{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fun",
  "scopeName": "source.fun",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#typeDeclarations" },
    { "include": "#genericTypes" },
    { "include": "#types" },
    { "include": "#customTypeReferences" },
    { "include": "#functions" },
    { "include": "#booleans" },
    { "include": "#keywords" }
  ],
  "repository": {
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fun",
          "match": "(->|::)"
        },
        {
          "name": "keyword.operator.fun",
          "match": "(\\+\\=|\\-\\=|\\*\\=|\\/\\=|\\%\\=|\\=\\=|\\!\\=|\\<\\=|\\>\\=|\\&\\&|\\|\\||\\<\\<|\\>\\>|\\+\\+|\\-\\-|\\+|\\-|\\*|\\/|\\%|\\=|\\<|\\>|\\!|\\?|\\&|\\||\\^|\\~|\\.)"
        },
        {
          "name": "punctuation.separator.fun",
          "match": "(;|,|:)"
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "name": "meta.type.declaration.struct.fun",
          "match": "\\b(compound|union)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.type.struct.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        },
        {
          "name": "meta.type.declaration.enum.fun",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.type.enum.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        },
        {
          "name": "meta.type.declaration.interface.fun",
          "match": "\\b(shape)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.type.interface.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        }
      ]
    },
    "genericTypes": {
      "patterns": [
        {
          "name": "meta.type.generic.fun",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(<\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\*+)?(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\*+)?)*\\s*>)",
          "captures": {
            "1": { "name": "entity.name.type.fun" },
            "2": { "name": "entity.name.type.parameters.fun" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fun",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fun",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fun",
          "match": "\"([^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.fun",
          "match": "'([^'\\\\]|\\\\.)*'"
        },
        {
          "comment": "Inline raw string: `` `content` `` closed by a single backtick on the same line; a doubled backtick is the one escape, a literal backtick.",
          "name": "string.quoted.other.fun",
          "match": "`(?:``|[^`])*`"
        },
        {
          "comment": "Multi-line raw string: a backtick left unclosed on its line starts a block. Each continuation line begins (after leading whitespace) with its own backtick marker; the block ends at an explicit single closing backtick (code may follow it on that line) or at the first line with no marker. Markers and doubled-backtick escapes are inner patterns tried first (applyEndPatternLast), so neither is taken for the closer.",
          "name": "string.quoted.other.multiline.fun",
          "begin": "`(?=(?:``|[^`])*$)",
          "end": "`|^(?!\\s*`)",
          "applyEndPatternLast": 1,
          "patterns": [{ "match": "^\\s*`" }, { "match": "``" }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fun",
          "match": "\\b(0x[0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.fun",
          "match": "\\b(void|raw|num|dec|f32|f64|str|flag|chr|i[1-9][0-9]*|u[1-9][0-9]*)\\b"
        },
        {
          "name": "support.type.fun",
          "match": "\\b(size_t|ptrdiff_t|ssize_t|intptr_t|uintptr_t|int8_t|uint8_t|int16_t|uint16_t|int32_t|uint32_t|int64_t|uint64_t|time_t|clock_t)\\b"
        }
      ]
    },
    "customTypeReferences": {
      "patterns": [
        {
          "name": "entity.name.type.fun",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*(?:\\*+)?\\s*[A-Za-z_][A-Za-z0-9_]*\\b)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.fun",
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?\\b",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.function.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        },
        {
          "name": "meta.function.call.fun",
          "match": "\\b(?!align\\(\\d+\\)|use\\b|as\\b|pub\\b|fun\\b|closure\\b|als\\b|compound\\b|shape\\b|impl\\b|enum\\b|let\\b|const\\b|if\\b|elif\\b|else\\b|fit\\b|ret\\b|for\\b|async\\b|await\\b|fork\\b|break\\b|continue\\b|defer\\b|assert\\b|panic\\b|test\\b|sequential\\b|fuzz\\b|allow\\b|expect\\b|true\\b|false\\b|nil\\b)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.fun" }
          }
        },
        {
          "comment": "A call spelling out its own generic type arguments (`identity<str>(5)`): a lowercase name, a balanced `<...>` (one level of nesting), then `(`. A capitalized name stays a type, so a downcast arm like `Box<num>(b) ->` is never taken for a call.",
          "name": "meta.function.call.generic.fun",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*<(?:[^<>()]|<[^<>()]*>)*>\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.fun" }
          }
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.fun",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.fun",
          "match": "\\b(nil)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fun",
          "match": "\\b(packed(?=\\s+(compound|union)\\b)|union(?=\\s+\\w+\\s*[{<])|align(?=\\(\\d+\\))|use|as|pub|fun|closure|als|compound|shape|impl|enum|let|const|asm|volatile|arch|if|elif|else|fit|ret|for|async|await|fork|break|continue|defer|assert|panic|test|sequential|fuzz|allow|expect)\\b"
        }
      ]
    }
  }
}
