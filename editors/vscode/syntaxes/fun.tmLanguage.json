{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fun",
  "scopeName": "source.fun",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#booleans" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fun",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fun",
          "match": "\"([^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.fun",
          "match": "'([^'\\\\]|\\\\.)*'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fun",
          "match": "\\b(0x[0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.fun",
          "match": "\\b(void|raw|num|dec|str|bin|chr)\\b"
        },
        {
          "name": "support.type.fun",
          "match": "\\b(size_t|ptrdiff_t|ssize_t|intptr_t|uintptr_t|int8_t|uint8_t|int16_t|uint16_t|int32_t|uint32_t|int64_t|uint64_t|time_t|clock_t)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.fun",
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.function.fun" }
          }
        },
        {
          "name": "meta.function.call.fun",
          "match": "\\b(?!imp\\b|fun\\b|compound\\b|quirk\\b|impl\\b|if\\b|elif\\b|else\\b|fit\\b|ret\\b|for\\b|break\\b|continue\\b|true\\b|false\\b)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.fun" }
          }
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.fun",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fun",
          "match": "\\b(imp|fun|compound|quirk|impl|if|elif|else|fit|ret|for|break|continue)\\b"
        }
      ]
    }
  }
}
