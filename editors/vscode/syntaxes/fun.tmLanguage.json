{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fun",
  "scopeName": "source.fun",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#typeDeclarations" },
    { "include": "#genericTypes" },
    { "include": "#types" },
    { "include": "#customTypeReferences" },
    { "include": "#functions" },
    { "include": "#booleans" },
    { "include": "#keywords" }
  ],
  "repository": {
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fun",
          "match": "(->|::)"
        },
        {
          "name": "keyword.operator.fun",
          "match": "(\\+\\=|\\-\\=|\\*\\=|\\/\\=|\\%\\=|\\=\\=|\\!\\=|\\<\\=|\\>\\=|\\&\\&|\\|\\||\\<\\<|\\>\\>|\\+\\+|\\-\\-|\\+|\\-|\\*|\\/|\\%|\\=|\\<|\\>|\\!|\\&|\\||\\^|\\~|\\.)"
        },
        {
          "name": "punctuation.separator.fun",
          "match": "(;|,|:)"
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "name": "meta.type.declaration.struct.fun",
          "match": "\\b(compound)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.type.struct.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        },
        {
          "name": "meta.type.declaration.enum.fun",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.type.enum.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        },
        {
          "name": "meta.type.declaration.interface.fun",
          "match": "\\b(quirk)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.type.interface.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        }
      ]
    },
    "genericTypes": {
      "patterns": [
        {
          "name": "meta.type.generic.fun",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(<\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\*+)?(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\*+)?)*\\s*>)",
          "captures": {
            "1": { "name": "entity.name.type.fun" },
            "2": { "name": "entity.name.type.parameters.fun" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fun",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fun",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fun",
          "match": "\"([^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.fun",
          "match": "'([^'\\\\]|\\\\.)*'"
        },
        {
          "comment": "Inline raw string: `` `content` `` closed on the same line -- no escape processing at all.",
          "name": "string.quoted.other.fun",
          "match": "`[^`]*`"
        },
        {
          "comment": "Multi-line raw string: a backtick with no closer on this line starts a block; each continuation line must itself begin (after leading whitespace) with a backtick to keep contributing, ending at the first line that doesn't.",
          "name": "string.quoted.other.multiline.fun",
          "begin": "`(?=[^`]*$)",
          "while": "^\\s*`"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fun",
          "match": "\\b(0x[0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.fun",
          "match": "\\b(void|raw|num|dec|f32|f64|str|bin|chr|i[1-9][0-9]*|u[1-9][0-9]*)\\b"
        },
        {
          "name": "support.type.fun",
          "match": "\\b(size_t|ptrdiff_t|ssize_t|intptr_t|uintptr_t|int8_t|uint8_t|int16_t|uint16_t|int32_t|uint32_t|int64_t|uint64_t|time_t|clock_t)\\b"
        }
      ]
    },
    "customTypeReferences": {
      "patterns": [
        {
          "name": "entity.name.type.fun",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*(?:\\*+)?\\s*[A-Za-z_][A-Za-z0-9_]*\\b)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.fun",
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>]+>)?\\b",
          "captures": {
            "1": { "name": "keyword.control.fun" },
            "2": { "name": "entity.name.function.fun" },
            "3": { "name": "entity.name.type.parameters.fun" }
          }
        },
        {
          "name": "meta.function.call.fun",
          "match": "\\b(?!imp\\b|as\\b|pub\\b|fun\\b|compound\\b|quirk\\b|impl\\b|enum\\b|let\\b|const\\b|if\\b|elif\\b|else\\b|fit\\b|ret\\b|for\\b|async\\b|await\\b|fork\\b|break\\b|continue\\b|defer\\b|assert\\b|panic\\b|test\\b|fuzz\\b|allow\\b|expect\\b|true\\b|false\\b|nil\\b)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.fun" }
          }
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.fun",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.fun",
          "match": "\\b(nil)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fun",
          "match": "\\b(imp|as|pub|fun|compound|quirk|impl|enum|let|const|asm|volatile|arch|if|elif|else|fit|ret|for|async|await|fork|break|continue|defer|assert|panic|test|fuzz|allow|expect)\\b"
        }
      ]
    }
  }
}
