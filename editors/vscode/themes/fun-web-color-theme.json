{
  "$schema": "vscode://schemas/color-theme",
  "name": "Fun Web",
  "type": "dark",
  "colors": {
    "editor.background": "#0A1228",
    "editor.foreground": "#E8EDFF",
    "editorLineNumber.foreground": "#5A6EA8",
    "editorLineNumber.activeForeground": "#9CB1E9",
    "editorCursor.foreground": "#E9EEFF",
    "editor.selectionBackground": "#6AA4FF59",
    "editor.inactiveSelectionBackground": "#6AA4FF33",
    "editor.wordHighlightBackground": "#8B7BFF40",
    "editor.wordHighlightStrongBackground": "#6AA4FF40",
    "editor.findMatchBackground": "#6AA4FF66",
    "editor.findMatchHighlightBackground": "#6AA4FF33",
    "editorIndentGuide.background1": "#22315F",
    "editorIndentGuide.activeBackground1": "#37539A",
    "editorWidget.background": "#0D1630",
    "editorWidget.border": "#304376",
    "dropdown.background": "#0C1530",
    "dropdown.foreground": "#E8EDFF",
    "dropdown.border": "#324B89",
    "input.background": "#0C1530",
    "input.foreground": "#E8EDFF",
    "input.border": "#324B89",
    "panel.background": "#0D1630",
    "panel.border": "#273869",
    "statusBar.background": "#0D1630",
    "statusBar.foreground": "#DCE6FF",
    "titleBar.activeBackground": "#121A32",
    "titleBar.activeForeground": "#E8EDFF",
    "sideBar.background": "#0B1020",
    "sideBar.foreground": "#E8EDFF",
    "sideBar.border": "#26345F",
    "activityBar.background": "#121A32",
    "activityBar.foreground": "#DCE6FF"
  },
  "tokenColors": [
    {
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#E8EDFF"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F8DB8"
      }
    },
    {
      "scope": [
        "string",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#F1C38F"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#7FE0C1"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9DE0FF"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7AA2FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#D4DEFF"
      }
    },
    {
      "scope": [
        "storage.type",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#9BDC8A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#B6A6FF"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#7FE0C1"
      }
    },
    {
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#FFB3C0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#A9E4FF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#7AA2FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.css",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7FE0C1"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#E8EDFF"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#FFB3C0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#0A1228",
        "background": "#FFB3C0"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#7F8DB8",
    "string": "#F1C38F",
    "regexp": "#7FE0C1",
    "number": "#9DE0FF",
    "keyword": {
      "foreground": "#7AA2FF",
      "bold": true
    },
    "operator": "#D4DEFF",
    "namespace": "#7FE0C1",
    "type": "#B6A6FF",
    "type.defaultLibrary": "#9BDC8A",
    "typeParameter": "#B6A6FF",
    "class": "#B6A6FF",
    "interface": "#B6A6FF",
    "struct": "#B6A6FF",
    "enum": "#B6A6FF",
    "enumMember": "#FFB3C0",
    "function": "#A9E4FF",
    "method": "#A9E4FF",
    "macro": "#7FE0C1",
    "decorator": "#7FE0C1",
    "parameter": "#E8EDFF",
    "variable": "#E8EDFF",
    "property": "#7FE0C1",
    "event": "#A9E4FF",
    "tag": "#7AA2FF",
    "attribute": "#7FE0C1",
    "label": "#7AA2FF"
  }
}
