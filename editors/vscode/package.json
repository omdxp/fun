{
  "name": "fun-language",
  "displayName": "Fun (FLS) for VS Code",
  "description": "Fun language support (fls language server)",
  "version": "0.1.4",
  "publisher": "omdxp",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdxp/fun.git"
  },
  "icon": "fun.png",
  "engines": {
    "vscode": ">=1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:fun",
    "onCommand:fun.restartLanguageServer",
    "onCommand:fun.showLanguageServerOutput",
    "onCommand:fun.runFile",
    "onCommand:fun.debugFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fun.restartLanguageServer",
        "title": "Fun: Restart Language Server"
      },
      {
        "command": "fun.showLanguageServerOutput",
        "title": "Fun: Show Language Server Output"
      },
      {
        "command": "fun.runFile",
        "title": "▶ Run",
        "category": "Fun"
      },
      {
        "command": "fun.debugFile",
        "title": "⚙ Debug",
        "category": "Fun"
      }
    ],
    "languages": [
      {
        "id": "fun",
        "aliases": [
          "Fun",
          "fun"
        ],
        "extensions": [
          ".fn"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "fun.png",
          "dark": "fun.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "fun",
        "scopeName": "source.fun",
        "path": "./syntaxes/fun.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Fun Web",
        "uiTheme": "vs-dark",
        "path": "./themes/fun-web-color-theme.json"
      }
    ],
    "breakpoints": [
      {
        "language": "fun"
      }
    ],
    "configuration": {
      "title": "Fun",
      "properties": {
        "fun.fls.path": {
          "type": "string",
          "default": "fls",
          "description": "Path to the fls language server executable."
        },
        "fun.fls.funPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the fun executable; passed to fls via FLS_FUN_PATH."
        },
        "fun.fls.stdlibDir": {
          "type": "string",
          "default": "",
          "description": "Optional stdlib root (folder that contains std/); passed to fls via FUN_STDLIB_DIR."
        },
        "fun.fls.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging from fls (sets FLS_DEBUG=1)."
        },
        "fun.fls.debugImports": {
          "type": "boolean",
          "default": false,
          "description": "Enable import/stdlib debug logging from fls (sets FLS_DEBUG_IMPORTS=1)."
        },
        "fun.fls.debugDefinitions": {
          "type": "boolean",
          "default": false,
          "description": "Enable go-to-definition debug logging from fls (sets FLS_DEBUG_DEFINITIONS=1)."
        },
        "fun.debugger.type": {
          "type": "string",
          "enum": [
            "lldb",
            "cppdbg"
          ],
          "enumDescriptions": [
            "CodeLLDB extension (vadimcn.vscode-lldb) — recommended on macOS/Linux",
            "C/C++ extension (ms-vscode.cpptools)"
          ],
          "default": "",
          "description": "Debugger type used by 'Debug' code lens. Leave empty for auto-detection (prefers CodeLLDB, then cpptools)."
        }
      }
    },
    "configurationDefaults": {
      "[fun]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "files.exclude": {
        "**/.__fls_*.fn": true
      },
      "files.watcherExclude": {
        "**/.__fls_*.fn": true
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "fun.restartLanguageServer",
          "when": "editorLangId == fun || resourceLangId == fun"
        },
        {
          "command": "fun.showLanguageServerOutput",
          "when": "editorLangId == fun || resourceLangId == fun"
        },
        {
          "command": "fun.runFile",
          "when": "editorLangId == fun"
        },
        {
          "command": "fun.debugFile",
          "when": "editorLangId == fun"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license --allow-star-activation"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^3.7.1"
  },
  "overrides": {
    "cheerio": "1.0.0"
  }
}
