    "tags": ["fun-test"]
  },
  {
    "label": "fun fuzz $ZED_CUSTOM_fuzz_name",
    "command": "fun",
    "args": ["-in", "\"$ZED_FILE\"", "-fuzz", "-fuzz-target", "\"$ZED_CUSTOM_fuzz_name\""],
    "tags": ["fun-fuzz"]
  },
  {
    "label": "fun test $ZED_RELATIVE_FILE",
    "command": "fun",
    "args": ["test", "\"$ZED_FILE\""]
  },
  {
    "label": "fun test $ZED_RELATIVE_FILE with coverage",
    "command": "fun",
    "args": ["test", "\"$ZED_FILE\"", "-cover"]
