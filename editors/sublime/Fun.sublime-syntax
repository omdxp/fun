%YAML 1.2
---
name: Fun
file_extensions:
  - fn
scope: source.fun

contexts:
  main:
    - match: //.*$
      scope: comment.line.double-slash.fun
    - match: /\*
      scope: punctuation.definition.comment.begin.fun
      push: block_comment
    - match: \b(compound|quirk|enum|impl)\s+([A-Za-z_][A-Za-z0-9_]*)(\s*<[^>]+>)?
      captures:
        1: keyword.control.fun
        2: entity.name.type.fun
        3: entity.name.type.parameters.fun
    - match: \b([A-Za-z_][A-Za-z0-9_]*)\s*(<[^>]+>)
      captures:
        1: entity.name.type.fun
        2: entity.name.type.parameters.fun
    - match: \b([A-Z][A-Za-z0-9_]*)\b(?=\s*(?:\*+)?\s*[A-Za-z_][A-Za-z0-9_]*\b)
      captures:
        1: entity.name.type.fun
    - match: (->|::|\+=|-=|\*=|/=|%=|==|!=|<=|>=|&&|\|\||<<|>>|\+\+|--|[+\-*/%=<>!&|^~.])
      scope: keyword.operator.fun
    - match: (;|,|:)
      scope: punctuation.separator.fun
    - match: '"'
      scope: punctuation.definition.string.begin.fun
      push: double_quoted
    - match: "'"
      scope: punctuation.definition.string.begin.fun
      push: single_quoted
    - match: \b(imp|as|pub|fun|compound|quirk|impl|enum|let|const|asm|volatile|arch|defer|ret|if|elif|else|for|fit|async|await|fork|break|continue|assert|panic|test|fuzz|allow|expect)\b
      scope: keyword.control.fun
    - match: \b(void|raw|num|dec|f32|f64|str|bin|chr|i[1-9][0-9]*|u[1-9][0-9]*)\b
      scope: storage.type.fun
    - match: \b(size_t|ptrdiff_t|ssize_t|intptr_t|uintptr_t|int8_t|uint8_t|int16_t|uint16_t|int32_t|uint32_t|int64_t|uint64_t|time_t|clock_t)\b
      scope: support.type.fun
    - match: \b(true|false)\b
      scope: constant.language.boolean.fun
    - match: \b(nil)\b
      scope: constant.language.null.fun
    - match: \b\d+(\.\d+)?\b
      scope: constant.numeric.fun

  block_comment:
    - meta_scope: comment.block.fun
    - match: \*/
      scope: punctuation.definition.comment.end.fun
      pop: true

  double_quoted:
    - meta_scope: string.quoted.double.fun
    - match: '\\.'
      scope: constant.character.escape.fun
    - match: '"'
      scope: punctuation.definition.string.end.fun
      pop: true

  single_quoted:
    - meta_scope: string.quoted.single.fun
    - match: "\\.'"
      scope: constant.character.escape.fun
    - match: "'"
      scope: punctuation.definition.string.end.fun
      pop: true
