// Companion to error_cases/let_infer_quirk_invalid.fn
// Shows the correct pattern: explicit shape annotation.

use std.c.io;

compound Point {
  num x;
  num y;
}

shape HasX {
  get_x() num;
}

impl Point as HasX {
  get_x() num {
    ret self.x;
  }
}

fun as_hasx(Point* p) HasX {
  ret p;
}

fun main() {
  Point p = Point{x = 4, y = 9};

  // Correct: explicit shape type annotation.
  HasX inferred_shape = as_hasx(&p);

  printf("x=%lld\n", inferred_shape.get_x());
}
