// Real-world-ish: write a short message to a file, then report bytes.

imp std.c.io;

fun main() {
  FILE* out = fopen("out.txt", "w");
  if out == 0 {
    perror("fopen");
    ret;
  }

  str msg = "hello from fun\n";
  num total = fputs(msg, out);

  fclose(out);
  printf("wrote %d bytes to out.txt\n", total);
}
