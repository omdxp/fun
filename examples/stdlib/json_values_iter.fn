// Iterate the elements of a parsed JSON array, reading each typed value.

imp std.c.io;
imp std.json;
imp std.result;
imp std.vec;

fun main() num {
  fit parse("[10, 20, 30]") {
    Result.Ok(doc) -> {
      let items = doc.as_array().unwrap_or(json_array());
      dec sum = 0.0;
      for item : items {
        sum = sum + item.as_num().unwrap_or(0.0);
      }
      printf("count=%lld sum=%g\n", items.len(), sum);
    }
    Result.Err(e) -> { printf("parse failed\n"); }
  }
  ret 0;
}
