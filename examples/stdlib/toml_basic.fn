// Typed TOML: parse `key = value` lines into typed values and read them back.

imp std.c.io;
imp std.toml;
imp std.option;

fun main() num {
  let doc = parse_document("name = \"fun\"\nversion = 2\nratio = 1.5\nstable = true\n");

  // get(key) returns Option<TomlValue>; as_* accessors narrow the scalar type.
  let name = doc.get("name").unwrap_or(TomlValue.Str(""));
  printf("name=%s\n", name.as_str().unwrap_or("?"));

  let version = doc.get("version").unwrap_or(TomlValue.Str(""));
  printf("version=%lld\n", version.as_int().unwrap_or(0));

  let stable = doc.get("stable").unwrap_or(TomlValue.Str(""));
  printf("stable=%d\n", stable.as_bool().unwrap_or(false));

  printf("toml=\n%s", doc.stringify());
  ret 0;
}
