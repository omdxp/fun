// Structured (de)serialization: a compound converts to/from a typed JsonValue via the
// ToJson/FromJson quirks (the reflection-free equivalent of derive), plus the text-layer
// Serialize quirk shared by JsonValue and TomlDoc.

imp std.c.io;
imp std.json;
imp std.toml;
imp std.serde;
imp std.option;
imp std.result;

pub compound Config {
  str name;
  dec version;
  bin stable;
}

impl Config as ToJson {
  pub to_json() JsonValue {
    let o = json_object();
    o.put("name", json_str(self.name));
    o.put("version", json_num(self.version));
    o.put("stable", json_bool(self.stable));
    ret JsonValue.Object(o);
  }
}

impl Config as FromJson {
  pub from_json(JsonValue value) {
    let n = value.get("name").unwrap_or(JsonValue.Null);
    self.name = n.as_str().unwrap_or("");
    let v = value.get("version").unwrap_or(JsonValue.Null);
    self.version = v.as_num().unwrap_or(0.0);
    let s = value.get("stable").unwrap_or(JsonValue.Null);
    self.stable = s.as_bool().unwrap_or(false);
  }
}

fun main() num {
  Config c = Config{name = "fun", version = 1.0, stable = true};

  // Compound -> typed JSON -> text.
  str json_text = to_json_string(&c);
  printf("json=%s\n", json_text);

  // text -> typed JSON -> compound.
  fit parse(json_text) {
    Result.Ok(doc) -> {
      Config back;
      back.from_json(doc);
      printf("back: name=%s version=%g stable=%d\n", back.name, back.version, back.stable);
    }
    Result.Err(e) -> { printf("parse failed\n"); }
  }

  // Text-layer Serialize quirk over a TomlDoc.
  let t = parse_document("channel = \"stable\"\n");
  Serialize ts = &t;
  printf("toml=%s", to_string(ts));

  ret 0;
}
