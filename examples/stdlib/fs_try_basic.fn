imp std.c.io;
imp std.fs;
imp std.result;

fun main() {
  Fs f = fs();
  str path = "_tmp_fs_try.txt";

  Result<bin> w = f.try_write_string(path, "hello from try");
  printf("write ok=%d err=%d\n", w.is_ok(), w.err.code);

  Result<str> r = f.try_read_to_string(path);
  printf("read ok=%d val=%s\n", r.is_ok(), r.value);
}
