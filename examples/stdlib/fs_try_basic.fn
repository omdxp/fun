// Fallible filesystem ops return a Result — match it with `fit` (or use a
// combinator like `unwrap_or`) instead of reading raw fields.

use std.c.io;
use std.fs;
use std.result;
use std.error;

fun main() num {
  Fs f = fs();
  str path = "_tmp_fs_try.txt";

  Result<flag, Error> w = f.try_write_string(path, "hello from try");
  fit w {
    Result.Ok(done) -> { printf("write ok\n"); }
    Result.Err(e) -> { printf("write failed: %s\n", e.message); }
  }

  Result<str, Error> r = f.try_read_to_string(path);
  fit r {
    Result.Ok(text) -> { printf("read ok: %s\n", text); }
    Result.Err(e) -> { printf("read failed: %s\n", e.message); }
  }
  ret 0;
}
