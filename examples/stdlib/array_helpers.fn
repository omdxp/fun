// Array helpers example.

use std.c.io;
use std.c.mem;
use std.array;

fun main() {
  num[] arr = [1, 2, 3, 4];
  num len = 4;
  Array<num> a;
  a.len = len;
  a.data = malloc(len * sizeof(num));
  a.fill(0);
  printf("sum=%d\n", sum_num(arr, len));
  printf("min=%d max=%d\n", min_num(arr, len), max_num(arr, len));
}
