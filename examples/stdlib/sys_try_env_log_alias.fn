use std.log as l;
use std.result;
use std.error;
use std.sys as sys;

fun main() {
  let env = sys.try_env("PATH");
  Result<str, Error> path_res = env;

  l.Logger logger = l.logger_init(l.LogLevel.Debug);
  if path_res.is_ok() {
    logger.info("PATH is available");
  } else {
    logger.warn("PATH missing");
  }
}
