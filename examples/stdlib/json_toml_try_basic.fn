// Parsing is fallible, so `parse` / `try_parse_document` return a Result. Match it
// with `fit`, or recover a fallback with `unwrap_or` after mapping.

imp std.c.io;
imp std.json;
imp std.toml;
imp std.result;

fun main() num {
  // JSON parse returns Result<JsonValue>.
  fit parse("{\"ok\": true}") {
    Result.Ok(doc) -> { printf("json ok, len=%lld\n", doc.len()); }
    Result.Err(e) -> { printf("json err\n"); }
  }

  // A malformed document surfaces as Err.
  fit parse("{ broken") {
    Result.Ok(doc) -> { printf("unexpected ok\n"); }
    Result.Err(e) -> { printf("json err as expected\n"); }
  }

  // TOML try-parse + stringify.
  fit try_parse_document("name = \"fun\"\n") {
    Result.Ok(doc) -> { printf("toml: %s", doc.stringify()); }
    Result.Err(e) -> { printf("toml err\n"); }
  }

  ret 0;
}
