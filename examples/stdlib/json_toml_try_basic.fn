imp std.c.io;
imp std.json;
imp std.toml;
imp std.result;

fun main() {
  JsonObject j = json_object_init();
  defer j.free();
  j.set("name", "fun");
  Result<str> js = j.try_stringify();
  printf("json ok=%d val=%s\n", js.is_ok(), js.value);

  TomlDoc t = toml_doc_init();
  defer t.free();
  t.set("name", "fun");
  Result<str> ts = t.try_stringify();
  printf("toml ok=%d val=%s\n", ts.is_ok(), ts.value);
}
