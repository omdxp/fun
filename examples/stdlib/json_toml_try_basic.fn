// JSON/TOML stringify is fallible, so it returns a Result; use `unwrap_or` or
// match it with `fit`.

imp std.c.io;
imp std.json;
imp std.toml;
imp std.result;

fun main() num {
  JsonObject j = json_object_init();
  defer j.free();
  j.set("name", "fun");
  Result<str> js = j.try_stringify();
  printf("json: %s\n", js.unwrap_or("<error>"));

  TomlDoc t = toml_doc_init();
  defer t.free();
  t.set("name", "fun");
  Result<str> ts = t.try_stringify();
  printf("toml: %s\n", ts.unwrap_or("<error>"));
  ret 0;
}
