// Real-world-ish: print the current time (epoch seconds).

imp std.io;
imp std.time;
fun main() {
  // `time()` returns a `time_t` and `ctime()` expects a `time_t*`.
  time_t now = time(NULL);
  printf("epoch_seconds=%lld\n", now);
  // human-readable format
  str time_str = ctime(&now);
  printf("time_str=%s", time_str); // ctime() adds its own newline
}
