// Fallible path operations return a Result; read the value with `unwrap_or` or
// match with `fit`.

use std.c.io;
use std.path;
use std.result;
use std.error;

fun main() num {
  Result<str, Error> j = try_path_join("/tmp", "file.txt");
  printf("join: %s\n", j.unwrap_or("<error>"));

  Result<str, Error> c = try_change_ext("/tmp/file.txt", ".log");
  fit c {
    Result.Ok(p) -> { printf("changed ext: %s\n", p); }
    Result.Err(e) -> { printf("change ext failed: %s\n", e.message); }
  }
  ret 0;
}
