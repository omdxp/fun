// Each of these three files keeps its own private `near`, and `a` and `b`
// each their own private `World` and `Scorer` shape: private names never
// collide across files.

use std.io;
use a;
use b;

fun near(num x) num {
  ret x - 1;
}

fun main() {
  println_fmt(
    "{num} {num} {num} {num} {num}",
    from_a(),
    from_b(),
    near(5),
    score_a(),
    score_b()
  );
}
