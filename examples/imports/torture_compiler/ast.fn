// AST module: the recursive expression tree the parser builds and the
// evaluator walks. Lives in its own file/module, imported by both
// parser.fn and eval.fn, to stress cross-file resolution of a recursive
// pointer-based tagged-union type (and its Display quirk impl).

imp std.io;
imp std.string;
imp std.vec;
imp std.quirks;

// `Call`'s args are a real `Vec<Expr*>` (variable arity) -- this used to hit
// a genuine compiler bug: a generic container instantiated with a POINTER
// type argument (`Vec<Expr*>`) mangled to the SAME C name as `Vec<Expr>`
// ("Vec__Expr" either way), so its struct fields, enum-payload unions, and
// monomorphized method parameters all lost or miscombined the pointer depth
// depending on which (colliding) instantiation happened to be processed
// last. Now fixed: the mangled name encodes each generic arg's pointer
// depth (`Vec__Expr_ptr1`), so distinct pointer-ness instantiate distinctly.
pub enum Expr {
  Num(dec),
  Var(str),
  Neg(Expr *),
  Bin(chr, Expr *, Expr *),
  Let(str, Expr *, Expr *),
  Call(str, Vec<Expr *>),
}

impl Expr as Display {
  pub to_string() str {
    fit *self {
      Expr.Num(n) -> { ret format("{}", n); }
      Expr.Var(name) -> { ret name; }
      Expr.Neg(e) -> { ret format("(neg {})", *e); }
      Expr.Bin(op, l, r) -> { ret format("({} {} {})", op, *l, *r); }
      Expr.Let(name, v, body) -> { ret format("(let {} = {} in {})", name, *v, *body); }
      Expr.Call(name, args) -> {
        Vec<str> parts;
        parts.init(4);
        num i = 0;
        for i < args.len() {
          // `format("{}", *args.get(i))` (dereferencing a METHOD CALL
          // result directly) doesn't dispatch to Display -- a separate,
          // already-documented limitation (auto-dispatch resolves a
          // small set of syntactic shapes, not full type inference).
          // Binding to a local first routes through the identifier-
          // dereference path, which does dispatch correctly.
          Expr* e = args.get(i);
          parts.push(format("{}", *e));
          i = i + 1;
        }
        ret format("{}({})", name, join(&parts, ", "));
      }
    }
  }
}
