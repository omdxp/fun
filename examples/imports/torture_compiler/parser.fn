// Parser module: recursive-descent, consuming a Vec<Token> (from lexer.fn)
// and building an Expr* tree (from ast.fn) — the two most
// "compiler-shaped" cross-file dependencies in this program.

imp std.c.mem;
imp std.vec;
imp std.result;
imp token;
imp ast;
imp lexer;

pub compound Parser {
  Vec<Token> toks;
  num pos;
}

pub fun parser_new(Vec<Token> toks) Parser {
  Parser p;
  p.toks = toks;
  p.pos = 0;
  ret p;
}

fun parser_mk_num(dec n) Expr* {
  Expr* e = malloc(sizeof(Expr));
  *e = Expr.Num(n);
  ret e;
}

fun parser_mk_var(str name) Expr* {
  Expr* e = malloc(sizeof(Expr));
  *e = Expr.Var(name);
  ret e;
}

fun parser_mk_neg(Expr* inner) Expr* {
  Expr* e = malloc(sizeof(Expr));
  *e = Expr.Neg(inner);
  ret e;
}

fun parser_mk_bin(chr op, Expr* l, Expr* r) Expr* {
  Expr* e = malloc(sizeof(Expr));
  *e = Expr.Bin(op, l, r);
  ret e;
}

fun parser_mk_call(str name, Vec<Expr *> args) Expr* {
  Expr* e = malloc(sizeof(Expr));
  *e = Expr.Call(name, args);
  ret e;
}

fun token_is_rparen(Token t) bin {
  fit t {
    Token.RParen -> { ret true; }
    _ -> { ret false; }
  }
}

fun token_is_comma(Token t) bin {
  fit t {
    Token.Comma -> { ret true; }
    _ -> { ret false; }
  }
}

impl Parser {
  peek() Token {
    ret self.toks.get(self.pos);
  }

  advance() Token {
    let t = self.toks.get(self.pos);
    self.pos = self.pos + 1;
    ret t;
  }

  pub parse_expr() Expr* {
    Expr* left = self.parse_term();
    for true {
      let t = self.peek();
      fit t {
        Token.Plus -> {
          self.advance();
          left = parser_mk_bin('+', left, self.parse_term());
        }
        Token.Minus -> {
          self.advance();
          left = parser_mk_bin('-', left, self.parse_term());
        }
        _ -> { ret left; }
      }
    }
    ret left;
  }

  parse_term() Expr* {
    Expr* left = self.parse_factor();
    for true {
      let t = self.peek();
      fit t {
        Token.Star -> {
          self.advance();
          left = parser_mk_bin('*', left, self.parse_factor());
        }
        Token.Slash -> {
          self.advance();
          left = parser_mk_bin('/', left, self.parse_factor());
        }
        _ -> { ret left; }
      }
    }
    ret left;
  }

  parse_factor() Expr* {
    let t = self.advance();
    fit t {
      Token.Num(n) -> { ret parser_mk_num(n); }
      Token.Ident(name) -> {
        let after = self.peek();
        fit after {
          Token.LParen -> { ret self.parse_call(name); }
          _ -> { ret parser_mk_var(name); }
        }
      }
      Token.Minus -> { ret parser_mk_neg(self.parse_factor()); }
      Token.LParen -> {
        Expr* inner = self.parse_expr();
        self.advance();
        ret inner;
      }
      _ -> { ret parser_mk_num(0.0); }
    }
  }

  // `name(` was already confirmed by the caller; consumes the '(' here.
  // Real variable-arity call: `f()`, `f(a)`, `f(a, b, ...)`.
  parse_call(str name) Expr* {
    self.advance();
    Vec<Expr *> args;
    args.init(4);
    if ! token_is_rparen(self.peek()) {
      args.push(self.parse_expr());
      for token_is_comma(self.peek()) {
        self.advance();
        args.push(self.parse_expr());
      }
    }
    self.advance();
    ret parser_mk_call(name, args);
  }
}

pub fun parse(str src) Result<Expr *> {
  Vec<Token> toks = tokenize(src);
  Parser p = parser_new(toks);
  Expr* result = p.parse_expr();
  let trailing = p.peek();
  fit trailing {
    Token.Eof -> { ret ok(result); }
    _ -> { ret err(1, "unexpected trailing tokens after expression", result); }
  }
}
