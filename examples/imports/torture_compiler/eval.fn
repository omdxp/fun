// Evaluator module: walks the Expr tree (ast.fn) using a Map<str, dec>
// (std.map, a two-type-param generic) as the symbol table.

imp std.map;
imp std.vec;
imp ast;

// max/min reduce over a variable-arity Vec<Expr*> -- any argument count.
fun eval_call(str name, Vec<Expr*> args, Map<str, dec>* env) dec {
  fit name {
    "max" -> {
      dec best = eval(args.get(0), env);
      num i = 1;
      for i < args.len() {
        let v = eval(args.get(i), env);
        if v > best {
          best = v;
        }
        i = i + 1;
      }
      ret best;
    }
    "min" -> {
      dec best = eval(args.get(0), env);
      num i = 1;
      for i < args.len() {
        let v = eval(args.get(i), env);
        if v < best {
          best = v;
        }
        i = i + 1;
      }
      ret best;
    }
    "abs" -> {
      let a = eval(args.get(0), env);
      if a < 0.0 {
        ret 0.0 - a;
      }
      ret a;
    }
    _ -> { ret 0.0; }
  }
}

pub fun eval(Expr* e, Map<str, dec>* env) dec {
  fit *e {
    Expr.Num(n) -> { ret n; }
    Expr.Var(name) -> { ret env.get_or(name, 0.0); }
    Expr.Neg(inner) -> { ret 0.0 - eval(inner, env); }
    Expr.Bin(op, l, r) -> {
      let lv = eval(l, env);
      let rv = eval(r, env);
      fit op {
        '+' -> { ret lv + rv; }
        '-' -> { ret lv - rv; }
        '*' -> { ret lv * rv; }
        '/' -> { ret lv / rv; }
        _ -> { ret 0.0; }
      }
    }
    Expr.Let(name, value_expr, body) -> {
      let v = eval(value_expr, env);
      env.put(name, v);
      ret eval(body, env);
    }
    Expr.Call(name, args) -> { ret eval_call(name, args, env); }
  }
  ret 0.0;
}
