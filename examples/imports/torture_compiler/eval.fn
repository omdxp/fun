// Evaluator module: walks the Expr tree (ast.fn) using a Map<str, dec>
// (std.map, a two-type-param generic) as the symbol table.

imp std.map;
imp ast;

fun eval_call(str name, dec a, dec b) dec {
  fit name {
    "max" -> {
      if a > b {
        ret a;
      }
      ret b;
    }
    "min" -> {
      if a < b {
        ret a;
      }
      ret b;
    }
    _ -> { ret 0.0; }
  }
}

pub fun eval(Expr* e, Map<str, dec>* env) dec {
  fit *e {
    Expr.Num(n) -> { ret n; }
    Expr.Var(name) -> { ret env.get_or(name, 0.0); }
    Expr.Neg(inner) -> { ret 0.0 - eval(inner, env); }
    Expr.Bin(op, l, r) -> {
      let lv = eval(l, env);
      let rv = eval(r, env);
      fit op {
        '+' -> { ret lv + rv; }
        '-' -> { ret lv - rv; }
        '*' -> { ret lv * rv; }
        '/' -> { ret lv / rv; }
        _ -> { ret 0.0; }
      }
    }
    Expr.Let(name, value_expr, body) -> {
      let v = eval(value_expr, env);
      env.put(name, v);
      ret eval(body, env);
    }
    Expr.Call(name, a, b) -> { ret eval_call(name, eval(a, env), eval(b, env)); }
  }
  ret 0.0;
}
