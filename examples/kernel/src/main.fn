// A bare-metal x86 kernel QEMU boots directly: it loads its own GDT
// (packed compounds), writes to VGA text memory (volatile), talks to the
// first serial port (port I/O through asm), and reports success or a
// failed assert through QEMU's debug-exit device. See README.md.

packed compound GdtEntry {
  u16 limit_low;
  u16 base_low;
  u8 base_mid;
  u8 access;
  u8 granularity;
  u8 base_high;
}

packed compound GdtPointer {
  u16 limit;
  u32 base;
}

compound VgaCell {
  u8 ch;
  u8 color;
}

const u32 VGA = 0xB8000;
const u16 COM1 = 0x3F8;

GdtEntry[3] gdt;
GdtPointer gdt_ptr;
num cursor = 0;

fun outb(u16 port, u8 value) {
  asm volatile arch x86 (in port: "Nd" = port; in value: "a" = value) {
    outb %[value], %[port]
  };
}

fun inb(u16 port) u8 {
  u8 value = 0;
  asm volatile arch x86 (out value: "=a" = value; in port: "Nd" = port) {
    inb %[port], %[value]
  };
  ret value;
}

fun serial_put(chr c) {
  for (inb(COM1 + 5) & 0x20) == 0 {
  }
  outb(COM1, c as u8);
}

fun print(str s) {
  volatile VgaCell* vga = VGA as volatile VgaCell*;
  num i = 0;
  for s[i] != '\0' {
    serial_put(s[i]);
    if s[i] != '\n' {
      vga[cursor] = VgaCell{ch = s[i] as u8, color = 0x0F};
      cursor++;
    }
    i++;
  }
}

fun print_num(num n) {
  chr[20] digits;
  num count = 0;
  if n == 0 {
    serial_put('0');
    ret;
  }
  for n > 0 {
    digits[count] = ('0' as num + n % 10) as chr;
    n = n / 10;
    count++;
  }
  for count > 0 {
    count--;
    serial_put(digits[count]);
  }
}

fun set_gate(num i, u32 base, u32 limit, u8 access, u8 gran) {
  gdt[i] = GdtEntry{
  limit_low = (limit & 0xFFFF) as u16,
  base_low = (base & 0xFFFF) as u16,
  base_mid = ((base >> 16) & 0xFF) as u8,
  access = access,
  granularity = (((limit >> 16) & 0x0F) | (gran & 0xF0)) as u8,
  base_high = ((base >> 24) & 0xFF) as u8}
  ;
}

fun load_gdt() {
  set_gate(0, 0, 0, 0, 0);
  set_gate(1, 0, 0xFFFFFFFF, 0x9A, 0xCF);
  set_gate(2, 0, 0xFFFFFFFF, 0x92, 0xCF);
  gdt_ptr = GdtPointer{limit = (sizeof(GdtEntry) * 3 - 1) as u16, base = &gdt as u32};
  GdtPointer* p = &gdt_ptr;
  asm volatile arch x86 (in p: "r" = p; clobber "memory") {
    lgdt (%[p])
    mov $0x10, %ax
    mov %ax, %ds
    mov %ax, %es
    mov %ax, %ss
    ljmp $0x08, $1f
    1:
  };
}

fun qemu_exit(u32 code) {
  asm volatile arch x86 (in code: "a" = code) {
    outl %[code], $0xf4
  };
}

pub fun fun_panic_handler(str message) {
  print("PANIC: ");
  print(message);
  print("\n");
  qemu_exit(3);
}

pub fun kmain() {
  print("fun kernel booted\n");
  print("gdt entry size: ");
  print_num(sizeof(GdtEntry));
  print("\n");
  print("gdt pointer size: ");
  print_num(sizeof(GdtPointer));
  print("\n");
  load_gdt();
  print("gdt loaded\n");
  volatile VgaCell* vga = VGA as volatile VgaCell*;
  print("vga first char: ");
  serial_put(vga[0].ch as chr);
  print("\n");
  assert cursor > 10, "cursor advanced";
  print("all checks passed\n");
  qemu_exit(0);
}
