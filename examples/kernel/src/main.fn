// A bare-metal x86 kernel QEMU boots directly. It loads its own GDT and
// interrupt table, remaps the interrupt controllers, counts timer ticks,
// turns on paging with a page mapped twice and a page fault handler that
// maps pages on first touch, and reports every check over the serial
// port before exiting through QEMU's debug-exit device. See README.md.

use console;
use port;
use gdt;
use idt;
use pic;
use timer;
use paging;
use cpu;

// The system call vector doubles `eax`, the way a system call hands
// back its result.
fun on_double(InterruptFrame* f) {
  f.eax = f.eax * 2;
}

fun call_double(u32 x) u32 {
  u32 r = x;
  asm volatile arch x86 (out r: "+a" = r; clobber "memory") {
    int $0x30
  };
  ret r;
}

// A breakpoint only needs to be seen: the stub counts it, and the CPU
// resumes after the `int3`.
fun on_breakpoint(InterruptFrame* f) {
  print("breakpoint at ");
  print_hex(f.eip);
  print("\n");
}

fun breakpoint() {
  asm volatile arch x86 (clobber "memory") {
    int3
  };
}

pub fun fun_panic_handler(str message) {
  print("PANIC: ");
  print(message);
  print("\n");
  qemu_exit(3);
}

fun check_cpu() {
  CpuInfo info = cpu_info();
  print("cpu vendor: ");
  num i = 0;
  for i < 12 {
    serial_put(info.vendor.text[i]);
    i++;
  }
  print("\n");
  assert info.max_leaf >= 1, "cpuid has leaf 1";
}

fun check_interrupts() {
  load_idt();
  report("idt entry size", idt_entry_size());
  set_handler(3, on_breakpoint);
  set_handler(SYSCALL_VECTOR, on_double);
  breakpoint();
  assert interrupt_count(3) == 1, "breakpoint reached its stub";
  u32 doubled = call_double(21);
  report("system call doubled 21", doubled as num);
  assert doubled == 42, "a handler's frame change reaches the caller";
}

fun check_timer() {
  pic_remap();
  timer_start();
  enable_interrupts();
  timer_wait(5);
  disable_interrupts();
  report("timer ticks", timer_ticks());
  assert timer_ticks() >= 5, "timer ticked";
}

fun check_paging() {
  report_hex("page directory", table_address());
  assert (table_address() & 0xFFF) == 0, "page directory is page aligned";
  assert (shared_page_address() & 0xFFF) == 0, "shared page is page aligned";
  enable_paging();
  print("paging enabled\n");
  volatile u32* alias = ALIAS as volatile u32*;
  volatile u32* direct = shared_page_address() as volatile u32*;
  *alias = 0xCAFEF00D;
  report_hex("read through identity map", *direct);
  assert *direct == 0xCAFEF00D, "alias and identity map share a page";
  volatile u32* demand = (DEMAND + 0x1000) as volatile u32*;
  u32 seen = *demand;
  report_hex("page fault at", last_fault_address());
  assert interrupt_count(14) == 1, "first touch faulted once";
  assert seen == 0xCAFEF00D, "fault handler mapped the shared page";
}

pub fun kmain() {
  print("fun kernel booted\n");
  report("gdt entry size", gdt_entry_size());
  report("gdt pointer size", gdt_pointer_size());
  load_gdt();
  print("gdt loaded\n");
  print("vga first char: ");
  serial_put(vga_char_at(0));
  print("\n");
  assert console_cursor() > 10, "cursor advanced";
  check_cpu();
  check_interrupts();
  check_timer();
  check_paging();
  print("all checks passed\n");
  qemu_exit(0);
}
