// Two-level 32-bit paging. The first 4 MiB are identity mapped, so the
// kernel keeps running where it was loaded, and one shared page is
// mapped a second time at `ALIAS`. Any other address is mapped on its
// first touch, by the page fault handler, to that same shared page.

use idt;

pub const u32 ALIAS = 0x40000000;
pub const u32 DEMAND = 0x80000000;

const u32 PRESENT_WRITABLE = 0x3;

align(4096) u32[1024] page_directory;
align(4096) u32[1024] identity_table;
align(4096) u32[1024] alias_table;
align(4096) u32[1024] demand_table;
align(4096) u8[4096] shared_page;

u32 last_fault = 0;

pub fun shared_page_address() u32 {
  ret &shared_page as u32;
}

pub fun table_address() u32 {
  ret &page_directory as u32;
}

pub fun last_fault_address() u32 {
  ret last_fault;
}

fun read_cr2() u32 {
  u32 v = 0;
  asm volatile arch x86 (out v: "=r" = v) {
    mov %cr2, %[v]
  };
  ret v;
}

fun on_page_fault(InterruptFrame* f) {
  u32 address = read_cr2();
  last_fault = address;
  num dir = (address >> 22) as num;
  num slot = ((address >> 12) & 0x3FF) as num;
  page_directory[dir] = (&demand_table as u32) | PRESENT_WRITABLE;
  demand_table[slot] = (&shared_page as u32) | PRESENT_WRITABLE;
}

pub fun enable_paging() {
  num i = 0;
  for i < 1024 {
    identity_table[i] = ((i * 4096) as u32) | PRESENT_WRITABLE;
    i++;
  }
  page_directory[0] = (&identity_table as u32) | PRESENT_WRITABLE;
  alias_table[0] = (&shared_page as u32) | PRESENT_WRITABLE;
  page_directory[(ALIAS >> 22) as num] = (&alias_table as u32) | PRESENT_WRITABLE;
  set_handler(14, on_page_fault);
  u32 dir = &page_directory as u32;
  asm volatile arch x86 (in dir: "r" = dir; clobber "memory") {
    mov %[dir], %cr3
    mov %cr0, %eax
    or $0x80000000, %eax
    mov %eax, %cr0
  };
}
