imp std.io;

compound Point {
  num x;
  num y;
}

quirk HasX {
  getX() num;
}

impl Point HasX {
  getX() num {
    ret self.x;
  }
}

quirk Shape {
  area() num;
  translate(num dx, num dy);
}

compound Rectangle {
  Point a;
  Point b;
}

compound Circle {
  Point center;
  num r;
}

impl Rectangle Shape {
  area() num {
    num w = self.b.x - self.a.x;
    num h = self.b.y - self.a.y;
    if (w < 0) w = -w;
    if (h < 0) h = -h;
    ret w * h;
  }

  translate(num dx, num dy) {
    self.a.x += dx;
    self.a.y += dy;
    self.b.x += dx;
    self.b.y += dy;
  }
}

impl Circle Shape {
  area() num {
    ret 3.14159 * self.r * self.r;
  }

  translate(num dx, num dy) {
    self.center.x += dx;
    self.center.y += dy;
  }
}

impl Rectangle HasX {
  getX() num {
    ret self.a.x;
  }
}

impl Circle HasX {
  getX() num {
    ret self.center.x;
  }
}

fun main() {
  Rectangle rect;
  rect.a.x = 0; rect.a.y = 0;
  rect.b.x = 4; rect.b.y = 3;

  Circle circ;
  circ.center.x = 1; circ.center.y = 1;
  circ.r = 2;

  Shape srect = &rect;
  Shape scirc = &circ;

  printf("rect area = %d\n", srect.area());
  printf("circ area = %d\n", scirc.area());

  srect.translate(1, -1);
  scirc.translate(-1, 2);

  printf("rect moved a=(%d,%d)\n", rect.a.x, rect.a.y);
  printf("circ moved center=(%d,%d)\n", circ.center.x, circ.center.y);

  HasX hx_rect = &rect;
  HasX hx_circ = &circ;
  printf("rect.getX=%d circ.getX=%d\n", hx_rect.getX(), hx_circ.getX());
}