// Demonstrates allowing the optional unused_import warning.
// 
// Run:
// fun -warn-unused -in .\examples\advanced\unused_import_allow.fn
// 
// Expected:
// - No warning is emitted because allow consumes the next unused_import warning.
// - Program still runs normally.

allow unused_import, "placeholder import while sketching the option-based API";
imp std.option;

fun main() {
}
