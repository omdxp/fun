imp std.c.io;
imp std.channel;

fun main() {
  Channel<num> a = channel_new(0);
  Channel<num> b = channel_new(0);

  _ = b.send(42);

  num out = 0;
  num which = -1;
  num rc = a.select_recv_timeout_with_slice(&b, &out, &which, 25, 2);

  printf("select rc=%lld which=%lld value=%lld slice=%lld\n", rc, which, out, 2);

  _ = a.destroy();
  _ = b.destroy();
}
