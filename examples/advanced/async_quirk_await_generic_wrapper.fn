imp std.c.io;

compound Counter {
  num base;
}

quirk AsyncCounter {
  async add(num x) num;
}

compound Box<T> {
  T v;
}

impl Counter as AsyncCounter {
  async add(num x) num {
    ret self.base + x;
  }
}

fun pack(AsyncCounter q) Box<AsyncCounter> {
  ret Box<AsyncCounter>{v = q};
}

async fun main() {
  Counter c;
  c.base = 41;
  AsyncCounter q = &c;
  num out = await pack(q).v.add(1);
  printf("%lld\n", out);
}
