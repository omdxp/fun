// Type aliases: a reusable name for a type expression.
// 
// `als Name<T1, T2> = <type>;` names a type expression, expanded wherever
// referenced before typecheck ever runs: the compiler never sees the
// alias name at all, only its fully-resolved body. Works for an ordinary
// type, a generic one (including a function type - the callback shape
// below is what motivated this feature), and a bound-list body usable as
// a generic constraint.

use std.io;

// A non-generic alias: just a shorter, more meaningful name for `num`.
als Meters = num;

// A generic alias whose body is a function type. `Callback<num, num> cb`
// reads with ordinary `Type name` order, unlike writing out
// `fun(num, num) num cb` directly at every call site.
als Callback<A, R> = fun(A) R;

fun square(num x) num {
  ret x * x;
}

fun apply(Callback<num, num> cb, num x) num {
  ret cb(x);
}

// A bound-list alias: `Numeric` stands for `num | dec`, spliced into a
// generic constraint wherever it's referenced. Saves retyping the same
// bound list on every function/compound that needs it.
als Numeric = num | dec;

fun double<T: Numeric>(T x) T {
  ret x + x;
}

// An alias's body can also name a quirk, and dynamic dispatch through it
// works exactly like a plain quirk-typed variable: `Drawable` is still a
// value type, never a pointer.
quirk Shape {
  area() num;
}

compound Square {
  num side;
}

impl Square as Shape {
  area() num {
    ret self.side * self.side;
  }
}

als Drawable = Shape;

fun describe(Drawable d) num {
  ret d.area();
}

fun main() {
  Meters distance = 5;
  println_fmt("distance: {num}", distance);

  println_fmt("applied: {num}", apply(square, 4));

  println_fmt("doubled: {num} {dec}", double(3), double(1.5));

  Square sq;
  sq.side = 4;
  Drawable d = &sq;
  println_fmt("described: {num}", describe(d));

  // Declaring `Meters d = "far";`, calling `apply(square, "4")`, or
  // calling `double("nope")` would now all be compile-time errors: an
  // alias's own underlying type is still fully enforced, it's never a
  // textual macro.
}
