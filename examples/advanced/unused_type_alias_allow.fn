// Demonstrates allowing the optional unused_type_alias warning.
// 
// Run:
// fun -warn-unused -in .\examples\advanced\unused_type_alias_allow.fn
// 
// Expected:
// - No warning is emitted because allow consumes the next unused_type_alias warning.
// - Program still runs normally.

allow unused_type_alias, "temporary private alias during refactor";

als Hidden = num;

fun main() {
}
