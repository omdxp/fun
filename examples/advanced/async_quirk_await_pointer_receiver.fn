imp std.c.io;

compound Counter {
  num base;
}

quirk AsyncCounter {
  async add(num x) num;
}

compound Box<T> {
  T v;
}

impl Counter as AsyncCounter {
  async add(num x) num {
    ret self.base + x;
  }
}

fun ptr(Box<AsyncCounter>* b) Box<AsyncCounter>* {
  ret b;
}

async fun main() {
  Counter c;
  c.base = 41;
  AsyncCounter q = &c;
  let b = Box<AsyncCounter>{v = q};
  let boxed = *ptr(&b);
  _ = boxed;
  let out = await (*ptr(&b)).v.add(1);
  let out2 = await (*ptr(&b)).v.add(1);
  printf("%lld %lld\n", out, out2);
}
