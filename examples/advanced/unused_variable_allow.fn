// Demonstrates allowing the optional unused_variable warning.
// 
// Run:
// fun -warn-unused -in .\examples\advanced\unused_variable_allow.fn
// 
// Expected:
// - No warning is emitted because allow consumes the next unused_variable warning.
// - Program still runs normally.

fun main() {
  allow unused_variable, "temporary scaffolding while wiring the call site";
  num value = 1;
}
