imp std.c.io;
imp std.channel;

fun main() {
  Channel<num> a = channel_new(0);
  Channel<num> b = channel_new(0);
  ChannelCancelToken token = channel_cancel_token_new();
  _ = channel_cancel_token_cancel(&token);

  num out = 0;
  num idx = CHANNEL_SELECT_INDEX_DEFAULT;
  num rc = a.select_recv_timeout_with_tuning_token(&b, &out, &idx, 100, -1, -1, &token);

  num ok_rc = 0;
  if rc == CHANNEL_RC_CANCELLED {
    ok_rc = 1;
  }
  num ok_idx = 0;
  if idx == CHANNEL_SELECT_INDEX_DEFAULT {
    ok_idx = 1;
  }

  printf("cancel ok=%lld idx_ok=%lld\n", ok_rc, ok_idx);

  _ = a.destroy();
  _ = b.destroy();
}
