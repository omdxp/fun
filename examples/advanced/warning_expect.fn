// Demonstrates expecting a warning and failing if it disappears.
// 
// Run:
// fun -in .\examples\advanced\warning_expect.fn

use std.c.io;

fun main() {
  flag x = true;

  // This suppresses the next fit_non_exhaustive warning.
  // If it doesn't happen, compilation fails.
  expect fit_non_exhaustive, "tracked intentional non-exhaustive fit";

  fit x {
    true -> { printf("intentional non-exhaustive fit\n"); }
  }
}
