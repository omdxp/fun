imp std.c.io;
imp std.channel;

fun main() {
  Channel<num> a = channel_new(0);
  Channel<num> b = channel_new(0);

  num out = 0;
  num idx = CHANNEL_SELECT_INDEX_DEFAULT;
  num rc = a.select_recv_default_with(&b, &out, &idx);

  num ok_rc = 0;
  if rc == CHANNEL_RC_DEFAULT {
    ok_rc = 1;
  }
  num ok_idx = 0;
  if idx == CHANNEL_SELECT_INDEX_DEFAULT {
    ok_idx = 1;
  }

  printf("default ok=%lld idx_ok=%lld\n", ok_rc, ok_idx);

  _ = a.destroy();
  _ = b.destroy();
}
