// Demonstrates the transpiler warning for non-exhaustive `fit` on `flag`.
//
// Run:
// fun -in .\examples\advanced\fit_exhaustive_warning.fn
//
// Expected:
// - A warning like:
// "fit statement is not exhausted for flag condition (missing false branch)"
// - Program still runs normally.

use std.c.io;

fun main() {
  flag x = true;

  // Not exhaustive: missing a `false -> ...` branch and no `_ -> ...` default.
  fit x {
    true -> { printf("x was true\n"); }
  }
}
