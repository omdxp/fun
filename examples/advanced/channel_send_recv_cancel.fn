imp std.c.io;
imp std.channel;

fun main() {
  Channel<num> ch = channel_new_cap(0, 1);
  ChannelCancelToken token = channel_cancel_token_new();

  num out = 0;

  num rc1 = ch.send_with_token(5, &token);
  num rc2 = ch.recv_into_with_token(&out, &token);

  _ = channel_cancel_token_cancel(&token);
  _ = ch.send(1);
  num rc3 = ch.send_timeout_with_token(2, 10, &token);
  _ = ch.recv_into(&out);
  num rc4 = ch.recv_timeout_into_with_token(&out, 10, &token);

  num ok_send = 0;
  if rc1 == channel_rc_ok() {
    ok_send = 1;
  }
  num ok_recv = 0;
  if rc2 == channel_rc_ok() {
    ok_recv = 1;
  }
  num ok_cancel_send = 0;
  if rc3 == channel_rc_cancelled() {
    ok_cancel_send = 1;
  }
  num ok_cancel_recv = 0;
  if rc4 == channel_rc_cancelled() {
    ok_cancel_recv = 1;
  }

  printf("ok_send=%lld ok_recv=%lld cancel_send=%lld cancel_recv=%lld\n", ok_send, ok_recv, ok_cancel_send, ok_cancel_recv);

  _ = ch.destroy();
}
