// Closures: `fun(num a) R { ... }` is an anonymous value, written wherever
// an expression is expected, that captures every outer local it reads by
// value at the moment it's created. Its type is `closure(num) R`. A plain
// function or `fun(...) R` value fits a closure of the same signature,
// but a closure never fits a plain `fun(...) R` slot.

use std.io;

fun twice(num x) num {
  ret x * 2;
}

fun apply(closure(num) num f, num x) num {
  ret f(x);
}

fun main() {
  num x = 1;
  closure() void snapshot = fun() {
    println_fmt("snapshot sees x={num}", x);
  };
  x = 99;
  snapshot(); // prints "x=1": captured a snapshot, not a live alias
  snapshot(); // a closure runs as many times as it's called
  snapshot.free();

  // `let` infers `closure(num) num` the same way it infers anything else.
  num base = 10;
  let add_base = fun(num n) num {
    ret n + base;
  };
  println_fmt("add_base={num}", apply(add_base, 1));
  add_base.free();

  // A plain function goes where a closure is expected, capturing nothing.
  println_fmt("twice={num}", apply(twice, 21));
}
