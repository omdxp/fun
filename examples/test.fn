imp std.io;

// this calculates the factorial of a number
fun factorial(num n) num {
    if n == 0 {
        ret 1;
    }
    ret n * factorial(n - 1);
}

fun main() {
    fun example() {
        printf("Hello, World!\n");
    }
    num number = 5;
    num result = factorial(number);
    printf("The factorial of %d is: %d\n", number, result);
}
