imp std.c.io;

// This example demonstrates the use of enum dot shorthand notation
enum Color {
  // Representing the color red
  Red,
  // Representing the color green
  Green,
  Blue,
}

fun takes(Color c) {
  fit c {
    .Red -> { printf("R\n"); },
    .Green -> { printf("G\n"); },
    .Blue -> { printf("B\n"); }
  }
}

fun main() {
  Color c = .Blue;
  if c == .Blue {
    takes(.Red);
  }
  takes(c);
}
