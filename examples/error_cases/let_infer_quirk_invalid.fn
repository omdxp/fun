// Expect: compiler error that let cannot infer shape type; explicit shape annotation is required.

compound Point {
  num x;
  num y;
}

shape HasX {
  get_x() num;
}

impl Point as HasX {
  get_x() num {
    ret self.x;
  }
}

fun as_hasx(Point* p) HasX {
  ret p;
}

fun main() {
  Point p = Point{x = 1, y = 2};
  let inferred_shape = as_hasx(&p);
  inferred_shape.get_x();
}
