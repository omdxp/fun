}

test "completion still answers while the text does not parse" {
  // What a reader is typing is half-written by definition, so a failed
  // parse must not turn into an empty reply.
  str src = `fun helper(num total) num {
  `  tot
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///half.fn";
  doc.path = "half.fn";
  doc.text = src;
  doc.version = 1;

  str out = completion(&reads, doc, 1, 5, false);
  assert contains(out, `"label":"ret"`), "expected the reserved words";
  assert contains(out, `"label":"total"`), "expected a name already written in the file";
}

test "formatting replaces the document with what the formatter produces" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fmt.fn";
  doc.path = "fmt.fn";
  doc.text = "fun main() num {\n  num x=1;\n  ret x;\n}\n";
  doc.version = 1;

  str out = formatting(doc);
  assert contains(out, `"newText"`), "expected an edit";
  assert contains(out, "num x = 1;"), "expected the formatted text";
  // The range ends one past the last line, which is how the whole
  // document is named without measuring the last line.
  assert contains(out, `"start":{"line":0,"character":0}`), "expected the range to start at the top";
  assert contains(out, `"character":0}}`), "expected the range to end at a line start";
}

test "formatting a document already formatted asks for no edit" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///tidy.fn";
  doc.path = "tidy.fn";
  doc.text = "fun main() num {\n  num x = 1;\n  ret x;\n}\n";
  doc.version = 1;

  // An empty list leaves the client's undo history alone.
  assert equals(formatting(doc), "[]"), "expected no edit for text already formatted";
}

test "formatting leaves text it cannot read alone" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///broken.fn";
  doc.path = "broken.fn";
  doc.text = "fun main() num {\n  ret 0\n}\n";
  doc.version = 1;

  // Refusing to format is better than rewriting a file whose meaning is
  // not yet clear.
  assert equals(formatting(doc), "[]"), "expected no edit for text that does not parse";
}

test "semantic tokens classify a function declaration, a type, a keyword styled as a type, and a literal" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///semtok.fn";
  doc.path = "semtok.fn";
  doc.text = `compound Widget {
  `  num n;
  `}
  `fun main() num {
  `  Widget w;
  `  bin ok = true;
  `  ret 0;
  `}`;
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  // A shallow structural check: the encoding is delta-based, not
  // position-keyed, so this decodes it enough to find one token of
  // each interesting kind rather than asserting on raw offsets.
  assert contains(out, `"data":[`), "expected the LSP data array shape";
  assert !contains(out, `"data":[]`), "expected at least one token classified";
}

test "semantic tokens' declared legend matches what the token-type indices actually mean" {
  // initialize's own capabilities and the encoder must agree on what
  // index 5 (say) means, or a client colors every token wrong.
  assert contains(TOKEN_TYPES, "\"function\""), "expected 'function' in the legend";
  assert contains(TOKEN_TYPES, "\"type\""), "expected 'type' in the legend";
  assert contains(TOKEN_TYPES, "\"keyword\""), "expected 'keyword' in the legend";
}

test "a bare '=' followed by whitespace is a one-column-wide semantic token, not two" {
  // Regression for the lexer fix this uncovered: '='s own reported
  // end_col used to bleed one column into the whitespace after it,
  // showing up here as a two-wide operator token that swallowed the
  // trailing space instead of stopping right after the '=' itself.
  // Doesn't need a full parse (only lexing), so a bare four-token
  // line pins down the whole flat array exactly: x=6(variable),
  // ==4(operator), y=6(variable), ;=4(operator), each length 1.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///eqwidth.fn";
  doc.path = "eqwidth.fn";
  doc.text = "x = y;";
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  assert equals(out, `{"data":[0,0,1,6,0,0,2,1,4,0,0,2,1,6,0,0,1,1,4,0]}`), "expected every token exactly one column wide, deltas exact";
}

test "a keyword completes to the shape it introduces" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///snip.fn";
  doc.path = "snip.fn";
  doc.text = "fun helper() num {\n  ret 0;\n}\n";
  doc.version = 1;

  // Format 2 is the protocol's snippet format: accepting `fun` writes
  // the declaration and leaves the cursor on its name.
  str out = completion(&reads, doc, 1, 2, true);
  assert contains(out, `"label":"fun"`), "expected the keyword";
  assert contains(out, `fun ${1:name}`), "expected the skeleton to name the first stop";
  assert contains(out, `"insertTextFormat":2`), "expected the snippet format";
}

test "a short trigger writes a whole shape" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///abbrev.fn";
  doc.path = "abbrev.fn";
  doc.text = "fun helper() num {\n  ret 0;\n}\n";
  doc.version = 1;

  // The point of a trigger is what it expands to, the way `psvm` writes
  // an entry point elsewhere.
  str out = completion(&reads, doc, 1, 2, true);
  assert contains(out, `"label":"main"`), "expected the entry-point trigger";
  assert contains(out, `"label":"iferr"`), "expected the early-return trigger";
  assert contains(out, `"label":"vecnew"`), "expected the vector trigger";
  assert contains(out, `"kind":15`), "expected them offered as snippets";
}

test "a client that does not understand a skeleton is sent none" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///plain.fn";
  doc.path = "plain.fn";
  doc.text = "fun helper() num {\n  ret 0;\n}\n";
  doc.version = 1;

  // Sent a skeleton, such a client would insert the marks as text.
  str out = completion(&reads, doc, 1, 2, false);
  assert contains(out, `"label":"fun"`), "expected the keyword itself";
  assert !contains(out, `"insertTextFormat"`), "expected no snippet";
  assert !contains(out, `"label":"iferr"`), "expected no trigger, which is only its expansion";
}
