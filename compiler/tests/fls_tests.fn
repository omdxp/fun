  assert contains(out, `"start":{"line":2,"character":10}`), "expected the insertion right where the diagnostic points";
  assert contains(out, `"newText":"await "`), "expected 'await ' as the inserted text";
}

test "code actions mark the enclosing function async for an await-outside-async error" {
