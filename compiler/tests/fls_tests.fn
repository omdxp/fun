// Language server cases: what a message on the wire is turned into.

imp ..fls.protocol;
imp ..fls.positions;
imp ..fls.symbols;
imp ..fls.navigation;
imp ..fls.signature_help;
imp ..fls.inlay_hints;
imp ..fls.code_action;
imp ..fls.diagnostics;
imp ..fls.outline;
imp ..fls.references;
imp ..fls.completion;
imp ..fls.formatting;
imp ..fls.analysis;
