// Symbols.
// 
// What a name at a position in a document refers to, and where it was
// declared. A name is looked for from the inside out: a parameter or
// local of the function it sits in, then a field of the type it is
// reached through, and only then a declaration the whole program shares.
// Answering in that order is what keeps a local named `len` from
// resolving to the standard library's function of the same name.

imp ..ast.ast;
imp ..lexer.token;
imp positions;
imp std.string;
imp std.io;
imp std.vec;
imp std.option;

// What a name turned out to be.
pub enum DeclarationKind {
  Function,
  Compound,
  Enum,
  Quirk,
  Field,
  Local,
  Parameter,
  Global,
  Variant,
}

// A name's declaration: what it is, how to spell it back to a reader,
// and where it was written.
pub compound Declaration {
  str name;
  DeclarationKind kind;
  // The declaration as a reader would write it, e.g. `fun len(str s) num`
  // or `Vec<str>* data`.
  str detail;
  Pos pos;
  // The compound/enum this was found on (a field, a method, a
  // variant); empty for anything declared at the top level. A field
  // typed `num` has no type name of its own to link from its
  // `detail`, but "See also: its own compound" is still worth
  // showing.
  str container;
  // Whether this declaration was written `pub`. Meaningful only for
  // the top-level kinds a cross-file lookup can actually reach
  // (Function, Compound, Enum, Quirk, Global); `true` for everything
  // else (a field, a local, a parameter, a variant, an impl method),
  // which visibility filtering doesn't apply to in the same way and
  // is never independently gated by this field.
  bin is_public;
}

// Whether `d` is visible from `current_file`: always, from the same
// file it's declared in (`pos.filename` empty means no position info
// at all, trusted the same way), otherwise only when it was written
// `pub`. Matches `check_visibility`'s own rule in typecheck.fn exactly.
pub fun declaration_visible_from(Declaration d, str current_file) bin {
  if d.is_public || equals(d.pos.filename, "") || equals(current_file, "") {
    ret true;
  }
  ret equals(d.pos.filename, current_file);
}

// The word a client's cursor sits on, given the token it landed on.
// The word a token spells, for the tokens that carry one.
pub fun token_word(Token t) str {
  fit t.data {
    .Sval(s) -> { ret s; }
    _ -> {}
  }
  ret "";
}

// A type as a reader would write it. A pointer is spelled with its `*`,
// which the flag records even when the depth does not, so a `Vec<T>*`
// field is not reported as a `Vec<T>`.
pub fun render_type(DataType* dt) str {
  if dt == nil {
    ret "";
  }
  StringBuilder b = string_builder_init(32);
  b.append(_base_type_name(dt));

  if dt.generic_args.len > 0 {
    b.append("<");
    num i = 0;
    for i < dt.generic_args.len {
      if i > 0 {
        b.append(", ");
      }
      b.append(render_type(dt.generic_args.get(i)));
      i = i + 1;
    }
    b.append(">");
  }

  num stars = dt.pointer_depth;
  if dt.flags.is_pointer && stars == 0 {
    stars = 1;
  }
  num s = 0;
  for s < stars {
    b.append("*");
    s = s + 1;
  }

  if dt.is_array || dt.flags.is_array {
    num depth = dt.array_depth;
    if depth == 0 {
      depth = 1;
    }
    num a = 0;
    for a < depth {
      b.append("[]");
      a = a + 1;
    }
  }
  ret b.build();
}

fun _base_type_name(DataType* dt) str {
  fit dt.kind {
    .Void -> { ret "void"; }
    .Raw -> { ret "raw"; }
    .Chr -> { ret "chr"; }
    .Str -> { ret "str"; }
    .Dec -> { ret "dec"; }
    .Num -> { ret "num"; }
    .Bin -> { ret "bin"; }
    _ -> {}
  }
  ret dt.type_str;
}

// A function as its signature reads, without its body.
pub fun render_function(FunctionNode f) str {
  ret render_function_named(f, f.name, true);
}

// Like `render_function`, but spelled back under `name` instead of
// `f.name`, since an impl method's own `f.name` is always mangled
// with its owning type (`Box__doubled`, never the bare `doubled` a
// reader wrote), so a caller resolving a method needs to supply the
// de-mangled name itself. `include_fun` leaves off the leading `fun `
// for a method, which is never written with one of its own
// (`pub doubled(...) num { ... }`, not `pub fun doubled(...)`).
pub fun render_function_named(FunctionNode f, str name, bin include_fun) str {
  StringBuilder b = string_builder_init(64);
  if f.is_async {
    b.append("async ");
  }
  if include_fun {
    b.append("fun ");
  }
  b.append(name);
  if f.has_type_params && f.type_params.len > 0 {
    b.append("<");
    num t = 0;
    for t < f.type_params.len {
      if t > 0 {
        b.append(", ");
      }
      b.append(f.type_params.get(t));
      t = t + 1;
    }
    b.append(">");
  }
  b.append("(");
  num i = 0;
  for i < f.args.len {
    if i > 0 {
      b.append(", ");
    }
    Node* arg = f.args.get(i);
    b.append(_render_param(arg));
    i = i + 1;
  }
  if f.is_variadic {
    if f.args.len > 0 {
      b.append(", ");
    }
    b.append("...");
  }
  b.append(")");
  if f.has_rtype {
    let rendered = render_type(f.rtype);
    if !equals(rendered, "") && !equals(rendered, "void") {
      b.append(" ");
      b.append(rendered);
    }
  }
  ret b.build();
}

fun _render_param(Node* arg) str {
  if arg == nil {
    ret "";
  }
  fit arg.kind {
    .Variable(v) -> {
      StringBuilder b = string_builder_init(24);
      b.append(render_type(v.var_type));
      b.append(" ");
      b.append(v.name);
      if v.has_val {
        str default_text = _literal_value_text(v.val);
        if !equals(default_text, "") {
          b.append(" = ");
          b.append(default_text);
        }
      }
      ret b.build();
    }
    _ -> {}
  }
  ret "";
}

// `s`, escaped for display inside a double-quoted rendering, without
// double-escaping content that already carries its own valid escapes.
// A `.String` node's own content is the lexer's raw as-written text:
// a double-quoted source string keeps every `\"`/`\\` it was written
// with untouched, but a backtick raw string has none at all, so an
// embedded quote there is a literal `"` character. Since the AST
// carries no record of which one produced this value, a quote is
// escaped only when it is not already preceded by an odd run of
// backslashes (an escape already covering it).
fun _quote_escaped(str s) str {
  StringBuilder b = string_builder_init(len(s) + 4);
  num n = len(s);
  num i = 0;
  bin prev_is_escaping_backslash = false;
  for i < n {
    chr c = s[i];
    if c == '"' && !prev_is_escaping_backslash {
      b.append_char('\\');
    }
    b.append_char(c);
    if c == '\\' {
      prev_is_escaping_backslash = !prev_is_escaping_backslash;
    } else {
      prev_is_escaping_backslash = false;
    }
    i = i + 1;
  }
  ret b.build();
}

// A constant's own literal value (or a parameter's own default one:
// `num times = 2`), spelled back the way a reader would read it (a
// re-rendered numeric form rather than the exact source text, so
// `0xFF` shows as `255`): "" for an initializer that isn't a plain
// literal, a bare name, or a unary minus over one of those - covers
// every shape a default parameter value is allowed to take (a
// constant, a global, `nil`, or an enum variant's own bare name;
// arbitrary expressions aren't legal there to begin with), but not
// a qualified or dot-shorthand variant construction.
fun _literal_value_text(Node* val) str {
  if val == nil {
    ret "";
  }
  fit val.kind {
    .Identifier(s) -> { ret s; }
    .Number(d) -> {
      fit d {
        .Num(n) -> { ret format_num(n); }
        .Dec(x) -> { ret format_dec(x, 6); }
        .Cval(c) -> { ret format("'{chr}'", c); }
        _ -> { ret ""; }
      }
    }
    .String(s) -> { ret format(`"{str}"`, _quote_escaped(s)); }
    .Character(c) -> { ret format("'{chr}'", c); }
    .Boolean(b) -> {
      if b {
        ret "true";
      }
      ret "false";
    }
    .Nil -> { ret "nil"; }
    .Unary(u) -> {
      // A negative numeric literal (`-1`) is parsed as a unary minus
      // over a plain Number node, not folded into the literal itself.
      if equals(u.op, "-") {
        str inner = _literal_value_text(u.operand);
        if !equals(inner, "") {
          ret format("-{str}", inner);
        }
      }
      ret "";
    }
    _ -> { ret ""; }
  }
}

// The contiguous `//`-prefixed comment lines immediately above
// `decl_line` (1-indexed, as `Pos.line` reads) in `text`, with each
// line's own `// ` prefix stripped and re-joined top to bottom. Empty
// when there is no such block directly above: a blank line or a
// non-comment line breaks the search, so a doc block separated from
// the declaration by a blank line (or an unrelated trailing comment
// on the previous declaration) is never mistaken for this one's own.
pub fun doc_comment_above(str text, num decl_line) str {
  if decl_line <= 1 {
    ret "";
  }
  Vec<str> src_lines = split_lines(text);
  num idx = decl_line - 2;
  // `decl_line` reads however the lexer counted lines, which is not
  // guaranteed to match `split_lines`'s own count exactly at the
  // edges (a missing final newline, a `\r\n` line ending); `Vec.get`
  // has no bounds check of its own, so a mismatch here would read out
  // of bounds rather than just finding no comment.
  if idx >= src_lines.len {
    ret "";
  }
  Vec<str> collected;
  collected.init(4);
  for idx >= 0 {
    str line_text = src_lines.get(idx);
    str t = trim(line_text);
    if equals(t, "") {
      break;
    }
    if !starts_with(t, "//") {
      break;
    }
    str content = substr(t, 2, len(t) - 2);
    if len(content) > 0 && content[0] == ' ' {
      content = substr(content, 1, len(content) - 1);
    }
    collected.push(content);
    idx = idx - 1;
  }
  if collected.len == 0 {
    ret "";
  }
  // Rendered top-to-bottom (`collected` was built bottom-to-top),
  // tracking ``` fenced code blocks: inside a fence, a line's own
  // indentation is kept verbatim so example code keeps its real
  // structure; outside, it's trimmed further so a stray extra space
  // in prose doesn't render as accidental sub-indentation.
  StringBuilder b = string_builder_init(64);
  bin in_fence = false;
  num i = collected.len;
  for i > 0 {
    i = i - 1;
    str content = collected.get(i);
    str trimmed_content = trim(content);
    bin is_fence = starts_with(trimmed_content, "```");
    if in_fence {
      b.append(content);
    } else {
      b.append(trimmed_content);
    }
    if is_fence {
      in_fence = !in_fence;
    }
    if i > 0 {
      b.append("\n");
    }
  }
  ret b.build();
}

// A trailing same-line comment on `decl_line` itself (`Circle(num), //
// meaning`), for a declaration with no leading block of its own to
// fall back to. Only the first `//` on the line, whatever comes
// before it on the source line is not re-parsed as code.
pub fun doc_comment_trailing(str text, num decl_line) str {
  if decl_line < 1 {
    ret "";
  }
  Vec<str> src_lines = split_lines(text);
  num idx = decl_line - 1;
  if idx >= src_lines.len {
    ret "";
  }
  str line_text = src_lines.get(idx);
  num slashes = index_of_str(line_text, "//");
  if slashes < 0 {
    ret "";
  }
  str content = trim(substr(line_text, slashes + 2, len(line_text) - slashes - 2));
  ret content;
}

// The declaration of `name` as seen from `file` at `line`: a parameter
// or local of the function that line sits in, before anything the whole
// program shares.
pub fun lookup(Vec<Node>* program, str name, str file, num line) Option<Declaration> {
  let local = _lookup_local(program, name, file, line);
  if local.is_some() {
    ret local;
  }
  ret lookup_top_level(program, name);
}

// The declaration of `name` among what the whole program declares.
pub fun lookup_top_level(Vec<Node>* program, str name) Option<Declaration> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Function(f) -> {
        if equals(f.name, name) {
          ret .Some(_declaration_vis(name, .Function, render_function(f), n.pos, n.flags.is_public));
        }
      }
      .Compound(c) -> {
        if equals(c.name, name) {
          StringBuilder b = string_builder_init(32);
          b.append("compound ");
          b.append(c.name);
          ret .Some(_declaration_vis(name, .Compound, b.build(), n.pos, n.flags.is_public));
        }
      }
      .Enum(e) -> {
        if equals(e.name, name) {
          StringBuilder b = string_builder_init(32);
          b.append("enum ");
          b.append(e.name);
          ret .Some(_declaration_vis(name, .Enum, b.build(), n.pos, n.flags.is_public));
        }
      }
      .Quirk(q) -> {
        if equals(q.name, name) {
          StringBuilder b = string_builder_init(32);
          b.append("quirk ");
          b.append(q.name);
          ret .Some(_declaration_vis(name, .Quirk, b.build(), n.pos, n.flags.is_public));
        }
      }
      .Variable(v) -> {
        if equals(v.name, name) {
          StringBuilder b = string_builder_init(32);
          if v.is_const {
            b.append("const ");
          }
          b.append(render_type(v.var_type));
          b.append(" ");
          b.append(v.name);
          if v.is_const && v.has_val {
            str literal = _literal_value_text(v.val);
            if !equals(literal, "") {
              b.append(" = ");
              b.append(literal);
            }
          }
          ret .Some(_declaration_vis(name, .Global, b.build(), n.pos, n.flags.is_public));
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// The field `field` of the compound named `type_name`.
pub fun lookup_field(Vec<Node>* program, str type_name, str field) Option<Declaration> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Compound(c) -> {
        if !equals(c.name, type_name) {
          continue;
        }
        num f = 0;
        for f < c.fields.len {
          CompoundField cf = c.fields.get(f);
          f = f + 1;
          if !equals(cf.name, field) {
            continue;
          }
          StringBuilder b = string_builder_init(32);
          b.append(render_type(cf.dtype));
          b.append(" ");
          b.append(cf.name);
          Pos field_pos = n.pos;
          if cf.has_pos {
            field_pos = cf.pos;
          }
          Declaration d = _declaration(field, .Field, b.build(), field_pos);
          d.container = type_name;
          ret .Some(d);
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// The method `method_name` declared in an `impl` block targeting
// `type_name`. Unlike a field or an enum variant, a method keeps its
// own real declaration position, so go-to-definition lands on the
// method itself, not on the enclosing impl or type. `concrete_args`
// is the receiver's own generic arguments in source order (`num` for
// an `Option<num>` receiver), when known; pass an empty `Vec` when
// they aren't (or the receiver isn't generic at all) to get the
// signature exactly as declared, template params included.
pub fun lookup_method(Vec<Node>* program, str type_name, str method_name, Vec<str> concrete_args) Option<Declaration> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Impl(im) -> {
        if !equals(im.type_name, type_name) {
          continue;
        }
        num m = 0;
        for m < im.methods.len {
          Node* method = im.methods.get(m);
          m = m + 1;
          if method == nil {
            continue;
          }
          fit method.kind {
            .Function(f) -> {
              if equals(bare_method_name(f.name), method_name) {
                str signature = render_function_named(f, method_name, false);
                if im.has_type_params {
                  signature = specialize_signature(signature, im.type_params, concrete_args);
                }
                Declaration d = _declaration(method_name, .Function, signature, method.pos);
                d.container = type_name;
                ret .Some(d);
              }
            }
            _ -> {}
          }
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// The signature `quirk_name` requires for `method_name`, as declared
// in the `quirk` block itself (no `self`, no body): what an `impl ...
// as quirk_name` block has to supply. `None` when no such quirk or
// method exists.
pub fun quirk_method_declaration(Vec<Node>* program, str quirk_name, str method_name) Option<Declaration> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Quirk(q) -> {
        if !equals(q.name, quirk_name) {
          continue;
        }
        num m = 0;
        for m < q.methods.len {
          QuirkMethodSig ms = q.methods.get(m);
          m = m + 1;
          if equals(ms.name, method_name) {
            Declaration d = _declaration(method_name, .Function, _render_quirk_method(ms), n.pos);
            d.container = quirk_name;
            ret .Some(d);
          }
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// `m` as a reader would write it inside an `impl` block: no `self`,
// since a quirk method's signature never carries one of its own.
fun _render_quirk_method(QuirkMethodSig m) str {
  StringBuilder b = string_builder_init(48);
  if m.is_async {
    b.append("async ");
  }
  b.append(m.name);
  b.append("(");
  num i = 0;
  for i < m.args.len {
    if i > 0 {
      b.append(", ");
    }
    QuirkArg a = m.args.get(i);
    b.append(render_type(a.dtype));
    b.append(" ");
    b.append(a.name);
    i = i + 1;
  }
  b.append(")");
  let rendered = render_type(m.rtype);
  if !equals(rendered, "") && !equals(rendered, "void") {
    b.append(" ");
    b.append(rendered);
  }
  ret b.build();
}

// `signature`, with each of `type_params`'s own name replaced by its
// positional entry in `concrete_args` wherever it appears as a whole
// word: `o.unwrap_or` on an `Option<num>` receiver shows
// `unwrap_or(num value) num`, not the bare template's own
// `unwrap_or(T value) T`. A length mismatch (an absent or unparsed
// concrete argument list) leaves `signature` unchanged, template
// params and all.
pub fun specialize_signature(str signature, Vec<str> type_params, Vec<str> concrete_args) str {
  if type_params.len == 0 || type_params.len != concrete_args.len {
    ret signature;
  }
  str out = signature;
  num i = 0;
  for i < type_params.len {
    out = _replace_word(out, type_params.get(i), concrete_args.get(i));
    i = i + 1;
  }
  ret out;
}

// The comma-separated generic type arguments in a rendered "Type<Arg1,
// Arg2> name" declaration detail, depth-aware so a nested generic
// argument's own comma isn't mistaken for a separator. Empty when
// `detail` names no generic instantiation at all.
pub fun generic_args_of_detail(str detail) Vec<str> {
  Vec<str> out;
  out.init(2);
  num open = index_of_char(detail, '<');
  if open < 0 {
    ret out;
  }
  num depth = 0;
  num start = open + 1;
  num i = start;
  num n = len(detail);
  for i < n {
    chr c = detail[i];
    if c == '<' {
      depth = depth + 1;
    } elif c == '>' {
      if depth == 0 {
        str piece = trim(substr(detail, start, i - start));
        if !equals(piece, "") {
          out.push(piece);
        }
        ret out;
      }
      depth = depth - 1;
    } elif c == ',' && depth == 0 {
      str piece = trim(substr(detail, start, i - start));
      if !equals(piece, "") {
        out.push(piece);
      }
      start = i + 1;
    }
    i = i + 1;
  }
  ret out;
}

// The generic type arguments of the local or parameter named `name`,
// as declared (`["num"]` for an `Option<num>` local); empty when it
// isn't generic, or isn't a known local at all. `tokens` is nil where
// a caller has no token stream to offer, the same convention
// `type_name_of_local` uses: a `let`-inferred local, whose own
// declared-args-from-detail read otherwise always comes back empty
// (the sentinel has no `<...>` to parse), only resolves its real
// generic args when `tokens` is available to re-run the same
// best-effort inference `type_name_of_local` already falls back to
// for the bare type name.
pub fun local_generic_args(Vec<Token>* tokens, Vec<Node>* program, str name, str file, num line) Vec<str> {
  let found = _lookup_local(program, name, file, line);
  if found.is_none() {
    Vec<str> empty;
    empty.init(0);
    ret empty;
  }
  Declaration d = found.unwrap();
  if tokens != nil && starts_with(d.detail, "__let_infer__") {
    let name_tok = token_at(tokens, d.pos.line - 1, d.pos.col - 1);
    if name_tok.is_none() {
      Vec<str> empty2;
      empty2.init(0);
      ret empty2;
    }
    num name_idx = index_of_token(tokens, name_tok.unwrap());
    Vec<str> inferred_args;
    inferred_args.init(0);
    infer_let_local_type_with_args(tokens, name_idx, program, file, d.pos.line, &inferred_args);
    ret inferred_args;
  }
  ret generic_args_of_detail(d.detail);
}

// `s` with every whole-word occurrence of `word` replaced by
// `replacement`. `word` must not be preceded or followed by an
// identifier character, so substituting `T` doesn't corrupt `Type`
// or a local actually named `Tx`.
fun _replace_word(str s, str word, str replacement) str {
  num n = len(s);
  num wlen = len(word);
  if wlen == 0 {
    ret s;
  }
  StringBuilder b = string_builder_init(n + 8);
  num i = 0;
  for i < n {
    bin matches = i + wlen <= n;
    if matches {
      num k = 0;
      for k < wlen {
        if s[i + k] != word[k] {
          matches = false;
        }
        k = k + 1;
      }
    }
    if matches {
      bin before_ok = i == 0 || !_is_type_param_ident_char(s[i - 1]);
      bin after_ok = i + wlen >= n || !_is_type_param_ident_char(s[i + wlen]);
      if before_ok && after_ok {
        b.append(replacement);
        i = i + wlen;
        continue;
      }
    }
    b.append_char(s[i]);
    i = i + 1;
  }
  ret b.build();
}

// True for a character that can appear in an identifier.
fun _is_type_param_ident_char(chr c) bin {
  ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// A method's own name, with the `Type__` prefix it is mangled with
// removed (an impl method's `f.name` is never the bare name a reader
// wrote; see `completion.fn`'s own `_method_label`, the same
// de-mangling under a different name for a different caller).
// A method's own written name, with whatever it was mangled with
// removed: `Type__method` for a plain impl, `Type__Quirk__method`
// for one conforming to a quirk (see `_parse_impl_method`'s own
// `gen_name` construction). Either way, the real name is everything
// after the last `__` separator, since neither a type nor a quirk
// name is ever written with one of its own.
pub fun bare_method_name(str mangled) str {
  num n = len(mangled);
  num i = n - 1;
  for i > 0 {
    if mangled[i] == '_' && mangled[i - 1] == '_' {
      ret substr(mangled, i + 1, n - i - 1);
    }
    i = i - 1;
  }
  ret mangled;
}

// The field, enum variant, or impl method `name` of whichever
// compound, enum, or impl block is being declared at `line`. A bare
// name written inside one of their bodies is only ever met without a
// value in front of it there.
pub fun lookup_field_at(Vec<Node>* program, str file, num line, str name) Option<Declaration> {
  num best_line = -1;
  Declaration best;
  bin found = false;
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    if !n.has_pos || !equals(n.pos.filename, file) || n.pos.line > line {
      continue;
    }
    fit n.kind {
      .Compound(c) -> {
        // A field's own name only means anything for the rest of
        // this compound's own body - a same-named bare identifier
        // written later in the file, in an unrelated function, must
        // not resolve to it just because it happens to be the
        // nearest declaration above.
        if line > _compound_last_line(c) {
          continue;
        }
        num f = 0;
        for f < c.fields.len {
          CompoundField cf = c.fields.get(f);
          f = f + 1;
          if !equals(cf.name, name) {
            continue;
          }
          // The nearest declaration above the line is the one being
          // written in.
          if n.pos.line > best_line {
            best_line = n.pos.line;
            StringBuilder b = string_builder_init(32);
            b.append(render_type(cf.dtype));
            b.append(" ");
            b.append(cf.name);
            Pos field_pos = n.pos;
            if cf.has_pos {
              field_pos = cf.pos;
            }
            best = _declaration(name, .Field, b.build(), field_pos);
            best.container = c.name;
            found = true;
          }
        }
      }
      .Enum(e) -> {
        // Same reasoning as the compound case above: a variant's own
        // name only means anything for the rest of this enum's own
        // body.
        if line > _enum_last_line(e) {
          continue;
        }
        num v = 0;
        for v < e.variants.len {
          EnumVariant variant = e.variants.get(v);
          v = v + 1;
          if !equals(variant.name, name) {
            continue;
          }
          if n.pos.line > best_line {
            best_line = n.pos.line;
            StringBuilder b = string_builder_init(24);
            b.append(variant.name);
            if variant.has_payload && variant.payload.len > 0 {
              b.append("(");
              num p = 0;
              for p < variant.payload.len {
                if p > 0 {
                  b.append(", ");
                }
                b.append(render_type(variant.payload.get(p)));
                p = p + 1;
              }
              b.append(")");
            }
            Pos variant_pos = n.pos;
            if variant.has_pos {
              variant_pos = variant.pos;
            }
            str detail = format("{str} = {num}", b.build(), _variant_ordinal(e, v - 1));
            best = _declaration(name, .Variant, detail, variant_pos);
            best.container = e.name;
            found = true;
          }
        }
      }
      .Impl(im) -> {
        // Unlike a compound/enum (a single-point container with no
        // body span of its own to fall outside of), an impl's own
        // methods stop meaning anything past its closing brace: a
        // same-named bare identifier written later in the file, in
        // an unrelated function, must not resolve to this impl's own
        // method just because it happens to be the nearest one above.
        if line > _impl_last_line(im) {
          continue;
        }
        num m = 0;
        for m < im.methods.len {
          Node* method = im.methods.get(m);
          m = m + 1;
          if method == nil {
            continue;
          }
          fit method.kind {
            .Function(f) -> {
              if !equals(bare_method_name(f.name), name) {
                continue;
              }
              if n.pos.line > best_line {
                best_line = n.pos.line;
                str signature = render_function_named(f, name, false);
                best = _declaration(name, .Function, signature, method.pos);
                best.container = im.type_name;
                found = true;
              }
            }
            _ -> {}
          }
        }
      }
      _ -> {}
    }
  }
  if !found {
    ret .None;
  }
  ret .Some(best);
}

// The type a local or parameter named `name` was declared with, as
// written. Used to resolve what a field is reached through. `tokens`
// is nil where a caller has no token stream to offer (a `fit`
// subject's own type, resolved from the AST alone); a `let`-inferred
// local, whose `detail` otherwise carries the permanent
// `__let_infer__` sentinel forever, only resolves to its real type
// when `tokens` is available to re-run the same best-effort inference
// `inlay_hints.fn` uses to display it.
pub fun type_name_of_local(Vec<Token>* tokens, Vec<Node>* program, str name, str file, num line) str {
  let found = _lookup_local(program, name, file, line);
  if found.is_none() {
    ret "";
  }
  Declaration d = found.unwrap();
  if tokens != nil && starts_with(d.detail, "__let_infer__") {
    let name_tok = token_at(tokens, d.pos.line - 1, d.pos.col - 1);
    if name_tok.is_none() {
      ret "";
    }
    num name_idx = index_of_token(tokens, name_tok.unwrap());
    str inferred = infer_let_local_type(tokens, name_idx, program, file, d.pos.line);
    if equals(inferred, "") {
      ret "";
    }
    ret _bare_type_expr(inferred);
  }
  ret bare_type_from_detail(d.detail);
}

// `type_expr`'s own bare name, with any generic args or pointer
// spelling removed: up to the first `<`, stars stripped. `type_expr`
// is already just a type on its own, not a "Type name" pair (see
// `bare_type_from_detail` for that shape).
fun _bare_type_expr(str type_expr) str {
  str written = type_expr;
  num cut = index_of_char(written, '<');
  if cut > 0 {
    written = substr(written, 0, cut);
  }
  ret trim(replace_char(written, '*', ' '));
}

// The bare declared type of a rendered "Type name" declaration
// detail, with any generic args or pointer spelling removed: what
// precedes the space, up to the first `<`, stars stripped. Shared by
// `type_name_of_local` and `chain_receiver_type`, since a field's own
// `Declaration.detail` reads the same shape a local's does.
pub fun bare_type_from_detail(str detail) str {
  num space = index_of_char(detail, ' ');
  if space <= 0 {
    ret "";
  }
  ret _bare_type_expr(substr(detail, 0, space));
}

// The bare return type of a rendered function/method signature
// ("name(args) RetType"), generics/pointer stripped: everything after
// its own last closing paren. "" for a declared void return, or a
// signature with no return type written at all.
pub fun return_type_from_detail(str signature) str {
  num close = last_index_of_char(signature, ')');
  if close < 0 {
    ret "";
  }
  ret _bare_type_expr(trim(substr(signature, close + 1, len(signature) - close - 1)));
}

// One segment of a dotted chain, closest-to-the-cursor first until
// reversed: a plain field/local name, or a call (`name(...)`, its
// own arguments skipped over), whose type comes from the callee's
// declared return type rather than a field lookup.
compound ChainSeg {
  str name;
  bin is_call;
}

// The index of the `(` matching the `)` at `rparen_idx`, scanning
// backward, depth-tracked.
fun _matching_lparen(Vec<Token>* tokens, num rparen_idx) Option<num> {
  num depth = 0;
  num i = rparen_idx;
  for i >= 0 {
    Token t = tokens.get(i);
    if token_is_symbol(t, ')') {
      depth = depth + 1;
    } elif token_is_operator(t, "(") {
      depth = depth - 1;
      if depth == 0 {
        ret .Some(i);
      }
    }
    i = i - 1;
  }
  ret .None;
}

// `detail` (a rendered "name(args) RetType" signature) with only the
// return type kept, generics and pointer star intact: everything
// after its own closing paren.
fun _return_type_text(str detail) str {
  num close = last_index_of_char(detail, ')');
  if close < 0 {
    ret "";
  }
  ret trim(substr(detail, close + 1, len(detail) - close - 1));
}

// `_return_type_text`, bare (generics/pointer stars stripped,
// matching `bare_type_from_detail`'s own convention) since a chain
// segment's type is looked up by its plain name.
fun _bare_return_type(str detail) str {
  str rtype = _return_type_text(detail);
  num cut = index_of_char(rtype, '<');
  if cut > 0 {
    rtype = substr(rtype, 0, cut);
  }
  ret trim(replace_char(rtype, '*', ' '));
}

// `chain_receiver`'s own result: the type everything before some
// token resolves to, plus whatever generic args that type itself
// carries at that point (a local's own annotation, or a field's/
// method's own declared generic type one hop back), needed by a
// caller that goes on to resolve one more segment past it, since a
// bare type name alone loses the specialization a further method
// call on it would need.
pub compound ChainReceiver {
  str type_name;
  Vec<str> generic_args;
}

// The type at the end of a dotted chain leading up to (but not
// including) `t`: for `a.b.c`, `c`'s own receiver type is whatever
// `b` resolves to on `a`'s declared type, not just `a`'s own type.
pub fun chain_receiver_type(Vec<Token>* tokens, Token t, Vec<Node>* program, str file, num line) str {
  ret chain_receiver(tokens, t, program, file, line).type_name;
}

// `chain_receiver_type`, also carrying the resolved type's own
// generic args. Walks backward through consecutive `ident.ident...`
// segments, including a call anywhere in the chain (`a.f().g`,
// `a.b().c().d`): its own callee's declared return type stands in
// for a field lookup at that step. An index (`x[0].g`) still ends
// the chain one segment short.
pub fun chain_receiver(Vec<Token>* tokens, Token t, Vec<Node>* program, str file, num line) ChainReceiver {
  ChainReceiver empty;
  empty.type_name = "";
  empty.generic_args.init(0);
  Vec<ChainSeg> segments;
  segments.init(4);
  num cursor = index_of_token(tokens, t);
  for cursor > 0 {
    let dot = token_before(tokens, cursor);
    if dot.is_none() || !token_is_operator(dot.unwrap(), ".") {
      break;
    }
    num dot_idx = index_of_token(tokens, dot.unwrap());
    let before_dot = token_before(tokens, dot_idx);
    if before_dot.is_none() {
      break;
    }
    Token seg_tok = before_dot.unwrap();
    bin is_call = false;
    if token_is_symbol(seg_tok, ')') {
      let lparen = _matching_lparen(tokens, index_of_token(tokens, seg_tok));
      if lparen.is_none() {
        break;
      }
      let callee = token_before(tokens, lparen.unwrap());
      if callee.is_none() {
        break;
      }
      fit callee.unwrap().type {
        .Identifier -> {}
        _ -> { break; }
      }
      seg_tok = callee.unwrap();
      is_call = true;
    } else {
      fit seg_tok.type {
        .Identifier -> {}
        _ -> { break; }
      }
    }
    ChainSeg seg;
    seg.name = token_word(seg_tok);
    seg.is_call = is_call;
    segments.push(seg);
    cursor = index_of_token(tokens, seg_tok);
  }
  if segments.len == 0 {
    ret empty;
  }
  // Collected closest-to-`t` first; reverse to left-to-right order.
  num lo = 0;
  num hi = segments.len - 1;
  for lo < hi {
    let tmp = segments.get(lo);
    segments.set(lo, segments.get(hi));
    segments.set(hi, tmp);
    lo = lo + 1;
    hi = hi - 1;
  }
  ChainSeg first = segments.get(0);
  str current_type = "";
  Vec<str> current_args;
  current_args.init(0);
  if first.is_call {
    let f = lookup_top_level(program, first.name);
    if f.is_some() {
      current_type = _bare_return_type(f.unwrap().detail);
      current_args = generic_args_of_detail(_return_type_text(f.unwrap().detail));
    }
  } else {
    current_type = type_name_of_local(tokens, program, first.name, file, line);
    current_args = local_generic_args(tokens, program, first.name, file, line);
  }
  num i = 1;
  for i < segments.len {
    if equals(current_type, "") {
      ret empty;
    }
    ChainSeg seg = segments.get(i);
    if seg.is_call {
      // Threads whatever generic args the receiver carries at this
      // point in the chain (from a local's own annotation, or from a
      // field/method's own declared generic type one step back) into
      // the method lookup, so a stdlib container's own `get`/`unwrap`
      // returns its concrete element type here too, not the bare
      // unspecialized template.
      let m = lookup_method(program, current_type, seg.name, current_args);
      if m.is_none() {
        ret empty;
      }
      current_type = _bare_return_type(m.unwrap().detail);
      current_args = generic_args_of_detail(_return_type_text(m.unwrap().detail));
      i = i + 1;
      continue;
    }
    let field = lookup_field(program, current_type, seg.name);
    if field.is_none() {
      ret empty;
    }
    current_args = generic_args_of_detail(field.unwrap().detail);
    current_type = bare_type_from_detail(field.unwrap().detail);
    i = i + 1;
  }
  ChainReceiver result;
  result.type_name = current_type;
  result.generic_args = current_args;
  ret result;
}

// The type of the whole chain ending at `last_tok`, including it,
// unlike `chain_receiver_type` (which stops one segment short). When
// `last_tok` is itself a call, that's its callee's own declared
// return type, specialized against whatever generic args the rest of
// the chain carries at that point; otherwise it's an ordinary field
// or bare local read.
pub fun chain_ending_type(
  Vec<Token>* tokens,
  Token last_tok,
  bin last_is_call,
  Vec<Node>* program,
  str file,
  num line
) str {
  ret chain_ending_receiver(tokens, last_tok, last_is_call, program, file, line).type_name;
}

// `chain_ending_type`, also carrying the resolved type's own generic
// args (mirroring `chain_receiver_type`/`chain_receiver`'s own split),
// needed by a caller that goes on to resolve a further member against
// the chain's own end rather than just displaying it.
pub fun chain_ending_receiver(
  Vec<Token>* tokens,
  Token last_tok,
  bin last_is_call,
  Vec<Node>* program,
  str file,
  num line
) ChainReceiver {
  ChainReceiver empty;
  empty.type_name = "";
  empty.generic_args.init(0);

  ChainReceiver receiver = chain_receiver(tokens, last_tok, program, file, line);
  str name = token_word(last_tok);
  if equals(receiver.type_name, "") {
    // `last_tok` is the chain's own base: no receiver before it at
    // all, so it's either a bare local or a plain top-level call.
    if last_is_call {
      let f = lookup_top_level(program, name);
      if f.is_none() {
        ret empty;
      }
      empty.type_name = _bare_return_type(f.unwrap().detail);
      empty.generic_args = generic_args_of_detail(_return_type_text(f.unwrap().detail));
      ret empty;
    }
    empty.type_name = type_name_of_local(tokens, program, name, file, line);
    empty.generic_args = local_generic_args(tokens, program, name, file, line);
    ret empty;
  }
  if last_is_call {
    // `receiver`'s own generic args (threaded all the way through by
    // `chain_receiver`, however deep the chain leading to it) are
    // what let a stdlib container's own method resolve its concrete
    // element type here, not just a bare local's.
    let m = lookup_method(program, receiver.type_name, name, receiver.generic_args);
    if m.is_none() {
      ret empty;
    }
    empty.type_name = _bare_return_type(m.unwrap().detail);
    empty.generic_args = generic_args_of_detail(_return_type_text(m.unwrap().detail));
    ret empty;
  }
  let field = lookup_field(program, receiver.type_name, name);
  if field.is_none() {
    ret empty;
  }
  empty.type_name = bare_type_from_detail(field.unwrap().detail);
  empty.generic_args = generic_args_of_detail(field.unwrap().detail);
  ret empty;
}

// The index of the `)` matching the `(` at `lparen_idx`, depth-tracked.
pub fun matching_rparen(Vec<Token>* tokens, num lparen_idx) Option<num> {
  num depth = 0;
  num i = lparen_idx;
  for i < tokens.len {
    Token t = tokens.get(i);
    if token_is_operator(t, "(") {
      depth = depth + 1;
    } elif token_is_symbol(t, ')') {
      depth = depth - 1;
      if depth == 0 {
        ret .Some(i);
      }
    }
    i = i + 1;
  }
  ret .None;
}

// The best-effort inferred type of the `let` local whose own name
// token sits at `name_idx`, read from its initializer, generic args
// included when it has any (`Option<num>`, not just `Option`).
// Shared by `inlay_hints.fn` (a `let`-inferred local's own type
// hint), hover, and `type_name_of_local` (a chain's own receiver,
// when it's a `let`-inferred local resolving further members needs
// its real type, not the permanent `__let_infer__` sentinel
// `d.detail` otherwise carries; that caller strips generic args back
// off immediately after, so carrying them here costs it nothing).
pub fun infer_let_local_type(
  Vec<Token>* tokens,
  num name_idx,
  Vec<Node>* program,
  str file,
  num line
) str {
  Vec<str> args;
  args.init(2);
  defer args.free();
  str base = infer_let_local_type_with_args(tokens, name_idx, program, file, line, &args);
  if equals(base, "") || args.len == 0 {
    ret base;
  }
  StringBuilder b = string_builder_init(32);
  b.append(base);
  b.append("<");
  num i = 0;
  for i < args.len {
    if i > 0 {
      b.append(", ");
    }
    b.append(args.get(i));
    i = i + 1;
  }
  b.append(">");
  ret b.build();
}

// `infer_let_local_type`, also writing the resolved type's own generic
// args into `out_args` when it isn't nil (a caller not needing them,
// the overwhelming majority, passes nil and pays nothing extra).
// Needed by `local_generic_args`'s own `__let_infer__` fallback, the
// same way `type_name_of_local` already falls back to
// `infer_let_local_type` itself for the bare type name.
pub fun infer_let_local_type_with_args(
  Vec<Token>* tokens,
  num name_idx,
  Vec<Node>* program,
  str file,
  num line,
  Vec<str>* out_args
) str {
  let eq_tok_opt = token_after(tokens, name_idx + 1);
  if eq_tok_opt.is_none() || !token_is_operator(eq_tok_opt.unwrap(), "=") {
    ret "";
  }
  num eq_idx = index_of_token(tokens, eq_tok_opt.unwrap());
  let val_tok_opt = token_after(tokens, eq_idx + 1);
  if val_tok_opt.is_none() {
    ret "";
  }
  ret _infer_type(tokens, val_tok_opt.unwrap(), program, file, line, out_args);
}

// A best-effort read of `val_tok`'s own type, when it's the first
// token of a `let`'s initializer: a literal's own type directly, or
// (for a plain or method call) the callee's own declared return type.
// "" for any other shape: a binary expression, an already-typed
// local read back, a compound literal, and so on aren't covered.
// `out_args`: see `infer_let_local_type_with_args`.
fun _infer_type(Vec<Token>* tokens, Token val_tok, Vec<Node>* program, str file, num line, Vec<str>* out_args) str {
  fit val_tok.type {
    .Number -> {
      fit val_tok.data {
        .Dec(_) -> { ret "dec"; }
        .Cval(_) -> { ret "chr"; }
        _ -> { ret "num"; }
      }
    }
    .String -> { ret "str"; }
    .Boolean -> { ret "bin"; }
    .Identifier -> {
      str name = token_word(val_tok);
      num idx = index_of_token(tokens, val_tok);

      // Walks the whole chain forward from `val_tok` (`a.b.c()`,
      // `a().b`, any mix, any length), tracking the last segment
      // reached and whether it's itself a call, then hands off to
      // chain_ending_type for the actual resolution: a receiver's
      // own field/method, a plain top-level call, or (no chain at
      // all) the bare read handled below.
      Token last_tok = val_tok;
      bin last_is_call = false;
      num cursor_idx = idx;
      let after0 = token_after(tokens, cursor_idx + 1);
      if after0.is_some() && token_is_operator(after0.unwrap(), "(") {
        last_is_call = true;
        let rparen0 = matching_rparen(tokens, index_of_token(tokens, after0.unwrap()));
        if rparen0.is_some() {
          cursor_idx = rparen0.unwrap();
        }
      }
      for true {
        let dot_opt = token_after(tokens, cursor_idx + 1);
        if dot_opt.is_none() || !token_is_operator(dot_opt.unwrap(), ".") {
          break;
        }
        num dot_idx = index_of_token(tokens, dot_opt.unwrap());
        let member_opt = token_after(tokens, dot_idx + 1);
        if member_opt.is_none() {
          break;
        }
        fit member_opt.unwrap().type {
          .Identifier -> {}
          _ -> { break; }
        }
        last_tok = member_opt.unwrap();
        last_is_call = false;
        cursor_idx = index_of_token(tokens, last_tok);
        let after_opt = token_after(tokens, cursor_idx + 1);
        if after_opt.is_some() && token_is_operator(after_opt.unwrap(), "(") {
          last_is_call = true;
          let rparen = matching_rparen(tokens, index_of_token(tokens, after_opt.unwrap()));
          if rparen.is_some() {
            cursor_idx = rparen.unwrap();
          }
        }
      }
      if index_of_token(tokens, last_tok) != idx || last_is_call {
        let ending = chain_ending_receiver(tokens, last_tok, last_is_call, program, file, line);
        if out_args != nil {
          *out_args = ending.generic_args;
        }
        ret ending.type_name;
      }

      // A bare read of an already-typed local/field/parameter/global
      // (`let c = a;`): whatever `a` itself was declared as, in full
      // (a pointer star or generic argument matters here, unlike
      // `type_name_of_local`'s bare form, which exists for looking a
      // further member up rather than for display). `a` may itself be
      // a `let` local this same heuristic couldn't resolve, in which
      // case its own recorded type is the raw sentinel rather than a
      // real one, shown as no hint rather than leaked verbatim.
      let existing = lookup(program, name, file, line);
      if existing.is_none() {
        ret "";
      }
      str existing_type = _full_declared_type(existing.unwrap());
      if equals(existing_type, "__let_infer__") {
        ret "";
      }
      ret existing_type;
    }
    _ -> { ret ""; }
  }
}

// `d`'s own declared type, spelled in full (pointer star, generic
// args, everything): whatever precedes `d`'s own name in its
// rendered "Type name" detail.
fun _full_declared_type(Declaration d) str {
  num name_len = len(d.name);
  if len(d.detail) <= name_len {
    ret "";
  }
  ret trim(substr(d.detail, 0, len(d.detail) - name_len));
}

// A parameter or local of the function containing `line` in `file`.
fun _lookup_local(Vec<Node>* program, str name, str file, num line) Option<Declaration> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Function(f) -> {
        if !covers(n, f, file, line) {
          continue;
        }
        let found = _lookup_in_function(f, name, program, file, line);
        if found.is_some() {
          ret found;
        }
      }
      .Impl(im) -> {
        num mi = 0;
        for mi < im.methods.len {
          Node* m = im.methods.get(mi);
          mi = mi + 1;
          if m == nil {
            continue;
          }
          fit m.kind {
            .Function(f) -> {
              if !covers(*m, f, file, line) {
                continue;
              }
              let found = _lookup_in_function(f, name, program, file, line);
              if found.is_some() {
                ret found;
              }
            }
            _ -> {}
          }
        }
      }
      .Test(td) -> {
        if !covers_body(n, td.body, file, line) {
          continue;
        }
        let found = _lookup_in_body(td.body, name, program, file, line);
        if found.is_some() {
          ret found;
        }
        let found_binding = _lookup_fit_binding(td.body, name, program, file, line);
        if found_binding.is_some() {
          ret found_binding;
        }
      }
      .Fuzz(fz) -> {
        if !covers_body(n, fz.body, file, line) {
          continue;
        }
        let param = _fuzz_param_named(fz, name);
        if param.is_some() {
          ret param;
        }
        let found = _lookup_in_body(fz.body, name, program, file, line);
        if found.is_some() {
          ret found;
        }
        let found_binding = _lookup_fit_binding(fz.body, name, program, file, line);
        if found_binding.is_some() {
          ret found_binding;
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// `fz`'s own `data`/`len` parameter, if it is spelled `name`. A
// `fuzz` block's two parameters aren't in a `Vec<Node*>` the way a
// function's are, just two direct fields, so they're checked by hand
// rather than through `_lookup_in_function`'s own arg loop.
fun _fuzz_param_named(FuzzDeclNode fz, str name) Option<Declaration> {
  if fz.data_param != nil {
    fit fz.data_param.kind {
      .Variable(v) -> {
        if equals(v.name, name) {
          ret .Some(_declaration(name, .Parameter, _render_param(fz.data_param), fz.data_param.pos));
        }
      }
      _ -> {}
    }
  }
  if fz.len_param != nil {
    fit fz.len_param.kind {
      .Variable(v) -> {
        if equals(v.name, name) {
          ret .Some(_declaration(name, .Parameter, _render_param(fz.len_param), fz.len_param.pos));
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// `name` as a parameter or local of `f`, whether declared directly at
// the top level or reached as one of an impl block's own methods
// (which are `FunctionNode`s just the same, only nested one level
// deeper in the program's own node list).
fun _lookup_in_function(FunctionNode f, str name, Vec<Node>* program, str file, num line) Option<Declaration> {
  num a = 0;
  for a < f.args.len {
    Node* arg = f.args.get(a);
    a = a + 1;
    if arg == nil {
      continue;
    }
    fit arg.kind {
      .Variable(v) -> {
        if equals(v.name, name) {
          ret .Some(_declaration(name, .Parameter, _render_param(arg), arg.pos));
        }
      }
      _ -> {}
    }
  }
  if f.has_body {
    let found = _lookup_in_body(f.body, name, program, file, line);
    if found.is_some() {
      ret found;
    }
    let found_binding = _lookup_fit_binding(f.body, name, program, file, line);
    if found_binding.is_some() {
      ret found_binding;
    }
  }
  ret .None;
}

// The enclosing function or impl method's own declared return type,
// unstripped, so a caller can resolve a generic instantiation's
// concrete type arguments rather than just its bare template name
// (`Result<str, Error>`'s own `str`/`Error`, not just `Result`).
// `.None` when `line` isn't inside a function with a declared,
// non-void return type.
pub fun enclosing_return_dtype(Vec<Node>* program, str file, num line) Option<DataType*> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Function(f) -> {
        if !covers(n, f, file, line) {
          continue;
        }
        if !f.has_rtype {
          ret .None;
        }
        ret .Some(f.rtype);
      }
      .Impl(im) -> {
        num mi = 0;
        for mi < im.methods.len {
          Node* m = im.methods.get(mi);
          mi = mi + 1;
          if m == nil {
            continue;
          }
          fit m.kind {
            .Function(mf) -> {
              if !covers(*m, mf, file, line) {
                continue;
              }
              if !mf.has_rtype {
                ret .None;
              }
              ret .Some(mf.rtype);
            }
            _ -> {}
          }
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// True when `line` falls inside the function `f` declared by `n`, in
// the file being asked about. Shared with `completion.fn`, which
// needs the exact same coverage test to scope what it offers to the
// function the cursor actually sits in.
pub fun covers(Node n, FunctionNode f, str file, num line) bin {
  if !f.has_body {
    ret false;
  }
  ret covers_body(n, f.body, file, line);
}

// The same test as `covers`, for a declaration whose body isn't
// wrapped in a `FunctionNode` (a `test`/`fuzz` block, which has no
// return type or generic params of its own to carry one).
pub fun covers_body(Node n, Node* body, str file, num line) bin {
  if !n.has_pos || !equals(n.pos.filename, file) {
    ret false;
  }
  if line < n.pos.line {
    ret false;
  }
  if body == nil {
    ret false;
  }
  num last = _last_line(body);
  ret line <= last;
}

// The furthest line any of `c`'s own fields reaches, standing in for
// where the whole compound itself ends - the same reach `im`'s own
// methods give `_impl_last_line`, needed for the identical reason: a
// same-named bare identifier written later in the file, in an
// unrelated function, must not resolve to this compound's own field
// just because it happens to be the nearest declaration above.
fun _compound_last_line(CompoundNode c) num {
  num last = 0;
  num f = 0;
  for f < c.fields.len {
    CompoundField cf = c.fields.get(f);
    f = f + 1;
    if cf.has_pos && cf.pos.line > last {
      last = cf.pos.line;
    }
  }
  ret last;
}

// `_compound_last_line`'s own twin for an enum's own variants.
fun _enum_last_line(EnumDeclNode e) num {
  num last = 0;
  num v = 0;
  for v < e.variants.len {
    EnumVariant variant = e.variants.get(v);
    v = v + 1;
    if variant.has_pos && variant.pos.line > last {
      last = variant.pos.line;
    }
  }
  ret last;
}

// The furthest line any of `im`'s own methods reaches, standing in
// for where the whole impl block itself ends.
fun _impl_last_line(ImplNode im) num {
  num last = 0;
  num m = 0;
  for m < im.methods.len {
    Node* method = im.methods.get(m);
    m = m + 1;
    if method == nil {
      continue;
    }
    fit method.kind {
      .Function(f) -> {
        // The method's own declaration line is always a valid floor,
        // even when its body's own position never got set (a
        // trivially empty `{}` body, `_last_line`'s scan finding
        // nothing to seed from): a hover sitting exactly on that
        // line must not be pushed out of coverage by an unreliable
        // body position.
        num reach = 0;
        if method.has_pos {
          reach = method.pos.line;
        }
        if f.has_body && f.body != nil {
          num body_reach = _last_line(f.body);
          if body_reach > reach {
            reach = body_reach;
          }
        }
        if reach > last {
          last = reach;
        }
      }
      _ -> {}
    }
  }
  ret last;
}

// The last line any statement of `body` reaches, which stands in for
// where the function ends.
fun _last_line(Node* body) num {
  num last = 0;
  if body == nil {
    ret last;
  }
  if body.has_pos {
    last = body.pos.end_line;
    if last == 0 {
      last = body.pos.line;
    }
  }
  fit body.kind {
    .Body(b) -> {
      num i = 0;
      for i < b.statements.len {
        Node* s = b.statements.get(i);
        i = i + 1;
        if s == nil {
          continue;
        }
        if s.has_pos {
          num reach = s.pos.end_line;
          if reach == 0 {
            reach = s.pos.line;
          }
          if reach > last {
            last = reach;
          }
        }
        // A container statement's own `pos` only ever covers its
        // leading token (see parse_if_statement/parse_fit_statement
        // et al) - the real last line lives inside whatever body it
        // carries, so descend into it too.
        let nested = single_nested_body(s);
        if nested.is_some() {
          num nested_last = _last_line(nested.unwrap());
          if nested_last > last {
            last = nested_last;
          }
        }
        fit s.kind {
          .StatementFit(f) -> {
            num bi = 0;
            for bi < f.branches.len {
              FitBranch br = f.branches.get(bi);
              bi = bi + 1;
              num branch_last = _last_line(br.body);
              if branch_last > last {
                last = branch_last;
              }
            }
          }
          _ -> {}
        }
      }
    }
    _ -> {}
  }
  ret last;
}

// A variable declared anywhere in `body`, including inside a nested
// block, since a name is in scope for everything that follows it.
fun _lookup_in_body(Node* body, str name, Vec<Node>* program, str file, num line) Option<Declaration> {
  if body == nil {
    ret .None;
  }
  fit body.kind {
    .Variable(v) -> {
      if equals(v.name, name) {
        StringBuilder b = string_builder_init(32);
        b.append(render_type(v.var_type));
        b.append(" ");
        b.append(v.name);
        ret .Some(_declaration(name, .Local, b.build(), body.pos));
      }
    }
    .Body(block) -> {
      num i = 0;
      for i < block.statements.len {
        let found = _lookup_in_body(block.statements.get(i), name, program, file, line);
        if found.is_some() {
          ret found;
        }
        i = i + 1;
      }
    }
    .StatementFit(fs) -> {
      num i = 0;
      for i < fs.branches.len {
        FitBranch branch = fs.branches.get(i);
        i = i + 1;
        let found = _lookup_in_body(branch.body, name, program, file, line);
        if found.is_some() {
          ret found;
        }
      }
    }
    // A `for`'s own loop variable (`item`/`index` in `for item : xs`,
    // `for i, item :: xs`, or `index` in `for i : a..b`) is bound by
    // the statement itself, not declared inside its body the way an
    // ordinary local is - checked here before recursing in, the same
    // shape a fit's own destructuring bindings already get above.
    .StatementFor(fk) -> {
      fit fk {
        .Range(fr) -> {
          if equals(fr.index_name, name) {
            ret .Some(_declaration(name, .Local, format("num {str}", name), body.pos));
          }
          ret _lookup_in_body(fr.body, name, program, file, line);
        }
        .Iter(fi) -> {
          if fi.has_index_name && equals(fi.index_name, name) {
            ret .Some(_declaration(name, .Local, format("num {str}", name), body.pos));
          }
          if equals(fi.item_name, name) {
            str item_type = _for_iter_item_type(fi.iterable, program, file, line);
            str detail = name;
            if !equals(item_type, "") {
              detail = format("{str} {str}", item_type, name);
            }
            ret .Some(_declaration(name, .Local, detail, body.pos));
          }
          ret _lookup_in_body(fi.body, name, program, file, line);
        }
        .Cond(fc) -> { ret _lookup_in_body(fc.body, name, program, file, line); }
      }
    }
    _ -> {
      let nested = single_nested_body(body);
      if nested.is_some() {
        ret _lookup_in_body(nested.unwrap(), name, program, file, line);
      }
    }
  }
  ret .None;
}

// A for-each loop's own iterable, best-effort: a bare local's own
// declared generic argument (`Vec<num> nums` -> `num`), the common
// shape. "" for anything deeper (a chain, a call), matching this
// file's own established scope for AST-only, token-free inference
// elsewhere (`fit_subject_type` and its own siblings).
pub fun _for_iter_item_type(Node* iterable, Vec<Node>* program, str file, num line) str {
  if iterable == nil {
    ret "";
  }
  fit iterable.kind {
    .Identifier(s) -> {
      let found = _lookup_local(program, s, file, line);
      if found.is_none() {
        ret "";
      }
      Vec<str> args = generic_args_of_detail(found.unwrap().detail);
      if args.len == 0 {
        ret "";
      }
      ret args.get(0);
    }
    _ -> { ret ""; }
  }
}

// The type name of an arbitrary expression, as far as `fit_subject_type`
// needs to resolve one: a bare identifier's own declared type, or (for
// `base.field`) `base`'s own type resolved the same way, then that
// field's own declared type on it. Covers the shape a fit subject most
// commonly takes in this codebase's own source (`fit n.kind { ... }`,
// `fit node.data { ... }`), which a bare identifier alone never did.
// "" for anything deeper (a call, an index, a chain more than one dot
// long) — narrower than `chain_ending_type`'s own token-based walk on
// purpose, since this operates on the already-parsed AST a fit
// statement carries, not a token stream.
fun _expr_type_name(Vec<Token>* tokens, Vec<Node>* program, Node* expr, str file, num line) str {
  if expr == nil {
    ret "";
  }
  fit expr.kind {
    .Identifier(s) -> { ret type_name_of_local(tokens, program, s, file, line); }
    .Expression(fe) -> {
      if !equals(fe.op, ".") || !fe.has_left || fe.left == nil || !fe.has_right || fe.right == nil {
        ret "";
      }
      str base_type = _expr_type_name(tokens, program, fe.left, file, line);
      if equals(base_type, "") {
        ret "";
      }
      fit fe.right.kind {
        .Identifier(field_name) -> {
          let field = lookup_field(program, base_type, field_name);
          if field.is_none() {
            ret "";
          }
          ret bare_type_from_detail(field.unwrap().detail);
        }
        _ -> { ret ""; }
      }
    }
    _ -> { ret ""; }
  }
}

// The enum type name a `fit` statement's subject expression resolves
// to: a bare local/parameter subject's own declared type, a
// `base.field` subject's own field type (see `_expr_type_name`), or,
// for `fit <- ch { ... }` (desugared at parse time to `ch.recv()`, a
// call whose callee is `ch`'s own `.recv` method access), the
// channel's element type. Anything else yields "".
pub fun fit_subject_type(Vec<Token>* tokens, Vec<Node>* program, Node* subject, str file, num line) str {
  if subject == nil {
    ret "";
  }
  fit subject.kind {
    .Identifier(s) -> { ret type_name_of_local(tokens, program, s, file, line); }
    .Expression(e) -> {
      if equals(e.op, ".") {
        ret _expr_type_name(tokens, program, subject, file, line);
      }
      if !equals(e.op, "()") || !e.has_left || e.left == nil {
        ret "";
      }
      fit e.left.kind {
        .Expression(callee) -> {
          if !equals(callee.op, ".") || !callee.has_right || callee.right == nil {
            ret "";
          }
          if !callee.has_left || callee.left == nil {
            ret "";
          }
          bin is_recv = false;
          fit callee.right.kind {
            .Identifier(m) -> {
              if equals(m, "recv") {
                is_recv = true;
              }
            }
            _ -> {}
          }
          if !is_recv {
            ret "";
          }
          fit callee.left.kind {
            .Identifier(chan_name) -> {
              ret _first_generic_arg_of_local(program, chan_name, file, line);
            }
            _ -> {}
          }
        }
        _ -> {}
      }
    }
    _ -> {}
  }
  ret "";
}

// `fit_subject_type`'s own concrete generic args, when the subject is
// a bare local/parameter carrying them directly (`fit b { ... }` for
// `b: Box<str>`) - the common case, and the one a `fit`'s own variant
// hover most needs. "" for the field-access and channel-receive
// shapes `fit_subject_type` also covers, matching what
// `local_generic_args` itself only resolves for a bare identifier.
pub fun fit_subject_generic_args(Vec<Token>* tokens, Vec<Node>* program, Node* subject, str file, num line) Vec<str> {
  Vec<str> empty;
  empty.init(0);
  if subject == nil {
    ret empty;
  }
  fit subject.kind {
    .Identifier(s) -> { ret local_generic_args(tokens, program, s, file, line); }
    _ -> { ret empty; }
  }
}

// The first generic type argument of local/parameter `name`'s own
// declared type, as written (`Job` from `Channel<Job>`). "" when
// `name` isn't found, or its declared type isn't generic.
fun _first_generic_arg_of_local(Vec<Node>* program, str name, str file, num line) str {
  let found = _lookup_local(program, name, file, line);
  if found.is_none() {
    ret "";
  }
  Declaration d = found.unwrap();
  num open = index_of_char(d.detail, '<');
  if open < 0 {
    ret "";
  }
  num depth = 0;
  num i = open;
  num n = len(d.detail);
  num end = -1;
  for i < n {
    chr c = d.detail[i];
    if c == '<' {
      depth = depth + 1;
    } elif c == '>' {
      depth = depth - 1;
      if depth == 0 {
        end = i;
        break;
      }
    } elif c == ',' && depth == 1 {
      end = i;
      break;
    }
    i = i + 1;
  }
  if end < 0 {
    ret "";
  }
  ret trim(substr(d.detail, open + 1, end - open - 1));
}

// The body of whichever function-like construct - a plain function,
// an impl method, a test, or a fuzz block, the same set `_lookup_local`
// enumerates for a local's own scope - covers `line` in `file`. Shared
// so a caller only cares "what body am I inside," not which of the
// four shapes got it there.
pub fun enclosing_body(Vec<Node>* program, str file, num line) Option<Node*> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Function(f) -> {
        if covers(n, f, file, line) && f.has_body {
          ret .Some(f.body);
        }
      }
      .Impl(im) -> {
        num mi = 0;
        for mi < im.methods.len {
          Node* m = im.methods.get(mi);
          mi = mi + 1;
          if m == nil {
            continue;
          }
          fit m.kind {
            .Function(f) -> {
              if covers(*m, f, file, line) && f.has_body {
                ret .Some(f.body);
              }
            }
            _ -> {}
          }
        }
      }
      .Test(td) -> {
        if covers_body(n, td.body, file, line) {
          ret .Some(td.body);
        }
      }
      .Fuzz(fz) -> {
        if covers_body(n, fz.body, file, line) {
          ret .Some(fz.body);
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// The `fit` statement, among every function-like body in the program
// (not just a plain function's - an impl method's, a test's, or a
// fuzz block's own body can carry one just as well), whose braces
// cover `line` in `file`.
pub fun covering_fit(Vec<Node>* program, str file, num line) Option<Node*> {
  let body = enclosing_body(program, file, line);
  if body.is_none() {
    ret .None;
  }
  ret _find_covering_fit(body.unwrap(), line);
}

// Descends into every nested block a statement can hide one inside,
// looking for a `fit` whose overall span (from its own line through
// the last line any of its branches reaches) covers `line`.
fun _find_covering_fit(Node* body, num line) Option<Node*> {
  if body == nil {
    ret .None;
  }
  fit body.kind {
    .StatementFit(f) -> {
      // A branch's own body can hide another `fit` (matching a
      // nested field, say), whose own span always sits inside this
      // one's - checking it first means the deepest, most specific
      // fit statement wins, instead of every line inside any nested
      // fit incorrectly resolving against this outer one's subject.
      num bi2 = 0;
      for bi2 < f.branches.len {
        FitBranch br2 = f.branches.get(bi2);
        bi2 = bi2 + 1;
        let nested = _find_covering_fit(br2.body, line);
        if nested.is_some() {
          ret nested;
        }
      }
      num last = 0;
      num bi = 0;
      for bi < f.branches.len {
        FitBranch br = f.branches.get(bi);
        bi = bi + 1;
        num reach = _last_line(br.body);
        if reach > last {
          last = reach;
        }
      }
      num start = 0;
      if body.has_pos {
        start = body.pos.line;
      }
      if line >= start && line <= last {
        ret .Some(body);
      }
    }
    .Body(block) -> {
      num i = 0;
      for i < block.statements.len {
        let found = _find_covering_fit(block.statements.get(i), line);
        if found.is_some() {
          ret found;
        }
        i = i + 1;
      }
    }
    _ -> {
      let nested = single_nested_body(body);
      if nested.is_some() {
        ret _find_covering_fit(nested.unwrap(), line);
      }
    }
  }
  ret .None;
}

// The body of any of the three `for` loop shapes, so a caller
// recursing through a function's statements doesn't need its own
// three-way match just to keep descending.
// The body of a `for` loop, whichever of the three shapes (bare
// condition, range, or iterator) it was parsed as. Shared with
// `completion.fn`, which needs the same descent to collect every
// local in scope, not just look one up.
pub fun for_body(ForKind fk) Node* {
  fit fk {
    .Cond(c) -> { ret c.body; }
    .Range(r) -> { ret r.body; }
    .Iter(it) -> { ret it.body; }
  }
}

// The single nested body a statement kind recurses into, for every
// shape that has exactly one and nothing else special about it - if,
// elif, else, defer (the block form), for. `.Body` (many statements)
// and `.StatementFit` (many branches, plus each one's own payload
// bindings) need their own handling and are deliberately not folded
// in here.
// 
// This is the one place that enumerates "which statement kinds carry
// a nested body" for every fls walker that needs to recurse into a
// function's own body looking for something (a local's own
// declaration, a covering fit, a fit's own binding, every local in
// scope for completion) - previously each of those four walkers
// listed if/elif/else/defer/for by hand, and StatementElseIf/
// StatementDefer were each missing from three of the four before
// being found and fixed one at a time. codegen.fn's own
// node_contains_fork enumerates this identical set of kinds for a
// different purpose (whether a fork sits anywhere inside a body) -
// cross-checked against it as the source of truth for what "every
// body-carrying statement kind" actually means in this language.
pub fun single_nested_body(Node* node) Option<Node*> {
  if node == nil {
    ret .None;
  }
  fit node.kind {
    .StatementIf(s) -> { ret .Some(s.body); }
    .StatementElseIf(ein) -> { ret .Some(ein.body); }
    .StatementElse(inner) -> { ret .Some(inner); }
    .StatementDefer(inner) -> { ret .Some(inner); }
    .StatementFor(fk) -> { ret .Some(for_body(fk)); }
    _ -> { ret .None; }
  }
}

// The declaration of `variant_name`, one of `enum_name`'s own
// variants, rendered as a reader would write its own pattern (bare,
// or with its payload types in parens).
pub fun enum_variant_declaration(
  Vec<Node>* program,
  str enum_name,
  str variant_name,
  Vec<str> concrete_args
) Option<Declaration> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Enum(e) -> {
        if !equals(e.name, enum_name) {
          continue;
        }
        num v = 0;
        for v < e.variants.len {
          EnumVariant variant = e.variants.get(v);
          v = v + 1;
          if !equals(variant.name, variant_name) {
            continue;
          }
          StringBuilder b = string_builder_init(24);
          b.append(variant.name);
          if variant.has_payload && variant.payload.len > 0 {
            b.append("(");
            num p = 0;
            for p < variant.payload.len {
              if p > 0 {
                b.append(", ");
              }
              b.append(render_type(variant.payload.get(p)));
              p = p + 1;
            }
            b.append(")");
          }
          Pos variant_pos = n.pos;
          if variant.has_pos {
            variant_pos = variant.pos;
          }
          // Substituted against the enum's own concrete generic args
          // when the caller has them (a fit's own subject, resolved
          // via fit_subject_generic_args), so a payload declared as a
          // bare type param in the template (`Ok(T)`) reads as the
          // subject's actual type (`Ok(str)`) the same way
          // enum_variant_declaration_typed already does for a ret
          // value's own declared type. A length mismatch (no concrete
          // args known) leaves it as declared, template params and
          // all, matching every existing caller's own behavior.
          str detail = specialize_signature(b.build(), e.type_params, concrete_args);
          detail = format("{str} = {num}", detail, _variant_ordinal(e, v - 1));
          Declaration d = _declaration(variant_name, .Variant, detail, variant_pos);
          d.container = enum_name;
          ret .Some(d);
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// Like `enum_variant_declaration`, but resolved against `dt`'s own
// concrete generic arguments (`Result<str, Error>`'s `str`/`Error`),
// so a payload declared as a bare type param in the template (`Ok(T)`)
// renders as the caller's actual concrete type (`Ok(str)`) rather
// than the template's own param name. A payload that isn't a bare
// type param (already concrete, or itself a further generic
// instantiation) renders as declared, unsubstituted.
pub fun enum_variant_declaration_typed(Vec<Node>* program, DataType* dt, str variant_name) Option<Declaration> {
  if dt == nil {
    ret .None;
  }
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Enum(e) -> {
        if !equals(e.name, dt.type_str) {
          continue;
        }
        num v = 0;
        for v < e.variants.len {
          EnumVariant variant = e.variants.get(v);
          v = v + 1;
          if !equals(variant.name, variant_name) {
            continue;
          }
          StringBuilder b = string_builder_init(24);
          b.append(variant.name);
          if variant.has_payload && variant.payload.len > 0 {
            b.append("(");
            num p = 0;
            for p < variant.payload.len {
              if p > 0 {
                b.append(", ");
              }
              b.append(_substituted_payload_type(
                variant.payload.get(p),
                e.type_params,
                dt.generic_args
              ));
              p = p + 1;
            }
            b.append(")");
          }
          str typed_detail = format("{str} = {num}", b.build(), _variant_ordinal(e, v - 1));
          Declaration d = _declaration(variant_name, .Variant, typed_detail, n.pos);
          d.container = e.name;
          ret .Some(d);
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// The ordinal `e`'s variant at `index` (0-indexed) is tagged with:
// its own explicit `= N` when written, otherwise one past whatever
// the variant before it resolved to (0 for the very first), the
// same auto-increment rule an ordinary C-style enum follows.
// Payload or not - a data-carrying variant can still be given its
// own explicit tag (`Circle(num) = 3`), and the auto-incremented one
// is just as fixed at compile time either way.
fun _variant_ordinal(EnumDeclNode e, num index) num {
  num running = 0;
  num i = 0;
  for i <= index {
    EnumVariant variant = e.variants.get(i);
    if variant.has_value {
      running = variant.value;
    }
    if i == index {
      ret running;
    }
    running = running + 1;
    i = i + 1;
  }
  ret running;
}

// `payload`'s own rendered type, substituted with the matching entry
// of `concrete_args` when `payload` is written as a bare type param
// name found in `type_params` (positional match). Renders as-is
// otherwise.
fun _substituted_payload_type(DataType* payload, Vec<str> type_params, Vec<DataType*> concrete_args) str {
  if payload == nil {
    ret "";
  }
  if payload.generic_args.len == 0 {
    num i = 0;
    for i < type_params.len {
      if equals(type_params.get(i), payload.type_str) && i < concrete_args.len {
        ret render_type(concrete_args.get(i));
      }
      i = i + 1;
    }
  }
  ret render_type(payload);
}

// The declaration of a bare `.VariantName` (or a fit destructuring
// pattern's own qualified `Enum.VariantName`) written at `line` in
// `file`, resolved against the enclosing `fit` statement's subject
// type.
pub fun lookup_fit_variant(Vec<Token>* tokens, Vec<Node>* program, str name, str file, num line) Option<Declaration> {
  let found = covering_fit(program, file, line);
  if found.is_none() {
    ret .None;
  }
  fit found.unwrap().kind {
    .StatementFit(f) -> {
      str enum_name = fit_subject_type(tokens, program, f.exp, file, line);
      if equals(enum_name, "") {
        ret .None;
      }
      ret enum_variant_declaration(
        program,
        enum_name,
        name,
        fit_subject_generic_args(tokens, program, f.exp, file, line)
      );
    }
    _ -> {}
  }
  ret .None;
}

// The variant name a fit branch's own condition names, when it is a
// data-carrying destructuring pattern (`.Circle(r)` or
// `Shape.Circle(r)`): the identifier `_try_parse_fit_destructure`
// builds as the right side of the condition's `.` expression.
pub fun branch_variant_name(FitBranch br) str {
  if !br.has_condition || br.condition == nil {
    ret "";
  }
  fit br.condition.kind {
    .Expression(e) -> {
      if equals(e.op, ".") && e.has_right && e.right != nil {
        fit e.right.kind {
          .Identifier(s) -> { ret s; }
          _ -> {}
        }
      }
    }
    _ -> {}
  }
  ret "";
}

// The payload type at position `idx` of `enum_name`'s variant named
// `variant_name`, rendered as a reader would write it.
pub fun variant_payload_type(Vec<Node>* program, str enum_name, str variant_name, num idx) Option<str> {
  num i = 0;
  for i < program.len {
    Node n = program.get(i);
    i = i + 1;
    fit n.kind {
      .Enum(e) -> {
        if !equals(e.name, enum_name) {
          continue;
        }
        num v = 0;
        for v < e.variants.len {
          EnumVariant variant = e.variants.get(v);
          v = v + 1;
          if !equals(variant.name, variant_name) {
            continue;
          }
          if idx < 0 || idx >= variant.payload.len {
            ret .None;
          }
          ret .Some(render_type(variant.payload.get(idx)));
        }
      }
      _ -> {}
    }
  }
  ret .None;
}

// A fit arm's own payload binding named `name`, if `line` falls
// within that arm: its pattern through the end of its body. Its type
// is the matching positional payload type of whichever variant the
// arm's own condition names, resolved against the fit's subject.
fun _lookup_fit_binding(Node* body, str name, Vec<Node>* program, str file, num line) Option<Declaration> {
  if body == nil {
    ret .None;
  }
  fit body.kind {
    .Body(block) -> {
      num i = 0;
      for i < block.statements.len {
        let found = _lookup_fit_binding(block.statements.get(i), name, program, file, line);
        if found.is_some() {
          ret found;
        }
        i = i + 1;
      }
    }
    .StatementFit(f) -> {
      num bi = 0;
      for bi < f.branches.len {
        FitBranch br = f.branches.get(bi);
        bi = bi + 1;
        num start = 0;
        if br.has_condition && br.condition != nil && br.condition.has_pos {
          start = br.condition.pos.line;
        } elif br.body != nil && br.body.has_pos {
          start = br.body.pos.line;
        }
        num last = _last_line(br.body);
        bin covers = line >= start && line <= last;
        if covers && br.has_bindings {
          num idx = -1;
          num k = 0;
          for k < br.bindings.len {
            if equals(br.bindings.get(k), name) {
              idx = k;
            }
            k = k + 1;
          }
          if idx >= 0 {
            // `nil`, not the real token stream: `_lookup_fit_binding`
            // is reached through `_lookup_local`, which has no tokens
            // of its own to thread here (a deeper, separate gap - see
            // `lookup_fit_variant`'s own `tokens` param for the
            // shallow case this was fixed for).
            str enum_name = fit_subject_type(nil, program, f.exp, file, line);
            if !equals(enum_name, "") {
              let payload_type = variant_payload_type(
                program,
                enum_name,
                branch_variant_name(br),
                idx
              );
              if payload_type.is_some() && br.body != nil {
                StringBuilder b = string_builder_init(24);
                b.append(payload_type.unwrap());
                b.append(" ");
                b.append(name);
                // Neither AST node here carries the individual binding
                // name's own position (bindings are plain strings,
                // Vec<str>, with nothing parallel tracking where each
                // one was written) and a fit arm's body block isn't
                // always given its own position by the parser either
                // (has_pos can read false, its fields then unset stack
                // garbage) - but the arm's own pattern expression
                // (`.Circle(r)` itself, `condition` here despite the
                // name, which also doubles as a boolean guard on a
                // non-destructuring arm) reliably is, and starts right
                // at the binding it names, close enough to be useful
                // for a jump even without landing on `r` exactly.
                // Falls back to the whole fit statement's own position
                // only when neither is available.
                Pos decl_pos = body.pos;
                if br.body.has_pos {
                  decl_pos = br.body.pos;
                }
                if br.has_condition && br.condition != nil && br.condition.has_pos {
                  decl_pos = br.condition.pos;
                }
                ret .Some(_declaration(name, .Local, b.build(), decl_pos));
              }
            }
          }
        }
        let nested = _lookup_fit_binding(br.body, name, program, file, line);
        if nested.is_some() {
          ret nested;
        }
      }
    }
    _ -> {
      let single = single_nested_body(body);
      if single.is_some() {
        ret _lookup_fit_binding(single.unwrap(), name, program, file, line);
      }
    }
  }
  ret .None;
}

pub fun _declaration(str name, DeclarationKind kind, str detail, Pos pos) Declaration {
  ret _declaration_vis(name, kind, detail, pos, true);
}

// `_declaration`, additionally recording whether the declaration was
// written `pub` (see `Declaration.is_public`). Used directly only at
// the handful of top-level call sites where that matters; every other
// call site keeps going through the plain `_declaration` wrapper,
// which is always visible from anywhere within the merged program the
// same way it always has been.
fun _declaration_vis(str name, DeclarationKind kind, str detail, Pos pos, bin is_public) Declaration {
  Declaration d;
  d.name = name;
  d.kind = kind;
  d.detail = detail;
  d.pos = pos;
  d.container = "";
  d.is_public = is_public;
  ret d;
}

// Every declaration `file` itself makes at the top level, as
// `Declaration`s: a function, a compound and each of its own fields,
// an enum and each of its own variants, a quirk, a plain top-level
// global, and each impl method declared for a type in this file.
// Mirrors `outline.fn`'s own `_collect` (same five-way node-kind
// split, since that's the richer of the two existing walks —
// `lookup_top_level` alone is missing fields/variants/methods
// entirely), but builds `Declaration`s instead of `OutlineEntry`s so
// the result carries `detail`/`is_public`, not just a name and a
// position. Used to build the workspace symbol table; a fresh call
// per document, not itself cached.
pub fun _collect_declarations(Vec<Node>* nodes, str file, Vec<Declaration>* out) {
  num i = 0;
  for i < nodes.len {
    Node n = nodes.get(i);
    i = i + 1;
    if !n.has_pos || !equals(n.pos.filename, file) {
      continue;
    }
    fit n.kind {
      .Function(f) -> {
        if f.has_name && !equals(f.name, "") {
          out.push(_declaration_vis(f.name, .Function, render_function(f), n.pos, n.flags.is_public));
        }
      }
      .Compound(c) -> {
        StringBuilder cb = string_builder_init(32);
        cb.append("compound ");
        cb.append(c.name);
        out.push(_declaration_vis(c.name, .Compound, cb.build(), n.pos, n.flags.is_public));
        num f = 0;
        for f < c.fields.len {
          CompoundField cf = c.fields.get(f);
          f = f + 1;
          StringBuilder fb = string_builder_init(32);
          fb.append(render_type(cf.dtype));
          fb.append(" ");
          fb.append(cf.name);
          Pos field_pos = n.pos;
          if cf.has_pos {
            field_pos = cf.pos;
          }
          Declaration fd = _declaration_vis(cf.name, .Field, fb.build(), field_pos, true);
          fd.container = c.name;
          out.push(fd);
        }
      }
      .Enum(e) -> {
        StringBuilder eb = string_builder_init(32);
        eb.append("enum ");
        eb.append(e.name);
        out.push(_declaration_vis(e.name, .Enum, eb.build(), n.pos, n.flags.is_public));
        num v = 0;
        for v < e.variants.len {
          EnumVariant variant = e.variants.get(v);
          v = v + 1;
          StringBuilder vb = string_builder_init(24);
          vb.append(variant.name);
          if variant.has_payload && variant.payload.len > 0 {
            vb.append("(");
            num p = 0;
            for p < variant.payload.len {
              if p > 0 {
                vb.append(", ");
              }
              vb.append(render_type(variant.payload.get(p)));
              p = p + 1;
            }
            vb.append(")");
          }
          Declaration vd = _declaration_vis(variant.name, .Variant, vb.build(), n.pos, true);
          vd.container = e.name;
          out.push(vd);
        }
      }
      .Quirk(q) -> {
        StringBuilder qb = string_builder_init(32);
        qb.append("quirk ");
        qb.append(q.name);
        out.push(_declaration_vis(q.name, .Quirk, qb.build(), n.pos, n.flags.is_public));
      }
      .Impl(im) -> {
        num m = 0;
        for m < im.methods.len {
          Node* method = im.methods.get(m);
          m = m + 1;
          if method == nil {
            continue;
          }
          fit method.kind {
            .Function(mf) -> {
              if !mf.has_name || equals(mf.name, "") {
                continue;
              }
              str method_name = bare_method_name(mf.name);
              Declaration md = _declaration_vis(
                method_name,
                .Function,
                render_function_named(mf, method_name, false),
                method.pos,
                true
              );
              md.container = im.type_name;
              out.push(md);
            }
            _ -> {}
          }
        }
      }
      .Variable(v) -> {
        StringBuilder gb = string_builder_init(32);
        if v.is_const {
          gb.append("const ");
        }
        gb.append(render_type(v.var_type));
        gb.append(" ");
        gb.append(v.name);
        out.push(_declaration_vis(v.name, .Global, gb.build(), n.pos, n.flags.is_public));
      }
      _ -> {}
    }
  }
}
