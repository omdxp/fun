// Hover and go to definition.
// 
// Both answer the same question first: what does the name under the
// cursor refer to? Hover then spells that declaration back to the
// reader, and go to definition says where it was written.

imp protocol;
imp documents;
imp analysis;
imp positions;
imp symbols;
imp uri;
imp imports;
imp inlay_hints;
imp ..lexer.token;
imp ..parser.datatype_defs;
imp ..parser.import_resolver;
imp std.string;
imp std.vec;
imp std.option;
imp std.io;
imp std.fs;
imp std.ctype;

// What a client is told when there is nothing to say.
const str NO_HOVER = "null";
const str NO_LOCATION = "[]";

// The hover for the position `line`/`character` in `doc`, as the result
// a client is sent.
pub fun hover(AnalysisCache* cache, Document doc, num line, num character) str {
  Analyzed read = cache.of(doc);
  if !read.lexed {
    ret NO_HOVER;
  }
  Vec<Token> tokens = read.tokens;

  let found = token_at(&tokens, line, character);
  if found.is_none() {
    ret NO_HOVER;
  }
  Token t = found.unwrap();

  fit t.type {
    .Keyword -> {
      if equals(token_word(t), "as") {
        ret _hover_result(_as_keyword_doc(&tokens, t), span_of(t, doc.text));
      }
      str doc_text = keyword_doc(token_word(t));
      if equals(doc_text, "") {
        ret NO_HOVER;
      }
      ret _hover_result(doc_text, span_of(t, doc.text));
    }
    .Identifier -> {
      // `fork` is not a lexer-level keyword (its recognition is
      // contextual, parser-side), so it lexes as a plain identifier;
      // checked here, before ordinary name resolution, since nothing
      // named `fork` could ever be a real declared symbol anyway.
      if equals(token_word(t), "fork") {
        str fork_doc = keyword_doc("fork");
        if !equals(fork_doc, "") {
          ret _hover_result(fork_doc, span_of(t, doc.text));
        }
      }
      // `sizeof` is recognized the same contextual way `fork` is:
      // never a lexer keyword, just an identifier the parser treats
      // specially at a call site, so it never resolves as a declared
      // symbol either.
      if equals(token_word(t), "sizeof") {
        str sizeof_doc = keyword_doc("sizeof");
        if !equals(sizeof_doc, "") {
          ret _hover_result(sizeof_doc, span_of(t, doc.text));
        }
      }
      // A sized integer type (`i7`, `u23`, ...) is recognized the
      // same contextual way `fork` is: never a lexer keyword, just an
      // identifier shape the parser accepts wherever a type is
      // expected, so it never resolves as a declared symbol and would
      // otherwise fall straight through to NO_HOVER like any other
      // undeclared name.
      let dynamic_int = parse_dynamic_int_datatype(token_word(t));
      if dynamic_int.is_some() {
        DynamicIntType dit = dynamic_int.unwrap();
        str sign_word = "unsigned";
        if dit.is_signed {
          sign_word = "signed";
        }
        ret _hover_result(
          _doc(
          format("{str} x;", token_word(t)),
          format("A {num}-bit {str} integer.", dit.bits, sign_word)
          ),
          span_of(t, doc.text)
        );
      }
      str target = import_target(&tokens, doc.path, line, character);
      if !equals(target, "") {
        ret _import_hover_result(target, span_of(t, doc.text));
      }
    }
    _ -> { ret NO_HOVER; }
  }

  let declared = _resolve(cache, doc, &tokens, t, line);
  if declared.is_none() {
    ret NO_HOVER;
  }
  Declaration d = declared.unwrap();
  // `let`'s own declared type never resolves in the parsed tree (see
  // inlay_hints.fn's own file-level note on the __let_infer__
  // sentinel), so a local's rendered detail otherwise shows that
  // placeholder verbatim. Re-run the same best-effort inference
  // inlayHint already does, using the declaration's own position to
  // find the initializer, rather than showing the raw sentinel.
  if read.parsed && starts_with(d.detail, "__let_infer__") {
    let name_tok = token_at(&tokens, d.pos.line - 1, d.pos.col - 1);
    if name_tok.is_some() {
      num name_idx = index_of_token(&tokens, name_tok.unwrap());
      str inferred = infer_let_local_type(
        &tokens,
        name_idx,
        &read.program.nodes,
        doc.path,
        d.pos.line
      );
      if !equals(inferred, "") {
        d.detail = format("{str} {str}", inferred, d.name);
      }
    }
  }
  str source_text = "";
  if equals(d.pos.filename, doc.path) {
    source_text = doc.text;
  } elif !equals(d.pos.filename, "") {
    // A symbol declared in another file (reached through an `imp`)
    // needs that file's own text, not the current document's, since
    // its doc comment sits above the declaration wherever that file
    // actually lives, not at the same line number here. Read fresh
    // each time rather than cached, since this file isn't one the
    // client has open for `didChange` to keep current.
    str other_text = read_to_string(d.pos.filename);
    if other_text != nil {
      source_text = other_text;
    }
  }
  str doc_comment = "";
  if !equals(source_text, "") {
    doc_comment = doc_comment_above(source_text, d.pos.line);
    // A field or variant with no leading block of its own falls back
    // to a trailing same-line comment (`Circle(num), // meaning`),
    // scoped to these two kinds since a trailing comment on a
    // function/compound/etc. is rarely meant as its doc.
    if equals(doc_comment, "") && (d.kind == DeclarationKind.Field || d.kind == DeclarationKind.Variant) {
      doc_comment = doc_comment_trailing(source_text, d.pos.line);
    }
  }
  StringBuilder b = string_builder_init(96);
  if !equals(doc_comment, "") {
    b.append(doc_comment);
    b.append("\n\n");
  }
  b.append("```fun\n");
  b.append(d.detail);
  b.append("\n```");
  if read.parsed {
    b.append(_see_also_footer(&read.program.nodes, d));
  }
  ret _hover_result(b.build(), span_of(t, doc.text));
}

// Where the name at `line`/`character` in `doc` was declared, as the
// result a client is sent. A declaration in another file is named by its
// own URI, which is how a jump leaves the document.
pub fun definition(AnalysisCache* cache, Document doc, num line, num character) str {
  Analyzed read = cache.of(doc);
  if !read.lexed {
    ret NO_LOCATION;
  }
  Vec<Token> tokens = read.tokens;

  let found = token_at(&tokens, line, character);
  if found.is_none() {
    ret NO_LOCATION;
  }
  Token t = found.unwrap();
  fit t.type {
    .Identifier -> {}
    _ -> { ret NO_LOCATION; }
  }

  str target = import_target(&tokens, doc.path, line, character);
  if !equals(target, "") {
    StringBuilder ib = string_builder_init(96);
    ib.append("[");
    ib.append(format(
      `{"uri":{str},"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}}}`,
      json_quote(path_to_uri(target))
    ));
    ib.append("]");
    ret ib.build();
  }

  let declared = _resolve(cache, doc, &tokens, t, line);
  if declared.is_none() {
    ret NO_LOCATION;
  }
  ret _location_result(doc, declared.unwrap());
}

// `definition`, extended with a last-resort fallback: when the
// current document's own transitively-merged program has nothing by
// this name, a top-level declaration in any other document this
// server already knows about (open, or already indexed by an earlier
// `references`/`workspace/symbol` scan) still counts. Doesn't trigger
// a workspace scan of its own, matching the reference's own
// `findTypeDefinitionAnyDoc`, which only ever searches what's already
// indexed rather than indexing on demand.
pub fun definition_workspace_wide(
  AnalysisCache* cache,
  Documents* docs,
  Document doc,
  num line,
  num character
) str {
  str local = definition(cache, doc, line, character);
  if !equals(local, NO_LOCATION) {
    ret local;
  }

  Analyzed read = cache.of(doc);
  if !read.lexed {
    ret NO_LOCATION;
  }
  Vec<Token> tokens = read.tokens;
  let found = token_at(&tokens, line, character);
  if found.is_none() {
    ret NO_LOCATION;
  }
  Token t = found.unwrap();
  fit t.type {
    .Identifier -> {}
    _ -> { ret NO_LOCATION; }
  }
  str name = token_word(t);

  Vec<str> uris = docs.all_uris();
  defer uris.free();
  num i = 0;
  for i < uris.len {
    str other_uri = uris.get(i);
    i = i + 1;
    let other_doc_opt = docs.at(other_uri);
    if other_doc_opt.is_none() {
      continue;
    }
    Document other_doc = other_doc_opt.unwrap();
    if equals(other_doc.path, doc.path) {
      continue;
    }
    Analyzed other_read = cache.of(other_doc);
    if !other_read.parsed {
      continue;
    }
    let hit = lookup_top_level(&other_read.program.nodes, name);
    if hit.is_some() {
      ret _location_result(other_doc, hit.unwrap());
    }
  }
  ret NO_LOCATION;
}

// A single-element `Location[]`, the shape every definition-like
// method answers with, pointing at `d`'s own declaration. `doc` is the
// document the request was made against, reused directly when `d`
// turns out to sit in that same file; a declaration reached through an
// `imp` needs that other file's own text read fresh, the same
// same-file-or-read pattern `hover()` uses for a doc comment.
fun _location_result(Document doc, Declaration d) str {
  if equals(d.pos.filename, "") {
    ret NO_LOCATION;
  }
  str target_text = doc.text;
  if !equals(d.pos.filename, doc.path) {
    str other_text = read_to_string(d.pos.filename);
    if other_text != nil {
      target_text = other_text;
    } else {
      target_text = "";
    }
  }
  Span s = span_of_pos(d.pos, len(d.name), target_text);
  StringBuilder b = string_builder_init(160);
  b.append("[");
  b.append(format(
    `{"uri":{str},"range":{"start":{"line":{num},"character":{num}},"end":{"line":{num},"character":{num}}}}`,
    json_quote(path_to_uri(d.pos.filename)),
    s.line,
    s.start,
    s.line,
    s.end
  ));
  b.append("]");
  ret b.build();
}

// Where the *type* of the name at `line`/`character` was declared,
// rather than the name itself: hovering a compound name jumps to
// itself (the same place plain `definition` would land), but hovering
// a local/field/parameter/global jumps to what it was declared *as*,
// the way an editor's "Go to Type Definition" is meant to work. `[]`
// for anything whose type can't be resolved to a real declaration (a
// primitive, an inferred `let` local, a function's own name).
pub fun type_definition(AnalysisCache* cache, Document doc, num line, num character) str {
  Analyzed read = cache.of(doc);
  if !read.lexed || !read.parsed {
    ret NO_LOCATION;
  }
  Vec<Token> tokens = read.tokens;

  let found = token_at(&tokens, line, character);
  if found.is_none() {
    ret NO_LOCATION;
  }
  Token t = found.unwrap();
  fit t.type {
    .Identifier -> {}
    _ -> { ret NO_LOCATION; }
  }

  let declared = _resolve(cache, doc, &tokens, t, line);
  if declared.is_none() {
    ret NO_LOCATION;
  }
  Declaration d = declared.unwrap();
  fit d.kind {
    .Compound -> { ret _location_result(doc, d); }
    .Enum -> { ret _location_result(doc, d); }
    .Quirk -> { ret _location_result(doc, d); }
    _ -> {}
  }

  // `d.detail` reads as a full "name(args) RetType" signature for a
  // function or method, not a bare "Type name" pair. Hovering the
  // call itself (the closing hop of a chain like `c.own().rpm`, or a
  // plain call anywhere) means its own declared return type, not
  // whatever `bare_type_from_detail`'s "Type name" splitting would
  // make of a whole signature.
  str type_name = "";
  if d.kind == DeclarationKind.Function {
    type_name = return_type_from_detail(d.detail);
  } else {
    type_name = bare_type_from_detail(d.detail);
  }
  if equals(type_name, "") {
    ret NO_LOCATION;
  }
  let type_decl = lookup_top_level(&read.program.nodes, type_name);
  if type_decl.is_none() {
    ret NO_LOCATION;
  }
  ret _location_result(doc, type_decl.unwrap());
}

// What the name `t` refers to, judged from where it sits: a field when
// it is reached through a dot, and otherwise a local, a parameter, or
// something the program declares.
fun _resolve(AnalysisCache* cache, Document doc, Vec<Token>* tokens, Token t, num line) Option<Declaration> {
  str name = token_word(t);
  if equals(name, "") {
    ret .None;
  }

  Analyzed read = cache.of(doc);
  if !read.parsed {
    ret .None;
  }
  ProgramMergeResult program = read.program;
  num source_line = line + 1;

  str receiver = _receiver_of(tokens, t);
  // A plain identifier before the dot isn't the only shape a receiver
  // takes: `a.f().g` has none (the token right before `.g` is `)`),
  // but still needs the receiver branch below, since that's the only
  // one that calls `chain_receiver_type` at all. `receiver` itself
  // stays "" for this shape; `local_generic_args` below already
  // tolerates that by finding no args, falling back to the
  // unspecialized template the same way a deeper chain already does.
  if !equals(receiver, "") || _preceded_by_dot(tokens, t) {
    // Walks the whole dotted chain (`a.b.c`, `a.f().c`, any mix), not
    // just the immediate `receiver` segment: `type_name_of_local(receiver,
    // ...)` alone would fail here whenever the receiver is itself a
    // field access or a call rather than a bare local, since neither
    // was ever declared as one.
    ChainReceiver found_receiver = chain_receiver(tokens, t, &program.nodes, doc.path, source_line);
    str type_name = found_receiver.type_name;
    if !equals(type_name, "") {
      let field = lookup_field(&program.nodes, type_name, name);
      if field.is_some() {
        ret field;
      }
      // Specializes a generic method's own signature against the
      // receiver's own concrete type arguments (`o.unwrap_or` on
      // `Option<num>` shows `num`, not the bare template's own `T`),
      // threaded all the way through by `chain_receiver` however deep
      // the chain leading to the receiver is, not just for a bare
      // local carrying them directly.
      let method = lookup_method(&program.nodes, type_name, name, found_receiver.generic_args);
      if method.is_some() {
        ret method;
      }
    }
    // `receiver` might not be a local at all, but an enum type named
    // directly (`OptionalInt.Some`), the qualified form of a fit
    // destructuring pattern (or an ordinary variant-constructing call
    // outside any fit, `ret OptionalInt.Some(v);`).
    let qualified_variant = enum_variant_declaration(&program.nodes, receiver, name);
    if qualified_variant.is_some() {
      ret qualified_variant;
    }
  } elif _is_dot_shorthand(tokens, t) {
    let variant = lookup_fit_variant(&program.nodes, name, doc.path, source_line);
    if variant.is_some() {
      ret variant;
    }
    // A bare `.Variant(...)` outside any fit, most commonly a `ret`'s
    // own value (`ret .Ok(x);`): resolved against the enclosing
    // function's own declared return type, substituting a generic
    // instantiation's concrete type arguments so a payload declared
    // as a bare type param in the template (`Ok(T)`) reads as the
    // caller's actual type (`Ok(str)`).
    if _is_return_value(tokens, t) {
      let rdt = enclosing_return_dtype(&program.nodes, doc.path, source_line);
      if rdt.is_some() {
        let rv = enum_variant_declaration_typed(&program.nodes, rdt.unwrap(), name);
        if rv.is_some() {
          ret rv;
        }
      }
    }
  }

  let declared_field = lookup_field_at(&program.nodes, doc.path, source_line, name);
  if declared_field.is_some() {
    ret declared_field;
  }

  ret lookup(&program.nodes, name, doc.path, source_line);
}

// The name `t` is reached through, when it is written as `receiver.name`.
// Empty when `t` stands on its own.
fun _receiver_of(Vec<Token>* tokens, Token t) str {
  num index = index_of_token(tokens, t);
  if index <= 0 {
    ret "";
  }
  let dot = token_before(tokens, index);
  if dot.is_none() {
    ret "";
  }
  Token d = dot.unwrap();
  if !token_is_operator(d, ".") {
    ret "";
  }
  num dot_index = index_of_token(tokens, d);
  if dot_index <= 0 {
    ret "";
  }
  let before = token_before(tokens, dot_index);
  if before.is_none() {
    ret "";
  }
  Token b = before.unwrap();
  fit b.type {
    .Identifier -> { ret token_word(b); }
    _ -> {}
  }
  ret "";
}

// True when `t` sits right after a `.` that itself continues a
// chain: a call's own closing `)` before it (`f().t`), which
// `_receiver_of` doesn't resolve to a name the way a plain identifier
// receiver does. Deliberately narrower than "any dot before `t`":
// a bare `.Variant` fit-pattern shorthand also has a dot right before
// its name, but nothing meaningful before that dot, and must fall
// through to `_is_dot_shorthand`'s own branch instead, not be
// swallowed here into a receiver search that finds nothing.
fun _preceded_by_dot(Vec<Token>* tokens, Token t) bin {
  num index = index_of_token(tokens, t);
  if index <= 0 {
    ret false;
  }
  let dot = token_before(tokens, index);
  if dot.is_none() || !token_is_operator(dot.unwrap(), ".") {
    ret false;
  }
  num dot_idx = index_of_token(tokens, dot.unwrap());
  let before_dot = token_before(tokens, dot_idx);
  if before_dot.is_none() {
    ret false;
  }
  Token bd = before_dot.unwrap();
  fit bd.type {
    .Identifier -> { ret true; }
    _ -> {}
  }
  ret token_is_symbol(bd, ')') || token_is_symbol(bd, ']');
}

// True when `t` is a bare `.Name` fit-pattern shorthand: directly
// preceded by a `.` that is not itself preceded by an identifier (an
// ordinary field or method access, which `_receiver_of` resolves
// instead).
fun _is_dot_shorthand(Vec<Token>* tokens, Token t) bin {
  num index = index_of_token(tokens, t);
  if index <= 0 {
    ret false;
  }
  let dot = token_before(tokens, index);
  if dot.is_none() {
    ret false;
  }
  if !token_is_operator(dot.unwrap(), ".") {
    ret false;
  }
  num dot_index = index_of_token(tokens, dot.unwrap());
  if dot_index <= 0 {
    ret true;
  }
  let before = token_before(tokens, dot_index);
  if before.is_none() {
    ret true;
  }
  fit before.unwrap().type {
    .Identifier -> { ret false; }
    _ -> {}
  }
  ret true;
}

// True when the nearest preceding token that could start a new
// statement, walked back from `t`, is the `ret` keyword: `t` is (or
// begins) a `ret`'s own value expression.
fun _is_return_value(Vec<Token>* tokens, Token t) bin {
  num index = index_of_token(tokens, t);
  num i = index - 1;
  for i >= 0 {
    Token tok = tokens.get(i);
    if token_is_symbol(tok, ';') || token_is_symbol(tok, '{') || token_is_symbol(tok, '}') {
      ret false;
    }
    fit tok.type {
      .Keyword -> { ret equals(token_word(tok), "ret"); }
      _ -> {}
    }
    i = i - 1;
  }
  ret false;
}

fun _hover_result(str markdown, Span s) str {
  ret format(
    `{"contents":{"kind":"markdown","value":{str}},"range":{"start":{"line":{num},"character":{num}},"end":{"line":{num},"character":{num}}}}`,
    json_quote(markdown),
    s.line,
    s.start,
    s.line,
    s.end
  );
}

// A "See also" footer linking the user-defined types mentioned in
// `d`'s own signature: its own capitalized type-shaped words (Fun's
// own convention, matching every builtin/C-typedef's lowercase
// spelling), each resolved through the program's own top-level
// declarations and rendered as a clickable file link. Skips a name
// that doesn't resolve to anything real, or resolves outside any
// file (nothing to link to). "" when nothing resolves at all.
fun _see_also_footer(Vec<Node>* program, Declaration d) str {
  Vec<str> names = _candidate_type_names(d.detail, d.name);
  defer names.free();
  // A field/method/variant's own container is worth linking even
  // when its detail carries no type name of its own (a `num` field
  // has nowhere else useful to point).
  if !equals(d.container, "") && !equals(d.container, d.name) && !names.contains(d.container) {
    names.push(d.container);
  }
  StringBuilder links = string_builder_init(64);
  num count = 0;
  num i = 0;
  for i < names.len && count < 8 {
    str name = names.get(i);
    i = i + 1;
    let found = lookup_top_level(program, name);
    if found.is_none() {
      continue;
    }
    Declaration td = found.unwrap();
    if equals(td.pos.filename, "") {
      continue;
    }
    if count > 0 {
      links.append(", ");
    }
    links.append(format("[`{str}`]({str}#L{num})", name, path_to_uri(td.pos.filename), td.pos.line));
    count = count + 1;
  }
  if count == 0 {
    ret "";
  }
  ret format("\n\n---\n\nSee also: {str}\n", links.build());
}

// The capitalized, identifier-shaped words in `detail` (a rendered
// signature or type), Fun's own convention for a user-defined type
// name as opposed to a builtin or C typedef (always spelled lower).
// Deduplicated, and never `exclude_name` itself, so a hovered
// symbol never "sees also" its own name.
fun _candidate_type_names(str detail, str exclude_name) Vec<str> {
  Vec<str> out;
  out.init(4);
  num n = len(detail);
  num i = 0;
  for i < n {
    chr c = detail[i];
    if !is_upper(c) {
      i = i + 1;
      continue;
    }
    num start = i;
    i = i + 1;
    for i < n && (is_alnum(detail[i]) || detail[i] == '_') {
      i = i + 1;
    }
    str word = substr(detail, start, i - start);
    if equals(word, exclude_name) || out.contains(word) {
      continue;
    }
    out.push(word);
  }
  ret out;
}

// The hover for an import path segment resolved to `target`: a
// README.md's own content verbatim, or a `.fn` module's own leading
// doc comment.
fun _import_hover_result(str target, Span s) str {
  // A directory with no README of its own (a real namespace segment,
  // just undocumented) still names something worth confirming, rather
  // than falling through to no hover at all.
  if is_dir(target) {
    ret _hover_result(format("Directory: `{str}`", target), s);
  }
  str text = read_to_string(target);
  if text == nil {
    ret NO_HOVER;
  }
  str shown = text;
  if !ends_with(target, "README.md") {
    shown = leading_doc_comment(text);
    if equals(shown, "") {
      ret NO_HOVER;
    }
  }
  ret _hover_result(shown, s);
}

// `as` reads two different ways depending on the statement it sits
// in: naming an import alias (`imp mod as alias;`) or naming the
// quirk an impl block implements (`impl Type as Quirk { ... }`).
// Told apart by walking back from `t` past the identifiers and dots
// that make up whatever comes before it, to the keyword that started
// the statement.
fun _as_keyword_doc(Vec<Token>* tokens, Token t) str {
  str impl_doc = _doc(
    `impl Type as Quirk { ... }`,
    `Names the quirk an impl block implements for a type.`
  );
  str import_doc = _doc(
    `imp module.path as alias;`,
    `Binds an import to a different name, reached afterward as
    `alias.name instead of the module's own leading segment.`
  );
  num i = index_of_token(tokens, t);
  if i < 0 {
    ret impl_doc;
  }
  i = i - 1;
  for i >= 0 {
    Token tok = tokens.get(i);
    if tok.type == TokenType.Comment || tok.type == TokenType.NewLine {
      i = i - 1;
      continue;
    }
    if tok.type == TokenType.Identifier || token_is_operator(tok, ".") {
      i = i - 1;
      continue;
    }
    if token_is_keyword(tok, "imp") {
      ret import_doc;
    }
    ret impl_doc;
  }
  ret impl_doc;
}

// `code` shown as a Fun snippet, with `prose` under it. A fence is
// written as doubled backticks, which is how a raw string carries one.
fun _doc(str code, str prose) str {
  ret format(```````fun
  `{str}
  ```````
  `{str}`, code, prose);
}

// What a keyword means, for the keywords whose meaning is not obvious
// from the word itself.
pub fun keyword_doc(str word) str {
  if equals(word, "async") {
    ret _doc(
      `async fun name(...) Type { ... }`,
      `Marks a function as asynchronous. Call it with await to wait for
      `its result, or with fork to spawn it and carry on.`
    );
  }
  if equals(word, "await") {
    ret _doc(
      `await some_async_call();`,
      `Waits for an async call and yields its result. Only valid inside
      `an async function.`
    );
  }
  if equals(word, "fork") {
    ret _doc(
      `fork worker(args);`,
      `Spawns a call as a virtual thread and carries on without its
      `result. The target must be an async fun, and main waits for every
      `fork before it exits.`
    );
  }
  if equals(word, "sizeof") {
    ret _doc(
      `sizeof(Type)`,
      `The size of a type in bytes, resolved at compile time. Stands for
      `num wherever it is written.`
    );
  }
  if equals(word, "nil") {
    ret _doc(
      `nil`,
      `The empty pointer. Stands for any pointer type and for str, and
      `compares with == and !=.`
    );
  }
  if equals(word, "panic") {
    ret _doc(
      `panic("message")`,
      `Prints the message and stops the program. Stands for whatever type
      `is expected where it is written, so it can be returned, assigned,
      `or passed as an argument.`
    );
  }
  if equals(word, "fit") {
    ret _doc(
      `fit value {
      `  .Variant(x) -> { ... }
      `  _ -> { ... }
      `}`,
      `Matches a value against the shapes it can take, binding what a
      `variant carries. Every variant must be covered, or _ must be.`
    );
  }
  if equals(word, "defer") {
    ret _doc(
      `defer cleanup();`,
      `Runs a statement when the enclosing scope ends, whichever way it
      `ends.`
    );
  }
  if equals(word, "imp") {
    ret _doc(
      `imp std.io;
      `imp ..lexer.token;`,
      `Imports another module. A leading run of dots steps up out of the
      `importing file's own directory.`
    );
  }
  if equals(word, "impl") {
    ret _doc(
      `impl Type { ... }
      `impl Type as Quirk { ... }`,
      `Declares methods on a type, or implements a quirk for it.`
    );
  }
  if equals(word, "quirk") {
    ret _doc(
      `quirk Named {
      `  name() str;
      `}`,
      `A set of methods a type can implement, which a value can then be
      `used through.`
    );
  }
  if equals(word, "raw") {
    ret _doc(`raw p;`, `An untyped pointer, for the places a real type cannot be written.`);
  }
  if equals(word, "ret") {
    ret _doc(
      `ret value;`,
      `Returns from a function, with a value unless the function returns
      `nothing.`
    );
  }
  if equals(word, "test") {
    ret _doc(
      `test "what it does" {
      `  assert condition, "message";
      `}`,
      `A test, run by fun -test and ignored by an ordinary build.`
    );
  }
  if equals(word, "fuzz") {
    ret _doc(
      `fuzz "never crashes on arbitrary input" (raw* data, num len) {
      `  ...
      `}`,
      `A fuzz test, run by fun -fuzz against random bytes. Must not crash
      `or leak, however malformed the input.`
    );
  }
  if equals(word, "pub") {
    ret _doc(
      `pub fun name(...) Type { ... }`,
      `Marks a declaration visible outside the file it is written in.
      `Without it, a function, type, or method is private to its own
      `file.`
    );
  }
  if equals(word, "fun") {
    ret _doc(`fun name(arg Type) Type { ... }`, `Declares a function.`);
  }
  if equals(word, "as") {
    ret _doc(`impl Type as Quirk { ... }`, `Names the quirk an impl block implements for a type.`);
  }
  if equals(word, "enum") {
    ret _doc(
      `enum Name {
      `  A,
      `  B(num),
      `}`,
      `Declares a set of variants a value can be, each optionally
      `carrying a payload. Matched with fit.`
    );
  }
  if equals(word, "compound") {
    ret _doc(
      `compound Name {
      `  num field;
      `}`,
      `Declares a struct-like type: a fixed set of named, typed fields.`
    );
  }
  if equals(word, "let") {
    ret _doc(`let x = value;`, `Declares a local with its type inferred from value.`);
  }
  if equals(word, "const") {
    ret _doc(
      `const num x = 5;`,
      `Declares a binding that cannot be reassigned after its initial
      `value.`
    );
  }
  if equals(word, "asm") {
    ret _doc(
      `asm volatile(out y: "=r" = y; in x: "r" = x) "...";
      `asm arch aarch64 { ... };`,
      `Emits inline assembly. volatile forbids the optimizer from
      `dropping or reordering it; arch restricts it to one target,
      `compiled out on any other.`
    );
  }
  if equals(word, "volatile") {
    ret _doc(
      `asm volatile(...) "...";`,
      `Marks an asm block as having effects the optimizer must not
      `assume away, forbidding it from being dropped or reordered.`
    );
  }
  if equals(word, "arch") {
    ret _doc(
      `asm arch aarch64 { ... };`,
      `Restricts an asm block to one target architecture; compiled out
      `entirely on any other.`
    );
  }
  if equals(word, "void") {
    ret _doc(
      `fun name() void { ... }`,
      `The absence of a value, for a function that returns nothing.`
    );
  }
  if equals(word, "num") {
    ret _doc(`num x;`, `A 64-bit signed integer.`);
  }
  if equals(word, "dec") {
    ret _doc(`dec x;`, `A 64-bit floating-point number.`);
  }
  if equals(word, "str") {
    ret _doc(`str s;`, `A NUL-terminated byte string.`);
  }
  if equals(word, "bin") {
    ret _doc(`bin flag;`, `A boolean: true or false.`);
  }
  if equals(word, "chr") {
    ret _doc(`chr c;`, `A single byte, written as a character literal ('a').`);
  }
  if equals(word, "if") {
    ret _doc(`if condition { ... }`, `Runs its body only when condition is true.`);
  }
  if equals(word, "elif") {
    ret _doc(
      `if a { ... } elif b { ... } else { ... }`,
      `An else-if arm, tried in order when every earlier condition in
      `the chain was false.`
    );
  }
  if equals(word, "else") {
    ret _doc(
      `if condition { ... } else { ... }`,
      `Runs when every earlier condition in the chain was false.`
    );
  }
  if equals(word, "true") {
    ret _doc(`bin flag = true;`, `The boolean literal for a true value.`);
  }
  if equals(word, "false") {
    ret _doc(`bin flag = false;`, `The boolean literal for a false value.`);
  }
  if equals(word, "for") {
    ret _doc(
      `for condition { ... }
      `for item : collection { ... }`,
      `Loops while condition is true, or once per item of a collection.`
    );
  }
  if equals(word, "break") {
    ret _doc(`break;`, `Exits the innermost enclosing loop immediately.`);
  }
  if equals(word, "continue") {
    ret _doc(`continue;`, `Skips to the next iteration of the innermost enclosing loop.`);
  }
  if equals(word, "allow") {
    ret _doc(
      `allow unused_variable;`,
      `Silences a specific warning for the declaration or scope it
      `precedes, deliberately overriding the usual warning-clean
      `requirement.`
    );
  }
  if equals(word, "expect") {
    ret _doc(
      `expect unused_variable;`,
      `Asserts that a specific warning does fire here; a build fails if
      `it doesn't. Used to test the compiler's own warning detection.`
    );
  }
  if equals(word, "assert") {
    ret _doc(
      `assert condition, "message";`,
      `Inside a test or fuzz block, fails it with message when condition
      `is false.`
    );
  }
  ret "";
}
