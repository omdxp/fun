// Inlay hints.
// 
// Two kinds, both inline "ghost" text a reader never typed: a
// `let`-inferred local's own resolved type right after its name, and
// a call argument's own parameter name right before it.
// 
// `let`'s declared type never actually resolves in the parsed tree:
// the parser leaves it as a permanent __let_infer__ sentinel, and
// only codegen (embedding its own on-the-fly inference) ever turns
// that into a real type, without writing it back anywhere fls can
// read. Rather than reimplement that inference in full, this covers
// the shapes a `let`'s own initializer most commonly takes: a
// literal, a plain function call, or a method call.

imp documents;
imp analysis;
imp positions;
imp symbols;
imp signature_help;
imp protocol;
imp ..lexer.token;
imp ..semantics.typecheck;
imp std.string;
imp std.vec;
imp std.option;
imp std.ctype;

// Every `let name = value;` local within lines `start_line` through
// `end_line` (both 0-indexed, inclusive) of `doc`, each as a type
// hint positioned right after its own name.
pub fun inlay_hints(AnalysisCache* cache, Document doc, num start_line, num end_line) str {
  Analyzed read = cache.of(doc);
  if !read.parsed || !read.lexed {
    ret "[]";
  }
  Vec<Token> tokens = read.tokens;
  ProgramMergeResult program = read.program;

  StringBuilder b = string_builder_init(256);
  b.append("[");
  bin any = false;
  num i = 0;
  for i < tokens.len {
    Token t = tokens.get(i);
    i = i + 1;
    if t.type != TokenType.Keyword || !equals(token_word(t), "let") {
      continue;
    }
    num src_line = t.pos.line;
    num line0 = src_line - 1;
    if line0 < start_line || line0 > end_line {
      continue;
    }
    let name_tok_opt = token_after(&tokens, i);
    if name_tok_opt.is_none() {
      continue;
    }
    Token name_tok = name_tok_opt.unwrap();
    fit name_tok.type {
      .Identifier -> {}
      _ -> { continue; }
    }
    num name_idx = index_of_token(&tokens, name_tok);
    str type_part = infer_let_local_type(&tokens, name_idx, &program.nodes, doc.path, src_line);
    if equals(type_part, "") {
      continue;
    }
    if any {
      b.append(",");
    }
    any = true;
    b.append(format(
      `{"position":{"line":{num},"character":{num}},"label":{str},"kind":1,"paddingLeft":true}`,
      line0,
      byte_col_to_utf16_char(doc.text, line0, name_tok.pos.end_col - 1),
      json_quote(format(": {str}", type_part))
    ));
  }

  // Parameter-name hints at call sites: `f(name: value)`. Every
  // identifier immediately followed by `(` that isn't a declaration
  // is treated as a call, its callee resolved (plain function, or
  // method through a receiver reached by a dot), and a hint placed at
  // each argument the resolved signature has a name for.
  num j = 0;
  for j < tokens.len {
    Token t = tokens.get(j);
    j = j + 1;
    fit t.type {
      .Identifier -> {}
      _ -> { continue; }
    }
    num src_line = t.pos.line;
    num line0 = src_line - 1;
    if line0 < start_line || line0 > end_line {
      continue;
    }
    num name_idx = index_of_token(&tokens, t);
    let lparen_opt = token_after(&tokens, name_idx + 1);
    if lparen_opt.is_none() || !token_is_operator(lparen_opt.unwrap(), "(") {
      continue;
    }
    num lparen_idx = index_of_token(&tokens, lparen_opt.unwrap());
    if _call_paren_is_declaration(&tokens, name_idx, lparen_idx) {
      continue;
    }

    str callee_name = token_word(t);
    let prev = token_before(&tokens, name_idx);
    bin is_method = prev.is_some() && token_is_operator(prev.unwrap(), ".");
    Option<Declaration> found = .None;
    if is_method {
      str type_name = chain_receiver_type(&tokens, t, &program.nodes, doc.path, src_line);
      if !equals(type_name, "") {
        Vec<str> no_args;
        no_args.init(0);
        found = lookup_method(&program.nodes, type_name, callee_name, no_args);
      }
    } else {
      found = lookup_top_level(&program.nodes, callee_name);
    }
    if found.is_none() {
      continue;
    }
    Declaration d = found.unwrap();
    fit d.kind {
      .Function -> {}
      _ -> { continue; }
    }
    Vec<str> params = split_signature_params(d.detail);
    defer params.free();
    if params.len == 0 {
      continue;
    }
    // A method's own rendered signature carries its implicit `self`
    // as parameter 0, which a call site never writes out, skipped
    // here the same way signature_help shifts its active-param index.
    num param_offset = 0;
    if is_method {
      param_offset = 1;
    }

    num depth = 0;
    num arg_index = 0;
    bin expecting_arg = true;
    num k = lparen_idx;
    for k < tokens.len {
      Token at = tokens.get(k);
      k = k + 1;
      bin is_open = token_is_operator(at, "(") || token_is_operator(at, "[");
      bin is_close = token_is_symbol(at, ')') || token_is_symbol(at, ']');
      if is_open {
        depth = depth + 1;
        if depth == 1 {
          continue;
        }
      } elif is_close {
        depth = depth - 1;
        if depth == 0 {
          break;
        }
        continue;
      } elif depth == 1 && token_is_operator(at, ",") {
        arg_index = arg_index + 1;
        expecting_arg = true;
        continue;
      }
      if depth != 1 || !expecting_arg {
        continue;
      }
      if at.type == TokenType.Comment || at.type == TokenType.NewLine {
        continue;
      }
      expecting_arg = false;
      num param_index = arg_index + param_offset;
      if param_index >= params.len {
        continue;
      }
      str pname = _param_name_from_piece(params.get(param_index));
      if equals(pname, "") {
        continue;
      }
      bin redundant = at.type == TokenType.Identifier && equals(token_word(at), pname);
      if redundant {
        continue;
      }
      if any {
        b.append(",");
      }
      any = true;
      b.append(format(
        `{"position":{"line":{num},"character":{num}},"label":{str},"kind":2,"paddingRight":true}`,
        at.pos.line - 1,
        byte_col_to_utf16_char(doc.text, at.pos.line - 1, at.pos.start_col - 1),
        json_quote(format("{str}:", pname))
      ));
    }
  }

  b.append("]");
  ret b.build();
}

// The best-effort inferred type of the `let` local whose own name
// token sits at `name_idx`, read from its initializer the same way
// this file's own inlay hints do. Shared with `navigation.fn`, which
// needs the same inference to show a resolved type on hover instead
// of the raw `__let_infer__` sentinel `d.detail` otherwise carries.
pub fun infer_let_local_type(
  Vec<Token>* tokens,
  num name_idx,
  Vec<Node>* program,
  str file,
  num line
) str {
  let eq_tok_opt = token_after(tokens, name_idx + 1);
  if eq_tok_opt.is_none() || !token_is_operator(eq_tok_opt.unwrap(), "=") {
    ret "";
  }
  num eq_idx = index_of_token(tokens, eq_tok_opt.unwrap());
  let val_tok_opt = token_after(tokens, eq_idx + 1);
  if val_tok_opt.is_none() {
    ret "";
  }
  ret _infer_type(tokens, val_tok_opt.unwrap(), program, file, line);
}

// A best-effort read of `val_tok`'s own type, when it's the first
// token of a `let`'s initializer: a literal's own type directly, or
// (for a plain or method call) the callee's own declared return type.
// "" for any other shape: a binary expression, an already-typed
// local read back, a compound literal, and so on aren't covered.
fun _infer_type(Vec<Token>* tokens, Token val_tok, Vec<Node>* program, str file, num line) str {
  fit val_tok.type {
    .Number -> {
      fit val_tok.data {
        .Dec(_) -> { ret "dec"; }
        .Cval(_) -> { ret "chr"; }
        _ -> { ret "num"; }
      }
    }
    .String -> { ret "str"; }
    .Boolean -> { ret "bin"; }
    .Identifier -> {
      str name = token_word(val_tok);
      num idx = index_of_token(tokens, val_tok);

      // Walks the whole chain forward from `val_tok` (`a.b.c()`,
      // `a().b`, any mix, any length), tracking the last segment
      // reached and whether it's itself a call, then hands off to
      // chain_ending_type for the actual resolution: a receiver's
      // own field/method, a plain top-level call, or (no chain at
      // all) the bare read handled below.
      Token last_tok = val_tok;
      bin last_is_call = false;
      num cursor_idx = idx;
      let after0 = token_after(tokens, cursor_idx + 1);
      if after0.is_some() && token_is_operator(after0.unwrap(), "(") {
        last_is_call = true;
        let rparen0 = _matching_rparen(tokens, index_of_token(tokens, after0.unwrap()));
        if rparen0.is_some() {
          cursor_idx = rparen0.unwrap();
        }
      }
      for true {
        let dot_opt = token_after(tokens, cursor_idx + 1);
        if dot_opt.is_none() || !token_is_operator(dot_opt.unwrap(), ".") {
          break;
        }
        num dot_idx = index_of_token(tokens, dot_opt.unwrap());
        let member_opt = token_after(tokens, dot_idx + 1);
        if member_opt.is_none() {
          break;
        }
        fit member_opt.unwrap().type {
          .Identifier -> {}
          _ -> { break; }
        }
        last_tok = member_opt.unwrap();
        last_is_call = false;
        cursor_idx = index_of_token(tokens, last_tok);
        let after_opt = token_after(tokens, cursor_idx + 1);
        if after_opt.is_some() && token_is_operator(after_opt.unwrap(), "(") {
          last_is_call = true;
          let rparen = _matching_rparen(tokens, index_of_token(tokens, after_opt.unwrap()));
          if rparen.is_some() {
            cursor_idx = rparen.unwrap();
          }
        }
      }
      if index_of_token(tokens, last_tok) != idx || last_is_call {
        ret chain_ending_type(tokens, last_tok, last_is_call, program, file, line);
      }

      // A bare read of an already-typed local/field/parameter/global
      // (`let c = a;`): whatever `a` itself was declared as, in full
      // (a pointer star or generic argument matters here, unlike
      // `type_name_of_local`'s bare form, which exists for looking a
      // further member up rather than for display). `a` may itself be
      // a `let` local this same heuristic couldn't resolve, in which
      // case its own recorded type is the raw sentinel rather than a
      // real one, shown as no hint rather than leaked verbatim.
      let existing = lookup(program, name, file, line);
      if existing.is_none() {
        ret "";
      }
      str existing_type = _full_declared_type(existing.unwrap());
      if equals(existing_type, LET_INFER_TYPE) {
        ret "";
      }
      ret existing_type;
    }
    _ -> { ret ""; }
  }
}

// `d`'s own declared type, spelled in full (pointer star, generic
// args, everything): whatever precedes `d`'s own name in its
// rendered "Type name" detail.
fun _full_declared_type(Declaration d) str {
  num name_len = len(d.name);
  if len(d.detail) <= name_len {
    ret "";
  }
  ret trim(substr(d.detail, 0, len(d.detail) - name_len));
}

// True when `name_idx`'s own `identifier(` is a declaration rather
// than a call: preceded directly by `fun`/`pub`/`async`, or (for a
// method written with no such keyword) sitting at a statement
// boundary with only type-shaped tokens between the matching `)` and
// a following `{`. Anything else, `;`/`.`/`=`/a bare expression
// context, means this is a call.
fun _call_paren_is_declaration(Vec<Token>* tokens, num name_idx, num lparen_idx) bin {
  let prev = token_before(tokens, name_idx);
  if prev.is_some() {
    Token p = prev.unwrap();
    if p.type == TokenType.Keyword && (equals(token_word(p), "fun") || equals(token_word(p), "pub") || equals(
      token_word(p),
      "async"
    )) {
      ret true;
    }
  }
  bin at_stmt_boundary = prev.is_none();
  if prev.is_some() {
    Token p = prev.unwrap();
    at_stmt_boundary = token_is_symbol(p, '{') || token_is_symbol(p, '}') || token_is_symbol(
      p,
      ';'
    );
  }
  if !at_stmt_boundary {
    ret false;
  }

  let rparen_opt = _matching_rparen(tokens, lparen_idx);
  if rparen_opt.is_none() {
    ret false;
  }
  num k_idx = rparen_opt.unwrap() + 1;
  let k_opt = token_after(tokens, k_idx);
  num steps = 0;
  for steps < 8 {
    if k_opt.is_none() {
      ret false;
    }
    Token k = k_opt.unwrap();
    if token_is_symbol(k, '{') {
      ret true;
    }
    bin typeish = k.type == TokenType.Identifier || k.type == TokenType.Keyword || token_is_operator(
      k,
      "*"
    ) || token_is_symbol(k, '[') || token_is_operator(k, "[") || token_is_symbol(k, ']') || token_is_operator(
      k,
      "<"
    ) || token_is_operator(k, ">") || token_is_operator(k, ",");
    if !typeish {
      ret false;
    }
    k_opt = token_after(tokens, index_of_token(tokens, k) + 1);
    steps = steps + 1;
  }
  ret false;
}

// The index of the `)` matching the `(` at `lparen_idx`, depth-tracked.
fun _matching_rparen(Vec<Token>* tokens, num lparen_idx) Option<num> {
  num depth = 0;
  num i = lparen_idx;
  for i < tokens.len {
    Token t = tokens.get(i);
    if token_is_operator(t, "(") {
      depth = depth + 1;
    } elif token_is_symbol(t, ')') {
      depth = depth - 1;
      if depth == 0 {
        ret .Some(i);
      }
    }
    i = i + 1;
  }
  ret .None;
}

// A parameter's own name from one rendered piece of a split signature
// (`"str name"` -> `"name"`, `"Vec<T>* data"` -> `"data"`): the
// trailing run of identifier characters, since a parameter's name is
// always what a rendered "Type name" piece ends with.
fun _param_name_from_piece(str piece) str {
  num end = len(piece);
  num start = end;
  for start > 0 && (is_alnum(piece[start - 1]) || piece[start - 1] == '_') {
    start = start - 1;
  }
  ret substr(piece, start, end - start);
}
