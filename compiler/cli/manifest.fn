// Reads the `fun.toml` project manifest.
// 
// A package may build a library, one or more binaries, or both. Targets
// can be declared explicitly, or left out entirely and discovered from
// the conventional `src/lib.fn` and `src/main.fn` paths.
// 
// Only the subset of TOML the manifest needs is parsed: top-level
// tables, arrays of tables, and quoted string values. Fun resolves
// imports by path, so a manifest declares build targets, never an
// import graph.

imp std.string;
imp std.toml;
imp std.vec;
imp std.option;
imp std.result;
imp std.io;
imp std.fs;

// A source file compiled to an executable.
pub compound BinTarget {
  str name;
  str path;
}

// A source file compiled as a library: checked and compiled to an
// object, never linked, since it has no entry point.
pub compound LibTarget {
  str name;
  str path;
}

// What a package builds.
pub enum PackageKind {
  // No target declared and none discovered.
  Empty,
  // A library only.
  Lib,
  // One or more executables only.
  Bin,
  // A library alongside one or more executables.
  Mixed,
}

pub compound Manifest {
  str package_name;
  str version;
  bin has_lib;
  LibTarget lib;
  Vec<BinTarget> bins;
}

impl Manifest {
  // What this package builds, once targets have been resolved.
  pub kind() PackageKind {
    if self.has_lib && self.bins.len > 0 {
      ret .Mixed;
    }
    if self.has_lib {
      ret .Lib;
    }
    if self.bins.len > 0 {
      ret .Bin;
    }
    ret .Empty;
  }

  pub free() {
    self.bins.free();
  }
}

// Reads `text` as a manifest. Targets are taken exactly as declared;
// see `resolve_targets` for filling in the conventional defaults.
pub fun parse_manifest(str text) Result<Manifest, str> {
  let doc = parse_document(text);
  defer doc.free();

  Manifest m;
  m.package_name = "";
  m.version = "";
  m.has_lib = false;
  m.lib.name = "";
  m.lib.path = "";
  m.bins.init(0);

  let pkg = doc.table("package");
  if pkg.is_none() {
    ret .Err("fun.toml is missing its [package] table");
  }
  m.package_name = pkg.unwrap().get_str("name");
  if equals(m.package_name, "") {
    ret .Err("[package] is missing a `name`");
  }
  m.version = pkg.unwrap().get_str("version");
  if equals(m.version, "") {
    m.version = "0.0.0";
  }

  num ti = 0;
  for ti < doc.tables.len {
    str tname = doc.tables.get(ti).name;
    if !equals(tname, "package") && !equals(tname, "lib") {
      ret .Err(format("unknown table `[{str}]`", tname));
    }
    ti = ti + 1;
  }
  num ai = 0;
  for ai < doc.array_tables.len {
    str aname = doc.array_tables.get(ai).name;
    if !equals(aname, "bin") {
      ret .Err(format("unknown table `[[{str}]]`", aname));
    }
    ai = ai + 1;
  }

  let lib = doc.table("lib");
  if lib.is_some() {
    m.has_lib = true;
    m.lib.name = lib.unwrap().get_str("name");
    m.lib.path = lib.unwrap().get_str("path");
  }

  let bins = doc.array("bin");
  defer bins.free();
  num i = 0;
  for i < bins.len {
    str name = bins.get(i).get_str("name");
    str path = bins.get(i).get_str("path");
    if equals(name, "") {
      ret .Err("a [[bin]] is missing a `name`");
    }
    if equals(path, "") {
      ret .Err(format("[[bin]] `{str}` is missing a `path`", name));
    }
    BinTarget b;
    b.name = name;
    b.path = path;
    m.bins.push(b);
    i = i + 1;
  }

  ret .Ok(m);
}

// Fills in whatever the manifest left implicit, relative to `root`:
// a `[lib]` with no path uses `src/lib.fn`, and a manifest declaring no
// targets at all picks up `src/lib.fn` and `src/main.fn` when they
// exist, each named after the package.
pub fun resolve_targets(Manifest* m, str root) {
  str lib_path = _join(root, "src/lib.fn");
  str main_path = _join(root, "src/main.fn");

  if m.has_lib {
    if equals(m.lib.path, "") {
      m.lib.path = lib_path;
    }
    if equals(m.lib.name, "") {
      m.lib.name = m.package_name;
    }
  }

  if !m.has_lib && m.bins.len == 0 {
    if exists(lib_path) {
      m.has_lib = true;
      m.lib.name = m.package_name;
      m.lib.path = lib_path;
    }
    if exists(main_path) {
      BinTarget b;
      b.name = m.package_name;
      b.path = main_path;
      m.bins.push(b);
    }
  }
}

// Joins a directory and a relative path. An empty root leaves `rel`
// as-is, so a manifest read from the working directory keeps the plain
// relative paths it declared.
fun _join(str root, str rel) str {
  if equals(root, "") || equals(root, ".") {
    ret rel;
  }
  StringBuilder b = string_builder_init(32);
  b.append(root);
  if !ends_with(root, "/") {
    b.append("/");
  }
  b.append(rel);
  ret b.build();
}

test "parses a package with a single binary" {
  str text = `[package]
  `name = "demo"
  `version = "1.2.3"
  `
  `[[bin]]
  `name = "app"
  `path = "src/main.fn"`;
  let r = parse_manifest(text);
  assert r.is_ok(), "expected the manifest to parse";
  let m = r.unwrap();
  assert equals(m.package_name, "demo"), "expected the package name";
  assert equals(m.version, "1.2.3"), "expected the declared version";
  assert m.bins.len == 1, "expected one binary target";
  assert equals(m.bins.get(0).name, "app"), "expected the binary's name";
  assert equals(m.bins.get(0).path, "src/main.fn"), "expected the binary's path";
  assert m.kind() == PackageKind.Bin, "expected a binary-only package";
}

test "parses several binaries" {
  str text = `[package]
  `name = "demo"
  `
  `[[bin]]
  `name = "one"
  `path = "src/one.fn"
  `
  `[[bin]]
  `name = "two"
  `path = "src/two.fn"`;
  let m = parse_manifest(text).unwrap();
  assert m.bins.len == 2, "expected both binary targets";
  assert equals(m.bins.get(1).name, "two"), "expected the second target";
}

test "parses a library-only package" {
  str text = `[package]
  `name = "mylib"
  `
  `[lib]
  `path = "src/lib.fn"`;
  let m = parse_manifest(text).unwrap();
  assert m.has_lib, "expected a library target";
  assert equals(m.lib.path, "src/lib.fn"), "expected the library path";
  assert m.kind() == PackageKind.Lib, "expected a library-only package";
}

test "parses a package building both a library and a binary" {
  str text = `[package]
  `name = "both"
  `
  `[lib]
  `path = "src/lib.fn"
  `
  `[[bin]]
  `name = "cli"
  `path = "src/main.fn"`;
  let m = parse_manifest(text).unwrap();
  assert m.kind() == PackageKind.Mixed, "expected a mixed package";
  assert m.has_lib, "expected the library target";
  assert m.bins.len == 1, "expected the binary target";
}

test "a version left out defaults to 0.0.0" {
  str text = `[package]
  `name = "demo"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.version, "0.0.0"), "expected the default version";
  assert m.kind() == PackageKind.Empty, "expected no targets before resolution";
}

test "comments and blank lines are ignored" {
  str text = `# a leading comment
  `[package]
  `name = "demo" # trailing
  `
  `# another
  `version = "0.1.0"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.package_name, "demo"), "expected the name without the comment";
  assert equals(m.version, "0.1.0"), "expected the version";
}

test "a missing package name is rejected" {
  str text = `[package]
  `version = "0.1.0"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a manifest with no package name to be rejected";
}

test "a bin without a path is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[[bin]]
  `name = "app"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a bin with no path to be rejected";
}

test "a value keeps its quotes stripped" {
  str text = `[package]
  `name = "demo"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.package_name, "demo"), "expected the quotes to be stripped";
}

test "an unknown table is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[nope]
  `key = "value"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected an unknown table to be rejected";
}

test "a lib with no path resolves to the conventional source file" {
  str text = `[package]
  `name = "mylib"
  `
  `[lib]`;
  Manifest m = parse_manifest(text).unwrap();
  resolve_targets(&m, "");
  assert equals(m.lib.path, "src/lib.fn"), "expected the conventional library path";
  assert equals(m.lib.name, "mylib"), "expected the library to take the package name";
}
