{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "fun build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "${workspaceFolder}/fun-out/bin/fun",
      "args": ["test", "src/tests"],
      "isBackground": false,
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "format check",
      "type": "shell",
      "command": "${workspaceFolder}/fun-out/bin/fun",
      "args": ["-fmt-check-all"],
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}
