{
  "name": "fun-reference-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "dev:web": "vite --host",
    "dev:server": "tsx watch server/index.ts",
    "dev": "npm run sync:version && npm run generate:content && concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run sync:version && npm run generate:content && npm run build:web && npm run build:server",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
