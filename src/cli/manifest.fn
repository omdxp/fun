// Reads the `fun.toml` project manifest.
//
// A package may build a library, one or more binaries, or both. Targets
// can be declared explicitly, or left out entirely and discovered from
// the conventional `src/lib.fn` and `src/main.fn` paths.
//
// Only the subset of TOML the manifest needs is parsed: top-level
// tables, arrays of tables, and quoted string values. Fun resolves
// local imports by path, never through the manifest - `[[deps]]` is the
// one deliberate exception: a git-fetched dependency has no path to
// resolve by until it has actually been fetched, so its own root gets
// named here and reached through `use deps.<name>...` (see
// `src/cli/deps.fn` for resolution/fetching, `src/parser/
// import_resolver.fn` for the `deps.`-prefixed `use` branch).

use ..ast.ast;
use ..lexer.lexdefs;
use std.string;
use std.toml;
use std.fs;
use coverage;
use std.vec;
use std.option;
use std.result;
use std.io;
use std.fs;
use std.c.mem;
use std.atomic;
use std.map;
use std.runtime_backend;

// A source file compiled to an executable.
pub compound ExeTarget {
  str name;
  str path;
}

// Which git ref a dependency resolves against. `.Auto` (no `tag`/
// `branch`/`rev` given) is resolved later, by `src/cli/deps.fn`, to the
// highest semver-sorted tag if the repo has any, else the remote's
// default branch - manifest parsing only records intent, it never talks
// to the network.
pub enum DepRef {
  Auto,
  Tag(str),
  Branch(str),
  Rev(str),
}

// One `[[deps]]` entry: a git-fetched dependency, importable as
// `use deps.<name>...` once resolved. `path` is the subfolder inside the
// repo the dependency's own source root lives at ("" means the repo
// root itself) - this is what lets a dependency live in an arbitrary
// subfolder of someone else's repo with no cooperation needed from the
// repo owner, unlike ecosystems that require the owner to declare each
// subpackage in its own manifest file.
pub compound Dependency {
  str name;
  str git;
  str path;
  DepRef spec;
  // Name of an environment variable whose value is used as a git
  // credential for this remote only ("" means none). Never written into
  // a checkout's own .git/config or interpolated into a URL - see
  // `src/cli/deps.fn`.
  str token_env;
}

// A source file compiled as a library: checked and compiled to an
// object, never linked, since it has no entry point.
pub compound LibTarget {
  str name;
  str path;
}

// What a package builds.
pub enum PackageKind {
  // No target declared and none discovered.
  Empty,
  // A library only.
  Lib,
  // One or more executables only.
  Exe,
  // A library alongside one or more executables.
  Mixed,
}

pub compound Manifest {
  str package_name;
  str version;
  // The rest of `[package]`: all optional, "" (or an empty `authors`)
  // when not given. Informational only - nothing in this codebase
  // reads `description`/`license`/`authors`/`repository` back, except
  // `min_fun_version`, which `fun build` enforces against the running
  // compiler's own version (see `semver_cmp`).
  str description;
  str license;
  str repository;
  Vec<str> authors;
  str min_fun_version;
  flag has_lib;
  LibTarget lib;
  Vec<ExeTarget> exes;
  Vec<Dependency> deps;
  // `[coverage]`: the minimum total coverage `fun test -cover` enforces, in
  // tenths of a percent, and the paths left out of its report.
  flag has_cover_min;
  num cover_min_tenths;
  Vec<str> cover_exclude;
  // `[build]`: what the C compiler and linker get beyond the generated C.
  BuildSettings build;
  // `[build.macos]`, `[build.linux]` and `[build.windows]`, keyed by that
  // name: added to `build` when building on that OS.
  Map<str, BuildSettings> build_for_os;
}

// `[build]`'s own settings, each a list as written in `fun.toml`. Paths are
// relative to the project root.
pub compound BuildSettings {
  // Extra C, assembly (`.s`/`.S`), or object files compiled and linked in.
  Vec<str> sources;
  // Header search directories (`-I`).
  Vec<str> include_dirs;
  // Library search directories (`-L`).
  Vec<str> lib_dirs;
  // Libraries to link, by name (`"SDL2"` links `-lSDL2`).
  Vec<str> links;
  // Raw flags for the C compiler, placed before the generated source.
  Vec<str> cflags;
  // Raw flags for the linker, placed after every source and library.
  Vec<str> ldflags;
  // A freestanding build: no C library and no runtime (see
  // `is_freestanding_build`).
  flag freestanding;
  // Runs `main` on the process's own first thread instead of a worker
  // thread with its own stack (see `is_os_main_thread_build`).
  flag os_main_thread;
  // Which C runtime an MSVC-ABI build links: "" or "static" for the
  // static one, "dll" for the DLL one most prebuilt Windows libraries use.
  str c_runtime;
  // The CPU the program is built for (`x86_64`, `aarch64`, ...), when it
  // isn't this machine's own: what `asm arch` blocks are checked against.
  str target_arch;
  // What `fun build` produces: "" (or "exe") for linked executables, or
  // "object" for object files under `fun-out/obj` a separate link step
  // combines.
  str output;
}

// No `[build]` settings at all.
pub fun build_settings_new() BuildSettings {
  BuildSettings b;
  b.sources.init(0);
  b.include_dirs.init(0);
  b.lib_dirs.init(0);
  b.links.init(0);
  b.cflags.init(0);
  b.ldflags.init(0);
  b.freestanding = false;
  b.os_main_thread = false;
  b.c_runtime = "";
  b.target_arch = "";
  b.output = "";
  ret b;
}

// `./fun.toml`'s `[build]` settings, read once per process; empty when
// there is no manifest here or it doesn't parse (the command that needs
// the manifest reports that itself).
Once _project_build_loaded;
BuildSettings _project_build;

pub fun project_build_settings() BuildSettings {
  if _project_build_loaded.begin() {
    _project_build = build_settings_new();
    if exists("fun.toml") {
      let parsed = parse_manifest(read_to_string("fun.toml"));
      if parsed.is_ok() {
        Manifest m = parsed.unwrap();
        _project_build = build_for_host(&m, host_os_name());
      }
    }
    _project_build_loaded.finish();
  }
  ret _project_build;
}

// `m.build` with `[build.<os_name>]` added on: its lists after the base
// ones, its `os_main_thread` turning that on, and its `c_runtime` in
// place of the base one.
pub fun build_for_host(Manifest* m, str os_name) BuildSettings {
  BuildSettings b = m.build;
  let extra = m.build_for_os.at(os_name);
  if extra.is_none() {
    ret b;
  }
  BuildSettings e = extra.unwrap();
  for v : e.sources {
    b.sources.push(v);
  }
  for v : e.include_dirs {
    b.include_dirs.push(v);
  }
  for v : e.lib_dirs {
    b.lib_dirs.push(v);
  }
  for v : e.links {
    b.links.push(v);
  }
  for v : e.cflags {
    b.cflags.push(v);
  }
  for v : e.ldflags {
    b.ldflags.push(v);
  }
  if e.os_main_thread {
    b.os_main_thread = true;
  }
  if !equals(e.c_runtime, "") {
    b.c_runtime = e.c_runtime;
  }
  ret b;
}

// The OS this compiler is running on: "macos", "linux", or "windows", or
// "" for any other. Read from files only each OS has, rather than by
// running a program: this module is also built for the browser, where
// starting a process isn't available.
Once _host_os_loaded;
str _host_os = "";

pub fun host_os_name() str {
  if _host_os_loaded.begin() {
    if runtime_backend_is_windows() {
      _host_os = "windows";
    } elif exists("/System/Library/CoreServices/SystemVersion.plist") {
      _host_os = "macos";
    } elif exists("/proc/version") {
      _host_os = "linux";
    }
    _host_os_loaded.finish();
  }
  ret _host_os;
}

// Set by `-os-main-thread` on the command line.
flag _os_main_thread_requested = false;

pub fun request_os_main_thread_build() {
  _os_main_thread_requested = true;
}

// True when `main` runs on the process's own first thread: asked for with
// `-os-main-thread` or `[build] os_main_thread = true`. A GUI toolkit that
// insists on that thread (macOS's, under a windowing library) needs it.
pub fun is_os_main_thread_build() flag {
  ret _os_main_thread_requested || project_build_settings().os_main_thread;
}

// True when an MSVC-ABI build links the DLL C runtime:
// `[build] c_runtime = "dll"`, or the same in `[build.windows]`.
pub fun is_dll_c_runtime_build() flag {
  ret equals(project_build_settings().c_runtime, "dll");
}

// The error for a `c_runtime` other than "static" or "dll", or none.
fun _c_runtime_error(str table, str value) Option<str> {
  if equals(value, "") || equals(value, "static") || equals(value, "dll") {
    ret .None;
  }
  ret .Some(
    format("[{str}] `c_runtime` must be \"static\" or \"dll\", found `{str}`", table, value)
  );
}

// Set by `-freestanding` on the command line.
flag _freestanding_requested = false;

pub fun request_freestanding_build() {
  _freestanding_requested = true;
}

// True when this build targets bare metal: asked for with `-freestanding`
// or `[build] freestanding = true`. Such a build gets no C library, no
// runtime, and no `main` wrapper, for a kernel, bootloader, or firmware.
pub fun is_freestanding_build() flag {
  ret _freestanding_requested || project_build_settings().freestanding;
}

impl BuildSettings {
  // True when nothing beyond the defaults was asked for.
  pub is_empty() flag {
    ret self.sources.len == 0 && self.include_dirs.len == 0 && self.lib_dirs.len == 0 &&
      self.links.len == 0 && self.cflags.len == 0 && self.ldflags.len == 0;
  }

  pub free() {
    self.sources.free();
    self.include_dirs.free();
    self.lib_dirs.free();
    self.links.free();
    self.cflags.free();
    self.ldflags.free();
  }
}

impl Manifest {
  // What this package builds, once targets have been resolved.
  pub kind() PackageKind {
    if self.has_lib && self.exes.len > 0 {
      ret .Mixed;
    }
    if self.has_lib {
      ret .Lib;
    }
    if self.exes.len > 0 {
      ret .Exe;
    }
    ret .Empty;
  }

  pub free() {
    self.authors.free();
    self.exes.free();
    self.deps.free();
    self.build.free();
  }
}

// A dependency `name`, safe to appear as an `use deps.<name>...` path
// segment: must look like an ordinary identifier, since it becomes part
// of a dotted import path. Also reused to validate `token_env` (a real
// environment-variable name has the same shape).
pub fun is_safe_dep_name(str s) flag {
  if equals(s, "") {
    ret false;
  }
  chr first = s[0];
  if first >= '0' && first <= '9' {
    ret false;
  }
  num n = len(s);
  num i = 0;
  for i < n {
    chr c = s[i];
    flag ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') || c == '_';
    if !ok {
      ret false;
    }
    i = i + 1;
  }
  // A dependency named e.g. "fun" or "flag" would otherwise compile
  // fine as an identifier here, but break the moment anything writes
  // `use deps.<name>...`: the lexer tokenizes that segment as the
  // reserved word, not a plain identifier, and the import fails to
  // parse. Reject it before it ever gets written into fun.toml.
  if is_keyword(s) {
    ret false;
  }
  ret true;
}

// A git ref (`tag`/`branch`/`rev`), safe to pass straight into a git
// argv without being mistaken for a flag or escaping its intended
// meaning. Refs may contain `/` (`feature/foo`) and `.`/`-`/`_`, but
// never start with `-` (a value like `--upload-pack=...` is a known
// real git-CLI argument-injection shape) and never contain `..` (not a
// filesystem path, but defensive: git itself already rejects `..` in
// real ref names, so this only ever rejects something that was never a
// valid ref to begin with).
pub fun is_safe_git_ref(str s) flag {
  if equals(s, "") {
    ret false;
  }
  if s[0] == '-' {
    ret false;
  }
  if contains(s, "..") {
    ret false;
  }
  num n = len(s);
  num i = 0;
  for i < n {
    chr c = s[i];
    flag ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' ||
    c == '/';
    if !ok {
      ret false;
    }
    i = i + 1;
  }
  ret true;
}

// A dependency's `git` URL: allow-listed to the transports this feature
// actually supports - `https://`, `ssh://` and the `git@host:...` SCP-
// like shorthand, and `file://` (needed for local test fixtures).
// Rejects every other git transport helper (`ext::`, `fd::`, and
// similar), some of which have a real history of being abused to run
// arbitrary local commands via a crafted "URL".
pub fun is_safe_git_url(str s) flag {
  ret starts_with(s, "https://") || starts_with(s, "ssh://") ||
  starts_with(s, "git@") || starts_with(s, "file://");
}

// A dependency's own `path` subfolder inside its repo: rejects the
// obviously-unsafe shapes at parse time (an absolute path, a `..`
// segment, a backslash that could confuse a Windows-style separator).
// The real enforcement - canonicalizing against the actual checkout
// root and rejecting anything that normalizes outside it - happens in
// `src/cli/deps.fn` once the repo is actually fetched; this is just a
// fast, obvious first check.
pub fun is_safe_dep_path(str s) flag {
  if equals(s, "") {
    ret true;
  }
  ret !starts_with(s, "/") && !contains(s, "\\") && !contains(s, "..");
}

// The strings of a one-line `["a", "b"]` array as the TOML reader leaves it
// (the raw text, since it has no array type). Anything else reads as empty.
pub fun _parse_string_array(str value) Vec<str> {
  Vec<str> out;
  out.init(0);
  str text = trim(value);
  if len(text) < 2 || text[0] != '[' || text[len(text) - 1] != ']' {
    ret out;
  }
  str inner = substr(text, 1, len(text) - 2);
  // Split on commas outside quotes only: a quoted item may hold commas
  // of its own (`"-Wl,-rpath,lib"`).
  num start = 0;
  flag quoted = false;
  num i = 0;
  num n = len(inner);
  for i <= n {
    if i < n && inner[i] == '"' {
      quoted = !quoted;
    } elif i == n || inner[i] == ',' && !quoted {
      str item = trim(substr(inner, start, i - start));
      if len(item) >= 2 && item[0] == '"' && item[len(item) - 1] == '"' {
        item = substr(item, 1, len(item) - 2);
      }
      if !equals(item, "") {
        out.push(item);
      }
      start = i + 1;
    }
    i = i + 1;
  }
  ret out;
}

// Whether `v` is a plain `MAJOR.MINOR.PATCH` version - a `-`/`+`
// suffix is allowed and ignored, matching `semver_cmp` below. This
// project's own release tags, and so `PACKAGE_VERSION`, are always
// exactly this shape (see `release.yml`'s version-match check).
pub fun is_valid_semver(str v) flag {
  str core = _semver_core(v);
  Vec<str> parts = split(core, '.');
  flag ok = parts.len == 3;
  if ok {
    for part : parts {
      let n = try_parse_int(part);
      if n.is_err() || n.unwrap() < 0 {
        ok = false;
      }
    }
  }
  parts.free();
  ret ok;
}

// -1 when `a` is an older version than `b`, 0 when they're the same,
// 1 when `a` is newer - a numeric comparison of the `MAJOR.MINOR.PATCH`
// core, not a lexical string compare (which gets `"0.9.0"` vs
// `"0.10.0"` backwards). Used by `fun build`'s `min_fun_version` check
// and `fun upgrade`'s "already on the latest version" check.
pub fun semver_cmp(str a, str b) num {
  num a_major = 0;
  num a_minor = 0;
  num a_patch = 0;
  num b_major = 0;
  num b_minor = 0;
  num b_patch = 0;
  _semver_parse(a, &a_major, &a_minor, &a_patch);
  _semver_parse(b, &b_major, &b_minor, &b_patch);
  if a_major != b_major {
    ret _semver_cmp_num(a_major, b_major);
  }
  if a_minor != b_minor {
    ret _semver_cmp_num(a_minor, b_minor);
  }
  ret _semver_cmp_num(a_patch, b_patch);
}

fun _semver_cmp_num(num a, num b) num {
  if a < b {
    ret -1;
  }
  if a > b {
    ret 1;
  }
  ret 0;
}

// `v` with a trailing `-pre`/`+build` suffix (if any) cut off.
fun _semver_core(str v) str {
  num cut = index_of_char(v, '-');
  num plus = index_of_char(v, '+');
  if plus >= 0 && (cut < 0 || plus < cut) {
    cut = plus;
  }
  if cut < 0 {
    ret v;
  }
  ret substr(v, 0, cut);
}

fun _semver_parse(str v, num* major, num* minor, num* patch) {
  Vec<str> parts = split(_semver_core(v), '.');
  *major = _semver_part(&parts, 0);
  *minor = _semver_part(&parts, 1);
  *patch = _semver_part(&parts, 2);
  parts.free();
}

fun _semver_part(Vec<str>* parts, num idx) num {
  if idx >= parts.len {
    ret 0;
  }
  ret parse_int(parts.get(idx));
}

// Reads `text` as a manifest. Targets are taken exactly as declared;
// see `resolve_targets` for filling in the conventional defaults.
pub fun parse_manifest(str text) Result<Manifest, str> {
  let doc = parse_document(text);
  defer doc.free();

  Manifest m;
  m.package_name = "";
  m.version = "";
  m.description = "";
  m.license = "";
  m.repository = "";
  m.authors.init(0);
  m.min_fun_version = "";
  m.has_lib = false;
  m.lib.name = "";
  m.lib.path = "";
  m.exes.init(0);
  m.deps.init(0);
  m.has_cover_min = false;
  m.cover_min_tenths = 0;
  m.cover_exclude.init(0);
  m.build = build_settings_new();
  m.build_for_os.init(4);

  let pkg = doc.table("package");
  if pkg.is_none() {
    ret .Err("fun.toml is missing its [package] table");
  }
  m.package_name = pkg.unwrap().get_str("name");
  if equals(m.package_name, "") {
    ret .Err("[package] is missing a `name`");
  }
  m.version = pkg.unwrap().get_str("version");
  if equals(m.version, "") {
    m.version = "0.0.0";
  }
  m.description = pkg.unwrap().get_str("description");
  m.license = pkg.unwrap().get_str("license");
  m.repository = pkg.unwrap().get_str("repository");
  m.authors = _parse_string_array(pkg.unwrap().get_str("authors"));
  m.min_fun_version = pkg.unwrap().get_str("min_fun_version");
  if !equals(m.min_fun_version, "") && !is_valid_semver(m.min_fun_version) {
    ret .Err(
      format(
      "[package] `min_fun_version` must be a plain `MAJOR.MINOR.PATCH` version, found `{str}`",
      m.min_fun_version
      )
    );
  }

  num ti = 0;
  for ti < doc.tables.len {
    str tname = doc.tables.get(ti).name;
    // A `[build.<os>]` table is checked where it's read, below.
    if !equals(tname, "package") && !equals(tname, "lib") && !equals(tname, "deps") &&
      !equals(tname, "coverage") && !equals(tname, "build") && !starts_with(tname, "build.") {
      ret .Err(format("unknown table `[{str}]`", tname));
    }
    ti = ti + 1;
  }
  num ai = 0;
  for ai < doc.array_tables.len {
    str aname = doc.array_tables.get(ai).name;
    if !equals(aname, "exe") {
      ret .Err(format("unknown table `[[{str}]]`", aname));
    }
    ai = ai + 1;
  }

  let cover = doc.table("coverage");
  if cover.is_some() {
    let min = cover.unwrap().get("min");
    if min.is_some() {
      num tenths = -1;
      let whole = min.unwrap().as_int();
      let fractional = min.unwrap().as_float();
      if whole.is_some() {
        tenths = whole.unwrap() * 10;
      } elif fractional.is_some() {
        tenths = parse_percent_tenths(format_dec(fractional.unwrap(), 1));
      }
      if tenths < 0 || tenths > 1000 {
        ret .Err("[coverage] `min` must be a percentage from 0 to 100");
      }
      m.has_cover_min = true;
      m.cover_min_tenths = tenths;
    }
    m.cover_exclude = _parse_string_array(cover.unwrap().get_str("exclude"));
  }

  let build = doc.table("build");
  if build.is_some() {
    Vec<str> build_keys = build.unwrap().values.keys();
    defer build_keys.free();
    for bk : build_keys {
      fit bk {
        "sources", "include_dirs", "lib_dirs", "links", "cflags", "ldflags", "freestanding",
        "os_main_thread", "c_runtime", "arch", "output" -> {}
        _ -> {
          ret .Err(
            format(
            "unknown key `{str}` in [build] (expected sources, include_dirs, lib_dirs, links, cflags, ldflags, freestanding, os_main_thread, c_runtime, arch, or output)",
            bk
            )
          );
        }
      }
    }
    m.build.sources = _parse_string_array(build.unwrap().get_str("sources"));
    m.build.include_dirs = _parse_string_array(build.unwrap().get_str("include_dirs"));
    m.build.lib_dirs = _parse_string_array(build.unwrap().get_str("lib_dirs"));
    m.build.links = _parse_string_array(build.unwrap().get_str("links"));
    m.build.cflags = _parse_string_array(build.unwrap().get_str("cflags"));
    m.build.ldflags = _parse_string_array(build.unwrap().get_str("ldflags"));
    let fs_value = build.unwrap().get("freestanding");
    if fs_value.is_some() {
      let fs_flag = fs_value.unwrap().as_bool();
      if fs_flag.is_none() {
        ret .Err("[build] `freestanding` must be true or false");
      }
      m.build.freestanding = fs_flag.unwrap();
    }
    let omt_value = build.unwrap().get("os_main_thread");
    if omt_value.is_some() {
      let omt_flag = omt_value.unwrap().as_bool();
      if omt_flag.is_none() {
        ret .Err("[build] `os_main_thread` must be true or false");
      }
      m.build.os_main_thread = omt_flag.unwrap();
    }
    m.build.c_runtime = build.unwrap().get_str("c_runtime");
    let crt_error = _c_runtime_error("build", m.build.c_runtime);
    if crt_error.is_some() {
      ret .Err(crt_error.unwrap());
    }
    m.build.target_arch = build.unwrap().get_str("arch");
    m.build.output = build.unwrap().get_str("output");
    if !equals(m.build.output, "") && !equals(m.build.output, "exe") &&
      !equals(m.build.output, "object") {
      ret .Err(
        format(
        "[build] `output` must be \"exe\" or \"object\", found `{str}`",
        m.build.output
        )
      );
    }
  }

  // `[build.<os>]`: more settings for one OS.
  for t : doc.tables {
    if !starts_with(t.name, "build.") {
      continue;
    }
    str os_name = substr(t.name, 6, len(t.name) - 6);
    if !equals(os_name, "macos") && !equals(os_name, "linux") && !equals(os_name, "windows") {
      ret .Err(
        format(
        "unknown table `[{str}]` (expected build.macos, build.linux, or build.windows)",
        t.name
        )
      );
    }
    Vec<str> os_keys = t.values.keys();
    defer os_keys.free();
    for ok : os_keys {
      fit ok {
        "sources", "include_dirs", "lib_dirs", "links", "cflags", "ldflags", "os_main_thread",
        "c_runtime" -> {}
        _ -> {
          ret .Err(
            format(
            "unknown key `{str}` in [{str}] (expected sources, include_dirs, lib_dirs, links, cflags, ldflags, os_main_thread, or c_runtime)",
            ok,
            t.name
            )
          );
        }
      }
    }
    BuildSettings os_build = build_settings_new();
    os_build.sources = _parse_string_array(t.get_str("sources"));
    os_build.include_dirs = _parse_string_array(t.get_str("include_dirs"));
    os_build.lib_dirs = _parse_string_array(t.get_str("lib_dirs"));
    os_build.links = _parse_string_array(t.get_str("links"));
    os_build.cflags = _parse_string_array(t.get_str("cflags"));
    os_build.ldflags = _parse_string_array(t.get_str("ldflags"));
    let os_omt = t.get("os_main_thread");
    if os_omt.is_some() {
      let os_omt_flag = os_omt.unwrap().as_bool();
      if os_omt_flag.is_none() {
        ret .Err(format("[{str}] `os_main_thread` must be true or false", t.name));
      }
      os_build.os_main_thread = os_omt_flag.unwrap();
    }
    os_build.c_runtime = t.get_str("c_runtime");
    let os_crt_error = _c_runtime_error(t.name, os_build.c_runtime);
    if os_crt_error.is_some() {
      ret .Err(os_crt_error.unwrap());
    }
    m.build_for_os.put(os_name, os_build);
  }

  let lib = doc.table("lib");
  if lib.is_some() {
    m.has_lib = true;
    m.lib.name = lib.unwrap().get_str("name");
    m.lib.path = lib.unwrap().get_str("path");
  }

  let exes = doc.array("exe");
  defer exes.free();
  num i = 0;
  for i < exes.len {
    str name = exes.get(i).get_str("name");
    str path = exes.get(i).get_str("path");
    if equals(name, "") {
      ret .Err("an [[exe]] is missing a `name`");
    }
    if equals(path, "") {
      ret .Err(format("[[exe]] `{str}` is missing a `path`", name));
    }
    ExeTarget e;
    e.name = name;
    e.path = path;
    m.exes.push(e);
    i = i + 1;
  }

  let deps_table = doc.table("deps");
  if deps_table.is_some() {
    let dt = deps_table.unwrap();
    let dep_names = dt.values.keys();
    defer dep_names.free();
    num di = 0;
    for di < dep_names.len() {
      // A fresh clone, not `dep_names`'s own borrowed entry: this
      // name is stored into `Dependency.name` below, which outlives
      // `doc` (freed, keys included, when this function returns).
      str borrowed_name = dep_names.get(di);
      str dname = substr(borrowed_name, 0, len(borrowed_name));
      if !is_safe_dep_name(dname) {
        ret .Err(
          format(
          "[deps] `{str}`: a dependency's name must be a plain identifier (letters, digits, underscore, not starting with a digit)",
          dname
          )
        );
      }
      let entry_val = dt.values.get(dname);
      if !entry_val.is_table() {
        ret .Err(
          format(
          "[deps] `{str}` must be an inline table: {str} = { git = \"...\" }",
          dname,
          dname
          )
        );
      }
      str dgit = entry_val.table_field("git");
      str dpath = entry_val.table_field("path");
      str dtag = entry_val.table_field("tag");
      str dbranch = entry_val.table_field("branch");
      str drev = entry_val.table_field("rev");
      str dtoken_env = entry_val.table_field("token_env");

      if equals(dgit, "") {
        ret .Err(format("[deps] `{str}` is missing a `git` URL", dname));
      }
      if !is_safe_git_url(dgit) {
        ret .Err(
          format(
          "[deps] `{str}`: `git` must start with https://, ssh://, git@, or file://",
          dname
          )
        );
      }
      if !is_safe_dep_path(dpath) {
        ret .Err(
          format(
          "[deps] `{str}`: `path` must be a relative path with no `..` segments",
          dname
          )
        );
      }

      num spec_count = 0;
      if !equals(dtag, "") {
        spec_count = spec_count + 1;
      }
      if !equals(dbranch, "") {
        spec_count = spec_count + 1;
      }
      if !equals(drev, "") {
        spec_count = spec_count + 1;
      }
      if spec_count > 1 {
        ret .Err(
          format("[deps] `{str}`: only one of `tag`, `branch`, `rev` may be given", dname)
        );
      }

      DepRef spec = .Auto;
      if !equals(dtag, "") {
        if !equals(dtag, "latest") && !is_safe_git_ref(dtag) {
          ret .Err(format("[deps] `{str}`: invalid `tag`", dname));
        }
        spec = .Tag(dtag);
      } elif !equals(dbranch, "") {
        if !is_safe_git_ref(dbranch) {
          ret .Err(format("[deps] `{str}`: invalid `branch`", dname));
        }
        spec = .Branch(dbranch);
      } elif !equals(drev, "") {
        if !is_safe_git_ref(drev) {
          ret .Err(format("[deps] `{str}`: invalid `rev`", dname));
        }
        spec = .Rev(drev);
      }

      if !equals(dtoken_env, "") && !is_safe_dep_name(dtoken_env) {
        ret .Err(format("[deps] `{str}`: invalid `token_env`", dname));
      }

      Dependency d;
      d.name = dname;
      d.git = dgit;
      d.path = dpath;
      d.spec = spec;
      d.token_env = dtoken_env;
      m.deps.push(d);
      di = di + 1;
    }
  }

  ret .Ok(m);
}

// Fills in whatever the manifest left implicit, relative to `root`:
// a `[lib]` with no path uses `src/lib.fn`, and a manifest declaring no
// targets at all picks up `src/lib.fn` and `src/main.fn` when they
// exist, each named after the package.
pub fun resolve_targets(Manifest* m, str root) {
  str lib_path = _join(root, "src/lib.fn");
  str main_path = _join(root, "src/main.fn");

  if m.has_lib {
    if equals(m.lib.path, "") {
      m.lib.path = lib_path;
    }
    if equals(m.lib.name, "") {
      m.lib.name = m.package_name;
    }
  }

  if !m.has_lib && m.exes.len == 0 {
    if exists(lib_path) {
      m.has_lib = true;
      m.lib.name = m.package_name;
      m.lib.path = lib_path;
    }
    if exists(main_path) {
      ExeTarget e;
      e.name = m.package_name;
      e.path = main_path;
      m.exes.push(e);
    }
  }
}

// Joins a directory and a relative path. An empty root leaves `rel`
// as-is, so a manifest read from the working directory keeps the plain
// relative paths it declared.
fun _join(str root, str rel) str {
  if equals(root, "") || equals(root, ".") {
    ret rel;
  }
  StringBuilder b = string_builder_init(32);
  b.append(root);
  if !ends_with(root, "/") {
    b.append("/");
  }
  b.append(rel);
  ret b.build();
}

// A constant supplied by the build rather than written in source.
pub compound Define {
  str name;
  str value;
}

// The constants every build makes available to the program: the package
// name and version, taken from the manifest.
pub fun manifest_defines(Manifest* m) Vec<Define> {
  Vec<Define> out;
  out.init(0);
  Define name;
  name.name = "PACKAGE_NAME";
  name.value = m.package_name;
  out.push(name);
  Define version;
  version.name = "PACKAGE_VERSION";
  version.value = m.version;
  out.push(version);
  ret out;
}

// The 1-based line of the first `<key> = ...` found inside `[section]`
// in raw manifest `text`, or 0 (never a real line) when the section or
// key isn't present. Used by fls to point PACKAGE_NAME/PACKAGE_VERSION's
// synthetic go-to-definition at the actual `name`/`version` line in
// `fun.toml`, rather than nowhere at all.
pub fun manifest_key_line(str text, str section, str key) num {
  let lines = split(text, '\n');
  defer lines.free();
  str header = format("[{str}]", section);
  flag in_section = false;
  num line_no = 0;
  for line : lines {
    line_no = line_no + 1;
    str trimmed = trim(line);
    if starts_with(trimmed, "[") {
      in_section = equals(trimmed, header);
      continue;
    }
    if !in_section {
      continue;
    }
    if starts_with(trimmed, key) {
      str rest = trim(substr(trimmed, len(key), len(trimmed) - len(key)));
      if starts_with(rest, "=") {
        ret line_no;
      }
    }
  }
  ret 0;
}

// Builds a `pub const str name = "value";` declaration, so a value known
// only to the build is reachable from source as an ordinary constant.
// Also used by fls (`analysis.fn`) to give a workspace's own
// PACKAGE_NAME/PACKAGE_VERSION the same hover/completion/go-to-
// definition support any other declared constant gets, rather than
// leaving them invisible to source analysis the way a build-only
// define otherwise would be.
pub fun manifest_const_node(str name, str value) Node {
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "str";

  Node* val = malloc(sizeof(Node));
  *val = node_new(.String(value));

  VariableNode v;
  v.var_type = dt;
  v.name = name;
  v.val = val;
  v.has_val = true;
  v.is_const = true;
  v.is_destructure = false;
  v.destructure_names.init(0);
  ret node_new(.Variable(v));
}

test "parses a package with a single executable" {
  str text = `[package]
  `name = "demo"
  `version = "1.2.3"
  `
  `[[exe]]
  `name = "app"
  `path = "src/main.fn"`;
  let r = parse_manifest(text);
  assert r.is_ok(), "expected the manifest to parse";
  let m = r.unwrap();
  assert equals(m.package_name, "demo"), "expected the package name";
  assert equals(m.version, "1.2.3"), "expected the declared version";
  assert m.exes.len == 1, "expected one executable target";
  assert equals(m.exes.get(0).name, "app"), "expected the executable's name";
  assert equals(m.exes.get(0).path, "src/main.fn"), "expected the executable's path";
  assert m.kind() == .Exe, "expected an executable-only package";
}

test "parses several executables" {
  str text = `[package]
  `name = "demo"
  `
  `[[exe]]
  `name = "one"
  `path = "src/one.fn"
  `
  `[[exe]]
  `name = "two"
  `path = "src/two.fn"`;
  let m = parse_manifest(text).unwrap();
  assert m.exes.len == 2, "expected both executable targets";
  assert equals(m.exes.get(1).name, "two"), "expected the second target";
}

test "parses a library-only package" {
  str text = `[package]
  `name = "mylib"
  `
  `[lib]
  `path = "src/lib.fn"`;
  let m = parse_manifest(text).unwrap();
  assert m.has_lib, "expected a library target";
  assert equals(m.lib.path, "src/lib.fn"), "expected the library path";
  assert m.kind() == .Lib, "expected a library-only package";
}

test "parses a package building both a library and an executable" {
  str text = `[package]
  `name = "both"
  `
  `[lib]
  `path = "src/lib.fn"
  `
  `[[exe]]
  `name = "cli"
  `path = "src/main.fn"`;
  let m = parse_manifest(text).unwrap();
  assert m.kind() == .Mixed, "expected a mixed package";
  assert m.has_lib, "expected the library target";
  assert m.exes.len == 1, "expected the executable target";
}

test "a version left out defaults to 0.0.0" {
  str text = `[package]
  `name = "demo"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.version, "0.0.0"), "expected the default version";
  assert m.kind() == .Empty, "expected no targets before resolution";
}

test "the rest of [package] is optional, and empty when left out" {
  str text = `[package]
  `name = "demo"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.description, ""), "expected no description";
  assert equals(m.license, ""), "expected no license";
  assert equals(m.repository, ""), "expected no repository";
  assert m.authors.len == 0, "expected no authors";
  assert equals(m.min_fun_version, ""), "expected no min_fun_version";
}

test "description, license, authors, repository, and min_fun_version all parse" {
  str text = `[package]
  `name = "demo"
  `version = "1.0.0"
  `description = "a demo package"
  `license = "MIT"
  `authors = ["a", "b"]
  `repository = "https://github.com/a/demo"
  `min_fun_version = "0.60.0"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.description, "a demo package"), "expected the description";
  assert equals(m.license, "MIT"), "expected the license";
  assert equals(m.repository, "https://github.com/a/demo"), "expected the repository";
  assert m.authors.len == 2, "expected two authors";
  assert equals(m.authors.get(0), "a"), "expected the first author";
  assert equals(m.authors.get(1), "b"), "expected the second author";
  assert equals(m.min_fun_version, "0.60.0"), "expected the min_fun_version";
}

test "a malformed min_fun_version is rejected" {
  str text = `[package]
  `name = "demo"
  `min_fun_version = "not-a-version"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a malformed min_fun_version to be rejected";
}

test "is_valid_semver accepts a plain MAJOR.MINOR.PATCH, with or without a suffix" {
  assert is_valid_semver("1.2.3"), "expected a plain version to be valid";
  assert is_valid_semver("0.0.0"), "expected an all-zero version to be valid";
  assert is_valid_semver("1.2.3-beta"), "expected a pre-release suffix to be allowed";
  assert is_valid_semver("1.2.3+build5"), "expected a build suffix to be allowed";
  assert !is_valid_semver("1.2"), "expected a two-component version to be rejected";
  assert !is_valid_semver("1.2.3.4"), "expected a four-component version to be rejected";
  assert !is_valid_semver("banana"), "expected a non-numeric version to be rejected";
  assert !is_valid_semver(""), "expected an empty version to be rejected";
}

test "semver_cmp compares numerically, not lexically" {
  assert semver_cmp("1.2.3", "1.2.3") == 0, "expected equal versions to compare equal";
  assert semver_cmp("1.2.3", "1.2.4") == -1, "expected a smaller patch to compare older";
  assert semver_cmp("1.2.3", "1.3.0") == -1, "expected a smaller minor to compare older";
  assert semver_cmp("2.0.0", "1.9.9") == 1, "expected a bigger major to compare newer";
  // The whole point of a numeric compare: "0.10.0" sorts after "0.9.0"
  // numerically, even though it sorts before it as a plain string.
  assert semver_cmp("0.9.0", "0.10.0") == -1, "expected a numeric, not lexical, comparison";
  assert semver_cmp("1.0.0-beta", "1.0.0") == 0, "expected a pre-release suffix to be ignored";
}

test "comments and blank lines are ignored" {
  str text = `# a leading comment
  `[package]
  `name = "demo" # trailing
  `
  `# another
  `version = "0.1.0"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.package_name, "demo"), "expected the name without the comment";
  assert equals(m.version, "0.1.0"), "expected the version";
}

test "a missing package name is rejected" {
  str text = `[package]
  `version = "0.1.0"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a manifest with no package name to be rejected";
}

test "an exe without a path is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[[exe]]
  `name = "app"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected an exe with no path to be rejected";
}

test "a value keeps its quotes stripped" {
  str text = `[package]
  `name = "demo"`;
  let m = parse_manifest(text).unwrap();
  assert equals(m.package_name, "demo"), "expected the quotes to be stripped";
}

test "an unknown table is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[nope]
  `key = "value"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected an unknown table to be rejected";
}

test "a lib with no path resolves to the conventional source file" {
  str text = `[package]
  `name = "mylib"
  `
  `[lib]`;
  Manifest m = parse_manifest(text).unwrap();
  resolve_targets(&m, "");
  assert equals(m.lib.path, "src/lib.fn"), "expected the conventional library path";
  assert equals(m.lib.name, "mylib"), "expected the library to take the package name";
}

fun _dep_named(Vec<Dependency>* deps, str name) Dependency {
  num i = 0;
  for i < deps.len {
    let d = deps.get(i);
    if equals(d.name, name) {
      ret d;
    }
    i = i + 1;
  }
  allow assert_constant, "reports the missing dependency's name";
  assert false, format("no dependency named {str}", name);
  ret deps.get(0);
}

test "parses a [deps] table with tag, branch, and rev entries" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = { git = "https://github.com/user/somejson", tag = "v1.2.3" }
  `httpclient = { git = "https://github.com/other/repo", path = "libs/httpclient", branch = "main" }
  `pinned = { git = "https://github.com/user/pinned", rev = "a1b2c3d" }`;
  let m = parse_manifest(text).unwrap();
  assert m.deps.len == 3, "expected three dependencies";

  let somejson = _dep_named(&m.deps, "somejson");
  assert equals(somejson.git, "https://github.com/user/somejson"), "expected the git url";
  assert equals(somejson.path, ""), "expected no subfolder";
  fit somejson.spec {
    .Tag(t) -> { assert equals(t, "v1.2.3"), "expected the tag value"; }
    _ -> {
      allow assert_constant, "reports the wrong spec variant if parsing regresses";
      assert false, "expected a Tag spec";
    }
  }

  let httpclient = _dep_named(&m.deps, "httpclient");
  assert equals(httpclient.path, "libs/httpclient"), "expected the subfolder";
  fit httpclient.spec {
    .Branch(b) -> { assert equals(b, "main"), "expected the branch value"; }
    _ -> {
      allow assert_constant, "reports the wrong spec variant if parsing regresses";
      assert false, "expected a Branch spec";
    }
  }

  let pinned = _dep_named(&m.deps, "pinned");
  fit pinned.spec {
    .Rev(r) -> { assert equals(r, "a1b2c3d"), "expected the rev value"; }
    _ -> {
      allow assert_constant, "reports the wrong spec variant if parsing regresses";
      assert false, "expected a Rev spec";
    }
  }
}

test "a [deps] entry with no tag/branch/rev defaults to Auto" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = { git = "https://github.com/user/somejson" }`;
  let m = parse_manifest(text).unwrap();
  fit m.deps.get(0).spec {
    .Auto -> {}
    _ -> {
      allow assert_constant, "reports the wrong spec variant if parsing regresses";
      assert false, "expected an Auto spec";
    }
  }
}

test "a [deps] entry giving both tag and branch is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = { git = "https://github.com/user/somejson", tag = "v1.0.0", branch = "main" }`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected conflicting tag/branch to be rejected";
}

test "a [deps] entry missing git is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = { tag = "v1.0.0" }`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a dependency with no git url to be rejected";
}

test "a [deps] entry with a disallowed git scheme is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = { git = "ext::sh -c evil" }`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a non-allow-listed git scheme to be rejected";
}

test "a [deps] entry with a flag-shaped tag is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = { git = "https://github.com/user/somejson", tag = "--upload-pack=evil" }`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected an argv-injection-shaped tag to be rejected";
}

test "a [deps] entry named after a reserved keyword is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `async = { git = "https://github.com/user/somejson" }`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a dependency literally named after a keyword to be rejected, use deps.async... would never parse";
}

test "a [deps] entry with a path-traversal path is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = { git = "https://github.com/user/somejson", path = "../../etc" }`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a path escaping the checkout to be rejected";
}

test "a non-inline-table [deps] entry is rejected" {
  str text = `[package]
  `name = "demo"
  `
  `[deps]
  `somejson = "not a table"`;
  let r = parse_manifest(text);
  assert r.is_err(), "expected a scalar [deps] entry to be rejected";
}

test "[coverage] reads a minimum and a list of excluded paths" {
  let ok = parse_manifest(
    "[package]\nname = \"demo\"\n\n[coverage]\nmin = 80\nexclude = [\"examples\", \"scripts/tools\"]\n"
  );
  assert ok.is_ok(), "expected a manifest with [coverage] to parse";
  Manifest m = ok.unwrap();
  assert m.has_cover_min && m.cover_min_tenths == 800, "expected 80 to read as 800 tenths";
  assert m.cover_exclude.len == 2, "expected both exclusions";
  assert equals(m.cover_exclude.get(0), "examples") &&
    equals(m.cover_exclude.get(1), "scripts/tools"), "expected the paths without quotes";
}

test "[coverage] min accepts one decimal and rejects out-of-range values" {
  let frac = parse_manifest("[package]\nname = \"demo\"\n\n[coverage]\nmin = 87.5\n");
  assert frac.is_ok(), "expected a decimal minimum to parse";
  assert frac.unwrap().cover_min_tenths == 875, "expected 87.5 to read as 875 tenths";
  let too_big = parse_manifest("[package]\nname = \"demo\"\n\n[coverage]\nmin = 120\n");
  assert too_big.is_err(), "expected a minimum over 100 to be rejected";
  let none = parse_manifest("[package]\nname = \"demo\"\n");
  assert none.is_ok() && !none.unwrap().has_cover_min, "expected no [coverage] to mean no minimum";
}

test "a string array reads its items and ignores anything else" {
  Vec<str> two = _parse_string_array("[\"a\", \"b\"]");
  assert two.len == 2 && equals(two.get(1), "b"), "expected two items";
  Vec<str> none = _parse_string_array("not an array");
  assert none.len == 0, "expected a non-array to read as empty";
  Vec<str> empty = _parse_string_array("[]");
  assert empty.len == 0, "expected an empty array to read as empty";
}

test "parses [build] settings, and rejects an unknown key there" {
  str text = `[package]
  `name = "game"
  `
  `[build]
  `sources = ["native/glue.c", "boot/start.S"]
  `include_dirs = ["vendor/include"]
  `lib_dirs = ["vendor/lib"]
  `links = ["SDL2", "m"]
  `cflags = ["-march=native"]
  `ldflags = ["-Wl,-rpath,vendor/lib"]`;
  let m = parse_manifest(text).unwrap();
  assert m.build.sources.len == 2 && equals(m.build.sources.get(1), "boot/start.S"), "expected both sources";
  assert equals(m.build.include_dirs.get(0), "vendor/include"), "expected the include dir";
  assert equals(m.build.lib_dirs.get(0), "vendor/lib"), "expected the lib dir";
  assert m.build.links.len == 2 && equals(m.build.links.get(0), "SDL2"), "expected both libraries";
  assert equals(m.build.cflags.get(0), "-march=native"), "expected the compiler flag";
  assert equals(m.build.ldflags.get(0), "-Wl,-rpath,vendor/lib"), "expected the linker flag";
  assert !m.build.is_empty(), "expected settings present";
  let bad = parse_manifest(`[package]
  `name = "game"
  `
  `[build]
  `link = ["SDL2"]`);
  assert bad.is_err() && contains(bad.unwrap_err(), "unknown key `link` in [build]"), "expected a typo reported";
  let plain = parse_manifest(`[package]
  `name = "plain"`).unwrap();
  assert plain.build.is_empty(), "expected no settings without a [build] table";
}

test "[build] os_main_thread takes true or false" {
  let m = parse_manifest(`[package]
  `name = "game"
  `
  `[build]
  `os_main_thread = true`)
    .unwrap();
  assert m.build.os_main_thread, "expected os_main_thread read";
  let bad = parse_manifest(`[package]
  `name = "game"
  `
  `[build]
  `os_main_thread = "yes"`);
  assert bad.is_err() &&
    contains(bad.unwrap_err(), "`os_main_thread` must be true or false"), "expected a non-flag rejected";
}

test "[build.<os>] settings are added to [build] on that OS only" {
  let m = parse_manifest(
    `[package]
  `name = "game"
  `
  `[build]
  `links = ["raylib"]
  `
  `[build.macos]
  `lib_dirs = ["vendor/macos/lib"]
  `os_main_thread = true
  `
  `[build.windows]
  `links = ["opengl32", "gdi32", "winmm"]`
  )
  .unwrap();

  BuildSettings mac = build_for_host(&m, "macos");
  assert mac.links.len == 1 && mac.lib_dirs.len == 1 && mac.os_main_thread, "expected the macOS table added on";
  BuildSettings win = build_for_host(&m, "windows");
  assert win.links.len == 4 && equals(win.links.get(3), "winmm") && !win.os_main_thread, "expected the Windows libraries after the base one";
  BuildSettings linux = build_for_host(&m, "linux");
  assert linux.links.len == 1 && linux.lib_dirs.len == 0, "expected only the base settings on Linux";
  let bad_os = parse_manifest(`[package]
  `name = "game"
  `
  `[build.amiga]
  `links = ["x"]`);
  assert bad_os.is_err() &&
    contains(bad_os.unwrap_err(), "unknown table `[build.amiga]`"), "expected an unknown OS reported";
  let bad_key = parse_manifest(`[package]
  `name = "game"
  `
  `[build.linux]
  `arch = "x86_64"`);
  assert bad_key.is_err() &&
    contains(bad_key.unwrap_err(), "unknown key `arch` in [build.linux]"), "expected a base-only key reported";
}

test "[build] output takes exe or object" {
  let m = parse_manifest(`[package]
  `name = "kernel"
  `
  `[build]
  `output = "object"`)
    .unwrap();
  assert equals(m.build.output, "object"), "expected object output read";
  let bad = parse_manifest(`[package]
  `name = "kernel"
  `
  `[build]
  `output = "lib"`);
  assert bad.is_err() && contains(bad.unwrap_err(), "`output` must be"), "expected an unknown output rejected";
}

test "[build] c_runtime takes static or dll, and [build.windows] overrides it" {
  let m = parse_manifest(
    `[package]
  `name = "game"
  `
  `[build]
  `c_runtime = "static"
  `
  `[build.windows]
  `c_runtime = "dll"`
  )
  .unwrap();
  assert equals(build_for_host(&m, "windows").c_runtime, "dll"), "expected the Windows table's runtime";
  assert equals(build_for_host(&m, "linux").c_runtime, "static"), "expected the base runtime elsewhere";
  let bad = parse_manifest(`[package]
  `name = "game"
  `
  `[build]
  `c_runtime = "shared"`);
  assert bad.is_err() &&
    contains(bad.unwrap_err(), "`c_runtime` must be \"static\" or \"dll\""), "expected an unknown runtime rejected";
}
