// Compiler entry point: reads the command line, lowers the input to C,
// then builds and runs it unless asked not to.

use driver;
use upgrade;
use ..parser.import_resolver;
use std.string;
use std.io;
use std.fs;
use std.vec;
use std.sys;
use std.path;
use std.process;

fun _fail(str msg) num {
  writeln_to(Sink.Stderr, format(`[Error]
  `{str}`, msg));
  ret 1;
}

// Sets `FUN_STDLIB_DIR` for the rest of this process when it isn't
// already set, from wherever `PATH` would resolve this same `fun` (or
// `fls`) to right now - what every real release bundle (and `fun
// upgrade`) actually lays out is `<prefix>/bin/fun` beside `<prefix>/
// share/fun/std`. A no-op when the override is already set, or
// neither binary is on `PATH`, or its own prefix has no real
// `share/fun/std` beside it: `import_resolver.fn`'s own walk-up (or a
// still-unset `FUN_STDLIB_DIR`, reported honestly as "import not
// found") covers every other case already.
//
// Deliberately done here, in the real compiler's own entry point, not
// inside `stdlib_root()` itself: `import_resolver.fn` is also what
// the wasm-targeted frontend (`lower.fn`/`wasm_frontend_main.fn`)
// imports to resolve a std.* import inside a browser sandbox, and
// `std.process` (needed to ask `PATH` at all) transitively pulls in
// `std.c.process`, which trips `codegen.fn`'s own `emscripten_mode`
// rejection the instant anything imports it - confirmed directly, not
// theoretical, as a real website build failing outright. This file is
// never wasm-targeted, so asking `PATH` here costs that invariant
// nothing.
fun _ensure_stdlib_dir_env() {
  str configured = env("FUN_STDLIB_DIR");
  if configured != nil && !equals(configured, "") {
    ret;
  }
  // `stdlib_root`'s own walk-up (from the current directory, a stand-in
  // for whatever input file this process goes on to compile - every
  // file `fun build` compiles shares this same project root) already
  // wins over asking `PATH` at all; only its own last-resort bare
  // literal sentinel means walking up genuinely found nothing. Without
  // this check, running inside this compiler's own source checkout -
  // which already has a real `./stdlib/std` right there - would still
  // reach for whatever's installed on `PATH` instead, silently
  // building against a stale, already-installed stdlib rather than
  // this checkout's own newer one.
  str walked_up = stdlib_root(".");
  flag already_resolved = !equals(walked_up, "stdlib");
  free(walked_up);
  if already_resolved {
    ret;
  }
  str fun_path = find_on_path("fun");
  if equals(fun_path, "") {
    free(fun_path);
    fun_path = find_on_path("fls");
  }
  if equals(fun_path, "") {
    free(fun_path);
    ret;
  }
  str bin_dir = dirname(fun_path);
  str prefix = dirname(bin_dir);
  free(bin_dir);
  free(fun_path);
  str candidate = path_join(prefix, "share/fun");
  free(prefix);
  str probe = path_join(candidate, "std");
  flag found = is_dir(probe);
  free(probe);
  if found {
    let _rc = set_env("FUN_STDLIB_DIR", candidate);
  }
  free(candidate);
}

fun main(str[] args) num {
  _ensure_stdlib_dir_env();
  // A totally bare invocation is a request for usage, not an error --
  // anything past the program name that still fails to resolve an input
  // falls through to the `opts.input == ""` case below instead, which is
  // a real error.
  if args[1] == 0 {
    println(help_text());
    ret 0;
  }

  Options opts = parse_args(args);
  defer opts.free();

  if opts.has_error {
    ret _fail(opts.error_text);
  }
  if opts.show_version {
    // `PACKAGE_VERSION` is not declared in this file: `fun build` injects
    // it as a top-level const ahead of every target it compiles, taken
    // from this repository's own fun.toml, so the compiled binary
    // reports its own release version rather than re-reading a
    // manifest at runtime (which could be some unrelated project's).
    println(PACKAGE_VERSION);
    ret 0;
  }
  if opts.show_help {
    println(help_text());
    ret 0;
  }
  // Checked once, ahead of every dispatch branch below (test/fuzz
  // included, both spellings) rather than only the plain-compile
  // fallthrough at the bottom of this function - `-ast -test` used to
  // silently print nothing at all, since run_tests/run_fuzz return
  // before ever reaching that check. Guarded the same way a single
  // real input file already has to be for any of those branches to do
  // anything; a directory-suite form (no single file, an empty/invalid
  // `-in`) has no one AST to print, so it's simply skipped here rather
  // than special-cased.
  if opts.show_ast && !equals(opts.input, "") && ends_with(opts.input, ".fn") &&
    exists(opts.input) {
    print_ast_for(opts.input);
  }
  if equals(opts.subcommand, "build") {
    ret build_project(opts.debug_info, &opts.defines);
  }
  if equals(opts.subcommand, "init") {
    ret init_project(opts.input);
  }
  if equals(opts.subcommand, "add") {
    ret add_dependency(
      opts.input,
      opts.dep_git,
      opts.dep_path,
      opts.dep_tag,
      opts.dep_branch,
      opts.dep_rev,
      opts.dep_token_env
    );
  }
  if equals(opts.subcommand, "deps") {
    if !equals(opts.deps_action, "update") {
      ret _fail(format("unknown `fun deps` action `{str}` (expected `update`)", opts.deps_action));
    }
    ret deps_update_command(opts.input);
  }
  if equals(opts.subcommand, "lint") {
    ret run_lint(opts.input, opts.lint_summary);
  }
  if equals(opts.subcommand, "upgrade") {
    ret upgrade_cli(opts.upgrade_check);
  }
  if equals(opts.subcommand, "test") {
    apply_manifest_coverage(&opts.cover);
    // No path, or a path that names a directory rather than a `.fn`
    // file, runs every `test` block found under that root instead of a
    // single file. `fun test some_file.fn` keeps compiling and running
    // just that one file.
    flag is_dir_form = equals(opts.input, "") || !ends_with(opts.input, ".fn") ||
      is_dir(opts.input);
    if is_dir_form {
      str root = opts.input;
      if equals(root, "") {
        root = ".";
      }
      ret run_test_suite(root, opts.debug_info, opts.warn_unused, opts.warn_unused_lenient, &opts.defines, &opts.cover, opts.memcheck, opts.memcheck_leaks);
    }
    ret run_tests(opts.input, &opts.program_args, opts.debug_info, opts.no_exec, opts.output, opts.warn_unused, opts.warn_unused_lenient, opts.keep_c, &opts.defines, &opts.cover, opts.memcheck, opts.memcheck_leaks);
  }
  if equals(opts.subcommand, "fuzz") {
    // No path, or a path that names a directory rather than a `.fn`
    // file, runs every `fuzz` target found under that root instead of a
    // single file, each bounded to a short default budget rather than
    // fuzzing's normal open-ended campaign. A target name only makes
    // sense alongside a specific file, so this form never takes one.
    flag is_dir_form = equals(opts.input, "") || !ends_with(opts.input, ".fn") ||
      is_dir(opts.input);
    if is_dir_form {
      str root = opts.input;
      if equals(root, "") {
        root = ".";
      }
      ret run_fuzz_suite(root, opts.debug_info, opts.warn_unused, opts.warn_unused_lenient, &opts.defines);
    }
    ret run_fuzz(opts.input, opts.fuzz_target, &opts.program_args, opts.debug_info, opts.no_exec, opts.output, opts.warn_unused, opts.warn_unused_lenient, opts.keep_c, &opts.defines);
  }
  // `-test`/`-fuzz` given directly alongside `-in`, rather than through
  // the `test`/`fuzz` subcommand spellings above.
  if opts.test_flag {
    apply_manifest_coverage(&opts.cover);
    ret run_tests(opts.input, &opts.program_args, opts.debug_info, opts.no_exec, opts.output, opts.warn_unused, opts.warn_unused_lenient, opts.keep_c, &opts.defines, &opts.cover, opts.memcheck, opts.memcheck_leaks);
  }
  if opts.fuzz_flag {
    ret run_fuzz(opts.input, opts.fuzz_target, &opts.program_args, opts.debug_info, opts.no_exec, opts.output, opts.warn_unused, opts.warn_unused_lenient, opts.keep_c, &opts.defines);
  }
  // Scanning a tree needs no input file: the working directory is the
  // root when none is named.
  if opts.fmt_check_all {
    Vec<str> offenders = collect_unformatted(opts.input);
    defer offenders.free();
    num i = 0;
    for i < offenders.len {
      writeln_to(Sink.Stderr, offenders.get(i));
      i = i + 1;
    }
    if offenders.len > 0 {
      ret 1;
    }
    ret 0;
  }

  if equals(opts.input, "") {
    println(help_text());
    ret 1;
  }
  if !ends_with(opts.input, ".fn") {
    ret _fail(format("input file must have a .fn extension: {str}", opts.input));
  }
  if !exists(opts.input) {
    ret _fail(format("no such file: {str}", opts.input));
  }

  if opts.fmt_check {
    if format_file_is_clean(opts.input) {
      ret 0;
    }
    writeln_to(Sink.Stderr, opts.input);
    ret 1;
  }
  if opts.fmt_all {
    let done = format_file_and_imports(opts.input);
    if done.is_err() {
      ret _fail(done.unwrap_err());
    }
    ret 0;
  }
  if opts.fmt_diag {
    // Rewritten in place, then falls through so diagnostics still run:
    // what fls shells out to, to combine formatting and diagnostics in
    // one call. A format failure here is not itself fatal -- the
    // diagnostics that follow report anything actually wrong.
    format_file(opts.input);
  }
  if opts.fmt && !opts.fmt_diag {
    let done = format_file(opts.input);
    if done.is_err() {
      ret _fail(done.unwrap_err());
    }
    ret 0;
  }

  // `-out` names the generated C file, defaulting to the input's own
  // name with a `.c` extension.
  str c_path = opts.output;
  if equals(c_path, "") {
    c_path = default_c_path(opts.input, ".c");
  }
  Vec<Define> all_defines = resolved_defines(&opts.defines);
  defer all_defines.free();
  // `-memcheck`'s own allocator/handler/leak-sweep functions are only
  // ever "called" through a C preprocessor macro (see codegen's own
  // `self.memcheck` note) - invisible to this pass's own reachability
  // analysis, which runs on the Fun AST before that macro exists, so
  // pruning stays off for a memcheck build rather than stripping them
  // as dead code. The same macro also captures `__FILE__`/`__LINE__`
  // at every allocation site for a leak/double-free/use-after-free
  // report to name - meaningful only with `#line` directives mapping
  // the generated C back to this program's own `.fn` source, which is
  // what `debug_info` turns on, so `-memcheck` implies it.
  flag mc_debug_info = opts.debug_info;
  if opts.memcheck {
    mc_debug_info = true;
  }
  let lowered = compile_to_c_mode(
    opts.input,
    c_path,
    &all_defines,
    false,
    opts.warn_unused,
    false,
    "",
    mc_debug_info,
    opts.warn_unused_lenient,
    !opts.memcheck,
    opts.memcheck,
    opts.memcheck_leaks
  );
  if lowered.is_err() {
    ret _fail(lowered.unwrap_err());
  }

  // `-no-exec` stops at the C, which is the artifact it was asked for.
  if opts.no_exec {
    ret 0;
  }

  str exe_path = default_exe_path(opts.input, "");

  let cc_code = compile_c_to_exe(c_path, exe_path, opts.debug_info);
  if !opts.keep_c {
    remove_file(c_path);
  }
  if cc_code != 0 {
    ret _fail("the C compiler rejected the generated program");
  }

  ret run_exe(exe_path, &opts.program_args);
}
