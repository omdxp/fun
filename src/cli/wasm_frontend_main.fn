// A minimal, separate entry point for running just the compiler's
// frontend (lex/parse/typecheck/codegen-to-C) inside a browser, via
// `FUN_CC=emcc`. Deliberately not `src/cli/main.fn`, and deliberately
// `use lower;` rather than `use driver;`: `driver.fn` itself `use`s
// `std.process` (to invoke a real C compiler and run the result, and
// for `deps.fn`'s own git fetches), which trips `codegen.fn`'s own
// `emscripten_mode` rejection for the whole merged program the instant
// anything imports it at all - even this file, which never calls any
// of driver's process-spawning functions. `lower.fn` is the same
// pipeline with that dependency removed; see its own doc comment.
//
// Contract with the caller (a browser page, via the same `Module`
// integration every other wasm artifact this project produces already
// uses): write the program's source text to `/playground.fn` in the
// module's own virtual filesystem before it runs (emscripten's MEMFS,
// a normal file write, `FS.writeFile` on the JS side), then read the
// result off stdout/stderr and the exit code exactly as for any other
// module - success prints the generated C to stdout and exits 0; a
// rejected program prints the real compiler error to stderr and exits
// 1. No argv, no interactive stdin: one file in, one of two outputs.
use lower;
use manifest;
use std.io;
use std.fs;
use std.vec;

fun main() num {
  str src_path = "/playground.fn";
  str out_path = "/playground.c";

  if !exists(src_path) {
    writeln_to(.Stderr, "no source provided: expected /playground.fn to exist before this module runs");
    ret 1;
  }

  Vec<Define> defines;
  defines.init(2);
  // A real `fun build`/`fun -in` run on a real project makes
  // `PACKAGE_NAME`/`PACKAGE_VERSION` available as ordinary string
  // constants, taken from `fun.toml` (`manifest_defines`, normally).
  // This module has no real manifest - it compiles one file handed to
  // it by a browser page, not a project - so a doc example that
  // references either constant (there is a real one, documenting
  // exactly this feature) would otherwise fail to compile at all.
  // Placeholder values here, matching what a project actually named
  // "playground" would see, make that example (and any other genuine
  // use of either constant) work instead of needing to be excluded.
  Define pkg_name;
  pkg_name.name = "PACKAGE_NAME";
  pkg_name.value = "playground";
  defines.push(pkg_name);
  Define pkg_version;
  pkg_version.name = "PACKAGE_VERSION";
  pkg_version.value = "0.0.0";
  defines.push(pkg_version);
  // `msvc_mode: false, emscripten_mode: true` are given directly rather
  // than resolved: this target is always emscripten, statically, and
  // `resolve_c_compiler()` (which would otherwise decide this) lives in
  // `driver.fn` and needs `std.process` itself to probe an installed
  // compiler - exactly the dependency this file exists to avoid.
  // `host_arch: ""` for the same reason (`host_arch_name()` needs it
  // too, for its own `uname -m` probe) - correctly fails any `asm
  // arch "..."` block's own check instead of skipping it, since real
  // inline assembly for some other CPU's instruction set was never
  // going to mean anything once this compiles to wasm anyway.
  // `parallel_preload: false` - this module runs inside a real
  // browser's own iframe sandbox, with no `SharedArrayBuffer` and no
  // cross-origin-isolation headers to request one (a caller embedding
  // this module controls none of that), so the parallel preload
  // pool's own `fork`ed workers can never actually start - confirmed
  // directly: left `true`, every run hangs forever rather than erroring,
  // since the scheduler believes workers exist that silently failed to
  // spawn. Correct and already proven under Node (the `fun -in`
  // toolchain this file is compiled through) either way - Node's own
  // pthread emulation works fine without this, so only the browser
  // case actually needs the fallback.
  // `reject_concurrency: true` - this module's own output (real-world
  // use: fed straight into `@wasmer/sdk`'s wasm32-wasi sandbox, no
  // threading support at all) hangs the exact same way for the exact
  // same reason if the program itself uses `fork` - confirmed directly,
  // a real concurrency example hung the deployed Playground's own tab
  // indefinitely. See `lower_to_c`'s own doc comment on this parameter.
  let lowered = lower_to_c(src_path, out_path, &defines, false, false, false, "", false, false, nil, true, false, true, "", false, true);
  defines.free();

  if lowered.is_err() {
    writeln_to(.Stderr, lowered.unwrap_err());
    ret 1;
  }

  print(read_to_string(out_path));
  ret 0;
}
