// Command-line driver: turns arguments into a compile, and optionally
// builds and runs the result.
//
// Compiling a program happens in two steps. The first lowers Fun to C,
// which this module owns. The second hands that C to a host compiler,
// chosen by `FUN_CC` or by platform default, and runs the executable it
// produces.

use ..parser.import_resolver;
use ..semantics.typecheck;
use ..semantics.warnings;
use ..semantics.alias_expand;
use ..lexer.lexer;
use ..lexer.token;
use fmt;
use ..ast.ast;
use ..ast.ast_print;
use manifest;
use deps;
use ..codegen.codegen;
use ..codegen.codegen_state;
use std.string;
use std.vec;
use std.option;
use std.result;
use std.io;
use std.fs;
use std.sys;
use std.cli;
use std.process;
use std.path;
use std.set;
use std.runtime_backend;
use std.c.mem;
use std.task;
use std.sync;
use std.time;
use std.c.time;
use std.thread_pool;

// What the arguments asked for.
pub compound Options {
  // `build`, `test`, `fuzz`, `init`, `add`, `deps`, `lint`, or "" for a
  // plain compile.
  str subcommand;
  // `-test`/`-fuzz` given directly (alongside `-in`) rather than via a
  // `test`/`fuzz` subcommand. Only meaningful when `subcommand` is "".
  flag test_flag;
  flag fuzz_flag;
  str input;
  str output;
  // The `fuzz` target's name, from `fun fuzz <input> <target>`'s optional
  // second positional. Empty when not given (only valid when the file
  // declares exactly one target).
  str fuzz_target;
  // Compile only, leaving the executable unrun.
  flag no_exec;
  // Keep the generated C instead of removing it after the build.
  flag keep_c;
  // Build with debug information.
  flag debug_info;
  flag show_help;
  flag show_version;
  // Report declarations nothing reads.
  flag warn_unused;
  // Like `warn_unused`, but keeps reporting them even when the file has
  // an unrelated type error elsewhere. fls's own diagnose() implements
  // the identical idea separately, for the editor rather than the CLI.
  flag warn_unused_lenient;
  // Print the parsed AST before compiling.
  flag show_ast;
  // Rewrite the input in place, and with `fmt_all` its local imports too.
  flag fmt;
  flag fmt_all;
  // Rewrite the input in place, then still run diagnostics against it
  // (what fls shells out to, to combine formatting and diagnostics).
  flag fmt_diag;
  // Report whether the input, or everything under it, is formatted,
  // without rewriting anything.
  flag fmt_check;
  flag fmt_check_all;
  // `fun lint`'s `-summary`: print only the totals, not each warning.
  flag lint_summary;
  // Arguments after `--`, passed to the compiled program.
  Vec<str> program_args;
  // Constants injected into the program, from `-D name=value`.
  Vec<Define> defines;
  // `fun deps <action> [name]`'s own action word ("update", so far the
  // only one) - `input` carries the optional dependency `name` after
  // it, the same "subcommand's own positionals" shape `fuzz`'s target
  // name already uses.
  str deps_action;
  // `fun add <name> -git <url> [-path <p>] [-tag <t> | -branch <b> |
  // -rev <r>] [-token-env <VAR>]`'s own flags. Only meaningful when
  // `subcommand` is `"add"`.
  str dep_git;
  str dep_path;
  str dep_tag;
  str dep_branch;
  str dep_rev;
  str dep_token_env;
  // Set when parsing failed, with `error_text` explaining why.
  flag has_error;
  str error_text;
}

fun _options_new() Options {
  Options o;
  o.subcommand = "";
  o.test_flag = false;
  o.fuzz_flag = false;
  o.input = "";
  o.output = "";
  o.fuzz_target = "";
  o.no_exec = false;
  o.keep_c = false;
  o.debug_info = false;
  o.show_help = false;
  o.show_version = false;
  o.warn_unused = false;
  o.warn_unused_lenient = false;
  o.show_ast = false;
  o.fmt = false;
  o.fmt_all = false;
  o.fmt_diag = false;
  o.fmt_check = false;
  o.fmt_check_all = false;
  o.lint_summary = false;
  o.program_args.init(0);
  o.defines.init(0);
  o.deps_action = "";
  o.dep_git = "";
  o.dep_path = "";
  o.dep_tag = "";
  o.dep_branch = "";
  o.dep_rev = "";
  o.dep_token_env = "";
  o.has_error = false;
  o.error_text = "";
  ret o;
}

impl Options {
  pub free() {
    self.program_args.free();
    self.defines.free();
  }
}

// The flags that take a separate value.
fun _value_flags() Vec<str> {
  Vec<str> out;
  out.init(0);
  out.push("in");
  out.push("out");
  out.push("D");
  out.push("fuzz-target");
  out.push("git");
  out.push("path");
  out.push("tag");
  out.push("branch");
  out.push("rev");
  out.push("token-env");
  ret out;
}

// Reads `argv` into `Options`. A subcommand, when present, is the first
// argument, and anything after `--` belongs to the compiled program.
pub fun parse_args(str[] argv) Options {
  Options o = _options_new();

  Vec<str> value_flags = _value_flags();
  defer value_flags.free();
  CliArgs parsed = cli_parse_flags(argv, &value_flags);
  defer parsed.free();

  if parsed.missing_value {
    o.has_error = true;
    o.error_text = format("-{str} expects a value", parsed.missing_value_flag);
    ret o;
  }

  num first_positional = 0;
  let leading = parsed.at_positional(0);
  if leading.is_some() {
    str head = leading.unwrap();
    if equals(head, "build") || equals(head, "test") || equals(head, "fuzz") ||
      equals(head, "init") || equals(head, "add") || equals(head, "deps") ||
      equals(head, "lint") {
      o.subcommand = head;
      first_positional = 1;
    }
  }

  o.show_help = parsed.has("help") || parsed.has("h");
  o.show_version = parsed.has("version");
  o.no_exec = parsed.has("no-exec");
  o.keep_c = parsed.has("outf");
  o.debug_info = parsed.has("g");
  o.warn_unused = parsed.has("warn-unused");
  o.warn_unused_lenient = parsed.has("warn-unused-lenient");
  // Implies the same detection as `warn_unused`.
  if o.warn_unused_lenient {
    o.warn_unused = true;
  }
  o.show_ast = parsed.has("ast");
  o.fmt = parsed.has("fmt");
  o.fmt_all = parsed.has("fmt-all");
  o.fmt_diag = parsed.has("fmt-diag");
  o.fmt_check = parsed.has("fmt-check");
  o.fmt_check_all = parsed.has("fmt-check-all");
  o.lint_summary = parsed.has("summary");
  o.test_flag = parsed.has("test");
  o.fuzz_flag = parsed.has("fuzz");
  o.fuzz_target = parsed.get_or("fuzz-target", "");
  o.input = parsed.get_or("in", "");
  o.output = parsed.get_or("out", "");
  o.dep_git = parsed.get_or("git", "");
  o.dep_path = parsed.get_or("path", "");
  o.dep_tag = parsed.get_or("tag", "");
  o.dep_branch = parsed.get_or("branch", "");
  o.dep_rev = parsed.get_or("rev", "");
  o.dep_token_env = parsed.get_or("token-env", "");
  if !equals(o.output, "") {
    if !ends_with(o.output, ".c") {
      o.has_error = true;
      o.error_text = format("-out expects a `.c` file, found `{str}`", o.output);
      ret o;
    }
    // Naming the generated C file is itself a request to keep it.
    o.keep_c = true;
  }

  let define = parsed.at("D");
  if define.is_some() {
    str pair = define.unwrap();
    let eq = index_of_char(pair, '=');
    if eq == -1 {
      o.has_error = true;
      o.error_text = format("-D expects `name=value`, found `{str}`", pair);
      ret o;
    }
    Define d;
    d.name = substr(pair, 0, eq);
    d.value = substr(pair, eq + 1, len(pair) - (eq + 1));
    o.defines.push(d);
  }

  // A bare path is the input, so `fun file.fn` works without `-in`. For
  // `fun fuzz <input> [<target>]`, the positional right after `input` is
  // the target name when it's a bare word, not a value that leaked
  // through from `-- <program args>` (`cli_parse_flags` already drops the
  // literal `--` marker itself, so a forwarded flag like
  // `-max_total_time=5` would otherwise look just like a target name by
  // position alone; a real target never starts with `-`).
  num i = first_positional;
  for i < parsed.positionals.len {
    str arg = parsed.positionals.get(i);
    flag looks_like_flag = len(arg) > 0 && arg[0] == '-';
    if equals(o.subcommand, "deps") && equals(o.deps_action, "") {
      o.deps_action = arg;
    } elif equals(o.input, "") {
      o.input = arg;
    } elif equals(o.subcommand, "fuzz") && equals(o.fuzz_target, "") && !looks_like_flag {
      o.fuzz_target = arg;
    } else {
      o.program_args.push(arg);
    }
    i = i + 1;
  }

  // `-fmt`/`-fmt-all`/`-fmt-diag`/`-fmt-check` and the `lint` subcommand
  // only ever check/format `o.input`, the single file the loop above
  // captured first; none of them execute a program, so there's no
  // legitimate `-- <program args>` use here. Without this check, a second
  // bare file falls silently into `o.program_args` above and is never
  // looked at, so e.g. `fun -fmt-check a.fn b.fn` would report success
  // after only ever checking `a.fn`.
  if (o.fmt || o.fmt_all || o.fmt_diag || o.fmt_check || equals(o.subcommand, "lint")) &&
    o.program_args.len > 0 {
    o.has_error = true;
    o.error_text = format(
      "only a single input file is supported here; got an extra argument: {str}",
      o.program_args.get(0)
    );
    ret o;
  }
  ret o;
}

// Replaces `path`'s extension with `ext`, or appends when it has none.
pub fun with_extension(str path, str ext) str {
  if equals(ext, "") {
    ret strip_ext(path);
  }
  ret change_ext(path, ext);
}

// The suffix an executable carries on this platform.
pub fun exe_suffix() str {
  if runtime_backend_is_windows() {
    ret ".exe";
  }
  ret "";
}

// Where build output goes, so nothing lands next to the sources.
pub fun out_dir() str {
  ret "fun-out";
}

// The generated C for `input`, under the build directory.
pub fun default_c_path(str input, str suffix) str {
  make_dir_all(out_dir());
  StringBuilder b = string_builder_init(16);
  b.append(strip_ext(basename(input)));
  b.append(suffix);
  ret path_join(out_dir(), b.build());
}

// The executable built from `input`, under the build directory.
pub fun default_exe_path(str input, str suffix) str {
  str dir = path_join(out_dir(), "bin");
  make_dir_all(dir);
  StringBuilder b = string_builder_init(16);
  b.append(strip_ext(basename(input)));
  b.append(suffix);
  b.append(exe_suffix());
  ret path_join(dir, b.build());
}

// The host C compiler to shell, honoring `FUN_CC`.
pub fun c_compiler() str {
  str override_cc = env_or("FUN_CC", "");
  if !equals(override_cc, "") {
    ret override_cc;
  }
  if runtime_backend_is_windows() {
    ret "cl";
  }
  ret "cc";
}

// True when `cc` takes MSVC-style arguments rather than gcc-style ones.
pub fun compiler_is_msvc(str cc) flag {
  let name = basename(cc);
  ret equals(name, "cl") || equals(name, "cl.exe");
}

// Lowers `input` to C at `out_path`, with `defines` available to the
// program as constants. The error text names the stage that rejected the
// program.
pub fun compile_to_c(str input, str out_path, Vec<Define>* defines, flag debug_info) Result<flag, str> {
  ret compile_to_c_mode(input, out_path, defines, false, false, false, "", debug_info, false);
}

// Lowers `input` to C, reporting declarations nothing reads.
pub fun compile_to_c_warning_unused(str input, str out_path, Vec<Define>* defines, flag debug_info) Result<flag, str> {
  ret compile_to_c_mode(input, out_path, defines, false, true, false, "", debug_info, false);
}

// Lowers `input` to C, emitting a test runner in place of the program's
// own entry point when `test_mode` is set, or a fuzz harness when
// `fuzz_mode` is set (`fuzz_target` names which target when the file
// declares more than one; empty is only valid when it declares exactly
// one).
// Writes one `Warning` to stderr in the CLI's own reporting shape.
// Shared by the ordinary post-typecheck report below and
// `-warn-unused-lenient`'s own best-effort report ahead of a type error.
fun _print_warning(Warning w) {
  StringBuilder line = string_builder_init(96);
  line.append("[Warning:");
  line.append(warning_id_name(w.id));
  line.append("] ");
  line.append(w.message);
  if w.has_pos {
    line.append(format("\nLocation: {str}:{num}:{num}", w.pos.filename, w.pos.line, w.pos.col));
  }
  writeln_to(Sink.Stderr, line.build());
}

// Drops every `test` block that came from a file other than `entry`, so a
// test binary runs just its own file's tests, as `fun test <file>` promises.
// The imported modules are compiled in for their code, but their tests are
// run by their own `fun test`, and running them again from every importer
// would multiply the work and, in a user's project, run a dependency's tests.
fun _drop_foreign_tests(Vec<Node>* nodes, str entry) {
  str want = _normalize_path(entry);
  num kept = 0;
  num i = 0;
  for i < nodes.len {
    Node n = nodes.get(i);
    flag foreign = false;
    fit n.kind {
      .Test(_) -> { foreign = n.has_pos && !equals(n.pos.filename, want); }
      _ -> {}
    }
    if !foreign {
      nodes.data[kept] = nodes.data[i];
      kept = kept + 1;
    }
    i = i + 1;
  }
  nodes.len = kept;
  free(want);
}

pub fun compile_to_c_mode(
  str input,
  str out_path,
  Vec<Define>* defines,
  flag test_mode,
  flag warn_unused,
  flag fuzz_mode,
  str fuzz_target,
  flag debug_info,
  flag warn_unused_lenient
) Result<flag, str> {
  let merged = parse_program_with_imports(input)!;
  if test_mode {
    _drop_foreign_tests(&merged.nodes, input);
  }

  // Injected ahead of the program's own declarations, so anything in it
  // can refer to them.
  num di = defines.len;
  for di > 0 {
    di = di - 1;
    Define* d = &defines.data[di];
    merged.nodes.insert(0, manifest_const_node(d.name, d.value));
  }

  // Every `als` reference is expanded transparently, in place, before
  // typecheck ever sees the program - typecheck and codegen never learn
  // aliases exist at all.
  let alias_err = expand_type_aliases(&merged.nodes);
  if alias_err.is_some() {
    ret .Err(alias_err.unwrap());
  }
  // `merged.entry_nodes` is a separate parse from `merged.nodes` (see its
  // own doc comment), so the `was_used` flag expansion just stamped onto
  // `merged.nodes` never reaches it on its own - the `unused_type_alias`
  // warning below reports against `entry_nodes`, so it needs its own copy.
  sync_type_alias_usage(&merged.nodes, &merged.entry_nodes);

  // Type checking runs over the merged program, so a call into an
  // imported module is checked against the signature it was declared
  // with.
  let checked = typecheck_program(&merged.nodes);
  if checked.is_err() {
    TypeError e = checked.unwrap_err();
    // Lenient mode's own promise (see Options.warn_unused_lenient's doc
    // comment): a warning nothing else depends on shouldn't stay
    // invisible just because something unrelated in the file doesn't
    // typecheck. `analyze` reads straight from the parsed nodes,
    // independent of whatever typechecking got through, so it still
    // runs here even though the type error below still fails the build
    // - fls's own diagnose() does the identical thing for the same
    // reason, for the editor rather than the CLI.
    if warn_unused_lenient {
      let lenient_noticed = analyze(&merged.entry_nodes, &merged.nodes, true, input);
      if lenient_noticed.is_ok() {
        Vec<Warning> lenient_warnings = lenient_noticed.unwrap();
        num lwi = 0;
        for lwi < lenient_warnings.len {
          _print_warning(lenient_warnings.get(lwi));
          lwi = lwi + 1;
        }
        lenient_warnings.free();
      }
    }
    if e.has_pos {
      // The node's own file, which is not the entry file when the error
      // is in something it imported.
      str where = e.pos.filename;
      if equals(where, "") {
        where = input;
      }
      ret .Err(format(
        "{str}\nLocation: {str}:{num}:{num}",
        e.message,
        where,
        e.pos.line,
        e.pos.col
      ));
    }
    ret .Err(e.message);
  }

  // Warnings are reported after checking, so a program that does not
  // compile is not also told what it might have meant. They are read
  // from the file's own parse: merging drops the import statements, and
  // what another file declares is its own business.
  let noticed = analyze(&merged.entry_nodes, &merged.nodes, warn_unused, input);
  if noticed.is_err() {
    UnmetExpectation ue = noticed.unwrap_err();
    if ue.has_pos {
      str where = ue.pos.filename;
      if equals(where, "") {
        where = input;
      }
      ret .Err(format(
        "{str}\nLocation: {str}:{num}:{num}",
        ue.message,
        where,
        ue.pos.line,
        ue.pos.col
      ));
    }
    ret .Err(ue.message);
  }
  Vec<Warning> warnings = noticed.unwrap();
  defer warnings.free();
  num wi = 0;
  for wi < warnings.len {
    _print_warning(warnings.get(wi));
    wi = wi + 1;
  }

  CodegenState state = codegen_state_new();
  Codegen cg = codegen_new(&state);
  cg.test_mode = test_mode;
  cg.fuzz_mode = fuzz_mode;
  cg.fuzz_target = fuzz_target;
  cg.msvc_mode = compiler_is_msvc(resolve_c_compiler());
  cg.debug_info = debug_info;
  cg.import_aliases = merged.aliases;
  cg.alias_rename_keys = merged.alias_rename_keys;
  cg.alias_rename_targets = merged.alias_rename_targets;

  let cg_err = cg.transpile(merged.nodes);
  fit cg_err {
    .Some(kind) -> {
      str what = "unsupported node";
      fit kind {
        .UnsupportedNode -> {}
        .InvalidNode -> { what = "invalid node"; }
      }
      if !equals(cg.error_note, "") {
        if !equals(cg.last_where, "") {
          ret .Err(format(
            "codegen failed: {str}: {str}, near {str}",
            what,
            cg.error_note,
            cg.last_where
          ));
        }
        ret .Err(format("codegen failed: {str}: {str}", what, cg.error_note));
      }
      if !equals(cg.last_where, "") {
        ret .Err(format("codegen failed: {str}, near {str}", what, cg.last_where));
      }
      ret .Err(format("codegen failed: {str}", what));
    }
    .None -> {}
  }

  str c_source = state.out.build();
  if !write_string(out_path, c_source) {
    ret .Err(format("could not write {str}", out_path));
  }
  ret .Ok(true);
}

// The first of Homebrew's usual keg-only OpenSSL install prefixes (3.x
// preferred, falling back to whatever `openssl` alone resolved to) that
// actually exists on this machine, checked by looking for its own
// `include/openssl/ssl.h`; "" when none of them do (a non-Homebrew
// install, or Linux with the headers already on the default path).
fun _find_openssl_prefix() str {
  Vec<str> candidates;
  candidates.init(4);
  candidates.push("/opt/homebrew/opt/openssl@3");
  candidates.push("/opt/homebrew/opt/openssl");
  candidates.push("/usr/local/opt/openssl@3");
  candidates.push("/usr/local/opt/openssl");
  defer candidates.free();
  num i = 0;
  for i < candidates.len {
    str prefix = candidates.get(i);
    if exists(format("{str}/include/openssl/ssl.h", prefix)) {
      ret prefix;
    }
    i = i + 1;
  }
  ret "";
}

// Appends the arguments a compile of `c_path` into `exe_path` needs,
// after `cc`'s own name is already in `argv_args`. MSVC spells its
// arguments differently and links the C runtime itself, so the thread
// and math flags apply only to gcc-style compilers.
// True when the caller asked for an optimized build and nothing overrides
// it: a debug build stays unoptimized, and an optimization level the user
// already put in `FUN_CC_ARGS` is theirs to keep.
fun _wants_optimization(flag optimize, flag debug_info) flag {
  if !optimize || debug_info {
    ret false;
  }
  str extra = env_or("FUN_CC_ARGS", "");
  ret !contains(extra, "-O") && !contains(extra, "/O");
}

fun _append_compile_args(Vec<str>* argv_args, str cc, str c_path, str exe_path, flag debug_info, flag optimize) {
  if compiler_is_msvc(cc) {
    argv_args.push("/nologo");
    argv_args.push("/std:c17");
    if _wants_optimization(optimize, debug_info) {
      argv_args.push("/O2");
    }
    argv_args.push(c_path);
    if debug_info {
      argv_args.push("/Zi");
    }
    argv_args.push(format("/Fe:{str}", exe_path));
    // Windows defaults to a 1 MB stack reserve, which this compiler's own
    // recursive-descent parser and codegen can exhaust while self-compiling
    // its own large, deeply-nested source - not just under `fun test`'s
    // accumulated sequential calls (already covered separately, in the
    // generated test runner's own main()), but in a single ordinary `fun
    // build`/`fun -in` compile too. Reserved for every MSVC-linked
    // executable here, at the real link step, rather than embedded as a
    // generated-C pragma: the latter would need adding to every compiled
    // program's own prelude, which is what a large batch of codegen tests
    // assert the exact literal text of.
    argv_args.push("/link");
    argv_args.push("/STACK:134217728");
  } else {
    if _wants_optimization(optimize, debug_info) {
      argv_args.push("-O2");
    }
    argv_args.push(c_path);
    argv_args.push("-o");
    argv_args.push(exe_path);
    if debug_info {
      argv_args.push("-g");
    } else {
      argv_args.push("-g0");
    }
    argv_args.push("-pthread");
    // Windows has no standalone math library to link against (its math
    // functions already live in the CRT); clang there still links via
    // lld-link in MSVC-ABI mode even without `cl.exe` itself, and that
    // linker resolves `-lm` by searching for a literal `m.lib`, which
    // doesn't exist on Windows at all - unlike POSIX, where `-lm` is
    // always required and always resolves against a real libm.
    if !runtime_backend_is_windows() {
      argv_args.push("-lm");
    } else {
      argv_args.push("-lws2_32");
    }
    // TLS/crypto (std.c.tls/std.c.crypto) need OpenSSL, but not every
    // program should have to link against it - codegen only emits the
    // OpenSSL headers, and this marker comment, when the program
    // actually imports one of those bindings (see write_prelude).
    // Windows' own SChannel/BCrypt backing needs no extra linking here:
    // it auto-links via #pragma comment(lib, ...) in the generated C
    // itself, the same way Ws2_32.lib already does.
    // The search string itself is built from pieces, not one literal:
    // self-hosting compiles this very check, and a contiguous literal
    // here would show up verbatim in the compiler's OWN generated C
    // too, falsely matching itself on every self-build.
    str openssl_marker = format("__fun_link: -l{str} -l{str}", "ssl", "crypto");
    if !runtime_backend_is_windows() && contains(read_to_string(c_path), openssl_marker) {
      // OpenSSL lives in the default include/lib search path on most
      // Linux distros once libssl-dev is installed, but Homebrew's own
      // build is deliberately keg-only (Apple Silicon and Intel prefixes
      // both checked) to avoid shadowing macOS's system LibreSSL, so it
      // needs its own explicit -I/-L. Harmless everywhere else: a prefix
      // that doesn't exist here is simply skipped.
      str openssl_prefix = _find_openssl_prefix();
      if !equals(openssl_prefix, "") {
        argv_args.push(format("-I{str}/include", openssl_prefix));
        argv_args.push(format("-L{str}/lib", openssl_prefix));
      }
      argv_args.push("-lssl");
      argv_args.push("-lcrypto");
    }
  }
}

// The C compilers tried, in order, when `FUN_CC` names none.
fun _default_cc_candidates() Vec<str> {
  Vec<str> out;
  out.init(3);
  out.push("clang");
  out.push("gcc");
  if runtime_backend_is_windows() {
    out.push("cl");
  } else {
    out.push("cc");
  }
  ret out;
}

// Returns the path to vcvarsall.bat for the latest VS installation on this
// machine (located via vswhere.exe at its standard installer path), or ""
// if VS is not installed or vswhere fails.  Windows-only helper used by
// both `_ensure_msvc_env` and `_compile_with_msvc_bat`.
fun _find_vcvarsall() str {
  str vswhere = "C:\\Program Files (x86)\\Microsoft Visual Studio\\Installer\\vswhere.exe";
  if !exists(vswhere) {
    ret "";
  }
  Vec<str> probe_args;
  probe_args.init(4);
  probe_args.push(vswhere);
  probe_args.push("-latest");
  probe_args.push("-property");
  probe_args.push("installationPath");
  str[] probe_argv = argv_from(&probe_args);
  let probe_result = run(probe_argv);
  free_argv(probe_argv);
  probe_args.free();
  if probe_result.is_err() {
    ret "";
  }
  ProcessResult pr = probe_result.unwrap();
  if pr.exit_code != 0 {
    ret "";
  }
  str install_path = trim(pr.stdout_text);
  if equals(install_path, "") {
    ret "";
  }
  str vcvarsall = path_join(install_path, "VC\\Auxiliary\\Build\\vcvarsall.bat");
  if !exists(vcvarsall) {
    ret "";
  }
  ret vcvarsall;
}

// On Windows, if INCLUDE is not set (vcvarsall.bat has not been sourced
// into the current process), finds the Visual Studio installation via
// vswhere.exe and applies the x64 MSVC environment to the current process
// via set_env().  Best-effort: on some Windows configurations the env
// update does not propagate to child processes; `_compile_with_msvc_bat`
// is the reliable fallback for that case.  A no-op on POSIX, when INCLUDE
// is already set, or when no VS installation is found.
fun _ensure_msvc_env() {
  if !runtime_backend_is_windows() {
    ret;
  }
  if !equals(env_or("INCLUDE", ""), "") {
    ret;
  }
  str vcvarsall = _find_vcvarsall();
  if equals(vcvarsall, "") {
    ret;
  }
  str temp_dir = env_or("TEMP", env_or("TMP", "C:\\Temp"));
  str bat_path = path_join(temp_dir, "fun_msvc_env.bat");
  write_string(bat_path, format("@echo off\ncall \"{str}\" x64 > NUL 2>&1\nset\n", vcvarsall));
  Vec<str> bat_args;
  bat_args.init(3);
  bat_args.push("cmd.exe");
  bat_args.push("/c");
  bat_args.push(bat_path);
  str[] bat_argv = argv_from(&bat_args);
  let bat_result = run(bat_argv);
  free_argv(bat_argv);
  bat_args.free();
  remove_file(bat_path);
  if bat_result.is_err() {
    ret;
  }
  ProcessResult bat_r = bat_result.unwrap();
  if bat_r.exit_code != 0 {
    ret;
  }
  Vec<str> lines = split(bat_r.stdout_text, '\n');
  defer lines.free();
  num i = 0;
  for i < lines.len {
    str line = trim(lines.get(i));
    num eq = index_of_char(line, '=');
    if eq > 0 {
      str name = substr(line, 0, eq);
      str value = substr(line, eq + 1, len(line) - eq - 1);
      set_env(name, value);
    }
    i = i + 1;
  }
}

// Compiles `c_path` to `exe_path` via cl.exe, routing through a temporary
// batch file that sources vcvarsall.bat x64 first, so that cl.exe sees the
// full MSVC build environment (INCLUDE, LIB, PATH) even when fun.exe itself
// was started from a plain PowerShell or CMD terminal.  Used as the reliable
// fallback when `_ensure_msvc_env` could not propagate INCLUDE to the current
// process environment (which happens on some Windows configurations where
// _putenv_s does not update the Windows environment block for child processes).
fun _compile_with_msvc_bat(str vcvarsall, str c_path, str exe_path, flag debug_info, flag optimize) num {
  str temp_dir = env_or("TEMP", env_or("TMP", "C:\\Temp"));
  str bat_path = path_join(temp_dir, "fun_cl.bat");
  str debug_flag = "";
  if debug_info {
    debug_flag = " /Zi";
  }
  if _wants_optimization(optimize, debug_info) {
    debug_flag = format("{str} /O2", debug_flag);
  }
  if !write_string(bat_path, format(
    "@echo off\ncall \"{str}\" x64 > NUL 2>&1\ncl.exe /nologo /std:c17 \"{str}\"{str} \"/Fe:{str}\" /link /STACK:134217728\nexit /b %ERRORLEVEL%\n",
    vcvarsall, c_path, debug_flag, exe_path
  )) {
    writeln_to(Sink.Stderr, "could not write MSVC build wrapper");
    ret 1;
  }
  Vec<str> bat_args;
  bat_args.init(3);
  bat_args.push("cmd.exe");
  bat_args.push("/c");
  bat_args.push(bat_path);
  str[] bat_argv = argv_from(&bat_args);
  let result = run(bat_argv);
  free_argv(bat_argv);
  bat_args.free();
  remove_file(bat_path);
  if result.is_err() {
    writeln_to(Sink.Stderr, "failed to spawn cmd.exe for MSVC build");
    ret 1;
  }
  ProcessResult r = result.unwrap();
  if r.exit_code != 0 {
    if !equals(r.stderr_text, "") {
      writeln_to(Sink.Stderr, r.stderr_text);
    }
    if !equals(r.stdout_text, "") {
      writeln_to(Sink.Stderr, r.stdout_text);
    }
  }
  ret r.exit_code;
}

// Which C compiler will actually receive the generated C, resolved the
// same way `compile_c_to_exe` itself will pick one: `FUN_CC`'s exact
// value if set, otherwise the first of `_default_cc_candidates()` found
// on PATH. Exists so codegen's own msvc-mode decision and the real
// compile step can never disagree about which compiler is in play -
// `c_compiler()`'s own hardcoded platform guess ("cl" on Windows) names
// a DIFFERENT compiler than the one actually used whenever clang (tried
// first, and normally present) is found, silently mismatching codegen's
// emitted C shape against the compiler that actually receives it. Falls
// back to `c_compiler()`'s own guess only when nothing on PATH matches
// any candidate at all, the same last resort `compile_c_to_exe` reaches
// before giving up.
pub fun resolve_c_compiler() str {
  str override_cc = env_or("FUN_CC", "");
  if !equals(override_cc, "") {
    ret override_cc;
  }
  _ensure_msvc_env();
  Vec<str> candidates = _default_cc_candidates();
  defer candidates.free();
  num i = 0;
  for i < candidates.len {
    str cc = candidates.get(i);
    i = i + 1;
    Vec<str> probe_args;
    probe_args.init(2);
    probe_args.push(cc);
    probe_args.push("--version");
    str[] probe_argv = argv_from(&probe_args);
    let probe_result = run(probe_argv);
    free_argv(probe_argv);
    probe_args.free();
    if probe_result.is_ok() {
      ret cc;
    }
  }
  ret c_compiler();
}

// Strips cl.exe filename echo lines from captured output, keeping only lines
// that contain ':' (diagnostics are always "file(line): category ...").
fun _strip_cl_filename_echo(str text) str {
  if equals(text, "") {
    ret text;
  }
  Vec<str> lines = split_lines(text);
  defer lines.free();
  StringBuilder b = string_builder_init(len(text));
  num i = 0;
  for i < lines.len {
    str line = trim(lines.get(i));
    if !equals(line, "") && index_of_char(line, ':') >= 0 {
      b.append(line);
      b.append("\n");
    }
    i = i + 1;
  }
  ret b.build();
}

// Compiles with an explicit `cc`, honoring `FUN_CC_ARGS` as extra
// arguments inserted right after `cc` itself and before the source
// file (a user override is trusted to know what it's asking for,
// so this streams the compiler's own output live rather than capturing it).
// For MSVC, output is captured and filename-echo lines are filtered out
// before printing, so only real diagnostics appear.
fun _compile_with_cc(str cc, str c_path, str exe_path, flag debug_info, flag optimize) num {
  Vec<str> argv_args;
  argv_args.init(0);
  defer argv_args.free();
  argv_args.push(cc);

  str extra = env_or("FUN_CC_ARGS", "");
  if !equals(extra, "") {
    Vec<str> extra_parts = split(extra, ' ');
    defer extra_parts.free();
    num j = 0;
    for j < extra_parts.len {
      str part = extra_parts.get(j);
      if !equals(part, "") {
        argv_args.push(part);
      }
      j = j + 1;
    }
  }

  _append_compile_args(&argv_args, cc, c_path, exe_path, debug_info, optimize);

  str[] argv = argv_from(&argv_args);
  if !compiler_is_msvc(cc) {
    let code = spawn_inherited(argv);
    free_argv(argv);
    ret code;
  }
  let result = run(argv);
  free_argv(argv);
  if result.is_err() {
    writeln_to(Sink.Stderr, "could not spawn cl.exe");
    ret 1;
  }
  ProcessResult r = result.unwrap();
  str filtered = _strip_cl_filename_echo(r.stdout_text);
  if !equals(filtered, "") {
    writeln_to(Sink.Stderr, filtered);
  }
  if !equals(r.stderr_text, "") {
    writeln_to(Sink.Stderr, r.stderr_text);
  }
  ret r.exit_code;
}

// Builds `c_path` into `exe_path`. Returns the compiler's exit code.
// `FUN_CC`, when set, is used exactly as given. Otherwise, each of
// `_default_cc_candidates` is tried in turn until one is actually found
// on `PATH`; a candidate that's found but fails to compile stops the
// search there rather than trying the next one, since a real compile
// error is never solved by switching compilers.
pub fun compile_c_to_exe(str c_path, str exe_path, flag debug_info) num {
  ret compile_c_to_exe_mode(c_path, exe_path, debug_info, false);
}

// `compile_c_to_exe`, optionally with the C compiler's own optimizer on
// (`-O2`, `/O2` for MSVC). Used by `fun build`, whose output is a program
// that gets run many times, unlike the quick compile-and-run and test paths
// that stay unoptimized to keep the edit loop fast.
pub fun compile_c_to_exe_mode(str c_path, str exe_path, flag debug_info, flag optimize) num {
  _ensure_msvc_env();
  str override_cc = env_or("FUN_CC", "");
  if !equals(override_cc, "") {
    ret _compile_with_cc(override_cc, c_path, exe_path, debug_info, optimize);
  }

  Vec<str> candidates = _default_cc_candidates();
  defer candidates.free();
  num i = 0;
  for i < candidates.len {
    str cc = candidates.get(i);
    i = i + 1;

    // When cl is selected and INCLUDE is still empty after _ensure_msvc_env
    // (env-propagation via _putenv_s is unreliable on some Windows configs),
    // use a bat-file wrapper that sources vcvarsall.bat directly so cl.exe
    // inherits the full MSVC build environment without depending on our
    // process environment reaching the child.
    if compiler_is_msvc(cc) && equals(env_or("INCLUDE", ""), "") {
      str vcvarsall = _find_vcvarsall();
      if !equals(vcvarsall, "") {
        ret _compile_with_msvc_bat(vcvarsall, c_path, exe_path, debug_info, optimize);
      }
    }

    Vec<str> argv_args;
    argv_args.init(0);
    defer argv_args.free();
    argv_args.push(cc);
    _append_compile_args(&argv_args, cc, c_path, exe_path, debug_info, optimize);

    str[] argv = argv_from(&argv_args);
    let result = run(argv);
    free_argv(argv);
    if result.is_err() {
      // Not installed; try the next candidate.
      continue;
    }
    ProcessResult r = result.unwrap();
    if r.exit_code != 0 {
      // cl.exe writes diagnostics to stdout; print both streams so the
      // error is always visible regardless of which compiler ran.
      if !equals(r.stderr_text, "") {
        writeln_to(Sink.Stderr, r.stderr_text);
      }
      if !equals(r.stdout_text, "") {
        writeln_to(Sink.Stderr, r.stdout_text);
      }
    }
    ret r.exit_code;
  }

  writeln_to(Sink.Stderr, "no C compiler found (tried clang, gcc, cc); set FUN_CC to override");
  ret 1;
}

// The C compilers this tries, in order, for building a fuzz harness:
// `FUN_FUZZ_CC` if set (a user override takes priority over everything
// else), then a short list of clang builds likely to carry libFuzzer's
// runtime (`-fsanitize=fuzzer` needs clang specifically, not gcc). A
// plain `clang` on PATH is tried first since it's the common case;
// candidates specific to a platform's own package manager layout follow,
// harmless to also try on another platform since a missing binary just
// fails to spawn and the search moves on.
fun _fuzz_cc_candidates() Vec<str> {
  Vec<str> out;
  out.init(4);
  str override_cc = env_or("FUN_FUZZ_CC", "");
  if !equals(override_cc, "") {
    out.push(override_cc);
    ret out;
  }
  out.push("clang");
  out.push("/opt/homebrew/opt/llvm/bin/clang");
  out.push("/usr/local/opt/llvm/bin/clang");
  out.push("clang-20");
  out.push("clang-19");
  out.push("clang-18");
  out.push("clang-17");
  out.push("clang-16");
  out.push("clang-15");
  out.push("clang-14");
  out.push("C:\\Program Files\\LLVM\\bin\\clang.exe");
  ret out;
}

// Builds `c_path` into a libFuzzer harness at `exe_path`, trying each
// candidate compiler from `_fuzz_cc_candidates` in turn until one
// compiles successfully. `-fsanitize=fuzzer,address` is the default
// (coverage-guided fuzzing plus AddressSanitizer's memory-error
// detection); `FUN_FUZZ_NO_ASAN` drops the `,address` half, since
// AddressSanitizer's own startup has been observed to hang in some
// sandboxed environments even when the compiler and fuzzing engine both
// work fine otherwise. Returns the exit code of the last candidate tried
// (0 on success), or -1 if no candidate compiler could be found at all.
pub fun compile_c_to_fuzz_exe(str c_path, str exe_path, flag debug_info) num {
  str no_asan_setting = env_or("FUN_FUZZ_NO_ASAN", "");
  flag no_asan = !equals(no_asan_setting, "") && !equals(no_asan_setting, "0");
  str sanitize_flag = "-fsanitize=fuzzer,address";
  if no_asan {
    sanitize_flag = "-fsanitize=fuzzer";
  }

  Vec<str> candidates = _fuzz_cc_candidates();
  defer candidates.free();

  num last_code = -1;
  num i = 0;
  for i < candidates.len {
    str cc = candidates.get(i);
    i = i + 1;

    Vec<str> argv_args;
    argv_args.init(0);
    defer argv_args.free();
    argv_args.push(cc);
    argv_args.push(sanitize_flag);
    argv_args.push(c_path);
    argv_args.push("-o");
    argv_args.push(exe_path);
    if debug_info {
      argv_args.push("-g");
    } else {
      argv_args.push("-g0");
    }
    argv_args.push("-pthread");
    argv_args.push("-lm");

    str[] argv = argv_from(&argv_args);
    let result = run(argv);
    free_argv(argv);
    if result.is_err() {
      // Couldn't even spawn this candidate (most likely not installed);
      // move on without treating it as a real compile failure.
      continue;
    }
    ProcessResult r = result.unwrap();
    if r.exit_code == 0 {
      ret 0;
    }
    last_code = r.exit_code;
    writeln_to(Sink.Stderr, r.stderr_text);
  }
  ret last_code;
}

// Compiles `c_path` to an object at `obj_path` without linking, which is
// how a library target is checked: it has no entry point to link.
pub fun compile_c_to_object(str c_path, str obj_path) num {
  str cc = c_compiler();
  Vec<str> argv_args;
  argv_args.init(0);
  defer argv_args.free();
  argv_args.push(cc);

  if compiler_is_msvc(cc) {
    argv_args.push("/nologo");
    argv_args.push("/c");
    argv_args.push(c_path);
    argv_args.push(format("/Fo:{str}", obj_path));
  } else {
    argv_args.push("-c");
    argv_args.push(c_path);
    argv_args.push("-o");
    argv_args.push(obj_path);
  }

  str[] argv = argv_from(&argv_args);
  let code = spawn_inherited(argv);
  free_argv(argv);
  ret code;
}

// Qualifies a bare executable name so it is run from the current
// directory rather than searched for on `PATH`. Windows already looks in
// the current directory, so only POSIX needs the prefix.
pub fun executable_path(str path) str {
  // Qualify a bare name so posix_spawnp never searches PATH for it.
  if !contains(path, "/") && !contains(path, "\\") {
    StringBuilder b = string_builder_init(16);
    if runtime_backend_is_windows() {
      b.append(".\\");
    } else {
      b.append("./");
    }
    b.append(path);
    ret b.build();
  }
  if runtime_backend_is_windows() {
    // posix_spawnp on MinGW fails with forward-slash relative paths; use backslashes.
    ret replace_char(path, '/', '\\');
  }
  ret path;
}

// Runs `exe_path` with `args`, inheriting this process's streams, and
// returns its exit code.
pub fun run_exe(str exe_path, Vec<str>* args) num {
  Vec<str> argv_args;
  argv_args.init(0);
  defer argv_args.free();
  argv_args.push(executable_path(exe_path));
  num i = 0;
  for i < args.len {
    argv_args.push(args.get(i));
    i = i + 1;
  }

  str[] argv = argv_from(&argv_args);
  let code = spawn_inherited(argv);
  free_argv(argv);
  ret code;
}

pub fun help_text() str {
  ret `usage:
  `  fun -in <input.fn> [-fmt | -fmt-all | -fmt-diag | -fmt-check | -fmt-check-all] [-out <output>] [-no-exec] [-outf] [-ast] [-g] [-warn-unused] [-warn-unused-lenient] [-D name=value] [-help] [-- <program args>]
  `  fun test <input.fn>      compiles and runs just that file's own test blocks
  `  fun test [<dir>]         runs every test block found under <dir> (default '.')
  `  fun fuzz <input.fn> [<target>]   builds and runs one fuzz block, open-ended
  `  fun fuzz [<dir>]         runs every fuzz target under <dir>, briefly bounded
  `  fun lint [<path>] [-summary]  reports every warning under <path> (a file or directory, default '.'), then totals; exits 1 if any
  `  fun build                reads ./fun.toml, installs binaries under fun-out/bin/
  `  fun init [lib|exe|mix]   scaffolds fun.toml and src/ (default exe)
  `  fun add <name> -git <url> [-path <p>] [-tag <t> | -branch <b> | -rev <sha>] [-token-env <VAR>]
  `                           adds or updates a [deps] entry in fun.toml
  `  fun deps update [<name>]  re-resolves tag/branch [deps] entries and rewrites fun.lock
  `  fun -fmt-check-all [-in <file_or_dir>]
  `  fun -version
  `
  `  -help, -h         Show this help message.
  `  -version          Print the package version and exit.
  `  -in <file>        Input file to compile.
  `  -out <file>       Write the generated C here.
  `  -no-exec          Compile only, without running the result.
  `  -outf             Keep the generated C file.
  `  -ast              Print the parsed AST, then continue compiling.
  `  -g                Build with debug information.
  `  -warn-unused      Report unused imports, variables, functions, and compounds.
  `  -warn-unused-lenient  Like -warn-unused, but keeps reporting them past an unrelated type error.
  `  -D name=value     Inject a constant the program can read.
  `  -test             Run -in's own test blocks, in place of a plain compile.
  `  -fuzz             Build and run -in's own fuzz target, in place of a plain compile.
  `  -fuzz-target <name>  Which target, when -in declares more than one.
  `  -fmt              Format the input file in place.
  `  -fmt-all          Format the input file and the modules it imports.
  `  -fmt-diag         Format the input file in place, then still run diagnostics.
  `  -fmt-check        Report the input if it is unformatted, and exit 1.
  `  -fmt-check-all    Report every unformatted file under the input, and exit 1.
  `  -summary          With lint, print only the totals.
  `  --                Pass every following argument to the compiled program.`;
}

fun _argv(Vec<str>* parts) str[] {
  str[] out = malloc(sizeof(str) * (parts.len + 2));
  out[0] = "fun";
  num i = 0;
  for i < parts.len {
    out[i + 1] = parts.get(i);
    i = i + 1;
  }
  out[parts.len + 1] = nil;
  ret out;
}

test "parses an input path and an output path" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("-out");
  a.push("prog.c");
  let o = parse_args(_argv(&a));
  assert !o.has_error, "expected the arguments to parse";
  assert equals(o.input, "main.fn"), "expected the input path";
  assert equals(o.output, "prog.c"), "expected the output path";
  assert o.keep_c, "expected -out to imply keeping the generated C file";
}

test "accepts a bare path as the input" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("main.fn");
  let o = parse_args(_argv(&a));
  assert equals(o.input, "main.fn"), "expected the input path";
}

test "collects the flags" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("-no-exec");
  a.push("-outf");
  a.push("-g");
  let o = parse_args(_argv(&a));
  assert o.no_exec, "expected -no-exec";
  assert o.keep_c, "expected -outf";
  assert o.debug_info, "expected -g";
}

test "everything after -- belongs to the program" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("--");
  a.push("passed");
  let o = parse_args(_argv(&a));
  defer o.free();
  assert o.program_args.len == 1, "expected the program argument";
  assert equals(o.program_args.get(0), "passed"), "expected the argument verbatim";
}

test "recognizes a build subcommand" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("build");
  let o = parse_args(_argv(&a));
  assert equals(o.subcommand, "build"), "expected the build subcommand";
}

test "recognizes an init subcommand and its kind positional" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("init");
  a.push("lib");
  let o = parse_args(_argv(&a));
  assert equals(o.subcommand, "init"), "expected the init subcommand";
  assert equals(o.input, "lib"), "expected the project kind as the positional";
}

test "init with no positional leaves the kind empty" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("init");
  let o = parse_args(_argv(&a));
  assert equals(o.subcommand, "init"), "expected the init subcommand";
  assert equals(o.input, ""), "expected no kind, defaulted later by init_project";
}

test "a double-dash spelling is equivalent to a single dash" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("--version");
  let o = parse_args(_argv(&a));
  assert o.show_version, "expected --version to match -version";
}

test "-test and -fuzz work as direct flags alongside -in" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("-test");
  let o = parse_args(_argv(&a));
  assert o.test_flag, "expected the direct -test flag";
  assert equals(o.subcommand, ""), "expected no subcommand rewrite";
}

test "-fuzz-target names a target without the fuzz subcommand" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("-fuzz");
  a.push("-fuzz-target");
  a.push("one");
  let o = parse_args(_argv(&a));
  assert o.fuzz_flag, "expected the direct -fuzz flag";
  assert equals(o.fuzz_target, "one"), "expected the named target";
}

test "a value flag with nothing following it is reported, not silently '1'" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  let o = parse_args(_argv(&a));
  assert o.has_error, "expected a missing value to be an error";
}

test "-out rejects a non-.c extension" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("-out");
  a.push("prog");
  let o = parse_args(_argv(&a));
  assert o.has_error, "expected a non-.c -out to be rejected";
}

test "reads a -D define" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-D");
  a.push("TAG=v1.2.3");
  a.push("main.fn");
  let o = parse_args(_argv(&a));
  defer o.free();
  assert o.defines.len == 1, "expected the define";
  assert equals(o.defines.get(0).name, "TAG"), "expected the define's name";
  assert equals(o.defines.get(0).value, "v1.2.3"), "expected the define's value";
}

test "a malformed -D is reported" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-D");
  a.push("NOEQUALS");
  let o = parse_args(_argv(&a));
  assert o.has_error, "expected a malformed define to be rejected";
}

test "with_extension replaces an existing extension" {
  assert equals(with_extension("main.fn", ".c"), "main.c"), "expected the extension replaced";
  assert equals(with_extension("src/main.fn", ".c"), "src/main.c"), "expected the directory kept";
}

test "with_extension appends when there is none" {
  assert equals(with_extension("main", ".c"), "main.c"), "expected the extension appended";
}

test "with_extension ignores a dot in a parent directory" {
  assert equals(with_extension("a.b/main", ".c"), "a.b/main.c"), "expected only the file's own name to matter";
}

test "executable_path qualifies a bare name" {
  if runtime_backend_is_windows() {
    assert equals(executable_path("prog"), ".\\prog"), "expected a bare name to be qualified with backslash on Windows";
  } else {
    assert equals(executable_path("prog"), "./prog"), "expected a bare name to be qualified";
  }
}

test "executable_path leaves a path alone" {
  if runtime_backend_is_windows() {
    assert equals(executable_path(".\\prog"), ".\\prog"), "expected an explicit backslash path to be kept";
    assert equals(executable_path("build/prog"), "build\\prog"), "expected forward slashes converted on Windows";
  } else {
    assert equals(executable_path("./prog"), "./prog"), "expected an explicit path to be kept";
    assert equals(executable_path("build/prog"), "build/prog"), "expected a directory path to be kept";
  }
}

test "with_extension handles a windows-style path" {
  assert equals(with_extension("src\\main.fn", ".c"), "src\\main.c"), "expected a backslash path to keep its directory";
}

test "the msvc compiler is recognized by name" {
  assert compiler_is_msvc("cl"), "expected cl to be msvc";
  assert compiler_is_msvc("cl.exe"), "expected cl.exe to be msvc";
  assert !compiler_is_msvc("cc"), "expected cc to be gcc-style";
  assert !compiler_is_msvc("/usr/bin/gcc"), "expected gcc to be gcc-style";
}

test "a compound field whose type was never imported is reported by name" {
  Vec<Define> defines;
  defines.init(0);
  defer defines.free();
  str out_path = "src/parser/import_resolver_fixtures/missing_map_import.test.c";
  let lowered = compile_to_c("src/parser/import_resolver_fixtures/missing_map_import.fn", out_path, &defines, false);
  remove_file(out_path);
  assert lowered.is_err(), "expected the missing import to fail the compile";
  str message = lowered.unwrap_err();
  assert contains(message, "the type 'Map' of field 'hints' in 'Holder' is not declared"), "expected the message to name the type, the field and the compound";
}

test "a test binary keeps only its own file's test blocks, not the ones it imports" {
  let merged = parse_program_with_imports("src/parser/import_resolver_fixtures/own_tests_main.fn");
  assert merged.is_ok(), "expected the fixture to parse";
  let nodes = merged.unwrap().nodes;
  num before = 0;
  for n : nodes {
    fit n.kind {
      .Test(_) -> { before = before + 1; }
      _ -> {}
    }
  }
  assert before == 2, "expected the entry's test and its import's test before filtering";
  _drop_foreign_tests(&nodes, "src/parser/import_resolver_fixtures/own_tests_main.fn");
  num after = 0;
  str kept_name = "";
  for n : nodes {
    fit n.kind {
      .Test(t) -> {
        after = after + 1;
        kept_name = t.name;
      }
      _ -> {}
    }
  }
  assert after == 1, "expected only the entry file's own test to remain";
  assert equals(kept_name, "the entry file's own test"), "expected the surviving test to be the entry's";
}

sequential test "resolve_c_compiler honors FUN_CC verbatim, and falls back to a real search when unset" {
  set_env("FUN_CC", "some-made-up-cc");
  assert equals(resolve_c_compiler(), "some-made-up-cc"), "expected the exact override, unresolved against PATH";
  clear_env("FUN_CC");

  // Regression: `cg.msvc_mode` used to come from `c_compiler()`'s own
  // hardcoded platform guess ("cl" on Windows), a DIFFERENT decision than
  // `compile_c_to_exe`'s own candidate search (clang tried first, and
  // normally present even on Windows) actually uses to pick a compiler -
  // silently mismatching codegen's emitted C shape against the compiler
  // that would actually receive it, on any machine where clang exists but
  // isn't literally named "cl". `resolve_c_compiler` runs that same
  // search itself, so it can never name a compiler `compile_c_to_exe`
  // wouldn't also pick.
  let resolved = resolve_c_compiler();
  assert !equals(resolved, ""), "expected some compiler to resolve on this machine";
}

// Reads `./fun.toml` and fills in whatever it left implicit.
pub fun load_manifest() Result<Manifest, str> {
  if !exists("fun.toml") {
    ret .Err("no fun.toml in this directory");
  }
  Manifest m = parse_manifest(read_to_string("fun.toml"))!;
  resolve_targets(&m, "");
  ret .Ok(m);
}

// The shared "make sure `[deps]` is fetched before compiling anything"
// step every entry point (`fun build`, `fun test`, `fun fuzz`) runs
// first: a no-op when there is no `fun.toml` here at all (a bare `fun
// -in file.fn` invocation, same as today) or the manifest declares no
// dependencies, otherwise resolves and fetches every entry, rewriting
// `fun.lock` to match. `None` on success; `Some(message)` is a real
// resolution/fetch failure the caller should report and abort on -
// distinct from "no fun.toml here", which is expected and silent.
fun ensure_deps_resolved() Option<str> {
  if !exists("fun.toml") {
    ret .None;
  }
  let loaded = load_manifest();
  if loaded.is_err() {
    // A malformed fun.toml is reported properly by whatever actually
    // needs it (compile_to_c_mode re-reads it for -D defines); this
    // step only cares about depending on one that parses.
    ret .None;
  }
  Manifest m = loaded.unwrap();
  defer m.free();
  if m.deps.len == 0 {
    ret .None;
  }
  let resolved = resolve_all(&m, "", false);
  if resolved.is_err() {
    ret .Some(resolved.unwrap_err());
  }
  resolved.unwrap().free();
  ret .None;
}

// Compiles every target the manifest declares, writing executables to
// `fun-out/bin`. A library has no entry point, so it is compiled to an
// object under `fun-out/lib` to prove it builds, never linked.
pub fun build_project(flag debug_info, Vec<Define>* extra_defines) num {
  let loaded = load_manifest();
  if loaded.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", loaded.unwrap_err()));
    ret 1;
  }
  Manifest m = loaded.unwrap();
  defer m.free();

  if m.kind() == .Empty {
    writeln_to(
      Sink.Stderr,
      format("[Error]\npackage `{str}` declares no [lib] or [[exe]] target", m.package_name)
    );
    ret 1;
  }

  if m.deps.len > 0 {
    let resolved = resolve_all(&m, "", false);
    if resolved.is_err() {
      writeln_to(Sink.Stderr, format("[Error]\n{str}", resolved.unwrap_err()));
      ret 1;
    }
    resolved.unwrap().free();
  }

  // Re-reads and re-parses fun.toml a second time (already loaded as
  // `m` above, needed for `m.kind()`/`m.has_lib`/... below) rather than
  // hand-merging `-D` in again here - `fun build` isn't a hot path, and
  // reusing the one shared merge point matters more than the extra read.
  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  if m.has_lib {
    make_dir_all("fun-out/lib");
    str c_path = path_join("fun-out/lib", format("{str}.c", m.lib.name));
    let lowered = compile_to_c(m.lib.path, c_path, &defines, debug_info);
    if lowered.is_err() {
      writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
      ret 1;
    }
    let code = compile_c_to_object(c_path, path_join("fun-out/lib", format("{str}.o", m.lib.name)));
    if code != 0 {
      ret 1;
    }
    println(format("checked {str}", m.lib.name));
  }

  num i = 0;
  for i < m.exes.len {
    ExeTarget* e = &m.exes.data[i];
    make_dir_all("fun-out/bin");
    str c_path = path_join("fun-out/bin", format("{str}.c", e.name));
    let lowered = compile_to_c(e.path, c_path, &defines, debug_info);
    if lowered.is_err() {
      writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
      ret 1;
    }
    str exe = path_join("fun-out/bin", format("{str}{str}", e.name, exe_suffix()));
    let code = compile_c_to_exe_mode(c_path, exe, debug_info, true);
    if code != 0 {
      ret 1;
    }
    println(format("built {str} -> {str}", e.name, exe));
    i = i + 1;
  }
  ret 0;
}

// `fun add <name> -git <url> [-path <p>] [-tag <t> | -branch <b> |
// -rev <r>] [-token-env <VAR>]`: writes or updates one `[deps]` entry
// in `fun.toml` in place. Line-based, matching this file's own
// hand-built-text approach for `fun init` rather than a general TOML
// writer (`std.toml`'s own `stringify` only round-trips flat top-level
// scalars, not sections - see `manifest.fn`'s module doc).
pub fun add_dependency(
  str name,
  str git,
  str path,
  str tag,
  str branch,
  str rev,
  str token_env
) num {
  if !exists("fun.toml") {
    writeln_to(Sink.Stderr, "[Error]\nno fun.toml in this directory");
    ret 1;
  }
  if equals(name, "") {
    writeln_to(Sink.Stderr, "[Error]\nfun add requires a dependency name");
    ret 1;
  }
  if equals(git, "") {
    writeln_to(Sink.Stderr, "[Error]\nfun add requires -git <url>");
    ret 1;
  }
  num spec_count = 0;
  if !equals(tag, "") {
    spec_count = spec_count + 1;
  }
  if !equals(branch, "") {
    spec_count = spec_count + 1;
  }
  if !equals(rev, "") {
    spec_count = spec_count + 1;
  }
  if spec_count > 1 {
    writeln_to(Sink.Stderr, "[Error]\nonly one of -tag, -branch, -rev may be given");
    ret 1;
  }
  // The exact same checks `fun build` would apply once this entry is
  // parsed back out of fun.toml, run here too, so a bad value is
  // rejected before it's ever written rather than leaving the user to
  // hand-edit the manifest after a confusing later failure.
  if !is_safe_dep_name(name) {
    writeln_to(Sink.Stderr, "[Error]\na dependency's name must be a plain identifier (letters, digits, underscore, not starting with a digit)");
    ret 1;
  }
  if !is_safe_git_url(git) {
    writeln_to(Sink.Stderr, "[Error]\n-git must start with https://, ssh://, git@, or file://");
    ret 1;
  }
  if !is_safe_dep_path(path) {
    writeln_to(Sink.Stderr, "[Error]\n-path must be a relative path with no .. segments");
    ret 1;
  }
  if !equals(tag, "") && !equals(tag, "latest") && !is_safe_git_ref(tag) {
    writeln_to(Sink.Stderr, "[Error]\ninvalid -tag");
    ret 1;
  }
  if !equals(branch, "") && !is_safe_git_ref(branch) {
    writeln_to(Sink.Stderr, "[Error]\ninvalid -branch");
    ret 1;
  }
  if !equals(rev, "") && !is_safe_git_ref(rev) {
    writeln_to(Sink.Stderr, "[Error]\ninvalid -rev");
    ret 1;
  }
  if !equals(token_env, "") && !is_safe_dep_name(token_env) {
    writeln_to(Sink.Stderr, "[Error]\ninvalid -token-env");
    ret 1;
  }

  StringBuilder entry = string_builder_init(64);
  entry.append(name);
  entry.append(" = { git = \"");
  entry.append(git);
  entry.append("\"");
  if !equals(path, "") {
    entry.append(", path = \"");
    entry.append(path);
    entry.append("\"");
  }
  if !equals(tag, "") {
    entry.append(", tag = \"");
    entry.append(tag);
    entry.append("\"");
  } elif !equals(branch, "") {
    entry.append(", branch = \"");
    entry.append(branch);
    entry.append("\"");
  } elif !equals(rev, "") {
    entry.append(", rev = \"");
    entry.append(rev);
    entry.append("\"");
  }
  if !equals(token_env, "") {
    entry.append(", token_env = \"");
    entry.append(token_env);
    entry.append("\"");
  }
  entry.append(" }");
  str entry_line = entry.build();

  str text = read_to_string("fun.toml");
  Vec<str> lines = split(text, '\n');
  defer lines.free();
  // A `\n`-terminated file's own split produces one trailing empty
  // element representing "nothing after the last real line", not an
  // actual blank line worth preserving - left in place, appending a
  // new entry after it would grow a fresh blank line onto the file's
  // own end every single time `fun add` runs.
  if lines.len > 0 && equals(lines.get(lines.len - 1), "") {
    lines.pop();
  }

  flag in_deps = false;
  flag replaced = false;
  flag has_deps_table = false;
  StringBuilder out = string_builder_init(len(text) + len(entry_line) + 16);
  str name_prefix = format("{str} = ", name);
  for line : lines {
    str trimmed = trim(line);
    if starts_with(trimmed, "[") && !starts_with(trimmed, "[deps]") {
      in_deps = false;
    }
    if equals(trimmed, "[deps]") {
      in_deps = true;
      has_deps_table = true;
    }
    if in_deps && starts_with(trimmed, name_prefix) {
      out.append(entry_line);
      out.append("\n");
      replaced = true;
      continue;
    }
    out.append(line);
    out.append("\n");
  }
  if !replaced {
    if !has_deps_table {
      out.append("\n[deps]\n");
    }
    out.append(entry_line);
    out.append("\n");
  }
  write_string("fun.toml", out.build());
  println(format("added `{str}` to [deps]", name));
  ret 0;
}

// `fun deps update [name]`: re-resolves every `tag`/`branch` entry (a
// `rev` pin is never re-resolved, since an explicit pin means the
// caller wants exactly that revision), rewriting `fun.lock`. `name`
// narrows this to one dependency; empty updates all of them.
pub fun deps_update_command(str name) num {
  let loaded = load_manifest();
  if loaded.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", loaded.unwrap_err()));
    ret 1;
  }
  Manifest m = loaded.unwrap();
  defer m.free();

  if m.deps.len == 0 {
    println("no [deps] entries to update");
    ret 0;
  }

  Manifest target = m;
  Vec<Dependency> filtered;
  flag narrowed = false;
  if !equals(name, "") {
    filtered.init(0);
    num i = 0;
    flag found = false;
    for i < m.deps.len {
      let d = m.deps.get(i);
      if equals(d.name, name) {
        filtered.push(d);
        found = true;
      }
      i = i + 1;
    }
    if !found {
      writeln_to(Sink.Stderr, format("[Error]\nno [deps] entry named `{str}`", name));
      filtered.free();
      ret 1;
    }
    target.deps = filtered;
    narrowed = true;
  }

  let resolved = resolve_all(&target, "", true);
  if narrowed {
    filtered.free();
  }
  if resolved.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", resolved.unwrap_err()));
    ret 1;
  }
  let out = resolved.unwrap();
  defer out.free();
  if equals(name, "") {
    println(format("updated {} dependencies", out.len));
  } else {
    println(format("updated `{str}`", name));
  }
  ret 0;
}

// The starter `src/main.fn` an `init`ed executable target gets.
fun _init_main_source() str {
  ret `use std.io;
  `
  `fun main(str[] args) {
  `  println("Hello, World!");
  `}`;
}

// The starter `src/lib.fn` an `init`ed library target gets.
fun _init_lib_source() str {
  ret `pub fun hello() str {
  `  ret "Hello, World!";
  `}`;
}

// The starter `.gitignore` an `init`ed project gets.
fun _init_gitignore_source() str {
  ret `/fun-out/`;
}

// `fun init [lib|exe|mix]`: writes a `fun.toml`, a `src/` directory, and
// a `.gitignore` for a new package in the working directory. `kind` is
// one of `lib`, `exe`, or `mix`; empty defaults to `exe`.
pub fun init_project(str kind) num {
  str resolved_kind = kind;
  if equals(resolved_kind, "") {
    resolved_kind = "exe";
  }
  flag wants_lib = equals(resolved_kind, "lib") || equals(resolved_kind, "mix");
  flag wants_exe = equals(resolved_kind, "exe") || equals(resolved_kind, "mix");
  if !wants_lib && !wants_exe {
    writeln_to(
      Sink.Stderr,
      format(
      "[Error]\nunknown project kind `{str}` (expected `lib`, `exe`, or `mix`)",
      resolved_kind
      )
    );
    ret 1;
  }
  if exists("fun.toml") {
    writeln_to(Sink.Stderr, "[Error]\nfun.toml already exists in this directory");
    ret 1;
  }

  str name = "app";

  let made_dir = make_dir_all("src");
  if made_dir.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", made_dir.unwrap_err().message));
    ret 1;
  }

  StringBuilder toml = string_builder_init(64);
  toml.append(format("[package]\nname = \"{str}\"\nversion = \"0.1.0\"\n", name));

  if wants_lib {
    toml.append("\n[lib]\npath = \"src/lib.fn\"\n");
    write_string("src/lib.fn", _init_lib_source());
    println("created src/lib.fn");
  }
  if wants_exe {
    toml.append(format("\n[[exe]]\nname = \"{str}\"\npath = \"src/main.fn\"\n", name));
    write_string("src/main.fn", _init_main_source());
    println("created src/main.fn");
  }

  write_string("fun.toml", toml.build());
  println("created fun.toml");

  if !exists(".gitignore") {
    write_string(".gitignore", _init_gitignore_source());
    println("created .gitignore");
  }
  ret 0;
}

// The full set of build-time constants a program compiles with: this
// workspace's own `PACKAGE_NAME`/`PACKAGE_VERSION` when a `fun.toml`
// exists here, plus whatever `-D name=value` the caller supplied
// directly. Shared so every entry point (a plain compile, `-test`,
// `-fuzz`, and both directory-suite forms) offers the same constants,
// rather than each seeing only its own half: the plain compile path
// only ever saw `-D`, `-test`/`-fuzz` only ever saw the manifest's own.
pub fun resolved_defines(Vec<Define>* extra) Vec<Define> {
  Vec<Define> out;
  out.init(extra.len + 2);
  if exists("fun.toml") {
    let loaded = load_manifest();
    if loaded.is_ok() {
      Manifest m = loaded.unwrap();
      let manifest_ones = manifest_defines(&m);
      num mi = 0;
      for mi < manifest_ones.len {
        out.push(manifest_ones.get(mi));
        mi = mi + 1;
      }
      manifest_ones.free();
    }
  }
  num ei = 0;
  for ei < extra.len {
    out.push(extra.get(ei));
    ei = ei + 1;
  }
  ret out;
}

// Compiles `input` with its test blocks and runs them, passing `args` on
// so a single test can be named. Returns the runner's exit code.
// `no_exec` stops right after writing the C (to `out_override` when
// given, the default `.test.c` path otherwise) - the artifact a caller
// wanting to compile and debug it themselves asked for (the vscode
// extension's own Debug Test command does exactly this) - rather than
// this function's own compile-run-delete cycle silently overriding it.
pub fun run_tests(
  str input,
  Vec<str>* args,
  flag debug_info,
  flag no_exec,
  str out_override,
  flag warn_unused,
  flag warn_unused_lenient,
  flag keep_c,
  Vec<Define>* extra_defines
) num {
  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  let dep_check = ensure_deps_resolved();
  if dep_check.is_some() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", dep_check.unwrap()));
    ret 1;
  }

  str c_path = out_override;
  if equals(c_path, "") {
    c_path = default_c_path(input, ".test.c");
  }
  let lowered = compile_to_c_mode(
    input,
    c_path,
    &defines,
    true,
    warn_unused,
    false,
    "",
    debug_info,
    warn_unused_lenient
  );
  if lowered.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
    ret 1;
  }

  if no_exec {
    ret 0;
  }

  str exe = default_exe_path(input, ".test");
  let cc_code = compile_c_to_exe(c_path, exe, debug_info);
  if !keep_c {
    remove_file(c_path);
  }
  if cc_code != 0 {
    ret 1;
  }

  let code = run_exe(exe, args);
  remove_file(exe);
  ret code;
}

// Compiles `input`'s `target` fuzz harness (or, when `target` is empty,
// the file's own single declared target) and runs it, passing `args` on
// (a caller wanting a bounded run passes libFuzzer flags like
// `-max_total_time=30` here). Returns the harness's own exit code.
// `no_exec`/`out_override`: see `run_tests`'s own doc comment - the
// same gap applied here identically.
pub fun run_fuzz(
  str input,
  str target,
  Vec<str>* args,
  flag debug_info,
  flag no_exec,
  str out_override,
  flag warn_unused,
  flag warn_unused_lenient,
  flag keep_c,
  Vec<Define>* extra_defines
) num {
  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  let dep_check = ensure_deps_resolved();
  if dep_check.is_some() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", dep_check.unwrap()));
    ret 1;
  }

  str c_path = out_override;
  if equals(c_path, "") {
    c_path = default_c_path(input, ".fuzz.c");
  }
  let lowered = compile_to_c_mode(
    input,
    c_path,
    &defines,
    false,
    warn_unused,
    true,
    target,
    debug_info,
    warn_unused_lenient
  );
  if lowered.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
    ret 1;
  }

  if no_exec {
    ret 0;
  }

  str exe = default_exe_path(input, ".fuzz");
  let cc_code = compile_c_to_fuzz_exe(c_path, exe, debug_info);
  if !keep_c {
    remove_file(c_path);
  }
  if cc_code != 0 {
    ret 1;
  }

  let code = run_exe(exe, args);
  remove_file(exe);
  ret code;
}

compound SuiteTestResult {
  num exit_code;
  str captured;
  // Wall-clock milliseconds spent lowering to C, in the C compiler, and
  // running the compiled test binary.
  num lower_ms;
  num cc_ms;
  num run_ms;
}

// Wall-clock milliseconds, only meaningful as a difference between two
// calls.
fun _wall_ms() num {
  i64* ts = malloc(16);
  ts[0] = 0;
  ts[1] = 0;
  raw* ts_raw = ts;
  let rc = clock_gettime(0, ts_raw);
  num ms = 0;
  if rc == 0 {
    ms = ts[0] * 1000 + ts[1] / 1000000;
  }
  free(ts);
  ret ms;
}

// Like run_tests but captures the test binary's stdout instead of inheriting
// it, so run_test_suite can decide what to display. Compile output still goes
// to stderr when a compiler is explicitly set via FUN_CC.
//
// `compile_tag` tags the intermediate `.c`/exe paths so concurrent
// run_test_suite workers never write the same output path at once: two
// different source files that happen to share a basename (different
// directories, same filename) would otherwise collide, and reusing a
// per-worker tag across that worker's own many files over the run isn't
// safe either (a just-deleted file isn't always immediately safe to
// recreate under the exact same name on Windows - antivirus/indexer/
// deferred handle release can still hold it briefly). The caller passes
// each file's own claimed index, unique for the whole run, so no compile
// ever reuses a path any other compile - on this worker or any other -
// has ever touched.
fun _run_tests_captured(
  str input,
  num compile_tag,
  flag debug_info,
  flag warn_unused,
  flag warn_unused_lenient,
  Vec<Define>* extra_defines
) SuiteTestResult {
  SuiteTestResult bad;
  bad.exit_code = 1;
  bad.captured = "";
  bad.lower_ms = 0;
  bad.cc_ms = 0;
  bad.run_ms = 0;

  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  str c_path = default_c_path(input, format(".w{num}.test.c", compile_tag));
  let t_lower = _wall_ms();
  let lowered = compile_to_c_mode(
    input,
    c_path,
    &defines,
    true,
    warn_unused,
    false,
    "",
    debug_info,
    warn_unused_lenient
  );
  let lower_ms = _wall_ms() - t_lower;
  bad.lower_ms = lower_ms;
  if lowered.is_err() {
    bad.captured = format("[Error]\n{str}", lowered.unwrap_err());
    ret bad;
  }

  str exe = default_exe_path(input, format(".w{num}.test", compile_tag));
  let t_cc = _wall_ms();
  let cc_code = compile_c_to_exe(c_path, exe, debug_info);
  let cc_ms = _wall_ms() - t_cc;
  bad.cc_ms = cc_ms;
  remove_file(c_path);
  if cc_code != 0 {
    bad.captured = "C compiler returned non-zero";
    ret bad;
  }

  Vec<str> argv_args;
  argv_args.init(1);
  defer argv_args.free();
  argv_args.push(executable_path(exe));
  str[] argv = argv_from(&argv_args);
  let t_run = _wall_ms();
  let result = run(argv);
  let run_ms = _wall_ms() - t_run;
  free_argv(argv);
  remove_file(exe);

  if result.is_err() {
    bad.captured = "could not run test binary";
    ret bad;
  }
  ProcessResult r = result.unwrap();
  SuiteTestResult ok;
  ok.exit_code = r.exit_code;
  ok.lower_ms = lower_ms;
  ok.cc_ms = cc_ms;
  ok.run_ms = run_ms;
  // A failed `assert`'s own "Assertion failed: ..." message goes to
  // stderr (see StatementAssert's own codegen), so stdout alone never
  // shows why a test actually failed - appended here rather than
  // silently dropped, the same output a directly-run test binary would
  // show in a real terminal, just not perfectly interleaved with it.
  if !equals(r.stderr_text, "") {
    ok.captured = format("{str}{str}", r.stdout_text, r.stderr_text);
  } else {
    ok.captured = r.stdout_text;
  }
  ret ok;
}

// Shared state for run_test_suite's worker threads. `next_index`/
// `passed`/`failed`/`failed_files` are all written only under `lock` (a
// plain counter, not `Atomic<num>`, since claiming a file and reporting
// its result share the same critical section below); a Vec push or a
// `println` isn't safe to run from more than one thread at once either.
compound _TestSuiteWorkerCtx {
  Vec<str>* files;
  num next_index;
  flag debug_info;
  flag warn_unused;
  flag warn_unused_lenient;
  Vec<Define>* extra_defines;
  Mutex lock;
  num passed;
  num failed;
  Vec<str>* failed_files;
  flag timing;
  num total_lower_ms;
  num total_cc_ms;
  num total_run_ms;
}

// A run_test_suite worker: claims files one at a time from the shared
// index until none remain, compiling and running each through
// `_run_tests_captured` outside the lock (the expensive part, where
// parallelism actually pays off) and only taking `lock` to claim the next
// file, print a result line, and update the shared counters/list.
fun _test_suite_worker(raw* arg) raw* {
  if arg == nil {
    ret nil;
  }
  _TestSuiteWorkerCtx* ctx = arg;

  for true {
    ctx.lock.lock();
    num i = ctx.next_index;
    if i >= ctx.files.len {
      ctx.lock.unlock();
      break;
    }
    ctx.next_index = i + 1;
    str path = ctx.files.get(i);
    println(format("  running {str}", path));
    ctx.lock.unlock();

    // `i`, not a per-worker id: a worker tag would get reused across
    // every file that same worker processes over the run's lifetime,
    // and on Windows a just-deleted file isn't always immediately safe
    // to recreate under the exact same name (antivirus/indexer/deferred
    // handle release can still hold it briefly). `i` is claimed once,
    // globally, for the whole run, so no compile ever reuses a path
    // another compile (on this worker or any other) has ever touched.
    let res = _run_tests_captured(
      path,
      i,
      ctx.debug_info,
      ctx.warn_unused,
      ctx.warn_unused_lenient,
      ctx.extra_defines
    );

    ctx.lock.lock();
    ctx.total_lower_ms = ctx.total_lower_ms + res.lower_ms;
    ctx.total_cc_ms = ctx.total_cc_ms + res.cc_ms;
    ctx.total_run_ms = ctx.total_run_ms + res.run_ms;
    if res.exit_code == 0 {
      ctx.passed = ctx.passed + 1;
      num n = count(res.captured, " ... PASS");
      if ctx.timing {
        println(
          format(
          "  ok  {str}  ({num} tests)  lower {num}ms, cc {num}ms, run {num}ms",
          path,
          n,
          res.lower_ms,
          res.cc_ms,
          res.run_ms
          )
        );
      } else {
        println(format("  ok  {str}  ({num} tests)", path, n));
      }
    } else {
      ctx.failed = ctx.failed + 1;
      println(format("  FAIL  {str}  (exit code {num})", path, res.exit_code));
      // Every test reporting PASS but the process still failing means the
      // run itself broke (a crash or a bad exit status at shutdown), not a
      // test - say so, rather than leaving it to look like a silent flake.
      if contains(res.captured, " tests passed") && !contains(res.captured, " ... FAIL") {
        println("  every test passed, but the test binary exited with a failure status");
      }
      print(res.captured);
      ctx.failed_files.push(path);
    }
    ctx.lock.unlock();
  }

  ret nil;
}

// Worker count for run_test_suite. Not `std.sys.cpu_count()`: that binding
// (and the compiler prelude wrapper backing it) is newer than the last
// release, and this file compiles as part of `fun` itself, so a stage-1
// bootstrap from that release needs to build it without relying on
// anything only stage 2 onward can provide. A fixed default, overridable
// with `FUN_TEST_JOBS`, has no such dependency.
//
// Lower by default on Windows: each compiled test binary also runs its
// own worker pool (see emit_test_runner), and a test that shells out to
// the C compiler pays for it there with `cl.exe`, which is markedly
// heavier to spawn than gcc/clang and, under both layers of parallelism
// running at once on a CI-sized Windows runner, was observed pushing
// individual test times from under a second to 6-8 seconds - real
// resource exhaustion, not a hang or a bug in any one test.
const num default_test_suite_workers = 8;
const num default_test_suite_workers_windows = 4;

fun _test_suite_worker_count() num {
  str override_s = env_or("FUN_TEST_JOBS", "");
  num fallback = default_test_suite_workers;
  if runtime_backend_is_windows() {
    fallback = default_test_suite_workers_windows;
  }
  if equals(override_s, "") {
    ret fallback;
  }
  num parsed = atoi(override_s);
  if parsed <= 0 {
    ret fallback;
  }
  ret parsed;
}

// `fun test <dir>`/`fun test` (no path): discovers every `.fn` file under
// `root` that declares a `test` block, then runs them across a pool of
// worker threads (see _test_suite_worker_count) pulling from a shared work
// queue, and prints an aggregate pass/fail summary.
// Every file still gets its own compile pass and its own process for the
// compiled binary (see _run_tests_captured), so one file's failure or
// crash can't take the rest of the run down with it - that per-file
// isolation is what makes running them concurrently safe in the first
// place. Result lines print as each worker finishes a file, so they
// interleave in completion order rather than file order; failing files
// still show their full captured output and are listed again in the
// summary at the end.
pub fun run_test_suite(
  str root,
  flag debug_info,
  flag warn_unused,
  flag warn_unused_lenient,
  Vec<Define>* extra_defines
) num {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);
  files.sort();

  Vec<str> test_files;
  test_files.init(16);
  defer test_files.free();
  num fi = 0;
  for fi < files.len {
    str path = files.get(fi);
    fi = fi + 1;
    if !_in_fixtures_dir(path) && _declares_top_level_block(path, "test") {
      test_files.push(path);
    }
  }

  if test_files.len == 0 {
    println(format("no `test` blocks found under {str}", dir));
    ret 0;
  }

  num workers = _test_suite_worker_count();
  if workers < 1 {
    workers = 1;
  }
  if workers > test_files.len {
    workers = test_files.len;
  }

  Vec<str> failed_files;
  failed_files.init(4);
  defer failed_files.free();

  // `compile_c_to_exe` (via `_ensure_msvc_env`) probes for the MSVC
  // toolchain and caches the result by setting `INCLUDE` in this
  // process's own environment, a fast path every later caller checks
  // first - but the probe itself isn't safe to run from more than one
  // thread at once (it shells out to a FIXED, shared batch-file path and
  // mutates the environment as it goes). Priming it once here, before
  // the worker pool below starts, means every worker's own later call
  // just hits the fast path instead of racing to do the real work
  // concurrently.
  _ensure_msvc_env();

  _TestSuiteWorkerCtx ctx;
  ctx.files = &test_files;
  ctx.next_index = 0;
  ctx.debug_info = debug_info;
  ctx.warn_unused = warn_unused;
  ctx.warn_unused_lenient = warn_unused_lenient;
  ctx.extra_defines = extra_defines;
  ctx.lock = mutex_new();
  ctx.passed = 0;
  ctx.failed = 0;
  ctx.failed_files = &failed_files;
  ctx.timing = !equals(env_or("FUN_TEST_TIMING", ""), "");
  ctx.total_lower_ms = 0;
  ctx.total_cc_ms = 0;
  ctx.total_run_ms = 0;
  let suite_start_ms = _wall_ms();

  // Each spawned file's own compiled test binary also sizes its OWN pool
  // to the full CPU count by default (see emit_test_runner); on Windows
  // that stacks on top of this process's own (already lower, see
  // _test_suite_worker_count) worker count and, under `cl.exe`'s heavier
  // spawn cost, was observed causing real slowdowns under CI-sized
  // resource limits. Capped here, but only if the caller hasn't already
  // set an explicit preference.
  if runtime_backend_is_windows() && equals(env_or("FUN_TEST_INTRA_JOBS", ""), "") {
    set_env("FUN_TEST_INTRA_JOBS", "2");
  }

  ThreadPool pool = thread_pool_new(workers);
  defer pool.destroy();

  raw* args_mem = malloc(sizeof(raw*) * workers);
  raw * [] args = args_mem;
  num k = 0;
  for k < workers {
    args[k] = &ctx;
    k = k + 1;
  }

  let start_rc = pool.start_all(_test_suite_worker, args);
  if start_rc != 0 {
    free(args_mem);
    println(format("failed to start test worker threads (code {num})", start_rc));
    ret 1;
  }
  let _join_rc = pool.join_all(nil);
  free(args_mem);

  num passed = ctx.passed;
  num failed = ctx.failed;

  println(format("\n{num}/{num} test files passed", passed, passed + failed));
  if ctx.timing {
    println(
      format(
      "wall {num}ms across {num} workers; summed per phase: lower {num}ms, cc {num}ms, run {num}ms",
      _wall_ms() - suite_start_ms,
      workers,
      ctx.total_lower_ms,
      ctx.total_cc_ms,
      ctx.total_run_ms
      )
    );
  }
  if failed > 0 {
    println("\nFailed:");
    num j = 0;
    for j < failed_files.len {
      println(format("  {str}", failed_files.get(j)));
      j = j + 1;
    }
    ret 1;
  }
  ret 0;
}

// Default wall-clock budget (seconds) for one fuzz target when running
// the directory-wide `fun fuzz [path]` form, where multiple targets
// across possibly multiple files each get their own bounded run rather
// than the open-ended campaign a single `fun fuzz <file.fn> <target>`
// normally leaves to the caller. Override with `FUN_FUZZ_DEFAULT_SECONDS`.
const num default_fuzz_seconds = 30;

fun _fuzz_budget_seconds() num {
  str override_s = env_or("FUN_FUZZ_DEFAULT_SECONDS", "");
  if equals(override_s, "") {
    ret default_fuzz_seconds;
  }
  num parsed = atoi(override_s);
  if parsed <= 0 {
    ret default_fuzz_seconds;
  }
  ret parsed;
}

// Shared state between `_fuzz_watchdog` and the thread waiting on the
// harness process. `mu` guards `done`/`killed`; both flip only once, from
// false to true, so a stale read just means the watchdog checks again a
// second later rather than reads garbage.
compound FuzzWatch {
  num pid;
  num budget_seconds;
  Mutex mu;
  flag done;
  flag killed;
}

// Sleeps up to `budget_seconds`, checking once a second whether the
// harness has already finished on its own, and force-kills it if it's
// still running when the budget runs out. Runs as its own virtual thread
// alongside the thread blocked in `wait_exit_code`, matching the
// reference compiler's own watchdog for the same reason: libFuzzer's own
// `-max_total_time` flag isn't reliable in every environment, so the
// budget can't depend on the fuzzing engine honoring it alone.
async fun _fuzz_watchdog(FuzzWatch* w, WaitGroup* wg) {
  num slept = 0;
  for slept < w.budget_seconds {
    w.mu.lock();
    flag d = w.done;
    w.mu.unlock();
    if d {
      break;
    }
    sleep_seconds(1);
    slept = slept + 1;
  }
  w.mu.lock();
  flag already_done = w.done;
  if !already_done {
    w.killed = true;
  }
  w.mu.unlock();
  if !already_done {
    kill_pid(w.pid);
  }
  wg.done();
}

// Runs `argv` (index 0 is the executable) to completion, force-killing it
// if it's still running after `budget_seconds`. `wg`/`w.mu` outlive the
// watchdog task (waited on below before returning), so there is no
// dangling reference to either once this function's own stack frame
// disappears.
compound FuzzRunResult {
  num exit_code;
  flag killed_by_budget;
}

fun _run_fuzz_bounded(str[] argv, num budget_seconds) FuzzRunResult {
  FuzzRunResult result;
  result.exit_code = -1;
  result.killed_by_budget = false;

  let spawned = spawn_background(argv);
  if spawned.is_err() {
    ret result;
  }

  FuzzWatch w;
  w.pid = spawned.unwrap();
  w.budget_seconds = budget_seconds;
  w.mu = mutex_new();
  w.done = false;
  w.killed = false;

  WaitGroup wg = wait_group_new(1);
  fork _fuzz_watchdog(&w, &wg);

  num code = wait_exit_code(w.pid);
  w.mu.lock();
  w.done = true;
  w.mu.unlock();
  wg.wait();
  wg.destroy();
  w.mu.destroy();

  result.exit_code = code;
  result.killed_by_budget = w.killed;
  ret result;
}

// Every `fuzz "<name>" (...)` target `path` declares, in source order. A
// file can declare more than one; the directory-wide fuzz runner builds
// and runs each separately (a fuzz harness only ever exercises one target
// per binary, selected at compile time).
fun _collect_fuzz_targets(str path) Vec<str> {
  Vec<str> out;
  out.init(0);
  if !exists(path) {
    ret out;
  }
  str src = read_to_string(path);
  let lexed = tokenize(src, path);
  if lexed.is_err() {
    ret out;
  }
  Vec<Token> tokens = lexed.unwrap();
  defer tokens.free();

  num i = 0;
  for i + 1 < tokens.len {
    Token t = tokens.get(i);
    i = i + 1;
    if t.type != .Keyword || !equals(token_text(t), "fuzz") {
      continue;
    }
    Token next = tokens.get(i);
    if next.type == .String {
      // Not `token_text`: for a `.String` token that returns the value
      // re-quoted for source reproduction (`fmt.fn`'s own job), not the
      // decoded name a target was declared with.
      fit next.data {
        .Sval(s) -> { out.push(s); }
        _ -> {}
      }
    }
  }
  ret out;
}

// `fun fuzz <dir>`/`fun fuzz` (no path): discovers every `.fn` file under
// `root` that declares one or more `fuzz` targets, runs each target for a
// bounded `FUN_FUZZ_DEFAULT_SECONDS` (default 30s), and prints an
// aggregate summary. Unlike `fun fuzz <file.fn> <target>`'s open-ended
// single-target run, this form exists for a CI-style "did anything
// regress" sweep across a whole project, so every target gets the same
// short, bounded budget rather than running indefinitely.
pub fun run_fuzz_suite(
  str root,
  flag debug_info,
  flag warn_unused,
  flag warn_unused_lenient,
  Vec<Define>* extra_defines
) num {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);
  files.sort();

  num budget = _fuzz_budget_seconds();
  num ran = 0;
  num failed = 0;
  num fi = 0;
  for fi < files.len {
    str path = files.get(fi);
    fi = fi + 1;
    if !_declares_top_level_block(path, "fuzz") {
      continue;
    }
    Vec<str> targets = _collect_fuzz_targets(path);
    defer targets.free();

    num ti = 0;
    for ti < targets.len {
      str target = targets.get(ti);
      ti = ti + 1;

      println(format("== {str} :: {str} ({num}s) ==", path, target, budget));

      Vec<Define> defines = resolved_defines(extra_defines);
      defer defines.free();

      str c_path = default_c_path(path, ".fuzz.c");
      let lowered = compile_to_c_mode(
        path,
        c_path,
        &defines,
        false,
        warn_unused,
        true,
        target,
        debug_info,
        warn_unused_lenient
      );
      if lowered.is_err() {
        writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
        failed = failed + 1;
        ran = ran + 1;
        continue;
      }

      str exe = default_exe_path(path, ".fuzz");
      let cc_code = compile_c_to_fuzz_exe(c_path, exe, debug_info);
      remove_file(c_path);
      if cc_code != 0 {
        failed = failed + 1;
        ran = ran + 1;
        continue;
      }

      Vec<str> argv_args;
      argv_args.init(0);
      defer argv_args.free();
      argv_args.push(executable_path(exe));
      str[] argv = argv_from(&argv_args);
      FuzzRunResult result = _run_fuzz_bounded(argv, budget);
      free_argv(argv);
      remove_file(exe);

      // A watchdog kill just means the budget ran out with nothing found,
      // the expected, successful outcome of a bounded sweep, not a
      // crash. Only an exit code the process reached on its own reflects
      // a real result.
      if !result.killed_by_budget && result.exit_code != 0 {
        failed = failed + 1;
      }
      ran = ran + 1;
    }
  }

  if ran == 0 {
    println(format("no `fuzz` targets found under {str}", dir));
    ret 0;
  }

  println(format("\n{num}/{num} fuzz targets clean", ran - failed, ran));
  if failed > 0 {
    ret 1;
  }
  ret 0;
}

// True when `path` declares at least one top level `keyword "name" {`/`(`
// block (`keyword` is `"test"` or `"fuzz"`). Shared scan behind
// `run_test_suite` and `run_fuzz_suite`'s own filters.
fun _declares_top_level_block(str path, str keyword) flag {
  if !exists(path) {
    ret false;
  }
  str src = read_to_string(path);
  let lexed = tokenize(src, path);
  if lexed.is_err() {
    ret false;
  }
  Vec<Token> tokens = lexed.unwrap();
  // Deep: returns a plain `flag`, nothing aliasing these tokens' own
  // strings escapes this function.
  defer free_token_vec(&tokens);

  num i = 0;
  for i + 1 < tokens.len {
    Token t = tokens.get(i);
    i = i + 1;
    if t.type != .Keyword || !equals(token_text(t), keyword) {
      continue;
    }
    if tokens.get(i).type == .String {
      ret true;
    }
  }
  ret false;
}

// Parses `input` and prints its own top-level nodes as a plain-text
// tree (`-ast`). Errors are swallowed: this is a best-effort look at
// the shape of a program, not itself the reason a compile fails.
pub fun print_ast_for(str input) {
  let parsed = parse_program_with_imports(input);
  if parsed.is_err() {
    ret;
  }
  let merged = parsed.unwrap();
  print_ast(&merged.entry_nodes);
}

// Formats `path` in place, reporting whether the file changed. A file
// that is already formatted is left untouched, so its timestamp only
// moves when its contents do.
pub fun format_file(str path) Result<flag, str> {
  if !exists(path) {
    ret .Err(format("no such file: {str}", path));
  }
  str src = read_to_string(path);
  str out = format_source(src, path)!;
  if equals(out, src) {
    ret .Ok(false);
  }
  if !write_string(path, out) {
    ret .Err(format("could not write {str}", path));
  }
  ret .Ok(true);
}

// True when `path` is already formatted.
pub fun format_file_is_clean(str path) flag {
  if !exists(path) {
    ret false;
  }
  str src = read_to_string(path);
  let formatted = format_source(src, path);
  if formatted.is_err() {
    ret false;
  }
  ret equals(formatted.unwrap(), src);
}

// The dotted paths that `src` imports, in the order they are written.
fun _imported_paths(str src, str filename) Vec<str> {
  Vec<str> out;
  out.init(0);
  let lexed = tokenize(src, filename);
  if lexed.is_err() {
    ret out;
  }
  Vec<Token> tokens = lexed.unwrap();
  // Deep: every path pushed to `out` below is a fresh StringBuilder
  // copy (`b.build()`), never a token's own `Sval` directly, so
  // nothing in the returned `Vec<str>` aliases these tokens.
  defer free_token_vec(&tokens);

  num i = 0;
  for i < tokens.len {
    Token t = tokens.get(i);
    if t.type != .Keyword || !equals(token_text(t), "use") {
      i = i + 1;
      continue;
    }
    StringBuilder b = string_builder_init(32);
    num j = i + 1;
    for j < tokens.len {
      Token it = tokens.get(j);
      if it.type == .NewLine || it.type == .Comment {
        j = j + 1;
        continue;
      }
      str text = token_text(it);
      if equals(text, ";") {
        break;
      }
      // An alias renames the import; the path is what precedes it.
      if it.type == .Keyword && equals(text, "as") {
        break;
      }
      b.append(text);
      j = j + 1;
    }
    str path = b.build();
    if !equals(path, "") {
      out.push(path);
    }
    i = j + 1;
  }
  ret out;
}

// Formats `path` and every module it imports, directly or not, leaving
// the stdlib alone. Reports how many files changed.
pub fun format_file_and_imports(str path) Result<num, str> {
  Vec<str> queue;
  queue.init(4);
  defer queue.free();
  queue.push(path);

  Set<str> seen = set_init("", 8);
  defer seen.free();

  num changed = 0;
  num i = 0;
  for i < queue.len {
    str current = queue.get(i);
    i = i + 1;
    if seen.has(current) {
      continue;
    }
    seen.add(current);

    if format_file(current)! {
      changed = changed + 1;
    }

    Vec<str> imports = _imported_paths(read_to_string(current), current);
    defer imports.free();
    num k = 0;
    for k < imports.len {
      str dotted = imports.get(k);
      k = k + 1;
      // The stdlib ships formatted and is not the caller's to rewrite.
      if starts_with(dotted, "std.") {
        continue;
      }
      str resolved = resolve_import_path(current, dotted);
      if exists(resolved) {
        queue.push(resolved);
      }
    }
  }
  ret .Ok(changed);
}

// Directories that hold generated or vendored files, which are not the
// project's own source.
fun _skip_scan_dir(str name) flag {
  fit name {
    ".git", ".funsand", "fun-out", "build", "node_modules" -> { ret true; }
    _ -> { ret false; }
  }
}

fun _collect_fun_files(str dir, Vec<str>* out) {
  let listed = list_dir(dir);
  if listed.is_err() {
    ret;
  }
  Vec<str> entries = listed.unwrap();
  defer entries.free();
  entries.sort();

  num i = 0;
  for i < entries.len {
    str name = entries.get(i);
    i = i + 1;
    str full = path_join(dir, name);
    if is_dir(full) {
      if !_skip_scan_dir(name) {
        _collect_fun_files(full, out);
      }
      continue;
    }
    if ends_with(name, ".fn") {
      out.push(full);
    }
  }
}

// One warning found by `fun lint`, with the file it was found in.
pub compound LintFinding {
  str file;
  str id;
  str message;
  flag has_pos;
  num line;
  num col;
}

// Everything `fun lint` learned about a tree: the warnings, the files it
// could not analyze (with why), and how many files it looked at.
pub compound LintOutcome {
  Vec<LintFinding> findings;
  Vec<str> failures;
  num files;
}

fun _lint_outcome_new() LintOutcome {
  LintOutcome o;
  o.findings.init(16);
  o.failures.init(0);
  o.files = 0;
  ret o;
}

// Analyzes one file the way `-warn-unused` does, without typechecking or
// building it: parse with its imports, expand aliases, then read the
// warnings off the file's own declarations.
fun _lint_file(str file, LintOutcome* out) {
  let parsed = parse_program_with_imports(file);
  if parsed.is_err() {
    out.failures.push(format("{str}: error: {str}", file, parsed.unwrap_err()));
    ret;
  }
  let merged = parsed.unwrap();
  let alias_err = expand_type_aliases(&merged.nodes);
  if alias_err.is_some() {
    out.failures.push(format("{str}: error: {str}", file, alias_err.unwrap()));
    ret;
  }
  sync_type_alias_usage(&merged.nodes, &merged.entry_nodes);
  let noticed = analyze(&merged.entry_nodes, &merged.nodes, true, file);
  if noticed.is_err() {
    UnmetExpectation ue = noticed.unwrap_err();
    str where = file;
    if ue.has_pos {
      where = format("{str}:{num}:{num}", ue.pos.filename, ue.pos.line, ue.pos.col);
    }
    out.failures.push(format("{str}: error: {str}", where, ue.message));
    ret;
  }
  Vec<Warning> warnings = noticed.unwrap();
  defer warnings.free();
  num i = 0;
  for i < warnings.len {
    Warning w = warnings.get(i);
    i = i + 1;
    LintFinding f;
    f.file = file;
    f.id = warning_id_name(w.id);
    f.message = w.message;
    f.has_pos = w.has_pos;
    f.line = 0;
    f.col = 0;
    if w.has_pos {
      f.line = w.pos.line;
      f.col = w.pos.col;
      if !equals(w.pos.filename, "") {
        f.file = w.pos.filename;
      }
    }
    out.findings.push(f);
  }
}

// True when `path` sits inside a directory named `fixtures` (or ending in
// `_fixtures`): test inputs that are deliberately odd, which a scan of a
// tree leaves out. Compares whole directory names, on either separator.
fun _in_fixtures_dir(str path) flag {
  Vec<str> parts = split(replace_char(path, '\\', '/'), '/');
  defer parts.free();
  num i = 0;
  for i + 1 < parts.len {
    str part = parts.get(i);
    if equals(part, "fixtures") || ends_with(part, "_fixtures") {
      ret true;
    }
    i = i + 1;
  }
  ret false;
}

// Lints every `.fn` file under `root`, which may name a directory or one
// file, leaving out anything inside a `fixtures` directory when scanning
// a directory (a file named directly is always linted). Errs only when
// `root` names neither.
pub fun lint_paths(str root) Result<LintOutcome, str> {
  str target = root;
  if equals(target, "") {
    target = ".";
  }
  Vec<str> files;
  files.init(16);
  defer files.free();
  if is_dir(target) {
    Vec<str> found;
    found.init(16);
    defer found.free();
    _collect_fun_files(target, &found);
    for path : found {
      if !_in_fixtures_dir(path) {
        files.push(path);
      }
    }
  } elif ends_with(target, ".fn") && exists(target) {
    files.push(target);
  } else {
    ret .Err(format("no such file or directory: {str}", target));
  }
  LintOutcome out = _lint_outcome_new();
  out.files = files.len;
  num i = 0;
  for i < files.len {
    _lint_file(files.get(i), &out);
    i = i + 1;
  }
  ret .Ok(out);
}

// Adds one to `key`'s count in the parallel `names`/`counts` lists,
// starting it at one when it is new.
fun _bump_count(Vec<str>* names, Vec<num>* counts, str key) {
  num i = 0;
  for i < names.len {
    if equals(names.get(i), key) {
      counts.set(i, counts.get(i) + 1);
      ret;
    }
    i = i + 1;
  }
  names.push(key);
  counts.push(1);
}

// Orders the parallel lists by count, largest first, keeping ties in the
// order they were first seen.
fun _sort_counts_desc(Vec<str>* names, Vec<num>* counts) {
  num i = 1;
  for i < names.len {
    str name = names.get(i);
    num count = counts.get(i);
    num j = i - 1;
    for j >= 0 && counts.get(j) < count {
      names.set(j + 1, names.get(j));
      counts.set(j + 1, counts.get(j));
      j = j - 1;
    }
    names.set(j + 1, name);
    counts.set(j + 1, count);
    i = i + 1;
  }
}

// "1 warning", "2 warnings".
fun _counted(num n, str one, str many) str {
  if n == 1 {
    ret format("{num} {str}", n, one);
  }
  ret format("{num} {str}", n, many);
}

// `fun lint`: reports every warning under `root`, then totals by warning
// id and by file. Exits 1 when there is anything to report, so it can gate
// a build the way `-fmt-check-all` does.
pub fun run_lint(str root, flag summary_only) num {
  let linted = lint_paths(root);
  if linted.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", linted.unwrap_err()));
    ret 1;
  }
  LintOutcome outcome = linted.unwrap();
  defer outcome.findings.free();
  defer outcome.failures.free();

  if !summary_only {
    num fi = 0;
    for fi < outcome.findings.len {
      LintFinding f = outcome.findings.get(fi);
      fi = fi + 1;
      if f.has_pos {
        println(format("{str}:{num}:{num}: warning[{str}]: {str}", f.file, f.line, f.col, f.id, f.message));
      } else {
        println(format("{str}: warning[{str}]: {str}", f.file, f.id, f.message));
      }
    }
  }
  num ei = 0;
  for ei < outcome.failures.len {
    writeln_to(Sink.Stderr, outcome.failures.get(ei));
    ei = ei + 1;
  }

  Vec<str> kinds;
  kinds.init(8);
  defer kinds.free();
  Vec<num> kind_counts;
  kind_counts.init(8);
  defer kind_counts.free();
  Vec<str> with_findings;
  with_findings.init(8);
  defer with_findings.free();
  Vec<num> file_counts;
  file_counts.init(8);
  defer file_counts.free();
  num si = 0;
  for si < outcome.findings.len {
    LintFinding f = outcome.findings.get(si);
    si = si + 1;
    _bump_count(&kinds, &kind_counts, f.id);
    _bump_count(&with_findings, &file_counts, f.file);
  }
  _sort_counts_desc(&kinds, &kind_counts);
  _sort_counts_desc(&with_findings, &file_counts);

  if outcome.findings.len > 0 {
    println("");
    println("Warnings by kind:");
    num ki = 0;
    for ki < kinds.len {
      println(format("  {str}  {num}", kinds.get(ki), kind_counts.get(ki)));
      ki = ki + 1;
    }
    println("Files with warnings:");
    num wi = 0;
    for wi < with_findings.len {
      println(format("  {str}  {num}", with_findings.get(wi), file_counts.get(wi)));
      wi = wi + 1;
    }
    println(format(
      "{str} in {num} of {str}",
      _counted(outcome.findings.len, "warning", "warnings"),
      with_findings.len,
      _counted(outcome.files, "file", "files")
    ));
  } else {
    println(format("No warnings in {str}", _counted(outcome.files, "file", "files")));
  }
  if outcome.failures.len > 0 {
    println(format(
      "{str} could not be analyzed",
      _counted(outcome.failures.len, "file", "files")
    ));
  }
  if outcome.findings.len > 0 || outcome.failures.len > 0 {
    ret 1;
  }
  ret 0;
}

// The unformatted `.fn` files under `root`, which may name a directory
// or a file whose directory is scanned instead.
pub fun collect_unformatted(str root) Vec<str> {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  } elif !is_dir(dir) {
    dir = dirname(dir);
    if equals(dir, "") {
      dir = ".";
    }
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);

  Vec<str> out;
  out.init(0);
  num i = 0;
  for i < files.len {
    str path = files.get(i);
    i = i + 1;
    if !format_file_is_clean(path) {
      out.push(path);
    }
  }
  ret out;
}

test "lists the modules a file imports, aliases and stdlib included" {
  str src = `use sub.helper;
  `use std.io as out;
  `
  `fun main() num {
  `  ret 0;
  `}`;
  Vec<str> found = _imported_paths(src, "main.fn");
  defer found.free();
  assert found.len == 2, "expected both imports to be listed";
  assert equals(found.get(0), "sub.helper"), "expected the local import first";
  assert equals(found.get(1), "std.io"), "expected the alias dropped from the path";
}

test "formatting reports a change only when the file is rewritten" {
  make_dir_all("fun-out");
  str path = "fun-out/_fmt_probe.fn";
  write_string(path, "fun probe() num{ret 1;}\n");
  defer remove_file(path);

  let first = format_file(path);
  assert first.is_ok(), "expected the file to format";
  assert first.unwrap(), "expected the unformatted file to change";
  assert format_file_is_clean(path), "expected the file to be formatted now";

  let second = format_file(path);
  assert second.is_ok(), "expected the formatted file to format again";
  assert !second.unwrap(), "expected no second rewrite";
}

test "an unformatted file is reported by a scan of its directory" {
  make_dir_all("fun-out/_fmt_scan");
  str path = "fun-out/_fmt_scan/dirty.fn";
  write_string(path, "fun dirty() num{ret 1;}\n");
  defer remove_file(path);

  Vec<str> offenders = collect_unformatted("fun-out/_fmt_scan");
  defer offenders.free();
  assert offenders.len == 1, "expected the unformatted file to be reported";
  assert ends_with(offenders.get(0), "dirty.fn"), "expected the offender's path";
}

test "lint reports a warning per finding across a tree and counts the files it looked at" {
  make_dir_all("fun-out/_lint_scan/sub");
  str dirty = "fun-out/_lint_scan/dirty.fn";
  str nested = "fun-out/_lint_scan/sub/nested.fn";
  str clean = "fun-out/_lint_scan/clean.fn";
  write_string(dirty, "fun main() num {\n  num unused = 1;\n  ret 0;\n}\n");
  write_string(nested, "fun main() num {\n  num also_unused = 2;\n  ret 0;\n}\n");
  write_string(clean, "fun main() num {\n  ret 0;\n}\n");
  defer remove_file(dirty);
  defer remove_file(nested);
  defer remove_file(clean);

  let linted = lint_paths("fun-out/_lint_scan");
  assert linted.is_ok(), "expected the tree to lint";
  LintOutcome outcome = linted.unwrap();
  defer outcome.findings.free();
  defer outcome.failures.free();
  assert outcome.files == 3, "expected every .fn file under the root, nested ones included";
  assert outcome.findings.len == 2, "expected one warning from each of the two files that have one";
  assert outcome.failures.len == 0, "expected nothing that could not be analyzed";
  LintFinding first = outcome.findings.get(0);
  assert equals(first.id, "unused_variable"), "expected the warning's own id";
  assert first.has_pos && first.line == 2, "expected the warning's own position";
}

test "lint reports a file that does not parse instead of stopping" {
  make_dir_all("fun-out/_lint_bad");
  str broken = "fun-out/_lint_bad/broken.fn";
  str fine = "fun-out/_lint_bad/fine.fn";
  write_string(broken, "fun main( {\n");
  write_string(fine, "fun main() num {\n  num unused = 1;\n  ret 0;\n}\n");
  defer remove_file(broken);
  defer remove_file(fine);

  let linted = lint_paths("fun-out/_lint_bad");
  assert linted.is_ok(), "expected the tree to lint";
  LintOutcome outcome = linted.unwrap();
  defer outcome.findings.free();
  defer outcome.failures.free();
  assert outcome.failures.len == 1, "expected the broken file to be reported as unanalyzable";
  assert contains(outcome.failures.get(0), "broken.fn"), "expected the failure to name its file";
  assert outcome.findings.len == 1, "expected the good file's warning still found";
}

test "lint of a single file reports just that file, and a missing path is an error" {
  make_dir_all("fun-out/_lint_one");
  str only = "fun-out/_lint_one/only.fn";
  write_string(only, "fun main() num {\n  num unused = 1;\n  ret 0;\n}\n");
  defer remove_file(only);

  let linted = lint_paths(only);
  assert linted.is_ok(), "expected a single file to lint";
  LintOutcome outcome = linted.unwrap();
  defer outcome.findings.free();
  defer outcome.failures.free();
  assert outcome.files == 1, "expected exactly the named file";

  assert lint_paths("fun-out/_lint_one/missing.fn").is_err(), "expected a missing file to be an error";
}

test "the counts are ordered largest first, ties in first-seen order" {
  Vec<str> names;
  names.init(4);
  defer names.free();
  Vec<num> counts;
  counts.init(4);
  defer counts.free();
  _bump_count(&names, &counts, "a");
  _bump_count(&names, &counts, "b");
  _bump_count(&names, &counts, "b");
  _bump_count(&names, &counts, "c");
  _bump_count(&names, &counts, "b");
  _bump_count(&names, &counts, "c");
  _sort_counts_desc(&names, &counts);
  assert equals(names.get(0), "b") && counts.get(0) == 3, "expected the most frequent first";
  assert equals(names.get(1), "c") && counts.get(1) == 2, "expected the next most frequent second";
  assert equals(names.get(2), "a") && counts.get(2) == 1, "expected the rarest last";
}

test "parses the lint subcommand with a path and -summary" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("lint");
  a.push("src");
  a.push("-summary");
  let o = parse_args(_argv(&a));
  assert !o.has_error, "expected the arguments to parse";
  assert equals(o.subcommand, "lint"), "expected the lint subcommand";
  assert equals(o.input, "src"), "expected the path as the input";
  assert o.lint_summary, "expected -summary to be set";
}

test "lint leaves out fixtures directories when scanning, but lints a fixture named directly" {
  make_dir_all("fun-out/_lint_fx/sub_fixtures");
  make_dir_all("fun-out/_lint_fx/fixtures");
  make_dir_all("fun-out/_lint_fx/real");
  str a = "fun-out/_lint_fx/sub_fixtures/a.fn";
  str b = "fun-out/_lint_fx/fixtures/b.fn";
  str c = "fun-out/_lint_fx/real/c.fn";
  str body = "fun main() num {\n  num unused = 1;\n  ret 0;\n}\n";
  write_string(a, body);
  write_string(b, body);
  write_string(c, body);
  defer remove_file(a);
  defer remove_file(b);
  defer remove_file(c);

  let scanned = lint_paths("fun-out/_lint_fx");
  assert scanned.is_ok(), "expected the tree to lint";
  LintOutcome outcome = scanned.unwrap();
  defer outcome.findings.free();
  defer outcome.failures.free();
  assert outcome.files == 1, "expected only the file outside every fixtures directory";

  let direct = lint_paths(b);
  assert direct.is_ok(), "expected a fixture named directly to lint";
  LintOutcome named = direct.unwrap();
  defer named.findings.free();
  defer named.failures.free();
  assert named.files == 1 && named.findings.len == 1, "expected the named fixture linted regardless";

  assert _in_fixtures_dir("src/tests/fixtures/x.fn"), "expected a fixtures directory recognized";
  assert _in_fixtures_dir("src\\parser\\import_resolver_fixtures\\x.fn"), "expected a *_fixtures directory recognized on backslashes";
  assert !_in_fixtures_dir("src/fixtures_helper.fn"), "expected a file merely named like fixtures kept";
  assert !_in_fixtures_dir("fixtures"), "expected the last component, a file or leaf, not counted as a directory";
}
