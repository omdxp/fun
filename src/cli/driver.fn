}

test "with_extension replaces an existing extension" {
  assert equals(with_extension("main.fn", ".c"), "main.c"), "expected the extension replaced";
  assert equals(with_extension("src/main.fn", ".c"), "src/main.c"), "expected the directory kept";
}

test "with_extension appends when there is none" {
  assert equals(with_extension("main", ".c"), "main.c"), "expected the extension appended";
}

test "with_extension ignores a dot in a parent directory" {
  assert equals(with_extension("a.b/main", ".c"), "a.b/main.c"), "expected only the file's own name to matter";
}

test "executable_path qualifies a bare name" {
  assert equals(executable_path("prog"), "./prog"), "expected a bare name to be qualified";
}

test "executable_path leaves a path alone" {
  assert equals(executable_path("./prog"), "./prog"), "expected an explicit path to be kept";
  assert equals(executable_path("build/prog"), "build/prog"), "expected a directory path to be kept";
}

test "with_extension handles a windows-style path" {
  assert equals(with_extension("src\\main.fn", ".c"), "src\\main.c"), "expected a backslash path to keep its directory";
}

test "the msvc compiler is recognized by name" {
  assert compiler_is_msvc("cl"), "expected cl to be msvc";
  assert compiler_is_msvc("cl.exe"), "expected cl.exe to be msvc";
  assert !compiler_is_msvc("cc"), "expected cc to be gcc-style";
  assert !compiler_is_msvc("/usr/bin/gcc"), "expected gcc to be gcc-style";
}

test "resolve_c_compiler honors FUN_CC verbatim" {
  set_env("FUN_CC", "some-made-up-cc");
  assert equals(resolve_c_compiler(), "some-made-up-cc"), "expected the exact override, unresolved against PATH";
  clear_env("FUN_CC");
}

// Regression test: `cg.msvc_mode` used to come from `c_compiler()`'s own
// hardcoded platform guess ("cl" on Windows), a DIFFERENT decision than
// `compile_c_to_exe`'s own candidate search (clang tried first, and
// normally present even on Windows) actually uses to pick a compiler -
// silently mismatching codegen's emitted C shape against the compiler
// that would actually receive it, on any machine where clang exists but
// isn't literally named "cl". `resolve_c_compiler` runs that same
// search itself, so it can never name a compiler `compile_c_to_exe`
// wouldn't also pick.
test "resolve_c_compiler finds a real compiler on PATH, not just a platform guess" {
  clear_env("FUN_CC");
  let resolved = resolve_c_compiler();
  assert !equals(resolved, ""), "expected some compiler to resolve on this machine";
}

// Reads `./fun.toml` and fills in whatever it left implicit.
pub fun load_manifest() Result<Manifest, str> {
  if !exists("fun.toml") {
    ret .Err("no fun.toml in this directory");
  }
  Manifest m = parse_manifest(read_to_string("fun.toml"))!;
  resolve_targets(&m, "");
  ret .Ok(m);
}

// Compiles every target the manifest declares, writing executables to
// `fun-out/bin`. A library has no entry point, so it is compiled to an
// object under `fun-out/lib` to prove it builds, never linked.
pub fun build_project(bin debug_info, Vec<Define>* extra_defines) num {
  let loaded = load_manifest();
  if loaded.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", loaded.unwrap_err()));
    ret 1;
  }
  Manifest m = loaded.unwrap();
  defer m.free();

  if m.kind() == .Empty {
    writeln_to(
      Sink.Stderr,
      format("[Error]\npackage `{str}` declares no [lib] or [[exe]] target", m.package_name)
    );
    ret 1;
  }

  // Re-reads and re-parses fun.toml a second time (already loaded as
  // `m` above, needed for `m.kind()`/`m.has_lib`/... below) rather than
  // hand-merging `-D` in again here - `fun build` isn't a hot path, and
  // reusing the one shared merge point matters more than the extra read.
  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  if m.has_lib {
    make_dir_all("fun-out/lib");
    str c_path = path_join("fun-out/lib", format("{str}.c", m.lib.name));
    let lowered = compile_to_c(m.lib.path, c_path, &defines, debug_info);
    if lowered.is_err() {
      writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
      ret 1;
    }
    let code = compile_c_to_object(c_path, path_join("fun-out/lib", format("{str}.o", m.lib.name)));
    if code != 0 {
      ret 1;
    }
    println(format("checked {str}", m.lib.name));
  }

  num i = 0;
  for i < m.exes.len {
    ExeTarget* e = &m.exes.data[i];
    make_dir_all("fun-out/bin");
    str c_path = path_join("fun-out/bin", format("{str}.c", e.name));
    let lowered = compile_to_c(e.path, c_path, &defines, debug_info);
    if lowered.is_err() {
      writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
      ret 1;
    }
    str exe = path_join("fun-out/bin", format("{str}{str}", e.name, exe_suffix()));
    let code = compile_c_to_exe(c_path, exe, debug_info);
    if code != 0 {
      ret 1;
    }
    println(format("built {str} -> {str}", e.name, exe));
    i = i + 1;
  }
  ret 0;
}

// The starter `src/main.fn` an `init`ed executable target gets.
fun _init_main_source() str {
  ret `imp std.io;
  `
  `fun main(str[] args) {
  `  println("Hello, World!");
  `}`;
}

// The starter `src/lib.fn` an `init`ed library target gets.
fun _init_lib_source() str {
  ret `pub fun hello() str {
  `  ret "Hello, World!";
  `}`;
}

// The starter `.gitignore` an `init`ed project gets.
fun _init_gitignore_source() str {
  ret `/fun-out/`;
}

// `fun init [lib|exe|mix]`: writes a `fun.toml`, a `src/` directory, and
// a `.gitignore` for a new package in the working directory. `kind` is
// one of `lib`, `exe`, or `mix`; empty defaults to `exe`.
pub fun init_project(str kind) num {
  str resolved_kind = kind;
  if equals(resolved_kind, "") {
    resolved_kind = "exe";
  }
  bin wants_lib = equals(resolved_kind, "lib") || equals(resolved_kind, "mix");
  bin wants_exe = equals(resolved_kind, "exe") || equals(resolved_kind, "mix");
  if !wants_lib && !wants_exe {
    writeln_to(
      Sink.Stderr,
      format(
      "[Error]\nunknown project kind `{str}` (expected `lib`, `exe`, or `mix`)",
      resolved_kind
      )
    );
    ret 1;
  }
  if exists("fun.toml") {
    writeln_to(Sink.Stderr, "[Error]\nfun.toml already exists in this directory");
    ret 1;
  }

  str name = "app";

  let made_dir = make_dir_all("src");
  if made_dir.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", made_dir.unwrap_err().message));
    ret 1;
  }

  StringBuilder toml = string_builder_init(64);
  toml.append(format("[package]\nname = \"{str}\"\nversion = \"0.1.0\"\n", name));

  if wants_lib {
    toml.append("\n[lib]\npath = \"src/lib.fn\"\n");
    write_string("src/lib.fn", _init_lib_source());
    println("created src/lib.fn");
  }
  if wants_exe {
    toml.append(format("\n[[exe]]\nname = \"{str}\"\npath = \"src/main.fn\"\n", name));
    write_string("src/main.fn", _init_main_source());
    println("created src/main.fn");
  }

  write_string("fun.toml", toml.build());
  println("created fun.toml");

  if !exists(".gitignore") {
    write_string(".gitignore", _init_gitignore_source());
    println("created .gitignore");
  }
  ret 0;
}

// The full set of build-time constants a program compiles with: this
// workspace's own `PACKAGE_NAME`/`PACKAGE_VERSION` when a `fun.toml`
// exists here, plus whatever `-D name=value` the caller supplied
// directly. Shared so every entry point (a plain compile, `-test`,
// `-fuzz`, and both directory-suite forms) offers the same constants,
// rather than each seeing only its own half: the plain compile path
// only ever saw `-D`, `-test`/`-fuzz` only ever saw the manifest's own.
pub fun resolved_defines(Vec<Define>* extra) Vec<Define> {
  Vec<Define> out;
  out.init(extra.len + 2);
  if exists("fun.toml") {
    let loaded = load_manifest();
    if loaded.is_ok() {
      Manifest m = loaded.unwrap();
      let manifest_ones = manifest_defines(&m);
      num mi = 0;
      for mi < manifest_ones.len {
        out.push(manifest_ones.get(mi));
        mi = mi + 1;
      }
      manifest_ones.free();
    }
  }
  num ei = 0;
  for ei < extra.len {
    out.push(extra.get(ei));
    ei = ei + 1;
  }
  ret out;
}

// Compiles `input` with its test blocks and runs them, passing `args` on
// so a single test can be named. Returns the runner's exit code.
// `no_exec` stops right after writing the C (to `out_override` when
// given, the default `.test.c` path otherwise) - the artifact a caller
// wanting to compile and debug it themselves asked for (the vscode
// extension's own Debug Test command does exactly this) - rather than
// this function's own compile-run-delete cycle silently overriding it.
pub fun run_tests(
  str input,
  Vec<str>* args,
  bin debug_info,
  bin no_exec,
  str out_override,
  bin warn_unused,
  bin warn_unused_lenient,
  bin keep_c,
  Vec<Define>* extra_defines
) num {
  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  str c_path = out_override;
  if equals(c_path, "") {
    c_path = default_c_path(input, ".test.c");
  }
  let lowered = compile_to_c_mode(
    input,
    c_path,
    &defines,
    true,
    warn_unused,
    false,
    "",
    debug_info,
    warn_unused_lenient
  );
  if lowered.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
    ret 1;
  }

  if no_exec {
    ret 0;
  }

  str exe = default_exe_path(input, ".test");
  let cc_code = compile_c_to_exe(c_path, exe, debug_info);
  if !keep_c {
    remove_file(c_path);
  }
  if cc_code != 0 {
    ret 1;
  }

  let code = run_exe(exe, args);
  remove_file(exe);
  ret code;
}

// Compiles `input`'s `target` fuzz harness (or, when `target` is empty,
// the file's own single declared target) and runs it, passing `args` on
// (a caller wanting a bounded run passes libFuzzer flags like
// `-max_total_time=30` here). Returns the harness's own exit code.
// `no_exec`/`out_override`: see `run_tests`'s own doc comment - the
// same gap applied here identically.
pub fun run_fuzz(
  str input,
  str target,
  Vec<str>* args,
  bin debug_info,
  bin no_exec,
  str out_override,
  bin warn_unused,
  bin warn_unused_lenient,
  bin keep_c,
  Vec<Define>* extra_defines
) num {
  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  str c_path = out_override;
  if equals(c_path, "") {
    c_path = default_c_path(input, ".fuzz.c");
  }
  let lowered = compile_to_c_mode(
    input,
    c_path,
    &defines,
    false,
    warn_unused,
    true,
    target,
    debug_info,
    warn_unused_lenient
  );
  if lowered.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
    ret 1;
  }

  if no_exec {
    ret 0;
  }

  str exe = default_exe_path(input, ".fuzz");
  let cc_code = compile_c_to_fuzz_exe(c_path, exe, debug_info);
  if !keep_c {
    remove_file(c_path);
  }
  if cc_code != 0 {
    ret 1;
  }

  let code = run_exe(exe, args);
  remove_file(exe);
  ret code;
}

compound SuiteTestResult {
  num exit_code;
  str captured;
}

// Like run_tests but captures the test binary's stdout instead of inheriting
// it, so run_test_suite can decide what to display. Compile output still goes
// to stderr when a compiler is explicitly set via FUN_CC.
fun _run_tests_captured(
  str input,
  bin debug_info,
  bin warn_unused,
  bin warn_unused_lenient,
  Vec<Define>* extra_defines
) SuiteTestResult {
  SuiteTestResult bad;
  bad.exit_code = 1;
  bad.captured = "";

  Vec<Define> defines = resolved_defines(extra_defines);
  defer defines.free();

  str c_path = default_c_path(input, ".test.c");
  let lowered = compile_to_c_mode(
    input,
    c_path,
    &defines,
    true,
    warn_unused,
    false,
    "",
    debug_info,
    warn_unused_lenient
  );
  if lowered.is_err() {
    bad.captured = format("[Error]\n{str}", lowered.unwrap_err());
    ret bad;
  }

  str exe = default_exe_path(input, ".test");
  let cc_code = compile_c_to_exe(c_path, exe, debug_info);
  remove_file(c_path);
  if cc_code != 0 {
    bad.captured = "C compiler returned non-zero";
    ret bad;
  }

  Vec<str> argv_args;
  argv_args.init(1);
  defer argv_args.free();
  argv_args.push(executable_path(exe));
  str[] argv = argv_from(&argv_args);
  let result = run(argv);
  free_argv(argv);
  remove_file(exe);

  if result.is_err() {
    bad.captured = "could not run test binary";
    ret bad;
  }
  ProcessResult r = result.unwrap();
  SuiteTestResult ok;
  ok.exit_code = r.exit_code;
  ok.captured = r.stdout_text;
  ret ok;
}

// `fun test <dir>`/`fun test` (no path): discovers every `.fn` file under
// `root` that declares a `test` block, runs each with `_run_tests_captured`,
// and prints an aggregate pass/fail summary. Passing files flicker on a
// single overwritten line; failing files show their full captured output and
// are listed again in the summary at the end. Every file gets its own compile
// pass and its own process for the compiled binary, so one file's failure or
// crash can't take the rest of the run down with it.
pub fun run_test_suite(
  str root,
  bin debug_info,
  bin warn_unused,
  bin warn_unused_lenient,
  Vec<Define>* extra_defines
) num {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);
  files.sort();

  Vec<str> failed_files;
  failed_files.init(4);
  defer failed_files.free();

  num passed = 0;
  num failed = 0;
  num i = 0;
  for i < files.len {
    str path = files.get(i);
    i = i + 1;
    if !_declares_top_level_block(path, "test") {
      continue;
    }
    // Show which file is being compiled/run; \r lets a pass overwrite this line.
    print(format("\r  running {str}  ", path));
    let res = _run_tests_captured(path, debug_info, warn_unused, warn_unused_lenient, extra_defines);
    if res.exit_code == 0 {
      passed = passed + 1;
      num n = count(res.captured, " ... PASS");
      println(format("\r  ok  {str}  ({num} tests)  ", path, n));
    } else {
      failed = failed + 1;
      println(format("\r  FAIL  {str}", path));
      print(res.captured);
      failed_files.push(path);
    }
  }

  if passed + failed == 0 {
    println(format("no `test` blocks found under {str}", dir));
    ret 0;
  }

  println(format("\n{num}/{num} test files passed", passed, passed + failed));
  if failed > 0 {
    println("\nFailed:");
    num j = 0;
    for j < failed_files.len {
      println(format("  {str}", failed_files.get(j)));
      j = j + 1;
    }
    ret 1;
  }
  ret 0;
}

// Default wall-clock budget (seconds) for one fuzz target when running
// the directory-wide `fun fuzz [path]` form, where multiple targets
// across possibly multiple files each get their own bounded run rather
// than the open-ended campaign a single `fun fuzz <file.fn> <target>`
// normally leaves to the caller. Override with `FUN_FUZZ_DEFAULT_SECONDS`.
const num default_fuzz_seconds = 30;

fun _fuzz_budget_seconds() num {
  str override_s = env_or("FUN_FUZZ_DEFAULT_SECONDS", "");
  if equals(override_s, "") {
    ret default_fuzz_seconds;
  }
  num parsed = atoi(override_s);
  if parsed <= 0 {
    ret default_fuzz_seconds;
  }
  ret parsed;
}

// Shared state between `_fuzz_watchdog` and the thread waiting on the
// harness process. `mu` guards `done`/`killed`; both flip only once, from
// false to true, so a stale read just means the watchdog checks again a
// second later rather than reads garbage.
compound FuzzWatch {
  num pid;
  num budget_seconds;
  Mutex mu;
  bin done;
  bin killed;
}

// Sleeps up to `budget_seconds`, checking once a second whether the
// harness has already finished on its own, and force-kills it if it's
// still running when the budget runs out. Runs as its own virtual thread
// alongside the thread blocked in `wait_exit_code`, matching the
// reference compiler's own watchdog for the same reason: libFuzzer's own
// `-max_total_time` flag isn't reliable in every environment, so the
// budget can't depend on the fuzzing engine honoring it alone.
async fun _fuzz_watchdog(FuzzWatch* w, WaitGroup* wg) {
  num slept = 0;
  for slept < w.budget_seconds {
    w.mu.lock();
    bin d = w.done;
    w.mu.unlock();
    if d {
      break;
    }
    sleep_seconds(1);
    slept = slept + 1;
  }
  w.mu.lock();
  bin already_done = w.done;
  if !already_done {
    w.killed = true;
  }
  w.mu.unlock();
  if !already_done {
    kill_pid(w.pid);
  }
  wg.done();
}

// Runs `argv` (index 0 is the executable) to completion, force-killing it
// if it's still running after `budget_seconds`. `wg`/`w.mu` outlive the
// watchdog task (waited on below before returning), so there is no
// dangling reference to either once this function's own stack frame
// disappears.
compound FuzzRunResult {
  num exit_code;
  bin killed_by_budget;
}

fun _run_fuzz_bounded(str[] argv, num budget_seconds) FuzzRunResult {
  FuzzRunResult result;
  result.exit_code = -1;
  result.killed_by_budget = false;

  let spawned = spawn_background(argv);
  if spawned.is_err() {
    ret result;
  }

  FuzzWatch w;
  w.pid = spawned.unwrap();
  w.budget_seconds = budget_seconds;
  w.mu = mutex_new();
  w.done = false;
  w.killed = false;

  WaitGroup wg = wait_group_new(1);
  fork _fuzz_watchdog(&w, &wg);

  num code = wait_exit_code(w.pid);
  w.mu.lock();
  w.done = true;
  w.mu.unlock();
  wg.wait();
  wg.destroy();
  w.mu.destroy();

  result.exit_code = code;
  result.killed_by_budget = w.killed;
  ret result;
}

// Every `fuzz "<name>" (...)` target `path` declares, in source order. A
// file can declare more than one; the directory-wide fuzz runner builds
// and runs each separately (a fuzz harness only ever exercises one target
// per binary, selected at compile time).
fun _collect_fuzz_targets(str path) Vec<str> {
  Vec<str> out;
  out.init(0);
  if !exists(path) {
    ret out;
  }
  str src = read_to_string(path);
  let lexed = tokenize(src, path);
  if lexed.is_err() {
    ret out;
  }
  Vec<Token> tokens = lexed.unwrap();
  defer tokens.free();

  num i = 0;
  for i + 1 < tokens.len {
    Token t = tokens.get(i);
    i = i + 1;
    if t.type != .Keyword || !equals(token_text(t), "fuzz") {
      continue;
    }
    Token next = tokens.get(i);
    if next.type == .String {
      // Not `token_text`: for a `.String` token that returns the value
      // re-quoted for source reproduction (`fmt.fn`'s own job), not the
      // decoded name a target was declared with.
      fit next.data {
        .Sval(s) -> { out.push(s); }
        _ -> {}
      }
    }
  }
  ret out;
}

// `fun fuzz <dir>`/`fun fuzz` (no path): discovers every `.fn` file under
// `root` that declares one or more `fuzz` targets, runs each target for a
// bounded `FUN_FUZZ_DEFAULT_SECONDS` (default 30s), and prints an
// aggregate summary. Unlike `fun fuzz <file.fn> <target>`'s open-ended
// single-target run, this form exists for a CI-style "did anything
// regress" sweep across a whole project, so every target gets the same
// short, bounded budget rather than running indefinitely.
pub fun run_fuzz_suite(
  str root,
  bin debug_info,
  bin warn_unused,
  bin warn_unused_lenient,
  Vec<Define>* extra_defines
) num {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);
  files.sort();

  num budget = _fuzz_budget_seconds();
  num ran = 0;
  num failed = 0;
  num fi = 0;
  for fi < files.len {
    str path = files.get(fi);
    fi = fi + 1;
    if !_declares_top_level_block(path, "fuzz") {
      continue;
    }
    Vec<str> targets = _collect_fuzz_targets(path);
    defer targets.free();

    num ti = 0;
    for ti < targets.len {
      str target = targets.get(ti);
      ti = ti + 1;

      println(format("== {str} :: {str} ({num}s) ==", path, target, budget));

      Vec<Define> defines = resolved_defines(extra_defines);
      defer defines.free();

      str c_path = default_c_path(path, ".fuzz.c");
      let lowered = compile_to_c_mode(
        path,
        c_path,
        &defines,
        false,
        warn_unused,
        true,
        target,
        debug_info,
        warn_unused_lenient
      );
      if lowered.is_err() {
        writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
        failed = failed + 1;
        ran = ran + 1;
        continue;
      }

      str exe = default_exe_path(path, ".fuzz");
      let cc_code = compile_c_to_fuzz_exe(c_path, exe, debug_info);
      remove_file(c_path);
      if cc_code != 0 {
        failed = failed + 1;
        ran = ran + 1;
        continue;
      }

      Vec<str> argv_args;
      argv_args.init(0);
      defer argv_args.free();
      argv_args.push(executable_path(exe));
      str[] argv = argv_from(&argv_args);
      FuzzRunResult result = _run_fuzz_bounded(argv, budget);
      free_argv(argv);
      remove_file(exe);

      // A watchdog kill just means the budget ran out with nothing found,
      // the expected, successful outcome of a bounded sweep, not a
      // crash. Only an exit code the process reached on its own reflects
      // a real result.
      if !result.killed_by_budget && result.exit_code != 0 {
        failed = failed + 1;
      }
      ran = ran + 1;
    }
  }

  if ran == 0 {
    println(format("no `fuzz` targets found under {str}", dir));
    ret 0;
  }

  println(format("\n{num}/{num} fuzz targets clean", ran - failed, ran));
  if failed > 0 {
    ret 1;
  }
  ret 0;
}

// True when `path` declares at least one top level `keyword "name" {`/`(`
// block (`keyword` is `"test"` or `"fuzz"`). Shared scan behind
// `run_test_suite` and `run_fuzz_suite`'s own filters.
fun _declares_top_level_block(str path, str keyword) bin {
  if !exists(path) {
    ret false;
  }
  str src = read_to_string(path);
  let lexed = tokenize(src, path);
  if lexed.is_err() {
    ret false;
  }
  Vec<Token> tokens = lexed.unwrap();
  // Deep: returns a plain `bin`, nothing aliasing these tokens' own
  // strings escapes this function.
  defer free_token_vec(&tokens);

  num i = 0;
  for i + 1 < tokens.len {
    Token t = tokens.get(i);
    i = i + 1;
    if t.type != .Keyword || !equals(token_text(t), keyword) {
      continue;
    }
    if tokens.get(i).type == .String {
      ret true;
    }
  }
  ret false;
}

// Parses `input` and prints its own top-level nodes as a plain-text
// tree (`-ast`). Errors are swallowed: this is a best-effort look at
// the shape of a program, not itself the reason a compile fails.
pub fun print_ast_for(str input) {
  let parsed = parse_program_with_imports(input);
  if parsed.is_err() {
    ret;
  }
  let merged = parsed.unwrap();
  print_ast(&merged.entry_nodes);
}

// Formats `path` in place, reporting whether the file changed. A file
// that is already formatted is left untouched, so its timestamp only
// moves when its contents do.
pub fun format_file(str path) Result<bin, str> {
  if !exists(path) {
    ret .Err(format("no such file: {str}", path));
  }
  str src = read_to_string(path);
  str out = format_source(src, path)!;
  if equals(out, src) {
    ret .Ok(false);
  }
  if !write_string(path, out) {
    ret .Err(format("could not write {str}", path));
  }
  ret .Ok(true);
}

// True when `path` is already formatted.
pub fun format_file_is_clean(str path) bin {
  if !exists(path) {
    ret false;
  }
  str src = read_to_string(path);
  let formatted = format_source(src, path);
  if formatted.is_err() {
    ret false;
  }
  ret equals(formatted.unwrap(), src);
}

// The dotted paths that `src` imports, in the order they are written.
fun _imported_paths(str src, str filename) Vec<str> {
  Vec<str> out;
  out.init(0);
  let lexed = tokenize(src, filename);
  if lexed.is_err() {
    ret out;
  }
  Vec<Token> tokens = lexed.unwrap();
  // Deep: every path pushed to `out` below is a fresh StringBuilder
  // copy (`b.build()`), never a token's own `Sval` directly, so
  // nothing in the returned `Vec<str>` aliases these tokens.
  defer free_token_vec(&tokens);

  num i = 0;
  for i < tokens.len {
    Token t = tokens.get(i);
    if t.type != .Keyword || !equals(token_text(t), "imp") {
      i = i + 1;
      continue;
    }
    StringBuilder b = string_builder_init(32);
    num j = i + 1;
    for j < tokens.len {
      Token it = tokens.get(j);
      if it.type == .NewLine || it.type == .Comment {
        j = j + 1;
        continue;
      }
      str text = token_text(it);
      if equals(text, ";") {
        break;
      }
      // An alias renames the import; the path is what precedes it.
      if it.type == .Keyword && equals(text, "as") {
        break;
      }
      b.append(text);
      j = j + 1;
    }
    str path = b.build();
    if !equals(path, "") {
      out.push(path);
    }
    i = j + 1;
  }
  ret out;
}

// Formats `path` and every module it imports, directly or not, leaving
// the stdlib alone. Reports how many files changed.
pub fun format_file_and_imports(str path) Result<num, str> {
  Vec<str> queue;
  queue.init(4);
  defer queue.free();
  queue.push(path);

  Set<str> seen = set_init("", 8);
  defer seen.free();

  num changed = 0;
  num i = 0;
  for i < queue.len {
    str current = queue.get(i);
    i = i + 1;
    if seen.has(current) {
      continue;
    }
    seen.add(current);

    if format_file(current)! {
      changed = changed + 1;
    }

    Vec<str> imports = _imported_paths(read_to_string(current), current);
    defer imports.free();
    num k = 0;
    for k < imports.len {
      str dotted = imports.get(k);
      k = k + 1;
      // The stdlib ships formatted and is not the caller's to rewrite.
      if starts_with(dotted, "std.") {
        continue;
      }
      str resolved = resolve_import_path(current, dotted);
      if exists(resolved) {
        queue.push(resolved);
      }
    }
  }
  ret .Ok(changed);
}

// Directories that hold generated or vendored files, which are not the
// project's own source.
fun _skip_scan_dir(str name) bin {
  fit name {
    ".git", ".funsand", "fun-out", "build", "node_modules" -> { ret true; }
    _ -> { ret false; }
  }
}

fun _collect_fun_files(str dir, Vec<str>* out) {
  let listed = list_dir(dir);
  if listed.is_err() {
    ret;
  }
  Vec<str> entries = listed.unwrap();
  defer entries.free();
  entries.sort();

  num i = 0;
  for i < entries.len {
    str name = entries.get(i);
    i = i + 1;
    str full = path_join(dir, name);
    if is_dir(full) {
      if !_skip_scan_dir(name) {
        _collect_fun_files(full, out);
      }
      continue;
    }
    if ends_with(name, ".fn") {
      out.push(full);
    }
  }
}

// The unformatted `.fn` files under `root`, which may name a directory
// or a file whose directory is scanned instead.
pub fun collect_unformatted(str root) Vec<str> {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  } elif !is_dir(dir) {
    dir = dirname(dir);
    if equals(dir, "") {
      dir = ".";
    }
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);

  Vec<str> out;
  out.init(0);
  num i = 0;
  for i < files.len {
    str path = files.get(i);
    i = i + 1;
    if !format_file_is_clean(path) {
      out.push(path);
    }
  }
  ret out;
}

test "lists the modules a file imports, aliases and stdlib included" {
  str src = `imp sub.helper;
  `imp std.io as out;
  `
  `fun main() num {
  `  ret 0;
  `}`;
  Vec<str> found = _imported_paths(src, "main.fn");
  defer found.free();
  assert found.len == 2, "expected both imports to be listed";
  assert equals(found.get(0), "sub.helper"), "expected the local import first";
  assert equals(found.get(1), "std.io"), "expected the alias dropped from the path";
}

test "formatting reports a change only when the file is rewritten" {
  make_dir_all("fun-out");
  str path = "fun-out/_fmt_probe.fn";
  write_string(path, "fun probe() num{ret 1;}\n");
  defer remove_file(path);

  let first = format_file(path);
  assert first.is_ok(), "expected the file to format";
  assert first.unwrap(), "expected the unformatted file to change";
  assert format_file_is_clean(path), "expected the file to be formatted now";

  let second = format_file(path);
  assert second.is_ok(), "expected the formatted file to format again";
  assert !second.unwrap(), "expected no second rewrite";
}

test "an unformatted file is reported by a scan of its directory" {
  make_dir_all("fun-out/_fmt_scan");
  str path = "fun-out/_fmt_scan/dirty.fn";
  write_string(path, "fun dirty() num{ret 1;}\n");
  defer remove_file(path);

  Vec<str> offenders = collect_unformatted("fun-out/_fmt_scan");
  defer offenders.free();
  assert offenders.len == 1, "expected the unformatted file to be reported";
  assert ends_with(offenders.get(0), "dirty.fn"), "expected the offender's path";
}
