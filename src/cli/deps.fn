// Resolves, fetches, and locks `[deps]` entries from `fun.toml`.
//
// Every fetch shells out to the system `git` (via `std.process.run`),
// the only thing in this codebase with real, already-correct TLS/SSH
// handling - there is no HTTP/TLS client anywhere in the stdlib. A
// dependency is never executed as part of resolution: it is source
// text, parsed and compiled the same as any other `use`, the same way
// a plain relative import already works. `fun.lock` pins the exact
// resolved commit for every entry; a `tag`/`branch` only re-resolves on
// an explicit `fun deps update`, never implicitly - see `resolve_all`.
//
// `resolve_all` also walks transitively: a fetched dependency that has
// its own `fun.toml` with its own `[deps]` gets those resolved too, all
// flattened into the one project-level `fun.lock` and the one flat
// `use deps.<name>...` namespace. The project's own `[deps]` always
// wins a same-name claim from somewhere deeper in the graph; two
// different transitive sources claiming the same name at genuinely
// different commits is a hard error naming both, since nothing else
// here decides which one should win.

use manifest;
use ..parser.deps_lock;
use std.vec;
use std.string;
use std.option;
use std.result;
use std.error;
use std.process;
use std.fs;
use std.path;
use std.io;

// A safety bound on the whole resolved dependency graph (direct plus
// every transitive dependency reached through it), keyed by distinct
// fetched trees - guards against a dependency cycle or a maliciously
// (or accidentally) deep chain turning one `fun build` into unbounded
// work. Generous: no real project should ever come close.
const num max_deps_graph_size = 256;

// Runs `git` with `args`, capturing output. `-C dir` (a plain argv
// element, not a real chdir) is how every caller targets an existing
// checkout - `std.process.run` has no cwd parameter, and `-C` works
// identically across every platform `git` itself supports.
fun _git(Vec<str> args) Result<ProcessResult, str> {
  str[] argv = argv_from(&args);
  defer free_argv(argv);
  let r = run(argv);
  if r.is_err() {
    ret .Err(format("git: {str}", r.unwrap_err().message));
  }
  ret .Ok(r.unwrap());
}

fun _git_ok(ProcessResult* r) flag {
  ret r.exit_code == 0;
}

// `git ls-remote --tags --refs --sort=-v:refname <url>`: the highest
// semver-sorted tag, using git's own version-sort so no semver parser
// is needed here. A remote query, no clone - cheap, and lets `tag =
// "latest"` resolve before deciding what to actually fetch.
fun _git_latest_tag(str url) Result<str, str> {
  Vec<str> args;
  args.init(6);
  defer args.free();
  args.push("git");
  args.push("ls-remote");
  args.push("--tags");
  args.push("--refs");
  args.push("--sort=-v:refname");
  args.push(url);
  let res = _git(args)!;
  if !_git_ok(&res) {
    ret .Err(format("could not list tags for {str}: {str}", url, res.stderr_text));
  }
  let lines = split(res.stdout_text, '\n');
  defer lines.free();
  for line : lines {
    if equals(trim(line), "") {
      continue;
    }
    num tab_i = index_of_char(line, '\t');
    if tab_i < 0 {
      continue;
    }
    str ref = trim(substr(line, tab_i + 1, len(line) - (tab_i + 1)));
    str prefix = "refs/tags/";
    if starts_with(ref, prefix) {
      ret .Ok(substr(ref, len(prefix), len(ref) - len(prefix)));
    }
  }
  ret .Err(format("{str} has no tags", url));
}

fun _git_rev_parse_head(str dir) Result<str, str> {
  Vec<str> args;
  args.init(4);
  defer args.free();
  args.push("git");
  args.push("-C");
  args.push(dir);
  args.push("rev-parse");
  args.push("HEAD");
  let res = _git(args)!;
  if !_git_ok(&res) {
    ret .Err(format("could not resolve HEAD in {str}: {str}", dir, res.stderr_text));
  }
  ret .Ok(trim(res.stdout_text));
}

// One shallow clone, exact ref (a tag or branch name git can resolve
// directly): `git clone --depth 1 --branch <ref> <url> <dest>`.
fun _git_clone_ref(str url, str ref, str dest) Result<flag, str> {
  Vec<str> args;
  args.init(8);
  defer args.free();
  args.push("git");
  args.push("clone");
  args.push("--depth");
  args.push("1");
  args.push("--branch");
  args.push(ref);
  args.push(url);
  args.push(dest);
  let res = _git(args)!;
  if !_git_ok(&res) {
    ret .Err(format("git clone {str}@{str} failed: {str}", url, ref, res.stderr_text));
  }
  ret .Ok(true);
}

// A repo with no tags at all under an `.Auto` spec: clones the remote's
// own default branch by simply omitting `--branch` (there is no real
// branch literally named `HEAD` that `--branch` could target).
fun _git_clone_default(str url, str dest) Result<flag, str> {
  Vec<str> args;
  args.init(6);
  defer args.free();
  args.push("git");
  args.push("clone");
  args.push("--depth");
  args.push("1");
  args.push(url);
  args.push(dest);
  let res = _git(args)!;
  if !_git_ok(&res) {
    ret .Err(format("git clone {str} failed: {str}", url, res.stderr_text));
  }
  ret .Ok(true);
}

// The real name of whatever branch a clone landed on - used to turn
// `_git_clone_default`'s "whatever the remote's default is" into a
// concrete branch name for `fun.lock`'s own `spec` field, rather than
// leaving it unrecorded.
fun _git_current_branch_name(str dir) Result<str, str> {
  Vec<str> args;
  args.init(5);
  defer args.free();
  args.push("git");
  args.push("-C");
  args.push(dir);
  args.push("rev-parse");
  args.push("--abbrev-ref");
  args.push("HEAD");
  let res = _git(args)!;
  if !_git_ok(&res) {
    ret .Err(format("could not determine the default branch in {str}: {str}", dir, res.stderr_text));
  }
  ret .Ok(trim(res.stdout_text));
}

// An exact commit, not a ref name git can `--branch` directly: shallow
// clone with no checkout, fetch that one commit, then check it out.
// Falls back to a full (non-shallow) clone + checkout when the shallow
// fetch-by-sha is rejected (some self-hosted git servers disable
// `uploadpack.allowReachableSHA1InWant`) - documented, not chased
// further; a full clone always works.
fun _git_fetch_rev(str url, str rev, str dest) Result<flag, str> {
  Vec<str> clone_args;
  clone_args.init(8);
  defer clone_args.free();
  clone_args.push("git");
  clone_args.push("clone");
  clone_args.push("--filter=blob:none");
  clone_args.push("--no-checkout");
  clone_args.push(url);
  clone_args.push(dest);
  let clone_res = _git(clone_args)!;
  if !_git_ok(&clone_res) {
    ret .Err(format("git clone {str} failed: {str}", url, clone_res.stderr_text));
  }

  Vec<str> fetch_args;
  fetch_args.init(6);
  defer fetch_args.free();
  fetch_args.push("git");
  fetch_args.push("-C");
  fetch_args.push(dest);
  fetch_args.push("fetch");
  fetch_args.push("--depth");
  fetch_args.push("1");
  fetch_args.push("origin");
  fetch_args.push(rev);
  let fetch_res = _git(fetch_args)!;
  flag shallow_fetch_ok = _git_ok(&fetch_res);

  if !shallow_fetch_ok {
    // Fall back to a full clone: remove the partial attempt and redo it
    // without `--filter`/`--no-checkout`, then a plain checkout.
    remove_dir_best_effort(dest);
    Vec<str> full_args;
    full_args.init(4);
    defer full_args.free();
    full_args.push("git");
    full_args.push("clone");
    full_args.push(url);
    full_args.push(dest);
    let full_res = _git(full_args)!;
    if !_git_ok(&full_res) {
      ret .Err(format("git clone {str} failed: {str}", url, full_res.stderr_text));
    }
  }

  Vec<str> checkout_args;
  checkout_args.init(5);
  defer checkout_args.free();
  checkout_args.push("git");
  checkout_args.push("-C");
  checkout_args.push(dest);
  checkout_args.push("checkout");
  str checkout_target = rev;
  if shallow_fetch_ok {
    checkout_target = "FETCH_HEAD";
  }
  checkout_args.push(checkout_target);
  let checkout_res = _git(checkout_args)!;
  if !_git_ok(&checkout_res) {
    ret .Err(format("git checkout {str} in {str} failed: {str}", rev, dest, checkout_res.stderr_text));
  }
  ret .Ok(true);
}

// Best-effort recursive removal, used only to clear a partial/failed
// clone attempt before retrying - never the primary cleanup path for
// anything a user would notice missing.
fun remove_dir_best_effort(str dir) {
  Vec<str> args;
  args.init(3);
  defer args.free();
  args.push("rm");
  args.push("-rf");
  args.push(dir);
  str[] argv = argv_from(&args);
  defer free_argv(argv);
  let r = run(argv);
  // On Windows `rm` is not a standalone executable so the spawn fails;
  // fall back to rename so the directory is at least moved out of the way.
  if r.is_err() || r.unwrap().exit_code != 0 {
    let orphan = format("{str}.removed", dir);
    rename(dir, orphan);
  }
}

// Resolves `d` to an exact commit and fetches it into the shared cache
// if not already there, without consulting or updating the lockfile -
// `resolve_all` is the caller that does both. `required_by` names the
// dependency that transitively pulled `d` in (empty for one declared
// directly in the project's own `[deps]`), folded into the printed
// fetch line so provenance is visible without a separate announcement
// that would print even when nothing is actually fetched.
pub fun resolve_one(Dependency* d, str required_by) Result<ResolvedDep, str> {
  str ref_kind = "";
  str ref_value = "";
  fit d.spec {
    .Tag(t) -> {
      ref_kind = "tag";
      ref_value = t;
    }
    .Branch(b) -> {
      ref_kind = "branch";
      ref_value = b;
    }
    .Rev(r) -> {
      ref_kind = "rev";
      ref_value = r;
    }
    .Auto -> {
      let latest = _git_latest_tag(d.git);
      if latest.is_ok() {
        ref_kind = "tag";
        ref_value = latest.unwrap();
      } else {
        // No tags at all - resolved below against the remote's own
        // default branch, whatever it's actually named.
        ref_kind = "branch";
        ref_value = "";
      }
    }
  }
  if equals(ref_kind, "tag") && equals(ref_value, "latest") {
    ref_value = _git_latest_tag(d.git)!;
  }

  str provenance = "";
  if !equals(required_by, "") {
    provenance = format(" (required by {str})", required_by);
  }

  str resolved_rev = "";
  str dest = "";
  if equals(ref_kind, "rev") {
    // The cache is keyed by the resolved commit itself, so the
    // destination is already known before fetching.
    dest = dep_cache_dir(d.git, ref_value);
    if !is_dir(dest) {
      println(format("  fetching {str} @ {str} ({str}){str}", d.name, ref_value, d.git, provenance));
      _ = _git_fetch_rev(d.git, ref_value, dest)!;
    }
    resolved_rev = ref_value;
  } else {
    // A tag/branch name resolves to a commit only after cloning, so a
    // temporary staging directory is used first, then the final,
    // commit-keyed cache directory is only trusted once the resolved
    // commit is known - avoids leaving a half-named directory behind
    // if resolution races with another `fun build`.
    flag default_branch = equals(ref_kind, "branch") && equals(ref_value, "");
    if default_branch {
      println(format("  fetching {str} @ default branch ({str}){str}", d.name, d.git, provenance));
    } else {
      println(format("  fetching {str} @ {str} {str} ({str}){str}", d.name, ref_kind, ref_value, d.git, provenance));
    }
    str staging_ref = ref_value;
    if equals(staging_ref, "") {
      staging_ref = "default";
    }
    str staging = format("{str}/.staging-{str}-{str}", deps_cache_root(), sanitize_url(d.git), staging_ref);
    remove_dir_best_effort(staging);
    make_dir_all(deps_cache_root());
    if default_branch {
      _ = _git_clone_default(d.git, staging)!;
      ref_value = _git_current_branch_name(staging)!;
    } else {
      _ = _git_clone_ref(d.git, ref_value, staging)!;
    }
    resolved_rev = _git_rev_parse_head(staging)!;
    dest = dep_cache_dir(d.git, resolved_rev);
    if is_dir(dest) {
      remove_dir_best_effort(staging);
    } else {
      // `rename()`, unlike `git clone`, never creates a missing destination
      // parent directory on its own - `dest`'s own parent (the
      // sanitized-URL directory) doesn't exist yet the first time any
      // ref of this repo is fetched.
      make_dir_all(dirname(dest));
      if rename(staging, dest) != 0 {
        ret .Err(format("could not move {str} into the dependency cache at {str}", staging, dest));
      }
    }
  }

  ResolvedDep out;
  out.name = d.name;
  out.git = d.git;
  out.path = d.path;
  out.spec_text = format("{str}:{str}", ref_kind, ref_value);
  out.resolved_rev = resolved_rev;
  if equals(d.path, "") {
    out.local_root = dest;
  } else {
    out.local_root = format("{str}/{str}", dest, d.path);
  }
  ret .Ok(out);
}

// Whether an already-resolved `spec_text` (e.g. "tag:v1.2.3" or
// "branch:main") still matches what `d` itself declares - shared by the
// lockfile-reuse check below and by `resolve_all`'s transitive dedupe,
// since both are really the same question: does this dependency still
// want what's already been resolved for it? `.Auto` matches either a
// resolved tag or a resolved branch (a repo with no tags at all falls
// back to its default branch, see `resolve_one`), since which of the
// two currently applies is exactly what only `fun deps update` should
// ever re-check.
fun _spec_still_matches(str spec_text, Dependency* d) flag {
  fit d.spec {
    .Auto -> { ret starts_with(spec_text, "tag:") || starts_with(spec_text, "branch:"); }
    _ -> {}
  }
  ret starts_with(spec_text, _dep_ref_text(d));
}

// Reuses `d`'s already-resolved entry from `locked` when the manifest's
// own spec for its name hasn't changed (skipping the network entirely),
// otherwise fetches fresh via `resolve_one`. Shared between a project's
// own top-level `[deps]` and every dependency discovered transitively
// through another dependency's own `fun.toml` - both need the exact
// same reuse-or-fetch decision against the one flat lock.
// `fetched_count` is incremented on every real fetch, so `resolve_all`
// can decide at the end whether any network work happened at all.
fun _resolve_one_reusing(Dependency* d, Vec<ResolvedDep>* locked, flag force_update, num* fetched_count, str required_by) Result<ResolvedDep, str> {
  flag is_rev = false;
  fit d.spec {
    .Rev(_) -> { is_rev = true; }
    _ -> {}
  }
  if !force_update || is_rev {
    num j = 0;
    for j < locked.len {
      let lk = locked.get(j);
      if equals(lk.name, d.name) && equals(lk.git, d.git) && equals(lk.path, d.path) &&
        _spec_still_matches(lk.spec_text, d) && is_dir(lk.local_root) {
        ret .Ok(lk);
      }
      j = j + 1;
    }
  }
  *fetched_count = *fetched_count + 1;
  ret resolve_one(d, required_by);
}

fun _index_of_name(Vec<ResolvedDep>* v, str name) num {
  num i = 0;
  for i < v.len {
    if equals(v.get(i).name, name) {
      ret i;
    }
    i = i + 1;
  }
  ret -1;
}

// The one thing `fun build`/`test`/`fuzz` call: resolves every `[deps]`
// entry in `m`, then floods outward through every fetched dependency's
// own `fun.toml` to resolve its transitive `[deps]` too, all flattened
// into one `fun.lock` and one flat `use deps.<name>...` namespace.
// Reuses the lockfile's own already-resolved commit whenever a
// manifest's spec for that name hasn't changed (so an ordinary build
// never re-resolves `tag`/`branch` over the network), fetching anything
// not already in the shared cache. `force_update` (from `fun deps
// update`) skips the lockfile-reuse check for every `tag`/`branch`
// entry at every level of the graph, re-resolving to whatever is
// current; a `rev`-pinned entry is never re-resolved either way, since
// an explicit pin means the caller wants exactly that revision.
pub fun resolve_all(Manifest* m, str root, flag force_update) Result<Vec<ResolvedDep>, str> {
  let locked = read_lock(root);
  defer locked.free();

  Vec<ResolvedDep> out;
  out.init(m.deps.len);
  Vec<str> owners;
  owners.init(m.deps.len);
  defer owners.free();
  Vec<str> top_level_names;
  top_level_names.init(m.deps.len);
  defer top_level_names.free();
  num fetched = 0;

  num i = 0;
  for i < m.deps.len {
    let d = m.deps.get(i);
    top_level_names.push(d.name);
    let resolved = _resolve_one_reusing(&d, &locked, force_update, &fetched, "")!;
    out.push(resolved);
    owners.push("the project itself");
    i = i + 1;
  }

  // `out` doubles as its own work queue below: resolving a transitive
  // dependency's own `[deps]` appends onto the very list being walked,
  // so a growing `out` naturally keeps the flood going until every
  // reachable dependency, direct or transitive, has been visited once.
  Vec<str> visited_nodes;
  visited_nodes.init(0);
  defer visited_nodes.free();

  i = 0;
  for i < out.len {
    let parent = out.get(i);
    str node_key = format("{str}|{str}|{str}", parent.git, parent.path, parent.resolved_rev);
    i = i + 1;
    if visited_nodes.contains(node_key) {
      continue;
    }
    visited_nodes.push(node_key);
    if visited_nodes.len > max_deps_graph_size {
      ret .Err(format(
        "[deps] the dependency graph reaches more than {num} distinct fetched repositories, likely a cycle; check for a dependency that transitively depends on itself",
        max_deps_graph_size
      ));
    }

    str child_toml_path = format("{str}/fun.toml", parent.local_root);
    if !exists(child_toml_path) {
      continue;
    }
    let child_text = read_to_string(child_toml_path);
    let child_manifest_r = parse_manifest(child_text);
    if child_manifest_r.is_err() {
      ret .Err(format("[deps] `{str}`'s own fun.toml is invalid: {str}", parent.name, child_manifest_r.unwrap_err()));
    }
    Manifest child_m = child_manifest_r.unwrap();
    defer child_m.free();

    num j = 0;
    for j < child_m.deps.len {
      let cd = child_m.deps.get(j);
      j = j + 1;
      if top_level_names.contains(cd.name) {
        // The project's own [deps] entry for this name always wins over
        // anything a dependency transitively asks for.
        continue;
      }
      num existing_idx = _index_of_name(&out, cd.name);
      if existing_idx < 0 {
        let resolved_child = _resolve_one_reusing(&cd, &locked, force_update, &fetched, parent.name)!;
        out.push(resolved_child);
        owners.push(parent.name);
        continue;
      }
      let existing = out.get(existing_idx);
      if equals(existing.git, cd.git) && equals(existing.path, cd.path) &&
        _spec_still_matches(existing.spec_text, &cd) {
        continue; // identical declared pin, already resolved - no extra fetch
      }
      // Specs differ syntactically (e.g. one side pins a tag, the other
      // the branch that tag was cut from) - resolve for real before
      // calling this an actual conflict, since they might still land on
      // the exact same commit.
      let resolved_child = _resolve_one_reusing(&cd, &locked, force_update, &fetched, parent.name)!;
      if equals(resolved_child.resolved_rev, existing.resolved_rev) &&
        equals(resolved_child.git, existing.git) &&
        equals(resolved_child.path, existing.path) {
        continue; // same content, different spelling - harmless
      }
      ret .Err(format(
        "[deps] `{str}` is required by both `{str}` and `{str}` pinned to different commits ({str} vs {str}); add `{str}` to this project's own [deps] to pick one",
        cd.name, owners.get(existing_idx), parent.name, existing.resolved_rev, resolved_child.resolved_rev, cd.name
      ));
    }
  }

  write_lock(root, &out);
  if fetched > 0 {
    println(format("Resolved {num} dependencies ({num} fetched or updated).", out.len, fetched));
  }
  ret .Ok(out);
}

// The manifest spec's own kind, as the `spec_text` prefix
// `resolve_all` compares a locked entry against (never the exact
// value for `tag`/`branch`, since those are allowed to drift until an
// explicit update; `rev` compares its own exact value, since a `rev`
// pin changing at all means a genuinely different dependency).
fun _dep_ref_text(Dependency* d) str {
  fit d.spec {
    .Auto -> { ret "tag"; }
    .Tag(t) -> { ret format("tag:{str}", t); }
    .Branch(b) -> { ret format("branch:{str}", b); }
    .Rev(r) -> { ret format("rev:{str}", r); }
  }
  ret "";
}

test "_index_of_name finds a resolved dependency by name, or reports -1" {
  Vec<ResolvedDep> v;
  v.init(2);
  defer v.free();
  ResolvedDep a;
  a.name = "alpha";
  v.push(a);
  ResolvedDep b;
  b.name = "beta";
  v.push(b);
  assert _index_of_name(&v, "beta") == 1, "expected the second entry's index";
  assert _index_of_name(&v, "gamma") == -1, "expected -1 for a name that isn't present";
}

test "_spec_still_matches: an explicit tag only matches its own exact value" {
  Dependency d;
  d.spec = .Tag("v1.2.3");
  assert _spec_still_matches("tag:v1.2.3", &d), "expected the same tag to match";
  assert !_spec_still_matches("tag:v1.2.4", &d), "expected a different tag to not match";
  assert !_spec_still_matches("branch:main", &d), "expected a branch entry to not match a tag spec";
}

test "_spec_still_matches: an explicit branch only matches its own exact value" {
  Dependency d;
  d.spec = .Branch("main");
  assert _spec_still_matches("branch:main", &d), "expected the same branch to match";
  assert !_spec_still_matches("branch:develop", &d), "expected a different branch to not match";
}

test "_spec_still_matches: a rev only matches its own exact commit" {
  Dependency d;
  d.spec = .Rev("abc123");
  assert _spec_still_matches("rev:abc123", &d), "expected the same rev to match";
  assert !_spec_still_matches("rev:def456", &d), "expected a different rev to not match";
}

test "_spec_still_matches: Auto matches either a resolved tag or a resolved branch" {
  Dependency d;
  d.spec = .Auto;
  assert _spec_still_matches("tag:v1.0.0", &d), "expected Auto to accept a previously resolved tag";
  assert _spec_still_matches("branch:main", &d), "expected Auto to accept a previously resolved branch, e.g. a repo with no tags at all";
  assert !_spec_still_matches("rev:abc123", &d), "expected Auto to not accept a rev-pinned entry";
}

// Runs `git` in `dir` (or where it is, for "") and reports whether it worked.
fun _git_in(str dir, Vec<str>* rest) flag {
  Vec<str> args;
  args.init(8);
  defer args.free();
  args.push("git");
  if !equals(dir, "") {
    args.push("-C");
    args.push(dir);
  }
  for a : rest {
    args.push(a);
  }
  let r = _git(args);
  ret r.is_ok() && _git_ok(&r.unwrap());
}

// A manifest with one `[deps]` entry, written without `format`, whose brace
// escaping would need care here.
fun _manifest_with_dep(str package, str dep, str url, str tag) str {
  StringBuilder b = string_builder_init(128);
  b.append("[package]\nname = \"");
  b.append(package);
  b.append("\"\n\n[deps]\n");
  b.append(dep);
  b.append(" = { git = \"");
  b.append(url);
  b.append("\", tag = \"");
  b.append(tag);
  b.append("\" }\n");
  ret b.build();
}

// `{ git = "url", tag = "tag" }`.
fun _inline_dep(str url, str tag) str {
  StringBuilder b = string_builder_init(96);
  b.append("{ git = \"");
  b.append(url);
  b.append("\", tag = \"");
  b.append(tag);
  b.append("\" }");
  ret b.build();
}

// Makes a git repository at `dir` (under fun-out) whose one commit holds
// `files` (name, then text), tagged `tag` unless that is empty, and returns
// its `file://` URL, or "" when this environment has no absolute working
// directory to build one from.
fun _local_repo(str name, str file_name, str file_text, str tag, str branch) str {
  str pwd = env_or("PWD", "");
  if equals(pwd, "") {
    ret "";
  }
  str dir = format("fun-out/deps_test_repo_{str}", name);
  remove_dir_best_effort(dir);
  make_dir_all(dir);
  Vec<str> a;
  a.init(4);
  a.push("init");
  a.push("-q");
  a.push("-b");
  a.push(branch);
  _git_in(dir, &a);
  write_string(path_join(dir, file_name), file_text);
  Vec<str> b;
  b.init(4);
  b.push("add");
  b.push("-A");
  _git_in(dir, &b);
  Vec<str> c;
  c.init(8);
  c.push("-c");
  c.push("user.name=test");
  c.push("-c");
  c.push("user.email=test@example.com");
  c.push("commit");
  c.push("-q");
  c.push("-m");
  c.push("first");
  _git_in(dir, &c);
  if !equals(tag, "") {
    Vec<str> t;
    t.init(4);
    t.push("tag");
    t.push(tag);
    _git_in(dir, &t);
  }
  ret format("file://{str}/{str}", pwd, dir);
}

sequential test "a dependency resolves from a local repository by tag, branch, revision and default" {
  set_env("FUN_DEPS_CACHE", "fun-out/deps_test_cache");
  str url = _local_repo("basic", "lib.fn", "pub fun one() num { ret 1; }\n", "v1.0.0", "main");
  if equals(url, "") {
    clear_env("FUN_DEPS_CACHE");
    ret;
  }
  Dependency d;
  d.name = "lib";
  d.git = url;
  d.path = "";
  d.token_env = "";
  d.spec = .Tag("v1.0.0");
  let by_tag = resolve_one(&d, "");
  assert by_tag.is_ok(), "expected a tag to resolve";
  ResolvedDep r = by_tag.unwrap();
  assert len(r.resolved_rev) == 40 && equals(r.spec_text, "tag:v1.0.0"), "expected a full commit id and the spec it came from";
  assert exists(path_join(r.local_root, "lib.fn")), "expected the checkout to hold the file";
  d.spec = .Branch("main");
  let by_branch = resolve_one(&d, "the project");
  assert by_branch.is_ok() && equals(by_branch.unwrap().resolved_rev, r.resolved_rev), "expected the branch to resolve to the same commit";
  d.spec = .Rev(r.resolved_rev);
  let by_rev = resolve_one(&d, "");
  assert by_rev.is_ok() &&
    equals(by_rev.unwrap().spec_text, format("rev:{str}", r.resolved_rev)), "expected the commit id to resolve";
  d.spec = .Rev(r.resolved_rev);
  assert resolve_one(&d, "").is_ok(), "expected a second resolve of a cached revision to succeed";
  d.spec = .Auto;
  let automatic = resolve_one(&d, "");
  assert automatic.is_ok() && equals(automatic.unwrap().spec_text, "tag:v1.0.0"), "expected Auto to pick the newest tag";
  d.spec = .Tag("latest");
  let latest = resolve_one(&d, "");
  assert latest.is_ok() && equals(latest.unwrap().spec_text, "tag:v1.0.0"), "expected the tag `latest` to mean the newest tag";
  d.spec = .Tag("v9.9.9");
  assert resolve_one(&d, "").is_err(), "expected an unknown tag to fail";
  d.spec = .Branch("nope");
  assert resolve_one(&d, "").is_err(), "expected an unknown branch to fail";
  d.path = "sub";
  d.spec = .Tag("v1.0.0");
  let with_path = resolve_one(&d, "");
  assert with_path.is_ok() && ends_with(with_path.unwrap().local_root, "/sub"), "expected a subfolder to be part of the local root";
  clear_env("FUN_DEPS_CACHE");
}

sequential test "a repository with no tags resolves to its default branch, and the tag lookup says so" {
  set_env("FUN_DEPS_CACHE", "fun-out/deps_test_cache");
  str url = _local_repo("notags", "lib.fn", "pub fun two() num { ret 2; }\n", "", "trunk");
  if equals(url, "") {
    clear_env("FUN_DEPS_CACHE");
    ret;
  }
  assert _git_latest_tag(url).is_err(), "expected no tags to be reported";
  Dependency d;
  d.name = "lib";
  d.git = url;
  d.path = "";
  d.token_env = "";
  d.spec = .Auto;
  let resolved = resolve_one(&d, "");
  assert resolved.is_ok() && equals(resolved.unwrap().spec_text, "branch:trunk"), "expected the default branch to be found and named";
  Dependency broken;
  broken.name = "gone";
  broken.git = "file:///no/such/repository";
  broken.path = "";
  broken.token_env = "";
  broken.spec = .Auto;
  assert resolve_one(&broken, "").is_err(), "expected an unreachable repository to fail";
  assert _git_rev_parse_head("fun-out/deps_test_no_such_dir").is_err(), "expected no commit in a directory that is not a repository";
  clear_env("FUN_DEPS_CACHE");
}

sequential test "resolve_all resolves a manifest's dependencies, follows theirs, and reuses the lock" {
  set_env("FUN_DEPS_CACHE", "fun-out/deps_test_cache");
  str leaf_url = _local_repo("leaf", "leaf.fn", "pub fun leaf() num { ret 3; }\n", "v1.0.0", "main");
  if equals(leaf_url, "") {
    clear_env("FUN_DEPS_CACHE");
    ret;
  }
  str mid_toml = _manifest_with_dep("mid", "leaf", leaf_url, "v1.0.0");
  str mid_url = _local_repo("mid", "fun.toml", mid_toml, "v2.0.0", "main");
  str root = "fun-out/deps_test_root";
  make_dir_all(root);
  remove_file(path_join(root, "fun.lock"));
  str top_toml = _manifest_with_dep("top", "mid", mid_url, "v2.0.0");
  let parsed = parse_manifest(top_toml);
  assert parsed.is_ok(), "expected the manifest to parse";
  Manifest m = parsed.unwrap();
  let first = resolve_all(&m, root, false);
  assert first.is_ok() && first.unwrap().len == 2, "expected the direct and the transitive dependency";
  assert exists(path_join(root, "fun.lock")), "expected a lock file to be written";
  let second = resolve_all(&m, root, false);
  assert second.is_ok() && second.unwrap().len == 2, "expected the lock to be reused";
  let forced = resolve_all(&m, root, true);
  assert forced.is_ok(), "expected a forced update to succeed";
  clear_env("FUN_DEPS_CACHE");
}

sequential test "two dependencies that need the same library at different commits are reported" {
  set_env("FUN_DEPS_CACHE", "fun-out/deps_test_cache");
  str shared_v1 = _local_repo("shared", "s.fn", "pub fun s() num { ret 1; }\n", "v1.0.0", "main");
  if equals(shared_v1, "") {
    clear_env("FUN_DEPS_CACHE");
    ret;
  }
  Vec<str> more;
  more.init(4);
  more.push("tag");
  more.push("v2.0.0");
  write_string("fun-out/deps_test_repo_shared/s.fn", "pub fun s() num { ret 2; }\n");
  Vec<str> add;
  add.init(2);
  add.push("commit");
  add.push("-q");
  add.push("-a");
  add.push("-m");
  add.push("second");
  add.push("--author=t <t@example.com>");
  Vec<str> cfg;
  cfg.init(4);
  cfg.push("-c");
  cfg.push("user.name=test");
  cfg.push("-c");
  cfg.push("user.email=test@example.com");
  for a : add {
    cfg.push(a);
  }
  _git_in("fun-out/deps_test_repo_shared", &cfg);
  _git_in("fun-out/deps_test_repo_shared", &more);
  str a_toml = _manifest_with_dep("a", "shared", shared_v1, "v1.0.0");
  str b_toml = _manifest_with_dep("b", "shared", shared_v1, "v2.0.0");
  str a_url = _local_repo("conflict_a", "fun.toml", a_toml, "v1.0.0", "main");
  str b_url = _local_repo("conflict_b", "fun.toml", b_toml, "v1.0.0", "main");
  str top_toml = format("{str}a = {str}\nb = {str}\n", "[package]\nname = \"top\"\n\n[deps]\n", _inline_dep(a_url, "v1.0.0"), _inline_dep(b_url, "v1.0.0"));
  Manifest m = parse_manifest(top_toml).unwrap();
  str root = "fun-out/deps_test_conflict_root";
  make_dir_all(root);
  remove_file(path_join(root, "fun.lock"));
  let outcome = resolve_all(&m, root, false);
  assert outcome.is_err(), "expected a version conflict to be an error";
  assert contains(outcome.unwrap_err(), "`shared` is required by both `a` and `b`"), "expected the message to name the library and both requirers";
  clear_env("FUN_DEPS_CACHE");
}

test "removing a directory best-effort deletes it, and a dependency's spec has a readable form" {
  str dir = "fun-out/deps_test_removal/inner";
  make_dir_all(dir);
  write_string(path_join(dir, "f.txt"), "x");
  remove_dir_best_effort("fun-out/deps_test_removal");
  assert !is_dir("fun-out/deps_test_removal"), "expected the directory tree to be gone";
  Dependency d;
  d.spec = .Auto;
  assert equals(_dep_ref_text(&d), "tag"), "expected the automatic spec to read as tag";
  d.spec = .Tag("v1");
  assert equals(_dep_ref_text(&d), "tag:v1"), "expected a tag";
  d.spec = .Branch("main");
  assert equals(_dep_ref_text(&d), "branch:main"), "expected a branch";
  d.spec = .Rev("abc");
  assert equals(_dep_ref_text(&d), "rev:abc"), "expected a revision";
}
