// Type-alias expansion.
//
// An `als Name<T1, T2> = <type>;` (or `als Name = a | b;`) declaration
// names a reusable type expression, transparently expanded wherever
// referenced before typecheck ever runs - neither typecheck nor codegen
// needs to know aliases exist, matching the same "single point of
// expansion, everything downstream free" approach this compiler already
// uses for keyword canonicalization.
//
// This mutates the program's own DataType nodes in place, so a caller
// that must keep an alias reference visible for display (fls hover,
// completion, go-to-definition) needs to run this against a disposable
// clone of the program, never its own cached copy - see
// `src/fls/diagnostics.fn`'s own call site for exactly that.

use ..ast.ast;
use ..parser.datatype_defs;
use generic_defaults;
use std.string;
use std.io;
use std.vec;
use std.map;
use std.option;
use std.set;

// One alias's own body, resolved against every other alias in the same
// program up to the round it was last processed. `is_resolved` is false
// until a round finds no remaining unresolved alias reference inside its
// own body/alternatives - only then is it safe for another alias (or the
// program at large) to substitute it in.
compound _ResolvedAlias {
  flag is_resolved;
  Vec<str> type_params;
  // Parallel to `type_params`: true at a position declared `(Name)`
  // rather than bare `Name` - see `TypeAliasNode.type_param_is_spread`.
  Vec<flag> type_param_is_spread;
  flag is_bound_list;
  DataType* body;
  Vec<str> bound_alternatives;
  // Set the moment any reference to this alias is seen, whether that
  // reference resolves cleanly or not - used to drive the
  // `unused_type_alias` warning, which needs to know about a real
  // reference before this pass erases it by substituting the alias away.
  flag is_used;
}

fun _unresolved_marker() _ResolvedAlias {
  Vec<str> empty_params;
  empty_params.init(0);
  Vec<flag> empty_spread;
  empty_spread.init(0);
  Vec<str> empty_alts;
  empty_alts.init(0);
  ret _ResolvedAlias{
  is_resolved = false,
  type_params = empty_params,
  type_param_is_spread = empty_spread,
  is_bound_list = false,
  body = nil,
  bound_alternatives = empty_alts,
  is_used = false}
  ;
}

// Frees a Vec<DataType*> this module itself built (each entry its own
// fresh allocation) - the same job as ast.fn's own private
// `_free_dtype_vec`, kept local since that one isn't exported.
fun _free_dtype_ptr_vec(Vec<DataType*>* v) {
  num i = 0;
  for i < v.len {
    dtype_free(v.get(i));
    i = i + 1;
  }
  v.free();
}

// Frees a Vec<Node*> owned the same way `array_brackets` is - the local
// counterpart to ast.fn's own private `_free_node_vec`.
fun _free_node_ptr_vec(Vec<Node*>* v) {
  num i = 0;
  for i < v.len {
    node_free(v.get(i));
    i = i + 1;
  }
  v.free();
}

// Overwrites `*dt` with `replacement`'s own field values, freeing
// whatever `dt` used to own first (its old generic_args, array_brackets,
// and fn_sig - nothing else in the program can still be pointing at any
// of them, since the walk below visits each DataType exactly once).
// `dt`'s own pointer identity stays stable; only its contents change,
// mirroring `dtype_clone`'s own shallow-copy-then-take-ownership idiom.
fun _replace_dtype(DataType* dt, DataType replacement) {
  Vec<DataType*> old_generic_args = dt.generic_args;
  Vec<DataType*> old_tuple_members = dt.tuple_members;
  Vec<Node*> old_array_brackets = dt.array_brackets;
  flag old_has_fn_sig = dt.has_fn_sig;
  FnTypeSig* old_fn_sig = dt.fn_sig;
  *dt = replacement;
  _free_dtype_ptr_vec(&old_generic_args);
  _free_dtype_ptr_vec(&old_tuple_members);
  _free_node_ptr_vec(&old_array_brackets);
  if old_has_fn_sig && old_fn_sig != nil {
    _free_dtype_ptr_vec(&old_fn_sig.params);
    dtype_free(old_fn_sig.rtype);
    free(old_fn_sig);
  }
}

// A fresh, independently-owned clone of `*src`'s own contents, as a
// value rather than the pointer `dtype_clone` itself returns - frees
// that pointer's own outer shell immediately after moving its contents
// out, so a caller assigning straight into a local (`DataType x =
// _cloned_value(src);`) doesn't leak the shell `dtype_clone` malloc'd
// to carry it back.
fun _cloned_value(DataType* src) DataType {
  DataType* c = dtype_clone(src);
  DataType v = *c;
  free(c);
  ret v;
}

// Substitutes every bare occurrence of one of `params` (an alias's own
// declared type params) inside `dt` for the matching concrete argument
// in `args`, recursively through `dt`'s own generic_args and fn_sig.
// `spread_flags` (parallel to `params`) marks a param declared `(Name)`
// rather than bare `Name` - see `TypeAliasNode.type_param_is_spread`.
fun _substitute_params(
  DataType* dt,
  Vec<str>* params,
  Vec<DataType*>* args,
  Vec<flag>* spread_flags
) {
  if dt == nil {
    ret;
  }
  num i = 0;
  for i < dt.generic_args.len {
    _substitute_params(dt.generic_args.get(i), params, args, spread_flags);
    i = i + 1;
  }
  num ti = 0;
  for ti < dt.tuple_members.len {
    _substitute_params(dt.tuple_members.get(ti), params, args, spread_flags);
    ti = ti + 1;
  }
  if dt.has_fn_sig && dt.fn_sig != nil {
    // A `fun((Args)) Ret`-shaped alias body whose single parameter
    // position is bound BARE (no generic wrapping, no pointer) to a
    // param DECLARED as a spread param (`(Args)` in the alias's own
    // `<...>` list) and resolves to a real tuple spreads that tuple's
    // own members into separate positional C parameters here - `Args =
    // (num, dec, str)` expands `fun(Args) Ret` to `fun(num, dec, str)
    // Ret`, not a single tuple-struct parameter. An ordinary (bare,
    // non-spread) param keeps today's one-param-in, one-param-out shape
    // via the plain recursive path below, even when its own argument
    // happens to be a tuple - the explicit `(Args)` marker, not the
    // argument's own shape, is what decides spreading.
    Vec<DataType*> new_fn_params;
    new_fn_params.init(0);
    num p = 0;
    for p < dt.fn_sig.params.len {
      let prm = dt.fn_sig.params.get(p);
      flag spread = false;
      if prm.generic_args.len == 0 && !prm.is_tuple && prm.pointer_depth == 0 {
        num j2 = 0;
        for j2 < params.len && j2 < args.len && j2 < spread_flags.len {
          if equals(params.get(j2), prm.type_str) {
            let arg2 = args.get(j2);
            if spread_flags.get(j2) && arg2.is_tuple {
              for tm : arg2.tuple_members {
                new_fn_params.push(dtype_clone(tm));
              }
              spread = true;
            }
            break;
          }
          j2 = j2 + 1;
        }
      }
      if spread {
        dtype_free(prm);
      } else {
        _substitute_params(prm, params, args, spread_flags);
        new_fn_params.push(prm);
      }
      p = p + 1;
    }
    dt.fn_sig.params.free();
    dt.fn_sig.params = new_fn_params;
    _substitute_params(dt.fn_sig.rtype, params, args, spread_flags);
  }
  num j = 0;
  for j < params.len && j < args.len {
    if equals(params.get(j), dt.type_str) {
      DataType* arg = args.get(j);
      DataType sub = _cloned_value(arg);
      sub.pointer_depth = sub.pointer_depth + dt.pointer_depth;
      _replace_dtype(dt, sub);
      ret;
    }
    j = j + 1;
  }
}

// Expands any alias reference reachable through `dt` - its own base
// name, and recursively through generic_args/fn_sig regardless of
// whether the outer name is itself an alias (an alias can sit nested
// inside another type's own generic argument, e.g.
// `Vec<Callback<num, num>>`). Sets `*saw_unresolved` when `dt`'s own base
// name names a registered alias not yet resolved this round - used
// during the alias table's own self-resolution rounds to know when
// another round is still needed.
fun _expand_dtype(DataType* dt, Map<str, _ResolvedAlias>* resolved, flag* saw_unresolved) {
  if dt == nil {
    ret;
  }
  num i = 0;
  for i < dt.generic_args.len {
    _expand_dtype(dt.generic_args.get(i), resolved, saw_unresolved);
    i = i + 1;
  }
  num ti = 0;
  for ti < dt.tuple_members.len {
    _expand_dtype(dt.tuple_members.get(ti), resolved, saw_unresolved);
    ti = ti + 1;
  }
  if dt.has_fn_sig && dt.fn_sig != nil {
    num p = 0;
    for p < dt.fn_sig.params.len {
      _expand_dtype(dt.fn_sig.params.get(p), resolved, saw_unresolved);
      p = p + 1;
    }
    _expand_dtype(dt.fn_sig.rtype, resolved, saw_unresolved);
  }

  let found = resolved.at(dt.type_str);
  if found.is_none() {
    ret;
  }
  _ResolvedAlias ra = found.unwrap();
  if !ra.is_used {
    ra.is_used = true;
    resolved.put(dt.type_str, ra);
  }
  if !ra.is_resolved {
    *saw_unresolved = true;
    ret;
  }
  if ra.is_bound_list {
    // A bound-list alias referenced as an ordinary type is a real user
    // error (only valid inside a bound-list position) - left for
    // typecheck's own downstream "unknown type" diagnostic rather than
    // expanding to nonsense here.
    ret;
  }

  DataType expanded = _cloned_value(ra.body);
  if ra.type_params.len > 0 {
    _substitute_params(&expanded, &ra.type_params, &dt.generic_args, &ra.type_param_is_spread);
  }
  // A pointer applied at the reference site stacks onto whatever the
  // alias's own body already carries (`als P = num*; P* x;` -> num**).
  expanded.pointer_depth = expanded.pointer_depth + dt.pointer_depth;
  _replace_dtype(dt, expanded);
}

// Splices a resolved bound-list alias's own alternatives into
// `alternatives` in place of a reference to it by name, or substitutes
// an ordinary alias reference with its own rendered, fully-expanded
// text; leaves anything not naming a registered alias (a concrete type,
// a quirk name) untouched. Sets `*saw_unresolved` when an alternative
// names a registered alias not yet resolved this round.
fun _expand_bound_alternatives(Vec<str>* alternatives, Map<str, _ResolvedAlias>* resolved, flag* saw_unresolved) {
  Vec<str> out;
  out.init(alternatives.len);
  num i = 0;
  for i < alternatives.len {
    str alt = alternatives.get(i);
    i = i + 1;
    let found = resolved.at(alt);
    if found.is_none() {
      out.push(alt);
      continue;
    }
    _ResolvedAlias ra = found.unwrap();
    if !ra.is_used {
      ra.is_used = true;
      resolved.put(alt, ra);
    }
    if !ra.is_resolved {
      *saw_unresolved = true;
      out.push(alt);
      continue;
    }
    if ra.is_bound_list {
      num j = 0;
      for j < ra.bound_alternatives.len {
        out.push(ra.bound_alternatives.get(j));
        j = j + 1;
      }
    } else {
      out.push(render_datatype_bound(ra.body));
    }
  }
  alternatives.free();
  *alternatives = out;
}

// Walks every top-level declaration's own DataType-bearing positions and
// expands each in place: a function/method's own params and return type,
// a compound's own fields, a plain variable declaration's own type, a
// quirk method's own signature, and every generic bound-list's own
// alternatives (function, compound, and impl - a method's own bound list
// is covered via the function-shaped branch inside `.Impl`'s methods).
// `fit node.kind { .Function(f) -> {...} }` gives `f` as a plain VALUE
// copy of the payload, not a reference into `node` itself: mutating a
// pointer FIELD on that copy (`f.rtype`, a `DataType*`) still reaches
// the same shared, heap-allocated `DataType` the real node points to,
// but mutating a VALUE field (`f.type_param_forced_insts`, a
// `Vec<Vec<str>>`, not a pointer) only changes the copy - it is lost the
// instant this function returns unless written back into `node.kind`
// explicitly. Every branch below that touches a `Vec`-shaped value field
// (as opposed to a `DataType*` pointer field) reassigns `node.kind`
// afterward for exactly this reason.
fun _expand_program(Vec<Node>* nodes, Map<str, _ResolvedAlias>* resolved) {
  flag unused = false;
  num i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .Function(f) -> {
        _expand_function_shaped(&f, resolved, &unused);
        node.kind = .Function(f);
      }
      .Variable(v) -> { _expand_dtype(v.var_type, resolved, &unused); }
      .Compound(c) -> {
        num fi = 0;
        for fi < c.fields.len {
          CompoundField cf = c.fields.get(fi);
          fi = fi + 1;
          _expand_dtype(cf.dtype, resolved, &unused);
        }
        if c.has_type_param_forced_insts {
          _expand_forced_insts(&c.type_param_forced_insts, resolved, &unused);
          node.kind = .Compound(c);
        }
      }
      .Quirk(q) -> {
        num mi = 0;
        for mi < q.methods.len {
          QuirkMethodSig m = q.methods.get(mi);
          mi = mi + 1;
          _expand_dtype(m.rtype, resolved, &unused);
          num ai = 0;
          for ai < m.args.len {
            QuirkArg qa = m.args.get(ai);
            ai = ai + 1;
            _expand_dtype(qa.dtype, resolved, &unused);
          }
        }
      }
      .Impl(im) -> {
        if im.has_type_param_forced_insts {
          _expand_forced_insts(&im.type_param_forced_insts, resolved, &unused);
          node.kind = .Impl(im);
        }
        num mi = 0;
        for mi < im.methods.len {
          Node* m = im.methods.get(mi);
          mi = mi + 1;
          if m == nil {
            continue;
          }
          fit m.kind {
            .Function(f) -> {
              _expand_function_shaped(&f, resolved, &unused);
              m.kind = .Function(f);
            }
            _ -> {}
          }
        }
      }
      _ -> {}
    }
  }
}

fun _expand_function_shaped(FunctionNode* f, Map<str, _ResolvedAlias>* resolved, flag* unused) {
  if f.has_rtype {
    _expand_dtype(f.rtype, resolved, unused);
  }
  if f.has_args {
    num a = 0;
    for a < f.args.len {
      Node* arg = f.args.get(a);
      a = a + 1;
      if arg == nil {
        continue;
      }
      fit arg.kind {
        .Variable(v) -> { _expand_dtype(v.var_type, resolved, unused); }
        _ -> {}
      }
    }
  }
  if f.has_type_param_forced_insts {
    _expand_forced_insts(&f.type_param_forced_insts, resolved, unused);
  }
  if f.has_body {
    _expand_body(f.body, resolved, unused);
  }
}

// Walks a function/method body recursively for a local `Variable`
// declaration's own type - the only DataType-bearing position inside a
// body, alongside every statement kind that can nest a body of its own.
fun _expand_body(Node* stmt, Map<str, _ResolvedAlias>* resolved, flag* unused) {
  if stmt == nil {
    ret;
  }
  fit stmt.kind {
    .Body(b) -> {
      num i = 0;
      for i < b.statements.len {
        _expand_body(b.statements.get(i), resolved, unused);
        i = i + 1;
      }
    }
    .Variable(v) -> {
      _expand_dtype(v.var_type, resolved, unused);
      if v.has_val {
        _expand_body(v.val, resolved, unused);
      }
    }
    .StatementIf(ifn) -> { _expand_body(ifn.body, resolved, unused); }
    .StatementElseIf(ein) -> { _expand_body(ein.body, resolved, unused); }
    .StatementElse(b) -> { _expand_body(b, resolved, unused); }
    .StatementDefer(inner) -> { _expand_body(inner, resolved, unused); }
    .StatementFor(kind) -> {
      fit kind {
        .Cond(c) -> { _expand_body(c.body, resolved, unused); }
        .Iter(it) -> { _expand_body(it.body, resolved, unused); }
      }
    }
    .StatementFit(f) -> {
      num i = 0;
      for i < f.branches.len {
        FitBranch b = f.branches.get(i);
        i = i + 1;
        _expand_body(b.body, resolved, unused);
      }
    }
    .StatementFork(inner) -> { _expand_body(inner, resolved, unused); }
    _ -> {}
  }
}

// `insts` is one Cartesian-product row per combo, one bound string per
// type-param POSITION within each row (not a flat alternatives list) -
// `_expand_bound_alternatives` alone isn't the right shape here: splicing
// a bound-list alias's alternatives into a single position must multiply
// the number of ROWS (one per alternative), never grow one row's own
// entry count, or a later position's value would land in the wrong type
// param's slot. Rebuilds `insts` from scratch via a small per-row
// cross-product, mirroring the same Cartesian-product idiom
// `parse_type_params_with_constraints` itself already uses to build these
// rows in the first place.
fun _expand_forced_insts(Vec<Vec<str>>* insts, Map<str, _ResolvedAlias>* resolved, flag* unused) {
  Vec<Vec<str>> out;
  out.init(insts.len);
  num c = 0;
  for c < insts.len {
    Vec<str> combo = insts.get(c);
    c = c + 1;
    _expand_combo_into(&combo, resolved, unused, &out);
  }
  insts.free();
  *insts = out;
}

// Expands each position of `combo` independently (a position naming a
// bound-list alias becomes that many alternatives; a position naming an
// ordinary alias becomes its own single rendered text; anything else
// stays exactly one, unchanged) via `_expand_bound_alternatives` itself
// (run on a one-entry list, so its existing per-entry logic is the only
// place this decision is made), then cross-products across positions so
// every combination of an expanded position's own alternatives becomes
// its own row in `out`.
fun _expand_combo_into(Vec<str>* combo, Map<str, _ResolvedAlias>* resolved, flag* unused, Vec<Vec<str>>* out) {
  Vec<Vec<str>> per_position;
  per_position.init(combo.len);
  num i = 0;
  for i < combo.len {
    Vec<str> one;
    one.init(1);
    one.push(combo.get(i));
    _expand_bound_alternatives(&one, resolved, unused);
    per_position.push(one);
    i = i + 1;
  }

  Vec<Vec<str>> combos;
  combos.init(1);
  Vec<str> seed;
  seed.init(combo.len);
  combos.push(seed);
  num p = 0;
  for p < per_position.len {
    Vec<str> pos = per_position.get(p);
    p = p + 1;
    Vec<Vec<str>> next;
    next.init(0);
    num e = 0;
    for e < combos.len {
      Vec<str> existing = combos.get(e);
      e = e + 1;
      num a = 0;
      for a < pos.len {
        str alt = pos.get(a);
        a = a + 1;
        Vec<str> grown;
        grown.init(existing.len + 1);
        num k = 0;
        for k < existing.len {
          grown.push(existing.get(k));
          k = k + 1;
        }
        grown.push(alt);
        next.push(grown);
      }
      existing.free();
    }
    combos.free();
    combos = next;
    pos.free();
  }
  per_position.free();

  num r = 0;
  for r < combos.len {
    out.push(combos.get(r));
    r = r + 1;
  }
  combos.free();
}

// Expands every `als` reference anywhere in `nodes` before typecheck
// ever runs - see the file-level note above. A no-op (fast path) when
// the program declares no aliases at all. Returns an error message for
// a duplicate alias name or a real reference cycle among aliases
// themselves; both are real compile errors, not something to silently
// paper over.
pub fun expand_type_aliases(Vec<Node>* nodes) Option<str> {
  // Omitted trailing type arguments are filled from their declarations'
  // defaults first, so an alias body and every reference below already
  // reads as fully written out.
  let defaults_err = fill_generic_defaults(nodes);
  if defaults_err.is_some() {
    ret defaults_err;
  }
  Map<str, TypeAliasNode> raw_aliases;
  raw_aliases.init(8);
  num i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .TypeAlias(a) -> {
        if raw_aliases.has(a.name) {
          raw_aliases.free();
          ret .Some(format("type alias '{str}' is declared more than once", a.name));
        }
        raw_aliases.put(a.name, a);
      }
      _ -> {}
    }
  }
  if raw_aliases.len() == 0 {
    raw_aliases.free();
    ret .None;
  }

  // An alias name colliding with another top-level declaration is caught
  // here, not by typecheck's own `_check_duplicate_top_level`: that
  // registration pass has no `.TypeAlias` case at all (an alias is never
  // itself a typechecked declaration, only ever a stand-in expanded away
  // before typecheck runs), so without this check the collision would go
  // completely unnoticed and this function would silently replace every
  // real reference to the other declaration with the alias's own body
  // instead. Matches `_check_duplicate_top_level`'s own checked kinds
  // exactly (function, compound, enum, global variable) - quirks aren't
  // checked against each other today either, so they're left out here too
  // rather than holding aliases to a stricter standard than everything
  // else.
  num ci = 0;
  for ci < nodes.len {
    Node* node = &nodes.data[ci];
    ci = ci + 1;
    str other_name = "";
    fit node.kind {
      .Function(f) -> {
        if f.has_name {
          other_name = f.name;
        }
      }
      .Compound(c) -> { other_name = c.name; }
      .Enum(e) -> { other_name = e.name; }
      .Variable(v) -> { other_name = v.name; }
      _ -> {}
    }
    if equals(other_name, "") {
      continue;
    }
    if raw_aliases.has(other_name) {
      raw_aliases.free();
      ret .Some(format("'{str}' is already declared as a type alias", other_name));
    }
  }

  // Resolve the alias table against itself: an alias's own body may
  // reference another alias, so this repeats until a full round leaves
  // nothing unresolved. Bounded by names.len + 1 rounds - a genuine
  // chain among N aliases resolves in at most N rounds, so anything
  // still unresolved after one more is a real cycle, not a slow chain.
  Vec<str> names = raw_aliases.keys();
  Map<str, _ResolvedAlias> resolved;
  resolved.init(names.len);
  num ni = 0;
  for ni < names.len {
    resolved.put(names.get(ni), _unresolved_marker());
    ni = ni + 1;
  }

  num round = 0;
  flag any_left = true;
  for round < names.len + 1 && any_left {
    any_left = false;
    num r = 0;
    for r < names.len {
      str name = names.get(r);
      r = r + 1;
      TypeAliasNode a = raw_aliases.at(name).unwrap();
      flag saw_unresolved = false;
      if a.is_bound_list {
        _expand_bound_alternatives(&a.bound_alternatives, &resolved, &saw_unresolved);
      } else {
        _expand_dtype(a.body, &resolved, &saw_unresolved);
      }
      raw_aliases.put(name, a);
      // A prior name processed earlier in this same round may already
      // have marked this alias `is_used` (by referencing it in its own
      // body) - preserve that instead of resetting it back to false here.
      flag prev_used = false;
      let prev = resolved.at(name);
      if prev.is_some() {
        prev_used = prev.unwrap().is_used;
      }
      resolved.put(
        name,
        _ResolvedAlias{
        is_resolved = !saw_unresolved,
        type_params = a.type_params,
        type_param_is_spread = a.type_param_is_spread,
        is_bound_list = a.is_bound_list,
        body = a.body,
        bound_alternatives = a.bound_alternatives,
        is_used = prev_used}

      );
      if saw_unresolved {
        any_left = true;
      }
    }
    round = round + 1;
  }

  if any_left {
    names.free();
    raw_aliases.free();
    resolved.free();
    ret .Some("type aliases form a reference cycle");
  }

  _expand_program(nodes, &resolved);

  // Every real reference just got erased by the substitution above -
  // record each alias's own final `is_used` verdict back onto its real
  // declaration node now, while `resolved` still has it, so the
  // `unused_type_alias` warning (which runs after this pass) has
  // something to check.
  num wi = 0;
  for wi < nodes.len {
    Node* node = &nodes.data[wi];
    wi = wi + 1;
    fit node.kind {
      .TypeAlias(a) -> {
        let ra = resolved.at(a.name);
        if ra.is_some() {
          a.was_used = ra.unwrap().is_used;
          node.kind = .TypeAlias(a);
        }
      }
      _ -> {}
    }
  }

  names.free();
  raw_aliases.free();
  resolved.free();
  ret .None;
}

// Propagates each `TypeAlias` declaration's own `was_used` flag from one
// node list to another, matched by name.
//
// A caller that runs `expand_type_aliases` against one tree but reports
// `unused_type_alias` against a different one (the CLI's own
// `entry_nodes`, kept as a separate parse from `nodes` so warnings stay
// scoped to declarations in the entry file; fls's own disposable
// expansion clone, kept separate from the shared, cached tree hover and
// completion read from) needs this: expansion only ever stamps the flag
// onto the exact `Node` objects it walked, and the flag is lost the
// moment that tree goes out of scope otherwise.
pub fun sync_type_alias_usage(Vec<Node>* from, Vec<Node>* to) {
  Set<str> used_names = set_init("", 8);
  defer used_names.free();
  num i = 0;
  for i < from.len {
    Node* node = &from.data[i];
    i = i + 1;
    fit node.kind {
      .TypeAlias(a) -> {
        if a.was_used {
          used_names.add(a.name);
        }
      }
      _ -> {}
    }
  }

  i = 0;
  for i < to.len {
    Node* node = &to.data[i];
    i = i + 1;
    fit node.kind {
      .TypeAlias(a) -> {
        a.was_used = used_names.has(a.name);
        node.kind = .TypeAlias(a);
      }
      _ -> {}
    }
  }
}
