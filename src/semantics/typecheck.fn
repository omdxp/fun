// Type checking.
// 
// The checker walks each function body with the types of everything in
// scope, infers the type of every expression it meets, and reports the
// first place where a value cannot stand for the type expected of it.
// Anything it cannot resolve infers as unknown, which stands for any
// type, so a gap in the checker never rejects a correct program.

use ..ast.ast;
use ..lexer.token;
use ..parser.datatype_defs;
use std.string;
use std.io;
use std.vec;
use std.map;
use std.set;
use std.option;
use std.result;

// What a value is, as far as the checker can tell.
pub compound CheckedType {
  DataTypeType base;
  flag is_array;
  num array_depth;
  num pointer_depth;
  // `nil`, which stands for a pointer or a string of any type.
  flag is_null_literal;
  // `panic(...)`, which never produces a value and so stands for any
  // type expected of it.
  flag is_panic_literal;
  // The written name of a user-defined type, empty for a builtin.
  str name;
  // The arguments a generic instantiation supplied, in the order the
  // type declares its parameters.
  Vec<CheckedType> generic_args;
  // A function-typed value's own declared signature (`fun(T1, T2) R`),
  // carried through so a value bound to it (a name referencing a known
  // top-level function, or another function-typed local) can be checked
  // against it, rather than degrading to unknown.
  flag has_fn_sig;
  FnTypeSig* fn_sig;
  // A real tuple type (`(num, str)`). Like a function type, this has no
  // `name` of its own, so `is_unknown` must never treat one as
  // unresolved just because `name` is empty.
  flag is_tuple;
  Vec<CheckedType> tuple_members;
}

pub fun checked_unknown() CheckedType {
  CheckedType t;
  t.base = .Unknown;
  t.is_array = false;
  t.array_depth = 0;
  t.pointer_depth = 0;
  t.is_null_literal = false;
  t.is_panic_literal = false;
  t.name = "";
  t.generic_args.init(0);
  t.has_fn_sig = false;
  t.fn_sig = nil;
  t.is_tuple = false;
  t.tuple_members.init(0);
  ret t;
}

pub fun checked_of(DataTypeType base) CheckedType {
  CheckedType t = checked_unknown();
  t.base = base;
  ret t;
}

// The checked form of a written type annotation.
pub fun checked_from_dtype(DataType* dt) CheckedType {
  CheckedType t = checked_unknown();
  if dt == nil {
    ret t;
  }
  t.base = dt.kind;
  t.is_array = dt.is_array;
  t.array_depth = dt.array_depth;
  // An array written without a size carries no depth of its own, but it
  // is still one deep.
  if t.is_array && t.array_depth == 0 {
    t.array_depth = 1;
  }
  t.pointer_depth = dt.pointer_depth;
  if dt.flags.is_pointer && t.pointer_depth == 0 {
    t.pointer_depth = 1;
  }
  if t.base == .Unknown {
    t.name = dt.type_str;
  }
  num i = 0;
  for i < dt.generic_args.len {
    t.generic_args.push(checked_from_dtype(dt.generic_args.get(i)));
    i = i + 1;
  }
  t.has_fn_sig = dt.has_fn_sig;
  t.fn_sig = dt.fn_sig;
  t.is_tuple = dt.is_tuple;
  num ti = 0;
  for ti < dt.tuple_members.len {
    t.tuple_members.push(checked_from_dtype(dt.tuple_members.get(ti)));
    ti = ti + 1;
  }
  ret t;
}

// Replaces each type parameter in `t` with what the instantiation
// supplied for it, leaving anything else as written.
pub fun substitute(CheckedType t, Vec<str>* params, Vec<CheckedType>* args) CheckedType {
  if params.len == 0 || args.len == 0 {
    ret t;
  }
  num i = 0;
  for i < params.len && i < args.len {
    if !equals(t.name, "") && equals(params.get(i), t.name) {
      // The parameter stands for the argument, while whatever was
      // written around it (a pointer, an array) still applies.
      CheckedType out = args.get(i);
      out.pointer_depth = out.pointer_depth + t.pointer_depth;
      if t.is_array {
        out.is_array = true;
        out.array_depth = out.array_depth + t.array_depth;
      }
      ret out;
    }
    i = i + 1;
  }
  ret t;
}

// A name the checker cannot resolve stands for any type, so it never
// rejects what it does not understand.
pub fun is_unknown(CheckedType t) flag {
  if t.base != .Unknown {
    ret false;
  }
  // A tuple has no `name` of its own, same as a function type already
  // carries `has_fn_sig` instead of a name - neither is "the checker
  // doesn't understand this", so neither reaches the empty-name check
  // below, which exists for a genuine placeholder/unresolved reference.
  if t.is_tuple || t.has_fn_sig {
    ret false;
  }
  // A `let` carries a placeholder until its value is known, which is
  // exactly what the checker fills in.
  ret equals(t.name, "") || equals(t.name, LET_INFER_TYPE);
}

// The placeholder the parser writes for a `let` declaration's type.
pub const str LET_INFER_TYPE = "__let_infer__";

pub fun type_name(CheckedType t) str {
  if t.is_tuple {
    StringBuilder tb = string_builder_init(16);
    tb.append("(");
    num ti = 0;
    for ti < t.tuple_members.len {
      if ti > 0 {
        tb.append(", ");
      }
      tb.append(type_name(t.tuple_members.get(ti)));
      ti = ti + 1;
    }
    tb.append(")");
    num pi = 0;
    for pi < t.pointer_depth {
      tb.append("*");
      pi = pi + 1;
    }
    ret tb.build();
  }
  str base = "unknown";
  fit t.base {
    .Void -> { base = "void"; }
    .Raw -> { base = "raw"; }
    .Chr -> { base = "chr"; }
    .Str -> { base = "str"; }
    .Dec -> { base = "dec"; }
    .Num -> { base = "num"; }
    .Bin -> { base = "flag"; }
    .Unknown -> {
      if !equals(t.name, "") {
        base = t.name;
      }
    }
  }
  StringBuilder b = string_builder_init(len(base) + 4);
  b.append(base);
  // What a generic was instantiated with is part of what it is: without
  // this, two different instantiations both read as `Box` and a message
  // about them says nothing.
  if t.generic_args.len > 0 {
    b.append("<");
    num g = 0;
    for g < t.generic_args.len {
      if g > 0 {
        b.append(", ");
      }
      b.append(type_name(t.generic_args.get(g)));
      g = g + 1;
    }
    b.append(">");
  }
  num i = 0;
  for i < t.pointer_depth {
    b.append("*");
    i = i + 1;
  }
  i = 0;
  for i < t.array_depth {
    b.append("[]");
    i = i + 1;
  }
  ret b.build();
}

// The name an instantiation is registered under, which carries its
// arguments the way an impl on a concrete instantiation is written
// (`impl Vec<str>` registers as `Vec__str`).
pub fun mangled_name(CheckedType t) str {
  if t.generic_args.len == 0 {
    ret t.name;
  }
  StringBuilder b = string_builder_init(len(t.name) + 8);
  b.append(t.name);
  num i = 0;
  for i < t.generic_args.len {
    b.append("__");
    b.append(mangled_name(t.generic_args.get(i)));
    i = i + 1;
  }
  ret b.build();
}

// True when a value of type `from` can stand where `to` is expected.
pub fun can_assign(CheckedType to, CheckedType from) flag {
  if is_unknown(to) || is_unknown(from) {
    ret true;
  }
  if from.is_panic_literal {
    ret true;
  }
  // `nil`, and the zero it is written as, stand for any pointer, and
  // for a string, which is one. Zero remains a number besides.
  if from.is_null_literal &&
    (to.pointer_depth > 0 || to.base == .Str || to.base == .Raw) {
    ret true;
  }
  // A raw pointer stands for any pointer, in either direction, and a
  // string is a pointer.
  if to.base == .Raw &&
  (from.pointer_depth > 0 || from.base == .Str) {
    ret true;
  }
  // A raw pointer stands for any pointer, and for the array storage a
  // pointer is how you allocate.
  if from.base == .Raw &&
  (to.pointer_depth > 0 || to.is_array || to.base == .Str) {
    ret true;
  }
  // An array stands for a pointer to what it holds, as it does in C,
  // and an array of characters is what a string is.
  if from.is_array && !to.is_array {
    if to.base == .Str && from.base == .Chr {
      ret true;
    }
    // An array of depth N stands for a pointer of depth N.
    if to.pointer_depth == from.array_depth + from.pointer_depth {
      if to.base == .Raw {
        ret true;
      }
      ret to.base == from.base && equals(to.name, from.name);
    }
  }
  if to.pointer_depth != from.pointer_depth {
    ret false;
  }
  if to.array_depth != from.array_depth {
    ret false;
  }
  // A whole number widens into a decimal, but a decimal does not narrow
  // back into one without being asked to.
  if _is_numeric(to) && _is_numeric(from) {
    ret to.base == .Dec || from.base != .Dec;
  }
  if to.base != from.base {
    ret false;
  }
  if to.base == .Unknown {
    // A tuple has no `name` of its own (both sides would read "" and
    // wrongly compare equal below) - arity is the only check this
    // standalone, `self`-less function can make; per-element
    // compatibility is `assignable`'s own job, via `tuple_members_agree`.
    if to.is_tuple || from.is_tuple {
      if !to.is_tuple || !from.is_tuple {
        ret false;
      }
      ret to.tuple_members.len == from.tuple_members.len;
    }
    ret equals(to.name, from.name);
  }
  ret true;
}

fun _is_numeric(CheckedType t) flag {
  if t.pointer_depth > 0 || t.is_array {
    ret false;
  }
  // A truth value is not a number: it neither widens into one nor
  // stands for one.
  ret t.base == .Num || t.base == .Dec || t.base == .Chr;
}

// What a function accepts and returns.
pub compound FnSig {
  CheckedType rtype;
  Vec<CheckedType> args;
  // The number of leading parameters a caller must pass; the rest carry
  // defaults.
  num min_args;
  flag is_variadic;
  flag is_async;
  // A generic function's checks are left to the instantiation, since a
  // type parameter stands for whatever the call site supplies.
  flag is_generic;
  // Set when the name belongs to more than one declaration, where a
  // call cannot be matched to one of them by name alone.
  flag ambiguous;
  // Where the function was declared, and whether it is offered to other
  // files.
  str file;
  flag is_public;
  // The type parameters the declaration names, the types each one is
  // allowed to stand for (empty where unconstrained), and, per
  // parameter, the type parameter it is written as (empty otherwise).
  Vec<str> type_params;
  Vec<Vec<str>> bounds;
  Vec<str> arg_params;
}

// A method call's own resolved signature, alongside the receiver's own
// checked type (its generic args among them), needed to substitute a
// generic method's type parameters into a nested function-typed
// parameter's own signature.
pub compound MethodResolution {
  FnSig sig;
  CheckedType receiver;
}

// What a top-level variable offers, and where it was declared.
compound GlobalInfo {
  str file;
  flag is_public;
}

// Where checking failed, and why.
pub compound TypeError {
  str message;
  Pos pos;
  flag has_pos;
}

fun _error(str message, Node* node) TypeError {
  TypeError e;
  e.message = message;
  e.has_pos = false;
  if node != nil && node.has_pos {
    e.pos = node.pos;
    e.has_pos = true;
  }
  ret e;
}

// A name in scope: what it holds, and whether it may be assigned again.
pub compound Binding {
  CheckedType type;
  flag is_const;
}

// The names in scope, innermost last.
pub compound TypeEnv {
  Vec<Map<str, Binding>> scopes;
}

pub fun type_env_new() TypeEnv {
  TypeEnv e;
  e.scopes.init(4);
  ret e;
}

impl TypeEnv {
  pub push() {
    Map<str, Binding> scope;
    scope.init(8);
    self.scopes.push(scope);
  }

  pub pop() {
    if self.scopes.len == 0 {
      ret;
    }
    Map<str, Binding> scope = self.scopes.pop();
    scope.free();
  }

  pub define(str name, CheckedType type) {
    self.bind(name, type, false);
  }

  pub bind(str name, CheckedType type, flag is_const) {
    if self.scopes.len == 0 {
      self.push();
    }
    Binding b;
    b.type = type;
    b.is_const = is_const;
    self.scopes.data[self.scopes.len - 1].put(name, b);
  }

  // What `name` is bound to, searching inner scopes first.
  pub binding(str name) Option<Binding> {
    num i = self.scopes.len;
    for i > 0 {
      i = i - 1;
      let found = self.scopes.data[i].at(name);
      if found.is_some() {
        ret found;
      }
    }
    ret .None;
  }

  // The type bound to `name`, searching inner scopes first.
  pub lookup(str name) Option<CheckedType> {
    ret .Some(self.binding(name)?.type);
  }

  pub free() {
    for self.scopes.len > 0 {
      self.pop();
    }
    self.scopes.free();
  }
}

// What a compound holds, keyed by field name.
compound CompoundInfo {
  Map<str, CheckedType> fields;
  // Where the compound was declared, and whether it is offered to other
  // files.
  str file;
  flag is_public;
  // The parameters the fields are written in terms of, which an
  // instantiation supplies arguments for, and the combinations of
  // concrete types those parameters are allowed to stand for.
  Vec<str> type_params;
  Vec<Vec<str>> bounds;
  // A generic compound's fields mention its type parameters, which
  // stand for whatever an instantiation supplies.
  flag is_generic;
}

// The methods declared on a type, keyed by method name. A quirk's
// methods are registered the same way, since a call reads the same.
compound MethodTable {
  Map<str, FnSig> methods;
}

// Frees a compound's own scratch: `.fields`'s own CheckedType values
// alias the declaring CompoundNode's own AST fields, so only the map
// itself needs freeing, the same shallow convention as `_free_fn_sig`.
fun _free_compound_info(CompoundInfo* info) {
  info.fields.free();
  info.type_params.free();
  info.bounds.free();
}

// Frees every compound's own scratch (`_free_compound_info`), then
// the map itself.
fun _free_compound_info_map(Map<str, CompoundInfo>* compounds) {
  Vec<str> names = compounds.keys();
  defer names.free();
  num i = 0;
  for i < names.len {
    CompoundInfo info = compounds.at(names.get(i)).unwrap();
    _free_compound_info(&info);
    i = i + 1;
  }
  compounds.free();
}

fun _method_table_new() MethodTable {
  MethodTable t;
  t.methods.init(8);
  ret t;
}

// Frees a signature's own scratch. Shallow throughout: `.args`'s own
// CheckedType values, `.type_params`'s own strings, and each inner
// Vec `.bounds` holds all alias the declaring FunctionNode's own AST
// fields (or a token's text, transitively) rather than owning fresh
// copies - only the four Vec containers themselves are this call's
// own to free, never what's inside them.
fun _free_fn_sig(FnSig* sig) {
  sig.args.free();
  sig.type_params.free();
  sig.bounds.free();
  sig.arg_params.free();
}

// Frees a whole `Map<str, FnSig>`: every signature's own scratch
// (`_free_fn_sig`), then the map itself.
fun _free_variant_owners_map(Map<str, Vec<str>>* owners) {
  Vec<str> names = owners.keys();
  defer names.free();
  for name : names {
    Vec<str> bucket = owners.at(name).unwrap();
    for owner : bucket {
      free(owner);
    }
    bucket.free();
  }
  owners.free();
}

// Frees a whole `Map<str, Set<str>>` where every value's own strings are
// borrowed from the AST (never a fresh allocation): unlike
// `_free_variant_owners_map`'s buckets, only each `Set<str>` and the map
// itself need freeing, not the strings inside.
fun _free_quirk_implementors_map(Map<str, Set<str>>* implementors) {
  Vec<str> names = implementors.keys();
  defer names.free();
  for name : names {
    Set<str> bucket = implementors.at(name).unwrap();
    bucket.free();
  }
  implementors.free();
}

// The variant name a bare enum-variant shorthand initializer names,
// whether payload-less (`.Same`) or carrying one (`.Same(5)`, parsed as
// a call whose callee is the same dot-shorthand shape). `.None` for
// anything else, including an already-qualified `Enum.Variant` (which
// names its own enum directly and needs no resolution here).
fun _bare_enum_shorthand_variant(Node* val) Option<str> {
  if val == nil {
    ret .None;
  }
  fit val.kind {
    .Expression(e) -> {
      if equals(e.op, "()") && e.has_left {
        ret _bare_enum_shorthand_variant(e.left);
      }
      if equals(e.op, ".") && e.has_left && e.has_right {
        flag left_is_blank = false;
        fit e.left.kind {
          .Blank -> { left_is_blank = true; }
          _ -> {}
        }
        if left_is_blank {
          fit e.right.kind {
            .Identifier(name) -> { ret .Some(name); }
            _ -> {}
          }
        }
      }
    }
    _ -> {}
  }
  ret .None;
}

fun _free_fn_sig_map(Map<str, FnSig>* fns) {
  Vec<str> names = fns.keys();
  defer names.free();
  num i = 0;
  for i < names.len {
    FnSig sig = fns.at(names.get(i)).unwrap();
    _free_fn_sig(&sig);
    i = i + 1;
  }
  fns.free();
}

// Frees every method table's own signature map, then the table of
// tables itself.
fun _free_method_tables(Map<str, MethodTable>* methods) {
  Vec<str> names = methods.keys();
  defer names.free();
  num i = 0;
  for i < names.len {
    MethodTable t = methods.at(names.get(i)).unwrap();
    _free_fn_sig_map(&t.methods);
    i = i + 1;
  }
  methods.free();
}

// The bare name of a method whose declared name carries the type it
// belongs to, as `Counter__add` carries `Counter`.
// Drops a method's receiver, which is declared as its first parameter
// but supplied by the call's receiver rather than its arguments.
fun _without_self(FnSig sig, FunctionNode f) FnSig {
  if f.args.len == 0 {
    ret sig;
  }
  flag leads_with_self = false;
  Node* first = f.args.get(0);
  fit first.kind {
    .Variable(v) -> { leads_with_self = equals(v.name, "self"); }
    _ -> {}
  }
  if !leads_with_self {
    ret sig;
  }
  FnSig out = sig;
  out.args.init(sig.args.len);
  num i = 1;
  for i < sig.args.len {
    out.args.push(sig.args.get(i));
    i = i + 1;
  }
  // What each argument was written as has to lose its first entry too:
  // a call names arguments after `self`, and the two lists are read
  // side by side. Leaving this one long shifted every argument by a
  // place, so a method's own bound was tested against `self` and never
  // against what the call supplied.
  out.arg_params.init(sig.arg_params.len);
  num a = 1;
  for a < sig.arg_params.len {
    out.arg_params.push(sig.arg_params.get(a));
    a = a + 1;
  }
  out.min_args = sig.min_args;
  if out.min_args > 0 {
    out.min_args = out.min_args - 1;
  }
  ret out;
}

fun _method_leaf_name(str declared, str type_name) str {
  _ = type_name;
  // The declared name carries the type, and a quirk impl's carries the
  // quirk as well, so the call's own name is what follows the last
  // separator.
  num cut = -1;
  num i = 0;
  for i + 1 < len(declared) {
    if declared[i] == '_' && declared[i + 1] == '_' {
      cut = i + 2;
      // Skips past the whole separator just matched, rather than just
      // one char: a leaf name that itself starts with `_` (`_next_inner`)
      // mangles to three underscores in a row (`Box___next_inner`), and
      // advancing by 1 would re-match the second/third as its own
      // separator, cutting one underscore too many off the leaf name.
      i = i + 2;
      continue;
    }
    i = i + 1;
  }
  if cut < 0 || cut >= len(declared) {
    ret declared;
  }
  ret substr(declared, cut, len(declared) - cut);
}

test "_method_leaf_name keeps a leaf name's own leading underscore" {
  // Regression: a leaf name starting with `_` (a private method,
  // `_next_inner`) mangles to three underscores in a row at the
  // boundary (`Box___next_inner`); the scan used to re-match the
  // second/third underscore as its own separator, stripping the leaf's
  // own leading `_` and registering it under the wrong key.
  assert equals(_method_leaf_name("Box___next_inner", "Box"), "_next_inner"),
  "expected the leaf's own leading underscore to survive";
  assert equals(_method_leaf_name("Box__half", "Box"), "half"),
  "expected an ordinary (non-underscore) leaf name to still strip cleanly";
  assert equals(_method_leaf_name("Box__Lenable__wrap", "Box"), "wrap"),
  "expected a quirk-mangled name to still cut at its last separator";
  assert equals(_method_leaf_name("Box__Lenable___wrap", "Box"), "_wrap"),
  "expected a quirk-mangled name whose leaf also starts with '_' to keep it too";
}

// The signature a quirk's method declaration promises.
fun _signature_of_quirk_method(QuirkMethodSig m) FnSig {
  FnSig sig;
  sig.args.init(m.args.len);
  sig.rtype = checked_unknown();
  if m.rtype != nil {
    sig.rtype = checked_from_dtype(m.rtype);
  }
  sig.is_variadic = false;
  sig.is_async = m.is_async;
  sig.is_generic = false;
  sig.ambiguous = false;
  sig.min_args = m.args.len;
  // A quirk method has no privacy of its own: naming the quirk is what
  // grants access to it, not which file declared it, so this reads as
  // public everywhere `check_visibility` looks.
  sig.file = "";
  sig.is_public = true;
  sig.type_params.init(0);
  sig.bounds.init(0);
  sig.arg_params.init(0);
  for a : m.args {
    sig.args.push(checked_from_dtype(a.dtype));
  }
  ret sig;
}

// What the checker carries while walking one program.
// Where a top-level name was first declared, and what it was: a
// function, a global variable, a compound, or an enum. Every one of
// these lowers to its own top-level C symbol or typedef, so two of them
// sharing a name is a real collision regardless of which kinds they
// are - not just two functions, or two globals.
compound TopLevelSite {
  str kind;
  str file;
  num line;
}

compound Checker {
  Map<str, FnSig> fns;
  // Every function/global-variable/compound/enum name declared so far,
  // to catch two of them sharing a name before codegen ever runs - the
  // C compiler would otherwise be the one to notice, far from the
  // actual cause and in terms the program's own source never used.
  Map<str, TopLevelSite> declared_at;
  // The quirks a program declares. A pointer to a compound that
  // implements one stands where the quirk is expected.
  Set<str> quirks;
  // Quirk name -> the type_name of every impl block that implements it
  // (both a generic impl's own bare template name, e.g. `impl Vec<T> as
  // Renderable` -> "Vec", and a monomorphizing impl's mangled concrete
  // name, e.g. `impl Vec<num> as Renderable` -> "Vec__num" - see
  // `implements_quirk`, which tries both forms the same way
  // `receiver_method` does for method lookup). Used to check a real
  // `impl X as Quirk` relationship for a generic bound naming a quirk
  // (`T: Renderable`), as opposed to `assignable`'s coarser
  // any-pointer-satisfies-any-quirk approximation used for ordinary
  // quirk-typed-parameter coercion - the two are deliberately different
  // strictness levels, not a shared notion of "satisfies this quirk".
  Map<str, Set<str>> quirk_implementors;
  // A quirk implementor's own declared argument type for that quirk
  // (`Range` -> `num` for `impl Range as Iterator<num>`), keyed by
  // `"{type_name}::{quirk_name}"` - lets a for-loop's own general
  // `Iterator<T>` element-type resolution read the real `Elem` a type
  // declared, not just confirm the relationship exists the way
  // `implements_quirk` alone does. Absent for a bare `as Quirk` with no
  // argument, or a symbolic binding whose argument is the enclosing
  // impl's own erased type param (never independently useful without
  // that impl's own concrete instantiation).
  Map<str, CheckedType> quirk_elem_by_type;
  // Enums whose variants carry no payload, which stand for the numbers
  // they are written as.
  Set<str> plain_enums;
  // What each top-level variable offers, so a read from another file can
  // be held to it.
  Map<str, GlobalInfo> globals;
  // Every enum the program declares, whether or not its variants carry
  // payloads. `plain_enums` holds only the ones that read as numbers.
  Set<str> enum_names;
  // Every enum name that declares a variant by that name, keyed by the
  // variant's own bare name (`"Some"` -> `["Option", "Result"]`).
  // Resolving a bare shorthand (`.Some`) with no declared type to lean
  // on needs to know whether exactly one enum owns that name.
  Map<str, Vec<str>> variant_owners;
  // What each declared compound holds, and what each type and quirk
  // declares as methods.
  Map<str, CompoundInfo> compounds;
  Map<str, MethodTable> methods;
  // The file whose declarations are being checked, so a name declared
  // elsewhere can be held to what its own file offers.
  str current_file;
  // The return type of the function being walked, and whether it may
  // await.
  CheckedType rtype;
  flag in_async;
  // The type parameters the declaration being walked names. They stand
  // for types the checker never sees, so a name among them is a type
  // rather than one nothing declares.
  Vec<str> active_type_params;
  flag failed;
  TypeError error;
}

fun _checker_new() Checker {
  Checker c;
  c.active_type_params.init(4);
  c.fns.init(32);
  c.declared_at.init(32);
  c.quirks = set_init("", 16);
  c.quirk_implementors.init(16);
  c.quirk_elem_by_type.init(16);
  c.plain_enums = set_init("", 16);
  c.globals.init(16);
  c.enum_names = set_init("", 16);
  c.variant_owners.init(16);
  c.compounds.init(16);
  c.methods.init(16);
  c.current_file = "";
  c.rtype = checked_unknown();
  c.in_async = false;
  c.failed = false;
  ret c;
}

impl Checker {
  // Records the methods an impl block supplies for its type. A generic
  // impl's methods mention type parameters, which stand for whatever an
  // instantiation supplies.
  register_impl(ImplNode block) {
    let existing = self.methods.at(block.type_name);
    MethodTable table = _method_table_new();
    if existing.is_some() {
      table = existing.unwrap();
    }
    for m : block.methods {
      fit m.kind {
        .Function(f) -> {
          if !f.has_name {
            continue;
          }
          FnSig sig = _without_self(_signature_of(f), f);
          if block.has_type_params && block.type_params.len > 0 {
            sig.is_generic = true;
            sig = _erase_signature(sig, &block.type_params);
          }
          // `_signature_of` always leaves `is_public`/`file` at their
          // defaults (it only sees the bare `FunctionNode`, not the
          // wrapping `Node` a method's own `pub`/position live on), so a
          // non-pub method's call through a value receiver was never
          // held to it: `check_visibility` treats an empty `file` as "no
          // module to compare against" and lets everything through.
          sig.is_public = m.flags.is_public;
          if m.has_pos {
            sig.file = m.pos.filename;
          }
          // A method's declared name carries the type it belongs to
          // (`Counter__add`), while a call names it on its own.
          table.methods.put(_method_leaf_name(f.name, block.type_name), sig);
        }
        _ -> {}
      }
    }
    self.methods.put(block.type_name, table);
  }

  // Records that `type_name` (a bare template name or a mangled concrete
  // instantiation, exactly as `ImplNode.type_name` carries it) has a real
  // `impl ... as quirk_name { ... }` block, for `implements_quirk` below.
  record_quirk_impl(str type_name, str quirk_name) {
    let existing = self.quirk_implementors.at(quirk_name);
    if existing.is_some() {
      Set<str> bucket = existing.unwrap();
      bucket.add(type_name);
      self.quirk_implementors.put(quirk_name, bucket);
    } else {
      Set<str> bucket = set_init("", 4);
      bucket.add(type_name);
      self.quirk_implementors.put(quirk_name, bucket);
    }
  }

  // True when `t` is a real, registered implementor of `quirk` - a
  // genuine `impl X as quirk { ... }` block was seen for it, not just
  // "any pointer satisfies any quirk" (`assignable`'s coarser check,
  // left as-is for ordinary quirk-typed-parameter coercion). Tries both
  // the mangled concrete-instantiation name and the bare type name, the
  // same lookup order `receiver_method` already uses for method lookup.
  implements_quirk(CheckedType t, str quirk_name) flag {
    let bucket_opt = self.quirk_implementors.at(quirk_name);
    if bucket_opt.is_none() {
      ret false;
    }
    Set<str> implementors = bucket_opt.unwrap();
    CheckedType named = t;
    named.name = self.canonical_type_name(t.name);
    str mangled = mangled_name(named);
    if !equals(mangled, named.name) && implementors.has(mangled) {
      ret true;
    }
    ret implementors.has(named.name);
  }

  // `t`'s own declared argument type for `quirk_name` (`Elem` in
  // `Iterator<Elem>`), substituted against `t`'s own concrete
  // `generic_args` when the implementor is itself generic - `Elem` for
  // `RingBuf<num>` implementing `Iterator<T>` on its own type param `T`
  // is `num`, not the bare `T` `quirk_elem_by_type` recorded at
  // registration time. `.None` when `t` doesn't implement `quirk_name`
  // at all, or the impl took no argument for it.
  quirk_arg_of(CheckedType t, str quirk_name) Option<CheckedType> {
    if !self.implements_quirk(t, quirk_name) {
      ret .None;
    }
    CheckedType named = t;
    named.name = self.canonical_type_name(t.name);
    str mangled = mangled_name(named);
    StringBuilder mangled_key_sb = string_builder_init(24);
    mangled_key_sb.append(mangled);
    mangled_key_sb.append("::");
    mangled_key_sb.append(quirk_name);
    let by_mangled = self.quirk_elem_by_type.at(mangled_key_sb.build());
    if by_mangled.is_some() {
      ret by_mangled;
    }
    StringBuilder bare_key_sb = string_builder_init(24);
    bare_key_sb.append(named.name);
    bare_key_sb.append("::");
    bare_key_sb.append(quirk_name);
    let by_bare = self.quirk_elem_by_type.at(bare_key_sb.build());
    if by_bare.is_none() {
      ret .None;
    }
    CheckedType elem = by_bare.unwrap();
    let info = self.compounds.at(named.name);
    if info.is_none() || !info.unwrap().is_generic {
      ret .Some(elem);
    }
    CompoundInfo holder = info.unwrap();
    ret .Some(substitute(elem, &holder.type_params, &named.generic_args));
  }

  // True when a value of type `from` can stand where `to` is expected,
  // including where `to` is a quirk a pointer satisfies.
  assignable(CheckedType to, CheckedType from) flag {
    if can_assign(to, from) {
      // Two instantiations of one generic type are the same type only
      // when they were instantiated with the same arguments: a
      // `Box<num>` is not a `Box<str>`, though both are written `Box`
      // and compare equal by name alone.
      if !self.tuple_members_agree(to, from) {
        ret false;
      }
      ret self.generic_args_agree(to, from);
    }
    // A name the program never declares is a type parameter that no
    // instantiation resolved, which stands for anything.
    if !self.names_a_declared_type(to) || !self.names_a_declared_type(from) {
      ret true;
    }
    // An enum with no payloads is written as, and reads as, a number.
    if self.reads_as_number(to) && self.reads_as_number(from) {
      ret true;
    }
    if self.quirks.has(to.name) {
      ret from.pointer_depth > 0 || self.quirks.has(from.name);
    }
    ret false;
  }

  // Judges `alias.name`, where `alias` names an imported file rather
  // than a value: what follows the dot is a variable in the file that
  // alias stands for. True when it was one, whether or not anything was
  // reported.
  check_alias_qualified_read(ExprNode e, str name, TypeEnv* env) flag {
    if !e.has_left || e.left == nil {
      ret false;
    }
    str alias = "";
    fit e.left.kind {
      .Identifier(text) -> { alias = text; }
      _ -> { ret false; }
    }
    if equals(alias, "") {
      ret false;
    }
    // A value of that name, or a type of that name, means this is not an
    // alias at all.
    if env.lookup(alias).is_some() || self.compounds.at(alias).is_some() ||
      self.quirks.has(alias) || self.enum_names.has(alias) {
      ret false;
    }
    let known = self.globals.at(name);
    if known.is_none() {
      ret false;
    }
    GlobalInfo info = known.unwrap();
    self.check_visibility(name, info.file, info.is_public, "variable", e.left);
    ret true;
  }

  // Reports a field another module has no business reading. A field
  // whose name begins with `_` belongs to the file that declares the
  // type: the type itself may be offered publicly while some of what it
  // holds is its own business.
  check_field_visibility(CompoundInfo holder, str type_name, str field, Node* at) {
    if len(field) == 0 || field[0] != '_' {
      ret;
    }
    if equals(holder.file, "") || equals(self.current_file, "") {
      ret;
    }
    if equals(holder.file, self.current_file) {
      ret;
    }
    self.fail(
      format("'{str}' of '{str}' is private to the file that declares it", field, type_name),
      at
    );
  }

  // Reports a `sizeof` of a name the program never declares. Measuring
  // a type nothing defines has no answer, and C would be left to guess
  // at a name it has never seen either.
  check_sizeof_operand(Node* node, Node* operand) {
    if operand == nil {
      ret;
    }
    str named = "";
    fit operand.kind {
      .Identifier(text) -> { named = text; }
      _ -> { ret; }
    }
    // Only a plain name is judged: a generic instantiation, an array or
    // a parenthesized form carries its own structure and is read
    // elsewhere.
    str bare = named;
    for ends_with(bare, "*") {
      bare = substr(bare, 0, len(bare) - 1);
    }
    if equals(bare, "") || keyword_is_datatype(bare) {
      ret;
    }
    if self.compounds.at(bare).is_some() || self.quirks.has(bare) ||
      self.plain_enums.has(bare) {
      ret;
    }
    if self.enum_names.has(bare) {
      ret;
    }
    // A parameter of the declaration being walked stands for a type an
    // instantiation supplies, which is a type all the same.
    for tp : self.active_type_params {
      if equals(tp, bare) {
        ret;
      }
    }
    self.fail(format("sizeof names no type called '{str}'", bare), node);
  }

  // Rejects a comparison between two different enums. A plain enum reads
  // as the number behind it, so comparing one to a number is ordinary;
  // comparing two enums that share no variants is asking whether two
  // unrelated ordinals happen to coincide, which is never what was meant.
  check_comparison(Node* node, ExprNode e, TypeEnv* env) {
    if !e.has_left || !e.has_right {
      ret;
    }
    CheckedType left = self.infer(e.left, env);
    CheckedType right = self.infer(e.right, env);
    if !self.plain_enums.has(left.name) || !self.plain_enums.has(right.name) {
      ret;
    }
    if equals(left.name, right.name) {
      ret;
    }
    self.fail(
      format(
      "'{str}' compares a {str} with a {str}, which share no variants",
      e.op,
      left.name,
      right.name
      ),
      node
    );
  }

  // True when two types instantiated from the same generic agree on what
  // they hold. An argument the checker never resolved stands for
  // anything, and a side carrying no arguments at all says nothing about
  // what it holds, so only two resolved lists are compared.
  generic_args_agree(CheckedType to, CheckedType from) flag {
    if to.generic_args.len == 0 || from.generic_args.len == 0 {
      ret true;
    }
    if to.generic_args.len != from.generic_args.len {
      ret true;
    }
    num i = 0;
    for i < to.generic_args.len {
      CheckedType want = to.generic_args.get(i);
      CheckedType got = from.generic_args.get(i);
      i = i + 1;
      if is_unknown(want) || is_unknown(got) {
        continue;
      }
      if !self.names_a_declared_type(want) || !self.names_a_declared_type(got) {
        continue;
      }
      if !self.assignable(want, got) {
        ret false;
      }
    }
    ret true;
  }

  // The tuple counterpart to `generic_args_agree`: `can_assign` already
  // confirmed matching arity (all it can check, being a standalone
  // function with no `self` to recurse with) - this checks each element
  // pairwise. Neither side being a tuple says nothing to disagree about,
  // matching `generic_args_agree`'s own "nothing to compare" default.
  tuple_members_agree(CheckedType to, CheckedType from) flag {
    if !to.is_tuple || !from.is_tuple {
      ret true;
    }
    if to.tuple_members.len != from.tuple_members.len {
      ret false;
    }
    num i = 0;
    for i < to.tuple_members.len {
      CheckedType want = to.tuple_members.get(i);
      CheckedType got = from.tuple_members.get(i);
      i = i + 1;
      if !self.assignable(want, got) {
        ret false;
      }
    }
    ret true;
  }

  // True when a type names something the program declares, as opposed to
  // a parameter standing in for whatever an instantiation supplies.
  names_a_declared_type(CheckedType t) flag {
    if t.base != .Unknown {
      ret true;
    }
    if equals(t.name, "") {
      ret true;
    }
    str name = self.canonical_type_name(t.name);
    if self.compounds.at(name).is_some() || self.quirks.has(name) ||
      self.plain_enums.has(name) {
      ret true;
    }
    ret self.methods.at(name).is_some();
  }

  // True for a value that stands in a numeric position: a number, or an
  // enum whose variants carry no payload.
  reads_as_number(CheckedType t) flag {
    if t.pointer_depth > 0 || t.is_array {
      ret false;
    }
    if t.base != .Unknown {
      ret t.base == .Num || t.base == .Chr;
    }
    ret self.plain_enums.has(t.name);
  }

  // Records the first failure; later ones are consequences of it.
  fail(str message, Node* node) {
    if self.failed {
      ret;
    }
    self.failed = true;
    self.error = _error(message, node);
  }
}

// Calls the language supplies rather than a program declaring them.
fun _is_builtin_call(str name) flag {
  fit name {
    "sizeof", "va_start", "va_end", "va_copy", "va_arg_num", "va_arg_dec", "va_arg_bin",
    "va_arg_chr", "va_arg_str", "va_arg_raw" -> { ret true; }
    _ -> { ret false; }
  }
}

// True for a name that reads as a type rather than a value, which is
// what `sizeof` measures.
fun _names_a_type(Node* node) flag {
  if node == nil {
    ret false;
  }
  fit node.kind {
    .Identifier(name) -> {
      // A pointer written inside `sizeof(...)` is carried on the name,
      // as `num*`, since the stars name no type of their own.
      str bare = name;
      for ends_with(bare, "*") {
        bare = substr(bare, 0, len(bare) - 1);
      }
      if keyword_is_datatype(bare) {
        ret true;
      }
      ret len(bare) > 0 && bare[0] >= 'A' && bare[0] <= 'Z';
    }
    .Unary(u) -> {
      // A pointer or array spelling of a type still names one.
      ret _names_a_type(u.operand);
    }
    // A generic instantiation is written the way a comparison is, so its
    // type is the name on the left.
    .Expression(e) -> {
      if !e.has_left {
        ret false;
      }
      ret _names_a_type(e.left);
    }
    .ExpressionParenthesis(inner) -> { ret _names_a_type(inner); }
    // A generic instantiation written without fields parses as a
    // compound literal carrying the type it names.
    .CompoundInit(init) -> { ret init.has_dtype && init.fields.len == 0; }
    _ -> { ret false; }
  }
  ret false;
}

// The signature a function declaration promises.
// True when `name` is one of the function's own type parameters, which
// stands for whatever a call site supplies rather than a fixed type.
fun _is_type_param(FunctionNode f, str name) flag {
  if !f.has_type_params {
    ret false;
  }
  for p : f.type_params {
    if equals(p, name) {
      ret true;
    }
  }
  ret false;
}

fun _erase_type_params(FunctionNode f, CheckedType t) CheckedType {
  if _is_type_param(f, t.name) {
    ret checked_unknown();
  }
  ret t;
}

// Erases a type named by one of `names`, which stands for whatever an
// instantiation supplies rather than a type of its own.
fun _erase_named(CheckedType t, Vec<str>* names) CheckedType {
  if equals(t.name, "") {
    ret t;
  }
  num i = 0;
  for i < names.len {
    if equals(names.get(i), t.name) {
      ret checked_unknown();
    }
    i = i + 1;
  }
  ret t;
}

// The same, over a whole signature: an impl's type parameters reach its
// methods' return types and parameters.
fun _erase_signature(FnSig sig, Vec<str>* names) FnSig {
  if names.len == 0 {
    ret sig;
  }
  FnSig out = sig;
  out.rtype = _erase_named(sig.rtype, names);
  out.args.init(sig.args.len);
  num i = 0;
  for i < sig.args.len {
    out.args.push(_erase_named(sig.args.get(i), names));
    i = i + 1;
  }
  ret out;
}

fun _signature_of(FunctionNode f) FnSig {
  FnSig sig;
  sig.args.init(f.args.len);
  sig.rtype = checked_unknown();
  if f.has_rtype {
    sig.rtype = _erase_type_params(f, checked_from_dtype(f.rtype));
  }
  sig.is_variadic = f.is_variadic;
  sig.is_async = f.is_async;
  sig.is_generic = f.has_type_params && f.type_params.len > 0;
  sig.ambiguous = false;
  sig.file = "";
  sig.is_public = false;
  sig.type_params.init(0);
  sig.bounds.init(0);
  sig.arg_params.init(f.args.len);
  if f.has_type_params {
    for p : f.type_params {
      sig.type_params.push(p);
    }
  }
  if f.has_type_param_forced_insts {
    for b : f.type_param_forced_insts {
      sig.bounds.push(b);
    }
  }
  sig.min_args = 0;
  flag counting = true;
  for a : f.args {
    fit a.kind {
      .Variable(v) -> {
        CheckedType declared = checked_from_dtype(v.var_type);
        str written = "";
        if _is_type_param(f, declared.name) {
          written = declared.name;
        }
        sig.arg_params.push(written);
        sig.args.push(_erase_type_params(f, declared));
        // A parameter with a default value, and everything after it,
        // may be left out by the caller.
        if v.has_val {
          counting = false;
        } elif counting {
          sig.min_args = sig.min_args + 1;
        }
      }
      _ -> {
        sig.arg_params.push("");
        sig.args.push(checked_unknown());
      }
    }
  }
  ret sig;
}

// The name a call's callee refers to, empty when it is not a plain call
// to a named function.
fun _callee_name(Node* callee) str {
  if callee == nil {
    ret "";
  }
  fit callee.kind {
    .Identifier(name) -> { ret name; }
    _ -> { ret ""; }
  }
}

// The arguments of a call, whose AST shape is a comma expression when
// there is more than one.
fun _call_args(Node* node, Vec<Node*>* out) {
  if node == nil {
    ret;
  }
  fit node.kind {
    .Expression(e) -> {
      if equals(e.op, ",") && e.has_left && e.has_right {
        _call_args(e.left, out);
        _call_args(e.right, out);
        ret;
      }
    }
    // A call's argument list is parenthesized, and the parentheses are
    // a node of their own.
    .ExpressionParenthesis(inner) -> {
      _call_args(inner, out);
      ret;
    }
    // An empty argument list still carries a node, which is not an
    // argument.
    .Blank -> { ret; }
    _ -> {}
  }
  out.push(node);
}

// A format-like variadic function's own fmt-argument index
// (`fprintf`/`sprintf`/`snprintf` carry a stream/destination before
// it), or -1 for anything else. `scanf`/`sscanf` are deliberately
// excluded: an input format's own specifiers name what gets written
// through a pointer, not a value's own type - a different, riskier
// check than this one, not attempted here.
fun _format_fmt_arg_index(str name) num {
  // format(fmt, ...), print_fmt(fmt, ...), println_fmt(fmt, ...),
  // printf(fmt, ...): fmt is the first argument, nothing before it.
  if equals(name, "format") || equals(name, "print_fmt") || equals(name, "println_fmt") ||
    equals(name, "printf") {
    ret 0;
  }
  // fprintf(stream, fmt, ...), sprintf(dst, fmt, ...): one argument
  // (the stream/destination) comes before fmt.
  if equals(name, "fprintf") || equals(name, "sprintf") {
    ret 1;
  }
  // snprintf(dst, n, fmt, ...): two arguments (destination, then its
  // own capacity) come before fmt.
  if equals(name, "snprintf") {
    ret 2;
  }
  ret -1;
}

fun _is_c_style_format(str name) flag {
  ret equals(name, "printf") || equals(name, "fprintf") || equals(name, "sprintf") ||
    equals(name, "snprintf");
  }

// The `{type}` placeholders in `fmt` (Fun's own `format()` syntax),
// in order: `""` for an untyped `{}`, or one of the 7 recognized
// type names for a typed one. Mirrors `format_impl`'s (std/io.fn)
// own recognition rules exactly - `{{` is a literal `{`, and `{xyz}`
// is a placeholder only when `xyz` names one of those 7 types,
// anything else is literal text - so this never misreads a
// literal-brace-heavy format string (fls's own JSON-building
// `format()` calls, throughout this very codebase) as carrying
// placeholders it doesn't.
fun _fun_format_specs(str fmt) Vec<str> {
  Vec<str> out;
  out.init(4);
  num i = 0;
  num n = len(fmt);
  for i < n {
    chr c = fmt[i];
    if c != '{' {
      i = i + 1;
      continue;
    }
    if i + 1 < n && fmt[i + 1] == '{' {
      i = i + 2;
      continue;
    }
    if i + 1 < n && fmt[i + 1] == '}' {
      out.push("");
      i = i + 2;
      continue;
    }
    // The placeholder word's own length varies (`flag` is 4 chars,
    // every other one is 3), so the closing `}` is found by scanning
    // forward within a short bound rather than assumed at a fixed
    // offset.
    num close = -1;
    num max_word_len = 5;
    num limit = i + 1 + max_word_len;
    if limit > n {
      limit = n;
    }
    num j = i + 1;
    for j < limit {
      if fmt[j] == '}' {
        close = j;
        break;
      }
      j = j + 1;
    }
    if close > 0 {
      str word = substr(fmt, i + 1, close - i - 1);
      if equals(word, "str") || equals(word, "num") || equals(word, "dec") ||
        equals(word, "flag") || equals(word, "chr") || equals(word, "ptr") ||
        equals(word, "raw") {
        out.push(word);
        i = close + 1;
        continue;
      }
      free(word);
    }
    i = i + 1;
  }
  ret out;
}

// The C-style conversions in `fmt` (`printf`/`fprintf`/`sprintf`/
// `snprintf`), as the same Fun type-name vocabulary `_fun_format_specs`
// uses, one entry per `%`-conversion found; `%%` is a literal percent,
// never a placeholder. `.None` (rather than an empty `Vec`) for
// anything this parser doesn't confidently recognize - a positional
// argument (`%1$s`), a dynamic width/precision (`%*d`), or an
// unrecognized conversion character - so a caller skips the check
// entirely rather than risk a false positive on a spec it doesn't
// fully understand.
fun _c_format_specs(str fmt) Option<Vec<str>> {
  Vec<str> out;
  out.init(4);
  num i = 0;
  num n = len(fmt);
  for i < n {
    chr c = fmt[i];
    if c != '%' {
      i = i + 1;
      continue;
    }
    i = i + 1;
    if i >= n {
      out.free();
      ret .None;
    }
    if fmt[i] == '%' {
      i = i + 1;
      continue;
    }
    for i < n &&
      (fmt[i] == '-' || fmt[i] == '+' || fmt[i] == '0' || fmt[i] == ' ' || fmt[i] == '#') {
      i = i + 1;
    }
    if i < n && fmt[i] == '*' {
      out.free();
      ret .None;
    }
    for i < n && fmt[i] >= '0' && fmt[i] <= '9' {
      i = i + 1;
    }
    if i < n && fmt[i] == '.' {
      i = i + 1;
      if i < n && fmt[i] == '*' {
        out.free();
        ret .None;
      }
      for i < n && fmt[i] >= '0' && fmt[i] <= '9' {
        i = i + 1;
      }
    }
    for i < n &&
      (fmt[i] == 'l' || fmt[i] == 'h' || fmt[i] == 'z' || fmt[i] == 'j' || fmt[i] == 't' || fmt[i] == 'L') {
      i = i + 1;
    }
    if i >= n {
      out.free();
      ret .None;
    }
    chr conv = fmt[i];
    i = i + 1;
    if conv == 'd' || conv == 'i' || conv == 'u' || conv == 'x' || conv == 'X' || conv == 'o' {
      out.push("num");
    } elif conv == 'f' || conv == 'F' || conv == 'g' || conv == 'G' || conv == 'e' || conv == 'E' {
      out.push("dec");
    } elif conv == 's' {
      out.push("str");
    } elif conv == 'c' {
      out.push("chr");
    } elif conv == 'p' {
      out.push("raw");
    } else {
      out.free();
      ret .None;
    }
  }
  ret .Some(out);
}

fun _data_type_for(str want_name) DataTypeType {
  if equals(want_name, "str") {
    ret .Str;
  }
  if equals(want_name, "num") {
    ret .Num;
  }
  if equals(want_name, "dec") {
    ret .Dec;
  }
  if equals(want_name, "flag") {
    ret .Bin;
  }
  ret .Chr;
}

impl Checker {
  // The type a literal, name, or operator expression produces. Anything
  // the checker does not model infers as unknown.
  infer(Node* node, TypeEnv* env) CheckedType {
    if node == nil {
      ret checked_unknown();
    }
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Dec(_) -> { ret checked_of(.Dec); }
          .Cval(_) -> { ret checked_of(.Chr); }
          .Num(value) -> {
            CheckedType t = checked_of(.Num);
            // Zero is how a null pointer is written.
            t.is_null_literal = value == 0;
            ret t;
          }
          _ -> { ret checked_of(.Num); }
        }
      }
      .String(_) -> { ret checked_of(.Str); }
      .Character(_) -> { ret checked_of(.Chr); }
      .Boolean(_) -> { ret checked_of(.Bin); }
      .Nil -> {
        CheckedType t = checked_of(.Raw);
        t.is_null_literal = true;
        ret t;
      }
      .Panic(_) -> {
        CheckedType t = checked_unknown();
        t.is_panic_literal = true;
        ret t;
      }
      .Identifier(name) -> {
        let found = env.lookup(name);
        if found.is_some() {
          ret found.unwrap();
        }
        ret checked_unknown();
      }
      .ExpressionParenthesis(inner) -> { ret self.infer(inner, env); }
      .Bracket(items) -> { ret self.infer_bracket(node, items, env); }
      .CompoundInit(init) -> { ret self.infer_compound_init(node, init, env); }
      .TupleLiteral(tl) -> {
        CheckedType out = checked_unknown();
        out.is_tuple = true;
        for el : tl.elements {
          out.tuple_members.push(self.infer(el, env));
        }
        ret out;
      }
      .Unary(u) -> { ret self.infer_unary(node, u, env); }
      .Expression(e) -> { ret self.infer_expression(node, e, env); }
      _ -> { ret checked_unknown(); }
    }
    ret checked_unknown();
  }

  // The type a compound literal builds. A generic one written without
  // arguments takes them from the fields it initializes.
  infer_compound_init(Node* node, CompoundInitNode init, TypeEnv* env) CheckedType {
    if !init.has_dtype {
      ret checked_unknown();
    }
    CheckedType built = checked_from_dtype(init.init_dtype);
    self.check_instantiation(built, node);
    if self.failed {
      ret checked_unknown();
    }
    let info = self.compounds.at(self.canonical_type_name(built.name));
    if info.is_none() {
      ret built;
    }
    CompoundInfo holder = info.unwrap();
    if !holder.is_generic || built.generic_args.len > 0 {
      ret built;
    }
    // Each parameter stands for the type of the first field written in
    // terms of it.
    num p = 0;
    for p < holder.type_params.len {
      str param = holder.type_params.get(p);
      p = p + 1;
      CheckedType stands_for = checked_unknown();
      for f : init.fields {
        let declared = holder.fields.at(f.name);
        if declared.is_none() {
          continue;
        }
        if !equals(declared.unwrap().name, param) {
          continue;
        }
        stands_for = self.infer(f.value, env);
        break;
      }
      built.generic_args.push(stands_for);
    }
    ret built;
  }

  // The type an array literal holds, which every element must share.
  infer_bracket(Node* node, Node* items, TypeEnv* env) CheckedType {
    Vec<Node*> elements;
    elements.init(4);
    defer elements.free();
    _call_args(items, &elements);

    CheckedType held = checked_unknown();
    num i = 0;
    for i < elements.len {
      CheckedType element = self.infer(elements.get(i), env);
      i = i + 1;
      if is_unknown(element) {
        continue;
      }
      if is_unknown(held) {
        held = element;
        continue;
      }
      if !can_assign(held, element) && !can_assign(element, held) {
        self.fail(
          format(
          "an array literal holds one type, found {str} and {str}",
          type_name(held),
          type_name(element)
          ),
          node
        );
        ret checked_unknown();
      }
    }
    if is_unknown(held) {
      ret checked_unknown();
    }
    CheckedType t = held;
    t.is_array = true;
    t.array_depth = held.array_depth + 1;
    ret t;
  }

  infer_unary(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    if equals(u.op, "await") {
      ret self.check_await(u, env);
    }
    // `x?`/`x!`: Option/Result propagation. Checked ahead of the
    // ordinary operand inference below since a failed propagation
    // check should report on the whole unary node, not fall through to
    // treating '!' as logical-NOT.
    if u.is_left_operanded_unary && (equals(u.op, "?") || equals(u.op, "!")) {
      ret self.infer_propagation(node, u, env);
    }
    if u.is_left_operanded_unary && equals(u.op, "?!") {
      ret self.infer_option_to_result_propagation(node, u, env);
    }
    if u.is_left_operanded_unary && equals(u.op, "!?") {
      ret self.infer_result_to_option_propagation(node, u, env);
    }
    CheckedType operand = self.infer(u.operand, env);
    if equals(u.op, "&") {
      CheckedType t = operand;
      t.pointer_depth = operand.pointer_depth + 1;
      ret t;
    }
    if equals(u.op, "*") {
      if operand.pointer_depth == 0 {
        ret checked_unknown();
      }
      CheckedType t = operand;
      t.pointer_depth = operand.pointer_depth - 1;
      ret t;
    }
    if equals(u.op, "!") {
      ret checked_of(.Bin);
    }
    ret operand;
  }

  // `x?` propagates a `.None` from `x: Option<T>`, evaluating to `T`
  // on `.Some`; `x!` propagates a `.Err(e)` from `x: Result<T,E>` (the
  // enclosing function's own error type must be exactly `E`, no
  // conversion), evaluating to `T` on `.Ok`. Real codegen lowering
  // happens later, in emit_expr's own `.Unary` handling; this only
  // validates and infers the resulting type.
  infer_propagation(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    CheckedType operand = self.infer(u.operand, env);
    flag is_option = equals(u.op, "?");
    str want_name = "Option";
    if !is_option {
      want_name = "Result";
    }
    if !equals(operand.name, want_name) {
      self.fail(format("'{str}' used on a non-{str} expression", u.op, want_name), node);
      ret checked_unknown();
    }
    if !equals(self.rtype.name, want_name) {
      self.fail(
        format("'{str}' used outside a function returning {str}<...>", u.op, want_name),
        node
      );
      ret checked_unknown();
    }
    if !is_option {
      str operand_e = type_name(operand.generic_args.get(1));
      str rtype_e = type_name(self.rtype.generic_args.get(1));
      if !equals(operand_e, rtype_e) {
        self.fail(
          format(
          "'!' propagates {str}, but the enclosing function returns Result<_, {str}>",
          operand_e,
          rtype_e
          ),
          node
        );
        ret checked_unknown();
      }
    }
    ret operand.generic_args.get(0);
  }

  // `x?!(err)`: propagates `err` from `x: Option<T>`'s `.None` in
  // whatever shape the enclosing function needs - `.Err(err)` if it
  // returns `Result<_, E>`, or `.Some(err)` if it returns `Option<E>`
  // (the error-channel convention codegen.fn itself uses throughout).
  // Evaluates to `T` on `.Some`. `err` must be assignable to the enclosing
  // function's own error slot, no conversion; a bare `.Variant` shorthand
  // has no type of its own and is accepted like any other unknown-typed
  // expression.
  infer_option_to_result_propagation(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    CheckedType operand = self.infer(u.operand, env);
    if !equals(operand.name, "Option") {
      self.fail("'?!' used on a non-Option expression", node);
      ret checked_unknown();
    }
    if !u.has_error_arg {
      self.fail("'?!' needs an error value: '?!(err)'", node);
      ret checked_unknown();
    }
    CheckedType err_val = self.infer(u.error_arg, env);
    if equals(self.rtype.name, "Result") {
      CheckedType want_err = self.rtype.generic_args.get(1);
      if !self.assignable(want_err, err_val) {
        self.fail(
          format(
          "'?!' propagates {str}, but the enclosing function returns Result<_, {str}>",
          type_name(err_val),
          type_name(want_err)
          ),
          node
        );
        ret checked_unknown();
      }
    } elif equals(self.rtype.name, "Option") {
      CheckedType want_err = self.rtype.generic_args.get(0);
      if !self.assignable(want_err, err_val) {
        self.fail(
          format(
          "'?!' propagates {str}, but the enclosing function returns Option<{str}>",
          type_name(err_val),
          type_name(want_err)
          ),
          node
        );
        ret checked_unknown();
      }
    } else {
      self.fail("'?!' used outside a function returning Result<...> or Option<...>", node);
      ret checked_unknown();
    }
    ret operand.generic_args.get(0);
  }

  // `x!?`: propagates from `x: Result<T, E>`'s `.Err(_)` by returning
  // `.None` from the enclosing function, discarding the error entirely
  // - the enclosing function just needs to return SOME `Option<...>`,
  // no relation between its own generic arg and `E` required (`.None`
  // carries no payload to typecheck against it). Evaluates to `T` on
  // `.Ok`.
  infer_result_to_option_propagation(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    CheckedType operand = self.infer(u.operand, env);
    if !equals(operand.name, "Result") {
      self.fail("'!?' used on a non-Result expression", node);
      ret checked_unknown();
    }
    if !equals(self.rtype.name, "Option") {
      self.fail("'!?' used outside a function returning Option<...>", node);
      ret checked_unknown();
    }
    ret operand.generic_args.get(0);
  }

  // The type a binary operator produces, checking a call's arguments
  // against what the callee declares along the way.
  infer_expression(Node* node, ExprNode e, TypeEnv* env) CheckedType {
    if equals(e.op, "()") {
      ret self.check_call(node, e, env, false);
    }
    if _is_assignment(e.op) {
      self.check_assignment(node, e, env);
      ret checked_unknown();
    }
    // A decimal has no remainder to take.
    if equals(e.op, "%") && e.has_left && e.has_right {
      CheckedType left = self.infer(e.left, env);
      CheckedType right = self.infer(e.right, env);
      if left.base == .Dec || right.base == .Dec {
        self.fail("the remainder operator does not apply to a decimal", node);
        ret checked_unknown();
      }
    }
    // Dividing by a zero written into the program is a mistake the
    // program can be told about, rather than one the machine finds.
    if (equals(e.op, "/") || equals(e.op, "%")) && e.has_right {
      if _is_constant_zero(e.right) {
        self.fail(
          format("division by zero: right operand of '{str}' is the constant 0", e.op),
          node
        );
        ret checked_unknown();
      }
    }
    if equals(e.op, ".") {
      ret self.infer_field(node, e, env);
    }
    // An index reads what the sequence holds: an array's own element
    // type one level shallower, or (a `str` has no array flag of its
    // own, C string semantics) a single `chr`.
    if equals(e.op, "[]") {
      if !e.has_left {
        ret checked_unknown();
      }
      CheckedType base = self.infer(e.left, env);
      if base.base == .Str && !base.is_array {
        ret checked_of(.Chr);
      }
      if !base.is_array {
        ret checked_unknown();
      }
      CheckedType held = base;
      held.array_depth = base.array_depth - 1;
      held.is_array = held.array_depth > 0;
      ret held;
    }
    if equals(e.op, ",") {
      ret checked_unknown();
    }
    if _is_comparison(e.op) || _is_logical(e.op) {
      self.check_comparison(node, e, env);
      ret checked_of(.Bin);
    }
    if !e.has_left {
      ret checked_unknown();
    }
    CheckedType left = self.infer(e.left, env);
    if !e.has_right {
      ret left;
    }
    CheckedType right = self.infer(e.right, env);
    // Arithmetic on two numeric kinds widens to the wider one.
    if right.base == .Dec && left.base == .Num {
      ret right;
    }
    if is_unknown(left) {
      ret right;
    }
    ret left;
  }

  // The type a field access reads, and the name of the type it reads
  // from. A method call is a field access whose result is called.
  infer_field(Node* node, ExprNode e, TypeEnv* env) CheckedType {
    if !e.has_left || !e.has_right {
      ret checked_unknown();
    }
    CheckedType receiver = self.infer(e.left, env);
    // Tuple positional access (`t.0`): the RHS lexes/parses as a plain
    // `Number` token (a real int, never a `Dec`, since the lexer only
    // treats a post-operand `.digit` as a leading-dot float when nothing
    // already ends a value before it), not an `Identifier` the way an
    // ordinary field name is - `_callee_name` below returns "" for it,
    // which is why this has to be checked first, not folded into the
    // ordinary field-name path.
    flag right_is_number = false;
    num tuple_index = 0;
    fit e.right.kind {
      .Number(data) -> {
        fit data {
          .Num(n) -> {
            right_is_number = true;
            tuple_index = n;
          }
          _ -> {}
        }
      }
      _ -> {}
    }
    if right_is_number {
      // A receiver the checker genuinely can't resolve (most commonly a
      // generic method's own un-substituted return type - `Vec<T>.get`
      // returns a method's declared return type as-is with no generic
      // substitution, a pre-existing gap this positional-access check
      // must not be stricter about than the ordinary field-name path
      // just below already is: that path's own `self.compounds.at(...)`
      // lookup silently falls through to `checked_unknown()` for exactly
      // this case, deferring entirely to codegen's own separate,
      // independent type resolution rather than reporting a real error
      // here. Covers both shapes an unresolved receiver actually takes
      // in practice: an empty name (`is_unknown`) and a real but
      // undeclared one, like a raw type-param name (`names_a_declared_type`).
      if !receiver.is_tuple &&
        (is_unknown(receiver) || !self.names_a_declared_type(receiver)) {
        ret checked_unknown();
      }
      if !receiver.is_tuple {
        self.fail(format("no field named '{num}'", tuple_index), node);
        ret checked_unknown();
      }
      if tuple_index < 0 || tuple_index >= receiver.tuple_members.len {
        self.fail(
          format(
          "tuple has no element {num} (it has {num} element(s))",
          tuple_index,
          receiver.tuple_members.len
          ),
          node
        );
        ret checked_unknown();
      }
      ret receiver.tuple_members.get(tuple_index);
    }
    str field = _callee_name(e.right);
    if equals(field, "") {
      ret checked_unknown();
    }
    if self.check_alias_qualified_read(e, field, env) {
      ret checked_unknown();
    }
    let info = self.compounds.at(self.canonical_type_name(receiver.name));
    if info.is_none() {
      ret checked_unknown();
    }
    CompoundInfo holder = info.unwrap();
    let found = holder.fields.at(field);
    if found.is_some() {
      self.check_field_visibility(holder, receiver.name, field, node);
      CheckedType declared = found.unwrap();
      if holder.is_generic {
        // Without the arguments the instantiation supplied, the field's
        // type is whatever the parameter stood for.
        if receiver.generic_args.len == 0 {
          ret checked_unknown();
        }
        ret substitute(declared, &holder.type_params, &receiver.generic_args);
      }
      ret declared;
    }
    if holder.is_generic && receiver.generic_args.len == 0 {
      ret checked_unknown();
    }
    // A method reads as a field until it is called.
    if self.has_method(receiver.name, field) {
      ret checked_unknown();
    }
    self.fail(format("'{str}' has no field '{str}'", receiver.name, field), node);
    ret checked_unknown();
  }

  // `self.compounds`/`self.methods` are keyed by a type's own bare name.
  // A cross-file reference through an import alias (`m.Boxed`) mangles
  // the annotation to `m__Boxed` at parse time, so a lookup by that raw
  // name misses; this resolves it back to the bare name once doing so
  // actually helps, and leaves anything else (a generic mangled name, a
  // genuinely unknown type) untouched.
  canonical_type_name(str name) str {
    if self.compounds.at(name).is_some() || self.methods.at(name).is_some() ||
      self.quirks.has(name) || self.plain_enums.has(name) {
      ret name;
    }
    num sep = index_of_str(name, "__");
    if sep < 0 {
      ret name;
    }
    ret substr(name, sep + 2, len(name) - sep - 2);
  }

  has_method(str type_name, str method) flag {
    let table = self.methods.at(self.canonical_type_name(type_name));
    if table.is_none() {
      ret false;
    }
    MethodTable found = table.unwrap();
    ret found.methods.at(method).is_some();
  }

  // A method reaches a receiver either through an impl on its
  // instantiation or through one on the type itself.
  receiver_method(CheckedType receiver, str method) Option<FnSig> {
    receiver.name = self.canonical_type_name(receiver.name);
    str instantiated = mangled_name(receiver);
    if !equals(instantiated, receiver.name) {
      let found = self.method_signature(instantiated, method);
      if found.is_some() {
        ret found;
      }
    }
    ret self.method_signature(receiver.name, method);
  }

  // True when the checker has seen what methods a type has, which is
  // what lets it say a call names none of them.
  knows_methods_of(CheckedType receiver) flag {
    if equals(receiver.name, "") {
      ret false;
    }
    // An instantiation reaches methods through impls written against the
    // type parameter, which these tables do not resolve, so only a type
    // with no arguments of its own is judged.
    if receiver.generic_args.len > 0 {
      ret false;
    }
    ret self.methods.at(self.canonical_type_name(receiver.name)).is_some();
  }

  // The signature of `method` on `type_name`, if the type declares one.
  // `type_name` may already be a generic-instantiation mangled string
  // (`Vec__num`, built by `mangled_name`), which must not be run back
  // through alias canonicalization. A caller that means the base type
  // itself canonicalizes before it gets here.
  method_signature(str type_name, str method) Option<FnSig> {
    ret self.methods.at(type_name)?.methods.at(method);
  }

  // The signature a call through a receiver resolves to, if the checker
  // can name both the receiver's type and the method.
  resolve_method_call(ExprNode callee, TypeEnv* env) Option<FnSig> {
    ret .Some(self.resolve_method_call_with_receiver(callee, env)?.sig);
  }

  // `resolve_method_call`, also carrying the receiver's own checked type
  // (its generic args among them) - needed to substitute a generic
  // method's own type parameters, `Vec<T>.sort_by`'s `T` among them,
  // into a function-typed parameter's nested signature before it can be
  // compared against an argument's real one.
  resolve_method_call_with_receiver(ExprNode callee, TypeEnv* env) Option<MethodResolution> {
    if !callee.has_left || !callee.has_right {
      ret .None;
    }
    CheckedType receiver = self.infer(callee.left, env);
    if equals(receiver.name, "") {
      ret .None;
    }
    str method = _callee_name(callee.right);
    if equals(method, "") {
      ret .None;
    }
    MethodResolution found;
    found.sig = self.receiver_method(receiver, method)?;
    found.receiver = receiver;
    ret .Some(found);
  }

  // True when a call through a receiver reaches an async method, or one
  // the checker cannot resolve, which it does not second-guess.
  awaits_async_method(ExprNode e, TypeEnv* env) flag {
    if !e.has_left {
      ret true;
    }
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") {
          ret true;
        }
        let resolved = self.resolve_method_call(callee, env);
        if resolved.is_none() {
          ret true;
        }
        ret resolved.unwrap().is_async;
      }
      _ -> { ret true; }
    }
    ret true;
  }

  // Checks a call written through a receiver, which resolves to a
  // method the receiver's type declares.
  check_method_call(Node* node, ExprNode e, Vec<Node*>* args, TypeEnv* env, flag awaited) CheckedType {
    if !e.has_left {
      ret checked_unknown();
    }
    Option<MethodResolution> resolved = .None;
    str method = "";
    fit e.left.kind {
      .Expression(callee) -> {
        if equals(callee.op, ".") {
          method = _callee_name(callee.right);
          resolved = self.resolve_method_call_with_receiver(callee, env);
        }
      }
      _ -> {}
    }
    if resolved.is_none() {
      // A call written `alias.name(...)` reaches a function in the file
      // that alias stands for, not a method on a value. What the merge
      // produced is one flat program, so the function is here under its
      // own name; only whether the file offers it still has to be said.
      if self.check_alias_qualified_call(node, e, method, env) {
        ret checked_unknown();
      }
      self.check_receiver_has_method(node, e, method, env);
      ret checked_unknown();
    }
    MethodResolution found = resolved.unwrap();
    FnSig sig = found.sig;
    self.check_visibility(method, sig.file, sig.is_public, "method", node);
    if sig.is_async && !awaited {
      self.fail(format("call to async method '{str}' needs await", method), node);
      ret checked_unknown();
    }
    // A function-typed parameter naming the enclosing compound's own
    // type param (`Vec<T>.sort_by`'s `T`), not the method's own -
    // `sig.type_params` is empty for a non-generic method like this one.
    Vec<str> receiver_type_params;
    receiver_type_params.init(0);
    let compound_info = self.compounds.at(self.canonical_type_name(found.receiver.name));
    if compound_info.is_some() {
      for p : compound_info.unwrap().type_params {
        receiver_type_params.push(p);
      }
    }
    self.check_arguments(node, method, sig, args, env, &receiver_type_params, &found.receiver.generic_args);
    ret sig.rtype;
  }

  // A quirk-bound alternative's own bare name, with any generic-arg
  // suffix stripped (`Steppable<T>` -> `Steppable`). `quirk_implementors`
  // only ever keys on a quirk's bare name (real membership is `impl X as
  // Steppable<...> { ... }` having been seen for X at all, not which
  // concrete argument it used), so a bound naming a generic quirk's own
  // instantiation - including a self-referential one like `T:
  // Steppable<T>`, where the type param the bound is even ATTACHED to is
  // still the unsubstituted literal "T" here, before any instantiation
  // site has supplied a real type for it - could otherwise never match:
  // `implements_quirk` would look up a quirk registered under the
  // literal, never-matching string "Steppable<T>" instead of "Steppable".
  _bare_quirk_bound_name(str bound) str {
    num lt = index_of_char(bound, '<');
    if lt < 0 {
      ret bound;
    }
    ret substr(bound, 0, lt);
  }

  // Checks the arguments an instantiation supplies against the types its
  // parameters are allowed to stand for.
  check_instantiation(CheckedType t, Node* at) {
    if t.generic_args.len == 0 || equals(t.name, "") {
      ret;
    }
    let info = self.compounds.at(self.canonical_type_name(t.name));
    if info.is_none() {
      ret;
    }
    CompoundInfo holder = info.unwrap();
    if holder.bounds.len == 0 {
      ret;
    }
    num p = 0;
    for p < holder.type_params.len && p < t.generic_args.len {
      str param = holder.type_params.get(p);
      CheckedType supplied = t.generic_args.get(p);
      num at_param = p;
      p = p + 1;
      if is_unknown(supplied) {
        continue;
      }
      str supplied_name = type_name(supplied);
      flag listed = false;
      num b = 0;
      for b < holder.bounds.len {
        Vec<str> combination = holder.bounds.get(b);
        b = b + 1;
        if at_param >= combination.len {
          continue;
        }
        str bound = combination.get(at_param);
        // A bound alternative naming a quirk is checked by real
        // membership (a genuine `impl X as quirk` block was seen), not
        // name equality - `bound` itself is never resolved against a
        // declared type/quirk table until now, so this is the first
        // point either check is even possible. A bound naming a
        // concrete instantiation of a generic quirk (`T: To<num>`, or a
        // self-referential one like `T: Steppable<T>`) is handled by
        // `_bare_quirk_bound_name` stripping the `<...>` suffix first.
        if equals(bound, supplied_name) ||
          self.implements_quirk(supplied, self.canonical_type_name(self._bare_quirk_bound_name(bound))) {
          listed = true;
        }
      }
      if !listed {
        self.fail(
          format("'{str}' does not accept {str} for '{str}'", t.name, supplied_name, param),
          at
        );
        ret;
      }
    }
  }

  // Checks the types a call supplies for the callee's type parameters
  // against the types each one is allowed to stand for.
  check_type_bounds(Node* node, str name, FnSig sig, Vec<Node*>* args, TypeEnv* env) {
    if sig.bounds.len == 0 || sig.type_params.len == 0 {
      ret;
    }
    num p = 0;
    for p < sig.type_params.len {
      str param = sig.type_params.get(p);
      // Each entry names one concrete type per parameter, so what this
      // parameter may stand for is that position across the entries.
      Vec<str> allowed;
      allowed.init(sig.bounds.len);
      defer allowed.free();
      num b = 0;
      for b < sig.bounds.len {
        Vec<str> combination = sig.bounds.get(b);
        b = b + 1;
        if p < combination.len {
          allowed.push(combination.get(p));
        }
      }
      p = p + 1;
      if allowed.len == 0 {
        continue;
      }
      // The first argument written as this parameter is what it stands
      // for at this call.
      num i = 0;
      for i < args.len && i < sig.arg_params.len {
        str written = sig.arg_params.get(i);
        num at = i;
        i = i + 1;
        if !equals(written, param) {
          continue;
        }
        CheckedType supplied = self.infer(args.get(at), env);
        if is_unknown(supplied) {
          break;
        }
        str supplied_name = type_name(supplied);
        flag listed = false;
        num a = 0;
        for a < allowed.len {
          str bound = allowed.get(a);
          // See the matching comment in `check_instantiation`: a quirk
          // bound is checked by real membership, not name equality,
          // with any generic-arg suffix on the bound itself stripped
          // first.
          if equals(bound, supplied_name) ||
            self.implements_quirk(supplied, self.canonical_type_name(self._bare_quirk_bound_name(bound))) {
            listed = true;
          }
          a = a + 1;
        }
        if !listed {
          self.fail(
            format("'{str}' does not accept {str} for '{str}'", name, supplied_name, param),
            node
          );
          ret;
        }
        break;
      }
    }
  }

  // Judges `alias.name(...)`, where `alias` names an imported file
  // rather than a value. True when it was one, whether or not anything
  // was reported: either way it is not a method call.
  // 
  // Only a name that resolves to nothing else is read this way, so a
  // receiver whose type the checker does not model is left to the method
  // path rather than being mistaken for an alias.
  check_alias_qualified_call(Node* node, ExprNode e, str method, TypeEnv* env) flag {
    if equals(method, "") || !e.has_left {
      ret false;
    }
    str alias = "";
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") || !callee.has_left || callee.left == nil {
          ret false;
        }
        fit callee.left.kind {
          .Identifier(name) -> { alias = name; }
          _ -> {}
        }
      }
      _ -> {}
    }
    if equals(alias, "") {
      ret false;
    }
    // A value of that name, or a type of that name, means this is not an
    // alias at all.
    if env.lookup(alias).is_some() || self.compounds.at(alias).is_some() ||
      self.quirks.has(alias) || self.plain_enums.has(alias) {
      ret false;
    }
    let known = self.fns.at(method);
    if known.is_none() {
      ret false;
    }
    FnSig sig = known.unwrap();
    if sig.ambiguous {
      ret true;
    }
    self.check_visibility(method, sig.file, sig.is_public, "function", node);
    ret true;
  }

  // Reports a method called on a value whose type declares none. Only a
  // receiver the checker resolved completely is judged, so an unmodelled
  // one is left alone.
  check_receiver_has_method(Node* node, ExprNode e, str method, TypeEnv* env) {
    if equals(method, "") || !e.has_left {
      ret;
    }
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") || !callee.has_left {
          ret;
        }
        CheckedType receiver = self.infer(callee.left, env);
        // A pointer or an array is not the receiver itself, so what it
        // reaches is judged elsewhere.
        if receiver.pointer_depth > 0 || receiver.is_array {
          ret;
        }
        if self.receiver_method(receiver, method).is_some() {
          ret;
        }
        // A builtin declares no methods at all, so any call through one
        // is wrong. A named type is only judged once its methods are
        // known: seeing an impl for it is what says they are, and a type
        // whose impls the checker never saw is left alone rather than
        // reported on a guess.
        if receiver.base == .Unknown && !self.knows_methods_of(receiver) {
          ret;
        }
        self.fail(format("{str} has no method '{str}'", type_name(receiver), method), node);
      }
      _ -> {}
    }
  }

  // Whether the top-level function `got` (already resolved from `self.fns`)
  // can stand in for a `fun(T1, T2) R`-typed parameter declared as
  // `want`: same arity, and every parameter/return type assignable the
  // same way an ordinary argument is. `want`'s own parameter/return
  // types are written `DataType`s, converted through `checked_from_dtype`
  // to compare against `got`'s already-checked ones; `type_params`/
  // `generic_args` substitute a generic method's own type parameter
  // (`Vec<T>.sort_by`'s `T`) with the receiver's real one (`Vec<num>`'s
  // `num`) before either side is compared, since `want` is written
  // against the unsubstituted template.
  _fn_sig_matches(FnTypeSig* want, FnSig got, Vec<str>* type_params, Vec<CheckedType>* generic_args) flag {
    if got.is_variadic || want.params.len != got.args.len {
      ret false;
    }
    num i = 0;
    for i < want.params.len {
      let want_param = substitute(checked_from_dtype(want.params.get(i)), type_params, generic_args);
      if !self.assignable(want_param, got.args.get(i)) {
        ret false;
      }
      i = i + 1;
    }
    let want_rtype = substitute(checked_from_dtype(want.rtype), type_params, generic_args);
    ret self.assignable(want_rtype, got.rtype);
  }

  // Checks every function-typed parameter's own argument (a bare name,
  // `list.sort_by(my_cmp)`) against its declared signature, rather than
  // letting an unresolved identifier degrade to unknown. True (and
  // reports) on the first mismatch found, so the caller can stop.
  check_fn_sig_args(
    Node* node,
    str name,
    FnSig sig,
    Vec<Node*>* args,
    Vec<str>* type_params,
    Vec<CheckedType>* generic_args
  ) flag {
    num i = 0;
    for i < args.len && i < sig.args.len {
      CheckedType want = sig.args.get(i);
      i = i + 1;
      if !want.has_fn_sig {
        continue;
      }
      fit args.get(i - 1).kind {
        .Identifier(fname) -> {
          let known = self.fns.at(fname);
          if known.is_some() &&
            !self._fn_sig_matches(want.fn_sig, known.unwrap(), type_params, generic_args) {
            self.fail(
              format("argument {num} of '{str}': '{str}' does not match the expected signature", i, name, fname),
              args.get(i - 1)
            );
            ret true;
          }
        }
        _ -> {}
      }
    }
    ret false;
  }

  // Checks the arguments of a call against what the callee declares. A
  // generic callee's parameters stand for whatever the call supplies,
  // so only the shape of such a call is checked.
  check_arguments(
    Node* node,
    str name,
    FnSig sig,
    Vec<Node*>* args,
    TypeEnv* env,
    Vec<str>* type_params,
    Vec<CheckedType>* generic_args
  ) {
    if !sig.is_variadic {
      if args.len > sig.args.len {
        self.fail(format("too many arguments to '{str}'", name), node);
        ret;
      }
      if args.len < sig.min_args {
        self.fail(format("too few arguments to '{str}'", name), node);
        ret;
      }
    }
    // Checked ahead of the generic/plain split below, since a generic
    // callee's OWN type-param bounds are checked instead of its
    // ordinary argument types (see check_type_bounds), but a
    // function-typed parameter's declared signature isn't a type-param
    // bound at all - `Vec<T>.sort_by(cmp)`'s `cmp` needs this checked
    // regardless of `sort_by` being generic in `T`.
    if self.check_fn_sig_args(node, name, sig, args, type_params, generic_args) {
      ret;
    }
    if sig.is_generic {
      self.check_type_bounds(node, name, sig, args, env);
      ret;
    }
    num i = 0;
    for i < args.len && i < sig.args.len {
      CheckedType want = sig.args.get(i);
      if want.has_fn_sig {
        i = i + 1;
        continue;
      }
      CheckedType got = self.infer(args.get(i), env);
      if !self.assignable(want, got) {
        self.fail(
          format(
          "argument {num} of '{str}' expects {str}, found {str}",
          i + 1,
          name,
          type_name(want),
          type_name(got)
          ),
          args.get(i)
        );
        ret;
      }
      i = i + 1;
    }
    num fmt_index = _format_fmt_arg_index(name);
    if fmt_index >= 0 && fmt_index < args.len {
      self.check_format_args(node, name, args, fmt_index, _is_c_style_format(name), env);
    }
  }

  // Cross-checks a format-like variadic call's own trailing arguments
  // against what its format string names, once the fixed leading
  // arguments (a stream, a destination buffer, ...) have already
  // passed the ordinary check above. Silently skips the check (never
  // a false positive) when the format string isn't a literal - the
  // usual convention every real printf-checker follows, since a
  // format built at runtime can't be reasoned about here - or when
  // the C-style parser meets a spec it doesn't confidently recognize.
  check_format_args(Node* node, str name, Vec<Node*>* args, num fmt_index, flag c_style, TypeEnv* env) {
    Node* fmt_node = args.get(fmt_index);
    str fmt_text = "";
    flag is_literal = false;
    fit fmt_node.kind {
      .String(s) -> {
        fmt_text = s;
        is_literal = true;
      }
      _ -> {}
    }
    if !is_literal {
      ret;
    }
    Vec<str> expected;
    if c_style {
      let parsed = _c_format_specs(fmt_text);
      if parsed.is_none() {
        ret;
      }
      expected = parsed.unwrap();
    } else {
      expected = _fun_format_specs(fmt_text);
    }
    defer expected.free();

    num variadic_start = fmt_index + 1;
    num given = args.len - variadic_start;
    if given != expected.len {
      str which = "too many";
      if given < expected.len {
        which = "too few";
      }
      self.fail(
        format(
        "{str} arguments to '{str}': its own format string names {num}, {num} given",
        which,
        name,
        expected.len,
        given
        ),
        node
      );
      ret;
    }
    num k = 0;
    for k < expected.len {
      str want_name = expected.get(k);
      Node* arg_node = args.get(variadic_start + k);
      num arg_position = variadic_start + k + 1;
      k = k + 1;
      if equals(want_name, "") {
        continue;
      }
      CheckedType got = self.infer(arg_node, env);
      if equals(want_name, "ptr") || equals(want_name, "raw") {
        if got.pointer_depth == 0 && got.base != .Raw {
          self.fail(
            format("argument {num} of '{str}' expects a pointer, found {str}", arg_position, name, type_name(got)),
            arg_node
          );
          ret;
        }
        continue;
      }
      // A C-style `%d`/`%x`/... conversion is written for any
      // integral value in ordinary C code, `flag` included (`0`/`1`,
      // as idiomatic there as it is unusual in Fun's own type
      // discipline) - widened here, and only here: `{num}`, Fun's
      // own explicit placeholder spelling, still means exactly num.
      if c_style && equals(want_name, "num") && got.base == .Bin {
        continue;
      }
      CheckedType want = checked_of(_data_type_for(want_name));
      if !self.assignable(want, got) {
        self.fail(
          format(
          "argument {num} of '{str}' expects {str} (from its own format string), found {str}",
          arg_position,
          name,
          want_name,
          type_name(got)
          ),
          arg_node
        );
        ret;
      }
    }
  }

  // Checks `await operand`: only an async function may await, and only
  // an async call is worth awaiting.
  check_await(UnaryNode u, TypeEnv* env) CheckedType {
    if !self.in_async {
      self.fail("await is only allowed in an async function", u.operand);
      ret checked_unknown();
    }
    if !self.awaits_async_call(u.operand, env) {
      self.fail("await expects a call to an async function", u.operand);
      ret checked_unknown();
    }
    ret self.infer_awaited(u.operand, env);
  }

  // The type an awaited call produces, checked as an ordinary call.
  infer_awaited(Node* operand, TypeEnv* env) CheckedType {
    if operand == nil {
      ret checked_unknown();
    }
    fit operand.kind {
      .Expression(e) -> {
        if equals(e.op, "()") {
          ret self.check_call(operand, e, env, true);
        }
      }
      .ExpressionParenthesis(inner) -> { ret self.infer_awaited(inner, env); }
      _ -> {}
    }
    ret self.infer(operand, env);
  }

  // True when `node` calls something the checker knows to be async, or
  // something it cannot resolve, which it does not second-guess.
  awaits_async_call(Node* node, TypeEnv* env) flag {
    if node == nil {
      ret false;
    }
    fit node.kind {
      .ExpressionParenthesis(inner) -> { ret self.awaits_async_call(inner, env); }
      .Expression(e) -> {
        if !equals(e.op, "()") {
          ret false;
        }
        if !e.has_left {
          ret true;
        }
        str name = _callee_name(e.left);
        if equals(name, "") {
          ret self.awaits_async_method(e, env);
        }
        let known = self.fns.at(name);
        if known.is_none() {
          ret true;
        }
        FnSig sig = known.unwrap();
        if sig.ambiguous {
          ret true;
        }
        ret sig.is_async;
      }
      _ -> { ret false; }
    }
    ret false;
  }

  // Checks a call against the callee's signature and reports its return
  // type.
  check_call(Node* node, ExprNode e, TypeEnv* env, flag awaited) CheckedType {
    Vec<Node*> args;
    args.init(4);
    defer args.free();
    if e.has_right {
      _call_args(e.right, &args);
    }

    num i = 0;
    for i < args.len {
      _ = self.infer(args.get(i), env);
      i = i + 1;
    }

    str name = "";
    if e.has_left {
      name = _callee_name(e.left);
    }
    if equals(name, "") {
      ret self.check_method_call(node, e, &args, env, awaited);
    }
    if _is_builtin_call(name) {
      if equals(name, "sizeof") {
        if args.len != 1 || !_names_a_type(args.get(0)) {
          self.fail("sizeof measures a type", node);
          ret checked_of(.Num);
        }
        self.check_sizeof_operand(node, args.get(0));
        ret checked_of(.Num);
      }
      ret checked_unknown();
    }
    let known = self.fns.at(name);
    if known.is_none() {
      // A name bound in scope holds a function rather than naming one -
      // a function-typed parameter, most commonly. Its own declared
      // signature is checked the same way a real function's would be.
      let local = env.lookup(name);
      if local.is_none() {
        self.fail(format("no function named '{str}'", name), node);
        ret checked_unknown();
      }
      let callee = local.unwrap();
      if !callee.has_fn_sig {
        ret checked_unknown();
      }
      let fsig = callee.fn_sig;
      if args.len != fsig.params.len {
        self.fail(
          format("'{str}' expects {num} arguments, got {num}", name, fsig.params.len, args.len),
          node
        );
        ret checked_unknown();
      }
      num ci = 0;
      for ci < fsig.params.len {
        let want = checked_from_dtype(fsig.params.get(ci));
        let got = self.infer(args.get(ci), env);
        if !self.assignable(want, got) {
          self.fail(
            format(
            "argument {num} of '{str}' expects {str}, found {str}",
            ci + 1,
            name,
            type_name(want),
            type_name(got)
            ),
            args.get(ci)
          );
          ret checked_unknown();
        }
        ci = ci + 1;
      }
      ret checked_from_dtype(fsig.rtype);
    }
    FnSig sig = known.unwrap();
    if sig.ambiguous {
      ret checked_unknown();
    }
    self.check_visibility(name, sig.file, sig.is_public, "function", node);
    if self.failed {
      ret checked_unknown();
    }
    // An async call produces its value only once awaited.
    if sig.is_async && !awaited {
      self.fail(format("call to async function '{str}' needs await", name), node);
      ret checked_unknown();
    }
    Vec<CheckedType> no_generic_args;
    no_generic_args.init(0);
    self.check_arguments(node, name, sig, &args, env, &sig.type_params, &no_generic_args);
    ret sig.rtype;
  }
}

// True for `=` and the operators that read and write in one step.
fun _is_assignment(str op) flag {
  if equals(op, "=") {
    ret true;
  }
  if len(op) < 2 || op[len(op) - 1] != '=' {
    ret false;
  }
  str head = substr(op, 0, len(op) - 1);
  ret equals(head, "+") || equals(head, "-") || equals(head, "*") || equals(head, "/") ||
    equals(
    head,
    "%"
  ) || equals(head, "&") || equals(head, "|") || equals(head, "^") || equals(head, "<<") ||
    equals(
    head,
    ">>"
  );
}

// The value an expression is known to hold when it is written out of
// literals. Only the shapes a divisor is plausibly written as are folded:
// a literal, a parenthesized one, and the arithmetic between two of them.
fun _constant_value(Node* node) Option<num> {
  if node == nil {
    ret .None;
  }
  fit node.kind {
    .Number(data) -> {
      fit data {
        .Num(v) -> { ret .Some(v); }
        _ -> {}
      }
    }
    .ExpressionParenthesis(inner) -> { ret _constant_value(inner); }
    .Bracket(inner) -> { ret _constant_value(inner); }
    .Expression(e) -> {
      if !e.has_left || !e.has_right {
        ret .None;
      }
      let left = _constant_value(e.left);
      let right = _constant_value(e.right);
      if left.is_none() || right.is_none() {
        ret .None;
      }
      num l = left.unwrap();
      num r = right.unwrap();
      if equals(e.op, "+") {
        ret .Some(l + r);
      }
      if equals(e.op, "-") {
        ret .Some(l - r);
      }
      if equals(e.op, "*") {
        ret .Some(l * r);
      }
    }
    _ -> {}
  }
  ret .None;
}

// True when `node` is written as a zero, however it is spelled.
fun _is_constant_zero(Node* node) flag {
  let value = _constant_value(node);
  ret value.is_some() && value.unwrap() == 0;
}

// The enum a branch pattern names, for a pattern written in full as
// `Enum.Variant` or `Enum.Variant(x)`. Empty for shorthand, which names
// no enum and so cannot disagree with one.
fun _branch_enum_name(Node* condition) str {
  if condition == nil {
    ret "";
  }
  fit condition.kind {
    .Expression(e) -> {
      if equals(e.op, ".") && e.has_left && e.left != nil {
        fit e.left.kind {
          .Identifier(name) -> { ret name; }
          _ -> {}
        }
      }
      // A destructuring pattern is a call on the variant it names.
      if equals(e.op, "()") && e.has_left {
        ret _branch_enum_name(e.left);
      }
    }
    _ -> {}
  }
  ret "";
}

fun _is_comparison(str op) flag {
  ret equals(op, "==") || equals(op, "!=") || equals(op, "<") || equals(op, ">") ||
    equals(
    op,
    "<="
  ) || equals(op, ">=");
}

fun _is_logical(str op) flag {
  ret equals(op, "&&") || equals(op, "||");
}

impl Checker {
  // A condition asks a question, so it holds a truth value rather than
  // something that merely stands in for one.
  check_condition(Node* condition, TypeEnv* env) {
    CheckedType t = self.infer(condition, env);
    if is_unknown(t) || t.base == .Bin {
      ret;
    }
    self.fail(format("a condition expects flag, found {str}", type_name(t)), condition);
  }

  // Walks an expression written as a statement, for the checks made
  // along the way rather than for the type it produces.
  walk_expr(Node* node, TypeEnv* env) {
    _ = self.infer(node, env);
  }

  // Walks a statement, checking whatever it declares, returns, or
  // evaluates.
  check_statement(Node* stmt, TypeEnv* env) {
    if stmt == nil || self.failed {
      ret;
    }
    fit stmt.kind {
      .Body(body) -> {
        env.push();
        for s : body.statements {
          self.check_statement(s, env);
        }
        env.pop();
      }
      .Variable(v) -> {
        if v.is_destructure {
          self.check_let_destructure(stmt, v, env);
        } else {
          self.check_variable(stmt, v, env);
        }
      }
      .StatementReturn(value) -> { self.check_return(stmt, value, env); }
      .StatementIf(ifn) -> {
        self.check_condition(ifn.condition, env);
        self.check_statement(ifn.body, env);
      }
      .StatementElseIf(ein) -> {
        self.check_condition(ein.condition, env);
        self.check_statement(ein.body, env);
      }
      .StatementElse(body) -> { self.check_statement(body, env); }
      .StatementDefer(inner) -> { self.check_statement(inner, env); }
      .StatementFor(kind) -> { self.check_for(stmt, kind, env); }
      .StatementFit(f) -> { self.check_fit(f, env); }
      .Expression(_) -> { self.walk_expr(stmt, env); }
      .ExpressionParenthesis(_) -> { self.walk_expr(stmt, env); }
      .Unary(_) -> { self.walk_expr(stmt, env); }
      _ -> {}
    }
  }

  // Checks that every branch matches the value being matched. A branch
  // written `Other.Variant` against a different enum's value can never
  // be taken, so it is a mistake rather than a dead branch.
  check_fit(FitStmtNode f, TypeEnv* env) {
    str subject = "";
    CheckedType subject_type = checked_unknown();
    flag have_subject_type = false;
    if f.exp != nil {
      subject_type = self.infer(f.exp, env);
      subject = subject_type.name;
      have_subject_type = true;
    }
    for branch : f.branches {
      if branch.has_condition {
        if branch.is_tuple_pattern {
          self.check_fit_tuple_pattern_condition(branch, subject_type, have_subject_type);
        } else {
          str named = _branch_enum_name(branch.condition);
          if !equals(named, "") && !equals(subject, "") && !equals(named, subject) {
            self.fail(
              format(
              "fit branch names '{str}' but the value being matched is a '{str}'",
              named,
              subject
              ),
              branch.condition
            );
          }
        }
      }
      env.push();
      if branch.is_tuple_pattern && branch.has_condition && have_subject_type &&
        subject_type.is_tuple {
        self.bind_fit_tuple_pattern(branch, subject_type, env);
      }
      self.check_statement(branch.body, env);
      env.pop();
    }
  }

  // Verifies a `(pattern, ...) -> ...` tuple-pattern arm's own shape: the
  // subject must itself be tuple-typed with the same arity as the pattern,
  // and each literal position (a binding position skips this - it accepts
  // any value at its own position) must fit the subject's own element type
  // at that position, the same way an ordinary `fit` label already has to
  // fit the subject's type.
  check_fit_tuple_pattern_condition(
    FitBranch branch,
    CheckedType subject_type,
    flag have_subject_type
  ) {
    if !have_subject_type || !subject_type.is_tuple {
      self.fail("a tuple pattern in 'fit' needs a tuple-typed subject", branch.condition);
      ret;
    }
    fit branch.condition.kind {
      .TupleLiteral(tl) -> {
        if tl.elements.len != subject_type.tuple_members.len {
          self.fail(
            format(
            "a tuple pattern with {num} position(s) needs a {num}-element tuple subject, not '{str}'",
            tl.elements.len,
            subject_type.tuple_members.len,
            type_name(subject_type)
            ),
            branch.condition
          );
          ret;
        }
      }
      _ -> {}
    }
  }

  // Binds each non-wildcard binding position of a tuple-pattern arm to its
  // own element type from the subject, and typechecks each literal
  // position against that same element type - real errors either way, not
  // a silent Unknown fallback, matching the standard `check_let_destructure`
  // and the for-loop's own tuple destructuring already hold tuple patterns
  // to elsewhere in this file. Caller has already verified the arity
  // matches and pushed a fresh `env` scope for the arm body.
  bind_fit_tuple_pattern(FitBranch branch, CheckedType subject_type, TypeEnv* env) {
    fit branch.condition.kind {
      .TupleLiteral(tl) -> {
        if tl.elements.len != subject_type.tuple_members.len {
          ret;
        }
        num i = 0;
        for el : tl.elements {
          CheckedType member = subject_type.tuple_members.get(i);
          flag is_binding = false;
          flag is_wildcard = false;
          str bname = "";
          fit el.kind {
            .Identifier(s) -> {
              if equals(s, "_") {
                is_wildcard = true;
              } else {
                is_binding = true;
                bname = s;
              }
            }
            _ -> {}
          }
          if is_binding {
            env.define(bname, member);
          } elif !is_wildcard {
            let lit_type = self.infer(el, env);
            if !self.assignable(member, lit_type) {
              self.fail(
                format(
                "a tuple pattern position expects a '{str}', not '{str}'",
                type_name(member),
                type_name(lit_type)
                ),
                el
              );
            }
          }
          i = i + 1;
        }
      }
      _ -> {}
    }
  }

  check_for(Node* stmt, ForKind kind, TypeEnv* env) {
    env.push();
    fit kind {
      .Cond(c) -> {
        if c.has_condition {
          _ = self.infer(c.condition, env);
        }
        self.check_statement(c.body, env);
      }
      .Iter(it) -> {
        CheckedType iterable_type = self.infer(it.iterable, env);
        // The real general resolution: does the iterable's own type
        // directly implement `Iterator<Elem>`? Covers `Range`, `Vec`,
        // `Map` (yielding `(K, V)` pairs), `Set`, and any user-defined
        // type with its own `impl X as Iterator<T>`.
        let elem_opt = self.quirk_arg_of(iterable_type, "Iterator");
        if it.item_is_destructure {
          // `for (a, b) : pairs`: the loop item is a tuple, destructured
          // into its own names the same way a declared-type `let`
          // destructuring pattern is - a real element-type mismatch or
          // arity mismatch is a compile error here too, not a silent
          // Unknown fallback, the same standard `check_let_destructure`
          // already holds tuple destructuring to.
          flag matched = false;
          Option<CheckedType> destructure_elem = .None;
          if elem_opt.is_some() {
            destructure_elem = elem_opt;
          } elif iterable_type.generic_args.len >= 1 {
            destructure_elem = .Some(iterable_type.generic_args.get(0));
          }
          if destructure_elem.is_some() {
            let elem = destructure_elem.unwrap();
            if elem.is_tuple && elem.tuple_members.len == it.item_destructure_names.len {
              matched = true;
              num idi = 0;
              for name : it.item_destructure_names {
                env.define(name, elem.tuple_members.get(idi));
                idi = idi + 1;
              }
            } elif elem.is_tuple {
              self.fail(
                format(
                "'for' destructuring pattern has {num} name(s) but the iterable's own element has {num} element(s)",
                it.item_destructure_names.len,
                elem.tuple_members.len
                ),
                stmt
              );
              matched = true;
              for name : it.item_destructure_names {
                env.define(name, checked_unknown());
              }
            }
          }
          if !matched {
            // Not confidently known to be a tuple-elemented iterable
            // (an unresolved reference, or a collection type the
            // checker doesn't model structurally) - binding each name
            // as Unknown lets the rest of the function keep checking,
            // the same leniency an ordinary for-loop item already gets
            // just below.
            for name : it.item_destructure_names {
              env.define(name, checked_unknown());
            }
          }
        } elif it.has_index_name && elem_opt.is_some() {
          let elem = elem_opt.unwrap();
          if elem.is_tuple && elem.tuple_members.len == 2 {
            // A two-name form over anything else yielding a pair (a
            // future Map migrated onto Iterator<(K, V)>, or a user type
            // doing the same) destructures it the same way, rather than
            // this being Map-specific.
            env.define(it.index_name, elem.tuple_members.get(0));
            env.define(it.item_name, elem.tuple_members.get(1));
          } else {
            // Otherwise, "enumerate": a running 0-based count alongside
            // the item, the general form Vec/array's own index/item
            // behavior below is really a special case of.
            env.define(it.index_name, checked_of(.Num));
            env.define(it.item_name, elem);
          }
        } elif elem_opt.is_some() {
          env.define(it.item_name, elem_opt.unwrap());
        } else {
          // What the loop walks holds values of a type the checker
          // does not model yet (Vec/Set/array today).
          env.define(it.item_name, checked_unknown());
          if it.has_index_name {
            env.define(it.index_name, checked_of(.Num));
          }
        }
        self.check_statement(it.body, env);
      }
    }
    env.pop();
  }

  // Rejects a name another file declares only for itself. A file offers
  // what it marks public; the rest is its own business.
  check_visibility(str name, str declared_in, flag is_public, str what, Node* at) {
    if is_public || equals(declared_in, "") || equals(self.current_file, "") {
      ret;
    }
    if equals(declared_in, self.current_file) {
      ret;
    }
    self.fail(format("{str} '{str}' is not public in the file that declares it", what, name), at);
  }

  // Rejects an assignment to a name declared const, and checks that the
  // value assigned fits what the name holds.
  check_assignment(Node* node, ExprNode e, TypeEnv* env) {
    if !e.has_left {
      ret;
    }
    fit e.left.kind {
      .Expression(target) -> {
        if !equals(target.op, ".") || !equals(e.op, "=") || !e.has_right {
          ret;
        }
        CheckedType field = self.infer_field(node, target, env);
        if self.failed {
          ret;
        }
        CheckedType value = self.infer(e.right, env);
        if !self.assignable(field, value) {
          self.fail(
            format(
            "cannot assign {str} to a field of type {str}",
            type_name(value),
            type_name(field)
            ),
            node
          );
        }
      }
      .Identifier(name) -> {
        let bound = env.binding(name);
        if bound.is_none() {
          ret;
        }
        Binding b = bound.unwrap();
        if b.is_const {
          self.fail(format("cannot assign to '{str}', which is const", name), node);
          ret;
        }
        if !equals(e.op, "=") || !e.has_right {
          ret;
        }
        CheckedType value = self.infer(e.right, env);
        if !self.assignable(b.type, value) {
          self.fail(
            format(
            "cannot assign {str} to '{str}' of type {str}",
            type_name(value),
            name,
            type_name(b.type)
            ),
            node
          );
        }
      }
      _ -> {}
    }
  }

  check_variable(Node* stmt, VariableNode v, TypeEnv* env) {
    CheckedType declared = checked_from_dtype(v.var_type);
    if !equals(declared.name, "") {
      str type_name = self.canonical_type_name(declared.name);
      let info = self.compounds.at(type_name);
      if info.is_some() {
        CompoundInfo holder = info.unwrap();
        self.check_visibility(type_name, holder.file, holder.is_public, "compound", stmt);
        if self.failed {
          ret;
        }
      }
    }
    self.check_instantiation(declared, stmt);
    if self.failed {
      ret;
    }
    if v.has_val {
      CheckedType value = self.infer(v.val, env);
      // A `let` takes the type of its value rather than checking one.
      if is_unknown(declared) {
        // A bare enum-variant shorthand (`let v = .Same;`) has no
        // declared type to resolve against, so it falls back to
        // whichever single enum in the whole program owns that variant
        // name (codegen's own resolve_unique_enum_for_variant does the
        // same lookup for real, once this passes). Zero or several
        // owners is not something a fallback can guess through, so it
        // is reported here rather than left to surface as a codegen
        // internal error far from the actual cause.
        let bare_variant = _bare_enum_shorthand_variant(v.val);
        if bare_variant.is_some() {
          str variant_name = bare_variant.unwrap();
          let owners_opt = self.variant_owners.at(variant_name);
          if owners_opt.is_none() {
            self.fail(
              format("no enum declares a variant named '{str}'", variant_name),
              stmt
            );
            ret;
          }
          Vec<str> owners = owners_opt.unwrap();
          if owners.len > 1 {
            StringBuilder ob = string_builder_init(32);
            num oi = 0;
            for oi < owners.len {
              if oi > 0 {
                ob.append(", ");
              }
              ob.append(owners.get(oi));
              oi = oi + 1;
            }
            self.fail(
              format(
              "cannot infer an enum type for '.{str}': ambiguous between {str} (give '{str}' an explicit declared type)",
              variant_name,
              ob.build(),
              v.name
              ),
              stmt
            );
            ret;
          }
        }
        // A quirk names a contract rather than a type a value can be
        // stored as, so it cannot be what a `let` infers.
        if self.quirks.has(value.name) {
          self.fail(
            format("cannot infer a type for '{str}': '{str}' is a quirk", v.name, value.name),
            stmt
          );
          ret;
        }
        // A void-returning call has no value to bind: `let x = noop();`
        // would declare a variable of a type that holds nothing.
        if value.base == .Void && value.pointer_depth == 0 && !value.is_array {
          self.fail(
            format(
            "'let' variable '{str}' cannot be initialized from a value of type void",
            v.name
            ),
            stmt
          );
          ret;
        }
        declared = value;
      } elif !self.assignable(declared, value) {
        self.fail(
          format(
          "cannot initialize '{str}' of type {str} with {str}",
          v.name,
          type_name(declared),
          type_name(value)
          ),
          stmt
        );
        ret;
      }
    }
    env.bind(v.name, declared, v.is_const);
  }

  // `let (a, b, c) = expr;`: unlike an ordinary `let`, whose real
  // inferred type is never written back onto the AST (it lives only in
  // `TypeEnv` via `env.bind` above), this is the only place a
  // destructured name's type is ever resolved at all - each one gets its
  // own `env.bind` call, one per element, exactly like an ordinary
  // `let`'s single call just repeated positionally.
  check_let_destructure(Node* stmt, VariableNode v, TypeEnv* env) {
    if !v.has_val {
      ret;
    }
    CheckedType value = self.infer(v.val, env);
    // A declared tuple type (`(num, str) (a, b) = expr;`) wins the same
    // way an ordinary declared variable's own type does: the initializer
    // must fit it (numeric widening included), and each name binds to
    // its own DECLARED element type, not the initializer's own inferred
    // one - real precision even when the initializer's own shape is
    // wider than what typecheck can pin down (e.g through the pre-
    // existing generic-method-return-type gap `infer_field` already
    // works around elsewhere).
    if !equals(v.var_type.type_str, "__let_infer__") {
      CheckedType declared = checked_from_dtype(v.var_type);
      if !declared.is_tuple || declared.tuple_members.len != v.destructure_names.len {
        self.fail(
          format(
          "a destructuring pattern with {num} name(s) needs a {num}-element declared tuple type, not {str}",
          v.destructure_names.len,
          v.destructure_names.len,
          type_name(declared)
          ),
          stmt
        );
        ret;
      }
      if !is_unknown(value) && !self.assignable(declared, value) {
        self.fail(
          format(
          "cannot initialize a destructuring pattern of type {str} with {str}",
          type_name(declared),
          type_name(value)
          ),
          stmt
        );
        ret;
      }
      num di = 0;
      for name : v.destructure_names {
        env.bind(name, declared.tuple_members.get(di), false);
        di = di + 1;
      }
      ret;
    }
    if is_unknown(value) {
      // Nothing to destructure against yet (an unresolved reference,
      // already reported elsewhere) - binding each name as Unknown lets
      // the rest of the function keep checking instead of cascading.
      for name : v.destructure_names {
        env.bind(name, checked_unknown(), false);
      }
      ret;
    }
    if !value.is_tuple {
      self.fail(
        format("cannot destructure a non-tuple value of type {str}", type_name(value)),
        stmt
      );
      ret;
    }
    if value.tuple_members.len != v.destructure_names.len {
      self.fail(
        format(
        "destructuring pattern has {num} name(s) but the value has {num} element(s)",
        v.destructure_names.len,
        value.tuple_members.len
        ),
        stmt
      );
      ret;
    }
    num i = 0;
    for name : v.destructure_names {
      env.bind(name, value.tuple_members.get(i), false);
      i = i + 1;
    }
  }

  check_return(Node* stmt, Node* value, TypeEnv* env) {
    if value == nil {
      ret;
    }
    CheckedType got = self.infer(value, env);
    if !self.assignable(self.rtype, got) {
      self.fail(
        format(
        "cannot return {str} from a function returning {str}",
        type_name(got),
        type_name(self.rtype)
        ),
        stmt
      );
    }
  }

  // Walks one function with the globals and its parameters in scope.
  // Walks the methods an impl block supplies, with the receiver bound to
  // the type they belong to.
  check_impl(ImplNode block, Vec<Node>* nodes) {
    // A generic impl's methods are written in terms of type parameters
    // the checker does not substitute, so their bodies are left alone.
    if block.has_type_params && block.type_params.len > 0 {
      ret;
    }
    for m : block.methods {
      fit m.kind {
        .Function(f) -> { self.check_function_with_self(f, nodes, block.type_name); }
        _ -> {}
      }
      if self.failed {
        ret;
      }
    }
  }

  // Reports a method a quirk requires that the impl block does not
  // supply.
  check_quirk_conformance(ImplNode block, Node* node) {
    if !block.has_quirk_name {
      ret;
    }
    let declared = self.methods.at(block.quirk_name);
    if declared.is_none() {
      ret;
    }
    MethodTable required = declared.unwrap();
    Vec<str> names = required.methods.keys();
    defer names.free();
    num i = 0;
    for i < names.len {
      str name = names.get(i);
      i = i + 1;
      let supplied = self.method_signature(block.type_name, name);
      if supplied.is_none() {
        self.fail(
          format(
          "'{str}' does not supply '{str}', which '{str}' requires",
          block.type_name,
          name,
          block.quirk_name
          ),
          node
        );
        ret;
      }
      // A method that must be awaited is not interchangeable with one
      // that must not be.
      let promised = required.methods.at(name);
      if promised.is_some() &&
        promised.unwrap().is_async != supplied.unwrap().is_async {
        self.fail(
          format(
          "'{str}' does not match how '{str}' declares '{str}'",
          block.type_name,
          block.quirk_name,
          name
          ),
          node
        );
        ret;
      }
    }
  }

  check_function(FunctionNode f, Vec<Node>* nodes) {
    self.check_function_with_self(f, nodes, "");
  }

  check_function_with_self(FunctionNode f, Vec<Node>* nodes, str self_type) {
    if !f.has_body {
      ret;
    }
    // Once a parameter carries a default, every parameter after it must
    // too, or a call omitting only the later ones would leave no way to
    // tell which trailing argument binds to which parameter.
    flag seen_default_param = false;
    for pa : f.args {
      fit pa.kind {
        .Variable(pv) -> {
          if pv.has_val {
            seen_default_param = true;
          } elif seen_default_param {
            self.fail("a parameter without a default cannot follow a parameter with a default", pa);
            ret;
          }
        }
        _ -> {}
      }
    }
    TypeEnv env = type_env_new();
    defer env.free();
    env.push();
    num g = 0;
    for g < nodes.len {
      fit nodes.data[g].kind {
        .Variable(v) -> {
          env.bind(v.name, checked_from_dtype(v.var_type), v.is_const);
        }
        _ -> {}
      }
      g = g + 1;
    }
    env.push();
    if !equals(self_type, "") {
      CheckedType receiver = checked_unknown();
      receiver.name = self_type;
      env.define("self", receiver);
    }
    for a : f.args {
      fit a.kind {
        .Variable(v) -> {
          env.define(v.name, _erase_type_params(f, checked_from_dtype(v.var_type)));
        }
        _ -> {}
      }
    }
    // The parameters this declaration names stand for types the checker
    // never sees, so they are held while its body is checked: a name
    // that is one of them is a type, not a name nothing declares.
    Vec<str> previous_params = self.active_type_params;
    Vec<str> params;
    params.init(4);
    if f.has_type_params {
      for tp : f.type_params {
        params.push(tp);
      }
    }
    self.active_type_params = params;

    CheckedType previous = self.rtype;
    flag previous_async = self.in_async;
    self.in_async = f.is_async;
    self.rtype = checked_unknown();
    if f.has_rtype {
      self.rtype = _erase_type_params(f, checked_from_dtype(f.rtype));
    }
    self.check_statement(f.body, &env);
    self.rtype = previous;
    self.in_async = previous_async;
    self.active_type_params.free();
    self.active_type_params = previous_params;
    env.pop();
    env.pop();
  }
}

// Registers `name` as declared at `node`, as `kind` (a human-readable
// label: "a function", "a global variable", "a compound", "an enum"),
// failing `checker` when another declaration already claimed it - a
// function, a global variable, a compound, and an enum each lower to
// their own top-level C symbol or typedef, so any two of them sharing a
// name collide regardless of whether they are the same kind. True when
// this failed (the caller should stop and return the error).
fun _check_duplicate_top_level(Checker* checker, str name, str kind, Node* node) flag {
  let existing = checker.declared_at.at(name);
  if existing.is_some() {
    TopLevelSite site = existing.unwrap();
    checker.fail(
      format(
      "'{str}' is already declared as {str} in {str}:{num}",
      name,
      site.kind,
      site.file,
      site.line
      ),
      node
    );
    ret true;
  }
  TopLevelSite site;
  site.kind = kind;
  site.file = "";
  site.line = 0;
  if node.has_pos {
    site.file = node.pos.filename;
    site.line = node.pos.line;
  }
  checker.declared_at.put(name, site);
  ret false;
}

// Checks a whole program, reporting the first type error it finds.
pub fun typecheck_program(Vec<Node>* nodes) Result<flag, TypeError> {
  Checker checker = _checker_new();
  defer _free_fn_sig_map(&checker.fns);
  defer checker.declared_at.free();
  defer checker.quirks.free();
  defer _free_quirk_implementors_map(&checker.quirk_implementors);
  defer checker.quirk_elem_by_type.free();
  defer checker.plain_enums.free();
  defer checker.globals.free();
  defer checker.enum_names.free();
  defer _free_variant_owners_map(&checker.variant_owners);
  defer _free_compound_info_map(&checker.compounds);
  defer _free_method_tables(&checker.methods);
  defer checker.active_type_params.free();

  num i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .Function(f) -> {
        if f.has_name {
          if _check_duplicate_top_level(&checker, f.name, "a function", node) {
            ret .Err(checker.error);
          }
          FnSig sig = _signature_of(f);
          sig.is_public = node.flags.is_public;
          if node.has_pos {
            sig.file = node.pos.filename;
          }
          // A name that resolves to more than one declaration cannot be
          // matched to one of them here.
          let existing = checker.fns.at(f.name);
          if existing.is_some() {
            sig.ambiguous = true;
          }
          checker.fns.put(f.name, sig);
        }
      }
      .Quirk(q) -> {
        checker.quirks.add(q.name);
        MethodTable table = _method_table_new();
        for m : q.methods {
          // A generic quirk's methods mention its type parameters, which
          // stand for whatever the implementing type supplies.
          FnSig sig = _signature_of_quirk_method(m);
          if q.is_generic {
            sig = _erase_signature(sig, &q.type_params);
          }
          table.methods.put(m.name, sig);
        }
        checker.methods.put(q.name, table);
      }
      .Variable(v) -> {
        if _check_duplicate_top_level(&checker, v.name, "a global variable", node) {
          ret .Err(checker.error);
        }
        GlobalInfo info;
        info.is_public = node.flags.is_public;
        info.file = "";
        if node.has_pos {
          info.file = node.pos.filename;
        }
        checker.globals.put(v.name, info);
      }
      .Enum(e) -> {
        if _check_duplicate_top_level(&checker, e.name, "an enum", node) {
          ret .Err(checker.error);
        }
        // No variants lowers to an empty C `enum`, which is invalid;
        // rejected here rather than left for the C compiler to explain.
        if e.variants.len == 0 {
          checker.fail(format("enum '{str}' must declare at least one variant", e.name), node);
          ret .Err(checker.error);
        }
        flag carries_data = false;
        for v : e.variants {
          if v.has_payload && v.payload.len > 0 {
            carries_data = true;
          }
        }
        checker.enum_names.add(e.name);
        if !carries_data {
          checker.plain_enums.add(e.name);
        }
        for v : e.variants {
          str owner = substr(e.name, 0, len(e.name));
          let existing = checker.variant_owners.at(v.name);
          if existing.is_some() {
            Vec<str> owners = existing.unwrap();
            owners.push(owner);
            checker.variant_owners.put(v.name, owners);
          } else {
            Vec<str> owners2;
            owners2.init(2);
            owners2.push(owner);
            checker.variant_owners.put(v.name, owners2);
          }
        }
      }
      .Compound(c) -> {
        if _check_duplicate_top_level(&checker, c.name, "a compound", node) {
          ret .Err(checker.error);
        }
        CompoundInfo info;
        info.is_public = node.flags.is_public;
        info.file = "";
        if node.has_pos {
          info.file = node.pos.filename;
        }
        info.fields.init(c.fields.len + 1);
        info.type_params.init(0);
        info.bounds.init(0);
        info.is_generic = c.has_type_params && c.type_params.len > 0;
        if c.has_type_params {
          for p : c.type_params {
            info.type_params.push(p);
          }
        }
        if c.has_type_param_forced_insts {
          for b : c.type_param_forced_insts {
            info.bounds.push(b);
          }
        }
        for field : c.fields {
          info.fields.put(field.name, checked_from_dtype(field.dtype));
        }
        checker.compounds.put(c.name, info);
      }
      .Impl(block) -> {
        checker.register_impl(block);
        if block.has_quirk_name {
          checker.record_quirk_impl(block.type_name, block.quirk_name);
          if block.has_quirk_arg_dtype {
            StringBuilder qeb_key_sb = string_builder_init(24);
            qeb_key_sb.append(block.type_name);
            qeb_key_sb.append("::");
            qeb_key_sb.append(block.quirk_name);
            checker.quirk_elem_by_type.put(
              qeb_key_sb.build(),
              checked_from_dtype(block.quirk_arg_dtype)
            );
          }
        }
      }
      _ -> {}
    }
  }

  i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .Function(f) -> {
        checker.current_file = "";
        if node.has_pos {
          checker.current_file = node.pos.filename;
        }
        checker.check_function(f, nodes);
      }
      .Impl(block) -> {
        checker.current_file = "";
        if node.has_pos {
          checker.current_file = node.pos.filename;
        }
        checker.check_quirk_conformance(block, node);
        checker.check_impl(block, nodes);
      }
      .Variable(v) -> {
        checker.current_file = "";
        if node.has_pos {
          checker.current_file = node.pos.filename;
        }
        TypeEnv global_env = type_env_new();
        checker.check_variable(node, v, &global_env);
      }
      _ -> {}
    }
    if checker.failed {
      ret .Err(checker.error);
    }
  }
  ret .Ok(true);
}

test "a value stands for a type it can be assigned to" {
  CheckedType num_t = checked_of(.Num);
  CheckedType dec_t = checked_of(.Dec);
  CheckedType str_t = checked_of(.Str);
  CheckedType bin_t = checked_of(.Bin);
  assert can_assign(dec_t, num_t), "expected a whole number to widen into a decimal";
  assert !can_assign(num_t, dec_t), "expected a decimal not to narrow on its own";
  assert !can_assign(num_t, str_t), "expected a string not to stand for a number";
  assert !can_assign(num_t, bin_t), "expected a truth value not to stand for a number";
  assert can_assign(checked_unknown(), str_t), "expected an unresolved type to accept anything";
}

test "nil and zero stand for a pointer, and zero stays a number" {
  CheckedType raw_t = checked_of(.Raw);
  raw_t.pointer_depth = 1;
  CheckedType zero = checked_of(.Num);
  zero.is_null_literal = true;
  assert can_assign(raw_t, zero), "expected zero to stand for a null pointer";
  assert can_assign(checked_of(.Num), zero), "expected zero to remain a number";
}

test "an array stands for a pointer to what it holds" {
  CheckedType chars;
  chars = checked_of(.Chr);
  chars.is_array = true;
  chars.array_depth = 1;
  assert can_assign(checked_of(.Str), chars), "expected characters to stand for a string";
}

test "a written type reads back as what it was written as" {
  CheckedType pointer = checked_of(.Num);
  pointer.pointer_depth = 1;
  assert equals(type_name(pointer), "num*"), "expected the pointer spelling";
  CheckedType named = checked_unknown();
  named.name = "Counter";
  assert equals(type_name(named), "Counter"), "expected the written name";
}

test "a scope hides an outer binding of the same name" {
  TypeEnv env = type_env_new();
  defer env.free();
  env.push();
  env.define("x", checked_of(.Num));
  env.push();
  env.define("x", checked_of(.Str));
  let inner = env.lookup("x");
  assert inner.is_some(), "expected the name to resolve";
  assert inner.unwrap().base == .Str, "expected the inner binding";
  env.pop();
  let outer = env.lookup("x");
  assert outer.unwrap().base == .Num, "expected the outer binding to return";
}
