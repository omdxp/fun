// Type checking.
//
// The checker walks each function body with the types of everything in
// scope, infers the type of every expression it meets, and reports the
// first place where a value cannot stand for the type expected of it.
// Anything it cannot resolve infers as unknown, which stands for any
// type, so a gap in the checker never rejects a correct program.

use ..ast.ast;
use ..lexer.token;
use ..parser.datatype_defs;
use std.string;
use std.io;
use std.vec;
use std.map;
use std.set;
use std.option;
use std.result;

// What a value is, as far as the checker can tell.
pub compound CheckedType {
  DataTypeType base;
  flag is_array;
  num array_depth;
  // Each dimension's own declared size, outermost first, when every
  // dimension was written with one and it folds to a literal number
  // (`num[3][4]`'s own `[3, 4]`) - `-1` at an index whose dimension's
  // size doesn't fold (a non-constant size expression), empty when
  // `is_array` is false or the declaration left any dimension bare
  // (`num[]`). Indexing (`infer`'s own `"[]"` case, `check_index_
  // assignment`) checks a constant index against this dimension's own
  // first entry before dropping it for whatever dimension remains.
  Vec<num> array_sizes;
  num pointer_depth;
  // `nil`, which stands for a pointer or a string of any type.
  flag is_null_literal;
  // `panic(...)`, which never produces a value and so stands for any
  // type expected of it.
  flag is_panic_literal;
  // The written name of a user-defined type, empty for a builtin.
  str name;
  // A fixed-width number's own spelling (`u8`, `i32`, `f32`), which the
  // checker otherwise treats as plain `num`/`dec`; empty for those two.
  str width;
  // The arguments a generic instantiation supplied, in the order the
  // type declares its parameters.
  Vec<CheckedType> generic_args;
  // A function-typed value's own declared signature (`fun(T1, T2) R`),
  // carried through so a value bound to it (a name referencing a known
  // top-level function, or another function-typed local) can be checked
  // against it, rather than degrading to unknown.
  flag has_fn_sig;
  FnTypeSig* fn_sig;
  // A capturing closure's own declared signature (`closure(T) R`), kept
  // entirely separate from `has_fn_sig`/`fn_sig` above - mirrors
  // `DataType`'s own identical split, for the identical reason: a
  // closure's runtime shape is not binary-compatible with a plain bare
  // function pointer, so the two must never be treated as the same
  // type.
  flag has_closure_sig;
  FnTypeSig* closure_sig;
  // A closure that captures a local by reference (`fun[&n]`), which must
  // not outlive the function that local belongs to.
  flag holds_refs;
  // A real tuple type (`(num, str)`). Like a function type, this has no
  // `name` of its own, so `is_unknown` must never treat one as
  // unresolved just because `name` is empty.
  flag is_tuple;
  Vec<CheckedType> tuple_members;
  // The top-level function a bare name refers to when it is used as a
  // value (`handlers[0] = on_tick;`), so it can be checked against the
  // `fun(...)` slot it is stored in; empty otherwise.
  str function_name;
}

pub fun checked_unknown() CheckedType {
  CheckedType t;
  t.base = .Unknown;
  t.is_array = false;
  t.array_depth = 0;
  t.array_sizes.init(0);
  t.pointer_depth = 0;
  t.is_null_literal = false;
  t.is_panic_literal = false;
  t.name = "";
  t.width = "";
  t.generic_args.init(0);
  t.has_fn_sig = false;
  t.fn_sig = nil;
  t.has_closure_sig = false;
  t.closure_sig = nil;
  t.holds_refs = false;
  t.is_tuple = false;
  t.tuple_members.init(0);
  t.function_name = "";
  ret t;
}

pub fun checked_of(DataTypeType base) CheckedType {
  CheckedType t = checked_unknown();
  t.base = base;
  ret t;
}

// The checked form of a written type annotation.
pub fun checked_from_dtype(DataType* dt) CheckedType {
  CheckedType t = checked_unknown();
  if dt == nil {
    ret t;
  }
  t.base = dt.kind;
  if (t.base == .Num || t.base == .Dec) && !equals(dt.type_str, "num") &&
    !equals(dt.type_str, "dec") {
    t.width = dt.type_str;
  }
  t.is_array = dt.is_array;
  t.array_depth = dt.array_depth;
  // An array written without a size carries no depth of its own, but it
  // is still one deep.
  if t.is_array && t.array_depth == 0 {
    t.array_depth = 1;
  }
  // Only every dimension sized (`dt.array_brackets.len == dt.array_
  // depth`) folds to anything at all - a mix of sized and bare
  // dimensions can't be matched back up positionally either (see
  // `render_type`'s own identical guard), so bounds-checking stays off
  // rather than guessing which entry belongs to which dimension.
  if dt.is_array && dt.array_depth > 0 && dt.array_brackets.len == dt.array_depth {
    num ai = 0;
    for ai < dt.array_brackets.len {
      let sz = _constant_value(dt.array_brackets.get(ai));
      if sz.is_some() {
        t.array_sizes.push(sz.unwrap());
      } else {
        t.array_sizes.push(-1);
      }
      ai = ai + 1;
    }
  }
  t.pointer_depth = dt.pointer_depth;
  if dt.flags.is_pointer && t.pointer_depth == 0 {
    t.pointer_depth = 1;
  }
  if t.base == .Unknown {
    t.name = dt.type_str;
  }
  num i = 0;
  for i < dt.generic_args.len {
    t.generic_args.push(checked_from_dtype(dt.generic_args.get(i)));
    i = i + 1;
  }
  t.has_fn_sig = dt.has_fn_sig;
  t.fn_sig = dt.fn_sig;
  t.has_closure_sig = dt.has_closure_sig;
  t.closure_sig = dt.closure_sig;
  t.is_tuple = dt.is_tuple;
  num ti = 0;
  for ti < dt.tuple_members.len {
    t.tuple_members.push(checked_from_dtype(dt.tuple_members.get(ti)));
    ti = ti + 1;
  }
  ret t;
}

// Replaces each type parameter in `t` with what the instantiation
// supplied for it, leaving anything else as written.
pub fun substitute(CheckedType t, Vec<str>* params, Vec<CheckedType>* args) CheckedType {
  if params.len == 0 || args.len == 0 {
    ret t;
  }
  num i = 0;
  for i < params.len && i < args.len {
    if !equals(t.name, "") && equals(params.get(i), t.name) {
      // The parameter stands for the argument, while whatever was
      // written around it (a pointer, an array) still applies.
      CheckedType out = args.get(i);
      out.pointer_depth = out.pointer_depth + t.pointer_depth;
      if t.is_array {
        out.is_array = true;
        out.array_depth = out.array_depth + t.array_depth;
      }
      ret out;
    }
    i = i + 1;
  }
  // `t` itself isn't a bare type param, but one can still be nested
  // further in (`MyOpt<T>`'s own `T`, a tuple's own element type) -
  // without this, a generic enum/compound's own return type
  // substituted its outer name just fine but left every nested type-
  // param argument exactly as written. Confirmed directly as the
  // reason a generic function's own call-site return type (`wrap<T>(T
  // v) MyOpt<T>`) never resolved to anything concrete: `MyOpt` isn't
  // itself `T`, so the loop above never even looks inside its own
  // generic args. Builds fresh `Vec`s rather than mutating `t`'s own
  // in place: `t` is frequently a shared template read on every call
  // to the same generic function (`sig.rtype_template`), never
  // uniquely owned by this one substitution, so freeing its own
  // backing arrays here - even to replace them - would corrupt every
  // other call still holding the same template. The old ones are
  // simply left unfreed (their own shell abandoned, not uniquely
  // owned either), the same tradeoff every other CheckedType built
  // this way already accepts for a short-lived compile process.
  if t.generic_args.len > 0 {
    Vec<CheckedType> substituted_args;
    substituted_args.init(t.generic_args.len);
    num g = 0;
    for g < t.generic_args.len {
      substituted_args.push(substitute(t.generic_args.get(g), params, args));
      g = g + 1;
    }
    t.generic_args = substituted_args;
  }
  if t.tuple_members.len > 0 {
    Vec<CheckedType> substituted_members;
    substituted_members.init(t.tuple_members.len);
    num m = 0;
    for m < t.tuple_members.len {
      substituted_members.push(substitute(t.tuple_members.get(m), params, args));
      m = m + 1;
    }
    t.tuple_members = substituted_members;
  }
  ret t;
}

// A name the checker cannot resolve stands for any type, so it never
// rejects what it does not understand.
pub fun is_unknown(CheckedType t) flag {
  if t.base != .Unknown {
    ret false;
  }
  // A tuple has no `name` of its own, same as a function type already
  // carries `has_fn_sig` instead of a name - neither is "the checker
  // doesn't understand this", so neither reaches the empty-name check
  // below, which exists for a genuine placeholder/unresolved reference.
  if t.is_tuple || t.has_fn_sig || t.has_closure_sig {
    ret false;
  }
  // A `let` carries a placeholder until its value is known, which is
  // exactly what the checker fills in.
  ret equals(t.name, "") || equals(t.name, LET_INFER_TYPE);
}

// The placeholder the parser writes for a `let` declaration's type.
pub const str LET_INFER_TYPE = "__let_infer__";

// True for a single number, character, string, or flag: not an array, a
// pointer, a tuple, or a function value.
fun _is_scalar_value(CheckedType t) flag {
  if t.is_array || t.pointer_depth > 0 || t.is_tuple || t.has_fn_sig ||
  t.has_closure_sig {
    ret false;
  }
  fit t.base {
    .Chr -> { ret true; }
    .Str -> { ret true; }
    .Dec -> { ret true; }
    .Num -> { ret true; }
    .Bin -> { ret true; }
    _ -> { ret false; }
  }
}

pub fun type_name(CheckedType t) str {
  if t.is_tuple {
    StringBuilder tb = string_builder_init(16);
    tb.append("(");
    num ti = 0;
    for ti < t.tuple_members.len {
      if ti > 0 {
        tb.append(", ");
      }
      tb.append(type_name(t.tuple_members.get(ti)));
      ti = ti + 1;
    }
    tb.append(")");
    num pi = 0;
    for pi < t.pointer_depth {
      tb.append("*");
      pi = pi + 1;
    }
    ret tb.build();
  }
  if !equals(t.function_name, "") {
    ret format("function '{str}'", t.function_name);
  }
  flag is_closure = t.has_closure_sig && t.closure_sig != nil;
  if is_closure || (t.has_fn_sig && t.fn_sig != nil) {
    FnTypeSig* sig = is_closure ? t.closure_sig : t.fn_sig;
    StringBuilder fb = string_builder_init(16);
    fb.append(is_closure ? "closure(" : "fun(");
    num fi = 0;
    for fi < sig.params.len {
      if fi > 0 {
        fb.append(", ");
      }
      fb.append(type_name(checked_from_dtype(sig.params.get(fi))));
      fi = fi + 1;
    }
    fb.append(")");
    CheckedType fr = checked_from_dtype(sig.rtype);
    if fr.base != .Void || fr.pointer_depth > 0 {
      fb.append(" ");
      fb.append(type_name(fr));
    }
    if t.is_array {
      fb.append("[]");
    }
    ret fb.build();
  }
  str base = "unknown";
  fit t.base {
    .Void -> { base = "void"; }
    .Raw -> { base = "raw"; }
    .Chr -> { base = "chr"; }
    .Str -> { base = "str"; }
    .Dec -> { base = "dec"; }
    .Num -> { base = "num"; }
    .Bin -> { base = "flag"; }
    .Unknown -> {
      if !equals(t.name, "") {
        base = t.name;
      }
    }
  }
  if (t.base == .Num || t.base == .Dec) && !equals(t.width, "") {
    base = t.width;
  }
  StringBuilder b = string_builder_init(len(base) + 4);
  b.append(base);
  // What a generic was instantiated with is part of what it is: without
  // this, two different instantiations both read as `Box` and a message
  // about them says nothing.
  if t.generic_args.len > 0 {
    b.append("<");
    num g = 0;
    for g < t.generic_args.len {
      if g > 0 {
        b.append(", ");
      }
      b.append(type_name(t.generic_args.get(g)));
      g = g + 1;
    }
    b.append(">");
  }
  num i = 0;
  for i < t.pointer_depth {
    b.append("*");
    i = i + 1;
  }
  i = 0;
  for i < t.array_depth {
    b.append("[]");
    i = i + 1;
  }
  ret b.build();
}

// The written name of a leaf (non-generic) type for mangling purposes.
// A primitive carries its kind via `base`, never `name` (see
// `is_unknown`'s own doc), so `t.name` alone is blank for one - this
// maps it back to the keyword `impl Atomic<num>` itself was written
// with, matching `_mangled_dtype_name`'s identical mapping over the
// parser's own `DataType`.
fun _mangled_leaf_name(CheckedType t) str {
  fit t.base {
    .Void -> { ret "void"; }
    .Raw -> { ret "raw"; }
    .Chr -> { ret "chr"; }
    .Str -> { ret "str"; }
    .Dec -> { ret "dec"; }
    .Num -> { ret "num"; }
    .Bin -> { ret "flag"; }
    .Unknown -> { ret t.name; }
  }
}

// The name an instantiation is registered under, which carries its
// arguments the way an impl on a concrete instantiation is written
// (`impl Vec<str>` registers as `Vec__str`).
// Borrows `t.name` when `t` has no generic args at all (the common
// case); allocates a fresh string otherwise. Every caller needs to
// check `t.generic_args.len` itself (or a nested arg's own, for the
// recursive case just below) before deciding whether the result is
// theirs to free - mirrors `canonical_type_name`'s identical contract.
pub fun mangled_name(CheckedType t) str {
  if t.generic_args.len == 0 {
    ret _mangled_leaf_name(t);
  }
  StringBuilder b = string_builder_init(len(t.name) + 8);
  b.append(_mangled_leaf_name(t));
  num i = 0;
  for i < t.generic_args.len {
    b.append("__");
    CheckedType arg = t.generic_args.get(i);
    str arg_mangled = mangled_name(arg);
    b.append(arg_mangled);
    if arg.generic_args.len > 0 {
      free(arg_mangled);
    }
    i = i + 1;
  }
  ret b.build();
}

// True when a value of type `from` can stand where `to` is expected.
pub fun can_assign(CheckedType to, CheckedType from) flag {
  if is_unknown(to) || is_unknown(from) {
    ret true;
  }
  if from.is_panic_literal {
    ret true;
  }
  // `nil`, and the zero it is written as, stand for any pointer, and
  // for a string, which is one. Zero remains a number besides.
  if from.is_null_literal &&
    (to.pointer_depth > 0 || to.base == .Str || to.base == .Raw) {
    ret true;
  }
  // A raw pointer stands for any pointer, in either direction, and a
  // string is a pointer.
  if to.base == .Raw &&
  (from.pointer_depth > 0 || from.base == .Str) {
    ret true;
  }
  // A raw pointer stands for any pointer, and for the array storage a
  // pointer is how you allocate.
  if from.base == .Raw &&
  (to.pointer_depth > 0 || to.is_array || to.base == .Str) {
    ret true;
  }
  // An array stands for a pointer to what it holds, as it does in C,
  // and an array of characters is what a string is.
  if from.is_array && !to.is_array {
    if to.base == .Str && from.base == .Chr {
      ret true;
    }
    // An array of depth N stands for a pointer of depth N.
    if to.pointer_depth == from.array_depth + from.pointer_depth {
      if to.base == .Raw {
        ret true;
      }
      ret to.base == from.base && equals(to.name, from.name);
    }
  }
  if to.pointer_depth != from.pointer_depth {
    ret false;
  }
  if to.array_depth != from.array_depth {
    ret false;
  }
  // A whole number widens into a decimal, but a decimal does not narrow
  // back into one without being asked to.
  if _is_numeric(to) && _is_numeric(from) {
    ret to.base == .Dec || from.base != .Dec;
  }
  if to.base != from.base {
    ret false;
  }
  if to.base == .Unknown {
    // A tuple has no `name` of its own (both sides would read "" and
    // wrongly compare equal below) - arity is the only check this
    // standalone, `self`-less function can make; per-element
    // compatibility is `assignable`'s own job, via `tuple_members_agree`.
    if to.is_tuple || from.is_tuple {
      if !to.is_tuple || !from.is_tuple {
        ret false;
      }
      ret to.tuple_members.len == from.tuple_members.len;
    }
    ret equals(to.name, from.name);
  }
  ret true;
}

fun _is_numeric(CheckedType t) flag {
  if t.pointer_depth > 0 || t.is_array {
    ret false;
  }
  // A truth value is not a number: it neither widens into one nor
  // stands for one.
  ret t.base == .Num || t.base == .Dec || t.base == .Chr;
}

// What a function accepts and returns.
pub compound FnSig {
  CheckedType rtype;
  Vec<CheckedType> args;
  // The number of leading parameters a caller must pass; the rest carry
  // defaults.
  num min_args;
  flag is_variadic;
  flag is_async;
  // A generic function's checks are left to the instantiation, since a
  // type parameter stands for whatever the call site supplies.
  flag is_generic;
  // Set when the name belongs to more than one declaration, where a
  // call cannot be matched to one of them by name alone.
  flag ambiguous;
  // Where the function was declared, and whether it is offered to other
  // files.
  str file;
  flag is_public;
  // The type parameters the declaration names, the types each one is
  // allowed to stand for (empty where unconstrained), and, per
  // parameter, the type parameter it is written as (empty otherwise).
  Vec<str> type_params;
  Vec<Vec<str>> bounds;
  Vec<str> arg_params;
  // Each type param's own declared default (`E = Error`), index-
  // aligned with `type_params`; `checked_unknown()` for one with none.
  // What a call explicitly naming fewer type arguments than `type_
  // params.len` falls back to for the trailing, un-named positions -
  // `wrap<num>(5)` on `fun wrap<T, E = Error>(T v) T` needs `E`
  // resolved to `Error` from here, the same way a parameter with its
  // own default may be left off a call's own argument list.
  Vec<CheckedType> type_param_defaults;
  // `rtype` exactly as written, before any erasure - `unwrap(Result<T,
  // E>* self) T*`'s own `T*`, pointer/array wrapping and all, kept
  // alongside `rtype` itself rather than instead of it: `rtype` gets
  // erased to a nameless Unknown the moment the method belongs to a
  // generic impl (`_erase_signature`), which is right for every OTHER
  // use of a generic method's signature (nothing but the instantiation
  // knows what it really is) but leaves no way for a method CALL to
  // substitute the receiver's own concrete type back into it - this is
  // that original, always `substitute`-ready regardless of whether
  // erasure ever touched anything (a non-generic method's own copy is
  // just `rtype` again, so substituting it is always safe to do
  // unconditionally). Confirmed directly as the reason `Result<num,
  // str>.unwrap()`'s own return type reached a `fit` statement (or
  // anything else needing the REAL type, not just "something") still
  // Unknown, indistinguishable from a genuinely unresolved expression.
  CheckedType rtype_template;
}

// A method call's own resolved signature, alongside the receiver's own
// checked type (its generic args among them), needed to substitute a
// generic method's type parameters into a nested function-typed
// parameter's own signature.
pub compound MethodResolution {
  FnSig sig;
  CheckedType receiver;
}

// What a top-level variable offers, and where it was declared.
compound GlobalInfo {
  str file;
  flag is_public;
}

// Where checking failed, and why.
pub compound TypeError {
  str message;
  Pos pos;
  flag has_pos;
}

fun _error(str message, Node* node) TypeError {
  TypeError e;
  e.message = message;
  e.has_pos = false;
  if node != nil && node.has_pos {
    e.pos = node.pos;
    e.has_pos = true;
  }
  ret e;
}

// A name in scope: what it holds, and whether it may be assigned again.
pub compound Binding {
  CheckedType type;
  flag is_const;
}

// The names in scope, innermost last.
pub compound TypeEnv {
  Vec<Map<str, Binding>> scopes;
}

pub fun type_env_new() TypeEnv {
  TypeEnv e;
  e.scopes.init(4);
  ret e;
}

impl TypeEnv {
  pub push() {
    Map<str, Binding> scope;
    scope.init(8);
    self.scopes.push(scope);
  }

  // Every binding this scope holds owns an independent, deep-cloned
  // `CheckedType` (see `bind`'s own note on why), so freeing each one
  // here can never reach back into a still-live outer scope's own
  // binding, or into whatever `infer()` call site originally produced
  // the value a binding started from.
  pub pop() {
    if self.scopes.len == 0 {
      ret;
    }
    Map<str, Binding> scope = self.scopes.pop();
    Vec<str> names = scope.keys();
    defer names.free();
    for name : names {
      Binding b = scope.at(name).unwrap();
      _free_checked_type_contents(&b.type);
    }
    scope.free();
  }

  pub define(str name, CheckedType type) {
    self.bind(name, type, false);
  }

  // `type` is deep-cloned before storing: a bare `let y = x;` infers
  // `y`'s own type by looking `x` up, and that lookup returns `x`'s
  // own stored `CheckedType` by value - its `generic_args`/
  // `tuple_members` Vecs are shallow copies of the *same* backing
  // arrays `x`'s own binding holds, not independent ones. Storing
  // that straight into `y`'s own binding would leave two scopes'
  // worth of bindings sharing one allocation, which `pop`'s own
  // per-binding free (see its note) would then free twice the moment
  // both scopes eventually pop - once safely, once as a double free.
  // A clone here means every binding, however it was produced, owns
  // its own copy from the moment it's stored.
  pub bind(str name, CheckedType type, flag is_const) {
    if self.scopes.len == 0 {
      self.push();
    }
    Binding b;
    b.type = _clone_checked_type(type);
    b.is_const = is_const;
    self.scopes.data[self.scopes.len - 1].put(name, b);
  }

  // What `name` is bound to, searching inner scopes first.
  pub binding(str name) Option<Binding> {
    num i = self.scopes.len;
    for i > 0 {
      i = i - 1;
      let found = self.scopes.data[i].at(name);
      if found.is_some() {
        ret found;
      }
    }
    ret .None;
  }

  // The type bound to `name`, searching inner scopes first.
  pub lookup(str name) Option<CheckedType> {
    ret .Some(self.binding(name)?.type);
  }

  pub free() {
    for self.scopes.len > 0 {
      self.pop();
    }
    self.scopes.free();
  }
}

// What a compound holds, keyed by field name.
compound CompoundInfo {
  Map<str, CheckedType> fields;
  // Where the compound was declared, and whether it is offered to other
  // files.
  str file;
  flag is_public;
  // The parameters the fields are written in terms of, which an
  // instantiation supplies arguments for, and the combinations of
  // concrete types those parameters are allowed to stand for.
  Vec<str> type_params;
  Vec<Vec<str>> bounds;
  // A generic compound's fields mention its type parameters, which
  // stand for whatever an instantiation supplies.
  flag is_generic;
  // A `union`, whose fields share one storage, so a literal sets one.
  flag is_union;
}

// The methods declared on a type, keyed by method name. A shape's
// methods are registered the same way, since a call reads the same.
compound MethodTable {
  Map<str, FnSig> methods;
}

// Frees a compound's own scratch. `.fields`'s own values are each a
// fresh `checked_from_dtype` build (see its own registration site),
// not an alias of anything - freed deeply here, keys left untouched
// since those are the declaring CompoundNode's own borrowed field
// names.
fun _free_compound_info(CompoundInfo* info) {
  _free_checked_type_map_borrowed_keys(&info.fields);
  info.type_params.free();
  info.bounds.free();
}

// Frees every compound's own scratch (`_free_compound_info`), then
// the map itself.
fun _free_compound_info_map(Map<str, CompoundInfo>* compounds) {
  Vec<str> names = compounds.keys();
  defer names.free();
  num i = 0;
  for i < names.len {
    CompoundInfo info = compounds.at(names.get(i)).unwrap();
    _free_compound_info(&info);
    i = i + 1;
  }
  compounds.free();
}

// Heap-allocated, never a bare `MethodTable` value: `Checker.methods`
// keeps one of these per type, and every reader (`register_impl`
// re-registering the same type across several impl/shape blocks,
// `check_shape_conformance`, `method_signature`, `has_method`) reaches
// the exact same object through this one pointer rather than a struct
// copy of it. A struct copy would alias `.methods`'s own backing
// arrays with whichever copy mutates (grows/rehashes) next - the
// shallow-copy-then-mutate hazard this file's other `Map`/`Set`
// fields guard against with an explicit remove-before-mutate dance -
// except here nothing can even depend on get-out-of-sync timing,
// since there is only ever the one real object.
fun _method_table_new() MethodTable* {
  MethodTable* t = malloc(sizeof(MethodTable));
  t.methods.init(8);
  ret t;
}

// A `CheckedType`'s own nested structure: `.generic_args`/
// `.tuple_members` are both fresh Vecs `checked_from_dtype` builds
// recursively (`Vec<CheckedType> t.generic_args.push(checked_from_dtype(...))`),
// never borrowed - unlike `.name` (aliased from the declaring
// `DataType`'s own `type_str`) and `.fn_sig` (the exact same pointer
// as the declaring `DataType`'s own `fn_sig`, left for the AST to
// free), which this never touches. Left unfreed, every signature
// registered for a program this typechecks - every function, every
// method - leaked its own return and argument types' entire generic/
// tuple structure (an `Option<T>`, a `Vec<T>`, a `(num, str)`, and so
// on through anything nested inside one of those), for as long as the
// server (or a single build's own compile) kept running.
fun _free_checked_type_contents(CheckedType* t) {
  num i = 0;
  for i < t.generic_args.len {
    CheckedType ga = t.generic_args.get(i);
    _free_checked_type_contents(&ga);
    i = i + 1;
  }
  t.generic_args.free();
  num j = 0;
  for j < t.tuple_members.len {
    CheckedType tm = t.tuple_members.get(j);
    _free_checked_type_contents(&tm);
    j = j + 1;
  }
  t.tuple_members.free();
  t.array_sizes.free();
}

// A deep, independently-owned copy of `t`: `.generic_args`/
// `.tuple_members` get their own fresh Vecs, each element cloned the
// same way, rather than the shallow struct copy an ordinary `CheckedType
// x = y;` assignment already does (same backing arrays as `y`'s own,
// per the whole-codebase Vec-is-a-value-type convention). `.name` and
// `.fn_sig` stay aliased, same as `_free_checked_type_contents` never
// touches them - both are borrowed from the AST either way, cloned or
// not. Used by `TypeEnv.bind` so every binding owns its own copy,
// independent of whatever `infer()` called site (an `env.lookup`
// among them) originally produced the value from.
fun _clone_checked_type(CheckedType t) CheckedType {
  CheckedType c = t;
  c.generic_args.init(t.generic_args.len);
  num i = 0;
  for i < t.generic_args.len {
    c.generic_args.push(_clone_checked_type(t.generic_args.get(i)));
    i = i + 1;
  }
  c.tuple_members.init(t.tuple_members.len);
  num j = 0;
  for j < t.tuple_members.len {
    c.tuple_members.push(_clone_checked_type(t.tuple_members.get(j)));
    j = j + 1;
  }
  c.array_sizes.init(t.array_sizes.len);
  num k = 0;
  for k < t.array_sizes.len {
    c.array_sizes.push(t.array_sizes.get(k));
    k = k + 1;
  }
  ret c;
}

// Frees a signature's own scratch: `.rtype` and each of `.args`'s own
// `CheckedType`s have their own nested structure to free (see
// `_free_checked_type_contents`); `.type_params`'s own strings and
// each inner Vec `.bounds` holds all alias the declaring
// FunctionNode's own AST fields (or a token's text, transitively)
// rather than owning fresh copies, so only the containers themselves
// are this call's own to free for those two.
fun _free_fn_sig(FnSig* sig) {
  _free_checked_type_contents(&sig.rtype);
  num i = 0;
  for i < sig.args.len {
    CheckedType a = sig.args.get(i);
    _free_checked_type_contents(&a);
    i = i + 1;
  }
  sig.args.free();
  sig.type_params.free();
  sig.bounds.free();
  sig.arg_params.free();
}

// Frees a whole `Map<str, FnSig>`: every signature's own scratch
// (`_free_fn_sig`), then the map itself.
// Frees a whole `Map<str, Vec<T>>` whose Vecs hold values borrowed from the
// AST rather than fresh allocations: only the buckets and the map itself.
fun _free_borrowed_vec_map_str(Map<str, Vec<str>>* m) {
  Vec<str> names = m.keys();
  defer names.free();
  for name : names {
    Vec<str> bucket = m.at(name).unwrap();
    bucket.free();
  }
  m.free();
}

// Frees a whole `Map<str, CheckedType>`: each value's own nested
// structure (see `_free_checked_type_contents`), then each key (built
// fresh by `format`/`StringBuilder` at every call site that populates
// one of these - never a borrowed AST string, unlike most other map
// keys in this file), then the map itself.
fun _free_checked_type_map(Map<str, CheckedType>* m) {
  Vec<str> names = m.keys();
  defer names.free();
  for name : names {
    CheckedType ct = m.at(name).unwrap();
    _free_checked_type_contents(&ct);
  }
  for name : names {
    free(name);
  }
  m.free();
}

// Same deep value-free as `_free_checked_type_map`, but for a map whose
// keys are borrowed from the AST (a compound's own field names) rather
// than this call's own fresh-built strings - those must never be freed.
fun _free_checked_type_map_borrowed_keys(Map<str, CheckedType>* m) {
  Vec<str> names = m.keys();
  defer names.free();
  for name : names {
    CheckedType ct = m.at(name).unwrap();
    _free_checked_type_contents(&ct);
  }
  m.free();
}

fun _free_variant_payloads_map(Map<str, Vec<CheckedType>>* m) {
  Vec<str> names = m.keys();
  defer names.free();
  for name : names {
    Vec<CheckedType> bucket = m.at(name).unwrap();
    // Each payload type is a fresh `checked_from_dtype` build, the
    // same as an `FnSig`'s own `.args`/`.rtype` - see
    // `_free_checked_type_contents`'s own note on why this is never
    // just the bucket itself to free.
    num i = 0;
    for i < bucket.len {
      CheckedType ct = bucket.get(i);
      _free_checked_type_contents(&ct);
      i = i + 1;
    }
    bucket.free();
  }
  // The keys are the map's own lookup keys, so they stay alive until every
  // bucket has been looked up.
  for name : names {
    free(name);
  }
  m.free();
}

fun _free_variant_owners_map(Map<str, Vec<str>>* owners) {
  Vec<str> names = owners.keys();
  defer names.free();
  for name : names {
    Vec<str> bucket = owners.at(name).unwrap();
    for owner : bucket {
      free(owner);
    }
    bucket.free();
  }
  owners.free();
}

// Frees a whole `Map<str, Set<str>>` where every value's own strings are
// borrowed from the AST (never a fresh allocation): unlike
// `_free_variant_owners_map`'s buckets, only each `Set<str>` and the map
// itself need freeing, not the strings inside.
fun _free_shape_implementors_map(Map<str, Set<str>>* implementors) {
  Vec<str> names = implementors.keys();
  defer names.free();
  for name : names {
    Set<str> bucket = implementors.at(name).unwrap();
    bucket.free();
  }
  implementors.free();
}

// Frees a whole `Map<str, Vec<Vec<str>>>` where every value's own strings
// are borrowed from the AST (never a fresh allocation) - same shape as
// `_free_shape_implementors_map` just above, for `Checker.shape_impl_type_params`.
fun _free_shape_impl_type_params_map(Map<str, Vec<Vec<str>>>* type_params_by_key) {
  Vec<str> keys = type_params_by_key.keys();
  defer keys.free();
  for k : keys {
    Vec<Vec<str>> entries = type_params_by_key.at(k).unwrap();
    for e : entries {
      e.free();
    }
    entries.free();
  }
  type_params_by_key.free();
}

// The variant name a bare enum-variant shorthand initializer names,
// whether payload-less (`.Same`) or carrying one (`.Same(5)`, parsed as
// a call whose callee is the same dot-shorthand shape). `.None` for
// anything else, including an already-qualified `Enum.Variant` (which
// names its own enum directly and needs no resolution here).
fun _bare_enum_shorthand_variant(Node* val) Option<str> {
  if val == nil {
    ret .None;
  }
  fit val.kind {
    .Expression(e) -> {
      if equals(e.op, "()") && e.has_left {
        ret _bare_enum_shorthand_variant(e.left);
      }
      if equals(e.op, ".") && e.has_left && e.has_right {
        flag left_is_blank = false;
        fit e.left.kind {
          .Blank -> { left_is_blank = true; }
          _ -> {}
        }
        if left_is_blank {
          fit e.right.kind {
            .Identifier(name) -> { ret .Some(name); }
            _ -> {}
          }
        }
      }
    }
    _ -> {}
  }
  ret .None;
}

// True for a function the generated C always declares, through the headers
// every program includes (stdlib.h, string.h, stdio.h, ctype.h). A Fun
// function defined under one of these names is emitted to C verbatim and
// clashes with the library's own declaration. Names from headers only
// included on demand (math.h, time.h) are left out: a program that never
// pulls them in can use the name, and one that does gets the clash reported
// as a duplicate declaration.
fun _is_libc_function_name(str name) flag {
  fit name {
    "abort", "abs", "atexit", "atof", "atoi", "atol", "atoll", "bsearch", "calloc", "div", "exit",
    "free", "getenv", "labs", "ldiv", "llabs", "lldiv", "malloc", "qsort", "rand" -> { ret true; }
    "realloc", "srand", "strtod", "strtof", "strtol", "strtold", "strtoll", "strtoul", "strtoull",
    "system", "mblen", "quick_exit", "aligned_alloc", "setenv", "unsetenv", "putenv", "realpath",
    "memchr", "memcmp", "memcpy" -> { ret true; }
    "memmove", "memset", "strcat", "strchr", "strcmp", "strcoll", "strcpy", "strcspn", "strerror",
    "strlen", "strncat", "strncmp", "strncpy", "strpbrk", "strrchr", "strspn", "strstr", "strtok",
    "strdup", "strndup" -> { ret true; }
    "strnlen", "strcasecmp", "strncasecmp", "index", "rindex", "clearerr", "fclose", "feof",
    "ferror", "fflush", "fgetc", "fgetpos", "fgets", "fopen", "fprintf", "fputc", "fputs",
    "fread", "freopen", "fscanf" -> { ret true; }
    "fseek", "fsetpos", "ftell", "fwrite", "getc", "getchar", "gets", "perror", "printf", "putc",
    "putchar", "puts", "remove", "rename", "rewind", "scanf", "setbuf", "setvbuf", "snprintf",
    "sprintf" -> { ret true; }
    "sscanf", "tmpfile", "tmpnam", "ungetc", "vfprintf", "vprintf", "vsnprintf", "vsprintf",
    "fileno", "fdopen", "popen", "pclose", "getline", "dprintf", "isalnum", "isalpha", "isblank",
    "iscntrl", "isdigit", "isgraph" -> { ret true; }
    "islower", "isprint", "ispunct", "isspace", "isupper", "isxdigit", "tolower", "toupper",
    "isascii", "toascii" -> { ret true; }
    _ -> { ret false; }
  }
}

// True for a node declared in one of the standard library's `std/c/` files,
// which mirror C's own names on purpose (`FILE`, `size_t`) and so are exempt
// from the C name collision check.
fun _in_c_mirror_file(Node* node) flag {
  if !node.has_pos {
    ret false;
  }
  ret contains(node.pos.filename, "std/c/") || contains(node.pos.filename, "std\\c\\");
}

// Fails when `name` cannot be a declared name in the generated C (a C
// reserved word, or a macro or type the always-included headers declare),
// naming what kind of thing it was declared as. `at` is where to report it.
fun _check_c_name(Checker* c, str name, str what, Node* at) {
  if c.failed || equals(name, "") {
    ret;
  }
  str reason = c_name_collision(name);
  if equals(reason, "") {
    ret;
  }
  c.fail(
    format(
    "'{str}' is {str} and cannot be used as {str} name here - the generated C would fail to compile",
    name,
    reason,
    what
    ),
    at
  );
}

// Walks a body for the names a statement declares that the parser has no
// single choke point for: a `fit` arm's bindings, a `for` loop's item, index
// and destructured names, and a `let` destructure's names.
fun _check_c_names_in_body(Checker* c, Node* stmt) {
  if stmt == nil || c.failed {
    ret;
  }
  fit stmt.kind {
    .Body(b) -> {
      for inner : b.statements {
        _check_c_names_in_body(c, inner);
      }
    }
    .Variable(v) -> {
      for dn : v.destructure_names {
        _check_c_name(c, dn, "a variable", stmt);
      }
      if v.has_val {
        _check_c_names_in_body(c, v.val);
      }
    }
    .StatementIf(ifn) -> { _check_c_names_in_body(c, ifn.body); }
    .StatementElseIf(ein) -> { _check_c_names_in_body(c, ein.body); }
    .StatementElse(inner) -> { _check_c_names_in_body(c, inner); }
    .StatementDefer(inner) -> { _check_c_names_in_body(c, inner); }
    .StatementFork(inner) -> { _check_c_names_in_body(c, inner); }
    .StatementFor(kind) -> {
      fit kind {
        .Cond(cn) -> { _check_c_names_in_body(c, cn.body); }
        .Iter(it) -> {
          _check_c_name(c, it.item_name, "a loop variable", stmt);
          if it.has_index_name {
            _check_c_name(c, it.index_name, "a loop index", stmt);
          }
          for dn : it.item_destructure_names {
            _check_c_name(c, dn, "a loop variable", stmt);
          }
          _check_c_names_in_body(c, it.body);
        }
      }
    }
    .StatementFit(f) -> {
      for br : f.branches {
        Node* at = stmt;
        if br.has_condition {
          at = br.condition;
        }
        for bn : br.bindings {
          _check_c_name(c, bn, "a fit binding", at);
        }
        _check_c_names_in_body(c, br.body);
      }
    }
    _ -> {}
  }
}

// Every declared name whose spelling the generated C cannot accept: type
// names, fields, and the body-level bindings above. Function, parameter,
// `let` and global names are already rejected by the parser.
fun _check_c_names(Checker* c, Vec<Node>* nodes) {
  num i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    if c.failed || _in_c_mirror_file(node) {
      continue;
    }
    fit node.kind {
      .Compound(cn) -> {
        _check_c_name(c, cn.name, "a compound", node);
        for cf : cn.fields {
          _check_c_name(c, cf.name, "a field", node);
        }
      }
      .Enum(e) -> { _check_c_name(c, e.name, "an enum", node); }
      .Shape(q) -> { _check_c_name(c, q.name, "a shape", node); }
      .Function(f) -> {
        for tp : f.type_params {
          _check_c_name(c, tp, "a type parameter", node);
        }
        if f.has_body {
          _check_c_names_in_body(c, f.body);
        }
      }
      .Impl(im) -> {
        for m : im.methods {
          if m != nil {
            _check_c_names_in_body(c, m);
          }
        }
      }
      .Test(t) -> { _check_c_names_in_body(c, t.body); }
      _ -> {}
    }
  }
}

// The enum and variant names of a callee written `Enum.Variant`, both
// left empty for any other shape.
fun _qualified_variant_names(Node* callee, str* enum_name, str* variant_name) {
  if callee == nil {
    ret;
  }
  fit callee.kind {
    .Expression(e) -> {
      if !equals(e.op, ".") || !e.has_left || !e.has_right {
        ret;
      }
      fit e.left.kind {
        .Identifier(n) -> { *enum_name = n; }
        _ -> { ret; }
      }
      fit e.right.kind {
        .Identifier(v) -> { *variant_name = v; }
        _ -> { *enum_name = ""; }
      }
    }
    _ -> {}
  }
}

// `checker.fns`'s own keys are a function declaration's bare `.name`,
// borrowed straight from the AST like every other node string - never
// this call's to free, unlike `MethodTable.methods`'s own keys (see
// `_free_fn_sig_map` below).
fun _free_fn_sig_map_borrowed_keys(Map<str, FnSig>* fns) {
  Vec<str> names = fns.keys();
  defer names.free();
  num i = 0;
  for i < names.len {
    FnSig sig = fns.at(names.get(i)).unwrap();
    _free_fn_sig(&sig);
    i = i + 1;
  }
  fns.free();
}

// Every key this map ever holds is its own fresh copy (see
// `_method_leaf_name` and the Shape-method registration's own matching
// clone), never borrowed from the AST - freed here alongside each
// value's own content, not just the map shell.
fun _free_fn_sig_map(Map<str, FnSig>* fns) {
  Vec<str> names = fns.keys();
  defer names.free();
  num i = 0;
  for i < names.len {
    FnSig sig = fns.at(names.get(i)).unwrap();
    _free_fn_sig(&sig);
    i = i + 1;
  }
  // A second, separate pass - matching `_free_checked_type_map`'s own
  // shape just above: freeing a key here is freeing live content
  // `fns.at()` still probes for every OTHER key in this same table
  // (open addressing walks past a live-but-unrelated slot to resolve
  // a hash collision), so a key freed mid-loop leaves any later
  // lookup that happens to probe through its own now-dangling slot
  // reading freed memory - confirmed directly as the real cause of an
  // intermittent `strcmp` crash tearing down a large table (enough
  // entries for real collisions), Guard Malloc catching every time,
  // plain malloc only sometimes.
  i = 0;
  for i < names.len {
    free(names.get(i));
    i = i + 1;
  }
  fns.free();
}

// Frees every method table's own signature map, then its own heap box
// (see `_method_table_new`'s own note on why it's always one), then
// the table of tables itself.
fun _free_method_tables(Map<str, MethodTable*>* methods) {
  Vec<str> names = methods.keys();
  defer names.free();
  num i = 0;
  for i < names.len {
    MethodTable* t = methods.at(names.get(i)).unwrap();
    _free_fn_sig_map(&t.methods);
    free(t);
    i = i + 1;
  }
  methods.free();
}

// The bare name of a method whose declared name carries the type it
// belongs to, as `Counter__add` carries `Counter`.
// Drops a method's receiver, which is declared as its first parameter
// but supplied by the call's receiver rather than its arguments.
fun _without_self(FnSig sig, FunctionNode f) FnSig {
  if f.args.len == 0 {
    ret sig;
  }
  flag leads_with_self = false;
  Node* first = f.args.get(0);
  fit first.kind {
    .Variable(v) -> { leads_with_self = equals(v.name, "self"); }
    _ -> {}
  }
  if !leads_with_self {
    ret sig;
  }
  FnSig out = sig;
  // `out.args`/`.arg_params` below are about to be overwritten with a
  // fresh Vec, same shape as `TypeEnv.bind`'s own aliasing concern:
  // `out = sig;` just shallow-copied `sig`'s own backing arrays, not
  // cloned them, so `.init()` replacing that copy here would abandon
  // `sig`'s own original ones - still reachable only through `sig`,
  // which nothing past this function ever reads again once this
  // returns. `self`'s own slot (element 0, the only one actually
  // dropped - every other element is transferred below, not copied
  // again) is the one entry here whose own nested structure needs
  // freeing explicitly; the rest travel into `out.args` by value and
  // stay owned exactly once, same as before this change.
  Vec<CheckedType> old_args = out.args;
  if old_args.len > 0 {
    CheckedType self_type = old_args.get(0);
    _free_checked_type_contents(&self_type);
  }
  out.args.init(sig.args.len);
  num i = 1;
  for i < sig.args.len {
    out.args.push(sig.args.get(i));
    i = i + 1;
  }
  old_args.free();
  // What each argument was written as has to lose its first entry too:
  // a call names arguments after `self`, and the two lists are read
  // side by side. Leaving this one long shifted every argument by a
  // place, so a method's own bound was tested against `self` and never
  // against what the call supplied.
  Vec<str> old_arg_params = out.arg_params;
  out.arg_params.init(sig.arg_params.len);
  num a = 1;
  for a < sig.arg_params.len {
    out.arg_params.push(sig.arg_params.get(a));
    a = a + 1;
  }
  old_arg_params.free();
  out.min_args = sig.min_args;
  if out.min_args > 0 {
    out.min_args = out.min_args - 1;
  }
  ret out;
}

fun _method_leaf_name(str declared, str type_name) str {
  _ = type_name;
  // The declared name carries the type, and a shape impl's carries the
  // shape as well, so the call's own name is what follows the last
  // separator.
  num cut = -1;
  num i = 0;
  for i + 1 < len(declared) {
    if declared[i] == '_' && declared[i + 1] == '_' {
      cut = i + 2;
      // Skips past the whole separator just matched, rather than just
      // one char: a leaf name that itself starts with `_` (`_next_inner`)
      // mangles to three underscores in a row (`Box___next_inner`), and
      // advancing by 1 would re-match the second/third as its own
      // separator, cutting one underscore too many off the leaf name.
      i = i + 2;
      continue;
    }
    i = i + 1;
  }
  if cut < 0 || cut >= len(declared) {
    // A fresh copy even here, not `declared` itself: every caller
    // stores this straight into a `MethodTable.methods` key, which is
    // always freed as owned (see `_free_fn_sig_map`'s own note) - this
    // is the fallback path only, but the invariant has to hold
    // unconditionally, not just for the ordinary mangled-name case
    // just below.
    ret substr(declared, 0, len(declared));
  }
  ret substr(declared, cut, len(declared) - cut);
}

test "_method_leaf_name keeps a leaf name's own leading underscore" {
  // Regression: a leaf name starting with `_` (a private method,
  // `_next_inner`) mangles to three underscores in a row at the
  // boundary (`Box___next_inner`); the scan used to re-match the
  // second/third underscore as its own separator, stripping the leaf's
  // own leading `_` and registering it under the wrong key.
  assert equals(_method_leaf_name("Box___next_inner", "Box"), "_next_inner"),
  "expected the leaf's own leading underscore to survive";
  assert equals(_method_leaf_name("Box__half", "Box"), "half"),
  "expected an ordinary (non-underscore) leaf name to still strip cleanly";
  assert equals(_method_leaf_name("Box__Lenable__wrap", "Box"), "wrap"),
  "expected a shape-mangled name to still cut at its last separator";
  assert equals(_method_leaf_name("Box__Lenable___wrap", "Box"), "_wrap"),
  "expected a shape-mangled name whose leaf also starts with '_' to keep it too";
}

// The signature a shape's method declaration promises.
fun _signature_of_shape_method(ShapeMethodSig m) FnSig {
  FnSig sig;
  sig.args.init(m.args.len);
  sig.rtype = checked_unknown();
  sig.rtype_template = checked_unknown();
  if m.rtype != nil {
    // Two independent conversions, same reasoning as `_signature_of`'s
    // own identical pair - no erasure happens here (a shape method
    // names no type params of its own), but each still needs to own
    // its own heap content rather than share one value's.
    sig.rtype = checked_from_dtype(m.rtype);
    sig.rtype_template = checked_from_dtype(m.rtype);
  }
  sig.is_variadic = false;
  sig.is_async = m.is_async;
  sig.is_generic = false;
  sig.ambiguous = false;
  sig.min_args = m.args.len;
  // A shape method has no privacy of its own: naming the shape is what
  // grants access to it, not which file declared it, so this reads as
  // public everywhere `check_visibility` looks.
  sig.file = "";
  sig.is_public = true;
  sig.type_params.init(0);
  sig.bounds.init(0);
  sig.arg_params.init(0);
  for a : m.args {
    sig.args.push(checked_from_dtype(a.dtype));
  }
  ret sig;
}

// What the checker carries while walking one program.
// Where a top-level name was first declared, and what it was: a
// function, a global variable, a compound, or an enum. Every one of
// these lowers to its own top-level C symbol or typedef, so two of them
// sharing a name is a real collision regardless of which kinds they
// are - not just two functions, or two globals.
compound TopLevelSite {
  str kind;
  str file;
  num line;
}

compound Checker {
  Map<str, FnSig> fns;
  // Every function/global-variable/compound/enum name declared so far,
  // to catch two of them sharing a name before codegen ever runs - the
  // C compiler would otherwise be the one to notice, far from the
  // actual cause and in terms the program's own source never used.
  Map<str, TopLevelSite> declared_at;
  // The shapes a program declares. A pointer to a compound that
  // implements one stands where the shape is expected.
  Set<str> shapes;
  // Shape name -> the type_name of every impl block that implements it
  // (both a generic impl's own bare template name, e.g. `impl Vec<T> as
  // Renderable` -> "Vec", and a monomorphizing impl's mangled concrete
  // name, e.g. `impl Vec<num> as Renderable` -> "Vec__num" - see
  // `implements_shape`, which tries both forms the same way
  // `receiver_method` does for method lookup). Used to check a real
  // `impl X as Shape` relationship for a generic bound naming a shape
  // (`T: Renderable`), as opposed to `assignable`'s coarser
  // any-pointer-satisfies-any-shape approximation used for ordinary
  // shape-typed-parameter coercion - the two are deliberately different
  // strictness levels, not a shared notion of "satisfies this shape".
  Map<str, Set<str>> shape_implementors;
  // An implementor's own `type_params`, keyed `"{type_name}::{shape_name}"`,
  // recorded only when the impl has them. `impl Box<num> as Sized`
  // resolves `type_name` to the mangled `Box__num` immediately and needs
  // nothing here, but `impl Box<Circle> as Sized` - an already-declared
  // compound/enum used as the argument, rather than a builtin scalar -
  // can't be told apart from a genuine unbound template (`impl Box<T> as
  // Sized`) by the parser at that position, so both are stored the same
  // way (`has_type_params` true, `type_params` holding the argument's own
  // name). A shape-downcast fit arm naming the mangled form directly
  // (`Box__Circle(b)`, what `Box<Circle>(b)` parses to) needs this to
  // reconstruct that same mangled identity and confirm which case it
  // actually is - see `check_shape_destructure_condition`.
  // One entry per distinct impl matching that key - `impl Box<num> as
  // Sized` and `impl Box<str> as Sized` both key to "Box::Sized", each
  // contributing its own `type_params` list, since the base+shape name
  // alone doesn't distinguish them (only the reconstructed mangled
  // identity does).
  Map<str, Vec<Vec<str>>> shape_impl_type_params;
  // A shape implementor's own declared argument type for that shape
  // (`Range` -> `num` for `impl Range as Iterator<num>`), keyed by
  // `"{type_name}::{shape_name}"` - lets a for-loop's own general
  // `Iterator<T>` element-type resolution read the real `Elem` a type
  // declared, not just confirm the relationship exists the way
  // `implements_shape` alone does. Absent for a bare `as Shape` with no
  // argument, or a symbolic binding whose argument is the enclosing
  // impl's own erased type param (never independently useful without
  // that impl's own concrete instantiation).
  Map<str, CheckedType> shape_elem_by_type;
  // Enums whose variants carry no payload, which stand for the numbers
  // they are written as.
  Set<str> plain_enums;
  // What each top-level variable offers, so a read from another file can
  // be held to it.
  Map<str, GlobalInfo> globals;
  // The real type of every top-level `let`/`const` written with no type
  // of its own, inferred once from its initializer before any function
  // body is checked - every function seeds its globals from the written
  // `var_type`, which for an inferred global is only the placeholder.
  Map<str, CheckedType> global_inferred;
  // Every enum the program declares, whether or not its variants carry
  // payloads. `plain_enums` holds only the ones that read as numbers.
  Set<str> enum_names;
  // Every enum name that declares a variant by that name, keyed by the
  // variant's own bare name (`"Some"` -> `["Option", "Result"]`).
  // Resolving a bare shorthand (`.Some`) with no declared type to lean
  // on needs to know whether exactly one enum owns that name.
  Map<str, Vec<str>> variant_owners;
  // Each enum variant's declared payload types, keyed "Enum.Variant", and
  // each enum's own type parameters, so a shorthand nested in a variant's
  // argument list can be held to the payload type it lands on.
  Map<str, Vec<CheckedType>> variant_payloads;
  Map<str, Vec<str>> enum_type_params;
  // What each declared compound holds, and what each type and shape
  // declares as methods.
  Map<str, CompoundInfo> compounds;
  Map<str, MethodTable*> methods;
  // The file whose declarations are being checked, so a name declared
  // elsewhere can be held to what its own file offers.
  str current_file;
  // The return type of the function being walked, and whether it may
  // await.
  CheckedType rtype;
  flag in_async;
  // How many closure literals the walk is inside; a `ret` at depth 0
  // returns from the function itself.
  num closure_depth;
  // The type parameters the declaration being walked names. They stand
  // for types the checker never sees, so a name among them is a type
  // rather than one nothing declares.
  Vec<str> active_type_params;
  // The type params of the generic `impl` whose methods are being checked
  // (`impl Box<T>`'s `T`), empty otherwise - in scope for every method
  // body exactly the way a method's own type params are.
  Vec<str> impl_type_params;
  // Parallel to `impl_type_params`: each one's allowed types - the
  // impl's own written constraint, else the target compound's own bound
  // for that position (an `impl Vec2<T>`'s `T` is bounded exactly as
  // `Vec2`'s own is).
  Vec<Vec<str>> impl_type_param_bounds;
  // Parallel to `active_type_params` by index: each entry's own declared
  // bound (empty when unconstrained), so a bound check on a reference to
  // one of these names - still an unresolved type parameter, not yet a
  // concrete type - can check entailment (every alternative it's already
  // known to allow also appears in the bound being checked) instead of
  // requiring the bare name to match an alternative by spelling.
  Vec<Vec<str>> active_type_param_bounds;
  // Every name a `use X as name;` import actually declared. Checked
  // by `check_alias_qualified_call` before treating a receiver as an
  // alias-qualified call (`alias.fn(...)`) at all - without this, any
  // bare name that happened to collide with no local/type, followed
  // by a dot and a bare function name that exists anywhere in the
  // whole merged program, read as a valid alias-qualified call
  // regardless of whether that name was ever declared as one.
  Set<str> declared_import_aliases;
  flag failed;
  TypeError error;
}

fun _checker_new() Checker {
  Checker c;
  c.active_type_params.init(4);
  c.impl_type_params.init(0);
  c.impl_type_param_bounds.init(0);
  c.active_type_param_bounds.init(4);
  c.fns.init(32);
  c.declared_at.init(32);
  c.shapes = set_init("", 16);
  c.shape_implementors.init(16);
  c.shape_impl_type_params.init(16);
  c.shape_elem_by_type.init(16);
  c.plain_enums = set_init("", 16);
  c.globals.init(16);
  c.global_inferred.init(16);
  c.enum_names = set_init("", 16);
  c.variant_owners.init(16);
  c.variant_payloads.init(16);
  c.enum_type_params.init(16);
  c.compounds.init(16);
  c.methods.init(16);
  c.declared_import_aliases = set_init("", 8);
  c.current_file = "";
  c.rtype = checked_unknown();
  c.closure_depth = 0;
  c.in_async = false;
  c.failed = false;
  ret c;
}

impl Checker {
  // Records the methods an impl block supplies for its type. A generic
  // impl's methods mention type parameters, which stand for whatever an
  // instantiation supplies.
  register_impl(ImplNode block) {
    let existing = self.methods.at(block.type_name);
    MethodTable* table;
    if existing.is_some() {
      // The same one heap-allocated table `self.methods` itself still
      // points at (see `_method_table_new`'s own note) - mutating
      // `table.methods` below mutates that exact object, not a copy,
      // so there is nothing to write back or any staleness window to
      // guard against.
      table = existing.unwrap();
    } else {
      table = _method_table_new();
    }
    for m : block.methods {
      fit m.kind {
        .Function(f) -> {
          if !f.has_name {
            continue;
          }
          FnSig sig = _without_self(_signature_of(f), f);
          if block.has_type_params && block.type_params.len > 0 {
            sig.is_generic = true;
            sig = _erase_signature(sig, &block.type_params);
          }
          // `_signature_of` always leaves `is_public`/`file` at their
          // defaults (it only sees the bare `FunctionNode`, not the
          // wrapping `Node` a method's own `pub`/position live on), so a
          // non-pub method's call through a value receiver was never
          // held to it: `check_visibility` treats an empty `file` as "no
          // module to compare against" and lets everything through.
          sig.is_public = m.flags.is_public;
          if m.has_pos {
            sig.file = m.pos.filename;
          }
          // A method's declared name carries the type it belongs to
          // (`Counter__add`), while a call names it on its own. A name
          // shared between two of this type's own impl blocks (a
          // shape impl re-supplying a method the main block already
          // has, e.g. `clear`) is a real, legal overlap - `put()`
          // keeps its own first-seen key on a matching re-insert (the
          // value still updates to this call's own, kept exactly as
          // before), so this call's own fresh copy of that same key
          // would otherwise leak unused.
          str leaf = _method_leaf_name(f.name, block.type_name);
          flag leaf_already_present = table.methods.at(leaf).is_some();
          table.methods.put(leaf, sig);
          if leaf_already_present {
            free(leaf);
          }
        }
        _ -> {}
      }
    }
    self.methods.put(block.type_name, table);
  }

  // Records that `type_name` (a bare template name or a mangled concrete
  // instantiation, exactly as `ImplNode.type_name` carries it) has a real
  // `impl ... as shape_name { ... }` block, for `implements_shape` below.
  record_shape_impl(str type_name, str shape_name) {
    let existing = self.shape_implementors.at(shape_name);
    if existing.is_some() {
      Set<str> bucket = existing.unwrap();
      // Same hazard as `register_impl`'s own note: `bucket` aliases
      // the stored Set's backing array, and `add()` below can grow
      // and rehash it, freeing the old one out from under
      // `self.shape_implementors`'s own copy until the write-back.
      self.shape_implementors.remove(shape_name);
      bucket.add(type_name);
      self.shape_implementors.put(shape_name, bucket);
    } else {
      Set<str> bucket = set_init("", 4);
      bucket.add(type_name);
      self.shape_implementors.put(shape_name, bucket);
    }
  }

  // True when `t` is a real, registered implementor of `shape` - a
  // genuine `impl X as shape { ... }` block was seen for it, not just
  // "any pointer satisfies any shape" (`assignable`'s coarser check,
  // left as-is for ordinary shape-typed-parameter coercion). Tries both
  // the mangled concrete-instantiation name and the bare type name, the
  // same lookup order `receiver_method` already uses for method lookup.
  implements_shape(CheckedType t, str shape_name) flag {
    let bucket_opt = self.shape_implementors.at(shape_name);
    if bucket_opt.is_none() {
      ret false;
    }
    Set<str> implementors = bucket_opt.unwrap();
    CheckedType named = t;
    named.name = self.canonical_type_name(t.name);
    str mangled = mangled_name(named);
    flag mangled_is_fresh = named.generic_args.len > 0;
    defer {
      if mangled_is_fresh {
        free(mangled);
      }
    }
    if !equals(mangled, named.name) && implementors.has(mangled) {
      ret true;
    }
    ret implementors.has(named.name);
  }

  // `t`'s own declared argument type for `shape_name` (`Elem` in
  // `Iterator<Elem>`), substituted against `t`'s own concrete
  // `generic_args` when the implementor is itself generic - `Elem` for
  // `RingBuf<num>` implementing `Iterator<T>` on its own type param `T`
  // is `num`, not the bare `T` `shape_elem_by_type` recorded at
  // registration time. `.None` when `t` doesn't implement `shape_name`
  // at all, or the impl took no argument for it.
  shape_arg_of(CheckedType t, str shape_name) Option<CheckedType> {
    if !self.implements_shape(t, shape_name) {
      ret .None;
    }
    CheckedType named = t;
    named.name = self.canonical_type_name(t.name);
    str mangled = mangled_name(named);
    flag mangled_is_fresh = named.generic_args.len > 0;
    StringBuilder mangled_key_sb = string_builder_init(24);
    mangled_key_sb.append(mangled);
    mangled_key_sb.append("::");
    mangled_key_sb.append(shape_name);
    if mangled_is_fresh {
      free(mangled);
    }
    str mangled_key = mangled_key_sb.build();
    let by_mangled = self.shape_elem_by_type.at(mangled_key);
    free(mangled_key);
    if by_mangled.is_some() {
      ret by_mangled;
    }
    StringBuilder bare_key_sb = string_builder_init(24);
    bare_key_sb.append(named.name);
    bare_key_sb.append("::");
    bare_key_sb.append(shape_name);
    str bare_key = bare_key_sb.build();
    let by_bare = self.shape_elem_by_type.at(bare_key);
    free(bare_key);
    if by_bare.is_none() {
      ret .None;
    }
    CheckedType elem = by_bare.unwrap();
    let info = self.compounds.at(named.name);
    if info.is_none() || !info.unwrap().is_generic {
      ret .Some(elem);
    }
    CompoundInfo holder = info.unwrap();
    ret .Some(substitute(elem, &holder.type_params, &named.generic_args));
  }

  // True when a value of type `from` can stand where `to` is expected,
  // including where `to` is a shape a pointer satisfies.
  assignable(CheckedType to, CheckedType from) flag {
    // A function stored into a `fun(...)` slot has to take and return
    // what the slot says, whether it is named directly or read out of
    // another function value.
    // A closure slot takes another closure, or a plain function or
    // function value with the same signature, which runs with nothing
    // captured. A closure never fits a plain function slot.
    if to.has_closure_sig && to.closure_sig != nil {
      ret self._fits_signature(to.closure_sig, from);
    }
    if to.has_fn_sig && from.has_closure_sig {
      ret false;
    }
    if to.has_fn_sig && to.fn_sig != nil {
      if !equals(from.function_name, "") {
        let known = self.fns.at(from.function_name);
        if known.is_some() && !known.unwrap().ambiguous {
          Vec<str> no_params;
          no_params.init(0);
          defer no_params.free();
          Vec<CheckedType> no_args;
          no_args.init(0);
          defer no_args.free();
          ret self._fn_sig_matches(to.fn_sig, known.unwrap(), &no_params, &no_args);
        }
      }
      if from.has_fn_sig && from.fn_sig != nil {
        ret self._fn_types_match(to.fn_sig, from.fn_sig);
      }
    }
    if can_assign(to, from) {
      // Two instantiations of one generic type are the same type only
      // when they were instantiated with the same arguments: a
      // `Box<num>` is not a `Box<str>`, though both are written `Box`
      // and compare equal by name alone.
      if !self.tuple_members_agree(to, from) {
        ret false;
      }
      ret self.generic_args_agree(to, from);
    }
    // A name the program never declares is a type parameter that no
    // instantiation resolved, which stands for anything.
    if !self.names_a_declared_type(to) || !self.names_a_declared_type(from) {
      ret true;
    }
    // An enum with no payloads is written as, and reads as, a number.
    if self.reads_as_number(to) && self.reads_as_number(from) {
      ret true;
    }
    if self.shapes.has(to.name) {
      ret from.pointer_depth > 0 || self.shapes.has(from.name);
    }
    ret false;
  }

  // Judges `alias.name`, where `alias` names an imported file rather
  // than a value: what follows the dot is a variable in the file that
  // alias stands for. True when it was one, whether or not anything was
  // reported.
  check_alias_qualified_read(ExprNode e, str name, TypeEnv* env) flag {
    if !e.has_left || e.left == nil {
      ret false;
    }
    str alias = "";
    fit e.left.kind {
      .Identifier(text) -> { alias = text; }
      _ -> { ret false; }
    }
    if equals(alias, "") {
      ret false;
    }
    // A value of that name, or a type of that name, means this is not an
    // alias at all.
    if env.lookup(alias).is_some() || self.compounds.at(alias).is_some() ||
      self.shapes.has(alias) || self.enum_names.has(alias) {
      ret false;
    }
    let known = self.globals.at(name);
    if known.is_none() {
      ret false;
    }
    GlobalInfo info = known.unwrap();
    self.check_visibility(name, info.file, info.is_public, "variable", e.left);
    ret true;
  }

  // Reports a field another module has no business reading. A field
  // whose name begins with `_` belongs to the file that declares the
  // type: the type itself may be offered publicly while some of what it
  // holds is its own business.
  check_field_visibility(CompoundInfo holder, str type_name, str field, Node* at) {
    if len(field) == 0 || field[0] != '_' {
      ret;
    }
    if equals(holder.file, "") || equals(self.current_file, "") {
      ret;
    }
    if equals(holder.file, self.current_file) {
      ret;
    }
    self.fail(
      format("'{str}' of '{str}' is private to the file that declares it", field, type_name),
      at
    );
  }

  // True for a name that reads as a type rather than a value, which is
  // what `sizeof` measures.
  _sizeof_names_a_type(Node* node) flag {
    if node == nil {
      ret false;
    }
    fit node.kind {
      .Identifier(name) -> {
        // A pointer written inside `sizeof(...)` is carried on the name,
        // as `num*`, since the stars name no type of their own.
        str bare = name;
        for ends_with(bare, "*") {
          bare = substr(bare, 0, len(bare) - 1);
        }
        if keyword_is_datatype(bare) || self._names_a_type(bare) {
          ret true;
        }
        // A capitalized name reads as a type even when none is declared,
        // so `check_sizeof_operand` can say which name is missing.
        ret len(bare) > 0 && bare[0] >= 'A' && bare[0] <= 'Z';
      }
      .Unary(u) -> {
        // A pointer or array spelling of a type still names one.
        ret self._sizeof_names_a_type(u.operand);
      }
      // A generic instantiation is written the way a comparison is, so its
      // type is the name on the left.
      .Expression(e) -> {
        if !e.has_left {
          ret false;
        }
        ret self._sizeof_names_a_type(e.left);
      }
      .ExpressionParenthesis(inner) -> { ret self._sizeof_names_a_type(inner); }
      // A generic instantiation written without fields parses as a
      // compound literal carrying the type it names.
      .CompoundInit(init) -> { ret init.has_dtype && init.fields.len == 0; }
      _ -> { ret false; }
    }
    ret false;
  }

  // Reports a `sizeof` of a name the program never declares. Measuring
  // a type nothing defines has no answer, and C would be left to guess
  // at a name it has never seen either.
  check_sizeof_operand(Node* node, Node* operand) {
    if operand == nil {
      ret;
    }
    str named = "";
    fit operand.kind {
      .Identifier(text) -> { named = text; }
      _ -> { ret; }
    }
    // Only a plain name is judged: a generic instantiation, an array or
    // a parenthesized form carries its own structure and is read
    // elsewhere.
    str bare = named;
    for ends_with(bare, "*") {
      bare = substr(bare, 0, len(bare) - 1);
    }
    if equals(bare, "") || keyword_is_datatype(bare) {
      ret;
    }
    if self._names_a_type(bare) {
      ret;
    }
    self.fail(format("sizeof names no type called '{str}'", bare), node);
  }

  // True when `name` is a builtin type, a declared compound, union, enum,
  // or shape, or a type parameter of the declaration being walked, which
  // stands for a type an instantiation supplies.
  _names_a_type(str name) flag {
    if keyword_is_datatype(name) {
      ret true;
    }
    str canonical = self.canonical_type_name(name);
    if self.compounds.at(canonical).is_some() || self.shapes.has(canonical) ||
      self.plain_enums.has(canonical) || self.enum_names.has(canonical) {
      ret true;
    }
    for tp : self.active_type_params {
      if equals(tp, name) {
        ret true;
      }
    }
    // A specialized instantiation is named in its mangled form
    // (`Vec__str`), which is a type when its base is.
    num mangled_at = index_of_str(name, "__");
    if mangled_at > 0 {
      ret self._names_a_type(substr(name, 0, mangled_at));
    }
    ret false;
  }

  // The first name in `t`, its generic arguments and tuple members
  // included, that names no type at all. Empty when every name does.
  _missing_type_name(CheckedType t) str {
    if t.has_fn_sig || t.has_closure_sig {
      ret "";
    }
    if !equals(t.name, "") && !self._names_a_type(t.name) {
      ret t.name;
    }
    for arg : t.generic_args {
      str missing = self._missing_type_name(arg);
      if !equals(missing, "") {
        ret missing;
      }
    }
    for member : t.tuple_members {
      str missing = self._missing_type_name(member);
      if !equals(missing, "") {
        ret missing;
      }
    }
    ret "";
  }

  // Reports a name in `t` that names no type, rather than leave the C
  // compiler to reject it.
  check_type_exists(CheckedType t, Node* at) {
    str missing = self._missing_type_name(t);
    if !equals(missing, "") {
      self.fail(
        format(
        "no type called '{str}' is declared in this program (missing an import?)",
        missing
        ),
        at
      );
    }
  }

  // Rejects a comparison between two different enums. A plain enum reads
  // as the number behind it, so comparing one to a number is ordinary;
  // comparing two enums that share no variants is asking whether two
  // unrelated ordinals happen to coincide, which is never what was meant.
  // True for a value (not a pointer or an array) of an enum some variant of
  // which carries data.
  carries_data_by_value(CheckedType t) flag {
    if t.pointer_depth > 0 || t.is_array || equals(t.name, "") {
      ret false;
    }
    ret self.enum_names.has(t.name) && !self.plain_enums.has(t.name);
  }

  // Describes `t` when it's a value no comparison operator applies to: an
  // array, a tuple, or a compound without an operator method of its own.
  // Empty for anything comparable.
  _uncomparable_value(CheckedType t, str op) str {
    if t.pointer_depth > 0 {
      ret "";
    }
    if t.is_array {
      ret format(
        "arrays ('{str}'); it would compare their addresses, so compare the elements",
        type_name(t)
      );
    }
    if t.is_tuple {
      ret format("tuples ('{str}'); compare their elements", type_name(t));
    }
    if !equals(t.name, "") && self.compounds.at(t.name).is_some() {
      ret format(
        "'{str}' values; give '{str}' an `{str}` method, or compare their fields",
        t.name,
        t.name,
        operator_method_name(op)
      );
    }
    ret "";
  }

  check_comparison(Node* node, ExprNode e, TypeEnv* env) {
    if !e.has_left || !e.has_right {
      ret;
    }
    CheckedType left = self.infer(e.left, env);
    CheckedType right = self.infer(e.right, env);
    if _is_comparison(e.op) {
      let dispatched = self.try_operator_dispatch(
        node,
        operator_operand_type(e.left, left, e.right, right),
        e.op,
        .Some(operator_operand_type(e.right, right, e.left, left))
      );
      if dispatched.is_some() || self.failed {
        ret;
      }
    }
    self.check_shorthand_variant(e.right, left, env);
    self.check_shorthand_variant(e.left, right, env);
    if self.failed {
      ret;
    }
    // A tagged-union enum is a struct in the generated C, which has no `==`.
    // Say so and point at `fit`, rather than let the C compiler reject it.
    if equals(e.op, "==") || equals(e.op, "!=") {
      if self.carries_data_by_value(left) || self.carries_data_by_value(right) {
        CheckedType offender = left;
        if !self.carries_data_by_value(left) {
          offender = right;
        }
        self.fail(
          format(
          "'{str}' cannot compare '{str}', an enum whose variants carry data; use `fit` to test which variant it is",
          e.op,
          offender.name
          ),
          node
        );
        ret;
      }
    }
    // A compound or tuple value is a struct in the generated C, and an array
    // compares as its address, so none of them has a built-in comparison.
    if !left.is_null_literal && !right.is_null_literal {
      let what = self._uncomparable_value(left, e.op);
      let what_right = self._uncomparable_value(right, e.op);
      str found = what;
      if equals(found, "") {
        found = what_right;
      }
      if !equals(found, "") {
        self.fail(format("'{str}' cannot compare {str}", e.op, found), node);
        ret;
      }
    }
    if !self.plain_enums.has(left.name) || !self.plain_enums.has(right.name) {
      ret;
    }
    if equals(left.name, right.name) {
      ret;
    }
    self.fail(
      format(
      "'{str}' compares a {str} with a {str}, which share no variants",
      e.op,
      left.name,
      right.name
      ),
      node
    );
  }

  // True when two types instantiated from the same generic agree on what
  // they hold. An argument the checker never resolved stands for
  // anything, and a side carrying no arguments at all says nothing about
  // what it holds, so only two resolved lists are compared.
  generic_args_agree(CheckedType to, CheckedType from) flag {
    if to.generic_args.len == 0 || from.generic_args.len == 0 {
      ret true;
    }
    if to.generic_args.len != from.generic_args.len {
      ret true;
    }
    num i = 0;
    for i < to.generic_args.len {
      CheckedType want = to.generic_args.get(i);
      CheckedType got = from.generic_args.get(i);
      i = i + 1;
      if is_unknown(want) || is_unknown(got) {
        continue;
      }
      if !self.names_a_declared_type(want) || !self.names_a_declared_type(got) {
        continue;
      }
      if !self.assignable(want, got) {
        ret false;
      }
    }
    ret true;
  }

  // The tuple counterpart to `generic_args_agree`: `can_assign` already
  // confirmed matching arity (all it can check, being a standalone
  // function with no `self` to recurse with) - this checks each element
  // pairwise. Neither side being a tuple says nothing to disagree about,
  // matching `generic_args_agree`'s own "nothing to compare" default.
  tuple_members_agree(CheckedType to, CheckedType from) flag {
    if !to.is_tuple || !from.is_tuple {
      ret true;
    }
    if to.tuple_members.len != from.tuple_members.len {
      ret false;
    }
    num i = 0;
    for i < to.tuple_members.len {
      CheckedType want = to.tuple_members.get(i);
      CheckedType got = from.tuple_members.get(i);
      i = i + 1;
      if !self.assignable(want, got) {
        ret false;
      }
    }
    ret true;
  }

  // True when a type names something the program declares, as opposed to
  // a parameter standing in for whatever an instantiation supplies.
  names_a_declared_type(CheckedType t) flag {
    if t.base != .Unknown {
      ret true;
    }
    if equals(t.name, "") {
      ret true;
    }
    str name = self.canonical_type_name(t.name);
    if self.compounds.at(name).is_some() || self.shapes.has(name) ||
      self.plain_enums.has(name) {
      ret true;
    }
    ret self.methods.at(name).is_some();
  }

  // True for a value that stands in a numeric position: a number, or an
  // enum whose variants carry no payload.
  reads_as_number(CheckedType t) flag {
    if t.pointer_depth > 0 || t.is_array {
      ret false;
    }
    if t.base != .Unknown {
      ret t.base == .Num || t.base == .Chr;
    }
    ret self.plain_enums.has(t.name);
  }

  // Records the first failure; later ones are consequences of it.
  fail(str message, Node* node) {
    if self.failed {
      ret;
    }
    self.failed = true;
    self.error = _error(message, node);
  }
}

// An integer literal's own value, a leading `-` included.
fun _integer_literal_value(Node* n) Option<num> {
  fit n.kind {
    .Number(d) -> {
      fit d {
        .Num(v) -> { ret .Some(v); }
        _ -> { ret .None; }
      }
    }
    .Unary(u) -> {
      if u.is_left_operanded_unary || !equals(u.op, "-") || u.has_indirection {
        ret .None;
      }
      let inner = _integer_literal_value(u.operand)?;
      ret .Some(-inner);
    }
    .ExpressionParenthesis(inner) -> { ret _integer_literal_value(inner); }
    _ -> { ret .None; }
  }
}

// The bit width a fixed-width integer spelling names (`u8` is 8).
fun _fixed_width_bits(str width) Option<num> {
  if len(width) < 2 || (width[0] != 'i' && width[0] != 'u') {
    ret .None;
  }
  num bits = parse_int(substr(width, 1, len(width) - 1));
  if bits <= 0 {
    ret .None;
  }
  ret .Some(bits);
}

// A pointer, a string (itself a pointer to its own bytes), or an array
// (which converts as the address of its first element).
fun _is_pointer_like(CheckedType t) flag {
  ret t.is_array || t.pointer_depth > 0 || t.base == .Str || t.is_null_literal;
}

// Calls the language supplies rather than a program declaring them.
fun _is_builtin_call(str name) flag {
  fit name {
    "sizeof", "va_start", "va_end", "va_copy", "va_arg_num", "va_arg_dec", "va_arg_bin",
    "va_arg_chr", "va_arg_str", "va_arg_raw", "__fun_key_hash", "__fun_key_eq",
    "__fun_as" -> { ret true; }
    _ -> { ret false; }
  }
}

// The signature a function declaration promises.
// True when `name` is one of the function's own type parameters, which
// stands for whatever a call site supplies rather than a fixed type.
fun _is_type_param(FunctionNode f, str name) flag {
  if !f.has_type_params {
    ret false;
  }
  for p : f.type_params {
    if equals(p, name) {
      ret true;
    }
  }
  ret false;
}

fun _erase_type_params(FunctionNode f, CheckedType t) CheckedType {
  if _is_type_param(f, t.name) {
    // `t` is owned outright by every caller (see each call site's own
    // note), and is about to be replaced wholesale, not returned - its
    // own contents, if any, have nowhere else to go but freed here.
    _free_checked_type_contents(&t);
    ret checked_unknown();
  }
  ret t;
}

// Erases a type named by one of `names`, which stands for whatever an
// instantiation supplies rather than a type of its own.
fun _erase_named(CheckedType t, Vec<str>* names) CheckedType {
  if equals(t.name, "") {
    ret t;
  }
  num i = 0;
  for i < names.len {
    if equals(names.get(i), t.name) {
      // Same reasoning as `_erase_type_params`'s own discard above.
      _free_checked_type_contents(&t);
      ret checked_unknown();
    }
    i = i + 1;
  }
  ret t;
}

// The same, over a whole signature: an impl's type parameters reach its
// methods' return types and parameters.
fun _erase_signature(FnSig sig, Vec<str>* names) FnSig {
  if names.len == 0 {
    ret sig;
  }
  FnSig out = sig;
  // `rtype_template` is deliberately left alone here: it already holds
  // `rtype` exactly as `_signature_of` first declared it, from before
  // ANY erasure pass (this one, an impl's own type params, or that
  // one's own, a free function's own) ever touched anything - that is
  // the whole point of keeping it (see its own field comment), so
  // there is nothing for this impl-level pass to add to it.
  out.rtype = _erase_named(sig.rtype, names);
  // Same aliasing shape as `_without_self`'s own `out = sig;`: `out.args`
  // is about to point at a fresh backing array, abandoning the one it
  // still shares with `sig.args` here. Each element's own content
  // already travels through `_erase_named` intact (or gets freed there
  // when erased) - only this array's own shell is left over.
  Vec<CheckedType> old_args = out.args;
  out.args.init(sig.args.len);
  num i = 0;
  for i < sig.args.len {
    out.args.push(_erase_named(old_args.get(i), names));
    i = i + 1;
  }
  old_args.free();
  ret out;
}

fun _signature_of(FunctionNode f) FnSig {
  FnSig sig;
  sig.args.init(f.args.len);
  sig.rtype = checked_unknown();
  sig.rtype_template = checked_unknown();
  if f.has_rtype {
    // Two independent conversions, not one shared value and a copy:
    // `CheckedType` owns heap content of its own (`generic_args`,
    // `tuple_members`), and `_erase_type_params` below may free `sig.
    // rtype`'s own copy wholesale the moment it matches - `rtype_
    // template` needs its own, untouched by whatever happens to the
    // other one.
    sig.rtype_template = checked_from_dtype(f.rtype);
    sig.rtype = _erase_type_params(f, checked_from_dtype(f.rtype));
  }
  sig.is_variadic = f.is_variadic;
  sig.is_async = f.is_async;
  sig.is_generic = f.has_type_params && f.type_params.len > 0;
  sig.ambiguous = false;
  sig.file = "";
  sig.is_public = false;
  sig.type_params.init(0);
  sig.bounds.init(0);
  sig.arg_params.init(f.args.len);
  sig.type_param_defaults.init(0);
  if f.has_type_params {
    for p : f.type_params {
      sig.type_params.push(p);
    }
    num tpdi = 0;
    for tpdi < f.type_params.len {
      if tpdi < f.type_param_defaults.len && f.type_param_defaults.get(tpdi) != nil {
        sig.type_param_defaults.push(
          checked_from_dtype(f.type_param_defaults.get(tpdi))
        );
      } else {
        sig.type_param_defaults.push(checked_unknown());
      }
      tpdi = tpdi + 1;
    }
  }
  if f.has_type_param_forced_insts {
    for b : f.type_param_forced_insts {
      sig.bounds.push(b);
    }
  }
  sig.min_args = 0;
  flag counting = true;
  for a : f.args {
    fit a.kind {
      .Variable(v) -> {
        CheckedType declared = checked_from_dtype(v.var_type);
        str written = "";
        if _is_type_param(f, declared.name) {
          written = declared.name;
        }
        sig.arg_params.push(written);
        sig.args.push(_erase_type_params(f, declared));
        // A parameter with a default value, and everything after it,
        // may be left out by the caller.
        if v.has_val {
          counting = false;
        } elif counting {
          sig.min_args = sig.min_args + 1;
        }
      }
      _ -> {
        sig.arg_params.push("");
        sig.args.push(checked_unknown());
      }
    }
  }
  ret sig;
}

// True when a call's callee is a member access (`a.b(...)`), which
// method-call checking handles.
fun _is_member_callee(Node* callee) flag {
  fit callee.kind {
    .Expression(ce) -> { ret equals(ce.op, "."); }
    _ -> { ret false; }
  }
}

// The name a call's callee refers to, empty when it is not a plain call
// to a named function.
fun _callee_name(Node* callee) str {
  if callee == nil {
    ret "";
  }
  fit callee.kind {
    .Identifier(name) -> { ret name; }
    _ -> { ret ""; }
  }
}

// The arguments of a call, whose AST shape is a comma expression when
// there is more than one.
fun _call_args(Node* node, Vec<Node*>* out) {
  if node == nil {
    ret;
  }
  fit node.kind {
    .Expression(e) -> {
      if equals(e.op, ",") && e.has_left && e.has_right {
        _call_args(e.left, out);
        _call_args(e.right, out);
        ret;
      }
    }
    // A call's argument list is parenthesized, and the parentheses are
    // a node of their own.
    .ExpressionParenthesis(inner) -> {
      _call_args(inner, out);
      ret;
    }
    // An empty argument list still carries a node, which is not an
    // argument.
    .Blank -> { ret; }
    _ -> {}
  }
  out.push(node);
}

// A format-like variadic function's own fmt-argument index
// (`fprintf`/`sprintf`/`snprintf` carry a stream/destination before
// it), or -1 for anything else. `scanf`/`sscanf` are deliberately
// excluded: an input format's own specifiers name what gets written
// through a pointer, not a value's own type - a different, riskier
// check than this one, not attempted here.
fun _format_fmt_arg_index(str name) num {
  // format(fmt, ...), print_fmt(fmt, ...), println_fmt(fmt, ...),
  // printf(fmt, ...): fmt is the first argument, nothing before it.
  if equals(name, "format") || equals(name, "print_fmt") || equals(name, "println_fmt") ||
    equals(name, "printf") {
    ret 0;
  }
  // fprintf(stream, fmt, ...), sprintf(dst, fmt, ...): one argument
  // (the stream/destination) comes before fmt.
  if equals(name, "fprintf") || equals(name, "sprintf") {
    ret 1;
  }
  // snprintf(dst, n, fmt, ...): two arguments (destination, then its
  // own capacity) come before fmt.
  if equals(name, "snprintf") {
    ret 2;
  }
  ret -1;
}

fun _is_c_style_format(str name) flag {
  ret equals(name, "printf") || equals(name, "fprintf") || equals(name, "sprintf") ||
    equals(name, "snprintf");
}

// The `{type}` placeholders in `fmt` (Fun's own `format()` syntax),
// in order: `""` for an untyped `{}`, or one of the 7 recognized
// type names for a typed one. Mirrors `format_impl`'s (std/io.fn)
// own recognition rules exactly - `{{` is a literal `{`, and `{xyz}`
// is a placeholder only when `xyz` names one of those 7 types,
// anything else is literal text - so this never misreads a
// literal-brace-heavy format string (fls's own JSON-building
// `format()` calls, throughout this very codebase) as carrying
// placeholders it doesn't.
fun _fun_format_specs(str fmt) Vec<str> {
  Vec<str> out;
  out.init(4);
  num i = 0;
  num n = len(fmt);
  for i < n {
    chr c = fmt[i];
    if c != '{' {
      i = i + 1;
      continue;
    }
    if i + 1 < n && fmt[i + 1] == '{' {
      i = i + 2;
      continue;
    }
    if i + 1 < n && fmt[i + 1] == '}' {
      out.push("");
      i = i + 2;
      continue;
    }
    // The placeholder word's own length varies, so the closing `}` is
    // found by scanning forward within a short bound.
    num close = -1;
    num max_word_len = 5;
    num limit = i + 1 + max_word_len;
    if limit > n {
      limit = n;
    }
    num j = i + 1;
    for j < limit {
      if fmt[j] == '}' {
        close = j;
        break;
      }
      j = j + 1;
    }
    if close > 0 {
      str word = substr(fmt, i + 1, close - i - 1);
      // Pushes the matched literal, not `word` itself: every entry
      // `out` ever holds is either this fixed vocabulary or the plain
      // literal `""` above, never a fresh allocation, so a caller
      // freeing `out` only needs to free its own backing array - the
      // same convention `_c_format_specs` already follows.
      flag matched = true;
      if equals(word, "str") {
        out.push("str");
      } elif equals(word, "num") {
        out.push("num");
      } elif equals(word, "dec") {
        out.push("dec");
      } elif equals(word, "flag") {
        out.push("flag");
      } elif equals(word, "chr") {
        out.push("chr");
      } elif equals(word, "ptr") {
        out.push("ptr");
      } elif equals(word, "raw") {
        out.push("raw");
      } elif equals(word, "f32") || equals(word, "f64") {
        out.push("dec");
      } elif is_fixed_width_placeholder(word) {
        out.push("num");
      } else {
        matched = false;
      }
      free(word);
      if matched {
        i = close + 1;
        continue;
      }
    }
    i = i + 1;
  }
  ret out;
}

// The C-style conversions in `fmt` (`printf`/`fprintf`/`sprintf`/
// `snprintf`), as the same Fun type-name vocabulary `_fun_format_specs`
// uses, one entry per `%`-conversion found; `%%` is a literal percent,
// never a placeholder. `.None` (rather than an empty `Vec`) for
// anything this parser doesn't confidently recognize - a positional
// argument (`%1$s`), a dynamic width/precision (`%*d`), or an
// unrecognized conversion character - so a caller skips the check
// entirely rather than risk a false positive on a spec it doesn't
// fully understand.
fun _c_format_specs(str fmt) Option<Vec<str>> {
  Vec<str> out;
  out.init(4);
  num i = 0;
  num n = len(fmt);
  for i < n {
    chr c = fmt[i];
    if c != '%' {
      i = i + 1;
      continue;
    }
    i = i + 1;
    if i >= n {
      out.free();
      ret .None;
    }
    if fmt[i] == '%' {
      i = i + 1;
      continue;
    }
    for i < n &&
      (fmt[i] == '-' || fmt[i] == '+' || fmt[i] == '0' || fmt[i] == ' ' || fmt[i] == '#') {
      i = i + 1;
    }
    if i < n && fmt[i] == '*' {
      out.free();
      ret .None;
    }
    for i < n && fmt[i] >= '0' && fmt[i] <= '9' {
      i = i + 1;
    }
    if i < n && fmt[i] == '.' {
      i = i + 1;
      if i < n && fmt[i] == '*' {
        out.free();
        ret .None;
      }
      for i < n && fmt[i] >= '0' && fmt[i] <= '9' {
        i = i + 1;
      }
    }
    for i < n &&
      (fmt[i] == 'l' || fmt[i] == 'h' || fmt[i] == 'z' || fmt[i] == 'j' || fmt[i] == 't' || fmt[i] == 'L') {
      i = i + 1;
    }
    if i >= n {
      out.free();
      ret .None;
    }
    chr conv = fmt[i];
    i = i + 1;
    if conv == 'd' || conv == 'i' || conv == 'u' || conv == 'x' || conv == 'X' || conv == 'o' {
      out.push("num");
    } elif conv == 'f' || conv == 'F' || conv == 'g' || conv == 'G' || conv == 'e' || conv == 'E' {
      out.push("dec");
    } elif conv == 's' {
      out.push("str");
    } elif conv == 'c' {
      out.push("chr");
    } elif conv == 'p' {
      out.push("raw");
    } else {
      out.free();
      ret .None;
    }
  }
  ret .Some(out);
}

fun _data_type_for(str want_name) DataTypeType {
  if equals(want_name, "str") {
    ret .Str;
  }
  if equals(want_name, "num") {
    ret .Num;
  }
  if equals(want_name, "dec") {
    ret .Dec;
  }
  if equals(want_name, "flag") {
    ret .Bin;
  }
  ret .Chr;
}

// Flattens a bound's per-combination alternatives at one type-parameter
// position into a single list: each combination names one concrete type
// per parameter, so what a parameter may stand for is that position
// across every combination. The caller owns the returned `Vec`.
fun _flat_allowed_for_param(Vec<Vec<str>> combos, num p) Vec<str> {
  Vec<str> allowed;
  allowed.init(combos.len);
  num b = 0;
  for b < combos.len {
    Vec<str> combination = combos.get(b);
    b = b + 1;
    if p < combination.len {
      allowed.push(combination.get(p));
    }
  }
  ret allowed;
}

impl Checker {
  // The type a literal, name, or operator expression produces; anything
  // the checker does not model infers as unknown. Whatever it resolves to that names one of
  // the enclosing function's own type params (`cur.value` through a
  // `Node<T>*`, a method returning `T`) stands for whatever an
  // instantiation supplies, the same as a parameter declared `T` - erased
  // here once, at the one place every expression's type passes through,
  // rather than left as a literal type named `T` that no operator or
  // value ever matches.
  infer(Node* node, TypeEnv* env) CheckedType {
    CheckedType t = self._infer_raw(node, env);
    if self.active_type_params.len > 0 && !equals(t.name, "") && !t.is_tuple &&
      self.active_type_params.contains(t.name) {
      CheckedType erased = checked_unknown();
      erased.pointer_depth = t.pointer_depth;
      ret erased;
    }
    ret t;
  }

  _infer_raw(Node* node, TypeEnv* env) CheckedType {
    if node == nil {
      ret checked_unknown();
    }
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Dec(_) -> { ret checked_of(.Dec); }
          .Cval(_) -> { ret checked_of(.Chr); }
          .Num(value) -> {
            CheckedType t = checked_of(.Num);
            // Zero is how a null pointer is written.
            t.is_null_literal = value == 0;
            ret t;
          }
          _ -> { ret checked_of(.Num); }
        }
      }
      .String(_) -> { ret checked_of(.Str); }
      .Character(_) -> { ret checked_of(.Chr); }
      .Boolean(_) -> { ret checked_of(.Bin); }
      .Nil -> {
        CheckedType t = checked_of(.Raw);
        t.is_null_literal = true;
        ret t;
      }
      .Panic(_) -> {
        CheckedType t = checked_unknown();
        t.is_panic_literal = true;
        ret t;
      }
      .Identifier(name) -> {
        let found = env.lookup(name);
        if found.is_some() {
          ret found.unwrap();
        }
        CheckedType out = checked_unknown();
        if self.fns.at(name).is_some() {
          out.function_name = name;
        }
        ret out;
      }
      .ExpressionParenthesis(inner) -> { ret self.infer(inner, env); }
      .Bracket(items) -> { ret self.infer_bracket(node, items, env); }
      .CompoundInit(init) -> { ret self.infer_compound_init(node, init, env); }
      .TupleLiteral(tl) -> {
        CheckedType out = checked_unknown();
        out.is_tuple = true;
        for el : tl.elements {
          out.tuple_members.push(self.infer(el, env));
        }
        ret out;
      }
      .Unary(u) -> { ret self.infer_unary(node, u, env); }
      .Ternary(t) -> { ret self.infer_ternary(node, t, env); }
      .Expression(e) -> { ret self.infer_expression(node, e, env); }
      .ClosureLiteral(f) -> { ret self.infer_closure_literal(node, f, env); }
      _ -> { ret checked_unknown(); }
    }
    ret checked_unknown();
  }

  // A closure literal's body shares the SAME live `env` its enclosing
  // function's own body is already being checked against (`TypeEnv` is
  // just a flat scope stack, so this is no different from how an `if`/
  // `for` block's own body already sees everything around it) - never
  // an isolated one, which would silently lose visibility into every
  // local the closure actually captures. `self.rtype` is saved and
  // swapped the same way `check_function_with_self` already does for a
  // real function, so a `ret` inside the closure checks against the
  // closure's OWN declared return type, not whatever function the
  // closure literal itself happens to sit inside.
  infer_closure_literal(Node* node, FunctionNode f, TypeEnv* env) CheckedType {
    // A top-level variable is in `env` too; listing one is harmless, since
    // the closure reaches it directly either way.
    for rc : f.ref_captures {
      if env.lookup(rc).is_none() {
        self.fail(format("'{str}' in the capture list isn't a variable in scope", rc), node);
        ret checked_unknown();
      }
    }
    CheckedType previous_rtype = self.rtype;
    self.rtype = checked_unknown();
    if f.has_rtype {
      self.rtype = checked_from_dtype(f.rtype);
    }
    env.push();
    for a : f.args {
      fit a.kind {
        .Variable(av) -> { env.bind(av.name, checked_from_dtype(av.var_type), false); }
        _ -> {}
      }
    }
    self.closure_depth = self.closure_depth + 1;
    self.check_statement(f.body, env);
    self.closure_depth = self.closure_depth - 1;
    env.pop();
    _free_checked_type_contents(&self.rtype);
    self.rtype = previous_rtype;

    CheckedType t = checked_unknown();
    t.has_closure_sig = true;
    t.name = "closure(...)";
    t.closure_sig = f.closure_sig;
    t.holds_refs = f.ref_captures.len > 0;
    ret t;
  }

  // The type a compound literal builds. A generic one written without
  // arguments takes them from the fields it initializes.
  infer_compound_init(Node* node, CompoundInitNode init, TypeEnv* env) CheckedType {
    if !init.has_dtype {
      ret checked_unknown();
    }
    CheckedType built = checked_from_dtype(init.init_dtype);
    self.check_instantiation(built, node);
    if self.failed {
      ret checked_unknown();
    }
    let info = self.compounds.at(self.canonical_type_name(built.name));
    if info.is_none() {
      ret built;
    }
    CompoundInfo holder = info.unwrap();
    // A union holds one field at a time, so a literal naming two would
    // silently keep only the last.
    if holder.is_union && init.fields.len > 1 {
      self.fail(
        format(
        "a '{str}' literal sets {num} fields, but a union holds only one at a time",
        built.name,
        init.fields.len
        ),
        node
      );
      ret checked_unknown();
    }
    for f : init.fields {
      let field_type = holder.fields.at(f.name);
      if field_type.is_none() {
        continue;
      }
      CheckedType want = field_type.unwrap();
      self.check_shorthand_variant(f.value, want, env);
      if self.failed {
        ret checked_unknown();
      }
      // A generic compound's field is checked once its parameters are
      // known, from the literal's own written arguments.
      if holder.is_generic {
        if built.generic_args.len == 0 {
          continue;
        }
        want = substitute(want, &holder.type_params, &built.generic_args);
      }
      CheckedType got = self.infer(f.value, env);
      if self.failed {
        ret checked_unknown();
      }
      if !self.assignable(want, got) {
        self.fail(
          format(
          "field '{str}' of '{str}' expects {str}, found {str}",
          f.name,
          built.name,
          type_name(want),
          type_name(got)
          ),
          f.value
        );
        ret checked_unknown();
      }
    }
    if !holder.is_generic || built.generic_args.len > 0 {
      ret built;
    }
    // Each parameter stands for the type of the first field written in
    // terms of it.
    num p = 0;
    for p < holder.type_params.len {
      str param = holder.type_params.get(p);
      p = p + 1;
      CheckedType stands_for = checked_unknown();
      for f : init.fields {
        let declared = holder.fields.at(f.name);
        if declared.is_none() {
          continue;
        }
        if !equals(declared.unwrap().name, param) {
          continue;
        }
        stands_for = self.infer(f.value, env);
        break;
      }
      built.generic_args.push(stands_for);
    }
    ret built;
  }

  // The type an array literal holds, which every element must share.
  infer_bracket(Node* node, Node* items, TypeEnv* env) CheckedType {
    Vec<Node*> elements;
    elements.init(4);
    defer elements.free();
    _call_args(items, &elements);

    CheckedType held = checked_unknown();
    num i = 0;
    for i < elements.len {
      CheckedType element = self.infer(elements.get(i), env);
      i = i + 1;
      if is_unknown(element) {
        continue;
      }
      if is_unknown(held) {
        held = element;
        continue;
      }
      if !can_assign(held, element) && !can_assign(element, held) {
        self.fail(
          format(
          "an array literal holds one type, found {str} and {str}",
          type_name(held),
          type_name(element)
          ),
          node
        );
        ret checked_unknown();
      }
    }
    if is_unknown(held) {
      ret checked_unknown();
    }
    CheckedType t = held;
    t.is_array = true;
    t.array_depth = held.array_depth + 1;
    ret t;
  }

  // A ternary's own type is whichever of its two branches is the more
  // specific, the same rule `infer_bracket` already uses across an
  // array literal's elements: either side assignable to the other
  // passes, an unknown side defers entirely to the other, and two
  // genuinely incompatible sides fail loudly instead of guessing.
  infer_ternary(Node* node, TernaryNode t, TypeEnv* env) CheckedType {
    self.check_condition(t.cond, env);
    if self.failed {
      ret checked_unknown();
    }
    CheckedType then_type = self.infer(t.then_val, env);
    CheckedType else_type = self.infer(t.else_val, env);
    if is_unknown(then_type) {
      ret else_type;
    }
    if is_unknown(else_type) {
      ret then_type;
    }
    if can_assign(then_type, else_type) {
      ret then_type;
    }
    if can_assign(else_type, then_type) {
      ret else_type;
    }
    self.fail(
      format(
      "a ternary's two branches must share a type, found {str} and {str}",
      type_name(then_type),
      type_name(else_type)
      ),
      node
    );
    ret checked_unknown();
  }

  infer_unary(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    if equals(u.op, "await") {
      ret self.check_await(u, env);
    }
    // `x?`/`x!`: Option/Result propagation. Checked ahead of the
    // ordinary operand inference below since a failed propagation
    // check should report on the whole unary node, not fall through to
    // treating '!' as logical-NOT.
    if u.is_left_operanded_unary && (equals(u.op, "?") || equals(u.op, "!")) {
      ret self.infer_propagation(node, u, env);
    }
    if u.is_left_operanded_unary && equals(u.op, "?!") {
      ret self.infer_option_to_result_propagation(node, u, env);
    }
    if u.is_left_operanded_unary && equals(u.op, "!?") {
      ret self.infer_result_to_option_propagation(node, u, env);
    }
    CheckedType operand = self.infer(u.operand, env);
    if equals(u.op, "&") {
      CheckedType t = operand;
      t.pointer_depth = operand.pointer_depth + 1;
      ret t;
    }
    if equals(u.op, "*") {
      // A run of consecutive `*`s (`**pp`) parses as one `Unary` node
      // with `indirection_depth` holding the whole run
      // (`parse_for_indirection_unary`), not as nested `Unary` nodes -
      // dereferencing by just 1 regardless of how many stars were
      // written left this one pointer level short every time, the
      // same wrong type whether reading `**pp` or assigning through
      // it (`check_assignment`'s own `.Unary` case infers through
      // here too).
      num depth = 1;
      if u.has_indirection && u.indirection_depth > 0 {
        depth = u.indirection_depth;
      }
      if operand.pointer_depth < depth {
        // A known, plainly non-pointer operand (`*head` where `head` is a
        // `Node` value) used to come back as Unknown, which every later
        // check treats as assignable to anything, so the mistake only
        // ever surfaced as a raw C error - or never, in an uninstantiated
        // generic or an unreachable function. An array (decays to a
        // pointer in C) and an erased/unknown type stay permissive.
        if !is_unknown(operand) && !operand.is_array {
          self.fail(
            format("cannot dereference {str}, which is not a pointer", type_name(operand)),
            node
          );
        }
        ret checked_unknown();
      }
      CheckedType t = operand;
      t.pointer_depth = operand.pointer_depth - depth;
      ret t;
    }
    if equals(u.op, "-") {
      // Not `operator_method_name` - that maps the same `"-"` text to
      // `op_sub`, the *binary* operator's own method name, which would
      // collide here. Negating a pointer means nothing, so `-self` is the
      // receiver's own `op_neg`.
      CheckedType neg_operand = operator_operand_type(
        u.operand,
        operand,
        nil,
        checked_of(.Num)
      );
      if neg_operand.pointer_depth == 0 && !neg_operand.is_array &&
        !equals(neg_operand.name, "") {
        let sig = self.receiver_method(neg_operand, "op_neg");
        if sig.is_some() && sig.unwrap().args.len == 0 {
          ret sig.unwrap().rtype;
        }
      }
      ret operand;
    }
    if equals(u.op, "!") {
      if operand.pointer_depth == 0 && !operand.is_array && !equals(operand.name, "") {
        let sig = self.receiver_method(operand, "op_not");
        if sig.is_some() && sig.unwrap().args.len == 0 {
          ret sig.unwrap().rtype;
        }
      }
      ret checked_of(.Bin);
    }
    ret operand;
  }

  // `x?` propagates a `.None` from `x: Option<T>`, evaluating to `T`
  // on `.Some`; `x!` propagates a `.Err(e)` from `x: Result<T,E>` (the
  // enclosing function's own error type must be exactly `E`, no
  // conversion), evaluating to `T` on `.Ok`. Real codegen lowering
  // happens later, in emit_expr's own `.Unary` handling; this only
  // validates and infers the resulting type.
  infer_propagation(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    CheckedType operand = self.infer(u.operand, env);
    flag is_option = equals(u.op, "?");
    str want_name = "Option";
    if !is_option {
      want_name = "Result";
    }
    if !equals(operand.name, want_name) {
      str other_name = is_option ? "Result" : "Option";
      if equals(operand.name, other_name) {
        // The other propagation operator is the one that fits.
        self.fail(
          format(
          "'{str}' unwraps an {str}, but this is a {str}; use '{str}'",
          u.op,
          want_name,
          other_name,
          is_option ? "!" : "?"
          ),
          node
        );
        ret checked_unknown();
      }
      self.fail(format("'{str}' used on a non-{str} expression", u.op, want_name), node);
      ret checked_unknown();
    }
    if !equals(self.rtype.name, want_name) {
      self.fail(
        format("'{str}' used outside a function returning {str}<...>", u.op, want_name),
        node
      );
      ret checked_unknown();
    }
    if !is_option {
      str operand_e = type_name(operand.generic_args.get(1));
      str rtype_e = type_name(self.rtype.generic_args.get(1));
      if !equals(operand_e, rtype_e) {
        self.fail(
          format(
          "'!' propagates {str}, but the enclosing function returns Result<_, {str}>",
          operand_e,
          rtype_e
          ),
          node
        );
        ret checked_unknown();
      }
    }
    ret operand.generic_args.get(0);
  }

  // `x?!(err)`: propagates `err` from `x: Option<T>`'s `.None` in
  // whatever shape the enclosing function needs - `.Err(err)` if it
  // returns `Result<_, E>`, or `.Some(err)` if it returns `Option<E>`
  // (the error-channel convention codegen.fn itself uses throughout).
  // Evaluates to `T` on `.Some`. `err` must be assignable to the enclosing
  // function's own error slot, no conversion; a bare `.Variant` shorthand
  // has no type of its own and is accepted like any other unknown-typed
  // expression.
  infer_option_to_result_propagation(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    CheckedType operand = self.infer(u.operand, env);
    if !equals(operand.name, "Option") {
      self.fail("'?!' used on a non-Option expression", node);
      ret checked_unknown();
    }
    if !u.has_error_arg {
      self.fail("'?!' needs an error value: '?!(err)'", node);
      ret checked_unknown();
    }
    CheckedType err_val = self.infer(u.error_arg, env);
    if equals(self.rtype.name, "Result") {
      CheckedType want_err = self.rtype.generic_args.get(1);
      self.check_shorthand_variant(u.error_arg, want_err, env);
      if self.failed {
        ret checked_unknown();
      }
      if !self.assignable(want_err, err_val) {
        self.fail(
          format(
          "'?!' propagates {str}, but the enclosing function returns Result<_, {str}>",
          type_name(err_val),
          type_name(want_err)
          ),
          node
        );
        ret checked_unknown();
      }
    } elif equals(self.rtype.name, "Option") {
      CheckedType want_err = self.rtype.generic_args.get(0);
      self.check_shorthand_variant(u.error_arg, want_err, env);
      if self.failed {
        ret checked_unknown();
      }
      if !self.assignable(want_err, err_val) {
        self.fail(
          format(
          "'?!' propagates {str}, but the enclosing function returns Option<{str}>",
          type_name(err_val),
          type_name(want_err)
          ),
          node
        );
        ret checked_unknown();
      }
    } else {
      self.fail("'?!' used outside a function returning Result<...> or Option<...>", node);
      ret checked_unknown();
    }
    ret operand.generic_args.get(0);
  }

  // `x!?`: propagates from `x: Result<T, E>`'s `.Err(_)` by returning
  // `.None` from the enclosing function, discarding the error entirely
  // - the enclosing function just needs to return SOME `Option<...>`,
  // no relation between its own generic arg and `E` required (`.None`
  // carries no payload to typecheck against it). Evaluates to `T` on
  // `.Ok`.
  infer_result_to_option_propagation(Node* node, UnaryNode u, TypeEnv* env) CheckedType {
    CheckedType operand = self.infer(u.operand, env);
    if !equals(operand.name, "Result") {
      self.fail("'!?' used on a non-Result expression", node);
      ret checked_unknown();
    }
    if !equals(self.rtype.name, "Option") {
      self.fail("'!?' used outside a function returning Option<...>", node);
      ret checked_unknown();
    }
    ret operand.generic_args.get(0);
  }

  // The type a binary operator produces, checking a call's arguments
  // against what the callee declares along the way.
  infer_expression(Node* node, ExprNode e, TypeEnv* env) CheckedType {
    if equals(e.op, "()") {
      ret self.check_call(node, e, env, false);
    }
    if _is_assignment(e.op) {
      self.check_assignment(node, e, env);
      ret checked_unknown();
    }
    // A decimal has no remainder to take.
    if equals(e.op, "%") && e.has_left && e.has_right {
      CheckedType left = self.infer(e.left, env);
      CheckedType right = self.infer(e.right, env);
      if left.base == .Dec || right.base == .Dec {
        self.fail("the remainder operator does not apply to a decimal", node);
        ret checked_unknown();
      }
    }
    // Dividing by a zero written into the program is a mistake the
    // program can be told about, rather than one the machine finds.
    if (equals(e.op, "/") || equals(e.op, "%")) && e.has_right {
      if _is_constant_zero(e.right) {
        self.fail(
          format("division by zero: right operand of '{str}' is the constant 0", e.op),
          node
        );
        ret checked_unknown();
      }
    }
    if equals(e.op, ".") {
      ret self.infer_field(node, e, env);
    }
    // An index reads what the sequence holds: an array's own element
    // type one level shallower, or (a `str` has no array flag of its
    // own, C string semantics) a single `chr`.
    if equals(e.op, "[]") {
      if !e.has_left {
        ret checked_unknown();
      }
      CheckedType base = self.infer(e.left, env);
      if base.base == .Str && !base.is_array {
        ret checked_of(.Chr);
      }
      if !base.is_array {
        if !e.has_right {
          ret checked_unknown();
        }
        // `e.right` is the index's `.Bracket` wrapper, not the index
        // expression itself - unwrapped first, since `infer()`'s own
        // `.Bracket` case (`infer_bracket`) means an array *literal*
        // (`[1, 2, 3]`), not "infer whatever's inside these brackets."
        Node* index_node = e.right;
        fit e.right.kind {
          .Bracket(inner) -> { index_node = inner; }
          _ -> {}
        }
        CheckedType index = self.infer(index_node, env);
        let dispatched = self.try_operator_dispatch(node, base, "[]", .Some(index));
        if dispatched.is_some() {
          ret dispatched.unwrap();
        }
        ret checked_unknown();
      }
      if e.has_right {
        Node* read_index_node = e.right;
        fit e.right.kind {
          .Bracket(inner) -> { read_index_node = inner; }
          _ -> {}
        }
        self.check_array_index_bounds(node, base, read_index_node);
      }
      ret _array_element(base);
    }
    if equals(e.op, ",") {
      ret checked_unknown();
    }
    if _is_comparison(e.op) || _is_logical(e.op) {
      self.check_comparison(node, e, env);
      ret checked_of(.Bin);
    }
    if !e.has_left {
      ret checked_unknown();
    }
    CheckedType left = self.infer(e.left, env);
    if !e.has_right {
      ret left;
    }
    CheckedType right = self.infer(e.right, env);
    let dispatched = self.try_operator_dispatch(
      node,
      operator_operand_type(e.left, left, e.right, right),
      e.op,
      .Some(operator_operand_type(e.right, right, e.left, left))
    );
    if dispatched.is_some() {
      ret dispatched.unwrap();
    }
    // Neither side owns this operator through an impl, so it falls to
    // C's own built-in meaning: numeric/decimal/char arithmetic (`'0' -
    // 'a'`, the lexer's own idiom, is as ordinary as `1 + 2`), or
    // pointer arithmetic. A named type with no `op_add`/`op_sub`/... of
    // its own has neither - left unchecked, `"a" + "b"` passed straight
    // through as `char*` addition, which C itself then rejects with no
    // real diagnostic at all.
    flag left_ok = is_unknown(left) || left.pointer_depth > 0 || left.is_array ||
      left.base == .Num || left.base == .Dec || left.base == .Chr;
    flag right_ok = is_unknown(right) || right.pointer_depth > 0 || right.is_array ||
      right.base == .Num || right.base == .Dec || right.base == .Chr;
    // `str` is itself a pointer at the C level, so offsetting one by a
    // whole number (`name + sep + 2`, this very file's own idiom) is
    // ordinary pointer arithmetic - but pairing two of them, as in
    // `"woof " + "rex"`, is never that: neither commutes to a real
    // address, and it's almost always a beginner's attempt at the
    // concatenation this operator never performs.
    if left.base == .Str && left.pointer_depth == 0 && !left.is_array {
      left_ok = right.base == .Num || is_unknown(right);
    }
    if right.base == .Str && right.pointer_depth == 0 && !right.is_array {
      right_ok = left.base == .Num || is_unknown(left);
    }
    if !left_ok || !right_ok {
      self.fail(
        format(
        "'{str}' is not defined between {str} and {str}",
        e.op,
        type_name(left),
        type_name(right)
        ),
        node
      );
      ret checked_unknown();
    }
    // Arithmetic on two numeric kinds widens to the wider one.
    if right.base == .Dec && left.base == .Num {
      ret right;
    }
    if is_unknown(left) {
      ret right;
    }
    ret left;
  }

  // The type a field access reads, and the name of the type it reads
  // from. A method call is a field access whose result is called.
  infer_field(Node* node, ExprNode e, TypeEnv* env) CheckedType {
    if !e.has_left || !e.has_right {
      ret checked_unknown();
    }
    CheckedType receiver = self.infer(e.left, env);
    // Tuple positional access (`t.0`): the RHS lexes/parses as a plain
    // `Number` token (a real int, never a `Dec`, since the lexer only
    // treats a post-operand `.digit` as a leading-dot float when nothing
    // already ends a value before it), not an `Identifier` the way an
    // ordinary field name is - `_callee_name` below returns "" for it,
    // which is why this has to be checked first, not folded into the
    // ordinary field-name path.
    flag right_is_number = false;
    num tuple_index = 0;
    fit e.right.kind {
      .Number(data) -> {
        fit data {
          .Num(n) -> {
            right_is_number = true;
            tuple_index = n;
          }
          _ -> {}
        }
      }
      _ -> {}
    }
    if right_is_number {
      // A receiver the checker genuinely can't resolve (most commonly a
      // generic method's own un-substituted return type - `Vec<T>.get`
      // returns a method's declared return type as-is with no generic
      // substitution, a pre-existing gap this positional-access check
      // must not be stricter about than the ordinary field-name path
      // just below already is: that path's own `self.compounds.at(...)`
      // lookup silently falls through to `checked_unknown()` for exactly
      // this case, deferring entirely to codegen's own separate,
      // independent type resolution rather than reporting a real error
      // here. Covers both shapes an unresolved receiver actually takes
      // in practice: an empty name (`is_unknown`) and a real but
      // undeclared one, like a raw type-param name (`names_a_declared_type`).
      if !receiver.is_tuple &&
        (is_unknown(receiver) || !self.names_a_declared_type(receiver)) {
        ret checked_unknown();
      }
      if !receiver.is_tuple {
        self.fail(format("no field named '{num}'", tuple_index), node);
        ret checked_unknown();
      }
      if tuple_index < 0 || tuple_index >= receiver.tuple_members.len {
        self.fail(
          format(
          "tuple has no element {num} (it has {num} element(s))",
          tuple_index,
          receiver.tuple_members.len
          ),
          node
        );
        ret checked_unknown();
      }
      ret receiver.tuple_members.get(tuple_index);
    }
    str field = _callee_name(e.right);
    if equals(field, "") {
      ret checked_unknown();
    }
    // A closure is called or freed, never read into.
    if receiver.has_closure_sig {
      self.fail(format("a closure has no field '{str}'", field), node);
      ret checked_unknown();
    }
    if self.check_alias_qualified_read(e, field, env) {
      ret checked_unknown();
    }
    let info = self.compounds.at(self.canonical_type_name(receiver.name));
    if info.is_none() {
      ret checked_unknown();
    }
    CompoundInfo holder = info.unwrap();
    let found = holder.fields.at(field);
    if found.is_some() {
      self.check_field_visibility(holder, receiver.name, field, node);
      CheckedType declared = found.unwrap();
      if holder.is_generic {
        // Without the arguments the instantiation supplied, the field's
        // type is whatever the parameter stood for.
        if receiver.generic_args.len == 0 {
          ret checked_unknown();
        }
        ret substitute(declared, &holder.type_params, &receiver.generic_args);
      }
      ret declared;
    }
    if holder.is_generic && receiver.generic_args.len == 0 {
      ret checked_unknown();
    }
    // A method reads as a field until it is called.
    if self.has_method(receiver.name, field) {
      ret checked_unknown();
    }
    self.fail(format("'{str}' has no field '{str}'", receiver.name, field), node);
    ret checked_unknown();
  }

  // `self.compounds`/`self.methods` are keyed by a type's own bare name.
  // A cross-file reference through an import alias (`m.Boxed`) mangles
  // the annotation to `m__Boxed` at parse time, so a lookup by that raw
  // name misses; this resolves it back to the bare name once doing so
  // actually helps, and leaves anything else (a generic mangled name, a
  // genuinely unknown type) untouched.
  // Always borrows `name` - never a fresh allocation, even on the
  // stripped-suffix path, since every caller throughout this file treats
  // the result as borrowed and never frees it (this is called from deep
  // inside hot paths like `receiver_method`/`has_method`, many times per
  // typecheck pass): offsetting straight into `name`'s own buffer rather
  // than `substr`-copying it is safe exactly because `name` itself
  // already outlives every use of the returned pointer.
  canonical_type_name(str name) str {
    if self.compounds.at(name).is_some() || self.methods.at(name).is_some() ||
      self.shapes.has(name) || self.plain_enums.has(name) {
      ret name;
    }
    num sep = index_of_str(name, "__");
    if sep < 0 {
      ret name;
    }
    ret name + sep + 2;
  }

  has_method(str type_name, str method) flag {
    let table = self.methods.at(self.canonical_type_name(type_name));
    if table.is_none() {
      ret false;
    }
    MethodTable* found = table.unwrap();
    ret found.methods.at(method).is_some();
  }

  // A method reaches a receiver either through an impl on its
  // instantiation or through one on the type itself.
  receiver_method(CheckedType receiver, str method) Option<FnSig> {
    receiver.name = self.canonical_type_name(receiver.name);
    str instantiated = mangled_name(receiver);
    flag instantiated_is_fresh = receiver.generic_args.len > 0;
    defer {
      if instantiated_is_fresh {
        free(instantiated);
      }
    }
    if !equals(instantiated, receiver.name) {
      let found = self.method_signature(instantiated, method);
      if found.is_some() {
        ret found;
      }
    }
    ret self.method_signature(receiver.name, method);
  }

  // Resolves `op` to `left`'s own `impl`-defined operator method (see
  // `operator_method_name`) when one exists, validating `right` -
  // `.None` for a unary operator - against its one declared
  // parameter. `.None` means "no such operator on this type," which
  // every call site treats as "fall through to the builtin behavior
  // unchanged," never an error by itself - a pointer or array isn't
  // offered operator dispatch at all (pointer arithmetic keeps its
  // own existing meaning), and neither is a builtin (empty type
  // name). Once a match IS found, though, a wrong argument type is a
  // real error, the same quality `check_fn_sig_args` already gives an
  // ordinary call - this path only ever runs for a type the user
  // explicitly wrote an operator for, so there is no legacy behavior
  // to protect by staying silent on a bad call.
  try_operator_dispatch(
    Node* node,
    CheckedType left,
    str op,
    Option<CheckedType> right
  ) Option<CheckedType> {
    if left.pointer_depth > 0 || left.is_array || equals(left.name, "") {
      ret .None;
    }
    str method = operator_method_name(op);
    if equals(method, "") {
      ret .None;
    }
    let sig = self.receiver_method(left, method)?;
    if right.is_some() {
      if sig.args.len != 1 {
        ret .None;
      }
      CheckedType want_right = right.unwrap();
      if !self.assignable(sig.args.get(0), want_right) {
        self.fail(
          format(
          "'{str}' on {str} ({str}) expects {str}, found {str}",
          op,
          left.name,
          method,
          type_name(sig.args.get(0)),
          type_name(want_right)
          ),
          node
        );
      }
    } elif sig.args.len != 0 {
      ret .None;
    }
    ret .Some(sig.rtype);
  }

  // True when the checker has seen what methods a type has, which is
  // what lets it say a call names none of them. Every impl block in the
  // program is collected before method calls are checked, so a type the
  // checker has fully registered (a compound, shape, or enum) has
  // already shown it everything it will ever declare - whether or not
  // `self.methods` ended up with an entry for it - and an entry's
  // absence then means "this type has no such method," not "unmodeled."
  // Only a type the checker never registered at all (an opaque or
  // external one) stays silent.
  knows_methods_of(CheckedType receiver) flag {
    if equals(receiver.name, "") {
      ret false;
    }
    str canonical = self.canonical_type_name(receiver.name);
    ret self.compounds.at(canonical).is_some() || self.shapes.has(canonical) ||
      self.enum_names.has(canonical);
  }

  // The signature of `method` on `type_name`, if the type declares one.
  // `type_name` may already be a generic-instantiation mangled string
  // (`Vec__num`, built by `mangled_name`), which must not be run back
  // through alias canonicalization. A caller that means the base type
  // itself canonicalizes before it gets here.
  method_signature(str type_name, str method) Option<FnSig> {
    ret self.methods.at(type_name)?.methods.at(method);
  }

  // The signature a call through a receiver resolves to, if the checker
  // can name both the receiver's type and the method.
  resolve_method_call(ExprNode callee, TypeEnv* env) Option<FnSig> {
    ret .Some(self.resolve_method_call_with_receiver(callee, env)?.sig);
  }

  // `resolve_method_call`, also carrying the receiver's own checked type
  // (its generic args among them) - needed to substitute a generic
  // method's own type parameters, `Vec<T>.sort_by`'s `T` among them,
  // into a function-typed parameter's nested signature before it can be
  // compared against an argument's real one.
  resolve_method_call_with_receiver(ExprNode callee, TypeEnv* env) Option<MethodResolution> {
    if !callee.has_left || !callee.has_right {
      ret .None;
    }
    CheckedType receiver = self.infer(callee.left, env);
    if equals(receiver.name, "") {
      ret .None;
    }
    str method = _callee_name(callee.right);
    if equals(method, "") {
      ret .None;
    }
    MethodResolution found;
    found.sig = self.receiver_method(receiver, method)?;
    found.receiver = receiver;
    ret .Some(found);
  }

  // True when a call through a receiver reaches an async method, or one
  // the checker cannot resolve, which it does not second-guess.
  awaits_async_method(ExprNode e, TypeEnv* env) flag {
    if !e.has_left {
      ret true;
    }
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") {
          ret true;
        }
        let resolved = self.resolve_method_call(callee, env);
        if resolved.is_none() {
          ret true;
        }
        ret resolved.unwrap().is_async;
      }
      _ -> { ret true; }
    }
    ret true;
  }

  // Checks a call written through a receiver, which resolves to a
  // method the receiver's type declares.
  check_method_call(
    Node* node,
    ExprNode e,
    Vec<Node*>* args,
    TypeEnv* env,
    flag awaited
  ) CheckedType {
    if !e.has_left {
      ret checked_unknown();
    }
    Option<MethodResolution> resolved = .None;
    str method = "";
    fit e.left.kind {
      .Expression(callee) -> {
        if equals(callee.op, ".") {
          method = _callee_name(callee.right);
          // `.tag_value()` is a builtin available on any enum receiver,
          // plain or tagged-union, with no `impl` required - the
          // discriminant every enum already carries in C, read back as
          // `num`. Checked before the ordinary `impl`-method lookup so
          // it works even when nothing was ever written for it.
          if equals(method, "tag_value") && args.len == 0 {
            let recv_t = self.infer(callee.left, env);
            if self.enum_names.has(self.canonical_type_name(recv_t.name)) {
              ret checked_of(.Num);
            }
          }
          // `.free()` releases what a closure captured.
          if equals(method, "free") {
            let recv_c = self.infer(callee.left, env);
            if recv_c.has_closure_sig {
              if args.len != 0 {
                self.fail("a closure's free() takes no arguments", node);
              }
              ret checked_of(.Void);
            }
          }
          resolved = self.resolve_method_call_with_receiver(callee, env);
        }
      }
      _ -> {}
    }
    if resolved.is_none() {
      // A call written `alias.name(...)` reaches a function in the file
      // that alias stands for, not a method on a value. What the merge
      // produced is one flat program, so the function is here under its
      // own name; only whether the file offers it still has to be said.
      if self.check_alias_qualified_call(node, e, method, env) {
        ret checked_unknown();
      }
      let field_call = self.check_field_function_call(node, e, args, env);
      if field_call.is_some() {
        ret field_call.unwrap();
      }
      self.check_receiver_has_method(node, e, method, env);
      ret checked_unknown();
    }
    MethodResolution found = resolved.unwrap();
    FnSig sig = found.sig;
    self.check_visibility(method, sig.file, sig.is_public, "method", node);
    if sig.is_async && !awaited {
      self.fail(format("call to async method '{str}' needs await", method), node);
      ret checked_unknown();
    }
    // A function-typed parameter naming the enclosing compound's own
    // type param (`Vec<T>.sort_by`'s `T`), not the method's own -
    // `sig.type_params` is empty for a non-generic method like this one.
    // A generic ENUM's own receiver (`Result<T, E>.unwrap`) needs the
    // same lookup against `enum_type_params` instead - `self.compounds`
    // only ever holds compounds, so this used to come back empty for
    // every enum method, silently skipping substitution below for all
    // of them (confirmed directly: `Result<num, str>.unwrap()`'s own
    // return type came back as the literal, unsubstituted `T` with no
    // way to tell it apart from a genuinely unresolved type - the
    // reason a `fit` matching its result against `.Ok`/`.Err` reached
    // codegen instead of getting a real diagnostic).
    Vec<str> receiver_type_params;
    receiver_type_params.init(0);
    // Shallow only: every pushed name below is borrowed straight from
    // the compound's or enum's own declared `type_params`, not a copy
    // of its own.
    defer receiver_type_params.free();
    str receiver_canonical = self.canonical_type_name(found.receiver.name);
    let compound_info = self.compounds.at(receiver_canonical);
    if compound_info.is_some() {
      for p : compound_info.unwrap().type_params {
        receiver_type_params.push(p);
      }
    } else {
      let enum_params = self.enum_type_params.at(receiver_canonical);
      if enum_params.is_some() {
        for p : enum_params.unwrap() {
          receiver_type_params.push(p);
        }
      }
    }
    self.check_arguments(
      node,
      e,
      method,
      sig,
      args,
      env,
      &receiver_type_params,
      &found.receiver.generic_args
    );
    // The method's own declared return type, substituted against the
    // receiver's own concrete generic arguments the same way an
    // argument's own type already is just above. `sig.rtype` itself
    // has nothing left to substitute by the time it gets here - `sig.
    // rtype_template` (the same return type, as declared, from before
    // any erasure ever touched it - see its own field comment) stands
    // in for it. Unconditional, not just for a generic receiver: an
    // ordinary method's own `rtype_template` is already identical to
    // `rtype`, and `substitute` itself is a no-op when there is
    // nothing in `receiver_type_params` to match, so this is exactly
    // `sig.rtype` again in that case. Without this, a generic method's
    // return type reached every caller still erased to Unknown (never
    // even template form), the one case `is_unknown()`'s own "stands
    // for any type" leniency can't tell apart from a genuinely
    // unresolved expression.
    ret substitute(
      sig.rtype_template,
      &receiver_type_params,
      &found.receiver.generic_args
    );
  }

  // A shape-bound alternative's own bare name, with any generic-arg
  // suffix stripped (`Steppable<T>` -> `Steppable`). `shape_implementors`
  // only ever keys on a shape's bare name (real membership is `impl X as
  // Steppable<...> { ... }` having been seen for X at all, not which
  // concrete argument it used), so a bound naming a generic shape's own
  // instantiation - including a self-referential one like `T:
  // Steppable<T>`, where the type param the bound is even ATTACHED to is
  // still the unsubstituted literal "T" here, before any instantiation
  // site has supplied a real type for it - could otherwise never match:
  // `implements_shape` would look up a shape registered under the
  // literal, never-matching string "Steppable<T>" instead of "Steppable".
  _bare_shape_bound_name(str bound) str {
    num lt = index_of_char(bound, '<');
    if lt < 0 {
      ret bound;
    }
    ret substr(bound, 0, lt);
  }

  // Checks the arguments an instantiation supplies against the types its
  // parameters are allowed to stand for.
  check_instantiation(CheckedType t, Node* at) {
    if t.generic_args.len == 0 || equals(t.name, "") {
      ret;
    }
    let info = self.compounds.at(self.canonical_type_name(t.name));
    if info.is_none() {
      ret;
    }
    CompoundInfo holder = info.unwrap();
    if holder.bounds.len == 0 {
      ret;
    }
    num p = 0;
    for p < holder.type_params.len && p < t.generic_args.len {
      str param = holder.type_params.get(p);
      CheckedType supplied = t.generic_args.get(p);
      num at_param = p;
      p = p + 1;
      if is_unknown(supplied) {
        continue;
      }
      str supplied_name = type_name(supplied);
      flag listed = false;
      num b = 0;
      for b < holder.bounds.len {
        Vec<str> combination = holder.bounds.get(b);
        b = b + 1;
        if at_param >= combination.len {
          continue;
        }
        str bound = combination.get(at_param);
        // A bound alternative naming a shape is checked by real
        // membership (a genuine `impl X as shape` block was seen), not
        // name equality - `bound` itself is never resolved against a
        // declared type/shape table until now, so this is the first
        // point either check is even possible. A bound naming a
        // concrete instantiation of a generic shape (`T: To<num>`, or a
        // self-referential one like `T: Steppable<T>`) is handled by
        // `_bare_shape_bound_name` stripping the `<...>` suffix first.
        if equals(bound, supplied_name) ||
          self.implements_shape(
          supplied,
          self.canonical_type_name(self._bare_shape_bound_name(bound))
        ) {
          listed = true;
        }
      }
      // `supplied_name` might not name a concrete type or shape at all,
      // but a type parameter still active in the declaration being
      // checked (e.g. `T` inside the very generic function/impl that
      // declared it) - not yet substituted for a concrete type. In that
      // case, check entailment: if every alternative `T`'s own bound
      // already allows also appears in this bound, `T` is guaranteed to
      // satisfy it no matter what concrete type it's eventually
      // instantiated with, without needing it resolved here first.
      if !listed {
        listed = self.active_type_param_bound_entails(
          supplied_name,
          &holder.bounds,
          at_param
        );
      }
      if !listed {
        self.fail(
          format("'{str}' does not accept {str} for '{str}'", t.name, supplied_name, param),
          at
        );
        ret;
      }
    }
  }

  // Whether `name` is a type parameter active in the declaration being
  // checked whose own declared bound only allows alternatives `target`
  // (at position `at_param`) also allows. `false` for a `name` that
  // isn't an active type parameter, or one with no bound of its own
  // (unconstrained still means "could be anything," not "known to
  // satisfy this").
  active_type_param_bound_entails(str name, Vec<Vec<str>>* target, num at_param) flag {
    num idx = -1;
    num i = 0;
    for i < self.active_type_params.len {
      if equals(self.active_type_params.get(i), name) {
        idx = i;
      }
      i = i + 1;
    }
    if idx < 0 || idx >= self.active_type_param_bounds.len {
      ret false;
    }
    Vec<str> own_allowed = self.active_type_param_bounds.get(idx);
    if own_allowed.len == 0 {
      ret false;
    }
    num o = 0;
    for o < own_allowed.len {
      str own_alt = own_allowed.get(o);
      flag found = false;
      num b = 0;
      for b < target.len {
        Vec<str> combination = target.get(b);
        b = b + 1;
        if at_param >= combination.len {
          continue;
        }
        if equals(combination.get(at_param), own_alt) {
          found = true;
        }
      }
      if !found {
        ret false;
      }
      o = o + 1;
    }
    ret true;
  }

  // Checks the types a call supplies for the callee's type parameters
  // against the types each one is allowed to stand for.
  check_type_bounds(
    Node* node,
    str name,
    FnSig sig,
    Vec<Node*>* args,
    TypeEnv* env,
    ExprNode e
  ) {
    if sig.bounds.len == 0 || sig.type_params.len == 0 {
      ret;
    }
    num p = 0;
    for p < sig.type_params.len {
      str param = sig.type_params.get(p);
      // Each entry names one concrete type per parameter, so what this
      // parameter may stand for is that position across the entries.
      Vec<str> allowed;
      allowed.init(sig.bounds.len);
      defer allowed.free();
      num b = 0;
      for b < sig.bounds.len {
        Vec<str> combination = sig.bounds.get(b);
        b = b + 1;
        if p < combination.len {
          allowed.push(combination.get(p));
        }
      }
      num this_param = p;
      p = p + 1;
      if allowed.len == 0 {
        continue;
      }
      // An explicit call-site type argument at this exact position
      // (`identity<str>(5)`) is checked against the bound directly,
      // regardless of whether any argument also happens to be
      // declared as this bare type param - the only way a type param
      // that's otherwise unreachable from any argument (named only in
      // the return type, or nowhere at all) ever gets its own
      // explicit value validated. The ordinary per-argument check
      // just below (`check_arguments`'s own ordinary assignability
      // loop, substituted against this same explicit value) is what
      // catches the call still disagreeing with what it actually
      // passed (`identity<str>(5)`'s own `5`, an argument), not this
      // function.
      if e.has_generic_args && this_param < e.generic_args.len {
        CheckedType explicit_supplied = checked_from_dtype(e.generic_args.get(this_param));
        str explicit_name = type_name(explicit_supplied);
        flag explicit_listed = false;
        num ea = 0;
        for ea < allowed.len {
          str bound = allowed.get(ea);
          if equals(bound, explicit_name) ||
            self.implements_shape(
            explicit_supplied,
            self.canonical_type_name(self._bare_shape_bound_name(bound))
          ) {
            explicit_listed = true;
          }
          ea = ea + 1;
        }
        if !explicit_listed {
          self.fail(
            format("'{str}' does not accept {str} for '{str}'", name, explicit_name, param),
            node
          );
          ret;
        }
      }
      // The first argument written as this parameter is what it stands
      // for at this call.
      num i = 0;
      for i < args.len && i < sig.arg_params.len {
        str written = sig.arg_params.get(i);
        num at = i;
        i = i + 1;
        if !equals(written, param) {
          continue;
        }
        CheckedType supplied = self.infer(args.get(at), env);
        if is_unknown(supplied) {
          break;
        }
        str supplied_name = type_name(supplied);
        flag listed = false;
        num a = 0;
        for a < allowed.len {
          str bound = allowed.get(a);
          // See the matching comment in `check_instantiation`: a shape
          // bound is checked by real membership, not name equality,
          // with any generic-arg suffix on the bound itself stripped
          // first.
          if equals(bound, supplied_name) ||
            self.implements_shape(
            supplied,
            self.canonical_type_name(self._bare_shape_bound_name(bound))
          ) {
            listed = true;
          }
          a = a + 1;
        }
        if !listed {
          self.fail(
            format("'{str}' does not accept {str} for '{str}'", name, supplied_name, param),
            node
          );
          ret;
        }
        break;
      }
    }
  }

  // The concrete type each of `sig`'s own type params stands for at
  // this call, inferred from the arguments the same way `check_type_
  // bounds` already does for bound-checking: the first argument
  // written as a given parameter is what it stands for. One entry per
  // `sig.type_params`, in the same order - `substitute`'s own
  // contract - `checked_unknown()` for any param no argument's own
  // declared type ever named (an unconstrained, genuinely
  // unresolvable position, the same ceiling every other best-effort
  // inference in this file already accepts).
  _infer_call_generic_args(FnSig sig, Vec<Node*>* args, TypeEnv* env) Vec<CheckedType> {
    Vec<CheckedType> out;
    out.init(sig.type_params.len);
    num p = 0;
    for p < sig.type_params.len {
      str param = sig.type_params.get(p);
      p = p + 1;
      CheckedType resolved = checked_unknown();
      num i = 0;
      for i < args.len && i < sig.arg_params.len {
        str written = sig.arg_params.get(i);
        num at = i;
        i = i + 1;
        if !equals(written, param) {
          continue;
        }
        resolved = self.infer(args.get(at), env);
        break;
      }
      out.push(resolved);
    }
    ret out;
  }

  // Judges `alias.name(...)`, where `alias` names an imported file
  // rather than a value. True when it was one, whether or not anything
  // was reported: either way it is not a method call.
  //
  // Only a name that resolves to nothing else is read this way, so a
  // receiver whose type the checker does not model is left to the method
  // path rather than being mistaken for an alias.
  check_alias_qualified_call(Node* node, ExprNode e, str method, TypeEnv* env) flag {
    if equals(method, "") || !e.has_left {
      ret false;
    }
    str alias = "";
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") || !callee.has_left || callee.left == nil {
          ret false;
        }
        fit callee.left.kind {
          .Identifier(name) -> { alias = name; }
          _ -> {}
        }
      }
      _ -> {}
    }
    if equals(alias, "") {
      ret false;
    }
    // A value of that name, or a type of that name, means this is not an
    // alias at all.
    if env.lookup(alias).is_some() || self.compounds.at(alias).is_some() ||
      self.shapes.has(alias) || self.plain_enums.has(alias) {
      ret false;
    }
    // `alias` must have actually been declared with `use X as alias;`
    // - without this, any bare name that collides with no local/type
    // read as a valid module qualifier the instant a method of that
    // exact name existed anywhere in the whole merged program, even
    // for a module imported with no alias at all (`use lib2;`, whose
    // own exports reach this file under their bare names directly,
    // never through a `lib2.` qualifier - confirmed directly:
    // `lib2.twice(5)` crashed codegen with no real diagnostic, since
    // typecheck wrongly accepted it as alias-qualified here).
    if !self.declared_import_aliases.has(alias) {
      ret false;
    }
    let known = self.fns.at(method);
    if known.is_none() {
      ret false;
    }
    FnSig sig = known.unwrap();
    if sig.ambiguous {
      ret true;
    }
    self.check_visibility(method, sig.file, sig.is_public, "function", node);
    ret true;
  }

  // `receiver.field(args)` when `field` names no method but IS a real
  // field of the receiver's own type whose declared type is itself a
  // function value (`fun(T1, T2) R`, docs/language.md's own "Function
  // values" section) - `resolve_method_call_with_receiver` only ever
  // looks for a real method, so this call shape fell straight through
  // to `check_receiver_has_method`'s "has no method" error otherwise,
  // even though reading the field directly and calling it (`let f =
  // o.op; f(6, 7);`) already worked fine. Checks arguments against the
  // field's own declared signature the same way a function-typed
  // local already does (see the plain-call path's own identical
  // `callee.has_fn_sig` branch). `.None` - not a real field at all, or
  // one whose type isn't a function value - leaves the call for the
  // ordinary "no method" diagnostic to report instead. A generic
  // compound's own field substitution isn't handled here; left to
  // that same fallback too, same as every other unhandled shape in
  // this file already is, rather than risking a wrong but silent
  // answer.
  check_field_function_call(Node* node, ExprNode e, Vec<Node*>* args, TypeEnv* env) Option<CheckedType> {
    if !e.has_left {
      ret .None;
    }
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") || !callee.has_left || !callee.has_right {
          ret .None;
        }
        CheckedType receiver = self.infer(callee.left, env);
        if equals(receiver.name, "") {
          ret .None;
        }
        let info = self.compounds.at(self.canonical_type_name(receiver.name));
        if info.is_none() || info.unwrap().is_generic {
          ret .None;
        }
        str field = _callee_name(callee.right);
        if equals(field, "") {
          ret .None;
        }
        let found = info.unwrap().fields.at(field);
        if found.is_none() ||
          (!found.unwrap().has_fn_sig && !found.unwrap().has_closure_sig) {
          ret .None;
        }
        CheckedType ft = found.unwrap();
        ret .Some(
          self.check_fn_value_call(
          node,
          format("'{str}'", field),
          ft.has_fn_sig ? ft.fn_sig : ft.closure_sig,
          args,
          env
          )
        );
      }
      _ -> {}
    }
    ret .None;
  }

  // Reports a method called on a value whose type declares none. Only a
  // receiver the checker resolved completely is judged, so an unmodelled
  // one is left alone.
  check_receiver_has_method(Node* node, ExprNode e, str method, TypeEnv* env) {
    if equals(method, "") || !e.has_left {
      ret;
    }
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") || !callee.has_left {
          ret;
        }
        // A receiver written as a bare name that resolves to nothing
        // at all - not a local, a const, a type, or a still-abstract
        // type param - is a plain typo or undeclared reference, not a
        // type the checker merely failed to model. Checked here,
        // before `infer()` folds it into the same Unknown-with-empty-
        // name shape a legitimately-unresolvable type gets, which this
        // function's own silence-on-Unknown rule below would otherwise
        // never catch: left unchecked, `nonexistent_thing.foo(5)`
        // passed typecheck outright and crashed codegen instead of a
        // real diagnostic. `check_alias_qualified_call` already ran
        // and failed by the time this is reached, so a real module
        // alias is already ruled out.
        fit callee.left.kind {
          .Identifier(bare_name) -> {
            if env.lookup(bare_name).is_none() &&
              self.compounds.at(bare_name).is_none() &&
              !self.shapes.has(bare_name) &&
              !self.plain_enums.has(bare_name) &&
              !self.enum_names.has(bare_name) &&
              !self.active_type_params.contains(bare_name) {
              self.fail(format("undeclared identifier '{str}'", bare_name), node);
              ret;
            }
          }
          _ -> {}
        }
        CheckedType receiver = self.infer(callee.left, env);
        // A method call through a single pointer reaches the pointee, so
        // that is what must have the method. A deeper pointer or an
        // array is not a receiver at all.
        if receiver.pointer_depth == 1 && !receiver.is_array && receiver.base != .Str {
          receiver.pointer_depth = 0;
        }
        if receiver.pointer_depth > 0 || receiver.is_array {
          ret;
        }
        if self.receiver_method(receiver, method).is_some() {
          ret;
        }
        // A builtin declares no methods at all, so any call through one
        // is wrong. A named type is only judged once its methods are
        // known: seeing an impl for it is what says they are, and a type
        // whose impls the checker never saw is left alone rather than
        // reported on a guess.
        if receiver.base == .Unknown && !self.knows_methods_of(receiver) {
          ret;
        }
        self.fail(
          format("{str} has no method '{str}'", type_name(receiver), method),
          node
        );
      }
      _ -> {}
    }
  }

  // Whether the top-level function `got` (already resolved from `self.fns`)
  // can stand in for a `fun(T1, T2) R`-typed parameter declared as
  // `want`: same arity, and every parameter/return type assignable the
  // same way an ordinary argument is. `want`'s own parameter/return
  // types are written `DataType`s, converted through `checked_from_dtype`
  // to compare against `got`'s already-checked ones; `type_params`/
  // `generic_args` substitute a generic method's own type parameter
  // (`Vec<T>.sort_by`'s `T`) with the receiver's real one (`Vec<num>`'s
  // `num`) before either side is compared, since `want` is written
  // against the unsubstituted template.
  _fn_sig_matches(
    FnTypeSig* want,
    FnSig got,
    Vec<str>* type_params,
    Vec<CheckedType>* generic_args
  ) flag {
    if got.is_variadic || want.params.len != got.args.len {
      ret false;
    }
    num i = 0;
    for i < want.params.len {
      let want_param = substitute(
        checked_from_dtype(want.params.get(i)),
        type_params,
        generic_args
      );
      if !self.assignable(want_param, got.args.get(i)) {
        ret false;
      }
      i = i + 1;
    }
    let want_rtype = substitute(checked_from_dtype(want.rtype), type_params, generic_args);
    ret self.assignable(want_rtype, got.rtype);
  }

  // Whether `from`, a closure, a function value, or a named function,
  // takes and returns what `want` says. Anything else that could still be
  // one (an unknown value) is let through.
  _fits_signature(FnTypeSig* want, CheckedType from) flag {
    if from.has_closure_sig && from.closure_sig != nil {
      ret self._fn_types_match(want, from.closure_sig);
    }
    if from.has_fn_sig && from.fn_sig != nil {
      ret self._fn_types_match(want, from.fn_sig);
    }
    if !equals(from.function_name, "") {
      let known = self.fns.at(from.function_name);
      if known.is_some() && !known.unwrap().ambiguous {
        Vec<str> no_params;
        no_params.init(0);
        defer no_params.free();
        Vec<CheckedType> no_args;
        no_args.init(0);
        defer no_args.free();
        ret self._fn_sig_matches(want, known.unwrap(), &no_params, &no_args);
      }
    }
    ret is_unknown(from);
  }

  // Whether a value of function type `from` can be stored where `to` is
  // expected: the same number of parameters, each one and the return
  // type matching.
  _fn_types_match(FnTypeSig* to, FnTypeSig* from) flag {
    if to.params.len != from.params.len {
      ret false;
    }
    num i = 0;
    for i < to.params.len {
      if !self.assignable(
        checked_from_dtype(to.params.get(i)),
        checked_from_dtype(from.params.get(i))
      ) {
        ret false;
      }
      i = i + 1;
    }
    ret self.assignable(checked_from_dtype(to.rtype), checked_from_dtype(from.rtype));
  }

  // Checks every function-typed parameter's own argument (a bare name,
  // `list.sort_by(my_cmp)`) against its declared signature, rather than
  // letting an unresolved identifier degrade to unknown. True (and
  // reports) on the first mismatch found, so the caller can stop.
  check_fn_sig_args(
    Node* node,
    str name,
    FnSig sig,
    Vec<Node*>* args,
    Vec<str>* type_params,
    Vec<CheckedType>* generic_args
  ) flag {
    num i = 0;
    for i < args.len && i < sig.args.len {
      CheckedType want = sig.args.get(i);
      i = i + 1;
      if !want.has_fn_sig && !want.has_closure_sig {
        continue;
      }
      FnTypeSig* want_sig = want.has_fn_sig ? want.fn_sig : want.closure_sig;
      fit args.get(i - 1).kind {
        .Identifier(fname) -> {
          let known = self.fns.at(fname);
          if known.is_some() &&
            !self._fn_sig_matches(
            want_sig,
            known.unwrap(),
            type_params,
            generic_args
          ) {
            self.fail(
              format(
              "argument {num} of '{str}': '{str}' does not match the expected signature",
              i,
              name,
              fname
              ),
              args.get(i - 1)
            );
            ret true;
          }
        }
        _ -> {}
      }
    }
    ret false;
  }

  // Checks the arguments of a call against what the callee declares. A
  // generic callee's own bare type-param positions stand for whatever
  // the call supplies (checked instead by `check_type_bounds`), but a
  // parameter whose declared type nests the type param inside a real
  // declared type - a shape, or a generic compound - is still checked
  // structurally, the same way a non-generic callee's argument is.
  check_arguments(
    Node* node,
    ExprNode e,
    str name,
    FnSig sig,
    Vec<Node*>* args,
    TypeEnv* env,
    Vec<str>* type_params,
    Vec<CheckedType>* generic_args
  ) {
    if !sig.is_variadic {
      if args.len > sig.args.len {
        self.fail(format("too many arguments to '{str}'", name), node);
        ret;
      }
      if args.len < sig.min_args {
        self.fail(format("too few arguments to '{str}'", name), node);
        ret;
      }
    }
    // Checked ahead of the generic/plain split below, since a generic
    // callee's OWN type-param bounds are checked instead of its
    // ordinary argument types (see check_type_bounds), but a
    // function-typed parameter's declared signature isn't a type-param
    // bound at all - `Vec<T>.sort_by(cmp)`'s `cmp` needs this checked
    // regardless of `sort_by` being generic in `T`.
    if self.check_fn_sig_args(node, name, sig, args, type_params, generic_args) {
      ret;
    }
    if sig.is_generic {
      self.check_type_bounds(node, name, sig, args, env, e);
      if self.failed {
        ret;
      }
    }
    // An explicit call-site type argument (`identity<str>(5)`) for one
    // of the callee's OWN declared type params (never the receiver's -
    // a method call's own receiver generics come from `found.receiver.
    // generic_args` above, already resolved by then), one entry per
    // `sig.type_params`, `checked_unknown()` for any position nothing
    // was written for - `substitute` already treats that as "stands
    // for whatever's supplied", the exact permissive behavior this had
    // before any explicit argument existed at all. Without this, a
    // generic callee's own bare-type-param-shaped parameter (`T x`)
    // matched any argument unconditionally (see the comment on `want`
    // below), so `identity<str>(5)` passed typecheck outright instead
    // of rejecting the mismatch between what was written and what was
    // actually passed.
    Vec<CheckedType> explicit_as_checked;
    explicit_as_checked.init(sig.type_params.len);
    num exi = 0;
    for exi < sig.type_params.len {
      if e.has_generic_args && exi < e.generic_args.len {
        explicit_as_checked.push(checked_from_dtype(e.generic_args.get(exi)));
      } else {
        explicit_as_checked.push(checked_unknown());
      }
      exi = exi + 1;
    }
    defer explicit_as_checked.free();
    num i = 0;
    for i < args.len && i < sig.args.len {
      CheckedType want = substitute(
        sig.args.get(i),
        &sig.type_params,
        &explicit_as_checked
      );
      // A bare top-level type-param argument (`T x`) is erased to a
      // nameless Unknown by the time it reaches `sig.args` (`_erase_
      // type_params`'s own doc comment: only a bare occurrence, never
      // one nested further in, like a `Vec<T> items` above, which
      // keeps its own name and so is already handled by `substitute`
      // above) - `substitute`'s own name-matching can never catch a
      // bare one, since there's no name left to match against.
      // `sig.arg_params` records which type param each argument
      // position was declared as separately, exactly for this.
      if i < sig.arg_params.len && !equals(sig.arg_params.get(i), "") {
        num api = 0;
        for api < sig.type_params.len {
          if equals(sig.type_params.get(api), sig.arg_params.get(i)) {
            CheckedType explicit_want = explicit_as_checked.get(api);
            if !is_unknown(explicit_want) {
              explicit_want.pointer_depth = explicit_want.pointer_depth + want.pointer_depth;
              if want.is_array {
                explicit_want.is_array = true;
                explicit_want.array_depth = explicit_want.array_depth + want.array_depth;
              }
              want = explicit_want;
            }
            break;
          }
          api = api + 1;
        }
      }
      if want.has_fn_sig {
        i = i + 1;
        continue;
      }
      CheckedType got = self.infer(args.get(i), env);
      self.check_shorthand_variant(args.get(i), want, env);
      if self.failed {
        ret;
      }
      // For a generic callee, `want` itself may still be the bare,
      // unsubstituted type parameter (`T x`) - `assignable` already
      // treats that as "stands for whatever's supplied" via
      // `names_a_declared_type`, so only a `want` naming a real
      // declared type (a shape, or a generic compound like `Box<T>`
      // with the type param nested inside its own generic args) is
      // actually constrained here; bound checking on the type param
      // itself already happened above via `check_type_bounds`.
      if !self.assignable(want, got) {
        self.fail(
          format(
          "argument {num} of '{str}' expects {str}, found {str}",
          i + 1,
          name,
          type_name(want),
          type_name(got)
          ),
          args.get(i)
        );
        ret;
      }
      i = i + 1;
    }
    num fmt_index = _format_fmt_arg_index(name);
    if fmt_index >= 0 && fmt_index < args.len {
      self.check_format_args(node, name, args, fmt_index, _is_c_style_format(name), env);
    }
  }

  // Cross-checks a format-like variadic call's own trailing arguments
  // against what its format string names, once the fixed leading
  // arguments (a stream, a destination buffer, ...) have already
  // passed the ordinary check above. Silently skips the check (never
  // a false positive) when the format string isn't a literal - the
  // usual convention every real printf-checker follows, since a
  // format built at runtime can't be reasoned about here - or when
  // the C-style parser meets a spec it doesn't confidently recognize.
  check_format_args(
    Node* node,
    str name,
    Vec<Node*>* args,
    num fmt_index,
    flag c_style,
    TypeEnv* env
  ) {
    Node* fmt_node = args.get(fmt_index);
    str fmt_text = "";
    flag is_literal = false;
    fit fmt_node.kind {
      .String(s) -> {
        fmt_text = s;
        is_literal = true;
      }
      _ -> {}
    }
    if !is_literal {
      ret;
    }
    Vec<str> expected;
    if c_style {
      let parsed = _c_format_specs(fmt_text);
      if parsed.is_none() {
        ret;
      }
      expected = parsed.unwrap();
    } else {
      expected = _fun_format_specs(fmt_text);
    }
    defer expected.free();

    num variadic_start = fmt_index + 1;
    num given = args.len - variadic_start;
    if given != expected.len {
      str which = "too many";
      if given < expected.len {
        which = "too few";
      }
      self.fail(
        format(
        "{str} arguments to '{str}': its own format string names {num}, {num} given",
        which,
        name,
        expected.len,
        given
        ),
        node
      );
      ret;
    }
    num k = 0;
    for k < expected.len {
      str want_name = expected.get(k);
      Node* arg_node = args.get(variadic_start + k);
      num arg_position = variadic_start + k + 1;
      k = k + 1;
      if equals(want_name, "") {
        continue;
      }
      CheckedType got = self.infer(arg_node, env);
      if equals(want_name, "ptr") || equals(want_name, "raw") {
        if got.pointer_depth == 0 && got.base != .Raw {
          self.fail(
            format(
            "argument {num} of '{str}' expects a pointer, found {str}",
            arg_position,
            name,
            type_name(got)
            ),
            arg_node
          );
          ret;
        }
        continue;
      }
      // A C-style `%d`/`%x`/... conversion is written for any
      // integral value in ordinary C code, `flag` included (`0`/`1`,
      // as idiomatic there as it is unusual in Fun's own type
      // discipline) - widened here, and only here: `{num}`, Fun's
      // own explicit placeholder spelling, still means exactly num.
      if c_style && equals(want_name, "num") && got.base == .Bin {
        continue;
      }
      CheckedType want = checked_of(_data_type_for(want_name));
      if !self.assignable(want, got) {
        self.fail(
          format(
          "argument {num} of '{str}' expects {str} (from its own format string), found {str}",
          arg_position,
          name,
          want_name,
          type_name(got)
          ),
          arg_node
        );
        ret;
      }
    }
  }

  // Checks `await operand`: only an async function may await, and only
  // an async call is worth awaiting.
  check_await(UnaryNode u, TypeEnv* env) CheckedType {
    if !self.in_async {
      self.fail("await is only allowed in an async function", u.operand);
      ret checked_unknown();
    }
    if !self.awaits_async_call(u.operand, env) {
      self.fail("await expects a call to an async function", u.operand);
      ret checked_unknown();
    }
    ret self.infer_awaited(u.operand, env);
  }

  // The type an awaited call produces, checked as an ordinary call.
  infer_awaited(Node* operand, TypeEnv* env) CheckedType {
    if operand == nil {
      ret checked_unknown();
    }
    fit operand.kind {
      .Expression(e) -> {
        if equals(e.op, "()") {
          ret self.check_call(operand, e, env, true);
        }
      }
      .ExpressionParenthesis(inner) -> { ret self.infer_awaited(inner, env); }
      _ -> {}
    }
    ret self.infer(operand, env);
  }

  // True when `node` calls something the checker knows to be async, or
  // something it cannot resolve, which it does not second-guess.
  awaits_async_call(Node* node, TypeEnv* env) flag {
    if node == nil {
      ret false;
    }
    fit node.kind {
      .ExpressionParenthesis(inner) -> { ret self.awaits_async_call(inner, env); }
      .Expression(e) -> {
        if !equals(e.op, "()") {
          ret false;
        }
        if !e.has_left {
          ret true;
        }
        str name = _callee_name(e.left);
        if equals(name, "") {
          ret self.awaits_async_method(e, env);
        }
        let known = self.fns.at(name);
        if known.is_none() {
          ret true;
        }
        FnSig sig = known.unwrap();
        if sig.ambiguous {
          ret true;
        }
        ret sig.is_async;
      }
      _ -> { ret false; }
    }
    ret false;
  }

  // Checks a call against the callee's signature and reports its return
  // type.
  // `value as T`: a numeric value converts to any numeric type (or a plain
  // enum, and back), a pointer to any other pointer, and a pointer and an
  // integer into each other. Anything else (a compound, a data enum, a
  // float address) is rejected.
  check_as_conversion(Node* node, ExprNode e, Vec<Node*> args, TypeEnv* env) CheckedType {
    CheckedType want = checked_from_dtype(e.generic_args.get(0));
    if args.len != 1 {
      self.fail("'as' converts exactly one value", node);
      ret want;
    }
    CheckedType got = self.infer(args.get(0), env);
    if self.failed || got.base == .Unknown && equals(got.name, "") {
      ret want;
    }
    flag got_ptr = _is_pointer_like(got);
    flag want_ptr = _is_pointer_like(want);
    flag got_int = !got_ptr && !got.is_array &&
      (got.base == .Num || got.base == .Chr || got.base == .Bin);
    flag want_int = !want_ptr && !want.is_array &&
      (want.base == .Num || want.base == .Chr || want.base == .Bin);
    flag got_num = got_int || !got_ptr && !got.is_array && got.base == .Dec;
    flag want_num = want_int || !want_ptr && !want.is_array && want.base == .Dec;
    flag got_enum = !got_ptr && self.plain_enums.has(got.name);
    flag want_enum = !want_ptr && self.plain_enums.has(want.name);
    flag ok = got_num && want_num || got_ptr && want_ptr || got_ptr && want_int ||
    got_int && want_ptr || got_enum && want_int || got_int && want_enum ||
    got_enum && want_enum || self.assignable(want, got);
    if !ok {
      self.fail(
        format(
        "cannot convert {str} to {str} with 'as'",
        type_name(got),
        type_name(want)
        ),
        node
      );
    }
    ret want;
  }

  // Fails, and returns true, when `value` is an integer literal that
  // doesn't fit `want`'s own fixed width (`u8 b = 300;`). Use `as` to
  // wrap one on purpose.
  literal_out_of_range(CheckedType want, Node* value, Node* at) flag {
    if want.base != .Num || want.pointer_depth > 0 || want.is_array ||
      equals(want.width, "") {
      ret false;
    }
    let lit = _integer_literal_value(value);
    if lit.is_none() {
      ret false;
    }
    let bits = _fixed_width_bits(want.width);
    if bits.is_none() || bits.unwrap() > 63 {
      ret false;
    }
    num width_bits = bits.unwrap();
    flag is_unsigned = want.width[0] == 'u';
    num lo = 0;
    num hi = 0;
    if is_unsigned {
      hi = (1 << width_bits) - 1;
    } else {
      hi = (1 << (width_bits - 1)) - 1;
      lo = -hi - 1;
    }
    num n = lit.unwrap();
    if n >= lo && n <= hi {
      ret false;
    }
    self.fail(
      format(
      "{num} doesn't fit in {str} ({num} to {num}); write `{num} as {str}` to wrap it on purpose",
      n,
      want.width,
      lo,
      hi,
      n,
      want.width
      ),
      at
    );
    ret true;
  }

  // Checks a call through a function value against its own signature:
  // `label` names the callee in diagnostics (`'cb'`, or a description
  // when it is an expression such as `handlers[v]`).
  check_fn_value_call(
    Node* node,
    str label,
    FnTypeSig* fsig,
    Vec<Node*>* args,
    TypeEnv* env
  ) CheckedType {
    if args.len != fsig.params.len {
      self.fail(
        format(
        "{str} expects {num} {str}, got {num}",
        label,
        fsig.params.len,
        fsig.params.len == 1 ? "argument" : "arguments",
        args.len
        ),
        node
      );
      ret checked_unknown();
    }
    num ci = 0;
    for ci < fsig.params.len {
      let want = checked_from_dtype(fsig.params.get(ci));
      let got = self.infer(args.get(ci), env);
      self.check_shorthand_variant(args.get(ci), want, env);
      if self.failed {
        ret checked_unknown();
      }
      if !self.assignable(want, got) {
        self.fail(
          format(
          "argument {num} of {str} expects {str}, found {str}",
          ci + 1,
          label,
          type_name(want),
          type_name(got)
          ),
          args.get(ci)
        );
        ret checked_unknown();
      }
      ci = ci + 1;
    }
    ret checked_from_dtype(fsig.rtype);
  }

  check_call(Node* node, ExprNode e, TypeEnv* env, flag awaited) CheckedType {
    Vec<Node*> args;
    args.init(4);
    defer args.free();
    if e.has_right {
      _call_args(e.right, &args);
    }

    num i = 0;
    for i < args.len {
      _ = self.infer(args.get(i), env);
      i = i + 1;
    }

    str name = "";
    if e.has_left {
      name = _callee_name(e.left);
    }
    if equals(name, "") {
      // A function value read out of an array or returned by a call
      // (`handlers[v](frame)`, `pick()(x)`).
      if e.has_left && !_is_member_callee(e.left) {
        let callee_t = self.infer(e.left, env);
        if self.failed {
          ret checked_unknown();
        }
        if callee_t.has_fn_sig || callee_t.has_closure_sig {
          ret self.check_fn_value_call(
            node,
            callee_t.has_fn_sig ? "this function value" : "this closure",
            callee_t.has_fn_sig ? callee_t.fn_sig : callee_t.closure_sig,
            &args,
            env
          );
        }
      }
      self.check_qualified_variant_call(node, e, &args, env);
      if self.failed {
        ret checked_unknown();
      }
      ret self.check_method_call(node, e, &args, env, awaited);
    }
    if _is_builtin_call(name) {
      if equals(name, "sizeof") {
        if args.len != 1 || !self._sizeof_names_a_type(args.get(0)) {
          self.fail("sizeof measures a type", node);
          ret checked_of(.Num);
        }
        self.check_sizeof_operand(node, args.get(0));
        ret checked_of(.Num);
      }
      // `std.map`'s own key hashing/equality, lowered per key type by
      // codegen - never declared anywhere a call could resolve against.
      if equals(name, "__fun_key_hash") {
        ret checked_of(.Num);
      }
      if equals(name, "__fun_key_eq") {
        ret checked_of(.Bin);
      }
      if equals(name, "__fun_as") {
        ret self.check_as_conversion(node, e, args, env);
      }
      ret checked_unknown();
    }
    // A local closure or function value shadows a function of the same
    // name, the way any local shadows what's declared outside it.
    let shadowing = env.lookup(name);
    if shadowing.is_some() &&
      (shadowing.unwrap().has_closure_sig || shadowing.unwrap().has_fn_sig) {
      CheckedType local_callee = shadowing.unwrap();
      ret self.check_fn_value_call(
        node,
        format("'{str}'", name),
        local_callee.has_closure_sig ? local_callee.closure_sig : local_callee.fn_sig,
        &args,
        env
      );
    }
    let known = self.fns.at(name);
    if known.is_none() {
      // A name bound in scope holds a function rather than naming one -
      // a function-typed parameter, most commonly. Its own declared
      // signature is checked the same way a real function's would be.
      let local = env.lookup(name);
      if local.is_none() {
        self.fail(format("no function named '{str}'", name), node);
        ret checked_unknown();
      }
      let callee = local.unwrap();
      if callee.has_closure_sig {
        ret self.check_fn_value_call(
          node,
          format("'{str}'", name),
          callee.closure_sig,
          &args,
          env
        );
      }
      if !callee.has_fn_sig {
        ret checked_unknown();
      }
      ret self.check_fn_value_call(
        node,
        format("'{str}'", name),
        callee.fn_sig,
        &args,
        env
      );
    }
    FnSig sig = known.unwrap();
    if sig.ambiguous {
      ret checked_unknown();
    }
    // A new thread may run long after this function returns, so it can't
    // take a closure pointing at this function's locals.
    if (equals(name, "spawn") || equals(name, "spawn_value")) &&
      ends_with(sig.file, "thread_spawn.fn") &&
      args.len == 1 && self.infer(args.get(0), env).holds_refs {
      self.fail(
        format(
        "'{str}' can't take a closure capturing a local by reference; the thread may outlive it",
        name
        ),
        node
      );
      ret checked_unknown();
    }
    self.check_visibility(name, sig.file, sig.is_public, "function", node);
    if self.failed {
      ret checked_unknown();
    }
    // An async call produces its value only once awaited.
    if sig.is_async && !awaited {
      self.fail(format("call to async function '{str}' needs await", name), node);
      ret checked_unknown();
    }
    Vec<CheckedType> no_generic_args;
    no_generic_args.init(0);
    self.check_arguments(
      node,
      e,
      name,
      sig,
      &args,
      env,
      &sig.type_params,
      &no_generic_args
    );
    if !sig.is_generic {
      ret sig.rtype;
    }
    // `sig.rtype` itself is `wrap<T>(T v) MyOpt<T>`'s own return type
    // with `T` already erased to a nameless Unknown by `_signature_of`
    // (every generic function's own type params are, regardless of
    // whether this call even resolves them) - substituted back in
    // below, the same way `check_arguments`' own ordinary argument
    // check already substitutes an explicit value into `want` - or a
    // generic function's own call-site result reached every caller
    // still Unknown, confirmed directly as the reason `wrap(5).unwrap()`
    // (chaining a method call onto a generic function's own result)
    // reached codegen with no real type to work with. Inferred the
    // same way `check_type_bounds` already does: the first argument
    // written as a given type param is what it stands for at this
    // call, UNLESS an explicit `<...>` was supplied at that position,
    // which wins outright - the whole reason writing one exists at
    // all, the one case this is for being a type param no argument
    // (or the return type) ever names at all.
    Vec<CheckedType> inferred_args = self._infer_call_generic_args(sig, &args, env);
    defer inferred_args.free();
    num exp_i = 0;
    for exp_i < sig.type_params.len {
      if e.has_generic_args && exp_i < e.generic_args.len {
        inferred_args.set(exp_i, checked_from_dtype(e.generic_args.get(exp_i)));
      }
      exp_i = exp_i + 1;
    }
    // A type param this call could never infer from anything - no
    // bare argument written as it, nothing nested inside any
    // argument's own declared type, no mention in the return type
    // either, and no explicit `<...>` supplied at the call site - is
    // not a type the checker merely failed to model; it is dead,
    // unreachable from this call under any circumstance. Left
    // unchecked, `make_zero<T>(num count) num` (T named nowhere at
    // all) passed typecheck outright, and codegen's own, separately-
    // written inference (which this mirrors) silently gave up and
    // fell back to the bare, unmangled name - a real function this
    // genuinely is not, since it was declared with its own `<T>`.
    num tpi = 0;
    for tpi < sig.type_params.len {
      if !is_unknown(inferred_args.get(tpi)) {
        tpi = tpi + 1;
        continue;
      }
      if e.has_generic_args && tpi < e.generic_args.len {
        tpi = tpi + 1;
        continue;
      }
      // Neither inferred from an argument nor named explicitly at
      // this position - but `wrap<T, E = Error>(T v) T` called as
      // `wrap<num>(5)` leaves `E` out on purpose, relying on its own
      // declared default the same way a trailing parameter with a
      // default may be left off a call's own argument list. Resolved
      // here, not just excused from the "unreachable" error below: an
      // unresolved default would still leave `inferred_args` Unknown
      // for this position, corrupting `substitute`'s own return-type
      // substitution two lines down the exact same way an unresolved
      // explicit argument used to.
      if tpi < sig.type_param_defaults.len &&
        !is_unknown(sig.type_param_defaults.get(tpi)) {
        inferred_args.set(tpi, sig.type_param_defaults.get(tpi));
        tpi = tpi + 1;
        continue;
      }
      str tp = sig.type_params.get(tpi);
      flag reachable = _checked_type_references_param(sig.rtype_template, tp);
      num ai = 0;
      for !reachable && ai < sig.args.len {
        if _checked_type_references_param(sig.args.get(ai), tp) {
          reachable = true;
        }
        ai = ai + 1;
      }
      if !reachable {
        self.fail(
          format(
          "cannot infer type parameter '{str}' for this call to '{str}' - pass it explicitly ('{str}<...>(...)')",
          tp,
          name,
          name
          ),
          node
        );
        ret checked_unknown();
      }
      tpi = tpi + 1;
    }
    ret substitute(sig.rtype_template, &sig.type_params, &inferred_args);
  }
}

// True when `t`, or anything nested inside it, names `param` -
// `_erase_type_params` only erases a bare top-level occurrence
// (`T x`), never one nested further in (`Vec<T> items`), so `t`'s own
// structural `generic_args`/`tuple_members` still carry a nested
// occurrence intact even after a signature's own params go through
// it. Used to tell "this type param genuinely cannot be inferred
// from anything" apart from "it can, just not by this call's own
// narrow bare-argument check" - the two read identically as far as
// `_infer_call_generic_args` alone can tell.
fun _checked_type_references_param(CheckedType t, str param) flag {
  if t.is_tuple {
    for m : t.tuple_members {
      if _checked_type_references_param(m, param) {
        ret true;
      }
    }
    ret false;
  }
  if equals(t.name, param) {
    ret true;
  }
  for a : t.generic_args {
    if _checked_type_references_param(a, param) {
      ret true;
    }
  }
  ret false;
}

// The type an operator sees for `operand`. Inside a method `self` is a
// pointer to the receiver, but `self * other` means the receiver's own
// operator, so `self` reads as its pointee unless the other side is a
// different pointer (`self == p` still compares addresses).
fun operator_operand_type(
  Node* operand,
  CheckedType t,
  Node* other_node,
  CheckedType other
) CheckedType {
  if t.pointer_depth != 1 || !is_self_identifier(operand) {
    ret t;
  }
  if !is_self_identifier(other_node) &&
    (other.pointer_depth != 0 || other.is_array || other.is_null_literal ||
    other.base == .Raw || is_unknown(other)) {
    ret t;
  }
  CheckedType v = t;
  v.pointer_depth = 0;
  ret v;
}

// True when `n` is the bare identifier `self`.
pub fun is_self_identifier(Node* n) flag {
  if n == nil {
    ret false;
  }
  fit n.kind {
    .Identifier(name) -> { ret equals(name, "self"); }
    _ -> { ret false; }
  }
}

// True when some subtree of `n` reads the identifier `self` - used to
// reject it inside a parameter's own default-value expression (see
// `check_function_with_self`'s own caller for why). Walks only the
// node kinds an expression can actually be built from; a statement or
// declaration never appears inside one, so those kinds need no case.
fun _references_self(Node* n) flag {
  if n == nil {
    ret false;
  }
  fit n.kind {
    .Identifier(name) -> { ret equals(name, "self"); }
    .Expression(e) -> {
      if e.has_left && _references_self(e.left) {
        ret true;
      }
      ret e.has_right && _references_self(e.right);
    }
    .ExpressionParenthesis(inner) -> { ret _references_self(inner); }
    .Unary(u) -> {
      if _references_self(u.operand) {
        ret true;
      }
      ret u.has_error_arg && _references_self(u.error_arg);
    }
    .Ternary(t) -> {
      ret _references_self(t.cond) || _references_self(t.then_val) ||
        _references_self(t.else_val);
    }
    .Bracket(inner) -> { ret _references_self(inner); }
    .CompoundInit(c) -> {
      for f : c.fields {
        if _references_self(f.value) {
          ret true;
        }
      }
      ret false;
    }
    .TupleLiteral(t) -> {
      for el : t.elements {
        if _references_self(el) {
          ret true;
        }
      }
      ret false;
    }
    .Panic(inner) -> { ret _references_self(inner); }
    _ -> { ret false; }
  }
}

// True for `=` and the operators that read and write in one step.
fun _is_assignment(str op) flag {
  if equals(op, "=") {
    ret true;
  }
  if len(op) < 2 || op[len(op) - 1] != '=' {
    ret false;
  }
  str head = substr(op, 0, len(op) - 1);
  flag matched = equals(head, "+") || equals(head, "-") || equals(head, "*") ||
    equals(head, "/") || equals(head, "%") || equals(head, "&") || equals(head, "|") ||
    equals(head, "^") || equals(head, "<<") || equals(head, ">>");
  free(head);
  ret matched;
}

// The message every mixed-array-dimension rejection below shares, so
// a caller elsewhere recognizing it by text (a test, a client-side
// quick-fix) only has one string to match against.
const str MIXED_ARRAY_DIMENSIONS_MSG =
"an array type's own size must be written for every dimension or none at all, not a mix of the two";

// True when `dt` is a multi-dimensional array mixing a sized and a
// bare dimension (`num[3][] arr`) - no real size for codegen to emit
// at all: `array_brackets` only ever records a sized dimension's own
// expression (`parse_array_brackets` skips a bare `[]` outright), so
// codegen's own bracket-declarator loop silently emits only the
// dimensions it has - one declarator short, with every index through
// the missing one then reading as a nonexistent nested array in the
// generated C. Every declaration site that can write this shape (a
// local, a field, a parameter, a return type, an enum variant's own
// payload) checks against this one helper, rather than re-deriving
// the same condition at each.
fun _has_mixed_array_dimensions(DataType* dt) flag {
  ret dt.is_array && dt.array_brackets.len > 0 && dt.array_brackets.len != dt.array_depth;
}

// The type of one element of the array type `base`.
fun _array_element(CheckedType base) CheckedType {
  CheckedType held = base;
  held.array_depth = base.array_depth - 1;
  held.is_array = held.array_depth > 0;
  held.array_sizes = _array_sizes_shifted(base.array_sizes);
  ret held;
}

// `sizes` with its own outermost dimension dropped, as a fresh,
// independently-owned `Vec` - never `sizes`'s own backing buffer,
// which an ordinary struct copy (`CheckedType held = base;`) still
// shares with whatever `base` it came from. Used by a chained index
// (`arr[i][j]`) to check its own next dimension against what remains
// once the first one is consumed.
fun _array_sizes_shifted(Vec<num> sizes) Vec<num> {
  Vec<num> out;
  num cap = sizes.len - 1;
  if cap < 0 {
    cap = 0;
  }
  out.init(cap);
  num i = 1;
  for i < sizes.len {
    out.push(sizes.get(i));
    i = i + 1;
  }
  ret out;
}

// The value an expression is known to hold when it is written out of
// literals. Only the shapes a divisor is plausibly written as are folded:
// a literal, a parenthesized one, a leading `-`/`+`, and the arithmetic
// between two of them.
fun _constant_value(Node* node) Option<num> {
  if node == nil {
    ret .None;
  }
  fit node.kind {
    .Number(data) -> {
      fit data {
        .Num(v) -> { ret .Some(v); }
        _ -> {}
      }
    }
    .ExpressionParenthesis(inner) -> { ret _constant_value(inner); }
    .Bracket(inner) -> { ret _constant_value(inner); }
    .Unary(u) -> {
      let operand = _constant_value(u.operand);
      if operand.is_none() {
        ret .None;
      }
      if equals(u.op, "-") {
        ret .Some(0 - operand.unwrap());
      }
      if equals(u.op, "+") {
        ret .Some(operand.unwrap());
      }
      ret .None;
    }
    .Expression(e) -> {
      if !e.has_left || !e.has_right {
        ret .None;
      }
      let left = _constant_value(e.left);
      let right = _constant_value(e.right);
      if left.is_none() || right.is_none() {
        ret .None;
      }
      num l = left.unwrap();
      num r = right.unwrap();
      if equals(e.op, "+") {
        ret .Some(l + r);
      }
      if equals(e.op, "-") {
        ret .Some(l - r);
      }
      if equals(e.op, "*") {
        ret .Some(l * r);
      }
    }
    _ -> {}
  }
  ret .None;
}

// True when `node` is written as a zero, however it is spelled.
fun _is_constant_zero(Node* node) flag {
  let value = _constant_value(node);
  ret value.is_some() && value.unwrap() == 0;
}

// The enum a branch pattern names, for a pattern written in full as
// `Enum.Variant` or `Enum.Variant(x)`. Empty for shorthand, which names
// no enum and so cannot disagree with one.
fun _branch_enum_name(Node* condition) str {
  if condition == nil {
    ret "";
  }
  fit condition.kind {
    .Expression(e) -> {
      if equals(e.op, ".") && e.has_left && e.left != nil {
        fit e.left.kind {
          .Identifier(name) -> { ret name; }
          _ -> {}
        }
      }
      // A destructuring pattern is a call on the variant it names.
      if equals(e.op, "()") && e.has_left {
        ret _branch_enum_name(e.left);
      }
    }
    _ -> {}
  }
  ret "";
}

// What a shape-downcast fit arm's named type turned out to be, from
// `Checker._shape_downcast_target_verdict`.
pub enum ShapeDowncastVerdict {
  // Not a registered implementor of the shape at all, bare or
  // reconstructed.
  NotAnImplementor,
  // A registered implementor, but a still-abstract one with no single
  // concrete value to dispatch to (an unbound template, or an
  // instantiation naming at least one abstract, non-real-type argument).
  Generic,
  // A registered implementor naming one fixed, real type - safe to
  // downcast to.
  Concrete,
}

// The bare type name a shape-downcast fit arm names (`Circle(c) -> ...`),
// or empty when `branch` isn't that shape at all: the parser
// (`_try_parse_fit_shape_destructure`) already commits a bare, undotted
// `Type(...)` pattern to exactly this AST shape - a plain `.Identifier`
// condition with `bindings` populated - never produced by the
// enum-destructure path, which always builds a `.`-qualified condition
// instead. So a bare identifier condition with any bindings at all is
// unambiguously this shape, not just a heuristic - arity is verified
// separately by `check_shape_destructure_condition`, not here, so a
// wrong-arity arm (`Circle(a, b)`) still gets a clear error instead of
// silently falling through to the ordinary value-pattern path (which
// would leave its bindings undefined and fail confusingly, deep in
// codegen, instead of here).
fun _shape_destructure_type_name(FitBranch branch) str {
  if !branch.has_condition || !branch.has_bindings || branch.bindings.len == 0 {
    ret "";
  }
  fit branch.condition.kind {
    .Identifier(name) -> { ret name; }
    _ -> {}
  }
  ret "";
}

// The `impl` method name operator overloading dispatches a *binary*
// operator to (`+` to `op_add`, `==` to `op_eq`, and so on) - unary
// `-`/`!` map to `op_neg`/`op_not` instead, resolved directly where
// `infer_unary` needs them, since the same `"-"` text means a
// different method name in each position. "" for an operator that
// can't be overloaded (no entry here), which every call site treats
// as "fall through to the builtin behavior unchanged" rather than an
// error - there is no other meaning to an empty result. `pub` so
// codegen's own binary-operator emission can mirror this exact
// mapping instead of keeping a second copy of it.
pub fun operator_method_name(str op) str {
  if equals(op, "+") {
    ret "op_add";
  }
  if equals(op, "-") {
    ret "op_sub";
  }
  if equals(op, "*") {
    ret "op_mul";
  }
  if equals(op, "/") {
    ret "op_div";
  }
  if equals(op, "%") {
    ret "op_mod";
  }
  if equals(op, "==") {
    ret "op_eq";
  }
  if equals(op, "!=") {
    ret "op_ne";
  }
  if equals(op, "<") {
    ret "op_lt";
  }
  if equals(op, "<=") {
    ret "op_le";
  }
  if equals(op, ">") {
    ret "op_gt";
  }
  if equals(op, ">=") {
    ret "op_ge";
  }
  if equals(op, "[]") {
    ret "op_index";
  }
  // Not a real token the parser ever produces - `check_assignment`'s own
  // `[]` target branch passes this literally, reusing `receiver_method`
  // the same way every other operator already does rather than
  // duplicating its instantiation/method-table lookup for one more case.
  if equals(op, "[]=") {
    ret "op_index_set";
  }
  ret "";
}

fun _is_comparison(str op) flag {
  ret equals(op, "==") || equals(op, "!=") || equals(op, "<") || equals(op, ">") ||
    equals(
    op,
    "<="
  ) || equals(op, ">=");
}

fun _is_logical(str op) flag {
  ret equals(op, "&&") || equals(op, "||");
}

impl Checker {
  // A condition asks a question, so it holds a truth value rather than
  // something that merely stands in for one.
  check_condition(Node* condition, TypeEnv* env) {
    CheckedType t = self.infer(condition, env);
    if is_unknown(t) || t.base == .Bin {
      ret;
    }
    self.fail(format("a condition expects flag, found {str}", type_name(t)), condition);
  }

  // Walks an expression written as a statement, for the checks made
  // along the way rather than for the type it produces.
  walk_expr(Node* node, TypeEnv* env) {
    _ = self.infer(node, env);
  }

  // Walks a statement, checking whatever it declares, returns, or
  // evaluates.
  check_statement(Node* stmt, TypeEnv* env) {
    if stmt == nil || self.failed {
      ret;
    }
    fit stmt.kind {
      .Body(body) -> {
        env.push();
        for s : body.statements {
          self.check_statement(s, env);
        }
        env.pop();
      }
      .Variable(v) -> {
        if v.is_destructure {
          self.check_let_destructure(stmt, v, env);
        } else {
          self.check_variable(stmt, v, env);
        }
      }
      .StatementReturn(value) -> { self.check_return(stmt, value, env); }
      .StatementIf(ifn) -> {
        self.check_condition(ifn.condition, env);
        self.check_statement(ifn.body, env);
      }
      .StatementElseIf(ein) -> {
        self.check_condition(ein.condition, env);
        self.check_statement(ein.body, env);
      }
      .StatementElse(body) -> { self.check_statement(body, env); }
      .StatementDefer(inner) -> { self.check_statement(inner, env); }
      .StatementFor(kind) -> { self.check_for(stmt, kind, env); }
      .StatementFit(f) -> { self.check_fit(f, env); }
      .Expression(_) -> { self.walk_expr(stmt, env); }
      .ExpressionParenthesis(_) -> { self.walk_expr(stmt, env); }
      .Unary(_) -> { self.walk_expr(stmt, env); }
      .Ternary(_) -> { self.walk_expr(stmt, env); }
      _ -> {}
    }
  }

  // Checks that every branch matches the value being matched. A branch
  // written `Other.Variant` against a different enum's value can never
  // be taken, so it is a mistake rather than a dead branch.
  check_fit(FitStmtNode f, TypeEnv* env) {
    str subject = "";
    CheckedType subject_type = checked_unknown();
    flag have_subject_type = false;
    if f.exp != nil {
      subject_type = self.infer(f.exp, env);
      subject = subject_type.name;
      have_subject_type = true;
    }
    flag subject_is_shape = have_subject_type && self.shapes.has(subject_type.name);
    for branch : f.branches {
      str shape_type_name = "";
      if branch.has_condition && subject_is_shape {
        shape_type_name = _shape_destructure_type_name(branch);
        if !equals(shape_type_name, "") {
          shape_type_name = self._auto_resolve_bare_generic_shape_target(
            shape_type_name,
            subject_type.name,
            branch.condition
          );
          if self.failed {
            ret;
          }
        }
      }
      if branch.has_condition {
        if branch.is_tuple_pattern {
          self.check_fit_tuple_pattern_condition(branch, subject_type, have_subject_type);
        } elif !equals(shape_type_name, "") {
          self.check_shape_destructure_condition(branch, shape_type_name, subject_type);
          if self.failed {
            ret;
          }
        } else {
          self.check_shorthand_variant(branch.condition, subject_type, env);
          if self.failed {
            ret;
          }
          str named = _branch_enum_name(branch.condition);
          if !equals(named, "") && !equals(subject, "") && !equals(named, subject) {
            self.fail(
              format(
              "fit branch names '{str}' but the value being matched is a '{str}'",
              named,
              subject
              ),
              branch.condition
            );
          }
        }
      }
      env.push();
      if branch.is_tuple_pattern && branch.has_condition && have_subject_type &&
        subject_type.is_tuple {
        self.bind_fit_tuple_pattern(branch, subject_type, env);
      } elif !equals(shape_type_name, "") {
        self.bind_fit_shape_pattern(branch, shape_type_name, env);
      } elif branch.has_bindings {
        // A plain data-carrying variant pattern (`.Rotating(r)`), not
        // itself a tuple or shape destructure - its own payload type
        // isn't modeled here (codegen resolves it independently, the
        // same split this file already has everywhere else), but the
        // name itself still needs a real binding: left unbound
        // entirely, `env.lookup` reported it as not found at all,
        // indistinguishable from a genuinely undeclared identifier -
        // exactly what a receiver-existence check added elsewhere in
        // this file needs to tell apart.
        for bname : branch.bindings {
          env.define(bname, checked_unknown());
        }
      }
      self.check_statement(branch.body, env);
      env.pop();
    }
  }

  // Verifies a `(pattern, ...) -> ...` tuple-pattern arm's own shape: the
  // subject must itself be tuple-typed with the same arity as the pattern,
  // and each literal position (a binding position skips this - it accepts
  // any value at its own position) must fit the subject's own element type
  // at that position, the same way an ordinary `fit` label already has to
  // fit the subject's type.
  check_fit_tuple_pattern_condition(
    FitBranch branch,
    CheckedType subject_type,
    flag have_subject_type
  ) {
    if !have_subject_type || !subject_type.is_tuple {
      self.fail("a tuple pattern in 'fit' needs a tuple-typed subject", branch.condition);
      ret;
    }
    fit branch.condition.kind {
      .TupleLiteral(tl) -> {
        if tl.elements.len != subject_type.tuple_members.len {
          self.fail(
            format(
            "a tuple pattern with {num} position(s) needs a {num}-element tuple subject, not '{str}'",
            tl.elements.len,
            subject_type.tuple_members.len,
            type_name(subject_type)
            ),
            branch.condition
          );
          ret;
        }
      }
      _ -> {}
    }
  }

  // Binds each non-wildcard binding position of a tuple-pattern arm to its
  // own element type from the subject, and typechecks each literal
  // position against that same element type - real errors either way, not
  // a silent Unknown fallback, matching the standard `check_let_destructure`
  // and the for-loop's own tuple destructuring already hold tuple patterns
  // to elsewhere in this file. Caller has already verified the arity
  // matches and pushed a fresh `env` scope for the arm body.
  bind_fit_tuple_pattern(FitBranch branch, CheckedType subject_type, TypeEnv* env) {
    fit branch.condition.kind {
      .TupleLiteral(tl) -> {
        if tl.elements.len != subject_type.tuple_members.len {
          ret;
        }
        num i = 0;
        for el : tl.elements {
          CheckedType member = subject_type.tuple_members.get(i);
          flag is_binding = false;
          flag is_wildcard = false;
          str bname = "";
          fit el.kind {
            .Identifier(s) -> {
              if equals(s, "_") {
                is_wildcard = true;
              } else {
                is_binding = true;
                bname = s;
              }
            }
            _ -> {}
          }
          if is_binding {
            env.define(bname, member);
          } elif !is_wildcard {
            let lit_type = self.infer(el, env);
            if !self.assignable(member, lit_type) {
              self.fail(
                format(
                "a tuple pattern position expects a '{str}', not '{str}'",
                type_name(member),
                type_name(lit_type)
                ),
                el
              );
            }
          }
          i = i + 1;
        }
      }
      _ -> {}
    }
  }

  // Verifies a shape-downcast arm (`Circle(c) -> ...`, only reached when
  // the fit subject is itself shape-typed and `_shape_destructure_type_name`
  // already confirmed a bare-identifier condition with at least one
  // binding): `type_name` must be a real `impl type_name as <subject's
  // shape> { ... }`, and the arm must bind exactly one name to recover
  // the concrete value, mirroring `Option.Some(v)`/`Result.Ok(v)`'s
  // single-payload shape rather than multi-field enum-payload
  // destructuring.
  check_shape_destructure_condition(FitBranch branch, str type_name, CheckedType subject_type) {
    let verdict = self._shape_downcast_target_verdict(type_name, subject_type.name);
    fit verdict {
      .NotAnImplementor -> {
        self.fail(
          format(
          "'{str}' does not implement shape '{str}'",
          type_name,
          subject_type.name
          ),
          branch.condition
        );
        ret;
      }
      .Generic -> {
        self.fail(
          format(
          "'{str}' is generic and has no single concrete implementation to downcast to",
          type_name
          ),
          branch.condition
        );
        ret;
      }
      .Concrete -> {}
    }
    if branch.bindings.len != 1 {
      self.fail(
        format(
        "expected exactly one binding to recover the concrete '{str}' value, got {num}",
        type_name,
        branch.bindings.len
        ),
        branch.condition
      );
    }
  }

  // Whether `name` is usable as one fixed, real value's own type: a
  // non-generic compound, a non-generic enum, or a builtin scalar -
  // never a still-abstract type-parameter name (`T`, `K`, `V`, ...),
  // which is never actually declared as any of these.
  _is_known_concrete_name(str name) flag {
    let compound_info = self.compounds.at(name);
    if compound_info.is_some() {
      ret !compound_info.unwrap().is_generic;
    }
    if self.enum_names.has(name) {
      let enum_params = self.enum_type_params.at(name);
      ret enum_params.is_none() || enum_params.unwrap().len == 0;
    }
    ret equals(name, "num") || equals(name, "str") || equals(name, "dec") ||
      equals(name, "flag") || equals(name, "chr") || equals(name, "raw") ||
      equals(name, "void");
  }

  // A bare generic compound name (`Box(b)`, no `<Args>`) auto-resolves
  // to its one concrete implementation of `shape_name` when exactly one
  // exists (`Box<num>`, say, is the only `impl Box<...> as Sized` in
  // the program) - same convenience `Wrapper<T> w;` already gets from
  // type inference elsewhere, applied here to a fit arm's pattern.
  // Anything else about `type_name` (not a generic compound at all,
  // already `<Args>`-mangled, a genuinely unbound template with zero
  // concrete instantiations) passes through unchanged, and
  // `_shape_downcast_target_verdict` reports the right thing for it.
  // Two or more concrete instantiations is ambiguous - reported here
  // directly (not deferred to the verdict's generic catch-all) since
  // only this function still has the actual candidate list to name.
  _auto_resolve_bare_generic_shape_target(str type_name, str shape_name, Node* condition) str {
    let compound_info = self.compounds.at(type_name);
    if compound_info.is_none() || !compound_info.unwrap().is_generic {
      ret type_name;
    }
    let keys = self.shape_impl_type_params.keys();
    Vec<str> concrete_names;
    concrete_names.init(2);
    for k : keys {
      num sep = last_index_of_char(k, ':');
      if sep < 1 {
        continue;
      }
      str base_name = substr(k, 0, sep - 1);
      str this_shape = substr(k, sep + 1, len(k) - sep - 1);
      if !equals(base_name, type_name) || !equals(this_shape, shape_name) {
        continue;
      }
      let entries_opt = self.shape_impl_type_params.at(k);
      if entries_opt.is_none() {
        continue;
      }
      Vec<Vec<str>> entries = entries_opt.unwrap();
      for tps : entries {
        flag all_concrete = true;
        for tp : tps {
          if !self._is_known_concrete_name(tp) {
            all_concrete = false;
            break;
          }
        }
        if !all_concrete {
          continue;
        }
        StringBuilder recon_sb = string_builder_init(16);
        recon_sb.append(base_name);
        for tp : tps {
          recon_sb.append("__");
          recon_sb.append(tp);
        }
        concrete_names.push(recon_sb.build());
      }
    }
    // A scalar-argument instantiation (`impl Box<num> as Sized`) never
    // shows up in `shape_impl_type_params` at all - `has_concrete_dtype`
    // resolves its own mangled identity immediately at parse time, with
    // nothing ambiguous left to record there, so it's registered
    // directly under its final mangled name in `shape_implementors`
    // instead. Every entry there sharing `type_name`'s own mangling
    // prefix is one of these.
    let bucket_opt = self.shape_implementors.at(shape_name);
    if bucket_opt.is_some() {
      str prefix = format("{str}__", type_name);
      for candidate : bucket_opt.unwrap().keys() {
        if starts_with(candidate, prefix) {
          concrete_names.push(candidate);
        }
      }
    }
    if concrete_names.len == 1 {
      ret concrete_names.get(0);
    }
    if concrete_names.len > 1 {
      StringBuilder list_sb = string_builder_init(16);
      num li = 0;
      for li < concrete_names.len {
        if li > 0 {
          list_sb.append(", ");
        }
        list_sb.append("'");
        list_sb.append(concrete_names.get(li));
        list_sb.append("'");
        li = li + 1;
      }
      self.fail(
        format(
        "'{str}' is ambiguous between {str} - write the generic arguments explicitly, like '{str}<...>(...)'",
        type_name,
        list_sb.build(),
        type_name
        ),
        condition
      );
    }
    ret type_name;
  }

  // What a shape-downcast fit arm's named type (`type_name`, the bare
  // identifier the arm wrote, or the mangled form a `Type<Args>(...)`
  // arm's own generic sugar produces) turns out to be, against
  // `shape_name`. Two ways to match:
  //
  // 1. A direct, bare match through `implements_shape` -
  // `shape_implementors` (`Circle` for a real `impl Circle as HasArea`,
  // but ALSO the bare template name for `impl Box<T> as Sized`, which
  // registers no differently - `type_params` says nothing about whether
  // each name is a fresh parameter or a reference to a real type, so
  // that's checked here via `_is_known_concrete_name`, not assumed).
  //
  // 2. A reconstructed match: `type_name` mangles back to `base__arg1__
  // arg2...` for some registered `(base, shape_name)` impl's own
  // `type_params` (`Box__Circle` for `impl Box<Circle> as Sized`, an
  // already-declared compound used as the argument - indistinguishable
  // from a fresh type-param name at parse time, so stored the exact same
  // way `impl Box<T> as Sized` would be; see `Checker.
  // shape_impl_type_params`'s own doc comment). Every argument must be a
  // real type for this to count as concrete - a genuinely unbound
  // template could coincidentally reconstruct into the same string a
  // hand-written mangled name would, and `_is_known_concrete_name`
  // catches that too.
  _shape_downcast_target_verdict(str type_name, str shape_name) ShapeDowncastVerdict {
    CheckedType candidate = checked_unknown();
    candidate.name = type_name;
    candidate.pointer_depth = 1;
    if self.implements_shape(candidate, shape_name) {
      // Unlike a type_param's own name below (expected to be a simple
      // name, real or abstract, positively confirmed), `type_name` here
      // can be a mangled instantiation (`Box__num`, from a
      // `has_concrete_dtype` impl - already fully resolved, never found
      // under its own exact mangled string in `self.compounds`) as
      // easily as a bare one. Only reject when it's POSITIVELY known as
      // a generic compound/enum declaration; anything else (not found at
      // all, or found and non-generic) is safe.
      let compound_info = self.compounds.at(type_name);
      if compound_info.is_some() {
        if compound_info.unwrap().is_generic {
          ret .Generic;
        }
        ret .Concrete;
      }
      let enum_params = self.enum_type_params.at(type_name);
      if enum_params.is_some() && enum_params.unwrap().len > 0 {
        ret .Generic;
      }
      ret .Concrete;
    }
    let keys = self.shape_impl_type_params.keys();
    for k : keys {
      let entries_opt = self.shape_impl_type_params.at(k);
      if entries_opt.is_none() {
        continue;
      }
      num sep = last_index_of_char(k, ':');
      if sep < 1 {
        continue;
      }
      // "{base}::{shape}" - the base name ends two characters before
      // this last ':'.
      str base_name = substr(k, 0, sep - 1);
      str this_shape = substr(k, sep + 1, len(k) - sep - 1);
      if !equals(this_shape, shape_name) {
        continue;
      }
      // More than one impl can share this base+shape key (`impl Box<num>
      // as Sized` and `impl Box<str> as Sized` both key to "Box::Sized"),
      // so every candidate's own reconstruction is tried, not just one.
      Vec<Vec<str>> entries = entries_opt.unwrap();
      flag matched_entry = false;
      for tps : entries {
        StringBuilder recon_sb = string_builder_init(16);
        recon_sb.append(base_name);
        for tp : tps {
          recon_sb.append("__");
          recon_sb.append(tp);
        }
        if equals(recon_sb.build(), type_name) {
          matched_entry = true;
          for tp : tps {
            if !self._is_known_concrete_name(tp) {
              ret .Generic;
            }
          }
          break;
        }
        // A genuinely unbound template (`impl Box<T> as Sized`, every
        // `tp` a fresh type param, never a reference to an already-
        // declared type) has no fixed instantiation to reconstruct and
        // compare literally - there's nothing to substitute `tp` with
        // ahead of time, unlike `impl Box<Circle> as Sized` above,
        // where "Circle" is already the one and only concrete value
        // `tp` ever takes. An explicit `Box<num>(b)` downcast arm names
        // its own chosen instantiation directly instead, so it's taken
        // at face value here: unlike the bare `Box(b)` form (ambiguous
        // between every instantiation the program happens to
        // construct, and rejected outright for a template like this
        // one), naming the instantiation explicitly is never ambiguous.
        flag all_unbound = true;
        for tp : tps {
          if self._is_known_concrete_name(tp) {
            all_unbound = false;
            break;
          }
        }
        if all_unbound && starts_with(type_name, format("{str}__", base_name)) {
          matched_entry = true;
          break;
        }
      }
      if !matched_entry {
        continue;
      }
      ret .Concrete;
    }
    ret .NotAnImplementor;
  }

  // `type_name` (`Box__num`, `Wrapper__Circle`, ...) reconstructed back
  // into a real generic `CheckedType` (`Box<num>`, `Wrapper<Circle>`)
  // when it names a `has_type_params` impl's own mangled identity -
  // `.None` for anything else (a plain type, or a `has_concrete_dtype`
  // impl's already-resolved mangled name, neither of which needs this).
  // A flat `CheckedType{name: type_name}` resolves a plain type fine,
  // but not a generic one: field-type substitution needs the real
  // `generic_args` structure, not just the pre-mangled string, the same
  // way an ordinary `Wrapper<Circle> w;` declaration already carries it.
  _reconstruct_generic_checked_type(str type_name) Option<CheckedType> {
    let keys = self.shape_impl_type_params.keys();
    for k : keys {
      let entries_opt = self.shape_impl_type_params.at(k);
      if entries_opt.is_none() {
        continue;
      }
      num sep = last_index_of_char(k, ':');
      if sep < 1 {
        continue;
      }
      str base_name = substr(k, 0, sep - 1);
      // More than one impl can share this base+shape key (`impl Box<num>
      // as Sized` and `impl Box<str> as Sized` both key to "Box::Sized"),
      // so every candidate's own reconstruction is tried, not just one.
      Vec<Vec<str>> entries = entries_opt.unwrap();
      for tps : entries {
        StringBuilder recon_sb = string_builder_init(16);
        recon_sb.append(base_name);
        for tp : tps {
          recon_sb.append("__");
          recon_sb.append(tp);
        }
        if !equals(recon_sb.build(), type_name) {
          continue;
        }
        CheckedType ct = checked_unknown();
        ct.name = base_name;
        Vec<CheckedType> gargs;
        gargs.init(tps.len);
        for tp : tps {
          CheckedType arg_ct = checked_unknown();
          arg_ct.name = tp;
          gargs.push(arg_ct);
        }
        ct.generic_args = gargs;
        ret .Some(ct);
      }
    }
    ret .None;
  }

  // Binds a shape-downcast arm's single name to the concrete
  // implementor's own type, as a pointer (matching how `self` is
  // received inside that type's own methods). Caller has already
  // verified the arm names a real implementor with exactly one binding,
  // and pushed a fresh `env` scope for the arm body.
  bind_fit_shape_pattern(FitBranch branch, str type_name, TypeEnv* env) {
    str bname = branch.bindings.get(0);
    if !equals(bname, "_") {
      let reconstructed = self._reconstruct_generic_checked_type(type_name);
      CheckedType bound = checked_unknown();
      if reconstructed.is_some() {
        bound = reconstructed.unwrap();
      } else {
        bound.name = type_name;
      }
      bound.pointer_depth = 1;
      env.define(bname, bound);
    }
  }

  check_for(Node* stmt, ForKind kind, TypeEnv* env) {
    env.push();
    fit kind {
      .Cond(c) -> {
        if c.has_condition {
          _ = self.infer(c.condition, env);
        }
        self.check_statement(c.body, env);
      }
      .Iter(it) -> {
        // `for x : a..b` builds a `Range`, which lives in `std.range`.
        fit it.iterable.kind {
          .CompoundInit(ci) -> {
            if ci.has_dtype && equals(ci.init_dtype.type_str, "Range") &&
              self.compounds.at(self.canonical_type_name("Range")).is_none() {
              self.fail("a range 'for' loop needs `use std.range;`", stmt);
              env.pop();
              ret;
            }
          }
          _ -> {}
        }
        CheckedType iterable_type = self.infer(it.iterable, env);
        // The real general resolution: does the iterable's own type
        // directly implement `Iterator<Elem>`? Covers `Range`, `Vec`,
        // `Map` (yielding `(K, V)` pairs), `Set`, and any user-defined
        // type with its own `impl X as Iterator<T>`.
        Option<CheckedType> elem_opt = self.shape_arg_of(iterable_type, "Iterator");
        // A raw array has no shape impls; it walks its own elements.
        flag walks_array = elem_opt.is_none() && iterable_type.is_array &&
          iterable_type.pointer_depth == 0;
        if walks_array {
          elem_opt = .Some(_array_element(iterable_type));
        }
        if it.item_is_destructure {
          // `for (a, b) : pairs`: the loop item is a tuple, destructured
          // into its own names the same way a declared-type `let`
          // destructuring pattern is - a real element-type mismatch or
          // arity mismatch is a compile error here too, not a silent
          // Unknown fallback, the same standard `check_let_destructure`
          // already holds tuple destructuring to.
          // `for i, (a, b) :: pairs` also counts.
          if it.has_index_name {
            env.define(it.index_name, checked_of(.Num));
          }
          flag matched = false;
          Option<CheckedType> destructure_elem = .None;
          if elem_opt.is_some() {
            destructure_elem = elem_opt;
          } elif iterable_type.generic_args.len >= 1 {
            destructure_elem = .Some(iterable_type.generic_args.get(0));
          }
          if destructure_elem.is_some() {
            let elem = destructure_elem.unwrap();
            if elem.is_tuple && elem.tuple_members.len == it.item_destructure_names.len {
              matched = true;
              num idi = 0;
              for name : it.item_destructure_names {
                env.define(name, elem.tuple_members.get(idi));
                idi = idi + 1;
              }
            } elif elem.is_tuple {
              self.fail(
                format(
                "'for' destructuring pattern has {num} name(s) but the iterable's own element has {num} element(s)",
                it.item_destructure_names.len,
                elem.tuple_members.len
                ),
                stmt
              );
              matched = true;
              for name : it.item_destructure_names {
                env.define(name, checked_unknown());
              }
            }
          }
          if !matched {
            // Not confidently known to be a tuple-elemented iterable
            // (an unresolved reference, or a collection type the
            // checker doesn't model structurally) - binding each name
            // as Unknown lets the rest of the function keep checking,
            // the same leniency an ordinary for-loop item already gets
            // just below.
            for name : it.item_destructure_names {
              env.define(name, checked_unknown());
            }
          }
        } elif it.has_index_name && elem_opt.is_some() {
          let elem = elem_opt.unwrap();
          if elem.is_tuple && elem.tuple_members.len == 2 && !walks_array {
            // A two-name form over anything else yielding a pair (a
            // future Map migrated onto Iterator<(K, V)>, or a user type
            // doing the same) destructures it the same way, rather than
            // this being Map-specific.
            env.define(it.index_name, elem.tuple_members.get(0));
            env.define(it.item_name, elem.tuple_members.get(1));
          } else {
            // Otherwise, "enumerate": a running 0-based count alongside
            // the item, the general form Vec/array's own index/item
            // behavior below is really a special case of.
            env.define(it.index_name, checked_of(.Num));
            env.define(it.item_name, elem);
          }
        } elif elem_opt.is_some() {
          env.define(it.item_name, elem_opt.unwrap());
        } else {
          // A scalar value has nothing to walk.
          if _is_scalar_value(iterable_type) {
            self.fail(
              format(
              "'for' can't walk a value of type '{str}'; it needs an array, a Vec, or a type that implements Iterator",
              type_name(iterable_type)
              ),
              it.iterable
            );
          }
          // What the loop walks holds values of a type the checker
          // does not model yet (Vec/Set/array today).
          env.define(it.item_name, checked_unknown());
          if it.has_index_name {
            env.define(it.index_name, checked_of(.Num));
          }
        }
        self.check_statement(it.body, env);
      }
    }
    env.pop();
  }

  // Rejects a name another file declares only for itself. A file offers
  // what it marks public; the rest is its own business.
  check_visibility(str name, str declared_in, flag is_public, str what, Node* at) {
    if is_public || equals(declared_in, "") || equals(self.current_file, "") {
      ret;
    }
    if equals(declared_in, self.current_file) {
      ret;
    }
    self.fail(
      format("{str} '{str}' is not public in the file that declares it", what, name),
      at
    );
  }

  // The name of the const binding a field-assignment's own receiver
  // chain is rooted at, walking left through consecutive `.field`
  // hops (`a.b.c = v;`'s own root is `a`) - `.None` when the root
  // isn't a bare identifier at all (a call's own result, an index,
  // ...) or names a binding that isn't const.
  _field_assignment_const_root(Node* target, TypeEnv* env) Option<str> {
    fit target.kind {
      .Identifier(name) -> {
        let bound = env.binding(name);
        if bound.is_some() && bound.unwrap().is_const {
          ret .Some(name);
        }
        ret .None;
      }
      .Expression(e) -> {
        if equals(e.op, ".") && e.has_left {
          ret self._field_assignment_const_root(e.left, env);
        }
        ret .None;
      }
      .ExpressionParenthesis(inner) -> { ret self._field_assignment_const_root(inner, env); }
      _ -> { ret .None; }
    }
  }

  // Rejects an assignment to a name declared const, and checks that the
  // value assigned fits what the name holds.
  check_assignment(Node* node, ExprNode e, TypeEnv* env) {
    if !e.has_left {
      ret;
    }
    fit e.left.kind {
      .Expression(target) -> {
        if equals(target.op, "[]") {
          self.check_index_assignment(node, e, target, env);
          ret;
        }
        if !equals(target.op, ".") || !equals(e.op, "=") || !e.has_right {
          ret;
        }
        // `head.next = v;` reaches a field through a chain whose own
        // root may be a const binding (`const head = ...;`) - rejected
        // the same way a direct `head = v;` already is just below,
        // since mutating a field is reassigning data the const binding
        // is supposed to own just as much as the binding itself.
        // `*head.next = v;` (writing through the pointer `next` holds,
        // not to the field itself) is a different assignment target
        // altogether - a `.Unary` dereference, never reaches this
        // `.Expression` arm at all - and stays allowed, matching C's
        // own shallow `const` for a pointer field exactly: the pointer
        // is fixed, not what it points to.
        let const_root = self._field_assignment_const_root(target.left, env);
        if const_root.is_some() {
          self.fail(
            format(
            "cannot assign to a field of '{str}', which is const",
            const_root.unwrap()
            ),
            node
          );
          ret;
        }
        CheckedType field = self.infer_field(node, target, env);
        if self.failed {
          ret;
        }
        CheckedType value = self.infer(e.right, env);
        self.check_shorthand_variant(e.right, field, env);
        if self.failed {
          ret;
        }
        if !self.assignable(field, value) {
          self.fail(
            format(
            "cannot assign {str} to a field of type {str}",
            type_name(value),
            type_name(field)
            ),
            node
          );
        }
      }
      .Identifier(name) -> {
        let bound = env.binding(name);
        if bound.is_none() {
          // `_ = expr;` still checks what it discards.
          if e.has_right {
            _ = self.infer(e.right, env);
          }
          ret;
        }
        Binding b = bound.unwrap();
        if b.is_const {
          self.fail(format("cannot assign to '{str}', which is const", name), node);
          ret;
        }
        if !equals(e.op, "=") || !e.has_right {
          if e.has_right {
            _ = self.infer(e.right, env);
          }
          ret;
        }
        CheckedType value = self.infer(e.right, env);
        self.check_shorthand_variant(e.right, b.type, env);
        if self.failed {
          ret;
        }
        if !self.assignable(b.type, value) {
          self.fail(
            format(
            "cannot assign {str} to '{str}' of type {str}",
            type_name(value),
            name,
            type_name(b.type)
            ),
            node
          );
        }
      }
      // `*ptr = v;` had no case here at all - every other assignment
      // target shape above checks the value fits what it's writing
      // into, but a dereferenced one skipped straight past this whole
      // `fit` with no check whatsoever, leaking a raw C compiler
      // error for anything mismatched (assigning a pointer where its
      // own pointee type is expected included, confirmed directly:
      // `*head = a_node_ptr;` where `head` is `Node*` compiled all the
      // way to a real C type error, "assigning to 'Node' from
      // incompatible type 'Node *'").
      .Unary(u) -> {
        if !equals(u.op, "*") || !equals(e.op, "=") || !e.has_right {
          ret;
        }
        CheckedType target = self.infer(e.left, env);
        if self.failed {
          ret;
        }
        CheckedType value = self.infer(e.right, env);
        self.check_shorthand_variant(e.right, target, env);
        if self.failed {
          ret;
        }
        if !self.assignable(target, value) {
          self.fail(
            format(
            "cannot assign {str} to a dereferenced value of type {str}",
            type_name(value),
            type_name(target)
            ),
            node
          );
        }
      }
      _ -> {}
    }
  }

  // Fails with a clear diagnostic when `index_node` folds to a
  // constant out of range for the dimension about to be indexed -
  // `base.array_sizes`'s own first entry, dropped for whatever
  // dimension remains the same way `infer`'s own `"[]"` case already
  // drops it for the rest of a chained index (`arr[i][j]`). Left
  // unchecked, the same as a non-constant divisor already is
  // elsewhere in this file, when `base` isn't an array with every
  // dimension's own size known, or the index isn't itself foldable.
  check_array_index_bounds(Node* node, CheckedType base, Node* index_node) {
    if base.array_sizes.len == 0 {
      ret;
    }
    num declared = base.array_sizes.get(0);
    if declared < 0 {
      ret;
    }
    let idx = _constant_value(index_node);
    if idx.is_none() {
      ret;
    }
    num iv = idx.unwrap();
    if iv < 0 || iv >= declared {
      self.fail(
        format("index {num} is out of range for an array of size {num}", iv, declared),
        node
      );
    }
  }

  // `a[i] = v` on a real array/`Vec<T>`/`str` keeps its own builtin
  // meaning, unchecked here exactly as it was before this method
  // existed - only a type with no array of its own gets validated,
  // against `op_index_set(index, value)`, the write-side counterpart
  // `try_operator_dispatch`'s own read-side `"[]"` case already
  // resolves against `op_index`. Not folded into `try_operator_dispatch`
  // itself: that helper's own single optional `right` only ever checks
  // one argument (a binary operator's one operand, or none for unary),
  // and a setter always takes two (the index, then the value).
  // `a[i] = v` on an array: `v` has to fit what the array holds.
  check_element_store(Node* node, ExprNode e, TypeEnv* env) {
    CheckedType element = self.infer(e.left, env);
    if self.failed {
      ret;
    }
    CheckedType value = self.infer(e.right, env);
    self.check_shorthand_variant(e.right, element, env);
    if self.failed {
      ret;
    }
    if !self.assignable(element, value) {
      self.fail(
        format(
        "cannot assign {str} to an element of type {str}",
        type_name(value),
        type_name(element)
        ),
        node
      );
    }
  }

  check_index_assignment(Node* node, ExprNode e, ExprNode target, TypeEnv* env) {
    if !equals(e.op, "=") || !e.has_right || !target.has_left {
      ret;
    }
    CheckedType base = self.infer(target.left, env);
    if base.is_array {
      if target.has_right {
        Node* write_index_node = target.right;
        fit target.right.kind {
          .Bracket(inner) -> { write_index_node = inner; }
          _ -> {}
        }
        self.check_array_index_bounds(node, base, write_index_node);
        if self.failed {
          ret;
        }
      }
      self.check_element_store(node, e, env);
      ret;
    }
    if base.pointer_depth > 0 || equals(base.name, "") ||
      (base.base == .Str && !base.is_array) {
      ret;
    }
    if !target.has_right {
      ret;
    }
    Node* index_node = target.right;
    fit target.right.kind {
      .Bracket(inner) -> { index_node = inner; }
      _ -> {}
    }
    CheckedType index = self.infer(index_node, env);
    CheckedType value = self.infer(e.right, env);
    let sig = self.receiver_method(base, "op_index_set");
    if sig.is_none() {
      if self.receiver_method(base, "op_index").is_some() {
        self.fail(
          format(
          "{str} has 'op_index' for reading but no 'op_index_set' for assignment through an index",
          type_name(base)
          ),
          node
        );
      }
      ret;
    }
    let s = sig.unwrap();
    if s.args.len != 2 {
      ret;
    }
    if !self.assignable(s.args.get(0), index) {
      self.fail(
        format(
        "'[]=' on {str} (op_index_set) expects index {str}, found {str}",
        type_name(base),
        type_name(s.args.get(0)),
        type_name(index)
        ),
        node
      );
      ret;
    }
    if !self.assignable(s.args.get(1), value) {
      self.fail(
        format(
        "'[]=' on {str} (op_index_set) expects value {str}, found {str}",
        type_name(base),
        type_name(s.args.get(1)),
        type_name(value)
        ),
        node
      );
    }
  }

  check_variable(Node* stmt, VariableNode v, TypeEnv* env) {
    CheckedType declared = checked_from_dtype(v.var_type);
    // A local declared as one of the enclosing function's own type params
    // (`T sum = a;`) stands for whatever an instantiation supplies, the
    // same as a parameter of that type - erased the same way, rather than
    // kept as a literal type named `T` no operator or value ever matches.
    flag declared_is_type_param = !equals(declared.name, "") &&
      self.active_type_params.contains(declared.name);
    // Owned outright for as long as `declared` still holds this fresh
    // value - `env.bind` below stores its own clone regardless (see
    // its own note on why), so every return path here is this value's
    // last use. Set false the one place `declared` is reassigned to
    // `value` (an inferred type that may alias another binding's own
    // CheckedType), where freeing it would risk a double free instead.
    flag declared_is_fresh = true;
    defer {
      if declared_is_fresh {
        _free_checked_type_contents(&declared);
      }
    }
    if !equals(declared.name, "") {
      str type_name = self.canonical_type_name(declared.name);
      let info = self.compounds.at(type_name);
      if info.is_some() {
        CompoundInfo holder = info.unwrap();
        self.check_visibility(type_name, holder.file, holder.is_public, "compound", stmt);
        if self.failed {
          ret;
        }
      }
    }
    if !equals(v.var_type.type_str, LET_INFER_TYPE) {
      self.check_type_exists(declared, stmt);
      if self.failed {
        ret;
      }
    }
    self.check_instantiation(declared, stmt);
    if self.failed {
      ret;
    }
    if _has_mixed_array_dimensions(v.var_type) {
      self.fail(MIXED_ARRAY_DIMENSIONS_MSG, stmt);
      ret;
    }
    if v.has_val {
      CheckedType value = self.infer(v.val, env);
      self.check_shorthand_variant(v.val, declared, env);
      if self.failed {
        ret;
      }
      // A local holding a by-reference closure is held to the same rules.
      if value.holds_refs {
        declared.holds_refs = true;
      }
      // A `let` takes the type of its value rather than checking one.
      if is_unknown(declared) {
        // A bare enum-variant shorthand (`let v = .Same;`) has no
        // declared type to resolve against, so it falls back to
        // whichever single enum in the whole program owns that variant
        // name (codegen's own resolve_unique_enum_for_variant does the
        // same lookup for real, once this passes). Zero or several
        // owners is not something a fallback can guess through, so it
        // is reported here rather than left to surface as a codegen
        // internal error far from the actual cause.
        let bare_variant = _bare_enum_shorthand_variant(v.val);
        if bare_variant.is_some() {
          str variant_name = bare_variant.unwrap();
          let owners_opt = self.variant_owners.at(variant_name);
          if owners_opt.is_none() {
            self.fail(
              format("no enum declares a variant named '{str}'", variant_name),
              stmt
            );
            ret;
          }
          Vec<str> owners = owners_opt.unwrap();
          if owners.len > 1 {
            StringBuilder ob = string_builder_init(32);
            num oi = 0;
            for oi < owners.len {
              if oi > 0 {
                ob.append(", ");
              }
              ob.append(owners.get(oi));
              oi = oi + 1;
            }
            self.fail(
              format(
              "cannot infer an enum type for '.{str}': ambiguous between {str} (give '{str}' an explicit declared type)",
              variant_name,
              ob.build(),
              v.name
              ),
              stmt
            );
            ret;
          }
        }
        // A bare compound literal (`let x = .{ a = 1 };`, no type
        // written anywhere - unlike `let x = Account{ a = 1 };`, which
        // `infer_compound_init` already resolves fine) has nothing at
        // all to infer a type from either. Left unchecked, `declared`
        // below became Unknown, which this language's `let`-infer
        // placeholder (`LET_INFER_TYPE`, "__let_infer__") is written
        // as - codegen then wrote that literal placeholder string into
        // the generated C as if it were a real type name, confirmed
        // directly as `error: use of undeclared identifier
        // '__let_infer__'` from the C compiler, not even a clean Fun-
        // level diagnostic.
        fit v.val.kind {
          .CompoundInit(init) -> {
            if !init.has_dtype {
              self.fail(
                format(
                "cannot infer a type for '{str}': a bare compound literal needs an explicit declared type",
                v.name
                ),
                stmt
              );
              ret;
            }
          }
          _ -> {}
        }
        // A shape names a contract rather than a type a value can be
        // stored as, so it cannot be what a `let` infers.
        if self.shapes.has(value.name) {
          self.fail(
            format(
            "cannot infer a type for '{str}': '{str}' is a shape",
            v.name,
            value.name
            ),
            stmt
          );
          ret;
        }
        // A void-returning call has no value to bind: `let x = noop();`
        // would declare a variable of a type that holds nothing.
        if value.base == .Void && value.pointer_depth == 0 && !value.is_array {
          self.fail(
            format(
            "'let' variable '{str}' cannot be initialized from a value of type void",
            v.name
            ),
            stmt
          );
          ret;
        }
        declared = value;
        declared_is_fresh = false;
      } elif !declared_is_type_param && self.literal_out_of_range(declared, v.val, stmt) {
        ret;
      } elif !declared_is_type_param && !self.assignable(declared, value) {
        self.fail(
          format(
          "cannot initialize '{str}' of type {str} with {str}",
          v.name,
          type_name(declared),
          type_name(value)
          ),
          stmt
        );
        ret;
      }
    }
    if declared_is_type_param {
      CheckedType erased = checked_unknown();
      erased.pointer_depth = declared.pointer_depth;
      env.bind(v.name, erased, v.is_const);
      ret;
    }
    env.bind(v.name, declared, v.is_const);
  }

  // `let (a, b, c) = expr;`: unlike an ordinary `let`, whose real
  // inferred type is never written back onto the AST (it lives only in
  // `TypeEnv` via `env.bind` above), this is the only place a
  // destructured name's type is ever resolved at all - each one gets its
  // own `env.bind` call, one per element, exactly like an ordinary
  // `let`'s single call just repeated positionally.
  check_let_destructure(Node* stmt, VariableNode v, TypeEnv* env) {
    if !v.has_val {
      ret;
    }
    CheckedType value = self.infer(v.val, env);
    // A declared tuple type (`(num, str) (a, b) = expr;`) wins the same
    // way an ordinary declared variable's own type does: the initializer
    // must fit it (numeric widening included), and each name binds to
    // its own DECLARED element type, not the initializer's own inferred
    // one - real precision even when the initializer's own shape is
    // wider than what typecheck can pin down (e.g through the pre-
    // existing generic-method-return-type gap `infer_field` already
    // works around elsewhere).
    if !equals(v.var_type.type_str, "__let_infer__") {
      CheckedType declared = checked_from_dtype(v.var_type);
      if !declared.is_tuple || declared.tuple_members.len != v.destructure_names.len {
        self.fail(
          format(
          "a destructuring pattern with {num} name(s) needs a {num}-element declared tuple type, not {str}",
          v.destructure_names.len,
          v.destructure_names.len,
          type_name(declared)
          ),
          stmt
        );
        ret;
      }
      if !is_unknown(value) && !self.assignable(declared, value) {
        self.fail(
          format(
          "cannot initialize a destructuring pattern of type {str} with {str}",
          type_name(declared),
          type_name(value)
          ),
          stmt
        );
        ret;
      }
      num di = 0;
      for name : v.destructure_names {
        env.bind(name, declared.tuple_members.get(di), false);
        di = di + 1;
      }
      ret;
    }
    if is_unknown(value) {
      // Nothing to destructure against yet (an unresolved reference,
      // already reported elsewhere) - binding each name as Unknown lets
      // the rest of the function keep checking instead of cascading.
      for name : v.destructure_names {
        env.bind(name, checked_unknown(), false);
      }
      ret;
    }
    if !value.is_tuple {
      self.fail(
        format("cannot destructure a non-tuple value of type {str}", type_name(value)),
        stmt
      );
      ret;
    }
    if value.tuple_members.len != v.destructure_names.len {
      self.fail(
        format(
        "destructuring pattern has {num} name(s) but the value has {num} element(s)",
        v.destructure_names.len,
        value.tuple_members.len
        ),
        stmt
      );
      ret;
    }
    num i = 0;
    for name : v.destructure_names {
      env.bind(name, value.tuple_members.get(i), false);
      i = i + 1;
    }
  }

  // Fails when a bare `.Variant` shorthand (`.Nope`, `.Nope(x)`) is held
  // to an enum that declares no variant by that name. Only a value that
  // is literally a bare shorthand is judged, and only against a type the
  // program declares as an enum: anything else has no variant list to
  // consult, so it is left to whatever checks it already gets.
  check_shorthand_variant(Node* val, CheckedType want, TypeEnv* env) {
    if self.failed {
      ret;
    }
    let variant = _bare_enum_shorthand_variant(val);
    if variant.is_none() {
      self.check_qualified_variant_against(val, want, env);
      ret;
    }
    str variant_name = variant.unwrap();
    // Genuinely nothing to check yet - an unresolved reference (already
    // reported elsewhere) or a `let` with no declared type, still
    // carrying its own placeholder (`is_unknown`'s own "a `let` carries
    // a placeholder until its value is known" case) while a SEPARATE,
    // dedicated pass resolves a bare shorthand against every enum the
    // whole program declares, not just this one `want`. Checked first,
    // ahead of the real-type checks below: without it, that placeholder
    // read as "a named type that isn't a registered enum" there too,
    // wrongly failing a `let`-inferred shorthand this file never
    // intended to flag at all.
    if is_unknown(want) {
      ret;
    }
    // A resolved builtin scalar (`num`, `flag`, ...) carries its own
    // kind through `want.base` directly, never through `want.name` -
    // "the written name of a user-defined type, empty for a builtin"
    // (see `CheckedType`'s own comment) - so `want.name` being empty
    // does NOT mean "unresolved" here, the way it does above; `is_
    // unknown` already ruled that reading out. A tuple or a function-
    // typed value is the same story: resolved, with no name of its own
    // either, `base == .Unknown` purely because neither has any other
    // way to carry its own kind (`is_tuple`/`has_fn_sig` do that
    // instead) - `is_unknown` already excludes both from its own
    // "nothing to check" case for exactly this reason. A bare
    // `.Variant` shorthand names an enum's own variant by definition,
    // so matching it against any of these is unambiguously wrong:
    // left unchecked before this, it reached codegen with no enum tag
    // to switch on at all, crashing there with an opaque "unsupported
    // node" instead of a real diagnostic at the actual mistake (most
    // commonly `fit`-ing the result of a stray `.unwrap()` that already
    // turned the value into its own payload type).
    if want.base != .Unknown || want.is_tuple || want.has_fn_sig {
      self.fail(
        format(
        "'.{str}' is an enum variant pattern, but the value being matched is a '{str}', not an enum",
        variant_name,
        type_name(want)
        ),
        val
      );
      ret;
    }
    str enum_name = self.canonical_type_name(want.name);
    if equals(enum_name, "") {
      ret;
    }
    if !self.enum_names.has(enum_name) {
      // Still ambiguous even past `is_unknown`: a name that resolves
      // to nothing registered at all is just as often a generic
      // method's own still-abstract type parameter (the enclosing
      // class's own `V`, say, substituted into a nested generic call's
      // return type correctly - see `check_method_call` - but no
      // closer to a concrete type for it) as it is a genuine mistake.
      // Only a name registered as a real COMPOUND is unambiguous: that
      // one definitely resolved to an actual type, and it definitely
      // isn't an enum. Confirmed directly as a real regression without
      // this narrowing: a generic class's own `V` substituted correctly
      // through `Option<V>.unwrap()` read as "a real resolved type
      // named 'V' that isn't a registered enum" here, failing code
      // that was never actually wrong.
      if self.compounds.at(enum_name).is_some() {
        self.fail(
          format(
          "'.{str}' is an enum variant pattern, but the value being matched is a '{str}', not an enum",
          variant_name,
          type_name(want)
          ),
          val
        );
      }
      ret;
    }
    flag declared = false;
    let owners = self.variant_owners.at(variant_name);
    if owners.is_some() {
      Vec<str> declared_by = owners.unwrap();
      num oi = 0;
      for oi < declared_by.len {
        if equals(declared_by.get(oi), enum_name) {
          declared = true;
        }
        oi = oi + 1;
      }
    }
    if !declared {
      self.fail(
        format("enum '{str}' has no variant named '{str}'", enum_name, variant_name),
        val
      );
      ret;
    }
    Vec<Node*> written;
    written.init(2);
    defer written.free();
    flag is_call = false;
    fit val.kind {
      .Expression(e) -> {
        if equals(e.op, "()") {
          is_call = true;
          if e.has_right {
            _call_args(e.right, &written);
          }
        }
      }
      _ -> {}
    }
    if is_call {
      self.check_variant_args(val, enum_name, variant_name, &written, want, env);
    }
  }

  // `Enum.Variant(args)` anywhere a call is written, checked with no
  // expected type to resolve a generic enum's own parameters from.
  check_qualified_variant_call(Node* node, ExprNode e, Vec<Node*>* args, TypeEnv* env) {
    if !e.has_left {
      ret;
    }
    str enum_name = "";
    str variant_name = "";
    _qualified_variant_names(e.left, &enum_name, &variant_name);
    if equals(enum_name, "") || env.lookup(enum_name).is_some() {
      ret;
    }
    str canonical = self.canonical_type_name(enum_name);
    if !self.enum_names.has(canonical) {
      ret;
    }
    self.check_variant_args(node, canonical, variant_name, args, checked_unknown(), env);
  }

  // A constructor call written with its enum named (`Shape.Circle(x)`),
  // held to `want` when the position it sits in expects one. A shorthand
  // (`.Circle(x)`) is checked through `check_shorthand_variant`.
  check_qualified_variant_against(Node* val, CheckedType want, TypeEnv* env) {
    if self.failed {
      ret;
    }
    fit val.kind {
      .Expression(e) -> {
        if !equals(e.op, "()") || !e.has_left {
          ret;
        }
        str enum_name = "";
        str variant_name = "";
        _qualified_variant_names(e.left, &enum_name, &variant_name);
        if equals(enum_name, "") || env.lookup(enum_name).is_some() ||
          !equals(
          self.canonical_type_name(enum_name),
          self.canonical_type_name(want.name)
        ) {
          ret;
        }
        Vec<Node*> written;
        written.init(2);
        defer written.free();
        if e.has_right {
          _call_args(e.right, &written);
        }
        self.check_variant_args(
          val,
          self.canonical_type_name(enum_name),
          variant_name,
          &written,
          want,
          env
        );
      }
      _ -> {}
    }
  }

  // Holds a variant constructor's arguments to its declared payload: the
  // count, and each argument's type against the slot it lands on, with the
  // enum's own type parameters replaced by what `want` instantiated them as
  // (a parameter `want` does not resolve stands for anything). A shorthand
  // nested in an argument is held to that slot's own enum.
  check_variant_args(
    Node* at,
    str enum_name,
    str variant_name,
    Vec<Node*>* written,
    CheckedType want,
    TypeEnv* env
  ) {
    if self.failed {
      ret;
    }
    str payload_key = format("{str}.{str}", enum_name, variant_name);
    defer free(payload_key);
    let payloads = self.variant_payloads.at(payload_key);
    let params = self.enum_type_params.at(enum_name);
    if payloads.is_none() || params.is_none() {
      ret;
    }
    Vec<CheckedType> payload_types = payloads.unwrap();
    Vec<str> type_params = params.unwrap();
    if written.len != payload_types.len {
      str unit = "values";
      if payload_types.len == 1 {
        unit = "value";
      }
      self.fail(
        format(
        "variant '{str}' of '{str}' takes {num} {str}, found {num}",
        variant_name,
        enum_name,
        payload_types.len,
        unit,
        written.len
        ),
        at
      );
      ret;
    }
    num i = 0;
    for i < written.len {
      CheckedType slot = substitute(
        payload_types.get(i),
        &type_params,
        &want.generic_args
      );
      CheckedType got = self.infer(written.get(i), env);
      if self.failed {
        ret;
      }
      self.check_shorthand_variant(written.get(i), slot, env);
      self.check_qualified_variant_against(written.get(i), slot, env);
      if self.failed {
        ret;
      }
      if !self.assignable(slot, got) {
        self.fail(
          format(
          "argument {num} of variant '{str}' of '{str}' expects {str}, found {str}",
          i + 1,
          variant_name,
          enum_name,
          type_name(slot),
          type_name(got)
          ),
          written.get(i)
        );
        ret;
      }
      i = i + 1;
    }
  }

  check_return(Node* stmt, Node* value, TypeEnv* env) {
    if value == nil {
      ret;
    }
    CheckedType got = self.infer(value, env);
    self.check_shorthand_variant(value, self.rtype, env);
    if self.failed {
      ret;
    }
    if got.holds_refs && self.closure_depth == 0 {
      self.fail(
        "a closure capturing a local by reference can't be returned; it would outlive what it captured",
        stmt
      );
      ret;
    }
    if !self.assignable(self.rtype, got) {
      self.fail(
        format(
        "cannot return {str} from a function returning {str}",
        type_name(got),
        type_name(self.rtype)
        ),
        stmt
      );
    }
  }

  // Walks one function with the globals and its parameters in scope.
  // Walks the methods an impl block supplies, with the receiver bound to
  // the type they belong to.
  check_impl(ImplNode block, Vec<Node>* nodes) {
    // A parameter's default is spliced into each call site's own
    // argument list verbatim (`emit_default_trailing_args`), never
    // evaluated against a bound receiver the way the method's own body
    // is - a call through a value with no `self` of its own (an
    // ordinary top-level statement) has nothing to splice it against.
    // Checked unconditionally, before the generic skip just below,
    // since it needs no type substitution at all - only whether the
    // expression itself mentions `self`. Left unchecked, `self.v`
    // leaked through as a genuine identifier lookup and crashed
    // codegen ("unsupported node: unknown identifier 'self'") instead
    // of a real diagnostic.
    for m : block.methods {
      fit m.kind {
        .Function(f) -> {
          for pa : f.args {
            fit pa.kind {
              .Variable(pv) -> {
                if pv.has_val && _references_self(pv.val) {
                  self.fail("a parameter's default value cannot reference 'self'", pa);
                  ret;
                }
              }
              _ -> {}
            }
          }
        }
        _ -> {}
      }
    }
    // A generic impl's own type params are in scope for every method
    // body, erased wherever an expression's type names one (see
    // `infer`), the same as a generic function's own - its bodies used
    // to be skipped outright, so nothing in them was ever checked.
    Vec<str> previous_impl_params = self.impl_type_params;
    Vec<Vec<str>> previous_impl_bounds = self.impl_type_param_bounds;
    Vec<str> impl_params;
    impl_params.init(4);
    Vec<Vec<str>> impl_bounds;
    impl_bounds.init(4);
    if block.has_type_params {
      let target_info = self.compounds.at(self.canonical_type_name(block.type_name));
      num ipi = 0;
      for ipi < block.type_params.len {
        impl_params.push(block.type_params.get(ipi));
        if block.has_type_param_forced_insts {
          impl_bounds.push(_flat_allowed_for_param(block.type_param_forced_insts, ipi));
        } elif target_info.is_some() {
          impl_bounds.push(_flat_allowed_for_param(target_info.unwrap().bounds, ipi));
        } else {
          Vec<str> none;
          none.init(0);
          impl_bounds.push(none);
        }
        ipi = ipi + 1;
      }
    }
    self.impl_type_params = impl_params;
    self.impl_type_param_bounds = impl_bounds;
    for m : block.methods {
      fit m.kind {
        .Function(f) -> { self.check_function_with_self(f, nodes, block.type_name); }
        _ -> {}
      }
      if self.failed {
        break;
      }
    }
    self.impl_type_params.free();
    self.impl_type_params = previous_impl_params;
    num ibi = 0;
    for ibi < self.impl_type_param_bounds.len {
      self.impl_type_param_bounds.data[ibi].free();
      ibi = ibi + 1;
    }
    self.impl_type_param_bounds.free();
    self.impl_type_param_bounds = previous_impl_bounds;
  }

  // Reports a method a shape requires that the impl block does not
  // supply.
  check_shape_conformance(ImplNode block, Node* node) {
    if !block.has_shape_name {
      ret;
    }
    let declared = self.methods.at(block.shape_name);
    if declared.is_none() {
      ret;
    }
    MethodTable* required = declared.unwrap();
    Vec<str> names = required.methods.keys();
    defer names.free();
    num i = 0;
    for i < names.len {
      str name = names.get(i);
      i = i + 1;
      let supplied = self.method_signature(block.type_name, name);
      if supplied.is_none() {
        self.fail(
          format(
          "'{str}' does not supply '{str}', which '{str}' requires",
          block.type_name,
          name,
          block.shape_name
          ),
          node
        );
        ret;
      }
      // A method that must be awaited is not interchangeable with one
      // that must not be.
      let promised = required.methods.at(name);
      if promised.is_some() &&
        promised.unwrap().is_async != supplied.unwrap().is_async {
        self.fail(
          format(
          "'{str}' does not match how '{str}' declares '{str}'",
          block.type_name,
          block.shape_name,
          name
          ),
          node
        );
        ret;
      }
    }
  }

  check_function(FunctionNode f, Vec<Node>* nodes) {
    self.check_function_with_self(f, nodes, "");
  }

  // Reports a compound field whose type names no type, once every type in
  // the program is known.
  check_field_types(Vec<Node>* nodes) {
    num i = 0;
    for i < nodes.len {
      Node* n = &nodes.data[i];
      i = i + 1;
      fit n.kind {
        .Compound(c) -> {
          Vec<str> previous_params = self.active_type_params;
          Vec<str> params;
          params.init(c.type_params.len);
          for tp : c.type_params {
            params.push(tp);
          }
          self.active_type_params = params;
          for field : c.fields {
            CheckedType ft = checked_from_dtype(field.dtype);
            str missing = self._missing_type_name(ft);
            _free_checked_type_contents(&ft);
            if !equals(missing, "") {
              self.fail(
                format(
                "the type '{str}' of field '{str}' in '{str}' is not declared in this program (missing an import?)",
                missing,
                field.name,
                c.name
                ),
                n
              );
              break;
            }
          }
          self.active_type_params.free();
          self.active_type_params = previous_params;
          if self.failed {
            ret;
          }
        }
        _ -> {}
      }
    }
  }

  // Reports a parameter or return type that names no type. Run while the
  // declaration's own type parameters are active.
  check_signature_types(FunctionNode f) {
    for a : f.args {
      fit a.kind {
        .Variable(v) -> {
          CheckedType at = checked_from_dtype(v.var_type);
          self.check_type_exists(at, a);
          _free_checked_type_contents(&at);
          if self.failed {
            ret;
          }
        }
        _ -> {}
      }
    }
    if f.has_rtype {
      CheckedType rt = checked_from_dtype(f.rtype);
      self.check_type_exists(rt, f.body);
      _free_checked_type_contents(&rt);
    }
  }

  check_function_with_self(FunctionNode f, Vec<Node>* nodes, str self_type) {
    if !f.has_body {
      ret;
    }
    // Once a parameter carries a default, every parameter after it must
    // too, or a call omitting only the later ones would leave no way to
    // tell which trailing argument binds to which parameter.
    flag seen_default_param = false;
    for pa : f.args {
      fit pa.kind {
        .Variable(pv) -> {
          if _has_mixed_array_dimensions(pv.var_type) {
            self.fail(MIXED_ARRAY_DIMENSIONS_MSG, pa);
            ret;
          }
          if pv.has_val {
            seen_default_param = true;
          } elif seen_default_param {
            self.fail(
              "a parameter without a default cannot follow a parameter with a default",
              pa
            );
            ret;
          }
        }
        _ -> {}
      }
    }
    if f.has_rtype && _has_mixed_array_dimensions(f.rtype) {
      self.fail(MIXED_ARRAY_DIMENSIONS_MSG, f.body);
      ret;
    }
    TypeEnv env = type_env_new();
    defer env.free();
    env.push();
    num g = 0;
    for g < nodes.len {
      fit nodes.data[g].kind {
        .Variable(v) -> {
          // `bind` stores its own clone (see its own note on why), so
          // this fresh value is redundant - and, unlike every other
          // caller here, which passes an alias shared with something
          // that outlives this call, this one owns it outright and
          // nothing else ever frees it otherwise.
          CheckedType vt = checked_from_dtype(v.var_type);
          let inferred_global = self.global_inferred.at(v.name);
          if is_unknown(vt) && inferred_global.is_some() {
            env.bind(v.name, inferred_global.unwrap(), v.is_const);
          } else {
            env.bind(v.name, vt, v.is_const);
          }
          _free_checked_type_contents(&vt);
        }
        _ -> {}
      }
      g = g + 1;
    }
    env.push();
    if !equals(self_type, "") {
      CheckedType receiver = checked_unknown();
      receiver.name = self_type;
      env.define("self", receiver);
    }
    for a : f.args {
      fit a.kind {
        .Variable(v) -> {
          // Same reasoning as this function's own `env.bind` call above:
          // `define` (via `bind`) stores its own clone, so this fresh
          // value - owned outright, not an alias of anything else - is
          // redundant once stored and nothing else frees it otherwise.
          CheckedType at = _erase_type_params(f, checked_from_dtype(v.var_type));
          env.define(v.name, at);
          _free_checked_type_contents(&at);
        }
        _ -> {}
      }
    }
    // The parameters this declaration names stand for types the checker
    // never sees, so they are held while its body is checked: a name
    // that is one of them is a type, not a name nothing declares.
    Vec<str> previous_params = self.active_type_params;
    Vec<str> params;
    params.init(4);
    if f.has_type_params {
      for tp : f.type_params {
        params.push(tp);
      }
    }
    for itp : self.impl_type_params {
      params.push(itp);
    }
    self.active_type_params = params;

    Vec<Vec<str>> previous_param_bounds = self.active_type_param_bounds;
    Vec<Vec<str>> param_bounds;
    param_bounds.init(4);
    if f.has_type_params {
      num tpi = 0;
      for tpi < f.type_params.len {
        Vec<str> flat;
        flat.init(0);
        if f.has_type_param_forced_insts {
          flat = _flat_allowed_for_param(f.type_param_forced_insts, tpi);
        }
        param_bounds.push(flat);
        tpi = tpi + 1;
      }
    }
    // The enclosing impl's own params follow the method's own in
    // `active_type_params` (see above), so their bounds follow here too,
    // copied since every entry is freed when this function is done.
    for ib : self.impl_type_param_bounds {
      Vec<str> ib_copy;
      ib_copy.init(ib.len);
      for ibs : ib {
        ib_copy.push(ibs);
      }
      param_bounds.push(ib_copy);
    }
    self.active_type_param_bounds = param_bounds;

    CheckedType previous = self.rtype;
    flag previous_async = self.in_async;
    self.in_async = f.is_async;
    self.rtype = checked_unknown();
    if f.has_rtype {
      self.rtype = _erase_named(
        _erase_type_params(f, checked_from_dtype(f.rtype)),
        &self.impl_type_params
      );
    }
    self.check_signature_types(f);
    if !self.failed {
      self.check_statement(f.body, &env);
    }
    // The rtype just built above (owned outright, not an alias of
    // `previous`) is done being checked against now - freed before
    // it's overwritten, or every typed function body leaks its own
    // return type on every check.
    _free_checked_type_contents(&self.rtype);
    self.rtype = previous;
    self.in_async = previous_async;
    self.active_type_params.free();
    self.active_type_params = previous_params;
    num fbi = 0;
    for fbi < self.active_type_param_bounds.len {
      self.active_type_param_bounds.data[fbi].free();
      fbi = fbi + 1;
    }
    self.active_type_param_bounds.free();
    self.active_type_param_bounds = previous_param_bounds;
    env.pop();
    env.pop();
  }
}

// Registers `name` as declared at `node`, as `kind` (a human-readable
// label: "a function", "a global variable", "a compound", "an enum"),
// failing `checker` when another declaration already claimed it - a
// function, a global variable, a compound, and an enum each lower to
// their own top-level C symbol or typedef, so any two of them sharing a
// name collide regardless of whether they are the same kind. True when
// this failed (the caller should stop and return the error).
fun _check_duplicate_top_level(Checker* checker, str name, str kind, Node* node) flag {
  let existing = checker.declared_at.at(name);
  if existing.is_some() {
    TopLevelSite site = existing.unwrap();
    checker.fail(
      format(
      "'{str}' is already declared as {str} in {str}:{num}",
      name,
      site.kind,
      site.file,
      site.line
      ),
      node
    );
    ret true;
  }
  TopLevelSite site;
  site.kind = kind;
  site.file = "";
  site.line = 0;
  if node.has_pos {
    site.file = node.pos.filename;
    site.line = node.pos.line;
  }
  checker.declared_at.put(name, site);
  ret false;
}

// Checks a whole program, reporting the first type error it finds.
pub fun typecheck_program(Vec<Node>* nodes) Result<flag, TypeError> {
  Vec<str> no_aliases;
  no_aliases.init(0);
  defer no_aliases.free();
  ret typecheck_program_with_aliases(nodes, &no_aliases);
}

// `typecheck_program`, told which names `use X as name;` actually
// declared across the whole merged program - needed by
// `check_alias_qualified_call` to tell a real module alias apart from
// any other bare name that happens to collide with no local/type (see
// its own doc comment for why). The import merger already tracks this
// (`ProgramMergeResult.aliases`); the plain `.Import` node it came
// from does not survive the merge into `nodes` itself (confirmed
// directly: a scan over `nodes` for `.Import` found none at all, even
// for a program `use`ing several aliased files), so it has to be
// threaded in from there rather than rediscovered here. A caller with
// no merge to draw one from (a single, unimported file, as every test
// in this file's own suite is) passes an empty list through the
// plain `typecheck_program` above instead.
pub fun typecheck_program_with_aliases(
  Vec<Node>* nodes,
  Vec<str>* aliases
) Result<flag, TypeError> {
  Checker checker = _checker_new();
  defer _free_fn_sig_map_borrowed_keys(&checker.fns);
  defer checker.declared_at.free();
  defer checker.shapes.free();
  defer _free_shape_implementors_map(&checker.shape_implementors);
  defer _free_shape_impl_type_params_map(&checker.shape_impl_type_params);
  defer _free_checked_type_map(&checker.shape_elem_by_type);
  defer checker.plain_enums.free();
  defer checker.globals.free();
  defer checker.enum_names.free();
  defer _free_variant_owners_map(&checker.variant_owners);
  defer _free_variant_payloads_map(&checker.variant_payloads);
  defer _free_borrowed_vec_map_str(&checker.enum_type_params);
  defer _free_compound_info_map(&checker.compounds);
  defer _free_method_tables(&checker.methods);
  defer checker.active_type_params.free();
  defer checker.declared_import_aliases.free();

  num ai = 0;
  for ai < aliases.len {
    checker.declared_import_aliases.add(aliases.get(ai));
    ai = ai + 1;
  }

  num i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .Function(f) -> {
        if f.has_name {
          if f.has_body && !f.has_type_params && _is_libc_function_name(f.name) {
            checker.fail(
              format(
              "'{str}' is a C library function the generated C already declares, so a function cannot be defined under this name (rename it)",
              f.name
              ),
              node
            );
            ret .Err(checker.error);
          }
          if _check_duplicate_top_level(&checker, f.name, "a function", node) {
            ret .Err(checker.error);
          }
          FnSig sig = _signature_of(f);
          sig.is_public = node.flags.is_public;
          if node.has_pos {
            sig.file = node.pos.filename;
          }
          // A name that resolves to more than one declaration cannot be
          // matched to one of them here.
          let existing = checker.fns.at(f.name);
          if existing.is_some() {
            sig.ambiguous = true;
          }
          checker.fns.put(f.name, sig);
        }
      }
      .Shape(q) -> {
        if _check_duplicate_top_level(&checker, q.name, "a shape", node) {
          ret .Err(checker.error);
        }
        checker.shapes.add(q.name);
        MethodTable* table = _method_table_new();
        for m : q.methods {
          // A generic shape's methods mention its type parameters, which
          // stand for whatever the implementing type supplies.
          FnSig sig = _signature_of_shape_method(m);
          if q.is_generic {
            sig = _erase_signature(sig, &q.type_params);
          }
          // A fresh copy, not `m.name` itself: every `MethodTable.methods`
          // key is freed as owned when the table itself is (see
          // `_free_fn_sig_map`'s own note), matching `register_impl`'s
          // own always-fresh `_method_leaf_name` result - a table whose
          // keys were a mix of owned and borrowed would free the wrong
          // half no matter which way that cleanup picked.
          table.methods.put(substr(m.name, 0, len(m.name)), sig);
        }
        checker.methods.put(q.name, table);
      }
      .Variable(v) -> {
        if _check_duplicate_top_level(&checker, v.name, "a global variable", node) {
          ret .Err(checker.error);
        }
        GlobalInfo info;
        info.is_public = node.flags.is_public;
        info.file = "";
        if node.has_pos {
          info.file = node.pos.filename;
        }
        checker.globals.put(v.name, info);
      }
      .Enum(e) -> {
        if _check_duplicate_top_level(&checker, e.name, "an enum", node) {
          ret .Err(checker.error);
        }
        // No variants lowers to an empty C `enum`, which is invalid;
        // rejected here rather than left for the C compiler to explain.
        if e.variants.len == 0 {
          checker.fail(
            format("enum '{str}' must declare at least one variant", e.name),
            node
          );
          ret .Err(checker.error);
        }
        flag carries_data = false;
        for v : e.variants {
          if v.has_payload && v.payload.len > 0 {
            carries_data = true;
          }
        }
        checker.enum_names.add(e.name);
        if !carries_data {
          checker.plain_enums.add(e.name);
        }
        Vec<str> enum_params;
        enum_params.init(2);
        if e.has_type_params {
          for tp : e.type_params {
            enum_params.push(tp);
          }
        }
        checker.enum_type_params.put(e.name, enum_params);
        for v : e.variants {
          Vec<CheckedType> payload_types;
          payload_types.init(2);
          if v.has_payload {
            for pd : v.payload {
              if _has_mixed_array_dimensions(pd) {
                checker.fail(MIXED_ARRAY_DIMENSIONS_MSG, node);
                ret .Err(checker.error);
              }
              payload_types.push(checked_from_dtype(pd));
            }
          }
          checker.variant_payloads.put(
            format("{str}.{str}", e.name, v.name),
            payload_types
          );
        }
        for v : e.variants {
          str owner = substr(e.name, 0, len(e.name));
          let existing = checker.variant_owners.at(v.name);
          if existing.is_some() {
            Vec<str> owners = existing.unwrap();
            owners.push(owner);
            checker.variant_owners.put(v.name, owners);
          } else {
            Vec<str> owners2;
            owners2.init(2);
            owners2.push(owner);
            checker.variant_owners.put(v.name, owners2);
          }
        }
      }
      .Compound(c) -> {
        if _check_duplicate_top_level(&checker, c.name, "a compound", node) {
          ret .Err(checker.error);
        }
        CompoundInfo info;
        info.is_public = node.flags.is_public;
        info.file = "";
        if node.has_pos {
          info.file = node.pos.filename;
        }
        info.fields.init(c.fields.len + 1);
        info.type_params.init(0);
        info.bounds.init(0);
        info.is_generic = c.has_type_params && c.type_params.len > 0;
        info.is_union = c.is_union;
        if c.has_type_params {
          for p : c.type_params {
            info.type_params.push(p);
          }
        }
        if c.has_type_param_forced_insts {
          for b : c.type_param_forced_insts {
            info.bounds.push(b);
          }
        }
        for field : c.fields {
          if _has_mixed_array_dimensions(field.dtype) {
            checker.fail(MIXED_ARRAY_DIMENSIONS_MSG, node);
            ret .Err(checker.error);
          }
          info.fields.put(field.name, checked_from_dtype(field.dtype));
        }
        checker.compounds.put(c.name, info);
      }
      .Impl(block) -> {
        checker.register_impl(block);
        if block.has_shape_name {
          checker.record_shape_impl(block.type_name, block.shape_name);
          if block.has_type_params {
            StringBuilder tp_key_sb = string_builder_init(24);
            tp_key_sb.append(block.type_name);
            tp_key_sb.append("::");
            tp_key_sb.append(block.shape_name);
            Vec<str> tp_names;
            tp_names.init(block.type_params.len);
            for tp : block.type_params {
              tp_names.push(tp);
            }
            str tp_key = tp_key_sb.build();
            Vec<Vec<str>> tp_entries;
            tp_entries.init(1);
            let existing_tp = checker.shape_impl_type_params.at(tp_key);
            if existing_tp.is_some() {
              tp_entries = existing_tp.unwrap();
            }
            tp_entries.push(tp_names);
            checker.shape_impl_type_params.put(tp_key, tp_entries);
          }
          if block.has_shape_arg_dtype {
            StringBuilder qeb_key_sb = string_builder_init(24);
            qeb_key_sb.append(block.type_name);
            qeb_key_sb.append("::");
            qeb_key_sb.append(block.shape_name);
            checker.shape_elem_by_type.put(
              qeb_key_sb.build(),
              checked_from_dtype(block.shape_arg_dtype)
            );
          }
        }
      }
      _ -> {}
    }
  }

  _check_c_names(&checker, nodes);
  if checker.failed {
    ret .Err(checker.error);
  }
  checker.check_field_types(nodes);
  if checker.failed {
    ret .Err(checker.error);
  }
  // Every global is checked once, in source order, against one shared
  // env before any function body: an inferred one's own initializer may
  // read an earlier global, and its resolved type is recorded in
  // `global_inferred` for every function body to see (see
  // `check_function_with_self`). Typed globals are bound first, so a
  // forward reference to one still resolves.
  TypeEnv globals_env = type_env_new();
  defer globals_env.free();
  globals_env.push();
  i = 0;
  for i < nodes.len {
    fit nodes.data[i].kind {
      .Variable(gv) -> {
        CheckedType gvt = checked_from_dtype(gv.var_type);
        if !is_unknown(gvt) {
          globals_env.bind(gv.name, gvt, gv.is_const);
        }
        _free_checked_type_contents(&gvt);
      }
      _ -> {}
    }
    i = i + 1;
  }
  i = 0;
  for i < nodes.len {
    Node* gnode = &nodes.data[i];
    i = i + 1;
    fit gnode.kind {
      .Variable(gv) -> {
        checker.current_file = "";
        if gnode.has_pos {
          checker.current_file = gnode.pos.filename;
        }
        checker.check_variable(gnode, gv, &globals_env);
        if checker.failed {
          ret .Err(checker.error);
        }
        CheckedType written = checked_from_dtype(gv.var_type);
        if is_unknown(written) {
          let resolved = globals_env.lookup(gv.name);
          if resolved.is_some() {
            checker.global_inferred.put(gv.name, resolved.unwrap());
          }
        }
        _free_checked_type_contents(&written);
      }
      _ -> {}
    }
  }
  i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .Function(f) -> {
        checker.current_file = "";
        if node.has_pos {
          checker.current_file = node.pos.filename;
        }
        checker.check_function(f, nodes);
      }
      .Impl(block) -> {
        checker.current_file = "";
        if node.has_pos {
          checker.current_file = node.pos.filename;
        }
        checker.check_shape_conformance(block, node);
        checker.check_impl(block, nodes);
      }
      _ -> {}
    }
    if checker.failed {
      ret .Err(checker.error);
    }
  }
  ret .Ok(true);
}

test "a value stands for a type it can be assigned to" {
  CheckedType num_t = checked_of(.Num);
  CheckedType dec_t = checked_of(.Dec);
  CheckedType str_t = checked_of(.Str);
  CheckedType bin_t = checked_of(.Bin);
  assert can_assign(dec_t, num_t), "expected a whole number to widen into a decimal";
  assert !can_assign(num_t, dec_t), "expected a decimal not to narrow on its own";
  assert !can_assign(num_t, str_t), "expected a string not to stand for a number";
  assert !can_assign(num_t, bin_t), "expected a truth value not to stand for a number";
  assert can_assign(checked_unknown(), str_t), "expected an unresolved type to accept anything";
}

test "nil and zero stand for a pointer, and zero stays a number" {
  CheckedType raw_t = checked_of(.Raw);
  raw_t.pointer_depth = 1;
  CheckedType zero = checked_of(.Num);
  zero.is_null_literal = true;
  assert can_assign(raw_t, zero), "expected zero to stand for a null pointer";
  assert can_assign(checked_of(.Num), zero), "expected zero to remain a number";
}

test "an array stands for a pointer to what it holds" {
  CheckedType chars;
  chars = checked_of(.Chr);
  chars.is_array = true;
  chars.array_depth = 1;
  assert can_assign(checked_of(.Str), chars), "expected characters to stand for a string";
}

test "a written type reads back as what it was written as" {
  CheckedType pointer = checked_of(.Num);
  pointer.pointer_depth = 1;
  assert equals(type_name(pointer), "num*"), "expected the pointer spelling";
  CheckedType named = checked_unknown();
  named.name = "Counter";
  assert equals(type_name(named), "Counter"), "expected the written name";
}

test "a scope hides an outer binding of the same name" {
  TypeEnv env = type_env_new();
  defer env.free();
  env.push();
  env.define("x", checked_of(.Num));
  env.push();
  env.define("x", checked_of(.Str));
  let inner = env.lookup("x");
  assert inner.is_some(), "expected the name to resolve";
  assert inner.unwrap().base == .Str, "expected the inner binding";
  env.pop();
  let outer = env.lookup("x");
  assert outer.unwrap().base == .Num, "expected the outer binding to return";
}
