// Lexical scope tracking.

use ..ast.ast;
use std.vec;
use std.string;
use std.c.mem;

// A single declared name (variable, parameter, loop binding, ...) visible
// within a Scope.
pub compound ScopeEntity {
  flag on_stack;
  Node* node;
  flag has_node;
  // True only when `node` is also the exact pointer a `Parser.create_node`
  // call copied *by value* into `state.nodes` for this same declaration
  // (currently just a plain `let`/variable declaration, `parse_variable`) -
  // meaning this struct and that copy share every nested `Node*`/`DataType*`
  // field value, and only `state.nodes`'s own teardown (`free_node_tree`)
  // may free what they point to. Freeing this entity's own `node` still
  // frees `node` itself (the wrapper `malloc(sizeof(Node))` this struct
  // alone owns), just never recurses into its contents.
  flag node_is_shared;
  // True only when `node` is the exact same pointer already owned by
  // something else entirely - currently just `self`, pushed into a
  // method's own `args: Vec<Node*>` by that identical pointer, not a
  // value copy (`parse_impl`). Unlike `node_is_shared`, this struct
  // does not own even the wrapper: freeing it here at all would free
  // the one and only copy `f.args` still points to and still needs.
  // Every other scope entity's own `node` (a destructuring binding, a
  // synthetic `vargs`, a `fit`-arm binding, ...) is registered in
  // scope but never copied or shared anywhere else, so it alone owns
  // what it points to, wrapper and contents both.
  flag node_is_borrowed;
  str name;
  // For multi-dimensional array elements: the root array name used to
  // compute sizeof chain bounds for nested for-iter loops. Empty for
  // non-multidim entities.
  str multidim_root;
  flag has_multidim_root;
  // How many dimensions deep this element is from multidim_root (0 = root
  // itself).
  num multidim_depth;
}

pub fun scope_entity_new(str name) ScopeEntity {
  ScopeEntity e;
  e.on_stack = false;
  e.node = nil;
  e.has_node = false;
  e.node_is_shared = false;
  e.node_is_borrowed = false;
  e.name = name;
  e.multidim_root = "";
  e.has_multidim_root = false;
  e.multidim_depth = 0;
  ret e;
}

// One lexical scope level (a function body, a block, a loop, ...), holding
// the names declared directly in it and a link to its enclosing scope.
pub compound Scope {
  Vec<ScopeEntity*> entities;
  Scope* parent;
  flag has_parent;
}

pub fun scope_new() Scope {
  Scope s;
  s.entities.init(0);
  s.parent = nil;
  s.has_parent = false;
  ret s;
}

// `.name`/`.multidim_root` are borrowed from the AST/tokens, owned
// elsewhere - but `.node` is not, except for `node_is_borrowed`:
// `Parser.new_scope_entity` otherwise always hands this struct a
// freshly `malloc`'d `Node*` of its own, never a pointer anything
// else keeps and frees. Left unfreed, every local, parameter,
// destructuring binding, and synthetic `vargs` in the whole program
// leaked its own declaration node, for as long as the server (or a
// single build's own compile) kept running. `node_is_shared`/
// `node_is_borrowed` (see their own notes on `ScopeEntity`) are the
// two exceptions, checked in that order since a node already fully
// owned elsewhere (`node_is_borrowed`) is never also flagged shared.
fun free_scope_entity(ScopeEntity* e) {
  if e == nil {
    ret;
  }
  if e.has_node && e.node != nil && !e.node_is_borrowed {
    if e.node_is_shared {
      free(e.node);
    } else {
      node_free(e.node);
    }
  }
  free(e);
}

// Frees `s`'s own entities and backing storage, never `.parent`.
pub fun free_scope(Scope* s) {
  if s == nil {
    ret;
  }
  num i = 0;
  for i < s.entities.len {
    free_scope_entity(s.entities.get(i));
    i = i + 1;
  }
  s.entities.free();
  free(s);
}

impl Scope {
  // The most recently declared entity directly in this scope (not its
  // parents), or nil if none.
  pub last_entity_at_scope() ScopeEntity* {
    if self.entities.len == 0 {
      ret nil;
    }
    ret self.entities.get(self.entities.len - 1);
  }

  // Walks up the parent chain for the last-declared entity, stopping at (not
  // including) `stop_scope`. `stop_scope` may be nil to search the whole chain.
  pub last_entity_from_scope_stop_at(Scope* stop_scope) ScopeEntity* {
    if self == stop_scope {
      ret nil;
    }
    let last = self.last_entity_at_scope();
    if last != nil {
      ret last;
    }
    if self.has_parent {
      ret self.parent.last_entity_from_scope_stop_at(stop_scope);
    }
    ret nil;
  }

  // Looks up an entity declared directly in this scope (not its parents) by
  // name, or nil if not found.
  pub get_entity_by_name(str name) ScopeEntity* {
    num i = 0;
    for i < self.entities.len {
      let e = self.entities.get(i);
      if equals(e.name, name) {
        ret e;
      }
      i = i + 1;
    }
    ret nil;
  }

  // Scope does not own the entity pointers (some call sites hold pointers to
  // stack-allocated entities); only the backing vector is freed.
  pub deinit() {
    self.entities.free();
  }
}
