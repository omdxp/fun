test "a string is written with what JSON reserves escaped" {
  assert equals(json_quote("plain"), `"plain"`), "expected a plain string to be quoted";
  assert equals(json_quote(`say "hi"`), `"say \"hi\""`), "expected the quotes to be escaped";
  assert equals(json_quote("a\nb"), `"a\nb"`), "expected the newline to be escaped";
  assert equals(json_quote("a\\b"), `"a\\b"`), "expected the backslash to be escaped";
}

test "a string with non-ASCII UTF-8 bytes is passed through unescaped" {
  // `chr` is a signed C `char`, so a UTF-8 lead/continuation byte
  // (>= 0x80) reads as negative; regression test for that byte
  // getting misread as a C0 control character and escaped as a bare
  // `\u` with no hex digits (an unparseable JSON string).
  str s = "caf\xC3\xA9";
  let q = json_quote(s);
  assert equals(q, "\"caf\xC3\xA9\""), "expected the UTF-8 bytes to pass through untouched";
  assert !contains(q, "\\u"), "expected no \\u escape for a non-control byte";
}

test "path_to_uri percent-encodes a non-ASCII byte with real hex digits, not a bare '%'" {
  // Same root cause as json_quote's own already-fixed bug above:
  // `chr` is a signed C char, so a UTF-8 lead/continuation byte (>=
  // 0x80) reads as negative here too. to_hex_upper returns "" for a
  // negative input, so without normalizing first, every non-ASCII
  // path byte percent-encoded as a bare "%" with no hex code
  // following it - a malformed URI for any file path with a non-ASCII
  // character in it.
  str uri = path_to_uri("/tmp/caf\xC3\xA9.fn");
  assert contains(uri, "%C3%A9"), "expected real hex digits for the non-ASCII byte";
  assert !contains(uri, "%.fn") && !contains(uri, "% "), "expected no bare '%' with nothing after it";
}

test "a header name is read whatever case it is written in" {
  assert starts_with_ignore_case("Content-Length: 5", "content-length:"), "expected the header to be recognized";
  assert starts_with_ignore_case("content-length: 5", "Content-Length:"), "expected either case to match";
  assert !starts_with_ignore_case("Content-Type: x", "content-length:"), "expected a different header not to match";
}

test "a reply carries the id it answers" {
  assert contains(response("1", "null"), `"id":1`), "expected a numeric id to be echoed";
  assert contains(response(`"abc"`, "null"), `"id":"abc"`), "expected a string id to be echoed";
  assert contains(response("1", `{"ok":true}`), `"result":{"ok":true}`), "expected the result to be carried";
}

test "a refusal names what could not be done" {
  str refusal = error_response("2", -32601, "unsupported request 'x'");
  assert contains(refusal, `"code":-32601`), "expected the code";
  assert contains(refusal, "unsupported request"), "expected the message";
  assert contains(refusal, `"id":2`), "expected the id";
}

test "a notification carries no id" {
  str note = notification("textDocument/publishDiagnostics", `{"uri":"file:///a.fn"}`);
  assert contains(note, `"method":"textDocument/publishDiagnostics"`), "expected the method";
  assert !contains(note, `"id"`), "expected no id on a notification";
}

test "a sink reads a line and then the bytes that follow it" {
  make_dir_all("fun-out");
  str path = "fun-out/_sink_read.txt";
  write_string(path, "Content-Length: 5\r\n\r\nhello");
  defer remove_file(path);

  File f = open_read(path);
  Sink source = Sink.File(f);
  defer f.close();

  str header = source.read_line_max(64);
  assert equals(trim(header), "Content-Length: 5"), "expected the header line";
  str blank = source.read_line_max(64);
  assert equals(trim(blank), ""), "expected the blank line ending the headers";
  str body = source.read_bytes(5);
  assert equals(body, "hello"), "expected exactly the bytes the header named";
}

test "a number is written as hexadecimal, padded to a width" {
  assert equals(to_hex(0, 4), "0000"), "expected zero padded to the width";
  assert equals(to_hex(255, 2), "ff"), "expected the lower-case digits";
  assert equals(to_hex_upper(255, 2), "FF"), "expected the upper-case digits";
  assert equals(to_hex(10, 4), "000a"), "expected the padding to fill";
  assert equals(to_hex(4096, 4), "1000"), "expected a value filling the width";
  assert equals(to_hex(65536, 4), "10000"), "expected a wider value to keep its digits";
}

test "a position lands on the token the cursor is in" {
  let lexed = tokenize("fun main() num {\n  num total = 1;\n  ret total;\n}\n", "pos.fn");
  assert lexed.is_ok(), "expected the source to lex";
  Vec<Token> tokens = lexed.unwrap();
  defer tokens.free();

  // Line and character are both counted from zero on the wire.
  let on_name = token_at(&tokens, 1, 6);
  assert on_name.is_some(), "expected a token under the cursor";
  assert equals(token_word(on_name.unwrap()), "total"), "expected the name being declared";

  // The last character of a token still counts as being on it, which is
  // where a cursor rests inside a word.
  let at_end = token_at(&tokens, 1, 10);
  assert at_end.is_some(), "expected the cursor at a token's last character to land on it";
  assert equals(token_word(at_end.unwrap()), "total"), "expected the same name";

  // Whitespace belongs to no token.
  assert token_at(&tokens, 1, 11).is_none(), "expected nothing under a space";
}

test "utf8_seq_len classifies a lead byte's own UTF-8 sequence length" {
  str ascii = "a";
  assert utf8_seq_len(ascii[0]) == 1, "expected ASCII to be a one-byte sequence";
  // U+00E9 (e-acute), a 2-byte UTF-8 lead.
  str two = "\xC3\xA9";
  assert utf8_seq_len(two[0]) == 2, "expected a 2-byte lead";
  // U+4E2D (中), a 3-byte UTF-8 lead.
  str three = "\xE4\xB8\xAD";
  assert utf8_seq_len(three[0]) == 3, "expected a 3-byte lead";
  // U+1F600 (an emoji), a 4-byte UTF-8 lead, past the Basic Multilingual
  // Plane.
  str four = "\xF0\x9F\x98\x80";
  assert utf8_seq_len(four[0]) == 4, "expected a 4-byte lead";

  assert utf16_units_for_utf8_seq_len(1) == 1, "expected one UTF-16 unit for ASCII";
  assert utf16_units_for_utf8_seq_len(2) == 1, "expected one UTF-16 unit still within the BMP";
  assert utf16_units_for_utf8_seq_len(3) == 1, "expected one UTF-16 unit still within the BMP";
  assert utf16_units_for_utf8_seq_len(4) == 2, "expected a surrogate pair past the BMP";
}

test "byte and UTF-16 columns convert correctly across a non-ASCII line" {
  // "café " - c/a/f/space are one byte each, e-acute is 2 UTF-8 bytes
  // but still one UTF-16 unit, so the line is 6 bytes but only 5
  // UTF-16 units wide.
  str text = "caf\xC3\xA9 x\n";

  // The client's own UTF-16 count for "x" (just past "café ") is 5;
  // that must land on byte offset 6, not byte offset 5 (which would
  // still be inside the e-acute's own second byte).
  assert utf16_char_to_byte_col(text, 0, 5) == 6, "expected the UTF-16 count to skip the full 2-byte character";

  // The reverse: byte offset 6 (the 'x') is UTF-16 character 5, not 6.
  assert byte_col_to_utf16_char(text, 0, 6) == 5, "expected the byte column to collapse to one UTF-16 unit for the 2-byte character";

  // A plain ASCII prefix converts as the identity, the common case.
  assert utf16_char_to_byte_col(text, 0, 2) == 2, "expected ASCII columns to pass through unchanged";
  assert byte_col_to_utf16_char(text, 0, 2) == 2, "expected ASCII columns to pass through unchanged";

  // offset_of (used for didChange edits) takes the same UTF-16 count
  // and returns the absolute byte offset in the whole document.
  assert offset_of(text, 0, 5) == 6, "expected offset_of to land on the byte after the 2-byte character";
}

test "a generic method on a let-inferred receiver specializes, not the bare template" {
  str src = `compound Box<T> {
  `  T val;
  `}
  `impl Box<T> {
  `  pub get() T {
  `    ret self.val;
  `  }
  `}
  `fun make() Box<str> {
  `  Box<str> b;
  `  b.val = "x";
  `  ret b;
  `}
  `fun use_it() str {
  `  let b = make();
  `  ret b.get();
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///generic_let_receiver.fn";
  doc.path = "generic_let_receiver.fn";
  doc.text = src;
  doc.version = 1;

  // Mid-word on "get".
  str hovered = hover(&reads, doc, 15, 9);
  assert contains(hovered, "get(Box<str>* self) str"), "expected the concrete specialized return type (str), not the bare template T";
  assert !contains(hovered, "self) T"), "expected no unspecialized template leaking through";
}

test "hover and inlay hints show a let-inferred local's own concrete generic type, not just the bare template" {
  str src = `imp std.option;
  `fun make() Option<num> {
  `  Option<num> o;
  `  ret o;
  `}
  `fun main() num {
  `  let r = make();
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///letgeneric.fn";
  doc.path = "letgeneric.fn";
  doc.text = src;
  doc.version = 1;

  // Hover on 'r' (line 6, "  let r = make();", col 6).
  str hovered = hover(&reads, doc, 6, 6);
  assert contains(hovered, "Option<num> r"), "expected the concrete generic arg (num), not just the bare 'Option'";

  str hints = inlay_hints(&reads, doc, 0, 8);
  assert contains(hints, `": Option<num>"`), "expected the same concrete generic arg in the inlay hint";
}

test "definition_workspace_wide respects cross-file pub visibility" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();

  docs.opened(
    "file:///vis_other.fn",
    `fun hidden() num {
    `  ret 1;
    `}
    `pub fun shown() num {
    `  ret 2;
    `}`,
    1
  );

  Document doc;
  doc.uri = "file:///vis_main.fn";
  doc.path = "vis_main.fn";
  doc.text = `fun use_hidden() num {
  `  ret hidden();
  `}
  `fun use_shown() num {
  `  ret shown();
  `}`;
  doc.version = 1;

  // "hidden" is declared in another file and never made pub: a
  // workspace-wide jump must not treat it as the target just because
  // the name matches.
  str hidden_result = definition_workspace_wide(&reads, &docs, &symbols, doc, 1, 8);
  assert equals(hidden_result, "[]"), "expected a private cross-file symbol not to be offered as a definition target";

  // "shown" is pub, so it's a legitimate cross-file jump target.
  str shown_result = definition_workspace_wide(&reads, &docs, &symbols, doc, 4, 8);
  assert contains(shown_result, "vis_other.fn"), "expected a pub cross-file symbol to resolve normally";
}

test "hover and definition resolve a method called on a let-inferred local" {
  str src = `compound Box {
  `  num width;
  `}
  `impl Box {
  `  pub doubled() num {
  `    ret self.width * 2;
  `  }
  `}
  `fun make() Box {
  `  Box b;
  `  b.width = 3;
  `  ret b;
  `}
  `fun use_it() num {
  `  let box = make();
  `  ret box.doubled();
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///let_receiver.fn";
  doc.path = "let_receiver.fn";
  doc.text = src;
  doc.version = 1;

  // `box` is a `let`-inferred local, never explicitly typed; hovering
  // and jumping to `doubled` needs the receiver's real type re-derived
  // from its own initializer, not the permanent __let_infer__
  // sentinel `box`'s own declaration detail otherwise carries.
  str hovered = hover(&reads, doc, 15, 10);
  assert contains(hovered, "doubled"), "expected hover to resolve the method on a let-inferred receiver";
  assert !equals(hovered, "null"), "expected a real hover, not null";

  str jumped = definition(&reads, doc, 15, 10);
  assert contains(jumped, "let_receiver.fn"), "expected go-to-definition to resolve to the same file";
  assert !equals(jumped, "[]"), "expected a real location, not an empty result";
}

test "diagnose caches per document revision, and drops the cache once the revision changes" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  DiagnosticsCache dcache = diagnostics_cache_new();
  defer dcache.free();

  Document doc;
  doc.uri = "file:///diag_cache.fn";
  doc.path = "diag_cache.fn";
  doc.text = `fun main() num {
  `  num unused_var = 1;
  `  ret 0;
  `}`;
  doc.version = 1;

  Vec<Diagnostic> first = diagnose(&reads, &dcache, doc);
  num first_len = first.len;
  assert first_len > 0, "expected an unused-variable warning";
  first.free();

  // Same revision: a second call must not crash freeing what it gets
  // back, and must still see the same finding (the cached copy, not a
  // fresh but broken re-typecheck).
  Vec<Diagnostic> second = diagnose(&reads, &dcache, doc);
  assert second.len == first_len, "expected the cached result to match";
  second.free();

  // A new revision with the warning fixed must not keep returning the
  // stale cached diagnostics.
  doc.version = 2;
  doc.text = `fun main() num {
  `  num used_var = 1;
  `  ret used_var;
  `}`;
  Vec<Diagnostic> third = diagnose(&reads, &dcache, doc);
  assert third.len == 0, "expected the stale warning to be gone once the revision changed";
  third.free();
}

test "an unmet expect diagnoses as an error, at the expect statement's own position" {
  // `analyze`'s own unmet-expectation case used to surface as
  // DIAG_SEVERITY_WARNING at file start (0,0), always - it's a genuine
  // compile error (the CLI fails the build over the same condition),
  // and now carries the expect statement's own position.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  DiagnosticsCache dcache = diagnostics_cache_new();
  defer dcache.free();

  Document doc;
  doc.uri = "file:///unmet_expect.fn";
  doc.path = "unmet_expect.fn";
  doc.text = `compound Hidden {
  `  num value;
  `}
  `
  `  expect unused_compound, "this expectation will never be met";
  `
  `fun main() num {
  `  Hidden h;
  `  h.value = 1;
  `  ret h.value;
  `}`;
  doc.version = 1;

  Vec<Diagnostic> diags = diagnose(&reads, &dcache, doc);
  defer diags.free();
  assert diags.len == 1, "expected exactly the unmet-expectation diagnostic";
  Diagnostic d = diags.get(0);
  assert d.severity == DIAG_SEVERITY_ERROR, "expected the unmet expectation to be an error, not a warning";
  assert d.line == 4, "expected the expect statement's own line, not file start";
  assert d.col == 2, "expected the expect statement's own column, not file start";
}

test "hover documents sizeof, never a real declared symbol" {
  // Never a lexer keyword, contextual like fork, resolved purely from
  // the identifier's own word before ever trying ordinary name
  // resolution.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///sizeof_hover.fn";
  doc.path = "sizeof_hover.fn";
  doc.text = `fun main() num {
  `  ret sizeof(num);
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 1, 8);
  assert contains(hovered, "sizeof(Type)"), "expected the sizeof(Type) skeleton";
  assert contains(hovered, "compile time"), "expected the doc explaining it's compile-time";
}

test "PACKAGE_NAME and PACKAGE_VERSION resolve as ordinary declared constants, from this workspace's own fun.toml" {
  // Neither is written anywhere in source: fun build injects both as
  // synthetic AST nodes ahead of the program's own declarations before
  // type-checking (manifest_defines/manifest_const_node), so source
  // analysis alone (fls's own parse, with no build step involved) has
  // never seen either one and would otherwise resolve nothing at all,
  // the same as any other undeclared name. AnalysisCache mirrors that
  // same injection for its own merged program, reading fun.toml from
  // the process's own working directory exactly like fun build does -
  // this test relies on the one this whole test suite already runs
  // from (the fun project's own repo root), not a fixture of its own.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///pkgconst.fn";
  doc.path = "pkgconst.fn";
  doc.text = `fun main() {
  `  println(PACKAGE_NAME);
  `  println(PACKAGE_VERSION);
  `}`;
  doc.version = 1;

  str name_hover = hover(&reads, doc, 1, 12);
  assert contains(name_hover, `const str PACKAGE_NAME = \"`), "expected PACKAGE_NAME to resolve as a declared string constant";
  str version_hover = hover(&reads, doc, 2, 12);
  assert contains(version_hover, `const str PACKAGE_VERSION = \"`), "expected PACKAGE_VERSION to resolve as a declared string constant";
}

test "hovering a stdlib import path segment resolves at every depth" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///stdlib_hover_probe.fn";
  doc.path = "src/tests/fixtures/stdlib_hover_probe.fn";
  doc.text = "imp std.c.io;\n\nfun main() num {\n  ret 0;\n}\n";
  doc.version = 1;

  // `std` alone: the stdlib root's own README.
  str std_hover = hover(&reads, doc, 0, 5);
  assert !equals(std_hover, "null"), "expected std to resolve to the stdlib root's README";

  // `std.c`: a real directory with no README of its own.
  str c_hover = hover(&reads, doc, 0, 8);
  assert contains(c_hover, "Directory:"), "expected a directory fallback for an undocumented namespace segment";

  // `std.c.io`: a real module file.
  str io_hover = hover(&reads, doc, 0, 11);
  assert !equals(io_hover, "null"), "expected std.c.io to resolve to its own module file";
}

test "compound-init literal offers only the type's own field names" {
  str src = `compound Point {
  `  num x;
  `  num y;
  `}
  `fun make() Point {
  `  ret Point{ x = 1,  };
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///init.fn";
  doc.path = "init.fn";
  doc.text = src;
  doc.version = 1;

  // Cursor sits between the trailing comma and the closing brace, on
  // `  ret Point{ x = 1,  };`.
  str out = completion(&reads, doc, 5, 20, false);
  assert contains(out, `"label":"y"`), "expected the still-unset field to be offered";
  assert !contains(out, `"label":"make"`), "expected the surrounding scope's own declarations not to leak in here";
}

test "completion offers a generic type snippet with a tab stop per type param" {
  str src = `compound Box<T> {
  `  T val;
  `}
  `enum Result<T, E> {
  `  Ok(T),
  `  Err(E),
  `}
  `compound Point {
  `  num x;
  `}
  `fun caller() num {
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///generic_snippet.fn";
  doc.path = "generic_snippet.fn";
  doc.text = src;
  doc.version = 1;

  // Mid-word inside caller()'s own body, snippets on.
  str out = completion(&reads, doc, 10, 6, true);
  assert contains(out, `"label":"Box"`), "expected the generic compound";
  assert contains(out, `"insertText":"Box<${1:T}>$0","insertTextFormat":2`), "expected one tab stop for Box's own type param";
  assert contains(out, `"insertText":"Result<${1:T}, ${2:E}>$0","insertTextFormat":2`), "expected two tab stops for Result's own type params";

  // A non-generic compound carries no snippet at all.
  assert contains(out, `"label":"Point","kind":22,"detail":"compound"}`), "expected no snippet for a non-generic type";
}

test "a function completion item carries structured labelDetails" {
  str src = `fun probe(str name, num count) bin {
  `  ret true;
  `}
  `fun caller() bin {
  `  ret probe("x", 1);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///labeldetails.fn";
  doc.path = "labeldetails.fn";
  doc.text = src;
  doc.version = 1;

  // Params dimmed, return type right-aligned.
  str out = completion(&reads, doc, 4, 8, true);
  assert contains(out, `"labelDetails":{"detail":"(str name, num count)","description":"bin"}`), "expected structured labelDetails for the function";

  // Reserved words carry no labelDetails at all.
  assert !contains(out, `"label":"ret","kind":14,"detail":"declaration","labelDetails"`), "expected no labelDetails on a keyword";
}

test "a method completion item's own labelDetails excludes the implicit self" {
  str src = `compound Buffer {
  `  num len;
  `}
  `impl Buffer {
  `  pub resize(num n) bin { self.len = n; ret true; }
  `}
  `fun helper(Buffer b) bin {
  `  ret b.resize(1);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///labeldetails_method.fn";
  doc.path = "labeldetails_method.fn";
  doc.text = src;
  doc.version = 1;

  // Right after `b.re`.
  str out = completion(&reads, doc, 7, 10, true);
  assert contains(out, `"labelDetails":{"detail":"(num n)","description":"bin"}`), "expected self excluded from the method's own labelDetails, matching its snippet";
}

test "completion offers a call snippet with one tab stop per parameter" {
  str src = `fun probe(str name, num count) bin {
  `  ret true;
  `}
  `fun caller() bin {
  `  ret probe("x", 1);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///snippet_call.fn";
  doc.path = "snippet_call.fn";
  doc.text = src;
  doc.version = 1;

  // Mid-word on "probe", snippets on.
  str out = completion(&reads, doc, 4, 8, true);
  assert contains(out, `"label":"probe"`), "expected the function itself";
  assert contains(out, `"insertText":"probe(${1:name}, ${2:count})$0","insertTextFormat":2`), "expected a snippet with one tab stop per parameter";

  // Same position, snippets off: plain label insertion, no snippet.
  str out_plain = completion(&reads, doc, 4, 8, false);
  assert contains(out_plain, `"label":"probe"`), "expected the function itself";
  assert !contains(out_plain, `"insertText"`), "expected no snippet when the client doesn't support one";
}

test "dot-completion offers a method's own call snippet too" {
  str src = `compound Buffer {
  `  num len;
  `}
  `impl Buffer {
  `  pub resize(num n) { self.len = n; }
  `}
  `fun helper(Buffer b) num {
  `  b.resize(1);
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///snippet_method.fn";
  doc.path = "snippet_method.fn";
  doc.text = src;
  doc.version = 1;

  // Right after `b.re`, snippets on.
  str out = completion(&reads, doc, 7, 6, true);
  assert contains(out, `"label":"resize"`), "expected the method itself";
  assert contains(out, `"insertText":"resize(${1:n})$0","insertTextFormat":2`), "expected the method's own call snippet";
}

test "dot-completion merges a method declared in a different file than the type" {
  str helper_src = `pub compound Widget {
  `  num n;
  `}
  `impl Widget {
  `  pub value() num {
  `    ret self.n;
  `  }
  `}`;
  write_string("src/tests/fixtures/_cross_method_helper.fn", helper_src);
  defer remove_file("src/tests/fixtures/_cross_method_helper.fn");

  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///cross_method_probe.fn";
  doc.path = "src/tests/fixtures/_cross_method_probe.fn";
  doc.text = `imp _cross_method_helper;
  `fun use_it(Widget w) num {
  `  ret w.value();
  `}`;
  doc.version = 1;

  // Right after `w.`, mid-word on the line that reads it.
  str out = completion(&reads, doc, 2, 8, false);
  assert contains(out, `"label":"value"`), "expected a method declared in a different file (via imp) to be offered";
}

test "a bare capitalized condition isn't mistaken for a compound-init literal" {
  str src = `const bin Ready = true;
  `fun check() num {
  `  if Ready {
  `    ret 1;
  `  }
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///cond.fn";
  doc.path = "cond.fn";
  doc.text = src;
  doc.version = 1;

  // Cursor right inside the `if Ready { }` block, which looks exactly
  // like a compound-init literal at the token level (a capitalized
  // identifier followed by `{`) but isn't one, since `Ready` names no
  // compound.
  str out = completion(&reads, doc, 3, 4, false);
  assert contains(out, `"label":"ret"`), "expected the ordinary block's own scope completion, not field completion";
}

test "publish with no findings clears an editor's own diagnostics for a document" {
  Vec<Diagnostic> none;
  none.init(0);
  str note = publish("file:///closed.fn", "", &none);
  assert contains(note, `"method":"textDocument/publishDiagnostics"`), "expected the publish notification";
  assert contains(note, `"uri":"file:///closed.fn"`), "expected the closed document's own uri";
  assert contains(note, `"diagnostics":[]`), "expected an empty diagnostics array, which is what clears the gutter";
}

test "a non-BMP character counts as two UTF-16 units, a surrogate pair" {
  // "x\xF0\x9F\x98\x80y" - the emoji is 4 UTF-8 bytes but 2 UTF-16
  // units (a surrogate pair), so 'y' sits at UTF-16 character 3, not 2.
  str text = "x\xF0\x9F\x98\x80y\n";
  assert byte_col_to_utf16_char(text, 0, 5) == 3, "expected the astral character to cost two UTF-16 units";
  assert utf16_char_to_byte_col(text, 0, 3) == 5, "expected UTF-16 character 3 to land right after the emoji's 4 bytes";
}

test "a pointer type keeps its star when spelled back" {
  str src = `compound Holder {
  `  Vec<str>* data;
  `  num len;
  `}
  `fun probe(Holder* h, num len) num { ret len; }`;
  let merged = parse_program_with_source("hover.fn", src);
  assert merged.is_ok(), "expected the program to parse";
  ProgramMergeResult program = merged.unwrap();

  // A field declared as a pointer is reported as one: the old server
  // dropped the star here.
  Vec<str> no_args;
  no_args.init(0);
  let field = lookup_field(&program.nodes, "Holder", "data", no_args);
  assert field.is_some(), "expected the field to resolve";
  assert equals(field.unwrap().detail, "Vec<str>* data"), "expected the pointer spelling kept";
}

test "an impl method's own is_public matches whether it was actually written pub" {
  str src = `compound Widget {
  `  num n;
  `}
  `impl Widget {
  `  helper() num {
  `    ret 1;
  `  }
  `  pub shown() num {
  `    ret 2;
  `  }
  `}`;
  let merged = parse_program_with_source("methodvis.fn", src);
  assert merged.is_ok(), "expected the program to parse";
  ProgramMergeResult program = merged.unwrap();

  Vec<str> no_args;
  no_args.init(0);
  defer no_args.free();

  // A method's own pub keyword is real, checked by the compiler
  // (typecheck.fn's own check_visibility) exactly like a top-level
  // function's - a hardcoded true here would let fls treat a private
  // method as visible from anywhere, which it isn't.
  let hidden = lookup_method(&program.nodes, "Widget", "helper", no_args);
  assert hidden.is_some(), "expected the private method to still resolve locally";
  assert !hidden.unwrap().is_public, "expected a method with no pub keyword to be marked private";

  let shown = lookup_method(&program.nodes, "Widget", "shown", no_args);
  assert shown.is_some(), "expected the pub method to resolve";
  assert shown.unwrap().is_public, "expected a method written pub to be marked public";

  // The declaration-site lookup (met at the method's own line, not
  // through a receiver) carries the same real visibility.
  let hidden_at = lookup_field_at(&program.nodes, "methodvis.fn", 5, "helper");
  assert hidden_at.is_some(), "expected the declaration-site lookup to resolve too";
  assert !hidden_at.unwrap().is_public, "expected the same private visibility at the declaration site";
}

test "a local name wins over a function of the same name" {
  str src = `compound Holder {
  `  num len;
  `}
  `fun probe(Holder* h, num len) num { ret len; }`;
  let merged = parse_program_with_source("hover.fn", src);
  assert merged.is_ok(), "expected the program to parse";
  ProgramMergeResult program = merged.unwrap();

  // `len` is a parameter here, not the standard library's function, and
  // resolving from the inside out is what tells them apart.
  let found = lookup(nil, &program.nodes, "len", "hover.fn", 4);
  assert found.is_some(), "expected the name to resolve";
  assert equals(found.unwrap().detail, "num len"), "expected the parameter, not a function";
}

test "a function is spelled back as its signature" {
  str src = `fun probe(str name, num count) bin { ret true; }`;
  let merged = parse_program_with_source("sig.fn", src);
  assert merged.is_ok(), "expected the program to parse";
  ProgramMergeResult program = merged.unwrap();

  let found = lookup_top_level(&program.nodes, "probe");
  assert found.is_some(), "expected the function to resolve";
  assert equals(found.unwrap().detail, "fun probe(str name, num count) bin"), "expected the whole signature";
}

test "hover appends a 'See also' footer linking a user-defined type in the signature" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///seealso.fn";
  doc.path = "seealso.fn";
  doc.text = `compound Point {
  `  num x;
  `}
  `fun make() Point {
  `  Point p;
  `  ret p;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 3, 5);
  assert contains(hovered, "See also:"), "expected the footer to appear";
  assert contains(hovered, "[`Point`]"), "expected a link to the return type";
  assert contains(hovered, "#L1"), "expected the link to point at Point's own declaration line";

  // A quirk name is resolved the same way (lookup_top_level previously
  // had no case for it at all, so a quirk-typed parameter never
  // resolved here).
  Document quirk_doc;
  quirk_doc.uri = "file:///seealsoquirk.fn";
  quirk_doc.path = "seealsoquirk.fn";
  quirk_doc.text = `quirk Greeter {
  `  greet() str;
  `}
  `fun announce(Greeter* g) str {
  `  ret g.greet();
  `}`;
  quirk_doc.version = 1;
  str quirk_hovered = hover(&reads, quirk_doc, 3, 5);
  assert contains(quirk_hovered, "See also:"), "expected the footer for a quirk-typed parameter too";
  assert contains(quirk_hovered, "[`Greeter`]"), "expected a link to the quirk's own declaration";
}

test "the 'See also' footer never links a cross-file type that isn't pub" {
  // A diamond import: the probe imports a lib file, which itself
  // imports a private type. The probe's own merged program ends up
  // carrying that private type's declaration even though the probe
  // could never legitimately name it itself - `_see_also_footer`
  // used to resolve any capitalized word in a hovered signature
  // blind to this, so it could link straight to it anyway.
  write_string("src/tests/fixtures/_see_also_priv.fn", `compound Secret {
  `  num x;
  `}`);
  defer remove_file("src/tests/fixtures/_see_also_priv.fn");
  write_string(
    "src/tests/fixtures/_see_also_lib.fn",
    `imp _see_also_priv;
    `pub fun make() Secret {
    `  Secret s;
    `  ret s;
    `}`
  );
  defer remove_file("src/tests/fixtures/_see_also_lib.fn");

  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///see_also_probe.fn";
  doc.path = "src/tests/fixtures/_see_also_probe.fn";
  doc.text = `imp _see_also_lib;
  `fun user() num {
  `  let s = make();
  `  ret 0;
  `}`;
  doc.version = 1;

  // On `make` in `let s = make();`.
  str hovered = hover(&reads, doc, 2, 12);
  assert contains(hovered, "fun make() Secret"), "expected make's own signature";
  assert !contains(hovered, "See also"), "expected no footer at all: Secret is not pub, and nothing else in the signature resolves";
}

test "hover on a primitive-typed field still links back to its own compound" {
  // A `num` field has no type name of its own in its rendered detail
  // to pull a 'See also' candidate from, but the compound it belongs
  // to is still worth linking.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///containerlink.fn";
  doc.path = "containerlink.fn";
  doc.text = `compound Counter {
  `  num value;
  `}
  `fun bump(Counter* c) {
  `  c.value = c.value + 1;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 3, 5);
  assert contains(hovered, "See also:"), "expected the footer linking the field's own compound";
  assert contains(hovered, "[`Counter`]"), "expected a link back to Counter itself";
}

test "hover resolves a parameter or local declared inside an impl method's own body" {
  // _lookup_local only ever walked top-level .Function nodes; an impl
  // block's own methods (also FunctionNodes, just nested one level
  // deeper under .Impl) were never reached at all, so every hover on
  // a method's own parameter or local resolved to nothing, in a
  // codebase almost entirely made of impl methods.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///implocal.fn";
  doc.path = "implocal.fn";
  doc.text = `compound Server {
  `  num count;
  `}
  `impl Server {
  `  bump(num message) {
  `    num delta = message;
  `    self.count = self.count + delta;
  `  }
  `}`;
  doc.version = 1;

  // The method's own parameter, at its use site (the right side of
  // 'num delta = message;', line 5).
  str param_hover = hover(&reads, doc, 5, 16);
  assert contains(param_hover, "num message"), "expected the method's own parameter to resolve";

  // The local it's assigned to, at its own declaration site.
  str local_decl_hover = hover(&reads, doc, 5, 8);
  assert contains(local_decl_hover, "num delta"), "expected the method's own local to resolve at its declaration";

  // The same local, at a later use (line 6).
  str local_use_hover = hover(&reads, doc, 6, 30);
  assert contains(local_use_hover, "num delta"), "expected the method's own local to resolve at a use too";
}

test "typeDefinition jumps to a local's declared type, and to itself when hovering the type directly" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///typedef.fn";
  doc.path = "typedef.fn";
  doc.text = `compound Point {
  `  num x;
  `  num y;
  `}
  `fun main() num {
  `  Point p;
  `  ret p.x;
  `}`;
  doc.version = 1;

  // Hovering the local 'p' jumps to Point's own declaration, not p's.
  str from_local = type_definition(&reads, doc, 5, 8);
  assert contains(from_local, `"line":0`), "expected a jump to Point's own line, not the local's";
  assert contains(from_local, `"character":9`), "expected the range to land on Point's own name";

  // Hovering 'Point' itself (the type reference on the same line)
  // jumps to itself, same as plain definition.
  str from_type_name = type_definition(&reads, doc, 5, 2);
  assert contains(from_type_name, `"line":0`), "expected Point hovered directly to resolve to itself";
}

test "typeDefinition on a method call jumps to its own declared return type" {
  // d.detail reads as a full "name(args) RetType" signature for a
  // function/method, not a bare "Type name" pair. bare_type_from_detail
  // (built for the "Type name" shape) mistook the whole signature text
  // for a type name and found nothing.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///typedefcall.fn";
  doc.path = "typedefcall.fn";
  doc.text = `compound Engine {
  `  num rpm;
  `}
  `compound Car {
  `  Engine engine;
  `}
  `impl Car {
  `  own() Engine {
  `    ret self.engine;
  `  }
  `}
  `fun main() num {
  `  Car c;
  `  ret c.own().rpm;
  `}`;
  doc.version = 1;

  str from_call = type_definition(&reads, doc, 13, 8);
  assert contains(from_call, `"line":0`), "expected a jump to Engine's own declaration";
  assert contains(from_call, `"character":9`), "expected the range to land on Engine's own name";
}

test "hover on a method's own declaration name resolves, unlike hovering it through nothing at all before" {
  // No path in _resolve covered a method's own name at its own
  // declaration site (not reached through a receiver): lookup_field_at
  // handled compound fields and enum variants there, but never an
  // impl block's own methods.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///methodself.fn";
  doc.path = "methodself.fn";
  doc.text = `compound Widget {
  `  num n;
  `}
  `impl Widget {
  `  demo() {}
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 4, 2);
  assert contains(hovered, "demo(Widget* self)"), "expected the method's own signature, self included";
  assert contains(hovered, "[`Widget`]"), "expected a See also link back to its own compound";
}

test "doc comments left-trim stray extra indentation in prose, but keep a fenced example's own indentation" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///docfence.fn";
  doc.path = "docfence.fn";
  doc.text = `// A demo function.
  `//
  `//    Extra-indented prose, not inside a fence.
  `//
  `// ``````fun
  `// fit x {
  `//   Case -> {}
  `// }
  `// ``````
  `fun demo() {}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 9, 4);
  assert contains(hovered, "Extra-indented prose, not inside a fence."), "expected the stray leading spaces trimmed off";
  assert !contains(hovered, "   Extra-indented"), "expected no residual indentation left on the prose line";
  assert contains(hovered, "  Case -> {}"), "expected the fenced example's own inner indentation kept";
}

test "go-to-definition on a compound field or enum variant lands on its own declaration line, not the type's" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///owndecl.fn";
  doc.path = "owndecl.fn";
  doc.text = `compound Point {
  `  num x;
  `  num y;
  `}
  `enum Color {
  `  Red,
  `  Green,
  `}
  `fun main() {
  `  Point p;
  `  num n = p.y;
  `  Color c = Color.Green;
  `}`;
  doc.version = 1;

  // 'y' is declared on line 2 (0-indexed), not Point's own line 0.
  str field_def = definition(&reads, doc, 10, 12);
  assert contains(field_def, `"line":2`), "expected the field's own declaration line, not the compound's";

  // 'Green' is declared on line 6 (0-indexed), not Color's own line 4.
  str variant_def = definition(&reads, doc, 11, 21);
  assert contains(variant_def, `"line":6`), "expected the variant's own declaration line, not the enum's";
}

test "go-to-definition on a quirk-typed receiver's method lands on the method's own line, not the quirk's" {
  // User-reported. QuirkMethodSig carried no position of its own -
  // quirk_method_declaration fell back to the whole quirk node's
  // position, so a receiver typed AS the quirk (not a concrete impl)
  // always jumped to the quirk's own name line instead of the method
  // signature inside it. Fixed by giving QuirkMethodSig a real `pos`,
  // set from the method name token in the parser.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///quirkdef.fn";
  doc.path = "quirkdef.fn";
  doc.text = `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `async fun main() {
  `  Counter c;
  `  AsyncCounter q = &c;
  `  let out = await q.add(1);
  `}`;
  doc.version = 1;

  // 'add' is declared on line 4 (0-indexed) inside the quirk, not the
  // quirk's own line 3.
  str method_def = definition(&reads, doc, 12, 20);
  assert contains(method_def, `"line":4`), "expected the quirk method's own declaration line, not the quirk's";
}

test "go-to-definition on a call prefers the method over a same-named field on the same compound" {
  // resolve_at tried lookup_field before ever considering lookup_method,
  // unconditionally - a compound with a field and a quirk-impl method
  // sharing one name (a plausible getter-over-its-own-backing-field
  // shape) always resolved `b.len()` to the FIELD, since a field call
  // was never distinguished from a field read by whether a '(' follows.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///namecollide.fn";
  doc.path = "namecollide.fn";
  doc.text = `quirk Sized {
  `  len() num;
  `}
  `compound Buffer {
  `  num len;
  `}
  `impl Buffer as Sized {
  `  len() num { ret self.len; }
  `}
  `fun main() {
  `  Buffer b;
  `  b.len = 3;
  `  num r = b.len();
  `  _ = r;
  `}`;
  doc.version = 1;

  // Field read: 'len' at line 11 ('  b.len = 3;') lands on the field, line 4.
  str field_read = definition(&reads, doc, 11, 4);
  assert contains(field_read, `"line":4`), "expected the field's own declaration line for a plain read";

  // Method call: 'len' at line 12 ('  num r = b.len();') lands on the method, line 7 - not the field.
  str method_call = definition(&reads, doc, 12, 12);
  assert contains(method_call, `"line":7`), "expected the method's own declaration line for a call, not the field's";
}

test "field and variant doc comments: a leading block scopes to just the field, a trailing comment is the fallback" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fielddoc.fn";
  doc.path = "fielddoc.fn";
  doc.text = `// The compound's own doc, not any field's.
  `compound Config {
  `  // The port to listen on.
  `  num port;
  `  num timeout; // Seconds before giving up.
  `}
  `enum Status {
  `  Ok,
  `  Failed, // Something went wrong.
  `}`;
  doc.version = 1;

  // 'port' has its own leading block; must not leak Config's doc.
  str port_hover = hover(&reads, doc, 3, 6);
  assert contains(port_hover, "The port to listen on."), "expected the field's own leading doc comment";
  assert !contains(port_hover, "The compound's own doc"), "expected the compound's doc not to leak onto a field that has its own";

  // 'timeout' has no leading block, only a trailing same-line comment.
  str timeout_hover = hover(&reads, doc, 4, 6);
  assert contains(timeout_hover, "Seconds before giving up."), "expected the trailing comment used as a fallback";
  assert !contains(timeout_hover, "The compound's own doc"), "expected no leak from the compound here either";

  // 'Failed' has only a trailing same-line comment too.
  str failed_hover = hover(&reads, doc, 8, 2);
  assert contains(failed_hover, "Something went wrong."), "expected the variant's own trailing comment";
}

test "a keyword carries documentation, and an ordinary word does not" {
  assert !equals(keyword_doc("fit"), ""), "expected fit to be documented";
  assert contains(keyword_doc("fit"), "```fun"), "expected a fenced example";
  assert equals(keyword_doc("total"), ""), "expected no documentation for an ordinary name";
}

test "hover documents a sized integer type (i7, u23), never a real declared symbol" {
  // Never a lexer keyword, contextual like fork, resolved purely
  // from the identifier's own shape, the same way the parser accepts
  // it wherever a type is expected.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///sizedint.fn";
  doc.path = "sizedint.fn";
  doc.text = `fun main() {
  `  i7 a = 1;
  `  u23 b = 2;
  `}`;
  doc.version = 1;

  str signed_hover = hover(&reads, doc, 1, 3);
  assert contains(signed_hover, "7-bit signed integer"), "expected i7's own bit width and signedness";

  str unsigned_hover = hover(&reads, doc, 2, 3);
  assert contains(unsigned_hover, "23-bit unsigned integer"), "expected u23's own bit width and signedness";
}

test "hovering an integer literal shows decimal, hex, binary, and octal" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///intlit.fn";
  doc.path = "intlit.fn";
  doc.text = `fun main() {
  `  u64 mask = 4294967295;
  `  num small = 10;
  `}`;
  doc.version = 1;

  str mask_hover = hover(&reads, doc, 1, 15);
  assert contains(mask_hover, "hex:     0xffffffff"), "expected the hex form";
  assert contains(mask_hover, "binary:  0b1111_1111_1111_1111_1111_1111_1111_1111"), "expected the binary form, grouped in nibbles";
  assert contains(mask_hover, "octal:   0o37777777777"), "expected the octal form";
  assert contains(mask_hover, "= 2^32 - 1"), "expected the power-of-two-minus-one annotation";

  str small_hover = hover(&reads, doc, 2, 15);
  assert contains(small_hover, "hex:     0xa"), "expected an unpadded, minimal-width hex form";
  assert !contains(small_hover, "2^"), "expected no power-of-two annotation for a value that isn't one";
}

test "hovering a character literal shows its own decimal, hex, and binary codepoint" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///charlit.fn";
  doc.path = "charlit.fn";
  doc.text = `fun main() {
  `  chr letter = 'A';
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 1, 17);
  assert contains(hovered, "decimal: 65"), "expected the ASCII decimal codepoint";
  assert contains(hovered, "hex:     0x41"), "expected the hex codepoint";
  assert contains(hovered, "binary:  0b01000001"), "expected the binary codepoint, byte-padded";
}

test "hovering a decimal literal names its own type, without a meaningless base conversion" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///declit.fn";
  doc.path = "declit.fn";
  doc.text = `fun main() {
  `  dec pi = 3.14159;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 1, 12);
  assert contains(hovered, "floating-point"), "expected the decimal literal's own type named";
  assert !contains(hovered, "hex:"), "expected no hex/binary conversion for a decimal literal";
}

test "hovering 'as' reads contextually: import alias vs quirk impl" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();

  Document import_doc;
  import_doc.uri = "file:///aliasimport.fn";
  import_doc.path = "aliasimport.fn";
  import_doc.text = "imp std.io as io2;\n";
  import_doc.version = 1;
  str import_hover = hover(&reads, import_doc, 0, 11);
  assert contains(import_hover, "Binds an import to a different name"), "expected the import-alias doc for 'as' inside an imp statement";
  assert !contains(import_hover, "Names the quirk"), "expected the impl-quirk doc not to leak into an import context";

  Document impl_doc;
  impl_doc.uri = "file:///aliasimpl.fn";
  impl_doc.path = "aliasimpl.fn";
  impl_doc.text = `compound Point {
  `  num x;
  `}
  `quirk Q {
  `  a() num;
  `}
  `impl Point as Q {
  `  a() num { ret self.x; }
  `}`;
  impl_doc.version = 1;
  str impl_hover = hover(&reads, impl_doc, 6, 11);
  assert contains(impl_hover, "Names the quirk"), "expected the impl-quirk doc for 'as' inside an impl statement";
  assert !contains(impl_hover, "Binds an import"), "expected the import-alias doc not to leak into an impl context";
}

test "hover and go-to-definition on an import path segment resolve to the module or its stdlib README" {
  str src = `imp std.io;
  `imp std.channel;
  `
  `fun main() num {
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///examples/advanced/probe.fn";
  doc.path = "examples/advanced/probe.fn";
  doc.text = src;
  doc.version = 1;

  // On `channel` in `imp std.channel;`: the module's own leading doc
  // comment.
  str module_hover = hover(&reads, doc, 1, 9);
  assert contains(module_hover, "channel"), "expected std.channel's own leading doc comment";

  str module_def = definition(&reads, doc, 1, 9);
  assert contains(module_def, "channel.fn"), "expected a jump straight to the module file";

  // On `std` alone: the stdlib's own root README, since `std/` itself
  // has no README of its own.
  str root_hover = hover(&reads, doc, 1, 5);
  assert contains(root_hover, "Standard Library"), "expected the stdlib root's own README";

  str root_def = definition(&reads, doc, 1, 5);
  assert contains(root_def, "README.md"), "expected a jump to the stdlib root's README";
}

test "hover and go-to-definition resolve a parent-traversal import ('..')" {
  // '..' lexes as one operator token, not two '.'s; both the
  // is-this-an-import-segment check and the specifier reconstruction
  // used to only recognize a single '.', silently dropping the whole
  // '..' prefix and resolving relative to the wrong directory.
  str src = `imp ..lexer.lexer;
  `
  `fun main() num {
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///src/fls/importprobe.fn";
  doc.path = "src/fls/importprobe.fn";
  doc.text = src;
  doc.version = 1;

  // On the final 'lexer' (the module segment): its own leading doc.
  str module_hover = hover(&reads, doc, 0, 12);
  assert contains(module_hover, "Vec<Token>"), "expected lexer.fn's own leading doc comment through a '..' path";

  str module_def = definition(&reads, doc, 0, 12);
  assert contains(module_def, "lexer/lexer.fn"), "expected a jump to the module file up and over from '..'";

  // A longer dot run ('....', two levels up) lexes as multiple tokens
  // (only '.'/'..'/'...' are known multi-char operators, so this one
  // splits into '...' + '.'), which the fix has to re-concatenate
  // rather than assume a single '..' token.
  Document doc2;
  doc2.uri = "file:///src/parser/importprobe.fn";
  doc2.path = "src/parser/importprobe.fn";
  doc2.text = "imp ....src.lexer.lexer;\n";
  doc2.version = 1;
  str deep_hover = hover(&reads, doc2, 0, 18);
  assert contains(deep_hover, "Vec<Token>"), "expected the same doc comment through a four-dot path";
}

test "documentLink covers a resolvable import's own path, and silently skips one that doesn't resolve" {
  str src = `imp std.io;
  `imp ..lexer.lexer;
  `imp nope.nope;
  `
  `fun main() num {
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///src/fls/linkprobe.fn";
  doc.path = "src/fls/linkprobe.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_links(&reads, doc);
  assert contains(out, `"target":"file://`), "expected at least one resolved link";
  assert contains(out, "stdlib/std/io.fn"), "expected std.io's own link target";
  assert contains(out, "lexer/lexer.fn"), "expected the '..' parent-traversal link target";
  assert !contains(out, "nope"), "expected an unresolvable specifier to be skipped, not reported as a broken link";

  // `imp std.io;` starts at column 0; the specifier itself ("std.io")
  // starts right after the keyword and its trailing space, column 4,
  // through column 10.
  assert contains(out, `"start":{"line":0,"character":4}`), "expected the link range to start at the specifier, not the 'imp' keyword";
  assert contains(out, `"character":10}`), "expected the link range to end at the specifier's own last character";
}

test "hover, go-to-definition, and dot-completion resolve an import alias at a use site, not just inside the imp statement" {
  str src = `imp std.c.math as cmath;
  `
  `fun main() num {
  `  ret cmath.sqrt(4.0);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///aliasprobe.fn";
  doc.path = "aliasprobe.fn";
  doc.text = src;
  doc.version = 1;

  // On 'cmath' at the call site (line 3), not inside the imp
  // statement itself: the aliased module's own leading doc comment.
  str alias_hover = hover(&reads, doc, 3, 7);
  assert contains(alias_hover, "C math library"), "expected the aliased module's own doc comment when hovering the alias at a use site";

  str alias_def = definition(&reads, doc, 3, 7);
  assert contains(alias_def, "math.fn"), "expected a jump to the aliased module's own file";

  // Right after 'cmath.': the module's own real top-level functions,
  // not nothing and not arbitrary words already typed in the file.
  str alias_completion = completion(&reads, doc, 3, 12, false);
  assert contains(alias_completion, `"label":"sqrt"`), "expected the aliased module's own function in completion";
  assert contains(alias_completion, `"label":"cos"`), "expected another of the aliased module's own functions too";
}

test "hover, go-to-definition, and completion cover a C builtin the language accepts without a declaration" {
  str src = `fun main() num {
  `  ret NULL;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///cbuiltin.fn";
  doc.path = "cbuiltin.fn";
  doc.text = src;
  doc.version = 1;

  // 'NULL' is never a declared symbol anywhere in the AST at all, the
  // exact reason ordinary resolution has nothing to offer it.
  str hovered = hover(&reads, doc, 1, 8);
  assert contains(hovered, "C builtin"), "expected NULL to be recognized as a C builtin, not silently resolve to nothing";
  assert contains(hovered, "std.c.def"), "expected the owning module named in the hover";

  str def = definition(&reads, doc, 1, 8);
  assert contains(def, "std/c/def.fn"), "expected a jump to the module that documents it";

  str out = completion(&reads, doc, 1, 2, false);
  assert contains(out, `"label":"NULL"`), "expected NULL to be offered in ordinary bare-identifier completion";
  assert contains(out, `"label":"size_t"`), "expected a C builtin typedef to be offered too, not just macro constants";
}

test "hover shows a doc comment for a method declared in another, imported file" {
  str src = `imp std.option;
  `fun main() num {
  `  Option<num> o;
  `  num v = o.unwrap();
  `  ret v;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///examples/advanced/crossdoc.fn";
  doc.path = "examples/advanced/crossdoc.fn";
  doc.text = src;
  doc.version = 1;

  // `unwrap`'s own declaration, and its doc comment, both live in
  // stdlib/std/option.fn, not in this document's own text.
  str hovered = hover(&reads, doc, 3, 14);
  assert contains(hovered, "The contained value"), "expected the doc comment read from option.fn itself, not this document's text";
  assert contains(hovered, "unwrap(Option<num>* self) num"), "expected the signature resolved too";
  assert !contains(hovered, "fun unwrap"), "expected no 'fun ' prefix, a method is never written with one";
}

test "an outline lists what a file declares, by kind" {
  str src = `pub const num LIMIT = 8;
  `pub compound Buffer {
  `  num len;
  `}
  `pub enum Mode {
  `  Fast,
  `}
  `impl Buffer {
  `  pub clear() { self.len = 0; }
  `}
  `fun helper() num { ret 1; }`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///outline.fn";
  doc.path = "outline.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(&reads, doc);
  // The protocol's own numbering: 14 constant, 23 struct, 10 enum,
  // 22 enum member, 6 method, 12 function.
  assert contains(out, `"name":"LIMIT","kind":14`), "expected the constant";
  assert contains(out, `"name":"Buffer","kind":23`), "expected the compound";
  assert contains(out, `"name":"Mode","kind":10`), "expected the enum";
  assert contains(out, `"name":"Fast","kind":22`), "expected the variant";
  assert contains(out, `"name":"helper","kind":12`), "expected the function";
}

test "an outline nests a compound's own fields and its impl's own methods as one tree, not two flat lists" {
  // User-reported (stdlib/std/vec.fn): fields and methods showed
  // neither nested under their own compound in the editor's outline -
  // document_symbols returned the protocol's flat, deprecated
  // SymbolInformation form (a containerName string, no real parent-
  // child structure), which a client has to guess a tree back from
  // using range containment; every entry here shared close to the
  // same range, so nothing reliable to guess from. Fixed by returning
  // the real nested DocumentSymbol form, with fields, variants, and an
  // impl's own methods (wherever the impl block itself sits in the
  // file) as actual JSON children of their own compound/enum entry.
  str src = `compound Buffer {
  `  num len;
  `  num cap;
  `}
  `impl Buffer {
  `  pub push(num n) { self.len = self.len + n; }
  `  pub clear() { self.len = 0; }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///nested.fn";
  doc.path = "nested.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(&reads, doc);
  num buffer_at = index_of_str(out, `"name":"Buffer"`);
  assert buffer_at >= 0, "expected Buffer's own entry";
  num children_at = index_of_str(out, `"children":[`);
  assert children_at > buffer_at, "expected a children array right on Buffer's own entry";
  str children_text = substr(out, children_at, len(out) - children_at);
  assert contains(children_text, `"name":"len","kind":8`), "expected len nested as a field";
  assert contains(children_text, `"name":"cap","kind":8`), "expected cap nested as a field";
  assert contains(children_text, `"name":"push","kind":6`), "expected push nested as a method";
  assert contains(children_text, `"name":"clear","kind":6`), "expected clear nested as a method";
}

test "an outline nests a concrete-instantiation impl's own methods under the base compound too" {
  // User-reported (stdlib/std/vec.fn): impl Vec<str> { ... } and impl
  // Vec<num> as Display { ... } both still showed their own methods
  // flat, even after nesting an ordinary impl's methods worked. A
  // concrete-instantiation impl (targeting one specific generic
  // argument, not the bare template) mangles its own type_name to
  // Buffer__str, which the top-level Buffer entry (bare name) never
  // matches; concrete_dtype carries the un-mangled base name for
  // exactly this lookup. impl Buffer<T: num | dec> - constrained but
  // still generic, not a concrete instantiation - already worked, since
  // its own type_name stays bare.
  str src = `compound Buffer<T> {
  `  T v;
  `}
  `impl Buffer<str> {
  `  pub upper() str { ret self.v; }
  `}
  `impl Buffer<T: num | dec> {
  `  pub doubled() T { ret self.v; }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///concreteimpl.fn";
  doc.path = "concreteimpl.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(&reads, doc);
  num buffer_at = index_of_str(out, `"name":"Buffer"`);
  assert buffer_at >= 0, "expected Buffer's own entry";
  str after_buffer = substr(out, buffer_at, len(out) - buffer_at);
  assert contains(after_buffer, `"name":"upper","kind":6`), "expected the concrete-instantiation impl's own method nested under Buffer";
  assert contains(after_buffer, `"name":"doubled","kind":6`), "expected the constrained-generic impl's own method nested under Buffer too";
}

test "a method is listed under the name it was written as" {
  str src = `compound Buffer {
  `  num len;
  `}
  `impl Buffer {
  `  pub clear() { self.len = 0; }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///method.fn";
  doc.path = "method.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(&reads, doc);
  // A method is stored mangled, as `Buffer__clear`; an outline shows the
  // name in the source, nested under Buffer's own entry.
  assert contains(out, `"name":"clear","kind":6`), "expected the written name";
  assert !contains(out, "Buffer__clear"), "expected the mangling not to reach the client";
  assert contains(out, `"name":"Buffer","kind":23`), "expected Buffer's own entry";
  num buffer_at = index_of_str(out, `"name":"Buffer"`);
  num clear_at = index_of_str(out, `"name":"clear"`);
  assert buffer_at >= 0 && clear_at > buffer_at, "expected clear nested inside Buffer's own children";
}

test "a quirk impl's method is listed under the name it was written as, not either mangled segment" {
  // A quirk impl's own method is stored mangled as `Buffer__Sized__len`
  // (type and quirk both); an outline used to strip only the leading
  // `Buffer__`, leaking the quirk-prefixed remainder `Sized__len`
  // straight through. User-reported (screenshot of stdlib/std/vec.fn's
  // own outline, `impl Vec<T> as Sized` methods showing as flat,
  // wrongly named entries).
  str src = `quirk Sized {
  `  len() num;
  `}
  `compound Buffer {
  `  num len;
  `}
  `impl Buffer as Sized {
  `  len() num { ret self.len; }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///quirkmethod.fn";
  doc.path = "quirkmethod.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(&reads, doc);
  assert contains(out, `"name":"len","kind":6`), "expected the written name, not a mangled remainder";
  assert !contains(out, "Sized__len"), "expected no quirk-mangled remainder to leak through";
  assert !contains(out, "Buffer__Sized__len"), "expected no fully mangled name to leak through";
  num buffer_at = index_of_str(out, `"name":"Buffer"`);
  assert buffer_at >= 0, "expected Buffer's own entry";
  str after_buffer = substr(out, buffer_at, len(out) - buffer_at);
  assert contains(after_buffer, `"name":"len","kind":6`), "expected the impl's own method nested inside Buffer's own children, not just Sized's own signature";
}

test "each field and variant in an outline carries its own position, not the whole declaration's" {
  // _collect reported every field of a compound (and every variant of
  // an enum) at the SAME position - the compound/enum's own node -
  // even though CompoundField and EnumVariant both carry their own
  // real position from the parser. Several same-range entries in a
  // flat SymbolInformation reply reads as a garbled, wrongly nested
  // outline client-side (user-reported, stdlib/std/vec.fn: a field
  // showing as a container for unrelated top-level functions).
  str src = `compound Point {
  `  num x;
  `  num y;
  `}
  `enum Color {
  `  Red,
  `  Green,
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///positions.fn";
  doc.path = "positions.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(&reads, doc);
  assert contains(out, `"name":"x","kind":8,"range":{"start":{"line":1`), "expected x's own line, not Point's";
  assert contains(out, `"name":"y","kind":8,"range":{"start":{"line":2`), "expected y's own line, not Point's";
  assert contains(out, `"name":"Red","kind":22,"range":{"start":{"line":5`), "expected Red's own line, not Color's";
  assert contains(out, `"name":"Green","kind":22,"range":{"start":{"line":6`), "expected Green's own line, not Color's";
}

test "an outline entry carries a range and a selectionRange a client can jump to" {
  str src = `fun helper() num { ret 1; }`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///loc.fn";
  doc.path = "loc.fn";
  doc.text = src;
  doc.version = 1;

  // The nested DocumentSymbol form carries a range/selectionRange pair
  // directly on each entry, not a separate SymbolInformation-style
  // location wrapper.
  str out = document_symbols(&reads, doc);
  assert contains(out, `"range"`), "expected a range on the entry";
  assert contains(out, `"selectionRange"`), "expected a selectionRange on the entry";
}

test "a ranged edit against a document with no baseline is refused, not applied against a guess" {
  Documents docs = documents_new();
  defer docs.free();

  // No didOpen for this uri at all - the ranged edit a client would
  // send for an ordinary keystroke has nothing to apply against.
  docs.edited("file:///never-opened.fn", 0, 0, 0, 0, "x", 2);
  assert docs.at("file:///never-opened.fn").is_none(), "expected no document to spring into existence from a ranged edit alone";

  // Same refusal once a document that *was* open is closed.
  docs.opened("file:///closed.fn", "abc", 1);
  docs.closed("file:///closed.fn");
  docs.edited("file:///closed.fn", 0, 0, 0, 1, "x", 2);
  assert docs.at("file:///closed.fn").is_none(), "expected the edit to be refused, not to reopen the document";
}

test "workspace symbol search matches by name, case-insensitively, across every open document" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();
  docs.opened("file:///a.fn", `fun helper() num { ret 1; }`, 1);
  docs.opened("file:///b.fn", `compound Helper { num n; }`, 1);

  str matches = workspace_symbols(&docs, &reads, &symbols, "help");
  assert contains(matches, `"name":"helper"`), "expected the lowercase match from a.fn";
  assert contains(matches, `"name":"Helper"`), "expected the differently-cased match from b.fn";
  assert contains(matches, `"uri":"file:///a.fn"`), "expected a.fn's own location";
  assert contains(matches, `"uri":"file:///b.fn"`), "expected b.fn's own location";

  assert equals(workspace_symbols(&docs, &reads, &symbols, "nope_no_such_symbol"), "[]"), "expected no matches";
  assert !equals(workspace_symbols(&docs, &reads, &symbols, ""), "[]"), "expected an empty query to match everything";
}

test "workspace symbol search scores and sorts matches: exact, then prefix, then substring, then fuzzy subsequence" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();
  // widget: exact match. widgetFactory: prefix match. myWidget:
  // substring match. wgt: fuzzy subsequence match (w-g-t in order).
  docs.opened(
    "file:///wsort.fn",
    `fun widget() num { ret 1; }
    `fun widgetFactory() num { ret 1; }
    `fun myWidget() num { ret 1; }
    `fun wgt() num { ret 1; }`,
    1
  );

  str matches = workspace_symbols(&docs, &reads, &symbols, "widget");
  num exact_pos = index_of_str(matches, `"name":"widget"`);
  num prefix_pos = index_of_str(matches, `"name":"widgetFactory"`);
  num substr_pos = index_of_str(matches, `"name":"myWidget"`);
  assert exact_pos >= 0 && prefix_pos >= 0 && substr_pos >= 0, "expected all three name matches present";
  assert exact_pos < prefix_pos, "expected the exact match ranked before the prefix match";
  assert prefix_pos < substr_pos, "expected the prefix match ranked before the plain substring match";
  assert !contains(matches, `"name":"wgt"`), "expected wgt excluded, it doesn't contain 'widget' as a substring or subsequence";

  // A genuinely fuzzy query: "wgt" is a subsequence of "widget" too,
  // but wgt's own exact match should still rank first.
  str fuzzy = workspace_symbols(&docs, &reads, &symbols, "wgt");
  assert contains(fuzzy, `"name":"wgt"`), "expected wgt's own exact match";
  num wgt_exact_pos = index_of_str(fuzzy, `"name":"wgt"`);
  num widget_fuzzy_pos = index_of_str(fuzzy, `"name":"widget"`);
  assert widget_fuzzy_pos >= 0, "expected widget matched as a fuzzy subsequence of wgt";
  assert wgt_exact_pos < widget_fuzzy_pos, "expected wgt's own exact match ranked above widget's fuzzy match";
}

test "a workspace-indexed document is visible alongside open ones, but an open one always wins" {
  str base = "fun-out/_workspace_index_test";
  make_dir_all(base);
  str disk_path = path_join(base, "disk_only.fn");
  write_string(disk_path, "fun disk_helper() num { ret 1; }\n");
  defer remove_file(disk_path);
  str disk_uri = path_to_uri(disk_path);

  Documents docs = documents_new();
  defer docs.free();
  docs.opened("file:///open.fn", `fun open_helper() num { ret 1; }`, 1);
  docs.index_from_disk(disk_uri, disk_path);

  Vec<str> uris = docs.all_uris();
  defer uris.free();
  assert uris.len == 2, "expected both the open and the disk-indexed document counted";

  let found_disk = docs.at(disk_uri);
  assert found_disk.is_some(), "expected the disk-indexed document to resolve";
  assert contains(found_disk.unwrap().text, "disk_helper"), "expected its own real content, read from disk";

  // An open document at the same URI stays authoritative: indexing it
  // again from disk must not clobber what the client actually holds.
  docs.opened(disk_uri, "fun overridden() num { ret 2; }", 1);
  docs.index_from_disk(disk_uri, disk_path);
  let found_after = docs.at(disk_uri);
  assert contains(found_after.unwrap().text, "overridden"), "expected the open document to stay authoritative over its own indexed copy";
}

test "a disk-indexed document's own content refreshes on re-index, and forget_indexed drops it on delete" {
  // The two Documents-level operations watched_files_changed
  // (server.fn) performs for a Changed/Created and a Deleted
  // FileChangeType respectively - re-indexing the changed file on
  // disk, or dropping it outright, is what keeps a workspace-wide
  // feature from serving a file's own stale content or a deleted
  // file's ghost entry once the client notifies this server a
  // watched .fn file changed on disk.
  str base = "fun-out/_watch_reindex_test";
  make_dir_all(base);
  str path = path_join(base, "watched.fn");
  write_string(path, "fun original() num { ret 1; }\n");
  defer remove_file(path);
  str uri = path_to_uri(path);

  Documents docs = documents_new();
  defer docs.free();
  docs.index_from_disk(uri, path);
  assert contains(docs.at(uri).unwrap().text, "original"), "expected the first read's own content";

  // Simulates the file changing on disk, then the client's own
  // watched-files notification triggering a re-read.
  write_string(path, "fun changed() num { ret 2; }\n");
  docs.index_from_disk(uri, path);
  assert contains(docs.at(uri).unwrap().text, "changed"), "expected the re-index to pick up the file's own new content";
  assert !contains(docs.at(uri).unwrap().text, "original"), "expected the old content gone, not merged with the new";

  // Simulates the file being deleted on disk, then the client's own
  // Deleted notification.
  docs.forget_indexed(uri);
  assert docs.at(uri).is_none(), "expected the deleted file's entry gone";

  // An open document's own buffer stays authoritative regardless -
  // watched_files_changed still forwards to index_from_disk for a
  // Changed event on an open URI, and it must remain a no-op.
  docs.opened(uri, "fun from_editor() num { ret 3; }", 1);
  docs.index_from_disk(uri, path);
  assert contains(docs.at(uri).unwrap().text, "from_editor"), "expected the open buffer to stay authoritative over a disk re-read";
}

test "references and workspace/symbol find a symbol in a document that was never opened, rename does not" {
  str base = "fun-out/_workspace_scan_test";
  make_dir_all(base);
  str other_path = path_join(base, "other.fn");
  write_string(
    other_path,
    `fun shared_util() num {
    `  ret 42;
    `}
    `fun another_user() num {
    `  ret shared_util();
    `}`
  );
  defer remove_file(other_path);
  str other_uri = path_to_uri(other_path);

  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();
  docs.opened("file:///main.fn", `fun main() num {
  `  ret shared_util();
  `}`, 1);
  // Stands in for the server's own lazy indexWorkspace call: the
  // server walks the real workspace root once per lifetime, but the
  // caller-visible contract this exercises is just "an indexed
  // document is in the store before the request runs".
  docs.index_from_disk(other_uri, other_path);
  let doc = docs.at("file:///main.fn").unwrap();

  str found = references(&reads, &docs, doc, 1, 6);
  assert count(found, `"uri"`) == 3, "expected all 3 occurrences across both files";
  assert contains(found, json_quote(other_uri)), "expected the unopened file's own uri present";

  str matches = workspace_symbols(&docs, &reads, &symbols, "another");
  assert contains(matches, `"name":"another_user"`), "expected the unopened file's own function found by workspace symbol search";

  // Rename never scans the workspace on its own: only the already-
  // known documents (open, or indexed by an earlier references/
  // workspace-symbol call) are touched.
  Documents fresh_docs = documents_new();
  defer fresh_docs.free();
  fresh_docs.opened("file:///main2.fn", `fun main() num {
  `  ret shared_util();
  `}`, 1);
  let fresh_doc = fresh_docs.at("file:///main2.fn").unwrap();
  str edit = rename_symbol(&reads, &fresh_docs, fresh_doc, 1, 6, "renamed_util");
  assert count(edit, `"newText":"renamed_util"`) == 1, "expected only the open document's own occurrence renamed";
}

test "definition_workspace_wide falls back to a type in a document never imported, once indexed" {
  // definition() itself only ever sees the current file's own
  // transitively-merged program, so a type this file never imports
  // is invisible to it no matter how the workspace is arranged.
  // definition_workspace_wide adds exactly the reference's own
  // findTypeDefinitionAnyDoc fallback: a last-resort scan of every
  // already-known document, triggering no scan of its own (an
  // unindexed workspace still finds nothing, matching the reference).
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();
  docs.opened("file:///main.fn", `fun main() num {
  `  OrphanType x;
  `  ret 0;
  `}`, 1);
  let main_doc = docs.at("file:///main.fn").unwrap();

  // Not yet indexed anywhere: no fallback match.
  assert equals(definition_workspace_wide(&reads, &docs, &symbols, main_doc, 1, 2), "[]"), "expected no match before any document declaring OrphanType is known";

  // Indexed now (standing in for an earlier references/workspace-
  // symbol call having already scanned the workspace). Also exercises
  // the table's own incremental rebuild: the first call above already
  // built it against a workspace with only main.fn in it.
  docs.opened("file:///unrelated.fn", `pub compound OrphanType {
  `  num n;
  `}`, 1);
  str found = definition_workspace_wide(&reads, &docs, &symbols, main_doc, 1, 2);
  assert contains(found, `"uri":"file:///unrelated.fn"`), "expected the fallback to find OrphanType's own declaration";
  assert contains(found, `"character":13`), "expected the range to land on OrphanType's own name, not the compound keyword";
}

test "the workspace symbol table is a version-gated no-op on an unchanged document" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();
  docs.opened("file:///stable.fn", `fun steady() num { ret 1; }`, 1);

  str first = workspace_symbols(&docs, &reads, &symbols, "steady");
  str second = workspace_symbols(&docs, &reads, &symbols, "steady");
  assert equals(first, second), "expected identical results across two calls with nothing changed in between";
}

test "the workspace symbol table rebuilds on edit, scrubbing the old name rather than shadowing it" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();

  // A second, unrelated file also declares "foo" - proves the rename
  // below scrubs only rename.fn's own contribution, not every "foo"
  // in the table.
  docs.opened("file:///other_foo.fn", `fun foo() num { ret 9; }`, 1);
  docs.opened("file:///rename.fn", `fun foo() num { ret 1; }`, 1);

  str before = workspace_symbols(&docs, &reads, &symbols, "foo");
  assert count(before, `"name":"foo"`) == 2, "expected both files' own foo found";

  docs.opened("file:///rename.fn", `fun bar() num { ret 1; }`, 2);

  str after_foo = workspace_symbols(&docs, &reads, &symbols, "foo");
  assert count(after_foo, `"name":"foo"`) == 1, "expected rename.fn's own foo gone, other_foo.fn's own foo still present";
  assert contains(after_foo, `"uri":"file:///other_foo.fn"`), "expected the surviving foo to be the unrelated file's own";

  str after_bar = workspace_symbols(&docs, &reads, &symbols, "bar");
  assert contains(after_bar, `"name":"bar"`), "expected the renamed function to be found under its new name";
}

test "closing a document forgets its own workspace symbol table entries" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();
  docs.opened("file:///closing.fn", `fun going_away() num { ret 1; }`, 1);

  str before = workspace_symbols(&docs, &reads, &symbols, "going_away");
  assert contains(before, `"name":"going_away"`), "expected the symbol found while the document is open";

  docs.closed("file:///closing.fn");
  symbols.forget("file:///closing.fn");

  str after = workspace_symbols(&docs, &reads, &symbols, "going_away");
  assert equals(after, "[]"), "expected the symbol gone once its own document was closed and forgotten";
}

test "workspace symbol search finds a field, a variant, and a method, not just top-level names" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  WorkspaceSymbolTable symbols = workspace_symbol_table_new();
  defer symbols.free();
  docs.opened(
    "file:///richness.fn",
    `compound Widget {
    `  num special_field;
    `}
    `impl Widget {
    `  pub special_method() num { ret 1; }
    `}
    `enum Outcome {
    `  SpecialVariant,
    `}`,
    1
  );

  str field_match = workspace_symbols(&docs, &reads, &symbols, "special_field");
  assert contains(field_match, `"name":"special_field"`), "expected a compound field found";
  assert contains(field_match, `"containerName":"Widget"`), "expected its own container recorded";

  str method_match = workspace_symbols(&docs, &reads, &symbols, "special_method");
  assert contains(method_match, `"name":"special_method"`), "expected an impl method found";

  str variant_match = workspace_symbols(&docs, &reads, &symbols, "SpecialVariant");
  assert contains(variant_match, `"name":"SpecialVariant"`), "expected an enum variant found";
}

test "a rename is refused when the new name is not one" {
  assert is_identifier("total"), "expected an ordinary name";
  assert is_identifier("_private"), "expected a leading underscore to be allowed";
  assert is_identifier("v2"), "expected digits after the first character";
  assert !is_identifier(""), "expected nothing to be rejected";
  assert !is_identifier("9bad"), "expected a leading digit to be rejected";
  assert !is_identifier("has space"), "expected a space to be rejected";
  assert !is_identifier("has-dash"), "expected punctuation to be rejected";
}

test "a rename is refused when the new name already names a top-level declaration in the same merged program" {
  str src = `fun helper(num total) num {
  `  ret total + total;
  `}
  `fun taken() num {
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  docs.opened("file:///collide.fn", src, 1);
  let held = docs.at("file:///collide.fn");
  assert held.is_some(), "expected the document to be held";
  Document doc = held.unwrap();

  // Fun resolves a private top-level name flatly across the whole
  // merged program, so renaming a local parameter to a name a
  // top-level function already has would break the build the moment
  // both sit in the same program - refused rather than silently
  // applied.
  assert equals(rename_symbol(&reads, &docs, doc, 1, 6, "taken"), "null"), "expected the rename refused when it collides with an existing top-level name";

  // A name nothing else in the program has is still renamed normally.
  str edit = rename_symbol(&reads, &docs, doc, 1, 6, "count");
  assert count(edit, `"newText":"count"`) == 3, "expected the rename to still work when there is no collision";
}

test "every place a name is written is found, and renamed together" {
  str src = `fun helper(num total) num {
  `  ret total + total;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  docs.opened("file:///ref.fn", src, 1);
  let held = docs.at("file:///ref.fn");
  assert held.is_some(), "expected the document to be held";
  Document doc = held.unwrap();

  // `total` is written three times: the parameter and its two uses.
  str found = references(&reads, &docs, doc, 1, 6);
  assert count(found, `"uri"`) == 3, "expected every occurrence";

  str edit = rename_symbol(&reads, &docs, doc, 1, 6, "count");
  assert count(edit, `"newText":"count"`) == 3, "expected every occurrence renamed";
  assert contains(edit, `"changes"`), "expected the edit grouped by document";

  // A name a reader could not have written is refused outright.
  assert equals(rename_symbol(&reads, &docs, doc, 1, 6, "9bad"), "null"), "expected the rename refused";
}

test "document highlight finds every occurrence in the current document, but never another one" {
  str src_a = `fun total(num n) num {
  `  ret n + total(0);
  `}`;
  str src_b = `fun total(num n) num {
  `  ret n;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  docs.opened("file:///a.fn", src_a, 1);
  docs.opened("file:///b.fn", src_b, 1);
  let held = docs.at("file:///a.fn");
  assert held.is_some(), "expected the document to be held";
  Document doc = held.unwrap();

  // `total` in `a.fn` is written twice: the declaration and its own
  // recursive call. `references` also finds `b.fn`'s own unrelated
  // `total`, since it scans every open document; document_highlights
  // must not.
  str refs = references(&reads, &docs, doc, 0, 5);
  assert count(refs, `"uri"`) == 3, "expected references to find all three, across both files";

  str highlights = document_highlights(&reads, doc, 0, 5);
  assert count(highlights, `"range"`) == 2, "expected only a.fn's own two occurrences";
  assert !contains(highlights, `"uri"`), "expected no uri field at all: every result is implicitly the requested document";
}

test "completion after a dot offers what the receiver has" {
  str src = `compound Buffer {
  `  num len;
  `}
  `impl Buffer {
  `  pub clear() { self.len = 0; }
  `}
  `fun helper(Buffer b) num {
  `  num x = b.len;
  `  ret x;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///cmp.fn";
  doc.path = "cmp.fn";
  doc.text = src;
  doc.version = 1;

  // Right after `b.` on the line that reads it.
  str out = completion(&reads, doc, 7, 12, false);
  assert contains(out, `"label":"len","kind":5`), "expected the field";
  assert contains(out, `"label":"clear","kind":2`), "expected the method, unmangled";
  assert !contains(out, `"label":"ret"`), "expected no reserved words after a dot";
}

test "completion lists an import path's own directory, filtered by what's typed so far" {
  str base = "fun-out/_import_completion_test";
  make_dir_all(base);
  make_dir_all(path_join(base, "subdir"));
  write_string(path_join(base, "sibling_a.fn"), "fun a() {}\n");
  write_string(path_join(base, "sibling_b.fn"), "fun b() {}\n");
  defer remove_file(path_join(base, "sibling_a.fn"));
  defer remove_file(path_join(base, "sibling_b.fn"));

  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///here.fn";
  doc.path = path_join(base, "here.fn");
  doc.text = "imp sub";
  doc.version = 1;

  str out = completion(&reads, doc, 0, 7, false);
  assert contains(out, `"label":"subdir","kind":19`), "expected the subdirectory offered as a folder, filtered by the 'sub' prefix";
  assert !contains(out, "sibling_a"), "expected the non-matching sibling filtered out";
  assert !contains(out, "sibling_b"), "expected the non-matching sibling filtered out";

  // The unfiltered case, right after 'imp ' with nothing typed: every
  // sibling and the synthetic 'std' entry point.
  doc.text = "imp ";
  str out_all = completion(&reads, doc, 0, 4, false);
  assert contains(out_all, `"label":"std","kind":19`), "expected the synthetic stdlib entry point";
  assert contains(out_all, `"label":"subdir","kind":19`), "expected the sibling directory";
  assert contains(out_all, `"label":"sibling_a","kind":17`), "expected the sibling module, bare of its .fn extension";
  assert contains(out_all, `"label":"sibling_b","kind":17`), "expected the other sibling module";
}

test "completion offers a warning id for the first argument of allow/expect, filtered by prefix" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///warnid.fn";
  doc.path = "warnid.fn";
  doc.text = "  allow unused_";
  doc.version = 1;

  str out = completion(&reads, doc, 0, 15, false);
  assert contains(out, `"label":"unused_variable","kind":21`), "expected a matching warning id, kind Constant";
  assert contains(out, `"label":"unused_import"`), "expected another matching warning id";
  assert contains(out, `"label":"unused_function"`), "expected a third matching warning id";
  assert contains(out, `"label":"unused_compound"`), "expected a fourth matching warning id";
  assert !contains(out, `"label":"fit_non_exhaustive"`), "expected a non-matching id filtered out";

  // Same for 'expect'.
  doc.text = "expect fit_non_exhaustive";
  str out2 = completion(&reads, doc, 0, 25, false);
  assert contains(out2, `"label":"fit_non_exhaustive"`), "expected 'expect' to offer ids too";

  // Past the id (a comma already typed, a reason started) this no
  // longer fires at all, checked by kind since the fallback
  // written-word completion legitimately re-offers the same text for
  // an unrelated reason (it is, after all, right there in the file).
  doc.text = "allow unused_import, \"";
  str out3 = completion(&reads, doc, 0, 22, false);
  assert !contains(out3, `"label":"unused_import","kind":21`), "expected no warning-id completion once the id is already typed and a reason has started";
}

test "hover and completion resolve a dotted chain through its own receiver's declared type" {
  str src = `compound Engine {
  `  num rpm;
  `}
  `compound Car {
  `  Engine engine;
  `}
  `fun main() num {
  `  Car c;
  `  num r = c.engine.rpm;
  `  ret r;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///chain.fn";
  doc.path = "chain.fn";
  doc.text = src;
  doc.version = 1;

  // On `rpm` in `c.engine.rpm`: not `c`'s own field (it has none
  // named `rpm`), only reachable by resolving `engine`'s own type
  // first.
  str hovered = hover(&reads, doc, 8, 21);
  assert contains(hovered, "num rpm"), "expected rpm resolved through the whole chain, not just c";

  // Right after `c.engine.`: only Engine's own members, not Car's.
  str out = completion(&reads, doc, 8, 19, false);
  assert contains(out, `"label":"rpm"`), "expected Engine's own field";
  assert !contains(out, `"label":"engine"`), "expected Car's own field excluded, one level too shallow";
}

test "hover resolves a chain ending in a call, including generic specialization threaded through it" {
  // chain_receiver_type only ever backed off one segment short when a
  // call sat anywhere in the chain (the token right before that dot
  // was a ')', not a plain identifier), and even where the receiver
  // resolved, its own generic args were computed then discarded, so a
  // stdlib container's own method (get, is_none, ...) always returned
  // its bare unspecialized template. User-reported, from real hovers
  // in this very codebase's own parser.fn.
  str src = `imp std.vec;
  `imp std.option;
  `compound Box {
  `  num n;
  `}
  `impl Box {
  `  peek() Box {
  `    Box b;
  `    ret b;
  `  }
  `  doubled() num {
  `    ret self.n * 2;
  `  }
  `}
  `fun main() num {
  `  Box b;
  `  ret b.peek().doubled();
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///callchain.fn";
  doc.path = "callchain.fn";
  doc.text = src;
  doc.version = 1;

  // `doubled` is reached only through `peek()`'s own return type,
  // not through `b`'s.
  str hovered = hover(&reads, doc, 16, 15);
  assert contains(hovered, "doubled(Box* self) num"), "expected the call-ending segment resolved through the call before it";

  // A stdlib generic's own method, reached through a call in the
  // middle of the chain (not just a plain field), specializes
  // correctly at the very end too.
  str src2 = `imp std.vec;
  `compound Holder {
  `  Vec<num> nums;
  `}
  `impl Holder {
  `  own() Vec<num> {
  `    ret self.nums;
  `  }
  `}
  `fun main() num {
  `  Holder h;
  `  h.nums.init(4);
  `  h.nums.push(5);
  `  ret h.own().get(0);
  `}`;
  Document doc2;
  doc2.uri = "file:///callchain2.fn";
  doc2.path = "callchain2.fn";
  doc2.text = src2;
  doc2.version = 1;
  str hovered2 = hover(&reads, doc2, 13, 14);
  assert contains(hovered2, "get(Vec<num>* self, num i) num"), "expected get resolved and specialized past a call in the middle of the chain";
}

test "a quirk-conforming impl's own method resolves, mangled name de-mangled correctly" {
  // A quirk-conforming impl mangles its methods Type__Quirk__method
  // (three parts), not Type__method (two) like a plain impl; the
  // de-mangling helper only ever stripped one Type__ prefix, leaving
  // "Quirk__method" and never matching the bare method name a reader
  // actually typed. Found incidentally verifying the chain fix above,
  // via std.vec's own VecIter (impl VecIter<T> as Iterator<T>).
  str src = `quirk Nextable<T> {
  `  next() Option<T>;
  `}
  `compound Counter<T> {
  `  T value;
  `}
  `impl Counter<T> as Nextable<T> {
  `  pub next() Option<T> {
  `    ret .Some(self.value);
  `  }
  `}
  `fun main() num {
  `  Counter<num> c;
  `  let n = c.next();
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///quirkimpl.fn";
  doc.path = "quirkimpl.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 13, 12);
  assert contains(hovered, "next(Counter<num>* self) Option<num>"), "expected the quirk-conforming method's own bare name resolved and specialized, not the mangled Quirk__method form";
}

test "an impl method whose own written name starts with an underscore resolves correctly, in hover, completion, and let-inference" {
  // bare_method_name's own "everything after the last '__'" rule
  // breaks when the method's own name starts with an underscore too:
  // the mangled form (Widget___helper, three raw underscores where
  // the separator's own two meet the method's own one) has its
  // rightmost valid '__' pair sitting one character short of the
  // true separator, silently dropping the method's own leading
  // underscore and never matching the name a reader actually wrote.
  // User-reported, live against src/lexer/lexer.fn's own
  // self._start_pos() call inside a let.
  str src = `compound Widget {
  `  num n;
  `}
  `impl Widget {
  `  _helper() num {
  `    ret 0;
  `  }
  `  _infer_me() num {
  `    let x = self._helper();
  `    ret x;
  `  }
  `}
  `fun use_it(Widget* w) num {
  `  ret w._helper();
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///underscoremethod.fn";
  doc.path = "underscoremethod.fn";
  doc.text = src;
  doc.version = 1;

  // Completion right after 'w.' (line 13).
  str completed = completion(&reads, doc, 13, 8, false);
  assert contains(completed, `"label":"_helper"`), "expected the method's own written name, leading underscore included, in completion";

  // Hover on the call site (line 13).
  str hovered = hover(&reads, doc, 13, 10);
  assert contains(hovered, "_helper(Widget* self) num"), "expected the method's own bare name resolved, not 'helper' with the leading underscore silently dropped";

  // let x = self._helper(); (line 8) should infer 'num', not fail
  // silently because the method lookup itself never matched.
  str inferred_hover = hover(&reads, doc, 8, 8);
  assert contains(inferred_hover, "num x"), "expected the let-inferred type through an underscore-prefixed method call";
}

test "a constant string value with an embedded quote is escaped exactly once, either source form" {
  // User-reported (via the raw-string case): a lexed string node's
  // own content is the lexer's as-written text, not a decoded value.
  // A double-quoted source already carries valid \" escapes in that
  // content untouched; a backtick raw string carries the literal "
  // character with no escaping at all, since raw strings have none.
  // The naive first fix blanket-escaped every quote regardless,
  // double-escaping the already-escaped double-quoted case into
  // three backslashes instead of one.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///quotedconst.fn";
  doc.path = "quotedconst.fn";
  doc.text = `const str QUOTED = "he said \"hi\"";
  `const str RAWQUOTED = ``he said "hi"``;
  `fun main() num {
  `  str a = QUOTED;
  `  str b = RAWQUOTED;
  `  ret 0;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 3, 10);
  assert contains(hovered, `const str QUOTED = \"he said \\\"hi\\\"\"`), "expected the already-escaped double-quoted source left alone, one backslash per quote";

  str hovered_raw = hover(&reads, doc, 4, 10);
  assert contains(hovered_raw, `const str RAWQUOTED = \"he said \\\"hi\\\"\"`), "expected the unescaped raw-string source newly escaped, also one backslash per quote";
}

test "hover on a generic compound/enum/quirk's own name shows its type params, not just the bare declaration" {
  // User-reported: hovering a generic compound's own name (at its
  // declaration or a use site) showed "compound Box" with no mention
  // of <T> at all - lookup_top_level's own Compound/Enum/Quirk cases
  // never rendered their type params, unlike a function's own
  // render_function_named. This also silently defeated the "is this
  // compound generic" check bare-generic-literal inference needs, so
  // it's worth locking down on its own.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///gentypeparams.fn";
  doc.path = "gentypeparams.fn";
  doc.text = `compound Box<T> {
  `  T value;
  `}
  `enum Maybe<T> {
  `  Has(T),
  `  None
  `}
  `quirk Mapper<T> {
  `  map(T x) T;
  `}
  `fun main() {
  `  Box<num> b;
  `  _ = b;
  `}`;
  doc.version = 1;

  assert contains(hover(&reads, doc, 11, 3), "compound Box<T>"), "expected the compound's own type param shown";
  assert contains(hover(&reads, doc, 3, 6), "enum Maybe<T>"), "expected the enum's own type param shown";
  assert contains(hover(&reads, doc, 7, 7), "quirk Mapper<T>"), "expected the quirk's own type param shown";
}

test "hover on a sized array local shows its own declared size, not a bare '[]'" {
  // User-reported: `chr[64] buf;` hovered as `chr[] buf`, silently
  // dropping the 64 - render_type's own array-rendering never looked
  // at DataType.array_brackets at all.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///sizedarr.fn";
  doc.path = "sizedarr.fn";
  doc.text = `fun main() {
  `  chr[64] buf;
  `  num[] dyn;
  `  _ = buf;
  `  _ = dyn;
  `}`;
  doc.version = 1;

  assert contains(hover(&reads, doc, 1, 10), "chr[64] buf"), "expected the declared size to show";
  assert contains(hover(&reads, doc, 2, 9), "num[] dyn"), "expected a bare '[]' to stay bare, not gain a wrong size";
}

test "hover on a module-alias-qualified type shows it written the way it was, not the internal mangled name" {
  // User-reported: `imp std.log as l;` then `l.Logger logger` hovered
  // as "l__Logger logger" - parser.fn's own parse_datatype mangles a
  // qualified type's type_str to "l__Logger" for symbol lookup, and
  // fls's own render_type showed that internal form verbatim instead
  // of demangling it back for display.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///aliastype.fn";
  doc.path = "aliastype.fn";
  doc.text = `imp std.log as l;
  `fun main() {
  `  l.Logger logger = l.logger_init(l.LogLevel.Debug);
  `  _ = logger;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 2, 11);
  assert contains(hovered, "l.Logger logger"), "expected the type written the way it was, alias and all";
  assert !contains(hovered, "l__Logger"), "expected no internal mangled name leaking through";
}

test "hovering a number literal shows decimal/hex/binary/octal each on its own line, not run together" {
  // User-reported: the whole breakdown rendered on one run-together
  // line, since a single '\n' in plain markdown prose is a soft line
  // break (a space), not a real one - needs its own fence to keep
  // each base on its own line.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///numhover.fn";
  doc.path = "numhover.fn";
  doc.text = `fun main() {
  `  let n = 17;
  `  let c = 'A';
  `  _ = n;
  `  _ = c;
  `}`;
  doc.version = 1;

  // `hover` returns its result already JSON-serialized, so a real
  // newline in the markdown content shows up here as the literal two
  // characters `\n` (backslash, n), not an actual newline byte.
  str num_hover = hover(&reads, doc, 1, 10);
  assert contains(num_hover, "```\\ndecimal: 17"), "expected the breakdown fenced, decimal first";
  assert contains(num_hover, "\\nhex:     0x11"), "expected hex on its own line";
  assert contains(num_hover, "\\nbinary:  0b1_0001"), "expected binary on its own line";
  assert contains(num_hover, "\\noctal:   0o21"), "expected octal on its own line";

  str char_hover = hover(&reads, doc, 2, 12);
  assert contains(char_hover, "```\\ndecimal: 65"), "expected the char breakdown fenced too";
  assert contains(char_hover, "\\nhex:     0x41"), "expected the char's hex on its own line";
  assert contains(char_hover, "\\nbinary:  0b01000001"), "expected the char's binary on its own line";
}

test "hovering a control-character literal shows its own escaped form, not a raw embedded byte" {
  // User-reported: '\n' hovered with the literal newline BYTE spliced
  // into the fenced code block ('' then a real line break then '),
  // breaking the fence's own visual rendering, since format('{chr}',
  // c) wrote the raw byte rather than the source escape a reader
  // actually typed.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///ctrlchar.fn";
  doc.path = "ctrlchar.fn";
  doc.text = `fun main() {
  `  chr nl = '\n';
  `  chr tab = '\t';
  `  _ = nl;
  `  _ = tab;
  `}`;
  doc.version = 1;

  // `hover`'s own JSON serialization escapes each literal backslash
  // in the markdown text to `\\`, same as the number-hover test
  // above's own newline check - so the escape this test is looking
  // for is itself doubled here too.
  assert contains(hover(&reads, doc, 1, 13), `'\\n'`), "expected the newline shown escaped, not as a raw embedded byte";
  assert contains(hover(&reads, doc, 2, 14), `'\\t'`), "expected the tab shown escaped too";
}

test "hovering a constant shows its own literal value, not just its type" {
  // User-requested: a const's rendered detail only ever showed its
  // type and name, the same as any other global. Its own initializer
  // is always a literal (const requires one), worth showing directly
  // rather than making a reader go find the declaration.
  str src = `const num LIMIT = 42;
  `const str GREETING = "hi";
  `const bin ENABLED = true;
  `const num NEGATIVE = -1;
  `fun main() num {
  `  num a = LIMIT;
  `  str b = GREETING;
  `  bin c = ENABLED;
  `  num d = NEGATIVE;
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///constval.fn";
  doc.path = "constval.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 5, 10);
  assert contains(hovered, "const num LIMIT = 42"), "expected the constant's own numeric literal value shown";

  str hovered_str = hover(&reads, doc, 6, 10);
  assert contains(hovered_str, `const str GREETING = \"hi\"`), "expected the constant's own string literal value shown, quoted";

  str hovered_bin = hover(&reads, doc, 7, 10);
  assert contains(hovered_bin, "const bin ENABLED = true"), "expected the constant's own boolean literal value shown";

  str hovered_neg = hover(&reads, doc, 8, 10);
  assert contains(hovered_neg, "const num NEGATIVE = -1"), "expected a negative numeric literal (a unary minus over the literal) shown with its sign";
}

test "a let local's inferred type resolves through a call-ending chain, not just one hop" {
  // _infer_type only ever handled a single receiver.member or
  // receiver.method() hop; a longer chain (`a.b.get(...)`) fell
  // through to the bare-read fallback and showed the raw
  // __let_infer__ sentinel instead of a real type. User-reported.
  str src = `imp std.vec;
  `compound Holder {
  `  Vec<num> nums;
  `}
  `fun main() num {
  `  Holder h;
  `  h.nums.init(4);
  `  h.nums.push(5);
  `  let first = h.nums.get(0);
  `  ret first;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///letchain.fn";
  doc.path = "letchain.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 8, 6);
  assert contains(hovered, "num first"), "expected the let local's type inferred through the full field-then-call chain, specialized to num";
  assert !contains(hovered, "__let_infer__"), "expected the raw sentinel never shown once a real type resolves";
}

test "hover on a local shadowed by an unrelated impl method's own name resolves to the local, not the method" {
  // lookup_field_at's own .Impl case (added earlier for hovering a
  // method at its own declaration site) never checked whether the
  // cursor's line actually fell inside that impl's own span, just
  // picked the nearest impl above with a matching method name.
  // A local later in the file, in a completely unrelated function,
  // sharing a name with some impl's own method resolved to that
  // method instead of the local. User-reported (a real local named
  // 'err' in this very codebase's own parser tests, shadowed by an
  // unrelated ParseState.err logging method declared earlier).
  str src = `compound Widget {
  `  num n;
  `}
  `impl Widget {
  `  err(str msg) {}
  `}
  `fun main() str {
  `  str err = "not the method";
  `  ret err;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///shadow.fn";
  doc.path = "shadow.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 7, 6);
  assert contains(hovered, "str err"), "expected the local, not Widget's own unrelated 'err' method";
  assert !contains(hovered, "msg"), "expected the method's own signature never shown here";
}

test "hover on an impl method with a trivially empty body still resolves at its own declaration" {
  // _impl_last_line (added to fix the shadowing bug above) needed a
  // coverage boundary for the whole impl block; a method with a
  // one-line empty body ('demo() {}') has no statement for
  // _last_line's own scan to seed a line from, which briefly
  // regressed hovering a method's own name at its own declaration
  // site back to nothing.
  str src = `compound Widget {
  `  num n;
  `}
  `impl Widget {
  `  demo() {}
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///emptybody.fn";
  doc.path = "emptybody.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 4, 2);
  assert contains(hovered, "demo(Widget* self)"), "expected the method's own signature to resolve at its own declaration";
}

test "hover on a function call resolves to the function, not an unrelated compound field sharing its name" {
  // lookup_field_at's own .Compound/.Enum cases had no coverage
  // boundary at all, unlike .Impl (fixed above): a field's own name
  // matched as "the nearest declaration above" for the rest of the
  // whole file, not just its own compound's own body. User-reported,
  // live against src/lexer/lexer.fn: `l.len = len(src);` hovered
  // the stdlib len() call and got Lexer's own 'len' field back
  // instead, since Lexer (declared earlier in the file) has a field
  // by that same name.
  str src = `compound Lexer {
  `  num len;
  `}
  `fun len(str s) num {
  `  ret 0;
  `}
  `fun make(str src) num {
  `  ret len(src);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fieldfn.fn";
  doc.path = "fieldfn.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 7, 8);
  assert contains(hovered, "fun len(str s) num"), "expected the function, not Lexer's own unrelated field of the same name";
  assert !contains(hovered, "Field"), "expected no field-shaped detail at all";
}

test "go-to-definition on a parameter resolves to the parameter, not an unrelated compound field sharing its name" {
  str src = `compound Lexer {
  `  str filename;
  `}
  `fun lexer_new(str src, str filename) Lexer {
  `  Lexer l;
  `  l.filename = filename;
  `  ret l;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fieldparam.fn";
  doc.path = "fieldparam.fn";
  doc.text = src;
  doc.version = 1;

  // On the RHS 'filename' (line 5), the parameter, not the field on
  // the LHS of the same assignment.
  str def = definition(&reads, doc, 5, 21);
  assert contains(def, `"line":3`), "expected a jump to the parameter's own declaration line, not the field's";
}

test "hover and signature help specialize a generic method against its receiver's own concrete type" {
  str src = `imp std.option;
  `fun main() num {
  `  Option<num> o;
  `  num v = o.unwrap_or(5);
  `  ret v;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///generic.fn";
  doc.path = "generic.fn";
  doc.text = src;
  doc.version = 1;

  // On `unwrap_or`: the template's own `T` substituted with `num`
  // throughout, self's own receiver type included, not the bare
  // `unwrap_or(T fallback) T` the template itself declares.
  str hovered = hover(&reads, doc, 3, 13);
  assert contains(hovered, "unwrap_or(Option<num>* self, num fallback) num"), "expected T specialized to num everywhere it appears";

  // Same specialization inside the call's own parens.
  str help = signature_help(&reads, doc, 3, 22);
  assert contains(help, `"label":"unwrap_or(Option<num>* self, num fallback) num"`), "expected the same specialized signature from signature help, no 'fun ' prefix";
}

test "hover resolves a bare variant shorthand and its payload binding inside a fit" {
  str src = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `}
  `fun area(Shape s) num {
  `  fit s {
  `    .Circle(r) -> { ret r * r; }
  `    .Square(side) -> { ret side * side; }
  `  }
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///shape.fn";
  doc.path = "shape.fn";
  doc.text = src;
  doc.version = 1;

  // On `Circle` in `.Circle(r) ->`.
  str variant_hover = hover(&reads, doc, 6, 6);
  assert contains(variant_hover, "Circle(num)"), "expected the variant's own payload signature";

  // On the second `r` in `ret r * r;`, the payload binding's use, not
  // its declaration site inside the pattern's parens.
  str binding_hover = hover(&reads, doc, 6, 24);
  assert contains(binding_hover, "num r"), "expected the binding's inferred payload type";

  // Go to definition on the variant lands on the variant's own line,
  // not the enum's.
  str variant_def = definition(&reads, doc, 6, 6);
  assert contains(variant_def, `"line":1`), "expected the variant's own declaration line";
}

test "hover resolves a fit arm's own payload binding when the subject is a plain function call" {
  // User-reported: `fit parse(src) { Result.Ok(doc) -> { ... } }`
  // hovered doc/e as the raw unsubstituted "T"/"E" - fit_subject_type
  // only ever covered a bare local/field subject, or the desugared
  // channel-receive call, never a plain top-level call's own declared
  // return type at all, so a call-shaped fit subject's own payload
  // bindings never resolved past the enum's own template params.
  str src = `enum Result<T, E> {
  `  Ok(T),
  `  Err(E)
  `}
  `compound Box { num n; }
  `compound Oops { num n; }
  `fun parse(str s) Result<Box, Oops> {
  `  ret Result.Ok(Box{n = 1});
  `}
  `fun main() {
  `  fit parse("x") {
  `    Result.Ok(doc) -> { _ = doc; }
  `    Result.Err(e) -> { _ = e; }
  `  }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///parsecall.fn";
  doc.path = "parsecall.fn";
  doc.text = src;
  doc.version = 1;

  assert contains(hover(&reads, doc, 11, 14), "Box doc"), "expected the call's own concrete Ok payload type, not a bare T";
  assert contains(hover(&reads, doc, 12, 15), "Oops e"), "expected the call's own concrete Err payload type, not a bare E";
}

test "hovering a fit arm's own payload binding resolves when the subject is a let-inferred local" {
  // `_lookup_fit_binding` is reached through `_lookup_local`, which had
  // no `tokens` parameter to pass down to `fit_subject_type`, so it was
  // always called with a hardcoded nil there. Harmless for a subject
  // with an explicit declared type (nothing needs the token stream to
  // read `v.var_type.type_str` directly), but a `let`-inferred subject
  // needs the real tokens to re-derive its own type at all - without
  // them, `type_name_of_local` fell through to the `__let_infer__`
  // sentinel itself, so nothing about the fit could resolve and every
  // arm's payload binding hovered as nothing at all. `lookup`, its
  // three callers, and every other function along that chain now
  // thread the real tokens all the way down. Also exercises a method
  // call subject (`ch.recv_result()`), which `fit_subject_type` never
  // handled generically before (only a hardcoded "recv" case).
  str src = `compound Channel<T> { T v; }
  `enum RecvResult<T> {
  `  Ok(T),
  `  Closed,
  `}
  `impl Channel<T> {
  `  recv_result() RecvResult<T> { ret RecvResult.Closed; }
  `}
  `fun main() {
  `  Channel<num> ch;
  `  let r = ch.recv_result();
  `  fit r {
  `    RecvResult.Ok(v) -> { _ = v; }
  `    RecvResult.Closed -> {}
  `  }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///letfitbind.fn";
  doc.path = "letfitbind.fn";
  doc.text = src;
  doc.version = 1;

  assert contains(hover(&reads, doc, 12, 18), "num v"), "expected the payload binding to resolve through a let-inferred, method-call fit subject";
}

test "hover resolves a quirk-typed receiver's own method, not just a concrete one" {
  // User-reported. lookup_method only ever searched impl blocks by
  // their own type_name, which is always the concrete implementing
  // type (impl Counter as AsyncCounter's own type_name is "Counter",
  // never "AsyncCounter") - a receiver declared as the quirk itself
  // (AsyncCounter q = &c; q.add(1)) has no impl block literally named
  // after it, so this came back empty no matter what. Every one of
  // this function's 8 call sites across hover, go-to-definition, inlay
  // hints, and signature help shared the same gap; fixed once, inside
  // lookup_method itself, by falling back to quirk_method_declaration
  // (which already existed for exactly this, just never consulted from
  // any of them).
  str src = `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  let out = await q.add(1);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///quirkreceiver.fn";
  doc.path = "quirkreceiver.fn";
  doc.text = src;
  doc.version = 1;

  assert contains(hover(&reads, doc, 13, 21), "async add(num x) num"), "expected the quirk-typed receiver's own method to resolve";
}

test "hover resolves a method called on a parenthesized receiver chain, not just a bare one" {
  // User-reported (examples/advanced/async_quirk_await_parenthesized_receiver.fn).
  // chain_receiver's own backward walk always assumed a ')' immediately
  // before a '.' meant a function call (looking for a callee identifier
  // right before the matching '('), so `(pack(q).v).add(1)` - a plain
  // parenthesized grouping, not a call - found "await" there instead of
  // an identifier and gave up on the whole chain. Fixed by recognizing
  // a ')' with no callee identifier before its matching '(' as a
  // parenthesized sub-expression instead, resolved through
  // chain_ending_receiver on its own inner tail token.
  str src = `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Box<T> {
  `  T v;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun pack(AsyncCounter q) Box<AsyncCounter> {
  `  ret Box<AsyncCounter>{v = q};
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  let out = await (pack(q).v).add(1);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///parenreceiver.fn";
  doc.path = "parenreceiver.fn";
  doc.text = src;
  doc.version = 1;

  assert contains(hover(&reads, doc, 19, 31), "async add(num x) num"), "expected the method on a parenthesized receiver chain to resolve";
}

test "hover resolves a method on a chain whose own paren group ends in a dereferenced call" {
  // User-reported (examples/advanced/async_quirk_await_pointer_receiver.fn,
  // `let out3 = await ((*ptr(&b)).v).add(1);`). The parenthesized-group fix
  // above only handled a group whose own inner tail was a nameable
  // identifier (a bare local or field); here the outer group's inner tail
  // is itself another paren group, `(*ptr(&b))`, whose own content is a
  // dereferenced call - its tail token is `ptr(&b)`'s own closing ')',
  // not an identifier chain_ending_receiver can resolve directly. Fixed by
  // recognizing that ')' and recovering the call's callee identifier
  // instead, the same way the outer walk already does for a real call.
  str src = `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Box<T> {
  `  T v;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun ptr(Box<AsyncCounter>* b) Box<AsyncCounter>* {
  `  ret b;
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  Box<AsyncCounter> b = Box<AsyncCounter>{v = q};
  `  let out = await ((*ptr(&b)).v).add(1);
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///doubleparen.fn";
  doc.path = "doubleparen.fn";
  doc.text = src;
  doc.version = 1;

  assert contains(hover(&reads, doc, 20, 34), "async add(num x) num"), "expected the method on a paren group ending in a dereferenced call to resolve";
}

test "hover resolves a compound-literal's own field name, generic instantiation included" {
  // User-reported (same file: `Box<AsyncCounter>{v = q}`'s own `v`).
  // CompoundInitField carries no position of its own in the AST, and
  // nothing in fls had any handling for a compound-literal field name
  // at all - resolved purely from the tokens (matching how
  // _infer_type_primary's own forward-facing compound-literal handling
  // already works), walking backward from the field name to the
  // nearest unmatched '{' and whatever names it: a bare identifier
  // (`Point{x = 1}`), or explicit generic args (`Box<AsyncCounter>{v =
  // q}`, substituting T -> AsyncCounter). A `.{...}` shorthand literal
  // is left alone - its own type comes from context, not from the
  // tokens here.
  str src = `compound Box<T> {
  `  T v;
  `}
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun pack(AsyncCounter q) Box<AsyncCounter> {
  `  ret Box<AsyncCounter>{v = q};
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///literalfield.fn";
  doc.path = "literalfield.fn";
  doc.text = src;
  doc.version = 1;

  assert contains(hover(&reads, doc, 13, 24), "AsyncCounter v"), "expected the field's own type, substituted from the literal's explicit generic arg";
}

test "hover on an enum variant shows its own tag value, auto-incrementing across an explicit override" {
  str src = `enum Shape {
  `  Circle(num),
  `  Square = 5,
  `  Empty,
  `}
  `fun use_it(Shape s) num {
  `  fit s {
  `    .Circle(r) -> { ret r; }
  `    .Square -> { ret 0; }
  `    .Empty -> { ret 0; }
  `  }
  `}
  `fun make() Shape {
  `  ret .Empty;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///ordinal.fn";
  doc.path = "ordinal.fn";
  doc.text = src;
  doc.version = 1;

  // Circle: no explicit value, auto-increments from 0.
  assert contains(hover(&reads, doc, 7, 6), "Circle(num) = 0"), "expected Circle's own auto-incremented tag";
  // Square: explicit `= 5`.
  assert contains(hover(&reads, doc, 8, 6), "Square = 5"), "expected Square's own explicit tag";
  // The same tag shows hovering the variant at its own declaration
  // site too (lookup_field_at's own path), not just at a use site.
  assert contains(hover(&reads, doc, 1, 2), "Circle(num) = 0"), "expected the tag hovering Circle's own declaration";
  // Empty: no explicit value of its own, continues from Square's
  // explicit 5, not from its own declaration position (2).
  assert contains(hover(&reads, doc, 9, 6), "Empty = 6"), "expected Empty's own tag to continue after Square's explicit override";
  // The same tag shows through enum_variant_declaration_typed's own
  // path too (a bare ret variant, resolved against the enclosing
  // function's declared return type).
  assert contains(hover(&reads, doc, 13, 7), "Empty = 6"), "expected the same tag via the ret-value hover path";
}

test "hover on a bare variant shorthand inside a fit substitutes the subject's own concrete generic args" {
  str src = `enum Box<T> {
  `  Full(T),
  `  Empty,
  `}
  `fun unwrap(Box<str> b) str {
  `  fit b {
  `    .Full(v) -> { ret v; }
  `    .Empty -> { ret ""; }
  `  }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///box.fn";
  doc.path = "box.fn";
  doc.text = src;
  doc.version = 1;

  // On `Full` in `.Full(v) ->`, substituted with `b`'s own concrete
  // Box<str>, not the enum template's bare Full(T).
  str variant_hover = hover(&reads, doc, 6, 6);
  assert contains(variant_hover, "Full(str)"), "expected the variant substituted with the subject's own concrete type argument";
}

test "a bare variant shorthand inside a fit resolves inside a test block, an impl method, and a fuzz block" {
  // `_covering_fit` used to walk only top-level `.Function` nodes,
  // so a fit statement inside anything else was silently
  // unreachable no matter how the earlier `_last_line` fix bounded
  // its own span.
  str src = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `}
  `compound Widget {
  `  Shape s;
  `}
  `impl Widget {
  `  pub area() num {
  `    fit self.s {
  `      .Circle(r) -> { ret r; }
  `      .Square(x) -> { ret x; }
  `    }
  `  }
  `}
  `test "shape" {
  `  Shape s = .Circle(1);
  `  fit s {
  `    .Circle(r) -> { assert r == 1, "x"; }
  `    .Square(x) -> {}
  `  }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///covering.fn";
  doc.path = "covering.fn";
  doc.text = src;
  doc.version = 1;

  // On `Circle` in the impl method's own fit (line 10).
  str method_hover = hover(&reads, doc, 10, 7);
  assert contains(method_hover, "Circle(num)"), "expected the variant to resolve inside an impl method's own fit";

  // On `Circle` in the test block's own fit (line 18).
  str test_hover = hover(&reads, doc, 18, 5);
  assert contains(test_hover, "Circle(num)"), "expected the variant to resolve inside a test block's own fit";
}

test "a bare variant shorthand inside a fit resolves when the subject is a let-inferred local" {
  // `fit_subject_type`/`fit_subject_generic_args` used to hardcode a
  // nil token stream, permanently skipping type_name_of_local's own
  // let-inference fallback - a fit over a `let`-bound local (an
  // extremely common shape) never resolved its own variant hover.
  str src = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `}
  `fun make() Shape {
  `  ret .Circle(1);
  `}
  `fun use_it() num {
  `  let s = make();
  `  fit s {
  `    .Circle(r) -> { ret r; }
  `    .Square(x) -> { ret x; }
  `  }
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///letfit.fn";
  doc.path = "letfit.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 10, 5);
  assert contains(hovered, "Circle(num)"), "expected the variant to resolve when the fit's own subject is a let-inferred local";
}

test "a bare variant shorthand inside a fit nested in another fit's own branch resolves against its own subject" {
  // `_find_covering_fit` used to return the outer fit as soon as a
  // line fell anywhere in its own span, before ever checking a
  // nested fit inside one of its own branches - since a nested fit's
  // span always sits inside its own outer one's, this made every
  // line inside a nested fit resolve against the wrong (outer)
  // subject type instead.
  str src = `enum Outer {
  `  A(Inner),
  `  B,
  `}
  `enum Inner {
  `  X(num),
  `  Y,
  `}
  `fun use_it(Outer o) num {
  `  fit o {
  `    .A(inner) -> {
  `      fit inner {
  `        .X(n) -> { ret n; }
  `        .Y -> { ret 0; }
  `      }
  `    }
  `    .B -> { ret 0; }
  `  }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///nested.fn";
  doc.path = "nested.fn";
  doc.text = src;
  doc.version = 1;

  // On `X` in the nested fit's own `.X(n) ->` (line 12, 0-indexed).
  str inner_hover = hover(&reads, doc, 12, 9);
  assert contains(inner_hover, "X(num)"), "expected the nested fit's own variant, not the outer fit's own Outer.A";
}

test "hover on a function or method shows a defaulted parameter's own default value" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///defparam.fn";
  doc.path = "defparam.fn";
  doc.text = `fun greet(str name, num times = 2, str sep = "-") str {
  `  ret sep;
  `}
  `compound Counter {
  `  num base;
  `}
  `impl Counter {
  `  pub add(num x = 10) num {
  `    ret self.base + x;
  `  }
  `}`;
  doc.version = 1;

  str fn_hover = hover(&reads, doc, 0, 4);
  assert contains(fn_hover, "num times = 2"), "expected the function's own defaulted num param";
  assert contains(fn_hover, `str sep = \"-\"`), "expected the function's own defaulted str param";

  str method_hover = hover(&reads, doc, 7, 6);
  assert contains(method_hover, "num x = 10"), "expected the method's own defaulted param";
}

test "hovering a parameter shows only its own type and name, not the enclosing function's own doc comment leaked onto it" {
  // A parameter's own line is always its enclosing function's own
  // declaration line, never a separate one of its own - the ordinary
  // doc-comment-above lookup found the function's own doc and
  // attached it to the parameter's hover too, as though the parameter
  // itself carried that doc.
  str src = `// Greets someone by name.
  `fun greet(str name) str {
  `  ret name;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///paramdoc.fn";
  doc.path = "paramdoc.fn";
  doc.text = src;
  doc.version = 1;

  str hovered = hover(&reads, doc, 1, 16);
  assert contains(hovered, "str name"), "expected the parameter's own type and name";
  assert !contains(hovered, "Greets someone"), "expected the enclosing function's own doc comment not to leak onto its parameter's hover";
}

test "a bare variant shorthand resolves in a comparison, an assignment, and a call argument, not just a fit or a ret" {
  // Every one of these is a real, common shape a bare `.Variant` is
  // written in outside a fit statement's own branches or a bare
  // `ret` value - user-reported, none of them resolved before.
  str src = `enum Color {
  `  Red = 1,
  `  Green,
  `  Blue,
  `}
  `compound Person {
  `  Color favoriteColor;
  `}
  `impl Person {
  `  setColor(Color c) {
  `    self.favoriteColor = c;
  `  }
  `}
  `fun takesColor(Color c) num {
  `  ret 0;
  `}
  `fun use_it() num {
  `  Color c = Color.Red;
  `  if c == .Red {
  `    ret 1;
  `  }
  `  c = .Green;
  `  takesColor(.Blue);
  `  Person p;
  `  p.setColor(.Red);
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///shorthand_ctx.fn";
  doc.path = "shorthand_ctx.fn";
  doc.text = src;
  doc.version = 1;

  // `if c == .Red` - the comparison's other operand.
  str cmp = hover(&reads, doc, 18, 11);
  assert contains(cmp, "Red = 1"), "expected the comparison's own operand to resolve .Red";

  // `c = .Green;` - a plain assignment.
  str assign = hover(&reads, doc, 21, 7);
  assert contains(assign, "Green = 2"), "expected the assignment target's own type to resolve .Green";

  // `takesColor(.Blue);` - a bare function call argument.
  str call_arg = hover(&reads, doc, 22, 14);
  assert contains(call_arg, "Blue = 3"), "expected the callee's own declared parameter type to resolve .Blue";

  // `p.setColor(.Red);` - a method call argument, self excluded from
  // the written argument count.
  str method_arg = hover(&reads, doc, 24, 14);
  assert contains(method_arg, "Red = 1"), "expected the method's own declared parameter type to resolve .Red";
}

test "hover on a method call, a qualified variant, and a ret's own bare variant (with generic substitution)" {
  str src = `compound Box {
  `  num width;
  `}
  `impl Box {
  `  pub doubled() num {
  `    ret self.width * 2;
  `  }
  `}
  `enum Outcome<T> {
  `  Ok(T),
  `  Err(str),
  `}
  `fun risky(str path) Outcome<num> {
  `  ret .Ok(5);
  `}
  `fun other(str path) Outcome<num> {
  `  ret Outcome.Ok(5);
  `}
  `fun use_box(Box b) num {
  `  ret b.doubled();
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///methods.fn";
  doc.path = "methods.fn";
  doc.text = src;
  doc.version = 1;

  // On `doubled` in the call `b.doubled()`.
  str method_hover = hover(&reads, doc, 19, 8);
  assert contains(method_hover, "doubled(Box* self) num"), "expected the method's own signature, de-mangled, with its implicit self";

  // On the bare `.Ok(5)` inside `risky`'s own `ret`, substituted with
  // Outcome<num>'s own concrete type argument, not the template's bare T.
  str bare_ret_hover = hover(&reads, doc, 13, 7);
  assert contains(bare_ret_hover, "Ok(num)"), "expected the bare ret variant substituted with the concrete type argument";
  // enum_variant_declaration_typed (the path a bare ret variant
  // resolves through) never set its own container, unlike its sibling
  // enum_variant_declaration, so a bare variant's See also footer
  // silently dropped its own enum.
  assert contains(bare_ret_hover, "[`Outcome`]"), "expected the bare ret variant to link back to its own enum";

  // On the qualified `Outcome.Ok(5)` inside `other`.
  str qualified_hover = hover(&reads, doc, 16, 15);
  assert contains(qualified_hover, "Ok("), "expected the qualified variant to resolve";
}

test "hover and completion resolve a local declared inside an elif branch" {
  // StatementElseIf is its own NodeKind, a real parser-constructed node
  // distinct from StatementIf/StatementElse (confirmed by how many other
  // places in this same compiler - codegen, typecheck, warnings - handle
  // it as its own explicit case). _lookup_in_body, _find_covering_fit,
  // _lookup_fit_binding, and completion's own _collect_locals all had
  // StatementIf and StatementElse covered but never StatementElseIf, so
  // any local declared inside an elif branch's own body (a routine,
  // common shape, not an edge case) was invisible to hover and
  // completion alike, found while re-checking the fit-arm fixes above
  // for other statement-kind gaps of the same shape.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///elseif.fn";
  doc.path = "elseif.fn";
  doc.text = `fun check(num x) num {
  `  if x == 1 {
  `    ret 1;
  `  } elif x == 2 {
  `    num doubled = x * 2;
  `    ret doubled;
  `  } else {
  `    ret 0;
  `  }
  `}`;
  doc.version = 1;

  // At the local's own declaration inside the elif body.
  str at_decl = hover(&reads, doc, 4, 10);
  assert contains(at_decl, "num doubled"), "expected the elif-branch local to resolve at its own declaration";

  // At a later use.
  str at_use = hover(&reads, doc, 5, 10);
  assert contains(at_use, "num doubled"), "expected the same local to resolve at a later use";

  str completed = completion(&reads, doc, 5, 10, false);
  assert contains(completed, `"label":"doubled"`), "expected the elif-branch local offered in scope completion";
}

test "hover and completion resolve a local declared inside a defer block" {
  // defer { ... } (the block form, not defer expr;) parses its own
  // full body the same way if/else does, but StatementDefer was
  // missing the same recursive case, found alongside the elif gap
  // above by checking the rest of NodeKind's own body-carrying
  // statement variants for the same omission.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///deferlocal.fn";
  doc.path = "deferlocal.fn";
  doc.text = `fun check() num {
  `  defer {
  `    num cleanup_count = 1;
  `    ret cleanup_count;
  `  }
  `  ret 0;
  `}`;
  doc.version = 1;

  str at_decl = hover(&reads, doc, 2, 10);
  assert contains(at_decl, "num cleanup_count"), "expected the defer-block local to resolve at its own declaration";

  str at_use = hover(&reads, doc, 3, 10);
  assert contains(at_use, "num cleanup_count"), "expected the same local to resolve at a later use";

  str completed = completion(&reads, doc, 3, 10, false);
  assert contains(completed, `"label":"cleanup_count"`), "expected the defer-block local offered in scope completion";
}

test "hover and completion resolve a for loop's own bound variables, item type inferred from the iterable" {
  // A for loop's own item/index names are bound by the statement
  // itself, not declared inside its body the way an ordinary local
  // is - neither _lookup_in_body nor completion's own _collect_locals
  // had a StatementFor case at all, so none of these ever resolved.
  // User-reported.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///forlocal.fn";
  doc.path = "forlocal.fn";
  doc.text = `fun use_it(Vec<num> xs) num {
  `  for v : xs {
  `    ret v;
  `  }
  `  for idx, item :: xs {
  `    ret idx + item;
  `  }
  `  for i : 0..10 {
  `    ret i;
  `  }
  `  ret 0;
  `}`;
  doc.version = 1;

  // `for v : xs` - the item's own type inferred from xs's own
  // declared Vec<num>.
  assert contains(hover(&reads, doc, 2, 8), "num v"), "expected the for-each item typed from the iterable's own element type";
  str offered = completion(&reads, doc, 2, 8, false);
  assert contains(offered, `"label":"v"`), "expected the for-each item offered in scope completion";

  // `for idx, item :: xs` - both bound names.
  assert contains(hover(&reads, doc, 5, 8), "num idx"), "expected the two-variable form's own index, always num";
  assert contains(hover(&reads, doc, 5, 14), "num item"), "expected the two-variable form's own item, typed from the iterable";

  // `for i : 0..10` - a range loop's own index, always num.
  assert contains(hover(&reads, doc, 8, 8), "num i"), "expected the range loop's own index";
}

test "the two-variable for loop's own bindings are key/value for a Map, not index/item" {
  // User-reported: `for name, score :: scores` (scores: Map<str,
  // num>) hovered name as "num" (the array-form's own always-num
  // index) and score as "str" (Map's own single-binding key-only
  // resolution, reused as if it were the item type) - neither
  // resolution actually applies to a Map's own two-binding form,
  // which yields key/value pairs specifically, not index/item.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///formapkv.fn";
  doc.path = "formapkv.fn";
  doc.text = `fun use_it(Map<str, num> scores) {
  `  for name, score :: scores {
  `    _ = name;
  `    _ = score;
  `  }
  `}`;
  doc.version = 1;

  assert contains(hover(&reads, doc, 1, 6), "str name"), "expected the Map's own key type, not a bare num index";
  assert contains(hover(&reads, doc, 1, 13), "num score"), "expected the Map's own value type, not its key type again";
  str offered = completion(&reads, doc, 2, 8, false);
  assert contains(offered, `"label":"name"`), "expected the key binding offered in scope completion";
  assert contains(offered, `"label":"score"`), "expected the value binding offered in scope completion";
}

test "hover and completion resolve a local declared inside a fit arm, including inside an impl method" {
  // _lookup_in_body (hover's own local search) and _declared
  // (completion's scope walk) both had every other statement shape
  // covered, if/else/for, but never fit, so any local declared inside
  // a fit arm's own body was invisible to both, user-reported.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fitlocal.fn";
  doc.path = "fitlocal.fn";
  doc.text = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `}
  `compound Calc {
  `  num n;
  `}
  `impl Calc {
  `  area(Shape s) num {
  `    fit s {
  `      .Circle(r) -> {
  `        let doubled = r * 2;
  `        ret doubled;
  `      }
  `      .Square(side) -> {
  `        ret side * side;
  `      }
  `    }
  `    ret 0;
  `  }
  `}`;
  doc.version = 1;

  // Both the declaration and a later use resolve.
  str decl_hover = hover(&reads, doc, 11, 12);
  assert contains(decl_hover, "doubled"), "expected the fit-arm local to resolve at its own declaration";
  str use_hover = hover(&reads, doc, 12, 12);
  assert contains(use_hover, "doubled"), "expected the fit-arm local to resolve at a later use";

  str completed = completion(&reads, doc, 12, 12, false);
  assert contains(completed, `"label":"doubled"`), "expected the fit-arm local offered in scope completion";
}

test "hover and completion resolve a fit arm's own payload binding when the subject is a field access, not just a bare local" {
  // fit_subject_type only ever handled a bare identifier subject
  // (fit s { ... }) or the fit <- ch channel-receive desugar. A
  // subject reached through a field (fit s.kind { ... }, this
  // codebase's own dominant idiom - every fit over an AST node's kind
  // is shaped exactly this way) fell through to "", so a payload
  // binding's own type never resolved at all, user-reported live
  // against this exact file (symbols.fn's own `.Variable(v)` fit arm).
  // completion._collect_locals had a separate, deeper version of the
  // same gap: its own .StatementFit case never pushed a branch's own
  // bindings as completion items at all, regardless of subject shape,
  // so "r" was never offered while typing inside the arm's own body.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fitfield.fn";
  doc.path = "fitfield.fn";
  doc.text = `enum ShapeKind {
  `  Circle(num),
  `}
  `compound Shape {
  `  ShapeKind kind;
  `}
  `fun check(Shape* s) num {
  `  fit s.kind {
  `    .Circle(r) -> {
  `      ret r;
  `    }
  `  }
  `  ret 0;
  `}`;
  doc.version = 1;

  // At the binding's own site, "(r)".
  str at_binding = hover(&reads, doc, 8, 12);
  assert contains(at_binding, "num r"), "expected the payload binding's own type to resolve at its declaration";

  // At a later use, "ret r;".
  str at_use = hover(&reads, doc, 9, 10);
  assert contains(at_use, "num r"), "expected the same binding to resolve at a later use too";

  // Mid-word on "r" inside the arm's own body.
  str completed = completion(&reads, doc, 9, 10, false);
  assert contains(completed, `"label":"r","kind":6,"detail":"num"`), "expected the payload binding offered in scope completion, correctly typed";

  // Go-to-definition lands on the arm's own pattern line (8, ".Circle(r)"
  // itself), not the enclosing fit statement's own line (7) - neither
  // AST node tracks a binding name's own exact position, but the arm's
  // own condition expression is a much closer stand-in than the whole
  // fit statement.
  str def_binding = definition(&reads, doc, 8, 12);
  assert contains(def_binding, `"line":8`), "expected the jump to land on the arm's own pattern line, not the fit statement's";
}

test "hover and completion resolve a local or parameter inside a test or fuzz block" {
  // Neither _lookup_local nor _declared ever had a .Test or .Fuzz
  // case at all, user-reported (via a real local in this very test
  // suite's own source): every parameter and local declared anywhere
  // inside a test/fuzz block, across the whole codebase's own test
  // files, was invisible to hover and completion alike.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///testblock.fn";
  doc.path = "testblock.fn";
  doc.text = `test "a demo" {
  `  num total = 5;
  `  ret total;
  `}
  `fuzz "a demo fuzz" (raw* data, num len) {
  `  ret len;
  `}`;
  doc.version = 1;

  str local_hover = hover(&reads, doc, 2, 6);
  assert contains(local_hover, "total"), "expected a local declared inside a test block to resolve";
  str local_completion = completion(&reads, doc, 2, 6, false);
  assert contains(local_completion, `"label":"total"`), "expected the test-block local offered in scope completion";

  str param_hover = hover(&reads, doc, 5, 6);
  assert contains(param_hover, "len"), "expected a fuzz block's own parameter to resolve";
  str param_completion = completion(&reads, doc, 5, 6, false);
  assert contains(param_completion, `"label":"len"`), "expected the fuzz parameter offered in scope completion";
  assert contains(param_completion, `"label":"data"`), "expected the fuzz block's other parameter offered too";
}

test "hover on a fuzz block's own data and len parameters keeps the pointer depth and shadows the stdlib function" {
  // Carried over as acceptance criteria for the fls port (see
  // project_fls_fuzz_param_hover_bugs memory): `data` used to hover as
  // `raw`, its pointer depth dropped, and `len` used to resolve to
  // std.string's own `len` free function instead of the block's own
  // parameter shadowing it.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fuzzhover.fn";
  doc.path = "fuzzhover.fn";
  doc.text = `fuzz "roundtrip" (raw* data, num len) {
  `  num n = len;
  `}`;
  doc.version = 1;

  assert contains(hover(&reads, doc, 0, 23), "raw* data"), "expected data's own pointer depth kept, not dropped to 'raw'";
  assert contains(hover(&reads, doc, 1, 10), "num len"), "expected len to resolve to the block's own parameter, not the stdlib function";
}

test "completion offers an impl method's own parameters and body locals, scoped to that method" {
  // _declared had no .Impl case at all, and never walked into any
  // function's body for locals, only its own top-level args, so
  // inside any impl method (almost this whole codebase), bare
  // identifier completion offered nothing but keywords and other
  // top-level names.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///scopecompl.fn";
  doc.path = "scopecompl.fn";
  doc.text = `compound Widget {
  `  num n;
  `}
  `impl Widget {
  `  bump(num delta) num {
  `    ret delta;
  `  }
  `}
  `fun plain() num {
  `  num total = 5;
  `  ret total;
  `}`;
  doc.version = 1;

  str in_method = completion(&reads, doc, 5, 8, false);
  assert contains(in_method, `"label":"delta"`), "expected the method's own parameter offered inside its body";
  assert !contains(in_method, `"label":"total"`), "expected the other function's local not offered here";

  str in_plain = completion(&reads, doc, 10, 8, false);
  assert contains(in_plain, `"label":"total"`), "expected the plain function's own local offered inside its body";
  assert !contains(in_plain, `"label":"delta"`), "expected the method's parameter not offered here";
}

test "signature help shows a call's own parameters and tracks the active one, self included for a method" {
  str src = `compound Box {
  `  num width;
  `}
  `impl Box {
  `  pub scale(num factor, num offset) num {
  `    ret self.width * factor + offset;
  `  }
  `}
  `fun add(num a, num b) num {
  `  ret a + b;
  `}
  `fun main() num {
  `  num x = add(1, 2);
  `  Box b;
  `  num y = b.scale(3, 4);
  `  ret x + y;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///sig.fn";
  doc.path = "sig.fn";
  doc.text = src;
  doc.version = 1;

  // Right after `add(`, on the first argument.
  str first_arg = signature_help(&reads, doc, 12, 14);
  assert contains(first_arg, `"label":"fun add(num a, num b) num"`), "expected add's own signature";
  assert contains(first_arg, `"activeParameter":0`), "expected the first parameter active";

  // Right after the comma, on the second argument.
  str second_arg = signature_help(&reads, doc, 12, 17);
  assert contains(second_arg, `"activeParameter":1`), "expected the second parameter active";

  // A method call's implicit self shifts the active index by one, so
  // the first argument the reader actually types still lands on
  // "factor", not on self.
  str method_first_arg = signature_help(&reads, doc, 14, 18);
  assert contains(method_first_arg, `"label":"scale(Box* self, num factor, num offset) num"`), "expected scale's own signature with self, no 'fun ' prefix";
  assert contains(method_first_arg, `"activeParameter":1`), "expected the first real argument active, past the implicit self";

  // Outside any call at all.
  assert equals(signature_help(&reads, doc, 0, 0), "null"), "expected no signature help outside a call";
}

test "inlay hints infer a let local's own type from a literal, a plain call, and a method call" {
  str src = `compound Box {
  `  num width;
  `}
  `impl Box {
  `  pub doubled() num {
  `    ret self.width * 2;
  `  }
  `}
  `fun helper() str {
  `  ret "hi";
  `}
  `fun main() num {
  `  let x = 5;
  `  let s = helper();
  `  Box b;
  `  let n = b.doubled();
  `  ret x;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///hints.fn";
  doc.path = "hints.fn";
  doc.text = src;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 20);
  assert contains(hints, `"label":": num"`), "expected a literal's own type";
  assert contains(hints, `"label":": str"`), "expected a plain call's own declared return type";
  // Both the literal-int local and the method-call local infer "num",
  // so this only confirms at least one num hint landed at the right
  // position rather than counting occurrences.
  assert contains(hints, `"line":12,"character":7`), "expected the first hint positioned right after x";

  // Nothing inside the given line range.
  assert equals(inlay_hints(&reads, doc, 0, 0), "[]"), "expected no hints outside the requested range";
}

test "inlay hints cover a char literal, a field read, an impl method's own local, and a bare copy" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///hints2.fn";
  doc.path = "hints2.fn";
  doc.text = `compound Server {
  `  num count;
  `}
  `impl Server {
  `  peek() num {
  `    let x = self.count;
  `    ret x;
  `  }
  `}
  `fun top() {
  `  num a = 5;
  `  let b = 'c';
  `  let c = a;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 20);
  // 'x' inside the impl method's own body: a field read, num.
  assert contains(hints, `"position":{"line":5,"character":9}`), "expected a hint positioned right after 'x'";
  assert contains(hints, `"label":": num"`), "expected the field read inside a method to resolve";
  // A char literal was previously reported as 'num' (the catch-all in
  // .Number's own fit), not 'chr'.
  assert contains(hints, `"position":{"line":11,"character":7}`), "expected a hint positioned right after 'b'";
  assert contains(hints, `"label":": chr"`), "expected a char literal to infer chr, not num";
  // A bare copy of an explicitly-typed local ('a' is a real num, not
  // a let) carries that type forward.
  assert contains(hints, `"position":{"line":12,"character":7}`), "expected a hint positioned right after 'c'";
}

test "inlay hints chase a bare copy through another unresolved let, bounded by a depth cap" {
  // 'a' is itself let-inferred, so its own AST-stored type is
  // permanently the sentinel regardless of what heuristic guess its
  // own hint shows - but that guess is re-derivable on demand from
  // 'a's own initializer, so a copy of it resolves the same way 'a'
  // itself would hint, not just its first hop.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///hints2b.fn";
  doc.path = "hints2b.fn";
  doc.text = `fun helper() num { ret 5; }
  `fun top() {
  `  let a = helper();
  `  let c = a;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 10);
  assert !contains(hints, "__let_infer__"), "expected the sentinel never shown verbatim";
  assert contains(hints, `"position":{"line":3,"character":7},"label":": num"`), "expected the chained copy to resolve the same way its source local would";
}

test "inlay hints stop chasing a chain of bare copies past the depth cap, showing no hint rather than looping" {
  // A short, deliberate chain of plain copies exercises the depth cap
  // (MAX_LET_INFER_DEPTH) without a document malformed enough to
  // actually cycle: nine hops from a real call is one past the cap,
  // so the last local in the chain shows no hint while every earlier
  // one still resolves.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///hints2c.fn";
  doc.path = "hints2c.fn";
  doc.text = `fun helper() num { ret 5; }
  `fun top() {
  `  let a0 = helper();
  `  let a1 = a0;
  `  let a2 = a1;
  `  let a3 = a2;
  `  let a4 = a3;
  `  let a5 = a4;
  `  let a6 = a5;
  `  let a7 = a6;
  `  let a8 = a7;
  `  let a9 = a8;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 20);
  assert !contains(hints, "__let_infer__"), "expected the sentinel never shown verbatim";
  // a1 (line 3) is one hop from the real call, well inside the cap;
  // a9 (line 11) is nine hops away, past it.
  assert contains(hints, `"position":{"line":3,"character":8},"label":": num"`), "expected an early copy in the chain to still resolve";
  assert !contains(hints, `"position":{"line":11`), "expected the copy past the depth cap to show no hint";
}

test "inlay hints substitute a generic function's own type parameter from the call site's arguments" {
  // chain_ending_receiver's plain-call branch used to hand back a
  // generic function's declared return type completely unsubstituted
  // (`fun pick_first<T>(T a, T b) T` called with two nums hinted as
  // the bare "T", not "num"). User-reported, from
  // examples/let_and_lowlevel_types.fn. The Point case pairs a
  // compound-literal argument (never itself resolvable, by design)
  // with a plain call, the same shape the real example uses: only one
  // matching argument has to resolve for the whole call to specialize.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///genericcall.fn";
  doc.path = "genericcall.fn";
  doc.text = `compound Point {
  `  num x;
  `  num y;
  `}
  `fun make_point(num x, num y) Point {
  `  ret Point{x = x, y = y};
  `}
  `fun pick_first<T>(T a, T b) T {
  `  _ = b;
  `  ret a;
  `}
  `fun main() {
  `  let from_num = pick_first(100, 200);
  `  let p1 = Point{x = 1, y = 2};
  `  let p2 = make_point(3, 4);
  `  let from_point = pick_first(p1, p2);
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 20);
  assert !contains(hints, `"label":": T"`), "expected no raw, unsubstituted type parameter in any hint";
  assert contains(hints, `"position":{"line":12,"character":14},"label":": num"`), "expected the num instantiation substituted";
  assert contains(hints, `"position":{"line":15,"character":16},"label":": Point"`), "expected the Point instantiation substituted";
}

test "a generic function's return substitutes against a compound-shaped parameter, not just a bare type param" {
  // `swap_pair<L, R>(Pair<L, R> p) Pair<R, L>` never matches a call
  // argument's type here, since neither declared parameter is itself
  // a bare type param - only Pair's own generic args are. Before this
  // fix, `_call_return_type` only matched a parameter whose whole
  // declared type equaled one type param name, so `swapped` hovered
  // as the raw "Pair<R, L>" and `pick_left(pair)`/`pick_left(swapped)`
  // both showed the bare "L", never resolving to a concrete type at
  // all. examples/advanced/generic_inference_after_init.fn.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///swappair.fn";
  doc.path = "swappair.fn";
  doc.text = `compound Pair<L, R> {
  `  L left;
  `  R right;
  `}
  `fun make_pair<L, R>(L left, R right) Pair<L, R> {
  `  ret Pair<L, R>{left = left, right = right};
  `}
  `fun pick_left<L, R>(Pair<L, R> p) L {
  `  ret p.left;
  `}
  `fun swap_pair<L, R>(Pair<L, R> p) Pair<R, L> {
  `  ret Pair<R, L>{left = p.right, right = p.left};
  `}
  `fun main() {
  `  let pair = make_pair(7, "hi");
  `  let swapped = swap_pair(pair);
  `  let left_num = pick_left(pair);
  `  let left_str = pick_left(swapped);
  `}`;
  doc.version = 1;

  assert contains(hover(&reads, doc, 15, 6), "Pair<str, num> swapped"), "expected swap_pair's own two type params substituted from Pair's own field args, not left raw";
  assert contains(hover(&reads, doc, 16, 6), "num left_num"), "expected pick_left's bare return substituted through a compound parameter";
  assert contains(hover(&reads, doc, 17, 6), "str left_str"), "expected pick_left substituted again against the swapped pair's own args";
}

test "hover on a generic function's own callee name specializes its signature against the call's own arguments" {
  // Hovering the callee itself (not a let-inferred local reading its
  // result) showed the same raw, unsubstituted signature. User-reported.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///genericcallee.fn";
  doc.path = "genericcallee.fn";
  doc.text = `fun pick_first<T>(T a, T b) T {
  `  _ = b;
  `  ret a;
  `}
  `fun main() {
  `  let x = pick_first(100, 200);
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 5, 10);
  assert contains(hovered, "pick_first(num a, num b) num"), "expected the callee's own hover to show the specialized signature, not the bare template";
}

test "let inference unwraps an await expression to its own async return type" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///awaitinfer.fn";
  doc.path = "awaitinfer.fn";
  doc.text = `async fun fetch() num {
  `  ret 5;
  `}
  `async fun main() {
  `  let out = await fetch();
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 10);
  assert contains(hints, `"position":{"line":4,"character":9},"label":": num"`), "expected an await expression's own inlay hint to unwrap to its async return type";
  str hovered = hover(&reads, doc, 4, 6);
  assert contains(hovered, "num out"), "expected hover on the await-inferred local to show its own async return type";
}

test "let inference resolves a binary arithmetic expression, promoting num to dec the same way the real typechecker does" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///arithinfer.fn";
  doc.path = "arithinfer.fn";
  doc.text = `fun main() {
  `  let total = 20;
  `  let bonus = 8;
  `  let final_total = total + bonus;
  `  let f = 1.5;
  `  let mixed = total + f;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 10);
  assert contains(hints, `"position":{"line":3,"character":17},"label":": num"`), "expected num + num to infer num";
  assert contains(hints, `"position":{"line":5,"character":11},"label":": dec"`), "expected num + dec to promote to dec, matching the real typechecker's own rule";
}

test "let inference unwraps a pointer dereference to one level shallower than its own operand" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///derefinfer.fn";
  doc.path = "derefinfer.fn";
  doc.text = `compound Point {
  `  num x;
  `}
  `fun make() Point* {
  `  Point p;
  `  ret &p;
  `}
  `fun main() {
  `  let pp = make();
  `  let p = *pp;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 10);
  assert contains(hints, `"position":{"line":8,"character":8},"label":": Point*"`), "expected pp's own pointer type";
  assert contains(hints, `"position":{"line":9,"character":7},"label":": Point"`), "expected the dereference one level shallower than its operand";
}

test "let inference dispatches a method call through a value typed as a quirk, not just a concrete impl type" {
  // chain_receiver/chain_ending_receiver only ever searched an impl
  // block by the implementing type's own name (lookup_method), never
  // falling back to the quirk's own declared signature - a quirk-typed
  // field or local's own method call (dispatched dynamically at
  // runtime) never resolved at all. User-reported, from
  // examples/advanced/async_quirk_await_pointer_receiver.fn.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///quirkchain.fn";
  doc.path = "quirkchain.fn";
  doc.text = `quirk Greeter {
  `  greet() num;
  `}
  `compound Loud {
  `  num n;
  `}
  `impl Loud as Greeter {
  `  greet() num {
  `    ret self.n;
  `  }
  `}
  `fun main() {
  `  Loud l;
  `  Greeter g = &l;
  `  let out = g.greet();
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 20);
  assert contains(hints, `"position":{"line":14,"character":9},"label":": num"`), "expected a method call through a quirk-typed local to resolve via the quirk's own declared signature";
}

test "let inference specializes a generic compound field's own type against its receiver's concrete instantiation" {
  // lookup_field never took the receiver's own concrete generic args
  // at all (unlike lookup_method, which already did), so a generic
  // compound field's type always read as its own bare, unspecialized
  // type parameter. `b`'s own receiver type has to come from
  // somewhere already resolvable (a function's own declared return
  // type here, not a compound literal - that shape is still its own
  // separate, unresolved case, covered by a different existing test).
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fieldgeneric.fn";
  doc.path = "fieldgeneric.fn";
  doc.text = `compound Box<T> {
  `  T v;
  `}
  `fun make_box() Box<num> {
  `  Box<num> b;
  `  b.v = 5;
  `  ret b;
  `}
  `fun main() {
  `  let b = make_box();
  `  let x = b.v;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 12);
  assert contains(hints, `"position":{"line":9,"character":7},"label":": Box<num>"`), "expected b's own receiver type";
  assert contains(hints, `"position":{"line":10,"character":7},"label":": num"`), "expected the generic field's own type substituted against its receiver's concrete instantiation";
}

test "let inference continues a chain past a parenthesized sub-expression, not just an identifier" {
  // chain_receiver/chain_ending_receiver only ever walked backward
  // from an identifier; `(<expr>).field.method()` has no identifier to
  // walk backward from at all, so any chain continuing past a
  // parenthesized base never resolved past that paren.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///parenchain.fn";
  doc.path = "parenchain.fn";
  doc.text = `compound Box {
  `  num n;
  `}
  `impl Box {
  `  doubled() num {
  `    ret self.n * 2;
  `  }
  `}
  `fun make() Box* {
  `  Box b;
  `  b.n = 5;
  `  ret &b;
  `}
  `fun main() {
  `  let out = (*make()).doubled();
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 20);
  assert contains(hints, `"position":{"line":14,"character":9},"label":": num"`), "expected the chain continuing past the parenthesized dereference to resolve to the method's own return type";
}

test "inlay hints name a call argument correctly even when the parameter has a default value" {
  // param_name_from_piece's own trailing-identifier walk used to read
  // a numeric default's own digits as the name ("num cap = 8" ->
  // "8"), since hover's own defaulted-param fix appended " = 8" to
  // the exact same rendered signature this shares. User-reported.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///defhint.fn";
  doc.path = "defhint.fn";
  doc.text = `fun make(num cap = 8) num {
  `  ret cap;
  `}
  `fun use_it() num {
  `  ret make(3);
  `}`;
  doc.version = 1;

  str out = inlay_hints(&reads, doc, 0, 100);
  assert contains(out, `"label":"cap:"`), "expected the parameter's own name, not its default value's digits";
  assert !contains(out, `"label":"8:"`), "expected no digit-shaped label leaking from the default value";
}

test "inlay hints name each call argument, skip declarations, skip redundant matches, and skip self on a method" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///paramhints.fn";
  doc.path = "paramhints.fn";
  doc.text = `fun greet(str name, num count) str {
  `  ret name;
  `}
  `compound Server {
  `  num count;
  `}
  `impl Server {
  `  bump(num delta, num limit) num {
  `    ret self.count + delta + limit;
  `  }
  `}
  `fun main() num {
  `  num delta = 3;
  `  greet("hi", 2);
  `  Server s;
  `  s.bump(delta, 10);
  `  ret 0;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 30);
  // A plain call names both arguments.
  assert contains(hints, `"label":"name:"`), "expected a hint for the first argument";
  assert contains(hints, `"label":"count:"`), "expected a hint for the second argument";
  // Neither the function declaration nor the method declaration (no
  // 'fun' keyword at all) is itself mistaken for a call.
  assert !contains(hints, `"line":0`), "expected no hint on the function declaration's own line";
  assert !contains(hints, `"line":7`), "expected no hint on the method declaration's own line";
  // A method call skips 'self' (parameter 0 in its own rendered
  // signature) and names only the arguments actually written.
  assert !contains(hints, `"label":"self:"`), "expected self never shown as an argument hint";
  assert contains(hints, `"label":"limit:"`), "expected the method's second real parameter to be named";
  // The first argument to bump (a bare 'delta' matching the
  // parameter name 'delta' exactly) is redundant and gets no hint.
  assert !contains(hints, `"label":"delta:"`), "expected the redundant bare-identifier argument to be suppressed";
}

test "inlay hints suppress the raw __let_infer__ sentinel rather than showing it verbatim" {
  // A bare copy of a let local whose OWN type this heuristic still
  // can't resolve (an enum shorthand - `.Red` needs the surrounding
  // expected type to know which enum it names at all, not something
  // _infer_type has a way to see) must not leak the parser's internal
  // placeholder into the hint text, and must not chase the copy into
  // a wrong hint either.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///hints3.fn";
  doc.path = "hints3.fn";
  doc.text = `enum Color { Red, Green }
  `fun main() {
  `  let a = .Red;
  `  let b = a;
  `}`;
  doc.version = 1;

  str hints = inlay_hints(&reads, doc, 0, 10);
  assert !contains(hints, "__let_infer__"), "expected the sentinel never shown verbatim";
  assert !contains(hints, `"line":2`), "expected no hint at all for the unresolved copy";
}

test "code actions offer to remove an unused import and to silence any warning" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///unused.fn";
  doc.path = "unused.fn";
  doc.text = `imp std.io;
  `
  `fun main() num {
  `  ret 0;
  `}`;
  doc.version = 1;

  Diagnostic d;
  d.line = 0;
  d.col = 0;
  d.end_line = 0;
  d.end_col = 1;
  d.severity = DIAG_SEVERITY_WARNING;
  d.message = "unused_import: unused import 'std.io'";
  Vec<Diagnostic> diags;
  diags.init(1);
  diags.push(d);

  str out = code_actions(&reads, doc, doc.uri, &diags);
  assert contains(out, `"title":"Remove unused import"`), "expected the removal quick fix";
  // Deletes the whole line 0, including its own newline.
  assert contains(
    out,
    `"start":{"line":0,"character":0},"end":{"line":1,"character":0}},"newText":""`
  ), "expected an edit deleting the whole import line";
  assert contains(out, `"title":"Silence with 'allow unused_import;'"`), "expected the allow quick fix";
  assert contains(out, `"newText":"allow unused_import;\n"`), "expected the allow statement inserted above";

  // Most errors carry no mechanical fix of their own (unlike the
  // quirk-conformance shape tested below).
  Diagnostic err;
  err.line = 2;
  err.col = 0;
  err.end_line = 2;
  err.end_col = 1;
  err.severity = DIAG_SEVERITY_ERROR;
  err.message = "some type error";
  Vec<Diagnostic> err_diags;
  err_diags.init(1);
  err_diags.push(err);
  assert equals(code_actions(&reads, doc, doc.uri, &err_diags), "[]"), "expected no quick fix offered for an unrecognized error";
}

test "code actions fill in a fit's missing arm with a correctly-sized stub" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///nonexhaustive.fn";
  doc.path = "nonexhaustive.fn";
  doc.text = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `}
  `fun area(Shape s) num {
  `  fit s {
  `    .Circle(r) -> { ret r * r; }
  `  }
  `  ret 0;
  `}`;
  doc.version = 1;

  Diagnostic d;
  d.line = 5;
  d.col = 2;
  d.end_line = 5;
  d.end_col = 5;
  d.severity = DIAG_SEVERITY_WARNING;
  d.message = "fit_non_exhaustive: fit does not handle 'Shape.Square'";
  Vec<Diagnostic> diags;
  diags.init(1);
  diags.push(d);

  str out = code_actions(&reads, doc, doc.uri, &diags);
  assert contains(out, `"title":"Fill in missing 'Shape.Square' arm"`), "expected the fit-arm quick fix";
  assert contains(out, `"newText":"  .Square(v0) -> {}\n"`), "expected a correctly-sized stub, Square takes one payload value";
  // Inserted right before the fit block's own closing brace (line 7).
  assert contains(out, `"start":{"line":7,"character":2}`), "expected the insertion right before the fit's closing brace";
}

test "code actions fill in every missing arm at once, not just the first" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///nonexhaustive_multi.fn";
  doc.path = "nonexhaustive_multi.fn";
  doc.text = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `  Triangle,
  `}
  `fun area(Shape s) num {
  `  fit s {
  `    .Circle(r) -> { ret r * r; }
  `  }
  `  ret 0;
  `}`;
  doc.version = 1;

  Diagnostic d;
  d.line = 6;
  d.col = 2;
  d.end_line = 6;
  d.end_col = 5;
  d.severity = DIAG_SEVERITY_WARNING;
  // The compiler itself now names every missing variant in one
  // message, not just the first - check_fit's own list, comma-joined.
  d.message = "fit_non_exhaustive: fit does not handle 'Shape.Square', 'Shape.Triangle'";
  Vec<Diagnostic> diags;
  diags.init(1);
  diags.push(d);

  str out = code_actions(&reads, doc, doc.uri, &diags);
  assert contains(out, `"title":"Fill in missing 'Shape.Square', 'Shape.Triangle' arms"`), "expected one fix naming both missing variants, plural";
  assert contains(out, `.Square(v0) -> {}`), "expected a stub for Square";
  assert contains(out, `.Triangle -> {}`), "expected a stub for Triangle too, in the same fix";
  // Both stubs land in one edit, right before the fit block's own
  // closing brace (line 8).
  assert contains(out, `"start":{"line":8,"character":2}`), "expected one insertion point for both stubs";
}

test "code actions implement a quirk's missing method with its exact declared signature" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///quirkgap.fn";
  doc.path = "quirkgap.fn";
  doc.text = `compound Point {
  `  num x;
  `}
  `quirk Q {
  `  a() num;
  `  b(num n) bin;
  `}
  `impl Point as Q {
  `  a() num { ret self.x; }
  `}`;
  doc.version = 1;

  Diagnostic d;
  d.line = 7;
  d.col = 0;
  d.end_line = 7;
  d.end_col = 1;
  d.severity = DIAG_SEVERITY_ERROR;
  d.message = "'Point' does not supply 'b', which 'Q' requires";
  Vec<Diagnostic> diags;
  diags.init(1);
  diags.push(d);

  str out = code_actions(&reads, doc, doc.uri, &diags);
  assert contains(out, `"title":"Implement missing 'Q.b'"`), "expected the quirk-method quick fix";
  assert contains(out, `"newText":"  pub b(num n) bin {\n    // TODO: implement\n  }\n"`), "expected a stub with the quirk's own declared signature, no 'self'";
  // Inserted right before the impl block's own closing brace (line 9).
  assert contains(out, `"start":{"line":9,"character":0}`), "expected the insertion right before the impl's closing brace";
}

test "code actions insert 'await' right where a missing-await error points" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///needsawait.fn";
  doc.path = "needsawait.fn";
  doc.text = `async fun fetch() num { ret 1; }
  `fun main() num {
  `  let v = fetch();
  `  ret v;
  `}`;
  doc.version = 1;

  Diagnostic d;
  d.line = 2;
  d.col = 10;
  d.end_line = 2;
  d.end_col = 17;
  d.severity = DIAG_SEVERITY_ERROR;
  d.message = "call to async function 'fetch' needs await";
  Vec<Diagnostic> diags;
  diags.init(1);
  diags.push(d);

  str out = code_actions(&reads, doc, doc.uri, &diags);
  assert contains(out, `"title":"Insert 'await'"`), "expected the insert-await quick fix";
  assert contains(out, `"start":{"line":2,"character":10}`), "expected the insertion right where the diagnostic points";
  assert contains(out, `"newText":"await "`), "expected 'await ' as the inserted text";
}

test "code actions mark the enclosing function async for an await-outside-async error" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///awaitoutside.fn";
  doc.path = "awaitoutside.fn";
  doc.text = `async fun fetch() num { ret 1; }
  `fun main() num {
  `  ret await fetch();
  `}`;
  doc.version = 1;

  Diagnostic d;
  d.line = 2;
  d.col = 8;
  d.end_line = 2;
  d.end_col = 20;
  d.severity = DIAG_SEVERITY_ERROR;
  d.message = "await is only allowed in an async function";
  Vec<Diagnostic> diags;
  diags.init(1);
  diags.push(d);

  str out = code_actions(&reads, doc, doc.uri, &diags);
  assert contains(out, `"title":"Mark enclosing function async"`), "expected the mark-async quick fix";
  // Right before 'main''s own 'fun' keyword (line 1).
  assert contains(out, `"start":{"line":1,"character":0}`), "expected the insertion right before the enclosing 'fun'";
  assert contains(out, `"newText":"async "`), "expected 'async ' as the inserted text";
}

test "completion still answers while the text does not parse" {
  // What a reader is typing is half-written by definition, so a failed
  // parse must not turn into an empty reply.
  str src = `fun helper(num total) num {
  `  tot
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///half.fn";
  doc.path = "half.fn";
  doc.text = src;
  doc.version = 1;

  str out = completion(&reads, doc, 1, 5, false);
  assert contains(out, `"label":"ret"`), "expected the reserved words";
  assert contains(out, `"label":"total"`), "expected a name already written in the file";
}

test "completion classifies a name's own kind from raw token shape when the text does not parse" {
  str src = `pub fun sqrt_dec(dec x dec {
