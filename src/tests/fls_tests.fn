}

test "a bare '.Variant' shorthand completes correctly when the fit's own subject is a field access, and when the arm is a ret, both while the document does not parse" {
  str src = `enum TokenKind {
  `  Comment,
  `  NewLine,
  `  Ident,
  `}
  `
  `compound Token {
  `  TokenKind kind;
  `}
  `
  `fun is_trivia(Token t) num {
  `  fit t.kind {
  `    . -> { ret 1; }
  `  }
  `  ret 0;
  `}
  `
  `fun find_thing() TokenKind {
  `  if 1 == 1 {
  `    ret .
  `  }
  `  ret .Ident;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fieldfit.fn";
  doc.path = "fieldfit.fn";
  doc.text = src;
  doc.version = 1;

  // Line 12, right after the dot in 'fit t.kind { . }': the fit's own
  // subject is a field access ('t.kind', this codebase's own
  // dominant idiom for matching an AST node's kind), not a bare
  // local - the earlier fix only covered a bare local subject.
  str field_fit = completion(&reads, doc, 12, 5, false);
  assert contains(field_fit, `"label":"Comment","kind":20`), "expected TokenKind's own variants through a field-access fit subject";
  assert contains(field_fit, `"label":"Ident","kind":20`), "expected every variant";
  assert !contains(field_fit, `"detail":"in this file"`), "expected real variants, not the unscoped word list";

  // Line 19, right after the dot in 'ret .': the enclosing function's
  // own declared return type, .
  str ret_shape = completion(&reads, doc, 19, 9, false);
  assert contains(ret_shape, `"label":"Comment","kind":20`), "expected TokenKind's own variants after a bare 'ret .'";
  assert !contains(ret_shape, `"detail":"in this file"`), "expected real variants, not the unscoped word list";
}

test "a bare '.Variant' shorthand resolves a field-access fit subject even when the field's own type is declared in an imported file, not the current document" {
  str src = `imp ..ast.ast;
  `
  `fun probe(Node* n) num {
  `  fit n.kind {
  `    . -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///src/fls/nodeprobe.fn";
  doc.path = "src/fls/nodeprobe.fn";
  doc.text = src;
  doc.version = 1;

  // Line 4, right after the dot: 'n's own type (Node) resolves
  // locally from its own parameter declaration, but Node itself, and
  // its own 'kind' field's type (NodeKind), are both declared in
  // ast.fn - reached only through the plain '..ast.ast' import, the
  // exact real-world shape this bug reproduced on
  // (src/fls/symbols.fn's own `fit body.kind { ... }`).
  str out = completion(&reads, doc, 4, 5, false);
  assert contains(out, `"label":"Function","kind":20`), "expected NodeKind's own variants through Node's own field, reached across the import";
  assert contains(out, `"label":"Compound","kind":20`), "expected another real variant too";
  assert !contains(out, `"detail":"in this file"`), "expected real variants, not the unscoped word list";
}

