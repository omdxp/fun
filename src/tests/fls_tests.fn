  doc.text = src;
  doc.version = 1;

  // Right after the dot in 'takes(.Red)' (line 11): the callee's own
  // declared parameter type. The document parses cleanly here (unlike
  // the other three shapes above), so this exercises the AST-driven
  // path rather than the token-only one.
  str out = completion(&reads, doc, 11, 9, false);
  assert contains(out, `"label":"Red","kind":20`), "expected Color's own variants as a call argument";
  assert contains(out, `"label":"Blue","kind":20`), "expected every variant";
