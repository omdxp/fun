test "a bare '.Variant' shorthand resolves correctly against a field-access operand in a comparison or assignment, not just a bare local" {
  str src = `enum Color {
  `  Red,
  `  Green,
  `  Blue,
  `}
  `
  `compound Widget {
  `  Color c;
