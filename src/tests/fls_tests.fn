  // Right after the dot (line 5): 'fit <- ch { ... }' desugars to
  // 'ch.recv()' at parse time, so this is the channel-receive
  // shorthand shape, not a bare local or a field access - and the
  // moment a reader triggers this by typing the dot, the document
  // can't parse yet, exercising the token-only path specifically.
  str out = completion(&reads, doc, 5, 5, false);
  assert contains(out, `"label":"Compute","kind":20`), "expected Msg's own variants through the channel's own element type";
  assert contains(out, `"label":"Stop","kind":20`), "expected every variant";
