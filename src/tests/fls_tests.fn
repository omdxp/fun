}

test "a bare '.Variant' shorthand renders a payload-carrying variant's own types, in a fit arm and a ret, parsed or not" {
  str src = `enum Shape {
  `  Circle(num),
  `  Rect(num, num),
  `  Point,
  `}
  `
  `fun area(Shape s) num {
  `  fit s {
  `    . -> { ret 0; }
  `  }
  `  ret 0;
  `}
  `
  `fun make() Shape {
  `  ret .
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///payload.fn";
  doc.path = "payload.fn";
  doc.text = src;
  doc.version = 1;

  // Line 8, right after the dot in the fit arm: the document does
  // not parse (the bare '.' isn't valid on its own), exercising the
  // token-only payload renderer.
  str fit_arm = completion(&reads, doc, 8, 5, false);
  assert contains(fit_arm, `"label":"Circle","kind":20,"detail":"Circle(num)"`), "expected a single-payload variant's own type rendered";
  assert contains(fit_arm, `"label":"Rect","kind":20,"detail":"Rect(num, num)"`), "expected a multi-payload variant's own types rendered, comma-separated";
  assert contains(fit_arm, `"label":"Point","kind":20,"detail":"Point"`), "expected a payload-free variant's own detail to stay bare";

  // Line 14, right after the dot in 'ret .': same token-only payload
  // renderer, reached through the return-type path instead.
  str ret_shape = completion(&reads, doc, 14, 7, false);
  assert contains(ret_shape, `"label":"Circle","kind":20,"detail":"Circle(num)"`), "expected the same payload rendering through 'ret .'";
}

