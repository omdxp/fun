  defer reads.free();
  Document doc;
  doc.uri = "file:///halfkind.fn";
  doc.path = "halfkind.fn";
  doc.text = src;
  doc.version = 1;

  str out = completion(&reads, doc, 13, 8, false);
  assert contains(out, `"label":"sqrt_dec","kind":3`), "expected a name followed by '(' anywhere to read as a function";
  assert contains(out, `"label":"Vec2","kind":22`), "expected a name declared with 'compound' to read as a struct";
  assert contains(out, `"label":"Sign","kind":13`), "expected a name declared with 'enum' to read as an enum";
}

test "dot-completion after an import alias lists the aliased module's own functions even while the document does not parse" {
  str src = `imp std.c.math as cmath;
  `
  `fun main() num {
  `  ret cmath.sqrt(4.0
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///halfalias.fn";
  doc.path = "halfalias.fn";
  doc.text = src;
  doc.version = 1;

  // Line 3, right after 'cmath.'; the missing ')' above leaves the
  // document unparseable, which is exactly when a reader is typing
  // this and needs a real answer, not the fallback word list.
  str out = completion(&reads, doc, 3, 12, false);
  assert contains(out, `"label":"sqrt","kind":3`), "expected the aliased module's own function even though the document does not parse";
  assert !contains(out, `"detail":"in this file"`), "expected the real module functions, not the unparsed-fallback word list";
}

test "dot-completion after an enum's own type name or an instance of it lists its variants, not the whole file" {
  str src = `enum Color {
  `  Red,
  `  Green,
  `  Blue,
  `}
  `
  `fun main() num {
  `  Color c = Color.Green;
  `  c.Blue;
  `  ret 0;
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///colors.fn";
  doc.path = "colors.fn";
  doc.text = src;
  doc.version = 1;

  // Line 7, right after 'Color.': the enum names itself as its own
  // receiver, the same way an alias names a module.
  str type_qualified = completion(&reads, doc, 7, 18, false);
  assert contains(type_qualified, `"label":"Red","kind":20`), "expected Color's own variants after the type name itself";
  assert contains(type_qualified, `"label":"Blue","kind":20`), "expected every variant, not just the one already written";
  assert !contains(type_qualified, `"detail":"in this file"`), "expected real variants, not the unscoped word list";

  // Line 8, right after 'c.': not real Fun syntax (variants are
  // reached through the enum's own name, not an instance), but the
  // receiver resolves to the same type either way, so this completes
  // the same way rather than falling back to the whole file.
  str instance = completion(&reads, doc, 8, 4, false);
  assert contains(instance, `"label":"Red","kind":20`), "expected the same variants completing through an instance";
}

test "dot-completion scopes to a local's own declared type even while the document does not parse" {
  str enum_src = `enum Color {
  `  Red,
  `  Green,
  `  Blue,
  `}
  `
  `fun main() {
  `  Color c = Color.Green;
  `  c.Blue;
  `  fi
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///halfenum.fn";
  doc.path = "halfenum.fn";
  doc.text = enum_src;
  doc.version = 1;

  // Line 8, right after 'c.'; the bare 'fi' on the next line leaves
  // the whole document unparseable, exactly the reported scenario.
  str out = completion(&reads, doc, 8, 4, false);
  assert contains(out, `"label":"Red","kind":20`), "expected every variant even though the document does not parse";
  assert contains(out, `"label":"Green","kind":20`), "expected the second variant too, not just the one immediately after the opening brace";
  assert contains(out, `"label":"Blue","kind":20`), "expected the third variant too, not just the one immediately after a comma";
  assert !contains(out, `"detail":"in this file"`), "expected real variants, not the unscoped word list";

  str compound_src = `compound Vec2 {
  `  dec x;
  `  dec y;
  `}
  `
  `impl Vec2 {
  `  pub length() dec {
  `    ret 0.0;
  `  }
  `}
  `
  `fun main() {
  `  Vec2 v;
  `  v.x;
  `  fi
  `}`;
  Document doc2;
  doc2.uri = "file:///halfcompound.fn";
  doc2.path = "halfcompound.fn";
  doc2.text = compound_src;
  doc2.version = 1;

  // Line 13, right after 'v.'.
  str out2 = completion(&reads, doc2, 13, 4, false);
  assert contains(out2, `"label":"x","kind":5`), "expected the compound's own field";
  assert contains(out2, `"label":"length","kind":2`), "expected the impl's own method too, from a separate impl block";
  assert !contains(out2, `"detail":"in this file"`), "expected real fields/methods, not the unscoped word list";
}

test "dot-completion on a generic-typed local reaches a stdlib type through a plain import, even while the document does not parse" {
  str src = `imp std.vec;
  `imp std.string;
  `
  `fun main() {
  `  Vec<str> lines = split_lines("a\nb");
  `  lines.
  `  fi
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///halfvec.fn";
  doc.path = "halfvec.fn";
  doc.text = src;
  doc.version = 1;

  // Line 5, right after 'lines.'. 'Vec' is never declared in this
  // document at all, only reached through a plain (unaliased) `imp
  // std.vec;` - the receiver's own generic type annotation (the `<`/
  // `>` between the base type and the name) also has to be walked
  // past correctly to find 'Vec' in the first place.
  str out = completion(&reads, doc, 5, 8, false);
  assert contains(out, `"label":"push","kind":2`), "expected Vec's own real method through the plain import";
  assert contains(out, `"label":"len","kind":5`), "expected Vec's own real field too";
  assert !contains(out, `"detail":"in this file"`), "expected real members, not the unscoped word list";
}

test "an identifier being typed does not suggest itself back while the document does not parse" {
  str src = `fun main() {
  `  bloater
  `  fi
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///halfword.fn";
  doc.path = "halfword.fn";
  doc.text = src;
  doc.version = 1;

  // Line 1, right after typing 'bloater': it is already a real token
  // in the buffer the instant it exists, but it isn't a declared
  // name, and offering it back as its own suggestion is misleading.
  str out = completion(&reads, doc, 1, 9, false);
  assert !contains(out, `"label":"bloater"`), "expected the word being typed not to suggest itself";
}

test "a bare '.Variant' shorthand completes to only its own enum's variants, in a fit arm, a comparison, and an assignment, even while the document does not parse" {
  str src = `enum Color {
  `  Red,
  `  Green,
  `  Blue,
  `}
  `
  `fun takes(Color c) {
  `  fit c {
  `    . -> {}
  `  }
  `}
  `
  `fun main() {
  `  Color c = .
  `  if c == . {
  `  }
  `}`;
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///halfshorthand.fn";
  doc.path = "halfshorthand.fn";
  doc.text = src;
  doc.version = 1;

  // Right after the dot in a fit arm's own pattern (line 8): the fit
  // statement's own subject, 'c', names Color, read token-only.
  str fit_arm = completion(&reads, doc, 8, 5, false);
  assert contains(fit_arm, `"label":"Red","kind":20`), "expected Color's own variants in a fit arm";
  assert contains(fit_arm, `"label":"Blue","kind":20`), "expected every variant, not just one";
  assert !contains(fit_arm, `"label":"fun"`), "expected only variants, not keywords too";
  assert !contains(fit_arm, `"detail":"in this file"`), "expected real variants, not the unscoped word list";

  // Right after the dot in a typed declaration's own RHS (line 13):
  // the declared LHS type, Color.
  str assignment = completion(&reads, doc, 13, 13, false);
  assert contains(assignment, `"label":"Green","kind":20`), "expected Color's own variants after a declaration's '='";

  // Right after the dot in a comparison (line 14): the other
  // operand's own declared type.
  str comparison = completion(&reads, doc, 14, 11, false);
  assert contains(comparison, `"label":"Red","kind":20`), "expected Color's own variants after '=='";
}

test "a bare '.Variant' shorthand as a call argument completes to only its own enum's variants" {
  str src = `enum Color {
  `  Red,
  `  Green,
