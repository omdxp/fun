  doc.uri = "file:///fieldassign.fn";
  doc.path = "fieldassign.fn";
  doc.text = src;
  doc.version = 1;

  // Line 11, right after the dot in 'w.c = .': the earlier assignment
  // fix only ever resolved a bare local's own type, mistaking a
  // field access for one (the last token before '=', 'c', treated as
  // if it were itself a locally-declared name called 'c', which it
  // is not).
  str out = completion(&reads, doc, 11, 9, false);
  assert contains(out, `"label":"Red","kind":20`), "expected Color's own variants through the field access on the assignment's own left side";
  assert !contains(out, `"detail":"in this file"`), "expected real variants, not the unscoped word list";
}

test "formatting replaces the document with what the formatter produces" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fmt.fn";
  doc.path = "fmt.fn";
  doc.text = "fun main() num {\n  num x=1;\n  ret x;\n}\n";
  doc.version = 1;

  str out = formatting(doc);
  assert contains(out, `"newText"`), "expected an edit";
  assert contains(out, "num x = 1;"), "expected the formatted text";
  // The range ends one past the last line, which is how the whole
  // document is named without measuring the last line.
  assert contains(out, `"start":{"line":0,"character":0}`), "expected the range to start at the top";
  assert contains(out, `"character":0}}`), "expected the range to end at a line start";
}

test "formatting a document already formatted asks for no edit" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///tidy.fn";
  doc.path = "tidy.fn";
  doc.text = "fun main() num {\n  num x = 1;\n  ret x;\n}\n";
  doc.version = 1;

  // An empty list leaves the client's undo history alone.
  assert equals(formatting(doc), "[]"), "expected no edit for text already formatted";
}

test "formatting leaves text it cannot read alone" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///broken.fn";
  doc.path = "broken.fn";
  doc.text = "fun main() num {\n  ret 0\n}\n";
  doc.version = 1;

  // Refusing to format is better than rewriting a file whose meaning is
  // not yet clear.
  assert equals(formatting(doc), "[]"), "expected no edit for text that does not parse";
}

test "folding range covers a multi-line block, but not a single-line one" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///fold.fn";
  doc.path = "fold.fn";
  doc.text = `fun add(num a, num b) num {
  `  if a > b {
  `    ret a;
  `  }
  `  ret b;
  `}
  `fun one_liner() num { ret 1; }`;
  doc.version = 1;

  str out = folding_ranges(&reads, doc);
  // The outer function (lines 0-5) and the nested if-block (lines
  // 1-3), 0-indexed, each on different lines for their own braces.
  assert contains(out, `{"startLine":0,"endLine":5}`), "expected the outer function to fold";
  assert contains(out, `{"startLine":1,"endLine":3}`), "expected the nested if-block to fold";
  // one_liner's own braces share a line, nothing worth folding there.
  assert !contains(out, `"startLine":6`), "expected no fold starting on the one-liner's own line";
}

test "code lens shows a reference count per function, correctly pluralized" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  docs.opened(
    "file:///cl.fn",
    `fun add(num a, num b) num {
    `  ret a + b;
    `}
    `fun use_it() num {
    `  ret add(1, 2) + add(3, 4);
    `}`,
    1
  );
  let held = docs.at("file:///cl.fn");
  Document doc = held.unwrap();

  str out = code_lenses(&reads, &docs, doc);
  // add: its own declaration plus two calls.
  assert contains(out, `"title":"3 references"`), "expected add's own count, plural";
  // use_it: declared, never called.
  assert contains(out, `"title":"1 reference"`), "expected use_it's own count, singular";
  assert contains(out, `"command":"fun.showReferences"`), "expected the extension-side wrapper command, not the raw built-in one";
}

test "code lens skips main and impl methods, but covers compounds, enums, and quirks" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  docs.opened(
    "file:///scope.fn",
    `compound Widget {
    `  num n;
    `}
    `enum Shape {
    `  Circle(num),
    `}
    `quirk Speaks {
    `  say() str;
    `}
    `impl Widget {
    `  pub free() {}
    `}
    `fun main() num {
    `  ret 0;
    `}`,
    1
  );
  let held = docs.at("file:///scope.fn");
  Document doc = held.unwrap();

  str out = code_lenses(&reads, &docs, doc);
  assert contains(out, `"start":{"line":0,"character":9}`), "expected a lens on Widget";
  assert contains(out, `"start":{"line":3,"character":5}`), "expected a lens on Shape";
  assert contains(out, `"start":{"line":6,"character":6}`), "expected a lens on Speaks";
  assert !contains(out, "main"), "expected no lens on main, an entry point invoked by the runtime";
  assert !contains(out, `"start":{"line":10,"character":6}`), "expected no lens on free, an impl method";
}

test "code lens on a quirk shows its own implementation count, a structural scan, not a name match" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  docs.opened(
    "file:///impl_count.fn",
    `quirk Speaks {
    `  say() str;
    `}
    `compound Dog {
    `  num age;
    `}
    `impl Dog as Speaks {
    `  say() str { ret "woof"; }
    `}
    `compound Cat {
    `  num age;
    `}
    `impl Cat as Speaks {
    `  say() str { ret "meow"; }
    `}`,
    1
  );
  let held = docs.at("file:///impl_count.fn");
  Document doc = held.unwrap();

  str out = code_lenses(&reads, &docs, doc);
  assert contains(out, `"title":"2 implementations"`), "expected Speaks' own implementation count";
  // Dog/Cat each show an ordinary reference count (declaration + own
  // impl block), not an implementation count - only a quirk gets that.
  assert contains(out, `"title":"2 references"`), "expected Dog/Cat's own ordinary reference counts";
  assert !contains(out, `"title":"0 implementations"`), "expected no zero-implementation lens on Dog or Cat";
}

test "selection range expands from a token through each enclosing bracket pair, outermost last" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///sel.fn";
  doc.path = "sel.fn";
  doc.text = `fun add(num a, num b) num {
  `  ret f(a, b);
  `}
  `fun f(num a, num b) num {
  `  ret a + b;
  `}`;
  doc.version = 1;

  // On the `a` argument inside `f(a, b)` (line 1, character 8).
  Vec<num> lines;
  lines.init(1);
  lines.push(1);
  Vec<num> chars;
  chars.init(1);
  chars.push(8);

  str out = selection_ranges(&reads, doc, &lines, &chars);
  // Token itself.
  assert contains(out, `{"line":1,"character":8}`), "expected the token's own start position";
  // The call's own parens, one level out.
  assert contains(out, `{"line":1,"character":7}`), "expected the call's own opening paren as the next range out";
  // The enclosing function body, outermost.
  assert contains(out, `{"line":0,"character":26}`), "expected the function body as the outermost range";
}

test "call hierarchy: prepare finds the function, incoming/outgoing calls group multiple call sites into one entry" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Documents docs = documents_new();
  defer docs.free();
  docs.opened(
    "file:///ch.fn",
    `fun helper(num a, num b) num {
    `  ret a + b;
    `}
    `fun add(num a, num b) num {
    `  ret helper(a, b);
    `}
    `fun use_it() num {
    `  ret add(1, 2) + add(3, 4);
    `}`,
    1
  );
  let held = docs.at("file:///ch.fn");
  Document doc = held.unwrap();

  // Prepare on `add`'s own declaration name.
  str prepared = prepare_call_hierarchy(&reads, doc, 3, 4);
  assert contains(prepared, `"name":"add"`), "expected add's own item";
  assert contains(prepared, `"kind":12`), "expected the function symbol kind";

  // Incoming: use_it calls add twice, grouped into one entry with
  // two fromRanges, not two separate entries.
  str incoming = incoming_calls(&reads, &docs, "add");
  assert contains(incoming, `"name":"use_it"`), "expected use_it as add's own caller";
  num from_count = count(incoming, `"name":"use_it"`);
  assert from_count == 1, "expected use_it grouped into a single entry despite two call sites";
  assert contains(incoming, `{"start":{"line":7,"character":6}`), "expected the first call site";
  assert contains(incoming, `{"start":{"line":7,"character":18}`), "expected the second call site";

  // Outgoing: add calls helper once.
  str outgoing_add = outgoing_calls(&reads, doc, "add");
  assert contains(outgoing_add, `"name":"helper"`), "expected add's own callee";

  // Outgoing: use_it calls add twice, grouped the same way.
  str outgoing_use_it = outgoing_calls(&reads, doc, "use_it");
  num to_count = count(outgoing_use_it, `"name":"add"`);
  assert to_count == 1, "expected add grouped into a single outgoing entry despite two call sites";
}

test "semantic tokens classify a function declaration, a type, a keyword styled as a type, and a literal" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///semtok.fn";
  doc.path = "semtok.fn";
  doc.text = `compound Widget {
  `  num n;
  `}
  `fun main() num {
  `  Widget w;
  `  bin ok = true;
  `  ret 0;
  `}`;
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  // A shallow structural check: the encoding is delta-based, not
  // position-keyed, so this decodes it enough to find one token of
  // each interesting kind rather than asserting on raw offsets.
  assert contains(out, `"data":[`), "expected the LSP data array shape";
  assert !contains(out, `"data":[]`), "expected at least one token classified";
}

test "semantic tokens mark a language primitive defaultLibrary, but any declared type (stdlib or project) plain" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///stdlibtok.fn";
  doc.path = "stdlibtok.fn";
  doc.text = `compound Widget {
  `  num n;
  `  i7 small;
  `}
  `fun make() Vec<num> {
  `  Vec<num> v;
  `  ret v;
  `}`;
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  // `num`'s own token: length 3, type 7 (type), modifier 1
  // (defaultLibrary) - a language primitive, regardless of where it
  // is used (a field's own type, a generic argument, ...).
  assert contains(out, "3,7,1,"), "expected num's own token marked defaultLibrary";
  // `i7`, a dynamic-width sized integer: same treatment as `num`,
  // even though it's lexed as a plain identifier, not a keyword.
  assert contains(out, "2,7,1,"), "expected i7's own token marked defaultLibrary";
  // `Widget`'s own token: length 6, type 7 (type), modifier 0 - a
  // declared compound, not a primitive, regardless of where it lives.
  assert contains(out, "6,7,0,"), "expected Widget's own declaration NOT marked defaultLibrary";
  // `Vec`'s own token: length 3, type 7 (type), modifier 0 - a
  // stdlib-declared compound is still just a declared type, not a
  // primitive, so it gets the same plain treatment as Widget.
  assert contains(out, "3,7,0,"), "expected Vec's own token NOT marked defaultLibrary";
}

test "semantic tokens classify a C builtin correctly against its own naming convention, not by capitalization" {
  // NULL/EOF/... are uppercase but name a value, not a type; size_t/
  // ptrdiff_t/... are lowercase but name a type, not a value - both
  // read backwards from the ordinary capitalization-based guess this
  // file otherwise uses to tell the two apart.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///cbuiltintok.fn";
  doc.path = "cbuiltintok.fn";
  doc.text = `fun main() num {
  `  size_t n;
  `  ret NULL;
  `}`;
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  // size_t: length 6, type 7 (type), modifier 1 (defaultLibrary) -
  // a C typedef, the same treatment num/i7 already get.
  assert contains(out, "6,7,1,"), "expected size_t classified as a defaultLibrary type despite being lowercase";
  // NULL: length 4, type 6 (variable), modifier 0 - a C constant, not
  // a type, despite being uppercase.
  assert contains(out, "4,6,0,"), "expected NULL classified as a variable despite being uppercase";
}

test "semantic tokens classify an enum variant's own name as enumMember, not a function call, generic payload included" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///variants.fn";
  doc.path = "variants.fn";
  doc.text = `enum Shape<T> {
  `  Circle(num),
  `  Wrap(T),
  `  Empty,
  `}
  `fun use_it(Shape s) num {
  `  fit s {
  `    .Circle(r) -> { ret r; }
  `    .Empty -> { ret 0; }
  `  }
  `}`;
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  // Each variant's own declaration-site name: type 8 (enumMember),
  // modifier 0, distinct lengths so each match is unambiguous.
  // `Wrap`'s own generic payload (`T`, not `num`) was the actual
  // regression: a `,` between two variants lexes as an Operator, not
  // a Symbol, so a check against the wrong token kind left every
  // variant after the first one permanently unmarked.
  assert contains(out, "6,8,0,"), "expected Circle's own declaration marked enumMember";
  assert contains(out, "4,8,0,"), "expected Wrap's own declaration marked enumMember";
  assert contains(out, "5,8,0,"), "expected Empty's own declaration marked enumMember";
  // A bare dot-shorthand reference in a fit resolves the same way.
  assert contains(out, "6,8,0,"), "expected .Circle's own use marked enumMember too";
}

test "semantic tokens classify a const's own name as a variable, not a type, wherever it is written" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///consttok.fn";
  doc.path = "consttok.fn";
  doc.text = `const str MAX_LEN = "x";
  `fun read_max() str {
  `  ret MAX_LEN;
  `}`;
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  // MAX_LEN's own token: length 7, type 6 (variable), modifier 0 -
  // not type 7 (type), despite being capitalized the same way a
  // declared type's own name is.
  assert contains(out, "7,6,0,"), "expected MAX_LEN classified as a variable, at both its declaration and its use";
}

test "semantic tokens' declared legend matches what the token-type indices actually mean" {
  // initialize's own capabilities and the encoder must agree on what
  // index 5 (say) means, or a client colors every token wrong.
  assert contains(TOKEN_TYPES, "\"function\""), "expected 'function' in the legend";
  assert contains(TOKEN_TYPES, "\"type\""), "expected 'type' in the legend";
  assert contains(TOKEN_TYPES, "\"keyword\""), "expected 'keyword' in the legend";
}

test "a bare '=' followed by whitespace is a one-column-wide semantic token, not two" {
  // Regression for the lexer fix this uncovered: '='s own reported
  // end_col used to bleed one column into the whitespace after it,
  // showing up here as a two-wide operator token that swallowed the
  // trailing space instead of stopping right after the '=' itself.
  // Doesn't need a full parse (only lexing), so a bare four-token
  // line pins down the whole flat array exactly: x=6(variable),
  // ==4(operator), y=6(variable), ;=4(operator), each length 1.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///eqwidth.fn";
  doc.path = "eqwidth.fn";
  doc.text = "x = y;";
  doc.version = 1;

  str out = semantic_tokens(&reads, doc);
  assert equals(out, `{"data":[0,0,1,6,0,0,2,1,4,0,0,2,1,6,0,0,1,1,4,0]}`), "expected every token exactly one column wide, deltas exact";
}

test "a keyword completes to the shape it introduces" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///snip.fn";
  doc.path = "snip.fn";
  doc.text = "fun helper() num {\n  ret 0;\n}\n";
  doc.version = 1;

  // Format 2 is the protocol's snippet format: accepting `fun` writes
  // the declaration and leaves the cursor on its name.
  str out = completion(&reads, doc, 1, 2, true);
  assert contains(out, `"label":"fun"`), "expected the keyword";
  assert contains(out, `fun ${1:name}`), "expected the skeleton to name the first stop";
  assert contains(out, `"insertTextFormat":2`), "expected the snippet format";
}

test "a short trigger writes a whole shape" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///abbrev.fn";
  doc.path = "abbrev.fn";
  doc.text = "fun helper() num {\n  ret 0;\n}\n";
  doc.version = 1;

  // The point of a trigger is what it expands to, the way `psvm` writes
  // an entry point elsewhere.
  str out = completion(&reads, doc, 1, 2, true);
  assert contains(out, `"label":"main"`), "expected the entry-point trigger";
  assert contains(out, `"label":"iferr"`), "expected the early-return trigger";
  assert contains(out, `"label":"vecnew"`), "expected the vector trigger";
  assert contains(out, `"kind":15`), "expected them offered as snippets";
  assert contains(out, `"label":"mapnew"`), "expected the map trigger";
  assert contains(out, `"label":"fito"`), "expected the option-match trigger";
}

test "a keyword's own skeleton covers fuzz and asm too, not just the more common declarations" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///skel.fn";
  doc.path = "skel.fn";
  doc.text = "fun helper() num {\n  ret 0;\n}\n";
  doc.version = 1;

  str out = completion(&reads, doc, 1, 2, true);
  assert contains(out, `"label":"fuzz"`), "expected the fuzz keyword itself to be offered";
  assert contains(out, `raw* `), "expected fuzz's own skeleton with its two fixed params";
  assert contains(out, `"label":"asm"`), "expected the asm keyword itself to be offered";
}

test "a trigger still writes its whole shape even while the document does not parse" {
  // Snippets are only offered on the fully-parsed path; the exact
  // moment a reader wants 'mainio' most (starting a new file, or
  // adding to one that is mid-edit elsewhere) is often when the
  // document does not parse at all.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///halfsnippet.fn";
  doc.path = "halfsnippet.fn";
  doc.text = "fun helper( {\n";
  doc.version = 1;

  str out = completion(&reads, doc, 1, 0, true);
  assert contains(out, `"label":"mainio"`), "expected the entry-point-that-prints trigger even while the document does not parse";
}

test "a client that does not understand a skeleton is sent none" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///plain.fn";
  doc.path = "plain.fn";
  doc.text = "fun helper() num {\n  ret 0;\n}\n";
  doc.version = 1;

  // Sent a skeleton, such a client would insert the marks as text.
  str out = completion(&reads, doc, 1, 2, false);
  assert contains(out, `"label":"fun"`), "expected the keyword itself";
  assert !contains(out, `"insertTextFormat"`), "expected no snippet";
  assert !contains(out, `"label":"iferr"`), "expected no trigger, which is only its expansion";
}

test "hover resolves a field name inside a bare '.{...}' compound-literal shorthand" {
  // `compound_literal_field_context` already resolved a typed literal
  // (`Node<num>{value = 2}`) and a named one (`Node{value = 2}`), but
  // fell through for the bare `.{...}` shorthand, whose own type comes
  // from the surrounding declaration rather than its own tokens.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///literalshorthand.fn";
  doc.path = "literalshorthand.fn";
  doc.text = `compound Node<T> {
  `  T value;
  `  Node<T>* next;
  `}
  `fun main() {
  `  Node<num> n1 = .{value = 2, next = nil};
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 5, 20);
  assert contains(hovered, "num value"), "expected the literal's own 'value' field to resolve, generic arg substituted";
}

test "hover on a generic compound shows each type param's own constraint" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///constrainedgeneric.fn";
  doc.path = "constrainedgeneric.fn";
  doc.text = `compound Node<T: dec | num> {
  `  T value;
  `  Node<T>* next;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 0, 10);
  assert contains(hovered, "Node<T: dec | num>"), "expected the constraint to render alongside the type param, not just 'T'";
}

test "hover on a 'let'-inferred top-level const shows its character-literal type" {
  // `_infer_global_const_type` had arms for .Number/.String/.Boolean but
  // not .Character, the node kind a bare 'c' literal actually parses to
  // (not .Number(.Cval(...))), so a chr-typed const's hover showed no
  // type at all.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///charconst.fn";
  doc.path = "charconst.fn";
  doc.text = "const CHAR = 'c';\nfun main() {}\n";
  doc.version = 1;

  str hovered = hover(&reads, doc, 0, 6);
  assert contains(hovered, "chr CHAR"), "expected the character-literal const to hover as chr";
}

test "completion offers 'sizeof', never a real lexer keyword but contextual at a call site" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///sizeofcompletion.fn";
  doc.path = "sizeofcompletion.fn";
  doc.text = `imp std.c.mem;
  `fun main() {
  `  raw* p = malloc(
  `}`;
  doc.version = 1;

  str out = completion(&reads, doc, 2, 18, false);
  assert contains(out, `"label":"sizeof"`), "expected sizeof to be offered even though it's never a lexer keyword";
}

test "completion on 'self.' filters to the enclosing impl's own members, even while the document does not parse" {
  // A bare 'self.' with nothing after it is itself a parse error, the
  // exact moment a reader triggers completion for it - the same
  // instant `_receiver_type_from_tokens` has no 'Type name' token to
  // read self's type from, since it's an implicit parameter.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///selfcompletion.fn";
  doc.path = "selfcompletion.fn";
  doc.text = `compound Node {
  `  num value;
  `}
  `impl Node {
  `  show() {
  `    self.
  `  }
  `}`;
  doc.version = 1;

  str out = completion(&reads, doc, 5, 9, false);
  assert contains(out, `"label":"value"`), "expected the enclosing impl's own field to be offered";
  assert !contains(out, `"label":"quirk"`), "expected filtering to the impl's own members, not every reserved word in scope";
}

test "completion never triggers on a '.' typed inside a comment" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///dotcomment.fn";
  doc.path = "dotcomment.fn";
  doc.text = `fun main() {
  `  // self.
  `}`;
  doc.version = 1;

  str out = completion(&reads, doc, 1, 10, false);
  assert equals(out, "[]"), "expected no completion at all for a '.' inside a comment";
}

test "hover on a 'let'-inferred function value shows the value's own type, not the referenced function's declaration" {
  // `_full_declared_type` assumed every declaration's rendered detail
  // ends with the declaration's own name (true for a variable/field/
  // param's "Type name" shape), but a function's own detail ends
  // with its return type instead, its name sitting in the middle
  // ("fun add(num a, num b) num") - stripping the wrong trailing
  // characters produced "fun add(num a, num b) g" for `let g = add;`.
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///letfnvalue.fn";
  doc.path = "letfnvalue.fn";
  doc.text = `fun add(num a, num b) num { ret a + b; }
  `fun main() {
  `  let g = add;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 2, 6);
  assert contains(hovered, "fun(num, num) num g"), "expected the local's own function-value type, not add's own declaration text";
}

test "hover on '?' and postfix '!' shows propagation doc text, prefix '!' does not" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();

  Document opt_doc;
  opt_doc.uri = "file:///propq.fn";
  opt_doc.path = "propq.fn";
  opt_doc.text = `imp std.option;
  `fun get() Option<num> { ret .None; }
  `fun main() Option<num> {
  `  num v = get()?;
  `  ret .Some(v);
  `}
  `fun notprop() {
  `  bin b = !true;
  `}`;
  opt_doc.version = 1;

  str hov_q = hover(&reads, opt_doc, 3, 15);
  assert contains(hov_q, "Option propagation"), "expected postfix '?' to show propagation doc";

  str hov_prefix_bang = hover(&reads, opt_doc, 7, 12);
  assert equals(hov_prefix_bang, "null"), "expected prefix '!' (logical NOT) to get no hover, not propagation doc";

  Document res_doc;
  res_doc.uri = "file:///propbang.fn";
  res_doc.path = "propbang.fn";
  res_doc.text = `imp std.result;
  `fun get() Result<num, str> { ret .Err("x"); }
  `fun main() Result<num, str> {
  `  num v = get()!;
  `  ret .Ok(v);
  `}`;
  res_doc.version = 1;

  str hov_bang = hover(&reads, res_doc, 3, 15);
  assert contains(hov_bang, "Result propagation"), "expected postfix '!' to show propagation doc";
}

test "hover on a let-bound '?' propagation shows the unwrapped type, and completion on it is filtered" {
  AnalysisCache reads = analysis_cache_new();
  defer reads.free();
  Document doc;
  doc.uri = "file:///propunwrap.fn";
  doc.path = "propunwrap.fn";
  doc.text = `imp std.option;
  `compound Point { num x; num y; }
  `fun get() Option<Point> { ret .None; }
  `fun main() Option<Point> {
  `  let p = get()?;
  `  num vx = p.x;
  `  ret .None;
  `}`;
  doc.version = 1;

  str hovered = hover(&reads, doc, 4, 6);
  assert contains(hovered, "Point p"), "expected p's own type to be Point, not Option<Point>";

  str comp = completion(&reads, doc, 5, 13, false);
  assert contains(comp, `"label":"x"`), "expected Point's own field 'x' to be offered";
  assert contains(comp, `"label":"y"`), "expected Point's own field 'y' to be offered";
  assert !contains(comp, `"label":"get"`), "expected filtering to Point's own members, not every name in scope";
}
