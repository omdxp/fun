test "self-referential recursive generic enum (List<T>) via generic helper functions" {
  str src = `use std.c.io;
  `use std.c.mem;
  `enum List<T> { Cons(T, List<T>*), Nil }
  `fun list_nil<T>(T type_hint) List<T>* {
  `  List<T>* n = malloc(sizeof(List<T>));
  `  *n = List.Nil;
  `  ret n;
  `}
  `fun list_push<T>(T v, List<T>* tail) List<T>* {
  `  List<T>* n = malloc(sizeof(List<T>));
  `  *n = List.Cons(v, tail);
  `  ret n;
  `}
  `fun list_head<T>(List<T>* l, T fallback) T {
  `  fit *l {
  `    List.Cons(v, tail) -> { ret v; }
  `    List.Nil -> { ret fallback; }
  `  }
  `}
  `fun main() num {
  `  List<dec>* nil_list = list_nil(0.0);
  `  List<dec>* l = list_push(2.0, list_push(1.0, nil_list));
  `  printf("head = %.1f\n", list_head(l, 0.0));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "self-referential recursive generic enum (List<T>) via generic helper functions"
  );
  assert contains(out, "List__dec* _1;"), "expected the self-referential payload at the monomorphized type";
}

test "a plain (non-generic) function can fit-match and destructure a concrete generic-enum instantiation through a pointer" {
  str src = `use std.c.io;
  `use std.c.mem;
  `enum List<T> { Cons(T, List<T>*), Nil }
  `fun list_nil<T>(T type_hint) List<T>* {
  `  List<T>* n = malloc(sizeof(List<T>));
  `  *n = List.Nil;
  `  ret n;
  `}
  `fun list_push<T>(T v, List<T>* tail) List<T>* {
  `  List<T>* n = malloc(sizeof(List<T>));
  `  *n = List.Cons(v, tail);
  `  ret n;
  `}
  `fun list_sum(List<dec>* l) dec {
  `  fit *l {
  `    List.Cons(v, tail) -> { ret v + list_sum(tail); }
  `    List.Nil -> { ret 0.0; }
  `  }
  `}
  `fun main() num {
  `  List<dec>* nil_list = list_nil(0.0);
  `  List<dec>* l = list_push(3.0, list_push(2.0, list_push(1.0, nil_list)));
  `  printf("sum = %.1f\n", list_sum(l));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a plain (non-generic) function can fit-match a concrete generic-enum instantiation"
  );
  assert contains(out, "List__dec* _1;"), "expected the self-referential payload at the monomorphized type";
}

// Resolved: constructing and destructuring a self-referential recursive
// generic enum works from both generic and plain non-generic code (the
// two tests above). Ran the compiled programs, not just the emitted C:
// "1 + 2 + 3" over a hand-built List<num> printed 6.

test "a generic function can call itself recursively (self-recursive generic function call)" {
  str src = `use std.c.io;
  `fun countdown<T>(T label, num n) num {
  `  if n <= 0 { ret 0; }
  `  ret 1 + countdown(label, n - 1);
  `}
  `fun main() num {
  `  printf("%lld\n", countdown("x", 5));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a generic function can call itself recursively (self-recursive generic function call)"
  );
  assert contains(out, "countdown__str(char* label, int64_t n)"), "expected one monomorphization inferred from the argument";
  assert contains(out, "countdown__str(label, (n - 1))"), "expected the recursive call to reuse it";
}

test "a generic array-typed value (T[]) compares against nil like any other pointer" {
  str src = `use std.c.io;
  `use std.c.mem;
  `compound Box<T> {
  `  T[] data;
  `}
  `impl Box<T> {
  `  pub alloc(num n) num {
  `    self.data = malloc(sizeof(T) * n);
  `    if self.data == nil {
  `      ret 1;
  `    }
  `    ret 0;
  `  }
  `}
  `fun main() num {
  `  num[] a = malloc(sizeof(num) * 4);
  `  printf("%d %d\n", a == nil, nil == a);
  `  free(a);
  `  Box<num> b;
  `  printf("%lld\n", b.alloc(4));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a generic array-typed value (T[]) compares against nil like any other pointer"
  );
  assert contains(out, "self->data == NULL"), "expected the generic array field to compare against NULL";
  assert contains(out, "NULL == a"), "expected nil on the left to compare too";
}

test "a wait group lets every forked task finish" {
  str src = `use std.c.io;
  `use std.task;
  `async fun worker(WaitGroup* wg, num i) {
  `  printf("task %lld\n", i);
  `  wg.done();
  `}
  `fun main() num {
  `  WaitGroup wg = wait_group_new(3);
  `  num i = 0;
  `  for i < 3 {
  `    fork worker(&wg, i);
  `    i = i + 1;
  `  }
  `  wg.wait();
  `  printf("all done\n");
  `  ret 0;
  `}`;
  // The point is that this returns at all: a wait group that miscounts
  // hangs here rather than failing an assertion.
  str out = run_source(src, "wait_group_probe", "a wait group lets every forked task finish");
  assert contains(out, "all done"), "expected the wait to be satisfied";
  assert contains(out, "task 0"), "expected every task to run";
  assert contains(out, "task 2"), "expected every task to run";
}

test "a generic function calling a DIFFERENT generic function from its own body gets that callee emitted (indirect instantiation)" {
  str src = `use std.c.io;
  `fun identity<T>(T x) T {
  `  ret x;
  `}
  `fun double_it<T>(T x) T {
  `  ret identity(x) + identity(x);
  `}
  `fun level3<T>(T x) T {
  `  ret x;
  `}
  `fun level2<T>(T x) T {
  `  ret level3(x) + level3(x);
  `}
  `fun level1<T>(T x) T {
  `  ret level2(x) + level2(x);
  `}
  `fun main() num {
  `  printf("%lld %lld\n", double_it(21), level1(5));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a generic function calling a DIFFERENT generic function from its own body gets that callee emitted (indirect instantiation)"
  );
  assert contains(out, "identity__num(int64_t x)"), "expected the indirectly reached callee to be emitted";
  assert contains(out, "level3__num(int64_t x)"), "expected discovery to reach three levels deep";
}

test "indirect generic instantiation discovery does not cross-substitute unrelated generic functions sharing a type param name" {
  str src = `use std.c.io;
  `compound Box<T> {
  `  T value;
  `}
  `fun make_box<T>(T v) Box<T> {
  `  Box<T> b;
  `  b.value = v;
  `  ret b;
  `}
  `fun dead_caller<T>(T v) Box<T> {
  `  ret make_box(v);
  `}
  `fun live_caller<T>(T v) T {
  `  ret v;
  `}
  `fun main() num {
  `  printf("%lld\n", live_caller(7));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "indirect generic instantiation discovery does not cross-substitute unrelated generic functions sharing a type param name"
  );
  assert contains(out, "live_caller__num"), "expected the called generic function to be emitted";
  assert !contains(out, "make_box__num"), "expected the never-called generic function to stay uninstantiated";
}

test "a self-recursive CONSTRAINED generic function calling itself with the abstract T passes its own bound" {
  str src = `use std.c.io;
  `fun sum_down<T: num | dec>(T n) T {
  `  if n <= 0 {
  `    ret n;
  `  }
  `  ret n + sum_down(n - 1);
  `}
  `fun main() num {
  `  printf("%lld\n", sum_down(5));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a self-recursive CONSTRAINED generic function calling itself with the abstract T passes its own bound"
  );
  assert contains(out, "sum_down__num(int64_t n)"), "expected the bound to admit the num instantiation";
  assert contains(out, "sum_down__num((n - 1))"), "expected the recursive call to reuse it";
}

// A bare function type used AS a generic argument (`Option<Handler>`) is a
// different shape from a generic function-type alias used as a parameter
// type (the test just below): `resolve_type_name` used to fall through to
// `type_str`, which for a function type is only ever the parser's
// `"fun(...)"` placeholder text, colliding every distinct function type
// into the same invalid mangled name.
test "a bare function type used as a generic argument gets a real mangled typedef, not a placeholder" {
  str src = `use std.c.io;
  `enum Option<T> { Some(T), None }
  `als Handler = fun(num) num;
  `fun dbl(num x) num { ret x * 2; }
  `fun mk() Option<Handler> { ret .Some(dbl); }
  `fun main() num {
  `  fit mk() {
  `    .Some(f) -> { printf("%lld\n", f(4)); }
  `    .None -> {}
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a bare function type used as a generic argument gets a real mangled typedef, not a placeholder"
  );
  assert !contains(out, "fun(..."), "expected no leftover 'fun(...)' placeholder in the mangled name";
  assert contains(
    out,
    "typedef int64_t (*__Fn__num__num)(int64_t);"
  ), "expected a real function-pointer typedef";
  assert contains(
    out,
    "Option____Fn__num__num"
  ), "expected the outer Option instantiation to mangle against the real typedef name";
}

test "a generic function-type alias emits the real callback signature, not the alias name" {
  str src = `use std.c.io;
  `als Callback<A, R> = fun(A) R;
  `fun square(num x) num { ret x * x; }
  `fun apply(Callback<num, num> cb, num x) num { ret cb(x); }
  `fun main() num {
  `  printf("%lld\n", apply(square, 4));
  `  ret 0;
  `}`;
  let out = emit_c(src, "a generic function-type alias emits the real callback signature, not the alias name");
  assert !contains(out, "Callback"), "expected the alias name to never reach emitted C";
}

test "a type alias naming a quirk still dispatches dynamically through the alias" {
  str src = `use std.c.io;
  `quirk Shape {
  `  area() num;
  `}
  `compound Square {
  `  num side;
  `}
  `impl Square as Shape {
  `  area() num { ret self.side * self.side; }
  `}
  `als Drawable = Shape;
  `fun describe(Drawable d) num { ret d.area(); }
  `fun main() num {
  `  Square s;
  `  s.side = 4;
  `  Drawable d = &s;
  `  printf("%lld\n", describe(d));
  `  ret 0;
  `}`;
  let out = emit_c(src, "a type alias naming a quirk still dispatches dynamically through the alias");
  assert !contains(out, "Drawable"), "expected the alias name to never reach emitted C";
  assert contains(out, "Shape"), "expected the real quirk type to reach emitted C";
}

test "a bound-list type alias's own expansion agrees with a hand-written bound list" {
  str src = `use std.c.io;
  `als Numeric = num | dec;
  `fun identity<T: Numeric>(T n) T { ret n; }
  `fun main() num {
  `  printf("%lld\n", identity(5));
  `  ret 0;
  `}`;
  assert_emits(
    src,
    "identity__num",
    "a bound-list type alias's own expansion agrees with a hand-written bound list"
  );
}

test "a bound-list type alias on a generic impl's own constraint monomorphizes for an allowed instantiation" {
  str src = `use std.c.io;
  `als Numeric = num | dec;
  `compound Wrapper<T> { T value; }
  `impl Wrapper<T: Numeric> {
  `  describe() str { ret "numeric"; }
  `}
  `fun main() num {
  `  Wrapper<num> w = Wrapper<num>{value = 5};
  `  printf("%s\n", w.describe());
  `  ret 0;
  `}`;
  assert_emits(
    src,
    "Wrapper__num__describe",
    "a bound-list type alias on a generic impl's own constraint monomorphizes for an allowed instantiation"
  );
}

test "a bound-list type alias on a generic impl's own constraint does not monomorphize for a disallowed instantiation" {
  str src = `use std.c.io;
  `als Numeric = num | dec;
  `compound Wrapper<T> { T value; }
  `impl Wrapper<T: Numeric> {
  `  describe() str { ret "numeric"; }
  `}
  `fun main() num {
  `  Wrapper<str> w = Wrapper<str>{value = "nope"};
  `  printf("%s\n", w.describe());
  `  ret 0;
  `}`;
  assert_not_emits(
    src,
    "Wrapper__str__describe(Wrapper__str* self) {",
    "expected a disallowed instantiation's method body to stay unemitted"
  );
}

test "a quirk-bounded generic impl monomorphizes for a real implementor" {
  str src = `use std.c.io;
  `quirk Renderable { render() str; }
  `compound Point { num x; }
  `impl Point as Renderable {
  `  render() str { ret "point"; }
  `}
  `compound Wrapper<T> { T value; }
  `impl Wrapper<T: Renderable> {
  `  describe() str { ret "wrapped"; }
  `}
  `fun main() num {
  `  Wrapper<Point> w = Wrapper<Point>{value = Point{x = 1}};
  `  printf("%s\n", w.describe());
  `  ret 0;
  `}`;
  assert_emits(src, "Wrapper__Point__describe", "expected the quirk-implementor instantiation to monomorphize");
}

test "a quirk-bounded generic impl does not monomorphize for a non-implementor" {
  str src = `use std.c.io;
  `quirk Renderable { render() str; }
  `compound Other { num v; }
  `compound Wrapper<T> { T value; }
  `impl Wrapper<T: Renderable> {
  `  describe() str { ret "wrapped"; }
  `}
  `fun main() num {
  `  Wrapper<Other> w = Wrapper<Other>{value = Other{v = 1}};
  `  printf("%s\n", w.describe());
  `  ret 0;
  `}`;
  // The call site itself is always emitted (`Wrapper__Other__describe(&w)`
  // as a bare reference); a rejected instantiation only ever leaves the
  // DEFINITION unemitted, matching the pre-existing behavior for a
  // bare-name bound violation on a generic impl (this codebase's own
  // baseline: an impl-level bound was never enforced with a clean Fun
  // diagnostic, only by leaving the method undefined in C).
  assert_not_emits(
    src,
    "Wrapper__Other__describe(Wrapper__Other* self) {",
    "expected a non-implementor instantiation's method body to stay unemitted"
  );
}

test "a generic-instantiation-bounded impl monomorphizes for a matching instantiation" {
  str src = `use std.c.io;
  `compound Box<T> { T value; }
  `compound Wrapper<T> { T value; }
  `impl Wrapper<T: num | Box<num>> {
  `  describe() str { ret "wrapped"; }
  `}
  `fun main() num {
  `  Wrapper<Box<num>> w = Wrapper<Box<num>>{value = Box<num>{value = 5}};
  `  printf("%s\n", w.describe());
  `  ret 0;
  `}`;
  assert_emits(
    src,
    "Wrapper__Box__num__describe",
    "expected the matching generic-instantiation bound to monomorphize"
  );
}

test "a generic-instantiation-bounded impl does not monomorphize for a mismatching instantiation" {
  str src = `use std.c.io;
  `compound Box<T> { T value; }
  `compound Wrapper<T> { T value; }
  `impl Wrapper<T: num | Box<num>> {
  `  describe() str { ret "wrapped"; }
  `}
  `fun main() num {
  `  Wrapper<str> w = Wrapper<str>{value = "hi"};
  `  printf("%s\n", w.describe());
  `  ret 0;
  `}`;
  // See the matching comment above: only the DEFINITION is checked, the
  // call site's own bare reference is always emitted regardless.
  assert_not_emits(
    src,
    "Wrapper__str__describe(Wrapper__str* self) {",
    "expected a mismatching instantiation's method body to stay unemitted"
  );
}

test "a self-referential generic-quirk bound (T: Quirk<T>) monomorphizes for a real implementor" {
  // `dtype_matches_constraint_name`'s own quirk-membership check only
  // keys on a quirk's bare name; a bound naming a generic quirk's own
  // instantiation (self-referential here - the bound is literally
  // "Steppable<T>" at declaration time, before any instantiation
  // supplies a real type for T) needs that `<...>` suffix stripped
  // first, or a real implementor is never recognized.
  str src = `use std.c.io;
  `quirk Steppable<T> { succ() T; }
  `compound Counter { num v; }
  `impl Counter as Steppable<Counter> {
  `  pub succ() Counter {
  `    Counter c;
  `    c.v = self.v + 1;
  `    ret c;
  `  }
  `}
  `compound Box<T: Steppable<T>> { T value; }
  `impl Box<T: Steppable<T>> {
  `  pub advance() T { ret self.value.succ(); }
  `}
  `fun main() num {
  `  Counter a;
  `  a.v = 1;
  `  Box<Counter> bx = Box<Counter>{value = a};
  `  let n = bx.advance();
  `  printf("%lld\n", n.v);
  `  ret 0;
  `}`;
  let out = run_source(src, "self_ref_quirk_bound", "a self-referential quirk bound monomorphizes for a real implementor");
  assert equals(out, "2\n"), "expected Box<Counter>.advance() to call Counter's own Steppable succ() and return the incremented value";
}

test "a generic user type implementing Iterator<T> directly on itself works in a for loop, not just Vec/Map/Set" {
  // `emit_for_iter`'s own direct-dispatch fast path used to hardcode
  // ["Vec", "Map", "Set"] - a generic user type implementing
  // Iterator<T> directly (not through a plain, non-generic impl) fell
  // through to a fallback path written only for the non-generic case,
  // leaving Elem unsubstituted. Now discovered generically from
  // registered generic Iterator impls, so a user's own generic type
  // gets identical treatment.
  str src = `use std.c.io;
  `use std.quirks;
  `use std.option;
  `compound Counter { num v; }
  `impl Counter as Steppable<Counter> {
  `  pub succ() Counter {
  `    Counter c;
  `    c.v = self.v + 1;
  `    ret c;
  `  }
  `  pub reached(Counter end) flag { ret self.v >= end.v; }
  `}
  `compound CountRange<T: Steppable<T>> { T start; T end; }
  `impl CountRange<T: Steppable<T>> as Iterator<T> {
  `  pub next() Option<T> {
  `    if self.start.reached(self.end) { ret .None; }
  `    T v = self.start;
  `    self.start = self.start.succ();
  `    ret .Some(v);
  `  }
  `}
  `fun main() num {
  `  Counter a;
  `  a.v = 1;
  `  Counter b;
  `  b.v = 4;
  `  num total = 0;
  `  for c : CountRange<Counter>{start = a, end = b} {
  `    total = total + c.v;
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(src, "generic_user_type_iterator", "a generic user type's own Iterator<T> impl works in a for loop");
  assert equals(out, "6\n"), "expected 1+2+3 over [1, 4) through the user's own generic Iterator<T> impl";
}

test "a next() body calling a further quirk method through self.<field> falls back to the call-based dispatch, not inlining" {
  // `_next_body_inlinable` only checked statement-level control-flow
  // shape before this fix - a next() body calling a quirk method
  // through self.<field> (self.start.succ(), needing the nested
  // generic instantiation resolved inside the inlined splice, which
  // this pass doesn't do correctly yet) was wrongly accepted for
  // inlining. Confirmed by the ABSENCE of the inlining pass's own
  // telltale marker (__fun_iter_local, the renamed-local prefix
  // emit_inlined_iterator_next always writes), contrasting with
  // Range's own next() (plain arithmetic, no nested quirk calls),
  // which IS still inlined - see "range for loop desugars into a Range
  // value" nearby.
  str src = `use std.c.io;
  `use std.quirks;
  `use std.option;
  `compound Counter { num v; }
  `impl Counter as Steppable<Counter> {
  `  pub succ() Counter {
  `    Counter c;
  `    c.v = self.v + 1;
  `    ret c;
  `  }
  `  pub reached(Counter end) flag { ret self.v >= end.v; }
  `}
  `compound CountRange<T: Steppable<T>> { T start; T end; }
  `impl CountRange<T: Steppable<T>> as Iterator<T> {
  `  pub next() Option<T> {
  `    if self.start.reached(self.end) { ret .None; }
  `    T v = self.start;
  `    self.start = self.start.succ();
  `    ret .Some(v);
  `  }
  `}
  `fun main() num {
  `  Counter a;
  `  a.v = 1;
  `  Counter b;
  `  b.v = 3;
  `  for c : CountRange<Counter>{start = a, end = b} {
  `    printf("%lld\n", c.v);
  `  }
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(
    src,
    "nested_self_call_fallback",
    "next() body with a nested self-rooted quirk call falls back to call-based dispatch"
  );
  assert !contains(out, "__fun_iter_local"), "expected the call-based fallback, not the inlining pass, given the nested quirk call this pass can't yet resolve inline";
}

// A call violating a generic bound is rejected by the typechecker,
// where the check and its tests live (typecheck_tests.fn).
