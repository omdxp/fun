test "a generic function's own trailing default is filled at its call site" {
  // A generic function is recorded whole and monomorphized from its call
  // site rather than through the plain-function registry, so its
  // defaults were never looked up at all: `pick__num(1)` called a
  // function declared with two parameters.
  str src = `imp std.c.io;
  `fun pick<T>(T v, num n = 3) num { ret n; }
  `fun main() num {
  `  printf("%lld\n", pick(1));
  `  ret 0;
  `}`;
  let out = emit_c(src, "a generic function's own trailing default is filled at its call site");
  assert contains(out, "pick__num(1, 3)"), "expected the default filled in at the instantiated call";
}

test "a method's own default does not collide with its receiver" {
  // The receiver is written before any default, so the separator that
  // starts a bare call's argument list is wrong here: it produced
  // `C__add(&c5)`, concatenating the receiver and the default.
  str src = `imp std.c.io;
  `compound C { num v; }
  `impl C {
  `  pub add(num a = 5) num { ret self.v + a; }
  `}
  `fun main() num {
  `  C c;
  `  c.v = 1;
  `  printf("%lld\n", c.add());
  `  ret 0;
  `}`;
  let out = emit_c(src, "a method's own default does not collide with its receiver");
  assert contains(out, "C__add(&c, 5)"), "expected the receiver and the default as separate arguments";
}

