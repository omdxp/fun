test "quirk-impl method call chains onto a call-expression receiver" {
  str src = `imp std.c.io;
  `quirk Sized { len() num; is_empty() bin; }
  `compound Bag<T> { num len; }
  `impl Bag<T> as Sized { pub len() num { ret self.len; } pub is_empty() bin { ret self.len == 0; } }
  `fun make_bag() Bag<num> {
  `  Bag<num> v;
  `  v.len = 2;
  `  ret v;
  `}
  `fun main() num {
  `  printf("%lld %d\n", make_bag().len(), make_bag().is_empty());
  `  ret 0;
  `}`;
  let out = emit_c(src, "quirk-impl method call chains onto a call-expression receiver");
  assert contains(out, "Bag__num__Sized__len"), "expected the quirk method, not the same-named field";
  assert contains(out, "__fun_recv_tmp"), "expected the call receiver hoisted into a temporary";
}

test "a rotating sink writes what was logged to its file" {
  str src = `imp std.io;
  `imp std.fs;
  `imp std.c.io;
  `fun main() num {
  `  RotatingSink r = rotating_sink_new("fun-out/rotate_probe.log", 4096, 2);
  `  Sink s = Sink.Rotating(&r);
  `  write_to(s, "first line\n");
  `  _ = s.flush();
  `  r.close();
  `  str back = read_to_string("fun-out/rotate_probe.log");
  `  printf("[%s]", back);
  `  remove_file("fun-out/rotate_probe.log");
  `  ret 0;
  `}`;
  make_dir_all("fun-out");
  str out = run_source(
    src,
    "rotating_sink_probe",
    "a rotating sink writes what was logged to its file"
  );
  assert contains(out, "first line"), "expected the line to reach the file";
}

test "for item : iterable drives a user Iterator via next()/Option; break exits the loop" {
  str src = `imp std.c.io;
  `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Counter { num cur; num limit; }
  `impl Counter as Iterator<num> {
  `  pub next() Option<num> {
  `    if self.cur >= self.limit { ret Option.None; }
  `    num v = self.cur;
  `    self.cur = self.cur + 1;
  `    ret Option.Some(v);
  `  }
  `}
  `fun main() num {
  `  Counter c = Counter{cur = 0, limit = 5};
  `  num sum = 0;
  `  for x : c {
  `    if x == 3 { break; }
  `    sum = sum + x;
  `  }
  `  printf("%lld\n", sum);
  `  ret 0;
  `}`;
  let out = emit_c(src, "for item : iterable drives a user Iterator");
  assert contains(out, "Counter__Iterator__next"), "expected the loop to call next()";
}

test "for k, v :: map binds each key to its value" {
  str src = `imp std.c.io;
  `imp std.map;
  `fun main() num {
  `  Map<str, num> m;
  `  m.init(8);
  `  m.put("a", 1);
  `  for k, v :: m {
  `    printf("%s=%lld\n", k, v);
  `  }
  `  m.free();
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(
    src,
    "for_map_pairs",
    "for k, v :: map binds each key to its value"
  );
  assert contains(out, "Map__str__num"), "expected the map instantiation";
  assert contains(out, "printf"), "expected the body to be emitted";
}

test "default parameter values: free fn + method, omitting trailing args fills defaults" {
  str src = `imp std.c.io;
  `fun base() num { ret 100; }
  `fun three(num a, num b = 2, num c = base()) num { ret a * 1000 + b * 10 + c; }
  `compound Box { num v; }
  `impl Box {
  `  pub add(num x, num y = 50) num { ret self.v + x + y; }
  `}
  `fun main() num {
  `  printf("%lld %lld %lld\n", three(1), three(1, 5), three(1, 5, 9));
  `  Box b;
  `  b.v = 1000;
  `  printf("%lld %lld\n", b.add(1), b.add(1, 1));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "default parameter values: free fn + method, omitting trailing args fills defaults"
  );
  assert contains(out, "three(1, 2, base())"), "expected a defaulted call expression to be materialized";
  assert contains(out, "Box__add(&b, 1, 50)"), "expected the method default to be filled";
}

test "the watchdog stops a program waiting on a channel nothing sends to" {
  str src = `imp std.c.io;
  `imp std.channel;
  `fun main() num {
  `  Channel<num> ch = channel_new(1);
  `  num v = 0;
  `  ch.recv_into(&v);
  `  printf("never reached\n");
  `  ret 0;
  `}`;
  // The wait never ends on its own, so the watchdog is what ends it. On
  // its own the watchdog only warns, over and over, and the program keeps
  // waiting; asking it to abort is what makes this a test that finishes
  // rather than one that hangs the suite. Both are read by the child from
  // what this process holds, and the interval is short on purpose.
  assert set_env("FUN_DEADLOCK_WATCHDOG_MS", "300"), "expected to set the watchdog";
  assert set_env("FUN_DEADLOCK_ABORT", "1"), "expected to ask it to abort rather than warn";
  ProcessResult r = run_source_result(
    src,
    "watchdog_probe",
    "the watchdog stops a program waiting on a channel nothing sends to"
  );
  assert clear_env("FUN_DEADLOCK_WATCHDOG_MS"), "expected to clear the watchdog";
  assert clear_env("FUN_DEADLOCK_ABORT"), "expected to clear the abort setting";

  assert contains(r.stderr_text, "possible deadlock"), "expected the watchdog to say what it noticed";
  assert !contains(r.stdout_text, "never reached"), "expected the program stopped before finishing";
  assert r.exit_code != 0, "expected the program to end on the watchdog rather than normally";
}

test "a value renders through Display when written as {}" {
  str src = `imp std.io;
  `imp std.quirks;
  `compound Point {
  `  num x;
  `}
  `impl Point as Display {
  `  pub to_string() str { ret "point"; }
  `}
  `fun main() num {
  `  Point p;
  `  p.x = 1;
  `  println_fmt("{}", &p);
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(
    src,
    "display_through_braces",
    "a value renders through Display when written as {}"
  );
  assert contains(out, "Point__Display__to_string"), "expected the implementation to be emitted";
  assert contains(out, "println_fmt"), "expected the call to survive";
}

test "every branch of an exhaustive fit can render through Display" {
  str src = `imp std.io;
  `imp std.quirks;
  `enum Shape {
  `  Dot,
  `  Line,
  `}
  `impl Shape as Display {
  `  pub to_string() str {
  `    fit *self {
  `      .Dot -> { ret "dot"; }
  `      .Line -> { ret "line"; }
  `    }
  `    ret "";
  `  }
  `}
  `fun main() num {
  `  Shape s = .Dot;
  `  println_fmt("{}", &s);
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(
    src,
    "display_exhaustive_fit",
    "every branch of an exhaustive fit can render through Display"
  );
  assert contains(out, "Shape__Display__to_string"), "expected the implementation";
  assert contains(out, "Shape_Dot"), "expected both variants emitted";
  assert contains(out, "Shape_Line"), "expected both variants emitted";
}

test "a private name in one file does not collide with the same name in another" {
  // Sibling files on disk, which is the only way a cross-file collision
  // can happen at all.
  assert write_string(
    "src/tests/fixtures/priv_sibling_a.fn",
    `fun _helper() num { ret 1; }
    `pub fun from_a() num { ret _helper(); }`
  ), "expected to stage the first file";
  defer remove_file("src/tests/fixtures/priv_sibling_a.fn");
  assert write_string(
    "src/tests/fixtures/priv_sibling_b.fn",
    `fun _helper() num { ret 2; }
    `pub fun from_b() num { ret _helper(); }`
  ), "expected to stage the second file";
  defer remove_file("src/tests/fixtures/priv_sibling_b.fn");

  str src = `imp priv_sibling_a;
  `imp priv_sibling_b;
  `imp std.c.io;
  `fun main() num {
  `  printf("%lld\n", from_a() + from_b());
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(
    src,
    "priv_sibling_main",
    "a private name in one file does not collide with the same name in another"
  );
  assert contains(out, "from_a"), "expected the first file's function";
  assert contains(out, "from_b"), "expected the second file's function";
}

test "fit statement with an explicit catch-all branch compiles and evaluates correctly" {
  str src = `imp std.c.io;
  `enum Token { Num(num), Ident, Plus, Minus, Star, Slash, LParen, RParen, Eof }
  `fun classify(Token t) num {
  `  fit t {
  `    Token.Num(n) -> { ret n; }
  `    Token.Ident -> { ret 1; }
  `    _ -> { ret 0; }
  `  }
  `}
  `fun main() num {
  `  printf("%lld %lld %lld\n", classify(Token.Num(5)), classify(Token.Ident), classify(Token.Eof));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "fit statement with an explicit catch-all branch compiles and evaluates correctly"
  );
  assert contains(out, "t.tag == Token_Num"), "expected the payload branch to test its tag";
  assert contains(out, "t.tag == Token_Ident"), "expected the payload-free branch to test its tag";
  assert contains(out, "} else {"), "expected the catch-all to lower to a trailing else";
}

test "a program spread over several files merges into one" {
  assert write_string(
    "src/tests/fixtures/spread_types.fn",
