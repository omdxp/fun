  str src = `imp spread_types;
  `imp spread_ops;
  `imp std.c.io;
  `fun main() num {
  `  Point p;
  `  p.x = 3;
  `  p.y = 4;
  `  printf("%lld\n", area(p));
  `  ret 0;
  `}`;
