// `fun main() num {
// `  printf("%s\n", sum_down("hi"));
// `  ret 0;
// `}`;
// let r = transpile_source(src);
// assert r.is_err(), "expected the constraint violation to be rejected";
// }

test "a generic impl method calling a DIFFERENT generic free function from its own body gets that callee emitted" {
  str src = `use std.c.io;
  `fun identity<T>(T x) T {
  `  ret x;
  `}
  `compound Box<T> {
  `  T value;
  `}
  `impl Box<T> {
  `  pub get() T {
  `    ret identity(self.value);
  `  }
  `}
  `fun main() num {
  `  Box<num> b;
  `  b.value = 99;
  `  printf("%lld\n", b.get());
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a generic impl method calling a DIFFERENT generic free function from its own body gets that callee emitted"
  );
  assert contains(out, "identity__num(int64_t x)"), "expected the free function reached from the method body";
  assert contains(out, "Box__num__get"), "expected the monomorphized method";
}

test "an impl method can declare its OWN generic type parameter beyond the impl's" {
  str src = `use std.c.io;
  `fun identity<T>(T x) T {
  `  ret x;
  `}
  `compound Box<T> {
  `  T value;
  `}
  `impl Box<T> {
  `  pub map<U>(U other) U {
  `    ret identity(other);
  `  }
  `  pub sum_with<U: num | dec>(U other) U {
  `    ret other + other;
  `  }
  `}
  `fun main() num {
  `  Box<num> b;
  `  b.value = 1;
  `  printf("%lld %s %lld\n", b.map(77), b.map("hello"), b.sum_with(21));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "an impl method can declare its OWN generic type parameter beyond the impl's"
  );
  assert contains(out, "identity__str(char* x)"), "expected the callee substituted with the method's type argument";
}

test "an impl method's own generic type param also works on a non-generic impl/compound" {
  str src = `use std.c.io;
  `fun identity<T>(T x) T {
  `  ret x;
  `}
  `compound Registry {
  `  num count;
  `}
  `impl Registry {
  `  pub echo<U>(U x) U {
  `    ret identity(x);
  `  }
  `}
  `fun main() num {
  `  Registry r;
  `  r.count = 0;
  `  printf("%lld\n", r.echo(123));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "an impl method's own generic type param also works on a non-generic impl/compound"
  );
  assert contains(out, "Registry__echo__num"), "expected the method monomorphized on its own type param";
  assert contains(out, "identity__num"), "expected the free function reached through it";
}

test "a method with its own type param calling a SIBLING method that also has its own type param" {
  str src = `use std.c.io;
  `compound Box<T> {
  `  T value;
  `}
  `impl Box<T> {
  `  pub inner<U>(U x) U {
  `    ret x;
  `  }
  `  pub outer<V>(V x) V {
  `    ret self.inner(x);
  `  }
  `}
  `fun main() num {
  `  Box<num> b;
  `  b.value = 0;
  `  printf("%lld\n", b.outer(9));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a method with its own type param calling a SIBLING method that also has its own type param"
  );
  assert contains(out, "Box__num__outer__num"), "expected the outer method monomorphized";
  assert contains(out, "Box__num__inner__num"), "expected the sibling reached from its body";
}

test "method chaining on a generic method's own-type-param call result monomorphizes correctly" {
  str src = `use std.c.io;
  `compound Box<T> {
  `  T value;
  `}
  `impl Box<T> {
  `  pub wrap<U>(U x) Box<U> {
  `    Box<U> b;
  `    b.value = x;
  `    ret b;
  `  }
  `  pub get() T {
  `    ret self.value;
  `  }
  `}
  `fun main() num {
  `  Box<num> b;
  `  b.value = 0;
  `  printf("%s\n", b.wrap("chained").get());
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "method chaining on a generic method's own-type-param call result monomorphizes correctly"
  );
  assert contains(out, "Box__str Box__num__wrap__str"), "expected the result type monomorphized on the method's own type param";
  assert contains(out, "char* Box__str__get(Box__str* self)"), "expected the chained method resolved against that result";
}

test "constructing a generic enum from a method's own type param does not cross-substitute via a name collision" {
  str src = `use std.c.io;
  `enum Maybe<T> {
  `  Has(T),
  `  None,
  `}
  `compound Box<T> {
  `  T value;
  `}
  `impl Box<T> {
  `  pub wrap<U>(U x) Maybe<U> {
  `    ret Maybe.Has(x);
  `  }
  `}
  `fun main() num {
  `  Box<num> b;
  `  b.value = 0;
  `  fit b.wrap("hi") {
  `    .Has(v) -> { printf("%s\n", v); }
  `    .None -> { printf("none\n"); }
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(src, "constructing a generic enum from a method's own type param");
  assert contains(out, "tag == Maybe__str_Has"), "expected the arm to test the substituted tag";
}

test "fork is a CONTEXTUAL keyword: usable as an ordinary function" {
  str src = `use std.c.io;
  `pub fun fork() num {
  `  ret 42;
  `}
  `fun main() num {
  `  let pid = fork();
  `  printf("%lld\n", pid);
  `  ret 0;
  `}`;
  let out = emit_c(src, "fork is a CONTEXTUAL keyword: usable as an ordinary function");
  assert contains(out, "fork()"), "expected an ordinary call, not a scheduler spawn";
  assert !contains(out, "__fun_go("), "expected no scheduler runtime to be emitted";
}

test "array return types: T[] is a valid function return type, with a body and signature-only" {
  str src = `use std.c.io;
  `use std.c.mem;
  `pub fun unused_signature_only() str[];
  `fun make_names() str[] {
  `  str[] out = malloc(sizeof(str) * 3);
  `  out[0] = "a";
  `  out[1] = "b";
  `  out[2] = nil;
  `  ret out;
  `}
  `fun main() num {
  `  str[] names = make_names();
  `  printf("%s %s\n", names[0], make_names()[1]);
  `  ret 0;
  `}`;
  str out = run_source(
    src,
    "array_return_type",
    "array return types: T[] is a valid function return type"
  );
  assert equals(out, "a b\n"), "expected the array return type to lower to a pointer-to-pointer, with a matching forward prototype";
}

test "a built program observes the file system and other processes" {
  str src = `use std.c.io;
  `use std.fs;
  `use std.process;
  `use std.vec;
  `use std.string;
  `use std.result;
  `use std.runtime_backend;
  `fun main() num {
  `  make_dir_all("fun-out/observe_probe");
  `  write_string("fun-out/observe_probe/a.txt", "content");
  `  str dir = "no";
  `  if is_dir("fun-out/observe_probe") { dir = "yes"; }
  `  Vec<str> command;
  `  command.init(4);
  `  if runtime_backend_is_windows() {
  `    command.push("cmd");
  `    command.push("/c");
  `    command.push("echo");
  `    command.push("spawned");
  `  } else {
  `    command.push("echo");
  `    command.push("spawned");
  `  }
  `  let r = run(argv_from(&command));
  `  str spawned = "no";
  `  if r.is_ok() && contains(r.unwrap().stdout_text, "spawned") { spawned = "yes"; }
  `  printf("dir=%s spawned=%s\n", dir, spawned);
  `  remove_file("fun-out/observe_probe/a.txt");
  `  ret 0;
  `}`;
  str out = run_source(
    src,
    "observe_probe",
    "a built program observes the file system and other processes"
  );
  assert contains(out, "dir=yes"), "expected the directory it made to be there";
  assert contains(out, "spawned=yes"), "expected the process it ran to report back";
}
