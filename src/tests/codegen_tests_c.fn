test "quirk-impl method call chains onto a call-expression receiver" {
  str src = `use std.c.io;
  `quirk Sized { len() num; is_empty() flag; }
  `compound Bag<T> { num len; }
  `impl Bag<T> as Sized { pub len() num { ret self.len; } pub is_empty() flag { ret self.len == 0; } }
  `fun make_bag() Bag<num> {
  `  Bag<num> v;
  `  v.len = 2;
  `  ret v;
  `}
  `fun main() num {
  `  printf("%lld %d\n", make_bag().len(), make_bag().is_empty());
  `  ret 0;
  `}`;
  let out = emit_c(src, "quirk-impl method call chains onto a call-expression receiver");
  assert contains(out, "Bag__num__Sized__len"), "expected the quirk method, not the same-named field";
  assert contains(out, "__fun_recv_tmp"), "expected the call receiver hoisted into a temporary";
}

test "a rotating sink writes what was logged to its file" {
  str src = `use std.io;
  `use std.fs;
  `use std.c.io;
  `fun main() num {
  `  RotatingSink r = rotating_sink_new("fun-out/rotate_probe.log", 4096, 2);
  `  Sink s = Sink.Rotating(&r);
  `  write_to(s, "first line\n");
  `  _ = s.flush();
  `  r.close();
  `  str back = read_to_string("fun-out/rotate_probe.log");
  `  printf("[%s]", back);
  `  remove_file("fun-out/rotate_probe.log");
  `  ret 0;
  `}`;
  make_dir_all("fun-out");
  str out = run_source(
    src,
    "rotating_sink_probe",
    "a rotating sink writes what was logged to its file"
  );
  assert contains(out, "first line"), "expected the line to reach the file";
}

test "for item : iterable inlines a user Iterator's own next() body; break exits the loop" {
  str src = `use std.c.io;
  `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Counter { num cur; num limit; }
  `impl Counter as Iterator<num> {
  `  pub next() Option<num> {
  `    if self.cur >= self.limit { ret Option.None; }
  `    num v = self.cur;
  `    self.cur = self.cur + 1;
  `    ret Option.Some(v);
  `  }
  `}
  `fun main() num {
  `  Counter c = Counter{cur = 0, limit = 5};
  `  num sum = 0;
  `  for x : c {
  `    if x == 3 { break; }
  `    sum = sum + x;
  `  }
  `  printf("%lld\n", sum);
  `  ret 0;
  `}`;
  let out = emit_c(src, "for item : iterable drives a user Iterator");
  // The loop no longer calls `next()`, its own body is spliced directly
  // inline (a hygienically-renamed clone of it, hence the `__fun_iter_local`
  // prefix): `Counter__Iterator__next` still exists as a real emitted C
  // function (there's no dead-code elimination in this compiler, so an
  // unused function still gets emitted), but the `for` loop's own generated
  // code never calls it.
  assert contains(out, "__fun_iter_local"), "expected the loop to splice next()'s own body inline";
  assert !contains(out, "Counter__Iterator__next(&c)"), "expected no direct call to next(), it should be inlined";
}

test "an inlined Iterator's own next() with a nested for/if (ret two levels deep) still yields correctly" {
  str src = `use std.c.io;
  `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Evens { num idx; num limit; }
  `impl Evens as Iterator<num> {
  `  pub next() Option<num> {
  `    for self.idx < self.limit {
  `      let at = self.idx;
  `      self.idx = self.idx + 1;
  `      if at % 2 == 0 {
  `        ret Option.Some(at);
  `      }
  `    }
  `    ret Option.None;
  `  }
  `}
  `fun main() num {
  `  Evens e = Evens{idx = 0, limit = 10};
  `  num sum = 0;
  `  for x : e {
  `    sum = sum + x;
  `  }
  `  printf("%lld\n", sum);
  `  ret 0;
  `}`;
  let out = run_source(
    src,
    "inlined_next_nested_for_if",
    "an inlined Iterator's next() with a nested for/if still yields correctly"
  );
  // 0 + 2 + 4 + 6 + 8 = 20.
  assert contains(out, "20"), "expected the nested-scan next() to still yield every even value";
}

test "two for loops inlining the same Iterator type in one function don't collide" {
  str src = `use std.c.io;
  `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Counter { num cur; num limit; }
  `impl Counter as Iterator<num> {
  `  pub next() Option<num> {
  `    if self.cur >= self.limit { ret Option.None; }
  `    num v = self.cur;
  `    self.cur = self.cur + 1;
  `    ret Option.Some(v);
  `  }
  `}
  `fun make_counter(num limit) Counter {
  `  ret Counter{cur = 0, limit = limit};
  `}
  `fun main() num {
  `  Counter a = make_counter(2);
  `  num total = 0;
  `  for x : a {
  `    Counter b = make_counter(2);
  `    for y : b {
  `      total = total + x * 10 + y;
  `    }
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(
    src,
    "inlined_next_no_collision",
    "two for loops inlining the same Iterator type don't collide"
  );
  // (0*10+0)+(0*10+1)+(1*10+0)+(1*10+1) = 0+1+10+11 = 22.
  assert contains(out, "22"), "expected each splice site's own hygienically-renamed locals not to collide";
}

test "a plain type's call-based next() fallback supports the two-name enumerate form" {
  // `next()`'s own body uses `elif`, a shape `_next_body_inlinable`
  // never accepts, forcing the call-based fallback
  // (`emit_called_iterator_next`) rather than the inline splice - this
  // fallback didn't support `for i, x :: it` at all before, silently
  // emitting an undeclared `i`.
  str src = `use std.c.io;
  `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Evens { num idx; num limit; }
  `impl Evens as Iterator<num> {
  `  pub next() Option<num> {
  `    if self.idx >= self.limit {
  `      ret Option.None;
  `    } elif self.idx < self.limit {
  `      let at = self.idx;
  `      self.idx = self.idx + 2;
  `      ret Option.Some(at);
  `    }
  `    ret Option.None;
  `  }
  `}
  `fun main() num {
  `  Evens e = Evens{idx = 0, limit = 6};
  `  num total = 0;
  `  for i, x :: e {
  `    total = total + i * 100 + x;
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(
    src,
    "call_based_enumerate",
    "call-based fallback supports two-name enumerate"
  );
  // i,x pairs: (0,0) (1,2) (2,4) -> 0 + 102 + 204 = 306.
  assert contains(out, "306"), "expected the running index to enumerate correctly through the call-based fallback";
}

test "a plain type's call-based next() fallback supports destructuring a tuple Elem" {
  // Same reasoning as the enumerate test above, for the destructure
  // form and a tuple-shaped `Elem` - the fallback's own `elem_dt` used
  // to come from string-stripping `quirk_concrete_instantiation`, which
  // never represented a tuple at all.
  str src = `use std.c.io;
  `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Pairs { num idx; num limit; }
  `impl Pairs as Iterator<(num, num)> {
  `  pub next() Option<(num, num)> {
  `    if self.idx >= self.limit {
  `      ret Option.None;
  `    } elif self.idx < self.limit {
  `      let at = self.idx;
  `      self.idx = self.idx + 1;
  `      ret Option.Some((at, at * 10));
  `    }
  `    ret Option.None;
  `  }
  `}
  `fun main() num {
  `  Pairs p = Pairs{idx = 0, limit = 3};
  `  num total = 0;
  `  for (a, b) : p {
  `    total = total + a + b;
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(
    src,
    "call_based_destructure",
    "call-based fallback supports tuple destructuring"
  );
  // (0+0)+(1+10)+(2+20) = 33.
  assert contains(out, "33"), "expected the tuple Elem to destructure correctly through the call-based fallback";
}

test "for k, v :: map binds each key to its value" {
  str src = `use std.c.io;
  `use std.map;
  `fun main() num {
  `  Map<str, num> m;
  `  m.init(8);
  `  m.put("a", 1);
  `  for k, v :: m {
  `    printf("%s=%lld\n", k, v);
  `  }
  `  m.free();
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(
    src,
    "for_map_pairs",
    "for k, v :: map binds each key to its value"
  );
  assert contains(out, "Map__str__num"), "expected the map instantiation";
  assert contains(out, "printf"), "expected the body to be emitted";
}

test "default parameter values: free fn + method, omitting trailing args fills defaults" {
  str src = `use std.c.io;
  `fun base() num { ret 100; }
  `fun three(num a, num b = 2, num c = base()) num { ret a * 1000 + b * 10 + c; }
  `compound Box { num v; }
  `impl Box {
  `  pub add(num x, num y = 50) num { ret self.v + x + y; }
  `}
  `fun main() num {
  `  printf("%lld %lld %lld\n", three(1), three(1, 5), three(1, 5, 9));
  `  Box b;
  `  b.v = 1000;
  `  printf("%lld %lld\n", b.add(1), b.add(1, 1));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "default parameter values: free fn + method, omitting trailing args fills defaults"
  );
  assert contains(out, "three(1, 2, base())"), "expected a defaulted call expression to be materialized";
  assert contains(out, "Box__add(&b, 1, 50)"), "expected the method default to be filled";
}

test "the watchdog stops a program waiting on a channel nothing sends to" {
  str src = `use std.c.io;
  `use std.channel;
  `fun main() num {
  `  Channel<num> ch = channel_new(1);
  `  num v = 0;
  `  ch.recv_into(&v);
  `  printf("never reached\n");
  `  ret 0;
  `}`;
  // The wait never ends on its own, so the watchdog is what ends it. On
  // its own the watchdog only warns, over and over, and the program keeps
  // waiting; asking it to abort is what makes this a test that finishes
  // rather than one that hangs the suite. Both are read by the child from
  // what this process holds, and the interval is short on purpose.
  assert set_env("FUN_DEADLOCK_WATCHDOG_MS", "300"), "expected to set the watchdog";
  assert set_env("FUN_DEADLOCK_ABORT", "1"), "expected to ask it to abort rather than warn";
  ProcessResult r = run_source_result(
    src,
    "watchdog_probe",
    "the watchdog stops a program waiting on a channel nothing sends to"
  );
  assert clear_env("FUN_DEADLOCK_WATCHDOG_MS"), "expected to clear the watchdog";
  assert clear_env("FUN_DEADLOCK_ABORT"), "expected to clear the abort setting";

  assert contains(r.stderr_text, "possible deadlock"), "expected the watchdog to say what it noticed";
  assert !contains(r.stdout_text, "never reached"), "expected the program stopped before finishing";
  assert r.exit_code != 0, "expected the program to end on the watchdog rather than normally";
}

test "a value renders through Display when written as {}" {
  str src = `use std.io;
  `use std.quirks;
  `compound Point {
  `  num x;
  `}
  `impl Point as Display {
  `  pub to_string() str { ret "point"; }
  `}
