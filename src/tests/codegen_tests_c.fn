test "fit on a chr subject checks every branch, not just the first (regression)" {
  str src = `use std.c.io;
  `fun classify(chr c) str {
  `  fit c {
  `    '+' -> { ret "plus"; }
  `    '-' -> { ret "minus"; }
  `    '*' -> { ret "star"; }
  `    '/' -> { ret "slash"; }
  `    _ -> { ret "other"; }
  `  }
  `}
  `fun main() num {
  `  printf("%s %s %s %s %s\n", classify('+'), classify('-'), classify('*'), classify('/'), classify('x'));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "fit on a chr subject checks every branch, not just the first (regression)"
  );
  assert contains(out, "c == '+'"), "expected the first char branch";
  assert contains(out, "c == '-'"), "expected the second char branch";
  assert contains(out, "c == '*'"), "expected the third char branch";
  assert contains(out, "c == '/'"), "expected the fourth char branch";
}

test "an enum variant payload of a generic-compound type matches its own declared type" {
  str src = `use std.c.io;
  `compound Bag<T> { T first; }
  `impl Bag<T> { pub get() T { ret self.first; } }
  `enum E { A(str, Bag<num>) }
  `fun consume(str name, Bag<num> v) num {
  `  ret v.get();
  `}
  `fun handle(E e) num {
  `  fit e {
  `    E.A(name, items) -> { ret consume(name, items); }
  `  }
  `  ret -1;
  `}
  `fun main() num {
  `  Bag<num> v;
  `  v.first = 42;
  `  printf("%lld\n", handle(E.A("x", v)));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "an enum variant payload of a generic-compound type matches its own declared type"
  );
  assert contains(out, "Bag__num _1;"), "expected the payload field at the monomorphized type";
  assert contains(out, "consume(name, items)"), "expected the bound payload to pass the type check";
}

test "sizeof(generic type param) is not resolved against an unrelated global type of the same bare name" {
  str src = `use std.c.io;
  `enum E { Variant }
  `compound Pair<T, E> { T a; }
  `impl Pair<T, E> { pub esize() num { ret sizeof(E); } }
  `fun main() num {
  `  Pair<num, str> p;
  `  printf("%lld\n", p.esize());
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "sizeof(generic type param) is not resolved against an unrelated global type of the same bare name"
  );
  assert contains(out, "sizeof(char*)"), "expected sizeof to use the substituted type param, not the global enum";
}

test "a generic container instantiated with a pointer type argument mangles distinctly" {
  str src = `use std.c.io;
  `compound Node { num value; }
  `compound Bag<T> { T slot; }
  `impl Bag<T> { pub put(T v) { self.slot = v; } pub get() T { ret self.slot; } }
  `fun main() num {
  `  Bag<Node> plain;
  `  Node a;
  `  a.value = 7;
  `  plain.put(a);
  `  Bag<Node*> ptrs;
  `  Node b;
  `  b.value = 42;
  `  ptrs.put(&b);
  `  Node got_plain = plain.get();
  `  Node* got_ptr = ptrs.get();
  `  printf("%lld %lld\n", got_plain.value, got_ptr.value);
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "a generic container instantiated with a pointer type argument mangles distinctly"
  );
  assert contains(out, "Bag__Node_ptr1"), "expected the pointer instantiation to mangle distinctly";
  assert contains(out, "Bag__Node__put(Bag__Node* self, Node v)"), "expected the by-value instantiation to keep its own signature";
  assert contains(out, "Bag__Node_ptr1__put(Bag__Node_ptr1* self, Node* v)"), "expected the pointer instantiation to take a pointer";
}

test "a concrete quirk instantiation with a pointer type argument validates against its own substituted signature" {
  str src = `use std.c.io;
  `compound Node { num value; }
  `quirk Box<T> { get() T; }
  `compound PtrBox { Node* held; }
  `impl PtrBox as Box<Node*> {
