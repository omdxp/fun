  assert contains(out_c, "fmt_raw("), "expected the raw-pointer formatter to be used instead";
}

test "a private name in one file does not collide with the same name in another" {
  // Sibling files on disk, which is the only way a cross-file collision
  // can happen at all.
  assert write_string(
    "src/tests/fixtures/priv_sibling_a.fn",
    `fun _helper() num { ret 1; }
    `pub fun from_a() num { ret _helper(); }`
  ), "expected to stage the first file";
  defer remove_file("src/tests/fixtures/priv_sibling_a.fn");
  assert write_string(
    "src/tests/fixtures/priv_sibling_b.fn",
    `fun _helper() num { ret 2; }
    `pub fun from_b() num { ret _helper(); }`
  ), "expected to stage the second file";
  defer remove_file("src/tests/fixtures/priv_sibling_b.fn");

  str src = `use priv_sibling_a;
  `use priv_sibling_b;
  `use std.c.io;
  `fun main() num {
  `  printf("%lld\n", from_a() + from_b());
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(
    src,
    "priv_sibling_main",
    "a private name in one file does not collide with the same name in another"
  );
  assert contains(out, "from_a"), "expected the first file's function";
  assert contains(out, "from_b"), "expected the second file's function";
}

test "fit statement with an explicit catch-all branch compiles and evaluates correctly" {
  str src = `use std.c.io;
  `enum Token { Num(num), Ident, Plus, Minus, Star, Slash, LParen, RParen, Eof }
  `fun classify(Token t) num {
  `  fit t {
  `    Token.Num(n) -> { ret n; }
  `    Token.Ident -> { ret 1; }
  `    _ -> { ret 0; }
  `  }
  `}
  `fun main() num {
  `  printf("%lld %lld %lld\n", classify(Token.Num(5)), classify(Token.Ident), classify(Token.Eof));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "fit statement with an explicit catch-all branch compiles and evaluates correctly"
  );
  assert contains(out, "t.tag == Token_Num"), "expected the payload branch to test its tag";
  assert contains(out, "t.tag == Token_Ident"), "expected the payload-free branch to test its tag";
  assert contains(out, "} else {"), "expected the catch-all to lower to a trailing else";
}

