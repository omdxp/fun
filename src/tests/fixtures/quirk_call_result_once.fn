imp std.c.io;
compound St { num v; }
quirk Weighted { weight() num; }
impl St as Weighted { weight() num { ret self.v; } }
num call_count = 0;
fun make(St* s) Weighted {
  call_count = call_count + 1;
  ret s;
}
fun main() num {
  St st; st.v = 5;
  printf("%lld %lld\n", make(&st).weight(), call_count);
  ret 0;
}