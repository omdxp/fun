imp std.c.io;
imp std.c.mem;

pub fun unused_signature_only() str[];
fun make_names() str[] {
  str[] out = malloc(sizeof(str) * 3);
  out[0] = "a";
  out[1] = "b";
  out[2] = nil;
  ret out;
}

fun main() num {
  str[] names = make_names();
  printf("%s %s\n", names[0], make_names()[1]);
  ret 0;
}
