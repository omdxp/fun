imp std.io;
imp std.fs;
imp std.c.io;
fun main() num {
  RotatingSink r = rotating_sink_new("fun-out/rotate_probe.log", 4096, 2);
  Sink s = Sink.Rotating(&r);
  write_to(s, "first line\n");
  _ = s.flush();
  r.close();
  str back = read_to_string("fun-out/rotate_probe.log");
  printf("[%s]", back);
  remove_file("fun-out/rotate_probe.log");
  ret 0;
}