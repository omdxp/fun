imp std.c.io;

fun logLine(str msg) {
  printf("%s\n", msg);
}

fun main() num {
  num i = 0;
  for i < 4 {
    defer logLine("defer iter");
    i = i + 1;
    if i == 2 {
      logLine("continue");
      continue;
    }
    if i == 3 {
      logLine("break");
      break;
    }
    logLine("tail");
  }
  ret 0;
}
