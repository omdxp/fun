imp std.c.io;
compound Item { num v; }
quirk HasV { getV() num; }
impl Item as HasV { getV() num { ret self.v; } }
compound Holder { Item it; }
fun main() num {
  Item[3] arr;
  arr[0] = Item{v = 7};
  HasV h1 = &arr[0];
  Holder hd;
  hd.it = Item{v = 9};
  HasV h2 = &hd.it;
  Item a = Item{v = 1};
  Item b = Item{v = 2};
  HasV[2] quirk_arr;
  quirk_arr[0] = &a;
  quirk_arr[1] = &b;
  printf("%lld %lld %lld %lld\n", h1.getV(), h2.getV(), quirk_arr[0].getV(), quirk_arr[1].getV());
  ret 0;
}