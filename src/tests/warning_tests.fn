// Warning cases: a program, and what the analysis is expected to notice
// about it.

use ..lexer.lexer;
use ..parser.parse_state;
use ..parser.parser;
use ..semantics.warnings;
use std.string;
use std.vec;
use std.result;

// Parses `src` and reports what the analysis notices, joined into one
// string, or the message of the expectation that went unmet.
fun notice(str src, flag report_unused) str {
  let tokens = tokenize(src, "t.fn");
  if tokens.is_err() {
    ret "lex error";
  }
  ParseState state = parse_state_new("t.fn", src);
  state.tokens = tokens.unwrap();
  state.emit_stderr = false;
  Parser p = parser_new(&state);
  let failed = p.parse();
  if failed.is_some() {
    ret "parse error";
  }
  let found = analyze(&state.nodes, &state.nodes, report_unused, "t.fn");
  if found.is_err() {
    ret found.unwrap_err().message;
  }
  Vec<Warning> warnings = found.unwrap();
  defer warnings.free();
  StringBuilder b = string_builder_init(128);
  num i = 0;
  for i < warnings.len {
    Warning w = warnings.get(i);
    i = i + 1;
    b.append(warning_id_name(w.id));
    b.append(": ");
    b.append(w.message);
    b.append("\n");
  }
  ret b.build();
}

fun notices(str src, str needle, str label) {
  assert contains(notice(src, false), needle), label;
}

fun notices_unused(str src, str needle, str label) {
  assert contains(notice(src, true), needle), label;
}

fun says_nothing(str src, str label) {
  assert equals(notice(src, false), ""), label;
}

test "returning the address of a local is noticed" {
  notices(
    `fun bad() num* {
    `  num x = 1;
    `  ret &x;
    `}`,
    "returning address of local variable",
    "expected the address of a local to be noticed"
  );
  says_nothing(
    `fun ok() num* {
    `  num* p = nil;
    `  ret p;
    `}`,
    "expected a pointer local to be returned quietly"
  );
}

test "a statement after one that always exits is noticed" {
  notices(
    `fun main() num {
    `  ret 0;
    `  num x = 1;
    `}`,
    "unreachable",
    "expected the unreachable statement to be noticed"
  );
}

test "an assert that cannot fail is noticed" {
  notices(
    `fun main() {
    `  assert true, "always";
    `}`,
    "always true",
    "expected the constant assert to be noticed"
  );
}

test "a control silences what it names, wherever it is written" {
  says_nothing(
    `fun main() num {
    `  ret 0;
    `  allow unreachable_code, "left in during a refactor";
    `  num x = 1;
    `}`,
    "expected the control to cover the whole body"
  );
}

test "an expectation that never fires is an error" {
  assert contains(
    notice(
    `fun ok() num* {
      `  expect return_local_ptr, "should fail when the warning disappears";
      `  num* p = nil;
      `  ret p;
      `}`,
    false
    ),
    "was not emitted"
  ), "expected the unmet expectation to be reported";
}

test "a declaration nothing reads is noticed when asked" {
  notices_unused(
    `fun demo() void {
    `  num value = 1;
    `}`,
    "unused variable 'value'",
    "expected the unused local to be noticed"
  );
  says_nothing(
    `fun demo() void {
    `  num value = 1;
    `}`,
    "expected silence when unused declarations are not asked for"
  );
}

test "a function that promises a value must hand one back" {
  notices(
    `fun f(num x) num {
    `  num y = x;
    `}`,
    "without returning a value",
    "expected the missing return to be noticed"
  );
  says_nothing(
    `fun f(num x) num {
    `  for true {
    `    ret x;
    `  }
    `}`,
    "expected a loop that never finishes to be accepted"
  );
}

test "a fit that misses a case is noticed" {
  notices(
    `enum Color {
    `  Red,
    `  Green,
    `}
    `fun main() {
    `  Color c = Color.Red;
    `  fit c {
    `    Color.Red -> { ret; }
    `  }
    `}`,
    "does not handle",
    "expected the missing variant to be noticed"
  );
  says_nothing(
    `enum Color {
    `  Red,
    `  Green,
    `}
    `fun main() {
    `  Color c = Color.Red;
    `  fit c {
    `    Color.Red -> { ret; }
    `    Color.Green -> { ret; }
    `  }
    `}`,
    "expected a fit covering every variant to be accepted"
  );
}

test "a branch an earlier one already covers is noticed" {
  notices(
    `enum Color {
    `  Red,
    `  Green,
    `}
    `fun main() {
    `  Color c = Color.Red;
    `  fit c {
    `    Color.Red -> { ret; }
    `    Color.Red -> { ret; }
    `    Color.Green -> { ret; }
    `  }
    `}`,
    "already covered",
    "expected the duplicate branch to be noticed"
  );
}

test "a literal a sized integer cannot hold is noticed" {
  notices(
    `fun main() {
    `  u2 a = 5;
    `}`,
    "does not fit",
    "expected the out-of-range literal to be noticed"
  );
  says_nothing(
    `fun main() {
    `  u8 a = 200;
    `  i8 b = -100;
    `}`,
    "expected literals within range to be accepted"
  );
}

test "a value several tasks write through is noticed" {
  notices(
    `compound Counter {
    `  num n;
    `}
    `async fun bump(Counter* c) {
    `  c.n = c.n + 1;
    `}
    `fun main() {
    `  Counter counter;
    `  for i : 0..4 {
    `    fork bump(&counter);
    `  }
    `}`,
    "write through it",
    "expected the shared mutable capture to be noticed"
  );
  says_nothing(
    `compound Counter {
    `  num n;
    `}
    `async fun peek(Counter* c) {
    `  let v = c.n;
    `}
    `fun main() {
    `  Counter counter;
    `  for i : 0..4 {
    `    fork peek(&counter);
    `  }
    `}`,
    "expected a read-only capture to be accepted"
  );
}

test "sends beyond a channel's room with nothing receiving are noticed" {
  notices(
    `fun main() {
    `  let c = channel_new_cap(0, 1);
    `  c <- 1;
    `  c <- 2;
    `  c <- 3;
    `}`,
    "nothing receiving",
    "expected the over-send to be noticed"
  );
  says_nothing(
    `fun main() {
    `  let c = channel_new_cap(0, 1);
    `  c <- 1;
    `  let x = <- c;
    `  c <- 2;
    `  let y = <- c;
    `}`,
    "expected sends a receive drains to be accepted"
  );
}

test "a wait group created with no room, never grown before forking into it, is noticed" {
  notices(
    `async fun worker() {}
    `fun main() {
    `  let wg = wait_group_new(0);
    `  for i : 0..4 {
    `    fork worker();
    `  }
    `}`,
    "never grown",
    "expected the ungrown empty wait group to be noticed"
  );
  says_nothing(
    `async fun worker() {}
    `fun main() {
    `  let wg = wait_group_new(0);
    `  for i : 0..4 {
    `    wg.add(1);
    `    fork worker();
    `  }
    `}`,
    "expected a wait group grown before forking to be accepted"
  );
}

test "a fit written in shorthand is still checked for the variants it skips" {
  // Every branch here names no enum, so what is being matched has to
  // come from what the subject holds. Without that, a shorthand fit was
  // never checked at all.
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  fit s {
  `    .A -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing variant to be noticed";
  assert contains(found, "S.B"), "expected the message to name what is missing";
}

test "a fit over a function parameter is checked exactly like one over a local" {
  // local_types only ever registered a `.Variable` statement's own
  // name, never a parameter's, so `fit`ing straight over what a
  // function was handed (the single most common shape) silently
  // skipped exhaustiveness checking entirely.
  str src = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `}
  `fun area(Shape s) num {
  `  fit s {
  `    .Circle(r) -> { ret r * r; }
  `  }
  `  ret 0;
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing variant noticed for a parameter subject";
  assert contains(found, "Shape.Square"), "expected the message to name what is missing";
}

test "a fit over a field access is checked, not just a bare identifier" {
  // Regression: `_fit_subject_type` only ever resolved a bare
  // `.Identifier` (or a single deref of one), so `fit base.field`
  // silently skipped exhaustiveness checking entirely, no matter how
  // many variants a real program's own fit statements over `x.kind`
  // shaped subjects left unhandled.
  str src = `enum Shape { Circle, Square }
  `compound Box { Shape kind; }
  `fun describe(Box b) num {
  `  fit b.kind {
  `    .Circle -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing variant noticed for a field-access subject";
  assert contains(found, "Shape.Square"), "expected the message to name what is missing";
}

test "a fit over a propagated field access is checked too" {
  // Same root cause as the field-access case just above, one layer
  // deeper: `get()?.kind` never reached the field-access resolver at
  // all, since `_fit_subject_type` had no case for a `?`/`!`-
  // propagated operand either. Found reviewing symbols.fn's own
  // `fit covering_fit(...)?.kind { ... }`, whose missing `_ ->` arms
  // would otherwise never have been checked at all.
  str src = `use std.option;
  `enum Shape { Circle, Square }
  `compound Box { Shape kind; }
  `fun get() Option<Box*> { ret .None; }
  `fun describe() Option<num> {
  `  fit get()?.kind {
  `    .Circle -> { ret .Some(1); }
  `  }
  `  ret .Some(0);
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing variant noticed through the propagated field-access subject";
  assert contains(found, "Shape.Square"), "expected the message to name what is missing";
}

test "a fit missing several variants names every one of them, not just the first" {
  str src = `enum Shape {
  `  Circle(num),
  `  Square(num),
  `  Triangle,
  `}
  `fun area(Shape s) num {
  `  fit s {
  `    .Circle(r) -> { ret r * r; }
  `  }
  `  ret 0;
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing variants to be noticed";
  assert contains(found, "'Shape.Square'"), "expected Square named";
  assert contains(found, "'Shape.Triangle'"), "expected Triangle named too, in the same warning";
  // Only one warning for the whole fit, not one per missing variant.
  assert count(found, "fit_non_exhaustive") == 1, "expected every missing variant folded into a single warning";
}

test "a shape-downcast fit missing an implementor is noticed" {
  str src = `shape HasArea { area() num; }
  `compound Circle { num radius; }
  `compound Square { num side; }
  `impl Circle as HasArea { area() num { ret self.radius * self.radius; } }
  `impl Square as HasArea { area() num { ret self.side * self.side; } }
  `fun describe(HasArea s) str {
  `  str out = "unknown";
  `  fit s {
  `    Circle(c) -> { out = "circle"; }
  `  }
  `  ret out;
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing implementor to be noticed";
  assert contains(found, "'Square'"), "expected the message to name what is missing";
}

test "a shape-downcast fit covering every implementor needs no wildcard" {
  str src = `shape HasArea { area() num; }
  `compound Circle { num radius; }
  `compound Square { num side; }
  `impl Circle as HasArea { area() num { ret self.radius * self.radius; } }
  `impl Square as HasArea { area() num { ret self.side * self.side; } }
  `fun describe(HasArea s) str {
  `  str out = "unknown";
  `  fit s {
  `    Circle(c) -> { out = "circle"; }
  `    Square(sq) -> { out = "square"; }
  `  }
  `  ret out;
  `}`;
  assert !contains(
    notice(src, false),
    "fit_non_exhaustive"
  ), "expected covering every implementor to need no catch-all, same as an enum's own variants";
}

test "a shape-downcast fit naming the same implementor twice is noticed" {
  str src = `shape HasArea { area() num; }
  `compound Circle { num radius; }
  `impl Circle as HasArea { area() num { ret self.radius * self.radius; } }
  `fun describe(HasArea s) str {
  `  str out = "unknown";
  `  fit s {
  `    Circle(c) -> { out = "circle"; }
  `    Circle(c2) -> { out = "circle again"; }
  `    _ -> { }
  `  }
  `  ret out;
  `}`;
  assert contains(
    notice(src, false),
    "fit_unreachable_branch"
  ), "expected the second Circle arm to be reported unreachable";
}

test "a shape-downcast fit missing a concrete generic instantiation is noticed" {
  str src = `shape Sized { len() num; }
  `compound Circle { num radius; }
  `impl Circle as Sized { len() num { ret 1; } }
  `compound Box<T> { T val; num count; }
  `impl Box<num> as Sized { len() num { ret self.count; } }
  `fun describe(Sized s) num {
  `  fit s {
  `    Circle(c) -> { ret c.radius; }
  `  }
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing concrete instantiation to be noticed";
  assert contains(found, "'Box__num'"), "expected the message to name the mangled instantiation";
}

test "a shape-downcast fit missing an unbound generic implementor asks for nothing impossible" {
  // impl Box<T> as Sized has no valid arm syntax at all - it must not be
  // demanded.
  str src = `shape Sized { len() num; }
  `compound Circle { num radius; }
  `impl Circle as Sized { len() num { ret 1; } }
  `compound Box<T> { T val; num count; }
  `impl Box<T> as Sized { len() num { ret self.count; } }
  `fun describe(Sized s) num {
  `  fit s {
  `    Circle(c) -> { ret c.radius; }
  `  }
  `}`;
  assert !contains(
    notice(src, false),
    "fit_non_exhaustive"
  ), "expected the unbound generic template not to be demanded";
}

test "a shape-downcast fit covering a concrete generic instantiation needs no wildcard" {
  str src = `shape Sized { len() num; }
  `compound Circle { num radius; }
  `impl Circle as Sized { len() num { ret 1; } }
  `compound Box<T> { T val; num count; }
  `impl Box<num> as Sized { len() num { ret self.count; } }
  `fun describe(Sized s) num {
  `  fit s {
  `    Circle(c) -> { ret c.radius; }
  `    Box<num>(b) -> { ret b.count; }
  `  }
  `}`;
  assert !contains(
    notice(src, false),
    "fit_non_exhaustive"
  ), "expected covering the concrete instantiation to need no catch-all";
}

test "a shape-downcast fit's bare auto-resolved arm counts as covering its one concrete instantiation" {
  // Box(b) (no <Args>) auto-resolves to Box<num> at typecheck since it's
  // the only impl of Box<...> for Sized - exhaustiveness must credit it
  // against the same reconstructed name, not treat the bare arm as
  // covering nothing.
  str src = `shape Sized { len() num; }
  `compound Circle { num radius; }
  `impl Circle as Sized { len() num { ret 1; } }
  `compound Box<T> { T val; num count; }
  `impl Box<num> as Sized { len() num { ret self.count; } }
  `fun describe(Sized s) num {
  `  fit s {
  `    Circle(c) -> { ret c.radius; }
  `    Box(b) -> { ret b.count; }
  `  }
  `}`;
  assert !contains(
    notice(src, false),
    "fit_non_exhaustive"
  ), "expected the bare auto-resolved arm to need no catch-all";
}

test "a fit comma-separated arm counts every alternative as covered" {
  str src = `enum Color { Red, Green, Blue }
  `fun warm(Color c) flag {
  `  fit c {
  `    .Red, .Green -> { ret true; }
  `    .Blue -> { ret false; }
  `  }
  `  ret false;
  `}`;
  assert !contains(
    notice(src, false),
    "fit_non_exhaustive"
  ), "expected the comma-separated arm's second alternative to count as handled";
}

test "a fit over num or a pointer with no catch-all is noticed" {
  // Neither has a closed value set the way flag/enum do, so a catch-all
  // is the only way to be exhaustive.
  str num_src = `fun main() num {
  `  num x = 1;
  `  fit x {
  `    1 -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  assert contains(notice(num_src, false), "fit_non_exhaustive"), "expected the missing catch-all noticed for num";

  str ptr_src = `use std.c.mem;
  `fun main() num {
  `  raw* p = malloc(1);
  `  fit p {
  `    NULL -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  assert contains(notice(ptr_src, false), "fit_non_exhaustive"), "expected the missing catch-all noticed for a pointer";
}

test "a fit over chr, str, or dec with no catch-all is noticed too, not just num and pointers" {
  // Same reasoning as num/pointer above: none of these three have a
  // closed value set either, so the same check applies.
  str chr_src = `fun main() num {
  `  chr c = 'a';
  `  fit c {
  `    'a', 'b' -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  assert contains(notice(chr_src, false), "fit_non_exhaustive"), "expected the missing catch-all noticed for chr";

  str str_src = `fun main() num {
  `  str s = "x";
  `  fit s {
  `    "x" -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  assert contains(notice(str_src, false), "fit_non_exhaustive"), "expected the missing catch-all noticed for str";

  str dec_src = `fun main() num {
  `  dec d = 1.0;
  `  fit d {
  `    1.0 -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  assert contains(notice(dec_src, false), "fit_non_exhaustive"), "expected the missing catch-all noticed for dec";
}

test "a fit over flag with both true and false covered is not double-flagged by the catch-all check" {
  // flag's own exhaustiveness is already decided by the truths counter
  // above this check; flag falls through to here too once it passes
  // (it names no enum), so the catch-all check must not re-flag it.
  str src = `fun main() num {
  `  flag b = true;
  `  fit b {
  `    true -> { ret 1; }
  `    false -> { ret 0; }
  `  }
  `}`;
  assert !contains(notice(src, false), "fit_non_exhaustive"), "expected no warning when both truth values are covered";
}

test "a fit over flag with a catch-all after both truth values are already covered is noticed" {
  str src = `fun main() num {
  `  flag b = true;
  `  fit b {
  `    true -> { ret 1; }
  `    false -> { ret 0; }
  `    _ -> { ret 2; }
  `  }
  `}`;
  assert contains(notice(src, false), "fit_unreachable_branch"), "expected the unreachable catch-all noticed";
}

test "a fit receiving from a channel is checked against the channel's own element type" {
  // `fit <- ch { ... }` desugars to `ch.recv()` at parse time; the
  // catch-all/enum check needs the channel's own generic element type,
  // not the call's own literal return type, to notice a missing variant.
  str src = `compound Channel<T> { T v; }
  `impl Channel<T> { pub recv() T { ret self.v; } }
  `enum Msg { Compute(num), Result(num), Stop }
  `async fun worker(Channel<Msg>* inbox, Channel<Msg>* outbox) {
  `  fit <- inbox {
  `    Msg.Compute(v) -> { ret; }
  `    Msg.Stop -> { ret; }
  `  }
  `}`;
  str found = notice(src, false);
  assert contains(found, "fit_non_exhaustive"), "expected the missing Msg.Result variant noticed on a channel receive";
  assert contains(found, "Msg.Result"), "expected the message to name what is missing";
}

test "a fit receiving from a channel with every variant covered is not flagged" {
  str src = `compound Channel<T> { T v; }
  `impl Channel<T> { pub recv() T { ret self.v; } }
  `enum Msg { Compute(num), Result(num), Stop }
  `async fun worker(Channel<Msg>* inbox, Channel<Msg>* outbox) {
  `  fit <- inbox {
  `    Msg.Compute(v) -> { ret; }
  `    Msg.Result(v) -> { ret; }
  `    Msg.Stop -> { ret; }
  `  }
  `}`;
  assert !contains(notice(src, false), "fit_non_exhaustive"), "expected no warning once every variant is covered";
}

test "allow silences a shorthand fit's missing variant" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  allow fit_non_exhaustive, "only A matters here";
  `  fit s {
  `    .A -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  assert !contains(notice(src, false), "fit_non_exhaustive"), "expected the warning silenced";
}

test "expect is met by a shorthand fit's missing variant" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  expect fit_non_exhaustive, "this fit is deliberately partial";
  `  fit s {
  `    .A -> { ret 1; }
  `  }
  `  ret 0;
  `}`;
  str found = notice(src, false);
  assert !contains(found, "fit_non_exhaustive:"), "expected the expectation to absorb it";
  assert !contains(found, "was not emitted"), "expected the expectation met";
}

test "an unmet expect on a fit is an error" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  expect fit_non_exhaustive, "claims this fit is partial";
  `  fit s {
  `    .A -> { ret 1; }
  `    .B -> { ret 2; }
  `  }
  `  ret 0;
  `}`;
  // A claim a program makes about itself that is no longer true.
  assert contains(notice(src, false), "was not emitted"), "expected the unmet expectation reported";
}

test "a fit branch an earlier one already covers is noticed" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  fit s {
  `    .A -> { ret 1; }
  `    .A -> { ret 2; }
  `    _ -> { ret 3; }
  `  }
  `}`;
  assert contains(notice(src, false), "fit_unreachable_branch"), "expected the repeated branch noticed";
}

test "allow silences a repeated fit branch" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  allow fit_unreachable_branch, "the repeat is deliberate";
  `  fit s {
  `    .A -> { ret 1; }
  `    .A -> { ret 2; }
  `    _ -> { ret 3; }
  `  }
  `}`;
  assert !contains(notice(src, false), "fit_unreachable_branch"), "expected allow to silence it";
}

test "expect is met by a repeated fit branch" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  expect fit_unreachable_branch, "this fit repeats a branch";
  `  fit s {
  `    .A -> { ret 1; }
  `    .A -> { ret 2; }
  `    _ -> { ret 3; }
  `  }
  `}`;
  str found = notice(src, false);
  assert !contains(found, "fit_unreachable_branch:"), "expected the expectation to absorb it";
  assert !contains(found, "was not emitted"), "expected the expectation met";
}

test "an unmet expect on an unreachable branch is an error" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  expect fit_unreachable_branch, "claims a branch repeats";
  `  fit s {
  `    .A -> { ret 1; }
  `    .B -> { ret 2; }
  `  }
  `}`;
  assert contains(notice(src, false), "was not emitted"), "expected the unmet expectation reported";
}

test "an unmet expect reports its own position, not the top of the file, and is a real error" {
  str src = `enum S { A, B }
  `fun main() num {
  `  S s = .A;
  `  expect fit_unreachable_branch, "claims a branch repeats";
  `  fit s {
  `    .A -> { ret 1; }
  `    .B -> { ret 2; }
  `  }
  `}`;
  let tokens = tokenize(src, "t.fn");
  ParseState state = parse_state_new("t.fn", src);
  state.tokens = tokens.unwrap();
  state.emit_stderr = false;
  Parser p = parser_new(&state);
  assert p.parse().is_none(), "expected the source to parse";
  let found = analyze(&state.nodes, &state.nodes, false, "t.fn");
  assert found.is_err(), "expected the unmet expectation to be an error";
  UnmetExpectation err = found.unwrap_err();
  assert err.has_pos, "expected a real position, not just a message";
  // Line 4 (1-indexed), the `expect` statement's own line, not line 1.
  assert err.pos.line == 4, "expected the expect statement's own line, not the top of the file";
}

test "a missing_return warning reports the function's own declaration line, not the top of the file" {
  str src = `use std.io;
  `
  `fun main() num {
  `  println("hi");
  `}`;
  let tokens = tokenize(src, "t.fn");
  ParseState state = parse_state_new("t.fn", src);
  state.tokens = tokens.unwrap();
  state.emit_stderr = false;
  Parser p = parser_new(&state);
  assert p.parse().is_none(), "expected the source to parse";
  let found = analyze(&state.nodes, &state.nodes, false, "t.fn");
  assert found.is_ok(), "expected analysis to succeed";
  Vec<Warning> warnings = found.unwrap();
  defer warnings.free();
  flag saw_it = false;
  num i = 0;
  for i < warnings.len {
    Warning w = warnings.get(i);
    i = i + 1;
    if w.id == .MissingReturn {
      saw_it = true;
      assert w.has_pos, "expected a real position, not just a message";
      // Line 3 (1-indexed), 'fun main() num {', not line 1.
      assert w.pos.line == 3, "expected the function's own declaration line, not the top of the file";
    }
  }
  assert saw_it, "expected a missing_return warning to fire";
}

test "an unused top-level const is noticed, a used one is not" {
  notices_unused(
    `const str NAME = "unused";
    `fun main() num {
    `  ret 0;
    `}`,
    "unused constant 'NAME'",
    "expected the unread top-level const to be flagged"
  );
  assert !contains(
    notice(
    `const str NAME = "used";
      `fun main() num {
      `  println(NAME);
      `  ret 0;
      `}`,
    true
    ),
    "unused constant"
  ), "expected the read top-level const not to be flagged";
}

test "a singular module-scope allow covers only the next unused-constant warning, a later one still fires" {
  // `allow <id>, "reason";` (the singular spelling) is removed from
  // `self.allowed` the moment it silences one warning - a module-scope
  // allow written once, before two unused consts, covers only the
  // first (A), leaving the second (B) reported normally.
  str found = notice(
    `allow unused_variable, "only A is deliberately unread";
    `const str A = "a";
    `const str B = "b";
    `fun main() num {
    `  ret 0;
    `}`,
    true
  );
  assert !contains(found, "unused constant 'A'"), "expected the allow to cover the first unused constant";
  assert contains(found, "unused constant 'B'"), "expected a singular allow to leave a later occurrence reported, not silenced too";
}

test "a plural module-scope allow covers every unused-constant warning in the file" {
  // `allow unused_variables, ...;` (plural) is the whole-file form:
  // its entry in `self.allowed` is never removed, so it keeps covering
  // every later occurrence, not just the first.
  str found = notice(
    `allow unused_variables, "both of these are deliberately unread";
    `const str A = "a";
    `const str B = "b";
    `fun main() num {
    `  ret 0;
    `}`,
    true
  );
  assert !contains(found, "unused constant"), "expected the plural allow to cover every later unused-constant warning in the file";
}

test "a singular statement-level allow covers only the next unused-variable warning in the function" {
  str found = notice(
    `fun main() num {
    `  allow unused_variable, "only a is deliberately unread";
    `  num a = 1;
    `  num b = 2;
    `  ret 0;
    `}`,
    true
  );
  assert !contains(found, "unused variable 'a'"), "expected the allow to cover the first unused local";
  assert contains(found, "unused variable 'b'"), "expected a singular allow to leave a later occurrence reported, not silenced too";
}

test "a plural statement-level allow covers every unused-variable warning in the function" {
  str found = notice(
    `fun main() num {
    `  allow unused_variables, "both of these are deliberately unread";
    `  num a = 1;
    `  num b = 2;
    `  ret 0;
    `}`,
    true
  );
  assert !contains(found, "unused_variable"), "expected the plural allow to cover every unused-variable warning in the same function";
}

test "a singular expect is met by, and absorbs, only the next occurrence of that warning" {
  str found = notice(
    `enum S { A, B, C }
    `fun main() num {
    `  expect fit_non_exhaustive, "only the first fit is deliberately partial";
    `  S s1 = .A;
    `  fit s1 {
    `    .A -> { ret 1; }
    `  }
    `  S s2 = .B;
    `  fit s2 {
    `    .B -> { ret 2; }
    `  }
    `  ret 0;
    `}`,
    false
  );
  assert !contains(found, "was not emitted"), "expected the expectation met by the first occurrence, not left unmet";
  assert contains(found, "fit_non_exhaustive:"), "expected a singular expect to leave a later occurrence reported, not silently absorbed too";
}

test "a plural expect is met by, and absorbs, every later occurrence of that warning" {
  str found = notice(
    `enum S { A, B, C }
    `fun main() num {
    `  expect fit_non_exhaustives, "both of these fits are deliberately partial";
    `  S s1 = .A;
    `  fit s1 {
    `    .A -> { ret 1; }
    `  }
    `  S s2 = .B;
    `  fit s2 {
    `    .B -> { ret 2; }
    `  }
    `  ret 0;
    `}`,
    false
  );
  assert !contains(found, "fit_non_exhaustive:"), "expected both non-exhaustive fits absorbed by the one plural expect";
  assert !contains(found, "was not emitted"), "expected the expectation met, not left unmet";
}

// A `test`/`fuzz` block's own body was never walked at all: the
// top-level dispatch in `analyze()` only ever matched `.Function` and
// `.Impl`, so every statement-level check (exhaustiveness, unreachable
// code, unused locals, allow/expect scoping) silently never ran for
// what is written inside one, regardless of nesting depth.

test "fit_non_exhaustive is noticed inside a test block" {
  notices(
    `enum Color { Red, Green, Blue }
    `test "t" {
    `  Color c = .Red;
    `  fit c {
    `    .Red -> { }
    `  }
    `}`,
    "fit does not handle",
    "expected a non-exhaustive fit inside a test block to be noticed"
  );
}

test "fit_non_exhaustive is noticed inside a fuzz block" {
  notices(
    `enum Color { Red, Green, Blue }
    `fuzz "f" (raw* data, num len) {
    `  Color c = .Red;
    `  fit c {
    `    .Red -> { }
    `  }
    `}`,
    "fit does not handle",
    "expected a non-exhaustive fit inside a fuzz block to be noticed"
  );
}

test "fit_non_exhaustive is noticed inside a nested if inside a test block" {
  notices(
    `enum Color { Red, Green, Blue }
    `test "t" {
    `  Color c = .Red;
    `  if true {
    `    fit c {
    `      .Red -> { }
    `    }
    `  }
    `}`,
    "fit does not handle",
    "expected a non-exhaustive fit nested inside a test block's own if to be noticed"
  );
}

test "unreachable_code is noticed inside a test block" {
  notices(
    `test "t" {
    `  assert true, "a";
    `  ret;
    `  assert true, "b";
    `}`,
    "unreachable",
    "expected code after a ret inside a test block to be noticed"
  );
}

test "unused_variable is noticed inside a test block, but only with -warn-unused" {
  str src = `test "t" {
    `  num unused_here = 1;
    `  assert 1 + 1 == 2, "keeps the test from being empty, not a bare boolean literal";
    `}`;
  says_nothing(src, "expected unused_variable to stay quiet without -warn-unused");
  notices_unused(
    src,
    "unused variable 'unused_here'",
    "expected the unused local inside a test block to be noticed with -warn-unused"
  );
}

test "unused_variable is noticed inside a fuzz block, but only with -warn-unused" {
  str src = `fuzz "f" (raw* data, num len) {
    `  num unused_here = 1;
    `}`;
  says_nothing(src, "expected unused_variable to stay quiet without -warn-unused");
  notices_unused(
    src,
    "unused variable 'unused_here'",
    "expected the unused local inside a fuzz block to be noticed with -warn-unused"
  );
}

test "fuzz's own two parameters are real fit subjects, not unresolved locals" {
  // Mirrors `walk_function`'s own parameter registration (a `fit` over
  // a plain parameter needs its declared type resolved the same way a
  // `let` local's does), now shared with a fuzz block's two fixed ones.
  says_nothing(
    `fuzz "f" (raw* data, num len) {
    `  if len > 0 {
    `  }
    `}`,
    "expected a fuzz block's own parameters to need no separate declaration"
  );
}

test "a singular statement-level allow written inside a test block covers only its own next occurrence" {
  str found = notice(
    `enum Color { Red, Green, Blue }
    `test "t" {
    `  allow fit_non_exhaustive, "only the first fit here is deliberately partial";
    `  Color a = .Red;
    `  fit a {
    `    .Red -> { }
    `  }
    `  Color b = .Green;
    `  fit b {
    `    .Green -> { }
    `  }
    `}`,
    false
  );
  assert contains(found, "fit does not handle 'Color.Red', 'Color.Blue'"), "expected the second, un-covered fit to still be reported";
  Vec<str> occurrences = split(found, '\n');
  defer occurrences.free();
  num fit_lines = 0;
  for line : occurrences {
    if contains(line, "fit_non_exhaustive:") {
      fit_lines = fit_lines + 1;
    }
  }
  assert fit_lines == 1, "expected the allow to absorb exactly the first occurrence, leaving exactly one reported";
}

test "an expect written inside a test block is met by, and absorbs, a warning from that same test block" {
  str found = notice(
    `test "t" {
    `  expect assert_constant, "deliberately constant, on purpose";
    `  assert true, "always true";
    `}`,
    false
  );
  assert !contains(found, "was not emitted"), "expected the expectation met from inside its own test block, not left unmet";
  assert !contains(found, "assert_constant:"), "expected the met expectation to absorb the warning, not also report it";
}

test "an expect written inside a test block that never fires is reported unmet at the expect statement's own position" {
  str found = notice(
    `test "t" {
    `  expect assert_constant, "this one never actually fires";
    `  assert 1 == 1, "not a bare boolean literal, so it stays undetected as constant";
    `}`,
    false
  );
  assert equals(found, "expected warning 'assert_constant' was not emitted"), "expected the unmet expectation itself, not any other notice";
}

// Every remaining warning category, run through the same test/fuzz-body
// gap once more - each one routes through `walk_declared_body`/
// `walk_body` the same way `fit_non_exhaustive` and `unused_variable`
// already proved does, so this closes out the full set rather than
// leaving the rest to assumption.

test "fit_unreachable_branch is noticed inside a test block" {
  notices(
    `enum S { A, B }
    `test "t" {
    `  S s = .A;
    `  fit s {
    `    .A -> { }
    `    .A -> { }
    `    _ -> { }
    `  }
    `}`,
    "fit_unreachable_branch",
    "expected a repeated fit branch inside a test block to be noticed"
  );
}

test "blocking_fork_deadlock is noticed inside a test block" {
  notices(
    `async fun worker() {}
    `test "t" {
    `  let wg = wait_group_new(0);
    `  for i : 0..4 {
    `    fork worker();
    `  }
    `}`,
    "never grown",
    "expected an ungrown empty wait group inside a test block to be noticed"
  );
}

test "shared_mutable_capture_race is noticed inside a test block" {
  notices(
    `compound Counter {
    `  num n;
    `}
    `async fun bump(Counter* c) {
    `  c.n = c.n + 1;
    `}
    `test "t" {
    `  Counter counter;
    `  for i : 0..4 {
    `    fork bump(&counter);
    `  }
    `}`,
    "write through it",
    "expected a shared mutable capture inside a test block to be noticed"
  );
}

test "shared_mutable_capture_race is noticed inside a fuzz block" {
  notices(
    `compound Counter {
    `  num n;
    `}
    `async fun bump(Counter* c) {
    `  c.n = c.n + 1;
    `}
    `fuzz "f" (raw* data, num len) {
    `  Counter counter;
    `  for i : 0..4 {
    `    fork bump(&counter);
    `  }
    `}`,
    "write through it",
    "expected a shared mutable capture inside a fuzz block to be noticed"
  );
}

test "integer_literal_out_of_range is noticed inside a test block" {
  notices(
    `test "t" {
    `  u2 a = 5;
    `}`,
    "does not fit",
    "expected an out-of-range literal inside a test block to be noticed"
  );
}

test "channel_capacity_overflow is noticed inside a test block" {
  notices(
    `test "t" {
    `  let c = channel_new_cap(0, 1);
    `  c <- 1;
    `  c <- 2;
    `  c <- 3;
    `}`,
    "nothing receiving",
    "expected an over-sent channel inside a test block to be noticed"
  );
}

test "channel_capacity_overflow is noticed inside a fuzz block" {
  notices(
    `fuzz "f" (raw* data, num len) {
    `  let c = channel_new_cap(0, 1);
    `  c <- 1;
    `  c <- 2;
    `  c <- 3;
    `}`,
    "nothing receiving",
    "expected an over-sent channel inside a fuzz block to be noticed"
  );
}

test "return_local_ptr is noticed inside a test block" {
  // `test`/`fuzz` bodies are conceptually void, but `ret <value>;`
  // still parses inside one (it just discards the value), and
  // `.StatementReturn`'s own check in `walk_body` never asked what
  // kind of body it is in - only whether the returned expression takes
  // the address of a local. Checked directly rather than assumed.
  notices(
    `test "t" {
    `  num x = 1;
    `  ret &x;
    `}`,
    "returning address of local variable",
    "expected the address of a local returned inside a test block to be noticed"
  );
}
