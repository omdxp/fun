// Corpus tests whose fixtures call into the standard library. These
// resolve imports from disk, so they cover the paths a source-only
// harness cannot reach.

use harness;
use std.string;

test "std.vec: push and get monomorphize on the element type" {
  str src = `use std.vec;
  `use std.c.io;
  `fun main() num {
  `  Vec<num> v;
  `  v.init(4);
  `  v.push(7);
  `  printf("%lld\n", v.get(0));
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(src, "sl_vec_push", "std.vec push/get");
  assert contains(out, "Vec__num"), "expected the num instantiation";
  assert contains(out, "Vec__num__push"), "expected the monomorphized push";
}

test "std.vec: two element types produce separate instantiations" {
  str src = `use std.vec;
  `fun main() num {
  `  Vec<num> a;
  `  a.init(2);
  `  a.push(1);
  `  Vec<str> b;
  `  b.init(2);
  `  b.push("x");
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(src, "sl_vec_two", "std.vec two instantiations");
  assert contains(out, "Vec__num__push"), "expected the num instantiation";
  assert contains(out, "Vec__str__push"), "expected the str instantiation";
}

test "std.map: put and get monomorphize on both key and value types" {
  str src = `use std.map;
  `use std.c.io;
  `fun main() num {
  `  Map<str, num> m;
  `  m.init(8);
  `  m.put("a", 1);
  `  printf("%lld\n", m.get("a"));
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(src, "sl_map_put", "std.map put/get");
  assert contains(out, "Map__str__num"), "expected the key/value instantiation";
  assert contains(out, "_key_hash"), "expected a key-hash intrinsic";
}

test "for-each over a Map yields (key, value) pairs" {
  str src = `use std.map;
  `use std.c.io;
  `fun main() num {
  `  Map<str, num> m;
  `  m.init(8);
  `  m.put("a", 1);
  `  m.put("b", 2);
  `  num total = 0;
  `  for pair : m {
  `    total = total + pair.1;
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_map_iter_pair", "for-each over Map yields pairs");
  assert equals(out, "3\n"), "expected the single-name form to bind a (K, V) pair";
}

test "for-each over a Map with the two-name form binds key and value separately" {
  str src = `use std.map;
  `use std.c.io;
  `fun main() num {
  `  Map<str, num> m;
  `  m.init(8);
  `  m.put("a", 1);
  `  m.put("b", 2);
  `  m.put("c", 3);
  `  num total = 0;
  `  for k, v :: m {
  `    if equals(k, "b") {
  `      total = total + v;
  `    }
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_map_iter_kv", "for-each over Map with key/value names");
  assert equals(out, "2\n"), "expected k/v bound separately, not a (K, V) tuple";
}

test "destructuring for-each over a Map binds (key, value) the same way as the two-name form" {
  str src = `use std.map;
  `use std.c.io;
  `fun main() num {
  `  Map<str, num> m;
  `  m.init(8);
  `  m.put("x", 10);
  `  num total = 0;
  `  for (k, v) : m {
  `    if equals(k, "x") {
  `      total = total + v;
  `    }
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_map_iter_destructure", "destructuring for-each over Map");
  assert equals(out, "10\n"), "expected (k, v) destructured from the Map's own pair Elem";
}

test "two independent for-each loops over the same Map value don't corrupt each other's cursor" {
  str src = `use std.map;
  `use std.c.io;
  `fun main() num {
  `  Map<str, num> m;
  `  m.init(8);
  `  m.put("a", 1);
  `  m.put("b", 2);
  `  num outer_count = 0;
  `  for a, av :: m {
  `    num inner_count = 0;
  `    for b, bv :: m {
  `      inner_count = inner_count + 1;
  `    }
  `    outer_count = outer_count + inner_count;
  `  }
  `  printf("%lld\n", outer_count);
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_map_iter_reentrant", "nested for-each over the same Map");
  assert equals(out, "4\n"), "expected the full 2x2 cross product, proving each loop iterates its own copy's cursor";
}

test "std.option: Some and None resolve against the declared type" {
  str src = `use std.option;
  `fun main() num {
  `  Option<num> a = .Some(5);
  `  Option<num> b = .None;
  `  if a.is_some() {
  `    ret a.unwrap();
  `  }
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(src, "sl_option", "std.option Some/None");
  assert contains(out, "Option__num"), "expected the num instantiation";
  assert contains(out, "Option__num_Some"), "expected the Some tag";
}

test "std.result: Ok and Err carry their payloads" {
  str src = `use std.result;
  `use std.error;
  `fun try_it(num n) Result<num, Error> {
  `  if n < 0 {
  `    ret err_kind(.Invalid, "negative", 0);
  `  }
  `  ret .Ok(n);
  `}
  `fun main() num {
  `  let r = try_it(3);
  `  if r.is_ok() {
  `    ret r.unwrap();
  `  }
  `  ret 1;
  `}`;
  let out = emit_c_with_imports(src, "sl_result", "std.result Ok/Err");
  assert contains(out, "Result__num__Error"), "expected the payload instantiation";
}

