test "for-each over a Vec with an explicit index name enumerates from zero" {
  str src = `use std.vec;
  `use std.c.io;
  `fun main() num {
  `  Vec<num> v;
  `  v.init(4);
  `  v.push(10);
  `  v.push(20);
  `  v.push(30);
  `  for i, x :: v {
  `    printf("%lld:%lld\n", i, x);
  `  }
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_vec_iter_idx", "for-each over Vec with index");
  assert equals(out, "0:10\n1:20\n2:30\n"), "expected a running 0-based index alongside each element";
}

test "destructuring for-each over a Vec<(A, B)> binds both tuple fields" {
  str src = `use std.vec;
  `use std.c.io;
  `fun main() num {
  `  Vec<(num, num)> v;
  `  v.init(4);
  `  v.push((1, 10));
  `  v.push((2, 20));
  `  for (a, b) : v {
  `    printf("%lld+%lld\n", a, b);
  `  }
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_vec_iter_destructure", "destructuring for-each over Vec");
  assert equals(out, "1+10\n2+20\n"), "expected both tuple fields bound per element";
}

test "a for-each over a real Vec<Vec<str>> resolves the nested item's own real element type" {
  str src = `use std.vec;
  `use std.c.io;
  `fun main() num {
  `  Vec<str> inner;
  `  inner.init(2);
  `  inner.push("a");
  `  inner.push("b");
  `  Vec<Vec<str>> outer;
  `  outer.init(2);
  `  outer.push(inner);
  `  for row : outer {
  `    for s : row {
  `      printf("%s\n", s);
  `    }
  `  }
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_vec_iter_nested", "nested Vec<Vec<str>> for-each");
  assert equals(out, "a\nb\n"), "expected the inner loop to resolve 'row's real Vec<str> element type, not a stale/wrong one";
}

test "two independent for-each loops over the same Vec value don't corrupt each other's cursor" {
  str src = `use std.vec;
  `use std.c.io;
  `fun main() num {
  `  Vec<num> v;
  `  v.init(4);
  `  v.push(1);
  `  v.push(2);
  `  v.push(3);
  `  for x : v {
  `    for y : v {
  `      printf("%lld,%lld\n", x, y);
  `    }
  `  }
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_vec_iter_reentrant", "nested for-each over the same Vec");
  assert equals(
    out,
    "1,1\n1,2\n1,3\n2,1\n2,2\n2,3\n3,1\n3,2\n3,3\n"
  ), "expected the full cross product, proving each loop iterates its own copy's cursor";
}

test "for-each over Vec<num> and Vec<str> in separate functions each resolve their own element type" {
  str src = `use std.vec;
  `use std.c.io;
  `fun nums(Vec<num> v) num {
  `  for x : v {
  `    printf("%lld\n", x);
  `  }
  `  ret 0;
  `}
  `fun main() num {
  `  Vec<str> s;
  `  s.init(2);
  `  s.push("hi");
  `  for x : s {
  `    printf("%s\n", x);
  `  }
  `  Vec<num> n;
  `  n.init(2);
  `  n.push(5);
  `  nums(n);
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_vec_iter_two_fns", "Vec iteration across two functions");
  assert equals(out, "hi\n5\n"), "expected each function's own local table to resolve its own Vec element type, not a stale one from the other function";
}

test "a quirk implemented by a stdlib type dispatches through its vtable" {
  str src = `use std.vec;
  `use std.quirks;
  `use std.c.io;
  `fun main() num {
  `  Vec<num> v;
  `  v.init(2);
  `  v.push(1);
  `  printf("%lld\n", v.len());
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(src, "sl_quirk_sized", "Sized quirk on Vec");
  assert contains(out, "Vec__num"), "expected the instantiation";
}

test "to_hex formats a value in lower-case hex, zero-padded to width" {
  assert equals(to_hex(255, 4), "00ff"), "expected zero-padded lower-case hex";
  assert equals(to_hex(0, 2), "00"), "expected zero itself padded";
  assert equals(to_hex(4294967295, 4), "ffffffff"), "expected a value wider than width to keep its own digits";
  assert equals(to_hex(-1, 4), ""), "expected a negative value to be unsupported";
}

test "to_binary formats a value in binary, zero-padded to width" {
  assert equals(to_binary(10, 8), "00001010"), "expected zero-padded binary";
  assert equals(to_binary(0, 4), "0000"), "expected zero itself padded";
  assert equals(to_binary(255, 4), "11111111"), "expected a value wider than width to keep its own digits";
  assert equals(to_binary(-1, 8), ""), "expected a negative value to be unsupported";
}

test "to_octal formats a value in octal, zero-padded to width" {
  assert equals(to_octal(8, 3), "010"), "expected zero-padded octal";
  assert equals(to_octal(0, 2), "00"), "expected zero itself padded";
  assert equals(to_octal(-1, 3), ""), "expected a negative value to be unsupported";
}

test "std.prelude bundles Vec, Option, Result, Map, Set, and Range through one import" {
  str src = `use std.prelude;
  `use std.c.io;
  `fun main() num {
  `  Vec<num> v;
  `  v.init(0);
  `  v.push(1);
  `  v.push(2);
  `  Option<num> o = .Some(5);
  `  fit o {
  `    .Some(x) -> { printf("opt=%lld\n", x); }
  `    .None -> {}
  `  }
  `  Result<num, str> r = .Ok(10);
  `  fit r {
  `    .Ok(x) -> { printf("res=%lld\n", x); }
  `    .Err(e) -> {}
  `  }
  `  Map<str, num> m;
  `  m.init(4);
  `  m.put("a", 1);
  `  printf("map=%lld\n", m.get("a"));
  `  Set<num> s = set_init(0, 4);
  `  s.add(7);
  `  printf("set_has=%d\n", s.has(7));
  `  num total = 0;
  `  for i : 0..3 {
  `    total = total + i;
  `  }
  `  printf("range=%lld\n", total);
  `  printf("vec=%lld\n", v.get(0));
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_prelude_bundle", "std.prelude bundles the everyday types");
  assert equals(out, "opt=5\nres=10\nmap=1\nset_has=1\nrange=3\nvec=1\n"), "expected every prelude-bundled type usable directly through one import";
}

test "std.step_range iterates a user-defined Steppable type through an ordinary for loop" {
  // The motivating case for Steppable/StepRange<T>: a plain user
  // compound (standing in for a date, or any other ordered type) with
  // no special compiler knowledge, iterated the same general way any
  // Iterator<T> implementor already is - `Range` (num-only, backing
  // the `a..b` syntax sugar) stays completely separate and untouched.
  str src = `use std.step_range;
  `use std.c.io;
  `compound Day { num n; }
  `impl Day as Steppable<Day> {
  `  pub succ() Day {
  `    Day d;
  `    d.n = self.n + 1;
  `    ret d;
  `  }
  `  pub reached(Day end) flag { ret self.n >= end.n; }
  `}
  `fun main() num {
  `  Day start;
  `  start.n = 1;
  `  Day end;
  `  end.n = 5;
  `  for d : StepRange<Day>{start = start, end = end} {
  `    printf("day %lld\n", d.n);
  `  }
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_step_range_days", "for-each over a StepRange<Day>");
  assert equals(out, "day 1\nday 2\nday 3\nday 4\n"), "expected StepRange<Day> to yield every day in [1, 5) through the for loop";
}
