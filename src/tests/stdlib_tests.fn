test "std.set: add and has monomorphize on the element type" {
  str src = `use std.set;
  `fun main() num {
  `  Set<str> s = set_init("", 8);
  `  s.add("a");
  `  if s.has("a") {
  `    ret 1;
  `  }
  `  ret 0;
  `}`;
  let out = emit_c_with_imports(src, "sl_set", "std.set add/has");
  assert contains(out, "Set__str"), "expected the str instantiation";
}

test "for-each over a Set iterates every element" {
  str src = `use std.set;
  `use std.c.io;
  `fun main() num {
  `  Set<num> s = set_init(0, 8);
  `  s.add(1);
  `  s.add(2);
  `  s.add(3);
  `  num total = 0;
  `  for x : s {
  `    total = total + x;
  `  }
  `  printf("%lld\n", total);
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_set_iter", "for-each over Set");
  assert equals(out, "6\n"), "expected every element visited exactly once";
}

test "two independent for-each loops over the same Set value don't corrupt each other's cursor" {
  str src = `use std.set;
  `use std.c.io;
  `fun main() num {
  `  Set<num> s = set_init(0, 8);
  `  s.add(1);
  `  s.add(2);
  `  num pairs = 0;
  `  for x : s {
  `    for y : s {
  `      pairs = pairs + 1;
  `    }
  `  }
  `  printf("%lld\n", pairs);
  `  ret 0;
  `}`;
  let out = run_source(src, "sl_set_iter_reentrant", "nested for-each over the same Set");
  assert equals(out, "4\n"), "expected the full 2x2 cross product, proving each loop iterates its own copy's cursor";
}

