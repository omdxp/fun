// Source-to-C helpers for the ported compiler test corpus. Each helper
// runs the whole pipeline (lex, parse, transpile) over an in-memory
// source string, so a test states its input as source text rather than
// hand-built AST nodes.

imp ..lexer.lexer;
imp ..parser.parse_state;
imp ..parser.parser;
imp ..parser.import_resolver;
imp ..codegen.codegen;
imp ..codegen.codegen_state;
imp std.string;
imp std.result;
imp std.error;
imp std.io;
imp std.fs;
imp std.process;
imp std.vec;
imp std.option;
imp std.runtime_backend;

// Transpiles `src` and returns the emitted C, or an error describing the
// stage that rejected it. Imports are not resolved: `src` is compiled on
// its own, so a test may name `imp` targets it never calls into.
pub fun transpile_source(str src) Result<str, str> {
  let tok_result = tokenize(src, "test.fn");
  if tok_result.is_err() {
    ret .Err("lex error");
  }

  ParseState state = parse_state_new("test.fn", src);
  state.tokens = tok_result.unwrap();
  state.emit_stderr = false;
  Parser p = parser_new(&state);
  let perr = p.parse();
  if perr.is_some() {
    ret .Err("parse error");
  }

  CodegenState cst = codegen_state_new();
  Codegen g = codegen_new(&cst);
  let cc_name = env_or("FUN_CC", "");
  g.msvc_mode = equals(cc_name, "cl") || equals(cc_name, "cl.exe") ||
    (equals(cc_name, "") && runtime_backend_is_windows());
  let cerr = g.transpile(state.nodes);
  if cerr.is_some() {
    ret .Err("codegen error");
  }
  ret .Ok(cst.out.build());
}

// Transpiles `src`, aborting with `label` when any stage rejects it.
pub fun emit_c(str src, str label) str {
  let r = transpile_source(src);
  if r.is_err() {
    allow assert_constant, "reports the stage that rejected the source";
    assert false, format("{str}: {str}", label, r.unwrap_err());
  }
  ret r.unwrap();
}

// Asserts the emitted C for `src` contains `needle`.
pub fun assert_emits(str src, str needle, str label) {
  let out = emit_c(src, label);
  assert contains(out, needle), format("{str}: expected C to contain `{str}`", label, needle);
}

// Asserts the emitted C for `src` does not contain `needle`.
pub fun assert_not_emits(str src, str needle, str label) {
  let out = emit_c(src, label);
  assert !contains(out, needle), format("{str}: expected C not to contain `{str}`", label, needle);
}

// Resolves `path`'s import graph and transpiles the merged program.
pub fun transpile_file(str path) Result<str, str> {
  let parsed = parse_program_with_imports(path);
  if parsed.is_err() {
    ret .Err(parsed.unwrap_err());
  }
  let merged = parsed.unwrap();

  CodegenState st = codegen_state_new();
  Codegen cg = codegen_new(&st);
  let cc_name2 = env_or("FUN_CC", "");
  cg.msvc_mode = equals(cc_name2, "cl") || equals(cc_name2, "cl.exe") ||
    (equals(cc_name2, "") && runtime_backend_is_windows());
  cg.import_aliases = merged.aliases;
  cg.alias_rename_keys = merged.alias_rename_keys;
  cg.alias_rename_targets = merged.alias_rename_targets;
  if cg.transpile(merged.nodes).is_some() {
    ret .Err("codegen error");
  }
  ret .Ok(st.out.build());
}

// Transpiles the entry file at `path`, aborting with `label` when any
// stage rejects it.
pub fun emit_file(str path, str label) str {
  let r = transpile_file(path);
  if r.is_err() {
    allow assert_constant, "reports the stage that rejected the file";
    assert false, format("{str}: {str}", label, r.unwrap_err());
  }
  ret r.unwrap();
}

// Transpiles `src` with its imports resolved, by staging it as a real
// file next to the other fixtures. `name` must be unique across tests,
// since the file is removed again once the C is in hand.
pub fun emit_c_with_imports(str src, str name, str label) str {
  StringBuilder pb = string_builder_init(32);
  pb.append("src/tests/fixtures/");
  pb.append(name);
  pb.append(".fn");
  str path = pb.build();

  assert write_string(path, src), format("{str}: could not stage {str}", label, path);
  let r = transpile_file(path);
  remove_file(path);
  if r.is_err() {
    allow assert_constant, "reports the stage that rejected the staged source";
    assert false, format("{str}: {str}", label, r.unwrap_err());
  }
  ret r.unwrap();
}

// Compiles `src` all the way to a binary, runs it, and returns what it
// wrote to stdout. Some expectations are only about what a program does
// once it runs: a log file it writes, a watchdog that aborts it, a
// directory it walks. Those cannot be read off the emitted C.
// 
// The C compiler is asked for by name rather than assumed, so the same
// helper works wherever the toolchain is built.
pub fun run_source(str src, str name, str label) str {
  ret run_source_result(src, name, label).stdout_text;
}

// The same, handing back everything the run produced: what it wrote to
// either stream and how it ended. Some expectations are about a program
// being stopped rather than about what it printed.
pub fun run_source_result(str src, str name, str label) ProcessResult {
  StringBuilder sb = string_builder_init(64);
  sb.append("src/tests/fixtures/");
  sb.append(name);
  str base = sb.build();

  StringBuilder fb = string_builder_init(64);
  fb.append(base);
  fb.append(".fn");
  str source_path = fb.build();

  StringBuilder cb = string_builder_init(64);
  cb.append(base);
  cb.append(".c");
  str c_path = cb.build();

  assert write_string(source_path, src), format("{str}: could not stage {str}", label, source_path);
  defer remove_file(source_path);

  let emitted = transpile_file(source_path);
  if emitted.is_err() {
    allow assert_constant, "reports the stage that rejected the staged source";
    assert false, format("{str}: {str}", label, emitted.unwrap_err());
  }
  assert write_string(c_path, emitted.unwrap()), format(
    "{str}: could not write {str}",
    label,
    c_path
  );
  defer remove_file(c_path);

  Vec<str> build;
  build.init(8);
  defer build.free();
  str cc = env_or("FUN_CC", "");
  if equals(cc, "") {
    if runtime_backend_is_windows() {
      cc = "cl";
    } else {
      cc = "cc";
    }
  }
  bin is_msvc = equals(cc, "cl") || equals(cc, "cl.exe");
  build.push(cc);
  str cc_extra = env_or("FUN_CC_ARGS", "");
  if !equals(cc_extra, "") {
    Vec<str> cc_parts = split(cc_extra, ' ');
    defer cc_parts.free();
    num ci = 0;
    for ci < cc_parts.len {
      str part = cc_parts.get(ci);
      if !equals(part, "") {
        build.push(part);
      }
      ci = ci + 1;
    }
  }
  if is_msvc {
    build.push("/nologo");
    build.push("/std:c17");
    build.push("/Od");
    build.push(format("/Fe:{str}.exe", base));
    build.push(c_path);
  } else {
    build.push("-O0");
    build.push("-pthread");
    build.push("-lm");
    if runtime_backend_is_windows() {
      build.push("-lws2_32");
    }
    build.push("-o");
    // zig cc (and clang) on Windows do not auto-append .exe when the -o
    // path has no extension, so supply it explicitly here so the exe_path
    // lookup below finds the file.
    if runtime_backend_is_windows() {
      build.push(format("{str}.exe", base));
    } else {
      build.push(base);
    }
    build.push(c_path);
  }
  let built = run(argv_from(&build));
  assert built.is_ok(), format("{str}: could not run the C compiler", label);
  assert built.unwrap().exit_code == 0, format(
    "{str}: the C compiler rejected the program: {str}",
    label,
    built.unwrap().stderr_text
  );

  // On Windows, zig cc appends .exe; posix_spawnp also needs backslashes.
  str exe_path = base;
  if runtime_backend_is_windows() {
    exe_path = replace_char(format("{str}.exe", base), '/', '\\');
  }
  defer remove_file(exe_path);

  Vec<str> invocation;
  invocation.init(2);
  defer invocation.free();
  invocation.push(exe_path);
  let ran = run(argv_from(&invocation));
  assert ran.is_ok(), format("{str}: could not run the built program", label);
  ProcessResult result = ran.unwrap();
  // MSVC's CRT runs in text mode by default, which converts \n to \r\n
  // when the child's stdout is a pipe. Normalize here so test assertions
  // that compare exact output can use plain \n on all platforms.
  if runtime_backend_is_windows() {
    result.stdout_text = replace_str(result.stdout_text, "\r\n", "\n");
    result.stderr_text = replace_str(result.stderr_text, "\r\n", "\n");
  }
  ret result;
}
