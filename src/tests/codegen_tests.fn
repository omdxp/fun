// Compiler test corpus, stated as source text and checked against the
// emitted C. Ported from the `tests/` suite so the same expectations run
// against this compiler.

imp harness;
imp std.string;

test "if/elif/else transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num x = 1;
  `  if x == 1 { printf("a\n"); }
  `  elif x == 2 { printf("b\n"); }
  `  else { printf("c\n"); }
  `}`;
  let out = emit_c(src, "if/elif/else transpiles");
  assert contains(out, "x == 1"), "expected the leading if condition";
  assert contains(out, "else if"), "expected the elif to lower to else if";
  assert contains(out, "else {"), "expected a trailing else block";
}

test "while-style for loop transpiles to a C for" {
  str src = `fun main() num {
  `  num i = 0;
  `  for i < 3 {
  `    i = i + 1;
  `  }
  `  ret i;
  `}`;
  let out = emit_c(src, "while-style for loop transpiles to a C for");
  assert contains(out, "for ("), "expected a C for loop";
  assert contains(out, "i < 3"), "expected the loop condition";
}

test "range for loop emits an indexed C for" {
  str src = `imp std.c.io;
  `fun main() {
  `  for i : 0..3 {
  `    printf("%d\n", i);
  `  }
  `}`;
  let out = emit_c(src, "range for loop emits an indexed C for");
  assert contains(out, "int64_t i = 0"), "expected the induction variable";
  assert contains(out, "i < 3"), "expected the range bound";
}

test "compound declaration emits a C struct typedef" {
  str src = `compound Point {
  `  num x;
  `  num y;
  `}
  `fun main() num {
  `  Point p;
  `  p.x = 1;
  `  ret p.x;
  `}`;
  let out = emit_c(src, "compound declaration emits a C struct typedef");
  assert contains(out, "typedef struct"), "expected a struct typedef";
  assert contains(out, "p.x = 1"), "expected field assignment";
}

test "plain enum emits C enum constants" {
  str src = `enum Color {
  `  Red,
  `  Green,
  `  Blue
  `}
  `fun main() num {
  `  Color c = Color.Green;
  `  ret 0;
  `}`;
  let out = emit_c(src, "plain enum emits C enum constants");
  assert contains(out, "Color_Red"), "expected a prefixed variant constant";
  assert contains(out, "Color_Green"), "expected the referenced variant";
}

test "function parameters and return type lower to C types" {
  str src = `fun add(num a, num b) num {
  `  ret a + b;
  `}
  `fun main() num {
  `  ret add(1, 2);
  `}`;
  let out = emit_c(src, "function parameters and return type lower to C types");
  assert contains(out, "int64_t add(int64_t a, int64_t b)"), "expected the C signature";
  assert contains(out, "return (a + b)"), "expected the returned expression";
}

test "string and char literals keep their C spelling" {
  str src = `fun main() num {
  `  str s = "hi";
  `  chr c = 'x';
  `  ret 0;
  `}`;
  let out = emit_c(src, "string and char literals keep their C spelling");
  assert contains(out, "char* s = \"hi\""), "expected a C string literal";
  assert contains(out, "char c = 'x'"), "expected a C char literal";
}

test "pointer parameters and address-of emit C pointer syntax" {
  str src = `fun bump(num* p) {
  `  *p = *p + 1;
  `}
  `fun main() num {
  `  num v = 1;
  `  bump(&v);
  `  ret v;
  `}`;
  let out = emit_c(src, "pointer parameters and address-of emit C pointer syntax");
  assert contains(out, "int64_t* p"), "expected a pointer parameter";
  assert contains(out, "&v"), "expected an address-of argument";
}

test "defer emits the deferred call at fall-through" {
  str src = `imp std.c.io;
  `fun main() num {
  `  defer printf("bye\n");
  `  printf("hi\n");
  `  ret 0;
  `}`;
  let out = emit_c(src, "defer emits the deferred call at fall-through");
  assert contains(out, "printf(\"bye"), "expected the deferred call to be emitted";
}

test "impl method emits a mangled C function taking self" {
  str src = `compound Counter {
  `  num n;
  `}
  `impl Counter {
  `  pub bump() {
  `    self.n = self.n + 1;
  `  }
  `}
  `fun main() num {
  `  Counter c;
  `  c.n = 0;
  `  c.bump();
  `  ret c.n;
  `}`;
  let out = emit_c(src, "impl method emits a mangled C function taking self");
  assert contains(out, "Counter__bump"), "expected the mangled method name";
  assert contains(out, "Counter* self"), "expected the implicit self parameter";
}

test "tagged-union enum emits a tag plus payload union" {
  str src = `enum Shape {
  `  Circle(num),
  `  Empty
  `}
  `fun main() num {
  `  Shape s = Shape.Circle(3);
  `  ret 0;
  `}`;
  let out = emit_c(src, "tagged-union enum emits a tag plus payload union");
  assert contains(out, "union"), "expected a payload union";
  assert contains(out, "Shape_Circle"), "expected the variant tag";
}

test "fit over a plain enum lowers to a switch" {
  str src = `enum Color {
  `  Red,
  `  Green
  `}
  `fun main() num {
  `  Color c = Color.Red;
  `  fit c {
  `    .Red -> { ret 1; }
  `    .Green -> { ret 2; }
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(src, "fit over a plain enum lowers to a switch");
  assert contains(out, "Color_Red"), "expected a comparison against the first variant";
  assert contains(out, "Color_Green"), "expected a comparison against the second variant";
}

test "generic compound monomorphizes per concrete instantiation" {
  str src = `compound Box<T> {
  `  T value;
  `}
  `fun main() num {
  `  Box<num> b;
  `  b.value = 7;
  `  ret b.value;
  `}`;
  let out = emit_c(src, "generic compound monomorphizes per concrete instantiation");
  assert contains(out, "Box__num"), "expected the mangled instantiation";
  assert !contains(out, "T value;"), "expected no unsubstituted type param";
}

test "generic function monomorphizes from its call site" {
  str src = `fun identity<T>(T x) T {
  `  ret x;
  `}
  `fun main() num {
  `  ret identity(7);
  `}`;
  let out = emit_c(src, "generic function monomorphizes from its call site");
  assert contains(out, "identity__num"), "expected the mangled instantiation";
}

test "unary operators emit their C spelling" {
  str src = `fun main() num {
  `  num a = 5;
  `  num b = -a;
  `  num c = ~a;
  `  ret b + c;
  `}`;
  let out = emit_c(src, "unary operators emit their C spelling");
  assert contains(out, "-a"), "expected negation";
  assert contains(out, "~a"), "expected bitwise not";
}

test "bitwise and shift operators stay parenthesized" {
  str src = `fun main() num {
  `  num a = 6;
  `  num b = 3;
  `  num c = a & b;
  `  num e = a << 1;
  `  ret c + e;
  `}`;
  let out = emit_c(src, "bitwise and shift operators stay parenthesized");
  assert contains(out, "(a & b)"), "expected a parenthesized bitwise and";
  assert contains(out, "(a << 1)"), "expected a parenthesized shift";
}

test "array literal and indexing emit a C array" {
  str src = `fun main() num {
  `  num[] xs = [1, 2, 3];
  `  ret xs[1];
  `}`;
  let out = emit_c(src, "array literal and indexing emit a C array");
  assert contains(out, "{1, 2, 3}"), "expected a C brace-list initializer";
  assert contains(out, "xs[1]"), "expected an index expression";
}

test "nested compound field access chains through the C struct" {
  str src = `compound Inner {
  `  num v;
  `}
  `compound Outer {
  `  Inner inner;
  `}
  `fun main() num {
  `  Outer o;
  `  o.inner.v = 3;
  `  ret o.inner.v;
  `}`;
  let out = emit_c(src, "nested compound field access chains through the C struct");
  assert contains(out, "o.inner.v = 3"), "expected a chained field assignment";
}

test "main always emits an int return type" {
  str src = `fun main() {
  `  num x = 1;
  `}`;
  let out = emit_c(src, "main always emits an int return type");
  assert contains(out, "int main("), "expected main to be declared int";
}

test "debug info off emits no #line directives at all" {
  str src = `fun main() num {
  `  num x = 1;
  `  ret x;
  `}`;
  let out = emit_c(src, "debug info off emits no #line directives at all");
  assert !contains(out, "#line"), "expected no #line directive without -g";
}

test "debug info on anchors each statement back to its own source line" {
  // User-reported: breakpoints and step-by-step debugging did nothing in
  // the self-hosted compiler, unlike the original Zig one. The Zig
  // transpiler emitted a `#line N "file"` directive before each C
  // statement so a native debugger's DWARF info points at the real .fn
  // source; codegen.fn never had any such mechanism, so -g compiled fine
  // but produced a binary with no source mapping for the debugger to
  // follow at all.
  str src = `fun main() num {
  `  num x = 1;
  `  num y = 2;
  `  ret x + y;
  `}`;
  let out = emit_c_with_debug_info(src, "debug info on anchors each statement back to its own source line");
  assert contains(out, `#line 2 "test.fn"`), "expected line 2's own directive before x's declaration";
  assert contains(out, `#line 3 "test.fn"`), "expected line 3's own directive before y's declaration";
  assert contains(out, `#line 4 "test.fn"`), "expected line 4's own directive before the ret";
}

test "debug info on anchors an if statement's own header line too" {
  // StatementIf/ElseIf/Else are chained together by emit_if_chain,
  // reached from emit_statements directly rather than through
  // emit_statement (the general per-statement hook) - a separate case
  // that needed its own explicit directive.
  str src = `fun main() num {
  `  num x = 1;
  `  if x == 1 {
  `    ret 1;
  `  }
  `  ret 0;
  `}`;
  let out = emit_c_with_debug_info(src, "debug info on anchors an if statement's own header line too");
  assert contains(out, `#line 3 "test.fn"`), "expected the if statement's own line";
  assert contains(out, `#line 4 "test.fn"`), "expected the ret inside its body";
}

test "debug info pins every line of an async function's synthesized trampoline back to its own declaration" {
  // The original Zig transpiler's own emit_async_function_support
  // equivalent re-pinned every hand-written C line of an async
  // function's entry/spawn/await trampoline back to the function's own
  // declaration line, rather than let the C preprocessor's line count
  // drift forward into unrelated source (blank lines, the next
  // declaration) as each line advances past the last #line directive.
  // codegen.fn's own port of the general per-statement mechanism didn't
  // reach this code at all, since it hand-writes many C lines per
  // self.state.write call rather than going through write_indent once
  // per statement - a real, separate gap from the ordinary-statement
  // case, closed by write_line_pinned re-anchoring every line inside a
  // multi-line write back to one fixed position.
  str src = `imp std.task;
  `async fun worker(WaitGroup* wg) {
  `  wg.done();
  `}`;
  let out = emit_c_with_debug_info(src, "debug info pins every line of an async function's synthesized trampoline back to its own declaration");
  assert contains(out, "__fun_async_entry_worker"), "expected the entry trampoline to be emitted";
  // Every line from the payload struct through the await helper - not
  // just the ordinary function body - should carry line 2 (worker's own
  // declaration), not drift onto whatever line comes after it.
  num entry_at = index_of_str(out, "__fun_async_entry_worker(void* __arg)");
  assert entry_at >= 0, "expected the entry trampoline's own definition";
  num after_entry = index_of_str(substr(out, entry_at, len(out) - entry_at), "return NULL;");
  assert after_entry >= 0, "expected the entry trampoline's own body";
  str entry_body = substr(out, entry_at, after_entry);
  assert !contains(entry_body, `#line 3`), "expected no line inside the trampoline to drift past worker's own declaration line";
  assert contains(out, `#line 2 "test.fn"`), "expected the trampoline's own lines pinned to worker's declaration";
}
