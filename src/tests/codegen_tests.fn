// Compiler test corpus, stated as source text and checked against the
// emitted C. Ported from the `tests/` suite so the same expectations run
// against this compiler.

use harness;
use std.string;

test "if/elif/else transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num x = 1;
  `  if x == 1 { printf("a\n"); }
  `  elif x == 2 { printf("b\n"); }
  `  else { printf("c\n"); }
  `}`;
  let out = emit_c(src, "if/elif/else transpiles");
  assert contains(out, "x == 1"), "expected the leading if condition";
  assert contains(out, "else if"), "expected the elif to lower to else if";
  assert contains(out, "else {"), "expected a trailing else block";
}

test "while-style for loop transpiles to a C for" {
  str src = `fun main() num {
  `  num i = 0;
  `  for i < 3 {
  `    i = i + 1;
  `  }
  `  ret i;
  `}`;
  let out = emit_c(src, "while-style for loop transpiles to a C for");
  assert contains(out, "for ("), "expected a C for loop";
  assert contains(out, "i < 3"), "expected the loop condition";
}

test "range for loop emits an indexed C for" {
  str src = `imp std.c.io;
  `fun main() {
  `  for i : 0..3 {
  `    printf("%d\n", i);
  `  }
  `}`;
  let out = emit_c(src, "range for loop emits an indexed C for");
  assert contains(out, "int64_t i = 0"), "expected the induction variable";
  assert contains(out, "i < 3"), "expected the range bound";
}

test "compound declaration emits a C struct typedef" {
  str src = `compound Point {
  `  num x;
  `  num y;
  `}
  `fun main() num {
  `  Point p;
  `  p.x = 1;
  `  ret p.x;
  `}`;
  let out = emit_c(src, "compound declaration emits a C struct typedef");
  assert contains(out, "typedef struct"), "expected a struct typedef";
  assert contains(out, "p.x = 1"), "expected field assignment";
}

test "plain enum emits C enum constants" {
  str src = `enum Color {
  `  Red,
  `  Green,
  `  Blue
  `}
  `fun main() num {
  `  Color c = Color.Green;
  `  ret 0;
  `}`;
  let out = emit_c(src, "plain enum emits C enum constants");
  assert contains(out, "Color_Red"), "expected a prefixed variant constant";
  assert contains(out, "Color_Green"), "expected the referenced variant";
}

test "function parameters and return type lower to C types" {
  str src = `fun add(num a, num b) num {
  `  ret a + b;
  `}
  `fun main() num {
  `  ret add(1, 2);
  `}`;
  let out = emit_c(src, "function parameters and return type lower to C types");
  assert contains(out, "int64_t add(int64_t a, int64_t b)"), "expected the C signature";
  assert contains(out, "return (a + b)"), "expected the returned expression";
}

test "string and char literals keep their C spelling" {
  str src = `fun main() num {
  `  str s = "hi";
  `  chr c = 'x';
  `  ret 0;
  `}`;
  let out = emit_c(src, "string and char literals keep their C spelling");
  assert contains(out, "char* s = \"hi\""), "expected a C string literal";
  assert contains(out, "char c = 'x'"), "expected a C char literal";
}

test "pointer parameters and address-of emit C pointer syntax" {
  str src = `fun bump(num* p) {
  `  *p = *p + 1;
  `}
  `fun main() num {
  `  num v = 1;
  `  bump(&v);
  `  ret v;
  `}`;
  let out = emit_c(src, "pointer parameters and address-of emit C pointer syntax");
  assert contains(out, "int64_t* p"), "expected a pointer parameter";
  assert contains(out, "&v"), "expected an address-of argument";
}

test "defer emits the deferred call at fall-through" {
  str src = `imp std.c.io;
  `fun main() num {
  `  defer printf("bye\n");
  `  printf("hi\n");
  `  ret 0;
  `}`;
  let out = emit_c(src, "defer emits the deferred call at fall-through");
  assert contains(out, "printf(\"bye"), "expected the deferred call to be emitted";
}

test "impl method emits a mangled C function taking self" {
  str src = `compound Counter {
  `  num n;
  `}
  `impl Counter {
  `  pub bump() {
  `    self.n = self.n + 1;
  `  }
  `}
  `fun main() num {
  `  Counter c;
  `  c.n = 0;
  `  c.bump();
  `  ret c.n;
  `}`;
  let out = emit_c(src, "impl method emits a mangled C function taking self");
  assert contains(out, "Counter__bump"), "expected the mangled method name";
  assert contains(out, "Counter* self"), "expected the implicit self parameter";
}

test "tagged-union enum emits a tag plus payload union" {
  str src = `enum Shape {
  `  Circle(num),
  `  Empty
  `}
  `fun main() num {
  `  Shape s = Shape.Circle(3);
  `  ret 0;
  `}`;
  let out = emit_c(src, "tagged-union enum emits a tag plus payload union");
  assert contains(out, "union"), "expected a payload union";
  assert contains(out, "Shape_Circle"), "expected the variant tag";
}

test "fit over a plain enum lowers to a switch" {
  str src = `enum Color {
  `  Red,
  `  Green
  `}
  `fun main() num {
  `  Color c = Color.Red;
  `  fit c {
  `    .Red -> { ret 1; }
  `    .Green -> { ret 2; }
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(src, "fit over a plain enum lowers to a switch");
  assert contains(out, "Color_Red"), "expected a comparison against the first variant";
  assert contains(out, "Color_Green"), "expected a comparison against the second variant";
}

test "generic compound monomorphizes per concrete instantiation" {
  str src = `compound Box<T> {
  `  T value;
  `}
  `fun main() num {
  `  Box<num> b;
  `  b.value = 7;
  `  ret b.value;
  `}`;
  let out = emit_c(src, "generic compound monomorphizes per concrete instantiation");
  assert contains(out, "Box__num"), "expected the mangled instantiation";
  assert !contains(out, "T value;"), "expected no unsubstituted type param";
}

test "generic function monomorphizes from its call site" {
  str src = `fun identity<T>(T x) T {
  `  ret x;
  `}
  `fun main() num {
  `  ret identity(7);
  `}`;
  let out = emit_c(src, "generic function monomorphizes from its call site");
  assert contains(out, "identity__num"), "expected the mangled instantiation";
}

test "unary operators emit their C spelling" {
  str src = `fun main() num {
  `  num a = 5;
  `  num b = -a;
  `  num c = ~a;
  `  ret b + c;
  `}`;
  let out = emit_c(src, "unary operators emit their C spelling");
  assert contains(out, "-a"), "expected negation";
  assert contains(out, "~a"), "expected bitwise not";
}

test "bitwise and shift operators stay parenthesized" {
  str src = `fun main() num {
  `  num a = 6;
  `  num b = 3;
  `  num c = a & b;
  `  num e = a << 1;
  `  ret c + e;
  `}`;
  let out = emit_c(src, "bitwise and shift operators stay parenthesized");
  assert contains(out, "(a & b)"), "expected a parenthesized bitwise and";
  assert contains(out, "(a << 1)"), "expected a parenthesized shift";
}

test "array literal and indexing emit a C array" {
  str src = `fun main() num {
  `  num[] xs = [1, 2, 3];
  `  ret xs[1];
  `}`;
  let out = emit_c(src, "array literal and indexing emit a C array");
  assert contains(out, "{1, 2, 3}"), "expected a C brace-list initializer";
  assert contains(out, "xs[1]"), "expected an index expression";
}

test "nested compound field access chains through the C struct" {
  str src = `compound Inner {
  `  num v;
  `}
  `compound Outer {
  `  Inner inner;
  `}
  `fun main() num {
  `  Outer o;
  `  o.inner.v = 3;
  `  ret o.inner.v;
  `}`;
  let out = emit_c(src, "nested compound field access chains through the C struct");
  assert contains(out, "o.inner.v = 3"), "expected a chained field assignment";
}

test "main always emits an int return type" {
  str src = `fun main() {
  `  num x = 1;
  `}`;
  let out = emit_c(src, "main always emits an int return type");
  assert contains(out, "int main("), "expected main to be declared int";
}

test "debug info off emits no #line directives at all" {
  str src = `fun main() num {
  `  num x = 1;
  `  ret x;
  `}`;
  let out = emit_c(src, "debug info off emits no #line directives at all");
  assert !contains(out, "#line"), "expected no #line directive without -g";
}

test "debug info on anchors each statement back to its own source line" {
  // User-reported: breakpoints and step-by-step debugging did nothing in
  // the self-hosted compiler, unlike the original Zig one. The Zig
  // transpiler emitted a `#line N "file"` directive before each C
  // statement so a native debugger's DWARF info points at the real .fn
  // source; codegen.fn never had any such mechanism, so -g compiled fine
  // but produced a binary with no source mapping for the debugger to
  // follow at all.
  str src = `fun main() num {
  `  num x = 1;
  `  num y = 2;
  `  ret x + y;
  `}`;
  let out = emit_c_with_debug_info(src, "debug info on anchors each statement back to its own source line");
  assert contains(out, `#line 2 "test.fn"`), "expected line 2's own directive before x's declaration";
  assert contains(out, `#line 3 "test.fn"`), "expected line 3's own directive before y's declaration";
  assert contains(out, `#line 4 "test.fn"`), "expected line 4's own directive before the ret";
}

test "debug info on anchors an if statement's own header line too" {
  // StatementIf/ElseIf/Else are chained together by emit_if_chain,
  // reached from emit_statements directly rather than through
  // emit_statement (the general per-statement hook) - a separate case
  // that needed its own explicit directive.
  str src = `fun main() num {
  `  num x = 1;
  `  if x == 1 {
  `    ret 1;
  `  }
  `  ret 0;
  `}`;
  let out = emit_c_with_debug_info(src, "debug info on anchors an if statement's own header line too");
  assert contains(out, `#line 3 "test.fn"`), "expected the if statement's own line";
  assert contains(out, `#line 4 "test.fn"`), "expected the ret inside its body";
}

test "debug info pins every line of an async function's synthesized trampoline back to its own declaration" {
  // The original Zig transpiler's own emit_async_function_support
  // equivalent re-pinned every hand-written C line of an async
  // function's entry/spawn/await trampoline back to the function's own
  // declaration line, rather than let the C preprocessor's line count
  // drift forward into unrelated source (blank lines, the next
  // declaration) as each line advances past the last #line directive.
  // codegen.fn's own port of the general per-statement mechanism didn't
  // reach this code at all, since it hand-writes many C lines per
  // self.state.write call rather than going through write_indent once
  // per statement - a real, separate gap from the ordinary-statement
  // case, closed by write_line_pinned re-anchoring every line inside a
  // multi-line write back to one fixed position.
  str src = `imp std.task;
  `async fun worker(WaitGroup* wg) {
  `  wg.done();
  `}`;
  let out = emit_c_with_debug_info(src, "debug info pins every line of an async function's synthesized trampoline back to its own declaration");
  assert contains(out, "__fun_async_entry_worker"), "expected the entry trampoline to be emitted";
  // Every line from the payload struct through the await helper - not
  // just the ordinary function body - should carry line 2 (worker's own
  // declaration), not drift onto whatever line comes after it.
  num entry_at = index_of_str(out, "__fun_async_entry_worker(void* __arg)");
  assert entry_at >= 0, "expected the entry trampoline's own definition";
  num after_entry = index_of_str(substr(out, entry_at, len(out) - entry_at), "return NULL;");
  assert after_entry >= 0, "expected the entry trampoline's own body";
  str entry_body = substr(out, entry_at, after_entry);
  assert !contains(entry_body, `#line 3`), "expected no line inside the trampoline to drift past worker's own declaration line";
  assert contains(out, `#line 2 "test.fn"`), "expected the trampoline's own lines pinned to worker's declaration";
}

test "'use'/'flag' compile and run end to end, as real alternate spellings of 'imp'/'bin'" {
  str src = `use std.c.io;
  `
  `fun main() num {
  `  flag ok = true;
  `  if ok {
  `    printf("ok\n");
  `  }
  `  ret 0;
  `}`;
  str out = run_source(src, "use_flag_alt_spellings", "'use'/'flag' end to end");
  assert equals(out, "ok\n"), "expected 'use'/'flag' to compile and run identically to 'imp'/'bin'";
}

test "a tuple literal constructs and positional access reads each element back" {
  str src = `use std.c.io;
  `fun main() num {
  `  (num, str) t = (1, "hi");
  `  printf("%lld %s\n", t.0, t.1);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_construct_and_positional_access", "tuple literal + positional access end to end");
  assert equals(out, "1 hi\n"), "expected the tuple's own elements read back positionally";
}

test "let destructuring binds each name to its own element's real value" {
  str src = `use std.c.io;
  `fun main() num {
  `  let (a, b, c) = (1, 2, 3);
  `  printf("%lld\n", a + b + c);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_let_destructure_values", "let destructuring end to end");
  assert equals(out, "6\n"), "expected each destructured name bound to its own element";
}

test "let destructuring evaluates its initializer exactly once" {
  str src = `use std.c.io;
  `num calls = 0;
  `fun make_pair() (num, num) {
  `  calls = calls + 1;
  `  ret (10, 20);
  `}
  `fun main() num {
  `  let (a, b) = make_pair();
  `  printf("%lld %lld %lld\n", a, b, calls);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_destructure_evaluates_once", "let destructuring evaluate-once correctness");
  assert equals(out, "10 20 1\n"), "expected the initializer call counted exactly once, not once per destructured name";
}

test "a function returning a tuple works end to end" {
  str src = `use std.c.io;
  `fun pair() (num, str) {
  `  ret (7, "seven");
  `}
  `fun main() num {
  `  let (n, s) = pair();
  `  printf("%lld %s\n", n, s);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_function_return", "tuple-returning function end to end");
  assert equals(out, "7 seven\n"), "expected the returned tuple's own elements to destructure correctly";
}

test "a tuple works as an ordinary generic argument end to end" {
  str src = `use std.c.io;
  `compound Box<T> { T v; }
  `fun main() num {
  `  Box<(num, str)> b = Box<(num, str)>{v = (1, "hi")};
  `  printf("%lld %s\n", b.v.0, b.v.1);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_generic_argument", "tuple as a generic argument end to end");
  assert equals(out, "1 hi\n"), "expected a tuple to plug into an existing generic compound like any other type";
}

test "a generic alias bound to a tuple works end to end, the original motivating case" {
  str src = `use std.c.io;
  `als Args = (num, str);
  `als Callback<A, R> = fun(A) R;
  `fun describe(Args a) str { ret a.1; }
  `fun apply(Callback<Args, str> cb, Args a) str { ret cb(a); }
  `fun main() num {
  `  printf("%s\n", apply(describe, (1, "hi")));
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_generic_alias_callback", "tuple-bodied generic alias end to end");
  assert equals(out, "hi\n"), "expected the tuple-bodied alias to expand and run exactly like a hand-written tuple type";
}

test "a numeric element widens against its declared tuple position, not the literal's own bare structural type" {
  str src = `use std.c.io;
  `fun pair() (dec, str) {
  `  ret (1, "hi");
  `}
  `fun show((dec, str) p) {
  `  printf("%f %s\n", p.0, p.1);
  `}
  `fun main() num {
  `  (dec, str) t = (1, "hi");
  `  printf("%f %s\n", t.0, t.1);
  `  let (a, b) = pair();
  `  printf("%f %s\n", a, b);
  `  show((2, "yo"));
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_numeric_widening", "a num literal widens into a declared dec tuple position end to end");
  assert equals(out, "1.000000 hi\n1.000000 hi\n2.000000 yo\n"), "expected every declared-dec tuple position to widen the literal, not mismatch the structurally-inferred num struct";
}

test "let destructuring compiles under MSVC's strict, non-GNU C, with no '__auto_type'" {
  str src = `use std.c.io;
  `fun min_max(num a, num b) (num, num) {
  `  if a < b {
  `    ret (a, b);
  `  }
  `  ret (b, a);
  `}
  `fun main() num {
  `  let (low, high) = min_max(9, 3);
  `  printf("%lld %lld\n", low, high);
  `  ret 0;
  `}`;
  // `__auto_type` is a GNU extension MSVC rejects outright; `emit_let_destructure`
  // must resolve a real declared/inferred C type for both its own hoisted
  // temp and each destructured name under `msvc_mode`, the same fallback
  // every other `__auto_type` site in codegen already has.
  str out_c = emit_c_with_imports_forcing_msvc(src, "tuple_destructure_msvc_shape", "let destructuring under MSVC emits no '__auto_type'");
  assert !contains(out_c, "__auto_type"), "expected a real resolved C type, not GNU's '__auto_type', under msvc_mode";
  str out_msvc = run_source_forcing_msvc(
    src,
    "tuple_destructure_msvc_strict",
    "let destructuring compiles and runs under a real strict (non-GNU) compile"
  );
  // `starts_with`, not an exact `equals` against a trailing '\n': every
  // other `run_source_forcing_msvc` test in this file already relaxes
  // this same way (a real Windows output-capture quirk around the final
  // byte under the strict/MSVC path, unrelated to the actual computed
  // values - confirmed directly against real Windows CI: the destructured
  // values themselves came back exactly right, "3 9", only the trailing
  // newline byte was ever in question). Still strictly stronger than a
  // bare `contains`: this also catches wrong values or garbage preceding
  // them, not just garbage after.
  assert starts_with(out_msvc, "3 9"), format(
    "expected the destructured values to actually run correctly under the strict MSVC-shaped compile, got {str}",
    out_msvc
  );
}

test "let destructuring from a tuple-returning function compiles under MSVC's strict, non-GNU C" {
  str src = `use std.c.io;
  `fun pair() (num, str) {
  `  ret (7, "seven");
  `}
  `fun main() num {
  `  let (n, s) = pair();
  `  printf("%lld %s\n", n, s);
  `  ret 0;
  `}`;
  str out_msvc = run_source_forcing_msvc(
    src,
    "tuple_fn_return_destructure_msvc_strict",
    "destructuring a tuple-returning function's call result under a real strict (non-GNU) compile"
  );
  assert starts_with(out_msvc, "7 seven"), format(
    "expected the call-returned tuple to destructure and run correctly under the strict MSVC-shaped compile, got {str}",
    out_msvc
  );
}

test "a declared-type destructuring pattern binds each name to its own declared element type end to end" {
  str src = `use std.c.io;
  `fun main() num {
  `  (dec, str) (a, b) = (1, "hi");
  `  printf("%f %s\n", a, b);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_declared_destructure_widening", "a declared-type destructuring pattern widens a num literal into its own dec position");
  assert equals(out, "1.000000 hi\n"), "expected the declared dec position to widen the num literal, exactly like an ordinary declared dec variable";
}

test "a declared-type destructuring pattern's own initializer is evaluated exactly once" {
  str src = `use std.c.io;
  `num calls = 0;
  `fun make_pair() (num, num) {
  `  calls = calls + 1;
  `  ret (10, 20);
  `}
  `fun main() num {
  `  (num, num) (a, b) = make_pair();
  `  printf("%lld %lld %lld\n", a, b, calls);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_declared_destructure_once", "a declared-type destructuring pattern evaluates its initializer exactly once");
  assert equals(out, "10 20 1\n"), "expected the initializer call counted exactly once, matching the inferred form's own evaluate-once guarantee";
}

test "a destructured name naming a compound resolves a later field access on it, both forms" {
  // Real bug: `emit_let_destructure` emitted a correctly-typed C local
  // for each destructured name but never registered any of them with
  // codegen's own known-locals table (`record_local_typed`, what the
  // ordinary non-destructure `.Variable` case already calls) - a later
  // field access on a destructured compound-typed name (`pt.x`) failed
  // with "unknown identifier 'pt'" even though the emitted C was
  // correct, since codegen's own field-chain resolver had no idea `pt`
  // existed at all.
  str src = `use std.c.io;
  `compound Point { num x; num y; }
  `fun main() num {
  `  let (n, pt) = (5, Point{x = 9, y = 10});
  `  (num, Point) (n2, pt2) = (6, Point{x = 11, y = 12});
  `  printf("%lld %lld %lld %lld %lld %lld\n", n, pt.x, pt.y, n2, pt2.x, pt2.y);
  `  ret 0;
  `}`;
  str out = run_source(src, "tuple_destructure_compound_field_access", "a destructured compound name's own field resolves after it, inferred and declared forms alike");
  assert equals(out, "5 9 10 6 11 12\n"), "expected a field access on either form's destructured compound name to resolve correctly";
}

test "a for loop destructures a Vec of tuples, one name per element" {
  str src = `use std.c.io;
  `use std.vec;
  `fun main() num {
  `  Vec<(num, str)> pairs;
  `  pairs.init(2);
  `  pairs.push((1, "one"));
  `  pairs.push((2, "two"));
  `  for (k, v) : pairs {
  `    printf("%lld=%s ", k, v);
  `  }
  `  ret 0;
  `}`;
  str out = run_source(src, "for_destructure_vec_tuple", "a for loop destructures a Vec<(num, str)> end to end");
  assert equals(out, "1=one 2=two "), "expected each pair's own elements bound to k and v in order";
}

test "a for loop's own destructuring name resolves a later field access on it" {
  // The same class of bug `emit_let_destructure` had: a destructured
  // for-loop item must also register each name with codegen's own
  // known-locals table, not just declare it as a correctly-typed local.
  str src = `use std.c.io;
  `use std.vec;
  `compound Point { num x; num y; }
  `fun main() num {
  `  Vec<(num, Point)> items;
  `  items.init(2);
  `  items.push((1, Point{x = 3, y = 4}));
  `  for (id, pt) : items {
  `    printf("%lld %lld %lld\n", id, pt.x, pt.y);
  `  }
  `  ret 0;
  `}`;
  str out = run_source(src, "for_destructure_field_access", "a for-destructured compound name's own field resolves");
  assert equals(out, "1 3 4\n"), "expected the destructured compound name's own field access to resolve correctly";
}

test "a for loop over a Vec of tuples compiles under MSVC's strict, non-GNU C" {
  str src = `use std.c.io;
  `use std.vec;
  `fun main() num {
  `  Vec<(num, str)> pairs;
  `  pairs.init(1);
  `  pairs.push((7, "seven"));
  `  for (k, v) : pairs {
  `    printf("%lld %s\n", k, v);
  `  }
  `  ret 0;
  `}`;
  str out_c = emit_c_with_imports_forcing_msvc(src, "for_destructure_msvc_shape", "a for-destructured Vec of tuples under MSVC emits no '__auto_type'");
  assert !contains(out_c, "__auto_type"), "expected a real resolved C type, not GNU's '__auto_type', under msvc_mode";
  str out_msvc = run_source_forcing_msvc(
    src,
    "for_destructure_msvc_strict",
    "a for loop over a Vec of tuples compiles and runs under a real strict (non-GNU) compile"
  );
  assert starts_with(out_msvc, "7 seven"), format(
    "expected the destructured for-loop values to actually run correctly under the strict MSVC-shaped compile, got {str}",
    out_msvc
  );
}

test "a declared-type destructuring pattern compiles under MSVC's strict, non-GNU C, with no '__auto_type'" {
  str src = `use std.c.io;
  `fun main() num {
  `  (num, str) (n, s) = (7, "seven");
  `  printf("%lld %s\n", n, s);
  `  ret 0;
  `}`;
  str out_c = emit_c_with_imports_forcing_msvc(src, "tuple_declared_destructure_msvc_shape", "a declared-type destructuring pattern under MSVC emits no '__auto_type'");
  assert !contains(out_c, "__auto_type"), "expected a real resolved C type, not GNU's '__auto_type', under msvc_mode";
  str out_msvc = run_source_forcing_msvc(
    src,
    "tuple_declared_destructure_msvc_strict",
    "a declared-type destructuring pattern compiles and runs under a real strict (non-GNU) compile"
  );
  assert starts_with(out_msvc, "7 seven"), format(
    "expected the declared-type destructured values to actually run correctly under the strict MSVC-shaped compile, got {str}",
    out_msvc
  );
}
