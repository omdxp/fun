// Loop-lowering corpus, ported from the `for` suite. Each test states its
// input as source text and checks the emitted C.

use harness;
use std.string;

test "for range transpiles" {
  // `transpile_source` doesn't resolve imports, so `Range`'s own
  // `Iterator<num>` impl is inlined here rather than imported.
  str src = `use std.c.io;
  `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Range { num start; num end; }
  `impl Range as Iterator<num> {
  `  pub next() Option<num> {
  `    if self.start >= self.end { ret Option.None; }
  `    num v = self.start;
  `    self.start = self.start + 1;
  `    ret Option.Some(v);
  `  }
  `}
  `fun main() {
  `  for i : 0..3 {
  `    printf("%d\n", i);
  `  }
  `}`;
  let out = emit_c(src, "for range transpiles");
  // Desugars into a Range value driven through the general Iterator
  // inlining mechanism, not a hand-written tight C for of its own.
  assert contains(out, "Range"), "expected a real Range value to back the loop";
  assert contains(out, "__fun_iter_local"), "expected Range's own next() to be inlined, not called";
}

test "for array item transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  num[] arr = [1, 2, 3];
  `  for item : arr {
  `    printf("%d\n", item);
  `  }
  `}`;
  let out = emit_c(src, "for array item transpiles");
  assert contains(out, "int64_t arr[] = {1, 2, 3};"), "expected the array declaration";
  assert contains(out, "for (int64_t __fun_i = 0;"), "expected a synthesized index variable";
  assert contains(out, "int64_t item = arr[__fun_i];"), "expected the item binding";
}

test "for array index and item transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  num[] arr = [1, 2, 3];
  `  for i, item :: arr {
  `    printf("arr[%d]=%d\n", i, item);
  `  }
  `}`;
  let out = emit_c(src, "for array index and item transpiles");
  assert contains(out, "for (int64_t i = 0;"), "expected the named index variable";
  assert contains(out, "int64_t item = arr[i];"), "expected the item binding to use it";
}

test "an index-and-item loop body can call a method" {
  // The original asserted nothing, so this states what the shape should
  // actually produce: the loop, and the call inside it.
  str src = `use std.c.io;
  `compound Counter {
  `  num n;
  `}
  `impl Counter {
  `  pub bump() num { ret self.n + 1; }
  `}
  `fun main() num {
  `  Counter[] items = [Counter{n = 1}, Counter{n = 2}];
  `  for i, item :: items {
  `    Counter c = item;
  `    printf("%lld %lld\n", i, c.bump());
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(src, "an index-and-item loop body can call a method");
  assert contains(out, "Counter__bump"), "expected the method to be emitted";
  assert contains(out, "for"), "expected the loop to be emitted";
}

test "for Vec values transpiles via inlining Vec's own next()" {
  // The harness compiles a single source string without resolving
  // imports, so a self-contained stand-in for Vec<T> is declared inline
  // here, mirroring its real `impl Vec<T> as Iterator<T>` in
  // stdlib/std/vec.fn: `emit_for_iter` dispatches on the type name "Vec"
  // structurally, regardless of whether it came from an import.
  str src = `enum Option<T> { Some(T), None }
  `quirk Iterator<T> { next() Option<T>; }
  `compound Vec<T> {
  `  T* data;
  `  num len;
  `  num __iter_pos;
  `}
  `impl Vec<T> as Iterator<T> {
  `  pub next() Option<T> {
  `    if self.__iter_pos >= self.len {
  `      self.__iter_pos = 0;
  `      ret Option.None;
  `    }
  `    T value = self.data[self.__iter_pos];
  `    self.__iter_pos = self.__iter_pos + 1;
  `    ret Option.Some(value);
  `  }
  `}
  `fun main() {
  `  Vec<str> vals;
  `  for val : vals {
  `    num n = 1;
  `  }
  `}`;
  let out = emit_c(src, "for Vec values transpiles via inlining Vec's own next()");
  assert contains(out, "__iter_pos"), "expected the inlined next() body's own cursor field";
  assert contains(out, "for (;;) {"), "expected the unified next()-inlining loop shape, not a direct index fast path";
}

test "for condition transpiles to while" {
  str src = `use std.c.io;
  `fun main() {
  `  num i = 0;
  `  for i < 3 {
  `    printf("%d\n", i);
  `    i = i + 1;
  `  }
  `}`;
  let out = emit_c(src, "for condition transpiles to while");
  assert contains(out, "while ("), "expected a C while loop";
  assert contains(out, "i < 3"), "expected the loop condition";
}

test "for infinite transpiles to while(1)" {
  str src = `use std.c.io;
  `fun main() {
  `  num i = 0;
  `  for {
  `    if i == 3 { break; }
  `    printf("%d\n", i);
  `    i = i + 1;
  `  }
  `}`;
  let out = emit_c(src, "for infinite transpiles to while(1)");
  assert contains(out, "while (1)"), "expected an unconditional loop";
}

test "2D matrix declaration transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  num[][] matrix = [[1, 2, 3], [4, 5, 6]];
  `}`;
  let out = emit_c(src, "2D matrix declaration transpiles");
  assert contains(out, "int64_t matrix[][3]"), "expected an unsized outer and sized inner dimension";
  assert contains(out, "{{1, 2, 3}, {4, 5, 6}}"), "expected the nested brace initializer";
}

test "2D matrix for-iter outer loop transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  num[][] matrix = [[1, 2, 3], [4, 5, 6]];
  `  for row : matrix {
  `    printf("%p\n", row);
  `  }
  `}`;
  let out = emit_c(src, "2D matrix for-iter outer loop transpiles");
  assert contains(out, "sizeof(matrix)/sizeof(matrix[0])"), "expected the outer bound from sizeof";
  assert contains(out, "int64_t * row = matrix[__fun_i]"), "expected the row to bind as a pointer";
}

test "2D matrix nested for-iter transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  num[][] matrix = [[1, 2, 3], [4, 5, 6]];
  `  for row : matrix {
  `    for item : row {
  `      printf("%lld\n", item);
  `    }
  `  }
  `}`;
  let out = emit_c(src, "2D matrix nested for-iter transpiles");
  assert contains(out, "sizeof(matrix)/sizeof(matrix[0])"), "expected the outer bound";
  assert contains(out, "sizeof(matrix[0])/sizeof(matrix[0][0])"), "expected the inner bound";
  assert contains(out, "int64_t item = row[__fun_i]"), "expected the innermost item to bind as a scalar";
}

test "2D matrix let inference transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  let m = [[10, 20], [30, 40]];
  `  for row : m {
  `    for val : row {
  `      printf("%lld\n", val);
  `    }
  `  }
  `}`;
  let out = emit_c(src, "2D matrix let inference transpiles");
  assert contains(out, "int64_t m[][2]"), "expected the inferred matrix type";
  assert contains(out, "sizeof(m)/sizeof(m[0])"), "expected the outer bound";
  assert contains(out, "sizeof(m[0])/sizeof(m[0][0])"), "expected the inner bound";
}

test "3D tensor nested for-iter transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  num[][][] tensor = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
  `  for plane : tensor {
  `    for row : plane {
  `      for item : row {
  `        printf("%lld\n", item);
  `      }
  `    }
  `  }
  `}`;
  let out = emit_c(src, "3D tensor nested for-iter transpiles");
  assert contains(out, "sizeof(tensor)/sizeof(tensor[0])"), "expected the outer bound";
  assert contains(out, "sizeof(tensor[0])/sizeof(tensor[0][0])"), "expected the middle bound";
  assert contains(out, "sizeof(tensor[0][0])/sizeof(tensor[0][0][0])"), "expected the inner bound";
  assert contains(out, "int64_t item = row[__fun_i]"), "expected the innermost item to bind as a scalar";
}

test "3D tensor let inference transpiles" {
  str src = `use std.c.io;
  `fun main() {
  `  let m = [[[10, 20], [30, 40]], [[50, 60], [70, 80]]];
  `  for plane : m {
  `    for row : plane {
  `      for val : row {
  `        printf("%lld\n", val);
  `      }
  `    }
  `  }
  `}`;
  let out = emit_c(src, "3D tensor let inference transpiles");
  assert contains(out, "int64_t m[][2][2]"), "expected the inferred tensor type";
  assert contains(out, "sizeof(m)/sizeof(m[0])"), "expected the outer bound";
  assert contains(out, "sizeof(m[0])/sizeof(m[0][0])"), "expected the middle bound";
  assert contains(out, "sizeof(m[0][0])/sizeof(m[0][0][0])"), "expected the inner bound";
}

test "a for loop over a pointer to a collection iterates the value it points to" {
  str src = `use std.c.io;
  `use std.vec;
  `use std.map;
  `use std.set;
  `use std.option;
  `use std.quirks;
  `compound Counter { num cur; num end; }
  `impl Counter as Iterator<num> {
  `  pub next() Option<num> {
  `    if self.cur >= self.end { ret .None; }
  `    num v = self.cur;
  `    self.cur = self.cur + 1;
  `    ret .Some(v);
  `  }
  `}
  `compound Holder { Vec<num>* items; }
  `fun sum_vec(Vec<num>* v) num {
  `  num total = 0;
  `  for x : v { total = total + x; }
  `  ret total;
  `}
  `fun count_map(Map<num, num>* m) num {
  `  num n = 0;
  `  for kv : m { n = n + 1; }
  `  ret n;
  `}
  `fun sum_set(Set<num>* s) num {
  `  num total = 0;
  `  for x : s { total = total + x; }
  `  ret total;
  `}
  `fun run_counter(Counter* c) num {
  `  num total = 0;
  `  for x : c { total = total + x; }
  `  ret total;
  `}
  `fun holder_sum(Holder* h) num {
  `  num total = 0;
  `  for x : h.items { total = total + x; }
  `  ret total;
  `}
  `fun main() num {
  `  Vec<num> v;
  `  v.init(0);
  `  v.push(1);
  `  v.push(2);
  `  v.push(3);
  `  Map<num, num> m;
  `  m.init();
  `  m.put(1, 10);
  `  m.put(2, 20);
  `  Set<num> s = set_init(0, 8);
  `  s.add(4);
  `  s.add(5);
  `  Counter c = Counter{ cur = 0, end = 4 };
  `  Holder h = Holder{ items = &v };
  `  printf("%lld %lld %lld %lld %lld\n", sum_vec(&v), count_map(&m), sum_set(&s), run_counter(&c), holder_sum(&h));
  `  printf("%lld\n", v.len);
  `  ret 0;
  `}`;
  str out = run_source(src, "for_over_pointer", "for over a pointer to a collection");
  assert equals(out, "6 2 9 6 6\n3\n"), "expected each pointer-typed iterable to iterate what it points to, leaving a Vec's own contents alone";
}
