// The read side of `fun.lock`: shared between `src/cli/deps.fn` (which
// also resolves and fetches, writing the lock) and `import_resolver.fn`
// (which only ever reads it, to turn an `imp deps.<name>...` path into
// a real file path). Kept in `src/parser/` rather than `src/cli/`
// deliberately: the parser layer must not depend on the CLI layer, and
// this file pulls in nothing beyond `std.toml`/`std.fs`/`std.map`,
// never `std.process` (the fetching engine's own git-shelling stays in
// `deps.fn`, which imports this file, not the other way around).

imp std.toml;
imp std.map;
imp std.vec;
imp std.string;
imp std.option;
imp std.fs;
imp std.sys;

// One dependency, fully resolved: an exact commit pinned, and fetched
// into the shared cache. `local_root` is `path` joined onto the
// checkout - what `imp deps.<name>...` actually resolves against.
pub compound ResolvedDep {
  str name;
  str git;
  str path;
  // "tag:v1.2.3" / "branch:main" / "rev:<sha>" / "tag:latest" - the
  // spec that produced `resolved_rev`, kept so a later `fun build` can
  // tell whether the manifest's own spec for this name has changed
  // since the lock was written, without needing to talk to the network
  // just to check.
  str spec_text;
  str resolved_rev;
  str local_root;
}

// `FUN_DEPS_CACHE` if set, else `$HOME/.local/share/fun/deps` - the
// same "explicit env var wins, else a default under the installer's
// own `$HOME/.local/share/fun`" shape `FUN_STDLIB_DIR`/`stdlib_root`
// already use. Shared across every project on the machine: two
// projects (or two spots in one project's own transitive graph)
// pinning the same commit of the same repo fetch it once.
pub fun deps_cache_root() str {
  let configured = env("FUN_DEPS_CACHE");
  if configured != nil && !equals(configured, "") {
    ret configured;
  }
  let home = env("HOME");
  if home != nil && !equals(home, "") {
    ret format("{str}/.local/share/fun/deps", home);
  }
  // On Windows, HOME is typically not set; LOCALAPPDATA points to the
  // per-user application data directory (C:\Users\<user>\AppData\Local).
  let local_app_data = env("LOCALAPPDATA");
  if local_app_data != nil && !equals(local_app_data, "") {
    ret format("{str}/fun/deps", local_app_data);
  }
  ret ".fun-deps-cache";
}

// A git URL turned into a filesystem-safe path component: strips the
// scheme, replaces `/`, `:`, `@`, `.` with `_`. Doesn't need to be
// reversible, just stable and collision-resistant enough for a cache
// directory name.
pub fun sanitize_url(str url) str {
  str s = url;
  num i = index_of_str(s, "://");
  if i >= 0 {
    s = substr(s, i + 3, len(s) - (i + 3));
  }
  StringBuilder b = string_builder_init(len(s) + 1);
  num j = 0;
  num n = len(s);
  for j < n {
    chr c = s[j];
    if c == '/' || c == ':' || c == '@' || c == '.' {
      b.append_char('_');
    } else {
      b.append_char(c);
    }
    j = j + 1;
  }
  ret b.build();
}

pub fun dep_cache_dir(str url, str resolved_rev) str {
  ret format("{str}/{str}/{str}", deps_cache_root(), sanitize_url(url), resolved_rev);
}

pub fun fun_lock_path(str root) str {
  if equals(root, "") || equals(root, ".") {
    ret "fun.lock";
  }
  ret format("{str}/fun.lock", root);
}

// Best-effort: a missing or unreadable lockfile just means every
// dependency gets freshly resolved, same as a first build - never an
// error a caller (a `resolve_import_path` call reached during ordinary
// editing/completion, in particular) has to handle.
pub fun read_lock(str root) Vec<ResolvedDep> {
  Vec<ResolvedDep> out;
  out.init(0);
  str path = fun_lock_path(root);
  if !exists(path) {
    ret out;
  }
  let text = read_to_string(path);
  let doc = parse_document(text);
  defer doc.free();
  let deps_table = doc.table("deps");
  if deps_table.is_none() {
    ret out;
  }
  let dt = deps_table.unwrap();
  let names = dt.values.keys();
  defer names.free();
  num i = 0;
  for i < names.len() {
    str name = names.get(i);
    let entry_val = dt.values.get(name);
    if !entry_val.is_table() {
      i = i + 1;
      continue;
    }
    ResolvedDep d;
    d.name = name;
    d.git = entry_val.table_field("git");
    d.path = entry_val.table_field("path");
    d.spec_text = entry_val.table_field("spec");
    d.resolved_rev = entry_val.table_field("resolved_rev");
    if equals(d.path, "") {
      d.local_root = dep_cache_dir(d.git, d.resolved_rev);
    } else {
      d.local_root = format("{str}/{str}", dep_cache_dir(d.git, d.resolved_rev), d.path);
    }
    out.push(d);
    i = i + 1;
  }
  ret out;
}

pub fun write_lock(str root, Vec<ResolvedDep>* deps) {
  StringBuilder b = string_builder_init(128);
  b.append("# fun.lock, generated by `fun build`/`fun deps update`. Do not edit by hand.\n");
  b.append("\n[deps]\n");
  num i = 0;
  for i < deps.len {
    let d = deps.get(i);
    b.append(d.name);
    b.append(" = { git = \"");
    b.append(d.git);
    b.append("\"");
    if !equals(d.path, "") {
      b.append(", path = \"");
      b.append(d.path);
      b.append("\"");
    }
    b.append(", spec = \"");
    b.append(d.spec_text);
    b.append("\", resolved_rev = \"");
    b.append(d.resolved_rev);
    b.append("\" }\n");
    i = i + 1;
  }
  write_string(fun_lock_path(root), b.build());
}

// The resolved local root for `name`, or None when `name` isn't among
// `resolved`.
pub fun deps_root_for(str name, Vec<ResolvedDep>* resolved) Option<str> {
  num i = 0;
  for i < resolved.len {
    if equals(resolved.get(i).name, name) {
      ret .Some(resolved.get(i).local_root);
    }
    i = i + 1;
  }
  ret .None;
}

// `read_lock` + `deps_root_for` in one call - what `resolve_import_path`
// actually needs for a `deps.<name>...` path: the nearest `fun.lock`
// above `project_root`'s own root, read fresh (a real disk read every
// time, not cached across calls - `fun.lock` is small and this is not
// a hot path the way `stdlib_root`'s own upward directory walk is
// guarded against being).
pub fun resolve_deps_import_root(str name, str project_root) Option<str> {
  let locked = read_lock(project_root);
  defer locked.free();
  ret deps_root_for(name, &locked);
}
