// Keyword/identifier-to-DataType lookup tables the parser depends on when
// reading a type annotation. Pure, self-contained lookup tables kept in
// their own module rather than inside parser.fn.

use ..ast.ast;
use std.string;
use std.ctype;
use std.option;

// A sized integer type name (`i8`..`i64`, `u8`..`u64`, arbitrary bit
// widths are accepted syntactically): its signedness and bit width.
pub compound DynamicIntType {
  flag is_signed;
  num bits;
}

// Parses `s` as a `iN`/`uN` sized-integer type name (e.g. `i32`, `u8`), or
// `.None` if it isn't one. A bare `i`/`u` with no digits, or any non-digit
// after the prefix, is rejected.
pub fun parse_dynamic_int_datatype(str s) Option<DynamicIntType> {
  if len(s) < 2 {
    ret .None;
  }
  flag is_signed = false;
  if s[0] == 'i' {
    is_signed = true;
  } elif s[0] == 'u' {
    is_signed = false;
  } else {
    ret .None;
  }
  num i = 1;
  for i < len(s) {
    if !is_digit(s[i]) {
      ret .None;
    }
    i = i + 1;
  }
  num bits = parse_int(substr(s, 1, len(s) - 1));
  if bits == 0 {
    ret .None;
  }
  ret .Some(DynamicIntType{is_signed = is_signed, bits = bits});
}

// True if `s` is a `iN`/`uN` sized-integer type name.
pub fun is_dynamic_int_datatype(str s) flag {
  ret parse_dynamic_int_datatype(s).is_some();
}

// True if `s` is a reserved builtin datatype keyword (as opposed to a
// user-defined/identifier-based type name like a compound or C typedef).
pub fun keyword_is_datatype(str s) flag {
  fit s {
    "void", "raw", "num", "dec", "str", "flag", "chr", "f32", "f64" -> { ret true; }
    _ -> { ret is_dynamic_int_datatype(s); }
  }
}

// Maps a builtin datatype keyword (or a `iN`/`uN` sized-integer name) to
// its `DataTypeType`. Returns `.Unknown` for anything else (a
// user-defined/identifier-based type name).
pub fun get_datatype_type(str s) DataTypeType {
  fit s {
    "void" -> { ret .Void; }
    "raw" -> { ret .Raw; }
    "chr" -> { ret .Chr; }
    "str" -> { ret .Str; }
    "dec", "f32", "f64" -> { ret .Dec; }
    "num" -> { ret .Num; }
    "flag" -> { ret .Bin; }
    _ -> {
      if is_dynamic_int_datatype(s) {
        ret .Num;
      }
      ret .Unknown;
    }
  }
}

// The canonical text a resolved type expression renders as: base name,
// `<A, B>` generic args (recursive, comma-space separated), then trailing
// `*` pointer-depth markers. Matches `type_name(CheckedType)` in
// src/semantics/typecheck.fn byte-for-byte, so a bound alternative stored
// as this text can be compared against an inferred argument's own
// rendered name with a bare `equals()`. No array-suffix handling: a bound
// alternative is a bare type reference, never an array type.
pub fun render_datatype_bound(DataType* dt) str {
  if dt == nil {
    ret "";
  }
  str base = "unknown";
  fit dt.kind {
    .Void -> { base = "void"; }
    .Raw -> { base = "raw"; }
    .Chr -> { base = "chr"; }
    .Str -> { base = "str"; }
    .Dec -> { base = "dec"; }
    .Num -> { base = "num"; }
    .Bin -> { base = "flag"; }
    .Unknown -> {
      if !equals(dt.type_str, "") {
        base = dt.type_str;
      }
    }
  }
  StringBuilder b = string_builder_init(len(base) + 4);
  b.append(base);
  if dt.generic_args.len > 0 {
    b.append("<");
    num g = 0;
    for g < dt.generic_args.len {
      if g > 0 {
        b.append(", ");
      }
      str arg = render_datatype_bound(dt.generic_args.get(g));
      b.append(arg);
      free(arg);
      g = g + 1;
    }
    b.append(">");
  }
  num stars = dt.pointer_depth;
  if dt.flags.is_pointer && stars == 0 {
    stars = 1;
  }
  num i = 0;
  for i < stars {
    b.append("*");
    i = i + 1;
  }
  ret b.build();
}

// Best-effort semantic typing for common C typedef names.
//
// These identifiers are emitted verbatim in C (`type_str`), but are tagged
// with a Fun base type so the typechecker can treat them as numeric where
// appropriate. `.None` when the name is not recognized.
pub fun get_c_typedef_alias_datatype_type(str s) Option<DataTypeType> {
  fit s {
    // stddef.h
    "size_t", "ptrdiff_t", "wchar_t",
    // C11 Annex K, if provided by the platform headers
    "rsize_t",
    // common POSIX/C extensions
    "ssize_t",
    // stdint.h
    "intptr_t", "uintptr_t", "int8_t", "uint8_t", "int16_t", "uint16_t", "int32_t", "uint32_t",
    "int64_t", "uint64_t",
    // time.h
    "time_t", "clock_t",
    // spawn.h / sys/wait.h
    "pid_t" -> { ret .Some(.Num); }
    // stdio.h / stdarg.h / pthread.h / spawn.h: opaque handle typedefs
    "FILE", "va_list", "pthread_t", "pthread_attr_t", "pthread_mutex_t", "pthread_mutexattr_t",
    "pthread_cond_t", "pthread_condattr_t", "posix_spawn_file_actions_t", "posix_spawnattr_t" -> {
      ret .Some(.Unknown);
    }
    _ -> { ret .None; }
  }
}

test "render_datatype_bound renders a builtin scalar" {
  DataType dt = dtype_new();
  dt.kind = .Num;
  assert equals(render_datatype_bound(&dt), "num"), "expected 'num'";
}

test "render_datatype_bound renders an identifier type name" {
  DataType dt = dtype_new();
  dt.kind = .Unknown;
  dt.type_str = "User";
  assert equals(render_datatype_bound(&dt), "User"), "expected 'User'";
}

test "render_datatype_bound renders a generic instantiation recursively" {
  DataType* arg = malloc(sizeof(DataType));
  *arg = dtype_new();
  arg.kind = .Num;

  DataType dt = dtype_new();
  dt.kind = .Unknown;
  dt.type_str = "Vec";
  dt.generic_args.push(arg);

  assert equals(render_datatype_bound(&dt), "Vec<num>"), "expected 'Vec<num>'";
}

test "render_datatype_bound renders trailing pointer stars" {
  DataType dt = dtype_new();
  dt.kind = .Unknown;
  dt.type_str = "User";
  dt.pointer_depth = 2;
  assert equals(render_datatype_bound(&dt), "User**"), "expected 'User**'";
}

test "parse_dynamic_int_datatype accepts iN/uN, rejects everything else" {
  fit parse_dynamic_int_datatype("i32") {
    .Some(d) -> {
      assert d.is_signed, "i32 should be signed";
      assert d.bits == 32, "i32 should have 32 bits";
    }
    .None -> { panic("i32 should parse"); }
  }
  fit parse_dynamic_int_datatype("u8") {
    .Some(d) -> {
      assert !d.is_signed, "u8 should be unsigned";
      assert d.bits == 8, "u8 should have 8 bits";
    }
    .None -> { panic("u8 should parse"); }
  }
  assert parse_dynamic_int_datatype("i").is_none(), "bare 'i' should not parse";
  assert parse_dynamic_int_datatype("x32").is_none(), "non i/u prefix should not parse";
  assert parse_dynamic_int_datatype("i3x").is_none(), "non-digit suffix should not parse";
}

test "keyword_is_datatype recognizes builtins and sized ints, not identifiers" {
  assert keyword_is_datatype("num"), "num is a datatype keyword";
  assert keyword_is_datatype("str"), "str is a datatype keyword";
  assert keyword_is_datatype("i64"), "i64 is a datatype keyword";
  assert !keyword_is_datatype("MyCompound"), "identifiers are not datatype keywords";
}

test "get_datatype_type maps builtins and sized ints, else Unknown" {
  assert get_datatype_type("num") == .Num, "num maps to Num";
  assert get_datatype_type("f32") == .Dec, "f32 maps to Dec";
  assert get_datatype_type("u16") == .Num, "u16 maps to Num";
  assert get_datatype_type("MyCompound") == .Unknown, "unknown name maps to Unknown";
}

test "get_c_typedef_alias_datatype_type recognizes common C typedefs" {
  fit get_c_typedef_alias_datatype_type("size_t") {
    .Some(t) -> { assert t == .Num, "size_t is numeric"; }
    .None -> { panic("size_t should be recognized"); }
  }
  fit get_c_typedef_alias_datatype_type("FILE") {
    .Some(t) -> { assert t == .Unknown, "FILE is an opaque handle"; }
    .None -> { panic("FILE should be recognized"); }
  }
  assert get_c_typedef_alias_datatype_type("not_a_typedef").is_none(), "unrecognized name returns None";
}
