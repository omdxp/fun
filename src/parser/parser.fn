test "parse_fuzz_declaration parses a named fuzz body with its two fixed-type params" {
  ParseState st = _state_from("fuzz \"never crashes\" (raw* data, num len) { assert len >= 0; }");
  Parser p = parser_new(&st);
  assert p.parse_fuzz_declaration().is_none(), "expected the fuzz declaration to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Fuzz(fd) -> {
      assert equals(fd.name, "never crashes"), "expected fuzz name 'never crashes'";
      fit fd.data_param.kind {
        .Variable(dv) -> {
          assert equals(dv.name, "data"), "expected the data param named 'data'";
          assert dv.var_type.pointer_depth == 1, "expected the data param to be a pointer (raw*)";
        }
        _ -> { panic("expected a Variable node for data_param"); }
      }
      fit fd.len_param.kind {
        .Variable(lv) -> {
          assert equals(lv.name, "len"), "expected the len param named 'len'";
          assert lv.var_type.kind == .Num, "expected the len param typed num";
        }
        _ -> { panic("expected a Variable node for len_param"); }
      }
      fit fd.body.kind {
        .Body(bn) -> { assert bn.statements.len == 1, "expected 1 statement in the fuzz body"; }
        _ -> { panic("expected a Body node"); }
      }
    }
    _ -> { panic("expected a Fuzz node"); }
  }
}

test "parse_fuzz_declaration requires a string name" {
  ParseState st = _state_from("fuzz foo (data, len) { }");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_fuzz_declaration();
  assert err.is_some(), "expected an error for a non-string fuzz name";
}

