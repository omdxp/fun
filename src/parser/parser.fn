test "parse_await_operand parses an awaited call, bounded at a following binary operator" {
  Vec<str> names;
  names.init(0);
  names.push("f");
  ParseState st = _state_with_declared("await f() + 1", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_await_operand().is_none(), "expected 'await f()' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "await"), "expected op 'await'";
      fit u.operand.kind {
        .Expression(e) -> {
          assert equals(e.op, "()"), "expected the awaited operand to be a call, not 'f() + 1'";
        }
        _ -> { panic("expected an Expression call as the operand"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
  // The '+ 1' wasn't consumed; it's still sitting in the token stream.
  assert p.state.next_token_is_operator("+"), "expected '+' to remain unconsumed after the bounded await operand";
}

test "parse_await_operand rejects use outside of a function" {
