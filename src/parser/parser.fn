}

test "parse stops cleanly at end of input" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected an empty file to parse with no nodes";
  assert st.nodes.len == 0, "expected no top-level nodes";
}

test "parse_import parses a simple dotted path with no alias" {
  ParseState st = _state_from("imp std.io;");
  Parser p = parser_new(&st);
  assert p.parse_import().is_none(), "expected 'imp std.io;' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Import(impn) -> {
      assert equals(impn.path, "std.io"), "expected path 'std.io'";
      assert !impn.has_alias, "expected no alias";
    }
    _ -> { panic("expected an Import node"); }
  }
}

test "parse_import parses an alias" {
  ParseState st = _state_from("imp std.io as io;");
  Parser p = parser_new(&st);
  assert p.parse_import().is_none(), "expected 'imp std.io as io;' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Import(impn) -> {
      assert equals(impn.path, "std.io"), "expected path 'std.io'";
      assert impn.has_alias, "expected an alias";
      assert equals(impn.alias, "io"), "expected alias 'io'";
    }
    _ -> { panic("expected an Import node"); }
  }
}

test "parse_import parses leading '..' parent-traversal segments" {
  ParseState st = _state_from("imp ..lexer.token;");
  Parser p = parser_new(&st);
  assert p.parse_import().is_none(), "expected 'imp ..lexer.token;' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Import(impn) -> {
      assert equals(impn.path, "..lexer.token"), "expected path '..lexer.token'";
    }
    _ -> { panic("expected an Import node"); }
  }
}

test "parse_import rejects an odd number of leading dots" {
  ParseState st = _state_from("imp .lexer.token;");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_import();
  assert err.is_some(), "expected an error for an odd number of leading dots";
}

test "parse parses an import at the top level" {
  ParseState st = _state_from("imp std.vec; fun main() num { ret 0; }");
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected the whole file to parse";
  assert st.nodes.len == 2, "expected 2 top-level nodes";
  fit st.nodes.get(0).kind {
    .Import(impn) -> { assert equals(impn.path, "std.vec"), "expected path 'std.vec'"; }
    _ -> { panic("expected an Import node"); }
  }
}

test "parse_for_statement parses an infinite loop with no condition" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("for { a; }", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_for_statement().is_none(), "expected 'for { a; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFor(fk) -> {
      fit fk {
        .Cond(fc) -> {
          assert !fc.has_condition, "expected no condition for an infinite loop";
          fit fc.body.kind {
            .Body(bn) -> { assert bn.statements.len == 1, "expected 1 statement in the body"; }
            _ -> { panic("expected a Body node"); }
          }
        }
        _ -> { panic("expected .Cond"); }
      }
    }
    _ -> { panic("expected a StatementFor node"); }
  }
}

test "parse_for_statement parses a condition loop" {
  Vec<str> names;
  names.init(0);
  names.push("i");
  names.push("n");
  ParseState st = _state_with_declared("for i < n { i; }", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_for_statement().is_none(), "expected 'for i < n { i; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFor(fk) -> {
      fit fk {
        .Cond(fc) -> {
          assert fc.has_condition, "expected a condition";
          fit fc.condition.kind {
            .Expression(e) -> { assert equals(e.op, "<"), "expected condition op '<'"; }
            _ -> { panic("expected an Expression condition"); }
          }
        }
        _ -> { panic("expected .Cond"); }
      }
    }
    _ -> { panic("expected a StatementFor node"); }
  }
}

test "parse_for_statement parses a range loop" {
  Vec<str> names;
  names.init(0);
  names.push("n");
  ParseState st = _state_with_declared("for i : 0..n { i; }", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_for_statement().is_none(), "expected 'for i : 0..n { i; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFor(fk) -> {
      fit fk {
        .Range(fr) -> {
          assert equals(fr.index_name, "i"), "expected index name 'i'";
          fit fr.range_expr.kind {
            .Expression(e) -> { assert equals(e.op, ".."), "expected range op '..'"; }
            _ -> { panic("expected an Expression range"); }
          }
          fit fr.body.kind {
            .Body(bn) -> { assert bn.statements.len == 1, "expected 1 statement in the body"; }
            _ -> { panic("expected a Body node"); }
          }
        }
        _ -> { panic("expected .Range"); }
      }
    }
    _ -> { panic("expected a StatementFor node"); }
  }
}

test "parse_for_statement parses an iterator loop with no index" {
  Vec<str> names;
  names.init(0);
  names.push("arr");
  ParseState st = _state_with_declared("for item : arr { item; }", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_for_statement().is_none(), "expected 'for item : arr { item; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFor(fk) -> {
      fit fk {
        .Iter(fi) -> {
          assert !fi.has_index_name, "expected no index name";
          assert equals(fi.item_name, "item"), "expected item name 'item'";
          fit fi.iterable.kind {
            .Identifier(s) -> { assert equals(s, "arr"), "expected iterable 'arr'"; }
            _ -> { panic("expected Identifier 'arr'"); }
          }
        }
        _ -> { panic("expected .Iter"); }
      }
    }
    _ -> { panic("expected a StatementFor node"); }
  }
}

test "parse_for_statement parses an iterator loop with an index" {
  Vec<str> names;
  names.init(0);
  names.push("arr");
  ParseState st = _state_with_declared("for i, item :: arr { i; item; }", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_for_statement().is_none(), "expected 'for i, item :: arr { i; item; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFor(fk) -> {
      fit fk {
        .Iter(fi) -> {
          assert fi.has_index_name, "expected an index name";
          assert equals(fi.index_name, "i"), "expected index name 'i'";
          assert equals(fi.item_name, "item"), "expected item name 'item'";
        }
        _ -> { panic("expected .Iter"); }
      }
    }
    _ -> { panic("expected a StatementFor node"); }
  }
}

test "parse_for_statement rejects a range loop written with the 'i, item ::' form" {
  Vec<str> names;
