// The parser: turns a token stream into an AST, covering the full
// expression grammar, every statement and top-level declaration form,
// and the top-level `parse()` loop that ties them into a whole file.
// `asm`/inline-assembly is not parsed; the lexer defers raw asm-body
// lexing to match. Note: chaining `.field` directly onto a
// `Vec<T*>.get(...)` call can emit `.` instead of `->` and fail to
// compile, so bind the call result to a `let` first.

imp parse_state;
imp datatype_defs;
imp expressionable_defs;
imp ..ast.ast;
imp ..lexer.token;
imp ..lexer.lexer;
imp ..semantics.scope;
imp ..semantics.symbol;
imp std.vec;
imp std.string;
imp std.option;
imp std.io;
imp std.c.io;
imp std.c.mem;

// Maximum recursive-descent depth for the expression parser. Set well
// above any plausible hand-written expression, but low enough that the
// limit is reported as an error rather than overflowing the stack.
const num max_parse_expr_depth = 600;

// Errors the parser can report.
pub enum ParseErrorKind {
  InvalidSymbol,
  InvalidKeyword,
  InvalidDataType,
  InvalidToken,
  InvalidIdentifier,
  InvalidOperand,
  InvalidStatement,
  InvalidString,
  InvalidExpression,
}

impl ParseState {
  // Logs a diagnostic with the current position in the token stream.
  // `msg` should already be formatted (via `std.io.format`), since
  // Fun's varargs sugar is for `{placeholder}` formatting, not a
  // passthrough to `fprintf`.
  pub err(str msg) {
    // Recorded before anything is printed, so a caller reading errors
    // as data sees them whether or not they are also written out. The
    // message is copied, since a caller frees what it formatted; only a
    // message this function copied is freed here.
    if self.has_error {
      free(self.error_message);
    }
    self.error_message = substr(msg, 0, len(msg));
    self.has_error = true;
    if self.has_current_token {
      self.error_pos = self.current_token.pos;
    }
    if !self.emit_stderr {
      ret;
    }
    let out = stderr_stream();
    fprintf(out, "%s", "\n[Error]\n");
    fprintf(out, "%s", msg);
    if self.has_current_token {
      let ct = self.current_token;
      num end_line = ct.pos.end_line;
      if end_line == 0 {
        end_line = ct.pos.line;
      }
      if end_line == ct.pos.line {
        let loc = format(
          "\nLocation: {str}:{num}:{num}-{num}\n",
          ct.pos.filename,
          ct.pos.line,
          ct.pos.start_col,
          ct.pos.end_col
        );
        defer free(loc);
        fprintf(out, "%s", loc);
      } else {
        let loc = format(
          "\nLocation: {str}:{num}:{num}-{num}:{num}\n",
          ct.pos.filename,
          ct.pos.line,
          ct.pos.start_col,
          end_line,
          ct.pos.end_col
        );
        defer free(loc);
        fprintf(out, "%s", loc);
      }
    } else {
      let loc = format(
        "\nLocation: {str}:{num}:{num}\n",
        self.pos.filename,
        self.pos.line,
        self.pos.col
      );
      defer free(loc);
      fprintf(out, "%s", loc);
    }
  }

  // Returns the token at the cursor without advancing, or `.None` past the
  // end of the stream.
  pub tokens_peek_no_increment() Option<Token> {
    ret self.tokens.at(self.pindex);
  }

  // Returns the token at the cursor and advances past it. Returns `.None`
  // (cursor unchanged) past the end of the stream.
  pub tokens_peek() Option<Token> {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        self.pindex = self.pindex + 1;
        ret .Some(t);
      }
      .None -> { ret .None; }
    }
  }

  // Un-reads the most recently peeked token (moves the cursor back by one).
  pub tokens_pop_last_peek() {
    if self.pindex > 0 {
      self.pindex = self.pindex - 1;
    }
  }

  // Advances the cursor past any run of newline/comment/`\` tokens.
  pub skip_nl_or_comment() {
    for {
      fit self.tokens_peek_no_increment() {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            ret;
          }
          self.tokens_peek();
        }
        .None -> { ret; }
      }
    }
  }

  // Peeks at the next significant (non newline/comment) token without
  // consuming it. Updates `current_token` as a side effect, so diagnostics
  // reported right after a peek still point at the right place.
  pub token_peek_next() Option<Token> {
    self.skip_nl_or_comment();
    let pk = self.tokens_peek_no_increment();
    fit pk {
      .Some(t) -> {
        self.current_token = t;
        self.has_current_token = true;
      }
      .None -> { self.has_current_token = false; }
    }
    ret pk;
  }

  // Peeks at the n-th significant token at or after the cursor without
  // consuming anything (`n = 0` is equivalent to `token_peek_next`, minus
  // the `current_token` side effect).
  pub token_peek_n(num n) Option<Token> {
    num idx = self.pindex;
    num seen = 0;
    for {
      fit self.tokens_at(idx) {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            if seen == n {
              ret .Some(t);
            }
            seen = seen + 1;
          }
          idx = idx + 1;
        }
        .None -> { ret .None; }
      }
    }
  }

  pub tokens_at(num idx) Option<Token> {
    ret self.tokens.at(idx);
  }

  // Consumes and returns the next significant token, recording it as both
  // the current diagnostic position and `current_token`.
  pub token_next() Option<Token> {
    self.skip_nl_or_comment();
    fit self.tokens_peek_no_increment() {
      .Some(t) -> { self.pos = t.pos; }
      .None -> {}
    }
    let consumed = self.tokens_peek();
    fit consumed {
      .Some(t) -> {
        self.current_token = t;
        self.has_current_token = true;
      }
      .None -> { self.has_current_token = false; }
    }
    ret consumed;
  }

  // True if the next significant token is an `Operator` with text `op`,
  // without consuming it.
  pub next_token_is_operator(str op) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_operator(t, op); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token is the `Keyword` `keyword`, without
  // consuming it.
  pub next_token_is_keyword(str keyword) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_keyword(t, keyword); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token is the `Symbol` `c`, without
  // consuming it.
  pub next_token_is_symbol(chr c) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_symbol(t, c); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token opens a generic-argument list: a
  // `<` (as an `Operator`, the common case, or a lexed `Symbol` in the rare
  // context where it wasn't combined into a longer operator).
  pub next_token_is_angle_open() bin {
    fit self.token_peek_next() {
      .Some(t) -> {
        fit t.type {
          .Operator -> {
            fit t.data {
              .Sval(s) -> { ret len(s) > 0 && s[0] == '<'; }
              _ -> { ret false; }
            }
          }
          .Symbol -> {
            fit t.data {
              .Cval(c) -> { ret c == '<'; }
              _ -> { ret false; }
            }
          }
          _ -> { ret false; }
        }
      }
      .None -> { ret false; }
    }
  }

  // Splits a lexed `>>` token in place into two adjacent `>` tokens, if the
  // next significant token is one. Needed so nested generics (`Vec<Vec<num>>`)
  // parse correctly, since the lexer can't tell `>>` apart from a
  // right-shift operator without parse context.
  pub split_angle_closer_token_if_needed() {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        if t.type != .Operator {
          ret;
        }
        bin is_shr = false;
        fit t.data {
          .Sval(s) -> { is_shr = equals(s, ">>"); }
          _ -> {}
        }
        if !is_shr {
          ret;
        }
        Token first = t;
        first.data = .Sval(">");
        self.tokens.set(self.pindex, first);
        Token second = t;
        second.data = .Sval(">");
        self.tokens.insert(self.pindex + 1, second);
      }
      .None -> {}
    }
  }

  // Splits a lexed `<<` token in place into two adjacent `<` tokens, if the
  // next significant token is one. The opening-bracket counterpart to
  // `split_angle_closer_token_if_needed`: a `<<` can appear immediately
  // before a nested generic's own opener when the outer angle bracket was
  // itself just split from a longer run.
  pub split_angle_opener_token_if_needed() {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        if t.type != .Operator {
          ret;
        }
        bin is_shl = false;
        fit t.data {
          .Sval(s) -> { is_shl = equals(s, "<<"); }
          _ -> {}
        }
        if !is_shl {
          ret;
        }
        Token first = t;
        first.data = .Sval("<");
        self.tokens.set(self.pindex, first);
        Token second = t;
        second.data = .Sval("<");
        self.tokens.insert(self.pindex + 1, second);
      }
      .None -> {}
    }
  }

  // Counts and consumes a run of `*` pointer-depth markers after a type
  // name (`num**` -> depth 2).
  pub parse_get_pointer_depth() num {
    num depth = 0;
    for self.next_token_is_operator("*") {
      depth = depth + 1;
      self.token_next();
    }
    ret depth;
  }

  // Resolves the n-th significant token strictly before physical index
  // `exclusive_end` (n = 0 -> the closest one). Linear backward scan.
  pub token_peek_prev_significant(num exclusive_end, num n) Option<Token> {
    num idx = exclusive_end - 1;
    num seen = 0;
    for idx >= 0 {
      fit self.tokens_at(idx) {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            if seen == n {
              ret .Some(t);
            }
            seen = seen + 1;
          }
        }
        .None -> { ret .None; }
      }
      idx = idx - 1;
    }
    ret .None;
  }

  // Peeks the previous non-skippable token (relative to the most recently
  // consumed token).
  pub token_peek_prev() Option<Token> {
    ret self.token_peek_prev_significant(self.pindex - 1, 0);
  }

  // Peeks the n-th previous non-skippable token (relative to the most
  // recently consumed token). `n = 0` is equivalent to `token_peek_prev`.
  pub token_peek_prev_n(num n) Option<Token> {
    ret self.token_peek_prev_significant(self.pindex - 1, n);
  }

  // Peeks the n-th previous non-skippable token relative to the next token
  // to be consumed (i.e. what `token_peek_next` would return sits at
  // `self.pindex`; this looks backward from `pindex - 1`, `pindex - 2`, ...),
  // which is the useful notion of "previous" when the token being inspected
  // hasn't been consumed yet.
  pub token_peek_prev_stream_n(num n) Option<Token> {
    ret self.token_peek_prev_significant(self.pindex, n);
  }

  // Expects the next significant token to be the symbol `c`. Reports and
  // returns an error if it is anything else.
  pub expect_sym(chr c) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> {
        if t.type == .Symbol {
          fit t.data {
            .Cval(v) -> { matched = v == c; }
            _ -> {}
          }
        }
      }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected symbol '{chr}'", c);
    defer free(msg);
    self.err(msg);
    ret .Some(.InvalidSymbol);
  }

  // Expects the next significant token to be the operator `op`. Reports and
  // returns an error if it is anything else.
  pub expect_op(str op) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> { matched = token_is_operator(t, op); }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected operator '{str}'", op);
    defer free(msg);
    self.err(msg);
    ret .Some(.InvalidOperand);
  }

  // Expects the next significant token to be the keyword `keyword`. Reports
  // and returns an error if it is anything else.
  pub expect_keyword(str keyword) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> { matched = token_is_keyword(t, keyword); }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected keyword '{str}'", keyword);
    defer free(msg);
    self.err(msg);
    ret .Some(.InvalidKeyword);
  }

  // Retrieves a symbol by name from the active symbol table.
  pub get_symbol(str name) Option<Symbol> {
    if !self.has_active_table {
      ret .None;
    }
    num i = 0;
    let tbl = self.active_table;
    for i < tbl.symbols.len {
      let s = tbl.symbols.get(i);
      if equals(s.name, name) {
        ret .Some(s);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Adds `s` to the active symbol table.
  pub push_symbol(Symbol s) {
    self.active_table.symbols.push(s);
  }

  // Registers a scope entity in the current scope.
  pub push_scope_entity(ScopeEntity* entity) {
    self.scope_current.entities.push(entity);
  }

  // Looks up a scope entity by name, starting at the current scope and
  // walking up to (but not including) the global/root scope.
  pub get_scope_entity(str name) ScopeEntity* {
    let s = self.scope_current;
    for s != nil {
      let found = s.get_entity_by_name(name);
      if found != nil {
        ret found;
      }
      if !s.has_parent {
        ret nil;
      }
      s = s.parent;
    }
    ret nil;
  }

  // Walks up the current scope chain for the last-declared entity, stopping
  // at (not including) `stop_scope`.
  pub last_scope_entity_stop_at(Scope* stop_scope) ScopeEntity* {
    ret self.scope_current.last_entity_from_scope_stop_at(stop_scope);
  }

  // Pops and returns the last node pushed onto the output node list, or
  // `.None` if it's empty. Expression/statement parsing composes larger
  // nodes by popping their already-parsed children back off this list.
  pub node_pop() Option<Node> {
    if self.nodes.len == 0 {
      ret .None;
    }
    ret .Some(self.nodes.pop());
  }

  // Returns the last node without popping it, or `.None` if empty.
  pub node_peek_last() Option<Node> {
    ret self.nodes.last();
  }

  // Establishes the root/global scope. Called once, before parsing the
  // first top-level declaration.
  pub init_root_scope() {
    Scope* root = malloc(sizeof(Scope));
    *root = scope_new();
    self.scope_root = root;
    self.has_scope_root = true;
    self.scope_current = root;
    self.has_scope_current = true;
  }

  // Pushes a new child scope (e.g. entering a function/block body), parented
  // to whatever scope was current.
  pub new_scope() {
    Scope* nc = malloc(sizeof(Scope));
    *nc = scope_new();
    if self.has_scope_current {
      nc.parent = self.scope_current;
      nc.has_parent = true;
    }
    self.scope_current = nc;
    self.has_scope_current = true;
  }

  // Pops back to the enclosing scope. A no-op past the root scope. The
  // popped scope is freed here, not collected to free later: once
  // `scope_current` moves past it, nothing can reach it again.
  pub finish_scope() {
    if !self.has_scope_current {
      ret;
    }
    let cur = self.scope_current;
    if cur.has_parent {
      self.scope_current = cur.parent;
    } else {
      self.has_scope_current = false;
    }
    free_scope(cur);
  }

  // Parses `<T>` or `<T: a | b, U: c>` generic type parameters in a
  // function/impl header (as opposed to `parse_generic_type_args`, which
  // parses generic arguments at a type-reference site). A no-op when
  // there's no `<...>` at all. Fills `out_params` with the parameter
  // names, and when any parameter carries a `: constraint` bound, fills
  // `out_forced_insts` with the Cartesian product of every parameter's
  // constraint set (e.g. `<T: num | dec, U: a | b>` produces all four
  // `[T, U]` pairings). Constraint names are captured as plain strings,
  // not interpreted here.
  pub parse_type_params_with_constraints(Vec<str>* out_params, Vec<Vec<str>>* out_forced_insts) Option<ParseErrorKind> {
    self.split_angle_opener_token_if_needed();
    if !self.next_token_is_angle_open() {
      ret .None;
    }
    self.token_next(); // consume '<'

    Vec<Vec<str>> param_constraints;
    param_constraints.init(0);
    bin has_constraints = false;

    for true {
      let tok = self.token_next();
      if tok.is_none() || tok.unwrap().type != .Identifier {
        self.err("expected generic parameter name");
        ret .Some(.InvalidIdentifier);
      }
      str name = "";
      fit tok.unwrap().data {
        .Sval(s) -> { name = s; }
        _ -> {}
      }
      out_params.push(name);

      Vec<str> constraints;
      constraints.init(0);
      if self.next_token_is_operator(":") {
        self.token_next(); // consume ':'
        has_constraints = true;
        for true {
          let ct = self.token_next();
          if ct.is_none() {
            self.err("expected type name in constraint after ':'");
            ret .Some(.InvalidIdentifier);
          }
          let ctok = ct.unwrap();
          if ctok.type != .Keyword && ctok.type != .Identifier {
            self.err("expected type name in constraint");
            ret .Some(.InvalidIdentifier);
          }
          str cname = "";
          fit ctok.data {
            .Sval(s) -> { cname = s; }
            _ -> {}
          }
          constraints.push(cname);
          if self.next_token_is_operator("|") {
            self.token_next();
            continue;
          }
          break;
        }
      }
      param_constraints.push(constraints);

      if self.next_token_is_operator(",") {
        self.token_next();
        continue;
      }
      break;
    }

    self.split_angle_closer_token_if_needed();
    if self.next_token_is_operator(">") {
      let err = self.expect_op(">");
      if err.is_some() {
        ret err;
      }
    } else {
      let err = self.expect_sym('>');
      if err.is_some() {
        ret err;
      }
    }

    if has_constraints {
      Vec<Vec<str>> combos;
      combos.init(0);
      Vec<str> initial;
      initial.init(0);
      combos.push(initial);

      for pc : param_constraints {
        Vec<Vec<str>> new_combos;
        new_combos.init(0);
        for existing : combos {
          for ct : pc {
            Vec<str> new_combo;
            new_combo.init(0);
            for et : existing {
              new_combo.push(et);
            }
            new_combo.push(ct);
            new_combos.push(new_combo);
          }
        }
        combos = new_combos;
      }

      for combo : combos {
        out_forced_insts.push(combo);
      }
    }

    ret .None;
  }

  // Parses a bracketed generic-argument list (`<T, U>`) into
  // `dt.generic_args`, if the next significant token opens one (a no-op
  // otherwise). Array-typed arguments (`Vec<num[]>`) aren't supported:
  // this method lives on `ParseState`, which lacks the expression-parsing
  // capability `parse_array_brackets` needs, so a generic arg starting
  // with `[` falls through to `parse_datatype`, which reports
  // `InvalidDataType`.
  pub parse_generic_type_args(DataType* dt) Option<ParseErrorKind> {
    self.split_angle_opener_token_if_needed();
    if !self.next_token_is_angle_open() {
      ret .None;
    }
    self.token_next();

    Vec<DataType*> args;
    args.init(0);

    for true {
      DataType* adt = malloc(sizeof(DataType));
      *adt = dtype_new();
      let err = self.parse_datatype(adt);
      if err.is_some() {
        ret err;
      }
      args.push(adt);

      if self.next_token_is_operator(",") {
        self.token_next();
        continue;
      }
      break;
    }

    self.split_angle_closer_token_if_needed();
    if self.next_token_is_operator(">") {
      let err = self.expect_op(">");
      if err.is_some() {
        ret err;
      }
    } else {
      let err = self.expect_sym('>');
      if err.is_some() {
        ret err;
      }
    }
    dt.generic_args = args;
    ret .None;
  }

  // Parses a function-type parameter's datatype: `fun(T1, T2, ...) R`.
  // Called from `parse_datatype` on a leading `fun` keyword. Fills
  // `dt.fn_sig` with the recursively-parsed params and return type, and
  // sets `type_str` to the fixed placeholder `"fun(...)"` since codegen
  // reads `fn_sig` directly. Gotcha: a bare identifier right after the
  // closing `)` is always consumed as the return type, so `fun(chr)
  // pred` with no return type misparses `pred` as one instead of
  // defaulting to `void`.
  pub parse_fn_type_datatype(DataType* dt) Option<ParseErrorKind> {
    self.token_next(); // consume 'fun'
    let operr = self.expect_op("(");
    if operr.is_some() {
      ret operr;
    }

    Vec<DataType*> params;
    params.init(0);
    for !self.next_token_is_symbol(')') {
      DataType* pdt = malloc(sizeof(DataType));
      *pdt = dtype_new();
      let perr = self.parse_datatype(pdt);
      if perr.is_some() {
        ret perr;
      }
      params.push(pdt);
      if !self.next_token_is_operator(",") {
        break;
      }
      self.token_next();
    }
    let cperr = self.expect_sym(')');
    if cperr.is_some() {
      ret cperr;
    }

    DataType* rtype = malloc(sizeof(DataType));
    *rtype = dtype_new();
    bin has_rtype_tok = false;
    fit self.token_peek_next() {
      .Some(t) -> {
        if t.type == .Identifier {
          has_rtype_tok = true;
        } else {
          if t.type == .Keyword {
            fit t.data {
              .Sval(s) -> {
                if keyword_is_datatype(s) {
                  has_rtype_tok = true;
                }
              }
              _ -> {}
            }
          }
        }
      }
      .None -> {}
    }
    if has_rtype_tok {
      let rerr = self.parse_datatype(rtype);
      if rerr.is_some() {
        ret rerr;
      }
    } else {
      rtype.kind = .Void;
      rtype.type_str = "void";
    }

    FnTypeSig sig = fn_type_sig_new();
    sig.params = params;
    sig.rtype = rtype;
    FnTypeSig* sig_ptr = malloc(sizeof(FnTypeSig));
    *sig_ptr = sig;

    dt.kind = .Unknown;
    dt.fn_sig = sig_ptr;
    dt.has_fn_sig = true;
    dt.type_str = "fun(...)";
    ret .None;
  }

  // Parses a type annotation into `dt`: a builtin scalar keyword or
  // user-defined/identifier-based name (optionally alias-qualified,
  // `mod.Type`), its generic arguments if any, then a trailing run of
  // `*` pointer-depth markers. A leading `fun` keyword delegates to
  // `parse_fn_type_datatype` instead. Trailing array-bracket suffixes
  // (`num[5]`, `str[]`) are handled separately by
  // `parse_array_brackets`, called explicitly by each site that allows
  // one.
  pub parse_datatype(DataType* dt) Option<ParseErrorKind> {
    if self.next_token_is_keyword("fun") {
      ret self.parse_fn_type_datatype(dt);
    }
    let tok = self.token_next();
    if tok.is_none() {
      self.err("expected datatype, got end of input");
      ret .Some(.InvalidDataType);
    }
    let dt_token = tok.unwrap();
    if dt_token.type != .Keyword && dt_token.type != .Identifier {
      self.err("expected datatype");
      ret .Some(.InvalidDataType);
    }

    str name = "";
    fit dt_token.data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    // Builtins use `dt.kind`; user-defined types keep `.Unknown` and rely
    // on `type_str`.
    if dt_token.type == .Keyword {
      if !keyword_is_datatype(name) {
        self.err(format("unexpected keyword '{str}' in datatype position", name));
        ret .Some(.InvalidDataType);
      }
      dt.kind = get_datatype_type(name);
      if dt.kind == .Unknown {
        self.err("unknown datatype");
        ret .Some(.InvalidDataType);
      }
    } else {
      // Identifier-based types (e.g. platform typedefs like `size_t`, or
      // a user compound/enum) are allowed. A small set of common typedef
      // names get tagged with a numeric semantic type so
      // arithmetic/comparisons typecheck, while still emitting the
      // original identifier via `type_str`.
      let builtin_kind = get_datatype_type(name);
      if builtin_kind != .Unknown {
        dt.kind = builtin_kind;
      } else {
        fit get_c_typedef_alias_datatype_type(name) {
          .Some(k) -> { dt.kind = k; }
          .None -> { dt.kind = .Unknown; }
        }
      }
    }
    dt.type_str = name;

    // Qualified user-defined types via module alias (`imp mod as m; m.Type`).
    // Mangled internally as `a__b` to match symbol/type naming.
    if dt_token.type == .Identifier {
      for self.next_token_is_operator(".") || self.next_token_is_symbol('.') {
        self.token_next();
        let seg = self.token_next();
        if seg.is_none() || seg.unwrap().type != .Identifier {
          self.err("expected identifier after '.' in qualified datatype");
          ret .Some(.InvalidDataType);
        }
        str seg_name = "";
        fit seg.unwrap().data {
          .Sval(s) -> { seg_name = s; }
          _ -> {}
        }
        dt.kind = .Unknown;
        dt.type_str = format("{str}__{str}", dt.type_str, seg_name);
      }
    }

    let gerr = self.parse_generic_type_args(dt);
    if gerr.is_some() {
      ret gerr;
    }

    let ptr_depth = self.parse_get_pointer_depth();
    if ptr_depth > 0 {
      dt.flags.is_pointer = true;
      dt.pointer_depth = ptr_depth;
    }

    ret .None;
  }

  // True if the `<...>` starting at the cursor looks like a type
  // parameter list (`<T>`, `<T: a | b>`) rather than concrete generic
  // arguments (`<num>`, `<Vec<str>>`). Pure lookahead, consumes nothing.
  // Used by `parse_impl` to distinguish `impl Vec<T> { ... }` (a new type
  // param) from `impl Vec<num> { ... }` (a concrete monomorphizing impl).
  // Every segment must be a bare identifier, optionally with `:
  // constraint | constraint` bounds, all the way to the closing `>`/`>>`.
  pub impl_generic_args_are_params() bin {
    num off = 0;
    let first_opt = self.token_peek_n(off);
    if first_opt.is_none() {
      ret false;
    }
    let first = first_opt.unwrap();
    if !(token_is_operator(first, "<") || token_is_symbol(first, '<')) {
      ret false;
    }
    off = off + 1;

    bin saw_any = false;
    for true {
      let tok_opt = self.token_peek_n(off);
      if tok_opt.is_none() {
        ret false;
      }
      if tok_opt.unwrap().type != .Identifier {
        ret false;
      }
      saw_any = true;
      off = off + 1;

      let next_opt = self.token_peek_n(off);
      if next_opt.is_none() {
        ret false;
      }
      let nt = next_opt.unwrap();

      if token_is_operator(nt, ":") {
        off = off + 1;
        for true {
          let ct_opt = self.token_peek_n(off);
          if ct_opt.is_none() {
            ret false;
          }
          let ct = ct_opt.unwrap();
          if ct.type == .Keyword || ct.type == .Identifier {
            off = off + 1;
          } else {
            ret false;
          }
          let sep_opt = self.token_peek_n(off);
          if sep_opt.is_none() {
            ret false;
          }
          if token_is_operator(sep_opt.unwrap(), "|") {
            off = off + 1;
            continue;
          }
          break;
        }
        let after_opt = self.token_peek_n(off);
        if after_opt.is_none() {
          ret false;
        }
        let after = after_opt.unwrap();
        if token_is_operator(after, ",") {
          off = off + 1;
          continue;
        }
        if token_is_operator(after, ">") || token_is_operator(after, ">>") ||
          token_is_symbol(
          after,
          '>'
        ) {
          ret saw_any;
        }
        ret false;
      }

      if token_is_operator(nt, ",") {
        off = off + 1;
        continue;
      }
      if token_is_operator(nt, ">") || token_is_operator(nt, ">>") || token_is_symbol(nt, '>') {
        ret saw_any;
      }
      ret false;
    }
  }

  // Returns the `token_peek_n` offset just past a `<...>` generic-
  // argument list starting at `off` (or `off` unchanged if there's no
  // `<` there). Pure lookahead, consumes nothing; used to look past a
  // possibly-generic type name (`Box<num>`) to see what follows it.
  pub skip_generic_args_tokens(num off) num {
    let first_opt = self.token_peek_n(off);
    if first_opt.is_none() || !token_is_operator(first_opt.unwrap(), "<") {
      ret off;
    }
    num cur = off;
    num depth = 0;
    for true {
      let tok_opt = self.token_peek_n(cur);
      if tok_opt.is_none() {
        ret cur;
      }
      let tok = tok_opt.unwrap();
      if token_is_operator(tok, "<") {
        depth = depth + 1;
        cur = cur + 1;
        continue;
      }
      if token_is_operator(tok, ">") {
        depth = depth - 1;
        cur = cur + 1;
        if depth == 0 {
          ret cur;
        }
        continue;
      }
      if token_is_operator(tok, ">>") {
        depth = depth - 2;
        cur = cur + 1;
        if depth <= 0 {
          ret cur;
        }
        continue;
      }
      cur = cur + 1;
    }
  }

  // True if the identifier at the cursor (position 0) is immediately
  // followed by `{`, once any generic-argument list (`<...>`) between them
  // is skipped over: the shape of a compound-literal initializer
  // (`Point{...}`, `Box<num>{...}`).
  pub looks_like_compound_init() bin {
    num off = self.skip_generic_args_tokens(1);
    let next_opt = self.token_peek_n(off);
    if next_opt.is_none() {
      ret false;
    }
    ret token_is_symbol(next_opt.unwrap(), '{');
  }

  // Same lookahead as `looks_like_compound_init`, but for a bare type
  // reference used as `sizeof(...)`'s sole argument (`sizeof(Trace<dec>)`).
  // The closing token is `)`, not `{`, since there's no literal body here.
  pub looks_like_sizeof_generic_type() bin {
    num off = self.skip_generic_args_tokens(1);
    if off == 1 {
      ret false;
    }
    let next_opt = self.token_peek_n(off);
    if next_opt.is_none() {
      ret false;
    }
    ret token_is_symbol(next_opt.unwrap(), ')');
  }

  // Consumes a run of `*` written after a type inside `sizeof(...)`, and
  // reports it as the stars to append to the type's own name. A pointer
  // is a type here rather than a multiplication, which is what the
  // expression parser would otherwise make of it.
  pub take_sizeof_pointer_stars() str {
    StringBuilder stars = string_builder_init(4);
    for true {
      let next_opt = self.token_peek_next();
      if next_opt.is_none() {
        break;
      }
      if !token_is_operator(next_opt.unwrap(), "*") {
        break;
      }
      // Only when what follows the run closes the call: anything else is
      // an ordinary multiplication and not part of the type.
      num ahead = 1;
      for true {
        let after_opt = self.token_peek_n(ahead);
        if after_opt.is_none() {
          ret stars.build();
        }
        if token_is_operator(after_opt.unwrap(), "*") {
          ahead = ahead + 1;
          continue;
        }
        break;
      }
      let closer_opt = self.token_peek_n(ahead);
      if closer_opt.is_none() || !token_is_symbol(closer_opt.unwrap(), ')') {
        break;
      }
      self.token_next();
      stars.append("*");
    }
    ret stars.build();
  }

  // Scans the whole token stream once for every top-level
  // `compound`/`enum`/`quirk` name, so a `Name{...}` initializer can
  // forward-reference a type declared later in the same file --
  // `is_known_compound_symbol` alone only sees symbols registered by the
  // point the cursor has reached. Guarded by `forward_type_names_scanned`
  // since `parse()` is the only real caller but tests construct a
  // `ParseState` directly and may re-enter parsing paths more than once.
  pub prescan_forward_type_names() {
    if self.forward_type_names_scanned {
      ret;
    }
    self.forward_type_names_scanned = true;
    num i = 0;
    for i < self.tokens.len {
      let t = self.tokens.get(i);
      i = i + 1;
      if !(token_is_keyword(t, "compound") || token_is_keyword(t, "enum") || token_is_keyword(
        t,
        "quirk"
      )) {
        continue;
      }
      num j = i;
      for j < self.tokens.len &&
        token_is_nl_or_comment_or_newline_separator(self.tokens.get(j)) {
        j = j + 1;
      }
      if j >= self.tokens.len {
        continue;
      }
      let name_tok = self.tokens.get(j);
      if name_tok.type != .Identifier {
        continue;
      }
      fit name_tok.data {
        .Sval(name) -> { self.forward_type_names.put(name, true); }
        _ -> {}
      }
    }
  }

  // True when `name` is a top-level `compound`/`enum`/`quirk` declared
  // anywhere in the file, per `prescan_forward_type_names`.
  pub is_forward_declared_type(str name) bin {
    ret self.forward_type_names.has(name);
  }

  // True if the identifier at the cursor is a known symbol resolving to a
  // `Compound` declaration, one of the conditions gating whether
  // `Name{...}`/`Name<T>{...}` parses as a compound-literal initializer.
  // Searches this file's symbols registered so far, then `global_symbols`;
  // a type declared later in the same file needs the separate
  // `is_forward_declared_type` check, kept apart since it recognizes
  // enum/quirk names too, which this deliberately doesn't.
  pub is_known_compound_symbol(str name) bin {
    let maybe_sym = self.get_symbol(name);
    if maybe_sym.is_some() {
      let maybe_node = get_node_symbol(maybe_sym.unwrap());
      if maybe_node.is_some() {
        fit maybe_node.unwrap().kind {
          .Compound(c) -> { ret true; }
          _ -> {}
        }
      }
    }
    if self.global_symbols.has(name) {
      ret self.global_symbols.get(name).is_compound;
    }
    ret false;
  }

  // True if the identifier at the cursor is a known symbol resolving to a
  // `Function` declaration -- one of the conditions gating whether
  // `name<T1,T2>(...)` parses as an explicit generic call rather than a
  // chained comparison. Mirrors `is_known_compound_symbol`.
  pub is_known_function(str name) bin {
    let maybe_sym = self.get_symbol(name);
    if maybe_sym.is_some() {
      let maybe_node = get_node_symbol(maybe_sym.unwrap());
      if maybe_node.is_some() {
        fit maybe_node.unwrap().kind {
          .Function(f) -> { ret true; }
          _ -> {}
        }
      }
    }
    if self.global_symbols.has(name) {
      ret self.global_symbols.get(name).is_function;
    }
    ret false;
  }
}

// The parser's state, layered on top of the shared `ParseState`: a pointer
// back to that shared state plus the fields that are genuinely
// parser-local (current body/function context for `binded` stamping,
// expression-recursion depth, `fit`-condition tracking).
pub compound Parser {
  ParseState* state;

  // The most recently consumed significant token.
  Token last_token;
  bin has_last_token;

  // The body/function node currently being parsed, used to stamp newly
  // created nodes' `binded` context (see `create_node`).
  Node* current_body;
  bin has_current_body;
  Node* current_function;
  bin has_current_function;

  // Current native-recursion depth of the recursive-descent expression
  // parser. Guards against stack-overflow crashes on pathological input.
  num expr_depth;

  // True while parsing a `fit` arm condition, where pattern bindings like
  // `Enum.Variant(x, y)` introduce new identifiers not yet in scope.
  bin in_fit_condition;

  // True for the entire duration of parsing a `fit` statement. Stops the
  // general expression loop from swallowing a following `->` as a binary
  // operator (it's only ever the fit-arm delimiter). Without this,
  // `fit x { 1 -> { a; } ...` over-consumes past `1` into the arm body.
  bin in_fit_statement;

  // True while parsing a bounded operand (`await expr`, `fork call`, a
  // channel receive `<-ch`) that must stop at the first binary operator:
  // `await f(x) + 1` is `(await f(x)) + 1`, not `await (f(x) + 1)`.
  // Postfix continuations (`(`, `[`, `.`) still continue the primary.
  bin stop_at_binary_op;

  // True while parsing a value expression that must stop at a top-level
  // comma rather than treating it as the comma operator, e.g. a
  // compound-literal field's value (`Point{ x = 1, y = 2 }`); without
  // this, `x`'s value would greedily consume `1, y = 2`. Unlike
  // `stop_at_binary_op`, this stops unconditionally; a comma nested
  // inside `(...)`/`[...]` is unaffected (`f(a, b)` still parses fully).
  bin stop_at_comma;

  // Explicit type arguments parsed right before a call's `(`
  // (`ok<num, Error>(42)`), waiting to be attached to the call's own
  // `ExprNode` once it is built. Nothing can intervene between consuming
  // `name<T1,T2>` and reaching its `(`, so this is always for the call
  // being built right after it is set.
  Vec<DataType*> pending_call_generic_args;
  bin has_pending_call_generic_args;
}

// Creates a new `Parser` over the given shared parse state.
pub fun parser_new(ParseState* state) Parser {
  Parser p;
  p.state = state;
  p.has_last_token = false;
  p.current_body = nil;
  p.has_current_body = false;
  p.current_function = nil;
  p.has_current_function = false;
  p.expr_depth = 0;
  p.in_fit_condition = false;
  p.in_fit_statement = false;
  p.stop_at_binary_op = false;
  p.stop_at_comma = false;
  p.pending_call_generic_args.init(0);
  p.has_pending_call_generic_args = false;
  ret p;
}

impl Parser {
  // Creates and registers a new node in the parse state's node list,
  // stamping its `binded` owner/function context from whatever body/
  // function is currently being parsed.
  pub create_node(Node* n) {
    BindedNode* binded = nil;
    bin is_bound = false;

    if self.has_current_body {
      Node* owner = malloc(sizeof(Node));
      *owner = *self.current_body;
      owner.has_binded = false;
      owner.binded = nil;
      binded = malloc(sizeof(BindedNode));
      binded.owner = owner;
      binded.has_owner = true;
      binded.function = nil;
      binded.has_function = false;
      is_bound = true;
    }

    if self.has_current_function {
      Node* function = malloc(sizeof(Node));
      *function = *self.current_function;
      function.has_binded = false;
      function.binded = nil;
      if !is_bound {
        binded = malloc(sizeof(BindedNode));
        binded.owner = nil;
        binded.has_owner = false;
      }
      binded.function = function;
      binded.has_function = true;
      is_bound = true;
    }

    if is_bound {
      n.binded = binded;
      n.has_binded = true;
    } else {
      n.binded = nil;
      n.has_binded = false;
    }

    self.state.nodes.push(*n);
  }

  // Consumes the next token and turns it into a single leaf AST node: a
  // number/character literal, an identifier, a string literal, or a
  // boolean literal. Anything else is an error. Handles only the primary
  // tokens of an expression; operators and grouping belong to the
  // expression parser built on top of this.
  pub parse_single_token_to_node() Option<ParseErrorKind> {
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected token, got eof");
      ret .Some(.InvalidToken);
    }
    let t = tok.unwrap();
    fit t.type {
      .Number -> {
        fit t.data {
          .Num(n) -> {
            Node node = node_new(.Number(.Num(n)));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          .Dec(d) -> {
            Node node = node_new(.Number(.Dec(d)));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          // A character literal lexes as a `Number`-type token carrying
          // `Cval` data (see lexer.fn's `_read_char`); it becomes a
          // `Character` AST node here, not a `Number` one.
          .Cval(c) -> {
            Node node = node_new(.Character(c));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {
            self.state.err("invalid number token");
            ret .Some(.InvalidToken);
          }
        }
      }
      .Identifier -> {
        str name = "";
        fit t.data {
          .Sval(s) -> { name = s; }
          _ -> {}
        }
        let prev = self.state.token_peek_prev();
        bin is_member_access = false;
        fit prev {
          .Some(p) -> { is_member_access = token_is_operator(p, "."); }
          .None -> {}
        }

        // Allow type operands inside `sizeof(Type)` even when the
        // identifier isn't declared as a value symbol yet (supports
        // forward-declared custom types).
        bin is_sizeof_type_operand = false;
        fit prev {
          .Some(p) -> {
            if token_is_operator(p, "(") {
              fit self.state.token_peek_prev_n(1) {
                .Some(p2) -> {
                  if p2.type == .Identifier {
                    fit p2.data {
                      .Sval(s2) -> { is_sizeof_type_operand = equals(s2, "sizeof"); }
                      _ -> {}
                    }
                  }
                }
                .None -> {}
              }
            }
          }
          .None -> {}
        }

        // `_` is a wildcard identifier (used by `fit` default branches),
        // accepted even when not declared. Otherwise an unknown
        // identifier is only valid as a member-access target, an
        // all-caps constant-style name, an out-of-order function call, a
        // possible enum member access (`Foo.Bar`), or inside a `fit`
        // condition (where pattern bindings aren't in scope yet).
        if !equals(name, "_") {
          if !is_member_access {
            if !is_sizeof_type_operand && self.state.get_scope_entity(name) == nil {
              if self.state.get_symbol(name).is_none() &&
                !self.state.global_symbols.has(name) {
                if !_is_c_macro_ident(name) {
                  bin is_possible_enum_member_access = self.state.next_token_is_operator(".");
                  if !self.state.next_token_is_operator("(") && !is_possible_enum_member_access &&
                    !self.in_fit_condition {
                    let msg = format("unknown identifier '{str}'", name);
                    defer free(msg);
                    self.state.err(msg);
                    ret .Some(.InvalidIdentifier);
                  }
                }
              }
            }
          }
        }

        // A pointer written inside `sizeof(...)` belongs to the type,
        // not to the expression around it.
        if is_sizeof_type_operand {
          StringBuilder named = string_builder_init(len(name) + 4);
          named.append(name);
          named.append(self.state.take_sizeof_pointer_stars());
          name = named.build();
        }

        Node node = node_new(.Identifier(name));
        node.pos = t.pos;
        node.has_pos = true;
        self.create_node(&node);
      }
      .String -> {
        fit t.data {
          .Sval(s) -> {
            Node node = node_new(.String(s));
            node.pos = t.pos;
            node.has_pos = true;
            node.flags.is_raw_string = t.is_raw_string;
            self.create_node(&node);
          }
          _ -> {}
        }
      }
      .Boolean -> {
        fit t.data {
          .Bval(b) -> {
            Node node = node_new(.Boolean(b));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {}
        }
      }
      _ -> {
        self.state.err("expected single token");
        ret .Some(.InvalidToken);
      }
    }
    ret .None;
  }

  // Builds a binary `Expression` node (`left_node op right_node`) and
  // pushes it via `create_node`. Copies both operands onto the heap so the
  // new node owns stable pointers to them.
  pub make_expression_node(Node* left_node, Node* right_node, str op, Pos op_pos) {
    Node* left = malloc(sizeof(Node));
    *left = *left_node;
    Node* right = malloc(sizeof(Node));
    *right = *right_node;

    ExprNode e = expr_node_new();
    e.left = left;
    e.has_left = true;
    e.right = right;
    e.has_right = true;
    e.op = op;

    Node node = node_new(.Expression(e));
    node.pos = op_pos;
    node.has_pos = true;
    self.create_node(&node);
  }

  // Desugars a channel operation into a method call and pushes it via
  // `create_node`: `<-ch` -> `ch.recv()` (`has_arg = false`, the call
  // argument becomes a `Blank`), `ch <- v` -> `ch.send(v)` (`has_arg =
  // true`). Builds `(recv.method)(arg)`, a `.` dot-expression wrapped in a
  // `()` call, the same AST shape a method call already has.
  _push_channel_method_call(Node* recv, str method_name, Node* arg, bin has_arg, Pos op_pos) {
    Node method_ident = node_new(.Identifier(method_name));
    method_ident.pos = op_pos;
    method_ident.has_pos = true;
    method_ident.flags.inside_expression = true;

    self.make_expression_node(recv, &method_ident, ".", op_pos);
    Node dot = node_new(.Blank);
    fit self.state.node_pop() {
      .Some(built) -> { dot = built; }
      .None -> { ret; }
    }

    Node call_arg = node_new(.Blank);
    if has_arg {
      call_arg = *arg;
    }
    call_arg.pos = op_pos;
    call_arg.has_pos = true;

    self.make_expression_node(&dot, &call_arg, "()", op_pos);
  }

  // Parses a compound-literal initializer body `{ field = value, ... }`
  // and pushes a `CompoundInit` node: `Type{...}` when `has_dt` (`dt`
  // already parsed by the caller), or `.{...}` when not (`dt` unused).
  // `pos`/`has_pos` is the node's own position, chosen by the caller,
  // falling back to the `{` token's position when it has none.
  pub parse_compound_init(DataType* dt, bin has_dt, Pos pos, bin has_pos) Option<ParseErrorKind> {
    let lbrace_tok = self.state.token_peek_next();
    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<CompoundInitField> fields;
    fields.init(0);

    for !self.state.next_token_is_symbol('}') {
      let field_tok = self.state.token_next();
      if field_tok.is_none() || field_tok.unwrap().type != .Identifier {
        self.state.err("expected field name in compound initializer");
        ret .Some(.InvalidIdentifier);
      }
      str fname = "";
      fit field_tok.unwrap().data {
        .Sval(s) -> { fname = s; }
        _ -> {}
      }

      let eqerr = self.state.expect_op("=");
      if eqerr.is_some() {
        ret eqerr;
      }

      // Stop the value expression at a top-level comma so it terminates
      // at this field's own separator rather than greedily consuming the
      // next field (`x = 1, y = 2` must not become `x = (1, y = 2)` via
      // the comma operator). See `Parser.stop_at_comma`'s doc comment.
      let prev_stop_comma = self.stop_at_comma;
      self.stop_at_comma = true;
      let verr = self.parse_expressionable_root();
      self.stop_at_comma = prev_stop_comma;
      if verr.is_some() {
        ret verr;
      }
      let maybe_val = self.state.node_pop();
      if maybe_val.is_none() {
        self.state.err("expected field value in compound initializer");
        ret .Some(.InvalidExpression);
      }
      Node* val = malloc(sizeof(Node));
      *val = maybe_val.unwrap();

      CompoundInitField f;
      f.name = fname;
      f.value = val;
      fields.push(f);

      if self.state.next_token_is_operator(",") {
        self.state.token_next();
        if self.state.next_token_is_symbol('}') {
          break;
        }
        continue;
      }
      break;
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    CompoundInitNode ci = compound_init_node_new();
    ci.init_dtype = dt;
    ci.has_dtype = has_dt;
    ci.fields = fields;

    Node node = node_new(.CompoundInit(ci));
    if has_pos {
      node.pos = pos;
      node.has_pos = true;
    } else {
      fit lbrace_tok {
        .Some(t) -> {
          node.pos = t.pos;
          node.has_pos = true;
        }
        .None -> {}
      }
    }
    self.state.nodes.push(node);
    ret .None;
  }

  // Rewrites `node = (a op1 (b op2 c))` in place to `((a op1 b) op2 c)`: a
  // left tree rotation used by `parse_reorder_expression` to fix
  // precedence when `op1` should bind tighter than (or equal to) `op2`
  // but the naive left-to-right build produced the right-heavy shape. A
  // no-op when the right child isn't an `Expression` or either side is
  // missing. Structurally identical to
  // `parse_node_move_right_left_to_left` below, kept separate because each
  // has its own trigger condition in `parse_reorder_expression`.
  pub parse_node_shift_children_left(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_right || !exp.has_left {
          ret;
        }
        fit exp.right.kind {
          .Expression(right_exp) -> {
            if !right_exp.has_left || !right_exp.has_right {
              ret;
            }
            ExprNode new_left_e = expr_node_new();
            new_left_e.left = exp.left;
            new_left_e.has_left = true;
            new_left_e.right = right_exp.left;
            new_left_e.has_right = true;
            new_left_e.op = exp.op;

            Node* new_left = malloc(sizeof(Node));
            *new_left = node_new(.Expression(new_left_e));
            new_left.pos = node.pos;
            new_left.has_pos = true;

            exp.left = new_left;
            exp.right = right_exp.right;
            exp.op = right_exp.op;
            node.kind = .Expression(exp);
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // The same `(a op1 (b op2 c))` -> `((a op1 b) op2 c)` rotation as
  // `parse_node_shift_children_left`, used by `parse_reorder_expression`'s
  // other trigger condition: an array-index/call/index left operand
  // paired with an assignment/comma right operand.
  pub parse_node_move_right_left_to_left(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_right || !exp.has_left {
          ret;
        }
        fit exp.right.kind {
          .Expression(right_exp) -> {
            if !right_exp.has_left || !right_exp.has_right {
              ret;
            }
            ExprNode completed_e = expr_node_new();
            completed_e.left = exp.left;
            completed_e.has_left = true;
            completed_e.right = right_exp.left;
            completed_e.has_right = true;
            completed_e.op = exp.op;

            Node* completed = malloc(sizeof(Node));
            *completed = node_new(.Expression(completed_e));
            completed.pos = node.pos;
            completed.has_pos = true;

            exp.left = completed;
            exp.right = right_exp.right;
            exp.op = right_exp.op;
            node.kind = .Expression(exp);
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // Recursively reorders `node` and its descendants for correct operator
  // precedence, after the naive left-to-right expression build. Applies two
  // independent fixups. First, when the right child is an `Expression` the
  // outer operator has priority over (binds tighter, or equal with
  // left-to-right associativity), rotate left and recurse into both new
  // children, since one rotation isn't always enough for a longer chain
  // (`a + b * c * d` needs two). Second, when the left operand is an array
  // index paired with an assignment on the right, or a call/index operand
  // paired with a comma expression, `parse_node_move_right_left_to_left`
  // fixes that shape.
  pub parse_reorder_expression(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_left || !exp.has_right {
          ret;
        }

        bin left_is_expr = _is_expression_kind(exp.left);
        bin right_is_expr = _is_expression_kind(exp.right);
        if !left_is_expr && !right_is_expr {
          ret;
        }

        if right_is_expr {
          fit exp.right.kind {
            .Expression(right_exp) -> {
              if left_has_priority(exp.op, right_exp.op) {
                self.parse_node_shift_children_left(node);
                fit node.kind {
                  .Expression(rotated) -> {
                    self.parse_reorder_expression(rotated.left);
                    self.parse_reorder_expression(rotated.right);
                  }
                  _ -> {}
                }
              }
            }
            _ -> {}
          }
        }

        // Re-read node.kind: the rotation above (if it ran) mutated it.
        fit node.kind {
          .Expression(exp2) -> {
            bin left_is_array = node_is_array(*exp2.left);
            bin right_is_assign = node_is_assignment(*exp2.right);
            bin left_is_call_or_index = node_is_expression(*exp2.left, "()") ||
              node_is_expression(
              *exp2.left,
              "[]"
            );
            bin right_is_comma = node_is_expression(*exp2.right, ",");
            if (left_is_array && right_is_assign) || (left_is_call_or_index && right_is_comma) {
              self.parse_node_move_right_left_to_left(node);
            }
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // The last node on the output list, if it's still a valid expression
  // operand (a literal/identifier/unary/nested-expression rather than, say,
  // a just-finished statement). `.None` when the list is empty or the last
  // node isn't operand-shaped. Used to tell a binary operator, continuing a
  // left operand already on the stack, from a prefix/unary position.
  pub node_peek_expressionable() Option<Node> {
    fit self.state.node_peek_last() {
      .Some(n) -> {
        if node_is_expressionable(n) {
          ret .Some(n);
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Parses a single "expressionable" token into a node and pushes it:
  // literals, identifiers, and strings via `parse_single_token_to_node`, an
  // operator token via `parse_expression` (grouping or a binary
  // continuation). Any other token kind is not an error here; it just means
  // there's nothing more to parse at this position, signaled by leaving the
  // output list unchanged (`parse_expressionable` loops on exactly that).
  // `sizeof` isn't a keyword, so `sizeof(Type)` takes the ordinary call path
  // with a callee named `sizeof`.
  pub parse_expressionable_single() Option<ParseErrorKind> {
    // Each nesting level costs several native frames, so pathological
    // input (deeply nested parentheses, very long operator chains) would
    // otherwise overflow the stack instead of reporting an error.
    if self.expr_depth >= max_parse_expr_depth {
      self.state.err("expression nests too deeply to parse");
      ret .Some(.InvalidExpression);
    }
    self.expr_depth = self.expr_depth + 1;
    defer self.expr_depth = self.expr_depth - 1;
    fit self.state.token_peek_next() {
      .Some(t) -> {
        // A `fit` arm's comma-separated multi-pattern list only supports
        // string-literal patterns, not bare enum-variant shorthand
        // (`.A, .B -> {}` fails to parse where `"a", "b" -> {}` works).
        if t.type == .Number || t.type == .Boolean ||
        t.type == .String {
          ret self.parse_single_token_to_node();
        }
        if t.type == .Identifier {
          // Named compound-literal initializer: `Point{...}`/`Box<num>{...}`.
          // Requires the identifier to resolve to a known `Compound`
          // symbol, to not be a value already in scope (a local shadowing
          // a compound name), and to not follow a `.`, since a qualified
          // reference like `.Symbol` is never a compound-init
          // target.
          str name = "";
          fit t.data {
            .Sval(s) -> { name = s; }
            _ -> {}
          }
          bin after_member_access = false;
          fit self.state.token_peek_prev_stream_n(0) {
            .Some(p) -> { after_member_access = token_is_operator(p, "."); }
            .None -> {}
          }
          bin is_value_in_scope = self.state.get_scope_entity(name) != nil;
          bin is_known_or_forward_type = self.state.is_known_compound_symbol(name) ||
            self.state.is_forward_declared_type(name);
          if !after_member_access && !is_value_in_scope && is_known_or_forward_type &&
            self.state.looks_like_compound_init() {
            DataType* dt = malloc(sizeof(DataType));
            *dt = dtype_new();
            let dterr = self.state.parse_datatype(dt);
            if dterr.is_some() {
              ret dterr;
            }
            ret self.parse_compound_init(dt, true, t.pos, true);
          }
          // In `sizeof(Generic<T>)`, an identifier preceded by `sizeof(`
          // and followed by generic args that land on the closing `)`
          // parses as a bare type reference, since the normal path would
          // read `Trace < dec >` as a comparison chain instead. The type
          // reference rides in a `.CompoundInit` node with zero fields,
          // which `emit_call`'s `sizeof` case reads back structurally.
          bin in_sizeof_ctx = false;
          fit self.state.token_peek_prev_stream_n(0) {
            .Some(p) -> {
              if token_is_operator(p, "(") {
                fit self.state.token_peek_prev_stream_n(1) {
                  .Some(p2) -> {
                    if p2.type == .Identifier {
                      fit p2.data {
                        .Sval(s2) -> { in_sizeof_ctx = equals(s2, "sizeof"); }
                        _ -> {}
                      }
                    }
                  }
                  .None -> {}
                }
              }
            }
            .None -> {}
          }
          if !after_member_access && in_sizeof_ctx &&
            self.state.looks_like_sizeof_generic_type() {
            DataType* sdt = malloc(sizeof(DataType));
            *sdt = dtype_new();
            let sderr = self.state.parse_datatype(sdt);
            if sderr.is_some() {
              ret sderr;
            }
            CompoundInitNode ci = compound_init_node_new();
            ci.init_dtype = sdt;
            ci.has_dtype = true;
            Node ci_node = node_new(.CompoundInit(ci));
            ci_node.pos = t.pos;
            ci_node.has_pos = true;
            self.create_node(&ci_node);
            ret .None;
          }
          // Explicit generic type arguments on a free-function call,
          // `ok<num, MyErrorKind>(42)` -- for a type param that has no
          // argument value to infer it from (e.g. an `E` used only in the
          // return type). Gated tightly (not a known local value, not
          // right after `.`, and the base name is a known function) so an
          // ordinary chained comparison like `a < b > (c)` is never
          // misread: that shape requires BOTH operands to be real runtime
          // values, which a function name never is. The cheap checks run
          // first: `skip_generic_args_tokens` below is a forward scan
          // that can run the length of the file when there's no closing
          // `>` nearby, so it must not run for every ordinary identifier,
          // only the rare ones that are already known functions.
          bin could_be_generic_call = !after_member_access && !is_value_in_scope &&
            self.state.is_known_function(name);
          bin looks_like_generic_call = false;
          if could_be_generic_call {
            num after_generic = self.state.skip_generic_args_tokens(1);
            if after_generic != 1 {
              let next_after_generic = self.state.token_peek_n(after_generic);
              if next_after_generic.is_some() &&
                token_is_operator(
                next_after_generic.unwrap(),
                "("
              ) {
                looks_like_generic_call = true;
              }
            }
          }
          if could_be_generic_call && looks_like_generic_call {
            let identerr = self.parse_single_token_to_node();
            if identerr.is_some() {
              ret identerr;
            }
            DataType* scratch_dt = malloc(sizeof(DataType));
            *scratch_dt = dtype_new();
            let gaerr = self.state.parse_generic_type_args(scratch_dt);
            if gaerr.is_some() {
              ret gaerr;
            }
            self.pending_call_generic_args = scratch_dt.generic_args;
            self.has_pending_call_generic_args = true;
            ret .None;
          }
          ret self.parse_single_token_to_node();
        }
        if t.type == .Operator {
          // A top-level comma stops a bounded value expression (a
          // compound-literal field's value) rather than being treated as
          // the comma operator. See `Parser.stop_at_comma`'s doc comment.
          if self.stop_at_comma && token_is_operator(t, ",") {
            ret .None;
          }
          // `->` is only ever the fit-arm delimiter, never a real
          // expression operator, so inside a fit statement treat it as
          // "nothing more to parse here" rather than a binary
          // continuation. See `Parser.in_fit_statement`'s doc comment.
          if self.in_fit_statement && token_is_operator(t, "->") {
            ret .None;
          }
          // For a bounded operand (`await`/`fork`/channel receive): once
          // a primary has been parsed, a following binary operator ends
          // it, so `await f(x) + 1` parses as `(await f(x)) + 1`. Postfix
          // continuations (`(`, `[`, `.`) and the `<-` receive prefix
          // aren't binary-only, so they still continue the primary. See
          // `Parser.stop_at_binary_op`'s doc comment.
          if self.stop_at_binary_op && is_binary_only_operator(t) &&
            self.node_peek_expressionable().is_some() {
            ret .None;
          }
          ret self.parse_expression();
        }
        if t.type == .Keyword {
          str kw = "";
          fit t.data {
            .Sval(s) -> { kw = s; }
            _ -> {}
          }
          // `nil`/`panic(...)`/`await` as primary expression operands, so
          // they compose with surrounding operators/contexts (e.g.
          // `x != nil && y`, `let y = panic("msg");`, `let z = await
          // f();`), not just as their own bare statement.
          if equals(kw, "nil") {
            self.state.token_next(); // consume 'nil'
            Node node = node_new(.Nil);
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
            ret .None;
          }
          if equals(kw, "panic") {
            ret self.parse_panic_expr();
          }
          if equals(kw, "await") {
            ret self.parse_await_operand();
          }
          // A builtin scalar type keyword as the sole operand of
          // `sizeof(...)` is a type keyword token rather than a value
          // expression, so it needs its own primary-expression case: an
          // `.Identifier` node carrying the keyword's text, which
          // `emit_call`'s `sizeof`-callee case maps to the real C type.
          // Gated like `is_sizeof_type_operand`, on being preceded by a
          // `(` whose own preceding token is the identifier `sizeof`.
          if keyword_is_datatype(kw) {
            bin in_sizeof = false;
            // `t` hasn't been consumed yet, so `token_peek_prev_stream_n`
            // (relative to the next token still to be consumed) is the
            // correct lookup here, not `token_peek_prev`/`token_peek_prev_n`
            // (relative to the most recently consumed token).
            fit self.state.token_peek_prev_stream_n(0) {
              .Some(p) -> {
                if token_is_operator(p, "(") {
                  fit self.state.token_peek_prev_stream_n(1) {
                    .Some(p2) -> {
                      if p2.type == .Identifier {
                        fit p2.data {
                          .Sval(s2) -> { in_sizeof = equals(s2, "sizeof"); }
                          _ -> {}
                        }
                      }
                    }
                    .None -> {}
                  }
                }
              }
              .None -> {}
            }
            if in_sizeof {
              self.state.token_next(); // consume the type keyword
              StringBuilder named = string_builder_init(8);
              named.append(kw);
              named.append(self.state.take_sizeof_pointer_stars());
              str operand = named.build();
              Node node = node_new(.Identifier(operand));
              node.pos = t.pos;
              node.has_pos = true;
              self.create_node(&node);
              ret .None;
            }
          }
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Repeatedly parses expressionable tokens until a call makes no further
  // progress (the output list stops growing) or an error occurs.
  pub parse_expressionable() Option<ParseErrorKind> {
    for true {
      num before = self.state.nodes.len;
      let err = self.parse_expressionable_single();
      if err.is_some() {
        ret err;
      }
      if self.state.nodes.len == before {
        ret .None;
      }
    }
  }

  // Like `parse_expressionable`, but requires at least one node to have
  // been produced: the entry point for a position that must be an
  // expression, such as an initializer or a condition.
  pub parse_expressionable_root() Option<ParseErrorKind> {
    num before = self.state.nodes.len;
    let err = self.parse_expressionable();
    if err.is_some() {
      ret err;
    }
    if self.state.nodes.len == before {
      self.state.err("expected expression");
      ret .Some(.InvalidExpression);
    }
    ret .None;
  }

  // If the next token is an operator, parses another full expressionable
  // continuation (used after a primary/postfix form to pick up whatever
  // binary operator follows, e.g. after closing a parenthesized group).
  pub parse_additional_expression() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        if t.type == .Operator {
          ret self.parse_expressionable();
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Parses a parenthesized group `(...)`. If a value was already sitting on
  // the output list right before the `(` (e.g. an already-parsed callee
  // identifier), it's popped and combined with the parenthesized contents
  // into a `()`-op call `Expression` node, which is how function and method
  // calls are represented. Otherwise the parenthesized contents become a
  // plain `ExpressionParenthesis` grouping node. Either way, finishes by
  // picking up any further operator continuation.
  pub parse_for_parenthesis() Option<ParseErrorKind> {
    let lparen_err = self.state.expect_op("(");
    if lparen_err.is_some() {
      ret lparen_err;
    }

    Node left_node = node_new(.Blank);
    bin has_left_node = false;
    fit self.state.node_peek_last() {
      .Some(n) -> {
        if node_is_value_type(n) {
          left_node = n;
          has_left_node = true;
          self.state.node_pop();
        }
      }
      .None -> {}
    }

    Node exp_node = node_new(.Blank);
    if !self.state.next_token_is_symbol(')') {
      // A parenthesized sub-expression is a fresh context: an inner
      // binary operator or comma is never bounded by an enclosing
      // `await <call>` operand or compound-init field value. Clear both
      // flags so `await (a + b)` and `f(a, b)` parse fully, then restore
      // whatever the caller had.
      let prev_stop_binary = self.stop_at_binary_op;
      let prev_stop_comma = self.stop_at_comma;
      self.stop_at_binary_op = false;
      self.stop_at_comma = false;
      let err = self.parse_expressionable_root();
      self.stop_at_binary_op = prev_stop_binary;
      self.stop_at_comma = prev_stop_comma;
      if err.is_some() {
        ret err;
      }
      fit self.state.node_pop() {
        .Some(n) -> { exp_node = n; }
        .None -> {}
      }
    }

    let rparen_err = self.state.expect_sym(')');
    if rparen_err.is_some() {
      ret rparen_err;
    }

    Node* exp = malloc(sizeof(Node));
    *exp = exp_node;
    Node paren_node = node_new(.ExpressionParenthesis(exp));
    self.create_node(&paren_node);

    if has_left_node {
      fit self.state.node_pop() {
        .Some(popped_paren) -> {
          Node* left = malloc(sizeof(Node));
          *left = left_node;
          Node* right = malloc(sizeof(Node));
          *right = popped_paren;

          ExprNode call_e = expr_node_new();
          call_e.left = left;
          call_e.has_left = true;
          call_e.right = right;
          call_e.has_right = true;
          call_e.op = "()";
          // Explicit type args parsed right before this `(` (see the
          // `looks_like_generic_call` branch in `parse_expressionable_single`)
          // belong to THIS call -- nothing can intervene between consuming
          // `name<T1,T2>` and reaching its `(`, so the pending slot is
          // always for the call being built right here.
          if self.has_pending_call_generic_args {
            call_e.generic_args = self.pending_call_generic_args;
            call_e.has_generic_args = true;
            self.has_pending_call_generic_args = false;
          }
          Node call_node = node_new(.Expression(call_e));
          call_node.pos = left_node.pos;
          call_node.has_pos = left_node.has_pos;
          self.create_node(&call_node);
        }
        .None -> {}
      }
    }

    ret self.parse_additional_expression();
  }

  // Parses `[...]`: array indexing when a valid expressionable left
  // operand already exists (`arr[i]` -> `Expression{ left = arr, right =
  // Bracket(i), op = "[]" }`), or an array literal otherwise (just the
  // bare `Bracket` node, e.g. `[1, 2, 3]`).
  pub parse_for_bracket() Option<ParseErrorKind> {
    Node left_node = node_new(.Blank);
    bin has_left_node = false;
    fit self.node_peek_expressionable() {
      .Some(n) -> {
        left_node = n;
        has_left_node = true;
        self.state.node_pop();
      }
      .None -> {}
    }

    let lbracket_tok = self.state.token_peek_next();
    let lberr = self.state.expect_op("[");
    if lberr.is_some() {
      ret lberr;
    }

    // Inside `[...]`, a comma separates array elements rather than
    // terminating the enclosing context, and an inner binary operator
    // isn't bounded by an enclosing `await`/`fork` operand either. Clear
    // both so a multi-element array literal parses fully, e.g. the field
    // value in `Row{ cols = [1, 2, 3] }`.
    let prev_stop_comma = self.stop_at_comma;
    let prev_stop_binary = self.stop_at_binary_op;
    self.stop_at_comma = false;
    self.stop_at_binary_op = false;
    let eerr = self.parse_expressionable_root();
    self.stop_at_comma = prev_stop_comma;
    self.stop_at_binary_op = prev_stop_binary;
    if eerr.is_some() {
      ret eerr;
    }

    let rberr = self.state.expect_sym(']');
    if rberr.is_some() {
      ret rberr;
    }

    let maybe_inner = self.state.node_pop();
    if maybe_inner.is_none() {
      self.state.err("expected an expression inside '[...]'");
      ret .Some(.InvalidExpression);
    }
    Node* inner = malloc(sizeof(Node));
    *inner = maybe_inner.unwrap();

    Node bracket_node = node_new(.Bracket(inner));
    let lb = lbracket_tok.unwrap();
    bracket_node.pos = lb.pos;
    bracket_node.has_pos = true;
    self.create_node(&bracket_node);

    if has_left_node {
      fit self.state.node_pop() {
        .Some(popped_bracket) -> {
          self.make_expression_node(&left_node, &popped_bracket, "[]", lb.pos);
        }
        .None -> {}
      }
    }

    ret self.parse_additional_expression();
  }

  // Parses a pointer-indirection unary (`*p`, `**pp`): a run of `*`s
  // (the pointer depth being dereferenced) followed by the operand
  // expression. Kept separate from `parse_for_normal_unary` because a
  // following run of `*`s is a pointer-depth count, not a chain of
  // separately-nested unary `Expression`/`Unary` operators.
  pub parse_for_indirection_unary() Option<ParseErrorKind> {
    let star_tok = self.state.token_peek_next();
    let depth = self.state.parse_get_pointer_depth();

    // Bound the operand (`stop_at_binary_op`) so a following binary
    // operator ends it instead of being swallowed into the operand:
    // `*buf = 10` must parse as `(*buf) = 10`, not `*(buf = 10)`, which
    // would silently change what gets assigned. The same bounding is used
    // for prefix channel receive (`<-ch + 1` -> `(<-ch) + 1`).
    let prev_stop_binary = self.stop_at_binary_op;
    self.stop_at_binary_op = true;
    let err = self.parse_expressionable();
    self.stop_at_binary_op = prev_stop_binary;
    if err.is_some() {
      ret err;
    }
    let maybe_operand = self.state.node_pop();
    if maybe_operand.is_none() {
      self.state.err("expected operand for pointer indirection");
      ret .Some(.InvalidOperand);
    }
    Node operand_val = maybe_operand.unwrap();
    Node* operand = malloc(sizeof(Node));
    *operand = operand_val;

    UnaryNode u;
    u.is_left_operanded_unary = false;
    u.op = "*";
    u.operand = operand;
    u.has_indirection = true;
    u.indirection_depth = depth;

    Node unode = node_new(.Unary(u));
    fit star_tok {
      .Some(t) -> {
        unode.pos = t.pos;
        unode.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&unode);
    ret .None;
  }

  // Parses a non-indirection prefix unary (`-x`, `!x`, `~x`, `&x`, `++x`,
  // `--x`): consumes the operator, parses its operand, and wraps it in a
  // `Unary` node.
  pub parse_for_normal_unary() Option<ParseErrorKind> {
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected unary operator");
      ret .Some(.InvalidOperand);
    }
    let unary_tok = tok.unwrap();
    str unary_op = "";
    fit unary_tok.data {
      .Sval(s) -> { unary_op = s; }
      _ -> {}
    }

    // Bound the operand the same way `parse_for_indirection_unary` does:
    // `-x = 10` must not swallow a following binary operator or a
    // top-level comma into the operand. `is_binary_only_operator` covers
    // both, so a single `stop_at_binary_op` bound handles it.
    let prev_stop_binary = self.stop_at_binary_op;
    self.stop_at_binary_op = true;
    let err = self.parse_expressionable();
    self.stop_at_binary_op = prev_stop_binary;
    if err.is_some() {
      ret err;
    }
    let maybe_operand = self.state.node_pop();
    if maybe_operand.is_none() {
      let msg = format("expected operand for unary operator '{str}'", unary_op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(.InvalidOperand);
    }
    Node operand_val = maybe_operand.unwrap();
    Node* operand = malloc(sizeof(Node));
    *operand = operand_val;

    UnaryNode u;
    u.is_left_operanded_unary = false;
    u.op = unary_op;
    u.operand = operand;
    u.has_indirection = false;
    u.indirection_depth = 0;

    Node unode = node_new(.Unary(u));
    unode.pos = unary_tok.pos;
    unode.has_pos = true;
    self.create_node(&unode);
    ret .None;
  }

  // Parses a prefix unary expression, routing indirection (`*p`) to its own
  // parser (a following `*` run is a pointer-depth count, not a normal
  // operand parse) and picking up any further operator continuation
  // afterward (e.g. `-x + 1`).
  pub parse_for_unary() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("expected unary operator");
      ret .Some(.InvalidOperand);
    }
    str unary_op = "";
    fit tok.unwrap().data {
      .Sval(s) -> { unary_op = s; }
      _ -> {}
    }
    if is_indirection_operator(unary_op) {
      let ind_err = self.parse_for_indirection_unary();
      if ind_err.is_some() {
        ret ind_err;
      }
      ret self.parse_additional_expression();
    }
    let err = self.parse_for_normal_unary();
    if err.is_some() {
      ret err;
    }
    ret self.parse_additional_expression();
  }

  // Wraps an already-parsed left operand in a postfix `Unary` node
  // (`x++`/`x--`) instead of treating the operator as a binary continuation.
  pub parse_for_left_operanded_unary(Node* node_left, str unary_op, Pos op_pos) Option<ParseErrorKind> {
    UnaryNode u;
    u.is_left_operanded_unary = true;
    u.op = unary_op;
    u.operand = node_left;
    u.has_indirection = false;
    u.indirection_depth = 0;

    Node unode = node_new(.Unary(u));
    unode.pos = op_pos;
    unode.has_pos = true;
    self.create_node(&unode);

    // `node_left` was already popped by the caller, so this call's net
    // effect on the node stack is zero growth. The outer
    // `parse_expressionable` loop gates on net growth, so without
    // continuing here explicitly it would stop and silently drop a
    // following operator (`x++ + 1` would never see the `+ 1`).
    ret self.parse_additional_expression();
  }

  // Dispatches on the next token to the right expression-shape parser:
  // `(` starts a parenthesized group or call, `[` starts an array literal
  // or indexing (`parse_for_bracket`), and everything else is a
  // binary-operator continuation via `parse_normal_expression`. That
  // includes `,`, which is an ordinary very-low-precedence binary operator
  // rather than a dedicated comma-expression form.
  pub parse_expression() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        bin is_lparen = false;
        bin is_lbracket = false;
        fit t.data {
          .Sval(s) -> {
            is_lparen = equals(s, "(");
            is_lbracket = equals(s, "[");
          }
          _ -> {}
        }
        if is_lparen {
          ret self.parse_for_parenthesis();
        }
        if is_lbracket {
          ret self.parse_for_bracket();
        }
        ret self.parse_normal_expression();
      }
      .None -> { ret .None; }
    }
  }

  // Parses a binary-operator continuation, a prefix unary (when no left
  // operand precedes the operator), or a postfix unary (`x++`/`x--`, when
  // one does). The binary case consumes the operator, parses its RHS,
  // combines it with the left operand already on the output list into an
  // `Expression` node, then fixes precedence via
  // `parse_reorder_expression`. That RHS must be a parenthesized group or
  // another `parse_expressionable` continuation; a unary RHS like `a + -b`
  // is not supported.
  pub parse_normal_expression() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("expected operator in expression");
      ret .Some(.InvalidExpression);
    }
    let t = tok.unwrap();
    str op = "";
    fit t.data {
      .Sval(s) -> { op = s; }
      _ -> {}
    }
    let op_pos = t.pos;

    let maybe_left = self.node_peek_expressionable();
    if maybe_left.is_none() {
      // Type-inferred compound-literal shorthand: `.{ field = value, ... }`
      // (the type comes from context, e.g. the declared type of a
      // `let`/assignment/return position, and isn't resolved here).
      bin next_is_lbrace = false;
      fit self.state.token_peek_n(1) {
        .Some(nt) -> { next_is_lbrace = token_is_symbol(nt, '{'); }
        .None -> {}
      }
      if equals(op, ".") && next_is_lbrace {
        self.state.token_next(); // consume '.'
        DataType* no_dt = malloc(sizeof(DataType));
        *no_dt = dtype_new();
        ret self.parse_compound_init(no_dt, false, op_pos, true);
      }
      // Enum-variant shorthand (`.Variant`, `.Variant(payload)`): parsed as
      // a `.` dot-expression with a blank left side, so later passes can
      // resolve it using the expected enum type from context. A following
      // `(...)` (a payload) is picked up afterward by the general postfix
      // continuation, same as any other primary.
      if equals(op, ".") {
        self.state.token_next(); // consume '.'
        let idtok = self.state.token_next();
        if idtok.is_none() || idtok.unwrap().type != .Identifier {
          self.state.err("expected identifier after '.'");
          ret .Some(.InvalidIdentifier);
        }
        let idt = idtok.unwrap();
        str variant_name = "";
        fit idt.data {
          .Sval(s) -> { variant_name = s; }
          _ -> {}
        }
        Node right = node_new(.Identifier(variant_name));
        right.pos = idt.pos;
        right.has_pos = true;
        right.flags.inside_expression = true;

        Node left = node_new(.Blank);
        left.pos = op_pos;
        left.has_pos = true;
        left.flags.inside_expression = true;

        self.make_expression_node(&left, &right, ".", op_pos);
        fit self.state.node_pop() {
          .Some(built) -> {
            Node shorthand = built;
            self.parse_reorder_expression(&shorthand);
            self.state.nodes.push(shorthand);
          }
          .None -> {
            self.state.err("expected expression node");
            ret .Some(.InvalidExpression);
          }
        }
        ret self.parse_additional_expression();
      }
      // Prefix channel receive: `<-ch` -> `ch.recv()`. The operand parse
      // is bounded (`stop_at_binary_op`) so a following binary op ends
      // it: `<-ch + 1` is `(<-ch) + 1`.
      if equals(op, "<-") {
        self.state.token_next(); // consume '<-'
        num before = self.state.nodes.len;
        let prev_stop = self.stop_at_binary_op;
        self.stop_at_binary_op = true;
        let cherr = self.parse_expressionable();
        self.stop_at_binary_op = prev_stop;
        if cherr.is_some() {
          ret cherr;
        }
        if self.state.nodes.len == before {
          self.state.err("expected a channel after '<-'");
          ret .Some(.InvalidExpression);
        }
        let maybe_ch = self.state.node_pop();
        if maybe_ch.is_none() {
          self.state.err("expected a channel after '<-'");
          ret .Some(.InvalidExpression);
        }
        Node ch_node = maybe_ch.unwrap();
        Node no_arg = node_new(.Blank);
        self._push_channel_method_call(&ch_node, "recv", &no_arg, false, op_pos);
        ret .None;
      }
      if is_unary_operator(op) {
        ret self.parse_for_unary();
      }
      let msg = format("expected left operand for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(.InvalidOperand);
    }
    Node node_left = maybe_left.unwrap();

    self.state.token_next();
    self.state.node_pop();

    if is_left_operanded_unary_operator(op) {
      Node* left_ptr = malloc(sizeof(Node));
      *left_ptr = node_left;
      ret self.parse_for_left_operanded_unary(left_ptr, op, op_pos);
    }

    let tok2 = self.state.token_peek_next();
    if tok2.is_none() {
      let msg = format("expected expressionable for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(.InvalidOperand);
    }
    let t2 = tok2.unwrap();
    if t2.type == .Operator {
      bin is_lparen = false;
      bin is_lbracket = false;
      bin is_dot_recv_or_unary = false;
      fit t2.data {
        .Sval(s2) -> {
          is_lparen = equals(s2, "(");
          is_lbracket = equals(s2, "[");
          is_dot_recv_or_unary = equals(s2, ".") || equals(s2, "<-") || is_unary_operator(s2);
        }
        _ -> {}
      }
      if is_lparen {
        let perr = self.parse_for_parenthesis();
        if perr.is_some() {
          ret perr;
        }
      } elif is_lbracket {
        // An array literal as a binary RHS (`sum + [1, 2, 3]`): no left
        // operand exists on the stack here (already popped into
        // `node_left` above), so `parse_for_bracket` reads this as a
        // literal, not an index.
        let berr = self.parse_for_bracket();
        if berr.is_some() {
          ret berr;
        }
      } elif is_dot_recv_or_unary {
        // Enum-variant shorthand, a prefix channel receive, or a prefix
        // unary operator is a valid RHS operand after a binary operator
        // (`sum + <-ch`, `x == .Variant`, `x != -1`).
        // `parse_normal_expression` sees no left operand here and routes
        // to the prefix handler above.
        let rerr = self.parse_normal_expression();
        if rerr.is_some() {
          ret rerr;
        }
      } else {
        let msg = format("expected expressionable for '{str}' operator", op);
        defer free(msg);
        self.state.err(msg);
        ret .Some(.InvalidOperand);
      }
    } else {
      let err = self.parse_expressionable();
      if err.is_some() {
        ret err;
      }
    }

    let maybe_right = self.state.node_pop();
    if maybe_right.is_none() {
      let msg = format("expected expressionable for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(.InvalidOperand);
    }
    Node node_right = maybe_right.unwrap();

    // Binary channel send: `ch <- v` -> `ch.send(v)`. The RHS was already
    // parsed as a full sub-expression above, so `a <- b + c` desugars to
    // `a.send(b + c)`.
    if equals(op, "<-") {
      self._push_channel_method_call(&node_left, "send", &node_right, true, op_pos);
      ret .None;
    }

    self.make_expression_node(&node_left, &node_right, op, op_pos);
    fit self.state.node_pop() {
      .Some(built) -> {
        Node exp_node = built;
        self.parse_reorder_expression(&exp_node);
        self.state.nodes.push(exp_node);
      }
      .None -> {
        self.state.err("expected expression node");
        ret .Some(.InvalidExpression);
      }
    }
    ret .None;
  }

  // Builds a new scope entity for `node`, deriving its lookup name from the
  // node's kind (identifiers/functions/variables are nameable; anything
  // else gets an empty name and is never found by `get_scope_entity`).
  pub new_scope_entity(Node* node) ScopeEntity* {
    ScopeEntity* entity = malloc(sizeof(ScopeEntity));
    *entity = scope_entity_new(_scope_entity_name(node));
    entity.node = node;
    entity.has_node = true;
    ret entity;
  }

  // The last-declared entity in the current scope chain, stopping at (not
  // including) the root/global scope.
  pub scope_last_entity_stop_global_scope() ScopeEntity* {
    ret self.state.last_scope_entity_stop_at(self.state.scope_root);
  }

  // Pushes a placeholder `Body` node (its `.statements` filled in once
  // parsing finishes) via `create_node`, so it picks up `binded` context
  // from whatever body/function currently encloses it.
  pub make_body_node() {
    Node body_node = node_new(.Blank);
    self.create_node(&body_node);
  }

  // Parses a `{ ... }` block's statements into a `Body` node, tracking that
  // node as `current_body` until the closing `}` so nested node
  // construction stamps `binded.owner` correctly. A parse error mid-body
  // leaves `current_body` unrestored, since a parse error aborts the whole
  // parse anyway.
  pub parse_body_multiple_statements() Option<ParseErrorKind> {
    Vec<Node*> stmts;
    stmts.init(0);

    self.make_body_node();
    let popped = self.state.node_pop();
    if popped.is_none() {
      self.state.err("expected body node");
      ret .Some(.InvalidStatement);
    }
    Node* bnode_ptr = malloc(sizeof(Node));
    *bnode_ptr = popped.unwrap();

    let prev_body = self.current_body;
    let prev_has_body = self.has_current_body;
    self.current_body = bnode_ptr;
    self.has_current_body = true;

    let lbrace_err = self.state.expect_sym('{');
    if lbrace_err.is_some() {
      ret lbrace_err;
    }

    for true {
      let peeked = self.state.token_peek_next();
      if peeked.is_none() {
        self.state.err("unexpected end of file (expected '}' to close body)");
        ret .Some(.InvalidStatement);
      }
      if token_is_symbol(peeked.unwrap(), '}') {
        break;
      }
      let serr = self.parse_statement();
      if serr.is_some() {
        ret serr;
      }
      let maybe_stmt = self.state.node_pop();
      if maybe_stmt.is_none() {
        self.state.err("expected statement");
        ret .Some(.InvalidStatement);
      }
      Node* stmt = malloc(sizeof(Node));
      *stmt = maybe_stmt.unwrap();
      stmts.push(stmt);
    }

    let rbrace_err = self.state.expect_sym('}');
    if rbrace_err.is_some() {
      ret rbrace_err;
    }

    self.current_body = prev_body;
    self.has_current_body = prev_has_body;

    BodyNode bn;
    bn.statements = stmts;
    bnode_ptr.kind = .Body(bn);
    self.state.nodes.push(*bnode_ptr);
    ret .None;
  }

  // Parses a `{ ... }` block, wrapping it in its own child scope so
  // declarations inside it don't leak into the enclosing one.
  pub parse_body() Option<ParseErrorKind> {
    self.state.new_scope();
    let err = self.parse_body_multiple_statements();
    self.state.finish_scope();
    ret err;
  }

  // Parses a run of `[expr]`/`[]` array-bracket suffixes onto `dt`, right
  // after its base type name (`num[5]`, `str[]`, `num[N][N]` for multi-
  // dimensional): sets `dt.is_array`/`dt.array_depth`, and records each
  // bracket's inner size expression (absent for a bare `[]`) as a
  // `Bracket` node in `dt.array_brackets`. Typecheck/codegen compute the
  // concrete size later; parsing only records what was written.
  pub parse_array_brackets(DataType* dt) Option<ParseErrorKind> {
    Vec<Node*> brackets;
    brackets.init(0);
    num depth = 0;

    for self.state.next_token_is_operator("[") {
      let lbracket_tok = self.state.token_peek_next();
      let lberr = self.state.expect_op("[");
      if lberr.is_some() {
        ret lberr;
      }
      dt.is_array = true;
      dt.flags.is_array = true;
      depth = depth + 1;

      if self.state.next_token_is_symbol(']') {
        self.state.token_next();
        continue;
      }

      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let rberr = self.state.expect_sym(']');
      if rberr.is_some() {
        ret rberr;
      }
      let maybe_exp = self.state.node_pop();
      if maybe_exp.is_none() {
        self.state.err("expected array size expression");
        ret .Some(.InvalidExpression);
      }
      Node* exp = malloc(sizeof(Node));
      *exp = maybe_exp.unwrap();

      Node bracket_node = node_new(.Bracket(exp));
      fit lbracket_tok {
        .Some(t) -> {
          bracket_node.pos = t.pos;
          bracket_node.has_pos = true;
        }
        .None -> {}
      }
      Node* bracket_ptr = malloc(sizeof(Node));
      *bracket_ptr = bracket_node;
      brackets.push(bracket_ptr);
    }

    dt.array_depth = depth;
    if brackets.len > 0 {
      dt.array_brackets = brackets;
    }
    ret .None;
  }

  // Parses a variable declaration's name and optional `= initializer`
  // (the type `dt` is already parsed by the caller): registers a scope
  // entity so later references resolve, and rejects re-declaring a name
  // already visible in the current scope chain. The `T[] name;` form, with
  // the brackets right after the base type, goes through
  // `parse_array_brackets`.
  pub parse_variable(DataType* dt, bin is_public, bin require_initializer, bin is_const) Option<ParseErrorKind> {
    if self.state.next_token_is_operator("[") {
      let aberr = self.parse_array_brackets(dt);
      if aberr.is_some() {
        ret aberr;
      }
    }
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected identifier");
      ret .Some(.InvalidIdentifier);
    }
    let ident_tok = tok.unwrap();
    if ident_tok.type != .Identifier {
      self.state.err("expected identifier");
      ret .Some(.InvalidIdentifier);
    }
    str name = "";
    fit ident_tok.data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    if self.state.get_scope_entity(name) != nil {
      let msg = format("variable '{str}' already declared", name);
      defer free(msg);
      self.state.err(msg);
      ret .Some(.InvalidStatement);
    }

    bin has_value = self.state.next_token_is_operator("=");
    if !has_value && require_initializer {
      self.state.err("'let' declarations require an initializer");
      ret .Some(.InvalidStatement);
    }

    VariableNode v;
    v.var_type = dt;
    v.name = name;
    v.val = nil;
    v.has_val = false;
    v.is_const = is_const;

    if has_value {
      self.state.token_next();
      // Stop the value expression at a top-level comma so a function
      // parameter default (`fun f(num b = 2, num c = 3)`) terminates at
      // the param-separator `,` rather than greedily consuming the next
      // parameter via the comma operator. Commas nested inside `(...)`/
      // `[...]` are unaffected, so a default like `= f(a, b)` still parses
      // fully, and a plain `let` is unaffected since a top-level comma
      // after its initializer is invalid there anyway.
      let prev_stop_comma = self.stop_at_comma;
      self.stop_at_comma = true;
      let verr = self.parse_expressionable_root();
      self.stop_at_comma = prev_stop_comma;
      if verr.is_some() {
        ret verr;
      }
      let maybe_val = self.state.node_pop();
      if maybe_val.is_none() {
        self.state.err("expected initializer expression");
        ret .Some(.InvalidStatement);
      }
      Node* val = malloc(sizeof(Node));
      *val = maybe_val.unwrap();
      v.val = val;
      v.has_val = true;
    }

    Node node = node_new(.Variable(v));
    node.pos = ident_tok.pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Node* node_ptr = malloc(sizeof(Node));
    *node_ptr = node;
    ScopeEntity* entity = self.new_scope_entity(node_ptr);

    self.create_node(node_ptr);
    self.state.push_scope_entity(entity);
    ret .None;
  }

  // Parses `let <name> = value;`: the declared type is the `__let_infer__`
  // sentinel, since real type inference happens at typecheck time, and an
  // initializer is mandatory.
  pub parse_let_declaration(bin is_public) Option<ParseErrorKind> {
    let kw_err = self.state.expect_keyword("let");
    if kw_err.is_some() {
      ret kw_err;
    }

    DataType* dt = malloc(sizeof(DataType));
    *dt = dtype_new();
    dt.type_str = "__let_infer__";

    let verr = self.parse_variable(dt, is_public, true, false);
    if verr.is_some() {
      ret verr;
    }
    ret self.state.expect_sym(';');
  }

  // Parses `const <name> = value;` (type-inferred, like `parse_let_declaration`
  // but immutable) or `const <type> <name> = value;` (explicit type; only a
  // builtin datatype keyword is accepted, not a user-defined type name).
  // Always requires an initializer, since a `const` with no value has
  // nothing to ever be assigned. Valid at both top-level and function-body
  // scope.
  pub parse_const_declaration(bin is_public) Option<ParseErrorKind> {
    let kw_err = self.state.expect_keyword("const");
    if kw_err.is_some() {
      ret kw_err;
    }

    let peeked = self.state.token_peek_next();
    if peeked.is_none() {
      self.state.err("expected identifier or type after 'const'");
      ret .Some(.InvalidStatement);
    }
    let t = peeked.unwrap();
    str kw = "";
    if t.type == .Keyword {
      fit t.data {
        .Sval(s) -> { kw = s; }
        _ -> {}
      }
    }

    if t.type == .Keyword && keyword_is_datatype(kw) {
      DataType* dt = malloc(sizeof(DataType));
      *dt = dtype_new();
      let derr = self.state.parse_datatype(dt);
      if derr.is_some() {
        ret derr;
      }
      let verr = self.parse_variable(dt, is_public, true, true);
      if verr.is_some() {
        ret verr;
      }
      ret self.state.expect_sym(';');
    }

    DataType* idt = malloc(sizeof(DataType));
    *idt = dtype_new();
    idt.type_str = "__let_infer__";

    let iverr = self.parse_variable(idt, is_public, true, true);
    if iverr.is_some() {
      ret iverr;
    }
    ret self.state.expect_sym(';');
  }

  // Parses `ret;` (bare) or `ret <expr>;`.
  pub parse_return() Option<ParseErrorKind> {
    let ret_tok = self.state.token_peek_next();
    self.state.token_next();

    if self.state.next_token_is_symbol(';') {
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
      Node node = node_new(.StatementReturn(nil));
      fit ret_tok {
        .Some(t) -> {
          node.pos = t.pos;
          node.has_pos = true;
        }
        .None -> {}
      }
      self.create_node(&node);
      ret .None;
    }

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    let maybe_exp = self.state.node_pop();
    if maybe_exp.is_none() {
      self.state.err("expected return value");
      ret .Some(.InvalidExpression);
    }
    Node* exp = malloc(sizeof(Node));
    *exp = maybe_exp.unwrap();

    Node node = node_new(.StatementReturn(exp));
    fit ret_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses `assert <condition>;` or `assert <condition>, <message>;`. The
  // condition expression parse may already consume the whole `cond,
  // message` as a single `,`-Expression, since `,` is an ordinary binary
  // operator in the precedence table; split that apart when it happens,
  // otherwise look for an explicit trailing `, message`.
  pub parse_assert() Option<ParseErrorKind> {
    let assert_tok = self.state.token_peek_next();
    self.state.token_next();

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    let maybe_exp = self.state.node_pop();
    if maybe_exp.is_none() {
      self.state.err("expected assert condition");
      ret .Some(.InvalidExpression);
    }
    Node exp_val = maybe_exp.unwrap();

    bin is_comma_expr = false;
    fit exp_val.kind {
      .Expression(e) -> {
        if equals(e.op, ",") {
          is_comma_expr = true;
        }
      }
      _ -> {}
    }

    Node* cond_ptr = nil;
    Node* msg_ptr = nil;
    bin has_msg = false;

    if is_comma_expr {
      fit exp_val.kind {
        .Expression(e) -> {
          cond_ptr = e.left;
          msg_ptr = e.right;
          has_msg = true;
        }
        _ -> {}
      }
    } else {
      cond_ptr = malloc(sizeof(Node));
      *cond_ptr = exp_val;

      if self.state.next_token_is_operator(",") {
        self.state.token_next();
        let merr = self.parse_expressionable_root();
        if merr.is_some() {
          ret merr;
        }
        let maybe_msg = self.state.node_pop();
        if maybe_msg.is_none() {
          self.state.err("expected assert message");
          ret .Some(.InvalidExpression);
        }
        msg_ptr = malloc(sizeof(Node));
        *msg_ptr = maybe_msg.unwrap();
        has_msg = true;
      }
    }

    AssertNode an;
    an.condition = cond_ptr;
    an.message = msg_ptr;
    an.has_message = has_msg;

    Node node = node_new(.StatementAssert(an));
    fit assert_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses an `if`/`elif` condition and leaves it on top of the node
  // stack. A leading `(...)` is stripped here rather than left to the
  // general expression parser, which unconditionally reports "there may be
  // more to parse" and would run a bare parenthesized condition into a
  // following single-statement body. When such a condition is followed by a
  // binary operator, it is re-wrapped in an `ExpressionParenthesis` so the
  // grouping survives into codegen; codegen never auto-parenthesizes, so
  // `(a || b) && c` would otherwise emit as `a || b && c`.
  _parse_if_or_elif_condition() Option<ParseErrorKind> {
    bin had_leading_paren = false;
    Node cond = node_new(.Blank);

    if self.state.next_token_is_operator("(") {
      had_leading_paren = true;
      let operr = self.state.expect_op("(");
      if operr.is_some() {
        ret operr;
      }
      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let maybe_cond = self.state.node_pop();
      if maybe_cond.is_none() {
        self.state.err("expected condition");
        ret .Some(.InvalidExpression);
      }
      cond = maybe_cond.unwrap();
      let cerr = self.state.expect_sym(')');
      if cerr.is_some() {
        ret cerr;
      }
    } else {
      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let maybe_cond = self.state.node_pop();
      if maybe_cond.is_none() {
        self.state.err("expected condition");
        ret .Some(.InvalidExpression);
      }
      cond = maybe_cond.unwrap();
    }

    fit self.state.token_peek_next() {
      .Some(nt) -> {
        if is_binary_only_operator(nt) {
          if had_leading_paren {
            Node* inner = malloc(sizeof(Node));
            *inner = cond;
            Node wrapped = node_new(.ExpressionParenthesis(inner));
            wrapped.pos = inner.pos;
            wrapped.has_pos = inner.has_pos;
            cond = wrapped;
          }
          self.state.nodes.push(cond);
          let cerr2 = self.parse_expressionable();
          if cerr2.is_some() {
            ret cerr2;
          }
          let maybe_cond2 = self.state.node_pop();
          if maybe_cond2.is_none() {
            self.state.err("expected condition");
            ret .Some(.InvalidExpression);
          }
          cond = maybe_cond2.unwrap();
        }
      }
      .None -> {}
    }

    bin is_assignment = false;
    fit cond.kind {
      .Expression(e) -> {
        if equals(e.op, "=") {
          is_assignment = true;
        }
      }
      _ -> {}
    }
    if is_assignment {
      self.state.err("expected expression, got assignment");
      ret .Some(.InvalidExpression);
    }

    self.state.nodes.push(cond);
    ret .None;
  }

  // Parses an if/elif/else body, either a `{ ... }` block or a single
  // statement, leaving the resulting node on top of the node stack.
  _parse_if_body() Option<ParseErrorKind> {
    if self.state.next_token_is_symbol('{') {
      ret self.parse_body();
    }
    ret self.parse_statement();
  }

  // Parses `if <condition> <body>`.
  pub parse_if_statement() Option<ParseErrorKind> {
    let if_tok = self.state.token_peek_next();
    let kwerr = self.state.expect_keyword("if");
    if kwerr.is_some() {
      ret kwerr;
    }
    if !self.has_current_function {
      self.state.err("if statement outside of function");
      ret .Some(.InvalidStatement);
    }

    let cerr = self._parse_if_or_elif_condition();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected if condition");
      ret .Some(.InvalidExpression);
    }
    Node* condition = malloc(sizeof(Node));
    *condition = maybe_cond.unwrap();

    let berr = self._parse_if_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected if body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    IfStmtNode ifn;
    ifn.condition = condition;
    ifn.body = body;

    Node node = node_new(.StatementIf(ifn));
    fit if_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `elif <condition> <body>`. A no-op if the next token isn't
  // `elif`. `parse_body_multiple_statements` doesn't check that an
  // elif/else actually follows an if/elif, so a stray `elif` with no
  // preceding `if` is accepted rather than rejected.
  pub parse_elif_statement() Option<ParseErrorKind> {
    if !self.state.next_token_is_keyword("elif") {
      ret .None;
    }
    let elif_tok = self.state.token_peek_next();
    if !self.has_current_function {
      self.state.err("elif statement outside of function");
      ret .Some(.InvalidStatement);
    }
    self.state.token_next();

    let cerr = self._parse_if_or_elif_condition();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected elif condition");
      ret .Some(.InvalidExpression);
    }
    Node* condition = malloc(sizeof(Node));
    *condition = maybe_cond.unwrap();

    let berr = self._parse_if_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected elif body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    IfStmtNode ifn;
    ifn.condition = condition;
    ifn.body = body;

    Node node = node_new(.StatementElseIf(ifn));
    fit elif_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `else <body>`. A no-op if the next token isn't `else`. Like
  // `parse_elif_statement`, doesn't validate that it follows an if/elif.
  pub parse_else_statement() Option<ParseErrorKind> {
    if !self.state.next_token_is_keyword("else") {
      ret .None;
    }
    let else_tok = self.state.token_peek_next();
    if !self.has_current_function {
      self.state.err("else statement outside of function");
      ret .Some(.InvalidStatement);
    }
    self.state.token_next();

    let berr = self._parse_if_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected else body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    Node node = node_new(.StatementElse(body));
    fit else_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses a function argument (`<type> <name>`, optionally `= default`):
  // the type, then delegates to `parse_variable` for the name/default.
  _parse_full_variable() Option<ParseErrorKind> {
    DataType* dt = malloc(sizeof(DataType));
    *dt = dtype_new();
    let derr = self.state.parse_datatype(dt);
    if derr.is_some() {
      ret derr;
    }
    ret self.parse_variable(dt, false, false, false);
  }

  // Parses a comma-separated argument list up to (not including) the
  // closing `)`, appending each argument node to `out_args`. A trailing
  // `...` (either as the whole list, `f(...)`, or after named args,
  // `f(str fmt, ...)`) sets `*out_is_variadic` and stops; it never becomes
  // an argument node itself.
  _parse_function_args(Vec<Node*>* out_args, bin* out_is_variadic) Option<ParseErrorKind> {
    for !self.state.next_token_is_symbol(')') {
      if self.state.next_token_is_operator("...") {
        self.state.token_next();
        *out_is_variadic = true;
        break;
      }
      let verr = self._parse_full_variable();
      if verr.is_some() {
        ret verr;
      }
      let maybe_arg = self.state.node_pop();
      if maybe_arg.is_none() {
        self.state.err("expected argument");
        ret .Some(.InvalidIdentifier);
      }
      Node* arg = malloc(sizeof(Node));
      *arg = maybe_arg.unwrap();
      out_args.push(arg);

      if !self.state.next_token_is_operator(",") {
        break;
      }
      self.state.token_next();
    }
    ret .None;
  }

  // Parses a function declaration: `fun <name>(args) [rtype] { body }`, or
  // `fun <name>(args) [rtype];` for a bare signature with no body. Registers
  // its own child scope for the argument list and body, and tracks itself as
  // `current_function` while parsing so nested node construction stamps
  // `binded.function` correctly. Reached from
  // `parse_top_level_declaration`, not `parse_statement`, since a function
  // declaration is only valid at the top level.
  pub parse_function(bin is_public, bin is_async) Option<ParseErrorKind> {
    self.state.new_scope();

    self.state.token_next(); // skip 'fun'

    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected identifier after 'fun'");
      ret .Some(.InvalidIdentifier);
    }
    let ident_tok = tok.unwrap();
    if ident_tok.type != .Identifier {
      self.state.err("expected identifier after 'fun'");
      ret .Some(.InvalidIdentifier);
    }
    str fname = "";
    fit ident_tok.data {
      .Sval(s) -> { fname = s; }
      _ -> {}
    }

    FunctionNode fnv = function_node_new();
    fnv.name = fname;
    fnv.has_name = true;
    fnv.is_async = is_async;

    Node fn_node = node_new(.Function(fnv));
    fn_node.pos = ident_tok.pos;
    fn_node.has_pos = true;
    fn_node.flags.is_public = is_public;

    Node* fn_node_ptr = malloc(sizeof(Node));
    *fn_node_ptr = fn_node;
    self.current_function = fn_node_ptr;
    self.has_current_function = true;

    // Registers the function's name as a symbol before its args and body
    // are parsed, so passing an already-declared function by name into a
    // `fun(T) R`-typed parameter passes the identifier-validity check in
    // `parse_single_token_to_node`. The stored symbol's node is a name-only
    // snapshot, which is fine since only `get_symbol(name).is_none()` is
    // ever checked for it.
    Symbol fn_sym = symbol_new(fname);
    fn_sym.kind = .NodeSym(*fn_node_ptr);
    self.state.push_symbol(fn_sym);

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> type_param_forced_insts;
    type_param_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(
      &type_params,
      &type_param_forced_insts
    );
    if tperr.is_some() {
      ret tperr;
    }
    fit fn_node_ptr.kind {
      .Function(curtp) -> {
        curtp.type_params = type_params;
        curtp.has_type_params = type_params.len > 0;
        curtp.type_param_forced_insts = type_param_forced_insts;
        curtp.has_type_param_forced_insts = type_param_forced_insts.len > 0;
        fn_node_ptr.kind = .Function(curtp);
      }
      _ -> {}
    }

    let operr = self.state.expect_op("(");
    if operr.is_some() {
      ret operr;
    }
    Vec<Node*> args;
    args.init(0);
    bin is_variadic = false;
    let aerr = self._parse_function_args(&args, &is_variadic);
    if aerr.is_some() {
      ret aerr;
    }
    let cperr = self.state.expect_sym(')');
    if cperr.is_some() {
      ret cperr;
    }

    fit fn_node_ptr.kind {
      .Function(cur) -> {
        cur.args = args;
        cur.has_args = true;
        cur.is_variadic = is_variadic;
        fn_node_ptr.kind = .Function(cur);
      }
      _ -> {}
    }

    // A variadic function's `...` args are collected into a synthetic
    // `vargs: Vec` binding, registered in scope but not emitted as a
    // declaration node (it's synthesized by codegen, like for-loop
    // range/iterator variables), so the body can reference `vargs` by name.
    if is_variadic {
      DataType* vdt = malloc(sizeof(DataType));
      *vdt = dtype_new();
      vdt.kind = .Unknown;
      vdt.type_str = "Vec";

      VariableNode vv;
      vv.var_type = vdt;
      vv.name = "vargs";
      vv.val = nil;
      vv.has_val = false;
      vv.is_const = false;

      Node vnode = node_new(.Variable(vv));
      vnode.pos = fn_node_ptr.pos;
      vnode.has_pos = fn_node_ptr.has_pos;

      Node* vnode_ptr = malloc(sizeof(Node));
      *vnode_ptr = vnode;
      ScopeEntity* ventity = self.new_scope_entity(vnode_ptr);
      self.state.push_scope_entity(ventity);
    }

    DataType* rtype = malloc(sizeof(DataType));
    bin has_explicit_rtype = false;
    fit self.state.token_peek_next() {
      .Some(rt) -> {
        bin looks_like_type = false;
        if rt.type == .Identifier {
          looks_like_type = true;
        }
        if rt.type == .Keyword {
          fit rt.data {
            .Sval(s) -> { looks_like_type = keyword_is_datatype(s); }
            _ -> {}
          }
        }
        if looks_like_type {
          *rtype = dtype_new();
          let rerr = self.state.parse_datatype(rtype);
          if rerr.is_some() {
            ret rerr;
          }
          if self.state.next_token_is_operator("[") {
            let raberr = self.parse_array_brackets(rtype);
            if raberr.is_some() {
              ret raberr;
            }
          }
          has_explicit_rtype = true;
        }
      }
      .None -> {}
    }
    if !has_explicit_rtype {
      *rtype = dtype_new();
      rtype.kind = .Void;
      rtype.type_str = "void";
    }

    fit fn_node_ptr.kind {
      .Function(cur2) -> {
        cur2.rtype = rtype;
        cur2.has_rtype = true;
        fn_node_ptr.kind = .Function(cur2);
      }
      _ -> {}
    }

    if self.state.next_token_is_symbol('{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected function body");
        ret .Some(.InvalidStatement);
      }
      Node* body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();
      fit fn_node_ptr.kind {
        .Function(cur3) -> {
          cur3.body = body;
          cur3.has_body = true;
          fn_node_ptr.kind = .Function(cur3);
        }
        _ -> {}
      }
    } else {
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    self.has_current_function = false;
    self.state.nodes.push(*fn_node_ptr);
    self.state.finish_scope();
    ret .None;
  }

  // Parses the range/iterator loop-variable forms, once `parse_for_statement`
  // has determined (via lookahead) that's what follows `for`: `for i :
  // start..end { ... }` for `.Range`, or `for item : arr { ... }` /
  // `for i, item :: arr { ... }` for `.Iter` with optional index
  // tracking. The loop variables are registered as on-stack scope entities
  // with no backing declaration `Node`, in a scope opened before the body
  // and closed after it. The one hard error here (range form with the
  // iterator-only `i, item ::` syntax) leaves that scope unfinished, since
  // a parse error aborts the whole parse anyway.
  _parse_for_range_or_iter(Option<Token> for_tok) Option<ParseErrorKind> {
    let first = self.state.token_next();
    if first.is_none() || first.unwrap().type != .Identifier {
      self.state.err("expected identifier after 'for'");
      ret .Some(.InvalidIdentifier);
    }
    str index_name = "";
    bin has_index_name = false;
    str item_name = "";
    fit first.unwrap().data {
      .Sval(s) -> { item_name = s; }
      _ -> {}
    }
    bin used_double_colon = false;

    if self.state.next_token_is_operator(",") {
      index_name = item_name;
      has_index_name = true;
      self.state.token_next(); // skip ','
      let second = self.state.token_next();
      if second.is_none() || second.unwrap().type != .Identifier {
        self.state.err("expected identifier after ',' in for loop");
        ret .Some(.InvalidIdentifier);
      }
      fit second.unwrap().data {
        .Sval(s) -> { item_name = s; }
        _ -> {}
      }
      let dcerr = self.state.expect_op("::");
      if dcerr.is_some() {
        ret dcerr;
      }
      used_double_colon = true;
    } else {
      let cerr = self.state.expect_op(":");
      if cerr.is_some() {
        ret cerr;
      }
    }

    let ierr = self.parse_expressionable_root();
    if ierr.is_some() {
      ret ierr;
    }
    let maybe_iterable = self.state.node_pop();
    if maybe_iterable.is_none() {
      self.state.err("expected for iterable/range expression");
      ret .Some(.InvalidExpression);
    }
    Node iterable_node = maybe_iterable.unwrap();

    bin is_range = false;
    fit iterable_node.kind {
      .Expression(e) -> {
        if equals(e.op, "..") {
          is_range = true;
        }
      }
      _ -> {}
    }

    self.state.new_scope();

    if is_range {
      if used_double_colon {
        self.state.err("range for loop does not support 'i, item ::' form");
        ret .Some(.InvalidStatement);
      }
      ScopeEntity item_entity = scope_entity_new(item_name);
      item_entity.on_stack = true;
      ScopeEntity* item_entity_ptr = malloc(sizeof(ScopeEntity));
      *item_entity_ptr = item_entity;
      self.state.push_scope_entity(item_entity_ptr);
    } else {
      if has_index_name {
        ScopeEntity index_entity = scope_entity_new(index_name);
        index_entity.on_stack = true;
        ScopeEntity* index_entity_ptr = malloc(sizeof(ScopeEntity));
        *index_entity_ptr = index_entity;
        self.state.push_scope_entity(index_entity_ptr);
      }
      ScopeEntity item_entity = scope_entity_new(item_name);
      item_entity.on_stack = true;
      ScopeEntity* item_entity_ptr = malloc(sizeof(ScopeEntity));
      *item_entity_ptr = item_entity;
      self.state.push_scope_entity(item_entity_ptr);
    }

    let berr = self.parse_body_multiple_statements();
    self.state.finish_scope();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected for body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    Node node = node_new(.Blank);
    if is_range {
      Node* range_ptr = malloc(sizeof(Node));
      *range_ptr = iterable_node;
      ForRangeNode fr;
      fr.index_name = item_name;
      fr.range_expr = range_ptr;
      fr.body = body;
      node.kind = .StatementFor(.Range(fr));
    } else {
      Node* iterable_ptr = malloc(sizeof(Node));
      *iterable_ptr = iterable_node;
      ForIterNode fi;
      fi.index_name = index_name;
      fi.has_index_name = has_index_name;
      fi.item_name = item_name;
      fi.iterable = iterable_ptr;
      fi.body = body;
      node.kind = .StatementFor(.Iter(fi));
    }
    fit for_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses a `for` loop: `for { ... }` (infinite), `for <condition> {
  // ... }`, `for i : start..end { ... }` (range), or `for item : arr {
  // ... }` / `for i, item :: arr { ... }` (iterator). A 1-token lookahead
  // separates the range/iterator forms from a condition loop starting with
  // an identifier (`for x != 0 { ... }`): only `for <ident> :` or
  // `for <ident> ,` are those forms, since a bare condition never starts
  // with `,` and `:` isn't an expression-continuation operator.
  pub parse_for_statement() Option<ParseErrorKind> {
    let for_tok = self.state.token_peek_next();
    let kwerr = self.state.expect_keyword("for");
    if kwerr.is_some() {
      ret kwerr;
    }
    if !self.has_current_function {
      self.state.err("for statement outside of function");
      ret .Some(.InvalidStatement);
    }

    if self.state.next_token_is_symbol('{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected for body");
        ret .Some(.InvalidStatement);
      }
      Node* body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();

      ForCondNode fc;
      fc.condition = nil;
      fc.has_condition = false;
      fc.body = body;

      Node node = node_new(.StatementFor(.Cond(fc)));
      fit for_tok {
        .Some(t) -> {
          node.pos = t.pos;
          node.has_pos = true;
        }
        .None -> {}
      }
      self.create_node(&node);
      ret .None;
    }

    bin is_legacy = false;
    fit self.state.token_peek_next() {
      .Some(nt) -> {
        if nt.type == .Identifier {
          fit self.state.token_peek_n(1) {
            .Some(after) -> {
              is_legacy = token_is_operator(after, ",") || token_is_operator(after, ":");
            }
            .None -> {}
          }
        }
      }
      .None -> {}
    }
    if is_legacy {
      ret self._parse_for_range_or_iter(for_tok);
    }

    let cerr = self.parse_expressionable_root();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected for condition");
      ret .Some(.InvalidExpression);
    }
    Node* cond_ptr = malloc(sizeof(Node));
    *cond_ptr = maybe_cond.unwrap();

    let berr = self.parse_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected for body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    ForCondNode fc;
    fc.condition = cond_ptr;
    fc.has_condition = true;
    fc.body = body;

    Node node = node_new(.StatementFor(.Cond(fc)));
    fit for_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Tries to parse a data-carrying-enum destructuring fit pattern at the
  // cursor: `Enum.Variant(a, b)` or shorthand `.Variant(a, b)`. On a
  // match, consumes those tokens, sets `*out_condition` to the variant-
  // path `.` expression (`Enum.Variant`, or `<blank>.Variant` for
  // shorthand), fills `*out_bindings` with the positional binding
  // identifiers, and sets `*out_matched` true. On no match, consumes
  // nothing and leaves `*out_matched` false. Detection requires the
  // trailing `(`, so a payload-less `Enum.Variant`/`.Variant` arm still
  // goes through the ordinary path.
  _try_parse_fit_destructure(bin* out_matched, Node* out_condition, Vec<str>* out_bindings) Option<ParseErrorKind> {
    *out_matched = false;
    let p0_opt = self.state.token_peek_n(0);
    let p1_opt = self.state.token_peek_n(1);
    if p0_opt.is_none() || p1_opt.is_none() {
      ret .None;
    }
    let p0 = p0_opt.unwrap();
    let p1 = p1_opt.unwrap();

    bin is_shorthand = token_is_operator(p0, ".") && p1.type == .Identifier;
    bin is_qualified = false;
    if !is_shorthand {
      is_qualified = p0.type == .Identifier && token_is_operator(p1, ".");
    }
    if !is_shorthand && !is_qualified {
      ret .None;
    }

    Token variant_tok;
    bin found_lparen = false;
    if is_shorthand {
      let p2_opt = self.state.token_peek_n(2);
      if p2_opt.is_some() && token_is_operator(p2_opt.unwrap(), "(") {
        variant_tok = p1;
        found_lparen = true;
      }
    } else {
      let p2_opt = self.state.token_peek_n(2);
      if p2_opt.is_some() && p2_opt.unwrap().type == .Identifier {
        let p3_opt = self.state.token_peek_n(3);
        if p3_opt.is_some() && token_is_operator(p3_opt.unwrap(), "(") {
          variant_tok = p2_opt.unwrap();
          found_lparen = true;
        }
      }
    }
    if !found_lparen {
      ret .None;
    }

    // Commit: consume the path tokens.
    Node left = node_new(.Blank);
    if is_shorthand {
      self.state.token_next(); // '.'
      self.state.token_next(); // Variant
      left.pos = variant_tok.pos;
      left.has_pos = true;
    } else {
      str enum_name = "";
      fit p0.data {
        .Sval(s) -> { enum_name = s; }
        _ -> {}
      }
      left = node_new(.Identifier(enum_name));
      left.pos = p0.pos;
      left.has_pos = true;
      self.state.token_next(); // Enum
      self.state.token_next(); // '.'
      self.state.token_next(); // Variant
    }
    left.flags.inside_expression = true;

    str variant_name = "";
    fit variant_tok.data {
      .Sval(s) -> { variant_name = s; }
      _ -> {}
    }
    Node right = node_new(.Identifier(variant_name));
    right.pos = variant_tok.pos;
    right.has_pos = true;
    right.flags.inside_expression = true;

    let lperr = self.state.expect_op("(");
    if lperr.is_some() {
      ret lperr;
    }

    Vec<str> binds;
    binds.init(0);
    for !self.state.next_token_is_symbol(')') {
      let bt = self.state.token_next();
      if bt.is_none() || bt.unwrap().type != .Identifier {
        self.state.err("expected binding name in fit destructuring pattern");
        ret .Some(.InvalidIdentifier);
      }
      str bname = "";
      fit bt.unwrap().data {
        .Sval(s) -> { bname = s; }
        _ -> {}
      }
      binds.push(bname);
      if !self.state.next_token_is_operator(",") {
        break;
      }
      self.state.token_next();
    }
    let rperr = self.state.expect_sym(')');
    if rperr.is_some() {
      ret rperr;
    }
    if binds.len == 0 {
      self.state.err("fit destructuring pattern '()' must bind at least one field");
      ret .Some(.InvalidToken);
    }

    self.make_expression_node(&left, &right, ".", variant_tok.pos);
    fit self.state.node_pop() {
      .Some(built) -> { *out_condition = built; }
      .None -> {
        self.state.err("failed to build fit destructuring variant path");
        ret .Some(.InvalidExpression);
      }
    }
    *out_bindings = binds;
    *out_matched = true;
    ret .None;
  }

  // Parses one `pattern -> { body }` fit arm, pushing the finished branch
  // onto `out_branches`. `_` (the wildcard default) has no condition and
  // must be the last arm, signaled back through `out_has_default` so the
  // caller's loop stops. Three pattern shapes are tried in order: a
  // data-carrying destructuring pattern via `_try_parse_fit_destructure`,
  // whose binding names are registered in a scope opened for the arm body;
  // a payload-less `.Variant` shorthand, which the general parser doesn't
  // recognize as a complete expression on its own; and an ordinary
  // expression pattern via `parse_expressionable_root`.
  _parse_fit_arm(Vec<FitBranch>* out_branches, bin* out_has_default) Option<ParseErrorKind> {
    Node arm_condition = node_new(.Blank);
    Vec<str> bindings;
    bindings.init(0);

    bin destructure_matched = false;
    Node destructure_condition = node_new(.Blank);
    Vec<str> destructure_bindings;
    destructure_bindings.init(0);
    let dxerr = self._try_parse_fit_destructure(
      &destructure_matched,
      &destructure_condition,
      &destructure_bindings
    );
    if dxerr.is_some() {
      ret dxerr;
    }

    if destructure_matched {
      arm_condition = destructure_condition;
      bindings = destructure_bindings;
    } else {
      bin is_dot_shorthand = false;
      Pos op_pos;
      fit self.state.token_peek_next() {
        .Some(t) -> {
          op_pos = t.pos;
          if t.type == .Operator {
            str op = "";
            fit t.data {
              .Sval(s) -> { op = s; }
              _ -> {}
            }
            is_dot_shorthand = equals(op, ".");
          }
        }
        .None -> {}
      }

      if is_dot_shorthand {
        self.state.token_next(); // consume '.'
        let ierr = self.parse_single_token_to_node();
        if ierr.is_some() {
          ret ierr;
        }
        let maybe_right = self.state.node_pop();
        if maybe_right.is_none() {
          self.state.err("expected identifier after '.' in fit pattern");
          ret .Some(.InvalidExpression);
        }
        Node node_right = maybe_right.unwrap();
        node_right.flags.inside_expression = true;

        Node blank_left = node_new(.Blank);
        blank_left.pos = op_pos;
        blank_left.has_pos = true;
        blank_left.flags.inside_expression = true;

        self.make_expression_node(&blank_left, &node_right, ".", op_pos);
        fit self.state.node_pop() {
          .Some(built) -> {
            arm_condition = built;
            self.parse_reorder_expression(&arm_condition);
          }
          .None -> {
            self.state.err("expected fit branch condition expression");
            ret .Some(.InvalidExpression);
          }
        }
      } else {
        let cerr = self.parse_expressionable_root();
        if cerr.is_some() {
          ret cerr;
        }
        let maybe_cond = self.state.node_pop();
        if maybe_cond.is_none() {
          self.state.err("expected fit branch condition expression");
          ret .Some(.InvalidExpression);
        }
        arm_condition = maybe_cond.unwrap();
      }
    }

    bin is_assignment = false;
    fit arm_condition.kind {
      .Expression(e) -> {
        if equals(e.op, "=") {
          is_assignment = true;
        }
      }
      _ -> {}
    }
    if is_assignment {
      self.state.err("expected expression, got assignment");
      ret .Some(.InvalidExpression);
    }

    bin is_wildcard = false;
    fit arm_condition.kind {
      .Identifier(s) -> {
        if equals(s, "_") {
          is_wildcard = true;
        }
      }
      _ -> {}
    }

    FitBranch branch = fit_branch_new();
    if !is_wildcard {
      Node* cond_ptr = malloc(sizeof(Node));
      *cond_ptr = arm_condition;
      branch.condition = cond_ptr;
      branch.has_condition = true;
    }
    bin has_bindings = bindings.len > 0;
    if has_bindings {
      branch.bindings = bindings;
      branch.has_bindings = true;
    }

    let arerr = self.state.expect_op("->");
    if arerr.is_some() {
      ret arerr;
    }
    // Register destructuring binding names in a scope so the arm body can
    // reference them at parse time. Opened here and closed after the
    // body is parsed, so bindings don't leak to sibling arms or past the
    // fit. Each binding is a plain Unknown-typed scope entity; typecheck
    // resolves the real payload type later.
    if has_bindings {
      self.state.new_scope();
      for bname : bindings {
        DataType* bdt = malloc(sizeof(DataType));
        *bdt = dtype_new();

        VariableNode bv;
        bv.var_type = bdt;
        bv.name = bname;
        bv.val = nil;
        bv.has_val = false;
        bv.is_const = false;

        Node bvar = node_new(.Variable(bv));
        Node* bvar_ptr = malloc(sizeof(Node));
        *bvar_ptr = bvar;
        ScopeEntity* bentity = self.new_scope_entity(bvar_ptr);
        self.state.push_scope_entity(bentity);
      }
    }
    let berr = self.parse_body();
    if has_bindings {
      self.state.finish_scope();
    }
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected fit branch body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();
    branch.body = body;

    out_branches.push(branch);
    if is_wildcard {
      *out_has_default = true;
    }

    if self.state.next_token_is_operator(",") {
      self.state.token_next();
    }
    ret .None;
  }

  // Parses a fit statement's body: `{ arm , arm , ... }`. Stops parsing
  // further arms once a wildcard `_` default arm has been parsed, since
  // `_` is always the last arm, then requires the closing `}`.
  pub parse_fit_body(Node* condition, Pos fit_pos, bin has_fit_pos) Option<ParseErrorKind> {
    let lbrace_err = self.state.expect_sym('{');
    if lbrace_err.is_some() {
      ret lbrace_err;
    }

    Vec<FitBranch> branches;
    branches.init(0);
    bin has_default_branch = false;

    for !self.state.next_token_is_symbol('}') {
      let aerr = self._parse_fit_arm(&branches, &has_default_branch);
      if aerr.is_some() {
        ret aerr;
      }
      if has_default_branch {
        break;
      }
    }

    let rbrace_err = self.state.expect_sym('}');
    if rbrace_err.is_some() {
      ret rbrace_err;
    }

    FitStmtNode fitn = fit_stmt_node_new();
    fitn.exp = condition;
    fitn.branches = branches;
    fitn.has_default_branch = has_default_branch;

    Node node = node_new(.StatementFit(fitn));
    if has_fit_pos {
      node.pos = fit_pos;
      node.has_pos = true;
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `fit <condition> { arm , ... }`. `in_fit_statement` covers the
  // subject expression as well as the arms, so a stray `->` right after
  // the subject stops there instead of swallowing into the arm list. It's
  // left set on an early-error return, since a parse error aborts the
  // whole parse anyway.
  pub parse_fit_statement() Option<ParseErrorKind> {
    let fit_tok = self.state.token_peek_next();
    let kwerr = self.state.expect_keyword("fit");
    if kwerr.is_some() {
      ret kwerr;
    }

    let prev_in_fit_statement = self.in_fit_statement;
    self.in_fit_statement = true;

    let cerr = self.parse_expressionable_root();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected fit condition");
      ret .Some(.InvalidExpression);
    }
    Node* condition = malloc(sizeof(Node));
    *condition = maybe_cond.unwrap();

    bin has_pos = false;
    // Zeroed rather than left uninitialized: `parse_fit_body` never
    // reads `pos` when `has_pos` is false, but passing an
    // uninitialized struct by value is undefined behavior in the
    // generated C regardless of whether the callee looks at it.
    Pos pos;
    pos.line = 0;
    pos.col = 0;
    pos.start_col = 0;
    pos.end_col = 0;
    pos.end_line = 0;
    pos.filename = "";
    fit fit_tok {
      .Some(t) -> {
        pos = t.pos;
        has_pos = true;
      }
      .None -> {}
    }
    let berr = self.parse_fit_body(condition, pos, has_pos);
    self.in_fit_statement = prev_in_fit_statement;
    ret berr;
  }

  // Parses `break;`.
  pub parse_break_statement() Option<ParseErrorKind> {
    let tok = self.state.token_next(); // consume 'break'
    Node node = node_new(.StatementBreak);
    fit tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses `continue;`.
  pub parse_continue_statement() Option<ParseErrorKind> {
    let tok = self.state.token_next(); // consume 'continue'
    Node node = node_new(.StatementContinue);
    fit tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses a `panic("msg")` expression, leaving a `Panic` node on the node
  // stack. Doesn't consume a trailing `;`; callers in statement position
  // do that themselves.
  pub parse_panic_expr() Option<ParseErrorKind> {
    let panic_tok = self.state.token_next(); // consume 'panic'
    let lperr = self.state.expect_op("(");
    if lperr.is_some() {
      ret lperr;
    }
    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    let maybe_msg = self.state.node_pop();
    if maybe_msg.is_none() {
      self.state.err("expected message expression after 'panic('");
      ret .Some(.InvalidExpression);
    }
    let rperr = self.state.expect_sym(')');
    if rperr.is_some() {
      ret rperr;
    }
    Node* msg = malloc(sizeof(Node));
    *msg = maybe_msg.unwrap();

    Node node = node_new(.Panic(msg));
    fit panic_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `await <expr>` as a bounded expression operand, lowered as a
  // `Unary` node with `op = "await"` and left on the node stack. Doesn't
  // consume a trailing `;`; statement-position callers do that themselves.
  // The operand parse is bounded via `stop_at_binary_op` so
  // `await f(x) + 1` parses as `(await f(x)) + 1`.
  pub parse_await_operand() Option<ParseErrorKind> {
    let await_tok = self.state.token_next(); // consume 'await'
    if !self.has_current_function {
      self.state.err("await statement outside of function");
      ret .Some(.InvalidStatement);
    }
    let next_tok = self.state.token_peek_next();
    if next_tok.is_none() {
      self.state.err("expected expression after 'await'");
      ret .Some(.InvalidExpression);
    }
    if token_is_symbol(next_tok.unwrap(), ';') {
      self.state.err("expected expression after 'await'");
      ret .Some(.InvalidExpression);
    }

    num before = self.state.nodes.len;
    let prev_stop = self.stop_at_binary_op;
    self.stop_at_binary_op = true;
    let eerr = self.parse_expressionable();
    self.stop_at_binary_op = prev_stop;
    if eerr.is_some() {
      ret eerr;
    }
    if self.state.nodes.len == before {
      self.state.err("expected expression after 'await'");
      ret .Some(.InvalidExpression);
    }

    let maybe_operand = self.state.node_pop();
    if maybe_operand.is_none() {
      self.state.err("expected expression after 'await'");
      ret .Some(.InvalidExpression);
    }
    Node* operand = malloc(sizeof(Node));
    *operand = maybe_operand.unwrap();

    UnaryNode un;
    un.is_left_operanded_unary = false;
    un.op = "await";
    un.operand = operand;
    un.has_indirection = false;
    un.indirection_depth = 0;

    Node node = node_new(.Unary(un));
    fit await_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `fork <call>;`, a fire-and-forget virtual-thread spawn. The
  // operand is a bounded expression (the same `stop_at_binary_op`
  // mechanism as `await`, so `fork f(x)` doesn't swallow a following
  // statement); codegen, not the parser, validates that it really is a
  // `()` call.
  pub parse_fork_statement() Option<ParseErrorKind> {
    let fork_tok = self.state.token_next(); // consume 'fork'
    if !self.has_current_function {
      self.state.err("fork statement outside of function");
      ret .Some(.InvalidStatement);
    }
    let next_tok = self.state.token_peek_next();
    if next_tok.is_none() {
      self.state.err("expected a function call after 'fork'");
      ret .Some(.InvalidExpression);
    }
    if token_is_symbol(next_tok.unwrap(), ';') {
      self.state.err("expected a function call after 'fork'");
      ret .Some(.InvalidExpression);
    }

    num before = self.state.nodes.len;
    let prev_stop = self.stop_at_binary_op;
    self.stop_at_binary_op = true;
    let eerr = self.parse_expressionable();
    self.stop_at_binary_op = prev_stop;
    if eerr.is_some() {
      ret eerr;
    }
    if self.state.nodes.len == before {
      self.state.err("expected a function call after 'fork'");
      ret .Some(.InvalidExpression);
    }

    let maybe_call = self.state.node_pop();
    if maybe_call.is_none() {
      self.state.err("expected a function call after 'fork'");
      ret .Some(.InvalidExpression);
    }
    Node* expr = malloc(sizeof(Node));
    *expr = maybe_call.unwrap();

    Node node = node_new(.StatementFork(expr));
    fit fork_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses `defer { ... }` (a block) or `defer expr;` (a single
  // expression). Both run at scope exit; the parser only records which
  // form was written, and codegen handles ordering and semantics.
  pub parse_defer_statement() Option<ParseErrorKind> {
    let defer_tok = self.state.token_peek_next();
    if !self.has_current_function {
      self.state.err("defer statement outside of function");
      ret .Some(.InvalidStatement);
    }
    self.state.token_next(); // consume 'defer'

    let next_tok = self.state.token_peek_next();
    if next_tok.is_none() {
      self.state.err("expected expression or body after 'defer'");
      ret .Some(.InvalidStatement);
    }

    Node* body;
    if token_is_symbol(next_tok.unwrap(), '{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected body after 'defer'");
        ret .Some(.InvalidStatement);
      }
      body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();
    } else {
      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let maybe_expr = self.state.node_pop();
      if maybe_expr.is_none() {
        self.state.err("expected expression after 'defer'");
        ret .Some(.InvalidStatement);
      }
      body = malloc(sizeof(Node));
      *body = maybe_expr.unwrap();
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    Node node = node_new(.StatementDefer(body));
    fit defer_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses one `name: "constraint" = expr` operand into `list`, then
  // consumes the `,` continuing the list, the `;` ending this section, or
  // stops (without consuming) at the `)` ending the whole operand list.
  // Shared by both the `out`/`in` sections of an `asm` statement, which
  // have an identical shape.
  _parse_asm_operand_list(Vec<AsmOperand>* list) Option<ParseErrorKind> {
    for true {
      self.state.skip_nl_or_comment();
      let name_tok = self.state.token_next();
      if name_tok.is_none() || name_tok.unwrap().type != .Identifier {
        self.state.err("expected operand name");
        ret .Some(.InvalidIdentifier);
      }
      str name = "";
      fit name_tok.unwrap().data {
        .Sval(s) -> { name = s; }
        _ -> {}
      }

      let colon_tok = self.state.token_next();
      bin colon_ok = false;
      if colon_tok.is_some() {
        let ct = colon_tok.unwrap();
        colon_ok = token_is_symbol(ct, ':') || token_is_operator(ct, ":");
      }
      if !colon_ok {
        self.state.err("expected ':' after operand name");
        ret .Some(.InvalidSymbol);
      }

      let constraint_tok = self.state.token_next();
      if constraint_tok.is_none() || constraint_tok.unwrap().type != .String {
        self.state.err("expected constraint string");
        ret .Some(.InvalidString);
      }
      str constraint = "";
      fit constraint_tok.unwrap().data {
        .Sval(s) -> { constraint = s; }
        _ -> {}
      }

      let eqerr = self.state.expect_op("=");
      if eqerr.is_some() {
        ret eqerr;
      }
      let everr = self.parse_expressionable_root();
      if everr.is_some() {
        ret everr;
      }
      let maybe_expr = self.state.node_pop();
      if maybe_expr.is_none() {
        self.state.err("expected operand expression");
        ret .Some(.InvalidStatement);
      }
      Node* expr = malloc(sizeof(Node));
      *expr = maybe_expr.unwrap();

      AsmOperand op;
      op.name = name;
      op.constraint = constraint;
      op.expr = expr;
      list.push(op);

      let peek_tok = self.state.token_peek_next();
      if peek_tok.is_none() {
        ret .None;
      }
      let pt = peek_tok.unwrap();
      if token_is_symbol(pt, ',') || token_is_operator(pt, ",") {
        self.state.token_next();
        continue;
      }
      if token_is_symbol(pt, ';') || token_is_operator(pt, ";") {
        self.state.token_next();
        ret .None;
      }
      if token_is_symbol(pt, ')') || token_is_operator(pt, ")") {
        ret .None;
      }
      self.state.err("expected ',', ';', or ')' after operand");
      ret .Some(.InvalidSymbol);
    }
    ret .None;
  }

  // Parses a comma/semicolon-separated list of clobber string literals
  // into `list`, the same way `_parse_asm_operand_list` handles operands.
  _parse_asm_clobber_list(Vec<str>* list) Option<ParseErrorKind> {
    for true {
      self.state.skip_nl_or_comment();
      let ctok = self.state.token_next();
      if ctok.is_none() || ctok.unwrap().type != .String {
        self.state.err("expected clobber string");
        ret .Some(.InvalidString);
      }
      str cname = "";
      fit ctok.unwrap().data {
        .Sval(s) -> { cname = s; }
        _ -> {}
      }
      list.push(cname);

      let peek_tok = self.state.token_peek_next();
      if peek_tok.is_none() {
        ret .None;
      }
      let pt = peek_tok.unwrap();
      if token_is_symbol(pt, ',') || token_is_operator(pt, ",") {
        self.state.token_next();
        continue;
      }
      if token_is_symbol(pt, ';') || token_is_operator(pt, ";") {
        self.state.token_next();
        ret .None;
      }
      if token_is_symbol(pt, ')') || token_is_operator(pt, ")") {
        ret .None;
      }
      self.state.err("expected ',', ';', or ')' after clobber");
      ret .Some(.InvalidSymbol);
    }
    ret .None;
  }

  // Finds the byte offset in `src` of `line`/`col` (both 1-based),
  // walking newlines from the start. Used to slice out an asm block's
  // exact raw source text between its braces.
  _source_index_from_line_col(str src, num line, num col) Option<num> {
    if line == 0 || col == 0 {
      ret .None;
    }
    num n = len(src);
    num current_line = 1;
    num line_start = 0;
    num i = 0;
    for i < n && current_line < line {
      if src[i] == '\n' {
        current_line = current_line + 1;
        line_start = i + 1;
      }
      i = i + 1;
    }
    if current_line != line {
      ret .None;
    }
    num offset = col - 1;
    num idx = line_start + offset;
    if idx > n {
      ret .None;
    }
    ret .Some(idx);
  }

  // Captures an asm block's `{ ... }` body as raw source text, appending
  // it to `out`. Walks the raw token stream (not the "skip insignificant"
  // view `token_next` gives) tracking brace depth, since the body must
  // preserve exactly what the user wrote, comments and newlines included,
  // rather than anything the lexer/formatter would normalize.
  _append_raw_asm_block_template(StringBuilder* out, Token open_brace_tok) Option<ParseErrorKind> {
    num depth = 1;
    Option<Token> close_brace_tok = .None;
    for true {
      if self.state.pindex >= self.state.tokens.len {
        self.state.err("unexpected end of file in asm block");
        ret .Some(.InvalidStatement);
      }
      let t = self.state.tokens.get(self.state.pindex);
      if t.type == .Symbol {
        fit t.data {
          .Cval(c) -> {
            if c == '{' {
              depth = depth + 1;
            } elif c == '}' {
              depth = depth - 1;
              if depth == 0 {
                close_brace_tok = .Some(t);
                self.state.pindex = self.state.pindex + 1;
                break;
              }
            }
          }
          _ -> {}
        }
      }
      self.state.pindex = self.state.pindex + 1;
    }
    if close_brace_tok.is_none() {
      self.state.err("unexpected end of file in asm block");
      ret .Some(.InvalidStatement);
    }
    let close_tok = close_brace_tok.unwrap();

    let start_idx_opt = self._source_index_from_line_col(
      self.state.input_source,
      open_brace_tok.pos.end_line,
      open_brace_tok.pos.end_col
    );
    let end_idx_opt = self._source_index_from_line_col(
      self.state.input_source,
      close_tok.pos.line,
      close_tok.pos.start_col
    );
    if start_idx_opt.is_none() || end_idx_opt.is_none() {
      self.state.err("internal parser error: invalid asm block span");
      ret .Some(.InvalidStatement);
    }
    num start_idx = start_idx_opt.unwrap();
    num end_idx = end_idx_opt.unwrap();
    if end_idx < start_idx || end_idx > len(self.state.input_source) {
      self.state.err("internal parser error: malformed asm block span");
      ret .Some(.InvalidStatement);
    }
    out.append(substr(self.state.input_source, start_idx, end_idx - start_idx));
    ret .None;
  }

  // Parses an `asm` statement: optional `volatile`, optional `arch
  // <name>`, an optional parenthesized `out`/`in`/`clobber` operand list
  // (GCC-style extended asm), then the template body as either a string
  // literal or a raw `{ ... }` block.
  pub parse_asm_statement() Option<ParseErrorKind> {
    let asm_tok = self.state.token_peek_next();
    if !self.has_current_function {
      self.state.err("asm statement outside of function");
      ret .Some(.InvalidStatement);
    }
    self.state.token_next(); // consume 'asm'

    bin is_volatile = false;
    let vol_tok = self.state.token_peek_next();
    if vol_tok.is_some() && token_is_keyword(vol_tok.unwrap(), "volatile") {
      self.state.token_next();
      is_volatile = true;
    }

    str arch_name = "";
    bin has_arch = false;
    let arch_kw_tok = self.state.token_peek_next();
    if arch_kw_tok.is_some() && token_is_keyword(arch_kw_tok.unwrap(), "arch") {
      self.state.token_next();
      let arch_val_tok = self.state.token_next();
      if arch_val_tok.is_none() ||
        (arch_val_tok.unwrap().type != .Identifier && arch_val_tok.unwrap().type != .Keyword) {
        self.state.err("expected architecture name after 'arch'");
        ret .Some(.InvalidIdentifier);
      }
      fit arch_val_tok.unwrap().data {
        .Sval(s) -> { arch_name = s; }
        _ -> {}
      }
      has_arch = true;
    }

    Vec<AsmOperand> outputs;
    outputs.init(0);
    Vec<AsmOperand> inputs;
    inputs.init(0);
    Vec<str> clobbers;
    clobbers.init(0);

    let open_paren_tok = self.state.token_peek_next();
    if open_paren_tok.is_some() &&
      (token_is_symbol(open_paren_tok.unwrap(), '(') || token_is_operator(
      open_paren_tok.unwrap(),
      "("
    )) {
      self.state.token_next();
      for true {
        self.state.skip_nl_or_comment();
        let peek_tok = self.state.token_peek_next();
        if peek_tok.is_none() {
          self.state.err("expected ')' to close asm operands");
          ret .Some(.InvalidStatement);
        }
        let pt = peek_tok.unwrap();
        if token_is_symbol(pt, ')') || token_is_operator(pt, ")") {
          self.state.token_next();
          break;
        }
        let section_tok = self.state.token_next();
        if section_tok.is_none() ||
          (section_tok.unwrap().type != .Identifier && section_tok.unwrap().type != .Keyword) {
          self.state.err("expected asm operand section");
          ret .Some(.InvalidKeyword);
        }
        str section = "";
        fit section_tok.unwrap().data {
          .Sval(s) -> { section = s; }
          _ -> {}
        }
        if equals(section, "in") {
          let ierr = self._parse_asm_operand_list(&inputs);
          if ierr.is_some() {
            ret ierr;
          }
        } elif equals(section, "out") {
          let oerr = self._parse_asm_operand_list(&outputs);
          if oerr.is_some() {
            ret oerr;
          }
        } elif equals(section, "clobber") {
          let cerr = self._parse_asm_clobber_list(&clobbers);
          if cerr.is_some() {
            ret cerr;
          }
        } else {
          let msg = format("unknown asm section '{str}'", section);
          defer free(msg);
          self.state.err(msg);
          ret .Some(.InvalidKeyword);
        }
      }
    }

    str template = "";
    bin is_string_literal = false;
    self.state.skip_nl_or_comment();

    let body_tok = self.state.token_peek_next();
    if body_tok.is_none() {
      self.state.err("expected asm body");
      ret .Some(.InvalidStatement);
    }
    let bt = body_tok.unwrap();
    if bt.type == .String {
      self.state.token_next();
      fit bt.data {
        .Sval(s) -> { template = s; }
        _ -> {}
      }
      is_string_literal = true;
    } elif token_is_symbol(bt, '{') {
      let open_brace_tok = self.state.token_next();
      if open_brace_tok.is_none() {
        self.state.err("expected '{' to start asm block");
        ret .Some(.InvalidStatement);
      }
      StringBuilder tmpl_sb = string_builder_init(32);
      let berr = self._append_raw_asm_block_template(&tmpl_sb, open_brace_tok.unwrap());
      if berr.is_some() {
        ret berr;
      }
      template = tmpl_sb.build();
    } else {
      self.state.err("expected asm body (string or block)");
      ret .Some(.InvalidStatement);
    }

    let serr = self.state.expect_sym(';');
    if serr.is_some() {
      ret serr;
    }

    AsmStmtNode a = asm_stmt_node_new();
    a.template = template;
    a.is_volatile = is_volatile;
    a.arch_name = arch_name;
    a.has_arch = has_arch;
    a.outputs = outputs;
    a.inputs = inputs;
    a.clobbers = clobbers;
    a.is_string_literal = is_string_literal;

    Node node = node_new(.StatementAsm(a));
    fit asm_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `test "name" { ... }`, top-level only since `test` is never
  // wired into `parse_statement`'s dispatch. The body reuses ordinary
  // statement parsing under a synthetic nameless function context, so
  // statements that check `has_current_function` behave the same inside a
  // test body as in a real function.
  pub parse_test_declaration() Option<ParseErrorKind> {
    let test_tok = self.state.token_next(); // consume 'test'

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != .String {
      self.state.err("expected a string name after 'test'");
      ret .Some(.InvalidString);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    self.state.new_scope();

    let prev_fn = self.current_function;
    let prev_has_fn = self.has_current_function;
    Node fn_stub = node_new(.Function(function_node_new()));
    self.current_function = &fn_stub;
    self.has_current_function = true;

    let berr = self.parse_body();
    self.current_function = prev_fn;
    self.has_current_function = prev_has_fn;
    self.state.finish_scope();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected test body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    TestDeclNode td;
    td.name = name;
    td.body = body;

    Node node = node_new(.Test(td));
    fit test_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.state.nodes.push(node);
    ret .None;
  }

  // Validates one of `fuzz`'s two parameters against its fixed contract
  // (see `parse_fuzz_declaration`). The fuzzing calling convention always
  // hands back a raw byte pointer plus a length, so the parameter types
  // aren't free to vary even though they're written out explicitly.
  _check_fuzz_param_shape(Node* param, str expected_type_name, num expected_pointer_depth) Option<ParseErrorKind> {
    fit param.kind {
      .Variable(v) -> {
        if !equals(v.var_type.type_str, expected_type_name) ||
          v.var_type.pointer_depth != expected_pointer_depth {
          self.state.err("'fuzz' parameter has the wrong type -- expected 'raw* data, num len'");
          ret .Some(.InvalidStatement);
        }
        ret .None;
      }
      _ -> {
        self.state.err("invalid 'fuzz' parameter");
        ret .Some(.InvalidStatement);
      }
    }
  }

  // Parses `fuzz "name" (raw* data, num len) { ... }`, top-level only like
  // `parse_test_declaration`. Parameters are written out explicitly and
  // parsed via `_parse_function_args`, but the fuzzing calling convention
  // fixes their types, so `_check_fuzz_param_shape` validates the parsed
  // shape against that contract.
  pub parse_fuzz_declaration() Option<ParseErrorKind> {
    let fuzz_tok = self.state.token_next(); // consume 'fuzz'

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != .String {
      self.state.err("expected a string name after 'fuzz'");
      ret .Some(.InvalidString);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    self.state.new_scope();

    let operr = self.state.expect_op("(");
    if operr.is_some() {
      self.state.finish_scope();
      ret operr;
    }

    Vec<Node*> args;
    args.init(0);
    bin is_variadic = false;
    let aerr = self._parse_function_args(&args, &is_variadic);
    if aerr.is_some() {
      self.state.finish_scope();
      ret aerr;
    }

    let cperr = self.state.expect_sym(')');
    if cperr.is_some() {
      self.state.finish_scope();
      ret cperr;
    }

    if is_variadic || args.len != 2 {
      self.state.err("'fuzz' requires exactly two explicitly-typed parameters: 'raw* data, num len'");
      self.state.finish_scope();
      ret .Some(.InvalidStatement);
    }

    Node* data_param = args.get(0);
    Node* len_param = args.get(1);
    let dcheck = self._check_fuzz_param_shape(data_param, "raw", 1);
    if dcheck.is_some() {
      self.state.finish_scope();
      ret dcheck;
    }
    let lcheck = self._check_fuzz_param_shape(len_param, "num", 0);
    if lcheck.is_some() {
      self.state.finish_scope();
      ret lcheck;
    }

    let prev_fn = self.current_function;
    let prev_has_fn = self.has_current_function;
    Node fn_stub = node_new(.Function(function_node_new()));
    self.current_function = &fn_stub;
    self.has_current_function = true;

    let berr = self.parse_body();
    self.current_function = prev_fn;
    self.has_current_function = prev_has_fn;
    self.state.finish_scope();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected fuzz body");
      ret .Some(.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    FuzzDeclNode fd;
    fd.name = name;
    fd.data_param = data_param;
    fd.len_param = len_param;
    fd.body = body;

    Node node = node_new(.Fuzz(fd));
    fit fuzz_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.state.nodes.push(node);
    ret .None;
  }

  // True for the warning ids that may be controlled at module scope (no
  // enclosing function); everything else needs a function to check inside.
  _warning_control_is_valid_in_module_scope(WarningId id) bin {
    fit id {
      .UnusedVariable -> { ret true; }
      .UnusedImport -> { ret true; }
      .UnusedFunction -> { ret true; }
      .UnusedCompound -> { ret true; }
      _ -> { ret false; }
    }
  }

  // Parses `allow <warning_id>, "reason";` or `expect <warning_id>,
  // "reason";`.
  pub parse_warning_control(WarningControlAction action) Option<ParseErrorKind> {
    let ctrl_tok = self.state.token_peek_next();
    self.state.token_next(); // consume 'allow'/'expect'

    let id_tok = self.state.token_next();
    if id_tok.is_none() || id_tok.unwrap().type != .Identifier {
      self.state.err("expected warning id after 'allow'/'expect'");
      ret .Some(.InvalidIdentifier);
    }
    str id_name = "";
    fit id_tok.unwrap().data {
      .Sval(s) -> { id_name = s; }
      _ -> {}
    }
    let maybe_id = warning_id_from_string(id_name);
    if maybe_id.is_none() {
      let msg = format(
        "unknown warning id '{str}' (expected one of: return_local_ptr, fit_non_exhaustive, fit_unreachable_branch, unreachable_code, assert_constant, unused_variable, unused_import, unused_function, unused_compound, missing_return, blocking_fork_deadlock, shared_mutable_capture_race, integer_literal_out_of_range, channel_capacity_overflow)",
        id_name
      );
      defer free(msg);
      self.state.err(msg);
      ret .Some(.InvalidIdentifier);
    }
    WarningId warning_id = maybe_id.unwrap();

    if !self.has_current_function &&
      !self._warning_control_is_valid_in_module_scope(warning_id) {
      self.state.err("this warning id is only valid inside functions; only unused_variable, unused_import, unused_function, and unused_compound may be controlled at module scope");
      ret .Some(.InvalidStatement);
    }

    let commaerr = self.state.expect_op(",");
    if commaerr.is_some() {
      ret commaerr;
    }

    let reason_tok = self.state.token_next();
    if reason_tok.is_none() || reason_tok.unwrap().type != .String {
      self.state.err("expected string reason after warning id");
      ret .Some(.InvalidString);
    }
    str reason = "";
    fit reason_tok.unwrap().data {
      .Sval(s) -> { reason = s; }
      _ -> {}
    }

    WarningCtrlNode wc;
    wc.action = action;
    wc.id = warning_id;
    wc.reason = reason;

    Node node = node_new(.StatementWarningControl(wc));
    fit ctrl_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses exactly one statement, then stamps its own `pos.end_line`
  // from the last token it consumed: every individual `parse_X`
  // dispatched by `_parse_statement_dispatch` below sets `pos` from
  // its own leading token only (a `ret`'s own keyword, a `fit`'s own
  // keyword, ...), which never reflects a multi-line statement's real
  // extent (a call spanning several lines, an `if` whose own body
  // runs past it). Anything that reads a statement's own span - most
  // directly, fls's own scope-boundary checks (`covers`/`_last_line`)
  // - needs the real extent, not just the start. One shared fix here
  // covers every statement kind at once, rather than patching each
  // `parse_X` individually.
  pub parse_statement() Option<ParseErrorKind> {
    let err = self._parse_statement_dispatch();
    if err.is_some() {
      ret err;
    }
    self._stamp_statement_end();
    ret .None;
  }

  // The last token this statement consumed (its own trailing `;` or
  // `}`) is always `current_token` by the time dispatch returns
  // successfully, so its line is the statement's own true last line.
  // A no-op when it's not past the statement's own already-recorded
  // start line, which covers a single-line statement without needing
  // its own case.
  _stamp_statement_end() {
    let top = self.state.node_peek_last();
    if top.is_none() {
      ret;
    }
    Node n = top.unwrap();
    if !n.has_pos || !self.state.has_current_token {
      ret;
    }
    num end_line = self.state.current_token.pos.line;
    if end_line > n.pos.line {
      n.pos.end_line = end_line;
      self.state.nodes.set(self.state.nodes.len - 1, n);
    }
  }

  // Parses one statement: a nested `{ ... }` body, a variable declaration
  // (`let`, `num x = 5;`, or a bare user type like `Point* p = ...;`), any
  // of the `ret`/`assert`/`if`/`for`/`fit`/`defer`/`break`/`continue`/
  // `allow`/`expect` statements, `fork <call>;`, `nil`/`panic(...)`/`await`
  // as expression statements, or a bare expression terminated by `;`. A
  // bare user-type declaration is found by a `<Identifier> [* ...]
  // <Identifier>` lookahead guarded on the name not already being a scope
  // entity, so `w * h;` isn't misread as a pointer declaration, and `fork`
  // is contextual: it's only a keyword when not followed by `(`, since it
  // is also an ordinary identifier for the POSIX `fork()` binding.
  // Top-level-only declarations are not dispatched here; a keyword with
  // no other case above reports a clean "not yet supported" error
  // instead of misparsing.
  _parse_statement_dispatch() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("unexpected end of file");
      ret .Some(.InvalidStatement);
    }
    let t = tok.unwrap();

    if t.type == .Keyword {
      str kw = "";
      fit t.data {
        .Sval(s) -> { kw = s; }
        _ -> {}
      }
      if keyword_is_datatype(kw) {
        ret self._parse_bare_type_variable_declaration(false);
      }
      if equals(kw, "let") {
        ret self.parse_let_declaration(false);
      }
      if equals(kw, "const") {
        ret self.parse_const_declaration(false);
      }
      if equals(kw, "ret") {
        ret self.parse_return();
      }
      if equals(kw, "assert") {
        ret self.parse_assert();
      }
      if equals(kw, "if") {
        ret self.parse_if_statement();
      }
      if equals(kw, "elif") {
        ret self.parse_elif_statement();
      }
      if equals(kw, "else") {
        ret self.parse_else_statement();
      }
      if equals(kw, "for") {
        ret self.parse_for_statement();
      }
      if equals(kw, "fit") {
        ret self.parse_fit_statement();
      }
      if equals(kw, "defer") {
        ret self.parse_defer_statement();
      }
      if equals(kw, "break") {
        ret self.parse_break_statement();
      }
      if equals(kw, "continue") {
        ret self.parse_continue_statement();
      }
      if equals(kw, "allow") {
        ret self.parse_warning_control(.Allow);
      }
      if equals(kw, "expect") {
        ret self.parse_warning_control(.Expect);
      }
      if equals(kw, "nil") || equals(kw, "panic") || equals(kw, "await") {
        let eerr = self.parse_expressionable_root();
        if eerr.is_some() {
          ret eerr;
        }
        ret self.state.expect_sym(';');
      }
      if equals(kw, "asm") {
        ret self.parse_asm_statement();
      }
      let msg = format("keyword '{str}' is not yet supported in statement position", kw);
      defer free(msg);
      self.state.err(msg);
      ret .Some(.InvalidStatement);
    }

    if t.type == .Identifier {
      str name = "";
      fit t.data {
        .Sval(s) -> { name = s; }
        _ -> {}
      }
      if equals(name, "fork") {
        let after = self.state.token_peek_n(1);
        bin calls_fork_itself = after.is_some() && token_is_operator(after.unwrap(), "(");
        if !calls_fork_itself {
          ret self.parse_fork_statement();
        }
      }

      // User-defined-type bare variable declaration: `Point p;`,
      // `Point* p;`, `Vec<num> v;`, `T[] xs;`. Detected by a
      // `<Identifier> [<generic args>] [* ...] [[...]] <Identifier>`
      // lookahead, guarded on the name not already being a scope entity so
      // an expression statement like `w * h;` isn't misread as a pointer
      // declaration. `skip_generic_args_tokens` skips the optional `<...>`
      // between the type name and any pointer stars.
      if self.state.get_scope_entity(name) == nil {
        // Optional qualified type segments after the leading identifier:
        // `alias.Type name;` (a module-alias-qualified type). Reads the
        // same shape as `parse_datatype`'s `.`-segment loop, once this
        // lookahead has already committed to the declaration path.
        num off = 1;
        for true {
          let dot_tok = self.state.token_peek_n(off);
          if dot_tok.is_none() {
            break;
          }
          bin is_dot = token_is_operator(dot_tok.unwrap(), ".") ||
            token_is_symbol(
            dot_tok.unwrap(),
            '.'
          );
          if !is_dot {
            break;
          }
          let seg_tok = self.state.token_peek_n(off + 1);
          if seg_tok.is_none() || seg_tok.unwrap().type != .Identifier {
            break;
          }
          off = off + 2;
        }
        off = self.state.skip_generic_args_tokens(off);
        for true {
          let tn = self.state.token_peek_n(off);
          if tn.is_none() {
            break;
          }
          if token_is_operator(tn.unwrap(), "*") {
            off = off + 1;
            continue;
          }
          break;
        }
        // Optional array brackets after the type name: `T[] xs;` or
        // `T[64] xs;`. Without skipping these, a local declaration of a
        // user-defined (or generic-param) array type falls through to
        // the expression path instead, which doesn't parse.
        for true {
          let bn = self.state.token_peek_n(off);
          if bn.is_none() || !token_is_operator(bn.unwrap(), "[") {
            break;
          }
          off = off + 1; // skip '['
          bin closed = false;
          for true {
            let inn = self.state.token_peek_n(off);
            if inn.is_none() {
              break;
            }
            let innt = inn.unwrap();
            if token_is_symbol(innt, ']') {
              off = off + 1; // skip ']'
              closed = true;
              break;
            }
            // Hitting a statement terminator before ']' means this
            // isn't a declaration after all.
            if token_is_symbol(innt, ';') {
              break;
            }
            off = off + 1;
          }
          if !closed {
            break;
          }
        }
        let t1 = self.state.token_peek_n(off);
        if t1.is_some() && t1.unwrap().type == .Identifier {
          ret self._parse_bare_type_variable_declaration(false);
        }
      }
    }

    if token_is_symbol(t, '{') {
      ret self.parse_body();
    }

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    ret self.state.expect_sym(';');
  }

  // Parses `imp path;` or `imp path as alias;`, including parent-
  // traversal path segments (`imp ..defs.user;`, `imp ...deep.thing;`).
  // Each pair of leading dots means "go up one directory"; `leading_dots`
  // sums the length of every leading all-dot operator token, so this
  // works whether the lexer handed back `..` as one token or `.` `.` as
  // two. The path and alias are recorded on the `Import` node but not
  // resolved; `import_resolver.fn` does that.
  pub parse_import() Option<ParseErrorKind> {
    let imp_tok = self.state.token_next(); // consume 'imp'

    num leading_dots = 0;
    for true {
      fit self.state.token_peek_next() {
        .Some(t) -> {
          if !_is_dot_run_operator(t) {
            break;
          }
          self.state.token_next();
          str s = "";
          fit t.data {
            .Sval(sv) -> { s = sv; }
            _ -> {}
          }
          leading_dots = leading_dots + len(s);
        }
        .None -> { break; }
      }
    }
    if leading_dots % 2 != 0 {
      self.state.err("invalid import path: expected '.' after '.'");
      ret .Some(.InvalidIdentifier);
    }

    let folder_tok = self.state.token_next();
    if folder_tok.is_none() || folder_tok.unwrap().type != .Identifier {
      self.state.err("expected folder identifier after import");
      ret .Some(.InvalidIdentifier);
    }
    str folder_name = "";
    fit folder_tok.unwrap().data {
      .Sval(s) -> { folder_name = s; }
      _ -> {}
    }

    str path = folder_name;
    num i = 0;
    for i < leading_dots {
      path = format("{chr}{str}", '.', path);
      i = i + 1;
    }

    for true {
      bin is_dot_run = false;
      fit self.state.token_peek_next() {
        .Some(t) -> { is_dot_run = _is_dot_run_operator(t); }
        .None -> {}
      }
      if !is_dot_run {
        break;
      }
      let dot_tok = self.state.token_next().unwrap();
      let part_tok = self.state.token_next();
      if part_tok.is_none() || part_tok.unwrap().type != .Identifier {
        self.state.err("expected identifier after '.' in import path");
        ret .Some(.InvalidIdentifier);
      }
      str dot_op = "";
      fit dot_tok.data {
        .Sval(s) -> { dot_op = s; }
        _ -> {}
      }
      str part_name = "";
      fit part_tok.unwrap().data {
        .Sval(s) -> { part_name = s; }
        _ -> {}
      }
      path = format("{str}{str}{str}", path, dot_op, part_name);
    }

    str alias = "";
    bin has_alias = false;
    if self.state.next_token_is_keyword("as") {
      self.state.token_next(); // consume 'as'
      let alias_tok = self.state.token_next();
      if alias_tok.is_none() || alias_tok.unwrap().type != .Identifier {
        self.state.err("expected alias identifier after 'as'");
        ret .Some(.InvalidIdentifier);
      }
      fit alias_tok.unwrap().data {
        .Sval(s) -> { alias = s; }
        _ -> {}
      }
      has_alias = true;
    }

    let serr = self.state.expect_sym(';');
    if serr.is_some() {
      ret serr;
    }

    ImportNode imp_node_data;
    imp_node_data.path = path;
    imp_node_data.alias = alias;
    imp_node_data.has_alias = has_alias;

    Node node = node_new(.Import(imp_node_data));
    fit imp_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `compound Name { field decls }` (optionally generic, `compound
  // Name<T> { ... }`): a struct-like user-defined type. Fields share a
  // datatype across a comma-separated name list (`dec x, y;`), though only
  // the first field in such a list may be an array type, since cloning the
  // size-expression AST per extra name isn't supported. Registers the
  // compound's name as a symbol so it can be used as a datatype identifier
  // elsewhere.
  pub parse_compound(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("compound");
    if kwerr.is_some() {
      ret kwerr;
    }

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != .Identifier {
      self.state.err("expected identifier after 'compound'");
      ret .Some(.InvalidIdentifier);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> type_param_forced_insts;
    type_param_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(
      &type_params,
      &type_param_forced_insts
    );
    if tperr.is_some() {
      ret tperr;
    }

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<CompoundField> fields;
    fields.init(0);

    for !self.state.next_token_is_symbol('}') {
      DataType* dt = malloc(sizeof(DataType));
      *dt = dtype_new();
      let derr = self.state.parse_datatype(dt);
      if derr.is_some() {
        ret derr;
      }
      if self.state.next_token_is_operator("[") {
        let aberr = self.parse_array_brackets(dt);
        if aberr.is_some() {
          ret aberr;
        }
      }

      num field_count = 0;
      for true {
        let field_tok = self.state.token_next();
        if field_tok.is_none() || field_tok.unwrap().type != .Identifier {
          self.state.err("expected field name");
          ret .Some(.InvalidIdentifier);
        }
        str fname = "";
        fit field_tok.unwrap().data {
          .Sval(s) -> { fname = s; }
          _ -> {}
        }

        // Only the first field in a combined multi-name list may be an
        // array type, since cloning the size-expression AST per extra
        // name isn't supported.
        if field_count > 0 && dt.is_array {
          self.state.err("array fields cannot be declared in a combined list; declare them separately");
          ret .Some(.InvalidDataType);
        }

        DataType* field_dt = malloc(sizeof(DataType));
        *field_dt = *dt;

        CompoundField cf;
        cf.name = fname;
        cf.dtype = field_dt;
        cf.pos = field_tok.unwrap().pos;
        cf.has_pos = true;
        fields.push(cf);
        field_count = field_count + 1;

        if !self.state.next_token_is_operator(",") {
          break;
        }
        self.state.token_next();
      }

      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    CompoundNode cn = compound_node_new();
    cn.name = name;
    cn.fields = fields;
    cn.type_params = type_params;
    cn.has_type_params = type_params.len > 0;
    cn.type_param_forced_insts = type_param_forced_insts;
    cn.has_type_param_forced_insts = type_param_forced_insts.len > 0;

    Node node = node_new(.Compound(cn));
    node.pos = name_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Symbol sym = symbol_new(name);
    sym.kind = .NodeSym(node);
    self.state.push_symbol(sym);

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `enum Name { variants }` (optionally generic, `enum Name<T> {
  // ... }`): a plain C-style enum, or a tagged union if any variant has a
  // data-carrying payload (`Circle(num)`). Variants are separated by `,`
  // or `;`, and a trailing separator before `}` is allowed. Registers the
  // enum's name as a symbol, and reuses
  // `parse_type_params_with_constraints` so `T: a | b` constraint syntax
  // parses here too, though constraints carry no meaning for an enum.
  pub parse_enum(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("enum");
    if kwerr.is_some() {
      ret kwerr;
    }

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != .Identifier {
      self.state.err("expected identifier after 'enum'");
      ret .Some(.InvalidIdentifier);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> unused_forced_insts;
    unused_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(&type_params, &unused_forced_insts);
    if tperr.is_some() {
      ret tperr;
    }

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<EnumVariant> variants;
    variants.init(0);

    for !self.state.next_token_is_symbol('}') {
      let vtok = self.state.token_next();
      if vtok.is_none() || vtok.unwrap().type != .Identifier {
        self.state.err("expected enum variant name");
        ret .Some(.InvalidIdentifier);
      }
      str vname = "";
      fit vtok.unwrap().data {
        .Sval(s) -> { vname = s; }
        _ -> {}
      }

      EnumVariant variant = enum_variant_new();
      variant.name = vname;
      variant.pos = vtok.unwrap().pos;
      variant.has_pos = true;

      // Optional positional payload for a data-carrying variant:
      // `Circle(num)`, `Rect(num, num)`.
      if self.state.next_token_is_operator("(") {
        self.state.token_next(); // consume '('
        Vec<DataType*> ptypes;
        ptypes.init(0);
        for !self.state.next_token_is_symbol(')') {
          DataType* pdt = malloc(sizeof(DataType));
          *pdt = dtype_new();
          let pderr = self.state.parse_datatype(pdt);
          if pderr.is_some() {
            ret pderr;
          }
          if self.state.next_token_is_operator("[") {
            let paberr = self.parse_array_brackets(pdt);
            if paberr.is_some() {
              ret paberr;
            }
          }
          ptypes.push(pdt);
          if !self.state.next_token_is_operator(",") {
            break;
          }
          self.state.token_next();
        }
        let rperr = self.state.expect_sym(')');
        if rperr.is_some() {
          ret rperr;
        }
        if ptypes.len == 0 {
          self.state.err("enum variant payload '()' must list at least one type");
          ret .Some(.InvalidToken);
        }
        variant.payload = ptypes;
        variant.has_payload = true;
      }

      // Optional explicit integer value: `A = 3`, `A = -1`.
      if self.state.next_token_is_operator("=") {
        self.state.token_next(); // consume '='
        bin negate = false;
        if self.state.next_token_is_operator("-") {
          self.state.token_next();
          negate = true;
        }
        let ntok = self.state.token_next();
        if ntok.is_none() || ntok.unwrap().type != .Number {
          self.state.err("expected integer literal after '='");
          ret .Some(.InvalidToken);
        }
        num v = 0;
        bin got_num = false;
        fit ntok.unwrap().data {
          .Num(n) -> {
            v = n;
            got_num = true;
          }
          _ -> {}
        }
        if !got_num {
          self.state.err("enum variant value must be an integer literal");
          ret .Some(.InvalidToken);
        }
        if negate {
          v = -v;
        }
        variant.value = v;
        variant.has_value = true;
      }

      if self.state.next_token_is_operator(",") {
        self.state.token_next();
      } elif self.state.next_token_is_symbol(';') {
        self.state.token_next();
      } elif !self.state.next_token_is_symbol('}') {
        self.state.err("expected ',' or ';' after enum variant");
        ret .Some(.InvalidToken);
      }

      variants.push(variant);
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    EnumDeclNode en = enum_decl_node_new();
    en.name = name;
    en.variants = variants;
    en.type_params = type_params;
    en.has_type_params = type_params.len > 0;

    Node node = node_new(.Enum(en));
    node.pos = name_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Symbol sym = symbol_new(name);
    sym.kind = .NodeSym(node);
    self.state.push_symbol(sym);

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `quirk Name { method sigs }` (optionally generic, `quirk
  // Name<T> { ... }`): a structural interface of method signatures with no
  // bodies, which `impl Type as Name { ... }` supplies. Registers the
  // quirk's name as a symbol, and reuses
  // `parse_type_params_with_constraints` so `T: a | b` constraint syntax
  // parses here too.
  pub parse_quirk(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("quirk");
    if kwerr.is_some() {
      ret kwerr;
    }

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != .Identifier {
      self.state.err("expected identifier after 'quirk'");
      ret .Some(.InvalidIdentifier);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> unused_forced_insts;
    unused_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(&type_params, &unused_forced_insts);
    if tperr.is_some() {
      ret tperr;
    }
    bin is_generic = type_params.len > 0;

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<QuirkMethodSig> methods;
    methods.init(0);

    for !self.state.next_token_is_symbol('}') {
      bin method_is_async = false;
      if self.state.next_token_is_keyword("async") {
        self.state.token_next();
        method_is_async = true;
      }

      let mname_tok = self.state.token_next();
      if mname_tok.is_none() || mname_tok.unwrap().type != .Identifier {
        self.state.err("expected method name");
        ret .Some(.InvalidIdentifier);
      }
      str mname = "";
      fit mname_tok.unwrap().data {
        .Sval(s) -> { mname = s; }
        _ -> {}
      }

      let lperr = self.state.expect_op("(");
      if lperr.is_some() {
        ret lperr;
      }

      Vec<QuirkArg> margs;
      margs.init(0);
      for !self.state.next_token_is_symbol(')') {
        DataType* adt = malloc(sizeof(DataType));
        *adt = dtype_new();
        let aderr = self.state.parse_datatype(adt);
        if aderr.is_some() {
          ret aderr;
        }
        if self.state.next_token_is_operator("[") {
          let qaberr = self.parse_array_brackets(adt);
          if qaberr.is_some() {
            ret qaberr;
          }
        }

        let aname_tok = self.state.token_next();
        if aname_tok.is_none() || aname_tok.unwrap().type != .Identifier {
          self.state.err("expected argument name");
          ret .Some(.InvalidIdentifier);
        }
        str aname = "";
        fit aname_tok.unwrap().data {
          .Sval(s) -> { aname = s; }
          _ -> {}
        }

        QuirkArg qa;
        qa.name = aname;
        qa.dtype = adt;
        margs.push(qa);

        if !self.state.next_token_is_operator(",") {
          break;
        }
        self.state.token_next();
      }
      let rperr = self.state.expect_sym(')');
      if rperr.is_some() {
        ret rperr;
      }

      DataType* rtype = malloc(sizeof(DataType));
      *rtype = dtype_new();
      bin has_explicit_rtype = false;
      fit self.state.token_peek_next() {
        .Some(rt) -> {
          bin looks_like_type = false;
          if rt.type == .Identifier {
            looks_like_type = true;
          }
          if rt.type == .Keyword {
            fit rt.data {
              .Sval(s) -> { looks_like_type = keyword_is_datatype(s); }
              _ -> {}
            }
          }
          if looks_like_type {
            let rderr = self.state.parse_datatype(rtype);
            if rderr.is_some() {
              ret rderr;
            }
            if self.state.next_token_is_operator("[") {
              let qrtaberr = self.parse_array_brackets(rtype);
              if qrtaberr.is_some() {
                ret qrtaberr;
              }
            }
            has_explicit_rtype = true;
          }
        }
        .None -> {}
      }
      if !has_explicit_rtype {
        rtype.kind = .Void;
        rtype.type_str = "void";
      }

      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }

      QuirkMethodSig ms = quirk_method_sig_new();
      ms.name = mname;
      ms.rtype = rtype;
      ms.args = margs;
      ms.is_async = method_is_async;
      ms.pos = mname_tok.unwrap().pos;
      methods.push(ms);
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    QuirkNode qn = quirk_node_new();
    qn.name = name;
    qn.methods = methods;
    qn.is_generic = is_generic;
    qn.type_params = type_params;
    qn.has_type_params = type_params.len > 0;

    Node node = node_new(.Quirk(qn));
    node.pos = name_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Symbol sym = symbol_new(name);
    sym.kind = .NodeSym(node);
    self.state.push_symbol(sym);

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `impl Type { methods }` or `impl Type as Quirk { methods }`,
  // including the generic forms. In `impl Type<T> { ... }` the arg is a
  // new type param the impl introduces, told apart from a concrete
  // monomorphizing `impl Type<num> { ... }` by
  // `impl_generic_args_are_params`; likewise `as Quirk<T>` is a symbolic
  // binding to the impl's own param while `as Quirk<num>` is a distinctly
  // mangled quirk identity. Each method becomes a top-level function named
  // `<Type>__<method>` (or `<Type>__<Quirk>__<method>`) with an implicit
  // `<Type>* self` first argument, parsed through the same
  // scope/`current_function` machinery as `parse_function`, and may carry
  // its own generic params plus a trailing `...` variadic marker.
  pub parse_impl(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("impl");
    if kwerr.is_some() {
      ret kwerr;
    }
    let type_tok = self.state.token_next();
    if type_tok.is_none() || type_tok.unwrap().type != .Identifier {
      self.state.err("expected type name after 'impl'");
      ret .Some(.InvalidIdentifier);
    }
    str base_type_name = "";
    fit type_tok.unwrap().data {
      .Sval(s) -> { base_type_name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> type_param_forced_insts;
    type_param_forced_insts.init(0);
    str type_name = base_type_name;
    DataType* impl_concrete_dt = nil;
    bin has_impl_concrete_dt = false;

    if self.state.next_token_is_angle_open() {
      if self.state.impl_generic_args_are_params() {
        let tperr = self.state.parse_type_params_with_constraints(
          &type_params,
          &type_param_forced_insts
        );
        if tperr.is_some() {
          ret tperr;
        }
      } else {
        DataType* concrete_dt = malloc(sizeof(DataType));
        *concrete_dt = dtype_new();
        concrete_dt.type_str = base_type_name;
        let gaerr = self.state.parse_generic_type_args(concrete_dt);
        if gaerr.is_some() {
          ret gaerr;
        }
        type_name = _mangled_dtype_name(concrete_dt);
        impl_concrete_dt = concrete_dt;
        has_impl_concrete_dt = true;
      }
    } else {
      let tperr = self.state.parse_type_params_with_constraints(
        &type_params,
        &type_param_forced_insts
      );
      if tperr.is_some() {
        ret tperr;
      }
    }
    bin has_type_params = type_params.len > 0;
    bin has_type_param_forced_insts = type_param_forced_insts.len > 0;

    let peek_after_type = self.state.token_peek_next();

    str quirk_name = "";
    bin has_quirk_name = false;
    str quirk_concrete_instantiation = "";
    bin has_quirk_concrete_instantiation = false;

    if peek_after_type.is_some() && token_is_keyword(peek_after_type.unwrap(), "as") {
      self.state.token_next(); // consume 'as'
      let quirk_tok = self.state.token_next();
      if quirk_tok.is_none() || quirk_tok.unwrap().type != .Identifier {
        self.state.err("expected quirk name after 'as'");
        ret .Some(.InvalidIdentifier);
      }
      str qname = "";
      fit quirk_tok.unwrap().data {
        .Sval(s) -> { qname = s; }
        _ -> {}
      }
      quirk_name = qname;
      has_quirk_name = true;

      // A generic quirk binding is either symbolic, where the arg is the
      // enclosing impl's own type param and mangling keys off the base
      // quirk name alone, or concrete, a fixed instantiation that is a
      // distinct quirk identity mangled like any generic instantiation.
      if self.state.next_token_is_angle_open() {
        DataType* quirk_dt = malloc(sizeof(DataType));
        *quirk_dt = dtype_new();
        quirk_dt.type_str = qname;
        let qgaerr = self.state.parse_generic_type_args(quirk_dt);
        if qgaerr.is_some() {
          ret qgaerr;
        }
        bin is_symbolic = _dtype_references_any_param(quirk_dt, type_params);
        if !is_symbolic {
          quirk_concrete_instantiation = _mangled_dtype_name(quirk_dt);
          has_quirk_concrete_instantiation = true;
        }
      }
    } elif peek_after_type.is_some() &&
    peek_after_type.unwrap().type == .Identifier {
      self.state.err("expected 'as' before quirk name in impl header");
      ret .Some(.InvalidIdentifier);
    } elif peek_after_type.is_none() || !token_is_symbol(peek_after_type.unwrap(), '{') {
      self.state.err("expected 'as <Quirk>' or '{' after type name");
      ret .Some(.InvalidIdentifier);
    }

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<Node*> methods;
    methods.init(0);

    for !self.state.next_token_is_symbol('}') {
      let merr = self._parse_impl_method(
        is_public,
        type_name,
        type_params,
        quirk_name,
        has_quirk_name,
        &methods
      );
      if merr.is_some() {
        ret merr;
      }
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    ImplNode impln = impl_node_new();
    impln.type_name = type_name;
    impln.type_params = type_params;
    impln.has_type_params = has_type_params;
    impln.type_param_forced_insts = type_param_forced_insts;
    impln.has_type_param_forced_insts = has_type_param_forced_insts;
    impln.quirk_name = quirk_name;
    impln.has_quirk_name = has_quirk_name;
    impln.quirk_concrete_instantiation = quirk_concrete_instantiation;
    impln.has_quirk_concrete_instantiation = has_quirk_concrete_instantiation;
    impln.concrete_dtype = impl_concrete_dt;
    impln.has_concrete_dtype = has_impl_concrete_dt;
    impln.methods = methods;

    Node node = node_new(.Impl(impln));
    node.pos = type_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses one impl method (`[pub] [async] name(args) [rtype] { body }`
  // or `... ;` for a bodyless one) and appends its generated `Function`
  // node to `out_methods`. See `parse_impl`'s doc comment for the
  // generated-name and implicit-`self` scheme this implements.
  _parse_impl_method(
    bin impl_is_public,
    str type_name,
    Vec<str> type_params,
    str quirk_name,
    bin has_quirk_name,
    Vec<Node*>* out_methods
  ) Option<ParseErrorKind> {
    bin method_is_public = impl_is_public;
    bin method_is_async = false;

    for true {
      let peek = self.state.token_peek_next();
      if peek.is_none() || peek.unwrap().type != .Keyword {
        break;
      }
      let pk = peek.unwrap();
      if token_is_keyword(pk, "pub") {
        self.state.token_next();
        method_is_public = true;
        continue;
      }
      if token_is_keyword(pk, "async") {
        self.state.token_next();
        method_is_async = true;
        continue;
      }
      break;
    }

    let mname_tok = self.state.token_next();
    if mname_tok.is_none() || mname_tok.unwrap().type != .Identifier {
      self.state.err("expected method name in impl");
      ret .Some(.InvalidIdentifier);
    }
    str mname = "";
    fit mname_tok.unwrap().data {
      .Sval(s) -> { mname = s; }
      _ -> {}
    }

    str gen_name = "";
    if has_quirk_name {
      gen_name = format("{str}__{str}__{str}", type_name, quirk_name, mname);
    } else {
      gen_name = format("{str}__{str}", type_name, mname);
    }

    FunctionNode fnv = function_node_new();
    fnv.name = gen_name;
    fnv.has_name = true;
    fnv.is_async = method_is_async;

    Node fn_node = node_new(.Function(fnv));
    fn_node.pos = mname_tok.unwrap().pos;
    fn_node.has_pos = true;
    fn_node.flags.is_public = method_is_public;

    Node* fn_node_ptr = malloc(sizeof(Node));
    *fn_node_ptr = fn_node;

    let prev_fn = self.current_function;
    let prev_has_fn = self.has_current_function;
    self.current_function = fn_node_ptr;
    self.has_current_function = true;

    self.state.new_scope();

    Vec<str> method_type_params;
    method_type_params.init(0);
    Vec<Vec<str>> method_type_param_forced_insts;
    method_type_param_forced_insts.init(0);
    let mtperr = self.state.parse_type_params_with_constraints(
      &method_type_params,
      &method_type_param_forced_insts
    );
    if mtperr.is_some() {
      ret mtperr;
    }
    fit fn_node_ptr.kind {
      .Function(curmtp) -> {
        curmtp.type_params = method_type_params;
        curmtp.has_type_params = method_type_params.len > 0;
        curmtp.type_param_forced_insts = method_type_param_forced_insts;
        curmtp.has_type_param_forced_insts = method_type_param_forced_insts.len > 0;
        fn_node_ptr.kind = .Function(curmtp);
      }
      _ -> {}
    }

    let lperr = self.state.expect_op("(");
    if lperr.is_some() {
      ret lperr;
    }

    // Implicit `<Type>* self` first arg. When the impl itself is
    // generic, `self`'s type carries the same type params as generic
    // arguments (`Box<T>* self`), so references to `self`'s fields
    // inside the method resolve against the impl's own params.
    DataType* self_dt = malloc(sizeof(DataType));
    *self_dt = dtype_new();
    self_dt.pointer_depth = 1;
    self_dt.flags.is_pointer = true;
    self_dt.type_str = type_name;
    if type_params.len > 0 {
      Vec<DataType*> self_gargs;
      self_gargs.init(0);
      for tp : type_params {
        DataType* ga = malloc(sizeof(DataType));
        *ga = dtype_new();
        ga.type_str = tp;
        self_gargs.push(ga);
      }
      self_dt.generic_args = self_gargs;
    }

    VariableNode selfv;
    selfv.var_type = self_dt;
    selfv.name = "self";
    selfv.val = nil;
    selfv.has_val = false;
    selfv.is_const = false;

    Node self_node = node_new(.Variable(selfv));
    self_node.pos = mname_tok.unwrap().pos;
    self_node.has_pos = true;

    Node* self_node_ptr = malloc(sizeof(Node));
    *self_node_ptr = self_node;
    ScopeEntity* self_entity = self.new_scope_entity(self_node_ptr);
    self.state.push_scope_entity(self_entity);

    Vec<Node*> margs;
    margs.init(0);
    margs.push(self_node_ptr);

    bin method_is_variadic = false;
    let aerr = self._parse_function_args(&margs, &method_is_variadic);
    if aerr.is_some() {
      ret aerr;
    }
    let rperr = self.state.expect_sym(')');
    if rperr.is_some() {
      ret rperr;
    }

    fit fn_node_ptr.kind {
      .Function(curargs) -> {
        curargs.args = margs;
        curargs.has_args = true;
        fn_node_ptr.kind = .Function(curargs);
      }
      _ -> {}
    }

    DataType* rtype = malloc(sizeof(DataType));
    bin has_explicit_rtype = false;
    fit self.state.token_peek_next() {
      .Some(rt) -> {
        bin looks_like_type = false;
        if rt.type == .Identifier {
          looks_like_type = true;
        }
        if rt.type == .Keyword {
          fit rt.data {
            .Sval(s) -> { looks_like_type = keyword_is_datatype(s); }
            _ -> {}
          }
        }
        if looks_like_type {
          *rtype = dtype_new();
          let rderr = self.state.parse_datatype(rtype);
          if rderr.is_some() {
            ret rderr;
          }
          if self.state.next_token_is_operator("[") {
            let imaberr = self.parse_array_brackets(rtype);
            if imaberr.is_some() {
              ret imaberr;
            }
          }
          has_explicit_rtype = true;
        }
      }
      .None -> {}
    }
    if !has_explicit_rtype {
      *rtype = dtype_new();
      rtype.kind = .Void;
      rtype.type_str = "void";
    }
    fit fn_node_ptr.kind {
      .Function(currt) -> {
        currt.rtype = rtype;
        currt.has_rtype = true;
        fn_node_ptr.kind = .Function(currt);
      }
      _ -> {}
    }

    if self.state.next_token_is_symbol('{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected method body");
        ret .Some(.InvalidStatement);
      }
      Node* body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();
      fit fn_node_ptr.kind {
        .Function(curbody) -> {
          curbody.body = body;
          curbody.has_body = true;
          fn_node_ptr.kind = .Function(curbody);
        }
        _ -> {}
      }
    } else {
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    self.current_function = prev_fn;
    self.has_current_function = prev_has_fn;
    self.state.finish_scope();

    out_methods.push(fn_node_ptr);
    ret .None;
  }

  // Parses one top-level item: `imp`, `test`, `compound`, `enum`, `quirk`,
  // `impl`, `pub`/`async fun`/`fun`, or a bare-datatype-keyword global
  // variable (`num x = 5;`). Anything `parse_statement` already
  // understands is delegated there directly, so a bare top-level
  // expression still needs its trailing `;`. An `asm` declaration or a
  // bare `Identifier name;` reports a clean "not yet supported" error
  // rather than misparsing.
  pub parse_top_level_declaration() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("unexpected end of file");
      ret .Some(.InvalidStatement);
    }
    let t = tok.unwrap();

    if t.type == .Keyword {
      str kw = "";
      fit t.data {
        .Sval(s) -> { kw = s; }
        _ -> {}
      }

      if equals(kw, "imp") {
        ret self.parse_import();
      }

      if equals(kw, "test") {
        ret self.parse_test_declaration();
      }

      if equals(kw, "fuzz") {
        ret self.parse_fuzz_declaration();
      }

      if equals(kw, "compound") {
        ret self.parse_compound(false);
      }

      if equals(kw, "enum") {
        ret self.parse_enum(false);
      }

      if equals(kw, "quirk") {
        ret self.parse_quirk(false);
      }

      if equals(kw, "impl") {
        ret self.parse_impl(false);
      }

      if equals(kw, "pub") {
        self.state.token_next(); // consume 'pub'
        let next_tok = self.state.token_peek_next();
        if next_tok.is_none() {
          self.state.err("expected a declaration after 'pub'");
          ret .Some(.InvalidStatement);
        }
        let nt = next_tok.unwrap();
        str nkw = "";
        bin nt_is_keyword = nt.type == .Keyword;
        if nt_is_keyword {
          fit nt.data {
            .Sval(s) -> { nkw = s; }
            _ -> {}
          }
          if keyword_is_datatype(nkw) {
            ret self._parse_bare_type_variable_declaration(true);
          }
          if equals(nkw, "let") {
            ret self.parse_let_declaration(true);
          }
          if equals(nkw, "const") {
            ret self.parse_const_declaration(true);
          }
          if equals(nkw, "compound") {
            ret self.parse_compound(true);
          }
          if equals(nkw, "enum") {
            ret self.parse_enum(true);
          }
          if equals(nkw, "quirk") {
            ret self.parse_quirk(true);
          }
          if equals(nkw, "impl") {
            ret self.parse_impl(true);
          }
          if equals(nkw, "async") {
            self.state.token_next(); // consume 'async'
            let fun_tok = self.state.token_peek_next();
            if fun_tok.is_none() || !token_is_keyword(fun_tok.unwrap(), "fun") {
              self.state.err("expected 'fun' after 'async'");
              ret .Some(.InvalidKeyword);
            }
            ret self.parse_function(true, true);
          }
          if equals(nkw, "fun") {
            ret self.parse_function(true, false);
          }
        }
        if nt_is_keyword {
          let msg = format("keyword '{str}' is not yet supported after 'pub'", nkw);
          defer free(msg);
          self.state.err(msg);
        } else {
          self.state.err("expected a declaration after 'pub'");
        }
        ret .Some(.InvalidKeyword);
      }

      if equals(kw, "async") {
        self.state.token_next(); // consume 'async'
        let fun_tok = self.state.token_peek_next();
        if fun_tok.is_none() || !token_is_keyword(fun_tok.unwrap(), "fun") {
          self.state.err("expected 'fun' after 'async'");
          ret .Some(.InvalidKeyword);
        }
        ret self.parse_function(false, true);
      }

      if equals(kw, "fun") {
        ret self.parse_function(false, false);
      }

      if keyword_is_datatype(kw) {
        ret self._parse_bare_type_variable_declaration(false);
      }
    }

    ret self.parse_statement();
  }

  // `<datatype> name [= val];`, an explicit-type variable declaration
  // with no leading `let`. Shared by `parse_statement` (inside a function
  // body, always private) and `parse_top_level_declaration` (`pub`/bare
  // at file scope).
  _parse_bare_type_variable_declaration(bin is_public) Option<ParseErrorKind> {
    DataType* dt = malloc(sizeof(DataType));
    *dt = dtype_new();
    let derr = self.state.parse_datatype(dt);
    if derr.is_some() {
      ret derr;
    }
    let verr = self.parse_variable(dt, is_public, false, false);
    if verr.is_some() {
      ret verr;
    }
    ret self.state.expect_sym(';');
  }

  // Repeatedly parses top-level items until the token stream is exhausted
  // or a parse error occurs, opening the file's root scope first and never
  // closing it. There is no cross-file `global_symbols` registration,
  // which `import_resolver.fn` does beforehand. Forward and out-of-order
  // function calls are tolerated by `parse_single_token_to_node`'s
  // identifier check; a forward-referenced compound-literal type name is
  // tolerated by the pre-scan below.
  pub parse() Option<ParseErrorKind> {
    self.state.prescan_forward_type_names();
    self.state.init_root_scope();
    for true {
      let peeked = self.state.token_peek_next();
      if peeked.is_none() {
        break;
      }
      let err = self.parse_top_level_declaration();
      if err.is_some() {
        ret err;
      }
    }
    ret .None;
  }
}

// ===== Test helpers =====

fun _state_from(str src) ParseState {
  ParseState st = parse_state_new("test.fn", src);
  st.tokens = tokenize(src, "test.fn").unwrap();
  // Tests exercise expected-failure paths too; keep stdout clean.
  st.emit_stderr = false;
  ret st;
}

test "token cursor advances past whitespace/newlines and reports EOF" {
  ParseState st = _state_from("let\nx");
  let first = st.token_next();
  assert first.is_some(), "expected a first token";
  assert token_is_keyword(first.unwrap(), "let"), "first token should be keyword 'let'";

  let second = st.token_next();
  assert second.is_some(), "expected a second token";
  fit second.unwrap().data {
    .Sval(s) -> { assert equals(s, "x"), "second token should be identifier 'x'"; }
    _ -> { panic("second token should carry Sval"); }
  }

  let third = st.token_next();
  assert third.is_none(), "expected end of stream after 2 tokens";
}

test "token_peek_next does not consume, token_peek_n looks further ahead" {
  ParseState st = _state_from("a b c");

  let peeked = st.token_peek_next();
  assert peeked.is_some(), "expected a peeked token";
  fit peeked.unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "peek should see 'a' without consuming it"; }
    _ -> { panic("expected Sval"); }
  }

  // Peeking again returns the same token (not consumed).
  let peeked_again = st.token_peek_next();
  fit peeked_again.unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "second peek should still see 'a'"; }
    _ -> { panic("expected Sval"); }
  }

  // n=1 looks one significant token further ahead without consuming anything.
  let ahead = st.token_peek_n(1);
  fit ahead.unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "token_peek_n(1) should see 'b'"; }
    _ -> { panic("expected Sval"); }
  }

  // Cursor is still at 'a': a real consume gets 'a', then 'b'.
  fit st.token_next().unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "first consume should still be 'a'"; }
    _ -> { panic("expected Sval"); }
  }
  fit st.token_next().unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "second consume should be 'b'"; }
    _ -> { panic("expected Sval"); }
  }
}

test "expect_sym/expect_op/expect_keyword succeed on a match" {
  // `(` lexes as an Operator (see lexdefs.fn's `op_treated_as_one`), not a
  // Symbol; only the small set of structural delimiters (`{ } ; ) ]`) are
  // Symbol tokens, so `)` is used here to exercise `expect_sym`.
  ParseState st = _state_from(") + let");
  assert st.expect_sym(')').is_none(), "expected ')' to match";
  assert st.expect_op("+").is_none(), "expected '+' to match";
  assert st.expect_keyword("let").is_none(), "expected 'let' to match";
}

test "expect_sym/expect_op/expect_keyword report a typed error on mismatch" {
  ParseState st = _state_from("let");
  let err_sym = st.expect_sym(')');
  assert err_sym.is_some(), "expected a mismatch error";
  fit err_sym.unwrap() {
    .InvalidSymbol -> {}
    _ -> { panic("expected InvalidSymbol"); }
  }

  ParseState st2 = _state_from("let");
  let err_op = st2.expect_op("+");
  assert err_op.is_some(), "expected a mismatch error";
  fit err_op.unwrap() {
    .InvalidOperand -> {}
    _ -> { panic("expected InvalidOperand"); }
  }

  ParseState st3 = _state_from("(");
  let err_kw = st3.expect_keyword("let");
  assert err_kw.is_some(), "expected a mismatch error";
  fit err_kw.unwrap() {
    .InvalidKeyword -> {}
    _ -> { panic("expected InvalidKeyword"); }
  }
}

test "push_symbol/get_symbol round-trip through the active table" {
  ParseState st = _state_from("");
  SymbolTable table = symbol_table_new("test");
  st.active_table = &table;
  st.has_active_table = true;

  assert st.get_symbol("x").is_none(), "expected no symbol before registration";

  Symbol s = symbol_new("x");
  st.push_symbol(s);

  let found = st.get_symbol("x");
  assert found.is_some(), "expected to find the registered symbol";
  assert equals(found.unwrap().name, "x"), "found symbol should be named 'x'";
}

test "push_scope_entity/get_scope_entity walk the scope chain" {
  ParseState st = _state_from("");
  Scope root = scope_new();
  Scope child = scope_new();
  child.parent = &root;
  child.has_parent = true;
  st.scope_root = &root;
  st.has_scope_root = true;
  st.scope_current = &child;
  st.has_scope_current = true;

  assert st.get_scope_entity("x") == nil, "expected no entity before registration";

  ScopeEntity* e = malloc(sizeof(ScopeEntity));
  *e = scope_entity_new("x");
  st.push_scope_entity(e);

  let found = st.get_scope_entity("x");
  assert found != nil, "expected to find the registered entity";
  assert equals(found.name, "x"), "found entity should be named 'x'";
  assert st.get_scope_entity("missing") == nil, "unregistered name should not be found";
}

test "create_node stamps binded owner/function context" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node body_node = node_new(.Blank);
  Node fn_node = node_new(.Blank);
  p.current_body = &body_node;
  p.has_current_body = true;
  p.current_function = &fn_node;
  p.has_current_function = true;

  Node n = node_new(.Blank);
  p.create_node(&n);

  assert n.has_binded, "expected create_node to stamp binded context";
  assert n.binded.has_owner, "expected binded.owner to be set from current_body";
  assert n.binded.has_function, "expected binded.function to be set from current_function";
  assert st.nodes.len == 1, "expected the node to be pushed into state.nodes";
}

test "create_node leaves binded unset with no active body/function" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node n = node_new(.Blank);
  p.create_node(&n);

  assert !n.has_binded, "expected no binded context outside any body/function";
  assert st.nodes.len == 1, "expected the node to be pushed into state.nodes";
}

test "new_scope_entity derives its name from the node kind" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node id_node = node_new(.Identifier("foo"));
  ScopeEntity* e = p.new_scope_entity(&id_node);
  assert equals(e.name, "foo"), "expected entity name derived from Identifier payload";

  Node blank_node = node_new(.Blank);
  ScopeEntity* blank_entity = p.new_scope_entity(&blank_node);
  assert equals(blank_entity.name, ""), "expected empty name for a non-nameable node kind";
}

test "parse_datatype reads a builtin scalar keyword" {
  ParseState st = _state_from("num");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected num to parse";
  assert dt.kind == .Num, "expected kind Num";
  assert equals(dt.type_str, "num"), "expected type_str 'num'";
  assert dt.pointer_depth == 0, "expected no pointer depth";
}

test "parse_datatype reads trailing pointer-depth markers" {
  ParseState st = _state_from("num**");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected num** to parse";
  assert dt.kind == .Num, "expected kind Num";
  assert dt.flags.is_pointer, "expected is_pointer flag set";
  assert dt.pointer_depth == 2, "expected pointer depth 2";
}

