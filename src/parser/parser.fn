test "parse_function parses args, an explicit return type, and a body" {
  ParseState st = _state_from("fun add(num a, num b) num { ret a + b; }");
  Parser p = parser_new(&st);
  assert p.parse_function(true, false).is_none(), "expected the function to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert equals(f.name, "add"), "expected function name 'add'";
      assert top.flags.is_public, "expected the function to be public";
      assert f.args.len == 2, "expected 2 args";
      let a0 = f.args.get(0);
      let a1 = f.args.get(1);
      fit a0.kind {
        .Variable(v) -> { assert equals(v.name, "a"), "expected first arg 'a'"; }
        _ -> { panic("expected a Variable arg"); }
      }
      fit a1.kind {
        .Variable(v) -> { assert equals(v.name, "b"), "expected second arg 'b'"; }
        _ -> { panic("expected a Variable arg"); }
      }
      assert f.has_rtype, "expected an rtype";
      assert equals(f.rtype.type_str, "num"), "expected rtype 'num'";
      assert f.has_body, "expected a body";
      fit f.body.kind {
        .Body(bn) -> { assert bn.statements.len == 1, "expected 1 statement in the body"; }
        _ -> { panic("expected a Body node"); }
      }
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_array_brackets parses a bare '[]' and a sized '[5]'" {
  ParseState st = _state_from("[][5]");
  Parser p = parser_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  assert p.parse_array_brackets(dt).is_none(), "expected '[][5]' to parse";
  assert dt.is_array, "expected is_array";
  assert dt.array_depth == 2, "expected array depth 2";
  // Only the '[5]' bracket is recorded; the bare '[]' has no size
  // expression to keep.
  assert dt.array_brackets.len == 1, "expected 1 recorded bracket";
  let b0 = dt.array_brackets.get(0);
  fit b0.kind {
    .Bracket(inner) -> {
      fit inner.kind {
        .Number(_) -> {}
        _ -> { panic("expected a Number size expression"); }
      }
    }
    _ -> { panic("expected a Bracket node"); }
  }
}

test "parse_function parses an array-typed argument and return type" {
  ParseState st = _state_from("fun sum(num[] arr) num[] { ret arr; }");
  Parser p = parser_new(&st);
  assert p.parse_function(false, false).is_none(), "expected the function to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      let a0 = f.args.get(0);
      fit a0.kind {
        .Variable(v) -> {
          assert v.var_type.is_array, "expected the arg type to be an array";
          assert equals(v.var_type.type_str, "num"), "expected element type 'num'";
        }
        _ -> { panic("expected a Variable arg"); }
      }
      assert f.rtype.is_array, "expected the return type to be an array";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_compound parses an array-typed field" {
  ParseState st = _state_from("compound Buffer { num[16] data; }");
  Parser p = parser_new(&st);
  assert p.parse_compound(false).is_none(), "expected the compound to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Compound(c) -> {
      let f0 = c.fields.get(0);
      assert f0.dtype.is_array, "expected the field type to be an array";
      assert f0.dtype.array_depth == 1, "expected array depth 1";
    }
    _ -> { panic("expected a Compound node"); }
  }
}

test "parse_compound rejects an array field in a combined multi-name list" {
  ParseState st = _state_from("compound Buffer { num[16] data, other; }");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_compound(false);
  assert err.is_some(), "expected an error for an array field combined with another name";
}

test "parse_enum parses an array-typed variant payload element" {
  ParseState st = _state_from("enum Shape { Grid(num[]) }");
  Parser p = parser_new(&st);
  assert p.parse_enum(false).is_none(), "expected the enum to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Enum(e) -> {
      let v0 = e.variants.get(0);
      let pt0 = v0.payload.get(0);
      assert pt0.is_array, "expected the payload element type to be an array";
    }
    _ -> { panic("expected an Enum node"); }
  }
}

test "parse_quirk parses an array-typed arg and return type" {
  ParseState st = _state_from("quirk Sized { fill(num[] buf) num[]; }");
  Parser p = parser_new(&st);
  assert p.parse_quirk(false).is_none(), "expected the quirk to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Quirk(q) -> {
      let m0 = q.methods.get(0);
      let a0 = m0.args.get(0);
      assert a0.dtype.is_array, "expected the arg type to be an array";
      assert m0.rtype.is_array, "expected the return type to be an array";
    }
    _ -> { panic("expected a Quirk node"); }
  }
}

test "parse_impl parses an array-typed method return type" {
  ParseState st = _state_from("impl Buffer { data() num[] { ret self.data; } }");
  Parser p = parser_new(&st);
  assert p.parse_impl(false).is_none(), "expected the impl to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Impl(i) -> {
      let m0 = i.methods.get(0);
      fit m0.kind {
        .Function(f) -> { assert f.rtype.is_array, "expected the return type to be an array"; }
        _ -> { panic("expected a Function node"); }
      }
    }
    _ -> { panic("expected an Impl node"); }
  }
}

test "parse parses a top-level array-typed variable" {
  ParseState st = _state_from("num[4] counters;");
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected the file to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Variable(v) -> {
      assert equals(v.name, "counters"), "expected variable name 'counters'";
      assert v.var_type.is_array, "expected the variable type to be an array";
    }
    _ -> { panic("expected a Variable node"); }
  }
}

test "parse_function defaults to a void return type with no args" {
  ParseState st = _state_from("fun greet() { }");
  Parser p = parser_new(&st);
  assert p.parse_function(false, false).is_none(), "expected the function to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert equals(f.name, "greet"), "expected function name 'greet'";
      assert !top.flags.is_public, "expected the function to be private";
      assert f.args.len == 0, "expected no args";
      assert f.has_rtype, "expected an rtype";
      assert equals(f.rtype.type_str, "void"), "expected the default rtype 'void'";
      fit f.rtype.kind {
        .Void -> {}
        _ -> { panic("expected .Void"); }
      }
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_function registers its own name as a symbol" {
  ParseState st = _state_from("fun greet() { }");
  Parser p = parser_new(&st);
  assert st.get_symbol("greet").is_none(), "expected no symbol before parsing";
  assert p.parse_function(false, false).is_none(), "expected the function to parse";
  assert st.get_symbol("greet").is_some(), "expected 'greet' registered as a symbol once parsed";
}

test "parse_statement accepts a bare reference to an already-declared function used as a value, not just a call" {
  // A bare function name passed by name into a `fun(T) R`-typed parameter
  // isn't a call (no immediately following '('), so the out-of-order-call
  // bypass in `parse_single_token_to_node` (which only covers `foo(...)`)
  // doesn't apply. `parse_function` registers a function's own name as a
  // symbol as soon as it's parsed, which covers this case too.
  ParseState st = _state_from("fun add_one(num x) num {\n  ret x + 1;\n}\nfun apply(fun(num) num cb, num x) num {\n  ret cb(x);\n}\nfun main() num {\n  ret apply(add_one, 5);\n}\n");
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected the whole program (including the bare 'add_one' argument) to parse";
}

test "parse_function parses a bodyless declaration (C-binding style)" {
  ParseState st = _state_from("fun malloc(num size) raw*;");
  Parser p = parser_new(&st);
  assert p.parse_function(true, false).is_none(), "expected the bodyless declaration to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert equals(f.name, "malloc"), "expected function name 'malloc'";
      assert !f.has_body, "expected no body";
      assert equals(f.rtype.type_str, "raw"), "expected rtype 'raw'";
      assert f.rtype.pointer_depth == 1, "expected rtype pointer depth 1";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_function requires an identifier after 'fun'" {
  ParseState st = _state_from("fun () { }");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_function(false, false);
  assert err.is_some(), "expected an error for a missing function name";
}

test "parse_function parses generic type parameters with no constraints" {
  ParseState st = _state_from("fun identity<T>(T x) T { ret x; }");
  Parser p = parser_new(&st);
  assert p.parse_function(true, false).is_none(), "expected the generic function to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert f.has_type_params, "expected type params";
      assert f.type_params.len == 1, "expected 1 type param";
      assert equals(f.type_params.get(0), "T"), "expected type param 'T'";
      assert !f.has_type_param_forced_insts, "expected no forced instantiations without constraints";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_function parses constrained generic type parameters into forced instantiations" {
  ParseState st = _state_from("fun add<T: num | dec>(T a, T b) T { ret a; }");
  Parser p = parser_new(&st);
  assert p.parse_function(true, false).is_none(), "expected the constrained generic function to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert f.has_type_params, "expected type params";
      assert f.type_params.len == 1, "expected 1 type param";
      assert f.has_type_param_forced_insts, "expected forced instantiations";
      assert f.type_param_forced_insts.len == 2, "expected 2 forced instantiations (num, dec)";
      let combo0 = f.type_param_forced_insts.get(0);
      let combo1 = f.type_param_forced_insts.get(1);
      assert combo0.len == 1, "expected 1 type per combo";
      assert equals(combo0.get(0), "num"), "expected the first combo to be 'num'";
      assert equals(combo1.get(0), "dec"), "expected the second combo to be 'dec'";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_function parses variadic arguments and registers a 'vargs' scope entity" {
  ParseState st = _state_from("fun log(str fmt, ...) num { ret vargs; }");
  Parser p = parser_new(&st);
  assert p.parse_function(true, false).is_none(), "expected the variadic function to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert f.is_variadic, "expected is_variadic to be true";
      assert f.args.len == 1, "expected 1 named arg ('fmt'); '...' is not itself an arg";
      let a0 = f.args.get(0);
      fit a0.kind {
        .Variable(v) -> { assert equals(v.name, "fmt"), "expected the named arg 'fmt'"; }
        _ -> { panic("expected a Variable arg"); }
      }
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_function parses a bodyless variadic C-binding declaration" {
  ParseState st = _state_from("fun printf(str fmt, ...) num;");
  Parser p = parser_new(&st);
  assert p.parse_function(true, false).is_none(), "expected the bodyless variadic declaration to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert f.is_variadic, "expected is_variadic to be true";
      assert !f.has_body, "expected no body";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse parses multiple top-level function declarations" {
  ParseState st = _state_from("fun add(num a, num b) num { ret a + b; } fun main() num { ret 0; }");
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected the whole file to parse";
  assert st.nodes.len == 2, "expected 2 top-level nodes";
  fit st.nodes.get(0).kind {
    .Function(f) -> {
      assert equals(f.name, "add"), "expected the first function to be 'add'";
    }
    _ -> { panic("expected a Function node"); }
  }
  fit st.nodes.get(1).kind {
    .Function(f) -> {
      assert equals(f.name, "main"), "expected the second function to be 'main'";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse parses a public function and an async function" {
  ParseState st = _state_from("pub fun greet() { } async fun work() { }");
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected the whole file to parse";
  assert st.nodes.len == 2, "expected 2 top-level nodes";
  fit st.nodes.get(0).kind {
    .Function(f) -> {
      assert equals(f.name, "greet"), "expected the first function to be 'greet'";
      assert st.nodes.get(0).flags.is_public, "expected 'greet' to be public";
    }
    _ -> { panic("expected a Function node"); }
  }
  fit st.nodes.get(1).kind {
    .Function(f) -> {
      assert equals(f.name, "work"), "expected the second function to be 'work'";
      assert f.is_async, "expected 'work' to be async";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse parses top-level variable declarations (bare and public)" {
  ParseState st = _state_from("num counter = 0; pub str greeting = \"hi\";");
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected the whole file to parse";
  assert st.nodes.len == 2, "expected 2 top-level nodes";
  fit st.nodes.get(0).kind {
    .Variable(v) -> {
      assert equals(v.name, "counter"), "expected the first variable to be 'counter'";
    }
    _ -> { panic("expected a Variable node"); }
  }
  fit st.nodes.get(1).kind {
    .Variable(v) -> {
      assert equals(v.name, "greeting"), "expected the second variable to be 'greeting'";
      assert st.nodes.get(1).flags.is_public, "expected 'greeting' to be public";
    }
    _ -> { panic("expected a Variable node"); }
  }
}

test "parse_top_level_declaration reports a clean error for an unsupported top-level keyword" {
  ParseState st = _state_from("asm { }");
  st.emit_stderr = false;
