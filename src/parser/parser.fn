  p.has_current_function = true;

  assert p.parse_defer_statement().is_none(), "expected 'defer { a; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementDefer(body) -> {
      fit body.kind {
        .Body(bn) -> {
          assert bn.statements.len == 1, "expected 1 statement in the deferred body";
        }
        _ -> { panic("expected a Body node"); }
      }
    }
    _ -> { panic("expected a StatementDefer node"); }
  }
}

