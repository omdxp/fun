test "parse_statement disambiguates the 'fork' statement from calling a function named 'fork'" {
  ParseState st = _state_from("fork();");
  Parser p = parser_new(&st);
  assert p.parse_statement().is_none(), "expected 'fork();' (calling 'fork' itself) to parse as an ordinary call statement";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "()"), "expected a call expression";
      fit e.left.kind {
        .Identifier(s) -> {
          assert equals(s, "fork"), "expected the callee to be identifier 'fork'";
        }
        _ -> { panic("expected Identifier 'fork'"); }
      }
    }
    _ -> { panic("expected an Expression node, not a StatementFork"); }
  }
}

test "parse_normal_expression desugars a channel receive to '.recv()'" {
  Vec<str> names;
  names.init(0);
  names.push("ch");
  ParseState st = _state_with_declared("<-ch", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '<-ch' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(call) -> {
      assert equals(call.op, "()"), "expected a call expression";
      fit call.left.kind {
        .Expression(dot) -> {
          assert equals(dot.op, "."), "expected the callee to be a '.' member-access expression";
          fit dot.left.kind {
            .Identifier(s) -> { assert equals(s, "ch"), "expected receiver 'ch'"; }
            _ -> { panic("expected Identifier 'ch'"); }
          }
          fit dot.right.kind {
            .Identifier(s) -> { assert equals(s, "recv"), "expected method 'recv'"; }
            _ -> { panic("expected Identifier 'recv'"); }
          }
        }
        _ -> { panic("expected the callee to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_normal_expression desugars a channel send to '.send(v)'" {
  Vec<str> names;
  names.init(0);
  names.push("ch");
  names.push("v");
  ParseState st = _state_with_declared("ch <- v", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'ch <- v' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(call) -> {
      assert equals(call.op, "()"), "expected a call expression";
      fit call.left.kind {
        .Expression(dot) -> {
          assert equals(dot.op, "."), "expected the callee to be a '.' member-access expression";
          fit dot.right.kind {
            .Identifier(s) -> { assert equals(s, "send"), "expected method 'send'"; }
            _ -> { panic("expected Identifier 'send'"); }
          }
        }
        _ -> { panic("expected the callee to be an Expression"); }
      }
      fit call.right.kind {
        .Identifier(s) -> { assert equals(s, "v"), "expected the send value 'v'"; }
        _ -> { panic("expected Identifier 'v' as the call argument"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_warning_control parses 'allow ..., \"reason\";' at module scope" {
  ParseState st = _state_from("allow unused_variable, \"kept for clarity\";");
  Parser p = parser_new(&st);
  assert p.parse_warning_control(.Allow).is_none(), "expected the warning control statement to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementWarningControl(wc) -> {
      assert wc.action == .Allow, "expected action Allow";
      assert wc.id == .UnusedVariable, "expected id UnusedVariable";
      assert equals(wc.reason, "kept for clarity"), "expected the reason string";
    }
    _ -> { panic("expected a StatementWarningControl node"); }
  }
}

