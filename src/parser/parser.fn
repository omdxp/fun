test "parse_top_level_declaration dispatches 'compound' and 'enum'" {
  ParseState st = _state_from("compound Point { num x; } enum Color { Red }");
  Parser p = parser_new(&st);
  assert p.parse_top_level_declaration().is_none(), "expected 'compound' to dispatch";
  assert p.parse_top_level_declaration().is_none(), "expected 'enum' to dispatch";
  fit st.nodes.get(0).kind {
    .Compound(c) -> { assert equals(c.name, "Point"), "expected compound name 'Point'"; }
    _ -> { panic("expected a Compound node"); }
  }
  fit st.nodes.get(1).kind {
    .Enum(e) -> { assert equals(e.name, "Color"), "expected enum name 'Color'"; }
    _ -> { panic("expected an Enum node"); }
  }
