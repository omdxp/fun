test "parse_compound parses fields, including a shared-type multi-name declaration" {
  ParseState st = _state_from("compound Point { num x, y; str label; }");
  Parser p = parser_new(&st);
  assert p.parse_compound(true).is_none(), "expected the compound to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Compound(c) -> {
      assert equals(c.name, "Point"), "expected compound name 'Point'";
      assert top.flags.is_public, "expected the compound to be public";
      assert c.fields.len == 3, "expected 3 fields (x, y, label)";
      let f0 = c.fields.get(0);
      let f1 = c.fields.get(1);
      let f2 = c.fields.get(2);
      assert equals(f0.name, "x"), "expected first field 'x'";
      assert equals(f0.dtype.type_str, "num"), "expected 'x' to be 'num'";
      assert equals(f1.name, "y"), "expected second field 'y'";
      assert equals(f1.dtype.type_str, "num"), "expected 'y' to be 'num'";
      assert equals(f2.name, "label"), "expected third field 'label'";
      assert equals(f2.dtype.type_str, "str"), "expected 'label' to be 'str'";
    }
    _ -> { panic("expected a Compound node"); }
  }
}

test "parse_compound parses generic type parameters with constraints" {
  ParseState st = _state_from("compound Box<T: num | dec> { T val; }");
  Parser p = parser_new(&st);
  assert p.parse_compound(false).is_none(), "expected the generic compound to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Compound(c) -> {
      assert c.has_type_params, "expected type params";
      assert equals(c.type_params.get(0), "T"), "expected type param 'T'";
      assert c.has_type_param_forced_insts, "expected forced instantiations";
      assert c.type_param_forced_insts.len == 2, "expected 2 forced instantiations";
    }
    _ -> { panic("expected a Compound node"); }
  }
}

test "parse_compound registers the compound name as a symbol" {
  ParseState st = _state_from("compound Point { num x; }");
  Parser p = parser_new(&st);
  assert p.parse_compound(false).is_none(), "expected the compound to parse";
  assert st.get_symbol("Point").is_some(), "expected 'Point' to be registered as a symbol";
}

test "parse_enum parses plain C-style variants" {
  ParseState st = _state_from("enum Color { Red, Green, Blue }");
  Parser p = parser_new(&st);
  assert p.parse_enum(true).is_none(), "expected the enum to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Enum(e) -> {
      assert equals(e.name, "Color"), "expected enum name 'Color'";
      assert top.flags.is_public, "expected the enum to be public";
      assert e.variants.len == 3, "expected 3 variants";
      let v0 = e.variants.get(0);
      assert equals(v0.name, "Red"), "expected first variant 'Red'";
      assert !v0.has_payload, "expected 'Red' to have no payload";
      assert !v0.has_value, "expected 'Red' to have no explicit value";
    }
    _ -> { panic("expected an Enum node"); }
  }
}

test "parse_enum parses data-carrying variant payloads" {
  ParseState st = _state_from("enum Shape { Circle(num), Rect(num, num), Point }");
  Parser p = parser_new(&st);
  assert p.parse_enum(false).is_none(), "expected the enum to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Enum(e) -> {
      assert e.variants.len == 3, "expected 3 variants";
      let circle = e.variants.get(0);
      assert circle.has_payload, "expected 'Circle' to have a payload";
      assert circle.payload.len == 1, "expected 'Circle' to have 1 payload type";
      let rect = e.variants.get(1);
      assert rect.has_payload, "expected 'Rect' to have a payload";
      assert rect.payload.len == 2, "expected 'Rect' to have 2 payload types";
      let point = e.variants.get(2);
      assert !point.has_payload, "expected 'Point' to have no payload";
    }
    _ -> { panic("expected an Enum node"); }
  }
}

test "parse_enum parses explicit (including negative) variant values" {
  ParseState st = _state_from("enum Status { Ok = 0, Err = -1 }");
  Parser p = parser_new(&st);
  assert p.parse_enum(false).is_none(), "expected the enum to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Enum(e) -> {
      let ok = e.variants.get(0);
      assert ok.has_value, "expected 'Ok' to have an explicit value";
      assert ok.value == 0, "expected 'Ok' == 0";
      let err = e.variants.get(1);
      assert err.has_value, "expected 'Err' to have an explicit value";
      assert err.value == -1, "expected 'Err' == -1";
    }
    _ -> { panic("expected an Enum node"); }
  }
}

test "parse_enum parses generic type parameters" {
  ParseState st = _state_from("enum Option<T> { Some(T), None }");
  Parser p = parser_new(&st);
  assert p.parse_enum(false).is_none(), "expected the generic enum to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Enum(e) -> {
      assert e.has_type_params, "expected type params";
      assert equals(e.type_params.get(0), "T"), "expected type param 'T'";
    }
    _ -> { panic("expected an Enum node"); }
  }
}

test "parse_enum registers the enum name as a symbol" {
