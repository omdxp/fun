  }
}

test "parse_datatype reads a function-type parameter with two params and a return type" {
  ParseState st = _state_from("fun(num, num) num");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected 'fun(num, num) num' to parse";
  assert dt.has_fn_sig, "expected has_fn_sig set";
  assert dt.fn_sig.params.len == 2, "expected two params";
  let p0 = dt.fn_sig.params.get(0);
  let p1 = dt.fn_sig.params.get(1);
  assert p0.kind == .Num, "expected the first param typed num";
  assert p1.kind == .Num, "expected the second param typed num";
  assert dt.fn_sig.rtype.kind == .Num, "expected the return type num";
}

test "parse_datatype reads a zero-arg function-type parameter" {
  ParseState st = _state_from("fun() bin");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected 'fun() bin' to parse";
  assert dt.has_fn_sig, "expected has_fn_sig set";
  assert dt.fn_sig.params.len == 0, "expected no params";
  assert dt.fn_sig.rtype.kind == .Bin, "expected the return type bin";
}

test "parse_datatype defaults an omitted function-type return type to void" {
  // Nothing follows the closing ')' here: `parse_fn_type_datatype` treats
  // any identifier immediately after ')' as the return type, ambiguous
  // with an omitted return type followed by the enclosing parameter's own
  // name; end-of-input is the unambiguous case.
  ParseState st = _state_from("fun(chr)");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected 'fun(chr)' with nothing after it to parse";
  assert dt.has_fn_sig, "expected has_fn_sig set";
  assert dt.fn_sig.rtype.kind == .Void, "expected the omitted return type to default to void";
}

test "parse_datatype reads a user-defined type as a function-type parameter's own param/return type" {
  ParseState st = _state_from("fun(Token) Node");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected 'fun(Token) Node' to parse";
  assert dt.fn_sig.params.len == 1, "expected one param";
  let p0 = dt.fn_sig.params.get(0);
  assert equals(p0.type_str, "Token"), "expected the param's own type_str 'Token'";
  assert equals(dt.fn_sig.rtype.type_str, "Node"), "expected the return type's own type_str 'Node'";
}

test "parse_generic_type_args reads a single generic argument" {
