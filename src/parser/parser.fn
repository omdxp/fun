    _ -> { panic("expected String node"); }
  }

  ParseState st2 = _state_from("true");
  Parser p2 = parser_new(&st2);
  assert p2.parse_single_token_to_node().is_none(), "expected true to parse";
  let n2 = st2.nodes.get(0);
  fit n2.kind {
    .Boolean(b) -> { assert b, "expected true"; }
    _ -> { panic("expected Boolean node"); }
  }
}

test "parse_single_token_to_node accepts a declared identifier" {
  ParseState st = _state_from("x");
  Scope root = scope_new();
  st.scope_root = &root;
  st.has_scope_root = true;
  st.scope_current = &root;
  st.has_scope_current = true;
  ScopeEntity* e = malloc(sizeof(ScopeEntity));
  *e = scope_entity_new("x");
  st.push_scope_entity(e);

  Parser p = parser_new(&st);
  assert p.parse_single_token_to_node().is_none(), "expected declared 'x' to parse";
  let n = st.nodes.get(0);
  fit n.kind {
    .Identifier(s) -> { assert equals(s, "x"), "expected identifier 'x'"; }
    _ -> { panic("expected Identifier node"); }
  }
}

test "parse_single_token_to_node accepts wildcard, macro-style, and call-position identifiers without declaration" {
  ParseState st = _state_from("_");
  Parser p = parser_new(&st);
  assert p.parse_single_token_to_node().is_none(), "expected '_' to parse undeclared";

  ParseState st2 = _state_from("INT_MAX");
  Parser p2 = parser_new(&st2);
  assert p2.parse_single_token_to_node().is_none(), "expected ALL_CAPS macro-style name to parse undeclared";

  ParseState st3 = _state_from("foo(");
  Parser p3 = parser_new(&st3);
  assert p3.parse_single_token_to_node().is_none(), "expected a call-position identifier to parse undeclared";
}

test "parse_single_token_to_node reports an error for an unknown plain identifier" {
  ParseState st = _state_from("mystery");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_single_token_to_node();
  assert err.is_some(), "expected an error for an undeclared, non-special identifier";
  fit err.unwrap() {
    .InvalidIdentifier -> {}
    _ -> { panic("expected InvalidIdentifier"); }
  }
}

test "make_expression_node builds a binary Expression node from two operands" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  Node a = node_new(.Identifier("a"));
  Node b = node_new(.Identifier("b"));
  Pos p0;
  p0.line = 1;
  p.make_expression_node(&a, &b, "+", p0);

  assert st.nodes.len == 1, "expected exactly 1 pushed node";
  let n = st.nodes.get(0);
  fit n.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected op '+'";
      assert e.has_left && e.has_right, "expected both operands set";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected left 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "b"), "expected right 'b'"; }
        _ -> { panic("expected Identifier 'b'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_reorder_expression rotates a right-heavy naive parse when the outer operator binds tighter" {
  // Simulates the naive left-to-right parse of `a * b + c`, which (since
  // the RHS parse is greedy and swallows the rest of the expression
  // regardless of precedence) builds the right-heavy `(a * (b + c))`
  // instead of the precedence-correct `((a * b) + c)`.
  Node a = node_new(.Identifier("a"));
  Node b = node_new(.Identifier("b"));
  Node c = node_new(.Identifier("c"));

  ExprNode inner_e = expr_node_new();
  inner_e.left = &b;
  inner_e.has_left = true;
  inner_e.right = &c;
  inner_e.has_right = true;
  inner_e.op = "+";
  Node inner = node_new(.Expression(inner_e));

  ExprNode outer_e = expr_node_new();
  outer_e.left = &a;
  outer_e.has_left = true;
  outer_e.right = &inner;
  outer_e.has_right = true;
  outer_e.op = "*";
  Node outer = node_new(.Expression(outer_e));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  p.parse_reorder_expression(&outer);

  // Expect ((a * b) + c).
  fit outer.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to become '+' after rotation";
      fit e.left.kind {
        .Expression(le) -> {
          assert equals(le.op, "*"), "expected the new left child's op to stay '*'";
          fit le.left.kind {
            .Identifier(s) -> { assert equals(s, "a"), "expected left-left 'a'"; }
            _ -> { panic("expected Identifier 'a'"); }
          }
          fit le.right.kind {
            .Identifier(s) -> { assert equals(s, "b"), "expected left-right 'b'"; }
            _ -> { panic("expected Identifier 'b'"); }
          }
        }
        _ -> { panic("expected the new left child to be an Expression"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "c"), "expected the outer right to stay 'c'"; }
        _ -> { panic("expected Identifier 'c'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_reorder_expression leaves an already-correct right-heavy shape untouched" {
  // Simulates the naive parse of `a + b * c`: `(a + (b * c))`, which is
  // already the precedence-correct shape ('*' binds tighter than '+'), so
  // no rotation should happen.
  Node a = node_new(.Identifier("a"));
  Node b = node_new(.Identifier("b"));
  Node c = node_new(.Identifier("c"));

  ExprNode inner_e = expr_node_new();
  inner_e.left = &b;
  inner_e.has_left = true;
  inner_e.right = &c;
  inner_e.has_right = true;
  inner_e.op = "*";
  Node inner = node_new(.Expression(inner_e));

  ExprNode outer_e = expr_node_new();
  outer_e.left = &a;
  outer_e.has_left = true;
  outer_e.right = &inner;
  outer_e.has_right = true;
  outer_e.op = "+";
  Node outer = node_new(.Expression(outer_e));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  p.parse_reorder_expression(&outer);

  fit outer.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to stay '+'";
      fit e.right.kind {
        .Expression(re) -> {
          assert equals(re.op, "*"), "expected the right child to stay '(b * c)'";
        }
        _ -> { panic("expected the right child to remain an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_reorder_expression rotates a chain needing two rotations" {
  // Matches how the parser builds `a * b * c * d`: each operator's RHS is
  // parsed and reordered first, so an outer node's right child is already
  // a fully reordered sub-expression. `parse_reorder_expression` runs
  // bottom-up, once per level, never on a raw multi-level chain.
  Node a = node_new(.Identifier("a"));
  Node b = node_new(.Identifier("b"));
  Node c = node_new(.Identifier("c"));
  Node d = node_new(.Identifier("d"));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  // Innermost first: (c * d).
  ExprNode e_cd = expr_node_new();
  e_cd.left = &c;
  e_cd.has_left = true;
  e_cd.right = &d;
  e_cd.has_right = true;
  e_cd.op = "*";
  Node cd = node_new(.Expression(e_cd));
  p.parse_reorder_expression(&cd);

  // Then (b * (c * d)) -> rotates to ((b * c) * d).
  ExprNode e_bcd = expr_node_new();
  e_bcd.left = &b;
  e_bcd.has_left = true;
  e_bcd.right = &cd;
  e_bcd.has_right = true;
  e_bcd.op = "*";
  Node bcd = node_new(.Expression(e_bcd));
  p.parse_reorder_expression(&bcd);

  // Then (a * ((b * c) * d)) -> rotates to (((a * b) * c) * d).
  ExprNode e_top = expr_node_new();
  e_top.left = &a;
  e_top.has_left = true;
  e_top.right = &bcd;
  e_top.has_right = true;
  e_top.op = "*";
  Node n1 = node_new(.Expression(e_top));
  p.parse_reorder_expression(&n1);

  // Expect (((a * b) * c) * d): top op '*', right = d, left = ((a*b)*c).
  fit n1.kind {
    .Expression(top) -> {
      fit top.right.kind {
        .Identifier(s) -> { assert equals(s, "d"), "expected the outermost right to be 'd'"; }
        _ -> { panic("expected Identifier 'd'"); }
      }
      fit top.left.kind {
        .Expression(mid) -> {
          fit mid.right.kind {
            .Identifier(s) -> { assert equals(s, "c"), "expected the middle right to be 'c'"; }
            _ -> { panic("expected Identifier 'c'"); }
          }
          fit mid.left.kind {
            .Expression(inner) -> {
              fit inner.left.kind {
                .Identifier(s) -> {
                  assert equals(s, "a"), "expected the innermost left to be 'a'";
                }
                _ -> { panic("expected Identifier 'a'"); }
              }
              fit inner.right.kind {
                .Identifier(s) -> {
                  assert equals(s, "b"), "expected the innermost right to be 'b'";
                }
                _ -> { panic("expected Identifier 'b'"); }
              }
            }
            _ -> { panic("expected the innermost left to be an Expression"); }
          }
        }
        _ -> { panic("expected the middle left to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_node_move_right_left_to_left rotates a call/comma-shaped pair" {
  Node callee = node_new(.Identifier("foo"));
  Node blank = node_new(.Blank);
  ExprNode call_e = expr_node_new();
  call_e.left = &callee;
  call_e.has_left = true;
  call_e.right = &blank;
  call_e.has_right = true;
  call_e.op = "()";
  Node call_node = node_new(.Expression(call_e));

  Node x = node_new(.Identifier("x"));
  Node y = node_new(.Identifier("y"));
  ExprNode comma_e = expr_node_new();
  comma_e.left = &x;
  comma_e.has_left = true;
  comma_e.right = &y;
  comma_e.has_right = true;
  comma_e.op = ",";
  Node comma_node = node_new(.Expression(comma_e));

  // The rotation carries the top node's own op onto the new left child,
  // not `call_node`'s, so `top`'s own op must be "()" for the new left
  // child to end up "()"-shaped too.
  ExprNode top_e = expr_node_new();
  top_e.left = &call_node;
  top_e.has_left = true;
  top_e.right = &comma_node;
  top_e.has_right = true;
  top_e.op = "()";
  Node top = node_new(.Expression(top_e));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  p.parse_node_move_right_left_to_left(&top);

  // Expect: left = (foo() x) [op "()"], right = y, top op = ",".
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, ","), "expected the top op to become ','";
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "y"), "expected the top right to be 'y'"; }
        _ -> { panic("expected Identifier 'y'"); }
      }
      fit e.left.kind {
        .Expression(le) -> {
          assert equals(le.op, "()"), "expected the new left op to stay '()'";
          fit le.right.kind {
            .Identifier(s) -> {
              assert equals(s, "x"), "expected the new left's right to be 'x'";
            }
            _ -> { panic("expected Identifier 'x'"); }
          }
        }
        _ -> { panic("expected the new left to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

// Sets up a ParseState with a root/current scope and one declared entity
// per name in `names`, so `parse_single_token_to_node`'s identifier
// validation accepts them as ordinary values. Used by the end-to-end
// expression-parsing tests below.
fun _state_with_declared(str src, Vec<str> names) ParseState {
  ParseState st = _state_from(src);
  Scope* root = malloc(sizeof(Scope));
  *root = scope_new();
  st.scope_root = root;
  st.has_scope_root = true;
  st.scope_current = root;
  st.has_scope_current = true;
  num i = 0;
  for i < names.len {
    ScopeEntity* e = malloc(sizeof(ScopeEntity));
    *e = scope_entity_new(names.get(i));
    st.push_scope_entity(e);
    i = i + 1;
  }
  ret st;
}

test "parse_expressionable_root parses a simple binary expression" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("a + b", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a + b' to parse";
  // `node_pop` really removes elements (a genuine stack, not a persistent
  // array with a logical top pointer): `a` and `b` are consumed when
  // combined into the Expression, so only the final combined node remains.
  assert st.nodes.len == 1, "expected only the final Expression node to remain";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected op '+'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected left 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "b"), "expected right 'b'"; }
        _ -> { panic("expected Identifier 'b'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a negative-literal right-hand side after a comparison operator" {
  // The binary-RHS continuation recognizes '(', '[', '.', '<-', and a
  // prefix unary operator like '-' as valid operator-token starts for the
  // right-hand operand, so `x != -1` parses.
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared("x != -1", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'x != -1' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "!="), "expected op '!='";
      fit e.right.kind {
        .Unary(u) -> {
          assert equals(u.op, "-"), "expected the right operand to be a unary '-'";
          fit u.operand.kind {
            .Number(_) -> {}
            _ -> { panic("expected the unary operand to be a Number"); }
          }
        }
        _ -> { panic("expected the right operand to be a Unary node"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root respects operator precedence (a * b + c)" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  names.push("c");
  ParseState st = _state_with_declared("a * b + c", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a * b + c' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  // Expect ((a * b) + c).
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to be '+'";
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "c"), "expected the outer right to be 'c'"; }
        _ -> { panic("expected Identifier 'c'"); }
      }
      fit e.left.kind {
        .Expression(le) -> {
          assert equals(le.op, "*"), "expected the left child's op to be '*'";
        }
        _ -> { panic("expected the left child to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root respects operator precedence (a + b * c)" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  names.push("c");
  ParseState st = _state_with_declared("a + b * c", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a + b * c' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  // Expect (a + (b * c)): already correct, no rotation needed.
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to be '+'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected the outer left to be 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
      fit e.right.kind {
        .Expression(re) -> {
          assert equals(re.op, "*"), "expected the right child's op to be '*'";
        }
        _ -> { panic("expected the right child to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a parenthesized group" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  names.push("c");
  ParseState st = _state_with_declared("(a + b) * c", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '(a + b) * c' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "*"), "expected the outer op to be '*'";
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "c"), "expected the outer right to be 'c'"; }
        _ -> { panic("expected Identifier 'c'"); }
      }
      fit e.left.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Expression(ie) -> {
              assert equals(ie.op, "+"), "expected the parenthesized op to be '+'";
            }
            _ -> { panic("expected the parenthesized contents to be an Expression"); }
          }
        }
        _ -> { panic("expected the outer left to be an ExpressionParenthesis"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a zero-arg call" {
  Vec<str> names;
  names.init(0);
  names.push("foo");
  ParseState st = _state_with_declared("foo()", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'foo()' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "()"), "expected op '()'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "foo"), "expected callee 'foo'"; }
        _ -> { panic("expected Identifier 'foo'"); }
      }
      fit e.right.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Blank -> {}
            _ -> { panic("expected a Blank node for the empty arg list"); }
          }
        }
        _ -> { panic("expected an ExpressionParenthesis for the arg list"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a one-arg call" {
  Vec<str> names;
  names.init(0);
  names.push("foo");
  names.push("x");
  ParseState st = _state_with_declared("foo(x)", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'foo(x)' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "()"), "expected op '()'";
      fit e.right.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Identifier(s) -> { assert equals(s, "x"), "expected the arg to be 'x'"; }
            _ -> { panic("expected the arg list contents to be Identifier 'x'"); }
          }
        }
        _ -> { panic("expected an ExpressionParenthesis for the arg list"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses 'sizeof(Type)' as an ordinary call" {
  // 'sizeof' isn't a keyword, so 'sizeof(Point)' is an ordinary call whose
  // callee happens to be named 'sizeof'. The only special handling is
  // letting the type-name argument through the unknown-identifier check,
  // via `is_sizeof_type_operand` in `parse_single_token_to_node`.
  ParseState st = _state_from("sizeof(Point)");
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'sizeof(Point)' to parse even though 'Point' is never declared";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "()"), "expected op '()'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "sizeof"), "expected callee 'sizeof'"; }
        _ -> { panic("expected Identifier 'sizeof'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses 'sizeof(bin)' with a builtin type keyword operand" {
  // Unlike a custom type name (`sizeof(Point)`, an ordinary `.Identifier`
  // token, handled by `is_sizeof_type_operand`), a builtin scalar type
  // name (`bin`/`num`/`str`/...) lexes as a `.Keyword` token, which
  // `parse_expressionable_single` handles as a primary-expression case
  // alongside `nil`/`panic`/`await`.
  ParseState st = _state_from("sizeof(bin)");
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'sizeof(bin)' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "()"), "expected op '()'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "sizeof"), "expected callee 'sizeof'"; }
        _ -> { panic("expected Identifier 'sizeof'"); }
      }
      fit e.right.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Identifier(s2) -> {
              assert equals(s2, "bin"), "expected the operand 'bin' folded into a plain Identifier node";
            }
            _ -> { panic("expected Identifier 'bin'"); }
          }
        }
        _ -> { panic("expected a parenthesized argument"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root rejects a bare builtin type keyword outside of sizeof(...)" {
  // The sizeof-operand case stays scoped to that one context: 'bin' on its
  // own still isn't a value expression.
  ParseState st = _state_from("bin");
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_some(), "expected a bare 'bin' outside sizeof(...) to still be rejected";
}

test "parse_expressionable_root parses array indexing" {
  Vec<str> names;
  names.init(0);
  names.push("arr");
  names.push("i");
  ParseState st = _state_with_declared("arr[i]", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'arr[i]' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "[]"), "expected op '[]'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "arr"), "expected receiver 'arr'"; }
        _ -> { panic("expected Identifier 'arr'"); }
      }
      fit e.right.kind {
        .Bracket(inner) -> {
          fit inner.kind {
            .Identifier(s) -> { assert equals(s, "i"), "expected index 'i'"; }
            _ -> { panic("expected Identifier 'i' inside the bracket"); }
          }
        }
        _ -> { panic("expected a Bracket node"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses an array literal (no left operand)" {
  ParseState st = _state_from("[1, 2, 3]");
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '[1, 2, 3]' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Bracket(inner) -> {
      // Only the first element is asserted on the shape (the comma chain
      // is a real Expression tree, same as call args); mainly confirming
      // this parses at all as a bare Bracket, not misread as indexing.
      fit inner.kind {
        .Expression(e) -> { assert equals(e.op, ","), "expected the elements joined by ','"; }
        _ -> { panic("expected a comma-Expression for multiple elements"); }
      }
    }
    _ -> { panic("expected a Bracket node"); }
  }
}

test "parse_expressionable_root parses chained indexing after a call" {
  Vec<str> names;
  names.init(0);
  names.push("get_arr");
  ParseState st = _state_with_declared("get_arr()[0]", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'get_arr()[0]' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "[]"), "expected the outer op to be '[]'";
      fit e.left.kind {
        .Expression(call) -> {
          assert equals(call.op, "()"), "expected the receiver to be a call";
        }
        _ -> { panic("expected an Expression call as the receiver"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses an indexed array element as an assignment target" {
  Vec<str> names;
  names.init(0);
  names.push("arr");
  names.push("i");
  names.push("v");
  ParseState st = _state_with_declared("arr[i] = v", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'arr[i] = v' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "="), "expected the outer op to be '='";
      fit e.left.kind {
        .Expression(idx) -> {
          assert equals(idx.op, "[]"), "expected the assignment target to be 'arr[i]'";
        }
        _ -> { panic("expected an Expression '[]' as the assignment target"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a named compound-literal initializer" {
  ParseState st = _state_from("compound Point { num x; num y; } Point{ x = 1, y = 2 }");
  Parser p = parser_new(&st);
  assert p.parse_top_level_declaration().is_none(), "expected the compound declaration to parse";
  assert p.parse_expressionable_root().is_none(), "expected 'Point{ x = 1, y = 2 }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .CompoundInit(ci) -> {
      assert ci.has_dtype, "expected an explicit dtype";
      assert equals(ci.init_dtype.type_str, "Point"), "expected dtype 'Point'";
      assert ci.fields.len == 2, "expected 2 fields";
      let f0 = ci.fields.get(0);
      assert equals(f0.name, "x"), "expected field 'x'";
      fit f0.value.kind {
        .Number(_) -> {}
        _ -> { panic("expected a Number value for field 'x'"); }
      }
      let f1 = ci.fields.get(1);
      assert equals(f1.name, "y"), "expected field 'y'";
    }
    _ -> { panic("expected a CompoundInit node"); }
  }
}

test "parse_expressionable_root parses the type-inferred compound-literal shorthand '.{...}'" {
  ParseState st = _state_from(".{ x = 1, y = 2 }");
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '.{ x = 1, y = 2 }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .CompoundInit(ci) -> {
      assert !ci.has_dtype, "expected no explicit dtype for the '.{...}' shorthand";
      assert ci.fields.len == 2, "expected 2 fields";
    }
    _ -> { panic("expected a CompoundInit node"); }
  }
}

test "parse_expressionable_root leaves a plain compound-type identifier alone with no following '{'" {
  ParseState st = _state_from("compound Point { num x; } Point");
  Parser p = parser_new(&st);
  assert p.parse_top_level_declaration().is_none(), "expected the compound declaration to parse";
  assert p.parse_expressionable_root().is_none(), "expected a bare 'Point' reference (no '{') to parse as a plain identifier";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Identifier(s) -> {
      assert equals(s, "Point"), "expected a plain Identifier 'Point', not a CompoundInit";
    }
    _ -> { panic("expected an Identifier node"); }
  }
}

test "parse_expressionable_root reports an error with no operand at all" {
  ParseState st = _state_from(";");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_expressionable_root();
  assert err.is_some(), "expected an error for an empty expression position";
}

test "parse_expressionable_root parses a prefix unary expression" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("-a", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '-a' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "-"), "expected op '-'";
      assert !u.is_left_operanded_unary, "expected a prefix (not postfix) unary";
      assert !u.has_indirection, "expected no indirection info for a plain '-'";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected operand 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

test "parse_expressionable_root parses pointer indirection with depth" {
  Vec<str> names;
  names.init(0);
  names.push("p");
  ParseState st = _state_with_declared("**p", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '**p' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "*"), "expected op '*'";
      assert u.has_indirection, "expected indirection info to be set";
      assert u.indirection_depth == 2, "expected indirection depth 2";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "p"), "expected operand 'p'"; }
        _ -> { panic("expected Identifier 'p'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

test "parse_expressionable_root parses a postfix unary expression" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("a++", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a++' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "++"), "expected op '++'";
      assert u.is_left_operanded_unary, "expected a postfix (left-operanded) unary";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected operand 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

test "parse_expressionable_root parses a postfix unary followed by a binary continuation" {
  // `parse_for_left_operanded_unary` pops its operand off the node stack
  // before pushing the finished Unary node, so the outer
  // parse_expressionable loop sees zero net growth. Without its trailing
  // parse_additional_expression, `a++ + 1` would silently drop the `+ 1`.
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("a++ + 1", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a++ + 1' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to be '+'";
      fit e.left.kind {
        .Unary(u) -> {
          assert equals(u.op, "++"), "expected the left side to be the postfix '++' unary";
        }
        _ -> { panic("expected a Unary node on the left"); }
      }
    }
    _ -> { panic("expected an Expression node -- the '+ 1' must not be silently dropped"); }
  }
}

test "parse_expressionable_root parses a unary operand followed by a binary continuation" {
  // `parse_for_normal_unary`/`parse_for_indirection_unary` bound their
  // operand parse with `stop_at_binary_op`, so a prefix unary binds
  // tightly: `-a + b` is `(-a) + b`, and `*buf = 10` assigns through the
  // pointer instead of parsing as `*(buf = 10)`. A postfix continuation
  // (`.`/`(`/`[`) still continues the same operand, so `!r.is_err()`
  // parses as `!(r.is_err())`.
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("-a + b", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '-a + b' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer node to be '(-a) + b'";
      fit e.left.kind {
        .Unary(u) -> {
          assert equals(u.op, "-"), "expected the left side to be unary '-'";
          fit u.operand.kind {
            .Identifier(s) -> {
              assert equals(s, "a"), "expected the unary's operand to be 'a'";
            }
            _ -> { panic("expected Identifier 'a'"); }
          }
        }
        _ -> { panic("expected the left side to be a Unary node"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "b"), "expected right 'b'"; }
        _ -> { panic("expected Identifier 'b'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses pointer-indirection assignment without swallowing the assignment into the operand" {
  // Same bounding as the previous test, at the indirection unary (`*p`)
  // specifically: `*buf = 10` must be `(*buf) = 10` (assign 10 through the
  // pointer), not `*(buf = 10)` (assign 10 to `buf` itself, then
  // dereference the result).
  Vec<str> names;
  names.init(0);
  names.push("buf");
  ParseState st = _state_with_declared("*buf = 10", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '*buf = 10' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "="), "expected the outer node to be an assignment";
      fit e.left.kind {
        .Unary(u) -> {
          assert u.has_indirection, "expected the assignment target to be a pointer indirection";
          fit u.operand.kind {
            .Identifier(s) -> {
              assert equals(s, "buf"), "expected the dereferenced operand to be 'buf'";
            }
            _ -> { panic("expected Identifier 'buf'"); }
          }
        }
        _ -> { panic("expected the assignment target to be a Unary node"); }
      }
      fit e.right.kind {
        .Number(_) -> {}
        _ -> { panic("expected the assigned value to be a Number"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a bare enum-variant shorthand" {
  ParseState st = _state_from(".None");
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '.None' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "."), "expected op '.'";
      fit e.left.kind {
        .Blank -> {}
        _ -> { panic("expected a Blank left side (no explicit enum name)"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "None"), "expected variant name 'None'"; }
        _ -> { panic("expected Identifier 'None'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses an enum-variant shorthand with a payload" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared(".Some(x)", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '.Some(x)' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(call) -> {
      assert equals(call.op, "()"), "expected op '()'";
      fit call.left.kind {
        .Expression(dot) -> {
          assert equals(dot.op, "."), "expected the callee to be a '.' shorthand expression";
          fit dot.left.kind {
            .Blank -> {}
            _ -> { panic("expected a Blank left side (no explicit enum name)"); }
          }
          fit dot.right.kind {
            .Identifier(s) -> { assert equals(s, "Some"), "expected variant name 'Some'"; }
            _ -> { panic("expected Identifier 'Some'"); }
          }
        }
        _ -> { panic("expected the callee to be an Expression"); }
      }
      fit call.right.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Identifier(s) -> { assert equals(s, "x"), "expected the payload arg to be 'x'"; }
            _ -> { panic("expected the payload arg to be Identifier 'x'"); }
          }
        }
        _ -> { panic("expected an ExpressionParenthesis for the payload"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_body parses a sequence of expression statements" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("{ a; b; }", names);
