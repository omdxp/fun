test "parse_defer_statement parses a deferred expression" {
  Vec<str> names;
  names.init(0);
  names.push("cleanup");
  ParseState st = _state_with_declared("defer cleanup();", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_defer_statement().is_none(), "expected 'defer cleanup();' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementDefer(body) -> {
      fit body.kind {
        .Expression(e) -> { assert equals(e.op, "()"), "expected a call expression"; }
        _ -> { panic("expected an Expression node"); }
      }
    }
    _ -> { panic("expected a StatementDefer node"); }
  }
}

test "parse_defer_statement parses a deferred block" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("defer { a; }", names);
