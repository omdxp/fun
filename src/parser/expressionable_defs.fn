// Operator precedence/associativity table the expression parser depends
// on: a pure, self-contained lookup table, kept in its own module rather
// than inside parser.fn.
// 
// Precedence rank: lower binds tighter (0 = postfix/call/member access,
// the tightest; 13 = comma, the loosest). Each group's index is what
// `left_has_priority` compares.

imp std.string;
imp ..lexer.token;

// Which direction a chain of same-precedence operators groups: `a op b op
// c` reads as `(a op b) op c` for LeftToRight, `a op (b op c)` for
// RightToLeft (assignment's natural grouping).
pub enum Associativity {
  LeftToRight,
  RightToLeft,
}

// An operator's resolved precedence: its rank (lower binds tighter) and
// associativity. `found = false` for a string that isn't a real operator
// at all (the caller's bug, not a valid "no precedence" state): every
// operator token the lexer produces has an entry below).
pub compound OpPrecedence {
  num rank;
  Associativity assoc;
  bin found;
}

// Resolves `op`'s precedence rank and associativity.
pub fun op_precedence_for(str op) OpPrecedence {
  OpPrecedence p;
  p.found = true;
  fit op {
    "++", "--", "()", "[]", "(", "[", "." -> {
      p.rank = 0;
      p.assoc = .LeftToRight;
      ret p;
    }
    "*", "/", "%" -> {
      p.rank = 1;
      p.assoc = .LeftToRight;
      ret p;
    }
    "+", "-" -> {
      p.rank = 2;
      p.assoc = .LeftToRight;
      ret p;
    }
    "<<", ">>" -> {
      p.rank = 3;
      p.assoc = .LeftToRight;
      ret p;
    }
    "<", "<=", ">", ">=" -> {
      p.rank = 4;
      p.assoc = .LeftToRight;
      ret p;
    }
    "==", "!=" -> {
      p.rank = 5;
      p.assoc = .LeftToRight;
      ret p;
    }
    "&" -> {
      p.rank = 6;
      p.assoc = .LeftToRight;
      ret p;
    }
    "^" -> {
      p.rank = 7;
      p.assoc = .LeftToRight;
      ret p;
    }
    "|" -> {
      p.rank = 8;
      p.assoc = .LeftToRight;
      ret p;
    }
    "&&" -> {
      p.rank = 9;
      p.assoc = .LeftToRight;
      ret p;
    }
    "||" -> {
      p.rank = 10;
      p.assoc = .LeftToRight;
      ret p;
    }
    // Range operator.
    ".." -> {
      p.rank = 11;
      p.assoc = .LeftToRight;
      ret p;
    }
    "=", "+=", "-=", "*=", "/=", "%=", "<<=", ">>=", "&=", "^=", "|=" -> {
      p.rank = 12;
      p.assoc = .RightToLeft;
      ret p;
    }
    "," -> {
      p.rank = 13;
      p.assoc = .LeftToRight;
      ret p;
    }
    _ -> {
      p.found = false;
      p.rank = -1;
      p.assoc = .LeftToRight;
      ret p;
    }
  }
}

// True when `op_left`, the already-built outer operator, should keep its
// operand rather than ceding it to `op_right`, the operator just found
// to its right, i.e. whether `(a op_left b) op_right c` is already the
// correct grouping, rather than `a op_left (b op_right c)`.
// Same-operator chains group by the operator's own associativity;
// otherwise a right-associative left operator never yields, and
// same-or-tighter binding (numerically <=, since lower rank binds
// tighter) on the left wins.
pub fun left_has_priority(str op_left, str op_right) bin {
  let left = op_precedence_for(op_left);
  let right = op_precedence_for(op_right);
  if equals(op_left, op_right) {
    ret left.assoc == .LeftToRight;
  }
  if left.assoc == .RightToLeft {
    ret false;
  }
  ret left.rank <= right.rank;
}

// True if `op` is one of the supported prefix unary operators: negation,
// unary plus, logical/bitwise not, pointer indirection, address-of, or
// pre-increment/decrement.
pub fun is_unary_operator(str op) bin {
  fit op {
    "-", "+", "!", "~", "*", "&", "++", "--" -> { ret true; }
    _ -> { ret false; }
  }
}

// True if `op` is the pointer-indirection operator (`*p`). A narrower
// check than `is_unary_operator`: indirection needs its own parsing
// path since a following run of `*`s is a pointer-depth count, not a
// chain of separate unary operators.
pub fun is_indirection_operator(str op) bin {
  ret equals(op, "*");
}

// True if `op` is a left-operanded (postfix) unary operator: `x++`/`x--`,
// or the propagation operators `x?` (Option) / `x!` (Result).
pub fun is_left_operanded_unary_operator(str op) bin {
  ret equals(op, "++") || equals(op, "--") || equals(op, "?") || equals(op, "!");
}

// True if `t` is an `Operator` token that, appearing after a complete
// primary expression, is a binary/infix operator, i.e. it would combine
// the primary with a following operand rather than continue it. Postfix-
// continuation operators (`.`, `[`, `(`) return false (they extend the
// primary instead). Used to decide whether a just-parsed condition
// (`if`/`elif`) needs to keep parsing a following binary operator, e.g.
// the `&&` in `if (a || b) && c`.
pub fun is_binary_only_operator(Token t) bin {
  if t.type != .Operator {
    ret false;
  }
  str op = "";
  fit t.data {
    .Sval(s) -> { op = s; }
    _ -> { ret false; }
  }
  if equals(op, ".") || equals(op, "(") || equals(op, "[") {
    ret false;
  }
  ret true;
}

test "op_precedence_for ranks multiplication tighter than addition" {
  let mul = op_precedence_for("*");
  let add = op_precedence_for("+");
  assert mul.found, "expected '*' to be a known operator";
  assert add.found, "expected '+' to be a known operator";
  assert mul.rank < add.rank, "expected '*' to bind tighter (lower rank) than '+'";
}

test "op_precedence_for reports RightToLeft for assignment, LeftToRight for arithmetic" {
  let assign = op_precedence_for("=");
  let plus = op_precedence_for("+");
  assert assign.assoc == .RightToLeft, "expected '=' to be right-associative";
  assert plus.assoc == .LeftToRight, "expected '+' to be left-associative";
}

test "op_precedence_for reports not-found for an unrecognized string" {
  let bogus = op_precedence_for("???");
  assert !bogus.found, "expected an unrecognized operator string to report not-found";
}

test "left_has_priority favors the tighter-binding operator" {
  // '*' binds tighter than '+': in `a + b * c`, the already-built '+'
  // does not keep its operand; '*' needs it instead.
  assert !left_has_priority("+", "*"), "'+' should yield to a tighter '*' on its right";
  // The reverse: '*' already built, '+' found to the right, so '*' keeps it.
  assert left_has_priority("*", "+"), "'*' should keep its operand against a looser '+'";
}

test "left_has_priority chains equal-precedence left-associative operators leftward" {
  // `a - b - c`: equal precedence, left-associative -> (a - b) - c, so the
  // already-built left '-' keeps its operand against another '-'.
  assert left_has_priority("-", "-"), "equal-precedence left-associative operators should group left";
}

test "left_has_priority chains equal-precedence right-associative operators rightward" {
  // `a = b = c`: equal precedence, right-associative -> a = (b = c), so
  // the already-built left '=' must yield to another '='.
  assert !left_has_priority("=", "="), "equal-precedence right-associative operators should group right";
}

test "left_has_priority never yields for a right-associative left operator" {
  // A right-associative operator (assignment) never keeps grouping
  // leftward against a different operator either, regardless of rank.
  assert !left_has_priority("=", "+"), "right-associative left operator should never keep priority";
}

test "is_unary_operator recognizes the supported prefix operators" {
  assert is_unary_operator("-"), "'-' should be a unary operator";
  assert is_unary_operator("!"), "'!' should be a unary operator";
  assert is_unary_operator("*"), "'*' should be a unary operator";
  assert is_unary_operator("++"), "'++' should be a unary operator";
  assert !is_unary_operator("+="), "'+=' should not be a unary operator";
  assert !is_unary_operator("=="), "'==' should not be a unary operator";
}

test "is_indirection_operator only matches '*'" {
  assert is_indirection_operator("*"), "'*' should be the indirection operator";
  assert !is_indirection_operator("&"), "'&' should not be the indirection operator";
}

test "is_left_operanded_unary_operator matches ++/--/?/!" {
  assert is_left_operanded_unary_operator("++"), "'++' should be left-operanded";
  assert is_left_operanded_unary_operator("--"), "'--' should be left-operanded";
  assert is_left_operanded_unary_operator("?"), "'?' should be left-operanded";
  assert is_left_operanded_unary_operator("!"), "'!' should be left-operanded";
  assert !is_left_operanded_unary_operator("-"), "'-' should not be left-operanded";
}

test "is_binary_only_operator recognizes infix operators, rejects postfix continuations" {
  Token and_tok;
  and_tok.type = .Operator;
  and_tok.data = .Sval("&&");
  assert is_binary_only_operator(and_tok), "'&&' should be a binary-only operator";

  Token dot_tok;
  dot_tok.type = .Operator;
  dot_tok.data = .Sval(".");
  assert !is_binary_only_operator(dot_tok), "'.' should not be binary-only (postfix continuation)";

  Token lparen_tok;
  lparen_tok.type = .Operator;
  lparen_tok.data = .Sval("(");
  assert !is_binary_only_operator(lparen_tok), "'(' should not be binary-only (postfix continuation)";

  Token ident_tok;
  ident_tok.type = .Identifier;
  ident_tok.data = .Sval("x");
  assert !is_binary_only_operator(ident_tok), "a non-operator token should not be binary-only";
}
