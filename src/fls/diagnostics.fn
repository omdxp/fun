// Diagnostics.
//
// What a client shows in the margin is what the compiler would say
// about the same text: the errors that stop it compiling, and the
// warnings about what it probably did not mean. The text comes from
// what the editor holds rather than from disk, so an unsaved edit is
// judged as it stands.

use protocol;
use documents;
use analysis;
use ..ast.ast;
use ..parser.parse_state;
use ..parser.parser;
use ..parser.import_resolver;
use ..semantics.typecheck;
use ..semantics.warnings;
use ..semantics.alias_expand;
use std.string;
use std.vec;
use std.option;
use std.result;
use std.io;
use std.map;
use std.c.mem;

// How seriously a client should take one finding.
pub const num DIAG_SEVERITY_ERROR = 1;
pub const num DIAG_SEVERITY_WARNING = 2;

// One finding, in the terms a client understands.
pub compound Diagnostic {
  num line;
  num col;
  num end_line;
  num end_col;
  num severity;
  str message;
}

// `diagnose`'s own result for one document revision, kept until a
// newer one arrives.
compound DiagnosedEntry {
  num version;
  Vec<Diagnostic> diagnostics;
}

// Caches `diagnose`'s result per document revision. Typechecking and
// analyzing the whole merged program is the expensive part of
// answering a diagnostics request, unlike `AnalysisCache`'s own
// lex/parse step; the same revision is asked about more than once
// (`didOpen`, then every unrelated request that happens to also
// trigger a report) without its text changing in between.
pub compound DiagnosticsCache {
  Map<str, DiagnosedEntry> entries;
}

pub fun diagnostics_cache_new() DiagnosticsCache {
  DiagnosticsCache c;
  c.entries.init(8);
  ret c;
}

impl DiagnosticsCache {
  // Drops what was kept for a document a client closed.
  pub forget(str document_uri) {
    let found = self.entries.at(document_uri);
    if found.is_some() {
      // Always a `_clone_diagnostics`-built copy (see `diagnose`'s
      // own note) - safe to deep-free.
      DiagnosedEntry entry = found.unwrap();
      free_diagnostics(&entry.diagnostics);
    }
    self.entries.remove(document_uri);
  }

  pub free() {
    self.entries.free();
  }
}

// A deep copy of `src`'s own elements: each `Diagnostic.message` is
// its own fresh string this call owns, not an aliased copy of
// `src`'s own - the cached copy and whatever the caller does with
// `src` afterward (typically freeing it, see `_free_diagnostics`)
// each own their own, with no double-free risk between them.
fun _clone_diagnostics(Vec<Diagnostic>* src) Vec<Diagnostic> {
  Vec<Diagnostic> copy;
  copy.init(src.len);
  num i = 0;
  for i < src.len {
    Diagnostic d = src.get(i);
    d.message = substr(d.message, 0, len(d.message));
    copy.push(d);
    i = i + 1;
  }
  ret copy;
}

// Frees every `Diagnostic.message` before the Vec's own backing
// array. Safe for any `Vec<Diagnostic>` this module itself hands
// back (from `diagnose`, or a `_clone_diagnostics`-built cache
// entry): every `_at_start` call site in this file clones a message
// that might otherwise be a bare string literal (several of
// typecheck.fn's/warnings.fn's/alias_expand.fn's own error-message
// sources are, and freeing one of those crashes) before handing it
// off, so every `Diagnostic.message` leaving this module is
// uniformly its own fresh, freeable string.
pub fun free_diagnostics(Vec<Diagnostic>* d) {
  num i = 0;
  for i < d.len {
    free(d.get(i).message);
    i = i + 1;
  }
  d.free();
}

// Everything wrong with `doc`, in the order a reader meets it. Cached
// by `dcache` per document revision; a cache hit still returns an
// independent copy, so a caller freeing what it gets back never
// touches the cached original.
pub fun diagnose(AnalysisCache* cache, DiagnosticsCache* dcache, Document doc) Vec<Diagnostic> {
  let kept = dcache.entries.at(doc.uri);
  if kept.is_some() {
    DiagnosedEntry found = kept.unwrap();
    if found.version == doc.version {
      ret _clone_diagnostics(&found.diagnostics);
    }
    // A stale revision, about to be replaced below - freed first, or
    // every edit leaks the whole previous diagnostics list for as
    // long as the server keeps running. Always a `_clone_diagnostics`
    // copy (every entry ever stored here went through it), so safe
    // to deep-free.
    free_diagnostics(&found.diagnostics);
  }

  Vec<Diagnostic> out = _diagnose_uncached(cache, doc);

  DiagnosedEntry fresh;
  fresh.version = doc.version;
  fresh.diagnostics = _clone_diagnostics(&out);
  dcache.entries.put(doc.uri, fresh);

  ret out;
}

fun _diagnose_uncached(AnalysisCache* cache, Document doc) Vec<Diagnostic> {
  Vec<Diagnostic> out;
  out.init(0);

  // The text an editor holds is what to judge, so it is written where
  // the compiler expects to find it before the imports are resolved.
  str path = doc.path;
  if equals(path, "") {
    ret out;
  }

  Analyzed read = cache.of(doc);
  if !read.lexed {
    str not_lexed = "could not read this file";
    out.push(_at_start(DIAG_SEVERITY_ERROR, substr(not_lexed, 0, len(not_lexed))));
    ret out;
  }

  // Checking needs what the file imports, which is read from disk. The
  // file being edited is not: its text is what the client holds, which
  // may not be what is saved.
  if !read.parsed {
    // `AnalysisCache.of()`'s own merge already parsed this exact text
    // under this exact path (see `parse_program_cached`'s own note on
    // why that no longer reparses twice) and it failed, but its error
    // carries no position - reparsed alone, just this once, on the
    // failure path only, to localize where. A real syntax error here
    // means this standalone parse fails the same way; the far more
    // common case (nothing wrong with this file's own text, just an
    // import that didn't resolve) falls through to the generic
    // message below instead, since there's no position to give for
    // that one either.
    ParseState state = parse_state_new(path, doc.text);
    state.tokens = read.tokens.clone();
    state.emit_stderr = false;
    Parser p = parser_new(&state);
    let parse_failed = p.parse();
    defer free_node_tree(&state.nodes);
    defer state.tokens.free();
    defer state.global_symbols.free();
    defer free_parse_state_internal(&state);
    if parse_failed.is_some() {
      // Always a fresh clone, whichever branch sets it - `message`
      // ends up as this `Diagnostic`'s own `.message`, which (unlike
      // most built in typecheck.fn/warnings.fn, often a bare string
      // literal) is always safe to free, matching every other
      // `Diagnostic` this function builds. See `report()`'s own note
      // on why that uniformity matters.
      str not_read = "this file could not be read";
      str message = substr(not_read, 0, len(not_read));
      if state.has_error {
        free(message);
        message = substr(state.error_message, 0, len(state.error_message));
      }
      Diagnostic d = _at_start(DIAG_SEVERITY_ERROR, message);
      if state.has_error {
        d.line = state.error_pos.line - 1;
        d.col = state.error_pos.col - 1;
        d.end_line = d.line;
        d.end_col = d.col + 1;
      }
      out.push(d);
      ret out;
    }
    str imports_msg = "this file's imports could not be resolved";
    str message = len(read.import_error) > 0
    ? substr(read.import_error, 0, len(read.import_error))
    : substr(imports_msg, 0, len(imports_msg));
    out.push(_at_start(DIAG_SEVERITY_ERROR, message));
    ret out;
  }
  ProgramMergeResult program = read.program;

  // A type error elsewhere in the file must not hide every unused-*
  // diagnostic for the rest of it: `analyze` reads straight from the
  // parsed nodes, independent of whatever typechecking got through, so
  // it still runs below even when checking failed. The type error
  // itself is recorded here and re-added once warnings are collected.
  flag has_type_error = false;
  Diagnostic type_error_diag = _at_start(DIAG_SEVERITY_ERROR, "");
  // Typechecking through an `als` reference needs it expanded first, but
  // expansion mutates the tree in place - and `program.nodes` here is
  // the SAME merged program hover/completion/go-to-definition read from
  // this same `AnalysisCache` entry. Expanding a disposable clone keeps
  // an alias reference visible as written for the rest of fls.
  Vec<Node> alias_checked_nodes = clone_node_tree(&program.nodes);
  let alias_err = expand_type_aliases(&alias_checked_nodes);
  if alias_err.is_some() {
    has_type_error = true;
    // Cloned: `expand_type_aliases`'s own error is a bare string
    // literal at at least one of its own return sites, never safe to
    // free as-is - see this function's own earlier note on why every
    // `Diagnostic` it builds needs to be uniformly freeable.
    str alias_msg = alias_err.unwrap();
    type_error_diag = _at_start(
      DIAG_SEVERITY_ERROR,
      substr(alias_msg, 0, len(alias_msg))
    );
  }
  let checked = typecheck_program_with_aliases(&alias_checked_nodes, &program.aliases);
  // The clone above is the only tree expansion ever touched, so it is
  // also the only place `was_used` (needed by the `unused_type_alias`
  // warning below) ever got set - propagate it onto both trees `analyze`
  // actually reads before the clone is thrown away.
  sync_type_alias_usage(&alias_checked_nodes, &program.nodes);
  sync_type_alias_usage(&alias_checked_nodes, &program.entry_nodes);
  free_node_tree(&alias_checked_nodes);
  if !has_type_error && checked.is_err() {
    TypeError e = checked.unwrap_err();
    has_type_error = true;
    // Cloned: `TypeError.message` is a bare string literal at most of
    // `Checker.fail`'s own call sites in typecheck.fn, never safe to
    // free as-is - every `Diagnostic` this function builds needs to
    // be uniformly freeable (see `report()`'s own note).
    type_error_diag = _at_start(
      DIAG_SEVERITY_ERROR,
      substr(e.message, 0, len(e.message))
    );
    if e.has_pos && equals(e.pos.filename, path) {
      type_error_diag.line = e.pos.line - 1;
      type_error_diag.col = e.pos.col - 1;
      type_error_diag.end_line = type_error_diag.line;
      type_error_diag.end_col = type_error_diag.col + 1;
    }
  }

  // Warnings are reported for the file being edited, and asked for in
  // full: an editor is where noticing an unused declaration helps.
  let noticed = analyze(&program.entry_nodes, &program.nodes, true, path);
  if has_type_error {
    out.push(type_error_diag);
  }
  if noticed.is_err() {
    // A genuine compile error (the CLI fails the build over this
    // exact condition), not a mere warning - and reported right at
    // the `expect` statement itself when it's in this file, not just
    // file start.
    UnmetExpectation ue = noticed.unwrap_err();
    Diagnostic ue_diag = _at_start(DIAG_SEVERITY_ERROR, ue.message);
    if ue.has_pos && equals(ue.pos.filename, path) {
      ue_diag.line = ue.pos.line - 1;
      ue_diag.col = ue.pos.col - 1;
      ue_diag.end_line = ue_diag.line;
      ue_diag.end_col = ue_diag.col + 1;
    }
    out.push(ue_diag);
    ret out;
  }
  Vec<Warning> found = noticed.unwrap();
  defer found.free();
  num i = 0;
  for i < found.len {
    Warning w = found.get(i);
    i = i + 1;
    Diagnostic d = _at_start(
      DIAG_SEVERITY_WARNING,
      format("{str}: {str}", warning_id_name(w.id), w.message)
    );
    if w.has_pos {
      d.line = w.pos.line - 1;
      d.col = w.pos.col - 1;
      d.end_line = d.line;
      d.end_col = d.col + 1;
    }
    out.push(d);
  }
  ret out;
}

// A finding with no position of its own, which a client shows against
// the start of the file.
fun _at_start(num severity, str message) Diagnostic {
  Diagnostic d;
  d.line = 0;
  d.col = 0;
  d.end_line = 0;
  d.end_col = 1;
  d.severity = severity;
  d.message = message;
  ret d;
}

// The notification telling a client what is wrong with a document. An
// empty list is what clears the margin, so it is sent as readily as a
// list of findings. `text` is the document's own source, needed to
// convert each finding's byte columns to the UTF-16 code units LSP
// itself reports.
pub fun publish(str document_uri, str text, Vec<Diagnostic>* found) str {
  StringBuilder b = string_builder_init(256);
  b.append(`{"uri":`);
  json_quote_into(&b, document_uri);
  b.append(`,"diagnostics":[`);
  num i = 0;
  for i < found.len {
    Diagnostic d = found.get(i);
    if i > 0 {
      b.append(",");
    }
    i = i + 1;
    b.append(`{"range":{"start":{"line":`);
    b.append_num(d.line);
    b.append(`,"character":`);
    b.append_num(byte_col_to_utf16_char(text, d.line, d.col));
    b.append(`},"end":{"line":`);
    b.append_num(d.end_line);
    b.append(`,"character":`);
    b.append_num(byte_col_to_utf16_char(text, d.end_line, d.end_col));
    b.append(`}},"severity":`);
    b.append_num(d.severity);
    b.append(`,"source":"fun","message":`);
    json_quote_into(&b, d.message);
    b.append("}");
  }
  b.append("]}");
  str params_json = b.build();
  str result = notification("textDocument/publishDiagnostics", params_json);
  free(params_json);
  ret result;
}
