// Workspace symbol table.
//
// workspace_symbols and definition_workspace_wide both used to re-walk
// every document in the workspace, from scratch, on every request. This
// keeps one Declaration per top-level name across the whole workspace,
// built once and kept current by version, so a query is a couple of Map
// lookups instead of a linear scan over every document's own AST.
//
// Pull-based, mirroring AnalysisCache's own of(): nothing rebuilds on
// didChange. A document's stale entry is only noticed and refreshed the
// next time (if ever) a workspace-wide request asks for it, since the
// hot per-keystroke paths (hover, completion, document symbols) never
// touch this table at all.

use documents;
use analysis;
use symbols;
use std.map;
use std.vec;
use std.string;
use std.option;

// One declaration as the table indexes it: the Declaration itself, plus
// the document URI that declares it. Declaration.pos.filename is a
// path, not a URI; storing both here avoids re-deriving one from the
// other at every query.
pub compound IndexedDeclaration {
  str uri;
  Declaration decl;
}

pub compound WorkspaceSymbolTable {
  // Every declaration this server has indexed, by the document URI
  // that declares it, so one edit's own before/after set is known
  // without re-deriving which names a document used to contribute.
  Map<str, Vec<IndexedDeclaration>> by_uri;
  // The version by_uri[uri] was built from, keyed the same way
  // AnalysisCache keys its own per-document cache, so a document
  // already indexed at its current revision is never re-walked.
  Map<str, num> versions;
  // Every declaration, by name, across the whole workspace. The index
  // workspace_symbols/definition_workspace_wide actually query;
  // neither walks by_uri document-by-document.
  Map<str, Vec<IndexedDeclaration>> by_name;
  // This table's own copy of each uri it currently holds anything
  // under, keyed by content so a caller-supplied uri (aliasing
  // whatever Documents happens to own it as, which Documents can free
  // out from under this table at any time - closing a document frees
  // its own uri/path/text) never gets stored directly. by_uri/versions
  // and every IndexedDeclaration.uri this table builds all point at
  // the SAME entry here instead, owned for exactly as long as this
  // table keeps anything under that uri, freed once in forget().
  Map<str, str> owned_uris;
}

pub fun workspace_symbol_table_new() WorkspaceSymbolTable {
  WorkspaceSymbolTable t;
  t.by_uri.init(16);
  t.versions.init(16);
  t.by_name.init(64);
  t.owned_uris.init(16);
  ret t;
}

impl WorkspaceSymbolTable {
  // Makes sure `uri`'s own contribution matches its current document
  // revision; a no-op when it already does.
  pub ensure(AnalysisCache* cache, Documents* docs, str uri) {
    let doc_opt = docs.at(uri);
    if doc_opt.is_none() {
      ret;
    }
    Document doc = doc_opt.unwrap();

    let current_version = self.versions.at(uri);
    if current_version.is_some() && current_version.unwrap() == doc.version {
      ret;
    }

    Analyzed read = cache.of(doc);
    if !read.parsed {
      // Deliberate deviation from AnalysisCache.of()'s own
      // clear-on-failure: this file's last-good declarations are left
      // in place rather than blanked. workspace_symbols/
      // definition_workspace_wide are lower-frequency, often
      // keyboard-driven ("jump to X") operations; a symbol flickering
      // out of workspace search over one unbalanced brace mid-edit
      // elsewhere in the file is a more visible regression than
      // hover blanking briefly at the exact edit spot. versions[uri]
      // is left un-set too, so the next call retries the rebuild
      // (cheaply) rather than treating this as "indexed as empty."
      ret;
    }

    Vec<Declaration> fresh;
    fresh.init(8);
    _collect_declarations(&read.program.entry_nodes, doc.path, &fresh);

    str owned_uri = self._own_uri(uri);
    self._replace(owned_uri, fresh);
    self.versions.put(owned_uri, doc.version);
  }

  // Makes sure every URI `docs` currently knows about is current. Runs
  // with `cache.imports`' own preload forced sequential for the
  // duration: this walks every workspace file back to back, each one
  // normally spawning and joining its own fork-based preload worker
  // pool (see `ImportCache.parallel_preload`) - hundreds of fork/join
  // cycles in a tight loop, a far higher-volume stress pattern on the
  // M:N scheduler's fixed thread pool than the one-call-per-keystroke
  // rate interactive edits produce it under. A real SIGABRT plus
  // memory corruption was traced here in practice; serializing just
  // this bulk pass avoids it without touching the interactive path's
  // own parallel speed.
  pub ensure_all(AnalysisCache* cache, Documents* docs) {
    Vec<str> uris = docs.all_uris();
    defer uris.free();
    let was_parallel = cache.imports.parallel_preload;
    cache.imports.parallel_preload = false;
    num i = 0;
    for i < uris.len {
      self.ensure(cache, docs, uris.get(i));
      i = i + 1;
    }
    cache.imports.parallel_preload = was_parallel;
  }

  // Drops what was indexed for a document a client closed. Without
  // this, a closed document's own stale entries would keep showing up
  // in workspace search, potentially pointing at a URI docs.at() can
  // no longer resolve at all.
  pub forget(str uri) {
    let old = self.by_uri.at(uri);
    if old.is_none() {
      ret;
    }
    Vec<IndexedDeclaration> old_bucket = old.unwrap();
    num i = 0;
    for i < old_bucket.len {
      self._scrub_name(old_bucket.get(i).decl.name, uri);
      i = i + 1;
    }
    old_bucket.free();
    self.by_uri.remove(uri);
    self.versions.remove(uri);

    let owned = self.owned_uris.at(uri);
    if owned.is_some() {
      str owned_uri = owned.unwrap();
      self.owned_uris.remove(uri);
      free(owned_uri);
    }
  }

  pub free() {
    Vec<Vec<IndexedDeclaration>> uri_buckets = self.by_uri.values();
    num i = 0;
    for i < uri_buckets.len {
      Vec<IndexedDeclaration> b = uri_buckets.get(i);
      i = i + 1;
      b.free();
    }
    uri_buckets.free();

    // Deep here, not just the bucket shells: `_replace` clones each
    // Declaration's own name/detail/container/pos.filename into this
    // table's own strings (see its own note), and this is the single
    // point that owns them - `by_uri`'s own buckets just above share
    // the same `IndexedDeclaration`s and stay shallow, to not free
    // each string twice.
    Vec<Vec<IndexedDeclaration>> name_buckets = self.by_name.values();
    i = 0;
    for i < name_buckets.len {
      Vec<IndexedDeclaration> b = name_buckets.get(i);
      i = i + 1;
      num bi = 0;
      for bi < b.len {
        IndexedDeclaration e = b.get(bi);
        bi = bi + 1;
        free(e.decl.name);
        free(e.decl.detail);
        free(e.decl.container);
        free(e.decl.pos.filename);
      }
      b.free();
    }
    name_buckets.free();

    self.by_uri.free();
    self.versions.free();
    self.by_name.free();

    Vec<str> owned = self.owned_uris.values();
    i = 0;
    for i < owned.len {
      free(owned.get(i));
      i = i + 1;
    }
    owned.free();
    self.owned_uris.free();
  }

  // Removes `uri`'s own entries from `by_name[name]`, freeing the old
  // bucket and either writing back what's left or dropping the key
  // outright when nothing does. Declaration carries no identity of
  // its own, so entries are told apart by which document indexed
  // them, not by structural equality.
  _scrub_name(str name, str uri) {
    let existing = self.by_name.at(name);
    if existing.is_none() {
      ret;
    }
    Vec<IndexedDeclaration> old_bucket = existing.unwrap();
    Vec<IndexedDeclaration> kept;
    kept.init(old_bucket.len);
    // `name` (this call's own parameter, read by `_replace`'s caller
    // straight off one of this exact bucket's own entries before
    // calling here) is the same pointer as exactly one dropped
    // entry's own `.decl.name` below - tracked here so that one
    // entry's own name is freed once, after the loop, rather than
    // inside it (where freeing it immediately would leave `name`
    // itself dangling for every later use in this same call).
    flag name_is_dropped = false;
    num i = 0;
    for i < old_bucket.len {
      IndexedDeclaration e = old_bucket.get(i);
      i = i + 1;
      if !equals(e.uri, uri) {
        kept.push(e);
      } else {
        if e.decl.name == name {
          name_is_dropped = true;
        } else {
          free(e.decl.name);
        }
        free(e.decl.detail);
        free(e.decl.container);
        free(e.decl.pos.filename);
      }
    }
    old_bucket.free();
    // Removed unconditionally, before any write-back: `Map.put()`
    // only ever replaces the VALUE at an existing key's own slot, so
    // calling it below with a *different* (but content-equal) key
    // while the old slot is still live would silently keep the old
    // slot's own key pointer in the map - exactly the one `name`
    // itself is about to free, the moment this call returns, leaving
    // the map's own stored key dangling. Removing first always forces
    // a fresh slot, with a key this call never frees.
    self.by_name.remove(name);
    if kept.len == 0 {
      kept.free();
    } else {
      self.by_name.put(kept.get(0).decl.name, kept);
    }
    if name_is_dropped {
      free(name);
    }
  }

  // The uri this table itself owns for `uri`'s own content, creating
  // and registering one the first time this content is seen. Every
  // long-lived string this table stores under a uri (a by_uri/versions
  // key, an IndexedDeclaration.uri) comes from here rather than from
  // `uri` directly, since `uri` may alias a Documents-owned string
  // that closing or re-indexing the document frees.
  _own_uri(str uri) str {
    let existing = self.owned_uris.at(uri);
    if existing.is_some() {
      ret existing.unwrap();
    }
    str owned = substr(uri, 0, len(uri));
    self.owned_uris.put(owned, owned);
    ret owned;
  }

  // The incremental core: scrubs `uri`'s own prior contribution out of
  // `by_name` (bounded by however many names that one document
  // declares, not the whole table), then re-adds `fresh` under `uri`.
  // Frees `fresh` itself once its contents are copied into
  // IndexedDeclaration wrappers.
  _replace(str uri, Vec<Declaration> fresh) {
    let old = self.by_uri.at(uri);
    if old.is_some() {
      Vec<IndexedDeclaration> old_bucket = old.unwrap();
      // `old_bucket` aliases the same backing array `self.by_uri`
      // itself still points at - `old_bucket.free()` just below frees
      // it outright, leaving that stored entry pointing at freed
      // memory until the write-back at the end of this call.
      self.by_uri.remove(uri);
      num i = 0;
      for i < old_bucket.len {
        self._scrub_name(old_bucket.get(i).decl.name, uri);
        i = i + 1;
      }
      old_bucket.free();
    }

    Vec<IndexedDeclaration> wrapped;
    wrapped.init(fresh.len);
    num j = 0;
    for j < fresh.len {
      IndexedDeclaration entry;
      entry.uri = uri;
      entry.decl = fresh.get(j);
      // `_collect_declarations` builds each `Declaration`'s own
      // name/detail/container/pos.filename borrowed from that
      // revision's own parsed AST (symbols.fn's own convention, same
      // as everywhere else a node string is read) - fine for a
      // one-shot read, but this table keeps every `Declaration` it
      // wraps indefinitely, across edits, while `AnalysisCache`/
      // `ImportCache` deep-free exactly that revision's own tokens
      // the moment the next edit replaces it (see `ParsedFile.tokens`'s
      // own note in import_resolver.fn) - cloned here so this table's
      // own copy outlives the revision it was read from, matching
      // every string `_scrub_name`/`free()` now frees to balance it.
      entry.decl.name = substr(entry.decl.name, 0, len(entry.decl.name));
      entry.decl.detail = substr(entry.decl.detail, 0, len(entry.decl.detail));
      entry.decl.container = substr(entry.decl.container, 0, len(entry.decl.container));
      entry.decl.pos.filename = substr(entry.decl.pos.filename, 0, len(entry.decl.pos.filename));
      wrapped.push(entry);

      let existing = self.by_name.at(entry.decl.name);
      if existing.is_some() {
        Vec<IndexedDeclaration> bucket = existing.unwrap();
        // `bucket` aliases the same backing array `self.by_name`
        // itself still points at - `push()` below can realloc it,
        // leaving that stored entry pointing at memory `realloc`
        // already moved or freed, until the write-back just after.
        self.by_name.remove(entry.decl.name);
        bucket.push(entry);
        self.by_name.put(entry.decl.name, bucket);
      } else {
        Vec<IndexedDeclaration> bucket2;
        bucket2.init(2);
        bucket2.push(entry);
        self.by_name.put(entry.decl.name, bucket2);
      }
      j = j + 1;
    }
    self.by_uri.put(uri, wrapped);
    fresh.free();
  }
}
