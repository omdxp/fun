// Signature help.
//
// What a call's own signature looks like, and which parameter the
// cursor sits on, while a reader is still typing inside its parens.

use protocol;
use documents;
use analysis;
use positions;
use symbols;
use completion;
use ..lexer.token;
use std.string;
use std.vec;
use std.option;
use std.c.mem;

// What a client is told when the cursor isn't inside a resolvable call.
const str NO_SIGNATURE = "null";

// The signature help for the position `line`/`character` in `doc`, as
// the result a client is sent.
pub fun signature_help(AnalysisCache* cache, Document doc, num line, num character) str {
  Analyzed read = cache.of(doc);
  if !read.lexed {
    ret NO_SIGNATURE;
  }
  Vec<Token> tokens = read.tokens;
  let call = _enclosing_call(&tokens, line, character);
  if call.is_none() {
    ret NO_SIGNATURE;
  }
  CallSite c = call.unwrap();
  num source_line = line + 1;

  // A reader asks for this exactly while still typing an argument,
  // which is exactly when the enclosing call's own parens aren't
  // balanced yet and the document doesn't parse - the ordinary case,
  // not an edge one, so it needs its own answer rather than nothing
  // (`!read.parsed` used to mean no signature at all here, the one
  // place in this file that never got the token-only fallback hover/
  // completion/goto-definition already have).
  if !read.parsed {
    if c.has_receiver {
      // A method on a chain (`l.debug_r("msg").dec_field(|`) - the
      // other real-world shape every bug report against this used,
      // once a plain top-level call's own gap (right above) was
      // fixed. `chain_receiver_identifier_index_from_tokens` finds the
      // receiver segment's own identifier token-only (walking back
      // through a call-ending chain of any length, not just a plain
      // local), `chain_tail_type_from_tokens` resolves its type the
      // same way, and `member_declaration_from_tokens` is the same
      // lookup hover/goto-definition already use for a member once
      // the document stops parsing.
      num recv_idx = chain_receiver_identifier_index_from_tokens(
        &tokens,
        index_of_token(&tokens, c.callee_token)
      );
      if recv_idx < 0 {
        ret NO_SIGNATURE;
      }
      str recv_type = chain_tail_type_from_tokens(&tokens, doc.path, cache, recv_idx);
      if equals(recv_type, "") {
        ret NO_SIGNATURE;
      }
      let member = member_declaration_from_tokens(
        &tokens,
        doc.path,
        cache,
        recv_type,
        c.callee
      );
      free(recv_type);
      if member.is_none() {
        ret NO_SIGNATURE;
      }
      Declaration d = member.unwrap();
      fit d.kind {
        .Function -> {}
        _ -> { ret NO_SIGNATURE; }
      }
      // Same implicit-`self`-as-parameter-0 shift the parsed-tree
      // branch below already applies for a method.
      ret _signature_result(d.detail, c.active_param + 1);
    }
    str sig = local_fn_signature_from_tokens(&tokens, doc.text, c.callee);
    if equals(sig, "") {
      ret NO_SIGNATURE;
    }
    ret _signature_result(sig, c.active_param);
  }

  ProgramMergeResult program = read.program;
  Option<Declaration> found = .None;
  // A method's own rendered signature includes its implicit `self` as
  // parameter 0, which the reader never types; shifting the active
  // index by one keeps it pointing at the actual argument the cursor
  // sits on rather than at `self`.
  num active_param = c.active_param;
  if c.has_receiver {
    // `chain_receiver`, not `type_name_of_local`: the latter only
    // resolves a receiver that's a bare local name, failing silently
    // for a method called on a chain of any length
    // (`l.debug_r("msg").field(...)`'s own `field` has no plain local
    // receiver at all - its receiver is itself a call) - the same gap
    // `_call_arg_expected_type` had (see navigation.fn), just here for
    // signature help instead of hover/goto-definition.
    let recv = chain_receiver(
      &tokens,
      c.callee_token,
      &program.nodes,
      doc.path,
      source_line,
      0
    );
    if !equals(recv.type_name, "") {
      found = lookup_method(
        &program.nodes,
        recv.type_name,
        c.callee,
        recv.generic_args
      );
      active_param = active_param + 1;
    }
  } else {
    found = lookup_top_level(&program.nodes, c.callee);
  }
  if found.is_none() {
    ret NO_SIGNATURE;
  }
  Declaration d = found.unwrap();
  fit d.kind {
    .Function -> {}
    _ -> { ret NO_SIGNATURE; }
  }
  ret _signature_result(d.detail, active_param);
}

// One call the cursor sits inside: the callee's own bare name, the
// callee's own token (so its receiver, if any, can be resolved
// through a chain of any length rather than just a plain local), and
// which positional argument (0-based) the cursor currently sits on.
compound CallSite {
  str callee;
  Token callee_token;
  flag has_receiver;
  num active_param;
}

// Walks backward from `line`/`character` to the nearest unmatched
// `(`, counting top-level commas along the way to know which argument
// the cursor is inside, then reads the identifier (and its own
// receiver, if reached through a dot) immediately before it.
fun _enclosing_call(Vec<Token>* tokens, num line, num character) Option<CallSite> {
  num i = _token_index_at_or_before(tokens, line, character)?;
  num depth = 0;
  num commas = 0;
  for i >= 0 {
    Token tk = tokens.get(i);
    if token_is_symbol(tk, ')') {
      depth = depth + 1;
    } elif token_is_operator(tk, "(") {
      if depth == 0 {
        break;
      }
      depth = depth - 1;
    } elif depth == 0 && token_is_operator(tk, ",") {
      commas = commas + 1;
    }
    i = i - 1;
  }
  if i < 0 {
    ret .None;
  }
  // `i` now indexes the opening `(` itself.
  Token ct = token_before(tokens, i)?;
  fit ct.type {
    .Identifier -> {}
    _ -> { ret .None; }
  }
  num callee_index = index_of_token(tokens, ct);
  let dot = token_before(tokens, callee_index);
  flag has_receiver = dot.is_some() && token_is_operator(dot.unwrap(), ".");
  CallSite c;
  c.callee = token_word(ct);
  c.callee_token = ct;
  c.has_receiver = has_receiver;
  c.active_param = commas;
  ret .Some(c);
}

// The index of the last non-trivia token at or before `line`/
// `character`, so a cursor sitting in whitespace just after a token
// (typing a new argument, nothing under the cursor itself) still has
// something to walk backward from.
fun _token_index_at_or_before(Vec<Token>* tokens, num line, num character) Option<num> {
  num source_line = line + 1;
  num source_col = character + 1;
  num best = -1;
  num i = 0;
  for i < tokens.len {
    Token t = tokens.get(i);
    i = i + 1;
    if t.type == .Comment || t.type == .NewLine {
      continue;
    }
    if t.pos.line > source_line {
      break;
    }
    if t.pos.line == source_line && t.pos.start_col > source_col {
      break;
    }
    best = i - 1;
  }
  if best < 0 {
    ret .None;
  }
  ret .Some(best);
}

// `signature`'s own parameter list, one rendered piece per parameter
// (`"str name"`, `"Vec<T>* data"`, ...), split at top-level commas
// only: angle-bracket and paren depth are both tracked so a comma
// inside a param's own generic args ("Map<str, num> m") is never
// mistaken for a separator. Shared with `inlay_hints.fn`, which needs
// the same parameter list to place a name hint at each call argument.
// The LSP `SignatureHelp` result: `signature`'s own parameters broken
// out individually, with `active_param` (clamped into range) marking
// which one the cursor sits on.
fun _signature_result(str signature, num active_param) str {
  Vec<str> params = split_signature_params(signature);
  defer free_params_vec(&params);
  StringBuilder b = string_builder_init(128);
  b.append(`{"signatures":[{"label":`);
  json_quote_into(&b, signature);
  b.append(`,"parameters":[`);
  num i = 0;
  for i < params.len {
    if i > 0 {
      b.append(",");
    }
    b.append(`{"label":`);
    json_quote_into(&b, params.get(i));
    b.append("}");
    i = i + 1;
  }
  num clamped = active_param;
  if params.len > 0 && clamped >= params.len {
    clamped = params.len - 1;
  }
  if clamped < 0 {
    clamped = 0;
  }
  b.append(`]}],"activeSignature":0,"activeParameter":`);
  b.append_num(clamped);
  b.append("}");
  ret b.build();
}
