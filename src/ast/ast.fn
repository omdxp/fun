// AST node types.
// 
// `DataType` and `Node` share this file because they're mutually
// recursive (array-size expressions need `Node`, declarations need
// `DataType`) and imports can't be circular. `NodeKind` is a flat
// data-carrying enum with each variant's payload in its own dedicated
// `compound`. Optional child nodes are plain `Node*` fields compared
// against `nil`; optional `Vec<T>` fields pair a `flag has_X` flag with
// an always-`.init(0)`-ed value, since an uninitialized `Vec<T>` reads
// garbage length; always build node payloads through the `_new()`
// constructors below, never a bare declaration.

use ..lexer.token;
use std.vec;
use std.string;
use std.option;
use std.quirks;
use std.c.mem;

// ===== Data types =====

// Boolean characteristics of a DataType.
pub compound DataTypeFlags {
  flag is_pointer;
  flag is_literal;
  flag is_array;
}

// The builtin scalar kind of a DataType (a named/user-defined type has
// `.Unknown` here and its real name in `DataType.type_str` instead).
pub enum DataTypeType {
  Void,
  Raw,
  Chr,
  Str,
  Dec,
  Num,
  Bin,
  Unknown,
}

// A function-type signature attached to a DataType's `fn_sig` (for a
// function-type parameter, `fun(T1, T2) R name`; see DataType.fn_sig).
pub compound FnTypeSig {
  Vec<DataType*> params;
  DataType* rtype;
}

pub fun fn_type_sig_new() FnTypeSig {
  FnTypeSig s;
  s.params.init(0);
  ret s;
}

// A type annotation as written/inferred: a builtin scalar, a named
// user-defined type, a pointer/array of one, or a generic instantiation.
pub compound DataType {
  DataTypeFlags flags;
  DataTypeType kind;
  str type_str;
  num pointer_depth;
  // Array-size expressions (`num[COMPUTED_SIZE]`); empty when not an
  // array or when brackets have no inner expression (`num[]`).
  Vec<Node*> array_brackets;
  flag is_array;
  num array_depth;
  // Generic instantiation arguments (`Vec<num>` -> [num]); empty for a
  // non-generic type.
  Vec<DataType*> generic_args;
  FnTypeSig* fn_sig;
  flag has_fn_sig;
  // A real, permanently-persisting tuple type (`(num, str)`), kept
  // separate from `generic_args` since a tuple has no single named
  // declaration behind it the way a generic instantiation always does.
  // `type_str` stays empty and `kind` stays `.Unknown` for a tuple,
  // mirroring how `has_fn_sig`/`fn_sig` already relate to them.
  flag is_tuple;
  Vec<DataType*> tuple_members;
}

// Every DataType construction site must go through this constructor (see
// the file-level design note on Vec-init discipline).
pub fun dtype_new() DataType {
  DataType dt;
  dt.flags = .{is_pointer = false, is_literal = false, is_array = false};
  dt.kind = .Unknown;
  dt.type_str = "";
  dt.pointer_depth = 0;
  dt.array_brackets.init(0);
  dt.is_array = false;
  dt.array_depth = 0;
  dt.generic_args.init(0);
  dt.fn_sig = nil;
  dt.has_fn_sig = false;
  dt.is_tuple = false;
  dt.tuple_members.init(0);
  ret dt;
}

// ===== Node envelope =====

// Boolean characteristics of a Node, tracked during parsing/typecheck.
pub compound NodeFlags {
  flag inside_expression;
  flag has_variable_combined;
  flag is_public;
  flag is_used;
  // True for a `.String`-kind node built from a backtick raw string
  // literal; see `Token.is_raw_string`'s doc comment. Set by the parser
  // when constructing this node from its token; codegen and the
  // formatter both key off it for `.String` nodes specifically.
  flag is_raw_string;
}

pub fun node_flags_new() NodeFlags {
  NodeFlags f;
  f.inside_expression = false;
  f.has_variable_combined = false;
  f.is_public = false;
  f.is_used = false;
  f.is_raw_string = false;
  ret f;
}

// Links a node back to its owning declaration/enclosing function, used by
// semantic checks that need to walk from a reference back to context (e.g.
// visibility checks, "which function is this return statement inside").
pub compound BindedNode {
  Node* owner;
  flag has_owner;
  Node* function;
  flag has_function;
}

// ===== Warning diagnostics =====

// Stable identifier for a compiler warning category, used by diagnostics and
// by `allow`/`expect` warning-control statements. Each variant's own hover
// text (`warning_id_doc` in src/fls/navigation.fn) says the same thing at
// more length; keep the two in sync.
pub enum WarningId {
  // Returning the address of one of the function's own locals.
  ReturnLocalPtr,
  // A fit with no catch-all that doesn't cover every value its subject
  // can hold.
  FitNonExhaustive,
  // A fit branch an earlier branch in the same fit already covers.
  FitUnreachableBranch,
  // A statement written after one that always exits its scope.
  UnreachableCode,
  // An assert whose condition is a compile-time constant.
  AssertConstant,
  // A local or top-level const nothing reads.
  UnusedVariable,
  // A use statement naming a module nothing in the file reads from.
  UnusedImport,
  // A private, non-main function with a body nothing calls.
  UnusedFunction,
  // A private compound type nothing references.
  UnusedCompound,
  // A private type alias nothing references.
  UnusedTypeAlias,
  // A non-void function that can reach its end without returning a value.
  MissingReturn,
  // A WaitGroup sized for one completion, done()'d from a fork inside a loop.
  BlockingForkDeadlock,
  // A mutable compound forked into concurrently with no synchronization.
  SharedMutableCaptureRace,
  // An integer literal that can't fit its declared arbitrary-width type.
  IntegerLiteralOutOfRange,
  // More blocking sends issued into a bounded channel than it can hold.
  ChannelCapacityOverflow,
}

// Which way a `WarningCtrlNode` controls its target warning: `allow` silences
// it, `expect` requires it to actually fire (else that is itself an error).
pub enum WarningControlAction {
  Allow,
  Expect,
}

// Kept as a free function (rather than only the `From<str>` quirk impl
// below) because callers that validate a warning-control directive from
// source (`allow unknown_id;`) need to detect and report an invalid id as a
// real compile error; `From<T>`'s `from(T value)` is void/best-effort by
// contract (see std.quirks), which can't express that failure.
pub fun warning_id_from_string(str name) Option<WarningId> {
  fit name {
    "return_local_ptr" -> { ret .Some(.ReturnLocalPtr); }
    "fit_non_exhaustive" -> { ret .Some(.FitNonExhaustive); }
    "fit_unreachable_branch" -> { ret .Some(.FitUnreachableBranch); }
    "unreachable_code" -> { ret .Some(.UnreachableCode); }
    "assert_constant" -> { ret .Some(.AssertConstant); }
    "unused_variable" -> { ret .Some(.UnusedVariable); }
    "unused_import" -> { ret .Some(.UnusedImport); }
    "unused_function" -> { ret .Some(.UnusedFunction); }
    "unused_compound" -> { ret .Some(.UnusedCompound); }
    "unused_type_alias" -> { ret .Some(.UnusedTypeAlias); }
    "missing_return" -> { ret .Some(.MissingReturn); }
    "blocking_fork_deadlock" -> { ret .Some(.BlockingForkDeadlock); }
    "shared_mutable_capture_race" -> { ret .Some(.SharedMutableCaptureRace); }
    "integer_literal_out_of_range" -> { ret .Some(.IntegerLiteralOutOfRange); }
    "channel_capacity_overflow" -> { ret .Some(.ChannelCapacityOverflow); }
    _ -> { ret .None; }
  }
}

// One resolved `warning_id_or_plural_from_string` result: which id was
// named, and whether the spelling that named it was singular or plural.
pub compound WarningIdRef {
  WarningId id;
  WarningControlScope scope;
}

// Resolves `name` (an `allow`/`expect` statement's own identifier) to a
// real `WarningId` plus whether it was written singular (`Next` scope -
// covers just the next matching warning) or plural (`WholeFile` scope -
// covers every one for the rest of the file). No warning id needs its
// plural spelling registered by hand: `name` is tried as-is first, then
// with a trailing `es` removed (`branches` -> `branch`), then with a
// trailing `s` removed (`imports` -> `import`) - whichever first
// resolves to a real id wins, so an accidental prefix match (`ranges`
// stripped of `es` -> `rang`, not a real id) falls through to the next,
// correct candidate rather than silently failing.
pub fun warning_id_or_plural_from_string(str name) Option<WarningIdRef> {
  let exact = warning_id_from_string(name);
  if exact.is_some() {
    ret .Some(WarningIdRef{id = exact.unwrap(), scope = .Next});
  }
  num n = len(name);
  if n > 2 && equals(substr(name, n - 2, 2), "es") {
    let es_stripped = warning_id_from_string(substr(name, 0, n - 2));
    if es_stripped.is_some() {
      ret .Some(WarningIdRef{id = es_stripped.unwrap(), scope = .WholeFile});
    }
  }
  if n > 1 && name[n - 1] == 's' {
    let s_stripped = warning_id_from_string(substr(name, 0, n - 1));
    if s_stripped.is_some() {
      ret .Some(WarningIdRef{id = s_stripped.unwrap(), scope = .WholeFile});
    }
  }
  ret .None;
}

test "warning_id_or_plural_from_string resolves every warning id both singular and plural" {
  // Covers all 15 ids, including the one irregular case
  // (`fit_unreachable_branch` -> `...branches` needs the "es" strip,
  // not a plain "s" strip) and the one that already ends in "e"
  // (`integer_literal_out_of_range` -> `...ranges` is a plain "s"
  // strip, not "es" - the "es" attempt on it must fail closed and fall
  // through rather than matching a bogus "...rang").
  str singulars = "return_local_ptr,fit_non_exhaustive,fit_unreachable_branch,unreachable_code,assert_constant,unused_variable,unused_import,unused_function,unused_compound,unused_type_alias,missing_return,blocking_fork_deadlock,shared_mutable_capture_race,integer_literal_out_of_range,channel_capacity_overflow";
  str plurals = "return_local_ptrs,fit_non_exhaustives,fit_unreachable_branches,unreachable_codes,assert_constants,unused_variables,unused_imports,unused_functions,unused_compounds,unused_type_aliases,missing_returns,blocking_fork_deadlocks,shared_mutable_capture_races,integer_literal_out_of_ranges,channel_capacity_overflows";
  Vec<str> sing = split(singulars, ',');
  Vec<str> plur = split(plurals, ',');
  assert sing.len == plur.len, "expected a matched singular/plural pair per id";
  num i = 0;
  for i < sing.len {
    str s = sing.get(i);
    str p = plur.get(i);
    i = i + 1;

    let sref_opt = warning_id_or_plural_from_string(s);
    assert sref_opt.is_some(), "expected the singular id to resolve";
    let sref = sref_opt.unwrap();
    assert sref.scope == .Next, "expected the singular id to resolve as Next scope";

    let pref_opt = warning_id_or_plural_from_string(p);
    assert pref_opt.is_some(), "expected the plural id to resolve";
    let pref = pref_opt.unwrap();
    assert pref.scope == .WholeFile, "expected the plural id to resolve as WholeFile scope";

    assert sref.id == pref.id, "expected the singular and plural spellings to resolve to the same underlying id";
  }
}

test "warning_id_or_plural_from_string rejects an unknown id, singular-looking or plural-looking" {
  assert warning_id_or_plural_from_string("not_a_real_id").is_none(), "expected a bogus id to be rejected";
  assert warning_id_or_plural_from_string("not_a_real_ids").is_none(), "expected a bogus plural-looking id to be rejected too";
}

// `id.from(str)` mutates `*self` in place on a recognized name, matching
// `From<T>`'s documented best-effort contract (leaves `self` unchanged on
// an unrecognized one), built on the fallible free function above rather
// than duplicating the string table.
impl WarningId as From<str> {
  pub from(str value) {
    let parsed = warning_id_from_string(value);
    fit parsed {
      .Some(id) -> { *self = id; }
      .None -> {}
    }
  }
}

// `id.to()` instead of a free function: WarningId -> str is exactly the
// shape std.quirks' `To<T>` conversion quirk is for.
impl WarningId as To<str> {
  pub to() str {
    fit *self {
      .ReturnLocalPtr -> { ret "return_local_ptr"; }
      .FitNonExhaustive -> { ret "fit_non_exhaustive"; }
      .FitUnreachableBranch -> { ret "fit_unreachable_branch"; }
      .UnreachableCode -> { ret "unreachable_code"; }
      .AssertConstant -> { ret "assert_constant"; }
      .UnusedVariable -> { ret "unused_variable"; }
      .UnusedImport -> { ret "unused_import"; }
      .UnusedFunction -> { ret "unused_function"; }
      .UnusedCompound -> { ret "unused_compound"; }
      .UnusedTypeAlias -> { ret "unused_type_alias"; }
      .MissingReturn -> { ret "missing_return"; }
      .BlockingForkDeadlock -> { ret "blocking_fork_deadlock"; }
      .SharedMutableCaptureRace -> { ret "shared_mutable_capture_race"; }
      .IntegerLiteralOutOfRange -> { ret "integer_literal_out_of_range"; }
      .ChannelCapacityOverflow -> { ret "channel_capacity_overflow"; }
    }
  }
}

// ===== Per-node-kind payload types =====
// Each compound below is the payload of exactly one `NodeKind` variant
// (named identically, minus the `Node`/`Kind` suffix). One with a
// `Vec<T>` field gets a paired `_new()` constructor; use it instead of
// a bare declaration (see the file-level note above).

// A binary (or, with `right` absent, unary-ish) operator expression, e.g.
// `a + b`, `a = b`, member access `a.b`, or a call `callee(args)` (`op` is
// `"()"` for a call, with `right` holding the flattened comma-joined args).
pub compound ExprNode {
  Node* left;
  flag has_left;
  Node* right;
  flag has_right;
  str op;
  // Explicit type arguments at a call site (`ok<num, Error>(42)`), for a
  // type param nothing in the argument list can infer (one that only
  // appears in the return type). Only meaningful when `op` is `"()"`.
  Vec<DataType*> generic_args;
  flag has_generic_args;
}

// Every `ExprNode` construction site must go through this constructor
// (see the file-level design note on Vec-init discipline): a bare
// declaration leaves every field, including `generic_args`, uninitialized.
pub fun expr_node_new() ExprNode {
  ExprNode e;
  e.left = nil;
  e.has_left = false;
  e.right = nil;
  e.has_right = false;
  e.op = "";
  e.generic_args.init(0);
  e.has_generic_args = false;
  ret e;
}

// A prefix (`-x`, `!x`, `*p`, `&x`) or postfix (`x++`) unary operator.
pub compound UnaryNode {
  flag is_left_operanded_unary;
  str op;
  Node* operand;
  flag has_indirection;
  num indirection_depth;
  // The error value `expr?!(err)` supplies, propagated in whatever
  // shape the enclosing function's own return type needs when `expr`
  // is `.None`. Only ever set when `op` is `"?!"`; every other unary
  // (including the mirror `!?`, which needs no argument) leaves this
  // unset.
  Node* error_arg;
  flag has_error_arg;
}

// True for any of the four propagation operators (`?`/`!`/`?!`/`!?`),
// as a left-operanded (postfix) unary's own `op` - the single shared
// predicate every consumer (typecheck, codegen, fls, the unused-
// variable/import checker) should use instead of its own repeated
// `equals(op, "?") || equals(op, "!")`-style check, so a future fifth
// propagation form only needs updating here.
pub fun is_propagation_op(str op) flag {
  ret equals(op, "?") || equals(op, "!") || equals(op, "?!") || equals(op, "!?");
}

// A ternary conditional expression: `cond ? then_val : else_val`.
pub compound TenaryNode {
  Node* cond;
  Node* then_val;
  Node* else_val;
}

// One `name = value` pair inside a compound initializer (`Type{ name =
// value, ... }`).
pub compound CompoundInitField {
  str name;
  Node* value;
}

// A compound-literal initializer: `Type{...}` (dtype present) or `.{...}`
// (dtype inferred from context).
pub compound CompoundInitNode {
  DataType* init_dtype;
  flag has_dtype;
  Vec<CompoundInitField> fields;
}

pub fun compound_init_node_new() CompoundInitNode {
  CompoundInitNode n;
  n.init_dtype = nil;
  n.has_dtype = false;
  n.fields.init(0);
  ret n;
}

// A variable declaration: `Type name;` or `Type name = val;` (`let name =
// val;` too: `var_type` carries the "infer from val" placeholder until
// typecheck resolves it).
pub compound VariableNode {
  DataType* var_type;
  str name;
  Node* val;
  flag has_val;
  // True for `const name = value;` (always requires an initializer).
  // False for every other variable-shaped construction: a plain
  // `let`/typed local, a function parameter, or a method's `self`.
  flag is_const;
  // True for `let (a, b, c) = expr;`: `name` is inert ("") and
  // `destructure_names` holds the real bound names instead, each
  // matched positionally against `val`'s own inferred tuple type.
  flag is_destructure;
  Vec<str> destructure_names;
}

// A `{ ... }` block: an ordered list of statements.
pub compound BodyNode {
  Vec<Node*> statements;
}

pub fun body_node_new() BodyNode {
  BodyNode b;
  b.statements.init(0);
  ret b;
}

// A function declaration: `fun name(args) rtype { body }` (a bodyless one,
// `has_body = false`, is a binding/prototype; see `std.c.*`).
pub compound FunctionNode {
  DataType* rtype;
  flag has_rtype;
  str name;
  flag has_name;
  // Generic type parameter names (`fun f<T>` -> ["T"]).
  Vec<str> type_params;
  flag has_type_params;
  // Forced concrete type combinations from constrained type params
  // (`fun f<T: num | str>` -> [["num"], ["str"]]), parallel to type_params.
  Vec<Vec<str>> type_param_forced_insts;
  flag has_type_param_forced_insts;
  // Each type param's own declared constraint, index-aligned with
  // type_params (`fun f<T: num | str>` -> [["num", "str"]]); empty per
  // param when unconstrained. For display (hover, signatures), unlike
  // type_param_forced_insts' combined Cartesian product.
  Vec<Vec<str>> type_param_constraints;
  flag has_type_param_constraints;
  // Each type param's own default type (`E = Error`), index-aligned with
  // type_params; nil for a param with none. Defaults are trailing: once
  // one param has a default, every later one does too. A default may name
  // earlier params (`B = A`), never itself or a later one.
  Vec<DataType*> type_param_defaults;
  Vec<Node*> args;
  flag has_args;
  flag is_async;
  flag is_variadic;
  Node* body;
  flag has_body;
}

pub fun function_node_new() FunctionNode {
  FunctionNode f;
  f.rtype = nil;
  f.has_rtype = false;
  f.name = "";
  f.has_name = false;
  f.type_params.init(0);
  f.has_type_params = false;
  f.type_param_forced_insts.init(0);
  f.has_type_param_forced_insts = false;
  f.type_param_constraints.init(0);
  f.has_type_param_constraints = false;
  f.type_param_defaults.init(0);
  f.args.init(0);
  f.has_args = false;
  f.is_async = false;
  f.is_variadic = false;
  f.body = nil;
  f.has_body = false;
  ret f;
}

// Shared by StatementIf and StatementElseIf (identical shape).
pub compound IfStmtNode {
  Node* condition;
  Node* body;
}

pub compound ForCondNode {
  // `for { ... }` (infinite) when absent; `for cond { ... }` otherwise.
  Node* condition;
  flag has_condition;
  Node* body;
}

// `for item : arr { ... }` or `for i, item :: arr { ... }`: iterate over an
// array/Vec/Iterator-implementing value, optionally tracking an index.
// `for i : start..end { ... }` is this shape too: the parser desugars a
// range into constructing a `Range{start, end}` value and feeding it
// through here like any other `Iterator`-implementing iterable, rather
// than a distinct AST shape of its own.
pub compound ForIterNode {
  str index_name;
  flag has_index_name;
  str item_name;
  // A destructuring loop variable (`for (a, b) : pairs`), naming each
  // element of the iterable's own tuple-typed element instead of a
  // single `item_name`. `item_name` stays empty/unused when this is
  // set - mirrors `VariableNode.is_destructure`/`destructure_names`.
  flag item_is_destructure;
  Vec<str> item_destructure_names;
  Node* iterable;
  Node* body;
}

// Which of the two `for` loop shapes a StatementFor node is.
pub enum ForKind {
  Cond(ForCondNode),
  Iter(ForIterNode),
}

// `assert cond;` or `assert cond, "message";`.
pub compound AssertNode {
  Node* condition;
  Node* message;
  flag has_message;
}

// Whether a `WarningCtrlNode` covers just the next matching warning, or
// every one for the rest of the file. Decided by which spelling was
// written at the use site (`allow unused_import, "...";` vs `allow
// unused_imports, "...";`), not a separate flag the author sets
// explicitly - the plural form of a warning id's own name IS the
// whole-file request.
pub enum WarningControlScope {
  Next,
  WholeFile,
}

// `allow warning_id;` or `expect warning_id;` (see WarningControlAction).
pub compound WarningCtrlNode {
  WarningControlAction action;
  WarningId id;
  WarningControlScope scope;
  str reason;
}

// One `pattern -> { body }` arm of a `fit` statement.
pub compound FitBranch {
  Node* condition;
  flag has_condition;
  Node* body;
  // Positional binding names for a data-carrying-enum destructuring arm
  // (`Shape.Circle(r)` binds ["r"]), or for a tuple-pattern arm's own
  // binding positions (below). Empty for a non-destructuring arm.
  Vec<str> bindings;
  flag has_bindings;
  // True when `condition` is a `.TupleLiteral` used as a structural
  // pattern (`(0, y) -> ...`) rather than an ordinary value expression -
  // each element is either a literal to match positionally or a bare
  // identifier binding that position's value, read directly off
  // `condition`'s own `.TupleLiteral` elements rather than duplicated
  // here, so freeing/cloning `condition` already owns them.
  flag is_tuple_pattern;
}

pub fun fit_branch_new() FitBranch {
  FitBranch b;
  b.condition = nil;
  b.has_condition = false;
  b.body = nil;
  b.bindings.init(0);
  b.has_bindings = false;
  b.is_tuple_pattern = false;
  ret b;
}

// `fit expr { branches }`: pattern-match dispatch over `exp`.
pub compound FitStmtNode {
  Node* exp;
  Vec<FitBranch> branches;
  flag has_default_branch;
}

pub fun fit_stmt_node_new() FitStmtNode {
  FitStmtNode f;
  f.exp = nil;
  f.branches.init(0);
  f.has_default_branch = false;
  ret f;
}

// `use path;` or `use path as alias;`.
pub compound ImportNode {
  str path;
  str alias;
  flag has_alias;
}

// One `name` : `dtype` field of a compound type declaration.
pub compound CompoundField {
  str name;
  DataType* dtype;
  Pos pos;
  flag has_pos;
}

// A `compound Name { fields }` declaration (a struct-like user-defined
// type).
pub compound CompoundNode {
  str name;
  Vec<CompoundField> fields;
  Vec<str> type_params;
  flag has_type_params;
  Vec<Vec<str>> type_param_forced_insts;
  flag has_type_param_forced_insts;
  // Each type param's own declared constraint, index-aligned with
  // type_params; see FunctionNode's own field of the same name.
  Vec<Vec<str>> type_param_constraints;
  flag has_type_param_constraints;
  // Each type param's own default type (`E = Error`), index-aligned with
  // type_params; nil for a param with none. Defaults are trailing: once
  // one param has a default, every later one does too. A default may name
  // earlier params (`B = A`), never itself or a later one.
  Vec<DataType*> type_param_defaults;
}

pub fun compound_node_new() CompoundNode {
  CompoundNode c;
  c.name = "";
  c.fields.init(0);
  c.type_params.init(0);
  c.has_type_params = false;
  c.type_param_forced_insts.init(0);
  c.has_type_param_forced_insts = false;
  c.type_param_constraints.init(0);
  c.has_type_param_constraints = false;
  c.type_param_defaults.init(0);
  ret c;
}

// One named, typed parameter of a quirk method signature.
pub compound QuirkArg {
  str name;
  DataType* dtype;
}

// One required method signature inside a `quirk Name { ... }` declaration
// (no body, quirks only declare a contract; `impl Type as Name` supplies
// the implementation).
pub compound QuirkMethodSig {
  str name;
  DataType* rtype;
  Vec<QuirkArg> args;
  flag is_async;
  Pos pos;
}

pub fun quirk_method_sig_new() QuirkMethodSig {
  QuirkMethodSig m;
  m.name = "";
  m.rtype = nil;
  m.args.init(0);
  m.is_async = false;
  ret m;
}

// An `als Name<T1, T2> = <type>;` declaration: a reusable name for a type
// expression, expanded wherever referenced before typecheck ever runs (see
// the alias-expansion pass) - typecheck and codegen never see an alias
// reference, only its already-expanded body.
// 
// Two distinct body shapes, told apart by `is_bound_list`: an ordinary
// alias (`als Meters = num;`, `als Callback<A, R> = fun(A) R;`) names one
// type expression in `body`; a bound-list alias (`als Numeric = num |
// dec;`) names a set of alternatives in `bound_alternatives`, each already
// rendered to canonical text the same way a generic bound alternative is
// (see `render_datatype_bound`), spliced into a `T: Numeric` bound list
// wherever referenced rather than standing for a single type. A bound-list
// alias is never generic - a bound list has no single instantiation site.
pub compound TypeAliasNode {
  str name;
  Vec<str> type_params;
  // Parallel to `type_params`: true at a position parsed as `(Name)`
  // rather than a bare `Name` - a spread param, whose tuple-typed
  // argument spreads into separate positional parameters wherever it
  // fills a whole `fun(...)` parameter position in `body`, instead of
  // substituting in as one tuple-struct parameter.
  Vec<flag> type_param_is_spread;
  flag has_type_params;
  // Each type param's own default type (`E = Error`), index-aligned with
  // type_params; nil for a param with none. Defaults are trailing: once
  // one param has a default, every later one does too. A default may name
  // earlier params (`B = A`), never itself or a later one.
  Vec<DataType*> type_param_defaults;
  DataType* body;
  Vec<str> bound_alternatives;
  flag is_bound_list;
  // Set by `expand_type_aliases` itself once a real reference is seen
  // anywhere in the program, since expansion substitutes every such
  // reference away before the `unused_type_alias` warning ever runs -
  // by then, nothing else can tell a used alias from an unused one.
  flag was_used;
}

pub fun type_alias_node_new() TypeAliasNode {
  TypeAliasNode a;
  a.name = "";
  a.type_params.init(0);
  a.type_param_is_spread.init(0);
  a.has_type_params = false;
  a.type_param_defaults.init(0);
  a.body = nil;
  a.bound_alternatives.init(0);
  a.is_bound_list = false;
  a.was_used = false;
  ret a;
}

// A `quirk Name { methods }` declaration (a structural interface).
pub compound QuirkNode {
  str name;
  Vec<QuirkMethodSig> methods;
  // True for a generic quirk (`quirk Iterator<T> { ... }`): static dispatch
  // only, no monomorphic vtable/quirk-object struct (an unbound type param
  // can't be represented in a single emitted signature) unless a concrete
  // instantiation is used as a type annotation.
  flag is_generic;
  Vec<str> type_params;
  flag has_type_params;
  // Each type param's own default type (`E = Error`), index-aligned with
  // type_params; nil for a param with none. Defaults are trailing: once
  // one param has a default, every later one does too. A default may name
  // earlier params (`B = A`), never itself or a later one.
  Vec<DataType*> type_param_defaults;
}

pub fun quirk_node_new() QuirkNode {
  QuirkNode q;
  q.name = "";
  q.methods.init(0);
  q.is_generic = false;
  q.type_params.init(0);
  q.has_type_params = false;
  q.type_param_defaults.init(0);
  ret q;
}

// One variant of an `enum Name { variants }` declaration: a plain
// enumerator, or a data-carrying (tagged union) one if `has_payload`.
pub compound EnumVariant {
  str name;
  // Explicit integer value (`Variant = 3;`); auto-increments from 0
  // when absent.
  num value;
  flag has_value;
  // Positional payload types for a data-carrying variant (`Circle(num)` ->
  // [num]); absent for a plain enumerator. An enum is a tagged union if
  // any of its variants has a payload.
  Vec<DataType*> payload;
  flag has_payload;
  Pos pos;
  flag has_pos;
}

pub fun enum_variant_new() EnumVariant {
  EnumVariant v;
  v.name = "";
  v.value = 0;
  v.has_value = false;
  v.payload.init(0);
  v.has_payload = false;
  v.has_pos = false;
  ret v;
}

// An `enum Name { variants }` declaration.
pub compound EnumDeclNode {
  str name;
  Vec<EnumVariant> variants;
  // Generic type parameters (`Option<T>` -> ["T"], `Result<T, E>` -> ["T",
  // "E"]); variant payloads may reference these, monomorphized per concrete
  // instantiation like generic compounds.
  Vec<str> type_params;
  flag has_type_params;
  // Each type param's own default type (`E = Error`), index-aligned with
  // type_params; nil for a param with none. Defaults are trailing: once
  // one param has a default, every later one does too. A default may name
  // earlier params (`B = A`), never itself or a later one.
  Vec<DataType*> type_param_defaults;
}

pub fun enum_decl_node_new() EnumDeclNode {
  EnumDeclNode e;
  e.name = "";
  e.variants.init(0);
  e.type_params.init(0);
  e.has_type_params = false;
  e.type_param_defaults.init(0);
  ret e;
}

// An `impl Type { methods }` (plain) or `impl Type as Quirk { methods }`
// (quirk-implementing) block.
pub compound ImplNode {
  str type_name;
  Vec<str> type_params;
  flag has_type_params;
  Vec<Vec<str>> type_param_forced_insts;
  flag has_type_param_forced_insts;
  // Each type param's own declared constraint, index-aligned with
  // type_params; see FunctionNode's own field of the same name.
  Vec<Vec<str>> type_param_constraints;
  flag has_type_param_constraints;
  // Bare quirk name (`Iterator`, `To`, ...), even when the `as` clause names
  // a concrete instantiation (`as Iterator<num>`). Absent for a plain impl
  // block (`impl Type { ... }`).
  str quirk_name;
  flag has_quirk_name;
  // Set when the `as` clause names a concrete instantiation of a generic
  // quirk whose argument is not the enclosing impl's own type param (`as
  // To<num>`), the mangled name (`To__num`) of that distinct quirk
  // identity, registered alongside `quirk_name` above.
  str quirk_concrete_instantiation;
  flag has_quirk_concrete_instantiation;
  // The quirk's own single type argument (`num` in `as Iterator<num>`,
  // `T` in a symbolic `as Iterator<T>`), as a real `DataType` rather than
  // only the pre-mangled string above - needed to resolve it structurally
  // (substituting a symbolic reference against a receiver's own concrete
  // `generic_args`), not just to recognize it as a fixed identity. Set
  // whenever the quirk name is followed by `<...>` at all, symbolic or
  // concrete alike; absent for a bare `as Quirk` with no argument.
  DataType* quirk_arg_dtype;
  flag has_quirk_arg_dtype;
  // Set when this impl targets a concrete instantiation of an
  // already-generic type (`impl Vec<num> { ... }`, `type_name` mangled
  // to `Vec__num`): the full, un-mangled DataType, so codegen can force
  // that type's definition to exist before these methods are emitted.
  // Absent for a plain impl or a generic template impl (`has_type_params`
  // true instead).
  DataType* concrete_dtype;
  flag has_concrete_dtype;
  Vec<Node*> methods;
}

pub fun impl_node_new() ImplNode {
  ImplNode i;
  i.type_name = "";
  i.type_params.init(0);
  i.has_type_params = false;
  i.type_param_forced_insts.init(0);
  i.has_type_param_forced_insts = false;
  i.type_param_constraints.init(0);
  i.has_type_param_constraints = false;
  i.quirk_name = "";
  i.has_quirk_name = false;
  i.quirk_concrete_instantiation = "";
  i.has_quirk_concrete_instantiation = false;
  i.quirk_arg_dtype = nil;
  i.has_quirk_arg_dtype = false;
  i.concrete_dtype = nil;
  i.has_concrete_dtype = false;
  i.methods.init(0);
  ret i;
}

// A `test "name" { body }` declaration (see .Test).
pub compound TestDeclNode {
  str name;
  Node* body;
}

// A `fuzz "name" (raw* data, num len) { body }` declaration (see
// .Fuzz). `data_param`/`len_param` are `Variable` nodes for the
// two user-chosen names; their types parse like ordinary parameters but
// must match the fixed `raw*`/`num` fuzzing shape, enforced by
// `parser._check_fuzz_param_shape`.
pub compound FuzzDeclNode {
  str name;
  Node* data_param;
  Node* len_param;
  Node* body;
}

// One named operand of an `asm` statement's `in`/`out` list: the name
// referenced as `%[name]` in the template, its GCC-style constraint
// string, and the Fun expression it binds to.
pub compound AsmOperand {
  str name;
  str constraint;
  Node* expr;
}

// An `asm` statement (see .StatementAsm). `template` is the raw
// assembly text: a decoded string literal when `is_string_literal`, or
// the exact source bytes between `{`/`}` (including whitespace, newlines,
// and comments) for the block form.
pub compound AsmStmtNode {
  str template;
  flag is_volatile;
  str arch_name;
  flag has_arch;
  Vec<AsmOperand> outputs;
  Vec<AsmOperand> inputs;
  Vec<str> clobbers;
  flag is_string_literal;
}

pub fun asm_stmt_node_new() AsmStmtNode {
  AsmStmtNode a;
  a.template = "";
  a.is_volatile = false;
  a.arch_name = "";
  a.has_arch = false;
  a.outputs.init(0);
  a.inputs.init(0);
  a.clobbers.init(0);
  a.is_string_literal = false;
  ret a;
}

// A tuple value literal (`(1, 2, 3)`), 2+ elements - a single
// parenthesized expression stays `.ExpressionParenthesis`, never this.
pub compound TupleLiteralNode {
  Vec<Node*> elements;
}

pub fun tuple_literal_node_new() TupleLiteralNode {
  TupleLiteralNode t;
  t.elements.init(0);
  ret t;
}

// ===== The node kind itself =====
pub enum NodeKind {
  Expression(ExprNode),
  ExpressionParenthesis(Node*),
  // Reuses TokenData's Num/Dec variants, which already distinguish
  // integer vs decimal literals, exactly what a Number node needs.
  Number(TokenData),
  Identifier(str),
  String(str),
  Character(chr),
  Boolean(flag),
  // The `nil` literal (a null pointer/string sentinel).
  Nil,
  // A `panic(msg)` expression: unifies with whatever type is expected at
  // its use site (like `nil` does for pointers). Never actually produces a
  // value: prints the message and aborts.
  Panic(Node*),
  Variable(VariableNode),
  Function(FunctionNode),
  Body(BodyNode),
  // Absent (nil) for a bare `ret;`.
  StatementReturn(Node*),
  StatementDefer(Node*),
  StatementIf(IfStmtNode),
  StatementElseIf(IfStmtNode),
  // The body of an `else`, a `Node*` (not specifically a `BodyNode`)
  // since, like if/elif, it can be either a `{ ... }` block or a single
  // statement (`else ret 0;`).
  StatementElse(Node*),
  StatementFor(ForKind),
  StatementBreak,
  StatementContinue,
  StatementAssert(AssertNode),
  StatementWarningControl(WarningCtrlNode),
  StatementFit(FitStmtNode),
  // Fire-and-forget virtual-thread spawn (`fork worker(&wg, i);`).
  StatementFork(Node*),
  // Inline assembly (`asm volatile arch x86_64 (out y: "=r" = y; ...) { ... };`).
  StatementAsm(AsmStmtNode),
  Unary(UnaryNode),
  Tenary(TenaryNode),
  Bracket(Node*),
  // `Type{...}` or `.{...}`.
  CompoundInit(CompoundInitNode),
  TupleLiteral(TupleLiteralNode),
  Import(ImportNode),
  Compound(CompoundNode),
  Quirk(QuirkNode),
  Enum(EnumDeclNode),
  Impl(ImplNode),
  TypeAlias(TypeAliasNode),
  // `test "name" { ... }` (top-level only). Skipped entirely by an
  // ordinary compile; only emitted/run in `fun test` mode.
  Test(TestDeclNode),
  // `fuzz "name" (raw* data, num len) { ... }` (top-level only). Skipped
  // entirely by an ordinary compile OR `fun test` mode; only emitted/run
  // in `fun fuzz` mode.
  Fuzz(FuzzDeclNode),
  Blank,
}

// A single AST node: the tagged payload (`kind`) plus source position and
// bookkeeping shared by every node shape.
pub compound Node {
  NodeKind kind;
  Pos pos;
  flag has_pos;
  NodeFlags flags;
  BindedNode* binded;
  flag has_binded;
}

// Names `kind` for a diagnostic, so a rejected node can say what it was.
pub fun node_kind_name(NodeKind kind) str {
  fit kind {
    .Number(_) -> { ret "number"; }
    .String(_) -> { ret "string"; }
    .Character(_) -> { ret "character"; }
    .Boolean(_) -> { ret "boolean"; }
    .Identifier(_) -> { ret "identifier"; }
    .Expression(_) -> { ret "expression"; }
    .ExpressionParenthesis(_) -> { ret "parenthesized expression"; }
    .Unary(_) -> { ret "unary expression"; }
    .Bracket(_) -> { ret "bracket literal"; }
    .CompoundInit(_) -> { ret "compound literal"; }
    .TupleLiteral(_) -> { ret "tuple literal"; }
    .Variable(_) -> { ret "variable declaration"; }
    .Function(_) -> { ret "function"; }
    .Compound(_) -> { ret "compound declaration"; }
    .Enum(_) -> { ret "enum declaration"; }
    .Quirk(_) -> { ret "quirk declaration"; }
    .Impl(_) -> { ret "impl block"; }
    .TypeAlias(_) -> { ret "type alias"; }
    .Import(_) -> { ret "import"; }
    .Test(_) -> { ret "test block"; }
    .StatementWarningControl(_) -> { ret "warning control"; }
    .Body(_) -> { ret "block"; }
    .Blank -> { ret "blank"; }
    _ -> { ret "node"; }
  }
}

pub fun node_new(NodeKind kind) Node {
  Node n;
  n.kind = kind;
  n.has_pos = false;
  n.flags = node_flags_new();
  n.binded = nil;
  n.has_binded = false;
  ret n;
}

// ===== Predicates =====

pub fun node_is_expression_or_parenthesis(Node n) flag {
  fit n.kind {
    .Expression(e) -> { ret true; }
    .ExpressionParenthesis(inner) -> { ret true; }
    _ -> { ret false; }
  }
}

pub fun node_is_value_type(Node n) flag {
  if node_is_expression_or_parenthesis(n) {
    ret true;
  }
  fit n.kind {
    .Identifier(s) -> { ret true; }
    .Number(d) -> { ret true; }
    .Unary(u) -> { ret true; }
    .Tenary(t) -> { ret true; }
    .String(s) -> { ret true; }
    .Character(c) -> { ret true; }
    .CompoundInit(ci) -> { ret true; }
    .TupleLiteral(tl) -> { ret true; }
    _ -> { ret false; }
  }
}

pub fun node_is_expressionable(Node n) flag {
  fit n.kind {
    .Expression(e) -> { ret true; }
    .ExpressionParenthesis(inner) -> { ret true; }
    .Unary(u) -> { ret true; }
    .Identifier(s) -> { ret true; }
    .Number(d) -> { ret true; }
    .String(s) -> { ret true; }
    .Character(c) -> { ret true; }
    .Boolean(b) -> { ret true; }
    // `nil` is a primary value literal: it can be the operand of a binary
    // operator (`x != nil && y`), so it counts as expressionable.
    .Nil -> { ret true; }
    .CompoundInit(ci) -> { ret true; }
    // A bracket literal as one element of an outer array literal (a 2D
    // matrix, e.g.) needs to be a valid left operand for the following
    // ',' to continue chaining the outer literal's remaining elements.
    .Bracket(inner) -> { ret true; }
    .TupleLiteral(tl) -> { ret true; }
    _ -> { ret false; }
  }
}

pub fun node_is_array(Node n) flag {
  fit n.kind {
    .Expression(e) -> { ret is_array_operator(e.op); }
    _ -> { ret false; }
  }
}

pub fun node_is_assignment(Node n) flag {
  fit n.kind {
    .Expression(e) -> {
      ret equals(e.op, "=") || equals(e.op, "+=") || equals(e.op, "-=") ||
        equals(e.op, "*=") || equals(
        e.op,
        "/="
      ) || equals(e.op, "%=") || equals(e.op, "&=") || equals(e.op, "|=") ||
        equals(e.op, "^=") || equals(
        e.op,
        "<<="
      ) || equals(e.op, ">>=");
    }
    _ -> { ret false; }
  }
}

pub fun node_is_expression(Node n, str op) flag {
  fit n.kind {
    .Expression(e) -> { ret equals(e.op, op); }
    _ -> { ret false; }
  }
}

// True for the `[]` index-expression operator, the only shape relevant to
// AST-level array-ness here.
fun is_array_operator(str op) flag {
  ret equals(op, "[]");
}

// ===== Freeing a tree =====
// 
// Only safe on a tree with no aliasing into anything else still alive:
// a document's own `entry_nodes` (an independent parse touching no
// shared import cache) and a `ParseState`'s own scratch `nodes`
// discarded without being handed anywhere else, never the transitively
// merged cross-file program (`ProgramMergeResult.nodes`), whose nodes
// are reached through a shared `ImportCache` and may still be
// referenced by another document's own merge.
// 
// Frees every `Node*`/`DataType*` this tree owns and every `Vec<T>`'s
// own backing storage, but never a `str` field's own character data:
// the parser commonly hands a node a token's own already-owned string
// pointer directly rather than copying it (`token_word`'s own
// contract), so a node's string fields and its source token's string
// data are frequently the same allocation - freeing both would double-
// free. `BindedNode.owner`/`.function` (see `Parser.create_node`) are
// each a separately `malloc`'d shallow copy of whatever enclosing
// body/function node was active at construction time - the copy's own
// `kind` shares every nested `Node*`/`Vec<T>` pointer the real node
// still owns (a shallow struct copy copies the pointer values, not
// what they point to), so only the copy's own outer struct is ever
// freed here, never anything reachable through it.

fun _free_node_vec(Vec<Node*>* v) {
  num i = 0;
  for i < v.len {
    node_free(v.get(i));
    i = i + 1;
  }
  v.free();
}

fun _free_dtype_vec(Vec<DataType*>* v) {
  num i = 0;
  for i < v.len {
    dtype_free(v.get(i));
    i = i + 1;
  }
  v.free();
}

fun _free_str_str_vec(Vec<Vec<str>>* v) {
  num i = 0;
  for i < v.len {
    Vec<str> inner = v.get(i);
    inner.free();
    i = i + 1;
  }
  v.free();
}

pub fun dtype_free(DataType* dt) {
  if dt == nil {
    ret;
  }
  _free_node_vec(&dt.array_brackets);
  _free_dtype_vec(&dt.generic_args);
  _free_dtype_vec(&dt.tuple_members);
  if dt.has_fn_sig && dt.fn_sig != nil {
    _free_dtype_vec(&dt.fn_sig.params);
    if dt.fn_sig.rtype != nil {
      dtype_free(dt.fn_sig.rtype);
    }
    free(dt.fn_sig);
  }
  free(dt);
}

fun _free_if_stmt(IfStmtNode s) {
  node_free(s.condition);
  node_free(s.body);
}

fun _free_fit_branches(Vec<FitBranch>* branches) {
  num i = 0;
  for i < branches.len {
    FitBranch b = branches.get(i);
    if b.has_condition {
      node_free(b.condition);
    }
    node_free(b.body);
    b.bindings.free();
    i = i + 1;
  }
  branches.free();
}

fun _free_asm_operands(Vec<AsmOperand>* ops) {
  num i = 0;
  for i < ops.len {
    AsmOperand o = ops.get(i);
    node_free(o.expr);
    i = i + 1;
  }
  ops.free();
}

fun _free_compound_fields(Vec<CompoundField>* fields) {
  num i = 0;
  for i < fields.len {
    CompoundField f = fields.get(i);
    dtype_free(f.dtype);
    i = i + 1;
  }
  fields.free();
}

fun _free_compound_init_fields(Vec<CompoundInitField>* fields) {
  num i = 0;
  for i < fields.len {
    CompoundInitField f = fields.get(i);
    node_free(f.value);
    i = i + 1;
  }
  fields.free();
}

fun _free_quirk_methods(Vec<QuirkMethodSig>* methods) {
  num i = 0;
  for i < methods.len {
    QuirkMethodSig m = methods.get(i);
    dtype_free(m.rtype);
    num j = 0;
    for j < m.args.len {
      QuirkArg a = m.args.get(j);
      dtype_free(a.dtype);
      j = j + 1;
    }
    m.args.free();
    i = i + 1;
  }
  methods.free();
}

fun _free_enum_variants(Vec<EnumVariant>* variants) {
  num i = 0;
  for i < variants.len {
    EnumVariant v = variants.get(i);
    _free_dtype_vec(&v.payload);
    i = i + 1;
  }
  variants.free();
}

// Frees everything a node owns *through* its fields (recursing into
// child nodes/types), but not the node struct pointed at by `n`
// itself - shared by `node_free` (an individually `malloc`'d child
// node) and `free_node_tree` (a top-level node living inline in a
// `Vec<Node>`'s own backing array, never separately `malloc`'d).
fun _free_node_contents(Node* n) {
  fit n.kind {
    .ExpressionParenthesis(inner) -> { node_free(inner); }
    .Panic(inner) -> { node_free(inner); }
    .Expression(e) -> {
      if e.has_left {
        node_free(e.left);
      }
      if e.has_right {
        node_free(e.right);
      }
      _free_dtype_vec(&e.generic_args);
    }
    .Variable(v) -> {
      dtype_free(v.var_type);
      if v.has_val {
        node_free(v.val);
      }
      v.destructure_names.free();
    }
    .Function(f) -> {
      if f.has_rtype {
        dtype_free(f.rtype);
      }
      f.type_params.free();
      _free_dtype_vec(&f.type_param_defaults);
      _free_str_str_vec(&f.type_param_forced_insts);
      if f.has_args {
        _free_node_vec(&f.args);
      }
      if f.has_body {
        node_free(f.body);
      }
    }
    .Body(b) -> { _free_node_vec(&b.statements); }
    .StatementReturn(inner) -> { node_free(inner); }
    .StatementDefer(inner) -> { node_free(inner); }
    .StatementIf(s) -> { _free_if_stmt(s); }
    .StatementElseIf(s) -> { _free_if_stmt(s); }
    .StatementElse(inner) -> { node_free(inner); }
    .StatementFor(fk) -> {
      fit fk {
        .Cond(c) -> {
          if c.has_condition {
            node_free(c.condition);
          }
          node_free(c.body);
        }
        .Iter(it) -> {
          node_free(it.iterable);
          node_free(it.body);
          it.item_destructure_names.free();
        }
      }
    }
    .StatementAssert(a) -> {
      node_free(a.condition);
      if a.has_message {
        node_free(a.message);
      }
    }
    .StatementFit(f) -> {
      node_free(f.exp);
      _free_fit_branches(&f.branches);
    }
    .StatementFork(inner) -> { node_free(inner); }
    .StatementAsm(a) -> {
      _free_asm_operands(&a.outputs);
      _free_asm_operands(&a.inputs);
      a.clobbers.free();
    }
    .Unary(u) -> {
      node_free(u.operand);
      if u.has_error_arg {
        node_free(u.error_arg);
      }
    }
    .Tenary(t) -> {
      node_free(t.cond);
      node_free(t.then_val);
      node_free(t.else_val);
    }
    .Bracket(inner) -> { node_free(inner); }
    .CompoundInit(ci) -> {
      if ci.has_dtype {
        dtype_free(ci.init_dtype);
      }
      _free_compound_init_fields(&ci.fields);
    }
    .TupleLiteral(tl) -> { _free_node_vec(&tl.elements); }
    .Compound(c) -> {
      _free_compound_fields(&c.fields);
      c.type_params.free();
      _free_dtype_vec(&c.type_param_defaults);
      _free_str_str_vec(&c.type_param_forced_insts);
    }
    .Quirk(q) -> {
      _free_quirk_methods(&q.methods);
      q.type_params.free();
      _free_dtype_vec(&q.type_param_defaults);
    }
    .Enum(e) -> {
      _free_enum_variants(&e.variants);
      e.type_params.free();
      _free_dtype_vec(&e.type_param_defaults);
    }
    .Impl(im) -> {
      im.type_params.free();
      _free_str_str_vec(&im.type_param_forced_insts);
      if im.has_concrete_dtype {
        dtype_free(im.concrete_dtype);
      }
      if im.has_quirk_arg_dtype {
        dtype_free(im.quirk_arg_dtype);
      }
      _free_node_vec(&im.methods);
    }
    .TypeAlias(a) -> {
      a.type_params.free();
      _free_dtype_vec(&a.type_param_defaults);
      a.type_param_is_spread.free();
      if a.is_bound_list {
        a.bound_alternatives.free();
      } else {
        dtype_free(a.body);
      }
    }
    .Test(t) -> { node_free(t.body); }
    .Fuzz(fz) -> {
      node_free(fz.data_param);
      node_free(fz.len_param);
      node_free(fz.body);
    }
    _ -> {}
  }
  if n.has_binded && n.binded != nil {
    if n.binded.has_owner && n.binded.owner != nil {
      free(n.binded.owner);
    }
    if n.binded.has_function && n.binded.function != nil {
      free(n.binded.function);
    }
    free(n.binded);
  }
}

// Frees an individually `malloc`'d child node - every `Node*` field
// throughout this file - contents included.
pub fun node_free(Node* n) {
  if n == nil {
    ret;
  }
  _free_node_contents(n);
  free(n);
}

// Frees a top-level node list a caller owns outright and nothing else
// aliases (a document's own `entry_nodes`, or a `ParseState.nodes`
// discarded without being handed to anything else) - see the file-level
// note above `_free_node_contents` for exactly what "owns outright"
// rules out. Each element lives inline in `nodes`'s own backing array,
// never separately `malloc`'d, so only its contents are freed before
// the whole backing array goes in one call.
pub fun free_node_tree(Vec<Node>* nodes) {
  num i = 0;
  for i < nodes.len {
    Node n = nodes.get(i);
    _free_node_contents(&n);
    i = i + 1;
  }
  nodes.free();
}

// ===== Cloning a tree =====
// 
// A deep, independently-owned copy of a node: every `Node*`/`DataType*`
// it owns is itself cloned (a fresh `malloc`, never the original
// pointer), and every `Vec<T>` gets its own fresh backing array. `str`
// fields are the one exception - copied as plain pointer values, never
// duplicated - which is safe both directions: neither `node_free` nor
// this clone ever frees a node's own string content (see
// `_free_node_contents`'s own note on why), so the clone and the
// original can freely share every string between them regardless of
// which one (or both) eventually gets freed.
// 
// This is what makes a document's own transitively-merged program
// safe to free at all: `_parse_and_merge_source` clones every node it
// pulls from `ImportCache` before handing it to a document's own
// `program.nodes`, so freeing that document's own copy on the next
// edit never touches what `ImportCache` (or another document's own
// merge) still holds.

fun _clone_str_vec(Vec<str>* v) Vec<str> {
  Vec<str> out;
  out.init(v.len);
  num i = 0;
  for i < v.len {
    out.push(v.get(i));
    i = i + 1;
  }
  ret out;
}

fun _clone_flag_vec(Vec<flag>* v) Vec<flag> {
  Vec<flag> out;
  out.init(v.len);
  num i = 0;
  for i < v.len {
    out.push(v.get(i));
    i = i + 1;
  }
  ret out;
}

fun _clone_str_str_vec(Vec<Vec<str>>* v) Vec<Vec<str>> {
  Vec<Vec<str>> out;
  out.init(v.len);
  num i = 0;
  for i < v.len {
    Vec<str> inner = v.get(i);
    out.push(_clone_str_vec(&inner));
    i = i + 1;
  }
  ret out;
}

fun _clone_node_vec(Vec<Node*>* v) Vec<Node*> {
  Vec<Node*> out;
  out.init(v.len);
  num i = 0;
  for i < v.len {
    out.push(node_clone_ptr(v.get(i)));
    i = i + 1;
  }
  ret out;
}

fun _clone_dtype_vec(Vec<DataType*>* v) Vec<DataType*> {
  Vec<DataType*> out;
  out.init(v.len);
  num i = 0;
  for i < v.len {
    out.push(dtype_clone(v.get(i)));
    i = i + 1;
  }
  ret out;
}

pub fun dtype_clone(DataType* dt) DataType* {
  if dt == nil {
    ret nil;
  }
  DataType* c = malloc(sizeof(DataType));
  *c = *dt;
  c.array_brackets = _clone_node_vec(&dt.array_brackets);
  c.generic_args = _clone_dtype_vec(&dt.generic_args);
  c.tuple_members = _clone_dtype_vec(&dt.tuple_members);
  if dt.has_fn_sig && dt.fn_sig != nil {
    FnTypeSig* fs = malloc(sizeof(FnTypeSig));
    fs.params = _clone_dtype_vec(&dt.fn_sig.params);
    fs.rtype = dtype_clone(dt.fn_sig.rtype);
    c.fn_sig = fs;
  }
  ret c;
}

// True for one of C's own reserved words (C89 through C11): a Fun name
// spelled the same way transpiles verbatim into an illegal C declaration.
pub fun is_c_keyword(str name) flag {
  fit name {
    "auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else",
    "enum", "extern", "float", "for", "goto", "if", "int", "long", "register", "return", "short",
    "signed", "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void",
    "volatile", "while", "inline", "restrict", "_Bool", "_Complex", "_Imaginary", "_Alignas",
    "_Alignof", "_Atomic", "_Generic", "_Noreturn", "_Static_assert", "_Thread_local" -> { ret true; }
    _ -> { ret false; }
  }
}

// True for an object-like macro or a type the headers every generated program
// includes (stdio.h, stdlib.h, stdint.h, stdbool.h, stdarg.h, limits.h)
// declare: `NULL`, `EOF`, `bool`, `FILE`, `size_t`, `INT_MAX` and the like. A
// Fun name spelled the same way is rewritten by the preprocessor or clashes
// with the typedef, so the C compiler rejects it far from the real cause.
// Function-like macros (`va_arg`, `va_start`) are left out: the preprocessor
// only expands them before a `(`, so a plain variable of that name is fine.
pub fun is_c_header_name(str name) flag {
  fit name {
    "NULL", "EOF", "BUFSIZ", "FILENAME_MAX", "FOPEN_MAX", "SEEK_SET", "SEEK_CUR", "SEEK_END",
    "TMP_MAX", "L_tmpnam", "stdin", "stdout", "stderr", "FILE", "fpos_t", "size_t", "va_list",
    "bool", "true", "false", "EXIT_SUCCESS",
    "EXIT_FAILURE", "RAND_MAX", "MB_CUR_MAX", "div_t", "ldiv_t", "lldiv_t", "wchar_t",
    "CHAR_BIT", "SCHAR_MIN", "SCHAR_MAX", "UCHAR_MAX", "CHAR_MIN", "CHAR_MAX", "MB_LEN_MAX",
    "SHRT_MIN", "SHRT_MAX", "USHRT_MAX", "INT_MIN", "INT_MAX", "UINT_MAX", "LONG_MIN",
    "LONG_MAX", "ULONG_MAX", "LLONG_MIN", "LLONG_MAX", "ULLONG_MAX", "SIZE_MAX", "INT8_MAX",
    "INT16_MAX", "INT32_MAX", "INT64_MAX", "UINT8_MAX", "UINT16_MAX", "UINT32_MAX",
    "UINT64_MAX", "INT8_MIN", "INT16_MIN", "INT32_MIN", "INT64_MIN", "INTPTR_MAX", "INTPTR_MIN",
    "UINTPTR_MAX", "INTMAX_MAX", "INTMAX_MIN", "UINTMAX_MAX", "int8_t", "int16_t", "int32_t",
    "int64_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t", "intptr_t", "uintptr_t",
    "intmax_t", "uintmax_t" -> { ret true; }
    _ -> { ret false; }
  }
}

// Why `name` cannot be used as a declared name in the generated C, or ""
// when it can: "a reserved word in C" or "declared by the C standard
// headers".
pub fun c_name_collision(str name) str {
  if is_c_keyword(name) {
    ret "a reserved word in C";
  }
  if is_c_header_name(name) {
    ret "declared by the C standard headers";
  }
  ret "";
}

// Replaces every bare occurrence of one of `params` inside `dt` (recursing
// through its generic arguments, tuple members and function signature)
// with a fresh clone of the matching entry of `args`, keeping any pointer
// depth written around it. What a default like `B = A` needs once `A` is
// known. `dt` is edited in place, so it must be a clone the caller owns.
pub fun dtype_substitute_params(DataType* dt, Vec<str>* params, Vec<DataType*>* args) {
  if dt == nil {
    ret;
  }
  num i = 0;
  for i < dt.generic_args.len {
    dtype_substitute_params(dt.generic_args.get(i), params, args);
    i = i + 1;
  }
  num ti = 0;
  for ti < dt.tuple_members.len {
    dtype_substitute_params(dt.tuple_members.get(ti), params, args);
    ti = ti + 1;
  }
  if dt.has_fn_sig && dt.fn_sig != nil {
    num pi = 0;
    for pi < dt.fn_sig.params.len {
      dtype_substitute_params(dt.fn_sig.params.get(pi), params, args);
      pi = pi + 1;
    }
    dtype_substitute_params(dt.fn_sig.rtype, params, args);
  }
  if dt.generic_args.len > 0 || dt.is_tuple || dt.has_fn_sig {
    ret;
  }
  num j = 0;
  for j < params.len && j < args.len {
    if equals(params.get(j), dt.type_str) {
      DataType* sub = dtype_clone(args.get(j));
      sub.pointer_depth = sub.pointer_depth + dt.pointer_depth;
      Vec<DataType*> old_generic = dt.generic_args;
      Vec<DataType*> old_tuple = dt.tuple_members;
      Vec<Node*> old_brackets = dt.array_brackets;
      *dt = *sub;
      free(sub);
      _free_dtype_vec(&old_generic);
      _free_dtype_vec(&old_tuple);
      _free_node_vec(&old_brackets);
      ret;
    }
    j = j + 1;
  }
}

fun _clone_if_stmt(IfStmtNode s) IfStmtNode {
  IfStmtNode c = s;
  c.condition = node_clone_ptr(s.condition);
  c.body = node_clone_ptr(s.body);
  ret c;
}

fun _clone_fit_branches(Vec<FitBranch>* branches) Vec<FitBranch> {
  Vec<FitBranch> out;
  out.init(branches.len);
  num i = 0;
  for i < branches.len {
    FitBranch b = branches.get(i);
    FitBranch c = b;
    if b.has_condition {
      c.condition = node_clone_ptr(b.condition);
    }
    c.body = node_clone_ptr(b.body);
    c.bindings = _clone_str_vec(&b.bindings);
    out.push(c);
    i = i + 1;
  }
  ret out;
}

fun _clone_asm_operands(Vec<AsmOperand>* ops) Vec<AsmOperand> {
  Vec<AsmOperand> out;
  out.init(ops.len);
  num i = 0;
  for i < ops.len {
    AsmOperand o = ops.get(i);
    AsmOperand c = o;
    c.expr = node_clone_ptr(o.expr);
    out.push(c);
    i = i + 1;
  }
  ret out;
}

fun _clone_compound_fields(Vec<CompoundField>* fields) Vec<CompoundField> {
  Vec<CompoundField> out;
  out.init(fields.len);
  num i = 0;
  for i < fields.len {
    CompoundField f = fields.get(i);
    CompoundField c = f;
    c.dtype = dtype_clone(f.dtype);
    out.push(c);
    i = i + 1;
  }
  ret out;
}

fun _clone_compound_init_fields(Vec<CompoundInitField>* fields) Vec<CompoundInitField> {
  Vec<CompoundInitField> out;
  out.init(fields.len);
  num i = 0;
  for i < fields.len {
    CompoundInitField f = fields.get(i);
    CompoundInitField c = f;
    c.value = node_clone_ptr(f.value);
    out.push(c);
    i = i + 1;
  }
  ret out;
}

fun _clone_quirk_methods(Vec<QuirkMethodSig>* methods) Vec<QuirkMethodSig> {
  Vec<QuirkMethodSig> out;
  out.init(methods.len);
  num i = 0;
  for i < methods.len {
    QuirkMethodSig m = methods.get(i);
    QuirkMethodSig c = m;
    c.rtype = dtype_clone(m.rtype);
    Vec<QuirkArg> cargs;
    cargs.init(m.args.len);
    num j = 0;
    for j < m.args.len {
      QuirkArg a = m.args.get(j);
      QuirkArg ca = a;
      ca.dtype = dtype_clone(a.dtype);
      cargs.push(ca);
      j = j + 1;
    }
    c.args = cargs;
    out.push(c);
    i = i + 1;
  }
  ret out;
}

fun _clone_enum_variants(Vec<EnumVariant>* variants) Vec<EnumVariant> {
  Vec<EnumVariant> out;
  out.init(variants.len);
  num i = 0;
  for i < variants.len {
    EnumVariant v = variants.get(i);
    EnumVariant c = v;
    c.payload = _clone_dtype_vec(&v.payload);
    out.push(c);
    i = i + 1;
  }
  ret out;
}

// A deep, independently-owned copy of `n`'s own contents - every
// `Vec<T>`/`Node*`/`DataType*` field freshly built, string fields
// shared with the original (see the file-level note above). `binded`
// is dropped rather than cloned: it's a later pass's own bookkeeping
// (`Parser.create_node`'s own shallow snapshot of enclosing context),
// meaningless once detached into an independently-merged program, and
// its own `owner`/`function` are themselves non-owning references
// `node_free` already treats specially for the same reason.
pub fun node_clone(Node n) Node {
  Node c = n;
  c.has_binded = false;
  c.binded = nil;
  fit n.kind {
    .ExpressionParenthesis(inner) -> {
      c.kind = .ExpressionParenthesis(node_clone_ptr(inner));
    }
    .Panic(inner) -> { c.kind = .Panic(node_clone_ptr(inner)); }
    .Expression(e) -> {
      ExprNode ce = e;
      if e.has_left {
        ce.left = node_clone_ptr(e.left);
      }
      if e.has_right {
        ce.right = node_clone_ptr(e.right);
      }
      ce.generic_args = _clone_dtype_vec(&e.generic_args);
      c.kind = .Expression(ce);
    }
    .Variable(v) -> {
      VariableNode cv = v;
      cv.var_type = dtype_clone(v.var_type);
      if v.has_val {
        cv.val = node_clone_ptr(v.val);
      }
      cv.destructure_names = _clone_str_vec(&v.destructure_names);
      c.kind = .Variable(cv);
    }
    .Function(f) -> {
      FunctionNode cf = f;
      if f.has_rtype {
        cf.rtype = dtype_clone(f.rtype);
      }
      cf.type_params = _clone_str_vec(&f.type_params);
      cf.type_param_defaults = _clone_dtype_vec(&f.type_param_defaults);
      cf.type_param_forced_insts = _clone_str_str_vec(&f.type_param_forced_insts);
      if f.has_args {
        cf.args = _clone_node_vec(&f.args);
      }
      if f.has_body {
        cf.body = node_clone_ptr(f.body);
      }
      c.kind = .Function(cf);
    }
    .Body(b) -> {
      BodyNode cb = b;
      cb.statements = _clone_node_vec(&b.statements);
      c.kind = .Body(cb);
    }
    .StatementReturn(inner) -> { c.kind = .StatementReturn(node_clone_ptr(inner)); }
    .StatementDefer(inner) -> { c.kind = .StatementDefer(node_clone_ptr(inner)); }
    .StatementIf(s) -> { c.kind = .StatementIf(_clone_if_stmt(s)); }
    .StatementElseIf(s) -> { c.kind = .StatementElseIf(_clone_if_stmt(s)); }
    .StatementElse(inner) -> { c.kind = .StatementElse(node_clone_ptr(inner)); }
    .StatementFor(fk) -> {
      fit fk {
        .Cond(cond) -> {
          ForCondNode cc = cond;
          if cond.has_condition {
            cc.condition = node_clone_ptr(cond.condition);
          }
          cc.body = node_clone_ptr(cond.body);
          c.kind = .StatementFor(.Cond(cc));
        }
        .Iter(it) -> {
          ForIterNode ci = it;
          ci.iterable = node_clone_ptr(it.iterable);
          ci.body = node_clone_ptr(it.body);
          ci.item_destructure_names = _clone_str_vec(&it.item_destructure_names);
          c.kind = .StatementFor(.Iter(ci));
        }
      }
    }
    .StatementAssert(a) -> {
      AssertNode ca = a;
      ca.condition = node_clone_ptr(a.condition);
      if a.has_message {
        ca.message = node_clone_ptr(a.message);
      }
      c.kind = .StatementAssert(ca);
    }
    .StatementFit(f) -> {
      FitStmtNode cf = f;
      cf.exp = node_clone_ptr(f.exp);
      cf.branches = _clone_fit_branches(&f.branches);
      c.kind = .StatementFit(cf);
    }
    .StatementFork(inner) -> { c.kind = .StatementFork(node_clone_ptr(inner)); }
    .StatementAsm(a) -> {
      AsmStmtNode ca = a;
      ca.outputs = _clone_asm_operands(&a.outputs);
      ca.inputs = _clone_asm_operands(&a.inputs);
      ca.clobbers = _clone_str_vec(&a.clobbers);
      c.kind = .StatementAsm(ca);
    }
    .Unary(u) -> {
      UnaryNode cu = u;
      cu.operand = node_clone_ptr(u.operand);
      if u.has_error_arg {
        cu.error_arg = node_clone_ptr(u.error_arg);
      }
      c.kind = .Unary(cu);
    }
    .Tenary(t) -> {
      TenaryNode ct = t;
      ct.cond = node_clone_ptr(t.cond);
      ct.then_val = node_clone_ptr(t.then_val);
      ct.else_val = node_clone_ptr(t.else_val);
      c.kind = .Tenary(ct);
    }
    .Bracket(inner) -> { c.kind = .Bracket(node_clone_ptr(inner)); }
    .CompoundInit(ci) -> {
      CompoundInitNode cc = ci;
      if ci.has_dtype {
        cc.init_dtype = dtype_clone(ci.init_dtype);
      }
      cc.fields = _clone_compound_init_fields(&ci.fields);
      c.kind = .CompoundInit(cc);
    }
    .TupleLiteral(tl) -> {
      TupleLiteralNode ctl = tl;
      ctl.elements = _clone_node_vec(&tl.elements);
      c.kind = .TupleLiteral(ctl);
    }
    .Compound(cn) -> {
      CompoundNode cc = cn;
      cc.fields = _clone_compound_fields(&cn.fields);
      cc.type_params = _clone_str_vec(&cn.type_params);
      cc.type_param_defaults = _clone_dtype_vec(&cn.type_param_defaults);
      cc.type_param_forced_insts = _clone_str_str_vec(&cn.type_param_forced_insts);
      c.kind = .Compound(cc);
    }
    .Quirk(q) -> {
      QuirkNode cq = q;
      cq.methods = _clone_quirk_methods(&q.methods);
      cq.type_params = _clone_str_vec(&q.type_params);
      cq.type_param_defaults = _clone_dtype_vec(&q.type_param_defaults);
      c.kind = .Quirk(cq);
    }
    .Enum(e) -> {
      EnumDeclNode ce = e;
      ce.variants = _clone_enum_variants(&e.variants);
      ce.type_params = _clone_str_vec(&e.type_params);
      ce.type_param_defaults = _clone_dtype_vec(&e.type_param_defaults);
      c.kind = .Enum(ce);
    }
    .Impl(im) -> {
      ImplNode ci = im;
      ci.type_params = _clone_str_vec(&im.type_params);
      ci.type_param_forced_insts = _clone_str_str_vec(&im.type_param_forced_insts);
      if im.has_concrete_dtype {
        ci.concrete_dtype = dtype_clone(im.concrete_dtype);
      }
      if im.has_quirk_arg_dtype {
        ci.quirk_arg_dtype = dtype_clone(im.quirk_arg_dtype);
      }
      ci.methods = _clone_node_vec(&im.methods);
      c.kind = .Impl(ci);
    }
    .TypeAlias(a) -> {
      TypeAliasNode ca = a;
      ca.type_params = _clone_str_vec(&a.type_params);
      ca.type_param_defaults = _clone_dtype_vec(&a.type_param_defaults);
      ca.type_param_is_spread = _clone_flag_vec(&a.type_param_is_spread);
      if a.is_bound_list {
        ca.bound_alternatives = _clone_str_vec(&a.bound_alternatives);
      } else {
        ca.body = dtype_clone(a.body);
      }
      c.kind = .TypeAlias(ca);
    }
    .Test(t) -> {
      TestDeclNode ct = t;
      ct.body = node_clone_ptr(t.body);
      c.kind = .Test(ct);
    }
    .Fuzz(fz) -> {
      FuzzDeclNode cf = fz;
      cf.data_param = node_clone_ptr(fz.data_param);
      cf.len_param = node_clone_ptr(fz.len_param);
      cf.body = node_clone_ptr(fz.body);
      c.kind = .Fuzz(cf);
    }
    _ -> {}
  }
  ret c;
}

// Clones an individually `malloc`'d child node; nil in, nil out.
pub fun node_clone_ptr(Node* n) Node* {
  if n == nil {
    ret nil;
  }
  Node* c = malloc(sizeof(Node));
  *c = node_clone(*n);
  ret c;
}

// Clones a top-level node list into a fresh, independently-owned one
// - the counterpart to `free_node_tree`, for handing a shared cache's
// own nodes to a consumer that needs its own exclusively-owned copy
// rather than a borrow.
pub fun clone_node_tree(Vec<Node>* nodes) Vec<Node> {
  Vec<Node> out;
  out.init(nodes.len);
  num i = 0;
  for i < nodes.len {
    out.push(node_clone(nodes.get(i)));
    i = i + 1;
  }
  ret out;
}
