// Which statements count toward code coverage, shared by the code generator
// (which puts a counter in front of each one) and by the report (which needs
// the full list of executable lines, including ones no test ever reached).
// Keeping one definition here is what stops the two from drifting apart.
//
// A line counts when a statement starts on it. `test` and `fuzz` blocks are
// left out: they are the measuring instrument, not the code being measured.

use ast;
use std.io;
use std.string;
use std.vec;
use std.set;
use ..lexer.lexer;
use ..parser.parse_state;
use ..parser.parser;

// True when `stmt` is a statement that gets its own counter. A block, the
// `elif`/`else` continuation of an `if` chain, and a warning-control
// annotation are not statements in their own right: the statements inside a
// block are counted, and the chain is counted once, at its `if`.
pub fun coverage_counts_statement(Node* stmt) flag {
  if stmt == nil || !stmt.has_pos {
    ret false;
  }
  fit stmt.kind {
    .Body(_) -> { ret false; }
    .StatementElseIf(_) -> { ret false; }
    .StatementElse(_) -> { ret false; }
    .StatementWarningControl(_) -> { ret false; }
    .Blank -> { ret false; }
    _ -> { ret true; }
  }
}

// Appends the (file, line) of every counted statement under `stmt`, walking
// into blocks, `if`/`elif`/`else`, loops and `fit` arms. A `defer` counts at
// the line that registers it; what it runs at scope exit is not walked.
pub fun collect_statement_lines(Node* stmt, Vec<str>* files, Vec<num>* lines) {
  if stmt == nil {
    ret;
  }
  if coverage_counts_statement(stmt) {
    files.push(stmt.pos.filename);
    lines.push(stmt.pos.line);
  }
  fit stmt.kind {
    .Body(b) -> {
      for s : b.statements {
        collect_statement_lines(s, files, lines);
      }
    }
    .StatementIf(i) -> { collect_statement_lines(i.body, files, lines); }
    .StatementElseIf(i) -> { collect_statement_lines(i.body, files, lines); }
    .StatementElse(b) -> { collect_statement_lines(b, files, lines); }
    .StatementFor(k) -> {
      fit k {
        .Cond(c) -> { collect_statement_lines(c.body, files, lines); }
        .Iter(i) -> { collect_statement_lines(i.body, files, lines); }
      }
    }
    .StatementFit(f) -> {
      for br : f.branches {
        collect_statement_lines(br.body, files, lines);
      }
    }
    _ -> {}
  }
}

// Appends the counted lines of every function and method body among
// `nodes`, which is one file's own top-level declarations - except a
// function, `impl`, or whole file `allow no_cover` excludes (see
// `collect_no_cover_ranges`'s own note on `Next`/`WholeFile` scope);
// those lines must never reach the denominator at all, not just be
// left uncounted when hit, or they'd report as uncovered instead of
// not measured.
pub fun collect_program_lines(Vec<Node>* nodes, Vec<str>* files, Vec<num>* lines) {
  Set<str> whole_file = set_init("", 4);
  defer whole_file.free();
  flag pending_next = false;

  for n : nodes {
    fit n.kind {
      .StatementWarningControl(wc) -> {
        if wc.action == .Allow && wc.id == .NoCover && n.has_pos {
          fit wc.scope {
            .Next -> { pending_next = true; }
            .WholeFile -> { whole_file.add(n.pos.filename); }
          }
        }
      }
      .Function(f) -> {
        flag excluded = pending_next ||
          (n.has_pos && whole_file.has(n.pos.filename));
        pending_next = false;
        if f.has_body && !excluded {
          collect_statement_lines(f.body, files, lines);
        }
      }
      .Impl(i) -> {
        flag excluded = pending_next ||
          (n.has_pos && whole_file.has(n.pos.filename));
        pending_next = false;
        for m : i.methods {
          fit m.kind {
            .Function(mf) -> {
              if mf.has_body && !excluded {
                collect_statement_lines(mf.body, files, lines);
              }
            }
            _ -> {}
          }
        }
      }
      _ -> {}
    }
  }
}

// `filename` as it is shown in a report: forward slashes, no leading `./`,
// and relative to `pwd` when it sits under it, so the same file has the same
// name whether the compiler reached it by a relative or an absolute path.
pub fun cover_display_path(str filename, str pwd) str {
  str slashed = replace_char(filename, '\\', '/');
  str path = slashed;
  if starts_with(path, "./") {
    path = substr(path, 2, len(path) - 2);
  }
  if !equals(pwd, "") {
    str prefix = format("{str}/", replace_char(pwd, '\\', '/'));
    if starts_with(path, prefix) {
      path = substr(path, len(prefix), len(path) - len(prefix));
    }
  }
  ret path;
}

// `text` as the inside of a C string literal.
pub fun c_string_escape(str text) str {
  StringBuilder sb = string_builder_init(len(text) + 8);
  num i = 0;
  for i < len(text) {
    chr c = text[i];
    if c == '\\' {
      sb.append("\\\\");
    } elif c == '"' {
      sb.append("\\\"");
    } elif c == '\n' {
      sb.append("\\n");
    } else {
      sb.append_char(c);
    }
    i = i + 1;
  }
  ret sb.build();
}

// True when the file at report path `path` is project code worth measuring:
// under the current directory (not an absolute path or one climbing out of
// it, which is how the standard library and dependencies are reached), and
// not a test fixture or build output.
pub fun cover_is_measured(str path) flag {
  if len(path) == 0 || path[0] == '/' || starts_with(path, "..") {
    ret false;
  }
  if len(path) > 1 && path[1] == ':' {
    ret false;
  }
  Vec<str> parts = split(path, '/');
  defer parts.free();
  num i = 0;
  for i + 1 < parts.len {
    str part = parts.get(i);
    if equals(part, "fixtures") || ends_with(part, "_fixtures") || equals(part, "fun-out") {
      ret false;
    }
    i = i + 1;
  }
  ret true;
}

// Records where each `test` and `fuzz` block among `nodes` sits: its file and
// the first and last line a statement of it starts on. Statements inside such
// a range belong to the measuring instrument and are not counted, even when
// they are emitted late, as part of a generic function a test happened to
// instantiate.
pub fun collect_test_ranges(
  Vec<Node>* nodes,
  Vec<str>* files,
  Vec<num>* from,
  Vec<num>* to
) {
  for n : nodes {
    Node* body = nil;
    fit n.kind {
      .Test(t) -> { body = t.body; }
      .Fuzz(f) -> { body = f.body; }
      _ -> {}
    }
    if body == nil || !n.has_pos {
      continue;
    }
    Vec<str> body_files;
    body_files.init(8);
    Vec<num> body_lines;
    body_lines.init(8);
    collect_statement_lines(body, &body_files, &body_lines);
    num last = n.pos.line;
    for bl : body_lines {
      if bl > last {
        last = bl;
      }
    }
    files.push(n.pos.filename);
    from.push(n.pos.line);
    to.push(last);
    body_files.free();
    body_lines.free();
  }
}

// Parses `src` into its own top-level nodes, asserting it compiles -
// shared by the `collect_no_cover_ranges`/`collect_program_lines`
// tests below, both of which need a real `Vec<Node>` to walk rather
// than a hand-built one.
fun _parsed_nodes(str src) Vec<Node> {
  let tokens = tokenize(src, "t.fn");
  assert !tokens.is_err(), "expected the source to lex";
  ParseState state = parse_state_new("t.fn", src);
  state.tokens = tokens.unwrap();
  state.emit_stderr = false;
  Parser p = parser_new(&state);
  assert p.parse().is_none(), "expected the source to parse";
  ret state.nodes;
}

test "collect_program_lines leaves out a function allow no_cover excludes, but still counts another" {
  Vec<Node> nodes = _parsed_nodes(
    `allow no_cover, "deliberately untestable";
    `fun skipped() num {
    `  ret 1;
    `}
    `fun kept() num {
    `  ret 2;
    `}`
  );
  Vec<str> files;
  files.init(8);
  Vec<num> lines;
  lines.init(8);
  collect_program_lines(&nodes, &files, &lines);
  assert lines.len == 1, format(
    "expected only kept()'s own statement declared, got {num}",
    lines.len
  );
}

test "collect_program_lines leaves out every function in a file allow no_covers (plural) excludes" {
  Vec<Node> nodes = _parsed_nodes(
    `allow no_covers, "deliberately untestable, whole file";
    `fun a() num {
    `  ret 1;
    `}
    `fun b() num {
    `  ret 2;
    `}`
  );
  Vec<str> files;
  files.init(8);
  Vec<num> lines;
  lines.init(8);
  collect_program_lines(&nodes, &files, &lines);
  assert lines.len == 0, format(
    "expected no lines declared for a whole-file exclusion, got {num}",
    lines.len
  );
}

test "collect_no_cover_ranges records only the one function its own directive covers" {
  Vec<Node> nodes = _parsed_nodes(
    `allow no_cover, "deliberately untestable";
    `fun skipped() num {
    `  ret 1;
    `}
    `fun kept() num {
    `  ret 2;
    `}`
  );
  // Ground truth for each function's own statement line, independent
  // of this test's own exact source layout.
  Vec<str> all_files;
  all_files.init(8);
  Vec<num> all_lines;
  all_lines.init(8);
  collect_program_lines(&nodes, &all_files, &all_lines);
  assert all_lines.len == 1, "expected kept()'s own line as ground truth";
  num kept_line = all_lines.get(0);

  Vec<str> skip_files;
  skip_files.init(4);
  Vec<num> skip_from;
  skip_from.init(4);
  Vec<num> skip_to;
  skip_to.init(4);
  collect_no_cover_ranges(&nodes, &skip_files, &skip_from, &skip_to);
  assert skip_files.len == 1, format(
    "expected exactly one no_cover range, got {num}",
    skip_files.len
  );
  assert !in_test_range("t.fn", kept_line, &skip_files, &skip_from, &skip_to), "expected kept()'s own line to fall outside the recorded range";
}

// True when a statement at `line` of `filename` sits inside one of the
// ranges `collect_test_ranges` recorded.
pub fun in_test_range(
  str filename,
  num line,
  Vec<str>* files,
  Vec<num>* from,
  Vec<num>* to
) flag {
  num i = 0;
  for i < files.len {
    if line >= from.get(i) && line <= to.get(i) && equals(files.get(i), filename) {
      ret true;
    }
    i = i + 1;
  }
  ret false;
}

// A function or method's own `(file, from, to)` range, the same shape
// `collect_test_ranges` records for a test/fuzz body - shared by
// `collect_no_cover_ranges` below for both a free function and a
// method found inside an `impl`'s own method list.
fun _record_no_cover_range(
  Node* decl,
  Node* body,
  Vec<str>* files,
  Vec<num>* from,
  Vec<num>* to
) {
  Vec<str> body_files;
  body_files.init(8);
  Vec<num> body_lines;
  body_lines.init(8);
  collect_statement_lines(body, &body_files, &body_lines);
  num last = decl.pos.line;
  for bl : body_lines {
    if bl > last {
      last = bl;
    }
  }
  files.push(decl.pos.filename);
  from.push(decl.pos.line);
  to.push(last);
  body_files.free();
  body_lines.free();
}

// Records where `allow no_cover`/`allow no_covers` (see
// `WarningId.NoCover`) excludes a function, a whole `impl`'s worth of
// methods, or a whole file from coverage - appended to the same
// `(files, from, to)` triple `collect_test_ranges` already fills, so a
// single `in_test_range` check (despite its name) covers both kinds of
// exclusion with no caller-side change.
//
// `Next` scope applies to the very next `.Function`/`.Impl` among
// `nodes` - skipping over anything else in between (a compound, an
// enum, ...) rather than resetting on it, since those aren't a
// sensible target for the directive anyway. `WholeFile` scope applies
// to every function/method whose own position names that same file,
// wherever in `nodes` it falls - needed because `nodes` here may be a
// whole merged, multi-file program, not just one file's own
// declarations, so "the rest of this list" would reach into a
// different file entirely.
pub fun collect_no_cover_ranges(
  Vec<Node>* nodes,
  Vec<str>* files,
  Vec<num>* from,
  Vec<num>* to
) {
  Set<str> whole_file = set_init("", 4);
  defer whole_file.free();
  flag pending_next = false;

  for n : nodes {
    fit n.kind {
      .StatementWarningControl(wc) -> {
        if wc.action == .Allow && wc.id == .NoCover && n.has_pos {
          fit wc.scope {
            .Next -> { pending_next = true; }
            .WholeFile -> { whole_file.add(n.pos.filename); }
          }
        }
      }
      .Function(f) -> {
        flag applies = pending_next || (n.has_pos && whole_file.has(n.pos.filename));
        pending_next = false;
        if f.has_body && applies {
          _record_no_cover_range(&n, f.body, files, from, to);
        }
      }
      .Impl(i) -> {
        flag applies = pending_next || (n.has_pos && whole_file.has(n.pos.filename));
        pending_next = false;
        if applies {
          for m : i.methods {
            fit m.kind {
              .Function(mf) -> {
                if mf.has_body {
                  _record_no_cover_range(m, mf.body, files, from, to);
                }
              }
              _ -> {}
            }
          }
        }
      }
      _ -> {}
    }
  }
}
