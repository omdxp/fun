    `#include <io.h>
    `#ifdef _MSC_VER
    `#pragma comment(lib, "Ws2_32.lib")
    `#endif
    `#ifndef __fun_win_close_defined
    `#define __fun_win_close_defined
    `static inline long long __fun_win_close(long long fd) { if (_close((int)fd) == 0) return 0LL; return closesocket((SOCKET)(uintptr_t)fd) == 0 ? 0LL : -1LL; }
    `#endif
    `#ifndef close
    `#define close __fun_win_close
    `#endif
    `#else
    `#include <sys/socket.h>
    `#include <netinet/in.h>
    `#include <arpa/inet.h>
    `#include <unistd.h>
    `#endif
    `typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
    `static __fun_wd_state __fun_g_wd;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `static void* __fun_wd_thread(void* unused){ (void)unused;
    `  long long last_seq=-1; long long stall_ms=0;
    `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
    `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_wd.threshold_ms){
    `      __fun_wd_warn((long long)blk, 0, stall_ms);
    `      if(__fun_g_wd.abort_on_fire) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `void __fun_wd_enter_wait(void){
    `  if(!__fun_g_wd.started){
    `    __fun_g_wd.started=1;
    `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm=(w && w[0])?atoll(w):0;
    `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
    `    const char* a=getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
    `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
    `  }
    `  if(!__fun_g_wd.armed) return;
    `  __fun_g_wd.blocked++;
    `}
    `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `    int64_t Box__num__get(Box__num* self);
    `int64_t Box__num__get(Box__num* self) {
    `    return self->value;
    `}
    `int main(int argc, char** argv) {
    `    Box__num b;
    `    Box__num__get(&b);
    `}
    ``
  ), "expected the struct typedef AND the monomorphized method's DEFINITION (lazily triggered by the call inside main's own body) BEFORE 'main', not nested inside its braces. Its bare PROTOTYPE now splices to the same file-scope position, visible from every call site in the whole function rather than just the block that happened to trigger it first. Also expects `main`'s own C signature forced to the real entry-point shape (`int main(int argc, char** argv)`), not its naive Fun-level `num`-returning, no-arg signature";
}

test "ensure_compound_instantiated rejects an unrecognized generic template name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Unrecognized";
  dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_some(), "expected an unrecognized generic template name to be rejected rather than guessed";
}

test "ensure_compound_instantiated rejects a wrong generic argument count" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* str_arg = malloc(sizeof(DataType));
  *str_arg = dtype_new();
  str_arg.type_str = "str";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(num_arg);
  dt.generic_args.push(str_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Box (one type param) instantiated with two arguments to be rejected";
}

test "ensure_compound_instantiated rejects a nested generic argument whose OWN template isn't registered" {
  // Nested generic arguments do resolve, as the test below covers; this
  // one checks that the argument is still rejected when the nested type
  // is unresolvable, `Vec` never having been registered as a template.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_vec = malloc(sizeof(DataType));
  *inner_vec = dtype_new();
  inner_vec.type_str = "Vec";
  inner_vec.generic_args.push(num_arg);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(inner_vec);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Box<Vec<num>> rejected because 'Vec' itself was never registered as a template, not because nesting itself is unsupported";
}

test "ensure_compound_instantiated instantiates a nested generic argument (Box<Box<num>>)" {
  // `Result<Option<Token>, Error>` has a generic argument that is itself
  // a generic instantiation. The nested argument resolves (and, on first
  // use, emits) first, its mangled name becoming the outer
  // instantiation's arg name; this recurses to arbitrary depth.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_box = malloc(sizeof(DataType));
  *inner_box = dtype_new();
  inner_box.type_str = "Box";
  inner_box.generic_args.push(num_arg);
  DataType* outer_dt = malloc(sizeof(DataType));
  *outer_dt = dtype_new();
  outer_dt.type_str = "Box";
  outer_dt.generic_args.push(inner_box);
  VariableNode v;
  v.var_type = outer_dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_none(), "expected Box<Box<num>> to instantiate, resolving the nested Box<num> first";
  let out = st.out.build();
  assert contains(out, "typedef struct Box__num {\n  int64_t value;\n} Box__num;"), "expected the INNER instantiation (Box__num) emitted";
  assert contains(out, "typedef struct Box__Box__num {\n  Box__num value;\n} Box__Box__num;"), "expected the OUTER instantiation (Box__Box__num) using the inner's own mangled name as its field type";
  assert contains(out, "Box__Box__num x;"), "expected the declaration itself to use the outer mangled name";
}

test "ensure_compound_instantiated mangles a pointer-typed generic argument distinctly" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* node_ptr_arg = malloc(sizeof(DataType));
  *node_ptr_arg = dtype_new();
  node_ptr_arg.type_str = "Node";
  node_ptr_arg.pointer_depth = 1;
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(node_ptr_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "b";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_none(), "expected Box<Node*> to instantiate";
  assert equals(
    st.out.build(),
    `typedef struct Box__Node_ptr1 {
    `  Node* value;
    `} Box__Node_ptr1;
    `
    `Box__Node_ptr1 b;
    ``
  ), "expected the mangled name to include the pointer depth, and the field itself to be a pointer";
}

test "emit_statement instantiates a generic tagged-union enum on first use" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  Node n = _opt_num_var_decl("o");
  assert g.emit_statement(n).is_none(), "expected the Opt<num> declaration to emit";
  assert equals(
    st.out.build(),
    `typedef enum Opt__num_tag {
    `  Opt__num_Some,
    `  Opt__num_None,
    `} Opt__num_tag;
    `typedef struct Opt__num {
    `  Opt__num_tag tag;
    `  union {
    `    struct { int64_t _0; } Some;
    `  } payload;
    `} Opt__num;
    `
    `Opt__num o;
    ``
  ), "expected the monomorphized tagged-union emitted once, then the declaration using its mangled name";
}

test "emit_statement does not re-emit an already-instantiated generic enum" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  Node n1 = _opt_num_var_decl("o1");
  Node n2 = _opt_num_var_decl("o2");
  assert g.emit_statement(n1).is_none(), "expected the first Opt<num> declaration to emit";
  assert g.emit_statement(n2).is_none(), "expected the second Opt<num> declaration to emit";
  let out = st.out.build();
  assert count(out, "typedef struct Opt__num {") == 1, "expected the tagged-union struct typedef only once, even though Opt<num> is used twice";
}

test "fit destructures a bare-shorthand pattern against a monomorphized generic enum local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  Node decl = _opt_num_var_decl("o");
  assert g.emit_statement(decl).is_none(), "expected the Opt<num> declaration to emit";

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(.Identifier("Some"));
  ExprNode dot = expr_node_new();
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(.Expression(dot));

  Node* ret_r = malloc(sizeof(Node));
  *ret_r = node_new(.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_r);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;
  br.bindings.push("v");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  Node* o_ident = malloc(sizeof(Node));
  *o_ident = node_new(.Identifier("o"));
  f.exp = o_ident;
  f.branches.push(br);

  Node fit_n = node_new(.StatementFit(f));
  assert g.emit_statement(fit_n).is_none(), "expected the bare-shorthand destructuring fit to emit against the monomorphized Opt__num local";
  let out = st.out.build();
  assert contains(out, "if (o.tag == Opt__num_Some) {"), "expected the tag check to use the MANGLED enum name, resolved via the local's own registered (mangled) type";
  assert contains(out, "__auto_type v = o.payload.Some._0;"), "expected the payload binding to resolve too";
  assert equals(g.lookup_local_type_name("v").unwrap(), "num"), "expected 'v' registered as a known local (type 'num', Opt<num>'s own payload type) so further access on it inside the branch -- a chained field access, another fit, a method call -- still resolves, not just usable as a bare value";
}

test "ensure_enum_instantiated rejects an unrecognized generic template name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Unrecognized";
  dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_some(), "expected an unrecognized generic enum template name to be rejected rather than guessed";
}

test "ensure_enum_instantiated rejects a wrong generic argument count" {
