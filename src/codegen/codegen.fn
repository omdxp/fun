// Transpiles a Fun AST into C source. Generic compounds, enums, impl
// methods, and functions are monomorphized lazily on first concrete use,
// with a body-triggered definition spliced in before the enclosing
// top-level item rather than left nested inside it (see
// `Codegen.hoist_insert_pos`/`emit_hoisted`). There is no standalone
// type-checker: declared types are taken at face value, and an untyped
// `let` binding relies on the C compiler's own `__auto_type` inference.

imp codegen_state;
imp typedefs;
imp host_arch;
imp ..ast.ast;
imp ..lexer.token;
imp ..parser.datatype_defs;
imp std.string;
imp std.option;
imp std.io;

pub enum CodegenErrorKind {
  UnsupportedNode,
  InvalidNode,
}

// A multi-dimensional array's root name and index depth; see
// `lookup_local_multidim`.
compound MultidimInfo {
  str root;
  num depth;
}

// An array literal's element type and nesting depth; see
// `infer_array_literal_elem_type_and_depth`.
compound ArrayLiteralElemInfo {
  str type_name;
  num depth;
}

// A resolved compound field's declared type name and pointer-ness.
// `dtype` optionally carries the field's full declared `DataType`,
// generic args intact, when the recording call site had one on hand.
compound FieldTypeInfo {
  str type_name;
  bin is_pointer;
  Option<DataType> dtype;
}

// Like `FieldTypeInfo`, plus the resolved C text. Used where a receiver's
// text needs to be computed once but written multiple times, such as a
// `fit` subject shared across several branches.
compound ChainResolution {
  str text;
  str type_name;
  bin is_pointer;
  Option<DataType> dtype;
  // Set when `text` is a call's own rendered result (an rvalue) rather
  // than an addressable lvalue. A caller that needs `&text` must hoist
  // it into a temp first.
  bin is_call_result;
}

// Which mangled `to_string` function to call for a `Display` argument in
// a `format`/`println_fmt` `{}` placeholder, and whether it needs `&`
// first.
compound DisplayResolution {
  str fn_name;
  bin pass_by_ref;
}

// A monomorphized generic function call: its mangled name, plus each
// parameter's declared type already substituted against this call's
// concrete arguments.
compound GenericCallResolution {
  str mangled_name;
  Vec<DataType> param_types;
  // The return type, substituted the same way. Kept separately since it
  // can't be recovered once the substitution context is torn down.
  DataType rtype;
}

// Result of `maybe_instantiate_generic_impl_method_own_params`: mangled
// name plus substituted return type, for the same reason as
// `GenericCallResolution.rtype`.
compound OwnParamCallResolution {
  str mangled_name;
  DataType rtype;
}

// One variant's shape within a generic enum template: its name, whether
// it carries a payload, and each payload position's declared type before
// substitution.
compound GenericEnumVariantTemplate {
  str name;
  bin has_payload;
  Vec<str> payload_type_strs;
  Vec<bin> payload_is_pointer;
}

// Where `fn_proto_splice_pos` chose to splice a lazily-triggered
// prototype, and whether that position is visible to every later call
// site in the file (the enclosing function's own start, or earlier) as
// opposed to only the one statement that triggered it. A caller must
// not skip re-emitting for a future call site on the strength of a
// `broad == false` splice: nothing outside that one statement's own
// block can see it, and C would warn `-Wout-of-scope-function` on
// every later use that relied on it anyway.
compound ProtoSplice {
  Option<num> pos;
  bin broad;
}

pub compound Codegen {
  CodegenState* state;
  // Local names seen so far in the current function (reset per
  // `emit_function`), with pointer-ness and declared type name: enough to
  // decide `.`/`->` for a field access and build a method call's mangled
  // name without a real type-inference engine.
  Vec<str> local_names;
  Vec<bin> local_is_pointer;
  Vec<str> local_type_name;
  // A local's full structured type, when known (`record_local_typed`);
  // `.None` for a local recorded without one (`record_local`). Lets a
  // caller read a generic argument's structure instead of
  // reverse-engineering it from a mangled name.
  Vec<Option<DataType>> local_dtype;
  // Sparse record of a multi-dimensional array's iteration variable,
  // mapping it back to the root array name and how many `[0]` levels
  // separate it. A nested loop's length bound can't be computed from the
  // (possibly pointer-decayed) loop variable itself, only by re-indexing
  // the root array. Reset between top-level functions.
  Vec<str> local_multidim_names;
  Vec<str> local_multidim_roots;
  Vec<num> local_multidim_depths;
  // Every non-generic enum's name, variant names, and whether it's a
  // tagged union, so a qualified enum-variant access resolves without a
  // real type-inference engine.
  Vec<str> enum_names;
  Vec<Vec<str>> enum_variant_names;
  Vec<bin> enum_is_tagged_union;
  // A tagged-union enum's per-variant payload field types, so a `fit`
  // destructuring binding is registered as a known local and further
  // access on it (a field, another `fit`, a method call) resolves.
  Vec<str> enum_variant_payload_owner;
  Vec<str> enum_variant_payload_variant;
  Vec<Vec<str>> enum_variant_payload_type_names;
  Vec<Vec<bin>> enum_variant_payload_is_pointer;
  Vec<Vec<Option<DataType>>> enum_variant_payload_dtype;
  // The current function's declared return type name, refreshed at the
  // start of every `emit_function`; feeds `expected_enum_type` for a
  // bare-shorthand `ret`.
  str current_fn_rtype_name;
  // The current function's return type as a full substituted `DataType`.
  // Lets `maybe_instantiate_generic_function` fall back to inferring a
  // type param from the enclosing function's own return type when it
  // can't be read off the call's arguments.
  Option<DataType> current_fn_rtype_dt;
  // The enum a bare `.Variant`/`.Variant(x)` shorthand resolves against,
  // standing in for "the expected type from context." Empty when nothing
  // in the enclosing statement provides one; scoped to the statement's
  // own value so it can't leak into an unrelated shorthand.
  str expected_enum_type;
  // Same idea as `expected_enum_type`, for a bare `.{ field = value }`
  // compound-literal shorthand.
  str expected_compound_type;
  // True while emitting a context where a bare `{...}` brace-list is the
  // correct form for an array literal: an array variable's initializer, a
  // nested row, or a compound-init field value. When false, a bare array
  // literal is rejected outright rather than emitting invalid C.
  bin in_array_initializer;
  // Names of every quirk with at least one concrete (non-generic) impl
  // emitted so far, used to recognize a receiver/declared type as a
  // quirk (dispatched through a vtable) rather than a concrete compound.
  // A generic quirk impl never adds its name here: dynamic dispatch
  // through an unbound type param has no single C vtable signature.
  Vec<str> quirk_names;
  // Keys (`<type_name>::<quirk_name>`) of every concrete quirk impl
  // whose vtable machinery has already run, so a plain compound with a
  // quirk-typed field can trigger it early without the normal pass
  // re-emitting it later.
  Vec<str> emitted_quirk_impl_vtables;
  // Every generic quirk's declaration, registered up front so a concrete
  // instantiation's vtable can be derived structurally even when no impl
  // of it exists in the translation unit. A non-generic quirk's vtable is
  // instead derived from its first concrete impl.
  Vec<str> quirk_decl_names;
  Vec<Vec<str>> quirk_decl_type_params;
  Vec<Vec<QuirkMethodSig>> quirk_decl_methods;
  // Every import alias name seen across the transitive import graph, set
  // by the caller right after `codegen_new`. Consulted wherever a
  // `y.symbol` reference could be misread as a receiver or type; each
  // site strips the alias prefix and resolves the rest unqualified.
  Vec<str> import_aliases;
  // Exception to the rule above: `<alias>::<bare_name>` -> the real
  // mangled name, for a function renamed at merge time because it
  // collided with a differently aliased import. Checked by
  // `lookup_alias_rename` before the plain unqualified name.
  Vec<str> alias_rename_keys;
  Vec<str> alias_rename_targets;
  // Every pending `defer` body in scope for the function being emitted,
  // in source order, plus frame markers (an index into `defer_stack`
  // where each block's defers begin). A deferred body is replicated as
  // ordinary statements at each early exit; the pop happens once, when
  // the owning block finishes.
  Vec<Node*> defer_stack;
  Vec<num> defer_scope_starts;
  // `defer_stack.len` at the start of the innermost enclosing loop's own
  // body, one entry pushed per nesting level of `for`. `break`/`continue`
  // read the top entry to replay every defer registered since that loop
  // began (which can span several nested block scopes, e.g. an `if`
  // inside the loop) without also replaying a defer from further out.
  Vec<num> loop_defer_marks;
  // Every non-generic compound's name and its fields' declared types, so
  // a chained field access can determine `.`/`->` at each link.
  Vec<str> compound_names;
  Vec<Vec<str>> compound_field_names;
  Vec<Vec<str>> compound_field_type_names;
  Vec<Vec<bin>> compound_field_is_pointer;
  // Each field's full, un-mangled declared type, when known.
  Vec<Vec<Option<DataType>>> compound_field_dtype;
  // Every impl method's owning type, bare name, and fully mangled
  // call-site name. A plain impl's method mangles to `Type__method`; a
  // quirk-implementing impl's mangles to `Type__Quirk__method`.
  Vec<str> impl_method_owner_type;
  Vec<str> impl_method_bare_name;
  Vec<str> impl_method_mangled_name;
  // Each method's declared return type, parallel to the three arrays
  // above. Populated only for a plain (non-generic) impl's methods.
  Vec<DataType*> impl_method_rtype;
  // Each method's declared parameter types, excluding the implicit
  // `self`, parallel to the arrays above.
  Vec<Vec<DataType*>> impl_method_param_types;
  // Each impl method's trailing default parameter values, parallel to
  // `impl_method_param_types`; `nil` for a parameter with no default.
  // Defaults are evaluated fresh at each call site.
  Vec<Vec<Node*>> impl_method_default_values;
  // Every plain top-level function's name and declared parameter types,
  // so a bare enum-variant shorthand passed as a call argument resolves
  // against the callee's own declared parameter type.
  Vec<str> function_names;
  Vec<Vec<DataType*>> function_param_types;
  // Each plain top-level function's trailing default parameter values,
  // parallel to `function_param_types`/`function_names`.
  Vec<Vec<Node*>> function_default_values;
  // Whether each registered plain function is variadic, parallel to
  // `function_names`.
  Vec<bin> function_is_variadic;
  // Each function's declared return type, parallel to `function_names`.
  Vec<DataType*> function_rtypes;
  // Every generic top-level function, recorded whole rather than
  // registered into `function_names`; monomorphized lazily from its call
  // site.
  Vec<Node> generic_function_templates;
  // A generic compound template: its name, type-param names, and each
  // field's declared type before substitution. A template is never
  // emitted directly, only a concrete monomorphization of it.
  Vec<str> generic_compound_names;
  Vec<Vec<str>> generic_compound_type_params;
  Vec<Vec<str>> generic_compound_field_names;
  Vec<Vec<str>> generic_compound_field_type_names;
  Vec<Vec<bin>> generic_compound_field_is_pointer;
  // Each field's full pre-substitution type, generic arguments included,
  // so a field whose own type is itself a nested generic instantiation
  // can be substituted correctly.
  Vec<Vec<DataType*>> generic_compound_field_dtypes;
  // A generic enum template: its name, type-param names, and each
  // variant's shape before substitution.
  Vec<str> generic_enum_names;
  Vec<Vec<str>> generic_enum_type_params;
  Vec<Vec<GenericEnumVariantTemplate>> generic_enum_variants;
  // Mangled names already monomorphized, so instantiating the same
  // concrete type arguments twice doesn't emit a duplicate C typedef.
  // Shared across compound and enum instantiations, whose mangled names
  // are drawn from the same namespace.
  Vec<str> emitted_generic_instantiations;
  // Every plain (non-generic) compound/enum name already emitted, the
  // dedup bookkeeping `emitted_generic_instantiations` gives generics.
  // Pushed when emission starts, not after it finishes, so a repeat
  // reference (a diamond, not a cycle: two unrelated types both embedding
  // a third by value) resolves without redoing the work.
  Vec<str> emitted_plain_types;
  // The plain types currently mid-emission, on the active
  // `ensure_plain_type_emitted` recursion path: a name found in here
  // again is a genuine cycle (a compound transitively embedding itself
  // by value), not just a repeat reference, and gets reported instead of
  // recursing forever.
  Vec<str> plain_type_in_progress;
  // The program's flattened top-level node list, stashed once at the
  // start of `pub transpile` so `ensure_plain_type_emitted` and similar
  // lookups can find a plain type by name without `nodes` threaded
  // through every call in between.
  Vec<Node> all_nodes;
  // Every generic impl block, recorded whole by `register_impl_methods`
  // without emitting any C. Monomorphized lazily by
  // `maybe_instantiate_generic_impl_methods`, on first concrete use.
  Vec<Node> generic_impl_templates;
  // One entry per concrete generic compound/enum instantiation: its
  // mangled name, template base name, and the substitution context (arg
  // type names, pointer-ness, structural dtypes) active when it was
  // instantiated. Lets `ensure_generic_impl_method_emitted` re-establish
  // that context later, when a method is first called, instead of
  // monomorphizing every method eagerly at instantiation.
  Vec<str> instantiation_mangled_name;
  Vec<str> instantiation_base_name;
  Vec<Vec<str>> instantiation_arg_type_names;
  Vec<Vec<bin>> instantiation_arg_is_pointer;
  Vec<Vec<DataType*>> instantiation_arg_dtypes;
  // Every generic impl method emitted (or enqueued, see
  // `pending_generic_impl_method_owner`) so far, keyed
  // `"<mangled_name>::<quirk_name>::<bare_method_name>"` (`<quirk_name>`
  // empty for a plain impl method). The quirk segment matters: a type
  // can define a plain method and a same-named quirk method side by
  // side (`Vec<T>`'s own `clear()` next to its `Clearable` quirk's
  // `clear()`), and without it the second lookup would see the first
  // one's key and wrongly skip emitting its own definition.
  Vec<str> emitted_generic_impl_methods;
  // Emitted monomorphizations of a method that declares its own generic
  // type params on top of the impl's (`impl Box<T> { pub wrap<U>(U x)
  // Box<U> { ... } }`), keyed by the combined mangled name
  // (`Box__num__wrap__str`). A separate dimension from
  // `emitted_generic_impl_methods`, which is keyed by owner and bare name.
  Vec<str> emitted_method_own_param_insts;
  // Every plain (non-generic) impl method that already got its own
  // inline forward-declared prototype from
  // `ensure_plain_impl_method_prototype_emitted`, keyed
  // `"<owner_type>::<bare_name>"`.
  Vec<str> emitted_plain_method_protos;
  // Every plain top-level function that already got its own inline
  // forward-declared prototype, keyed by bare name.
  Vec<str> emitted_plain_function_protos;
  // A FIFO queue of (owner mangled name, bare method name) pairs still
  // needing a prototype and body, so a generic impl method calling
  // another not-yet-emitted method of the same instantiation is drained
  // from the outermost call rather than nested inline.
  Vec<str> pending_generic_impl_method_owner;
  Vec<str> pending_generic_impl_method_bare;
  // Parallel to the queue above: the quirk name this entry's lookup
  // needs to match against (empty for a plain impl method). See
  // `emitted_generic_impl_methods`'s own comment for why this can't
  // just be folded into `bare_name`.
  Vec<str> pending_generic_impl_method_quirk;
  // Parallel to the queue above: whether this entry's prototype was
  // already written at discovery time. False only for an entry
  // discovered while draining was suppressed, whose prototype the drain
  // loop still needs to write itself before the body.
  Vec<bin> pending_generic_impl_method_proto_written;
  // How many entries at the front of the queue have already been
  // processed, so a later, unrelated drain resumes instead of
  // re-processing everything from the start.
  num pending_generic_impl_method_cursor;
  // True for the duration of the outermost drain loop. A call arriving
  // while this is already true just enqueues and returns.
  bin draining_generic_impl_methods;
  // True while `self.state` points at a throwaway text-capture probe,
  // such as `resolve_field_chain`'s call-as-receiver case. A generic impl
  // method first reached inside such a probe can't be spliced there, so
  // draining is suppressed in favor of enqueuing; the probe drains the
  // queue itself once it restores the real buffer.
  bin suppress_generic_impl_method_draining;
  // The active type-param substitution for the generic impl method being
  // monomorphized: parallel arrays mapping each of the impl's type-param
  // names to this instantiation's concrete argument. Empty means no
  // substitution is active.
  Vec<str> type_subst_param_names;
  Vec<str> type_subst_arg_type_strs;
  Vec<bin> type_subst_arg_is_pointer;
  // Each argument's full structural type, parallel to the two arrays
  // above, kept separately so a further-generic argument substitutes
  // with its own generic arguments intact rather than collapsing to an
  // opaque mangled name.
  Vec<DataType*> type_subst_arg_dtypes;
  // Non-empty while `emit_quirk_vtable_machinery` is building the
  // machinery for one concrete instantiation of a generic compound's
  // quirk impl, naming that instantiation's mangled struct name (e.g.
  // `Box__num`) in place of the template's own bare `type_name`. Empty
  // is the ordinary, non-generic case.
  str quirk_inst_override_name;
  // Where a lazily-monomorphized typedef or generic impl method
  // definition is spliced, instead of wherever the output happens to be
  // when it's first triggered: for a type used inside a function body
  // that would nest a definition inside the function's braces, which is
  // invalid C. `.None` means append at the current tail.
  Option<num> hoist_insert_pos;
  // Position right before the currently executing statement, updated
  // before dispatching each statement in a body. Lets a lazily-triggered
  // prototype land as its own declaration right before the current
  // statement rather than at the live tail.
  Option<num> current_stmt_start_pos;
  // One-shot: `emit_condition` sets this right before calling `emit_
  // expr` on an `if`/`while` condition that's a plain binary op, so
  // that call's own wrapping parens are skipped (C's `if (...)`/`while
  // (...)` already supplies them). Consumed by the very next `.Expression`
  // binary op `emit_expr` handles, whichever that is, and reset
  // immediately, so it never reaches into `left`/`right`'s own nested
  // emission.
  bin suppress_next_expr_parens;
  // Root-buffer-relative position right before the current top-level
  // function's own signature, only ever trustworthy while `self.state
  // == self.root_state` (several other scratch buffers, a struct or
  // enum's own typedef in progress, say, also run at `hoist_scratch_
  // depth == 0`, and this position is meaningless against any of
  // them). Set once by the outermost `emit_function_named` (or `emit_
  // test_runner`, for a test body) call; a nested one leaves it alone.
  // Lets a lazily-triggered plain prototype splice somewhere every
  // call site in the whole function can see, not just whichever
  // triggered it first, which `current_stmt_start_pos` alone can't do
  // since it's scoped to whatever C block the triggering statement
  // sits in. Only trusted once every type the prototype names is
  // confirmed already declared ahead of this position: a type this
  // exact call also happens to be the first to instantiate lands its
  // own typedef wherever the ambient splice position was at the time,
  // not necessarily ahead of this one.
  Option<num> current_fn_body_start_pos;
  // Unique counter for `resolve_field_chain`'s call-as-receiver temp
  // names.
  num call_recv_temp_counter;
  // Unique counter for `emit_for_iter`'s Set/Map iterator temp names.
  num for_iter_temp_counter;
  // How many levels deep emission is nested inside a scratch buffer with
  // `hoist_insert_pos`/`current_stmt_start_pos` suspended (0 when not
  // nested); every scratch-buffer swap shares the counter, since any can
  // trigger another recursively. `root_state`/`root_hoist_pos`/`root_stmt
  // _start_pos` are captured on the 0-to-1 transition and hold the
  // outermost buffer and positions, which `emit_hoisted` reads instead of
  // the live nested ones whenever this is above zero.
  num hoist_scratch_depth;
  CodegenState* root_state;
  Option<num> root_hoist_pos;
  Option<num> root_stmt_start_pos;
  // Unique counter for `emit_fit`'s call-subject temp names.
  num fit_subj_temp_counter;
  // Whether any `fork` statement appears in the program, computed once
  // before the prelude is written.
  bin uses_fork;
  // Names of program-defined functions that collide with a C binding
  // symbol declared in `std/c/*`. Emitted under a `__fun_shadow__`
  // prefix so they never clash with the real libc declaration.
  Vec<str> c_shadow_names;
  // True while emitting `main`'s body. Its forced `int` C signature means
  // `ret <expr>;` can only emit the real expression when the declared
  // return type is a scalar `num`; any other type discards it. Saved and
  // restored around nested function-body emission.
  // What the rejected node was and where it came from, filled in when
  // codegen gives up so the failure can name it.
  str error_note;
  // The innermost node being emitted, so a failure deep in an
  // expression still reports a position.
  str last_where;
  // Emit test blocks and a runner in place of the program's own `main`.
  bin test_mode;
  // Emit MSVC-compatible C: hoist vararg temps before the enclosing
  // statement instead of using GNU `({...})`, replace `__auto_type` with
  // explicit C types wherever they can be inferred at transpile time.
  bin msvc_mode;
  // Incremented for each variadic call that uses the hoist path so each
  // call's temporaries get a unique prefix in the surrounding scope.
  num va_call_counter;
  // Emit exactly one `fuzz` block as a harness in place of the program's
  // own `main`.
  bin fuzz_mode;
  // The `fuzz` target's name to build when a file declares more than one.
  // Empty means "not given", which is only valid when the file declares
  // exactly one target.
  str fuzz_target;
  bin in_main;
}

pub fun codegen_new(CodegenState* state) Codegen {
  Codegen g;
  g.state = state;
  g.local_names.init(0);
  g.local_is_pointer.init(0);
  g.local_type_name.init(0);
  g.local_dtype.init(0);
  g.local_multidim_names.init(0);
  g.local_multidim_roots.init(0);
  g.local_multidim_depths.init(0);
  g.enum_names.init(0);
  g.enum_variant_names.init(0);
  g.enum_is_tagged_union.init(0);
  g.enum_variant_payload_owner.init(0);
  g.enum_variant_payload_variant.init(0);
  g.enum_variant_payload_type_names.init(0);
  g.enum_variant_payload_is_pointer.init(0);
  g.enum_variant_payload_dtype.init(0);
  g.compound_names.init(0);
  g.compound_field_names.init(0);
  g.compound_field_type_names.init(0);
  g.compound_field_is_pointer.init(0);
  g.compound_field_dtype.init(0);
  g.impl_method_owner_type.init(0);
  g.impl_method_bare_name.init(0);
  g.impl_method_mangled_name.init(0);
  g.impl_method_rtype.init(0);
  g.impl_method_param_types.init(0);
  g.impl_method_default_values.init(0);
  g.function_names.init(0);
  g.function_param_types.init(0);
  g.function_default_values.init(0);
  g.function_is_variadic.init(0);
  g.function_rtypes.init(0);
  g.generic_function_templates.init(0);
  g.generic_compound_names.init(0);
  g.generic_compound_type_params.init(0);
  g.generic_compound_field_names.init(0);
  g.generic_compound_field_type_names.init(0);
  g.generic_compound_field_is_pointer.init(0);
  g.generic_compound_field_dtypes.init(0);
  g.generic_enum_names.init(0);
  g.generic_enum_type_params.init(0);
  g.generic_enum_variants.init(0);
  g.emitted_generic_instantiations.init(0);
  g.emitted_plain_types.init(0);
  g.plain_type_in_progress.init(0);
  g.all_nodes.init(0);
  g.generic_impl_templates.init(0);
  g.instantiation_mangled_name.init(0);
  g.instantiation_base_name.init(0);
  g.instantiation_arg_type_names.init(0);
  g.instantiation_arg_is_pointer.init(0);
  g.instantiation_arg_dtypes.init(0);
  g.emitted_generic_impl_methods.init(0);
  g.emitted_method_own_param_insts.init(0);
  g.emitted_plain_method_protos.init(0);
  g.emitted_plain_function_protos.init(0);
  g.pending_generic_impl_method_owner.init(0);
  g.pending_generic_impl_method_bare.init(0);
  g.pending_generic_impl_method_quirk.init(0);
  g.pending_generic_impl_method_proto_written.init(0);
  g.pending_generic_impl_method_cursor = 0;
  g.draining_generic_impl_methods = false;
  g.suppress_generic_impl_method_draining = false;
  g.type_subst_param_names.init(0);
  g.type_subst_arg_type_strs.init(0);
  g.type_subst_arg_is_pointer.init(0);
  g.type_subst_arg_dtypes.init(0);
  g.quirk_inst_override_name = "";
  g.loop_defer_marks.init(0);
  g.hoist_insert_pos = .None;
  g.current_stmt_start_pos = .None;
  g.suppress_next_expr_parens = false;
  g.current_fn_body_start_pos = .None;
  g.call_recv_temp_counter = 0;
  g.for_iter_temp_counter = 0;
  g.va_call_counter = 0;
  g.hoist_scratch_depth = 0;
  // Matches `g.state`, so `self.state == self.root_state` is already
  // true for the very first function, not just after the first nested
  // generic-impl-method transition sets it.
  g.root_state = state;
  g.root_hoist_pos = .None;
  g.root_stmt_start_pos = .None;
  g.fit_subj_temp_counter = 0;
  g.current_fn_rtype_name = "";
  g.current_fn_rtype_dt = .None;
  g.expected_enum_type = "";
  g.expected_compound_type = "";
  g.in_array_initializer = false;
  g.quirk_names.init(0);
  g.emitted_quirk_impl_vtables.init(0);
  g.quirk_decl_names.init(0);
  g.quirk_decl_type_params.init(0);
  g.quirk_decl_methods.init(0);
  g.import_aliases.init(0);
  g.alias_rename_keys.init(0);
  g.alias_rename_targets.init(0);
  g.defer_stack.init(0);
  g.defer_scope_starts.init(0);
  g.uses_fork = false;
  g.c_shadow_names.init(0);
  g.error_note = "";
  g.last_where = "";
  g.test_mode = false;
  g.msvc_mode = false;
  g.fuzz_mode = false;
  g.fuzz_target = "";
  g.in_main = false;
  ret g;
}

// True if `node`'s subtree contains a `fork <call>;` statement anywhere.
// A `fork` is always a statement, never nested inside an expression, so
// only statement and body shapes need walking.
fun node_contains_fork(Node* node) bin {
  fit node.kind {
    .StatementFork(_) -> { ret true; }
    .Body(bn) -> {
      for s : bn.statements {
        if node_contains_fork(s) {
          ret true;
        }
      }
      ret false;
    }
    .StatementIf(ifn) -> { ret node_contains_fork(ifn.body); }
    .StatementElseIf(ein) -> { ret node_contains_fork(ein.body); }
    .StatementElse(ebody) -> { ret node_contains_fork(ebody); }
    .StatementDefer(body) -> { ret node_contains_fork(body); }
    .StatementFor(fk) -> {
      fit fk {
        .Cond(fc) -> { ret node_contains_fork(fc.body); }
        .Range(fr) -> { ret node_contains_fork(fr.body); }
        .Iter(fi) -> { ret node_contains_fork(fi.body); }
      }
    }
    .StatementFit(f) -> {
      for br : f.branches {
        if node_contains_fork(br.body) {
          ret true;
        }
      }
      ret false;
    }
    .Function(fnv) -> {
      if fnv.has_body {
        ret node_contains_fork(fnv.body);
      }
      ret false;
    }
    .Impl(i) -> {
      for m : i.methods {
        if node_contains_fork(m) {
          ret true;
        }
      }
      ret false;
    }
    _ -> { ret false; }
  }
}

// True if any `fork` statement appears across `nodes`, the program's
// flattened top-level declaration list. Imports are already resolved and
// flattened in before codegen runs, so imported children need no separate
// recursion.
// True when the program pulled in the bindings declared by `std/c/<file>`.
// Imports are flattened before codegen, so the binding declarations
// themselves are what identifies which C headers the program needs.
fun program_uses_std_c_header(Vec<Node> nodes, str file) bin {
  for n : nodes {
    if !n.has_pos {
      continue;
    }
    if !ends_with(n.pos.filename, file) {
      continue;
    }
    if contains(n.pos.filename, "/std/c/") || contains(n.pos.filename, "\\std\\c\\") {
      ret true;
    }
  }
  ret false;
}

fun uses_fork_in(Vec<Node> nodes) bin {
  for n : nodes {
    if node_contains_fork(&n) {
      ret true;
    }
  }
  ret false;
}

// True when `node` was declared in a `std/c/*.fn` binding file.
fun node_is_std_c_binding(Node n) bin {
  if !n.has_pos {
    ret false;
  }
  ret contains(n.pos.filename, "/std/c/") || contains(n.pos.filename, "\\std\\c\\");
}

// Collects every program-defined function whose name also names a C
// binding declared in `std/c/*`, such as `std/log.fn`'s `log` against
// libc's `log(double)`. Such a function is emitted under a
// `__fun_shadow__` prefix so the C declaration stays usable.
fun collect_c_shadow_names(Vec<Node> nodes) Vec<str> {
  Vec<str> binding_names;
  binding_names.init(0);
  defer binding_names.free();
  for n : nodes {
    fit n.kind {
      .Function(f) -> {
        if !f.has_body && node_is_std_c_binding(n) {
          binding_names.push(f.name);
        }
      }
      _ -> {}
    }
  }

  Vec<str> out;
  out.init(0);
  for n2 : nodes {
    fit n2.kind {
      .Function(f2) -> {
        // `main` keeps its name: C requires the real entry point.
        if !f2.has_body || equals(f2.name, "main") || node_is_std_c_binding(n2) {
          continue;
        }
        if binding_names.contains(f2.name) && !out.contains(f2.name) {
          out.push(f2.name);
        }
      }
      _ -> {}
    }
  }
  ret out;
}

// Shifts a tracked buffer position right by `splice_len` if it falls at
// or after `splice_at`, to account for text just spliced in there.
fun adjust_pos_after_splice(Option<num> pos, num splice_at, num splice_len) Option<num> {
  if pos.is_none() {
    ret pos;
  }
  if splice_at <= pos.unwrap() {
    ret .Some(pos.unwrap() + splice_len);
  }
  ret pos;
}

// True when splicing new text in at `pos` (within `full`) lands
// between two top-level declarations rather than mid-signature: every
// declaration this codegen emits ends its own line, so `pos` has to
// sit right after a newline. This is a second, independent safety net
// alongside checking that every type a prototype names is already
// declared: that check can pass while `pos` still isn't a real
// declaration boundary if some other position it was derived from
// went stale, and landing mid-signature there would silently split an
// identifier in two.
fun is_safe_splice_boundary(StringBuilder* out, num pos) bin {
  if pos <= 0 || pos >= out.len() {
    ret true;
  }
  ret out.char_at(pos - 1) == '\n';
}

// True for a character C reads as part of a `\x` escape's digits.
fun _is_hex_digit(chr c) bin {
  ret (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

// True when `dt` is a pointer of any depth, matching `write_type`'s
// `ptr_depth`/`flags.is_pointer` check.
fun dtype_is_pointer(DataType dt) bin {
  if dt.pointer_depth > 0 {
    ret true;
  }
  ret dt.flags.is_pointer;
}

// True for an unsized array type (`T[]`, no bracket dimension), which
// decays to a plain C pointer. A sized array (`T[3]`) is excluded; it
// stays a fixed-size inline array.
fun dtype_is_array_as_pointer(DataType dt) bin {
  if !dt.is_array {
    ret false;
  }
  if dt.array_brackets.len > 0 {
    ret false;
  }
  ret dt.array_depth <= 1;
}

// True when `dt` matches a constraint name from an `impl Vec<T: num |
// dec>`-style forced-instantiation list. A builtin scalar matches by
// kind; a named type matches by its bare name, or by the base name
// before a mangled `__` separator.
fun dtype_matches_constraint_name(DataType dt, str expected) bin {
  fit dt.kind {
    .Num -> { ret equals(expected, "num"); }
    .Dec -> { ret equals(expected, "dec"); }
    .Str -> { ret equals(expected, "str"); }
    .Chr -> { ret equals(expected, "chr"); }
    .Bin -> { ret equals(expected, "bin"); }
    .Raw -> { ret equals(expected, "raw"); }
    .Void -> { ret equals(expected, "void"); }
    .Unknown -> {
      if equals(dt.type_str, expected) {
        ret true;
      }
      num sep = index_of_str(dt.type_str, "__");
      if sep < 0 {
        ret false;
      }
      ret equals(substr(dt.type_str, 0, sep), expected);
    }
  }
}

// True when `gargs` (a generic impl instantiation's concrete arguments)
// is allowed by `forced_insts`, one of the concrete-type combinations
// from an `impl Vec<T: num | dec>`-style constraint. An unconstrained
// template always allows any instantiation.
fun impl_allows_generic_args(bin has_forced, Vec<Vec<str>> forced_insts, Vec<DataType*> gargs) bin {
  if !has_forced {
    ret true;
  }
  for inst : forced_insts {
    if inst.len != gargs.len {
      continue;
    }
    bin all_match = true;
    num i = 0;
    for i < inst.len {
      if !dtype_matches_constraint_name(*gargs.get(i), inst.get(i)) {
        all_match = false;
        break;
      }
      i = i + 1;
    }
    if all_match {
      ret true;
    }
  }
  ret false;
}

impl Codegen {

  // Writes `type_name`'s bare C spelling, with no pointer stars.
  write_type_name(str type_name) {
    fit parse_dynamic_int_datatype(type_name) {
      .Some(dyn) -> { self.state.write(dynamic_int_type_to_c(dyn)); }
      .None -> { self.state.write(map_type_to_c(type_name)); }
    }
  }

  // Returns a copy of `dt` with every bare occurrence of an active
  // type-param name substituted for its concrete argument, either `dt`
  // itself or one of its own generic arguments. Returns `dt` unchanged
  // when no substitution context is active.
  resolve_type_subst(DataType dt) DataType {
    if self.type_subst_param_names.len == 0 {
      ret dt;
    }
    if dt.generic_args.len == 0 {
      for i : 0..self.type_subst_param_names.len {
        if equals(self.type_subst_param_names.get(i), dt.type_str) {
          // Prefer the argument's full structural type, which keeps a
          // further-generic argument intact. Falls back to the flat
          // strings for a call site that only populated those.
          if i < self.type_subst_arg_dtypes.len {
            let arg_dt = self.type_subst_arg_dtypes.get(i);
            DataType out2 = *arg_dt;
            out2.pointer_depth = out2.pointer_depth + dt.pointer_depth;
            ret out2;
          }
          DataType out = dtype_new();
          out.type_str = self.type_subst_arg_type_strs.get(i);
          out.flags = dt.flags;
          num extra = 0;
          if self.type_subst_arg_is_pointer.get(i) {
            extra = 1;
          }
          out.pointer_depth = dt.pointer_depth + extra;
          ret out;
        }
      }
      ret dt;
    }
    DataType out = dtype_new();
    out.type_str = dt.type_str;
    out.pointer_depth = dt.pointer_depth;
    out.flags = dt.flags;
    Vec<DataType*> new_args;
    new_args.init(0);
    for a : dt.generic_args {
      bin substituted = false;
      if a.generic_args.len == 0 {
        for i : 0..self.type_subst_param_names.len {
          if equals(self.type_subst_param_names.get(i), a.type_str) {
            if i < self.type_subst_arg_dtypes.len {
              let arg_dt2 = self.type_subst_arg_dtypes.get(i);
              DataType* sub2 = malloc(sizeof(DataType));
              *sub2 = *arg_dt2;
              sub2.pointer_depth = sub2.pointer_depth + a.pointer_depth;
              new_args.push(sub2);
              substituted = true;
              break;
            }
            DataType* sub = malloc(sizeof(DataType));
            *sub = dtype_new();
            sub.type_str = self.type_subst_arg_type_strs.get(i);
            num extra = 0;
            if self.type_subst_arg_is_pointer.get(i) {
              extra = 1;
            }
            sub.pointer_depth = a.pointer_depth + extra;
            new_args.push(sub);
            substituted = true;
            break;
          }
        }
      }
      if !substituted {
        new_args.push(a);
      }
    }
    out.generic_args = new_args;
    ret out;
  }

  // Writes `dt`'s C spelling plus pointer stars, returning the resolved
  // name: the mangled name for a generic instantiation, `dt.type_str`
  // otherwise. A caller that needs to register this type for later
  // lookup must use the returned name. Returns `.None` when `dt` is a
  // generic instantiation that can't be resolved.
  pub write_type(DataType dt) Option<str> {
    let resolved = self.resolve_type_name(dt);
    if resolved.is_none() {
      ret .None;
    }
    str resolved_name = resolved.unwrap();
    self.write_type_name(resolved_name);
    let rdt = self.resolve_type_subst(dt);
    num ptr_depth = rdt.pointer_depth;
    if ptr_depth == 0 && rdt.flags.is_pointer {
      ptr_depth = 1;
    }
    num i = 0;
    for i < ptr_depth {
      self.state.write("*");
      i = i + 1;
    }
    ret .Some(resolved_name);
  }

  // Strips a declared type name's leading `<alias>__` segment back to the
  // bare name, since an alias's declarations are merged in unqualified.
  // Only a known alias is stripped; a generic instantiation's mangled
  // name has the same `X__Y` shape but never matches one.
  strip_known_alias_prefix(str type_str) str {
    for alias : self.import_aliases {
      StringBuilder pfx = string_builder_init(16);
      pfx.append(alias);
      pfx.append("__");
      str prefix = pfx.build();
      if starts_with(type_str, prefix) {
        ret strip_prefix(type_str, prefix);
      }
    }
    ret type_str;
  }

  // The name-resolution half of `write_type`, for a caller that needs
  // `dt`'s resolved name (triggering monomorphization) without writing
  // its C spelling.
  resolve_type_name(DataType dt) Option<str> {
    dt.type_str = self.strip_known_alias_prefix(dt.type_str);
    let rdt = self.resolve_type_subst(dt);
    if rdt.generic_args.len == 0 {
      ret .Some(rdt.type_str);
    }
    let compound_inst = self.ensure_compound_instantiated(rdt);
    if compound_inst.is_some() {
      ret compound_inst;
    }
    let enum_inst = self.ensure_enum_instantiated(rdt);
    if enum_inst.is_some() {
      ret enum_inst;
    }
    // A concrete instantiation of a generic quirk used directly as a
    // type: neither a compound nor an enum template recognizes it.
    ret self.ensure_quirk_instantiated(rdt);
  }

  // Appends a rendered typedef or method definition at the current tail
  // (when `hoist_insert_pos` is `.None`) or splices it at the tracked
  // earlier position, so a definition triggered inside a function body
  // lands before the enclosing item. Advances `hoist_insert_pos` so a
  // second hoisted definition lands after the first.
  emit_hoisted(str text) {
    if self.hoist_insert_pos.is_none() {
      if self.hoist_scratch_depth > 0 {
        // Nested inside another scratch buffer: route through the root
        // buffer and position instead of the suspended local one.
        if self.root_hoist_pos.is_none() {
          self.root_state.write(text);
          ret;
        }
        num rpos = self.root_hoist_pos.unwrap();
        // `peek()`, not `build()`: this is the true root buffer, still
        // being written to for the rest of the program after this
        // splice, not a throwaway scratch one.
        str rfull = self.root_state.out.peek();
        str rhead = substr(rfull, 0, rpos);
        str rtail = substr(rfull, rpos, len(rfull) - rpos);
        StringBuilder rrebuilt = string_builder_init(len(rfull) + len(text) + 16);
        rrebuilt.append(rhead);
        rrebuilt.append(text);
        rrebuilt.append(rtail);
        free(rfull);
        free(rhead);
        free(rtail);
        self.root_state.out.free();
        self.root_state.out = rrebuilt;
        self.root_hoist_pos = .Some(rpos + len(text));
        self.root_stmt_start_pos = adjust_pos_after_splice(
          self.root_stmt_start_pos,
          rpos,
          len(text)
        );
        ret;
      }
      self.state.write(text);
      ret;
    }
    num pos = self.hoist_insert_pos.unwrap();
    // `peek()`, not `build()`, same reason as the root-buffer branch above.
    str full = self.state.out.peek();
    str head = substr(full, 0, pos);
    str tail = substr(full, pos, len(full) - pos);
    StringBuilder rebuilt = string_builder_init(len(full) + len(text) + 16);
    rebuilt.append(head);
    rebuilt.append(text);
    rebuilt.append(tail);
    free(full);
    free(head);
    free(tail);
    self.state.out.free();
    self.state.out = rebuilt;
    self.hoist_insert_pos = .Some(pos + len(text));
    // Tracked independently of `hoist_insert_pos`, so it needs the same
    // shift.
    self.current_stmt_start_pos = adjust_pos_after_splice(
      self.current_stmt_start_pos,
      pos,
      len(text)
    );
    // Only trustworthy when `self.state` is confirmed to be the real
    // buffer this splice just landed in.
    if self.state == self.root_state {
      self.current_fn_body_start_pos = adjust_pos_after_splice(
        self.current_fn_body_start_pos,
        pos,
        len(text)
      );
    }
  }

  // Given a generic compound template's bare name (from a literal with no
  // explicit type arguments) and its initializer fields, infers each type
  // param's binding from whichever field's declared type is a bare
  // occurrence of that param. `.None` when `base_name` isn't a generic
  // template, or a type param can't be inferred from any field.
  infer_generic_compound_init_args(str base_name, Vec<CompoundInitField> init_fields) Option<Vec<DataType*>> {
    num template_idx = 0;
    bin found_tmpl = false;
    for template_idx < self.generic_compound_names.len {
      if equals(self.generic_compound_names.get(template_idx), base_name) {
        found_tmpl = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found_tmpl {
      ret .None;
    }
    let type_params = self.generic_compound_type_params.get(template_idx);
    let tmpl_field_names = self.generic_compound_field_names.get(template_idx);
    let tmpl_field_dtypes = self.generic_compound_field_dtypes.get(template_idx);

    Vec<DataType*> resolved_args;
    resolved_args.init(0);
    for tp : type_params {
      bin tp_found = false;
      str tp_name = "";
      bin tp_is_pointer = false;
      num fi = 0;
      for fi < tmpl_field_names.len {
        if tp_found {
          break;
        }
        let tfdt = tmpl_field_dtypes.get(fi);
        if equals(tfdt.type_str, tp) && tfdt.generic_args.len == 0 {
          let fname = tmpl_field_names.get(fi);
          num ii = 0;
          for ii < init_fields.len {
            let ifield = init_fields.get(ii);
            if equals(ifield.name, fname) {
              let inferred_name = self.infer_arg_type_name(ifield.value);
              if inferred_name.is_some() {
                tp_name = inferred_name.unwrap();
                tp_is_pointer = self.infer_arg_is_pointer(ifield.value);
                tp_found = true;
              }
            }
            ii = ii + 1;
          }
        }
        fi = fi + 1;
      }
      if !tp_found {
        ret .None;
      }
      DataType* tp_dt = malloc(sizeof(DataType));
      *tp_dt = dtype_new();
      tp_dt.type_str = tp_name;
      if tp_is_pointer {
        tp_dt.pointer_depth = 1;
      }
      resolved_args.push(tp_dt);
    }
    ret .Some(resolved_args);
  }

  // Resolves a generic compound instantiation (`Box<num>` -> `Box__num`)
  // and, the first time it is seen, emits its monomorphized C struct.
  // Mangled as `<base>__<arg1>__<arg2>...` with a `_ptrN` suffix for a
  // pointer argument; a nested generic argument resolves and emits first,
  // recursing to arbitrary depth. `.None` when `dt.type_str` isn't a
  // known generic compound template, the argument count doesn't match, or
  // a nested argument can't be resolved.
  ensure_compound_instantiated(DataType dt) Option<str> {
    num template_idx = 0;
    bin found = false;
    for template_idx < self.generic_compound_names.len {
      if equals(self.generic_compound_names.get(template_idx), dt.type_str) {
        found = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found {
      ret .None;
    }

    let type_params = self.generic_compound_type_params.get(template_idx);
    if type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder name_sb = string_builder_init(16);
    name_sb.append(dt.type_str);
    Vec<str> arg_type_names;
    arg_type_names.init(0);
    Vec<bin> arg_is_pointer;
    arg_is_pointer.init(0);
    Vec<DataType*> arg_dtypes;
    arg_dtypes.init(0);
    num ai = 0;
    for ai < dt.generic_args.len {
      let arg = dt.generic_args.get(ai);
      str arg_name = arg.type_str;
      if arg.generic_args.len > 0 {
        // Resolved (and, on first use, emitted) first, so it's already
        // hoisted before the outer type's mangled name is built.
        let nested_name = self.resolve_type_name(*arg);
        if nested_name.is_none() {
          ret .None;
        }
        arg_name = nested_name.unwrap();
      }
      name_sb.append("__");
      name_sb.append(arg_name);
      bin arg_ptr = dtype_is_pointer(*arg);
      if arg_ptr {
        name_sb.append("_ptr");
        name_sb.append(format_num(arg.pointer_depth));
      }
      arg_type_names.push(arg_name);
      arg_is_pointer.push(arg_ptr);
      // Keeps the argument's full structural type, not just its flattened
      // name, for a further-generic argument.
      arg_dtypes.push(arg);
      ai = ai + 1;
    }
    str mangled_name = name_sb.build();

    num ei = 0;
    for ei < self.emitted_generic_instantiations.len {
      if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
        ret .Some(mangled_name);
      }
      ei = ei + 1;
    }
    // Registered before the struct body is resolved: a self-referential
    // field recurses back into this function for the same mangled name,
    // so registering only at the end would recurse forever.
    self.emitted_generic_instantiations.push(mangled_name);
    let field_names = self.generic_compound_field_names.get(template_idx);
    let field_type_names = self.generic_compound_field_type_names.get(template_idx);
    let field_is_pointer = self.generic_compound_field_is_pointer.get(template_idx);
    let field_dtypes = self.generic_compound_field_dtypes.get(template_idx);
    // A directly self-referential template is forward-declared first, so
    // a field like `Box<T>* next;` inside `compound Box<T>` has a type
    // name to reference before the body is written.
    bin is_self_referential = false;
    for fdt : field_dtypes {
      if equals(fdt.type_str, dt.type_str) {
        is_self_referential = true;
      }
    }
    if is_self_referential {
      StringBuilder fwd_sb = string_builder_init(32);
      fwd_sb.append("typedef struct ");
      fwd_sb.append(mangled_name);
      fwd_sb.append(" ");
      fwd_sb.append(mangled_name);
      fwd_sb.append(";\n");
      self.emit_hoisted(fwd_sb.build());
    }

    Vec<str> resolved_field_names;
    resolved_field_names.init(0);
    Vec<str> resolved_field_type_names;
    resolved_field_type_names.init(0);
    Vec<bin> resolved_field_is_pointer;
    resolved_field_is_pointer.init(0);
    // Star count for each field's C declaration: an array-decayed field
    // substituting a pointer-typed argument needs both the array decay's
    // star and the argument's pointer depth (`Vec<Node*>`'s `data` field
    // is `Node** data;`).
    Vec<num> resolved_field_ptr_depth;
    resolved_field_ptr_depth.init(0);

    // Pass 1: resolve every field's substituted type before `self.state`
    // is swapped to the scratch buffer below, so a nested instantiation
    // still splices against the real buffer.
    num fi = 0;
    for fi < field_names.len {
      str ftype = field_type_names.get(fi);
      bin fptr = field_is_pointer.get(fi);
      str resolved_type = ftype;
      bin resolved_ptr = fptr;
      bin matched_bare_param = false;
      num ptr_depth = 0;
      if fptr {
        ptr_depth = 1;
      }
      num pi = 0;
      for pi < type_params.len {
        if equals(type_params.get(pi), ftype) {
          resolved_type = arg_type_names.get(pi);
          // `fptr` carries the field's array-decay pointer-ness,
          // independent of whether the argument is pointer-shaped.
          resolved_ptr = arg_is_pointer.get(pi) || fptr;
          // The argument's pointer depth stacks on top of the array
          // decay's single level.
          let matched_arg = arg_dtypes.get(pi);
          ptr_depth = ptr_depth + matched_arg.pointer_depth;
          matched_bare_param = true;
          break;
        }
        pi = pi + 1;
      }
      // `ftype` records only a field's bare base name, dropping its
      // generic args; `field_dtypes` keeps the full type, so this can
      // reuse the substitution machinery a generic impl method's body
      // gets.
      if !matched_bare_param {
        let field_dt = field_dtypes.get(fi);
        if field_dt.generic_args.len > 0 {
          let prev_params = self.type_subst_param_names;
          let prev_arg_names = self.type_subst_arg_type_strs;
          let prev_arg_ptrs = self.type_subst_arg_is_pointer;
          self.type_subst_param_names = type_params;
          self.type_subst_arg_type_strs = arg_type_names;
          self.type_subst_arg_is_pointer = arg_is_pointer;
          let nested_name = self.resolve_type_name(*field_dt);
          self.type_subst_param_names = prev_params;
          self.type_subst_arg_type_strs = prev_arg_names;
          self.type_subst_arg_is_pointer = prev_arg_ptrs;
          if nested_name.is_some() {
            resolved_type = nested_name.unwrap();
            resolved_ptr = dtype_is_pointer(*field_dt) || fptr;
            if resolved_ptr {
              ptr_depth = 1;
            }
          }
        }
      }
      // A bare type param substituted straight to a plain (non-generic)
      // name (`compound Result<T, E> { T value; E err; }` instantiated
      // as `Result<num, Error>`) never goes through the nested-generic
      // branch above, which is the only place this function otherwise
      // ensures a by-value dependency's own body exists first. Guarded
      // to the root buffer: `self.state` can be some other type's own
      // in-progress scratch here (a nested instantiation reached from
      // deeper in Pass 1), and `ensure_plain_type_emitted` writes
      // straight to `self.state` with no scratch-aware routing of its
      // own, same as everywhere else in this codebase that only trusts
      // a splice while `self.state == self.root_state`.
      if !resolved_ptr && self.state == self.root_state {
        self.ensure_plain_type_emitted(resolved_type);
      }
      resolved_field_names.push(field_names.get(fi));
      resolved_field_type_names.push(resolved_type);
      resolved_field_is_pointer.push(resolved_ptr);
      resolved_field_ptr_depth.push(ptr_depth);
      fi = fi + 1;
    }

    // Pass 2: write the struct body verbatim from the resolved vectors
    // above, so no further resolution (and no recursive instantiation)
    // happens while `self.state` is swapped.
    CodegenState typedef_scratch = codegen_state_new();
    CodegenState* saved_state = self.state;
    self.state = &typedef_scratch;
    self.state.write("typedef struct ");
    self.state.write(mangled_name);
    self.state.write(" {\n");
    num wi = 0;
    for wi < resolved_field_names.len {
      self.state.write("  ");
      self.write_type_name(resolved_field_type_names.get(wi));
      // Uses the field's star count, not `resolved_field_is_pointer`'s
      // single boolean.
      num pdi = 0;
      for pdi < resolved_field_ptr_depth.get(wi) {
        self.state.write("*");
        pdi = pdi + 1;
      }
      self.state.write(" ");
      self.state.write(resolved_field_names.get(wi));
      // A fixed-size array field (`num[3] data;`) is a real C array, not
      // a decayed pointer, the same as the plain-compound case in
      // `emit_compound`: `field_dtypes` already carries the template
      // field's own bracket nodes (an array's size doesn't depend on the
      // instantiation's type argument), untouched by Pass 1's
      // type-param substitution.
      let wfield_dt = field_dtypes.get(wi);
      if wfield_dt.is_array && resolved_field_ptr_depth.get(wi) == 0 &&
        wfield_dt.array_brackets.len > 0 {
        for bnode : wfield_dt.array_brackets {
          self.state.write("[");
          fit bnode.kind {
            .Bracket(inner) -> {
              let werr = self.emit_expr(*inner);
              if werr.is_some() {
                self.state = saved_state;
                ret .None;
              }
            }
            _ -> {
              let werr = self.emit_expr(*bnode);
              if werr.is_some() {
                self.state = saved_state;
                ret .None;
              }
            }
          }
          self.state.write("]");
        }
      }
      self.state.write(";\n");
      wi = wi + 1;
    }
    self.state.write("} ");
    self.state.write(mangled_name);
    self.state.write(";\n\n");
    self.state = saved_state;
    self.emit_hoisted(typedef_scratch.out.build());

    self.record_compound(
      mangled_name,
      resolved_field_names,
      resolved_field_type_names,
      resolved_field_is_pointer
    );
    self.maybe_instantiate_generic_impl_methods(
      dt.type_str,
      mangled_name,
      arg_type_names,
      arg_is_pointer,
      arg_dtypes
    );
    self.maybe_emit_quirk_vtable_for_instantiation(
      dt.type_str,
      mangled_name,
      type_params,
      arg_type_names,
      arg_is_pointer,
      arg_dtypes
    );
    ret .Some(mangled_name);
  }

  // Resolves a generic enum instantiation (`Option<num>` ->
  // `Option__num`) and, the first time it is seen, emits its
  // monomorphized C enum or tagged union. Follows
  // `ensure_compound_instantiated`, differing only in what each variant
  // emits.
  ensure_enum_instantiated(DataType dt) Option<str> {
    num template_idx = 0;
    bin found = false;
    for template_idx < self.generic_enum_names.len {
      if equals(self.generic_enum_names.get(template_idx), dt.type_str) {
        found = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found {
      ret .None;
    }

    let type_params = self.generic_enum_type_params.get(template_idx);
    if type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder name_sb = string_builder_init(16);
    name_sb.append(dt.type_str);
    Vec<str> arg_type_names;
    arg_type_names.init(0);
    Vec<bin> arg_is_pointer;
    arg_is_pointer.init(0);
    Vec<DataType*> arg_dtypes;
    arg_dtypes.init(0);
    num ai = 0;
    for ai < dt.generic_args.len {
      let arg = dt.generic_args.get(ai);
      str arg_name = arg.type_str;
      if arg.generic_args.len > 0 {
        // A nested generic argument resolves first, recursing to
        // arbitrary depth.
        let nested_name = self.resolve_type_name(*arg);
        if nested_name.is_none() {
          ret .None;
        }
        arg_name = nested_name.unwrap();
      }
      name_sb.append("__");
      name_sb.append(arg_name);
      bin arg_ptr = dtype_is_pointer(*arg);
      if arg_ptr {
        name_sb.append("_ptr");
        name_sb.append(format_num(arg.pointer_depth));
      }
      arg_type_names.push(arg_name);
      arg_is_pointer.push(arg_ptr);
      // The full structural type is kept alongside the flattened name
      // and pointer-ness; see `ensure_compound_instantiated`.
      arg_dtypes.push(arg);
      ai = ai + 1;
    }
    str mangled_name = name_sb.build();

    num ei = 0;
    for ei < self.emitted_generic_instantiations.len {
      if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
        ret .Some(mangled_name);
      }
      ei = ei + 1;
    }
    // Pushed before the enum body is written, and forward-declared when
    // self-referential; see `ensure_compound_instantiated`.
    self.emitted_generic_instantiations.push(mangled_name);
    let variant_templates = self.generic_enum_variants.get(template_idx);
    bin enum_is_self_referential = false;
    for vt : variant_templates {
      for pt : vt.payload_type_strs {
        if equals(pt, dt.type_str) {
          enum_is_self_referential = true;
        }
      }
    }
    if enum_is_self_referential {
      StringBuilder efwd_sb = string_builder_init(32);
      efwd_sb.append("typedef struct ");
      efwd_sb.append(mangled_name);
      efwd_sb.append(" ");
      efwd_sb.append(mangled_name);
      efwd_sb.append(";\n");
      self.emit_hoisted(efwd_sb.build());
    }

    bin is_tagged_union = false;
    for vt : variant_templates {
      if vt.has_payload {
        is_tagged_union = true;
      }
    }

    // A payload written as a bare type param, substituted straight to a
    // plain (non-generic) name, needs that name's own body ensured
    // first, mirroring `ensure_compound_instantiated`'s own field pass
    // and for the same reason: nothing else guarantees the substituted
    // type's body already exists by the time it's embedded by value
    // here. Has to run before `self.state` swaps to `enum_scratch`
    // below, since `ensure_plain_type_emitted` writes straight to
    // `self.state` with no scratch-aware routing of its own -- same
    // root-buffer guard as the compound side.
    if is_tagged_union && self.state == self.root_state {
      for vt2 : variant_templates {
        if !vt2.has_payload {
          continue;
        }
        num pti = 0;
        for pti < vt2.payload_type_strs.len {
          str ptype2 = vt2.payload_type_strs.get(pti);
          bin pptr2 = vt2.payload_is_pointer.get(pti);
          pti = pti + 1;
          if pptr2 || equals(ptype2, dt.type_str) {
            continue;
          }
          num pi2 = 0;
          for pi2 < type_params.len {
            if equals(type_params.get(pi2), ptype2) {
              if !arg_is_pointer.get(pi2) {
                self.ensure_plain_type_emitted(arg_type_names.get(pi2));
              }
            }
            pi2 = pi2 + 1;
          }
        }
      }
    }

    Vec<str> variant_names;
    variant_names.init(0);
    for vt : variant_templates {
      variant_names.push(vt.name);
    }

    CodegenState enum_scratch = codegen_state_new();
    CodegenState* saved_enum_state = self.state;
    self.state = &enum_scratch;
    if is_tagged_union {
      self.emit_tagged_union_enum_instance(
        dt.type_str,
        mangled_name,
        variant_templates,
        type_params,
        arg_type_names,
        arg_is_pointer
      );
    } else {
      self.state.write("typedef enum ");
      self.state.write(mangled_name);
      self.state.write(" {\n");
      for vt : variant_templates {
        self.state.write("  ");
        self.state.write(mangled_name);
        self.state.write("_");
        self.state.write(vt.name);
        self.state.write(",\n");
      }
      self.state.write("} ");
      self.state.write(mangled_name);
      self.state.write(";\n\n");
    }
    self.state = saved_enum_state;
    self.emit_hoisted(enum_scratch.out.build());

    self.record_enum(mangled_name, variant_names, is_tagged_union);
    self.maybe_instantiate_generic_impl_methods(
      dt.type_str,
      mangled_name,
      arg_type_names,
      arg_is_pointer,
      arg_dtypes
    );
    self.maybe_emit_quirk_vtable_for_instantiation(
      dt.type_str,
      mangled_name,
      type_params,
      arg_type_names,
      arg_is_pointer,
      arg_dtypes
    );
    ret .Some(mangled_name);
  }

  // Resolves a concrete generic-quirk instantiation and, the first time
  // it is seen, emits its vtable struct and fat pointer type, deriving
  // each method's signature from the quirk declaration. Covers a type
  // reference to an instantiation with no impl in the translation unit.
  // `.None` when `dt.type_str` doesn't name a registered generic quirk or
  // the argument count doesn't match.
  ensure_quirk_instantiated(DataType dt) Option<str> {
    num qdi = 0;
    bin qfound = false;
    for qdi < self.quirk_decl_names.len {
      if equals(self.quirk_decl_names.get(qdi), dt.type_str) {
        qfound = true;
        break;
      }
      qdi = qdi + 1;
    }
    if !qfound {
      ret .None;
    }
    let q_type_params = self.quirk_decl_type_params.get(qdi);
    if q_type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder qname_sb = string_builder_init(16);
    qname_sb.append(dt.type_str);
    Vec<str> q_arg_type_names;
    q_arg_type_names.init(0);
    Vec<bin> q_arg_is_pointer;
    q_arg_is_pointer.init(0);
    for qarg : dt.generic_args {
      qname_sb.append("__");
      qname_sb.append(qarg.type_str);
      q_arg_type_names.push(qarg.type_str);
      q_arg_is_pointer.push(dtype_is_pointer(*qarg));
    }
    str q_mangled = qname_sb.build();

    if self.quirk_names.contains(q_mangled) {
      ret .Some(q_mangled);
    }

    let q_methods = self.quirk_decl_methods.get(qdi);

    let prev_params = self.type_subst_param_names;
    let prev_arg_names = self.type_subst_arg_type_strs;
    let prev_arg_ptrs = self.type_subst_arg_is_pointer;
    self.type_subst_param_names = q_type_params;
    self.type_subst_arg_type_strs = q_arg_type_names;
    self.type_subst_arg_is_pointer = q_arg_is_pointer;

    CodegenState qvt_scratch = codegen_state_new();
    CodegenState* saved_qvt_state = self.state;
    self.state = &qvt_scratch;
    self.state.write("typedef struct ");
    self.state.write(q_mangled);
    self.state.write("_vtable ");
    self.state.write(q_mangled);
    self.state.write("_vtable;\n");
    self.state.write("struct ");
    self.state.write(q_mangled);
    self.state.write("_vtable {\n");
    bin q_write_err = false;
    for qm : q_methods {
      self.state.write("  ");
      if qm.rtype != nil {
        let qwt = self.write_type(*qm.rtype);
        if qwt.is_none() {
          q_write_err = true;
        }
      } else {
        self.state.write("void");
      }
      self.state.write(" (*");
      self.state.write(qm.name);
      self.state.write(")(void* self");
      for qarg3 : qm.args {
        self.state.write(", ");
        let qpwt = self.write_type(*qarg3.dtype);
        if qpwt.is_none() {
          q_write_err = true;
        }
      }
      self.state.write(");\n");
    }
    self.state.write("};\n");
    self.state.write("typedef struct ");
    self.state.write(q_mangled);
    self.state.write(" { void* self; const ");
    self.state.write(q_mangled);
    self.state.write("_vtable* vtable; } ");
    self.state.write(q_mangled);
    self.state.write(";\n\n");
    self.state = saved_qvt_state;
    self.type_subst_param_names = prev_params;
    self.type_subst_arg_type_strs = prev_arg_names;
    self.type_subst_arg_is_pointer = prev_arg_ptrs;
    if q_write_err {
      ret .None;
    }
    self.emit_hoisted(qvt_scratch.out.build());
    self.quirk_names.push(q_mangled);
    ret .Some(q_mangled);
  }

  // Emits a monomorphized generic impl method's C prototype without its
  // body, so every method of an instantiation can be forward-declared
  // before any body: one body can call another method declared later.
  // Doesn't reuse `emit_function_param`, which also registers each param
  // as a known local.
  emit_generic_impl_method_prototype(Node m, str new_name) Option<CodegenErrorKind> {
    fit m.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(.InvalidNode);
        }
        let rt = self.write_type(*f.rtype);
        if rt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        // `write_type` writes a type's own `pointer_depth`, not its
        // array-decay; see the matching star in `emit_function_named`'s
        // own return-type write, which this prototype must agree with.
        if dtype_is_array_as_pointer(*f.rtype) {
          self.state.write("*");
        }
        self.state.write(" ");
        self.state.write(new_name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  let sig = v.var_type.fn_sig;
                  let prt = self.write_type(*sig.rtype);
                  if prt.is_none() {
                    ret .Some(.UnsupportedNode);
                  }
                  self.state.write(" (*");
                  self.state.write(v.name);
                  self.state.write(")(");
                  bin pfirst = true;
                  for p : sig.params {
                    if !pfirst {
                      self.state.write(", ");
                    }
                    pfirst = false;
                    let pt = self.write_type(*p);
                    if pt.is_none() {
                      ret .Some(.UnsupportedNode);
                    }
                  }
                  self.state.write(")");
                } else {
                  // An unsized array parameter's decay star must be added
                  // here too, or the prototype and the definition
                  // disagree; see `emit_function_param`.
                  bin arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
                  let wt = self.write_type(*v.var_type);
                  if wt.is_none() {
                    ret .Some(.UnsupportedNode);
                  }
                  if arr_as_ptr {
                    self.state.write("*");
                  }
                  self.state.write(" ");
                  self.state.write(v.name);
                }
              }
              _ -> { ret .Some(.InvalidNode); }
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(");\n");
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Forward-declares an async generic impl method's
  // `__fun_async_call_<new_name>` helper, needed when a sibling async
  // method on the same impl `await`s this one before its support block
  // has been emitted.
  emit_async_call_helper_prototype(Node m, str new_name) Option<CodegenErrorKind> {
    fit m.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(.InvalidNode);
        }
        self.state.write("static ");
        let rt = self.write_type(*f.rtype);
        if rt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        self.state.write(" __fun_async_call_");
        self.state.write(new_name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  ret .Some(.UnsupportedNode);
                }
                if !first {
                  self.state.write(", ");
                }
                first = false;
                let wt = self.write_type(*v.var_type);
                if wt.is_none() {
                  ret .Some(.UnsupportedNode);
                }
              }
              _ -> {}
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(");\n");
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // True when `dt` can't safely appear in the early function/method
  // forward-declare pass: a plain enum, or a generic instantiation of
  // either kind. Unlike a compound, whose bare name is already
  // forward-declared, C can't name an enum without its full definition,
  // and offers no name-only forward-declare for a generic instantiation.
  prototype_type_is_unsafe_early(DataType dt) bin {
    if dt.generic_args.len > 0 {
      ret true;
    }
    // A concrete impl's `self` parameter carries an already-mangled bare
    // name with no generic args, so the check above misses it; detect it
    // by matching a registered generic template's prefix instead.
    for tmpl_name : self.generic_compound_names {
      StringBuilder tmpl_pfx2 = string_builder_init(16);
      tmpl_pfx2.append(tmpl_name);
      tmpl_pfx2.append("__");
      if starts_with(dt.type_str, tmpl_pfx2.build()) {
        ret true;
      }
    }
    for tmpl_name2 : self.generic_enum_names {
      StringBuilder tmpl_pfx3 = string_builder_init(16);
      tmpl_pfx3.append(tmpl_name2);
      tmpl_pfx3.append("__");
      if starts_with(dt.type_str, tmpl_pfx3.build()) {
        ret true;
      }
    }
    for n : self.all_nodes {
      fit n.kind {
        .Enum(e) -> {
          if equals(e.name, dt.type_str) {
            ret true;
          }
        }
        // A quirk's C typedef (its vtable and fat-pointer struct) isn't
        // emitted until its first concrete impl is processed, so it's
        // unsafe here for the same reason a plain enum is. A generic
        // quirk has no monomorphic struct at all.
        .Quirk(q) -> {
          if !q.is_generic && equals(q.name, dt.type_str) {
            ret true;
          }
        }
        _ -> {}
      }
    }
    ret false;
  }

  // True when every one of `n`'s declared param/return types is safe
  // for the early forward-declare pass; see
  // `prototype_type_is_unsafe_early`. A function-pointer-typed parameter
  // is treated as always safe without inspecting its nested types.
  function_prototype_is_safe_early(Node n) bin {
    fit n.kind {
      .Function(f) -> {
        if f.has_rtype && self.prototype_type_is_unsafe_early(*f.rtype) {
          ret false;
        }
        if f.has_args {
          for arg : f.args {
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  continue;
                }
                if self.prototype_type_is_unsafe_early(*v.var_type) {
                  ret false;
                }
              }
              _ -> {}
            }
          }
        }
        ret true;
      }
      _ -> { ret false; }
    }
  }

  // Forward-declares a plain (non-generic) top-level function's or impl
  // method's C prototype under its real name, which for a method is
  // already the pre-mangled `Type__method`.
  emit_function_prototype(Node n) Option<CodegenErrorKind> {
    fit n.kind {
      .Function(f) -> {
        ret self.emit_generic_impl_method_prototype(n, self.effective_function_name(f.name));
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Records the instantiation's substitution context and each method's
  // substituted return and param types, emitting no C. A template
  // method's body may only compile for some of the concrete types it
  // could be instantiated with, so the body is emitted lazily on first
  // call by `ensure_generic_impl_method_emitted`.
  maybe_instantiate_generic_impl_methods(
    str base_name,
    str mangled_name,
    Vec<str> arg_type_names,
    Vec<bin> arg_is_pointer,
    Vec<DataType*> arg_dtypes
  ) {
    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if equals(i.type_name, base_name) && i.type_params.len == arg_type_names.len &&
            impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            self.instantiation_mangled_name.push(mangled_name);
            self.instantiation_base_name.push(base_name);
            self.instantiation_arg_type_names.push(arg_type_names);
            self.instantiation_arg_is_pointer.push(arg_is_pointer);
            self.instantiation_arg_dtypes.push(arg_dtypes);

            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            let prev_arg_dtypes = self.type_subst_arg_dtypes;
            self.type_subst_param_names = i.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_dtypes = arg_dtypes;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            StringBuilder pfx = string_builder_init(16);
            pfx.append(i.type_name);
            pfx.append("__");
            if i.has_quirk_name {
              pfx.append(i.quirk_name);
              pfx.append("__");
            }
            str prefix = pfx.build();

            for m : i.methods {
              str tmpl_name = "";
              DataType* tmpl_rtype = nil;
              Vec<DataType*> tmpl_param_dtypes;
              tmpl_param_dtypes.init(0);
              // Each param's default value expression, `nil` when it has
              // none. Needs no substitution: it's evaluated fresh at the
              // call site.
              Vec<Node*> tmpl_default_values;
              tmpl_default_values.init(0);
              fit m.kind {
                .Function(fnv) -> {
                  tmpl_name = fnv.name;
                  if fnv.has_rtype {
                    tmpl_rtype = fnv.rtype;
                  }
                  if fnv.has_args {
                    bin skipped_tmpl_self = false;
                    for arg : fnv.args {
                      if !skipped_tmpl_self {
                        skipped_tmpl_self = true;
                        continue;
                      }
                      fit arg.kind {
                        .Variable(v) -> {
                          tmpl_param_dtypes.push(v.var_type);
                          if v.has_val {
                            tmpl_default_values.push(v.val);
                          } else {
                            tmpl_default_values.push(nil);
                          }
                        }
                        _ -> {}
                      }
                    }
                  }
                }
                _ -> {}
              }
              let bare_name = strip_prefix(tmpl_name, prefix);

              StringBuilder nb = string_builder_init(16);
              nb.append(mangled_name);
              nb.append("__");
              if i.has_quirk_name {
                nb.append(i.quirk_name);
                nb.append("__");
              }
              nb.append(bare_name);
              str new_name = nb.build();

              // The template's declared return type, substituted against
              // this instantiation's binding, so a `let` can resolve
              // against a monomorphized method's return type.
              DataType* recorded_rtype = nil;
              if tmpl_rtype != nil {
                DataType substituted_rtype = self.resolve_type_subst(*tmpl_rtype);
                recorded_rtype = malloc(sizeof(DataType));
                *recorded_rtype = substituted_rtype;
              }
              // Each param's substituted type too.
              Vec<DataType*> recorded_param_types;
              recorded_param_types.init(0);
              for pdt : tmpl_param_dtypes {
                DataType substituted_pdt = self.resolve_type_subst(*pdt);
                DataType* recorded_pdt = malloc(sizeof(DataType));
                *recorded_pdt = substituted_pdt;
                recorded_param_types.push(recorded_pdt);
              }
              self.record_impl_method(
                mangled_name,
                bare_name,
                new_name,
                recorded_rtype,
                recorded_param_types,
                tmpl_default_values
              );
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
            self.type_subst_arg_dtypes = prev_arg_dtypes;
          }
        }
        _ -> {}
      }
    }
  }

  // Companion to `maybe_instantiate_generic_impl_methods`: builds dynamic
  // dispatch machinery for a generic compound's quirk impl, once per
  // concrete instantiation (`Box<num>` gets its own `__fun_coerce_Box__num_
  // Lenable`, wrapper trampolines, and vtable instance calling into that
  // instantiation's own monomorphized methods). The quirk's vtable struct
  // and fat-pointer type themselves are still shared across every
  // instantiation, since a plain (non-generic) quirk's shape doesn't
  // depend on `T` — `emit_quirk_vtable_machinery` already keys that half
  // by bare quirk name. A doubly-generic quirk (`impl Box<T> as To<T>`,
  // `i.has_quirk_concrete_instantiation`) is out of scope here; its
  // vtable shape would depend on `T` too, needing machinery this doesn't
  // attempt.
  maybe_emit_quirk_vtable_for_instantiation(
    str base_name,
    str mangled_name,
    Vec<str> type_params,
    Vec<str> arg_type_names,
    Vec<bin> arg_is_pointer,
    Vec<DataType*> arg_dtypes
  ) {
    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) || !i.has_quirk_name ||
            i.has_quirk_concrete_instantiation || i.type_params.len != arg_type_names.len {
            continue;
          }
          // `i.has_quirk_concrete_instantiation` only flags a generic
          // quirk already resolved to concrete args at the impl (`impl
          // PtrBox as Box<Node*>`, where `PtrBox` itself isn't generic).
          // It says nothing about a generic quirk whose own argument is
          // still one of the compound's unresolved type params (`impl
          // MapIter<K, V> as Iterator<K>`), checked separately here
          // against the quirk's own declaration: that shape needs a
          // vtable keyed by the resolved `K`, which this machinery
          // doesn't build, so it's skipped rather than misfiring with a
          // stale, unsubstituted vtable shape.
          bin quirk_itself_generic = false;
          num qdi = 0;
          for qdi < self.quirk_decl_names.len {
            if equals(self.quirk_decl_names.get(qdi), i.quirk_name) {
              if self.quirk_decl_type_params.get(qdi).len > 0 {
                quirk_itself_generic = true;
              }
              break;
            }
            qdi = qdi + 1;
          }
          if quirk_itself_generic {
            continue;
          }
          // A forced instantiation (`impl Map<str, num> as Display`) only
          // applies to a matching set of concrete arguments; without this
          // check it would also misfire on an unrelated instantiation
          // sharing the same argument COUNT (`Map<str, str>`), building a
          // vtable off a substitution that maps two different forced
          // names onto one instantiation's arguments.
          if !impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            continue;
          }
          let prev_params = self.type_subst_param_names;
          let prev_arg_names = self.type_subst_arg_type_strs;
          let prev_arg_ptrs = self.type_subst_arg_is_pointer;
          let prev_arg_dtypes = self.type_subst_arg_dtypes;
          self.type_subst_param_names = type_params;
          self.type_subst_arg_type_strs = arg_type_names;
          self.type_subst_arg_is_pointer = arg_is_pointer;
          self.type_subst_arg_dtypes = arg_dtypes;
          str prev_override = self.quirk_inst_override_name;
          self.quirk_inst_override_name = mangled_name;

          // Writes real struct/function definitions, not just
          // declarations, so it can't go straight to `self.state`: this
          // is reached mid-body, resolving a local's declared type, the
          // same trigger point `ensure_compound_instantiated` hoists its
          // own struct body from. The whole splice, vtable machinery
          // and each method's own monomorphized body alike, has to land
          // in one safe, hoisted block: `self.state` here can be an
          // unrelated compound's own in-progress struct scratch (this
          // whole call chain started from `ensure_compound_instantiated`,
          // reachable from a field dependency, not just a real
          // statement). `ensure_generic_impl_method_emitted` below calls
          // `emit_hoisted` itself, which resolves against whatever
          // `hoist_insert_pos`/`hoist_scratch_depth` happen to be at that
          // moment; left at the caller's ambient values, a stale position
          // captured for the outer real buffer would get applied against
          // this small throwaway `qv_scratch` instead. Pinning both to
          // "no position, no nesting" for the duration forces every
          // nested `emit_hoisted` down the plain `self.state.write`
          // path, landing in `qv_scratch`, exactly where this needs it,
          // and the ambient values are restored before the real
          // splice below, which needs them intact.
          CodegenState qv_scratch = codegen_state_new();
          CodegenState* saved_qv_state = self.state;
          let saved_qv_hoist_pos = self.hoist_insert_pos;
          let saved_qv_scratch_depth = self.hoist_scratch_depth;
          // `ensure_generic_impl_method_emitted`'s own prototype-splicing
          // (below) reads `current_stmt_start_pos`, not just
          // `hoist_insert_pos`, to decide where to splice; left at the
          // caller's stale value, that position is only valid against the
          // outer real buffer, not this tiny `qv_scratch`, and splicing
          // against it here is an out-of-bounds substring read.
          let saved_qv_stmt_start_pos = self.current_stmt_start_pos;
          self.state = &qv_scratch;
          self.hoist_insert_pos = .None;
          self.hoist_scratch_depth = 0;
          self.current_stmt_start_pos = .None;
          self.emit_quirk_vtable_machinery(tmpl);

          // The vtable's wrappers call straight through to each method's
          // own monomorphized body, which nothing else triggers: a
          // dynamically-dispatched `la.size()` never names
          // `Box__num__Lenable__size` in the source the way a static
          // `bn.size()` call would. `ensure_generic_impl_method_emitted`
          // is the same lazy trigger a static call site uses, keyed and
          // deduped off `self.instantiation_*`, which `.push`ed this
          // instantiation's binding just above in
          // `maybe_instantiate_generic_impl_methods`. Draining is
          // suppressed here: this runs the moment the compound is first
          // instantiated, which is too early for a method body that
          // references some other type by value (`sizeof(JsonValue)`
          // inside `Map<str, JsonValue>`'s own `clear()`); that other
          // type's own full definition isn't necessarily emitted yet at
          // this point, only forward-declared. Enqueuing without
          // draining defers the actual body to `transpile`'s own
          // end-of-program drain below, by which point everything the
          // program ever uses has already been emitted at least once.
          StringBuilder qm_pfx_sb = string_builder_init(16);
          qm_pfx_sb.append(base_name);
          qm_pfx_sb.append("__");
          qm_pfx_sb.append(i.quirk_name);
          qm_pfx_sb.append("__");
          str qm_prefix = qm_pfx_sb.build();
          bin prev_suppress_qv = self.suppress_generic_impl_method_draining;
          self.suppress_generic_impl_method_draining = true;
          for m : i.methods {
            fit m.kind {
              .Function(fnv) -> {
                let qm_bare = strip_prefix(fnv.name, qm_prefix);
                self.ensure_generic_impl_method_emitted(mangled_name, qm_bare, i.quirk_name);
              }
              _ -> {}
            }
          }
          self.suppress_generic_impl_method_draining = prev_suppress_qv;

          self.state = saved_qv_state;
          self.hoist_insert_pos = saved_qv_hoist_pos;
          self.hoist_scratch_depth = saved_qv_scratch_depth;
          self.current_stmt_start_pos = saved_qv_stmt_start_pos;
          self.emit_hoisted(qv_scratch.out.build());

          self.quirk_inst_override_name = prev_override;
          self.type_subst_param_names = prev_params;
          self.type_subst_arg_type_strs = prev_arg_names;
          self.type_subst_arg_is_pointer = prev_arg_ptrs;
          self.type_subst_arg_dtypes = prev_arg_dtypes;
        }
        _ -> {}
      }
    }
  }

  // Writes one generic impl method's prototype immediately, wherever
  // `self.state` currently is; a bare declaration is legal C at block
  // scope. Called before the body is queued for deferred emission, so
  // that body can call another not-yet-bodied method of the same
  // instantiation. A no-op when `owner_type` isn't a known instantiation
  // or `self.state` points at a throwaway text-capture probe.
  // `quirk_name`, when non-empty, narrows the search to that quirk's
  // own impl, same as `emit_one_generic_impl_method`.
  emit_generic_impl_method_prototype_now(str owner_type, str bare_name, str quirk_name) {
    num ii = 0;
    bin found_inst = false;
    for ii < self.instantiation_mangled_name.len {
      if equals(self.instantiation_mangled_name.get(ii), owner_type) {
        found_inst = true;
        break;
      }
      ii = ii + 1;
    }
    if !found_inst {
      ret;
    }
    str base_name = self.instantiation_base_name.get(ii);
    let arg_type_names = self.instantiation_arg_type_names.get(ii);
    let arg_is_pointer = self.instantiation_arg_is_pointer.get(ii);
    let arg_dtypes = self.instantiation_arg_dtypes.get(ii);

    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) || i.type_params.len != arg_type_names.len {
            continue;
          }
          if !equals(quirk_name, "") &&
            (!i.has_quirk_name || !equals(i.quirk_name, quirk_name)) {
            continue;
          }
          if !impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            continue;
          }
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          if i.has_quirk_name {
            pfx.append(i.quirk_name);
            pfx.append("__");
          }
          str prefix = pfx.build();

          for m : i.methods {
            str tmpl_name = "";
            fit m.kind {
              .Function(fnv) -> { tmpl_name = fnv.name; }
              _ -> {}
            }
            if !equals(strip_prefix(tmpl_name, prefix), bare_name) {
              continue;
            }

            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            let prev_arg_dtypes = self.type_subst_arg_dtypes;
            self.type_subst_param_names = i.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_dtypes = arg_dtypes;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            StringBuilder nb = string_builder_init(16);
            nb.append(owner_type);
            nb.append("__");
            if i.has_quirk_name {
              nb.append(i.quirk_name);
              nb.append("__");
            }
            nb.append(bare_name);
            str new_name = nb.build();

            // Pre-resolves the method's return and param types before
            // `self.state` swaps to the scratch buffer below, so a
            // generic instantiation triggered by one of them splices its
            // typedef at top level, not into the scratch. Also collects
            // each resolved name, so a splice against `current_fn_body_
            // start_pos` below can confirm they're all already declared
            // ahead of that position before trusting it.
            Vec<str> proto_type_names;
            proto_type_names.init(2);
            fit m.kind {
              .Function(proto_fnv) -> {
                if proto_fnv.has_rtype {
                  let proto_rt_name = self.resolve_type_name(self.resolve_type_subst(*proto_fnv.rtype));
                  if proto_rt_name.is_some() {
                    proto_type_names.push(proto_rt_name.unwrap());
                  }
                }
                if proto_fnv.has_args {
                  for proto_arg : proto_fnv.args {
                    fit proto_arg.kind {
                      .Variable(proto_v) -> {
                        if !proto_v.var_type.has_fn_sig {
                          let proto_pt_name = self.resolve_type_name(self.resolve_type_subst(*proto_v.var_type));
                          if proto_pt_name.is_some() {
                            proto_type_names.push(proto_pt_name.unwrap());
                          }
                        }
                      }
                      _ -> {}
                    }
                  }
                }
              }
              _ -> {}
            }

            // Built into a scratch buffer, then spliced at the current
            // statement's start: writing at the live tail would land
            // mid-statement when the triggering call is a sub-expression.
            CodegenState proto_scratch = codegen_state_new();
            CodegenState* saved_proto_state = self.state;
            let saved_proto_hoist_pos = self.hoist_insert_pos;
            proto_scratch.indent_level = saved_proto_state.indent_level;
            self.state = &proto_scratch;
            self.hoist_insert_pos = .None;
            self.state.write_indent();
            self.emit_generic_impl_method_prototype(*m, new_name);
            self.state = saved_proto_state;
            str proto_text = proto_scratch.out.build();
            if self.hoist_scratch_depth > 0 {
              // Nested inside a generic method's own lazily-drained
              // body: `self.state` here is that method's own scratch
              // buffer, not the root buffer, so `current_stmt_start_
              // pos` (freshly set against whichever buffer `emit_
              // statements` last dispatched a statement into) would be
              // relative to the wrong buffer entirely, splicing this
              // prototype inside the scratch text rather than at file
              // scope. Forcing `hoist_insert_pos` to `.None` routes
              // this through `emit_hoisted`'s own root-relative path
              // instead, via `root_hoist_pos`.
              self.hoist_insert_pos = .None;
              self.emit_hoisted(proto_text);
              self.hoist_insert_pos = saved_proto_hoist_pos;
            } else {
              let proto_splice_pos = self.fn_proto_splice_pos(proto_type_names).pos;
              self.hoist_insert_pos = proto_splice_pos;
              self.emit_hoisted(proto_text);
              // A captured local, so it needs the shift `emit_hoisted`
              // applies automatically only to `current_stmt_start_pos`.
              if proto_splice_pos.is_some() {
                saved_proto_hoist_pos = adjust_pos_after_splice(
                  saved_proto_hoist_pos,
                  proto_splice_pos.unwrap(),
                  len(proto_text)
                );
              }
              self.hoist_insert_pos = saved_proto_hoist_pos;
            }

            // An async method's call-helper forward declaration is
            // `static`, which C forbids at block scope, so it is spliced
            // at the top-level position instead.
            fit m.kind {
              .Function(proto_async_fnv) -> {
                if proto_async_fnv.is_async {
                  CodegenState async_proto_scratch = codegen_state_new();
                  CodegenState* saved_async_state = self.state;
                  self.state = &async_proto_scratch;
                  self.emit_async_call_helper_prototype(*m, new_name);
                  self.state = saved_async_state;
                  self.emit_hoisted(async_proto_scratch.out.build());
                }
              }
              _ -> {}
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
            self.type_subst_arg_dtypes = prev_arg_dtypes;
            ret;
          }
        }
        _ -> {}
      }
    }
  }

  // Ensures a plain (non-generic) impl method has an inline prototype
  // declared right before its first call site, when its signature was too
  // unsafe for the early forward-declare pass. A no-op when the method is
  // unknown, its signature is already safe, it already has a prototype,
  // or `self.state` points at a throwaway text-capture probe.
  ensure_plain_impl_method_prototype_emitted(str owner_type, str bare_name) {
    // See `ensure_plain_function_prototype_emitted`: only bails outright
    // with no scratch depth to route the splice through.
    if self.suppress_generic_impl_method_draining && self.hoist_scratch_depth == 0 {
      ret;
    }
    StringBuilder pm_key_sb = string_builder_init(16);
    pm_key_sb.append(owner_type);
    pm_key_sb.append("::");
    pm_key_sb.append(bare_name);
    str pm_key = pm_key_sb.build();
    num pmki = 0;
    for pmki < self.emitted_plain_method_protos.len {
      if equals(self.emitted_plain_method_protos.get(pmki), pm_key) {
        ret;
      }
      pmki = pmki + 1;
    }

    num pmi = 0;
    bin found_pm = false;
    for pmi < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(pmi), owner_type) &&
        equals(
        self.impl_method_bare_name.get(pmi),
        bare_name
      ) {
        found_pm = true;
        break;
      }
      pmi = pmi + 1;
    }
    if !found_pm {
      ret;
    }
    DataType* pm_rtype = self.impl_method_rtype.get(pmi);
    if pm_rtype == nil {
      ret;
    }
    let pm_param_types = self.impl_method_param_types.get(pmi);
    for pm_pt : pm_param_types {
      if pm_pt.has_fn_sig {
        ret;
      }
    }

    // The receiver's type needs the same "not yet defined this early"
    // check as any other param, since `impl_method_param_types` excludes
    // the implicit `self`. Narrower than
    // `prototype_type_is_unsafe_early`: just the plain-enum and quirk
    // name check, since a mangled generic instantiation has its own path.
    bin pm_owner_unsafe = false;
    for pm_owner_n : self.all_nodes {
      fit pm_owner_n.kind {
        .Enum(pm_oe) -> {
          if equals(pm_oe.name, owner_type) {
            pm_owner_unsafe = true;
          }
        }
        .Quirk(pm_oq) -> {
          if !pm_oq.is_generic && equals(pm_oq.name, owner_type) {
            pm_owner_unsafe = true;
          }
        }
        _ -> {}
      }
    }
    bin pm_unsafe = pm_owner_unsafe;
    if !pm_unsafe {
      pm_unsafe = self.prototype_type_is_unsafe_early(*pm_rtype);
    }
    if !pm_unsafe {
      for pm_pt2 : pm_param_types {
        if self.prototype_type_is_unsafe_early(*pm_pt2) {
          pm_unsafe = true;
        }
      }
    }
    if !pm_unsafe {
      ret;
    }

    str pm_mangled = self.impl_method_mangled_name.get(pmi);

    // Pre-resolved before swapping to the scratch buffer below, so a
    // generic instantiation triggered by one of these types splices at
    // top level rather than into the scratch. Also collects each
    // resolved name (plus the receiver's own type), so a splice
    // against `current_fn_body_start_pos` below can confirm they're
    // all already declared ahead of that position before trusting it.
    Vec<str> pm_type_names;
    pm_type_names.init(2);
    pm_type_names.push(owner_type);
    let pm_rt_pre = self.resolve_type_name(*pm_rtype);
    if pm_rt_pre.is_some() {
      pm_type_names.push(pm_rt_pre.unwrap());
    }
    for pm_pt3 : pm_param_types {
      let pm_pt3_name = self.resolve_type_name(*pm_pt3);
      if pm_pt3_name.is_some() {
        pm_type_names.push(pm_pt3_name.unwrap());
      }
    }

    CodegenState pm_scratch = codegen_state_new();
    CodegenState* saved_pm_state = self.state;
    let saved_pm_hoist_pos = self.hoist_insert_pos;
    pm_scratch.indent_level = saved_pm_state.indent_level;
    self.state = &pm_scratch;
    self.hoist_insert_pos = .None;
    self.state.write_indent();
    let pm_rt = self.write_type(*pm_rtype);
    // Matches the extra star the real definition writes for an
    // array-decayed return type; see the same fix in
    // `ensure_plain_function_prototype_emitted`.
    if dtype_is_array_as_pointer(*pm_rtype) {
      self.state.write("*");
    }
    if pm_rt.is_some() {
      self.state.write(" ");
      self.state.write(pm_mangled);
      self.state.write("(");
      self.state.write(owner_type);
      self.state.write("* self");
      for pm_pt4 : pm_param_types {
        self.state.write(", ");
        self.write_type(*pm_pt4);
      }
      self.state.write(");\n");
    }
    self.state = saved_pm_state;
    str pm_text = pm_scratch.out.build();
    if self.hoist_scratch_depth > 0 {
      // See the matching branch in `emit_generic_impl_method_prototype_
      // now`: `self.state` here is a nested scratch buffer, not root,
      // so this has to route through `root_hoist_pos` instead. That
      // path always lands at file scope, so it's safe to remember for
      // every future call site the same way the broad branches below
      // are.
      self.emitted_plain_method_protos.push(pm_key);
      self.hoist_insert_pos = .None;
      self.emit_hoisted(pm_text);
      self.hoist_insert_pos = saved_pm_hoist_pos;
    } else {
      // `saved_pm_hoist_pos` is a plain captured local, so it needs
      // manual adjustment for this splice. Only remembered for future
      // call sites when the splice itself landed somewhere broadly
      // visible - see `ProtoSplice`'s own doc comment.
      let pm_splice = self.fn_proto_splice_pos(pm_type_names);
      if pm_splice.broad {
        self.emitted_plain_method_protos.push(pm_key);
      }
      let pm_splice_pos = pm_splice.pos;
      self.hoist_insert_pos = pm_splice_pos;
      self.emit_hoisted(pm_text);
      if pm_splice_pos.is_some() {
        saved_pm_hoist_pos = adjust_pos_after_splice(
          saved_pm_hoist_pos,
          pm_splice_pos.unwrap(),
          len(pm_text)
        );
      }
      self.hoist_insert_pos = saved_pm_hoist_pos;
    }
  }

  // The C name to emit for the program-defined function `name`: prefixed
  // when it would otherwise shadow a C binding of the same name; see
  // `Codegen.c_shadow_names`. Lookups keyed by the Fun name still use the
  // bare one.
  effective_function_name(str name) str {
    if !self.c_shadow_names.contains(name) {
      ret name;
    }
    StringBuilder sb = string_builder_init(16);
    sb.append("__fun_shadow__");
    sb.append(name);
    ret sb.build();
  }

  // The C name to emit for a call's callee: alias-qualified calls name a
  // C binding directly and keep their raw name.
  emit_callee_name(str name, bin alias_qualified) str {
    if alias_qualified {
      ret name;
    }
    ret self.effective_function_name(name);
  }

  // Ensures a plain top-level function (not an impl method) has an inline
  // prototype declared right before its first call site, when its
  // signature is unsafe for the early forward-declare pass. Follows
  // `ensure_plain_impl_method_prototype_emitted`, sourced from the
  // plain-function registry and with no `self` param to prepend.
  ensure_plain_function_prototype_emitted(str fn_name) {
    // Only bails outright when there's no scratch depth to route
    // through: `emit_hoisted` below already splices safely into the
    // root buffer whenever `hoist_scratch_depth > 0`, so a plain
    // (non-generic-impl-method) prototype request nested in a call's
    // return-type probe doesn't need the deferral generic impl methods
    // use this flag for.
    if self.suppress_generic_impl_method_draining && self.hoist_scratch_depth == 0 {
      ret;
    }
    num pfi = 0;
    for pfi < self.emitted_plain_function_protos.len {
      if equals(self.emitted_plain_function_protos.get(pfi), fn_name) {
        ret;
      }
      pfi = pfi + 1;
    }

    num fi = 0;
    bin found_pf = false;
    for fi < self.function_names.len {
      if equals(self.function_names.get(fi), fn_name) {
        found_pf = true;
        break;
      }
      fi = fi + 1;
    }
    if !found_pf {
      ret;
    }
    DataType* pf_rtype = self.function_rtypes.get(fi);
    if pf_rtype == nil {
      ret;
    }
    let pf_param_types = self.function_param_types.get(fi);
    for pf_pt : pf_param_types {
      if pf_pt.has_fn_sig {
        ret;
      }
    }

    bin pf_unsafe = self.prototype_type_is_unsafe_early(*pf_rtype);
    if !pf_unsafe {
      for pf_pt2 : pf_param_types {
        if self.prototype_type_is_unsafe_early(*pf_pt2) {
          pf_unsafe = true;
        }
      }
    }
    if !pf_unsafe {
      ret;
    }

    // Collects each resolved name, so a splice against `current_fn_
    // body_start_pos` below can confirm they're all already declared
    // ahead of that position before trusting it.
    Vec<str> pf_type_names;
    pf_type_names.init(2);
    let pf_rt_pre = self.resolve_type_name(*pf_rtype);
    if pf_rt_pre.is_some() {
      pf_type_names.push(pf_rt_pre.unwrap());
    }
    for pf_pt3 : pf_param_types {
      let pf_pt3_name = self.resolve_type_name(*pf_pt3);
      if pf_pt3_name.is_some() {
        pf_type_names.push(pf_pt3_name.unwrap());
      }
    }

    CodegenState pf_scratch = codegen_state_new();
    CodegenState* saved_pf_state = self.state;
    let saved_pf_hoist_pos = self.hoist_insert_pos;
    pf_scratch.indent_level = saved_pf_state.indent_level;
    self.state = &pf_scratch;
    self.hoist_insert_pos = .None;
    self.state.write_indent();
    let pf_rt = self.write_type(*pf_rtype);
    // Matches the same extra star the real definition writes for an
    // array-decayed return type (`emit_function_named`); left off here,
    // this inline prototype disagreed with it and the C compiler saw two
    // conflicting declarations for the same function.
    if dtype_is_array_as_pointer(*pf_rtype) {
      self.state.write("*");
    }
    if pf_rt.is_some() {
      self.state.write(" ");
      self.state.write(self.effective_function_name(fn_name));
      self.state.write("(");
      bin pf_first = true;
      for pf_pt4 : pf_param_types {
        if !pf_first {
          self.state.write(", ");
        }
        pf_first = false;
        self.write_type(*pf_pt4);
        // An array parameter decays to a pointer, matching what the
        // definition writes.
        if dtype_is_array_as_pointer(*pf_pt4) {
          self.state.write("*");
        }
      }
      if pf_first {
        self.state.write("void");
      }
      self.state.write(");\n");
    }
    self.state = saved_pf_state;
    str pf_text = pf_scratch.out.build();
    if self.hoist_scratch_depth > 0 {
      // See the matching branch in `emit_generic_impl_method_prototype_
      // now`: `self.state` here is a nested scratch buffer, not root,
      // so this has to route through `root_hoist_pos` instead. That
      // path always lands at file scope, so it's safe to remember for
      // every future call site the same way the broad branches below
      // are.
      self.emitted_plain_function_protos.push(fn_name);
      self.hoist_insert_pos = .None;
      self.emit_hoisted(pf_text);
      self.hoist_insert_pos = saved_pf_hoist_pos;
    } else {
      // `saved_pf_hoist_pos` is a captured local, so this splice needs a
      // manual adjustment. Only remembered for future call sites when
      // the splice itself landed somewhere broadly visible - see
      // `ProtoSplice`'s own doc comment.
      let pf_splice = self.fn_proto_splice_pos(pf_type_names);
      if pf_splice.broad {
        self.emitted_plain_function_protos.push(fn_name);
      }
      let pf_splice_pos = pf_splice.pos;
      self.hoist_insert_pos = pf_splice_pos;
      self.emit_hoisted(pf_text);
      if pf_splice_pos.is_some() {
        saved_pf_hoist_pos = adjust_pos_after_splice(
          saved_pf_hoist_pos,
          pf_splice_pos.unwrap(),
          len(pf_text)
        );
      }
      self.hoist_insert_pos = saved_pf_hoist_pos;
    }
  }

  // Resolves the quirk name a `bare_name` lookup on `owner_type`
  // actually lands on, given the caller's own `requested_quirk`. A
  // non-empty request is trusted outright: the quirk vtable machinery
  // already knows exactly which quirk it means. An empty request (an
  // ordinary static call site, `v.len()`) mirrors the same search
  // `emit_one_generic_impl_method` runs later, so it agrees with
  // whichever impl that search would land on: for a method that exists
  // ONLY via one quirk impl (`Vec<T>`'s `len()`, from `Sized`, with no
  // plain-impl duplicate), a plain call site and the vtable's own
  // explicit lookup must resolve to the SAME canonical identity, or
  // the method gets emitted twice under two different dedup keys.
  // Empty when nothing matches, same as the real lookup would find.
  resolve_generic_impl_quirk_for_bare(str owner_type, str bare_name, str requested_quirk) str {
    if !equals(requested_quirk, "") {
      ret requested_quirk;
    }
    num ii = 0;
    bin found_inst = false;
    for ii < self.instantiation_mangled_name.len {
      if equals(self.instantiation_mangled_name.get(ii), owner_type) {
        found_inst = true;
        break;
      }
      ii = ii + 1;
    }
    if !found_inst {
      ret "";
    }
    str base_name = self.instantiation_base_name.get(ii);
    let arg_type_names = self.instantiation_arg_type_names.get(ii);
    let arg_dtypes = self.instantiation_arg_dtypes.get(ii);
    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) || i.type_params.len != arg_type_names.len {
            continue;
          }
          if !impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            continue;
          }
          StringBuilder rq_pfx_sb = string_builder_init(16);
          rq_pfx_sb.append(i.type_name);
          rq_pfx_sb.append("__");
          if i.has_quirk_name {
            rq_pfx_sb.append(i.quirk_name);
            rq_pfx_sb.append("__");
          }
          str rq_prefix = rq_pfx_sb.build();
          for m : i.methods {
            str rq_tmpl_name = "";
            fit m.kind {
              .Function(rq_fnv) -> { rq_tmpl_name = rq_fnv.name; }
              _ -> {}
            }
            if equals(strip_prefix(rq_tmpl_name, rq_prefix), bare_name) {
              if i.has_quirk_name {
                ret i.quirk_name;
              }
              ret "";
            }
          }
        }
        _ -> {}
      }
    }
    ret "";
  }

  // Lazily emits one monomorphization of a generic impl method's
  // prototype and body, called from every generic-impl-method call site,
  // so a method is emitted only for the instantiations actually called.
  // Enqueues rather than recursing directly, draining only when not
  // already draining, since a queued body may call another not-yet-
  // emitted method while `self.state` is the outer method's scratch
  // buffer. `.None` when `owner_type` isn't a known instantiation.
  // `quirk_name` narrows the lookup to one specific quirk impl (see
  // `emitted_generic_impl_methods`); every ordinary static-call site
  // passes `""`, resolved against the real target impl below rather
  // than trusted as-is, so it can't disagree with a quirk-qualified
  // call site over the identity of a quirk-only method.
  ensure_generic_impl_method_emitted(str owner_type, str bare_name, str quirk_name) Option<CodegenErrorKind> {
    str resolved_quirk = self.resolve_generic_impl_quirk_for_bare(
      owner_type,
      bare_name,
      quirk_name
    );
    StringBuilder key_sb = string_builder_init(16);
    key_sb.append(owner_type);
    key_sb.append("::");
    key_sb.append(resolved_quirk);
    key_sb.append("::");
    key_sb.append(bare_name);
    str key = key_sb.build();
    num ei = 0;
    for ei < self.emitted_generic_impl_methods.len {
      if equals(self.emitted_generic_impl_methods.get(ei), key) {
        ret .None;
      }
      ei = ei + 1;
    }
    // Pushed before this entry is processed, so a self-recursive call
    // sees "already handled" rather than recursing forever.
    self.emitted_generic_impl_methods.push(key);
    bin proto_written = !self.suppress_generic_impl_method_draining;
    if proto_written {
      self.emit_generic_impl_method_prototype_now(owner_type, bare_name, resolved_quirk);
    }
    self.pending_generic_impl_method_owner.push(owner_type);
    self.pending_generic_impl_method_bare.push(bare_name);
    self.pending_generic_impl_method_quirk.push(resolved_quirk);
    self.pending_generic_impl_method_proto_written.push(proto_written);

    // Also deferred while `self.state` points at a throwaway probe; the
    // probe drains this queue once it restores the real buffer.
    if self.draining_generic_impl_methods || self.suppress_generic_impl_method_draining {
      ret .None;
    }
    ret self.drain_pending_generic_impl_methods();
  }

  // Processes every queued (owner, bare name, quirk name) triple. Writes
  // straight to `self.state`/`self.hoist_insert_pos`, so the caller must
  // have restored the real ones first.
  drain_pending_generic_impl_methods() Option<CodegenErrorKind> {
    self.draining_generic_impl_methods = true;
    // Not saved and restored around the whole drain: each splice this
    // loop makes advances `current_stmt_start_pos`, and restoring the
    // pre-drain value would undo that.
    Option<CodegenErrorKind> first_err = .None;
    num qi = self.pending_generic_impl_method_cursor;
    for qi < self.pending_generic_impl_method_owner.len {
      let q_owner = self.pending_generic_impl_method_owner.get(qi);
      let q_bare = self.pending_generic_impl_method_bare.get(qi);
      let q_quirk = self.pending_generic_impl_method_quirk.get(qi);
      if !self.pending_generic_impl_method_proto_written.get(qi) {
        self.emit_generic_impl_method_prototype_now(q_owner, q_bare, q_quirk);
      }
      let err = self.emit_one_generic_impl_method(q_owner, q_bare, q_quirk);
      if err.is_some() && first_err.is_none() {
        first_err = err;
      }
      qi = qi + 1;
      self.pending_generic_impl_method_cursor = qi;
    }
    self.draining_generic_impl_methods = false;
    ret first_err;
  }

  // Emits the body for one queued (owner, bare name, quirk name)
  // triple; the prototype is already written by now. `quirk_name`,
  // when non-empty, restricts matching to the impl that implements
  // that specific quirk, so a plain method and a same-named quirk
  // method on the same type (`Vec<T>`'s own `clear()` next to its
  // `Clearable` quirk's `clear()`) can't shadow each other.
  emit_one_generic_impl_method(str owner_type, str bare_name, str quirk_name) Option<CodegenErrorKind> {
    num ii = 0;
    bin found_inst = false;
    for ii < self.instantiation_mangled_name.len {
      if equals(self.instantiation_mangled_name.get(ii), owner_type) {
        found_inst = true;
        break;
      }
      ii = ii + 1;
    }
    if !found_inst {
      ret .None;
    }
    str base_name = self.instantiation_base_name.get(ii);
    let arg_type_names = self.instantiation_arg_type_names.get(ii);
    let arg_is_pointer = self.instantiation_arg_is_pointer.get(ii);
    let arg_dtypes = self.instantiation_arg_dtypes.get(ii);

    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) || i.type_params.len != arg_type_names.len {
            continue;
          }
          // An empty `quirk_name` keeps the original behavior of
          // matching whichever impl (plain or quirk) provides the bare
          // name first, since most call sites here have no quirk to
          // disambiguate with in the first place. Only a non-empty
          // `quirk_name` narrows the search, and only to that quirk.
          if !equals(quirk_name, "") &&
            (!i.has_quirk_name || !equals(i.quirk_name, quirk_name)) {
            continue;
          }
          if !impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            continue;
          }
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          if i.has_quirk_name {
            pfx.append(i.quirk_name);
            pfx.append("__");
          }
          str prefix = pfx.build();

          for m : i.methods {
            str tmpl_name = "";
            fit m.kind {
              .Function(fnv) -> { tmpl_name = fnv.name; }
              _ -> {}
            }
            if !equals(strip_prefix(tmpl_name, prefix), bare_name) {
              continue;
            }

            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            let prev_arg_dtypes = self.type_subst_arg_dtypes;
            self.type_subst_param_names = i.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_dtypes = arg_dtypes;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            StringBuilder nb = string_builder_init(16);
            nb.append(owner_type);
            nb.append("__");
            if i.has_quirk_name {
              nb.append(i.quirk_name);
              nb.append("__");
            }
            nb.append(bare_name);
            str new_name = nb.build();

            CodegenState method_scratch = codegen_state_new();
            CodegenState* saved_method_state = self.state;
            let saved_hoist_pos = self.hoist_insert_pos;
            // `emit_function_named` recurses into `emit_statements`,
            // which sets `current_stmt_start_pos` against this scratch
            // buffer, so it is suspended and restored in lockstep with
            // `hoist_insert_pos` and can't leak a scratch-relative
            // position to a caller splicing against the real buffer.
            let saved_stmt_start_pos = self.current_stmt_start_pos;
            // `suppress_generic_impl_method_draining` is left alone: this
            // runs only inside `drain_pending_generic_impl_methods`'s
            // loop, which already keeps `draining_generic_impl_methods`
            // set, so a nested trigger just enqueues.
            let saved_local_names = self.local_names;
            let saved_local_is_pointer = self.local_is_pointer;
            let saved_local_type_name = self.local_type_name;
            let saved_local_dtype = self.local_dtype;
            let saved_fn_rtype_name = self.current_fn_rtype_name;
            let saved_fn_rtype_dt = self.current_fn_rtype_dt;
            let saved_defer_stack = self.defer_stack;
            let saved_defer_scope_starts = self.defer_scope_starts;
            // Shares the `hoist_scratch_depth` nesting counter with the
            // other scratch-buffer swaps, since this body can trigger
            // another one recursively.
            if self.hoist_scratch_depth == 0 {
              self.root_state = self.state;
              self.root_hoist_pos = self.hoist_insert_pos;
              self.root_stmt_start_pos = self.current_stmt_start_pos;
            }
            self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
            self.state = &method_scratch;
            self.hoist_insert_pos = .None;
            self.current_stmt_start_pos = .None;
            let body_err = self.emit_function_named(*m, new_name);
            self.state = saved_method_state;
            self.hoist_insert_pos = saved_hoist_pos;
            self.current_stmt_start_pos = saved_stmt_start_pos;
            self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
            if self.hoist_scratch_depth == 0 {
              // The just-restored local snapshots above can be stale.
              self.hoist_insert_pos = self.root_hoist_pos;
              self.current_stmt_start_pos = self.root_stmt_start_pos;
            }
            self.local_names = saved_local_names;
            self.local_is_pointer = saved_local_is_pointer;
            self.local_type_name = saved_local_type_name;
            self.local_dtype = saved_local_dtype;
            self.current_fn_rtype_name = saved_fn_rtype_name;
            self.current_fn_rtype_dt = saved_fn_rtype_dt;
            self.defer_stack = saved_defer_stack;
            self.defer_scope_starts = saved_defer_scope_starts;
            self.emit_hoisted(method_scratch.out.build());

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
            self.type_subst_arg_dtypes = prev_arg_dtypes;
            ret body_err;
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // True when `bare_name`, resolved against `owner_type`'s impl template,
  // declares its own generic type params on top of the impl's
  // (`impl Box<T> { pub wrap<U>(U x) Box<U> { ... } }`).
  impl_method_has_own_type_params(str owner_type, str bare_name) bin {
    // A plain impl's own methods can declare type params too, and are
    // monomorphized through the same path with an empty impl-level
    // substitution.
    for n : self.all_nodes {
      fit n.kind {
        .Impl(pi) -> {
          if !pi.has_type_params && equals(pi.type_name, owner_type) {
            StringBuilder ppfx = string_builder_init(16);
            ppfx.append(pi.type_name);
            ppfx.append("__");
            str ptpfx = ppfx.build();
            for pm : pi.methods {
              fit pm.kind {
                .Function(pfn) -> {
                  if pfn.has_type_params &&
                    equals(strip_prefix(pfn.name, ptpfx), bare_name) {
                    ret true;
                  }
                }
                _ -> {}
              }
            }
          }
        }
        _ -> {}
      }
    }
    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          str tpfx = pfx.build();
          if !starts_with(owner_type, tpfx) {
            continue;
          }
          for m : i.methods {
            fit m.kind {
              .Function(fnv) -> {
                if fnv.has_type_params &&
                  equals(strip_prefix(fnv.name, tpfx), bare_name) {
                  ret true;
                }
              }
              _ -> {}
            }
          }
        }
        _ -> {}
      }
    }
    ret false;
  }

  // Monomorphizes a method that declares its own generic type params,
  // combining the impl's known substitution with a fresh one inferred
  // from `args`. Signature and body are hoisted together to the current
  // statement's position, with no separate prototype step. Returns the
  // combined mangled name plus the substituted return type, or `.None`
  // when inference fails.
  // 
  // A plain impl contributes no substitution of its own, so the combined
  // one reduces to the method's own params.
  maybe_instantiate_generic_impl_method_own_params(str owner_type, str bare_name, Vec<Node*> args) Option<OwnParamCallResolution> {
    num ii = 0;
    bin found_inst = false;
    for ii < self.instantiation_mangled_name.len {
      if equals(self.instantiation_mangled_name.get(ii), owner_type) {
        found_inst = true;
        break;
      }
      ii = ii + 1;
    }

    str base_name = owner_type;
    Vec<str> impl_arg_type_names;
    impl_arg_type_names.init(0);
    Vec<bin> impl_arg_is_pointer;
    impl_arg_is_pointer.init(0);
    Vec<DataType*> impl_arg_dtypes;
    impl_arg_dtypes.init(0);
    Vec<Node> candidates;
    candidates.init(0);
    if found_inst {
      base_name = self.instantiation_base_name.get(ii);
      impl_arg_type_names = self.instantiation_arg_type_names.get(ii);
      impl_arg_is_pointer = self.instantiation_arg_is_pointer.get(ii);
      impl_arg_dtypes = self.instantiation_arg_dtypes.get(ii);
      for gt : self.generic_impl_templates {
        candidates.push(gt);
      }
    } else {
      for n : self.all_nodes {
        fit n.kind {
          .Impl(pi) -> {
            if !pi.has_type_params && equals(pi.type_name, owner_type) {
              candidates.push(n);
            }
          }
          _ -> {}
        }
      }
    }

    for tmpl : candidates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) ||
            i.type_params.len != impl_arg_type_names.len {
            continue;
          }
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          str prefix = pfx.build();

          for m : i.methods {
            fit m.kind {
              .Function(fnv) -> {
                if !fnv.has_type_params ||
                  !equals(strip_prefix(fnv.name, prefix), bare_name) {
                  continue;
                }

                Vec<str> own_arg_type_names;
                own_arg_type_names.init(0);
                Vec<bin> own_arg_is_pointer;
                own_arg_is_pointer.init(0);
                for tp : fnv.type_params {
                  bin found = false;
                  str found_name = "";
                  num ai = 0;
                  num arg_i = 0;
                  if fnv.has_args {
                    for parg : fnv.args {
                      if ai == 0 {
                        // Skip the implicit `self` param.
                        ai = ai + 1;
                        continue;
                      }
                      fit parg.kind {
                        .Variable(v) -> {
                          if equals(v.var_type.type_str, tp) &&
                            v.var_type.generic_args.len == 0 && arg_i < args.len {
                            let inferred = self.infer_arg_type_name(args.get(arg_i));
                            if inferred.is_some() {
                              found_name = inferred.unwrap();
                              found = true;
                            }
                          }
                        }
                        _ -> {}
                      }
                      ai = ai + 1;
                      arg_i = arg_i + 1;
                    }
                  }
                  if !found {
                    ret .None;
                  }
                  own_arg_type_names.push(found_name);
                  own_arg_is_pointer.push(false);
                }

                StringBuilder nb = string_builder_init(24);
                nb.append(owner_type);
                nb.append("__");
                nb.append(bare_name);
                for oan : own_arg_type_names {
                  nb.append("__");
                  nb.append(oan);
                }
                str new_name = nb.build();

                Vec<str> combined_params;
                combined_params.init(0);
                Vec<str> combined_arg_names;
                combined_arg_names.init(0);
                Vec<bin> combined_arg_ptrs;
                combined_arg_ptrs.init(0);
                for tpn : i.type_params {
                  combined_params.push(tpn);
                }
                for tpn2 : fnv.type_params {
                  combined_params.push(tpn2);
                }
                for an3 : impl_arg_type_names {
                  combined_arg_names.push(an3);
                }
                for an4 : own_arg_type_names {
                  combined_arg_names.push(an4);
                }
                for ap : impl_arg_is_pointer {
                  combined_arg_ptrs.push(ap);
                }
                for ap2 : own_arg_is_pointer {
                  combined_arg_ptrs.push(ap2);
                }

                // The combined substitution is set up before the dedup
                // check below: a repeat call still needs the return type
                // resolved fresh even though its body isn't re-emitted.
                let prev_params = self.type_subst_param_names;
                let prev_arg_names = self.type_subst_arg_type_strs;
                let prev_arg_ptrs = self.type_subst_arg_is_pointer;
                let prev_arg_dtypes = self.type_subst_arg_dtypes;
                self.type_subst_param_names = combined_params;
                self.type_subst_arg_type_strs = combined_arg_names;
                self.type_subst_arg_is_pointer = combined_arg_ptrs;
                // Left at the impl's shorter list on purpose:
                // `resolve_type_subst` falls back to the flat strings for
                // any index at or beyond its length.
                self.type_subst_arg_dtypes = impl_arg_dtypes;

                DataType resolved_rtype = dtype_new();
                if fnv.has_rtype {
                  resolved_rtype = self.resolve_type_subst(*fnv.rtype);
                }

                num ei = 0;
                bin already_emitted = false;
                for ei < self.emitted_method_own_param_insts.len {
                  if equals(self.emitted_method_own_param_insts.get(ei), new_name) {
                    already_emitted = true;
                  }
                  ei = ei + 1;
                }
                if already_emitted {
                  self.type_subst_param_names = prev_params;
                  self.type_subst_arg_type_strs = prev_arg_names;
                  self.type_subst_arg_is_pointer = prev_arg_ptrs;
                  self.type_subst_arg_dtypes = prev_arg_dtypes;
                  OwnParamCallResolution res0;
                  res0.mangled_name = new_name;
                  res0.rtype = resolved_rtype;
                  ret .Some(res0);
                }
                self.emitted_method_own_param_insts.push(new_name);

                // Same scratch-buffer/state-swap discipline as
                // `emit_one_generic_impl_method`.
                CodegenState method_scratch = codegen_state_new();
                CodegenState* saved_method_state = self.state;
                let saved_hoist_pos = self.hoist_insert_pos;
                let saved_stmt_start_pos = self.current_stmt_start_pos;
                let saved_local_names = self.local_names;
                let saved_local_is_pointer = self.local_is_pointer;
                let saved_local_type_name = self.local_type_name;
                let saved_local_dtype = self.local_dtype;
                let saved_fn_rtype_name = self.current_fn_rtype_name;
                let saved_fn_rtype_dt = self.current_fn_rtype_dt;
                let saved_defer_stack = self.defer_stack;
                let saved_defer_scope_starts = self.defer_scope_starts;
                let prev_suppress = self.suppress_generic_impl_method_draining;
                if self.hoist_scratch_depth == 0 {
                  self.root_state = self.state;
                  self.root_hoist_pos = self.hoist_insert_pos;
                  self.root_stmt_start_pos = self.current_stmt_start_pos;
                }
                self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
                self.state = &method_scratch;
                self.hoist_insert_pos = .None;
                self.current_stmt_start_pos = .None;
                self.suppress_generic_impl_method_draining = true;
                let body_err = self.emit_function_named(*m, new_name);
                self.state = saved_method_state;
                self.hoist_insert_pos = saved_hoist_pos;
                self.current_stmt_start_pos = saved_stmt_start_pos;
                self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
                if self.hoist_scratch_depth == 0 {
                  self.hoist_insert_pos = self.root_hoist_pos;
                  self.current_stmt_start_pos = self.root_stmt_start_pos;
                }
                self.suppress_generic_impl_method_draining = prev_suppress;
                self.local_names = saved_local_names;
                self.local_is_pointer = saved_local_is_pointer;
                self.local_type_name = saved_local_type_name;
                self.local_dtype = saved_local_dtype;
                self.current_fn_rtype_name = saved_fn_rtype_name;
                self.current_fn_rtype_dt = saved_fn_rtype_dt;
                self.defer_stack = saved_defer_stack;
                self.defer_scope_starts = saved_defer_scope_starts;
                self.emit_hoisted(method_scratch.out.build());

                self.type_subst_param_names = prev_params;
                self.type_subst_arg_type_strs = prev_arg_names;
                self.type_subst_arg_is_pointer = prev_arg_ptrs;
                self.type_subst_arg_dtypes = prev_arg_dtypes;
                if body_err.is_some() {
                  ret .None;
                }
                OwnParamCallResolution res;
                res.mangled_name = new_name;
                res.rtype = resolved_rtype;
                ret .Some(res);
              }
              _ -> {}
            }
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Emits one monomorphization of a generic tagged-union enum template,
  // substituting each variant's payload types against the template's
  // type-param names. A payload type that isn't a bare occurrence of a
  // type param is left unchanged.
  emit_tagged_union_enum_instance(
    str template_name,
    str mangled_name,
    Vec<GenericEnumVariantTemplate> variant_templates,
    Vec<str> type_params,
    Vec<str> arg_type_names,
    Vec<bin> arg_is_pointer
  ) {
    self.state.write("typedef enum ");
    self.state.write(mangled_name);
    self.state.write("_tag {\n");
    for vt : variant_templates {
      self.state.write("  ");
      self.state.write(mangled_name);
      self.state.write("_");
      self.state.write(vt.name);
      self.state.write(",\n");
    }
    self.state.write("} ");
    self.state.write(mangled_name);
    self.state.write("_tag;\n");

    self.state.write("typedef struct ");
    self.state.write(mangled_name);
    self.state.write(" {\n  ");
    self.state.write(mangled_name);
    self.state.write("_tag tag;\n  union {\n");
    for vt : variant_templates {
      if vt.has_payload {
        self.state.write("    struct { ");
        num i = 0;
        Vec<str> resolved_payload_names;
        resolved_payload_names.init(0);
        Vec<bin> resolved_payload_ptrs;
        resolved_payload_ptrs.init(0);
        for i < vt.payload_type_strs.len {
          str ptype = vt.payload_type_strs.get(i);
          bin pptr = vt.payload_is_pointer.get(i);
          str resolved_type = ptype;
          bin resolved_ptr = pptr;
          // A payload written as the enum's own name (`List<T>*` inside
          // `List`'s own variant) refers to this instantiation itself,
          // not to a type parameter: nothing in `type_params` would ever
          // match it, since it names the enum, not a param.
          if equals(ptype, template_name) {
            resolved_type = mangled_name;
          } else {
            num pi = 0;
            for pi < type_params.len {
              if equals(type_params.get(pi), ptype) {
                resolved_type = arg_type_names.get(pi);
                resolved_ptr = arg_is_pointer.get(pi);
              }
              pi = pi + 1;
            }
          }
          self.write_type_name(resolved_type);
          if resolved_ptr {
            self.state.write("*");
          }
          self.state.write(" _");
          self.state.write(format_num(i));
          self.state.write("; ");
          resolved_payload_names.push(resolved_type);
          resolved_payload_ptrs.push(resolved_ptr);
          i = i + 1;
        }
        self.state.write("} ");
        self.state.write(vt.name);
        self.state.write(";\n");
        self.record_enum_variant_payload(
          mangled_name,
          vt.name,
          resolved_payload_names,
          resolved_payload_ptrs
        );
      }
    }
    self.state.write("  } payload;\n} ");
    self.state.write(mangled_name);
    self.state.write(";\n\n");
  }

  // Records that local `name` is (or isn't) a pointer, and its declared
  // type name, for later field-access/method-call decisions. No full
  // `DataType` on hand here; see `record_local_typed` for that case.
  record_local(str name, str type_name, bin is_pointer) {
    self.local_names.push(name);
    self.local_is_pointer.push(is_pointer);
    self.local_type_name.push(type_name);
    self.local_dtype.push(.None);
  }

  // Like `record_local`, but for a call site that has the local's real,
  // already-substituted `DataType` on hand.
  record_local_typed(str name, str type_name, bin is_pointer, DataType dtype) {
    self.local_names.push(name);
    self.local_is_pointer.push(is_pointer);
    self.local_type_name.push(type_name);
    self.local_dtype.push(.Some(dtype));
  }

  // Looks up whether `name` was recorded as a pointer local. `.None`
  // means `name` isn't a known local. Searches backward, most recently
  // recorded first, so a local shadowing an earlier one of the same name
  // wins; there is no block-scope popping, so both entries live in the
  // same flat list.
  lookup_local_is_pointer(str name) Option<bin> {
    num i = self.local_names.len - 1;
    for i >= 0 {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_is_pointer.get(i));
      }
      i = i - 1;
    }
    ret .None;
  }

  // Looks up `name`'s declared type name, for building a method call's
  // mangled callee name. Same scope and `.None` contract as
  // `lookup_local_is_pointer`.
  lookup_local_type_name(str name) Option<str> {
    num i = self.local_names.len - 1;
    for i >= 0 {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_type_name.get(i));
      }
      i = i - 1;
    }
    ret .None;
  }

  // Looks up `name`'s full structured `DataType`, when it was recorded
  // via `record_local_typed`. `.None` covers both "not a known local" and
  // "recorded via plain `record_local`"; `lookup_local_type_name`
  // distinguishes the two.
  lookup_local_dtype(str name) Option<DataType> {
    num i = self.local_names.len - 1;
    for i >= 0 {
      if equals(self.local_names.get(i), name) {
        ret self.local_dtype.get(i);
      }
      i = i - 1;
    }
    ret .None;
  }

  // Registers `name` (a multi-dimensional array's for-loop item) as
  // needing its length bound computed via `root`, the true declared
  // array, with `depth` leading `[0]` index levels.
  record_local_multidim(str name, str root, num depth) {
    self.local_multidim_names.push(name);
    self.local_multidim_roots.push(root);
    self.local_multidim_depths.push(depth);
  }

  // Looks up `name`'s multi-dim root/depth, if registered. `.None` for an
  // ordinary local.
  lookup_local_multidim(str name) Option<MultidimInfo> {
    num i = self.local_multidim_names.len - 1;
    for i >= 0 {
      if equals(self.local_multidim_names.get(i), name) {
        MultidimInfo m;
        m.root = self.local_multidim_roots.get(i);
        m.depth = self.local_multidim_depths.get(i);
        ret .Some(m);
      }
      i = i - 1;
    }
    ret .None;
  }

  // Records `name` as a known enum with the given variant names and
  // tagged-union-ness, for later `EnumName.Variant` access recognition.
  record_enum(str name, Vec<str> variant_names, bin is_tagged_union) {
    self.enum_names.push(name);
    self.enum_variant_names.push(variant_names);
    self.enum_is_tagged_union.push(is_tagged_union);
  }

  // Records `variant_name`'s payload field types, positional, for a
  // tagged-union enum `enum_name`.
  record_enum_variant_payload(
    str enum_name,
    str variant_name,
    Vec<str> type_names,
    Vec<bin> is_pointer
  ) {
    Vec<Option<DataType>> dtypes;
    dtypes.init(0);
    num k = 0;
    for k < type_names.len {
      dtypes.push(.None);
      k = k + 1;
    }
    self.enum_variant_payload_owner.push(enum_name);
    self.enum_variant_payload_variant.push(variant_name);
    self.enum_variant_payload_type_names.push(type_names);
    self.enum_variant_payload_is_pointer.push(is_pointer);
    self.enum_variant_payload_dtype.push(dtypes);
  }

  // Like `record_enum_variant_payload`, but for a call site that has
  // each payload field's real, resolved `DataType` on hand.
  record_enum_variant_payload_typed(
    str enum_name,
    str variant_name,
    Vec<str> type_names,
    Vec<bin> is_pointer,
    Vec<DataType> dtypes_raw
  ) {
    Vec<Option<DataType>> dtypes;
    dtypes.init(0);
    for d : dtypes_raw {
      dtypes.push(.Some(d));
    }
    self.enum_variant_payload_owner.push(enum_name);
    self.enum_variant_payload_variant.push(variant_name);
    self.enum_variant_payload_type_names.push(type_names);
    self.enum_variant_payload_is_pointer.push(is_pointer);
    self.enum_variant_payload_dtype.push(dtypes);
  }

  // Looks up `variant_name`'s payload field type at `position` (0-based)
  // for the tagged-union enum `enum_name`. `.None` when the enum/variant
  // isn't recorded, or `position` is out of range.
  lookup_enum_variant_payload_type(str enum_name, str variant_name, num position) Option<FieldTypeInfo> {
    num i = 0;
    for i < self.enum_variant_payload_owner.len {
      if equals(self.enum_variant_payload_owner.get(i), enum_name) &&
        equals(
        self.enum_variant_payload_variant.get(i),
        variant_name
      ) {
        let type_names = self.enum_variant_payload_type_names.get(i);
        if position < 0 || position >= type_names.len {
          ret .None;
        }
        let is_pointers = self.enum_variant_payload_is_pointer.get(i);
        let dtypes = self.enum_variant_payload_dtype.get(i);
        FieldTypeInfo info;
        info.type_name = type_names.get(position);
        info.is_pointer = is_pointers.get(position);
        info.dtype = dtypes.get(position);
        ret .Some(info);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Resolves a bare enum-variant shorthand (`.Red`) by global uniqueness:
  // the single enum across the program whose variants include
  // `variant_name`. Covers a `let` declaration, which has no declared
  // type to resolve against. `.None` when zero or several enums match.
  resolve_unique_enum_for_variant(str variant_name) Option<str> {
    str found_name = "";
    num found_count = 0;
    num i = 0;
    for i < self.enum_names.len {
      let variants = self.enum_variant_names.get(i);
      num j = 0;
      for j < variants.len {
        if equals(variants.get(j), variant_name) {
          found_name = self.enum_names.get(i);
          found_count = found_count + 1;
        }
        j = j + 1;
      }
      i = i + 1;
    }
    if found_count == 1 {
      ret .Some(found_name);
    }
    ret .None;
  }

  // True if `enum_name` is a known enum with a variant named
  // `variant_name`.
  enum_has_variant(str enum_name, str variant_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        let variants = self.enum_variant_names.get(i);
        num j = 0;
        for j < variants.len {
          if equals(variants.get(j), variant_name) {
            ret true;
          }
          j = j + 1;
        }
        ret false;
      }
      i = i + 1;
    }
    ret false;
  }

  // True if `enum_name` is a known tagged-union enum.
  enum_is_tagged_union_named(str enum_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        ret self.enum_is_tagged_union.get(i);
      }
      i = i + 1;
    }
    ret false;
  }

  // Records `name` as a known compound with the given fields' names and
  // declared types, for later chained-field-access resolution. No full
  // per-field `DataType` on hand here; see `record_compound_typed`.
  record_compound(
    str name,
    Vec<str> field_names,
    Vec<str> field_type_names,
    Vec<bin> field_is_pointer
  ) {
    Vec<Option<DataType>> field_dtypes;
    field_dtypes.init(0);
    num k = 0;
    for k < field_names.len {
      field_dtypes.push(.None);
      k = k + 1;
    }
    self.compound_names.push(name);
    self.compound_field_names.push(field_names);
    self.compound_field_type_names.push(field_type_names);
    self.compound_field_is_pointer.push(field_is_pointer);
    self.compound_field_dtype.push(field_dtypes);
  }

  // Like `record_compound`, but for a call site that has each field's
  // real, un-mangled `DataType` on hand.
  record_compound_typed(
    str name,
    Vec<str> field_names,
    Vec<str> field_type_names,
    Vec<bin> field_is_pointer,
    Vec<DataType> field_dtypes_raw
  ) {
    Vec<Option<DataType>> field_dtypes;
    field_dtypes.init(0);
    for d : field_dtypes_raw {
      field_dtypes.push(.Some(d));
    }
    self.compound_names.push(name);
    self.compound_field_names.push(field_names);
    self.compound_field_type_names.push(field_type_names);
    self.compound_field_is_pointer.push(field_is_pointer);
    self.compound_field_dtype.push(field_dtypes);
  }

  // Looks up `field_name`'s declared type on the known compound
  // `compound_name`. `.None` when either isn't recognized.
  lookup_compound_field(str compound_name, str field_name) Option<FieldTypeInfo> {
    num i = 0;
    for i < self.compound_names.len {
      if equals(self.compound_names.get(i), compound_name) {
        let field_names = self.compound_field_names.get(i);
        let field_types = self.compound_field_type_names.get(i);
        let field_ptrs = self.compound_field_is_pointer.get(i);
        let field_dtypes = self.compound_field_dtype.get(i);
        num j = 0;
        for j < field_names.len {
          if equals(field_names.get(j), field_name) {
            FieldTypeInfo info;
            info.type_name = field_types.get(j);
            info.is_pointer = field_ptrs.get(j);
            info.dtype = field_dtypes.get(j);
            ret .Some(info);
          }
          j = j + 1;
        }
        ret .None;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Records an impl method's owning type, bare name, mangled call-site
  // name, declared return type (nil when unknown, as for a generic impl's
  // method), and declared parameter types excluding the implicit `self`.
  record_impl_method(
    str owner_type,
    str bare_name,
    str mangled_name,
    DataType* rtype,
    Vec<DataType*> param_types,
    Vec<Node*> default_values
  ) {
    self.impl_method_owner_type.push(owner_type);
    self.impl_method_bare_name.push(bare_name);
    self.impl_method_mangled_name.push(mangled_name);
    self.impl_method_rtype.push(rtype);
    self.impl_method_param_types.push(param_types);
    self.impl_method_default_values.push(default_values);
  }

  // The declared return type of `bare_name` on the quirk `quirk_name`
  // itself, read from its declaration rather than from any one impl.
  // What a dynamically-dispatched call returns is what the quirk says it
  // returns; every impl of it agrees, since the quirk is what a caller
  // sees.
  lookup_quirk_method_rtype(str quirk_name, str bare_name) Option<DataType*> {
    num i = 0;
    for i < self.quirk_decl_names.len {
      if equals(self.quirk_decl_names.get(i), quirk_name) {
        for m : self.quirk_decl_methods.get(i) {
          if equals(m.name, bare_name) {
            if m.rtype == nil {
              ret .None;
            }
            ret .Some(m.rtype);
          }
        }
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s declared return type on `owner_type`. `.None`
  // means the method isn't recognized, or its return type wasn't
  // recorded (a generic impl's method).
  lookup_impl_method_rtype(str owner_type, str bare_name) Option<DataType*> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) &&
        equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        let rtype = self.impl_method_rtype.get(i);
        if rtype == nil {
          ret .None;
        }
        ret .Some(rtype);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s declared parameter type at `arg_index`
  // (excluding `self`) on `owner_type`. `.None` when the method isn't
  // recognized, or `arg_index` is out of range.
  lookup_impl_method_param_type(str owner_type, str bare_name, num arg_index) Option<DataType*> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) &&
        equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        let param_types = self.impl_method_param_types.get(i);
        if arg_index >= param_types.len {
          ret .None;
        }
        ret .Some(param_types.get(arg_index));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s full declared param list (excluding `self`),
  // for `emit_method_call`'s default-parameter fill-in.
  lookup_impl_method_param_types(str owner_type, str bare_name) Option<Vec<DataType*>> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) &&
        equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        ret .Some(self.impl_method_param_types.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s trailing default-parameter value expressions.
  lookup_impl_method_default_values(str owner_type, str bare_name) Option<Vec<Node*>> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) &&
        equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        ret .Some(self.impl_method_default_values.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s fully mangled C call-site name on `owner_type`.
  lookup_impl_method(str owner_type, str bare_name) Option<str> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) &&
        equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        ret .Some(self.impl_method_mangled_name.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Writes an ordinary (non-raw) string literal's body, already holding
  // whatever escapes the source wrote. `\x` is the one that needs
  // attention: C reads as many hex digits as follow it, with no bound,
  // while a Fun `\xHH` escape means exactly one byte. A hex digit
  // written right after such an escape is split into its own adjacent
  // literal (`"\x42" "C"`, which C concatenates back), so it is read as
  // the next character rather than swallowed into the same escape.
  write_string_literal_body(str s) {
    num i = 0;
    num n = len(s);
    for i < n {
      chr c = s[i];
      self.write_c_char(c);
      i = i + 1;
      if c == '\\' && i < n && s[i] == 'x' {
        self.write_c_char('x');
        i = i + 1;
        num digits = 0;
        for digits < 2 && i < n && _is_hex_digit(s[i]) {
          self.write_c_char(s[i]);
          i = i + 1;
          digits = digits + 1;
        }
        if i < n && _is_hex_digit(s[i]) {
          self.state.write("\" \"");
        }
      }
    }
  }

  // Writes one byte, as the string helpers above pass characters through
  // `self.state.write`, which takes a NUL-terminated string rather than
  // a bare character.
  write_c_char(chr c) {
    str buf = malloc(2);
    buf[0] = c;
    buf[1] = 0;
    self.state.write(buf);
  }

  // Writes a raw string literal's bytes as a C string-literal body,
  // escaping backslash, double-quote, and newline; everything else
  // passes through unchanged.
  write_raw_string_body(str s) {
    num i = 0;
    num n = len(s);
    for i < n {
      chr c = s[i];
      if c == '\\' {
        self.state.write("\\\\");
      } elif c == '"' {
        self.state.write("\\\"");
      } elif c == '\n' {
        self.state.write("\\n");
      } elif c == '\r' {
        self.state.write("\\r");
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
      i = i + 1;
    }
  }

  // Writes a single-quoted C character literal for `c`, escaping
  // backslash/quote/newline/CR/tab/NUL, and any other non-printable-ASCII
  // byte as `\xHH`.
  write_char_literal(chr c) {
    self.state.write("'");
    if c == '\\' {
      self.state.write("\\\\");
    } elif c == '\'' {
      self.state.write("\\'");
    } elif c == '\n' {
      self.state.write("\\n");
    } elif c == '\r' {
      self.state.write("\\r");
    } elif c == '\t' {
      self.state.write("\\t");
    } elif c == 0 {
      self.state.write("\\0");
    } else {
      num code = c;
      if code < 0x20 || code >= 0x7f {
        self.state.write(format("\\x{num}", code));
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
    }
    self.state.write("'");
  }

  // Emits `node` as a C expression.
  // Remembers `node` as the innermost one being emitted.
  mark_node(Node node) {
    if !node.has_pos {
      ret;
    }
    self.last_where = format(
      "{str} at {str}:{str}:{str}",
      node_kind_name(node.kind),
      node.pos.filename,
      format_num(node.pos.line),
      format_num(node.pos.col)
    );
  }

  // Records what codegen could not emit, with the node's own position
  // when it carries one.
  note_unsupported(Node node, str stage) {
    if !equals(self.error_note, "") {
      ret;
    }
    str where = "";
    if node.has_pos {
      where = format(
        " at {str}:{str}:{str}",
        node.pos.filename,
        format_num(node.pos.line),
        format_num(node.pos.col)
      );
    }
    self.error_note = format("{str} ({str}){str}", node_kind_name(node.kind), stage, where);
  }

  // Emits `cond` as an `if`/`while` condition, without the one redundant
  // layer of parens a plain binary expression's own self-wrapping would
  // otherwise stack on top of C's own `if (...)`/`while (...)`: `emit_
  // expr` always wraps a binary op in its own parens, correct for a
  // sub-expression nested somewhere else, but doubled up here it reads
  // as `if ((x == y))`, which GCC and clang both warn on (mistaking it
  // for a disguised assignment). `emit_expr`'s own `.Expression`
  // binary-op case checks the flag set below right before writing its
  // wrapping `(`/`)` pair, consuming it (one shot, not inherited by
  // `left`/`right`'s own recursive emission) so only the outermost
  // pair is skipped.
  // Whether every name in `type_names` that could possibly need one
  // already has its own `typedef struct`/`typedef enum` declared
  // somewhere before `pos` in the true root buffer. A name skipped by
  // `map_type_to_c` (a scalar like `num`/`str`, or a raw C keyword
  // spelling it already maps to) never gets a typedef of its own, so
  // it's excluded rather than always failing the check.
  fn_types_declared_before(Vec<str> type_names, num pos) bin {
    if pos <= 0 {
      ret false;
    }
    str head = "";
    bin head_built = false;
    for name : type_names {
      if equals(name, "") || equals(name, "void") || !equals(map_type_to_c(name), name) {
        continue;
      }
      if !head_built {
        // `peek()`: a read-only check of what's already in the live
        // buffer, not the end of it - `build()` here would silently
        // wipe everything written so far on the very next `write`.
        str out_so_far = self.state.out.peek();
        head = substr(out_so_far, 0, pos);
        free(out_so_far);
        head_built = true;
      }
      StringBuilder struct_needle_sb = string_builder_init(20);
      struct_needle_sb.append("typedef struct ");
      struct_needle_sb.append(name);
      StringBuilder enum_needle_sb = string_builder_init(20);
      enum_needle_sb.append("typedef enum ");
      enum_needle_sb.append(name);
      str struct_needle = struct_needle_sb.build();
      str enum_needle = enum_needle_sb.build();
      bin found = contains(head, struct_needle) || contains(head, enum_needle);
      free(struct_needle);
      free(enum_needle);
      if !found {
        if head_built {
          free(head);
        }
        ret false;
      }
    }
    if head_built {
      free(head);
    }
    ret true;
  }

  // Non-nested splice position for a lazily-triggered plain (generic
  // or non-generic) prototype: the earlier of the enclosing function's
  // own start and the current-statement position, so escaping a nested
  // C block (the reason to prefer the function's own start at all)
  // never lands later than the plain statement-scoped splice already
  // did. `current_stmt_start_pos` isn't always actually inside the
  // function `current_fn_body_start_pos` names — a generic plain
  // function's deferred impl-method drain rewinds it to a position
  // from a different splice entirely, which can sit before the
  // enclosing function's own start. The function's own start is only
  // trusted at all when it's confirmed safe (`self.state` is the real
  // buffer, and every type the prototype names is already declared
  // ahead of that position). `type_names` is the prototype's own
  // return type plus every parameter type, in any order.
  // 
  // `.broad` tells a caller whether the position is safe to remember
  // as "already declared" for every future call site, not just this
  // one: both branches inside the safety check below land somewhere a
  // C declaration stays visible for the rest of the file (a function's
  // own start, or an earlier splice already known to be just as safe);
  // the plain fallback lands wherever the current statement happens to
  // sit, which C only scopes to its own enclosing block. Treating that
  // fallback as broad is exactly what used to make a later, unrelated
  // call site rely on a declaration already out of scope.
  fn_proto_splice_pos(Vec<str> type_names) ProtoSplice {
    if self.state == self.root_state && self.current_fn_body_start_pos.is_some() {
      num fp = self.current_fn_body_start_pos.unwrap();
      if self.fn_types_declared_before(type_names, fp) &&
        is_safe_splice_boundary(
        &self.state.out,
        fp
      ) {
        if self.current_stmt_start_pos.is_some() &&
          self.current_stmt_start_pos.unwrap() < fp {
          ProtoSplice broad_stmt;
          broad_stmt.pos = self.current_stmt_start_pos;
          broad_stmt.broad = true;
          ret broad_stmt;
        }
        ProtoSplice broad_fn;
        broad_fn.pos = self.current_fn_body_start_pos;
        broad_fn.broad = true;
        ret broad_fn;
      }
    }
    ProtoSplice narrow;
    narrow.pos = self.current_stmt_start_pos;
    narrow.broad = false;
    ret narrow;
  }

  emit_condition(Node cond) Option<CodegenErrorKind> {
    bin is_plain_binary = false;
    fit cond.kind {
      .Expression(ce) -> {
        // `=` isn't excluded because it's exempt from the double-paren
        // warning (it's just as much a candidate); it's excluded
        // because a bare `_ = expr` discard returns before ever
        // reaching the flag check below, which would leak the flag,
        // set but never consumed, into whatever gets emitted next.
        if !equals(ce.op, "()") && !equals(ce.op, ".") && !equals(ce.op, "[]") &&
          !equals(
          ce.op,
          ","
        ) && !equals(ce.op, "=") {
          is_plain_binary = true;
        }
      }
      _ -> {}
    }
    if is_plain_binary {
      self.suppress_next_expr_parens = true;
    }
    ret self.emit_expr(cond);
  }

  pub emit_expr(Node node) Option<CodegenErrorKind> {
    self.mark_node(node);
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Num(n) -> {
            self.state.write(format_num(n));
            ret .None;
          }
          .Dec(d) -> {
            self.state.write(format_dec(d, 6));
            ret .None;
          }
          _ -> { ret .Some(.InvalidNode); }
        }
      }
      .String(s) -> {
        self.state.write("\"");
        if node.flags.is_raw_string {
          self.write_raw_string_body(s);
        } else {
          self.write_string_literal_body(s);
        }
        self.state.write("\"");
        ret .None;
      }
      .Character(c) -> {
        self.write_char_literal(c);
        ret .None;
      }
      .Boolean(b) -> {
        if b {
          self.state.write("true");
        } else {
          self.state.write("false");
        }
        ret .None;
      }
      .Nil -> {
        self.state.write("NULL");
        ret .None;
      }
      .Panic(msg) -> {
        // Prints the message and aborts. Trails off with a plain `0` so
        // it type-checks in almost any scalar/pointer context.
        // MSVC does not support GNU statement expressions `({…})`, so
        // use the comma operator instead; the `(int64_t)0` is unreachable
        // (abort() is noreturn) but makes the expression well-typed.
        if self.msvc_mode {
          self.state.write("(fprintf(stderr_stream(), \"panic: %s\\n\", ");
          let merr = self.emit_expr(*msg);
          if merr.is_some() {
            ret merr;
          }
          self.state.write("), abort(), (int64_t)0)");
        } else {
          self.state.write("({ fprintf(stderr_stream(), \"panic: %s\\n\", ");
          let merr2 = self.emit_expr(*msg);
          if merr2.is_some() {
            ret merr2;
          }
          self.state.write("); abort(); 0; })");
        }
        ret .None;
      }
      .CompoundInit(ci) -> {
        // `Type{ field = value, ... }` (explicit) or `.{ field = value,
        // ... }` (bare, resolved against `expected_compound_type`).
        // Lowers to a GNU C compound literal: `(Type){ .field = value,
        // ... }`, or `(Type){0}` for an empty initializer.
        str type_name = "";
        if ci.has_dtype {
          bin have_type_name = false;
          // A bare `Type{...}` inside a generic impl method's body,
          // naming that method's return type's bare template, resolves
          // against `current_fn_rtype_name`. Checked before the
          // field-based inference below, whose fields are typically set
          // from still-abstract type-param locals, not concrete values.
          if ci.init_dtype.generic_args.len == 0 && self.current_fn_rtype_dt.is_some() {
            let crt = self.current_fn_rtype_dt.unwrap();
            if crt.generic_args.len > 0 && equals(crt.type_str, ci.init_dtype.type_str) {
              type_name = self.current_fn_rtype_name;
              have_type_name = true;
            }
          }
          // A bare `Box{value = 7}` infers `T`'s concrete binding from
          // the initializer's field values.
          if !have_type_name && ci.init_dtype.generic_args.len == 0 {
            let inferred_gargs = self.infer_generic_compound_init_args(
              ci.init_dtype.type_str,
              ci.fields
            );
            if inferred_gargs.is_some() {
              DataType effective_dtype = *ci.init_dtype;
              effective_dtype.generic_args = inferred_gargs.unwrap();
              let resolved2 = self.resolve_type_name(effective_dtype);
              if resolved2.is_some() {
                type_name = resolved2.unwrap();
                have_type_name = true;
              }
            }
          }
          if !have_type_name {
            let resolved = self.resolve_type_name(*ci.init_dtype);
            if resolved.is_none() {
              ret .Some(.UnsupportedNode);
            }
            type_name = resolved.unwrap();
          }
        } elif !equals(self.expected_compound_type, "") {
          type_name = self.expected_compound_type;
        } else {
          ret .Some(.UnsupportedNode);
        }
        self.state.write("(");
        self.state.write(type_name);
        self.state.write("){");
        if ci.fields.len == 0 {
          self.state.write("0");
        } else {
          bin first = true;
          for f : ci.fields {
            if !first {
              self.state.write(", ");
            }
            first = false;
            self.state.write(".");
            self.state.write(f.name);
            self.state.write(" = ");
            // A field value may itself be a bare enum-variant or `.{...}`
            // compound shorthand; both need the expected type set from
            // the field's declared type before recursing.
            let field_info = self.lookup_compound_field(type_name, f.name);
            let prev_expected_enum = self.expected_enum_type;
            let prev_expected_compound = self.expected_compound_type;
            if field_info.is_some() {
              let finfo = field_info.unwrap();
              if self.enum_names.contains(finfo.type_name) {
                self.expected_enum_type = finfo.type_name;
              } else {
                self.expected_compound_type = finfo.type_name;
              }
            }
            // A field value may itself be an array literal, needing the
            // bare-brace-list form.
            let prev_arr_init = self.in_array_initializer;
            self.in_array_initializer = true;
            let ferr = self.emit_expr(*f.value);
            self.in_array_initializer = prev_arr_init;
            self.expected_enum_type = prev_expected_enum;
            self.expected_compound_type = prev_expected_compound;
            if ferr.is_some() {
              ret ferr;
            }
          }
        }
        self.state.write("}");
        ret .None;
      }
      // A bare `[elem, elem, ...]` array literal. Inside a declaration
      // already providing the array's own type
      // (`in_array_initializer`), just the bare `{...}` initializer
      // fragment is legal C; anywhere else (a call argument, a nested
      // expression) needs a full compound literal, self-typed from the
      // elements the same way `let arr = [1, 2, 3];` already infers its
      // own declared type.
      .Bracket(inner) -> {
        if !self.in_array_initializer {
          self.state.write("(");
          self.state.write(self.infer_array_literal_elem_c_type(inner));
          self.state.write("[])");
        }
        Vec<Node*> elems;
        elems.init(0);
        self.flatten_call_args(inner, &elems);
        self.state.write("{");
        bin first = true;
        for elem : elems {
          if !first {
            self.state.write(", ");
          }
          first = false;
          let eerr = self.emit_expr(*elem);
          if eerr.is_some() {
            ret eerr;
          }
        }
        self.state.write("}");
        ret .None;
      }
      .Identifier(name) -> {
        self.state.write(name);
        ret .None;
      }
      .ExpressionParenthesis(inner) -> {
        // An explicit parenthesized sub-expression (`(a + b)`).
        self.state.write("(");
        let ierr = self.emit_expr(*inner);
        if ierr.is_some() {
          ret ierr;
        }
        self.state.write(")");
        ret .None;
      }
      .Unary(u) -> {
        if equals(u.op, "await") {
          ret self.emit_await(u.operand);
        }
        self.state.write("(");
        if u.is_left_operanded_unary {
          // Postfix: `x++`/`x--`.
          let oerr = self.emit_expr(*u.operand);
          if oerr.is_some() {
            ret oerr;
          }
          self.state.write(u.op);
        } elif u.has_indirection {
          // Pointer indirection (`*p`, `**pp`, ...): a run of `*`s for
          // the depth.
          num i = 0;
          for i < u.indirection_depth {
            self.state.write("*");
            i = i + 1;
          }
          let oerr2 = self.emit_expr(*u.operand);
          if oerr2.is_some() {
            ret oerr2;
          }
        } else {
          // Prefix (`-x`, `!x`, `~x`, `&x`).
          self.state.write(u.op);
          let oerr3 = self.emit_expr(*u.operand);
          if oerr3.is_some() {
            ret oerr3;
          }
        }
        self.state.write(")");
        ret .None;
      }
      .Expression(e) -> {
        // Every binary operator besides `()`/`.`/`[]` already has an
        // identical C spelling; a plain `(left op right)` emission is
        // correct as-is.
        if equals(e.op, "()") {
          ret self.emit_call(e);
        }
        if equals(e.op, ".") {
          ret self.emit_field_access(e);
        }
        if equals(e.op, "[]") {
          ret self.emit_index(e);
        }
        if equals(e.op, ",") {
          ret .Some(.UnsupportedNode);
        }
        if !e.has_left || !e.has_right {
          ret .Some(.InvalidNode);
        }
        // `_ = expr;` discards a return value on purpose; `_` isn't a
        // declared variable in C, so this lowers to `(void)(expr)`.
        if equals(e.op, "=") && e.has_left {
          fit e.left.kind {
            .Identifier(lname) -> {
              if equals(lname, "_") {
                self.state.write("(void)(");
                let derr = self.emit_expr(*e.right);
                if derr.is_some() {
                  ret derr;
                }
                self.state.write(")");
                ret .None;
              }
            }
            _ -> {}
          }
        }
        // Consumed here, one shot: only this outermost pair is skipped,
        // never `e.left`/`e.right`'s own recursive `emit_expr` calls.
        bin wrote_own_parens = !self.suppress_next_expr_parens;
        self.suppress_next_expr_parens = false;
        if wrote_own_parens {
          self.state.write("(");
        }
        let lerr = self.emit_expr(*e.left);
        if lerr.is_some() {
          ret lerr;
        }
        self.state.write(" ");
        self.state.write(e.op);
        self.state.write(" ");

        // An assignment or equality comparison's right-hand side may be a
        // bare enum-variant shorthand, so the left side's declared type
        // becomes the expected type for the right expression only.
        bin resolves_rhs_shorthand = equals(e.op, "=") || equals(e.op, "==") ||
          equals(e.op, "!=");
        str prev_expected = self.expected_enum_type;
        str prev_expected_compound = self.expected_compound_type;
        // A quirk-typed left side needs the same coercion wrapper a
        // declaration's own initializer gets: `h = &a;` for an already-
        // declared `HasV h` hits the identical mismatch a fresh `HasV h
        // = &a;` would, since plain assignment never went through that
        // path at all.
        bin did_assign_coerce = false;
        if equals(e.op, "=") {
          let lhs_resolved2 = self.resolve_field_chain(e.left);
          if lhs_resolved2.is_some() {
            let lhs_type_name2 = lhs_resolved2.unwrap().type_name;
            if self.quirk_names.contains(lhs_type_name2) {
              let concrete2 = self.resolve_quirk_coerce_concrete_type(e.right);
              if concrete2.is_some() {
                self.state.write("__fun_coerce_");
                self.state.write(concrete2.unwrap());
                self.state.write("_");
                self.state.write(lhs_type_name2);
                self.state.write("(");
                did_assign_coerce = true;
              }
            }
          }
        }
        if resolves_rhs_shorthand {
          let lhs_resolved = self.resolve_field_chain(e.left);
          if lhs_resolved.is_some() {
            let lhs_type_name = lhs_resolved.unwrap().type_name;
            self.expected_enum_type = lhs_type_name;
            // A bare `.{...}` compound literal resolves against the same
            // left-hand type, so both are set here; the AST already
            // distinguishes which applies.
            self.expected_compound_type = lhs_type_name;
          }
        }
        let rerr = self.emit_expr(*e.right);
        if resolves_rhs_shorthand {
          self.expected_enum_type = prev_expected;
          self.expected_compound_type = prev_expected_compound;
        }
        if rerr.is_some() {
          ret rerr;
        }
        if did_assign_coerce {
          self.state.write(")");
        }
        if wrote_own_parens {
          self.state.write(")");
        }
        ret .None;
      }
      _ -> {
        self.note_unsupported(node, "expression");
        ret .Some(.UnsupportedNode);
      }
    }
  }

  // Flattens a call's argument-list node into individual argument nodes,
  // appended in left-to-right source order.
  flatten_call_args(Node* node, Vec<Node*>* out) {
    fit node.kind {
      .ExpressionParenthesis(inner) -> { self.flatten_call_args(inner, out); }
      .Blank -> {}
      .Expression(e) -> {
        if equals(e.op, ",") {
          if e.has_left {
            self.flatten_call_args(e.left, out);
          }
          if e.has_right {
            self.flatten_call_args(e.right, out);
          }
        } else {
          out.push(node);
        }
      }
      _ -> { out.push(node); }
    }
  }

  // Writes the inner dimension declarators `[N1][N2]...` for a
  // multi-dimensional array local. The leading dimension stays unsized (C
  // infers it from the initializer) but every other must be explicit, so
  // sizes are derived by counting the first element at each nesting
  // level, assuming a rectangular literal. `outer_lit` is the `.Bracket`
  // node at the current level, `remaining` how many dimensions are left.
  emit_multidim_inner_declarators(Node* outer_lit, num remaining) {
    if remaining == 0 {
      ret;
    }
    fit outer_lit.kind {
      .Bracket(outer_inner) -> {
        Vec<Node*> outer_elems;
        outer_elems.init(0);
        self.flatten_call_args(outer_inner, &outer_elems);
        if outer_elems.len == 0 {
          ret;
        }
        let first_elem = outer_elems.get(0);
        fit first_elem.kind {
          .Bracket(first_inner) -> {
            Vec<Node*> inner_elems;
            inner_elems.init(0);
            self.flatten_call_args(first_inner, &inner_elems);
            self.state.write("[");
            self.state.write(format_num(inner_elems.len));
            self.state.write("]");
            if remaining > 1 {
              self.emit_multidim_inner_declarators(first_elem, remaining - 1);
            }
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // Structural nesting depth of a bare array literal: 1 for a flat
  // `[1, 2, 3]`, one more per level of further uniform nesting. Only
  // checks whether the first element at each level is itself a
  // `.Bracket`, so it always succeeds regardless of element type.
  array_literal_nesting_depth(Node* lit) num {
    fit lit.kind {
      .Bracket(inner) -> {
        Vec<Node*> elems;
        elems.init(0);
        self.flatten_call_args(inner, &elems);
        if elems.len == 0 {
          ret 1;
        }
        let first = elems.get(0);
        fit first.kind {
          .Bracket(_) -> { ret 1 + self.array_literal_nesting_depth(first); }
          _ -> { ret 1; }
        }
      }
      _ -> { ret 1; }
    }
  }

  // True when `arg`'s declared type, resolved through the active generic
  // substitution, is the builtin string type, which the `__fun_key_eq`
  // and `__fun_key_hash` intrinsics use to pick string-contents over
  // raw-byte semantics. Only a bare `.Identifier` argument is resolvable;
  // anything else conservatively answers false.
  _key_arg_is_str(Node* arg) bin {
    fit arg.kind {
      .Identifier(name) -> {
        let dt_opt = self.lookup_local_dtype(name);
        if dt_opt.is_none() {
          ret false;
        }
        let resolved = self.resolve_type_subst(dt_opt.unwrap());
        if resolved.pointer_depth != 0 {
          ret false;
        }
        ret equals(resolved.type_str, "str");
      }
      _ -> { ret false; }
    }
  }

  // Resolves whether `expr` (a variadic `format`/`println_fmt` `{}`
  // argument) should be pre-converted through its own type's `Display`
  // impl instead of passed raw. Handles a bare local, a field access, or
  // a unary `*`/`&` wrapping either, whose resolved type has a
  // registered `to_string` method.
  resolve_display_dispatch(Node* expr) Option<DisplayResolution> {
    // `*ptr` dereferences to the pointee's declared type, `&x` takes a
    // Display value's address. Checked first, since a `.Unary` node never
    // matches `eligible` below.
    fit expr.kind {
      .Unary(u) -> {
        bin want_ptr = equals(u.op, "*");
        bin want_addr = equals(u.op, "&");
        if want_ptr || want_addr {
          fit u.operand.kind {
            .Identifier(name) -> {
              let is_ptr = self.lookup_local_is_pointer(name);
              let type_name = self.lookup_local_type_name(name);
              if is_ptr.is_some() && type_name.is_some() {
                bin shape_ok = false;
                if want_ptr && is_ptr.unwrap() {
                  shape_ok = true;
                }
                if want_addr && !is_ptr.unwrap() {
                  shape_ok = true;
                }
                if shape_ok {
                  let fn_name_opt2 = self.lookup_impl_method(type_name.unwrap(), "to_string");
                  if fn_name_opt2.is_some() {
                    // A Display impl reached only through this
                    // unary-wrapped dispatch needs a forward prototype,
                    // or an earlier-defined caller in the same file hits
                    // an implicit-declaration error.
                    self.ensure_plain_impl_method_prototype_emitted(
                      type_name.unwrap(),
                      "to_string"
                    );
                    self.ensure_generic_impl_method_emitted(type_name.unwrap(), "to_string", "");
                    DisplayResolution res2;
                    res2.fn_name = fn_name_opt2.unwrap();
                    // `*p` evaluates to a plain value, so a
                    // pointer-receiver `to_string` needs its address
                    // taken; `&x` is already a pointer.
                    res2.pass_by_ref = want_ptr;
                    ret .Some(res2);
                  }
                }
              }
            }
            _ -> {}
          }
        }
        ret .None;
      }
      _ -> {}
    }
    bin eligible = false;
    fit expr.kind {
      .Identifier(_) -> { eligible = true; }
      .Expression(e) -> {
        if equals(e.op, ".") {
          eligible = true;
        }
      }
      _ -> {}
    }
    if !eligible {
      ret .None;
    }
    let r_opt = self.resolve_field_chain(expr);
    if r_opt.is_none() {
      ret .None;
    }
    let r = r_opt.unwrap();
    if r.is_call_result {
      ret .None;
    }
    let fn_name_opt = self.lookup_impl_method(r.type_name, "to_string");
    if fn_name_opt.is_none() {
      ret .None;
    }
    // Same as `emit_method_call`'s dispatch: ensures a forward prototype
    // exists for a plain impl method and, harmlessly when inapplicable, a
    // generic compound's mangled instantiation.
    self.ensure_plain_impl_method_prototype_emitted(r.type_name, "to_string");
    self.ensure_generic_impl_method_emitted(r.type_name, "to_string", "");
    DisplayResolution res;
    res.fn_name = fn_name_opt.unwrap();
    res.pass_by_ref = !r.is_pointer;
    ret .Some(res);
  }

  // Counts each typed `{kind}` placeholder in a `format()` literal's
  // format string (`{str}`/`{num}`/`{dec}`/`{bin}`/`{chr}`/`{ptr}`/`{raw}`),
  // mirroring the reference compiler's own placeholder recognition:
  // `{{`/`}}` are escaped braces, and a bare `{}` opts the whole string
  // out of counting (returns `.None`), since it takes the general vararg
  // path rather than a specific typed one.
  count_format_placeholders(str fmt) Option<num> {
    num i = 0;
    num n = len(fmt);
    num count = 0;
    for i < n {
      chr c = fmt[i];
      if c == '{' {
        if i + 1 < n && fmt[i + 1] == '{' {
          i = i + 2;
          continue;
        }
        if i + 1 < n && fmt[i + 1] == '}' {
          ret .None;
        }
        if i + 4 < n && fmt[i + 4] == '}' {
          chr a = fmt[i + 1];
          chr b = fmt[i + 2];
          chr d = fmt[i + 3];
          bin matched = false;
          if a == 's' && b == 't' && d == 'r' {
            matched = true;
          } elif a == 'n' && b == 'u' && d == 'm' {
            matched = true;
          } elif a == 'd' && b == 'e' && d == 'c' {
            matched = true;
          } elif a == 'b' && b == 'i' && d == 'n' {
            matched = true;
          } elif a == 'c' && b == 'h' && d == 'r' {
            matched = true;
          } elif a == 'p' && b == 't' && d == 'r' {
            matched = true;
          } elif a == 'r' && b == 'a' && d == 'w' {
            matched = true;
          }
          if matched {
            count = count + 1;
            i = i + 5;
            continue;
          }
        }
      }
      i = i + 1;
    }
    ret .Some(count);
  }

  // Emits a call `callee(arg1, arg2, ...)`: a plain-identifier callee (an
  // ordinary free-function call) directly, or delegates to
  // `emit_method_call` when the callee is a `.`-Expression
  // (`recv.method(...)`).
  emit_call(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(.InvalidNode);
    }
    str callee_name = "";
    // An alias-qualified callee (`cmath.log(x)`) names the C binding
    // directly, so it keeps its raw name; see `effective_function_name`.
    bin callee_is_alias_qualified = false;
    fit e.left.kind {
      .Identifier(name) -> { callee_name = name; }
      .Expression(recv_e) -> {
        if equals(recv_e.op, ".") {
          // `alias.func(args)`, a plain function call qualified by an
          // import alias. Checked before falling through to
          // `emit_method_call`, and gated on not already being a known
          // local so a same-named local shadows the alias.
          bin left_is_known_alias = false;
          str known_alias_name = "";
          if recv_e.has_left {
            fit recv_e.left.kind {
              .Identifier(lname) -> {
                if self.import_aliases.contains(lname) &&
                  self.lookup_local_type_name(lname).is_none() {
                  left_is_known_alias = true;
                  known_alias_name = lname;
                }
              }
              _ -> {}
            }
          }
          if left_is_known_alias {
            callee_is_alias_qualified = true;
            if !recv_e.has_right {
              ret .Some(.UnsupportedNode);
            }
            fit recv_e.right.kind {
              .Identifier(fname) -> {
                // A collision-renamed function resolves to its mangled
                // name here, falling back to the bare unqualified name
                // when nothing matches.
                let renamed = self.lookup_alias_rename(known_alias_name, fname);
                if renamed.is_some() {
                  callee_name = renamed.unwrap();
                } else {
                  callee_name = fname;
                }
              }
              _ -> { ret .Some(.UnsupportedNode); }
            }
          } else {
            // `EnumName.Variant(args...)`, a tagged-union payload
            // construction, shares the AST shape of a method call, so it
            // is disambiguated by checking whether the left side is a
            // known enum name carrying that variant.
            if recv_e.has_left && recv_e.has_right {
              str enum_name = "";
              bin have_enum_name = false;
              fit recv_e.left.kind {
                .Identifier(name) -> {
                  enum_name = name;
                  have_enum_name = true;
                }
                // Bare shorthand (`.Some(x)`, no `EnumName.` qualifier),
                // falling through to `emit_method_call` when it doesn't
                // resolve.
                .Blank -> {
                  if !equals(self.expected_enum_type, "") {
                    enum_name = self.expected_enum_type;
                    have_enum_name = true;
                  }
                }
                _ -> {}
              }
              if have_enum_name {
                fit recv_e.right.kind {
                  .Identifier(variant_name) -> {
                    // `Option<str> x = Option.Some("v");` qualifies
                    // against a generic enum's bare template name, which
                    // is never registered in `enum_names` (only a
                    // concrete instantiation like `Option__str` is), so
                    // it falls back to `expected_enum_type`, which
                    // already holds the mangled name.
                    if !self.enum_has_variant(enum_name, variant_name) {
                      StringBuilder ec_tmpl_pfx = string_builder_init(16);
                      ec_tmpl_pfx.append(enum_name);
                      ec_tmpl_pfx.append("__");
                      if starts_with(self.expected_enum_type, ec_tmpl_pfx.build()) &&
                        self.enum_has_variant(
                        self.expected_enum_type,
                        variant_name
                      ) {
                        enum_name = self.expected_enum_type;
                      }
                    }
                    if self.enum_has_variant(enum_name, variant_name) {
                      ret self.emit_enum_variant_construction(enum_name, variant_name, e.right);
                    }
                  }
                  _ -> {}
                }
              }
            }
            ret self.emit_method_call(recv_e, e.right);
          }
        } else {
          ret .Some(.UnsupportedNode);
        }
      }
      _ -> { ret .Some(.UnsupportedNode); }
    }
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(e.right, &args);

    // `format("{num} {str}", a, b)`'s argument count is checked against
    // its own placeholder count, matching the reference compiler's
    // validation (a side effect there of a snprintf fast-path
    // optimization this codegen doesn't have; format stays an ordinary
    // vararg call here, this check just replicates the same accept/reject
    // decision on its own). Only applies to a literal, non-raw format
    // string with no bare `{}` placeholder, exactly like the reference:
    // a bare `{}` takes the general vararg path, uncounted.
    if equals(callee_name, "format") && args.len >= 1 &&
      !args.get(0).flags.is_raw_string {
      fit args.get(0).kind {
        .String(fmt_str) -> {
          let ph_opt = self.count_format_placeholders(fmt_str);
          if ph_opt.is_some() {
            num expected = ph_opt.unwrap();
            num provided = args.len - 1;
            if expected != provided {
              self.error_note = format(
                "format expects {num} arguments, got {num}",
                expected,
                provided
              );
              ret .Some(.UnsupportedNode);
            }
          }
        }
        _ -> {}
      }
    }

    // A call to a known variadic plain function needs an extra trailing
    // argument beyond its varargs: a `__fun_vtags` type-tag string, one
    // character per vararg built via the `__fun_tag` `_Generic` macro,
    // which the callee's body-prefix shim reads back with `va_arg` into a
    // `Vec<str>` named `vargs`. Each vararg binds to an `__auto_type
    // __fun_va_N` temp inside a GNU C statement expression first, since
    // it's read twice below and must not be evaluated twice.
    let var_fixed_len = self.lookup_function_variadic_fixed_len(callee_name);
    if var_fixed_len.is_some() {
      num fixed_len = var_fixed_len.unwrap();
      num var_len = 0;
      if args.len > fixed_len {
        var_len = args.len - fixed_len;
      }
      if var_len == 0 {
        self.state.write(self.emit_callee_name(callee_name, callee_is_alias_qualified));
        self.state.write("(");
        num vc_i = 0;
        for vc_i < fixed_len {
          if vc_i > 0 {
            self.state.write(", ");
          }
          let vc_err = self.emit_expr(*args.get(vc_i));
          if vc_err.is_some() {
            ret vc_err;
          }
          vc_i = vc_i + 1;
        }
        if fixed_len > 0 {
          self.state.write(", ");
        }
        if self.msvc_mode {
          self.state.write("\"\")");
        } else {
          self.state.write("(const char[]){0})");
        }
        ret .None;
      }
      // Resolved once per position and reused across the three loops
      // below: binding, tag string, and pass-through argument.
      Vec<bin> va_is_display;
      va_is_display.init(var_len);
      defer va_is_display.free();
      Vec<str> va_disp_fn;
      va_disp_fn.init(var_len);
      defer va_disp_fn.free();
      Vec<bin> va_disp_by_ref;
      va_disp_by_ref.init(var_len);
      defer va_disp_by_ref.free();
      num vd_i = 0;
      for vd_i < var_len {
        let disp = self.resolve_display_dispatch(args.get(fixed_len + vd_i));
        if disp.is_some() {
          let d = disp.unwrap();
          va_is_display.push(true);
          va_disp_fn.push(d.fn_name);
          va_disp_by_ref.push(d.pass_by_ref);
        } else {
          va_is_display.push(false);
          va_disp_fn.push("");
          va_disp_by_ref.push(false);
        }
        vd_i = vd_i + 1;
      }

      // MSVC has no GNU statement expressions (`({...})`). When msvc_mode
      // and a statement-start position is tracked, hoist each va temp as a
      // plain declaration before the enclosing statement and emit the
      // callee call directly. Falls back to the GNU form otherwise (e.g.
      // when emitting top-level initializers where no statement context
      // exists).
      bin va_use_hoist = self.msvc_mode && self.current_stmt_start_pos.is_some();
      // Arg texts captured for the msvc inline fallback (no-hoist + msvc):
      // avoids GNU statement expressions when there is no stmt position to
      // hoist into (e.g. nested variadic call evaluated in a scratch buffer).
      Vec<str> gnu_msvc_va_texts;
      gnu_msvc_va_texts.init(0);
      defer gnu_msvc_va_texts.free();
      // Resolved C type per variadic arg, used in MSVC mode to build a
      // tag string literal instead of an unsupported (const char[]){…}
      // compound literal.
      Vec<str> va_resolved_ctypes;
      va_resolved_ctypes.init(0);
      defer va_resolved_ctypes.free();
      num va_call_id = 0;
      if va_use_hoist {
        self.va_call_counter = self.va_call_counter + 1;
        va_call_id = self.va_call_counter;
        num va_i = 0;
        for va_i < var_len {
          Node* va_arg = args.get(fixed_len + va_i);
          bin va_is_chr_literal = false;
          fit va_arg.kind {
            .Character(_) -> { va_is_chr_literal = true; }
            _ -> {}
          }
          // Capture the expression text into a scratch buffer so we can
          // splice the declaration before the enclosing statement.
          CodegenState va_scratch = codegen_state_new();
          CodegenState* va_saved_state = self.state;
          let va_saved_hoist_pos = self.hoist_insert_pos;
          let va_saved_stmt_pos = self.current_stmt_start_pos;
          if self.hoist_scratch_depth == 0 {
            self.root_state = self.state;
            self.root_hoist_pos = self.hoist_insert_pos;
            self.root_stmt_start_pos = self.current_stmt_start_pos;
          }
          self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
          self.state = &va_scratch;
          self.hoist_insert_pos = .None;
          self.current_stmt_start_pos = .None;
          let va_err = self.emit_expr(*va_arg);
          self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
          self.state = va_saved_state;
          if self.hoist_scratch_depth == 0 {
            self.hoist_insert_pos = self.root_hoist_pos;
            self.current_stmt_start_pos = self.root_stmt_start_pos;
          } else {
            self.hoist_insert_pos = va_saved_hoist_pos;
            self.current_stmt_start_pos = va_saved_stmt_pos;
          }
          if va_err.is_some() {
            ret va_err;
          }
          str va_expr_text = va_scratch.out.build();
          let va_type_opt = self.infer_arg_type_name(va_arg);
          str va_c_type = "int64_t";
          if va_type_opt.is_some() {
            va_c_type = map_type_to_c(va_type_opt.unwrap());
          }
          if equals(va_c_type, "void") {
            va_c_type = "void*";
          }
          va_resolved_ctypes.push(va_c_type);
          StringBuilder va_decl_sb = string_builder_init(64);
          num va_indent_ii = 0;
          for va_indent_ii < self.state.indent_level {
            va_decl_sb.append("    ");
            va_indent_ii = va_indent_ii + 1;
          }
          va_decl_sb.append(va_c_type);
          va_decl_sb.append(" __fun_va_");
          va_decl_sb.append(format_num(va_call_id));
          va_decl_sb.append("_");
          va_decl_sb.append(format_num(va_i));
          va_decl_sb.append(" = ");
          if va_is_chr_literal {
            va_decl_sb.append("(char)");
          }
          va_decl_sb.append(va_expr_text);
          va_decl_sb.append(";\n");
          if va_is_display.get(va_i) {
            num va_disp_indent_ii = 0;
            for va_disp_indent_ii < self.state.indent_level {
              va_decl_sb.append("    ");
              va_disp_indent_ii = va_disp_indent_ii + 1;
            }
            va_decl_sb.append("char* __fun_disp_");
            va_decl_sb.append(format_num(va_call_id));
            va_decl_sb.append("_");
            va_decl_sb.append(format_num(va_i));
            va_decl_sb.append(" = ");
            va_decl_sb.append(va_disp_fn.get(va_i));
            va_decl_sb.append("(");
            if va_disp_by_ref.get(va_i) {
              va_decl_sb.append("&");
            }
            va_decl_sb.append("__fun_va_");
            va_decl_sb.append(format_num(va_call_id));
            va_decl_sb.append("_");
            va_decl_sb.append(format_num(va_i));
            va_decl_sb.append(");\n");
          }
          str va_decl_text = va_decl_sb.build();
          let va_hoist_save = self.hoist_insert_pos;
          let va_splice_pos = self.current_stmt_start_pos;
          self.hoist_insert_pos = va_splice_pos;
          self.emit_hoisted(va_decl_text);
          if va_splice_pos.is_some() {
            va_hoist_save = adjust_pos_after_splice(
              va_hoist_save,
              va_splice_pos.unwrap(),
              len(va_decl_text)
            );
          }
          self.hoist_insert_pos = va_hoist_save;
          va_i = va_i + 1;
        }
      } else {
        if self.msvc_mode {
          // No GNU statement expressions (`({...})`) in MSVC. Capture each
          // arg's rendered text so it can be emitted inline in the tag array
          // and arg list; args that are function calls are evaluated twice,
          // which is acceptable here because this path only fires for nested
          // variadic calls evaluated inside a hoist scratch buffer where
          // side-effecting args are uncommon in practice.
          num va_i = 0;
          for va_i < var_len {
            Node* va_arg = args.get(fixed_len + va_i);
            bin va_is_chr_literal = false;
            fit va_arg.kind {
              .Character(_) -> { va_is_chr_literal = true; }
              _ -> {}
            }
            CodegenState va_scratch_m = codegen_state_new();
            CodegenState* va_m_saved = self.state;
            let va_m_saved_hoist = self.hoist_insert_pos;
            let va_m_saved_stmt = self.current_stmt_start_pos;
            if self.hoist_scratch_depth == 0 {
              self.root_state = self.state;
              self.root_hoist_pos = self.hoist_insert_pos;
              self.root_stmt_start_pos = self.current_stmt_start_pos;
            }
            self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
            self.state = &va_scratch_m;
            self.hoist_insert_pos = .None;
            self.current_stmt_start_pos = .None;
            let va_err = self.emit_expr(*va_arg);
            self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
            self.state = va_m_saved;
            if self.hoist_scratch_depth == 0 {
              self.hoist_insert_pos = self.root_hoist_pos;
              self.current_stmt_start_pos = self.root_stmt_start_pos;
            } else {
              self.hoist_insert_pos = va_m_saved_hoist;
              self.current_stmt_start_pos = va_m_saved_stmt;
            }
            if va_err.is_some() {
              ret va_err;
            }
            str va_expr_m = va_scratch_m.out.build();
            if va_is_chr_literal {
              StringBuilder va_chr_sb = string_builder_init(len(va_expr_m) + 6);
              va_chr_sb.append("(char)");
              va_chr_sb.append(va_expr_m);
              gnu_msvc_va_texts.push(va_chr_sb.build());
            } else {
              gnu_msvc_va_texts.push(va_expr_m);
            }
            // Collect resolved C type for the MSVC tag string literal.
            let va_m_type_opt = self.infer_arg_type_name(va_arg);
            str va_m_c_type = "int64_t";
            if va_m_type_opt.is_some() {
              va_m_c_type = map_type_to_c(va_m_type_opt.unwrap());
            }
            if equals(va_m_c_type, "void") {
              va_m_c_type = "void*";
            }
            va_resolved_ctypes.push(va_m_c_type);
            va_i = va_i + 1;
          }
        } else {
          self.state.write("({ ");
          num va_i = 0;
          for va_i < var_len {
            Node* va_arg = args.get(fixed_len + va_i);
            // A bare character literal has type `int` in C, so `__auto_type`
            // would infer `int`, `__fun_tag`'s `_Generic` dispatch would take
            // the `int` case, and the callee's shim would stringify the ASCII
            // code instead of the character. An explicit `(char)` cast forces
            // the right inference; a `chr`-typed variable is already `char`.
            bin va_is_chr_literal = false;
            fit va_arg.kind {
              .Character(_) -> { va_is_chr_literal = true; }
              _ -> {}
            }
            self.state.write("__auto_type __fun_va_");
            self.state.write(format_num(va_i));
            self.state.write(" = ");
            if va_is_chr_literal {
              self.state.write("(char)");
            }
            let va_err = self.emit_expr(*va_arg);
            if va_err.is_some() {
              ret va_err;
            }
            self.state.write("; ");
            if va_is_display.get(va_i) {
              self.state.write("char* __fun_disp_");
              self.state.write(format_num(va_i));
              self.state.write(" = ");
              self.state.write(va_disp_fn.get(va_i));
              self.state.write("(");
              if va_disp_by_ref.get(va_i) {
                self.state.write("&");
              }
              self.state.write("__fun_va_");
              self.state.write(format_num(va_i));
              self.state.write("); ");
            }
            va_i = va_i + 1;
          }
        }
      }
      self.state.write(self.emit_callee_name(callee_name, callee_is_alias_qualified));
      self.state.write("(");
      num vf_i = 0;
      for vf_i < fixed_len {
        if vf_i > 0 {
          self.state.write(", ");
        }
        let vf_err = self.emit_expr(*args.get(vf_i));
        if vf_err.is_some() {
          ret vf_err;
        }
        vf_i = vf_i + 1;
      }
      if fixed_len > 0 {
        self.state.write(", ");
      }
      if self.msvc_mode {
        // MSVC C17 does not support compound literals (const char[]){…}.
        // Emit a string literal with the tag chars pre-resolved from the
        // inferred C types. Display args are always 's'; scalars map via
        // their C type. Unknown types fall back to 'n' (int64_t default).
        self.state.write("\"");
        num vt_i = 0;
        for vt_i < var_len {
          if va_is_display.get(vt_i) {
            self.state.write("s");
          } else {
            str ctype_for_tag = "int64_t";
            if vt_i < va_resolved_ctypes.len {
              ctype_for_tag = va_resolved_ctypes.get(vt_i);
            }
            if equals(ctype_for_tag, "char*") || equals(ctype_for_tag, "const char*") {
              self.state.write("s");
            } elif equals(ctype_for_tag, "double") || equals(ctype_for_tag, "float") {
              self.state.write("d");
            } elif equals(ctype_for_tag, "bool") {
              self.state.write("b");
            } elif equals(ctype_for_tag, "char") {
              self.state.write("c");
            } else {
              self.state.write("n");
            }
          }
          vt_i = vt_i + 1;
        }
        self.state.write("\"");
      } else {
        self.state.write("(const char[]){");
        num vt_i = 0;
        for vt_i < var_len {
          if vt_i > 0 {
            self.state.write(", ");
          }
          if va_is_display.get(vt_i) {
            self.state.write("'s'");
          } else {
            self.state.write("__fun_tag(");
            self.state.write("__fun_va_");
            self.state.write(format_num(vt_i));
            self.state.write(")");
          }
          vt_i = vt_i + 1;
        }
        if var_len > 0 {
          self.state.write(", ");
        }
        self.state.write("0}");
      }
      num vp_i = 0;
      for vp_i < var_len {
        self.state.write(", ");
        if va_is_display.get(vp_i) {
          if va_use_hoist {
            self.state.write("__fun_disp_");
            self.state.write(format_num(va_call_id));
            self.state.write("_");
            self.state.write(format_num(vp_i));
          } elif self.msvc_mode {
            self.state.write(va_disp_fn.get(vp_i));
            self.state.write("(");
            if va_disp_by_ref.get(vp_i) {
              self.state.write("&");
            }
            self.state.write(gnu_msvc_va_texts.get(vp_i));
            self.state.write(")");
          } else {
            self.state.write("__fun_disp_");
            self.state.write(format_num(vp_i));
          }
        } else {
          if va_use_hoist {
            self.state.write("__fun_va_");
            self.state.write(format_num(va_call_id));
            self.state.write("_");
            self.state.write(format_num(vp_i));
          } elif self.msvc_mode {
            self.state.write(gnu_msvc_va_texts.get(vp_i));
          } else {
            self.state.write("__fun_va_");
            self.state.write(format_num(vp_i));
          }
        }
        vp_i = vp_i + 1;
      }
      if va_use_hoist || self.msvc_mode {
        self.state.write(")");
      } else {
        self.state.write("); })");
      }
      ret .None;
    }

    // `__fun_key_eq(a, b)` and `__fun_key_hash(x)` are intrinsics, not
    // real functions, used by `Map<K, V>`/`Set<T>` to compare and hash a
    // key by contents when it's a string and by raw bytes otherwise;
    // without this a `Map<str>` key would hash the pointer itself.
    // `_key_arg_is_str` resolves through the active generic substitution,
    // since a bare type param like `K` may concretely be `str` here.
    if equals(callee_name, "__fun_key_eq") && args.len == 2 {
      self.state.write("(");
      if self._key_arg_is_str(args.get(0)) {
        self.state.write("strcmp((");
        let keq_a_err = self.emit_expr(*args.get(0));
        if keq_a_err.is_some() {
          ret keq_a_err;
        }
        self.state.write("), (");
        let keq_b_err = self.emit_expr(*args.get(1));
        if keq_b_err.is_some() {
          ret keq_b_err;
        }
        self.state.write(")) == 0)");
      } else {
        self.state.write("memcmp(&(");
        let keq_a_err2 = self.emit_expr(*args.get(0));
        if keq_a_err2.is_some() {
          ret keq_a_err2;
        }
        self.state.write("), &(");
        let keq_b_err2 = self.emit_expr(*args.get(1));
        if keq_b_err2.is_some() {
          ret keq_b_err2;
        }
        self.state.write("), sizeof(");
        let keq_a_err3 = self.emit_expr(*args.get(0));
        if keq_a_err3.is_some() {
          ret keq_a_err3;
        }
        self.state.write(")) == 0)");
      }
      ret .None;
    }
    if equals(callee_name, "__fun_key_hash") && args.len == 1 {
      if self._key_arg_is_str(args.get(0)) {
        self.state.write("__fun_str_key_hash((");
        let kh_err = self.emit_expr(*args.get(0));
        if kh_err.is_some() {
          ret kh_err;
        }
        self.state.write("))");
      } else {
        self.state.write("__fun_bytes_key_hash(&(");
        let kh_err2 = self.emit_expr(*args.get(0));
        if kh_err2.is_some() {
          ret kh_err2;
        }
        self.state.write("), sizeof(");
        let kh_err3 = self.emit_expr(*args.get(0));
        if kh_err3.is_some() {
          ret kh_err3;
        }
        self.state.write("))");
      }
      ret .None;
    }

    // `sizeof(T)`, where `T` is a generic impl method's own type param,
    // needs the same substitution every other reference to `T` gets via
    // `resolve_type_subst`; only fires when a substitution context is
    // active and the argument matches one of its params. Falls through
    // to an unconditional check below for a bare builtin scalar keyword
    // argument (`sizeof(bin)`, `sizeof(chr)`, ...), since
    // `write_type_name` passes an unrecognized name through
    // `map_type_to_c` unchanged.
    if equals(callee_name, "sizeof") && args.len == 1 {
      // `sizeof(Generic<T>)` parses as a zero-field `.CompoundInit` node
      // carrying a plain type reference, resolved (and, on first use,
      // monomorphized) like any other generic-type reference.
      fit args.get(0).kind {
        .CompoundInit(ci) -> {
          if ci.has_dtype {
            let resolved = self.resolve_type_name(*ci.init_dtype);
            if resolved.is_some() {
              self.state.write("sizeof(");
              self.write_type_name(resolved.unwrap());
              self.state.write(")");
              ret .None;
            }
          }
        }
        _ -> {}
      }
      str sizeof_operand = "";
      bin have_sizeof_operand = false;
      fit args.get(0).kind {
        .Identifier(name) -> {
          sizeof_operand = name;
          have_sizeof_operand = true;
        }
        _ -> {}
      }
      if have_sizeof_operand {
        if self.type_subst_param_names.len > 0 {
          num spi = 0;
          for spi < self.type_subst_param_names.len {
            if equals(self.type_subst_param_names.get(spi), sizeof_operand) {
              self.state.write("sizeof(");
              self.write_type_name(self.type_subst_arg_type_strs.get(spi));
              if self.type_subst_arg_is_pointer.get(spi) {
                self.state.write("*");
              }
              self.state.write(")");
              ret .None;
            }
            spi = spi + 1;
          }
        }
        // The operand may carry the stars of a pointer type, which name
        // no type of their own: the base is mapped and they are written
        // back after it.
        StringBuilder stars = string_builder_init(4);
        for ends_with(sizeof_operand, "*") {
          stars.append("*");
          sizeof_operand = substr(sizeof_operand, 0, len(sizeof_operand) - 1);
        }
        self.state.write("sizeof(");
        self.write_type_name(sizeof_operand);
        self.state.write(stars.build());
        self.state.write(")");
        ret .None;
      }
    }

    // A call to a generic function is monomorphized from this call site's
    // arguments under a mangled name; a plain or unrecognized callee
    // keeps `callee_name`. `template_callee_name` holds the un-mangled
    // name for the per-argument bare-shorthand lookup below, since
    // `lookup_function_param_type` only knows a template by its bare name.
    str template_callee_name = callee_name;
    let generic_inst = self.maybe_instantiate_generic_function(callee_name, args, e.generic_args);
    if generic_inst.is_some() {
      callee_name = generic_inst.unwrap().mangled_name;
    } else {
      // A non-generic plain function's signature can still be unsafe for
      // the early forward-declare pass. A generic function's prototype
      // and body are handled by `maybe_instantiate_generic_function`.
      self.ensure_plain_function_prototype_emitted(callee_name);
    }
    self.state.write(self.emit_callee_name(callee_name, callee_is_alias_qualified));
    self.state.write("(");

    bin first = true;
    num arg_idx = 0;
    for arg : args {
      if !first {
        self.state.write(", ");
      }
      first = false;

      // A bare enum-variant shorthand (`.Parse`) passed as a call
      // argument resolves against the callee's declared parameter type at
      // this position. A generic callee must use the call's substituted
      // param type, not the template's raw type param, which resolves to
      // nothing; anything unresolvable leaves `expected_enum_type` alone.
      Option<DataType> ptype = .None;
      if generic_inst.is_some() {
        let call_res = generic_inst.unwrap();
        if arg_idx < call_res.param_types.len {
          ptype = .Some(call_res.param_types.get(arg_idx));
        }
      }
      if ptype.is_none() {
        let plain_ptype = self.lookup_function_param_type(template_callee_name, arg_idx);
        if plain_ptype.is_some() {
          ptype = .Some(*plain_ptype.unwrap());
        }
      }
      str prev_expected = self.expected_enum_type;
      bin arg_did_quirk_coerce = false;
      if ptype.is_some() {
        let resolved = self.resolve_type_name(ptype.unwrap());
        if resolved.is_some() {
          self.expected_enum_type = resolved.unwrap();
          // A concrete-typed argument passed where the declared parameter
          // is a quirk type needs the same coercion wrap a `Variable` or
          // `ret` initializer gets; without it the argument's concrete
          // pointer would be passed where C expects the quirk's
          // fat-pointer struct by value.
          if self.quirk_names.contains(resolved.unwrap()) {
            let arg_concrete = self.resolve_quirk_coerce_concrete_type(arg);
            if arg_concrete.is_some() {
              self.state.write("__fun_coerce_");
              self.state.write(arg_concrete.unwrap());
              self.state.write("_");
              self.state.write(resolved.unwrap());
              self.state.write("(");
              arg_did_quirk_coerce = true;
            }
          }
        }
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      if aerr.is_some() {
        ret aerr;
      }
      if arg_did_quirk_coerce {
        self.state.write(")");
      }
      arg_idx = arg_idx + 1;
    }
    // Trailing params omitted at this call site get their declared
    // default value expression filled in here. A generic call is looked
    // up under the name it was written as, since what the instantiation
    // is called says nothing about the defaults the template declared.
    let defaults = self.lookup_function_default_values(template_callee_name);
    if defaults.is_some() {
      let dparam_types = self.lookup_function_param_types(template_callee_name);
      let derr = self.emit_default_trailing_args(
        defaults.unwrap(),
        dparam_types,
        args.len,
        args.len > 0
      );
      if derr.is_some() {
        ret derr;
      }
    } else {
      let generic_defaults = self.lookup_generic_default_values(template_callee_name);
      if generic_defaults.is_some() {
        let gderr = self.emit_default_trailing_args(
          generic_defaults.unwrap(),
          .None,
          args.len,
          args.len > 0
        );
        if gderr.is_some() {
          ret gderr;
        }
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits `, <default value expr>` for each trailing parameter position
  // from `provided_count` onward that has a recorded default; a `nil`
  // entry means no default and stops the fill. `param_types`, when the
  // caller has it, is resolved into
  // `expected_enum_type`/`expected_compound_type` first, so a default
  // that is itself a bare shorthand has something to resolve against.
  emit_default_trailing_args(
    Vec<Node*> defaults,
    Option<Vec<DataType*>> param_types,
    num provided_count,
    bin anything_written
  ) Option<CodegenErrorKind> {
    bin needs_separator = anything_written;
    num i = provided_count;
    for i < defaults.len {
      Node* d = defaults.get(i);
      if d == nil {
        ret .None;
      }
      // A separator only where something precedes it. A method call has
      // already written its receiver, while a call that supplied no
      // arguments at all starts the list here.
      if needs_separator {
        self.state.write(", ");
      }
      needs_separator = true;
      str prev_expected_e = self.expected_enum_type;
      str prev_expected_c = self.expected_compound_type;
      if param_types.is_some() {
        let ptypes = param_types.unwrap();
        if i < ptypes.len {
          let resolved = self.resolve_type_name(*ptypes.get(i));
          if resolved.is_some() {
            self.expected_enum_type = resolved.unwrap();
            self.expected_compound_type = resolved.unwrap();
          }
        }
      }
      let derr = self.emit_expr(*d);
      self.expected_enum_type = prev_expected_e;
      self.expected_compound_type = prev_expected_c;
      if derr.is_some() {
        ret derr;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Infers a C element type for a bare array literal from its first
  // element, for a `let`-inferred declaration's GNU compound-literal
  // cast. Defaults to `int64_t` for anything unrecognized, which at worst
  // produces a C type error rather than a silently wrong value.
  infer_array_literal_elem_c_type(Node* inner) str {
    Vec<Node*> elems;
    elems.init(0);
    defer elems.free();
    self.flatten_call_args(inner, &elems);
    if elems.len == 0 {
      ret "int64_t";
    }
    let first = elems.get(0);
    fit first.kind {
      .Number(data) -> {
        fit data {
          .Dec(_) -> { ret "double"; }
          _ -> { ret "int64_t"; }
        }
      }
      .String(_) -> { ret "char*"; }
      .Character(_) -> { ret "char"; }
      .Boolean(_) -> { ret "bool"; }
      .Identifier(name) -> {
        let tn = self.lookup_local_type_name(name);
        if tn.is_some() {
          ret map_type_to_c(tn.unwrap());
        }
        ret "int64_t";
      }
      // An explicit compound literal such as `[Point{x = 0, y = 1}]`
      // carries its type name directly, as in `infer_let_expr_type`.
      .CompoundInit(ci) -> {
        if ci.has_dtype {
          ret ci.init_dtype.type_str;
        }
        ret "int64_t";
      }
      // A call to a registered plain function uses its declared return
      // type.
      .Expression(e2) -> {
        if equals(e2.op, "()") && e2.has_left {
          fit e2.left.kind {
            .Identifier(fn_name) -> {
              let rt = self.lookup_function_rtype(fn_name);
              if rt.is_some() {
                ret rt.unwrap().type_str;
              }
            }
            _ -> {}
          }
        }
        ret "int64_t";
      }
      _ -> { ret "int64_t"; }
    }
  }

  // Hoists a call expression's rendered text (`recv_r.text`, an rvalue)
  // into a fresh temp spliced right before the current statement,
  // returning the temp's name. Shared by `emit_method_call` (which
  // needs `&<rvalue>`, invalid C without this) and
  // `emit_quirk_dispatch_call` (which reads the same rvalue twice, once
  // for `.vtable` and once for `.self`; without hoisting it, that
  // silently runs the call twice at runtime).
  // `recv_type_name`/`recv_is_pointer`: when non-empty and
  // `self.msvc_mode`, emits an explicit C type instead of `__auto_type`.
  hoist_call_result_to_temp(str call_text, str recv_type_name, bin recv_is_pointer) str {
    self.call_recv_temp_counter = self.call_recv_temp_counter + 1;
    StringBuilder recv_tmp_name_sb = string_builder_init(24);
    recv_tmp_name_sb.append("__fun_recv_tmp");
    recv_tmp_name_sb.append(format_num(self.call_recv_temp_counter));
    str recv_tmp_name = recv_tmp_name_sb.build();

    StringBuilder recv_tmp_stmt_sb = string_builder_init(64);
    num recv_tmp_ii = 0;
    for recv_tmp_ii < self.state.indent_level {
      recv_tmp_stmt_sb.append("    ");
      recv_tmp_ii = recv_tmp_ii + 1;
    }
    if self.msvc_mode && !equals(recv_type_name, "") {
      recv_tmp_stmt_sb.append(map_type_to_c(recv_type_name));
      if recv_is_pointer {
        recv_tmp_stmt_sb.append("*");
      }
    } else {
      recv_tmp_stmt_sb.append("__auto_type");
    }
    recv_tmp_stmt_sb.append(" ");
    recv_tmp_stmt_sb.append(recv_tmp_name);
    recv_tmp_stmt_sb.append(" = ");
    recv_tmp_stmt_sb.append(call_text);
    recv_tmp_stmt_sb.append(";\n");

    if self.hoist_scratch_depth > 0 {
      // Nested inside `resolve_field_chain`'s call-as-receiver scratch
      // buffer. `hoist_insert_pos`/`current_stmt_start_pos` only reach
      // that enclosing buffer, which holds an expression result rather
      // than a statement, so this reaches through to the root buffer
      // and position instead.
      CodegenState* saved_nested_state = self.state;
      let saved_nested_hoist_pos = self.hoist_insert_pos;
      let saved_nested_stmt_pos = self.current_stmt_start_pos;
      self.state = self.root_state;
      self.hoist_insert_pos = self.root_stmt_start_pos;
      self.current_stmt_start_pos = self.root_stmt_start_pos;
      str recv_tmp_text_root = recv_tmp_stmt_sb.build();
      // `root_hoist_pos` tracks a coarser position into the same root
      // buffer, so it needs the same splice-shift adjustment that
      // `emit_hoisted` below applies to `current_stmt_start_pos`.
      let root_splice_pos_before = self.current_stmt_start_pos;
      self.emit_hoisted(recv_tmp_text_root);
      if root_splice_pos_before.is_some() {
        self.root_hoist_pos = adjust_pos_after_splice(
          self.root_hoist_pos,
          root_splice_pos_before.unwrap(),
          len(recv_tmp_text_root)
        );
      }
      self.root_stmt_start_pos = self.current_stmt_start_pos;
      self.state = saved_nested_state;
      self.hoist_insert_pos = saved_nested_hoist_pos;
      self.current_stmt_start_pos = saved_nested_stmt_pos;
    } else {
      let saved_recv_tmp_hoist_pos = self.hoist_insert_pos;
      let recv_tmp_splice_pos = self.current_stmt_start_pos;
      self.hoist_insert_pos = recv_tmp_splice_pos;
      str recv_tmp_text = recv_tmp_stmt_sb.build();
      self.emit_hoisted(recv_tmp_text);
      // `saved_recv_tmp_hoist_pos` is a captured local, so this splice
      // needs a manual adjustment.
      if recv_tmp_splice_pos.is_some() {
        saved_recv_tmp_hoist_pos = adjust_pos_after_splice(
          saved_recv_tmp_hoist_pos,
          recv_tmp_splice_pos.unwrap(),
          len(recv_tmp_text)
        );
      }
      self.hoist_insert_pos = saved_recv_tmp_hoist_pos;
    }
    ret recv_tmp_name;
  }

  // Emits `recv.method(args...)` as C `recv.vtable->method(recv.self,
  // args...)`, using `->` throughout when `recv` is a pointer to the
  // quirk's fat-pointer struct. The dynamic-dispatch counterpart to
  // `emit_method_call`'s static dispatch, called once `recv_r.type_name`
  // is recognized as a quirk. A call-result receiver is hoisted into a
  // temp first, since its rendered text is read twice below (`.vtable`,
  // then `.self`) and evaluating the call itself twice would run it
  // twice at runtime.
  emit_quirk_dispatch_call(ChainResolution recv_r, str method_name, Node* args_node) Option<CodegenErrorKind> {
    str recv_text = recv_r.text;
    if recv_r.is_call_result {
      recv_text = self.hoist_call_result_to_temp(recv_r.text, recv_r.type_name, recv_r.is_pointer);
    }
    str sep = ".";
    if recv_r.is_pointer {
      sep = "->";
    }
    self.state.write(recv_text);
    self.state.write(sep);
    self.state.write("vtable->");
    self.state.write(method_name);
    self.state.write("(");
    self.state.write(recv_text);
    self.state.write(sep);
    self.state.write("self");
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);
    for arg : args {
      self.state.write(", ");
      let aerr = self.emit_expr(*arg);
      if aerr.is_some() {
        ret aerr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Resolves the concrete type an expression's value coerces from, for a
  // quirk-typed destination such as a `Variable` initializer or a `ret`
  // from a quirk-returning function; the `__fun_coerce_<Type>_<Quirk>`
  // helper needs `<Type>` by name. Handles `&identifier` and a bare
  // identifier that's already a pointer; `.None` for anything else.
  resolve_quirk_coerce_concrete_type(Node* exp) Option<str> {
    fit exp.kind {
      .Unary(u) -> {
        if equals(u.op, "&") && !u.is_left_operanded_unary {
          ret self.resolve_quirk_coerce_addressed_type(u.operand);
        }
      }
      .Identifier(name) -> {
        let is_ptr = self.lookup_local_is_pointer(name);
        if is_ptr.is_some() && is_ptr.unwrap() {
          ret self.lookup_local_type_name(name);
        }
      }
      _ -> {}
    }
    ret .None;
  }

  // The concrete type a `&`-taken operand names, for `resolve_quirk_coerce_
  // concrete_type`'s pointer case: a bare local, an array element
  // (`&arr[i]`, which reads the element's own type since a fixed-size
  // array local is already tracked under it), or a compound field
  // (`&struct.field`, read from the field's declared type).
  resolve_quirk_coerce_addressed_type(Node* operand) Option<str> {
    fit operand.kind {
      .Identifier(oname) -> { ret self.lookup_local_type_name(oname); }
      .Expression(e) -> {
        if equals(e.op, "[]") && e.has_left {
          ret self.resolve_quirk_coerce_addressed_type(e.left);
        }
        if equals(e.op, ".") && e.has_left && e.has_right {
          let recv_r_opt = self.resolve_field_chain(e.left);
          if recv_r_opt.is_none() {
            ret .None;
          }
          str field_name = "";
          fit e.right.kind {
            .Identifier(n) -> { field_name = n; }
            _ -> { ret .None; }
          }
          if equals(field_name, "") {
            ret .None;
          }
          let field_info = self.lookup_compound_field(recv_r_opt.unwrap().type_name, field_name);
          if field_info.is_none() {
            ret .None;
          }
          ret .Some(field_info.unwrap().type_name);
        }
      }
      _ -> {}
    }
    ret .None;
  }

  // Emits a method call `recv.method(arg1, ...)` as C
  // `TypeName__method(<self-arg>, arg1, ...)`, or
  // `TypeName__Quirk__method(...)` when `method` came from a
  // quirk-implementing impl, falling back to plain `TypeName__method`
  // when nothing is registered. `recv` must be a plain identifier or a
  // chain `resolve_field_chain` can resolve; anything else is rejected
  // rather than guessed. A receiver whose resolved type is a known quirk
  // dispatches dynamically through its vtable instead.
  emit_method_call(ExprNode recv_e, Node* args_node) Option<CodegenErrorKind> {
    if !recv_e.has_left || !recv_e.has_right {
      ret .Some(.InvalidNode);
    }
    let recv_r_opt = self.resolve_field_chain(recv_e.left);
    if recv_r_opt.is_none() {
      ret .Some(.UnsupportedNode);
    }
    let recv_r = recv_r_opt.unwrap();
    str method_name = "";
    fit recv_e.right.kind {
      .Identifier(name) -> { method_name = name; }
      _ -> { ret .Some(.UnsupportedNode); }
    }

    if self.quirk_names.contains(recv_r.type_name) {
      ret self.emit_quirk_dispatch_call(recv_r, method_name, args_node);
    }

    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);

    // A method declaring its own generic type param (`impl Box<T> { pub
    // wrap<U>(U x) Box<U> { ... } }`) needs a combined substitution, the
    // impl's `T` plus this call's `U` inferred from `args`, that neither
    // `ensure_generic_impl_method_emitted` nor the static dispatch below
    // builds, so it is checked first.
    bin used_own_param_inst = false;
    if self.impl_method_has_own_type_params(recv_r.type_name, method_name) {
      let own_inst = self.maybe_instantiate_generic_impl_method_own_params(
        recv_r.type_name,
        method_name,
        args
      );
      if own_inst.is_some() {
        self.state.write(own_inst.unwrap().mangled_name);
        used_own_param_inst = true;
      }
    }

    if !used_own_param_inst {
      // A generic impl method such as `Vec<str>.sum()` gets its C
      // prototype and body emitted here, at the first call site for this
      // instantiation. A no-op for a plain type's method.
      let emit_err = self.ensure_generic_impl_method_emitted(recv_r.type_name, method_name, "");
      if emit_err.is_some() {
        ret emit_err;
      }
      let registered = self.lookup_impl_method(recv_r.type_name, method_name);
      if registered.is_some() {
        // A plain impl method whose signature was unsafe for the early
        // forward-declare pass breaks when called from a method defined
        // earlier in the same file, so an inline prototype is placed at
        // this first-use point instead. A no-op once already covered.
        self.ensure_plain_impl_method_prototype_emitted(recv_r.type_name, method_name);
        self.state.write(registered.unwrap());
      } else {
        self.state.write(recv_r.type_name);
        self.state.write("__");
        self.state.write(method_name);
      }
    }
    self.state.write("(");
    if recv_r.is_pointer {
      self.state.write(recv_r.text);
    } elif recv_r.is_call_result {
      // `recv_r.text` is a call's rendered text, an rvalue, and
      // `&<rvalue>` is invalid C. It is hoisted into a fresh
      // `__auto_type` temp spliced right before the current statement,
      // and the temp's address is taken instead.
      str recv_tmp_name = self.hoist_call_result_to_temp(
        recv_r.text,
        recv_r.type_name,
        recv_r.is_pointer
      );
      self.state.write("&");
      self.state.write(recv_tmp_name);
    } else {
      self.state.write("&");
      self.state.write(recv_r.text);
    }

    num arg_idx = 0;
    for arg : args {
      self.state.write(", ");
      // A bare enum-variant shorthand resolves against the callee
      // method's declared parameter type at this position, as in
      // `emit_call`. Anything unresolvable leaves the expected types
      // untouched.
      let ptype = self.lookup_impl_method_param_type(recv_r.type_name, method_name, arg_idx);
      str prev_expected = self.expected_enum_type;
      str prev_expected_compound = self.expected_compound_type;
      if ptype.is_some() {
        let resolved = self.resolve_type_name(*ptype.unwrap());
        if resolved.is_some() {
          self.expected_enum_type = resolved.unwrap();
          self.expected_compound_type = resolved.unwrap();
        }
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      self.expected_compound_type = prev_expected_compound;
      if aerr.is_some() {
        ret aerr;
      }
      arg_idx = arg_idx + 1;
    }
    // The same trailing-default fill-in `emit_call` does for a plain
    // function, keyed by (owner type, bare method name) instead.
    let method_defaults = self.lookup_impl_method_default_values(recv_r.type_name, method_name);
    if method_defaults.is_some() {
      let mdparam_types = self.lookup_impl_method_param_types(recv_r.type_name, method_name);
      // A method call has already written its receiver, so a default
      // never starts the list.
      let mderr = self.emit_default_trailing_args(
        method_defaults.unwrap(),
        mdparam_types,
        args.len,
        true
      );
      if mderr.is_some() {
        ret mderr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits `await expr`, where `expr` must be a call. Lowers to the
  // callee's call helper (`__fun_async_call_<mangled name>`) rather than
  // its plain mangled name. Only a generic impl method's async method is
  // monomorphized here, not a generic plain async function. A quirk-typed
  // receiver degrades to a synchronous call, since the concrete callee
  // behind a quirk dispatch isn't known until runtime.
  emit_await(Node* operand) Option<CodegenErrorKind> {
    fit operand.kind {
      .Expression(e) -> {
        if equals(e.op, "()") && e.has_left {
          fit e.left.kind {
            .Expression(recv_e) -> {
              if equals(recv_e.op, ".") && recv_e.has_left && recv_e.has_right {
                let recv_r_opt = self.resolve_field_chain(recv_e.left);
                if recv_r_opt.is_some() &&
                  self.quirk_names.contains(recv_r_opt.unwrap().type_name) {
                  ret self.emit_expr(*operand);
                }
              }
            }
            _ -> {}
          }
        }
      }
      _ -> {}
    }
    ret self.emit_async_or_fork_call(operand, "__fun_async_call_");
  }

  // `fork expr;` is fire-and-forget: enqueued onto the scheduler via
  // `__fun_go` rather than spawned and joined. Lowers like `await`, using
  // the `__fun_fork_call_` prefix.
  emit_fork_stmt(Node* expr) Option<CodegenErrorKind> {
    ret self.emit_async_or_fork_call(expr, "__fun_fork_call_");
  }

  // Writes `text` as a C string-literal body, escaping the handful of
  // bytes that would otherwise break or change its meaning: a raw asm
  // template's own `%[name]` placeholders and everything else pass
  // through unchanged.
  write_asm_escaped(str text) {
    num i = 0;
    num n = len(text);
    for i < n {
      chr c = text[i];
      if c == '\\' {
        self.state.write("\\\\");
      } elif c == '"' {
        self.state.write("\\\"");
      } elif c == '\n' {
        self.state.write("\\n");
      } elif c == '\r' {
        self.state.write("\\r");
      } elif c == '\t' {
        self.state.write("\\t");
      } elif c == 0 {
        self.state.write("\\0");
      } else {
        self.write_c_char(c);
      }
      i = i + 1;
    }
  }

  // Writes one `[name] "constraint"(expr)` operand of an asm statement's
  // out/in list.
  emit_asm_operand_list(Vec<AsmOperand> list) Option<CodegenErrorKind> {
    bin first = true;
    for op : list {
      if !first {
        self.state.write(", ");
      }
      first = false;
      self.state.write("[");
      self.state.write(op.name);
      self.state.write("] \"");
      self.write_asm_escaped(op.constraint);
      self.state.write("\"(");
      let eerr = self.emit_expr(*op.expr);
      if eerr.is_some() {
        ret eerr;
      }
      self.state.write(")");
    }
    ret .None;
  }

  // Emits an `asm` statement as GCC/Clang extended inline assembly
  // (`__asm__ __volatile__ ("template" : outputs : inputs : clobbers);`).
  // `arch`, when given, is checked against `host_arch_name()`, read
  // from the host machine at runtime rather than baked into the
  // compiler binary, matching the reference compiler's own check.
  emit_asm_stmt(AsmStmtNode a) Option<CodegenErrorKind> {
    if a.has_arch {
      bin arch_ok = false;
      str want = a.arch_name;
      str host = host_arch_name();
      if equals(want, "x86_64") || equals(want, "amd64") {
        arch_ok = equals(host, "x86_64");
      } elif equals(want, "x86") || equals(want, "i386") {
        arch_ok = equals(host, "x86");
      } elif equals(want, "aarch64") || equals(want, "arm64") {
        arch_ok = equals(host, "aarch64");
      } elif equals(want, "arm") {
        arch_ok = equals(host, "arm");
      }
      if !arch_ok {
        self.error_note = format("asm arch '{str}' does not match target", want);
        ret .Some(.InvalidNode);
      }
    }
    self.state.write_indent();
    self.state.write("__asm__");
    if a.is_volatile {
      self.state.write(" __volatile__");
    }
    self.state.write("(\"");
    self.write_asm_escaped(a.template);
    self.state.write("\"");

    bin has_outputs = a.outputs.len > 0;
    bin has_inputs = a.inputs.len > 0;
    bin has_clobbers = a.clobbers.len > 0;

    if has_outputs || has_inputs || has_clobbers {
      self.state.write(" : ");
      if has_outputs {
        let oerr = self.emit_asm_operand_list(a.outputs);
        if oerr.is_some() {
          ret oerr;
        }
      }
      if has_inputs || has_clobbers {
        self.state.write(" : ");
        if has_inputs {
          let ierr = self.emit_asm_operand_list(a.inputs);
          if ierr.is_some() {
            ret ierr;
          }
        }
        if has_clobbers {
          self.state.write(" : ");
          bin first_cl = true;
          for cl : a.clobbers {
            if !first_cl {
              self.state.write(", ");
            }
            first_cl = false;
            self.state.write("\"");
            self.write_asm_escaped(cl);
            self.state.write("\"");
          }
        }
      }
    }

    self.state.write(");\n");
    ret .None;
  }

  // Shared lowering for `await` and `fork` over `f(args...)` or
  // `recv.method(args...)`: both rewrite the call to `<prefix><mangled
  // callee name>(args...)`, with the receiver and self-arg handling an
  // ordinary call gets. Separate from `emit_call`/`emit_method_call`,
  // since neither has a seam to intercept just the callee name.
  emit_async_or_fork_call(Node* operand, str prefix) Option<CodegenErrorKind> {
    fit operand.kind {
      .Expression(e) -> {
        if !equals(e.op, "()") || !e.has_left || !e.has_right {
          ret .Some(.UnsupportedNode);
        }
        fit e.left.kind {
          .Identifier(name) -> {
            Vec<Node*> args;
            args.init(0);
            defer args.free();
            self.flatten_call_args(e.right, &args);
            // A generic callee (`async fun id<T>(T x) T`) needs its
            // mangled instantiation, not the bare template name: the
            // thunk this prefix builds only exists under
            // `__fun_async_call_<mangled name>`, emitted as a side
            // effect of `emit_function_named` on the specialized body
            // `maybe_instantiate_generic_function` produces here.
            str callee_name = name;
            Vec<DataType*> no_explicit_gargs_a;
            no_explicit_gargs_a.init(0);
            let generic_inst = self.maybe_instantiate_generic_function(
              name,
              args,
              no_explicit_gargs_a
            );
            if generic_inst.is_some() {
              callee_name = generic_inst.unwrap().mangled_name;
            }
            self.state.write(prefix);
            self.state.write(callee_name);
            self.state.write("(");
            bin first = true;
            for arg : args {
              if !first {
                self.state.write(", ");
              }
              first = false;
              let aerr = self.emit_expr(*arg);
              if aerr.is_some() {
                ret aerr;
              }
            }
            self.state.write(")");
            ret .None;
          }
          .Expression(recv_e) -> {
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .Some(.UnsupportedNode);
            }
            let recv_r_opt = self.resolve_field_chain(recv_e.left);
            if recv_r_opt.is_none() {
              ret .Some(.UnsupportedNode);
            }
            let recv_r = recv_r_opt.unwrap();
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(mname) -> { method_name = mname; }
              _ -> { ret .Some(.UnsupportedNode); }
            }
            // A generic impl method's first call site for this
            // instantiation; see `emit_method_call`.
            let emit_err = self.ensure_generic_impl_method_emitted(
              recv_r.type_name,
              method_name,
              ""
            );
            if emit_err.is_some() {
              ret emit_err;
            }
            let registered = self.lookup_impl_method(recv_r.type_name, method_name);
            self.state.write(prefix);
            if registered.is_some() {
              self.state.write(registered.unwrap());
            } else {
              self.state.write(recv_r.type_name);
              self.state.write("__");
              self.state.write(method_name);
            }
            self.state.write("(");
            if recv_r.is_pointer {
              self.state.write(recv_r.text);
            } else {
              self.state.write("&");
              self.state.write(recv_r.text);
            }
            Vec<Node*> margs;
            margs.init(0);
            defer margs.free();
            self.flatten_call_args(e.right, &margs);
            for marg : margs {
              self.state.write(", ");
              let maerr = self.emit_expr(*marg);
              if maerr.is_some() {
                ret maerr;
              }
            }
            self.state.write(")");
            ret .None;
          }
          _ -> { ret .Some(.UnsupportedNode); }
        }
      }
      _ -> { ret .Some(.UnsupportedNode); }
    }
  }

  // Emits a tagged-union compound literal for `EnumName.Variant(args...)`:
  // ((EnumName){ .tag = EnumName_Variant, .payload.Variant = { ._0 = (a0), ... } })
  // matching the struct layout `emit_tagged_union_enum` emits, where
  // payload field names `_0`, `_1`, ... line up positionally with the
  // union struct's fields.
  emit_enum_variant_construction(str enum_name, str variant_name, Node* args_node) Option<CodegenErrorKind> {
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);

    self.state.write("((");
    self.state.write(enum_name);
    self.state.write("){ .tag = ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(", .payload.");
    self.state.write(variant_name);
    self.state.write(" = { ");
    num i = 0;
    for arg : args {
      if i > 0 {
        self.state.write(", ");
      }
      self.state.write("._");
      self.state.write(format_num(i));
      self.state.write(" = (");
      // A bare enum-variant shorthand nested inside another variant's
      // construction (`.Ok(.Some(t))`) resolves against this position's
      // payload type. Anything unresolvable leaves `expected_enum_type`
      // untouched.
      let payload_info = self.lookup_enum_variant_payload_type(enum_name, variant_name, i);
      str prev_expected = self.expected_enum_type;
      if payload_info.is_some() {
        self.expected_enum_type = payload_info.unwrap().type_name;
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      if aerr.is_some() {
        ret aerr;
      }
      self.state.write(")");
      i = i + 1;
    }
    self.state.write(" } })");
    ret .None;
  }

  // Emits `arr[i]` as C `arr[i]`, from the parser's `Expression{ op =
  // "[]", left = arr, right = Bracket(i) }`. Needs no type resolution:
  // C's `[]` composes with whatever `arr` emitted as. Also serves as an
  // assignment target, since `=` dispatches its left side through here.
  emit_index(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(.InvalidNode);
    }
    let lerr = self.emit_expr(*e.left);
    if lerr.is_some() {
      ret lerr;
    }
    self.state.write("[");
    fit e.right.kind {
      .Bracket(inner) -> {
        let ierr = self.emit_expr(*inner);
        if ierr.is_some() {
          ret ierr;
        }
      }
      _ -> { ret .Some(.InvalidNode); }
    }
    self.state.write("]");
    ret .None;
  }

  // Emits `recv.field` as C `recv.field` or `recv->field`, deciding
  // `.`/`->` from `recv`'s declared pointer-ness. Also recognizes a
  // qualified enum-variant constant (`EnumName.Variant`, checked first),
  // emitting `EnumName_Variant` rather than treating `EnumName` as a
  // receiver, and a bare `.Variant` shorthand resolved against
  // `expected_enum_type`; both apply only to a single-level receiver. A
  // chained access recurses through `emit_receiver_and_resolve_type` to
  // resolve `.`/`->` at every link, and an unrecognized receiver shape is
  // rejected rather than guessed.
  emit_field_access(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(.InvalidNode);
    }
    str field_name = "";
    fit e.right.kind {
      .Identifier(name) -> { field_name = name; }
      _ -> { ret .Some(.UnsupportedNode); }
    }

    str enum_recv_name = "";
    bin is_bare_shorthand = false;
    bin left_is_single_level = false;

    // `alias.EnumName.Variant` used as a value rather than a call, which
    // `emit_call` handles. `e.left` is `alias.EnumName`, an Expression
    // rather than a bare Identifier, so this is checked before the
    // ordinary single-level case below.
    fit e.left.kind {
      .Expression(inner_e) -> {
        if equals(inner_e.op, ".") && inner_e.has_left && inner_e.has_right {
          // Gated on not already being a known local, since a local
          // always shadows a same-named global alias.
          bin inner_left_is_alias = false;
          fit inner_e.left.kind {
            .Identifier(aname) -> {
              if self.import_aliases.contains(aname) &&
                self.lookup_local_type_name(aname).is_none() {
                inner_left_is_alias = true;
              }
            }
            _ -> {}
          }
          if inner_left_is_alias {
            fit inner_e.right.kind {
              .Identifier(ename) -> {
                enum_recv_name = ename;
                left_is_single_level = true;
              }
              _ -> {}
            }
          }
        }
      }
      _ -> {}
    }
    if left_is_single_level {
      // The alias case above matched, so the ordinary single-level check
      // below is skipped.
    } else {
      fit e.left.kind {
        .Identifier(name) -> {
          enum_recv_name = name;
          left_is_single_level = true;
        }
        .Blank -> {
          // Bare shorthand (`.Variant`, no `EnumName.` qualifier). Must
          // not fall through to the chained-access path below if it
          // doesn't resolve: there's no receiver identifier to look up.
          is_bare_shorthand = true;
          left_is_single_level = true;
          enum_recv_name = self.expected_enum_type;
        }
        _ -> {}
      }
    }
    // `Option<num> b = Option.None;` qualifies against a generic enum's
    // bare template name, which is never registered in `enum_names` (only
    // a concrete instantiation like `Option__num` is), so it falls back
    // to `expected_enum_type`, which already holds that mangled name.
    if left_is_single_level && !is_bare_shorthand &&
      !self.enum_has_variant(
      enum_recv_name,
      field_name
    ) {
      StringBuilder tmpl_pfx = string_builder_init(16);
      tmpl_pfx.append(enum_recv_name);
      tmpl_pfx.append("__");
      if starts_with(self.expected_enum_type, tmpl_pfx.build()) &&
        self.enum_has_variant(
        self.expected_enum_type,
        field_name
      ) {
        enum_recv_name = self.expected_enum_type;
      }
    }
    if left_is_single_level && !equals(enum_recv_name, "") &&
      self.enum_has_variant(
      enum_recv_name,
      field_name
    ) {
      if self.enum_is_tagged_union_named(enum_recv_name) {
        // A tagged union's payload-less variant used as a bare value
        // still needs the tag set: `((Enum){ .tag = Enum_Variant })`, not
        // just the bare discriminant constant.
        self.state.write("((");
        self.state.write(enum_recv_name);
        self.state.write("){ .tag = ");
        self.state.write(enum_recv_name);
        self.state.write("_");
        self.state.write(field_name);
        self.state.write(" })");
      } else {
        self.state.write(enum_recv_name);
        self.state.write("_");
        self.state.write(field_name);
      }
      ret .None;
    }
    if is_bare_shorthand {
      ret .Some(.UnsupportedNode);
    }

    // `alias.global` reads a public global from an aliased import. The
    // import is flattened into one program, so the global keeps its own
    // name and the alias qualifier is dropped. Gated on not being a
    // known local, which always shadows a same-named alias.
    fit e.left.kind {
      .Identifier(alias_name) -> {
        if self.import_aliases.contains(alias_name) &&
          self.lookup_local_type_name(alias_name).is_none() {
          let renamed = self.lookup_alias_rename(alias_name, field_name);
          if renamed.is_some() {
            self.state.write(renamed.unwrap());
          } else {
            self.state.write(field_name);
          }
          ret .None;
        }
      }
      _ -> {}
    }

    let recv_info_opt = self.emit_receiver_and_resolve_type(e.left);
    if recv_info_opt.is_none() {
      ret .Some(.UnsupportedNode);
    }
    if recv_info_opt.unwrap().is_pointer {
      self.state.write("->");
    } else {
      self.state.write(".");
    }
    self.state.write(field_name);
    ret .None;
  }

  // Resolves `recv`'s C text and declared type without writing to
  // `self.state`: the pure counterpart to
  // `emit_receiver_and_resolve_type`, for wherever a receiver's text is
  // computed once and written several times, such as `emit_fit`'s
  // subject. `recv` is a plain identifier resolved as a known local, or a
  // `.`-Expression recursed through here to resolve its own receiver
  // first. `.None` means the shape isn't resolvable and the caller must
  // not guess. Enum-variant and bare-shorthand shapes never appear
  // mid-chain, so only plain field access is handled.
  resolve_field_chain(Node* recv) Option<ChainResolution> {
    fit recv.kind {
      .Identifier(name) -> {
        let type_found = self.lookup_local_type_name(name);
        let ptr_found = self.lookup_local_is_pointer(name);
        if type_found.is_none() || ptr_found.is_none() {
          ret .None;
        }
        ChainResolution r;
        r.text = name;
        r.type_name = type_found.unwrap();
        r.is_pointer = ptr_found.unwrap();
        r.dtype = self.lookup_local_dtype(name);
        r.is_call_result = false;
        ret .Some(r);
      }
      .Expression(inner_e) -> {
        // A call as the receiver (`tok.unwrap().type`), with no
        // intermediate `let` binding. Resolved in two steps: the call's
        // declared return type, then its rendered C text. Unlike every
        // other link in a chain, that text can't be built by string
        // concatenation, since a call's emission logic lives in
        // `emit_expr`/`emit_call`, so it is captured by rendering into a
        // throwaway scratch buffer.
        if equals(inner_e.op, "()") && inner_e.has_left {
          Option<DataType> call_rtype = .None;
          fit inner_e.left.kind {
            .Identifier(fn_name) -> {
              let rt = self.lookup_function_rtype(fn_name);
              if rt.is_some() {
                call_rtype = .Some(*rt.unwrap());
              }
            }
            .Expression(recv_e) -> {
              if equals(recv_e.op, ".") && recv_e.has_left && recv_e.has_right {
                str method_name = "";
                fit recv_e.right.kind {
                  .Identifier(n) -> { method_name = n; }
                  _ -> {}
                }
                // `alias.func(args)`, a plain function call qualified by
                // an import alias, shares the `.`-`()` AST shape of a
                // method call. When `recv_e.left` is a known alias rather
                // than a receiver, `method_name` is the callee's bare
                // name and resolves via the plain-function lookup.
                bin left_is_known_alias2 = false;
                if !equals(method_name, "") {
                  fit recv_e.left.kind {
                    .Identifier(lname2) -> {
                      if self.import_aliases.contains(lname2) &&
                        self.lookup_local_type_name(lname2).is_none() {
                        left_is_known_alias2 = true;
                      }
                    }
                    _ -> {}
                  }
                }
                if left_is_known_alias2 {
                  let alias_rt = self.lookup_function_rtype(method_name);
                  if alias_rt.is_some() {
                    call_rtype = .Some(*alias_rt.unwrap());
                  }
                } elif !equals(method_name, "") {
                  let recv_r_opt = self.resolve_field_chain(recv_e.left);
                  if recv_r_opt.is_some() {
                    let recv_r2 = recv_r_opt.unwrap();
                    // A method declaring its own generic type param needs
                    // the combined substitution
                    // `maybe_instantiate_generic_impl_method_own_params`
                    // builds; `lookup_impl_method_rtype` below only knows
                    // the raw unsubstituted template return type.
                    if inner_e.has_right &&
                      self.impl_method_has_own_type_params(
                      recv_r2.type_name,
                      method_name
                    ) {
                      Vec<Node*> own_args;
                      own_args.init(0);
                      self.flatten_call_args(inner_e.right, &own_args);
                      let own_res = self.maybe_instantiate_generic_impl_method_own_params(
                        recv_r2.type_name,
                        method_name,
                        own_args
                      );
                      if own_res.is_some() {
                        call_rtype = .Some(own_res.unwrap().rtype);
                      }
                    }
                    if call_rtype.is_none() {
                      let rt = self.lookup_impl_method_rtype(recv_r2.type_name, method_name);
                      if rt.is_some() {
                        call_rtype = .Some(*rt.unwrap());
                      }
                    }
                    // A quirk-typed receiver dispatches dynamically, so
                    // no concrete impl owns the call; the return type
                    // comes from what the quirk itself declares instead.
                    if call_rtype.is_none() &&
                      self.quirk_names.contains(recv_r2.type_name) {
                      let qrt = self.lookup_quirk_method_rtype(recv_r2.type_name, method_name);
                      if qrt.is_some() {
                        call_rtype = .Some(*qrt.unwrap());
                      }
                    }
                  }
                }
              }
            }
            _ -> {}
          }
          if call_rtype.is_none() {
            ret .None;
          }
          let rdt = self.resolve_type_subst(call_rtype.unwrap());
          let resolved_name_opt = self.resolve_type_name(rdt);
          if resolved_name_opt.is_none() {
            ret .None;
          }

          // `hoist_insert_pos`/`current_stmt_start_pos` are suspended for
          // this scratch-buffer swap, so a nested hoisted emission
          // splices into the real buffer rather than this throwaway one.
          // `suppress_generic_impl_method_draining` additionally stops a
          // method from being emitted while `self.state` points here; it
          // is enqueued instead and drained once the real state is
          // restored, unless an outer drain or probe is already running.
          if self.hoist_scratch_depth == 0 {
            self.root_state = self.state;
            self.root_hoist_pos = self.hoist_insert_pos;
            self.root_stmt_start_pos = self.current_stmt_start_pos;
          }
          self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
          CodegenState call_scratch = codegen_state_new();
          CodegenState* saved_call_state = self.state;
          let saved_call_hoist_pos = self.hoist_insert_pos;
          let saved_call_stmt_start_pos = self.current_stmt_start_pos;
          let prev_suppress = self.suppress_generic_impl_method_draining;
          self.state = &call_scratch;
          self.hoist_insert_pos = .None;
          self.current_stmt_start_pos = .None;
          self.suppress_generic_impl_method_draining = true;
          let cerr = self.emit_expr(*recv);
          self.state = saved_call_state;
          self.hoist_insert_pos = saved_call_hoist_pos;
          self.current_stmt_start_pos = saved_call_stmt_start_pos;
          self.suppress_generic_impl_method_draining = prev_suppress;
          self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
          if self.hoist_scratch_depth == 0 {
            // Leaving nested receiver-chain territory. `root_stmt_start
            // _pos` holds the current position after any splices made
            // during the nested session and can be ahead of the restored
            // `saved_call_stmt_start_pos`, so syncing back to it keeps a
            // further receiver-temp hoist after everything already
            // spliced. `hoist_insert_pos` needs the same resync, since a
            // nested instantiation advances `root_hoist_pos` directly.
            self.current_stmt_start_pos = self.root_stmt_start_pos;
            self.hoist_insert_pos = self.root_hoist_pos;
          }
          if !prev_suppress && !self.draining_generic_impl_methods {
            self.drain_pending_generic_impl_methods();
          }
          if cerr.is_some() {
            ret .None;
          }

          // The call's rendered text is an rvalue: fine to embed for a
          // further `.field` read, but not addressable, so a caller
          // needing `&<receiver>` would emit invalid C. `is_call_result`
          // flags it so such a caller hoists an addressable temp itself.
          // Hoisting here unconditionally would inject an extra statement
          // for a plain field read that never needs addressing.
          ChainResolution r;
          r.text = call_scratch.out.build();
          r.type_name = resolved_name_opt.unwrap();
          r.is_pointer = dtype_is_pointer(rdt);
          r.dtype = .Some(rdt);
          r.is_call_result = true;
          ret .Some(r);
        }
        // An indexed receiver (`arr[0].getV()`), for a fixed-size array
        // local: the element is what is addressed, so its type is what
        // the array itself is already tracked under (see
        // `resolve_quirk_coerce_addressed_type`'s array case, which
        // reads the same thing for `&arr[i]`). Only a bare array
        // identifier is handled; a further chain (`self.arr[0]`) is not
        // attempted.
        if equals(inner_e.op, "[]") && inner_e.has_left {
          str elem_type_name = "";
          bin elem_is_pointer = false;
          Option<DataType> elem_dtype = .None;
          bin have_elem = false;
          fit inner_e.left.kind {
            .Identifier(arr_name) -> {
              let t = self.lookup_local_type_name(arr_name);
              if t.is_some() {
                elem_type_name = t.unwrap();
                elem_dtype = self.lookup_local_dtype(arr_name);
                if elem_dtype.is_some() {
                  let edt = elem_dtype.unwrap();
                  if edt.is_array {
                    // A real array's own element star (if any) survives
                    // indexing unchanged; the array-ness is what decays.
                    elem_is_pointer = dtype_is_pointer(edt);
                  } else {
                    // A raw pointer indexed like an array (`pts[0]`,
                    // pointer arithmetic for `*(pts + 0)`) dereferences
                    // one level of the pointer itself: `Point* pts`
                    // yields a value, `Point** pts` yields `Point*`.
                    elem_is_pointer = edt.pointer_depth > 1;
                  }
                } else {
                  let p = self.lookup_local_is_pointer(arr_name);
                  elem_is_pointer = p.is_some() && p.unwrap();
                }
                have_elem = true;
              }
            }
            _ -> {}
          }
          if !have_elem {
            ret .None;
          }

          // Rendered the same way a call-as-receiver is: the index can
          // be any expression, not just a literal, so it is emitted
          // through the ordinary expression path into a scratch buffer
          // rather than rebuilt by hand.
          if self.hoist_scratch_depth == 0 {
            self.root_state = self.state;
            self.root_hoist_pos = self.hoist_insert_pos;
            self.root_stmt_start_pos = self.current_stmt_start_pos;
          }
          self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
          CodegenState idx_scratch = codegen_state_new();
          CodegenState* saved_idx_state = self.state;
          let saved_idx_hoist_pos = self.hoist_insert_pos;
          let saved_idx_stmt_start_pos = self.current_stmt_start_pos;
          let prev_idx_suppress = self.suppress_generic_impl_method_draining;
          self.state = &idx_scratch;
          self.hoist_insert_pos = .None;
          self.current_stmt_start_pos = .None;
          self.suppress_generic_impl_method_draining = true;
          let ixerr = self.emit_expr(*recv);
          self.state = saved_idx_state;
          self.hoist_insert_pos = saved_idx_hoist_pos;
          self.current_stmt_start_pos = saved_idx_stmt_start_pos;
          self.suppress_generic_impl_method_draining = prev_idx_suppress;
          self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
          if self.hoist_scratch_depth == 0 {
            self.current_stmt_start_pos = self.root_stmt_start_pos;
            self.hoist_insert_pos = self.root_hoist_pos;
          }
          if !prev_idx_suppress && !self.draining_generic_impl_methods {
            self.drain_pending_generic_impl_methods();
          }
          if ixerr.is_some() {
            ret .None;
          }

          ChainResolution r;
          r.text = idx_scratch.out.build();
          r.type_name = elem_type_name;
          r.is_pointer = elem_is_pointer;
          r.dtype = elem_dtype;
          // A real array's element is addressable in C, unlike a call's
          // rvalue result.
          r.is_call_result = false;
          ret .Some(r);
        }
        if !equals(inner_e.op, ".") || !inner_e.has_left || !inner_e.has_right {
          ret .None;
        }
        str field_name = "";
        fit inner_e.right.kind {
          .Identifier(name) -> { field_name = name; }
          _ -> { ret .None; }
        }
        let recv_r_opt = self.resolve_field_chain(inner_e.left);
        if recv_r_opt.is_none() {
          ret .None;
        }
        let recv_r = recv_r_opt.unwrap();
        let field_info_opt = self.lookup_compound_field(recv_r.type_name, field_name);
        if field_info_opt.is_none() {
          ret .None;
        }
        let field_info = field_info_opt.unwrap();
        StringBuilder sb = string_builder_init(8);
        sb.append(recv_r.text);
        if recv_r.is_pointer {
          sb.append("->");
        } else {
          sb.append(".");
        }
        sb.append(field_name);
        ChainResolution r;
        r.text = sb.build();
        r.type_name = field_info.type_name;
        r.is_pointer = field_info.is_pointer;
        r.dtype = field_info.dtype;
        // Propagated, not reset: a `.field` read off a call-result
        // receiver is still not addressable in C, so the chain inherits
        // the innermost receiver's rvalue-ness.
        r.is_call_result = recv_r.is_call_result;
        ret .Some(r);
      }
      // A parenthesized receiver resolves like its unwrapped inner
      // expression; the parens carry no separate meaning here.
      .ExpressionParenthesis(inner) -> { ret self.resolve_field_chain(inner); }
      // `(*ptr_expr).field`: a dereference receiver resolves its operand
      // first, then clears `is_pointer` and drops one level of `dtype`'s
      // `pointer_depth`, since a dereferenced pointer is a plain value.
      // Only a single, non-left-operanded `*`; `**pp` isn't produced here.
      .Unary(u) -> {
        if !equals(u.op, "*") || u.is_left_operanded_unary || !u.has_indirection ||
          u.indirection_depth != 1 {
          ret .None;
        }
        let recv_r_opt = self.resolve_field_chain(u.operand);
        if recv_r_opt.is_none() {
          ret .None;
        }
        let recv_r = recv_r_opt.unwrap();
        if !recv_r.is_pointer {
          ret .None;
        }
        StringBuilder deref_sb = string_builder_init(8);
        deref_sb.append("(*");
        deref_sb.append(recv_r.text);
        deref_sb.append(")");
        Option<DataType> deref_dtype = recv_r.dtype;
        if deref_dtype.is_some() {
          DataType dd = deref_dtype.unwrap();
          if dd.pointer_depth > 0 {
            dd.pointer_depth = dd.pointer_depth - 1;
          }
          // `dtype_is_pointer` also honors `flags.is_pointer`
          // independently of `pointer_depth`, so clearing it too is what
          // keeps the deref from still reading as a pointer.
          dd.flags.is_pointer = false;
          deref_dtype = .Some(dd);
        }
        ChainResolution r;
        r.text = deref_sb.build();
        r.type_name = recv_r.type_name;
        r.is_pointer = false;
        r.dtype = deref_dtype;
        r.is_call_result = false;
        ret .Some(r);
      }
      _ -> { ret .None; }
    }
  }

  // Emits `recv`'s C text (via `resolve_field_chain`) and returns its
  // resolved declared type, so the caller (`emit_field_access`) can
  // decide `.`/`->` for the next link in a chain it's emitting inline.
  emit_receiver_and_resolve_type(Node* recv) Option<FieldTypeInfo> {
    let resolved = self.resolve_field_chain(recv);
    if resolved.is_none() {
      ret .None;
    }
    let r = resolved.unwrap();
    self.state.write(r.text);
    FieldTypeInfo info;
    info.type_name = r.type_name;
    info.is_pointer = r.is_pointer;
    info.dtype = r.dtype;
    ret .Some(info);
  }

  // Emits one statement plus its trailing newline.
  // `StatementIf`/`StatementElseIf`/`StatementElse` aren't handled here:
  // they're only valid chained together, which needs the sibling
  // lookahead only `emit_statements` has, so reaching this with one of
  // them errors rather than emitting an invalid lone fragment.
  pub emit_statement(Node node) Option<CodegenErrorKind> {
    self.mark_node(node);
    fit node.kind {
      .StatementReturn(exp) -> {
        // `main` always emits as `int main(...)` regardless of its
        // declared Fun-level return type, so `ret <expr>;` can write the
        // real expression only when that type is a scalar `num`; anything
        // else must discard it and report success, since returning a
        // struct from an `int`-returning C function is an error. Pending
        // defers still run either way; only the value is skipped.
        bin main_discards_return = false;
        if self.in_main {
          main_discards_return = true;
          if self.current_fn_rtype_dt.is_some() {
            let main_rt = self.current_fn_rtype_dt.unwrap();
            if equals(main_rt.type_str, "num") && !main_rt.is_array &&
              main_rt.pointer_depth == 0 {
              main_discards_return = false;
            }
          }
        }
        if main_discards_return {
          // The discarded expression is still evaluated for its side
          // effects, into a throwaway scratch buffer. `hoist_insert_pos`
          // is suspended for the swap so a nested hoisted type dependency
          // doesn't splice at a stale position into this tiny buffer; a
          // generic function reached only from here is never hoisted,
          // since lazy triggers fire only when `emit_expr` writes
          // somewhere real.
          if exp != nil {
            CodegenState main_discard_scratch = codegen_state_new();
            CodegenState* saved_discard_state = self.state;
            let saved_discard_hoist_pos = self.hoist_insert_pos;
            // Suspended alongside `hoist_insert_pos`, so a method call
            // inside the discarded expression can't use a
            // real-buffer-sized position as a bound on this scratch
            // buffer.
            let saved_discard_stmt_start_pos = self.current_stmt_start_pos;
            self.state = &main_discard_scratch;
            self.hoist_insert_pos = .None;
            self.current_stmt_start_pos = .None;
            let discard_eerr = self.emit_expr(*exp);
            self.state = saved_discard_state;
            self.hoist_insert_pos = saved_discard_hoist_pos;
            self.current_stmt_start_pos = saved_discard_stmt_start_pos;
            if discard_eerr.is_some() {
              ret discard_eerr;
            }
          }
          let main_dferr = self.emit_function_scope_defers();
          if main_dferr.is_some() {
            ret main_dferr;
          }
          self.state.write_indent();
          self.state.write("return 0;\n");
          ret .None;
        }
        // A `ret` unwinds every enclosing block at once, so pending
        // `defer` bodies run first. With no defers this keeps the plain
        // single-statement form; otherwise the return expression is
        // evaluated into an `__auto_type` temp first, so a deferred
        // statement can't change what gets returned by mutating a
        // variable the expression already read. A `ret` value coerced to
        // a quirk-typed return gets the same coercion wrap a `Variable`
        // initializer does.
        bin ret_did_quirk_coerce = false;
        str ret_quirk_concrete = "";
        if exp != nil && self.quirk_names.contains(self.current_fn_rtype_name) {
          let ret_concrete = self.resolve_quirk_coerce_concrete_type(exp);
          if ret_concrete.is_some() {
            ret_did_quirk_coerce = true;
            ret_quirk_concrete = ret_concrete.unwrap();
          }
        }
        if self.defer_stack.len == 0 {
          self.state.write_indent();
          self.state.write("return");
          if exp != nil {
            self.state.write(" ");
            if ret_did_quirk_coerce {
              self.state.write("__fun_coerce_");
              self.state.write(ret_quirk_concrete);
              self.state.write("_");
              self.state.write(self.current_fn_rtype_name);
              self.state.write("(");
            }
            let prev_expected = self.expected_enum_type;
            self.expected_enum_type = self.current_fn_rtype_name;
            let eerr = self.emit_expr(*exp);
            self.expected_enum_type = prev_expected;
            if eerr.is_some() {
              ret eerr;
            }
            if ret_did_quirk_coerce {
              self.state.write(")");
            }
          }
          self.state.write(";\n");
          ret .None;
        }
        if exp != nil {
          self.state.write_indent();
          if self.msvc_mode && self.current_fn_rtype_dt.is_some() {
            let defer_rdt = self.current_fn_rtype_dt.unwrap();
            let defer_wt = self.write_type(defer_rdt);
            if defer_wt.is_none() {
              self.state.write("int64_t");
            }
          } else {
            self.state.write("__auto_type");
          }
          self.state.write(" __fun_defer_ret = ");
          if ret_did_quirk_coerce {
            self.state.write("__fun_coerce_");
            self.state.write(ret_quirk_concrete);
            self.state.write("_");
            self.state.write(self.current_fn_rtype_name);
            self.state.write("(");
          }
          let prev_expected = self.expected_enum_type;
          self.expected_enum_type = self.current_fn_rtype_name;
          let eerr = self.emit_expr(*exp);
          self.expected_enum_type = prev_expected;
          if eerr.is_some() {
            ret eerr;
          }
          if ret_did_quirk_coerce {
            self.state.write(")");
          }
          self.state.write(";\n");
        }
        let dferr = self.emit_function_scope_defers();
        if dferr.is_some() {
          ret dferr;
        }
        self.state.write_indent();
        if exp != nil {
          self.state.write("return __fun_defer_ret;\n");
        } else {
          self.state.write("return;\n");
        }
        ret .None;
      }
      .StatementBreak -> {
        if self.loop_defer_marks.len > 0 {
          let derr = self.emit_defers_from(self.loop_defer_marks.get(self.loop_defer_marks.len - 1));
          if derr.is_some() {
            ret derr;
          }
        }
        self.state.write_indent();
        self.state.write("break;\n");
        ret .None;
      }
      .StatementContinue -> {
        if self.loop_defer_marks.len > 0 {
          let derr = self.emit_defers_from(self.loop_defer_marks.get(self.loop_defer_marks.len - 1));
          if derr.is_some() {
            ret derr;
          }
        }
        self.state.write_indent();
        self.state.write("continue;\n");
        ret .None;
      }
      .Variable(v) -> {
        self.state.write_indent();
        // `let NAME = <expr>;` (the `__let_infer__` sentinel from
        // `parse_let`) always emits GNU C's `__auto_type`, letting the C
        // compiler do the real inference. `infer_let_expr_type` is tried
        // only for this codegen's own bookkeeping, so a later shorthand
        // or method call on `NAME` resolves; when it infers nothing,
        // `NAME` simply isn't a known local afterward.
        bin is_let = equals(v.var_type.type_str, "__let_infer__");
        bin have_resolved = false;
        str resolved_name = "";
        bin resolved_ptr = false;
        Option<DataType> resolved_dtype = .None;

        // An unsized array local (`T[] new_data = malloc(...);`) decays
        // to a pointer, like an unsized array field, unless it's
        // initialized with a bracket array literal, which stays a stack
        // array. Decided here, since `write_type` can't see the
        // initializer.
        bin arr_as_ptr = false;
        if !is_let {
          arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
          if arr_as_ptr && v.has_val {
            fit v.val.kind {
              .Bracket(_) -> { arr_as_ptr = false; }
              _ -> {}
            }
          }
        }

        // `const` on a pointer-typed binding lands after the pointer
        // stars (`Type* const name`, the pointer itself can't be
        // reassigned) rather than before the base type (`const Type*
        // name`, a stricter guarantee this codegen doesn't enforce). For
        // an `__auto_type`-inferred const the pointer-ness isn't known
        // yet, so `const` lands before; that's valid GNU C either way.
        // `str` needs the same treatment despite `dtype_is_pointer`
        // reading false for it (Fun's own type system doesn't consider
        // a bare `str` a pointer type, even though its C spelling,
        // `char*`, is one): landing `const` before it declares `const
        // char*`, incompatible with the plain `char*` every ordinary
        // `str` value uses, which is what every str-returning function
        // and str-taking parameter expects.
        bin const_is_ptr_binding = !is_let &&
          (dtype_is_pointer(*v.var_type) || arr_as_ptr || equals(
          v.var_type.type_str,
          "str"
        ));
        if v.is_const && !const_is_ptr_binding {
          self.state.write("const ");
        }

        // `let arr = [1, 2, 3];` needs an explicitly-typed array
        // declaration (`int64_t arr[] = {1, 2, 3};`), not `__auto_type`,
        // which would decay to a pointer at initialization.
        // `emit_for_iter`'s raw-array fast path depends on
        // `sizeof(arr)/sizeof(arr[0])` giving the real element count, so
        // that decay would cut iteration to a single element.
        bin let_is_bracket_literal = false;
        str let_lit_elem_c_type = "int64_t";
        num let_lit_depth = 1;
        if is_let && v.has_val {
          fit v.val.kind {
            .Bracket(bracket_inner) -> {
              let_is_bracket_literal = true;
              let_lit_elem_c_type = self.infer_array_literal_elem_c_type(bracket_inner);
              let_lit_depth = self.array_literal_nesting_depth(v.val);
            }
            _ -> {}
          }
        }
        if let_is_bracket_literal {
          self.state.write(let_lit_elem_c_type);
        } elif is_let {
          if self.msvc_mode && v.has_val {
            let msvc_idt_opt = self.infer_let_expr_type(v.val);
            if msvc_idt_opt.is_some() {
              let msvc_idt = msvc_idt_opt.unwrap();
              let msvc_wt = self.write_type(msvc_idt);
              if msvc_wt.is_some() {
                let msvc_subst = self.resolve_type_subst(msvc_idt);
                resolved_name = msvc_wt.unwrap();
                resolved_ptr = dtype_is_pointer(msvc_subst);
                resolved_dtype = .Some(msvc_subst);
                have_resolved = true;
              } else {
                self.state.write("int64_t");
              }
            } else {
              self.state.write("int64_t");
            }
          } else {
            self.state.write("__auto_type");
          }
        } else {
          let wt = self.write_type(*v.var_type);
          if wt.is_none() {
            ret .Some(.UnsupportedNode);
          }
          let subst_dt = self.resolve_type_subst(*v.var_type);
          resolved_name = wt.unwrap();
          resolved_ptr = dtype_is_pointer(subst_dt) || arr_as_ptr;
          // The array decay's pointer level is always additional to
          // whatever `write_type` wrote for `subst_dt`'s pointer depth,
          // even when `subst_dt` is itself a pointer.
          if arr_as_ptr {
            self.state.write("*");
          }
          resolved_dtype = .Some(subst_dt);
          have_resolved = true;
        }
        if v.is_const && const_is_ptr_binding {
          self.state.write(" const");
        }
        self.state.write(" ");
        self.state.write(v.name);
        // An array declarator (`[24]`, `[]`) lands after the name in C,
        // unlike every other type modifier above.
        // `let_is_bracket_literal` needs its own path, since a `let` has
        // no `v.var_type.array_brackets` to read: a leading `[]` whose
        // count C infers from the initializer, plus inner dimensions from
        // `emit_multidim_inner_declarators`. Skipped entirely for
        // `arr_as_ptr`, already decayed to a `*` above.
        if let_is_bracket_literal {
          self.state.write("[]");
          if let_lit_depth > 1 {
            self.emit_multidim_inner_declarators(v.val, let_lit_depth - 1);
          }
        } elif !is_let && !arr_as_ptr && v.var_type.is_array {
          if v.var_type.array_brackets.len > 0 {
            for bnode : v.var_type.array_brackets {
              self.state.write("[");
              fit bnode.kind {
                .Bracket(inner) -> {
                  let berr = self.emit_expr(*inner);
                  if berr.is_some() {
                    ret berr;
                  }
                }
                _ -> {
                  let berr = self.emit_expr(*bnode);
                  if berr.is_some() {
                    ret berr;
                  }
                }
              }
              self.state.write("]");
            }
          } elif v.var_type.array_depth > 1 {
            // A multi-dimensional array with no explicit bracket sizes
            // (`num[][] matrix = [[1, 2], [3, 4]];`). The leading
            // dimension stays `[]`, but every other needs an explicit
            // size (`T[][N]` is legal C, `T[][]` is not), derived from
            // the initializer's shape. Falls back to `[]` per dimension
            // when there's no bracket literal to derive sizes from.
            self.state.write("[]");
            bin wrote_inner_dims = false;
            if v.has_val {
              fit v.val.kind {
                .Bracket(_) -> {
                  self.emit_multidim_inner_declarators(v.val, v.var_type.array_depth - 1);
                  wrote_inner_dims = true;
                }
                _ -> {}
              }
            }
            if !wrote_inner_dims {
              num mdim_d = 1;
              for mdim_d < v.var_type.array_depth {
                self.state.write("[]");
                mdim_d = mdim_d + 1;
              }
            }
          } else {
            self.state.write("[]");
          }
        }
        if v.has_val {
          self.state.write(" = ");
          // A bare shorthand in a `Variable` initializer resolves against
          // the variable's declared type, via `resolve_type_name` rather
          // than the bare `v.var_type.type_str`, since a generic declared
          // type's bare string is the unresolved template name that
          // `enum_has_variant` never recognizes. For `let` it is
          // `__let_infer__`, so a bare shorthand fails to resolve.
          let prev_expected = self.expected_enum_type;
          let resolved_decl_type = self.resolve_type_name(*v.var_type);
          if resolved_decl_type.is_some() {
            self.expected_enum_type = resolved_decl_type.unwrap();
          } else {
            self.expected_enum_type = v.var_type.type_str;
          }
          // A bare `.{...}` compound-literal initializer resolves against
          // `expected_compound_type`, as an enum shorthand does above.
          let prev_expected_compound = self.expected_compound_type;
          self.expected_compound_type = self.expected_enum_type;
          // A `let` has no declared type to resolve a bare enum-variant
          // initializer against (`let color = .Red;`), so this falls back
          // to global uniqueness.
          if is_let {
            fit v.val.kind {
              .Expression(ve) -> {
                if equals(ve.op, ".") && ve.has_left && ve.has_right {
                  fit ve.left.kind {
                    .Blank -> {
                      fit ve.right.kind {
                        .Identifier(vname) -> {
                          let unique = self.resolve_unique_enum_for_variant(vname);
                          if unique.is_some() {
                            self.expected_enum_type = unique.unwrap();
                          }
                        }
                        _ -> {}
                      }
                    }
                    _ -> {}
                  }
                }
              }
              _ -> {}
            }
          }
          // A declaration's initializer is one of the contexts where a
          // bare `[1, 2, 3]` array literal needs the brace-list form.
          let prev_arr_init = self.in_array_initializer;
          self.in_array_initializer = true;
          // A quirk-typed declaration's initializer needs a coercion call
          // wrapped around the RHS.
          bin did_quirk_coerce = false;
          // A concrete quirk instantiation is registered under its
          // mangled identity (`To__num`), not `v.var_type.type_str`.
          str var_quirk_type = v.var_type.type_str;
          if !self.quirk_names.contains(var_quirk_type) && v.var_type.generic_args.len > 0 {
            StringBuilder vq_sb = string_builder_init(16);
            vq_sb.append(v.var_type.type_str);
            for vqarg : v.var_type.generic_args {
              vq_sb.append("__");
              vq_sb.append(vqarg.type_str);
            }
            let vq_candidate = vq_sb.build();
            if self.quirk_names.contains(vq_candidate) {
              var_quirk_type = vq_candidate;
            }
          }
          if self.quirk_names.contains(var_quirk_type) {
            let concrete = self.resolve_quirk_coerce_concrete_type(v.val);
            if concrete.is_some() {
              self.state.write("__fun_coerce_");
              self.state.write(concrete.unwrap());
              self.state.write("_");
              self.state.write(var_quirk_type);
              self.state.write("(");
              did_quirk_coerce = true;
            }
          }
          // `let_is_bracket_literal` already declared an explicitly-typed
          // array above, so `emit_expr`'s `.Bracket` case needs only the
          // brace-list form, no compound-literal cast wrapper.
          let verr = self.emit_expr(*v.val);
          if did_quirk_coerce {
            self.state.write(")");
          }
          self.in_array_initializer = prev_arr_init;
          self.expected_enum_type = prev_expected;
          self.expected_compound_type = prev_expected_compound;
          if verr.is_some() {
            ret verr;
          }
        }
        self.state.write(";\n");
        if is_let && v.has_val {
          let inferred = self.infer_let_expr_type(v.val);
          if inferred.is_some() {
            let idt = inferred.unwrap();
            let resolved = self.resolve_type_name(idt);
            if resolved.is_some() {
              let subst_idt = self.resolve_type_subst(idt);
              resolved_name = resolved.unwrap();
              resolved_ptr = dtype_is_pointer(subst_idt);
              resolved_dtype = .Some(subst_idt);
              have_resolved = true;
            }
          }
        }
        if have_resolved {
          if resolved_dtype.is_some() {
            self.record_local_typed(v.name, resolved_name, resolved_ptr, resolved_dtype.unwrap());
          } else {
            self.record_local(v.name, resolved_name, resolved_ptr);
          }
        }
        ret .None;
      }
      .StatementFor(fk) -> {
        self.state.write_indent();
        fit fk {
          .Cond(fc) -> { ret self.emit_for_cond(fc); }
          .Range(fr) -> { ret self.emit_for_range(fr); }
          .Iter(fi) -> { ret self.emit_for_iter(fi); }
        }
      }
      .StatementFit(f) -> {
        self.state.write_indent();
        ret self.emit_fit(f);
      }
      // A bare expression used as a statement parses as a plain
      // `.Expression`/`.Unary` node, with no `StatementExpression`
      // wrapper, and emits as `<expr>;`.
      .Expression(_) -> {
        self.state.write_indent();
        let eerr = self.emit_expr(node);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .Unary(_) -> {
        self.state.write_indent();
        let uerr = self.emit_expr(node);
        if uerr.is_some() {
          ret uerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .Panic(_) -> {
        // A bare `panic("msg");` statement, with no statement wrapper of
        // its own, as with `.Expression`/`.Unary` above.
        self.state.write_indent();
        let perr = self.emit_expr(node);
        if perr.is_some() {
          ret perr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .StatementAssert(a) -> {
        // `assert cond;` and `assert cond, "msg";` lower to
        // `if (!(cond)) { ...; abort(); }`. Under a test run the failure
        // returns to the runner instead, so the tests after it still
        // run; outside one, a failed assertion is a real bug.
        self.state.write_indent();
        self.state.write("if (!(");
        let cerr = self.emit_expr(*a.condition);
        if cerr.is_some() {
          ret cerr;
        }
        self.state.write(")) { ");
        if a.has_message {
          self.state.write("fprintf(stderr_stream(), \"Assertion failed: %s\\n\", ");
          let merr = self.emit_expr(*a.message);
          if merr.is_some() {
            ret merr;
          }
          self.state.write("); ");
        }
        if self.test_mode {
          self.state.write("longjmp(__fun_test_jmp, 1); }\n");
        } else {
          self.state.write("abort(); }\n");
        }
        ret .None;
      }
      .StatementDefer(body) -> {
        // `defer <body>;` registers `body` onto `Codegen.defer_stack`
        // rather than emitting anything here; it is replicated as an
        // ordinary statement wherever this block's scope ends.
        self.defer_stack.push(body);
        ret .None;
      }
      .StatementFork(expr) -> {
        self.state.write_indent();
        let ferr = self.emit_fork_stmt(expr);
        if ferr.is_some() {
          ret ferr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .StatementAsm(a) -> { ret self.emit_asm_stmt(a); }
      // `allow`/`expect` control diagnostics rather than describing
      // runtime behavior, so they contribute no C of their own.
      .StatementWarningControl(_) -> { ret .None; }
      _ -> {
        self.note_unsupported(node, "statement");
        ret .Some(.UnsupportedNode);
      }
    }
  }

  // Emits `for { ... }` or `for cond { ... }` as `while (1) { ... }` or
  // `while (cond) { ... }`. A conditional `for` has no init or increment
  // clause, so a `while` loop is the same construct.
  emit_for_cond(ForCondNode fc) Option<CodegenErrorKind> {
    if fc.has_condition {
      self.state.write("while (");
      let cerr = self.emit_condition(*fc.condition);
      if cerr.is_some() {
        ret cerr;
      }
      self.state.write(") {\n");
    } else {
      self.state.write("while (1) {\n");
    }
    self.state.indent_level = self.state.indent_level + 1;
    self.loop_defer_marks.push(self.defer_stack.len);
    let berr = self.emit_body(*fc.body);
    self.loop_defer_marks.pop();
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    ret .None;
  }

  // Emits `for i : start..end { ... }` as `for (int64_t i = start; i <
  // end; i++) { ... }`. `range_expr` is always an
  // `Expression{ op = ".." }` with start on the left and end on the right.
  emit_for_range(ForRangeNode fr) Option<CodegenErrorKind> {
    fit fr.range_expr.kind {
      .Expression(e) -> {
        if !equals(e.op, "..") || !e.has_left || !e.has_right {
          ret .Some(.InvalidNode);
        }
        self.state.write("for (int64_t ");
        self.state.write(fr.index_name);
        self.state.write(" = ");
        let serr = self.emit_expr(*e.left);
        if serr.is_some() {
          ret serr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write(" < ");
        let eerr = self.emit_expr(*e.right);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write("++) {\n");
        self.state.indent_level = self.state.indent_level + 1;
        self.loop_defer_marks.push(self.defer_stack.len);
        let berr = self.emit_body(*fr.body);
        self.loop_defer_marks.pop();
        if berr.is_some() {
          ret berr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Emits `for item : arr { ... }` and `for i, item :: arr { ... }` as a
  // Vec fast path: `for (int64_t idx = 0; idx < arr.len; idx++) {
  // __auto_type item = arr.data[idx]; ... }`, reading `Vec<T>`'s
  // `.len`/`.data` directly rather than dispatching through an
  // `Iterator`-quirk `.next()`. `idx` is `fi.index_name` when given, else
  // a synthetic `__fun_i`, and `__auto_type` lets the C compiler infer
  // `item`'s type, so `T` never needs to be known here.
  emit_for_iter(ForIterNode fi) Option<CodegenErrorKind> {
    // The iterable is either a plain identifier, checked structurally via
    // `lookup_local_dtype` or by name, or a chained field access resolved
    // via `resolve_field_chain`. `ChainResolution.dtype` carries the
    // field's structured `DataType` when `record_compound_typed` had one,
    // so `item` can be recorded with its real element type either way.
    str arr_text = "";
    Option<DataType> arr_dtype = .None;
    Option<str> arr_type_name = .None;
    bin iterable_is_identifier = false;
    fit fi.iterable.kind {
      .Identifier(name) -> {
        arr_text = name;
        arr_dtype = self.lookup_local_dtype(name);
        arr_type_name = self.lookup_local_type_name(name);
        iterable_is_identifier = true;
      }
      .Expression(e) -> {
        // A chained field access, or a call such as
        // `for k : squares.keys() { ... }`. `resolve_field_chain` handles
        // a call node passed directly, not only one nested as a receiver.
        if !equals(e.op, ".") && !equals(e.op, "()") {
          ret .Some(.UnsupportedNode);
        }
        let resolved = self.resolve_field_chain(fi.iterable);
        if resolved.is_none() {
          ret .Some(.UnsupportedNode);
        }
        let r = resolved.unwrap();
        arr_text = r.text;
        arr_type_name = .Some(r.type_name);
        arr_dtype = r.dtype;
      }
      _ -> { ret .Some(.UnsupportedNode); }
    }

    // A structurally knowable element `DataType` lets `item` be recorded
    // as a known local of its real type below, so a nested iteration over
    // it resolves too. `arr_dtype` being `.Some` doesn't guarantee that:
    // a local from a monomorphized method's return type has an
    // already-mangled `type_str` with empty `generic_args`. Either shape
    // is recognized as a Vec, but only the structural one resolves the
    // element type.
    Option<DataType> elem_dt = .None;
    bin is_vec = false;
    if arr_dtype.is_some() {
      let arr_dt = arr_dtype.unwrap();
      if equals(arr_dt.type_str, "Vec") && arr_dt.generic_args.len == 1 {
        elem_dt = .Some(self.resolve_type_subst(*arr_dt.generic_args.get(0)));
        is_vec = true;
      } elif equals(arr_dt.type_str, "Vec") || starts_with(arr_dt.type_str, "Vec__") {
        is_vec = true;
      }
    }
    if !is_vec && arr_type_name.is_some() {
      let found_name = arr_type_name.unwrap();
      if equals(found_name, "Vec") || starts_with(found_name, "Vec__") {
        is_vec = true;
      }
    }
    // A sized array local (`num[] arr`, not decayed to a pointer) has no
    // `.len`/`.data` in C, so its length comes from
    // `sizeof(arr)/sizeof(arr[0])` instead.
    bin is_raw_array = false;
    str elem_c_type = "int64_t";
    // Defaults to 1 (an ordinary single-dimension array) when
    // `arr_dt.array_depth` wasn't populated at all.
    num raw_array_depth = 1;
    Option<DataType> raw_arr_dt = .None;
    if !is_vec && arr_dtype.is_some() {
      let arr_dt = arr_dtype.unwrap();
      if arr_dt.is_array && arr_dt.pointer_depth == 0 {
        is_raw_array = true;
        elem_c_type = map_type_to_c(arr_dt.type_str);
        raw_arr_dt = .Some(arr_dt);
        if arr_dt.array_depth > 0 {
          raw_array_depth = arr_dt.array_depth;
        }
      }
    }
    // A structurally known `Set<T>` or `Map<K, V>` iterates through the
    // `iter()`/`next()`/`Option` protocol instead of a direct index. This
    // needs the collection's structural generic args, since a
    // mangled-name-only type can't recover the element type needed to
    // instantiate `SetIter<T>`/`MapIter<K, V>`/`Option<T>`, and a bare
    // identifier receiver, since an rvalue receiver can't take `&` to
    // call `.iter()` on it.
    if !is_vec && !is_raw_array && iterable_is_identifier && arr_dtype.is_some() {
      let coll_dt = arr_dtype.unwrap();
      bin is_set = equals(coll_dt.type_str, "Set") && coll_dt.generic_args.len == 1;
      bin is_map = equals(coll_dt.type_str, "Map") && coll_dt.generic_args.len == 2;
      if is_set || is_map {
        DataType elem_key_dt = *coll_dt.generic_args.get(0);
        DataType* elem_key_ptr = malloc(sizeof(DataType));
        *elem_key_ptr = elem_key_dt;

        DataType iter_dt = dtype_new();
        Vec<DataType*> iter_args;
        iter_args.init(2);
        iter_args.push(elem_key_ptr);
        if is_map {
          iter_dt.type_str = "MapIter";
          DataType val_dt = *coll_dt.generic_args.get(1);
          DataType* val_ptr = malloc(sizeof(DataType));
          *val_ptr = val_dt;
          iter_args.push(val_ptr);
        } else {
          iter_dt.type_str = "SetIter";
        }
        iter_dt.generic_args = iter_args;

        DataType opt_dt = dtype_new();
        opt_dt.type_str = "Option";
        Vec<DataType*> opt_args;
        opt_args.init(1);
        DataType* opt_elem_ptr = malloc(sizeof(DataType));
        *opt_elem_ptr = elem_key_dt;
        opt_args.push(opt_elem_ptr);
        opt_dt.generic_args = opt_args;

        let coll_name_opt = self.resolve_type_name(coll_dt);
        let iter_name_opt = self.resolve_type_name(iter_dt);
        let opt_name_opt = self.resolve_type_name(opt_dt);
        if coll_name_opt.is_none() || iter_name_opt.is_none() || opt_name_opt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        str coll_name = coll_name_opt.unwrap();
        str iter_name = iter_name_opt.unwrap();
        str opt_name = opt_name_opt.unwrap();

        self.ensure_generic_impl_method_emitted(coll_name, "iter", "");
        self.ensure_generic_impl_method_emitted(iter_name, "next", "");
        if is_map && fi.has_index_name {
          self.ensure_generic_impl_method_emitted(coll_name, "get", "");
        }

        self.for_iter_temp_counter = self.for_iter_temp_counter + 1;
        StringBuilder it_tmp_sb = string_builder_init(24);
        it_tmp_sb.append("__fun_iter_it");
        it_tmp_sb.append(format_num(self.for_iter_temp_counter));
        str it_tmp = it_tmp_sb.build();
        StringBuilder opt_tmp_sb = string_builder_init(24);
        opt_tmp_sb.append("__fun_iter_opt");
        opt_tmp_sb.append(format_num(self.for_iter_temp_counter));
        str opt_tmp = opt_tmp_sb.build();

        self.state.write("{\n");
        self.state.indent_level = self.state.indent_level + 1;
        self.state.write_indent();
        self.state.write(iter_name);
        self.state.write(" ");
        self.state.write(it_tmp);
        self.state.write(" = ");
        self.state.write(coll_name);
        self.state.write("__iter(&");
        self.state.write(arr_text);
        self.state.write(");\n");
        self.state.write_indent();
        self.state.write("for (;;) {\n");
        self.state.indent_level = self.state.indent_level + 1;
        self.state.write_indent();
        self.state.write(opt_name);
        self.state.write(" ");
        self.state.write(opt_tmp);
        self.state.write(" = ");
        self.state.write(iter_name);
        // `SetIter<T>` and `MapIter<K, V>` declare `next` under
        // `impl ... as Iterator<...>`, unlike the plain `iter`/`get`
        // above. A quirked impl mangles to `owner__QuirkName__method`, so
        // the plain `owner__method` form doesn't resolve here.
        // Hardcoding "Iterator" is safe because this branch is scoped to
        // Set and Map, not a general Iterator-quirk dispatch.
        self.state.write("__Iterator__next(&");
        self.state.write(it_tmp);
        self.state.write(");\n");
        self.state.write_indent();
        self.state.write("if (");
        self.state.write(opt_tmp);
        self.state.write(".tag == ");
        self.state.write(opt_name);
        self.state.write("_None) break;\n");
        self.state.write_indent();
        if is_map && fi.has_index_name {
          if self.msvc_mode {
            let idx_wt = self.write_type(elem_key_dt);
            if idx_wt.is_none() {
              self.state.write("int64_t");
            }
          } else {
            self.state.write("__auto_type");
          }
          self.state.write(" ");
          self.state.write(fi.index_name);
          self.state.write(" = ");
          self.state.write(opt_tmp);
          self.state.write(".payload.Some._0;\n");
          self.state.write_indent();
          let val_dt2 = *coll_dt.generic_args.get(1);
          if self.msvc_mode {
            let val_wt = self.write_type(val_dt2);
            if val_wt.is_none() {
              self.state.write("int64_t");
            }
          } else {
            self.state.write("__auto_type");
          }
          self.state.write(" ");
          self.state.write(fi.item_name);
          self.state.write(" = ");
          self.state.write(coll_name);
          self.state.write("__get(&");
          self.state.write(arr_text);
          self.state.write(", ");
          self.state.write(fi.index_name);
          self.state.write(");\n");
          let key_name = self.resolve_type_name(elem_key_dt);
          if key_name.is_some() {
            self.record_local_typed(
              fi.index_name,
              key_name.unwrap(),
              dtype_is_pointer(elem_key_dt),
              elem_key_dt
            );
          }
          let val_name = self.resolve_type_name(val_dt2);
          if val_name.is_some() {
            self.record_local_typed(
              fi.item_name,
              val_name.unwrap(),
              dtype_is_pointer(val_dt2),
              val_dt2
            );
          }
        } else {
          if self.msvc_mode {
            let elem_wt = self.write_type(elem_key_dt);
            if elem_wt.is_none() {
              self.state.write("int64_t");
            }
          } else {
            self.state.write("__auto_type");
          }
          self.state.write(" ");
          self.state.write(fi.item_name);
          self.state.write(" = ");
          self.state.write(opt_tmp);
          self.state.write(".payload.Some._0;\n");
          let elem_name = self.resolve_type_name(elem_key_dt);
          if elem_name.is_some() {
            self.record_local_typed(
              fi.item_name,
              elem_name.unwrap(),
              dtype_is_pointer(elem_key_dt),
              elem_key_dt
            );
          }
        }
        self.loop_defer_marks.push(self.defer_stack.len);
        let berr = self.emit_body(*fi.body);
        self.loop_defer_marks.pop();
        if berr.is_some() {
          ret berr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        ret .None;
      }

      // A plain type with a concrete `Iterator<T>` quirk impl (`impl
      // Counter as Iterator<num> { pub next() Option<num> { ... } }`)
      // iterates by calling `.next()` on itself directly each pass, no
      // `.iter()` indirection: unlike Set/Map, the value already IS its
      // own iterator state.
      str user_iter_elem_type = "";
      bin has_user_iter = false;
      for n2 : self.all_nodes {
        fit n2.kind {
          .Impl(i2) -> {
            if equals(i2.type_name, coll_dt.type_str) && i2.has_quirk_name &&
              equals(
              i2.quirk_name,
              "Iterator"
            ) && i2.has_quirk_concrete_instantiation {
              // `quirk_concrete_instantiation` is the whole quirk
              // instantiation's mangled name (`Iterator__num`), not the
              // bare element type: strip the `Iterator__` prefix back
              // off to recover it.
              StringBuilder qpfx = string_builder_init(16);
              qpfx.append(i2.quirk_name);
              qpfx.append("__");
              user_iter_elem_type = strip_prefix(i2.quirk_concrete_instantiation, qpfx.build());
              has_user_iter = true;
            }
          }
          _ -> {}
        }
      }
      if has_user_iter {
        let next_mangled_opt = self.lookup_impl_method(coll_dt.type_str, "next");
        if next_mangled_opt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        self.ensure_plain_impl_method_prototype_emitted(coll_dt.type_str, "next");
        str next_mangled = next_mangled_opt.unwrap();

        DataType elem_dt2 = dtype_new();
        elem_dt2.type_str = user_iter_elem_type;

        DataType opt_dt = dtype_new();
        opt_dt.type_str = "Option";
        Vec<DataType*> opt_args;
        opt_args.init(1);
        DataType* opt_elem_ptr = malloc(sizeof(DataType));
        *opt_elem_ptr = elem_dt2;
        opt_args.push(opt_elem_ptr);
        opt_dt.generic_args = opt_args;
        let opt_name_opt = self.resolve_type_name(opt_dt);
        if opt_name_opt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        str opt_name = opt_name_opt.unwrap();

        self.for_iter_temp_counter = self.for_iter_temp_counter + 1;
        StringBuilder uopt_tmp_sb = string_builder_init(24);
        uopt_tmp_sb.append("__fun_iter_opt");
        uopt_tmp_sb.append(format_num(self.for_iter_temp_counter));
        str uopt_tmp = uopt_tmp_sb.build();

        self.state.write("for (;;) {\n");
        self.state.indent_level = self.state.indent_level + 1;
        self.state.write_indent();
        self.state.write(opt_name);
        self.state.write(" ");
        self.state.write(uopt_tmp);
        self.state.write(" = ");
        self.state.write(next_mangled);
        self.state.write("(&");
        self.state.write(arr_text);
        self.state.write(");\n");
        self.state.write_indent();
        self.state.write("if (");
        self.state.write(uopt_tmp);
        self.state.write(".tag == ");
        self.state.write(opt_name);
        self.state.write("_None) break;\n");
        self.state.write_indent();
        if self.msvc_mode {
          let uiter_wt = self.write_type(elem_dt2);
          if uiter_wt.is_none() {
            self.state.write("int64_t");
          }
        } else {
          self.state.write("__auto_type");
        }
        self.state.write(" ");
        self.state.write(fi.item_name);
        self.state.write(" = ");
        self.state.write(uopt_tmp);
        self.state.write(".payload.Some._0;\n");
        let elem_name2 = self.resolve_type_name(elem_dt2);
        if elem_name2.is_some() {
          self.record_local_typed(
            fi.item_name,
            elem_name2.unwrap(),
            dtype_is_pointer(elem_dt2),
            elem_dt2
          );
        }
        self.loop_defer_marks.push(self.defer_stack.len);
        let uberr = self.emit_body(*fi.body);
        self.loop_defer_marks.pop();
        if uberr.is_some() {
          ret uberr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        ret .None;
      }
    }

    if !is_vec && !is_raw_array {
      ret .Some(.UnsupportedNode);
    }

    str idx_name = "__fun_i";
    if fi.has_index_name {
      idx_name = fi.index_name;
    }

    // A Vec-typed iterable that isn't a bare identifier, such as
    // `squares.keys()`, is an rvalue: re-embedding `arr_text` in both the
    // loop condition and the body would re-evaluate the call each time,
    // re-allocating a Vec per iteration, so it is materialized into a
    // temp up front. Raw arrays never reach here as a non-identifier,
    // since the earlier `is_array` check requires a real local.
    bin needs_vec_src_temp = is_vec && !iterable_is_identifier;
    str vec_src_text = arr_text;
    if needs_vec_src_temp {
      self.for_iter_temp_counter = self.for_iter_temp_counter + 1;
      StringBuilder vsrc_sb = string_builder_init(24);
      vsrc_sb.append("__fun_iter_src");
      vsrc_sb.append(format_num(self.for_iter_temp_counter));
      vec_src_text = vsrc_sb.build();
      self.state.write("{\n");
      self.state.indent_level = self.state.indent_level + 1;
      self.state.write_indent();
      if self.msvc_mode && arr_dtype.is_some() {
        let vsrc_wt = self.write_type(arr_dtype.unwrap());
        if vsrc_wt.is_none() {
          self.state.write("int64_t");
        }
      } else {
        self.state.write("__auto_type");
      }
      self.state.write(" ");
      self.state.write(vec_src_text);
      self.state.write(" = ");
      self.state.write(arr_text);
      self.state.write(";\n");
      self.state.write_indent();
    }

    // A multi-dimensional raw array's length bound can't be computed from
    // `arr_text` once that is a nested item (`row` in `for item : row`),
    // since `row`'s runtime value has already decayed to a pointer. When
    // `arr_text` was registered as a multi-dim item,
    // `len_root`/`len_offset` redirect the bound back to the root array
    // name with the right number of leading `[0]` levels; otherwise they
    // default to `arr_text` with zero levels.
    str len_root = arr_text;
    num len_offset = 0;
    if is_raw_array && iterable_is_identifier {
      let mdim = self.lookup_local_multidim(arr_text);
      if mdim.is_some() {
        let m = mdim.unwrap();
        len_root = m.root;
        len_offset = m.depth;
      }
    }
    // How many dimensions are left below this one: 0 when `item` is a
    // plain scalar, 1 for a 2D array's row, where `item` decays to a
    // single-star pointer, and 2 or more for a deeper array's layer,
    // where `item` needs `__auto_type` to deduce a pointer-to-array type.
    num element_depth = 0;
    if is_raw_array && raw_array_depth > 0 {
      element_depth = raw_array_depth - 1;
    }
    self.state.write("for (int64_t ");
    self.state.write(idx_name);
    self.state.write(" = 0; ");
    self.state.write(idx_name);
    self.state.write(" < ");
    if is_vec {
      self.state.write(vec_src_text);
      self.state.write(".len; ");
    } else {
      self.state.write("(int64_t)(sizeof(");
      self.state.write(len_root);
      num lo_i = 0;
      for lo_i < len_offset {
        self.state.write("[0]");
        lo_i = lo_i + 1;
      }
      self.state.write(")/sizeof(");
      self.state.write(len_root);
      num lo_j = 0;
      for lo_j < len_offset + 1 {
        self.state.write("[0]");
        lo_j = lo_j + 1;
      }
      self.state.write(")); ");
    }
    self.state.write(idx_name);
    self.state.write("++) {\n");
    self.state.indent_level = self.state.indent_level + 1;
    self.state.write_indent();
    // An element that is itself an array of two or more dimensions needs
    // `__auto_type` so the compiler deduces the pointer-to-array type
    // (`int64_t (*)[4]`); a naive pointer-star expansion would give a
    // flat double pointer, losing the inner dimension's stride. A 1D
    // array or a 2D row takes `elem_c_type` plus stars.
    // MSVC mode: use explicit element type when available.
    if is_vec || element_depth >= 2 {
      if self.msvc_mode && is_vec && elem_dt.is_some() {
        let elem_wt = self.write_type(elem_dt.unwrap());
        if elem_wt.is_none() {
          self.state.write("int64_t");
        }
        self.state.write(" ");
      } elif self.msvc_mode {
        // element_depth >= 2 or Vec with unknown elem: best-effort fallback.
        self.state.write("int64_t ");
      } else {
        self.state.write("__auto_type ");
      }
    } else {
      self.state.write(elem_c_type);
      num star_i = 0;
      for star_i < element_depth {
        self.state.write(" *");
        star_i = star_i + 1;
      }
      self.state.write(" ");
    }
    self.state.write(fi.item_name);
    self.state.write(" = ");
    self.state.write(vec_src_text);
    if is_vec {
      self.state.write(".data[");
    } else {
      self.state.write("[");
    }
    self.state.write(idx_name);
    self.state.write("];\n");
    // `item` is recorded as a known local of the element type when
    // `elem_dt` resolved above; otherwise it stays unrecorded, so a later
    // `item.field` read is rejected rather than guessed. `*item` works
    // either way, needing no locals lookup.
    if elem_dt.is_some() {
      let edt = elem_dt.unwrap();
      let elem_name = self.resolve_type_name(edt);
      if elem_name.is_some() {
        self.record_local_typed(fi.item_name, elem_name.unwrap(), dtype_is_pointer(edt), edt);
      }
    }
    // A raw array's item is recorded at the decremented depth, so a
    // nested `for x : item` can resolve `is_raw_array` structurally for
    // `item`'s name rather than relying on its multidim root and depth,
    // registered separately just below.
    if is_raw_array && raw_arr_dt.is_some() {
      DataType item_dt = raw_arr_dt.unwrap();
      item_dt.array_depth = element_depth;
      item_dt.is_array = element_depth > 0;
      let item_name_opt = self.resolve_type_name(item_dt);
      if item_name_opt.is_some() {
        self.record_local_typed(fi.item_name, item_name_opt.unwrap(), false, item_dt);
      }
      if element_depth > 0 {
        self.record_local_multidim(fi.item_name, len_root, len_offset + 1);
      }
    }
    self.loop_defer_marks.push(self.defer_stack.len);
    let berr = self.emit_body(*fi.body);
    self.loop_defer_marks.pop();
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    if needs_vec_src_temp {
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}\n");
    }
    ret .None;
  }

  // Emits one `fit` branch matching a tagged-union enum variant, bare or
  // qualified and with or without destructuring bindings, as
  // `subj.tag == EnumName_Variant { ... }` (`subj->tag` when
  // `subj_is_pointer`), chained with a leading `if`/`else if` per
  // `wrote_branch`. Each positional binding gets an `__auto_type name =
  // subj.payload.Variant._N;` declaration first, and is registered as a
  // known local when its payload field type is on record.
  emit_fit_enum_branch(
    str subj_name,
    bin subj_is_pointer,
    str enum_name,
    str variant_name,
    FitBranch br,
    bin wrote_branch
  ) Option<CodegenErrorKind> {
    if wrote_branch {
      self.state.write(" else if (");
    } else {
      self.state.write("if (");
    }
    self.state.write(subj_name);
    if subj_is_pointer {
      self.state.write("->");
    } else {
      self.state.write(".");
    }
    self.state.write("tag == ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    if br.has_bindings {
      num bi = 0;
      for bname : br.bindings {
        self.state.write_indent();
        // A known payload field type registers `bname` as a known local,
        // so further access on it inside the branch resolves. An
        // unresolvable payload type leaves `bname` unregistered.
        let payload_info = self.lookup_enum_variant_payload_type(enum_name, variant_name, bi);
        if self.msvc_mode && payload_info.is_some() {
          let fb_info = payload_info.unwrap();
          self.state.write(map_type_to_c(fb_info.type_name));
          if fb_info.is_pointer {
            self.state.write("*");
          }
        } else {
          self.state.write("__auto_type");
        }
        self.state.write(" ");
        self.state.write(bname);
        self.state.write(" = ");
        self.state.write(subj_name);
        if subj_is_pointer {
          self.state.write("->");
        } else {
          self.state.write(".");
        }
        self.state.write("payload.");
        self.state.write(variant_name);
        self.state.write("._");
        self.state.write(format_num(bi));
        self.state.write(";\n");
        if payload_info.is_some() {
          let fb_info2 = payload_info.unwrap();
          if fb_info2.dtype.is_some() {
            self.record_local_typed(
              bname,
              fb_info2.type_name,
              fb_info2.is_pointer,
              fb_info2.dtype.unwrap()
            );
          } else {
            self.record_local(bname, fb_info2.type_name, fb_info2.is_pointer);
          }
        }
        bi = bi + 1;
      }
    }
    let berr = self.emit_body(*br.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits one `fit` branch matching a plain (payload-less) enum variant
  // as `subj == EnumName_Variant { ... }`, or `(*subj) == ...` when
  // `subj_is_pointer`. A direct C-enum-value comparison rather than
  // `emit_fit_enum_branch`'s `.tag ==`, which only exists on a
  // tagged-union struct. No destructuring, there being no payload.
  emit_fit_plain_enum_branch(
    str subj_name,
    bin subj_is_pointer,
    str enum_name,
    str variant_name,
    FitBranch br,
    bin wrote_branch
  ) Option<CodegenErrorKind> {
    if wrote_branch {
      self.state.write(" else if (");
    } else {
      self.state.write("if (");
    }
    if subj_is_pointer {
      self.state.write("(*");
      self.state.write(subj_name);
      self.state.write(")");
    } else {
      self.state.write(subj_name);
    }
    self.state.write(" == ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*br.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Next unique name for `emit_fit`'s call-subject temp (`__fit_subj1`,
  // `__fit_subj2`, ...).
  next_fit_subj_name() str {
    self.fit_subj_temp_counter = self.fit_subj_temp_counter + 1;
    ret format("__fit_subj{num}", self.fit_subj_temp_counter);
  }

  // Emits `fit subject { patterns -> { body } ... }` as a chain of C
  // `if`/`else if`/`else` blocks. A branch condition is a tagged-union
  // enum-variant pattern when it has the `Identifier . Identifier` or
  // `Blank . Identifier` shape and names a known enum variant, else a
  // literal pattern compared against `subject` (`strcmp(...) == 0` for
  // `str`, `==` otherwise; a comma-chained pattern matches any of its
  // values). An unrecognized enum or subject shape is rejected rather
  // than guessed. `subject` must be a plain identifier, a `*name`
  // dereference, a chained field access, or a `receiver.method()` call.
  // The first three are re-evaluated per branch, none having a side
  // effect when read twice; a call subject is hoisted into one
  // `__auto_type __fit_subjN = <call>;` temp whose bare-shorthand enum
  // type comes from the callee's declared return type.
  emit_fit(FitStmtNode f) Option<CodegenErrorKind> {
    str subj_name = "";
    bin subj_is_pointer = false;
    Option<str> subj_type = .None;
    fit f.exp.kind {
      .Identifier(name) -> {
        subj_name = name;
        subj_type = self.lookup_local_type_name(name);
        subj_is_pointer = self.lookup_local_is_pointer(name).unwrap_or(false);
      }
      .Unary(u) -> {
        // An `await`-wrapped call subject (`fit await self.foo(...)`).
        // Resolves the callee's return type with the same lookups the
        // plain `()`-call case below uses, then hoists an `__auto_type
        // __fit_subj` temp holding the lowered await call.
        if equals(u.op, "await") {
          ExprNode await_call = expr_node_new();
          fit u.operand.kind {
            .Expression(ac) -> { await_call = ac; }
            _ -> { ret .Some(.UnsupportedNode); }
          }
          if !equals(await_call.op, "()") || !await_call.has_left || !await_call.has_right {
            ret .Some(.UnsupportedNode);
          }
          Option<DataType*> await_rtype = .None;
          fit await_call.left.kind {
            .Identifier(fn_name) -> { await_rtype = self.lookup_function_rtype(fn_name); }
            .Expression(recv_e2) -> {
              if equals(recv_e2.op, ".") && recv_e2.has_left && recv_e2.has_right {
                let recv_chain2 = self.resolve_field_chain(recv_e2.left);
                if recv_chain2.is_some() {
                  str method_name2 = "";
                  fit recv_e2.right.kind {
                    .Identifier(n2) -> { method_name2 = n2; }
                    _ -> {}
                  }
                  if !equals(method_name2, "") {
                    await_rtype = self.lookup_impl_method_rtype(
                      recv_chain2.unwrap().type_name,
                      method_name2
                    );
                  }
                }
              }
            }
            _ -> {}
          }
          if await_rtype.is_none() {
            ret .Some(.UnsupportedNode);
          }
          let resolved_await_rtype = self.resolve_type_name(*await_rtype.unwrap());
          if resolved_await_rtype.is_none() {
            ret .Some(.UnsupportedNode);
          }
          let fit_subj_name1 = self.next_fit_subj_name();
          if self.msvc_mode {
            self.state.write(map_type_to_c(resolved_await_rtype.unwrap()));
          } else {
            self.state.write("__auto_type");
          }
          self.state.write(" ");
          self.state.write(fit_subj_name1);
          self.state.write(" = ");
          let awerr = self.emit_await(u.operand);
          if awerr.is_some() {
            ret awerr;
          }
          self.state.write(";\n");
          self.state.write_indent();
          subj_name = fit_subj_name1;
          subj_type = resolved_await_rtype;
          subj_is_pointer = false;
        } elif u.is_left_operanded_unary || !u.has_indirection || u.indirection_depth != 1 {
          ret .Some(.UnsupportedNode);
        } else {
          fit u.operand.kind {
            .Identifier(name) -> {
              subj_name = name;
              subj_type = self.lookup_local_type_name(name);
              subj_is_pointer = true;
            }
            _ -> { ret .Some(.UnsupportedNode); }
          }
        }
      }
      .Expression(dot_e) -> {
        if equals(dot_e.op, "()") {
          if !dot_e.has_left || !dot_e.has_right {
            ret .Some(.UnsupportedNode);
          }
          // A plain function-call subject, whose callee is a bare
          // `.Identifier` rather than a `recv.method()` `.Expression`,
          // resolved via `lookup_function_rtype`. A generic callee's
          // return type is resolved the same way a normal call site
          // monomorphizes one: `maybe_instantiate_generic_function`
          // infers `T` from this call's own arguments and substitutes it
          // into the declared return type, since `lookup_function_rtype`
          // only knows the template's unsubstituted `RR<T>`.
          bin is_plain_fn_call = false;
          str plain_fn_name = "";
          fit dot_e.left.kind {
            .Identifier(fn_name) -> {
              is_plain_fn_call = true;
              plain_fn_name = fn_name;
            }
            _ -> {}
          }
          if is_plain_fn_call {
            Vec<Node*> fit_call_args;
            fit_call_args.init(0);
            defer fit_call_args.free();
            self.flatten_call_args(dot_e.right, &fit_call_args);
            Vec<DataType*> no_explicit_gargs_b;
            no_explicit_gargs_b.init(0);
            let generic_fit_inst = self.maybe_instantiate_generic_function(
              plain_fn_name,
              fit_call_args,
              no_explicit_gargs_b
            );
            Option<str> resolved_rtype = .None;
            if generic_fit_inst.is_some() {
              resolved_rtype = self.resolve_type_name(generic_fit_inst.unwrap().rtype);
            } else {
              let rtype = self.lookup_function_rtype(plain_fn_name);
              if rtype.is_none() {
                ret .Some(.UnsupportedNode);
              }
              resolved_rtype = self.resolve_type_name(*rtype.unwrap());
            }
            if resolved_rtype.is_none() {
              ret .Some(.UnsupportedNode);
            }
            let fit_subj_name2 = self.next_fit_subj_name();
            if self.msvc_mode {
              self.state.write(map_type_to_c(resolved_rtype.unwrap()));
            } else {
              self.state.write("__auto_type");
            }
            self.state.write(" ");
            self.state.write(fit_subj_name2);
            self.state.write(" = ");
            let cerr = self.emit_expr(*f.exp);
            if cerr.is_some() {
              ret cerr;
            }
            self.state.write(";\n");
            self.state.write_indent();
            subj_name = fit_subj_name2;
            subj_type = resolved_rtype;
            subj_is_pointer = false;
          } else {
            ExprNode recv_e = expr_node_new();
            fit dot_e.left.kind {
              .Expression(inner) -> { recv_e = inner; }
              _ -> { ret .Some(.UnsupportedNode); }
            }
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .Some(.UnsupportedNode);
            }
            // The receiver may be a chained field access rather than a
            // bare local, so it resolves via `resolve_field_chain`.
            let recv_chain = self.resolve_field_chain(recv_e.left);
            if recv_chain.is_none() {
              ret .Some(.UnsupportedNode);
            }
            let owner_type_name = recv_chain.unwrap().type_name;
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(n) -> { method_name = n; }
              _ -> { ret .Some(.UnsupportedNode); }
            }
            // A method declaring its own generic type param
            // (`wrap<U>(U x) Maybe<U>`) needs the combined substitution
            // `maybe_instantiate_generic_impl_method_own_params` builds,
            // inferring `U` from this call's own arguments; the plain
            // `lookup_impl_method_rtype` below only knows the raw
            // unsubstituted `Maybe<U>` template.
            Option<DataType> own_rtype_dt = .None;
            if self.impl_method_has_own_type_params(owner_type_name, method_name) {
              Vec<Node*> fit_own_args;
              fit_own_args.init(0);
              defer fit_own_args.free();
              self.flatten_call_args(dot_e.right, &fit_own_args);
              let own_res = self.maybe_instantiate_generic_impl_method_own_params(
                owner_type_name,
                method_name,
                fit_own_args
              );
              if own_res.is_some() {
                own_rtype_dt = .Some(own_res.unwrap().rtype);
              }
            }
            Option<str> resolved_rtype = .None;
            if own_rtype_dt.is_some() {
              resolved_rtype = self.resolve_type_name(own_rtype_dt.unwrap());
            } else {
              let rtype = self.lookup_impl_method_rtype(owner_type_name, method_name);
              if rtype.is_none() {
                ret .Some(.UnsupportedNode);
              }
              resolved_rtype = self.resolve_type_name(*rtype.unwrap());
            }
            if resolved_rtype.is_none() {
              ret .Some(.UnsupportedNode);
            }
            let fit_subj_name3 = self.next_fit_subj_name();
            if self.msvc_mode {
              self.state.write(map_type_to_c(resolved_rtype.unwrap()));
            } else {
              self.state.write("__auto_type");
            }
            self.state.write(" ");
            self.state.write(fit_subj_name3);
            self.state.write(" = ");
            let merr = self.emit_method_call(recv_e, dot_e.right);
            if merr.is_some() {
              ret merr;
            }
            self.state.write(";\n");
            self.state.write_indent();
            subj_name = fit_subj_name3;
            subj_type = resolved_rtype;
            subj_is_pointer = false;
          }
        } else {
          if !equals(dot_e.op, ".") {
            ret .Some(.UnsupportedNode);
          }
          let resolved = self.resolve_field_chain(f.exp);
          if resolved.is_none() {
            ret .Some(.UnsupportedNode);
          }
          let r = resolved.unwrap();
          subj_name = r.text;
          subj_type = .Some(r.type_name);
          subj_is_pointer = r.is_pointer;
        }
      }
      _ -> { ret .Some(.UnsupportedNode); }
    }

    bin wrote_branch = false;
    Node* default_body = nil;
    bin has_default = false;

    for br : f.branches {
      if !br.has_condition {
        if br.has_bindings && br.bindings.len > 0 {
          ret .Some(.UnsupportedNode);
        }
        default_body = br.body;
        has_default = true;
        continue;
      }

      bin handled_as_enum = false;
      fit br.condition.kind {
        .Expression(dot_e) -> {
          if equals(dot_e.op, ".") && dot_e.has_left && dot_e.has_right {
            str enum_name = "";
            bin have_enum_name = false;
            fit dot_e.left.kind {
              .Identifier(en) -> {
                enum_name = en;
                have_enum_name = true;
              }
              .Blank -> {
                if subj_type.is_some() {
                  enum_name = subj_type.unwrap();
                  have_enum_name = true;
                }
              }
              _ -> {}
            }
            str variant_name = "";
            fit dot_e.right.kind {
              .Identifier(vn) -> { variant_name = vn; }
              _ -> {}
            }
            // An explicit `EnumName.Variant` condition names the bare
            // template when the subject is a generic enum, but only the
            // mangled instantiation is registered. When the plain lookup
            // fails and `subj_type` is a concrete instantiation of
            // `enum_name`, the condition matches `subj_type`'s variant
            // instead. Bare shorthand skips this, already falling back to
            // `subj_type`.
            bin has_variant = self.enum_has_variant(enum_name, variant_name);
            str effective_enum_name = enum_name;
            if !has_variant && have_enum_name && subj_type.is_some() {
              let subj = subj_type.unwrap();
              StringBuilder tmpl_pfx = string_builder_init(16);
              tmpl_pfx.append(enum_name);
              tmpl_pfx.append("__");
              if starts_with(subj, tmpl_pfx.build()) &&
                self.enum_has_variant(subj, variant_name) {
                has_variant = true;
                effective_enum_name = subj;
              }
            }
            if have_enum_name && has_variant {
              // A plain (payload-less) enum has no `.tag` field, so it
              // needs a different comparison from a tagged union's
              // `.tag == ...`.
              if self.enum_is_tagged_union_named(effective_enum_name) {
                let eerr = self.emit_fit_enum_branch(
                  subj_name,
                  subj_is_pointer,
                  effective_enum_name,
                  variant_name,
                  br,
                  wrote_branch
                );
                if eerr.is_some() {
                  ret eerr;
                }
              } else {
                if br.has_bindings && br.bindings.len > 0 {
                  ret .Some(.UnsupportedNode);
                }
                let peerr = self.emit_fit_plain_enum_branch(
                  subj_name,
                  subj_is_pointer,
                  effective_enum_name,
                  variant_name,
                  br,
                  wrote_branch
                );
                if peerr.is_some() {
                  ret peerr;
                }
              }
              handled_as_enum = true;
              wrote_branch = true;
            }
          }
        }
        _ -> {}
      }
      if handled_as_enum {
        continue;
      }

      if br.has_bindings && br.bindings.len > 0 {
        ret .Some(.UnsupportedNode);
      }

      if wrote_branch {
        self.state.write(" else if (");
      } else {
        self.state.write("if (");
      }

      Vec<Node*> labels;
      labels.init(0);
      defer labels.free();
      self.flatten_call_args(br.condition, &labels);

      bin first_label = true;
      for lbl : labels {
        if !first_label {
          self.state.write(" || ");
        }
        first_label = false;
        bin is_str_label = false;
        fit lbl.kind {
          .String(_) -> { is_str_label = true; }
          _ -> {}
        }
        if is_str_label {
          self.state.write("strcmp(");
          self.state.write(subj_name);
          self.state.write(", ");
          let lerr = self.emit_expr(*lbl);
          if lerr.is_some() {
            ret lerr;
          }
          self.state.write(") == 0");
        } else {
          self.state.write(subj_name);
          self.state.write(" == ");
          let lerr2 = self.emit_expr(*lbl);
          if lerr2.is_some() {
            ret lerr2;
          }
        }
      }

      self.state.write(") {\n");
      self.state.indent_level = self.state.indent_level + 1;
      let berr = self.emit_body(*br.body);
      if berr.is_some() {
        ret berr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
      wrote_branch = true;
    }

    if has_default {
      if wrote_branch {
        self.state.write(" else {\n");
      } else {
        self.state.write("{\n");
      }
      self.state.indent_level = self.state.indent_level + 1;
      let dberr = self.emit_body(*default_body);
      if dberr.is_some() {
        ret dberr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
    }
    self.state.write("\n");
    ret .None;
  }

  // Emits an `if (cond) { ... }` block, without the trailing newline;
  // the caller decides what comes next.
  emit_if_block(Node* condition, Node* body) Option<CodegenErrorKind> {
    self.state.write("if (");
    let cerr = self.emit_condition(*condition);
    if cerr.is_some() {
      ret cerr;
    }
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits `stmts[start_i]` (a `StatementIf`) chained with every
  // immediately-following `StatementElseIf`/`StatementElse` sibling as
  // one C `if (...) { } else if (...) { } else { }`, returning the index
  // past the chain. `if`/`elif`/`else` parse as three independent sibling
  // statement kinds, not a nested tree, so chaining needs this lookahead.
  emit_if_chain(Vec<Node*> stmts, num start_i, num* out_next_i) Option<CodegenErrorKind> {
    Node* if_stmt = stmts.get(start_i);
    fit if_stmt.kind {
      .StatementIf(ifn) -> {
        let ferr = self.emit_if_block(ifn.condition, ifn.body);
        if ferr.is_some() {
          ret ferr;
        }
      }
      _ -> { ret .Some(.InvalidNode); }
    }

    num i = start_i + 1;
    for i < stmts.len {
      Node* next = stmts.get(i);
      bin chained = false;
      fit next.kind {
        .StatementElseIf(ein) -> {
          self.state.write(" else ");
          let eerr = self.emit_if_block(ein.condition, ein.body);
          if eerr.is_some() {
            ret eerr;
          }
          chained = true;
        }
        .StatementElse(ebody) -> {
          self.state.write(" else {\n");
          self.state.indent_level = self.state.indent_level + 1;
          let elerr = self.emit_body(*ebody);
          if elerr.is_some() {
            ret elerr;
          }
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}");
          chained = true;
        }
        _ -> {}
      }
      if !chained {
        break;
      }
      i = i + 1;
    }
    self.state.write("\n");
    *out_next_i = i;
    ret .None;
  }

  // True for a statement kind that always leaves its enclosing block: a
  // `ret`/`break`/`continue`, or a bare `panic(...)`. `emit_statements`
  // uses it to decide whether fall-through defer cleanup is needed after
  // a block's last statement. An if/elif/else chain is never a terminator
  // here even when every branch returns, since proving that needs
  // branch-coverage analysis, so such a block emits dead but valid
  // cleanup.
  node_is_scope_terminator(Node stmt) bin {
    fit stmt.kind {
      .StatementReturn(_) -> { ret true; }
      .StatementBreak -> { ret true; }
      .StatementContinue -> { ret true; }
      .Panic(_) -> { ret true; }
      _ -> { ret false; }
    }
  }

  // Pushes a new `defer` scope frame, marking `defer_stack`'s current
  // length as where this block's defers begin.
  push_defer_scope() {
    self.defer_scope_starts.push(self.defer_stack.len);
  }

  // Pops the innermost `defer` scope frame and discards its by-now
  // already-emitted entries from `defer_stack`.
  pop_defer_scope() {
    if self.defer_scope_starts.len == 0 {
      ret;
    }
    let start = self.defer_scope_starts.pop();
    self.defer_stack.resize(start, nil);
  }

  // Emits, without removing, every pending defer from `defer_stack`'s end
  // back down to `start_index`, in reverse registration order, each as an
  // ordinary statement.
  emit_defers_from(num start_index) Option<CodegenErrorKind> {
    num i = self.defer_stack.len;
    for i > start_index {
      i = i - 1;
      let d = self.defer_stack.get(i);
      let derr = self.emit_body(*d);
      if derr.is_some() {
        ret derr;
      }
    }
    ret .None;
  }

  // Emits just the current (innermost) block's pending defers, used at
  // ordinary fall-through when the block ends without an explicit
  // `ret`/`break`/`continue`/`panic`.
  emit_current_scope_defers() Option<CodegenErrorKind> {
    if self.defer_scope_starts.len == 0 {
      ret .None;
    }
    let start = self.defer_scope_starts.get(self.defer_scope_starts.len - 1);
    ret self.emit_defers_from(start);
  }

  // Emits every pending defer back to function entry, for a `ret`, which
  // unwinds every enclosing block at once. Frame kinds aren't
  // distinguished, so function entry is always index 0.
  emit_function_scope_defers() Option<CodegenErrorKind> {
    ret self.emit_defers_from(0);
  }

  // Emits `stmts` in order, one statement per line, chaining any
  // `StatementIf`/`StatementElseIf`/`StatementElse` run into a single C
  // if/else-if/else construct. Pushes and pops a `defer` scope frame
  // around the list: every block, not just a function's top-level body,
  // is its own defer scope.
  emit_statements(Vec<Node*> stmts) Option<CodegenErrorKind> {
    self.push_defer_scope();
    num i = 0;
    bin last_is_terminator = false;
    for i < stmts.len {
      Node* stmt = stmts.get(i);
      // Armed fresh per statement, relative to whatever buffer
      // `self.state` currently is. Mid-swap that's a scratch buffer, so a
      // nested trigger from deeper in this body splices its inline
      // prototype into the same scratch, before the statement that
      // triggered it. The swap restores the outer value afterward, as it
      // does for `hoist_insert_pos`.
      self.current_stmt_start_pos = .Some(self.state.out.len());
      bin is_if = false;
      fit stmt.kind {
        .StatementIf(ifn) -> { is_if = true; }
        _ -> {}
      }
      if is_if {
        self.state.write_indent();
        num next_i = i;
        let cherr = self.emit_if_chain(stmts, i, &next_i);
        if cherr.is_some() {
          self.pop_defer_scope();
          ret cherr;
        }
        i = next_i;
        last_is_terminator = false;
        continue;
      }
      last_is_terminator = self.node_is_scope_terminator(*stmt);
      let serr = self.emit_statement(*stmt);
      if serr.is_some() {
        self.pop_defer_scope();
        ret serr;
      }
      i = i + 1;
    }
    if !last_is_terminator {
      let dferr = self.emit_current_scope_defers();
      if dferr.is_some() {
        self.pop_defer_scope();
        ret dferr;
      }
    }
    self.pop_defer_scope();
    ret .None;
  }

  // Emits `body`: every statement in order for a `Body` block, or the one
  // statement for a braceless body, since an `if`/`for` body doesn't
  // require `{ }` around a single statement.
  emit_body(Node body) Option<CodegenErrorKind> {
    fit body.kind {
      .Body(bn) -> { ret self.emit_statements(bn.statements); }
      _ -> { ret self.emit_statement(body); }
    }
  }

  // Emits one function parameter as `<type> <name>` and records it as a
  // local for `.`/`->` decisions. A function-type parameter
  // (`fun(T1, T2) R name`) needs C's function-pointer declarator, which
  // wraps the name rather than preceding it (`R (*name)(T1, T2)`), so it
  // is handled before the ordinary `write_type` path. Calling through
  // such a parameter needs nothing special at the call site, its C type
  // already being a function pointer; it is recorded under an empty type
  // name so a later `.field` off it is rejected rather than guessed.
  // Writes `dtype name`, in whatever order C wants the name written. A
  // function type puts it inside the declarator, `bin (*name)(num)`, so
  // a type and a name cannot simply be written one after the other.
  write_named_type(DataType dtype, str name) Option<CodegenErrorKind> {
    if !dtype.has_fn_sig {
      let plain = self.write_type(dtype);
      if plain.is_none() {
        ret .Some(.UnsupportedNode);
      }
      self.state.write(" ");
      self.state.write(name);
      ret .None;
    }

    let sig = dtype.fn_sig;
    let rt = self.write_type(*sig.rtype);
    if rt.is_none() {
      ret .Some(.UnsupportedNode);
    }
    self.state.write(" (*");
    self.state.write(name);
    self.state.write(")(");
    bin first = true;
    for p : sig.params {
      if !first {
        self.state.write(", ");
      }
      first = false;
      let pt = self.write_type(*p);
      if pt.is_none() {
        ret .Some(.UnsupportedNode);
      }
    }
    self.state.write(")");
    ret .None;
  }

  emit_function_param(Node param) Option<CodegenErrorKind> {
    fit param.kind {
      .Variable(v) -> {
        if v.var_type.has_fn_sig {
          let sig = v.var_type.fn_sig;
          let rt = self.write_type(*sig.rtype);
          if rt.is_none() {
            ret .Some(.UnsupportedNode);
          }
          self.state.write(" (*");
          self.state.write(v.name);
          self.state.write(")(");
          bin first = true;
          for p : sig.params {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let pt = self.write_type(*p);
            if pt.is_none() {
              ret .Some(.UnsupportedNode);
            }
          }
          self.state.write(")");
          self.record_local(v.name, "", false);
          ret .None;
        }
        // An unsized array parameter (`T[] src`) decays to a pointer.
        // `write_type` only knows `pointer_depth`/`flags.is_pointer`, so
        // the star is added here, unconditionally stacking on whatever
        // depth it already wrote. Gating on `!dtype_is_pointer(param_dt)`
        // would drop the array's level whenever the element is itself a
        // pointer: `Vec<Node*>`'s `push_many(Node* src, ...)` needs
        // `Node** src`, one level for the array and one for the element.
        bin arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
        let wt = self.write_type(*v.var_type);
        if wt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        let param_dt = self.resolve_type_subst(*v.var_type);
        if arr_as_ptr {
          self.state.write("*");
        }
        self.state.write(" ");
        self.state.write(v.name);
        self.record_local_typed(
          v.name,
          wt.unwrap(),
          dtype_is_pointer(param_dt) || arr_as_ptr,
          param_dt
        );
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Emits a plain (no generics, no variadics) top-level function as a C
  // definition: `<rtype> <name>(<args>) { <body> }`, with `(void)` for a
  // zero-arg function, since an empty `()` in C means "unspecified
  // arguments" rather than "no arguments".
  pub emit_function(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        ret self.emit_function_named(node, self.effective_function_name(f.name));
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // True when `node` was declared in a `std/c/*.fn` binding file, a
  // signature-only module documenting an existing C header such as
  // `std/c/time.fn`'s `tm` or `std/c/io.fn`'s `FILE`. Such a declaration
  // exists so call sites and field accesses can typecheck against it; the
  // system header remains the sole source of truth, so codegen must never
  // emit competing C text for one of these nodes.
  is_std_c_signature_node(Node node) bin {
    if !node.has_pos {
      ret false;
    }
    ret contains(node.pos.filename, "/std/c/") ||
      contains(node.pos.filename, "\\std\\c\\");
    }

  // Emits the wrapper C functions an `async` function or method needs
  // around its ordinary body: a payload struct holding its args and
  // result, an entry trampoline running on a dedicated OS thread that
  // unpacks and repacks through that payload, a spawn helper, an await
  // helper that joins and extracts the result, and the call helper
  // `await expr` invokes. A `fork expr;` reuses the same payload struct
  // through a second entry and call pair. There is no state machine or
  // coroutine transform: `await` spawns a thread and immediately joins
  // it, `fork` enqueues onto the scheduler's worker pool without waiting.
  // `emit_name` is the function's final C name, used by the entry
  // trampoline and the call helper's synchronous fallback, and covers a
  // monomorphized `async` method once per instantiation. An argument of
  // function type is carried like any other, written into the payload as
  // the declarator C wants rather than as a type beside a name.
  emit_async_function_support(Node node, str emit_name) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(.InvalidNode);
        }
        bin is_void = equals(f.rtype.type_str, "void");

        Vec<str> arg_names;
        arg_names.init(0);
        Vec<DataType*> arg_dtypes;
        arg_dtypes.init(0);
        if f.has_args {
          for arg : f.args {
            fit arg.kind {
              .Variable(v) -> {
                arg_names.push(v.name);
                arg_dtypes.push(v.var_type);
              }
              _ -> {}
            }
          }
        }

        // 0. Forward-declare `emit_name`: the entry trampoline and the
        // call helper's sync-fallback path both call it directly, but its
        // definition is emitted after this helper set returns.
        let fwt = self.write_type(*f.rtype);
        if fwt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        self.state.write(" ");
        self.state.write(emit_name);
        self.state.write("(");
        num fi = 0;
        for fi < arg_dtypes.len {
          if fi > 0 {
            self.state.write(", ");
          }
          let fpt = self.write_type(*arg_dtypes.get(fi));
          if fpt.is_none() {
            ret .Some(.UnsupportedNode);
          }
          fi = fi + 1;
        }
        if arg_dtypes.len == 0 {
          self.state.write("void");
        }
        self.state.write(");\n");

        StringBuilder pnb = string_builder_init(32);
        pnb.append("__fun_async_payload_");
        pnb.append(emit_name);
        str payload_name = pnb.build();

        // 1. Payload struct: one field per arg, plus `__result` unless
        // the return type is `void`.
        self.state.write("typedef struct ");
        self.state.write(payload_name);
        self.state.write(" {\n");
        num ai = 0;
        for ai < arg_names.len {
          self.state.write("  ");
          StringBuilder fb = string_builder_init(16);
          fb.append("__arg");
          fb.append(format_num(ai));
          let awt = self.write_named_type(*arg_dtypes.get(ai), fb.build());
          if awt.is_some() {
            ret awt;
          }
          self.state.write(";\n");
          ai = ai + 1;
        }
        if !is_void {
          self.state.write("  ");
          let rwt = self.write_type(*f.rtype);
          if rwt.is_none() {
            ret .Some(.UnsupportedNode);
          }
          self.state.write(" __result;\n");
        }
        self.state.write("} ");
        self.state.write(payload_name);
        self.state.write(";\n");

        // 2. Entry trampoline: runs on the spawned thread.
        self.state.write("static void* __fun_async_entry_");
        self.state.write(emit_name);
        self.state.write("(void* __arg) {\n");
        self.state.write("  ");
        self.state.write(payload_name);
        self.state.write("* __payload = (");
        self.state.write(payload_name);
        self.state.write("*)__arg;\n");
        self.state.write("  ");
        if !is_void {
          self.state.write("__payload->__result = ");
        }
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          self.state.write("__payload->__arg");
          self.state.write(format_num(ai));
          ai = ai + 1;
        }
        self.state.write(");\n");
        self.state.write("  return NULL;\n");
        self.state.write("}\n");

        // 3. Spawn helper.
        self.state.write("static int __fun_async_spawn_");
        self.state.write(emit_name);
        self.state.write("(");
        self.state.write(payload_name);
        self.state.write("* __payload, __fun_thread_t* __thr) {\n");
        self.state.write("  return __fun_thread_start(__thr, __fun_async_entry_");
        self.state.write(emit_name);
        self.state.write(", __payload);\n");
        self.state.write("}\n");

        // 4. Await helper: join, extract the result, free the payload.
        self.state.write("static ");
        let awt2 = self.write_type(*f.rtype);
        if awt2.is_none() {
          ret .Some(.UnsupportedNode);
        }
        self.state.write(" __fun_async_await_");
        self.state.write(emit_name);
        self.state.write("(");
        self.state.write(payload_name);
        self.state.write("* __payload, __fun_thread_t __thr) {\n");
        self.state.write("  (void)__fun_thread_join(__thr);\n");
        if is_void {
          self.state.write("  free(__payload);\n");
        } else {
          self.state.write("  ");
          let rwt2 = self.write_type(*f.rtype);
          if rwt2.is_none() {
            ret .Some(.UnsupportedNode);
          }
          self.state.write(" __result = __payload->__result;\n");
          self.state.write("  free(__payload);\n");
          self.state.write("  return __result;\n");
        }
        self.state.write("}\n");

        // 5. Call helper: what `await expr` lowers to. Degrades to a
        // direct synchronous call on malloc or spawn failure.
        self.state.write("static ");
        let cwt = self.write_type(*f.rtype);
        if cwt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        self.state.write(" __fun_async_call_");
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          let pwt = self.write_type(*arg_dtypes.get(ai));
          if pwt.is_none() {
            ret .Some(.UnsupportedNode);
          }
          self.state.write(" ");
          self.state.write(arg_names.get(ai));
          ai = ai + 1;
        }
        if arg_names.len == 0 {
          self.state.write("void");
        }
        self.state.write(") {\n");
        self.state.write("  ");
        self.state.write(payload_name);
        self.state.write("* __payload = malloc(sizeof(");
        self.state.write(payload_name);
        self.state.write("));\n");
        self.state.write("  if (__payload == NULL) { ");
        if !is_void {
          self.state.write("return ");
        }
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          self.state.write(arg_names.get(ai));
          ai = ai + 1;
        }
        self.state.write(");");
        if is_void {
          self.state.write(" return;");
        }
        self.state.write(" }\n");
        ai = 0;
        for ai < arg_names.len {
          self.state.write("  __payload->__arg");
          self.state.write(format_num(ai));
          self.state.write(" = ");
          self.state.write(arg_names.get(ai));
          self.state.write(";\n");
          ai = ai + 1;
        }
        self.state.write("  __fun_thread_t __thr;\n");
        self.state.write("  int __rc = __fun_async_spawn_");
        self.state.write(emit_name);
        self.state.write("(__payload, &__thr);\n");
        self.state.write("  if (__rc != 0) { free(__payload); ");
        if !is_void {
          self.state.write("return ");
        }
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          self.state.write(arg_names.get(ai));
          ai = ai + 1;
        }
        self.state.write(");");
        if is_void {
          self.state.write(" return;");
        }
        self.state.write(" }\n");
        if is_void {
          self.state.write("  __fun_async_await_");
          self.state.write(emit_name);
          self.state.write("(__payload, __thr);\n");
        } else {
          self.state.write("  return __fun_async_await_");
          self.state.write(emit_name);
          self.state.write("(__payload, __thr);\n");
        }
        self.state.write("}\n\n");

        // 6. Fork support, emitted only when `fork` is used anywhere in
        // the program. Reuses the payload struct above; the entry runs
        // the function then frees the payload itself, the result being
        // discarded, and the call helper enqueues onto the scheduler via
        // `__fun_go` rather than spawning and joining, with the same
        // degrade-to-sync fallback as the await call helper.
        if self.uses_fork {
          self.state.write("static void __fun_fork_entry_");
          self.state.write(emit_name);
          self.state.write("(void* __arg) {\n");
          self.state.write("  ");
          self.state.write(payload_name);
          self.state.write("* __payload = (");
          self.state.write(payload_name);
          self.state.write("*)__arg;\n");
          self.state.write("  ");
          self.state.write(emit_name);
          self.state.write("(");
          ai = 0;
          for ai < arg_names.len {
            if ai > 0 {
              self.state.write(", ");
            }
            self.state.write("__payload->__arg");
            self.state.write(format_num(ai));
            ai = ai + 1;
          }
          self.state.write(");\n");
          self.state.write("  free(__payload);\n");
          self.state.write("}\n");

          self.state.write("static void __fun_fork_call_");
          self.state.write(emit_name);
          self.state.write("(");
          ai = 0;
          for ai < arg_names.len {
            if ai > 0 {
              self.state.write(", ");
            }
            let fpt = self.write_type(*arg_dtypes.get(ai));
            if fpt.is_none() {
              ret .Some(.UnsupportedNode);
            }
            self.state.write(" ");
            self.state.write(arg_names.get(ai));
            ai = ai + 1;
          }
          if arg_names.len == 0 {
            self.state.write("void");
          }
          self.state.write(") {\n");
          self.state.write("  ");
          self.state.write(payload_name);
          self.state.write("* __payload = malloc(sizeof(");
          self.state.write(payload_name);
          self.state.write("));\n");
          self.state.write("  if (__payload == NULL) { ");
          self.state.write(emit_name);
          self.state.write("(");
          ai = 0;
          for ai < arg_names.len {
            if ai > 0 {
              self.state.write(", ");
            }
            self.state.write(arg_names.get(ai));
            ai = ai + 1;
          }
          self.state.write("); return; }\n");
          ai = 0;
          for ai < arg_names.len {
            self.state.write("  __payload->__arg");
            self.state.write(format_num(ai));
            self.state.write(" = ");
            self.state.write(arg_names.get(ai));
            self.state.write(";\n");
            ai = ai + 1;
          }
          self.state.write("  __fun_go(__fun_fork_entry_");
          self.state.write(emit_name);
          self.state.write(", __payload);\n");
          self.state.write("}\n\n");
        }
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Does the work of `pub emit_function` under an explicit `emit_name`
  // rather than `node`'s mangled `Function.name`, so the same template
  // method body can be emitted once per concrete instantiation, each
  // under its own further-mangled C symbol. `current_fn_rtype_name` is
  // set from the resolved post-substitution return type, so a generic
  // method's bare-`T` return type resolves against the active
  // instantiation for `ret <shorthand>;`.
  emit_function_named(Node node, str emit_name) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        // A bodyless function, such as every `std.c.*` binding, is a
        // signature-only declaration. The system header is authoritative
        // and its param types need not match these (`size_t` versus
        // `int64_t`), so emitting a competing prototype would cause a
        // conflicting-types error. `register_function_signatures` already
        // recorded the signature before any emission pass, so skipping C
        // text here doesn't affect call-site resolution.
        if !f.has_body {
          ret .None;
        }
        // An `async` body is transpiled as an ordinary C function below,
        // with no state machine or coroutine transform; the asyncness
        // lives in the wrapper functions `emit_async_function_support`
        // generates around it. `main` is excluded, since nothing `await`s
        // it.
        if f.is_async && !equals(emit_name, "main") {
          let aserr = self.emit_async_function_support(node, emit_name);
          if aserr.is_some() {
            ret aserr;
          }
        }
        // Marks the true start of this function's own signature, so a
        // lazily-triggered prototype can splice somewhere every call
        // site in the whole function (not just the one that happened
        // to trigger it first) can see. Only the outermost call owns
        // this: a nested one reached through some scratch buffer
        // (`self.state != self.root_state`) leaves it alone, since its
        // own position would be relative to the wrong buffer entirely.
        bin owns_fn_body_start_pos = self.state == self.root_state &&
          self.current_fn_body_start_pos.is_none();
        if owns_fn_body_start_pos {
          self.current_fn_body_start_pos = .Some(self.state.out.len());
        }
        // Fresh per function, and not scoped to nested blocks, so an
        // inner `{ }` shadowing an outer local of the same name isn't
        // tracked correctly.
        self.local_names.init(0);
        self.local_is_pointer.init(0);
        self.local_type_name.init(0);
        self.local_dtype.init(0);
        self.local_multidim_names.init(0);
        self.local_multidim_roots.init(0);
        self.local_multidim_depths.init(0);
        // Fresh per function too: a previous function's leftover pending
        // defers must never bleed into this one.
        self.defer_stack.init(0);
        self.defer_scope_starts.init(0);
        if !f.has_rtype {
          ret .Some(.InvalidNode);
        }
        // `write_type` writes the return type's C spelling to
        // `self.state` as a side effect of resolving it. For `main` that
        // text must never reach the output, the signature being forced to
        // `int` below, so it is captured into a throwaway scratch buffer
        // and discarded once `rt` is in hand. `hoist_insert_pos` is
        // suspended for the swap, so a nested hoisted emission splices
        // into the real buffer.
        bin is_main = equals(emit_name, "main");
        CodegenState rtype_scratch = codegen_state_new();
        CodegenState* saved_rtype_state = self.state;
        let saved_rtype_hoist_pos = self.hoist_insert_pos;
        if is_main {
          self.state = &rtype_scratch;
          self.hoist_insert_pos = .None;
        }
        let rt = self.write_type(*f.rtype);
        // `write_type` writes a type's own `pointer_depth`, not its
        // array-decay: an unsized `str[]` return needs one more star
        // than `str` alone (`char**`, not `char*`), the same extra star
        // a field or parameter of the same array type already gets at
        // its own, separate emission site.
        if dtype_is_array_as_pointer(*f.rtype) {
          self.state.write("*");
        }
        if is_main {
          self.state = saved_rtype_state;
          self.hoist_insert_pos = saved_rtype_hoist_pos;
        }
        if rt.is_none() {
          ret .Some(.UnsupportedNode);
        }
        self.current_fn_rtype_name = rt.unwrap();
        self.current_fn_rtype_dt = .Some(self.resolve_type_subst(*f.rtype));
        // C's `main` must be `int main(void)` or take `argc`/`argv`
        // (optionally `envp`), regardless of the Fun-level signature.
        // Only the written C signature is overridden here;
        // `current_fn_rtype_name`/`_dt` above stay set from the declared
        // return type for the body's own bookkeeping. No params emits the
        // standard `argc`/`argv` pair; a single `str[] name` param keeps
        // that name but still takes OS argv; anything else emits the
        // declared params verbatim.
        bin main_is_single_str_array = false;
        if is_main && f.has_args && f.args.len == 1 {
          let main_arg0 = f.args.get(0);
          fit main_arg0.kind {
            .Variable(v) -> {
              if equals(v.var_type.type_str, "str") && v.var_type.is_array {
                main_is_single_str_array = true;
              }
            }
            _ -> {}
          }
        }
        if is_main {
          self.state.write("int");
        }
        self.state.write(" ");
        self.state.write(emit_name);
        self.state.write("(");
        if is_main && (!f.has_args || f.args.len == 0) {
          self.state.write("int argc, char** argv");
        } elif is_main && main_is_single_str_array {
          self.state.write("int argc, ");
          let margerr = self.emit_function_param(*f.args.get(0));
          if margerr.is_some() {
            ret margerr;
          }
        } elif f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let aerr = self.emit_function_param(*arg);
            if aerr.is_some() {
              ret aerr;
            }
          }
        } elif !f.is_variadic {
          self.state.write("void");
        }
        // A variadic function gets two extra trailing C params beyond its
        // named ones: `const char* __fun_vtags`, a NUL-terminated
        // per-call type-tag string with one character per vararg, then
        // the real `...`.
        if f.is_variadic {
          if f.has_args && f.args.len > 0 {
            self.state.write(", ");
          }
          self.state.write("const char* __fun_vtags, ...");
        }
        // A bodyless function emits as a bare prototype, relying on the
        // library definition being linked in separately. An empty `{ }`
        // definition would shadow libc's own `malloc`/`free` with no-op
        // redefinitions.
        if !f.has_body {
          self.state.write(");\n");
          ret .None;
        }
        self.state.write(") {\n");
        self.state.indent_level = self.state.indent_level + 1;
        // A variadic body starts by unpacking its varargs, through
        // `__fun_vtags` and `va_arg`, into a `Vec<str>` named `vargs`:
        // the synthetic local the parser registers in scope but never
        // declares. Each vararg is stringified by the `fmt_*` helper
        // matching its `__fun_tag` character rather than kept in its
        // native C type, since `vargs` is always a `Vec<str>`.
        if f.is_variadic {
          self.state.write_indent();
          self.state.write("Vec__str vargs;\n");
          self.state.write_indent();
          self.state.write("vargs.len = 0; vargs.cap = 0; vargs.data = NULL;\n");
          self.state.write_indent();
          self.state.write("if (__fun_vtags) {\n");
          self.state.indent_level = self.state.indent_level + 1;
          self.state.write_indent();
          self.state.write("size_t __fun_vc = 0; while (__fun_vtags[__fun_vc] != 0) { __fun_vc++; }\n");
          self.state.write_indent();
          self.state.write("vargs.len = (int64_t)__fun_vc; vargs.cap = (int64_t)__fun_vc;\n");
          self.state.write_indent();
          self.state.write("if (__fun_vc > 0) { vargs.data = (char**)malloc(sizeof(char*) * __fun_vc); }\n");
          self.state.write_indent();
          self.state.write("va_list __fun_ap; va_start(__fun_ap, __fun_vtags);\n");
          self.state.write_indent();
          self.state.write("size_t __fun_vi = 0; while (__fun_vi < __fun_vc) {\n");
          self.state.indent_level = self.state.indent_level + 1;
          self.state.write_indent();
          self.state.write("char __fun_tagc = __fun_vtags[__fun_vi];\n");
          self.state.write_indent();
          self.state.write("switch (__fun_tagc) {\n");
          self.state.indent_level = self.state.indent_level + 1;
          self.state.write_indent();
          self.state.write("case 's': vargs.data[__fun_vi] = va_arg(__fun_ap, char*); break;\n");
          self.state.write_indent();
          self.state.write("case 'n': vargs.data[__fun_vi] = fmt_num((int64_t)va_arg(__fun_ap, long long)); break;\n");
          self.state.write_indent();
          self.state.write("case 'd': vargs.data[__fun_vi] = fmt_dec((double)va_arg(__fun_ap, double)); break;\n");
          self.state.write_indent();
          self.state.write("case 'b': vargs.data[__fun_vi] = fmt_bin((bool)va_arg(__fun_ap, int)); break;\n");
          self.state.write_indent();
          self.state.write("case 'c': vargs.data[__fun_vi] = fmt_chr((char)va_arg(__fun_ap, int)); break;\n");
          self.state.write_indent();
          self.state.write("case 'p': vargs.data[__fun_vi] = fmt_raw((void*)va_arg(__fun_ap, void*)); break;\n");
          self.state.write_indent();
          self.state.write("default: vargs.data[__fun_vi] = fmt_raw((void*)va_arg(__fun_ap, void*)); break;\n");
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}\n");
          self.state.write_indent();
          self.state.write("__fun_vi = __fun_vi + 1;\n");
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}\n");
          self.state.write_indent();
          self.state.write("va_end(__fun_ap);\n");
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}\n");
          // Recorded as a known local so the body's reads of `vargs`
          // resolve like any other `Vec<str>`, with `resolve_type_name`
          // instantiating `Vec__str` regardless of program order.
          DataType* vargs_str_arg = malloc(sizeof(DataType));
          *vargs_str_arg = dtype_new();
          vargs_str_arg.type_str = "str";
          DataType vargs_dt = dtype_new();
          vargs_dt.type_str = "Vec";
          vargs_dt.generic_args.push(vargs_str_arg);
          self.resolve_type_name(vargs_dt);
          self.record_local_typed("vargs", "Vec__str", false, vargs_dt);
          // `vargs.data` and every non-`'s'`-tagged element it holds
          // (a fresh `fmt_*` allocation) are otherwise never freed.
          // Registered as a synthetic `defer`, replaying through the
          // same mechanism a user-written one uses at every return.
          Node* vargs_ident_a = malloc(sizeof(Node));
          *vargs_ident_a = node_new(.Identifier("vargs"));
          Node* data_ident = malloc(sizeof(Node));
          *data_ident = node_new(.Identifier("data"));
          ExprNode vargs_data_e = expr_node_new();
          vargs_data_e.left = vargs_ident_a;
          vargs_data_e.has_left = true;
          vargs_data_e.right = data_ident;
          vargs_data_e.has_right = true;
          vargs_data_e.op = ".";
          Node* vargs_data_node = malloc(sizeof(Node));
          *vargs_data_node = node_new(.Expression(vargs_data_e));

          Node* vtags_ident = malloc(sizeof(Node));
          *vtags_ident = node_new(.Identifier("__fun_vtags"));

          Node* vargs_ident_b = malloc(sizeof(Node));
          *vargs_ident_b = node_new(.Identifier("vargs"));
          Node* len_ident = malloc(sizeof(Node));
          *len_ident = node_new(.Identifier("len"));
          ExprNode vargs_len_e = expr_node_new();
          vargs_len_e.left = vargs_ident_b;
          vargs_len_e.has_left = true;
          vargs_len_e.right = len_ident;
          vargs_len_e.has_right = true;
          vargs_len_e.op = ".";
          Node* vargs_len_node = malloc(sizeof(Node));
          *vargs_len_node = node_new(.Expression(vargs_len_e));

          ExprNode free_args_tail = expr_node_new();
          free_args_tail.left = vtags_ident;
          free_args_tail.has_left = true;
          free_args_tail.right = vargs_len_node;
          free_args_tail.has_right = true;
          free_args_tail.op = ",";
          Node* free_args_tail_node = malloc(sizeof(Node));
          *free_args_tail_node = node_new(.Expression(free_args_tail));

          ExprNode free_args_e = expr_node_new();
          free_args_e.left = vargs_data_node;
          free_args_e.has_left = true;
          free_args_e.right = free_args_tail_node;
          free_args_e.has_right = true;
          free_args_e.op = ",";
          Node* free_args_comma = malloc(sizeof(Node));
          *free_args_comma = node_new(.Expression(free_args_e));
          Node* free_args_node = malloc(sizeof(Node));
          *free_args_node = node_new(.ExpressionParenthesis(free_args_comma));

          Node* free_callee = malloc(sizeof(Node));
          *free_callee = node_new(.Identifier("__fun_free_vargs"));
          ExprNode free_call_e = expr_node_new();
          free_call_e.left = free_callee;
          free_call_e.has_left = true;
          free_call_e.right = free_args_node;
          free_call_e.has_right = true;
          free_call_e.op = "()";
          Node* free_call_node = malloc(sizeof(Node));
          *free_call_node = node_new(.Expression(free_call_e));
          self.defer_stack.push(free_call_node);
        }
        let saved_in_main = self.in_main;
        self.in_main = is_main;
        let berr = self.emit_body(*f.body);
        self.in_main = saved_in_main;
        if berr.is_some() {
          ret berr;
        }
        // Typecheck already rejects a non-void function whose body
        // doesn't return on every path; C's own, weaker flow analysis
        // can't always see that an exhaustive `fit`'s if/else-if chain
        // covers everything, and warns as if it were a real gap. Only
        // added when the body's own last statement isn't already a
        // plain `ret`, the common case C can already prove itself:
        // this doesn't need to be exhaustive about every provably-
        // terminating shape, just conservative about not stacking an
        // extra statement onto the ordinary one. Stays deliberately
        // loud (a crash) rather than `__builtin_unreachable()` (silent
        // undefined behavior), in case that guarantee is ever wrong.
        bin fn_body_ends_in_return = false;
        fit (*f.body).kind {
          .Body(fn_bn) -> {
            if fn_bn.statements.len > 0 {
              let fn_last_stmt = fn_bn.statements.get(fn_bn.statements.len - 1);
              fit fn_last_stmt.kind {
                .StatementReturn(_) -> { fn_body_ends_in_return = true; }
                _ -> {}
              }
            }
          }
          _ -> {}
        }
        if !is_main && !fn_body_ends_in_return && rt.is_some() &&
          !equals(rt.unwrap(), "void") {
          self.state.write_indent();
          self.state.write("fprintf(stderr_stream(), \"panic: unreachable\\n\"); abort();\n");
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write("}\n");
        if owns_fn_body_start_pos {
          self.current_fn_body_start_pos = .None;
        }
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Companion to `ensure_plain_type_emitted`, for a by-value field whose
  // type is a quirk rather than a plain compound or enum.
  // `emit_quirk_vtable_machinery` normally runs once per concrete impl in
  // `pub transpile`'s late per-impl pass, at that impl's source position,
  // which is too late for a compound embedding the quirk by value
  // earlier. This finds the first concrete impl of `type_name` and
  // triggers its machinery early; `emitted_quirk_impl_vtables` memoizes,
  // so it's safe whether or not the later pass already ran. A no-op when
  // `type_name` isn't a quirk with a concrete impl.
  ensure_quirk_vtable_emitted_early(str type_name) Option<CodegenErrorKind> {
    for n : self.all_nodes {
      fit n.kind {
        .Impl(i) -> {
          if i.has_quirk_name && equals(i.quirk_name, type_name) && !i.has_type_params {
            ret self.emit_quirk_vtable_machinery(n);
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Ensures a plain (non-generic) compound or enum named `type_name` is
  // fully emitted, recursively emitting any plain compound or enum it
  // embeds by value first: the same lazy, dependency-triggered, memoized
  // emission generic types get, keyed by bare name. A flat "all enums,
  // then all compounds" pass breaks once by-value dependencies run in
  // both directions across files. A by-pointer field or payload is
  // exempt, needing only the forward-declared struct name, and recursing
  // into it could misfire on a self-referential type. `.None` means
  // success, including when `type_name` isn't a known plain type.
  // `via_direct_embed` distinguishes a true by-value struct embedding (a
  // field typed directly as `type_name`) from a reference reached through
  // a generic container's type argument (`Vec<type_name>`,
  // `Map<str, type_name>`). A container like `Vec`/`Map` holds its
  // elements behind a pointer, so `Vec<A>` inside `A` itself (a
  // self-referential JSON-tree-style enum, say) is not an unbounded-size
  // cycle and must not be reported as one; only the direct case is
  // checked against `plain_type_in_progress`.
  ensure_plain_type_emitted(str type_name, bin via_direct_embed = true) Option<CodegenErrorKind> {
    num ei = 0;
    for ei < self.emitted_plain_types.len {
      if equals(self.emitted_plain_types.get(ei), type_name) {
        // Already started or finished. A name still on the active
        // recursion path (`plain_type_in_progress`) is a genuine cycle,
        // not just a repeat reference to an already-finished type.
        if via_direct_embed {
          for pip : self.plain_type_in_progress {
            if equals(pip, type_name) {
              self.error_note = format(
                "cyclic by-value compound dependency: '{str}' transitively embeds itself by value (use a pointer to break the cycle)",
                type_name
              );
              ret .Some(.UnsupportedNode);
            }
          }
        }
        ret .None;
      }
      ei = ei + 1;
    }
    for n : self.all_nodes {
      fit n.kind {
        .Compound(c) -> {
          if equals(c.name, type_name) && !c.has_type_params {
            // Pushed before recursing, not after emission finishes, so a
            // cycle is caught instead of recursing forever.
            self.emitted_plain_types.push(type_name);
            self.plain_type_in_progress.push(type_name);
            defer self.plain_type_in_progress.pop();
            for f : c.fields {
              if !dtype_is_pointer(*f.dtype) && !dtype_is_array_as_pointer(*f.dtype) {
                let fderr = self.ensure_plain_type_emitted(f.dtype.type_str);
                if fderr.is_some() {
                  ret fderr;
                }
                // A by-value quirk field needs the same early emission,
                // but the call above never finds it: a quirk is neither
                // a `.Compound` nor an `.Enum` node.
                let fqerr = self.ensure_quirk_vtable_emitted_early(f.dtype.type_str);
                if fqerr.is_some() {
                  ret fqerr;
                }
                // A by-value field that is itself a generic instantiation
                // (`Vec<DataType*> generic_args;`) hides its dependency
                // inside `generic_args`: the instantiation's
                // monomorphized methods may subscript a field typed as a
                // concrete argument, needing that argument's complete
                // type. Must run before `emit_compound` starts writing
                // this type's body, or a nested definition would splice
                // into a still-open struct. Skips a further-generic
                // argument.
                for garg : f.dtype.generic_args {
                  if garg.generic_args.len == 0 {
                    let gerr = self.ensure_plain_type_emitted(garg.type_str, false);
                    if gerr.is_some() {
                      ret gerr;
                    }
                  }
                }
              }
            }
            self.hoist_insert_pos = .Some(self.state.out.len());
            ret self.emit_compound(n);
          }
        }
        .Enum(e) -> {
          if equals(e.name, type_name) && !e.has_type_params {
            self.emitted_plain_types.push(type_name);
            self.plain_type_in_progress.push(type_name);
            defer self.plain_type_in_progress.pop();
            bin is_tagged_union = false;
            for v : e.variants {
              if v.has_payload && v.payload.len > 0 {
                is_tagged_union = true;
              }
            }
            if is_tagged_union {
              for v : e.variants {
                for pt : v.payload {
                  if !dtype_is_pointer(*pt) {
                    let pderr = self.ensure_plain_type_emitted(pt.type_str);
                    if pderr.is_some() {
                      ret pderr;
                    }
                    // See the identical `f.dtype.generic_args` loop in
                    // the `.Compound` branch above.
                    for garg : pt.generic_args {
                      if garg.generic_args.len == 0 {
                        let gerr = self.ensure_plain_type_emitted(garg.type_str, false);
                        if gerr.is_some() {
                          ret gerr;
                        }
                      }
                    }
                  }
                }
              }
            }
            self.hoist_insert_pos = .Some(self.state.out.len());
            ret self.emit_enum(n);
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Emits a non-generic `enum Name { variants }`: a plain C enum typedef
  // when no variant carries a payload, or the tagged-union layout when
  // one does. Registers the enum so a later `EnumName.Variant` access
  // resolves. A generic enum is only recorded as a template and never
  // emitted directly, as with a generic compound; only a concrete
  // monomorphization is emitted.
  emit_enum(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Enum(e) -> {
        if e.has_type_params {
          Vec<GenericEnumVariantTemplate> variant_templates;
          variant_templates.init(0);
          for v : e.variants {
            GenericEnumVariantTemplate vt;
            vt.name = v.name;
            vt.has_payload = v.has_payload && v.payload.len > 0;
            Vec<str> payload_type_strs;
            payload_type_strs.init(0);
            Vec<bin> payload_is_pointer;
            payload_is_pointer.init(0);
            for pt : v.payload {
              payload_type_strs.push(pt.type_str);
              payload_is_pointer.push(dtype_is_pointer(*pt));
            }
            vt.payload_type_strs = payload_type_strs;
            vt.payload_is_pointer = payload_is_pointer;
            variant_templates.push(vt);
          }
          self.generic_enum_names.push(e.name);
          self.generic_enum_type_params.push(e.type_params);
          self.generic_enum_variants.push(variant_templates);
          ret .None;
        }
        bin is_tagged_union = false;
        for v : e.variants {
          if v.has_payload && v.payload.len > 0 {
            is_tagged_union = true;
          }
        }

        Vec<str> variant_names;
        variant_names.init(0);
        for v : e.variants {
          variant_names.push(v.name);
        }

        if is_tagged_union {
          self.emit_tagged_union_enum(e);
        } else {
          self.state.write("typedef enum ");
          self.state.write(e.name);
          self.state.write(" {\n");
          for v : e.variants {
            self.state.write("  ");
            self.state.write(e.name);
            self.state.write("_");
            self.state.write(v.name);
            if v.has_value {
              self.state.write(" = ");
              self.state.write(format_num(v.value));
            }
            self.state.write(",\n");
          }
          self.state.write("} ");
          self.state.write(e.name);
          self.state.write(";\n\n");
        }
        self.record_enum(e.name, variant_names, is_tagged_union);
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Emits a data-carrying (tagged-union) enum with this layout:
  // typedef enum Name_tag { Name_Variant1, Name_Variant2, ... } Name_tag;
  // typedef struct Name {
  // Name_tag tag;
  // union {
  // struct { <type> _0; <type> _1; ... } Variant1;
  // ...
  // } payload;
  // } Name;
  // A payload-less variant occupies a tag slot but no union member.
  // Payload fields are named positionally (`_0`, `_1`, ...), matching
  // `emit_enum_variant_construction`'s own field names.
  emit_tagged_union_enum(EnumDeclNode e) {
    self.state.write("typedef enum ");
    self.state.write(e.name);
    self.state.write("_tag {\n");
    for v : e.variants {
      self.state.write("  ");
      self.state.write(e.name);
      self.state.write("_");
      self.state.write(v.name);
      self.state.write(",\n");
    }
    self.state.write("} ");
    self.state.write(e.name);
    self.state.write("_tag;\n");

    self.state.write("typedef struct ");
    self.state.write(e.name);
    self.state.write(" {\n  ");
    self.state.write(e.name);
    self.state.write("_tag tag;\n  union {\n");
    for v : e.variants {
      if v.has_payload && v.payload.len > 0 {
        self.state.write("    struct { ");
        num i = 0;
        Vec<str> payload_type_names;
        payload_type_names.init(0);
        Vec<bin> payload_is_pointer;
        payload_is_pointer.init(0);
        Vec<DataType> payload_dtypes;
        payload_dtypes.init(0);
        for pt : v.payload {
          let wt = self.write_type(*pt);
          if wt.is_some() {
            payload_type_names.push(wt.unwrap());
          } else {
            payload_type_names.push("");
          }
          let resolved_pt = self.resolve_type_subst(*pt);
          payload_is_pointer.push(dtype_is_pointer(resolved_pt));
          payload_dtypes.push(resolved_pt);
          self.state.write(" _");
          self.state.write(format_num(i));
          self.state.write("; ");
          i = i + 1;
        }
        self.state.write("} ");
        self.state.write(v.name);
        self.state.write(";\n");
        self.record_enum_variant_payload_typed(
          e.name,
          v.name,
          payload_type_names,
          payload_is_pointer,
          payload_dtypes
        );
      }
    }
    self.state.write("  } payload;\n} ");
    self.state.write(e.name);
    self.state.write(";\n\n");
  }

  // Emits a non-generic `compound Name { fields }` as a C struct typedef.
  // A generic compound is only recorded as a template and never emitted
  // directly; only a concrete monomorphization is. Assumes any by-value
  // nested type dependency is already emitted, which
  // `ensure_plain_type_emitted` and `emit_global_variable` handle first.
  // A sized array field (`T[3]`) gets no special treatment here, unlike
  // an unsized one.
  emit_compound(Node node) Option<CodegenErrorKind> {
    if self.is_std_c_signature_node(node) {
      ret .None;
    }
    fit node.kind {
      .Compound(c) -> {
        Vec<str> field_names;
        field_names.init(0);
        Vec<str> field_type_names;
        field_type_names.init(0);
        Vec<bin> field_is_pointer;
        field_is_pointer.init(0);

        if c.has_type_params {
          Vec<DataType*> field_template_dtypes;
          field_template_dtypes.init(0);
          for f : c.fields {
            field_names.push(f.name);
            field_type_names.push(f.dtype.type_str);
            field_is_pointer.push(dtype_is_pointer(*f.dtype) || dtype_is_array_as_pointer(*f.dtype));
            field_template_dtypes.push(f.dtype);
          }
          self.generic_compound_names.push(c.name);
          self.generic_compound_type_params.push(c.type_params);
          self.generic_compound_field_names.push(field_names);
          self.generic_compound_field_type_names.push(field_type_names);
          self.generic_compound_field_is_pointer.push(field_is_pointer);
          self.generic_compound_field_dtypes.push(field_template_dtypes);
          ret .None;
        }

        Vec<DataType> field_dtypes;
        field_dtypes.init(0);
        self.state.write("typedef struct ");
        self.state.write(c.name);
        self.state.write(" {\n");
        for f : c.fields {
          self.state.write("  ");
          let wt = self.write_type(*f.dtype);
          if wt.is_none() {
            ret .Some(.UnsupportedNode);
          }
          bin fld_ptr = dtype_is_pointer(*f.dtype);
          bin fld_arr_ptr = dtype_is_array_as_pointer(*f.dtype);
          if fld_arr_ptr && !fld_ptr {
            self.state.write("*");
          }
          self.state.write(" ");
          self.state.write(f.name);
          // A fixed-size array field (`num[3] data;`) is a real C array,
          // not a decayed pointer: `dtype_is_array_as_pointer` is false
          // exactly when there are bracket sizes to write, and without
          // this the field silently became a bare scalar.
          if f.dtype.is_array && !fld_arr_ptr && f.dtype.array_brackets.len > 0 {
            for bnode : f.dtype.array_brackets {
              self.state.write("[");
              fit bnode.kind {
                .Bracket(inner) -> {
                  let ferr = self.emit_expr(*inner);
                  if ferr.is_some() {
                    ret ferr;
                  }
                }
                _ -> {
                  let ferr = self.emit_expr(*bnode);
                  if ferr.is_some() {
                    ret ferr;
                  }
                }
              }
              self.state.write("]");
            }
          }
          self.state.write(";\n");
          field_names.push(f.name);
          field_type_names.push(wt.unwrap());
          field_is_pointer.push(fld_ptr || fld_arr_ptr);
          field_dtypes.push(self.resolve_type_subst(*f.dtype));
        }
        // MSVC rejects empty structs; a guard-wrapped dummy keeps the
        // struct valid for MSVC while staying invisible on GCC/Clang.
        if field_names.len == 0 {
          self.state.write("#ifdef _MSC_VER\n  char __msvc_dummy;\n#endif\n");
        }
        self.state.write("} ");
        self.state.write(c.name);
        self.state.write(";\n\n");
        self.record_compound_typed(
          c.name,
          field_names,
          field_type_names,
          field_is_pointer,
          field_dtypes
        );
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Emits a top-level `const`/`let` declaration as a C file-scope global.
  // Doesn't reuse the local-`Variable` case's indent and `record_local`
  // bookkeeping, there being no enclosing function scope and no later
  // pass needing a global's inferred type. `pub transpile` runs this pass
  // before impls and functions, so a global used in any body is already
  // declared textually earlier; globals get no forward-declaration pass.
  emit_global_variable(Node node) Option<CodegenErrorKind> {
    if self.is_std_c_signature_node(node) {
      ret .None;
    }
    fit node.kind {
      .Variable(v) -> {
        bin is_let = equals(v.var_type.type_str, "__let_infer__");
        // `pub transpile` emits every global before any plain type's full
        // body, which breaks for a global whose declared type is itself a
        // plain compound or enum. This emits that body first; memoization
        // makes it a no-op for a scalar or an already-emitted type.
        let gt_err = self.ensure_plain_type_emitted(v.var_type.type_str);
        if gt_err.is_some() {
          ret gt_err;
        }
        // An unsized array global (`T[] buf = malloc(...);`) decays to a
        // pointer, as a local does, unless it's initialized with a
        // bracket array literal, which stays a fixed-size global array.
        bin arr_as_ptr = false;
        if !is_let {
          arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
          if arr_as_ptr && v.has_val {
            fit v.val.kind {
              .Bracket(_) -> { arr_as_ptr = false; }
              _ -> {}
            }
          }
        }
        // See the matching fix on the local-variable declaration site:
        // `str` needs the same "pointer for const-placement purposes"
        // treatment `dtype_is_pointer` alone doesn't give it.
        bin const_is_ptr_binding = !is_let &&
          (dtype_is_pointer(*v.var_type) || arr_as_ptr || equals(
          v.var_type.type_str,
          "str"
        ));
        if v.is_const && !const_is_ptr_binding {
          self.state.write("const ");
        }
        if is_let {
          if self.msvc_mode && v.has_val {
            let msvc_gdt_opt = self.infer_let_expr_type(v.val);
            if msvc_gdt_opt.is_some() {
              let msvc_gdt = msvc_gdt_opt.unwrap();
              let msvc_gwt = self.write_type(msvc_gdt);
              if msvc_gwt.is_none() {
                self.state.write("int64_t");
              }
            } else {
              self.state.write("int64_t");
            }
          } else {
            self.state.write("__auto_type");
          }
        } else {
          let wt = self.write_type(*v.var_type);
          if wt.is_none() {
            ret .Some(.UnsupportedNode);
          }
          if arr_as_ptr {
            self.state.write("*");
          }
        }
        if v.is_const && const_is_ptr_binding {
          self.state.write(" const");
        }
        self.state.write(" ");
        self.state.write(v.name);
        // An array declarator (`[24]`, `[]`) lands after the name in C, as
        // for a local. Only an explicitly array-typed global is handled;
        // a bare `let arr = [...]` global gets no literal inference.
        if !is_let && !arr_as_ptr && v.var_type.is_array {
          if v.var_type.array_brackets.len > 0 {
            for bnode : v.var_type.array_brackets {
              self.state.write("[");
              fit bnode.kind {
                .Bracket(inner) -> {
                  let berr = self.emit_expr(*inner);
                  if berr.is_some() {
                    ret berr;
                  }
                }
                _ -> {
                  let berr = self.emit_expr(*bnode);
                  if berr.is_some() {
                    ret berr;
                  }
                }
              }
              self.state.write("]");
            }
          } elif v.var_type.array_depth > 1 {
            self.state.write("[]");
            bin wrote_inner_dims = false;
            if v.has_val {
              fit v.val.kind {
                .Bracket(_) -> {
                  self.emit_multidim_inner_declarators(v.val, v.var_type.array_depth - 1);
                  wrote_inner_dims = true;
                }
                _ -> {}
              }
            }
            if !wrote_inner_dims {
              num mdim_d = 1;
              for mdim_d < v.var_type.array_depth {
                self.state.write("[]");
                mdim_d = mdim_d + 1;
              }
            }
          } else {
            self.state.write("[]");
          }
        }
        if v.has_val {
          self.state.write(" = ");
          // A top-level global's initializer is a declaration context
          // too; see `Codegen.in_array_initializer`.
          let prev_arr_init = self.in_array_initializer;
          self.in_array_initializer = true;
          let verr = self.emit_expr(*v.val);
          self.in_array_initializer = prev_arr_init;
          if verr.is_some() {
            ret verr;
          }
        }
        self.state.write(";\n");
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Pre-registers every plain top-level function's name and parameter
  // types, emitting no C. A whole-program pass run before any body, so a
  // call to a function defined later in source order still resolves. A
  // generic function is instead recorded whole and monomorphized lazily
  // from its call site.
  register_function_signatures(Vec<Node> nodes) {
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          if f.has_type_params {
            self.generic_function_templates.push(n);
          } else {
            Vec<DataType*> param_types;
            param_types.init(0);
            // Each param's default value expression, `nil` when it has
            // none.
            Vec<Node*> default_values;
            default_values.init(0);
            if f.has_args {
              for arg : f.args {
                fit arg.kind {
                  .Variable(v) -> {
                    param_types.push(v.var_type);
                    if v.has_val {
                      default_values.push(v.val);
                    } else {
                      default_values.push(nil);
                    }
                  }
                  _ -> {}
                }
              }
            }
            self.function_names.push(f.name);
            self.function_param_types.push(param_types);
            self.function_default_values.push(default_values);
            // Only a variadic function with a body gets the
            // `__fun_vtags` tag-array call-site treatment. A bodyless
            // variadic binding such as `std.c.io`'s `snprintf` is a real
            // C variadic function expecting ordinary varargs; marking it
            // variadic here would pass a tag-array pointer where `%f`
            // expects a `double`, silently reading garbage.
            self.function_is_variadic.push(f.is_variadic && f.has_body);
            if f.has_rtype {
              self.function_rtypes.push(f.rtype);
            } else {
              self.function_rtypes.push(nil);
            }
          }
        }
        _ -> {}
      }
    }
  }

  // Looks up `fn_name`'s fixed (named, non-`...`) argument count when it
  // is a registered variadic plain function. `.None` means the function
  // isn't registered, or isn't variadic.
  lookup_function_variadic_fixed_len(str fn_name) Option<num> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        if self.function_is_variadic.get(i) {
          ret .Some(self.function_param_types.get(i).len);
        }
        ret .None;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `fn_name`'s declared return type. `.None` means it isn't
  // registered: unknown, a method, or a generic function.
  lookup_function_rtype(str fn_name) Option<DataType*> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        let rt = self.function_rtypes.get(i);
        if rt == nil {
          ret .None;
        }
        ret .Some(rt);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up whether `bare_name`, referenced through `alias`, was renamed
  // at merge time after colliding with a differently-aliased import's
  // same-named function. `.None` means no rename happened, and callers
  // fall back to the bare unqualified name.
  lookup_alias_rename(str alias, str bare_name) Option<str> {
    str key = format("{str}::{str}", alias, bare_name);
    num i = 0;
    for i < self.alias_rename_keys.len {
      if equals(self.alias_rename_keys.get(i), key) {
        ret .Some(self.alias_rename_targets.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Infers a call argument's bare type name, for binding a generic
  // function's type parameter from its call site. Covers a known local, a
  // call to a registered plain function, a literal, and a plain field
  // chain; anything else is rejected rather than guessed.
  infer_arg_type_name(Node* arg) Option<str> {
    fit arg.kind {
      .Identifier(name) -> { ret self.lookup_local_type_name(name); }
      .Number(data) -> {
        fit data {
          .Num(_) -> { ret .Some("num"); }
          .Dec(_) -> { ret .Some("dec"); }
          _ -> { ret .None; }
        }
      }
      .String(_) -> { ret .Some("str"); }
      .Character(_) -> { ret .Some("chr"); }
      .Boolean(_) -> { ret .Some("bin"); }
      .Expression(e) -> {
        // A qualified enum-variant constant (`Job.Quit`) infers `T` as the
        // enum's name. Checked before the `()` call case below, since a
        // qualified access and a call are both `.Expression` nodes.
        if equals(e.op, ".") && e.has_left && e.has_right {
          fit e.left.kind {
            .Identifier(enum_name) -> {
              fit e.right.kind {
                .Identifier(variant_name) -> {
                  if self.enum_has_variant(enum_name, variant_name) {
                    ret .Some(enum_name);
                  }
                }
                _ -> {}
              }
            }
            _ -> {}
          }
          // Not a qualified enum-variant constant: a plain field chain
          // such as `nbox.value` resolves via `resolve_field_chain`.
          let chain = self.resolve_field_chain(arg);
          if chain.is_some() {
            ret .Some(chain.unwrap().type_name);
          }
          ret .None;
        }
        if !equals(e.op, "()") || !e.has_left {
          // A comparison yields `bin`; other binary operators yield
          // whichever operand resolves, so an argument like `n - 1`
          // still infers a type param.
          if equals(e.op, "==") || equals(e.op, "!=") || equals(e.op, "<") ||
            equals(e.op, "<=") || equals(
            e.op,
            ">"
          ) || equals(e.op, ">=") || equals(e.op, "&&") || equals(e.op, "||") {
            ret .Some("bin");
          }
          if e.has_left {
            let left_type = self.infer_arg_type_name(e.left);
            if left_type.is_some() {
              ret left_type;
            }
          }
          if e.has_right {
            ret self.infer_arg_type_name(e.right);
          }
          ret .None;
        }
        fit e.left.kind {
          .Identifier(callee_name) -> {
            let rt = self.lookup_function_rtype(callee_name);
            if rt.is_none() {
              ret .None;
            }
            ret .Some(rt.unwrap().type_str);
          }
          _ -> {
            // Method call (`receiver.method(args)`): resolve via the chain
            // resolver, which handles the dot-then-call shape and returns
            // the method's declared return type.
            let chain = self.resolve_field_chain(arg);
            if chain.is_some() {
              ret .Some(chain.unwrap().type_name);
            }
            ret .None;
          }
        }
      }
      _ -> { ret .None; }
    }
  }

  // Companion to `infer_arg_type_name`, resolving a known local's
  // recorded pointer-ness so type-param inference knows whether the
  // generated param should be `T` or `T*`. `false` for every other shape.
  infer_arg_is_pointer(Node* arg) bin {
    fit arg.kind {
      .Identifier(name) -> {
        let p = self.lookup_local_is_pointer(name);
        if p.is_some() {
          ret p.unwrap();
        }
        ret false;
      }
      .Expression(e) -> {
        if equals(e.op, ".") && e.has_left && e.has_right {
          let chain = self.resolve_field_chain(arg);
          if chain.is_some() {
            ret chain.unwrap().is_pointer;
          }
        }
        ret false;
      }
      _ -> { ret false; }
    }
  }

  // Infers a bare array literal's Fun-level element type name and nesting
  // depth, for `let arr = [1, 2, 3];`, which has no declared type to
  // read. Only the first element at each level is inspected, assuming a
  // rectangular literal, as `emit_multidim_inner_declarators` does on the
  // declaration side. `.None` when the first element's type can't be
  // determined, or the literal is empty.
  infer_array_literal_elem_type_and_depth(Node* lit) Option<ArrayLiteralElemInfo> {
    fit lit.kind {
      .Bracket(inner) -> {
        Vec<Node*> elems;
        elems.init(0);
        self.flatten_call_args(inner, &elems);
        if elems.len == 0 {
          ret .None;
        }
        let first = elems.get(0);
        fit first.kind {
          .Bracket(_) -> {
            let sub = self.infer_array_literal_elem_type_and_depth(first);
            if sub.is_none() {
              ret .None;
            }
            let s = sub.unwrap();
            ArrayLiteralElemInfo r;
            r.type_name = s.type_name;
            r.depth = s.depth + 1;
            ret .Some(r);
          }
          _ -> {
            let tn = self.infer_arg_type_name(first);
            if tn.is_none() {
              ret .None;
            }
            ArrayLiteralElemInfo r;
            r.type_name = tn.unwrap();
            r.depth = 1;
            ret .Some(r);
          }
        }
      }
      _ -> { ret .None; }
    }
  }

  // Companion to `infer_arg_type_name` for nested type-param inference,
  // where a param declared `Pair<L, R> p` matches a type param inside its
  // `generic_args` rather than its bare type. Needs the argument's full
  // structural `DataType`, so it covers a known local and a literal;
  // anything else is unresolvable here.
  infer_arg_dtype(Node* arg) Option<DataType> {
    fit arg.kind {
      .Identifier(name) -> { ret self.lookup_local_dtype(name); }
      .Number(data) -> {
        fit data {
          .Num(_) -> {
            DataType dt = dtype_new();
            dt.type_str = "num";
            ret .Some(dt);
          }
          .Dec(_) -> {
            DataType dt = dtype_new();
            dt.type_str = "dec";
            ret .Some(dt);
          }
          _ -> { ret .None; }
        }
      }
      .String(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "str";
        ret .Some(dt);
      }
      .Character(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "chr";
        ret .Some(dt);
      }
      .Boolean(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "bin";
        ret .Some(dt);
      }
      .Expression(e) -> {
        if equals(e.op, ".") && e.has_left && e.has_right {
          let chain = self.resolve_field_chain(arg);
          if chain.is_some() {
            ret chain.unwrap().dtype;
          }
        }
        ret .None;
      }
      _ -> { ret .None; }
    }
  }

  // Infers a `let NAME = <expr>;` declaration's type for this codegen's
  // bookkeeping, so a later shorthand `fit`, field access, or method call
  // on `NAME` resolves. The C declaration emits `__auto_type` either way,
  // so a failed inference only means `NAME` isn't a known local
  // afterward. Covers the shapes `infer_arg_type_name` does, plus a
  // method call resolved via `resolve_field_chain` and
  // `lookup_impl_method_rtype`.
  infer_let_expr_type(Node* val) Option<DataType> {
    fit val.kind {
      .Identifier(name) -> {
        let t = self.lookup_local_type_name(name);
        let p = self.lookup_local_is_pointer(name);
        if t.is_none() || p.is_none() {
          ret .None;
        }
        DataType dt = dtype_new();
        dt.type_str = t.unwrap();
        if p.unwrap() {
          dt.pointer_depth = 1;
        }
        ret .Some(dt);
      }
      // A bare array literal has no declared type to read. Without this,
      // `arr` would never be recorded as a known local and a later
      // `for x : arr` would reject it as an unrecognized iterable.
      .Bracket(_) -> {
        let info = self.infer_array_literal_elem_type_and_depth(val);
        if info.is_none() {
          ret .None;
        }
        let i = info.unwrap();
        DataType dt = dtype_new();
        dt.type_str = i.type_name;
        dt.is_array = true;
        dt.array_depth = i.depth;
        ret .Some(dt);
      }
      // An explicit compound literal carries its type name directly. A
      // bare `.{...}` shorthand has no `expected_compound_type` to
      // resolve against here, and unlike a bare enum shorthand it has no
      // global-uniqueness fallback: field names aren't a reliable key.
      .CompoundInit(ci) -> {
        if ci.has_dtype {
          // A bare `Box{value = 7}` with no explicit `<T>` needs the same
          // field-value-based generic-arg inference `emit_expr` uses.
          // Otherwise the recorded local type stays the template's bare
          // name and a later `nbox.value` read can't resolve its type.
          DataType effective_dtype = *ci.init_dtype;
          if effective_dtype.generic_args.len == 0 {
            let inferred_gargs = self.infer_generic_compound_init_args(
              effective_dtype.type_str,
              ci.fields
            );
            if inferred_gargs.is_some() {
              effective_dtype.generic_args = inferred_gargs.unwrap();
            }
          }
          ret .Some(effective_dtype);
        }
        ret .None;
      }
      .Number(data) -> {
        DataType dt = dtype_new();
        fit data {
          .Num(_) -> {
            dt.type_str = "num";
            ret .Some(dt);
          }
          .Dec(_) -> {
            dt.type_str = "dec";
            ret .Some(dt);
          }
          _ -> { ret .None; }
        }
      }
      .String(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "str";
        ret .Some(dt);
      }
      .Character(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "chr";
        ret .Some(dt);
      }
      .Boolean(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "bin";
        ret .Some(dt);
      }
      .Expression(e) -> {
        // A plain field-access initializer resolves the whole chain via
        // `resolve_field_chain`, the same resolution a later `ct.pos.line`
        // read needs. Without it `ct` is never a known local and any
        // further field access off it is rejected.
        if equals(e.op, ".") {
          let chain = self.resolve_field_chain(val);
          if chain.is_none() {
            ret .None;
          }
          let r = chain.unwrap();
          // Keeps the structural type, whose generic arguments a later
          // `for x : value` needs.
          if r.dtype.is_some() {
            ret .Some(r.dtype.unwrap());
          }
          DataType dt = dtype_new();
          dt.type_str = r.type_name;
          if r.is_pointer {
            dt.pointer_depth = 1;
          }
          ret .Some(dt);
        }
        // For `let m = f[0];` with a pointer-typed `f`, C's `pointer[0]`
        // is `*pointer`, a value of the pointee's type. Only a
        // bare-identifier receiver resolves here; anything computed falls
        // through to `.None`.
        if equals(e.op, "[]") && e.has_left {
          fit e.left.kind {
            .Identifier(recv_name) -> {
              let t = self.lookup_local_type_name(recv_name);
              let p = self.lookup_local_is_pointer(recv_name);
              if t.is_some() && p.is_some() && p.unwrap() {
                DataType dt = dtype_new();
                dt.type_str = t.unwrap();
                ret .Some(dt);
              }
            }
            _ -> {}
          }
          ret .None;
        }
        if !equals(e.op, "()") || !e.has_left {
          ret .None;
        }
        fit e.left.kind {
          .Identifier(fn_name) -> {
            let rt = self.lookup_function_rtype(fn_name);
            if rt.is_some() {
              ret .Some(*rt.unwrap());
            }
            // A generic function template isn't in the plain registry
            // `lookup_function_rtype` reads, so its substituted return
            // type comes from the same instantiation `emit_call`
            // triggers. Idempotent: instantiation dedups, so a repeat
            // call is a cheap no-op.
            if e.has_right {
              for tmpl : self.generic_function_templates {
                fit tmpl.kind {
                  .Function(f) -> {
                    if !equals(f.name, fn_name) || !f.has_rtype {
                      continue;
                    }
                    Vec<Node*> gargs;
                    gargs.init(0);
                    self.flatten_call_args(e.right, &gargs);
                    let ginst = self.maybe_instantiate_generic_function(
                      fn_name,
                      gargs,
                      e.generic_args
                    );
                    if ginst.is_none() {
                      ret .None;
                    }
                    ret .Some(ginst.unwrap().rtype);
                  }
                  _ -> {}
                }
              }
            }
            ret .None;
          }
          .Expression(recv_e) -> {
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .None;
            }
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(n) -> { method_name = n; }
              _ -> { ret .None; }
            }
            let recv_r_opt = self.resolve_field_chain(recv_e.left);
            if recv_r_opt.is_none() {
              ret .None;
            }
            let recv_r = recv_r_opt.unwrap();
            // A quirk-typed receiver dispatches through the quirk's
            // declared method signature, not `lookup_impl_method_rtype`,
            // which only knows concrete impls' registered methods.
            // `recv_r.type_name` is the mangled concrete identity
            // (`To__MyEnum`), so stripping the quirk's bare-name prefix
            // recovers the concrete argument, which then substitutes for
            // the quirk's type param in the method's return type.
            if self.quirk_names.contains(recv_r.type_name) {
              num qdi2 = 0;
              for qdi2 < self.quirk_decl_names.len {
                let qn = self.quirk_decl_names.get(qdi2);
                StringBuilder qpfx_sb = string_builder_init(16);
                qpfx_sb.append(qn);
                qpfx_sb.append("__");
                str qpfx = qpfx_sb.build();
                if starts_with(recv_r.type_name, qpfx) {
                  str qarg_name = strip_prefix(recv_r.type_name, qpfx);
                  let qmethods = self.quirk_decl_methods.get(qdi2);
                  for qm2 : qmethods {
                    if equals(qm2.name, method_name) {
                      if qm2.rtype == nil {
                        ret .None;
                      }
                      DataType qm_rdt = *qm2.rtype;
                      let q_type_params2 = self.quirk_decl_type_params.get(qdi2);
                      if q_type_params2.len == 1 &&
                        equals(qm_rdt.type_str, q_type_params2.get(0)) &&
                        qm_rdt.generic_args.len == 0 {
                        DataType subst_dt = dtype_new();
                        subst_dt.type_str = qarg_name;
                        ret .Some(subst_dt);
                      }
                      ret .Some(qm_rdt);
                    }
                  }
                }
                qdi2 = qdi2 + 1;
              }
              ret .None;
            }
            let rt = self.lookup_impl_method_rtype(recv_r.type_name, method_name);
            if rt.is_none() {
              ret .None;
            }
            ret .Some(*rt.unwrap());
          }
          _ -> { ret .None; }
        }
      }
      // A single pointer-dereference initializer (`let boxed = *pb;`)
      // resolves `pb`'s chain first, then drops one level of
      // `pointer_depth`, a dereferenced pointer being a plain value.
      .Unary(u) -> {
        if !equals(u.op, "*") || u.is_left_operanded_unary || !u.has_indirection ||
          u.indirection_depth != 1 {
          ret .None;
        }
        let recv_r_opt = self.resolve_field_chain(u.operand);
        if recv_r_opt.is_none() {
          ret .None;
        }
        let recv_r = recv_r_opt.unwrap();
        if !recv_r.is_pointer {
          ret .None;
        }
        if recv_r.dtype.is_some() {
          DataType dd = recv_r.dtype.unwrap();
          if dd.pointer_depth > 0 {
            dd.pointer_depth = dd.pointer_depth - 1;
          }
          // `dtype_is_pointer` also honors `flags.is_pointer`
          // independently of `pointer_depth`, so clearing it too is what
          // keeps the deref from still reading as a pointer.
          dd.flags.is_pointer = false;
          ret .Some(dd);
        }
        DataType dt = dtype_new();
        dt.type_str = recv_r.type_name;
        ret .Some(dt);
      }
      _ -> { ret .None; }
    }
  }

  // Falls back to contextual inference for a generic function's type
  // param `tp` when the call's arguments don't reveal it, as with a bare
  // shorthand argument. Matches `f`'s declared return type structurally
  // against the enclosing function's concrete return type, finds where
  // `tp` appears bare, and reads the enclosing return type at that
  // position. `.None` with no enclosing context, on a shape mismatch, or
  // when `tp` never appears bare.
  infer_generic_function_type_param_from_context(FunctionNode f, str tp) Option<str> {
    if !f.has_rtype || self.current_fn_rtype_dt.is_none() {
      ret .None;
    }
    let caller_rtype = self.current_fn_rtype_dt.unwrap();
    if !equals(f.rtype.type_str, caller_rtype.type_str) ||
      f.rtype.generic_args.len != caller_rtype.generic_args.len {
      ret .None;
    }
    num pi = 0;
    for pi < f.rtype.generic_args.len {
      let templ_arg = f.rtype.generic_args.get(pi);
      if equals(templ_arg.type_str, tp) && templ_arg.generic_args.len == 0 {
        let caller_arg = caller_rtype.generic_args.get(pi);
        ret self.resolve_type_name(*caller_arg);
      }
      pi = pi + 1;
    }
    ret .None;
  }

  // Monomorphizes a call to a registered generic function template,
  // inferring each type param's binding from whichever positional
  // argument's declared param type is a bare occurrence of it, then
  // emitting the body under a mangled `<name>__<arg1>__<arg2>...` and
  // returning that name for `emit_call` to use as the C callee. Every
  // inferred binding is a bare value type, with no pointer-arg mangling.
  // `.None` when `fn_name` isn't a template, or a type param's binding
  // can't be inferred from this call's arguments.
  maybe_instantiate_generic_function(
    str fn_name,
    Vec<Node*> args,
    Vec<DataType*> explicit_generic_args
  ) Option<GenericCallResolution> {
    for tmpl : self.generic_function_templates {
      fit tmpl.kind {
        .Function(f) -> {
          if equals(f.name, fn_name) {
            Vec<str> arg_type_names;
            arg_type_names.init(0);
            Vec<bin> arg_is_pointer;
            arg_is_pointer.init(0);
            // Parallel to `arg_type_names`, the full structural type
            // behind each inferred binding, so a nested call inside this
            // function's own body (another generic function or a
            // generic impl method, referencing this same type param by
            // name) substitutes against THIS call's argument and not
            // whatever substitution context happens to still be active
            // from an enclosing generic impl method. See
            // `resolve_type_subst`'s own preference for this over the
            // flat name below.
            Vec<DataType*> arg_dtypes;
            arg_dtypes.init(0);
            num tp_idx = 0;
            for tp : f.type_params {
              bin found = false;
              str found_name = "";
              bin found_is_pointer = false;
              Option<DataType> found_dtype = .None;
              num ai = 0;
              for parg : f.args {
                fit parg.kind {
                  .Variable(v) -> {
                    if equals(v.var_type.type_str, tp) && v.var_type.generic_args.len == 0 &&
                      ai < args.len {
                      let arg_node = args.get(ai);
                      let inferred = self.infer_arg_type_name(arg_node);
                      if inferred.is_some() {
                        found_name = inferred.unwrap();
                        // A pointer argument needs the generated param
                        // to be a pointer too, but `infer_arg_type_name`
                        // returns only the bare name. Captured here at
                        // the matching position, since `ai` is stale once
                        // the loop ends, having passed every param.
                        found_is_pointer = self.infer_arg_is_pointer(arg_node);
                        found_dtype = self.infer_arg_dtype(arg_node);
                        found = true;
                      }
                    }
                  }
                  _ -> {}
                }
                ai = ai + 1;
              }
              // Falls back to a nested match when no param is a bare
              // occurrence of `tp`: a param declared `Pair<L, R> p` never
              // matches the loop above, but `tp` appears bare one level
              // down inside the param's `generic_args`. Its position
              // there is read out of the argument's structural
              // `DataType`. Only one level of nesting is matched, and an
              // argument with no recorded generic args can't resolve.
              if !found {
                num ai3 = 0;
                for parg3 : f.args {
                  fit parg3.kind {
                    .Variable(v3) -> {
                      if v3.var_type.generic_args.len > 0 && ai3 < args.len {
                        num gi = 0;
                        for garg : v3.var_type.generic_args {
                          if !found && equals(garg.type_str, tp) &&
                            garg.generic_args.len == 0 {
                            let arg_dt3 = self.infer_arg_dtype(args.get(ai3));
                            if arg_dt3.is_some() {
                              let adt3 = arg_dt3.unwrap();
                              if gi < adt3.generic_args.len {
                                let nested = adt3.generic_args.get(gi);
                                let nested_name = self.resolve_type_name(*nested);
                                if nested_name.is_some() {
                                  found_name = nested_name.unwrap();
                                  found_dtype = .Some(*nested);
                                  found = true;
                                }
                              }
                            }
                          }
                          gi = gi + 1;
                        }
                      }
                    }
                    _ -> {}
                  }
                  ai3 = ai3 + 1;
                }
              }
              if !found {
                let ctx_inferred = self.infer_generic_function_type_param_from_context(f, tp);
                if ctx_inferred.is_some() {
                  found_name = ctx_inferred.unwrap();
                  found = true;
                }
              }
              // Explicit type arguments at the call site (`ok<num,
              // Error>(42)`), matched to this type param by position.
              // Tried last, only for a param nothing else could pin down
              // (the exact case the syntax exists for: a type that
              // appears only in the return type, never in an argument).
              if !found && tp_idx < explicit_generic_args.len {
                DataType* explicit_dt = explicit_generic_args.get(tp_idx);
                let explicit_name = self.resolve_type_name(*explicit_dt);
                if explicit_name.is_some() {
                  found_name = explicit_name.unwrap();
                  found_dtype = .Some(*explicit_dt);
                  found = true;
                }
              }
              if !found {
                ret .None;
              }
              arg_type_names.push(found_name);
              arg_is_pointer.push(found_is_pointer);
              DataType* dtp = malloc(sizeof(DataType));
              if found_dtype.is_some() {
                *dtp = found_dtype.unwrap();
              } else {
                *dtp = dtype_new();
                dtp.type_str = found_name;
              }
              arg_dtypes.push(dtp);
              tp_idx = tp_idx + 1;
            }

            StringBuilder nb = string_builder_init(16);
            nb.append(fn_name);
            for an : arg_type_names {
              nb.append("__");
              nb.append(an);
            }
            str mangled_name = nb.build();

            // The substitution context is set up before the dedup check
            // below, so substituted param types are computed on either
            // path: a repeat call re-uses the already-monomorphized
            // instance without re-emitting, but still needs its params
            // resolved fresh for this call site.
            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            let prev_arg_dtypes = self.type_subst_arg_dtypes;
            self.type_subst_param_names = f.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_is_pointer = arg_is_pointer;
            self.type_subst_arg_dtypes = arg_dtypes;

            Vec<DataType> param_types;
            param_types.init(0);
            for parg : f.args {
              fit parg.kind {
                .Variable(v) -> {
                  param_types.push(self.resolve_type_subst(*v.var_type));
                }
                _ -> {}
              }
            }

            num ei = 0;
            bin already_emitted = false;
            for ei < self.emitted_generic_instantiations.len {
              if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
                already_emitted = true;
              }
              ei = ei + 1;
            }

            if !already_emitted {
              self.emitted_generic_instantiations.push(mangled_name);

              // `hoist_insert_pos` is suspended for the swap, so a nested
              // instantiation appends inline to `scratch` instead of
              // splicing at a stale position into the wrong buffer;
              // `emit_hoisted` below still lands `scratch` at the right
              // outer position. This can run nested inside another
              // function's in-progress emission, so the local-name and
              // return-type state is saved and restored too.
              CodegenState scratch = codegen_state_new();
              CodegenState* saved_state = self.state;
              let saved_hoist_pos = self.hoist_insert_pos;
              let saved_local_names = self.local_names;
              let saved_local_is_pointer = self.local_is_pointer;
              let saved_local_type_name = self.local_type_name;
              let saved_local_dtype = self.local_dtype;
              let saved_fn_rtype_name = self.current_fn_rtype_name;
              let saved_fn_rtype_dt = self.current_fn_rtype_dt;
              let saved_defer_stack = self.defer_stack;
              let saved_defer_scope_starts = self.defer_scope_starts;
              // `current_stmt_start_pos` needs the same suspend and
              // restore as `hoist_insert_pos`, since `emit_function_named`
              // recurses into `emit_statements` and overwrites it with a
              // position measured against this scratch buffer.
              let saved_stmt_start_pos = self.current_stmt_start_pos;
              // Also suspended: otherwise a generic impl method first
              // reached from inside this body would drain immediately,
              // and with both positions suspended its splice would append
              // at `self.state`'s tail, nesting a full method definition
              // inside this function's braces. Entries are only enqueued
              // while suppressed, and drained explicitly below once the
              // real buffer and position are restored.
              let prev_suppress2 = self.suppress_generic_impl_method_draining;
              // Shares `hoist_scratch_depth` with
              // `emit_one_generic_impl_method`, since this body can be
              // reached from inside another generic impl method's first
              // instantiation.
              if self.hoist_scratch_depth == 0 {
                self.root_state = self.state;
                self.root_hoist_pos = self.hoist_insert_pos;
                self.root_stmt_start_pos = self.current_stmt_start_pos;
              }
              self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
              self.state = &scratch;
              self.hoist_insert_pos = .None;
              self.current_stmt_start_pos = .None;
              self.suppress_generic_impl_method_draining = true;
              self.emit_function_named(tmpl, mangled_name);
              self.state = saved_state;
              self.hoist_insert_pos = saved_hoist_pos;
              self.current_stmt_start_pos = saved_stmt_start_pos;
              self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
              if self.hoist_scratch_depth == 0 {
                self.hoist_insert_pos = self.root_hoist_pos;
                self.current_stmt_start_pos = self.root_stmt_start_pos;
              }
              self.suppress_generic_impl_method_draining = prev_suppress2;
              self.local_names = saved_local_names;
              self.local_is_pointer = saved_local_is_pointer;
              self.local_type_name = saved_local_type_name;
              self.local_dtype = saved_local_dtype;
              self.current_fn_rtype_name = saved_fn_rtype_name;
              self.current_fn_rtype_dt = saved_fn_rtype_dt;
              self.defer_stack = saved_defer_stack;
              self.defer_scope_starts = saved_defer_scope_starts;
              self.emit_hoisted(scratch.out.build());
              if !prev_suppress2 && !self.draining_generic_impl_methods {
                // A method enqueued from inside the just-spliced
                // `scratch` needs its inline prototype before that text,
                // not at `self.hoist_insert_pos`, which has advanced past
                // `scratch` and would land the prototype too late for a
                // call inside it. `saved_hoist_pos`, captured before the
                // splice, is the right target for this drain only; the
                // body splice still uses `self.hoist_insert_pos`, landing
                // after `scratch` where a definition belongs.
                let saved_stmt_start_pos_for_drain = self.current_stmt_start_pos;
                self.current_stmt_start_pos = saved_hoist_pos;
                self.drain_pending_generic_impl_methods();
                self.current_stmt_start_pos = saved_stmt_start_pos_for_drain;
              }
            }

            // Computed before the substitution context is torn down
            // below. `f.rtype` is optional for a `void`-returning generic
            // function and stays a placeholder when absent, no caller
            // reading `rtype` without checking `f.has_rtype` first.
            DataType resolved_rtype = dtype_new();
            if f.has_rtype {
              resolved_rtype = self.resolve_type_subst(*f.rtype);
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
            self.type_subst_arg_dtypes = prev_arg_dtypes;

            GenericCallResolution res;
            res.mangled_name = mangled_name;
            res.param_types = param_types;
            res.rtype = resolved_rtype;
            ret .Some(res);
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Looks up the declared type of `fn_name`'s parameter at `arg_index`.
  // Falls back to a generic template's declared param type at that
  // position when `fn_name` isn't in the plain registry, a
  // non-generic-position param type already being concrete. `.None` means
  // `fn_name` isn't registered, or `arg_index` is out of range.
  lookup_function_param_type(str fn_name, num arg_index) Option<DataType*> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        let params = self.function_param_types.get(i);
        if arg_index < 0 || arg_index >= params.len {
          ret .None;
        }
        ret .Some(params.get(arg_index));
      }
      i = i + 1;
    }
    for tmpl : self.generic_function_templates {
      fit tmpl.kind {
        .Function(f) -> {
          if equals(f.name, fn_name) {
            if arg_index < 0 || !f.has_args || arg_index >= f.args.len {
              ret .None;
            }
            let param_node = f.args.get(arg_index);
            fit param_node.kind {
              .Variable(v) -> { ret .Some(v.var_type); }
              _ -> { ret .None; }
            }
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Looks up `fn_name`'s trailing default-parameter value expressions.
  // `.None` means `fn_name` isn't registered as a plain function.
  // The default value expressions a generic function's template
  // declares. A generic is recorded whole and monomorphized from its
  // call site, so its defaults are read from the template rather than
  // from the plain-function registry, which never sees it.
  lookup_generic_default_values(str fn_name) Option<Vec<Node*>> {
    for tmpl : self.generic_function_templates {
      fit tmpl.kind {
        .Function(f) -> {
          if !equals(f.name, fn_name) {
            continue;
          }
          Vec<Node*> defaults;
          defaults.init(f.args.len);
          bin any = false;
          for arg : f.args {
            fit arg.kind {
              .Variable(v) -> {
                if v.has_val {
                  defaults.push(v.val);
                  any = true;
                } else {
                  defaults.push(nil);
                }
              }
              _ -> { defaults.push(nil); }
            }
          }
          if !any {
            defaults.free();
            ret .None;
          }
          ret .Some(defaults);
        }
        _ -> {}
      }
    }
    ret .None;
  }

  lookup_function_default_values(str fn_name) Option<Vec<Node*>> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        ret .Some(self.function_default_values.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `fn_name`'s full param list, so
  // `emit_default_trailing_args` can resolve a default value that is
  // itself a bare enum shorthand against that param's declared type.
  // `.None` means `fn_name` isn't registered as a plain function.
  lookup_function_param_types(str fn_name) Option<Vec<DataType*>> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        ret .Some(self.function_param_types.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Pre-registers every method of a plain or quirk-implementing
  // (non-generic) impl block under its bare and mangled call-site names,
  // emitting no C. A whole-program pass run before any impl method body,
  // so a method calling another type's method already has that type's row
  // recorded regardless of source order. The bare name comes from
  // stripping the known prefix (`Type__`, or `Type__Quirk__`) off each
  // method's pre-mangled `Function` node name. A generic impl is instead
  // recorded whole and monomorphized lazily on first concrete use.
  register_impl_methods(Node node) {
    fit node.kind {
      .Impl(i) -> {
        if i.has_type_params {
          self.generic_impl_templates.push(node);
          ret;
        }
        StringBuilder pfx = string_builder_init(16);
        pfx.append(i.type_name);
        pfx.append("__");
        if i.has_quirk_name {
          pfx.append(i.quirk_name);
          pfx.append("__");
        }
        str prefix = pfx.build();
        for m : i.methods {
          str mangled_name = "";
          DataType* rtype = nil;
          Vec<DataType*> param_types;
          param_types.init(0);
          // Each param's default value expression, `nil` when it has
          // none.
          Vec<Node*> default_values;
          default_values.init(0);
          fit m.kind {
            .Function(fnv) -> {
              mangled_name = fnv.name;
              if fnv.has_rtype {
                rtype = fnv.rtype;
              }
              if fnv.has_args {
                bin skipped_self = false;
                for arg : fnv.args {
                  if !skipped_self {
                    skipped_self = true;
                    continue;
                  }
                  fit arg.kind {
                    .Variable(v) -> {
                      param_types.push(v.var_type);
                      if v.has_val {
                        default_values.push(v.val);
                      } else {
                        default_values.push(nil);
                      }
                    }
                    _ -> {}
                  }
                }
              }
            }
            _ -> {}
          }
          let bare_name = strip_prefix(mangled_name, prefix);
          self.record_impl_method(
            i.type_name,
            bare_name,
            mangled_name,
            rtype,
            param_types,
            default_values
          );
        }
      }
      _ -> {}
    }
  }

  // Emits every method of a plain or quirk-implementing (non-generic)
  // `impl Type { methods }` block as an ordinary top-level C function.
  // Each method is already parsed as a `Function` node pre-mangled to
  // `Type__method` (or `Type__Quirk__method`) with `<Type>* self` as its
  // first arg, so it emits like any other function, with no
  // self-injection or mangling here. Assumes `register_impl_methods`
  // already ran for every impl. Dynamic dispatch through an abstract
  // quirk-typed value is handled by `emit_quirk_vtable_machinery`, called
  // right after these concrete bodies; a static call through a concrete
  // receiver resolves entirely in `emit_method_call`. A generic impl is
  // skipped, as in `emit_compound`.
  emit_impl(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Impl(i) -> {
        if i.has_type_params {
          ret .None;
        }
        for m : i.methods {
          // A method declaring its own type params is emitted per call
          // site by `maybe_instantiate_generic_impl_method_own_params`;
          // emitting the template here too would leave its unsubstituted
          // param names in the output as literal C type names.
          bin own_params = false;
          fit m.kind {
            .Function(mf) -> { own_params = mf.has_type_params; }
            _ -> {}
          }
          if own_params {
            continue;
          }
          let merr = self.emit_function(*m);
          if merr.is_some() {
            ret merr;
          }
        }
        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Emits the C machinery backing dynamic dispatch through an abstract
  // quirk-typed value (`Shape s = &rect; s.area();`) for one concrete,
  // non-generic quirk-implementing impl. A no-op for a plain or generic
  // impl. One vtable struct is emitted per quirk name (`Shape_vtable`)
  // rather than a signature-hash struct shared across identically-shaped
  // quirks, which would be a size optimization only.
  // 
  // Three pieces, in order:
  // 1. The first time this quirk name is seen: the vtable struct, one
  // function-pointer field per method each taking `void* self` first, and
  // the fat-pointer wrapper struct `Shape` resolves to as a C type,
  // derived from this impl's signatures. Every other impl of the quirk
  // must structurally match; there is no typechecker to verify it.
  // 2. Always: a `void* self`-taking wrapper trampoline per method,
  // casting back to `Type*` and calling `Type__Quirk__method`, plus a
  // `static const` vtable instance populated with those wrappers.
  // 3. Always: the `__fun_coerce_Type_Quirk` helper building a `Shape`
  // value from a `Type*`, called from a `Shape s = &rect;` initializer.
  emit_quirk_vtable_machinery(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Impl(i) -> {
        // A generic quirk impl (`impl Vec<T> as Sized { ... }`) has no
        // single monomorphic vtable signature: an unbound `T` in a method
        // signature can't be expressed as one C function pointer. The
        // exception is a call arriving through `quirk_inst_override_name`,
        // where the caller has already bound `T` to one concrete
        // instantiation and set up substitution context accordingly.
        if !i.has_quirk_name ||
          (i.has_type_params && equals(self.quirk_inst_override_name, "")) {
          ret .None;
        }
        str quirk_name = i.quirk_name;
        // The template's own bare name, used to strip each method's
        // pre-mangled template name (`Box__Lenable__wrap`) down to its
        // bare method name regardless of instantiation.
        str bare_type_name = i.type_name;
        str type_name = i.type_name;
        if !equals(self.quirk_inst_override_name, "") {
          type_name = self.quirk_inst_override_name;
        }
        // A no-op when this impl's machinery already ran, such as when
        // `ensure_plain_type_emitted`'s field-dependency check triggered
        // it early, so the later per-impl pass doesn't re-emit.
        StringBuilder eqiv_key_sb = string_builder_init(16);
        eqiv_key_sb.append(type_name);
        eqiv_key_sb.append("::");
        eqiv_key_sb.append(quirk_name);
        str eqiv_key = eqiv_key_sb.build();
        if self.emitted_quirk_impl_vtables.contains(eqiv_key) {
          ret .None;
        }
        self.emitted_quirk_impl_vtables.push(eqiv_key);
        // The vtable and fat-pointer type's identity. A concrete
        // instantiation of a generic quirk (`impl Config as
        // To<JsonValue>`) is distinct from `To<str>` and needs its own
        // mangled name, which `i.quirk_concrete_instantiation` carries.
        // Method-name mangling below stays keyed on the bare quirk name,
        // `fnv.name` already being pre-mangled that way by the parser.
        str quirk_type_identity = quirk_name;
        if i.has_quirk_concrete_instantiation {
          quirk_type_identity = i.quirk_concrete_instantiation;
        }

        StringBuilder pfx = string_builder_init(16);
        pfx.append(bare_type_name);
        pfx.append("__");
        pfx.append(quirk_name);
        pfx.append("__");
        str prefix = pfx.build();

        if !self.quirk_names.contains(quirk_type_identity) {
          // Forward-declared ahead of the vtable struct: a method can
          // return the very quirk it belongs to (`self_ref() Chain` on
          // `impl X as Chain`), and the vtable's function-pointer field
          // for it needs the name in scope before the quirk's own fat
          // pointer struct is completed below. Harmless when nothing
          // actually self-refers.
          self.state.write("typedef struct ");
          self.state.write(quirk_type_identity);
          self.state.write(" ");
          self.state.write(quirk_type_identity);
          self.state.write(";\n");
          self.state.write("typedef struct ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable;\n");
          self.state.write("struct ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable {\n");
          bin vtable_has_methods = false;
          for m : i.methods {
            fit m.kind {
              .Function(fnv) -> {
                vtable_has_methods = true;
                self.state.write("  ");
                if fnv.has_rtype {
                  let wt = self.write_type(*fnv.rtype);
                  if wt.is_none() {
                    ret .Some(.UnsupportedNode);
                  }
                } else {
                  self.state.write("void");
                }
                let base = strip_prefix(fnv.name, prefix);
                self.state.write(" (*");
                self.state.write(base);
                self.state.write(")(void* self");
                if fnv.has_args {
                  bin skipped_self = false;
                  for arg : fnv.args {
                    if !skipped_self {
                      skipped_self = true;
                      continue;
                    }
                    fit arg.kind {
                      .Variable(v) -> {
                        self.state.write(", ");
                        let pwt = self.write_type(*v.var_type);
                        if pwt.is_none() {
                          ret .Some(.UnsupportedNode);
                        }
                      }
                      _ -> {}
                    }
                  }
                }
                self.state.write(");\n");
              }
              _ -> {}
            }
          }
          if self.msvc_mode && !vtable_has_methods {
            self.state.write("  int __fun_dummy;\n");
          }
          self.state.write("};\n");
          self.state.write("typedef struct ");
          self.state.write(quirk_type_identity);
          self.state.write(" { void* self; const ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable* vtable; } ");
          self.state.write(quirk_type_identity);
          self.state.write(";\n\n");
          self.quirk_names.push(quirk_type_identity);
        }

        StringBuilder vsb = string_builder_init(24);
        vsb.append("__fun_impl_");
        vsb.append(type_name);
        vsb.append("_");
        vsb.append(quirk_type_identity);
        vsb.append("_vtable");
        str vtbl_instance_name = vsb.build();

        for m : i.methods {
          fit m.kind {
            .Function(fnv) -> {
              let base = strip_prefix(fnv.name, prefix);
              // Equal to `fnv.name` itself for a plain impl (`prefix +
              // base` reconstructs exactly what was stripped off it);
              // rebuilt explicitly so a generic instantiation's mangled
              // method name (`Box__num__Lenable__wrap`, never literally
              // written on the template's own `fnv.name`) resolves the
              // same way.
              StringBuilder rfnb = string_builder_init(32);
              rfnb.append(type_name);
              rfnb.append("__");
              rfnb.append(quirk_name);
              rfnb.append("__");
              rfnb.append(base);
              str real_fn_name = rfnb.build();
              StringBuilder wsb = string_builder_init(32);
              wsb.append("__fun_wrap_");
              wsb.append(type_name);
              wsb.append("_");
              wsb.append(quirk_type_identity);
              wsb.append("_");
              wsb.append(base);
              str wrap_name = wsb.build();

              // The wrapper below calls straight through to the plain
              // method it wraps, which this vtable machinery now runs
              // ahead of: a forward prototype is what lets the wrapper
              // reference it before `emit_impl` defines it. Only types
              // are written, which is all a C prototype needs and avoids
              // registering `self`/the other parameters as locals the
              // way emitting them for a real body would.
              if fnv.has_rtype {
                let pwt = self.write_type(*fnv.rtype);
                if pwt.is_none() {
                  ret .Some(.UnsupportedNode);
                }
              } else {
                self.state.write("void");
              }
              self.state.write(" ");
              self.state.write(real_fn_name);
              self.state.write("(");
              if fnv.has_args {
                bin proto_first = true;
                for parg : fnv.args {
                  fit parg.kind {
                    .Variable(pv) -> {
                      if !proto_first {
                        self.state.write(", ");
                      }
                      proto_first = false;
                      let ppt = self.write_type(*pv.var_type);
                      if ppt.is_none() {
                        ret .Some(.UnsupportedNode);
                      }
                    }
                    _ -> {}
                  }
                }
              }
              self.state.write(");\n");

              self.state.write("static ");
              if fnv.has_rtype {
                let wt2 = self.write_type(*fnv.rtype);
                if wt2.is_none() {
                  ret .Some(.UnsupportedNode);
                }
              } else {
                self.state.write("void");
              }
              self.state.write(" ");
              self.state.write(wrap_name);
              self.state.write("(void* self");
              Vec<str> arg_names;
              arg_names.init(0);
              if fnv.has_args {
                bin skipped_self2 = false;
                num arg_i = 0;
                for arg : fnv.args {
                  if !skipped_self2 {
                    skipped_self2 = true;
                    continue;
                  }
                  fit arg.kind {
                    .Variable(v) -> {
                      self.state.write(", ");
                      let pwt2 = self.write_type(*v.var_type);
                      if pwt2.is_none() {
                        ret .Some(.UnsupportedNode);
                      }
                      StringBuilder an_sb = string_builder_init(8);
                      an_sb.append(" __fun_a");
                      an_sb.append(format_num(arg_i));
                      str an = an_sb.build();
                      self.state.write(an);
                      arg_names.push(an);
                      arg_i = arg_i + 1;
                    }
                    _ -> {}
                  }
                }
              }
              self.state.write(") {\n  ");
              if fnv.has_rtype {
                self.state.write("return ");
              }
              self.state.write(real_fn_name);
              self.state.write("((");
              self.state.write(type_name);
              self.state.write("*)self");
              for an2 : arg_names {
                self.state.write(",");
                self.state.write(an2);
              }
              self.state.write(");\n}\n\n");
            }
            _ -> {}
          }
        }

        self.state.write("static const ");
        self.state.write(quirk_type_identity);
        self.state.write("_vtable ");
        self.state.write(vtbl_instance_name);
        self.state.write(" = {\n");
        for m : i.methods {
          fit m.kind {
            .Function(fnv) -> {
              let base2 = strip_prefix(fnv.name, prefix);
              StringBuilder wsb2 = string_builder_init(32);
              wsb2.append("__fun_wrap_");
              wsb2.append(type_name);
              wsb2.append("_");
              wsb2.append(quirk_type_identity);
              wsb2.append("_");
              wsb2.append(base2);
              self.state.write("  .");
              self.state.write(base2);
              self.state.write(" = ");
              self.state.write(wsb2.build());
              self.state.write(",\n");
            }
            _ -> {}
          }
        }
        self.state.write("};\n\n");

        self.state.write("static inline ");
        self.state.write(quirk_type_identity);
        self.state.write(" __fun_coerce_");
        self.state.write(type_name);
        self.state.write("_");
        self.state.write(quirk_type_identity);
        self.state.write("(");
        self.state.write(type_name);
        self.state.write("* self) { return (");
        self.state.write(quirk_type_identity);
        self.state.write("){ .self = self, .vtable = &");
        self.state.write(vtbl_instance_name);
        self.state.write(" }; }\n\n");

        ret .None;
      }
      _ -> { ret .Some(.InvalidNode); }
    }
  }

  // Writes the fixed set of C headers this codegen always includes, plus
  // the `stderr_stream()` helper `emit_expr`'s `.Panic` case calls. Every
  // header is unconditional rather than gated on an actual import: import
  // nodes never survive flattening, so there is no way to see which
  // `std.c.*` modules a program used, and an unused header is harmless.
  pub write_prelude() {
    self.state.write(`#include <stdio.h>
    `#include <stdbool.h>
    `#include <stdint.h>
    `#include <stdarg.h>
    `#include <stdlib.h>
    `#include <string.h>
    `#include <ctype.h>
    `#include <limits.h>
    ``);
    // `<math.h>` declares names a program may define itself (`log`), so
    // it is emitted only when the math bindings are actually imported.
    if program_uses_std_c_header(self.all_nodes, "math.fn") {
      self.state.write("#include <math.h>\n");
    }
    // `time_t`/`time()` happen to be visible transitively today through
    // another always-included header on some platforms, but that's not
    // guaranteed everywhere a C compiler runs; included explicitly
    // whenever `std.c.time` bindings are actually imported, matching the
    // same pattern as `<math.h>` above.
    if program_uses_std_c_header(self.all_nodes, "time.fn") {
      self.state.write("#include <time.h>\n");
    }
    // These headers exist only on POSIX, so a program that never
    // spawns stays portable without them.
    // A failing assertion returns to the runner, which needs a jump
    // target per thread.
    if self.test_mode {
      self.state.write("#include <setjmp.h>\n");
      self.state.write("static _Thread_local jmp_buf __fun_test_jmp;\n");
      // Windows defaults to a 1 MB thread stack, which the parser's recursive
      // descent exhausts before its own depth guard fires on deeply-nested
      // expressions.  Request 8 MB to match the Linux/macOS default so the
      // guard, not the OS, rejects pathological input.
      self.state.write("#ifdef _WIN32\n#pragma comment(linker, \"/STACK:8388608\")\n#endif\n");
    }
    // Spawning has no counterpart on Windows, so the bindings are backed
    // there by a compatibility layer over the platform's own process API.
    if program_uses_std_c_header(self.all_nodes, "process.fn") {
      self.state.write(`
      `#if defined(_WIN32)
      `#ifndef WIN32_LEAN_AND_MEAN
      `#define WIN32_LEAN_AND_MEAN
      `#endif
      `#pragma push_macro("close")
      `#undef close
      `#include <windows.h>
      `#include <io.h>
      `#include <fcntl.h>
      `#include <process.h>
      `#pragma pop_macro("close")
      `
      `#include <sys/types.h>
      `#ifndef _PID_T_
      `#define _PID_T_
      `typedef int pid_t;
      `#endif
      `typedef void* posix_spawnattr_t;
      `typedef struct {
      `    int has_dup2_1; int dup2_1_fd;
      `    int has_dup2_2; int dup2_2_fd;
      `} posix_spawn_file_actions_t;
      `
      `long long posix_spawn_file_actions_init(posix_spawn_file_actions_t* fa) {
      `    if (fa == NULL) return -1;
      `    fa->has_dup2_1 = 0;
      `    fa->has_dup2_2 = 0;
      `    return 0;
      `}
      `
      `long long posix_spawn_file_actions_destroy(posix_spawn_file_actions_t* fa) {
      `    (void)fa;
      `    return 0;
      `}
      `
      `long long posix_spawn_file_actions_adddup2(posix_spawn_file_actions_t* fa, long long fildes, long long newfildes) {
      `    if (fa == NULL) return -1;
      `    if (newfildes == 1) { fa->has_dup2_1 = 1; fa->dup2_1_fd = (int)fildes; return 0; }
      `    if (newfildes == 2) { fa->has_dup2_2 = 1; fa->dup2_2_fd = (int)fildes; return 0; }
      `    return -1;
      `}
      `
      `long long posix_spawn_file_actions_addclose(posix_spawn_file_actions_t* fa, long long fildes) {
      `    (void)fa; (void)fildes;
      `    return 0;
      `}
      `
      `static char* __fun_win_build_cmdline(char** argv) {
      `    size_t cap = 256, len = 0;
      `    char* out = (char*)malloc(cap);
      `    if (out == NULL) return NULL;
      `    for (int i = 0; argv[i] != NULL; i++) {
      `        const char* a = argv[i];
      `        size_t alen = strlen(a);
      `        int needs_quotes = (alen == 0);
      `        for (size_t j = 0; j < alen && !needs_quotes; j++) {
      `            if (a[j] == ' ' || a[j] == '\t' || a[j] == '"') needs_quotes = 1;
      `        }
      `        size_t need = alen * 2 + 3;
      `        while (len + need + 2 > cap) {
      `            cap *= 2;
      `            char* n = (char*)realloc(out, cap);
      `            if (n == NULL) { free(out); return NULL; }
      `            out = n;
      `        }
      `        if (i > 0) out[len++] = ' ';
      `        if (needs_quotes) out[len++] = '"';
      `        size_t backslashes = 0;
      `        for (size_t j = 0; j < alen; j++) {
      `            char c = a[j];
      `            if (c == '\\') { backslashes++; out[len++] = c; continue; }
      `            if (c == '"') {
      `                for (size_t k = 0; k <= backslashes; k++) out[len++] = '\\';
      `                out[len++] = '"';
      `                backslashes = 0;
      `                continue;
      `            }
      `            backslashes = 0;
      `            out[len++] = c;
      `        }
      `        if (needs_quotes) {
      `            for (size_t k = 0; k < backslashes; k++) out[len++] = '\\';
      `            out[len++] = '"';
      `        }
      `    }
      `    out[len] = '\0';
      `    return out;
      `}
      `
      `long long posix_spawnp(pid_t* pid, const char* file, posix_spawn_file_actions_t* file_actions, posix_spawnattr_t* attrp, char** argv, char** envp) {
      `    (void)file; (void)attrp; (void)envp;
      `    if (pid == NULL || argv == NULL) return -1;
      `
      `    STARTUPINFOA si;
      `    PROCESS_INFORMATION pi;
      `    memset(&si, 0, sizeof(si));
      `    memset(&pi, 0, sizeof(pi));
      `    si.cb = sizeof(si);
      `
      `    BOOL inherit = FALSE;
      `    if (file_actions != NULL && (file_actions->has_dup2_1 || file_actions->has_dup2_2)) {
      `        si.dwFlags |= STARTF_USESTDHANDLES;
      `        si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
      `        si.hStdOutput = file_actions->has_dup2_1 ? (HANDLE)_get_osfhandle(file_actions->dup2_1_fd) : GetStdHandle(STD_OUTPUT_HANDLE);
      `        si.hStdError = file_actions->has_dup2_2 ? (HANDLE)_get_osfhandle(file_actions->dup2_2_fd) : GetStdHandle(STD_ERROR_HANDLE);
      `        if (file_actions->has_dup2_1) SetHandleInformation(si.hStdOutput, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);
      `        if (file_actions->has_dup2_2) SetHandleInformation(si.hStdError, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);
      `        inherit = TRUE;
      `    }
      `
      `    char* cmdline = __fun_win_build_cmdline(argv);
      `    if (cmdline == NULL) return -1;
      `    BOOL ok = CreateProcessA(NULL, cmdline, NULL, NULL, inherit, 0, NULL, NULL, &si, &pi);
      `    free(cmdline);
      `    if (!ok) return -1;
      `
      `    CloseHandle(pi.hThread);
      `    CloseHandle(pi.hProcess);
      `    *pid = (pid_t)pi.dwProcessId;
      `    return 0;
      `}
      `
      `long long waitpid(pid_t pid, int32_t* status, long long options) {
      `    (void)options;
      `    HANDLE h = OpenProcess(SYNCHRONIZE | PROCESS_QUERY_INFORMATION, FALSE, (DWORD)pid);
      `    if (h == NULL) return -1;
      `    WaitForSingleObject(h, INFINITE);
      `    DWORD code = 0;
      `    GetExitCodeProcess(h, &code);
      `    CloseHandle(h);
      `    if (status != NULL) *status = (int32_t)((code & 0xFF) << 8);
      `    return (long long)pid;
      `}
      `
      `long long kill(pid_t pid, long long sig) {
      `    (void)sig;
      `    HANDLE h = OpenProcess(PROCESS_TERMINATE, FALSE, (DWORD)pid);
      `    if (h == NULL) return -1;
      `    BOOL ok = TerminateProcess(h, 1);
      `    CloseHandle(h);
      `    return ok ? 0 : -1;
      `}
      `
      `long long pipe(int32_t* fds) {
      `    return (long long)_pipe(fds, 4096, _O_BINARY);
      `}
      `#else
      `#include <spawn.h>
      `#include <sys/wait.h>
      `#include <unistd.h>
      `#include <signal.h>
      `#endif
      `#ifdef _WIN32
      `static char** environ_ptr(void){ return _environ; }
      `#else
      `extern char** environ;
      `static char** environ_ptr(void){ return environ; }
      `#endif
      ``);
    }
    // `stdout`/`stderr`/`stdin` are macros or globals, not callable, and
    // differ per libc, so a `static` wrapper each lets `std.c.io`'s
    // bodyless stream bindings resolve portably.
    self.state.write(`static FILE* stdout_stream(void){ return stdout; }
    `static FILE* stderr_stream(void){ return stderr; }
    `static FILE* stdin_stream(void){ return stdin; }
    ``);
    // Suspends the calling thread for whole seconds, used by
    // std.time's sleep_seconds. Not a direct libc binding since POSIX's
    // nanosleep has no Windows equivalent under the same name; Windows
    // gets its own implementation in terms of Sleep. `clock_gettime`
    // gets the same treatment right after it: UCRT never had a POSIX
    // clock_gettime at all, so std.c.time's binding (used directly by
    // std.channel's own deadline math) needs a real Windows definition
    // rather than relying on a header to provide one.
    self.state.write(`#ifdef _WIN32
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#ifndef NOGDI
    `#define NOGDI
    `#endif
    `#include <windows.h>
    `static int setenv(const char* name, const char* value, int overwrite) {
    `  if (!overwrite && getenv(name) != NULL) { return 0; }
    `  return _putenv_s(name, value);
    `}
    `static int unsetenv(const char* name) { return _putenv_s(name, ""); }
    `static void __fun_sleep_seconds(double seconds) {
    `  if (seconds < 0) seconds = 0;
    `  Sleep((DWORD)(seconds * 1000.0));
    `}
    `#ifndef __MINGW32__
    `#ifndef __fun_clock_gettime_defined
    `#define __fun_clock_gettime_defined
    `static long long clock_gettime(long long clk_id, void* tp) {
    `  (void)clk_id;
    `  if (!tp) return -1;
    `  long long* __fun_cgt_out = (long long*)tp;
    `  FILETIME __fun_cgt_ft;
    `  GetSystemTimeAsFileTime(&__fun_cgt_ft);
    `  unsigned long long __fun_cgt_t = ((unsigned long long)__fun_cgt_ft.dwHighDateTime << 32) | __fun_cgt_ft.dwLowDateTime;
    `  __fun_cgt_t -= 116444736000000000ULL;
    `  __fun_cgt_out[0] = (long long)(__fun_cgt_t / 10000000ULL);
    `  __fun_cgt_out[1] = (long long)((__fun_cgt_t % 10000000ULL) * 100);
    `  return 0;
    `}
    `#endif
    `#endif
    `#else
    `#include <time.h>
    `static void __fun_sleep_seconds(double seconds) {
    `  if (seconds < 0) seconds = 0;
    `  struct timespec __fun_sleep_ts; __fun_sleep_ts.tv_sec = (time_t)seconds; __fun_sleep_ts.tv_nsec = (long)((seconds - (double)__fun_sleep_ts.tv_sec) * 1000000000.0);
    `  nanosleep(&__fun_sleep_ts, NULL);
    `}
    `#endif
    ``);
    // FNV-1a-style hashes backing the `__fun_key_hash` intrinsic. Always
    // emitted, harmless when unused.
    self.state.write(`static long long __fun_str_key_hash(const char* s) { long long h = 2166136261LL; if (s) { for (; *s; ++s) { h ^= (unsigned char)*s; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } } if (h < 0) h = -h; return h; }
    `static long long __fun_bytes_key_hash(const void* p, unsigned long n) { long long h = 2166136261LL; const unsigned char* b = (const unsigned char*)p; for (unsigned long i = 0; i < n; ++i) { h ^= b[i]; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } if (h < 0) h = -h; return h; }
    ``);
    // `__fun_tag(x)` maps a vararg's C type to the one-character tag
    // `emit_call` embeds in `__fun_vtags`, which the callee-side
    // unpacking in `emit_function_named` reads back.
    self.state.write("#define __fun_tag(x) _Generic((x), char*: 's', const char*: 's', long long: 'n', long: 'n', int: 'n', unsigned long long: 'n', unsigned long: 'n', unsigned int: 'n', double: 'd', float: 'd', _Bool: 'b', char: 'c', void*: 'p', default: 'p')\n");
    // Frees a variadic function's own `vargs` unpacking: `data` itself
    // (the backing array `emit_function_named` mallocs above), plus
    // every element `tags[i] != 's'` marks as an owned `fmt_*` string
    // rather than an argument borrowed straight through.
    self.state.write("static void __fun_free_vargs(char** data, const char* tags, long long n) { if (!data) { return; } long long __fun_fv_i = 0; for (; __fun_fv_i < n; __fun_fv_i++) { if (tags && tags[__fun_fv_i] != 's') { free(data[__fun_fv_i]); } } free(data); }\n");
    // Directory helpers for `std.c.dirent`, backing `std.fs`'s
    // `list_dir`/`walk_dir`/`is_dir`/`make_dir`. Platform directory APIs
    // differ too much (POSIX `opendir`/`readdir` versus Win32
    // `FindFirstFile`) for direct bindings, so each wrapper's signature
    // is matched exactly to its Fun type.
    self.state.write(`#ifdef _WIN32
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#ifndef NOGDI
    `#define NOGDI
    `#endif
    `#include <windows.h>
    `#include <direct.h>
    `#include <sys/stat.h>
    `typedef struct { HANDLE h; WIN32_FIND_DATAA data; int started; } __fun_dir_iter;
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; char pattern[4096]; snprintf(pattern, sizeof(pattern), "%s\\*", path); __fun_dir_iter* it = (__fun_dir_iter*)malloc(sizeof(__fun_dir_iter)); if (!it) return NULL; it->h = FindFirstFileA(pattern, &it->data); it->started = 0; if (it->h == INVALID_HANDLE_VALUE) { free(it); return NULL; } return it; }
    `static char* __fun_dir_read_name(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return NULL; if (it->started) { if (!FindNextFileA(it->h, &it->data)) return NULL; } else { it->started = 1; } return it->data.cFileName; }
    `static long long __fun_dir_close(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return -1; FindClose(it->h); free(it); return 0; }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct _stat st; if (_stat(path, &st) != 0) return 0; return (st.st_mode & _S_IFDIR) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return _mkdir(path); }
    `#else
    `#include <dirent.h>
    `#include <sys/stat.h>
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; return (void*)opendir(path); }
    `static char* __fun_dir_read_name(void* dirp) { if (!dirp) return NULL; struct dirent* e = readdir((DIR*)dirp); return e ? e->d_name : NULL; }
    `static long long __fun_dir_close(void* dirp) { if (!dirp) return -1; return (long long)closedir((DIR*)dirp); }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct stat st; if (stat(path, &st) != 0) return 0; return S_ISDIR(st.st_mode) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return mkdir(path, 0755); }
    `#endif
    ``);
    // The private thread primitive, always emitted regardless of whether
    // the program uses `fork`, `async`, or channels. `await` and `fork`
    // build directly on `__fun_thread_start`/`__fun_thread_join`, and the
    // M:N scheduler builds on top of those.
    self.state.write(`#ifdef _WIN32
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#ifndef NOGDI
    `#define NOGDI
    `#endif
    `#include <windows.h>
    `#ifdef __MINGW32__
    `#include <pthread.h>
    `#endif
    `#ifndef __MINGW32__
    `#include <time.h>
    `#include <errno.h>
    `typedef HANDLE pthread_t;
    `typedef struct { int __fun_dummy; } pthread_attr_t;
    `typedef CRITICAL_SECTION pthread_mutex_t;
    `typedef struct { int __fun_dummy; } pthread_mutexattr_t;
    `typedef CONDITION_VARIABLE pthread_cond_t;
    `typedef struct { int __fun_dummy; } pthread_condattr_t;
    `typedef struct __fun_win_timespec { time_t tv_sec; long tv_nsec; } __fun_win_timespec;
    `static void __fun_win_clock_gettime(__fun_win_timespec* out) { FILETIME ft; GetSystemTimeAsFileTime(&ft); unsigned long long t = ((unsigned long long)ft.dwHighDateTime << 32) | ft.dwLowDateTime; t -= 116444736000000000ULL; out->tv_sec = (time_t)(t / 10000000ULL); out->tv_nsec = (long)((t % 10000000ULL) * 100); }
    `typedef struct { void* (*fn)(void*); void* arg; } __fun_pth_ctx;
    `static DWORD WINAPI __fun_pth_tramp(LPVOID p) { __fun_pth_ctx* ctx = (__fun_pth_ctx*)p; if (ctx) { ctx->fn(ctx->arg); free(ctx); } return 0; }
    `static long long pthread_create(pthread_t* thread, pthread_attr_t* attr, void* start_routine, void* arg) { (void)attr; if (!thread || !start_routine) return 22; __fun_pth_ctx* ctx = (__fun_pth_ctx*)malloc(sizeof(__fun_pth_ctx)); if (!ctx) return 12; ctx->fn = (void* (*)(void*))start_routine; ctx->arg = arg; HANDLE h = CreateThread(NULL, 8 * 1024 * 1024, __fun_pth_tramp, ctx, 0, NULL); if (!h) { free(ctx); return 11; } *thread = h; return 0; }
    `static long long pthread_join(pthread_t thread, void* retval) { if (!thread) return 22; DWORD w = WaitForSingleObject(thread, INFINITE); if (retval) *((void**)retval) = NULL; CloseHandle(thread); return w == WAIT_OBJECT_0 ? 0 : (long long)GetLastError(); }
    `static long long pthread_detach(pthread_t thread) { if (!thread) return 22; return CloseHandle(thread) ? 0 : (long long)GetLastError(); }
    `static pthread_t pthread_self(void) { return GetCurrentThread(); }
    `static long long pthread_equal(pthread_t t1, pthread_t t2) { DWORD i1 = GetThreadId(t1), i2 = GetThreadId(t2); return (i1 && i2) ? (i1 == i2 ? 1 : 0) : (t1 == t2 ? 1 : 0); }
    `static long long pthread_attr_init(pthread_attr_t* a) { (void)a; return 0; }
    `static long long pthread_attr_setstacksize(pthread_attr_t* a, long long s) { (void)a; (void)s; return 0; }
    `static long long pthread_attr_destroy(pthread_attr_t* a) { (void)a; return 0; }
    `static long long pthread_mutex_init(pthread_mutex_t* m, pthread_mutexattr_t* a) { (void)a; if (!m) return 22; InitializeCriticalSection(m); return 0; }
    `static long long pthread_mutex_destroy(pthread_mutex_t* m) { if (!m) return 22; DeleteCriticalSection(m); return 0; }
    `static long long pthread_mutex_lock(pthread_mutex_t* m) { if (!m) return 22; EnterCriticalSection(m); return 0; }
    `static long long pthread_mutex_trylock(pthread_mutex_t* m) { if (!m) return (long long)EINVAL; return TryEnterCriticalSection(m) ? 0 : (long long)EBUSY; }
    `static long long pthread_mutex_unlock(pthread_mutex_t* m) { if (!m) return 22; LeaveCriticalSection(m); return 0; }
    `static long long pthread_cond_init(pthread_cond_t* c, pthread_condattr_t* a) { (void)a; if (!c) return 22; InitializeConditionVariable(c); return 0; }
    `static long long pthread_cond_destroy(pthread_cond_t* c) { (void)c; return 0; }
    `static long long pthread_cond_wait(pthread_cond_t* c, pthread_mutex_t* m) { if (!c || !m) return 22; return SleepConditionVariableCS(c, m, INFINITE) ? 0 : (long long)GetLastError(); }
    `static long long pthread_cond_timedwait(pthread_cond_t* c, pthread_mutex_t* m, void* abstime) { if (!c || !m || !abstime) return (long long)EINVAL; const __fun_win_timespec* ts = (const __fun_win_timespec*)abstime; __fun_win_timespec now; __fun_win_clock_gettime(&now); long long sd = (long long)ts->tv_sec - (long long)now.tv_sec; long long nd = (long long)ts->tv_nsec - (long long)now.tv_nsec; if (nd < 0) { sd--; nd += 1000000000LL; } if (sd < 0) return (long long)ETIMEDOUT; unsigned long long ms = (unsigned long long)sd * 1000ULL + (unsigned long long)(nd / 1000000LL); if (nd % 1000000LL) ms++; if (!ms) ms = 1; if (ms > 0xFFFFFFFEULL) ms = 0xFFFFFFFEULL; BOOL ok = SleepConditionVariableCS(c, m, (DWORD)ms); if (ok) return 0; return GetLastError() == ERROR_TIMEOUT ? (long long)ETIMEDOUT : (long long)GetLastError(); }
    `static long long pthread_cond_signal(pthread_cond_t* c) { if (!c) return 22; WakeConditionVariable(c); return 0; }
    `static long long pthread_cond_broadcast(pthread_cond_t* c) { if (!c) return 22; WakeAllConditionVariable(c); return 0; }
    `#endif
    `typedef HANDLE __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `typedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;
    `static DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 8 * 1024 * 1024, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }
    `static int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }
    `#else
    `#include <pthread.h>
    `typedef pthread_t __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { pthread_attr_t __fun_tattr; pthread_attr_init(&__fun_tattr); pthread_attr_setstacksize(&__fun_tattr, 8 * 1024 * 1024); int __fun_trc = pthread_create(t, &__fun_tattr, entry, arg); pthread_attr_destroy(&__fun_tattr); return __fun_trc; }
    `static int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }
    `#endif
    ``);
    // `std.c.net`'s socket bindings need these headers, in both their
    // Windows and POSIX forms, and are emitted unconditionally like every
    // other prelude header.
    self.state.write(`#if defined(_WIN32)
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#include <winsock2.h>
    `#include <ws2tcpip.h>
    `#include <io.h>
    `#ifdef _MSC_VER
    `#pragma comment(lib, "Ws2_32.lib")
    `#endif
    `#ifndef __fun_win_close_defined
    `#define __fun_win_close_defined
    `static inline long long __fun_win_close(long long fd) { if (_close((int)fd) == 0) return 0LL; return closesocket((SOCKET)(uintptr_t)fd) == 0 ? 0LL : -1LL; }
    `#endif
    `#ifndef close
    `#define close __fun_win_close
    `#endif
    `#else
    `#include <sys/socket.h>
    `#include <netinet/in.h>
    `#include <arpa/inet.h>
    `#include <unistd.h>
    `#endif
    ``);
    // A non-fork program can still deadlock on a channel wait, and
    // `std/channel.fn` calls `__fun_wd_enter_wait`/`__fun_wd_leave_wait`
    // around every blocking wait, so these three symbols must always
    // exist. Without `fork` this minimal self-contained watchdog is
    // emitted, with no task queue to track; with `fork`,
    // `emit_scheduler_runtime` defines the same symbols against the
    // scheduler's queue instead. Dormant unless
    // FUN_DEADLOCK_WATCHDOG_MS is set.
    if self.uses_fork {
      self.emit_scheduler_runtime();
    } else {
      self.state.write(`typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
      `static __fun_wd_state __fun_g_wd;
      `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
      `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
      `}
      `static void* __fun_wd_thread(void* unused){ (void)unused;
      `  long long last_seq=-1; long long stall_ms=0;
      `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
      `  for(;;){
      `#ifdef _WIN32
      `    Sleep((DWORD)step);
      `#else
      `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
      `#endif
      `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
      `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
      `    last_seq=seq;
      `    if(stall_ms>=__fun_g_wd.threshold_ms){
      `      __fun_wd_warn((long long)blk, 0, stall_ms);
      `      if(__fun_g_wd.abort_on_fire) abort();
      `      stall_ms=0;
      `    }
      `  }
      `}
      `void __fun_wd_enter_wait(void){
      `  if(!__fun_g_wd.started){
      `    __fun_g_wd.started=1;
      `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
      `    long long wm=(w && w[0])?atoll(w):0;
      `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
      `    const char* a=getenv("FUN_DEADLOCK_ABORT");
      `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
      `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
      `  }
      `  if(!__fun_g_wd.armed) return;
      `  __fun_g_wd.blocked++;
      `}
      `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
      ``);
    }
  }

  // Emits the M:N cooperative task scheduler runtime `fork` uses: a fixed
  // pool of OS worker threads, sized to the CPU count, draining a shared
  // FIFO task queue. Each `fork f(args)` enqueues a function pointer plus
  // a heap-allocated payload, which a worker pops and runs to completion,
  // so many cheap tasks share a few threads rather than one thread per
  // fork as with `await`. The pool starts lazily on the first fork, and
  // `__fun_sched_wait_idle()` blocks until the queue drains. It isn't run
  // automatically at `main`'s exit points, so an orphaned `fork` with no
  // synchronization may not finish first; stdlib uses synchronize through
  // a `WaitGroup` or channel. Cooperative, not preemptive: a blocked task
  // holds its worker, the blocking primitives being the yield points.
  emit_scheduler_runtime() {
    self.state.write(` // --- M:N cooperative virtual-thread scheduler (the fork keyword) ---
    `typedef void (*__fun_task_fn)(void*);
    `typedef struct __fun_task { __fun_task_fn fn; void* arg; } __fun_task;
    `#ifdef _WIN32
    `typedef CRITICAL_SECTION __fun_sched_mtx; typedef CONDITION_VARIABLE __fun_sched_cv;
    `static void __fun_sched_mtx_init(__fun_sched_mtx* m){InitializeCriticalSection(m);}
    `static void __fun_sched_mtx_lock(__fun_sched_mtx* m){EnterCriticalSection(m);}
    `static void __fun_sched_mtx_unlock(__fun_sched_mtx* m){LeaveCriticalSection(m);}
    `static void __fun_sched_cv_init(__fun_sched_cv* c){InitializeConditionVariable(c);}
    `static void __fun_sched_cv_wait(__fun_sched_cv* c, __fun_sched_mtx* m){SleepConditionVariableCS(c, m, INFINITE);}
    `static int __fun_sched_cv_timedwait(__fun_sched_cv* c, __fun_sched_mtx* m, long long ms){
    `  BOOL __ok = SleepConditionVariableCS(c, m, (DWORD)ms);
    `  return __ok ? 0 : 1;
    `}
    `static void __fun_sched_cv_signal(__fun_sched_cv* c){WakeConditionVariable(c);}
    `static void __fun_sched_cv_broadcast(__fun_sched_cv* c){WakeAllConditionVariable(c);}
    `static int __fun_cpu_count(void){SYSTEM_INFO si; GetSystemInfo(&si); int n=(int)si.dwNumberOfProcessors; return n>0?n:1;}
    `#ifndef __MINGW32__
    `#ifndef __fun_clock_gettime_defined
    `#define __fun_clock_gettime_defined
    `static long long clock_gettime(long long clk_id, void* tp) {
    `  (void)clk_id;
    `  if (!tp) return -1;
    `  long long* __fun_cgt_out = (long long*)tp;
    `  FILETIME __fun_cgt_ft;
    `  GetSystemTimeAsFileTime(&__fun_cgt_ft);
    `  unsigned long long __fun_cgt_t = ((unsigned long long)__fun_cgt_ft.dwHighDateTime << 32) | __fun_cgt_ft.dwLowDateTime;
    `  __fun_cgt_t -= 116444736000000000ULL;
    `  __fun_cgt_out[0] = (long long)(__fun_cgt_t / 10000000ULL);
    `  __fun_cgt_out[1] = (long long)((__fun_cgt_t % 10000000ULL) * 100);
    `  return 0;
    `}
    `#endif
    `#endif
    `#else
    `#include <unistd.h>
    `#include <time.h>
    `#include <errno.h>
    `typedef pthread_mutex_t __fun_sched_mtx; typedef pthread_cond_t __fun_sched_cv;
    `static void __fun_sched_mtx_init(__fun_sched_mtx* m){pthread_mutex_init(m,NULL);}
    `static void __fun_sched_mtx_lock(__fun_sched_mtx* m){pthread_mutex_lock(m);}
    `static void __fun_sched_mtx_unlock(__fun_sched_mtx* m){pthread_mutex_unlock(m);}
    `static void __fun_sched_cv_init(__fun_sched_cv* c){pthread_cond_init(c,NULL);}
    `static void __fun_sched_cv_wait(__fun_sched_cv* c, __fun_sched_mtx* m){pthread_cond_wait(c,m);}
    `static int __fun_sched_cv_timedwait(__fun_sched_cv* c, __fun_sched_mtx* m, long long ms){
    `  struct timespec __ts; clock_gettime(CLOCK_REALTIME, &__ts);
    `  __ts.tv_sec += ms/1000; __ts.tv_nsec += (ms%1000)*1000000L;
    `  if(__ts.tv_nsec >= 1000000000L){ __ts.tv_nsec -= 1000000000L; __ts.tv_sec += 1; }
    `  int __rc = pthread_cond_timedwait(c, m, &__ts);
    `  return (__rc == ETIMEDOUT) ? 1 : 0;
    `}
    `static void __fun_sched_cv_signal(__fun_sched_cv* c){pthread_cond_signal(c);}
    `static void __fun_sched_cv_broadcast(__fun_sched_cv* c){pthread_cond_broadcast(c);}
    `static int __fun_cpu_count(void){long n=sysconf(_SC_NPROCESSORS_ONLN); return n>0?(int)n:1;}
    `#endif
    `#define __FUN_SCHED_QCAP 4096
    `// An idle worker beyond the CPU-sized base pool retires after this long
    `// with nothing to do, so a burst of blocking work doesn't leave the
    `// process holding hundreds of OS threads open indefinitely.
    `#define __FUN_SCHED_IDLE_RETIRE_MS 10000
    `typedef struct __fun_sched {
    `  __fun_sched_mtx mu; __fun_sched_cv not_empty; __fun_sched_cv not_full; __fun_sched_cv idle;
    `  __fun_task q[__FUN_SCHED_QCAP]; int head, tail, count;
    `  long long pending;
    `  int started, shutting_down, base_workers, nworkers, max_workers, idle_workers;
    `  int wd_armed; long long wd_threshold_ms; int wd_abort;
    `  int blocked; long long progress_seq;
    `} __fun_sched;
    `static __fun_sched __fun_g_sched;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `void __fun_wd_enter_wait(void){ if(!__fun_g_sched.wd_armed) return; __fun_sched_mtx_lock(&__fun_g_sched.mu); __fun_g_sched.blocked++; __fun_sched_mtx_unlock(&__fun_g_sched.mu); }
    `void __fun_wd_leave_wait(void){ if(!__fun_g_sched.wd_armed) return; __fun_sched_mtx_lock(&__fun_g_sched.mu); if(__fun_g_sched.blocked>0)__fun_g_sched.blocked--; __fun_g_sched.progress_seq++; __fun_sched_mtx_unlock(&__fun_g_sched.mu); }
    `static void* __fun_sched_watchdog(void* unused){ (void)unused;
    `  long long last_seq = -1; long long stall_ms = 0;
    `  long long step = __fun_g_sched.wd_threshold_ms/4; if(step<1) step=1; if(step>1000) step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `    long long pend=__fun_g_sched.pending; int blk=__fun_g_sched.blocked; int nw=__fun_g_sched.nworkers;
    `    long long seq=__fun_g_sched.progress_seq; int down=__fun_g_sched.shutting_down;
    `    __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `    if(down) return NULL;
    `    (void)nw;
    `    if(pend>0 && blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_sched.wd_threshold_ms){
    `      __fun_wd_warn((long long)blk, pend, stall_ms);
    `      if(__fun_g_sched.wd_abort) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `// A worker's run loop, launched both by the initial CPU-sized base pool
    `// and elastically by __fun_go under contention (see there). A worker
    `// beyond the base pool that stays idle past __FUN_SCHED_IDLE_RETIRE_MS
    `// exits rather than waiting forever, so the pool grows to absorb a
    `// burst of blocking work and shrinks back once it passes; the base
    `// pool itself never retires, so there is always at least CPU-count
    `// capacity ready with zero spin-up latency.
    `static void* __fun_sched_worker(void* unused){ (void)unused;
    `  for(;;){
    `    __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `    __fun_g_sched.idle_workers++;
    `    while(__fun_g_sched.count==0 && !__fun_g_sched.shutting_down){
    `      int __timed_out = __fun_sched_cv_timedwait(&__fun_g_sched.not_empty, &__fun_g_sched.mu, __FUN_SCHED_IDLE_RETIRE_MS);
    `      if(__timed_out && __fun_g_sched.count==0 && !__fun_g_sched.shutting_down && __fun_g_sched.nworkers > __fun_g_sched.base_workers){
    `        __fun_g_sched.nworkers--; __fun_g_sched.idle_workers--;
    `        __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `        return NULL;
    `      }
    `    }
    `    __fun_g_sched.idle_workers--;
    `    if(__fun_g_sched.count==0 && __fun_g_sched.shutting_down){ __fun_sched_mtx_unlock(&__fun_g_sched.mu); return NULL; }
    `    __fun_task t = __fun_g_sched.q[__fun_g_sched.head];
    `    __fun_g_sched.head = (__fun_g_sched.head+1) % __FUN_SCHED_QCAP;
    `    __fun_g_sched.count--;
    `    if(__fun_g_sched.wd_armed) __fun_g_sched.progress_seq++;
    `    __fun_sched_cv_signal(&__fun_g_sched.not_full);
    `    __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `    if(t.fn) t.fn(t.arg);
    `    __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `    __fun_g_sched.pending--;
    `    if(__fun_g_sched.wd_armed) __fun_g_sched.progress_seq++;
    `    if(__fun_g_sched.pending==0) __fun_sched_cv_broadcast(&__fun_g_sched.idle);
    `    __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `  }
    `}
    `static void __fun_sched_init_once(void){
    `  static int once=0; if(once) return; once=1;
    `  __fun_sched_mtx_init(&__fun_g_sched.mu);
    `  __fun_sched_cv_init(&__fun_g_sched.not_empty);
    `  __fun_sched_cv_init(&__fun_g_sched.not_full);
    `  __fun_sched_cv_init(&__fun_g_sched.idle);
    `  { const char* w = getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm = (w && w[0]) ? atoll(w) : 0;
    `    __fun_g_sched.wd_armed = (wm > 0) ? 1 : 0;
    `    __fun_g_sched.wd_threshold_ms = (wm > 0) ? wm : 0;
    `    const char* a = getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_sched.wd_abort = (a && a[0]=='1') ? 1 : 0;
    `    __fun_g_sched.blocked = 0; __fun_g_sched.progress_seq = 0; }
    `}
    `static void __fun_sched_ensure_started(void){
    `  __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `  if(!__fun_g_sched.started){
    `    __fun_g_sched.started=1; __fun_g_sched.head=__fun_g_sched.tail=__fun_g_sched.count=0;
    `    __fun_g_sched.pending=0; __fun_g_sched.shutting_down=0; __fun_g_sched.idle_workers=0;
    `    int n=__fun_cpu_count(); if(n<1)n=1; if(n>64)n=64; __fun_g_sched.base_workers=n; __fun_g_sched.nworkers=n;
    `    { const char* mw = getenv("FUN_SCHED_MAX_WORKERS");
    `      long long mwv = (mw && mw[0]) ? atoll(mw) : 4096;
    `      if(mwv < n) mwv = n;
    `      __fun_g_sched.max_workers = (int)mwv; }
    `    for(int i=0;i<n;i++){ __fun_thread_t th; __fun_thread_start(&th, __fun_sched_worker, NULL); }
    `    if(__fun_g_sched.wd_armed){ __fun_thread_t wt; __fun_thread_start(&wt, __fun_sched_watchdog, NULL); }
    `  }
    `  __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `}
    `// Enqueues fn(arg) for a worker to run. Beyond simply queuing, this
    `// is what keeps a burst of blocking work (e.g. many forked tasks all
    `// contending on the same Mutex) from starving the fixed base pool: if
    `// no worker is currently idle to pick this task up and the pool has
    `// room to grow, one more worker is spun up right away. Without this,
    `// once every base worker is blocked on something other than the
    `// scheduler's own queue, nothing is left to drain it and the whole
    `// program deadlocks -- the base pool alone is sized for CPU-bound
    `// throughput, not for absorbing however many tasks happen to block at
    `// once.
    `static void __fun_go(__fun_task_fn fn, void* arg){
    `  __fun_sched_init_once(); __fun_sched_ensure_started();
    `  __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `  while(__fun_g_sched.count==__FUN_SCHED_QCAP && !__fun_g_sched.shutting_down)
    `    __fun_sched_cv_wait(&__fun_g_sched.not_full, &__fun_g_sched.mu);
    `  if(__fun_g_sched.shutting_down){ __fun_sched_mtx_unlock(&__fun_g_sched.mu); if(fn) fn(arg); return; }
    `  __fun_g_sched.q[__fun_g_sched.tail].fn=fn; __fun_g_sched.q[__fun_g_sched.tail].arg=arg;
    `  __fun_g_sched.tail=(__fun_g_sched.tail+1)%__FUN_SCHED_QCAP; __fun_g_sched.count++; __fun_g_sched.pending++;
    `  if(__fun_g_sched.wd_armed) __fun_g_sched.progress_seq++;
    `  int __need_worker = (__fun_g_sched.idle_workers==0) && (__fun_g_sched.nworkers < __fun_g_sched.max_workers);
    `  if(__need_worker){ __fun_g_sched.nworkers++; }
    `  __fun_sched_cv_signal(&__fun_g_sched.not_empty);
    `  __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `  if(__need_worker){ __fun_thread_t __th; __fun_thread_start(&__th, __fun_sched_worker, NULL); }
    `}
    `static void __fun_sched_wait_idle(void){
    `  if(!__fun_g_sched.started) return;
    `  __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `  while(__fun_g_sched.pending>0) __fun_sched_cv_wait(&__fun_g_sched.idle, &__fun_g_sched.mu);
    `  __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `}
    `
    ``);
  }

  // Transpiles every top-level `Enum`/`Compound`/`Impl`/`Function` node
  // in `nodes`, skipping anything else without error. Impl methods are
  // pre-registered first, since a generic impl's template must be in
  // `generic_impl_templates` before the enum and compound pass: a plain
  // type's field can be a generic instantiation that immediately triggers
  // monomorphizing that type's methods. Types come next, registering
  // their names as a side effect, all before any body is generated, so a
  // method calling another type's method resolves regardless of
  // declaration order. Impl methods are then emitted before plain
  // top-level functions, so a function calling a method needs no forward
  // declaration.
  pub transpile(Vec<Node> nodes) Option<CodegenErrorKind> {
    self.all_nodes = nodes;
    // Computed before the prelude is written, so it's available by the
    // time any pass needs to know whether the program uses `fork`.
    self.uses_fork = uses_fork_in(nodes);
    self.c_shadow_names = collect_c_shadow_names(nodes);
    self.write_prelude();
    self.register_function_signatures(nodes);
    // Registers every quirk's declaration, pure bookkeeping with no C
    // text: a generic one, before anything referencing a concrete
    // instantiation of it as a bare type needs to resolve it, and a
    // plain one, so a dynamically-dispatched call's return type can be
    // read from here rather than from any one impl.
    for n : nodes {
      fit n.kind {
        .Quirk(q) -> {
          self.quirk_decl_names.push(q.name);
          self.quirk_decl_type_params.push(q.type_params);
          self.quirk_decl_methods.push(q.methods);
        }
        _ -> {}
      }
    }
    // Pre-registered before the enum and compound passes, since a
    // non-generic type's field can be a generic instantiation that
    // immediately triggers `maybe_instantiate_generic_impl_methods`.
    for n : nodes {
      fit n.kind {
        .Impl(i) -> { self.register_impl_methods(n); }
        _ -> {}
      }
    }
    // Forward-declares every plain compound's struct name (`typedef
    // struct X X;`) before any type body or the prototype pass below, so
    // every type name is usable regardless of position. `emit_compound`
    // and `emit_enum` rely on source order alone, which breaks down for
    // mutually self-referential compounds. A plain tagged-union enum
    // needs the same treatment for a self-referential pointer payload
    // (`enum Expr { Neg(Expr*), ... }`).
    for n : nodes {
      fit n.kind {
        .Compound(c) -> {
          if !c.has_type_params && !self.is_std_c_signature_node(n) {
            self.state.write("typedef struct ");
            self.state.write(c.name);
            self.state.write(" ");
            self.state.write(c.name);
            self.state.write(";\n");
          }
        }
        .Enum(e) -> {
          if !e.has_type_params {
            bin en_is_tagged_union = false;
            for v : e.variants {
              if v.has_payload && v.payload.len > 0 {
                en_is_tagged_union = true;
              }
            }
            if en_is_tagged_union {
              self.state.write("typedef struct ");
              self.state.write(e.name);
              self.state.write(" ");
              self.state.write(e.name);
              self.state.write(";\n");
            }
          }
        }
        _ -> {}
      }
    }
    // Registers every generic enum and compound template, pure
    // bookkeeping with no C text, before the prototype pass below: a
    // plain signature can reference a generic instantiation that needs
    // its template known to resolve, as can a plain type's field.
    for n : nodes {
      fit n.kind {
        .Enum(e) -> {
          if e.has_type_params {
            let eerr = self.emit_enum(n);
            if eerr.is_some() {
              ret eerr;
            }
          }
        }
        .Compound(c) -> {
          if c.has_type_params {
            let cerr = self.emit_compound(n);
            if cerr.is_some() {
              ret cerr;
            }
          }
        }
        _ -> {}
      }
    }
    // Forward-declares every plain top-level function's and plain impl
    // method's C prototype before any body, since `emit_function` and
    // `emit_impl` rely on source order alone, which breaks as soon as one
    // calls another declared later. Positioned right after
    // `register_impl_methods` rather than alongside the compound pass,
    // because a plain impl method can be called far earlier than its
    // textual position: a generic method reached lazily during the type
    // pass below can resolve to a concrete override and be emitted there.
    // Excludes a `std/c/*.fn` binding node, whose forward declaration
    // would conflict with the system header, and any signature not safe
    // this early, which falls back to source order. `main` is excluded
    // too, since `emit_function_prototype` doesn't know about its forced
    // entry-point signature and would disagree with the real definition;
    // nothing calls `main` recursively.
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          if !f.has_type_params && !self.is_std_c_signature_node(n) &&
            !equals(f.name, "main") && !f.is_variadic &&
            self.function_prototype_is_safe_early(n) {
            self.hoist_insert_pos = .Some(self.state.out.len());
            let ferr = self.emit_function_prototype(n);
            if ferr.is_some() {
              ret ferr;
            }
          }
        }
        .Impl(i) -> {
          if !i.has_type_params {
            for m : i.methods {
              if self.is_std_c_signature_node(*m) ||
                !self.function_prototype_is_safe_early(*m) {
                continue;
              }
              // Emitted per call site once its own type params are
              // known; see `emit_impl`.
              bin m_own_params = false;
              fit m.kind {
                .Function(mfn) -> { m_own_params = mfn.has_type_params; }
                _ -> {}
              }
              if m_own_params {
                continue;
              }
              self.hoist_insert_pos = .Some(self.state.out.len());
              let merr = self.emit_function_prototype(*m);
              if merr.is_some() {
                ret merr;
              }
            }
          }
        }
        _ -> {}
      }
    }
    // Globals are emitted before types, not just before impls and
    // functions. Any pass can hoist a monomorphized generic definition to
    // wherever the output currently ends, and that first trigger can fire
    // as early as the type pass, so a global emitted later would land
    // after a hoisted method body that already references it. Globals are
    // literals with no type dependency, so moving them first costs
    // nothing.
    for n : nodes {
      fit n.kind {
        .Variable(v) -> {
          self.hoist_insert_pos = .Some(self.state.out.len());
          let gerr = self.emit_global_variable(n);
          if gerr.is_some() {
            ret gerr;
          }
        }
        _ -> {}
      }
    }
    // Every plain enum and compound is emitted lazily on first reference
    // rather than through two flat passes, which can't satisfy every
    // dependency direction. This walk just ensures each plain type is
    // emitted; most are already done, pulled in as an earlier type's
    // dependency.
    for n : nodes {
      fit n.kind {
        .Enum(e) -> {
          if !e.has_type_params {
            let eerr2 = self.ensure_plain_type_emitted(e.name);
            if eerr2.is_some() {
              ret eerr2;
            }
          }
        }
        .Compound(c) -> {
          if !c.has_type_params {
            let cerr2 = self.ensure_plain_type_emitted(c.name);
            if cerr2.is_some() {
              ret cerr2;
            }
          }
        }
        _ -> {}
      }
    }
    // Forces a concrete monomorphizing impl's target type (`impl
    // Vec<num> { ... }`) to be instantiated now, after the type pass
    // registered the template but before the impl bodies below. Such a
    // method's implicit `self` is already a bare `Vec__num*`, so
    // `self.<field>` never goes through the lazy-instantiation path, and
    // `Vec__num`'s field records would otherwise exist only if something
    // else happened to instantiate `Vec<num>` first. Tries compound then
    // enum; an already-non-generic impl skips this entirely.
    for n : nodes {
      fit n.kind {
        .Impl(i) -> {
          if !i.has_type_params && i.has_concrete_dtype {
            self.hoist_insert_pos = .Some(self.state.out.len());
            let forced_compound = self.ensure_compound_instantiated(*i.concrete_dtype);
            if forced_compound.is_none() {
              self.ensure_enum_instantiated(*i.concrete_dtype);
            }
          }
        }
        _ -> {}
      }
    }
    // One combined pass in source order emits every plain impl's methods
    // and every plain function's body. Two flat passes would put every
    // impl method before every plain function, breaking the case where a
    // function is textually earlier, an impl method calls it, and both
    // were excluded from the forward-declare pass above.
    for n : nodes {
      fit n.kind {
        .Impl(i) -> {
          // The vtable machinery first: a method returning the very
          // quirk it implements (`self_ref() Chain` on `impl X as
          // Chain`) needs that quirk's own struct typedef to already
          // exist when its signature is written, and nothing this
          // writes depends on the method bodies emitted after it.
          self.hoist_insert_pos = .Some(self.state.out.len());
          let qerr = self.emit_quirk_vtable_machinery(n);
          if qerr.is_some() {
            ret qerr;
          }
          self.hoist_insert_pos = .Some(self.state.out.len());
          let ierr = self.emit_impl(n);
          if ierr.is_some() {
            self.note_unsupported(n, "in an impl block");
            ret ierr;
          }
        }
        .Function(f) -> {
          // A test run supplies its own entry point, so the program's
          // own `main` is left out rather than competing with it. The
          // fuzzing engine's own driver supplies `main` too, so a
          // user-defined one would collide with it at link time.
          bin skip_main = equals(f.name, "main") && (self.test_mode || self.fuzz_mode);
          if !f.has_type_params && !skip_main {
            self.hoist_insert_pos = .Some(self.state.out.len());
            let ferr = self.emit_function(n);
            if ferr.is_some() {
              self.note_unsupported(n, format("in function `{str}`", f.name));
              ret ferr;
            }
          }
        }
        _ -> {}
      }
    }

    // Catches any generic impl method enqueued but never drained: a
    // quirk's vtable wrapper (`maybe_emit_quirk_vtable_for_instantiation`)
    // enqueues its methods under suppression, since that trigger fires
    // too early (right when the compound is first instantiated) for a
    // body that references some other type by value. By now every type
    // the program uses has been emitted at least once, so this is a safe
    // position for whatever is still outstanding.
    if self.pending_generic_impl_method_cursor < self.pending_generic_impl_method_owner.len {
      self.hoist_insert_pos = .Some(self.state.out.len());
      let drain_err = self.drain_pending_generic_impl_methods();
      if drain_err.is_some() {
        ret drain_err;
      }
    }

    if self.test_mode {
      ret self.emit_test_runner(nodes);
    }
    if self.fuzz_mode {
      ret self.emit_fuzz_harness(nodes);
    }
    ret .None;
  }

  // Emits each test block as its own function, then an entry point that
  // runs them and reports what passed. An optional argument names a
  // single test to run.
  emit_test_runner(Vec<Node> nodes) Option<CodegenErrorKind> {
    Vec<str> names;
    names.init(0);
    defer names.free();

    num index = 0;
    for n : nodes {
      fit n.kind {
        .Test(t) -> {
          names.push(t.name);
          // A test body starts from the same clean slate a function
          // body does.
          self.local_names.init(0);
          self.local_is_pointer.init(0);
          self.local_type_name.init(0);
          self.local_dtype.init(0);
          self.local_multidim_names.init(0);
          self.local_multidim_roots.init(0);
          self.local_multidim_depths.init(0);
          self.defer_stack.init(0);
          self.defer_scope_starts.init(0);
          self.in_main = false;
          // Instantiations belong at file scope, not nested inside the
          // test function.
          self.hoist_insert_pos = .Some(self.state.out.len());
          // A test body compiles straight through `emit_body`, never
          // through `emit_function_named`, so it needs its own copy of
          // that function's function-start ownership capture.
          bin owns_test_fn_body_start_pos = self.state == self.root_state &&
            self.current_fn_body_start_pos.is_none();
          if owns_test_fn_body_start_pos {
            self.current_fn_body_start_pos = .Some(self.state.out.len());
          }
          self.state.write(format("static void __fun_test_{str}(void) {\n", format_num(index)));
          self.state.indent_level = self.state.indent_level + 1;
          let berr = self.emit_body(*t.body);
          if berr.is_some() {
            self.note_unsupported(n, format("in test `{str}`", t.name));
            ret berr;
          }
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write("}\n\n");
          if owns_test_fn_body_start_pos {
            self.current_fn_body_start_pos = .None;
          }
          index = index + 1;
        }
        _ -> {}
      }
    }

    if names.len == 0 {
      self.state.write("int main(void) {\n");
      self.state.write("    printf(\"no tests found\\n\");\n");
      self.state.write("    return 0;\n");
      self.state.write("}\n");
      ret .None;
    }

    self.state.write("static void __fun_test_dispatch(int64_t i) {\n");
    self.state.write("    switch (i) {\n");
    num di = 0;
    for di < names.len {
      self.state.write(format(
        "        case {str}: __fun_test_{str}(); break;\n",
        format_num(di),
        format_num(di)
      ));
      di = di + 1;
    }
    self.state.write("    }\n");
    self.state.write("}\n\n");

    self.state.write("static char* __fun_test_name(int64_t i) {\n");
    self.state.write("    switch (i) {\n");
    num ni = 0;
    for ni < names.len {
      // A test name reaches here as it was written in source, where it
      // was already a string literal, so it needs no further escaping.
      self.state.write(format("        case {str}: return \"", format_num(ni)));
      self.state.write(names.get(ni));
      self.state.write("\";\n");
      ni = ni + 1;
    }
    self.state.write("    }\n");
    self.state.write("    return \"\";\n");
    self.state.write("}\n\n");

    self.state.write("int main(int argc, char** argv) {\n");
    self.state.write("    const char* filter = argc > 1 ? argv[1] : (const char*)0;\n");
    self.state.write(format("    int64_t total = {str};\n", format_num(names.len)));
    self.state.write("    int64_t ran = 0;\n");
    self.state.write("    int64_t passed = 0;\n");
    self.state.write("    for (int64_t i = 0; i < total; i++) {\n");
    self.state.write("        char* name = __fun_test_name(i);\n");
    self.state.write("        if (filter && strcmp(filter, name) != 0) { continue; }\n");
    self.state.write("        ran++;\n");
    self.state.write("        if (setjmp(__fun_test_jmp) == 0) {\n");
    self.state.write("            __fun_test_dispatch(i);\n");
    self.state.write("            passed++;\n");
    self.state.write("            printf(\"test: %s ... PASS\\n\", name);\n");
    self.state.write("        } else {\n");
    self.state.write("            printf(\"test: %s ... FAIL\\n\", name);\n");
    self.state.write("        }\n");
    self.state.write("    }\n");
    self.state.write("    if (filter && ran == 0) {\n");
    self.state.write("        printf(\"no test named \\\"%s\\\" found\\n\", filter);\n");
    self.state.write("        return 1;\n");
    self.state.write("    }\n");
    self.state.write("    printf(\"%lld/%lld tests passed\\n\", (long long)passed, (long long)ran);\n");
    self.state.write("    return passed == ran ? 0 : 1;\n");
    self.state.write("}\n");
    ret .None;
  }

  // Emits the chosen `fuzz` target's body as `LLVMFuzzerTestOneInput`, the
  // entry point the fuzzing engine's own `main` (supplied at link time by
  // `-fsanitize=fuzzer`) calls once per input. `self.fuzz_target` names
  // which target to build when a file declares more than one; a file with
  // exactly one target doesn't need it named.
  emit_fuzz_harness(Vec<Node> nodes) Option<CodegenErrorKind> {
    Vec<Node> targets;
    targets.init(0);
    defer targets.free();
    for n : nodes {
      fit n.kind {
        .Fuzz(_) -> { targets.push(n); }
        _ -> {}
      }
    }

    if targets.len == 0 {
      self.error_note = "no 'fuzz' target declared, fuzz mode needs at least one fuzz \"name\" (data, len) { ... } block";
      ret .Some(.InvalidNode);
    }

    Node chosen;
    bin have_chosen = false;
    if !equals(self.fuzz_target, "") {
      for n : targets {
        fit n.kind {
          .Fuzz(fd) -> {
            if equals(fd.name, self.fuzz_target) {
              chosen = n;
              have_chosen = true;
            }
          }
          _ -> {}
        }
      }
      if !have_chosen {
        self.error_note = format("no fuzz target named '{str}' found", self.fuzz_target);
        ret .Some(.InvalidNode);
      }
    } elif targets.len == 1 {
      chosen = targets.get(0);
      have_chosen = true;
    } else {
      self.error_note = "multiple fuzz targets declared, specify which one to build";
      ret .Some(.InvalidNode);
    }

    fit chosen.kind {
      .Fuzz(fd) -> {
        // A fuzz body starts from the same clean slate a function body
        // does, matching `emit_test_runner`'s own reset.
        self.local_names.init(0);
        self.local_is_pointer.init(0);
        self.local_type_name.init(0);
        self.local_dtype.init(0);
        self.local_multidim_names.init(0);
        self.local_multidim_roots.init(0);
        self.local_multidim_depths.init(0);
        self.defer_stack.init(0);
        self.defer_scope_starts.init(0);
        // `LLVMFuzzerTestOneInput` returns `int`, like a real `main`, so a
        // bare `ret;` (the only form typecheck allows in a void-context
        // fuzz body) needs to become C `return 0;`, not a bare `return;`.
        // `in_main` is the existing mechanism a Fun-level `void main() { ...
        // ret; }` already uses for its own `int main(void)` wrapper, reused
        // here for the same reason.
        self.in_main = true;
        self.hoist_insert_pos = .Some(self.state.out.len());

        str data_name = "";
        str len_name = "";
        fit fd.data_param.kind {
          .Variable(v) -> { data_name = v.name; }
          _ -> {}
        }
        fit fd.len_param.kind {
          .Variable(v) -> { len_name = v.name; }
          _ -> {}
        }

        self.state.write("int LLVMFuzzerTestOneInput(const unsigned char* __fun_fuzz_data, unsigned long __fun_fuzz_size) {\n");
        self.state.write(format("  void* {str} = (void*)__fun_fuzz_data;\n", data_name));
        self.state.write(format("  int64_t {str} = (int64_t)__fun_fuzz_size;\n", len_name));
        let berr = self.emit_body(*fd.body);
        if berr.is_some() {
          self.note_unsupported(chosen, format("in fuzz target `{str}`", fd.name));
          ret berr;
        }
        self.state.write("\n  return 0;\n}\n");
      }
      _ -> {}
    }
    ret .None;
  }
}

test "write_type emits builtin scalar C types with pointer depth" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "num";
  g.write_type(dt);
  assert equals(st.out.build(), "int64_t"), "expected 'int64_t'";

  CodegenState st2 = codegen_state_new();
  Codegen g2 = codegen_new(&st2);
  DataType dt2 = dtype_new();
  dt2.type_str = "chr";
  dt2.pointer_depth = 2;
  g2.write_type(dt2);
  assert equals(st2.out.build(), "char**"), "expected 'char**'";
}

test "write_type emits a sized int via dynamic_int_type_to_c" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "u32";
  g.write_type(dt);
  assert equals(st.out.build(), "uint32_t"), "expected 'uint32_t'";
}

test "emit_expr emits a number literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(.Number(.Num(42)));
  assert g.emit_expr(n).is_none(), "expected the number to emit";
  assert equals(st.out.build(), "42"), "expected '42'";
}

test "emit_expr emits a string literal verbatim between quotes" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(.String("hello"));
  assert g.emit_expr(n).is_none(), "expected the string to emit";
  assert equals(st.out.build(), "\"hello\""), "expected a quoted string";
}

test "emit_expr escapes a raw string's literal bytes when node.flags.is_raw_string is set" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(.String("C:\\Users\\name"));
  n.flags.is_raw_string = true;
  assert g.emit_expr(n).is_none(), "expected the raw string to emit";
  // Each literal backslash must become an escaped pair in the C output.
  assert equals(st.out.build(), "\"C:\\\\Users\\\\name\""), "expected backslashes escaped for C";
}

test "emit_expr escapes an embedded double-quote and newline in a raw string" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(.String("she said \"hi\"\nbye"));
  n.flags.is_raw_string = true;
  assert g.emit_expr(n).is_none(), "expected the raw string to emit";
  assert equals(st.out.build(), "\"she said \\\"hi\\\"\\nbye\""), "expected the quote and newline escaped for C";
}

test "emit_expr emits a boolean literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(.Boolean(true));
  assert g.emit_expr(n).is_none(), "expected the boolean to emit";
  assert equals(st.out.build(), "true"), "expected 'true'";
}

test "emit_expr emits the nil literal as C NULL" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(.Nil);
  assert g.emit_expr(n).is_none(), "expected 'nil' to emit";
  assert equals(st.out.build(), "NULL"), "expected 'NULL'";
}

test "emit_expr emits a panic expression as a GNU statement expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(.String("oops"));
  Node n = node_new(.Panic(msg));
  assert g.emit_expr(n).is_none(), "expected the panic expression to emit";
  assert equals(
    st.out.build(),
    "({ fprintf(stderr_stream(), \"panic: %s\\n\", \"oops\"); abort(); 0; })"
  ), "expected the GNU statement-expression lowering, printing the message and aborting";
}

test "emit_statement emits a bare panic(...) as a statement" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(.String("internal error"));
  Node n = node_new(.Panic(msg));
  assert g.emit_statement(n).is_none(), "expected the bare panic statement to emit";
  assert equals(
    st.out.build(),
    "({ fprintf(stderr_stream(), \"panic: %s\\n\", \"internal error\"); abort(); 0; });\n"
  ), "expected the panic expression followed by a trailing ';\\n', same as any other bare-expression statement";
}

test "emit_statement emits 'assert cond, msg;' as an if/abort with the message printed" {
  // An `assert cond, "msg";` statement needs its own `emit_statement`
  // case; without one it is rejected as `UnsupportedNode`.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(.Boolean(false));
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(.String("should not happen"));
  AssertNode a;
  a.condition = cond;
  a.message = msg;
  a.has_message = true;
  Node n = node_new(.StatementAssert(a));
  assert g.emit_statement(n).is_none(), "expected the assert statement to emit";
  assert equals(
    st.out.build(),
    "if (!(false)) { fprintf(stderr_stream(), \"Assertion failed: %s\\n\", \"should not happen\"); abort(); }\n"
  ), "expected an if/abort guard printing the assert's own message on failure";
}

test "emit_statement emits a message-less 'assert cond;' as a plain if/abort" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(.Boolean(true));
  AssertNode a;
  a.condition = cond;
  a.has_message = false;
  Node n = node_new(.StatementAssert(a));
  assert g.emit_statement(n).is_none(), "expected the message-less assert statement to emit";
  assert equals(st.out.build(), "if (!(true)) { abort(); }\n"), "expected a plain if/abort guard with no message printed";
}

test "emit_expr escapes a character literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(.Character('\n'));
  assert g.emit_expr(n).is_none(), "expected the character to emit";
  assert equals(st.out.build(), "'\\n'"), "expected an escaped newline character literal";
}

test "emit_expr emits an identifier" {
