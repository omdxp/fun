    `typedef pthread_t __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { pthread_attr_t __fun_tattr; pthread_attr_init(&__fun_tattr); pthread_attr_setstacksize(&__fun_tattr, 8 * 1024 * 1024); int __fun_trc = pthread_create(t, &__fun_tattr, entry, arg); pthread_attr_destroy(&__fun_tattr); return __fun_trc; }
    `static int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }
    `#endif
    `#if defined(_WIN32)
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#include <winsock2.h>
    `#include <ws2tcpip.h>
    `#include <io.h>
    `#ifdef _MSC_VER
    `#pragma comment(lib, "Ws2_32.lib")
    `#endif
    `#ifndef __fun_win_close_defined
    `#define __fun_win_close_defined
    `static inline long long __fun_win_close(long long fd) { if (_close((int)fd) == 0) return 0LL; return closesocket((SOCKET)(uintptr_t)fd) == 0 ? 0LL : -1LL; }
    `#endif
    `#ifndef close
    `#define close __fun_win_close
    `#endif
    `#else
    `#include <sys/socket.h>
    `#include <netinet/in.h>
    `#include <arpa/inet.h>
    `#include <unistd.h>
    `#endif
    `typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
    `static __fun_wd_state __fun_g_wd;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `static void* __fun_wd_thread(void* unused){ (void)unused;
    `  long long last_seq=-1; long long stall_ms=0;
    `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
    `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_wd.threshold_ms){
    `      __fun_wd_warn((long long)blk, 0, stall_ms);
    `      if(__fun_g_wd.abort_on_fire) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `void __fun_wd_enter_wait(void){
    `  if(!__fun_g_wd.started){
    `    __fun_g_wd.started=1;
    `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm=(w && w[0])?atoll(w):0;
    `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
    `    const char* a=getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
    `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
    `  }
    `  if(!__fun_g_wd.armed) return;
    `  __fun_g_wd.blocked++;
    `}
    `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
    `typedef struct Outer Outer;
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `typedef struct Outer {
    `  Box__num inner;
    `} Outer;
    `
    ``
  ), "expected Box__num's typedef BEFORE Outer's, not nested inside its field list";
}

test "pub transpile hoists a generic impl method's monomorphized definition BEFORE the function that first triggers it, not nested inside it" {
  // `Box<num>` first used inside `main`'s body must not emit
  // `Box__num`'s typedef and `Box__num__get`'s definition nested inside
  // `main`'s braces. A nested typedef is valid if oddly scoped, but a
  // nested function definition is a hard C syntax error. `pub transpile`
  // tracks where `main` started, and anything hoisted from inside it is
  // spliced right before that point.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;
  CompoundField f;
  f.name = "value";
  DataType* fdt = malloc(sizeof(DataType));
  *fdt = dtype_new();
  fdt.type_str = "T";
  f.dtype = fdt;
  c.fields.push(f);
  Node compound_node = node_new(.Compound(c));

  DataType* t_arg = malloc(sizeof(DataType));
  *t_arg = dtype_new();
  t_arg.type_str = "T";
  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Box";
  self_dt.pointer_depth = 1;
  self_dt.generic_args.push(t_arg);
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(.Identifier("value"));
  ExprNode field_e = expr_node_new();
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(.Expression(field_e));
  Node* method_ret_stmt = malloc(sizeof(Node));
  *method_ret_stmt = node_new(.StatementReturn(field_expr));
  Vec<Node*> method_stmts;
  method_stmts.init(0);
  method_stmts.push(method_ret_stmt);
  BodyNode method_bn;
  method_bn.statements = method_stmts;
  Node* method_body = malloc(sizeof(Node));
  *method_body = node_new(.Body(method_bn));

  FunctionNode getfn = function_node_new();
  getfn.name = "Box__get";
  getfn.has_name = true;
  DataType* get_rtype = malloc(sizeof(DataType));
  *get_rtype = dtype_new();
  get_rtype.type_str = "T";
  getfn.rtype = get_rtype;
  getfn.has_rtype = true;
  getfn.args = margs;
  getfn.has_args = true;
  getfn.body = method_body;
  getfn.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(.Function(getfn));

  ImplNode implb = impl_node_new();
  implb.type_name = "Box";
  implb.type_params.push("T");
  implb.has_type_params = true;
  implb.methods.push(method_node);
  Node impl_node = node_new(.Impl(implb));

  Node main_decl = _box_num_var_decl("b");
  Node* main_decl_ptr = malloc(sizeof(Node));
  *main_decl_ptr = main_decl;
  // A call, not just a declaration: lazy per-method emission triggers a
  // body only at its first call, so it's the call that needs hoisting.
  Node* main_call_ptr = malloc(sizeof(Node));
  *main_call_ptr = _box_get_call_node("b");
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(main_decl_ptr);
  main_stmts.push(main_call_ptr);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "num";
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(compound_node);
  nodes.push(impl_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert equals(
    st.out.build(),
    `#include <stdio.h>
    `#include <stdbool.h>
    `#include <stdint.h>
    `#include <stdarg.h>
    `#include <stdlib.h>
    `#include <string.h>
    `#include <ctype.h>
    `#include <limits.h>
    `static FILE* stdout_stream(void){ return stdout; }
    `static FILE* stderr_stream(void){ return stderr; }
    `static FILE* stdin_stream(void){ return stdin; }
    `#ifdef _WIN32
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#ifndef NOGDI
    `#define NOGDI
    `#endif
    `#include <windows.h>
    `static int setenv(const char* name, const char* value, int overwrite) {
    `  if (!overwrite && getenv(name) != NULL) { return 0; }
    `  return _putenv_s(name, value);
    `}
    `static int unsetenv(const char* name) { return _putenv_s(name, ""); }
    `static void __fun_sleep_seconds(double seconds) {
    `  if (seconds < 0) seconds = 0;
    `  Sleep((DWORD)(seconds * 1000.0));
    `}
    `#ifndef __MINGW32__
    `#ifndef __fun_clock_gettime_defined
    `#define __fun_clock_gettime_defined
    `static long long clock_gettime(long long clk_id, void* tp) {
    `  (void)clk_id;
    `  if (!tp) return -1;
    `  long long* __fun_cgt_out = (long long*)tp;
    `  FILETIME __fun_cgt_ft;
    `  GetSystemTimeAsFileTime(&__fun_cgt_ft);
    `  unsigned long long __fun_cgt_t = ((unsigned long long)__fun_cgt_ft.dwHighDateTime << 32) | __fun_cgt_ft.dwLowDateTime;
    `  __fun_cgt_t -= 116444736000000000ULL;
    `  __fun_cgt_out[0] = (long long)(__fun_cgt_t / 10000000ULL);
    `  __fun_cgt_out[1] = (long long)((__fun_cgt_t % 10000000ULL) * 100);
    `  return 0;
    `}
    `#endif
    `#endif
    `#else
    `#include <time.h>
    `static void __fun_sleep_seconds(double seconds) {
    `  if (seconds < 0) seconds = 0;
    `  struct timespec __fun_sleep_ts; __fun_sleep_ts.tv_sec = (time_t)seconds; __fun_sleep_ts.tv_nsec = (long)((seconds - (double)__fun_sleep_ts.tv_sec) * 1000000000.0);
    `  nanosleep(&__fun_sleep_ts, NULL);
    `}
    `#endif
    `static long long __fun_str_key_hash(const char* s) { long long h = 2166136261LL; if (s) { for (; *s; ++s) { h ^= (unsigned char)*s; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } } if (h < 0) h = -h; return h; }
