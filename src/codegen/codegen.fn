    `static void __fun_free_vargs(char** data, const char* tags, long long n) { if (!data) { return; } long long __fun_fv_i = 0; for (; __fun_fv_i < n; __fun_fv_i++) { if (tags && tags[__fun_fv_i] != 's') { free(data[__fun_fv_i]); } } free(data); }
    `#ifdef _WIN32
