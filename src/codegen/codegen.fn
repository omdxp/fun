  assert g.emit_expr(n).is_some(), "expected a non-identifier callee to be rejected this slice";
}

test "emit_statement emits a variable declaration with an initializer" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "num";
  Node* val = malloc(sizeof(Node));
  *val = node_new(.Number(.Num(5)));
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.val = val;
  v.has_val = true;
  v.is_const = false;
  Node n = node_new(.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "int64_t x = 5;\n"), "expected 'int64_t x = 5;\\n'";
}

test "emit_statement emits a 'let' declaration as '__auto_type', inferring its type from a plain function call" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  FunctionNode fnv = function_node_new();
  fnv.name = "mk";
  fnv.has_name = true;
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.has_args = false;
  Node fn_node = node_new(.Function(fnv));
  Vec<Node> sig_nodes;
  sig_nodes.init(0);
  sig_nodes.push(fn_node);
  g.register_function_signatures(sig_nodes);

  DataType* let_dt = malloc(sizeof(DataType));
  *let_dt = dtype_new();
  let_dt.type_str = "__let_infer__";
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(.Identifier("mk"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(.ExpressionParenthesis(blank));
  ExprNode call_e = expr_node_new();
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* val = malloc(sizeof(Node));
  *val = node_new(.Expression(call_e));
  VariableNode v;
  v.var_type = let_dt;
  v.name = "r";
  v.val = val;
  v.has_val = true;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_none(), "expected the 'let' declaration to emit";
  assert equals(st.out.build(), "__auto_type r = mk();\n"), "expected '__auto_type', not the '__let_infer__' sentinel, in the emitted C";
  assert equals(g.lookup_local_type_name("r").unwrap(), "num"), "expected 'r' inferred as 'num' from mk's own declared return type, so a later fit/field access on 'r' still resolves";
}

test "emit_statement infers a 'let' declaration's type from a plain field-access initializer, so a chained field read off of it still resolves" {
  // A `let ct = self.current_token;` initializer needs
  // `infer_let_expr_type` to resolve the whole chain, or the later
  // `ct.pos.line` read is rejected as an unrecognized local.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "ParseState", true);

  Vec<str> ps_fields;
  ps_fields.init(0);
  ps_fields.push("current_token");
  Vec<str> ps_field_types;
  ps_field_types.init(0);
  ps_field_types.push("Token");
  Vec<bin> ps_field_ptrs;
  ps_field_ptrs.init(0);
  ps_field_ptrs.push(false);
  g.record_compound("ParseState", ps_fields, ps_field_types, ps_field_ptrs);

  Vec<str> tok_fields;
  tok_fields.init(0);
  tok_fields.push("pos");
  Vec<str> tok_field_types;
  tok_field_types.init(0);
  tok_field_types.push("Pos");
  Vec<bin> tok_field_ptrs;
  tok_field_ptrs.init(0);
  tok_field_ptrs.push(false);
  g.record_compound("Token", tok_fields, tok_field_types, tok_field_ptrs);

  DataType* let_dt = malloc(sizeof(DataType));
  *let_dt = dtype_new();
  let_dt.type_str = "__let_infer__";
  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(.Identifier("self"));
  Node* ct_field_ident = malloc(sizeof(Node));
  *ct_field_ident = node_new(.Identifier("current_token"));
  ExprNode field_e = expr_node_new();
  field_e.left = self_ident;
  field_e.has_left = true;
  field_e.right = ct_field_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* val = malloc(sizeof(Node));
  *val = node_new(.Expression(field_e));
  VariableNode v;
  v.var_type = let_dt;
  v.name = "ct";
  v.val = val;
  v.has_val = true;
  v.is_const = false;
  Node n = node_new(.Variable(v));

  assert g.emit_statement(n).is_none(), "expected the 'let' declaration to emit";
  assert equals(st.out.build(), "__auto_type ct = self->current_token;\n"), "expected '__auto_type', not the '__let_infer__' sentinel, in the emitted C";
  assert equals(g.lookup_local_type_name("ct").unwrap(), "Token"), "expected 'ct' inferred as 'Token' from 'self.current_token's own declared field type, so a later 'ct.pos' read still resolves";
}

test "pub transpile resolves a 'fit' over a 'let'-declared local whose type was inferred from a method call" {
  // `let last = self.tokens.last();` followed by a `fit last` needs
  // `last`'s type resolved rather than left as the `__let_infer__`
  // sentinel, or the bare-shorthand pattern match is rejected.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  EnumDeclNode optd = enum_decl_node_new();
  optd.name = "Option";
  EnumVariant some_v = enum_variant_new();
  some_v.name = "Some";
  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "num";
  some_v.payload.push(pdt);
  some_v.has_payload = true;
  optd.variants.push(some_v);
  EnumVariant none_v = enum_variant_new();
  none_v.name = "None";
  optd.variants.push(none_v);
  Node opt_node = node_new(.Enum(optd));

  CompoundNode holderc = compound_node_new();
  holderc.name = "Holder";
  CompoundField hf;
  hf.name = "v";
  DataType* hfdt = malloc(sizeof(DataType));
  *hfdt = dtype_new();
  hfdt.type_str = "num";
  hf.dtype = hfdt;
  holderc.fields.push(hf);
  Node holder_node = node_new(.Compound(holderc));

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Holder";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(.Variable(selfv));
  Vec<Node*> get_params;
  get_params.init(0);
  get_params.push(self_param);

  Node* self_ident_g = malloc(sizeof(Node));
  *self_ident_g = node_new(.Identifier("self"));
  Node* v_ident = malloc(sizeof(Node));
  *v_ident = node_new(.Identifier("v"));
  ExprNode field_e = expr_node_new();
  field_e.left = self_ident_g;
  field_e.has_left = true;
  field_e.right = v_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(.Expression(field_e));
  Node* get_blank = malloc(sizeof(Node));
  *get_blank = node_new(.Blank);
  Node* some_ident = malloc(sizeof(Node));
  *some_ident = node_new(.Identifier("Some"));
  ExprNode some_dot = expr_node_new();
  some_dot.left = get_blank;
  some_dot.has_left = true;
  some_dot.right = some_ident;
  some_dot.has_right = true;
  some_dot.op = ".";
  Node* some_dot_node = malloc(sizeof(Node));
  *some_dot_node = node_new(.Expression(some_dot));
  Node* some_args = malloc(sizeof(Node));
  *some_args = node_new(.ExpressionParenthesis(field_expr));
  ExprNode some_call = expr_node_new();
  some_call.left = some_dot_node;
  some_call.has_left = true;
  some_call.right = some_args;
  some_call.has_right = true;
  some_call.op = "()";
  Node* some_call_node = malloc(sizeof(Node));
  *some_call_node = node_new(.Expression(some_call));
  Node* get_ret = malloc(sizeof(Node));
  *get_ret = node_new(.StatementReturn(some_call_node));
  Vec<Node*> get_stmts;
  get_stmts.init(0);
  get_stmts.push(get_ret);
  BodyNode get_bn;
  get_bn.statements = get_stmts;
  Node* get_body = malloc(sizeof(Node));
  *get_body = node_new(.Body(get_bn));

  FunctionNode getfn = function_node_new();
  getfn.name = "Holder__get";
  getfn.has_name = true;
  DataType* get_rt = malloc(sizeof(DataType));
  *get_rt = dtype_new();
  get_rt.type_str = "Option";
  getfn.rtype = get_rt;
  getfn.has_rtype = true;
  getfn.args = get_params;
  getfn.has_args = true;
  getfn.body = get_body;
  getfn.has_body = true;
  Node* get_method_node = malloc(sizeof(Node));
  *get_method_node = node_new(.Function(getfn));

  ImplNode holderimpl = impl_node_new();
  holderimpl.type_name = "Holder";
  holderimpl.methods.push(get_method_node);
  Node holder_impl_node = node_new(.Impl(holderimpl));

  DataType* param_dt = malloc(sizeof(DataType));
  *param_dt = dtype_new();
  param_dt.type_str = "Holder";
  VariableNode hparam;
  hparam.var_type = param_dt;
  hparam.name = "h";
  hparam.has_val = false;
  hparam.is_const = false;
  Node* h_param = malloc(sizeof(Node));
  *h_param = node_new(.Variable(hparam));
  Vec<Node*> check_params;
  check_params.init(0);
  check_params.push(h_param);

  DataType* let_dt = malloc(sizeof(DataType));
  *let_dt = dtype_new();
  let_dt.type_str = "__let_infer__";
  Node* h_ident = malloc(sizeof(Node));
  *h_ident = node_new(.Identifier("h"));
  Node* get_ident = malloc(sizeof(Node));
  *get_ident = node_new(.Identifier("get"));
  ExprNode call_dot = expr_node_new();
  call_dot.left = h_ident;
  call_dot.has_left = true;
  call_dot.right = get_ident;
  call_dot.has_right = true;
  call_dot.op = ".";
  Node* call_dot_node = malloc(sizeof(Node));
  *call_dot_node = node_new(.Expression(call_dot));
  Node* call_blank = malloc(sizeof(Node));
  *call_blank = node_new(.Blank);
  Node* call_args = malloc(sizeof(Node));
  *call_args = node_new(.ExpressionParenthesis(call_blank));
  ExprNode call_e = expr_node_new();
  call_e.left = call_dot_node;
  call_e.has_left = true;
  call_e.right = call_args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(.Expression(call_e));
  VariableNode letv;
  letv.var_type = let_dt;
  letv.name = "last";
  letv.val = call_node;
  letv.has_val = true;
  letv.is_const = false;
  Node* let_stmt = malloc(sizeof(Node));
  *let_stmt = node_new(.Variable(letv));

  Node* fit_subj = malloc(sizeof(Node));
  *fit_subj = node_new(.Identifier("last"));
  Node* true_ret = malloc(sizeof(Node));
  *true_ret = node_new(.StatementReturn(nil));
  Vec<Node*> true_stmts;
  true_stmts.init(0);
  true_stmts.push(true_ret);
  BodyNode true_bn;
  true_bn.statements = true_stmts;
  Node* true_body = malloc(sizeof(Node));
  *true_body = node_new(.Body(true_bn));
  Node* some_blank = malloc(sizeof(Node));
  *some_blank = node_new(.Blank);
  Node* some_variant = malloc(sizeof(Node));
  *some_variant = node_new(.Identifier("Some"));
  ExprNode some_pat = expr_node_new();
  some_pat.left = some_blank;
  some_pat.has_left = true;
  some_pat.right = some_variant;
  some_pat.has_right = true;
  some_pat.op = ".";
  Node* some_pat_node = malloc(sizeof(Node));
  *some_pat_node = node_new(.Expression(some_pat));
  Vec<str> some_bindings;
  some_bindings.init(0);
  some_bindings.push("t");
  FitBranch some_branch;
  some_branch.condition = some_pat_node;
  some_branch.has_condition = true;
  some_branch.body = true_body;
  some_branch.bindings = some_bindings;
  some_branch.has_bindings = true;

  FitStmtNode fitn = fit_stmt_node_new();
  fitn.exp = fit_subj;
  fitn.branches.push(some_branch);
  fitn.has_default_branch = false;
  Node* fit_node = malloc(sizeof(Node));
  *fit_node = node_new(.StatementFit(fitn));

  Vec<Node*> check_stmts;
  check_stmts.init(0);
  check_stmts.push(let_stmt);
  check_stmts.push(fit_node);
  BodyNode check_bn;
  check_bn.statements = check_stmts;
  Node* check_body = malloc(sizeof(Node));
  *check_body = node_new(.Body(check_bn));

  FunctionNode checkfn = function_node_new();
  checkfn.name = "check";
  checkfn.has_name = true;
  DataType* check_rt = malloc(sizeof(DataType));
  *check_rt = dtype_new();
  check_rt.type_str = "bin";
  checkfn.rtype = check_rt;
  checkfn.has_rtype = true;
  checkfn.args = check_params;
  checkfn.has_args = true;
  checkfn.body = check_body;
  checkfn.has_body = true;
  Node check_node = node_new(.Function(checkfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(opt_node);
  nodes.push(holder_node);
  nodes.push(holder_impl_node);
  nodes.push(check_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  let out = st.out.build();
  assert contains(out, "__auto_type last = Holder__get(&h);"), "expected '__auto_type', not '__let_infer__', in the emitted C";
  assert contains(out, "if (last.tag == Option_Some)"), "expected the fit's bare '.Some' pattern resolved against Option, inferred from Holder__get's own declared return type";
}

test "emit_statement emits an uninitialized variable declaration" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "bin";
  VariableNode v;
  v.var_type = dt;
  v.name = "done";
  v.val = nil;
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "bool done;\n"), "expected 'bool done;\\n'";
}

test "emit_body emits a plain if statement with no elif/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* cond = malloc(sizeof(Node));
  *cond = node_new(.Identifier("ok"));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(.StatementReturn(nil));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret_stmt);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(.Body(if_body_n));

  IfStmtNode ifn;
  ifn.condition = cond;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(.StatementIf(ifn));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if statement to emit";
  assert equals(st.out.build(), `if (ok) {
  `    return;
  `}
  ``), "expected a plain if block";
}

test "emit_body chains StatementIf/StatementElseIf/StatementElse into one if/else-if/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  // if a { ret 1; } elif b { ret 2; } else { ret 3; }
  Node* cond_a = malloc(sizeof(Node));
  *cond_a = node_new(.Identifier("a"));
  Node* val1 = malloc(sizeof(Node));
  *val1 = node_new(.Number(.Num(1)));
  Node* ret1 = malloc(sizeof(Node));
  *ret1 = node_new(.StatementReturn(val1));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret1);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(.Body(if_body_n));
  IfStmtNode ifn;
  ifn.condition = cond_a;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(.StatementIf(ifn));

  Node* cond_b = malloc(sizeof(Node));
  *cond_b = node_new(.Identifier("b"));
  Node* val2 = malloc(sizeof(Node));
  *val2 = node_new(.Number(.Num(2)));
  Node* ret2 = malloc(sizeof(Node));
  *ret2 = node_new(.StatementReturn(val2));
  Vec<Node*> elif_stmts;
  elif_stmts.init(0);
  elif_stmts.push(ret2);
  BodyNode elif_body_n;
  elif_body_n.statements = elif_stmts;
  Node* elif_body = malloc(sizeof(Node));
  *elif_body = node_new(.Body(elif_body_n));
  IfStmtNode ein;
  ein.condition = cond_b;
  ein.body = elif_body;
  Node* elif_stmt = malloc(sizeof(Node));
  *elif_stmt = node_new(.StatementElseIf(ein));

  Node* val3 = malloc(sizeof(Node));
  *val3 = node_new(.Number(.Num(3)));
  Node* ret3 = malloc(sizeof(Node));
  *ret3 = node_new(.StatementReturn(val3));
  Vec<Node*> else_stmts;
  else_stmts.init(0);
  else_stmts.push(ret3);
  BodyNode else_body_n;
  else_body_n.statements = else_stmts;
  Node* else_body = malloc(sizeof(Node));
  *else_body = node_new(.Body(else_body_n));
  Node* else_stmt = malloc(sizeof(Node));
  *else_stmt = node_new(.StatementElse(else_body));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  stmts.push(elif_stmt);
  stmts.push(else_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if/elif/else chain to emit";
  let out = st.out.build();
  assert equals(
    out,
    `if (a) {
    `    return 1;
    `} else if (b) {
    `    return 2;
    `} else {
    `    return 3;
    `}
    ``
  ), "expected a single chained if/else-if/else C construct";
}

