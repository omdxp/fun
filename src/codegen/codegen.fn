test "emit_expr emits an explicit 'Type{ field = value, ... }' compound literal" {
  // An explicit `Type{field = ...}` literal needs its own `emit_expr`
  // case for `.CompoundInit`; without one it is rejected as
  // `UnsupportedNode`.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "DynamicIntType";

  CompoundInitField f1;
  f1.name = "is_signed";
  Node* v1 = malloc(sizeof(Node));
  *v1 = node_new(.Boolean(true));
  f1.value = v1;
  CompoundInitField f2;
  f2.name = "bits";
  Node* v2 = malloc(sizeof(Node));
  *v2 = node_new(.Number(.Num(8)));
  f2.value = v2;

  CompoundInitNode ci = compound_init_node_new();
  ci.init_dtype = dt;
  ci.has_dtype = true;
  ci.fields.push(f1);
  ci.fields.push(f2);
  Node n = node_new(.CompoundInit(ci));

  assert g.emit_expr(n).is_none(), "expected the explicit compound literal to emit";
  assert equals(st.out.build(), "(DynamicIntType){.is_signed = true, .bits = 8}"), "expected a GNU C compound literal with each field set";
}

test "emit_expr emits an empty explicit compound literal as '(Type){0}'" {
