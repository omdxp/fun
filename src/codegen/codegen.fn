  assert equals(st.out.build(), "(Empty){0}"), "expected '(Empty){0}'";
}

test "emit_expr resolves a bare '.{ field = value, ... }' compound literal against expected_compound_type" {
  // A bare `.{ is_pointer = false, ... }` form carries no dtype of its
  // own, so it needs `expected_compound_type`, set by `emit_expr`'s `=`
  // case from the left-hand side's resolved field type, to know which
  // struct to emit.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.expected_compound_type = "DataTypeFlags";

  CompoundInitField f1;
  f1.name = "is_pointer";
  Node* v1 = malloc(sizeof(Node));
  *v1 = node_new(.Boolean(false));
  f1.value = v1;

  CompoundInitNode ci = compound_init_node_new();
  ci.has_dtype = false;
  ci.fields.push(f1);
  Node n = node_new(.CompoundInit(ci));

  assert g.emit_expr(n).is_none(), "expected the bare compound literal to emit";
  assert equals(st.out.build(), "(DataTypeFlags){.is_pointer = false}"), "expected 'DataTypeFlags' resolved from expected_compound_type, not a written-out type name";
}

test "emit_expr rejects a bare '.{...}' compound literal with no expected_compound_type in context" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  // `expected_compound_type` is left empty: no ambient context.

  CompoundInitNode ci = compound_init_node_new();
  ci.has_dtype = false;
  Node n = node_new(.CompoundInit(ci));

  assert g.emit_expr(n).is_some(), "expected a bare compound literal with no ambient expected type to be rejected, not guessed";
}

test "emit_statement resolves a bare '.{...}' compound-literal assignment right-hand side against the field's declared type" {
  // The full shape, `dt.flags = .{is_pointer = false, ...};` as an
  // assignment statement, exercising the `resolve_field_chain` wiring in
  // `emit_expr`'s `=` case rather than a pre-set expected type.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("dt", "DataType", false);

  Vec<str> field_names;
  field_names.init(0);
  field_names.push("flags");
  Vec<str> field_types;
  field_types.init(0);
  field_types.push("DataTypeFlags");
  Vec<bin> field_ptrs;
  field_ptrs.init(0);
  field_ptrs.push(false);
  g.record_compound("DataType", field_names, field_types, field_ptrs);

  Node* dt_ident = malloc(sizeof(Node));
  *dt_ident = node_new(.Identifier("dt"));
  Node* flags_ident = malloc(sizeof(Node));
  *flags_ident = node_new(.Identifier("flags"));
  ExprNode field_e = expr_node_new();
  field_e.left = dt_ident;
  field_e.has_left = true;
  field_e.right = flags_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_node = malloc(sizeof(Node));
  *field_node = node_new(.Expression(field_e));

  CompoundInitField f1;
  f1.name = "is_pointer";
  Node* v1 = malloc(sizeof(Node));
  *v1 = node_new(.Boolean(false));
  f1.value = v1;
  CompoundInitNode ci = compound_init_node_new();
  ci.has_dtype = false;
  ci.fields.push(f1);
  Node* ci_node = malloc(sizeof(Node));
  *ci_node = node_new(.CompoundInit(ci));

  ExprNode assign = expr_node_new();
  assign.left = field_node;
  assign.has_left = true;
  assign.right = ci_node;
  assign.has_right = true;
  assign.op = "=";
  Node n = node_new(.Expression(assign));

  assert g.emit_statement(n).is_none(), "expected the assignment statement to emit";
  assert equals(st.out.build(), "(dt.flags = (DataTypeFlags){.is_pointer = false});\n"), "expected 'DataTypeFlags' resolved from the field's own declared type";
}

test "emit_expr emits a chained field access followed by indexing (self.data[i])" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "Vec", true);

  Vec<str> vec_fields;
  vec_fields.init(0);
  vec_fields.push("data");
  Vec<str> vec_field_types;
  vec_field_types.init(0);
  vec_field_types.push("str");
  Vec<bin> vec_field_ptrs;
  vec_field_ptrs.init(0);
  vec_field_ptrs.push(true);
  g.record_compound("Vec", vec_fields, vec_field_types, vec_field_ptrs);

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(.Identifier("self"));
  Node* data_ident = malloc(sizeof(Node));
  *data_ident = node_new(.Identifier("data"));
  ExprNode dot = expr_node_new();
  dot.left = self_ident;
  dot.has_left = true;
  dot.right = data_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(.Expression(dot));

  Node* i_ident = malloc(sizeof(Node));
  *i_ident = node_new(.Identifier("i"));
  Node* bracket_inner = malloc(sizeof(Node));
  *bracket_inner = node_new(.Bracket(i_ident));
  ExprNode idx = expr_node_new();
  idx.left = dot_node;
  idx.has_left = true;
  idx.right = bracket_inner;
  idx.has_right = true;
  idx.op = "[]";
  Node n = node_new(.Expression(idx));

  assert g.emit_expr(n).is_none(), "expected 'self.data[i]' to emit";
  assert equals(st.out.build(), "self->data[i]"), "expected 'self->data[i]', deciding '->' from self's own pointer-ness";
}

