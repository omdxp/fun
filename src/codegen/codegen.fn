test "emit_statement resolves a bare-shorthand assignment right-hand side against the field's declared type" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("t", "Token", true);

  Vec<str> token_fields;
  token_fields.init(0);
  token_fields.push("data");
  Vec<str> token_field_types;
  token_field_types.init(0);
  token_field_types.push("TokenData");
  Vec<bin> token_field_ptrs;
  token_field_ptrs.init(0);
  token_field_ptrs.push(false);
  g.record_compound("Token", token_fields, token_field_types, token_field_ptrs);

  Vec<str> variants;
  variants.init(0);
  variants.push("Cval");
  variants.push("Num");
  g.record_enum("TokenData", variants, true);

  // `t.data = .Cval(0);`: `t` is a pointer local, so the left side
  // needs `->`.
  Node* t_ident = malloc(sizeof(Node));
  *t_ident = node_new(.Identifier("t"));
  Node* data_ident = malloc(sizeof(Node));
  *data_ident = node_new(.Identifier("data"));
  ExprNode lhs_dot = expr_node_new();
  lhs_dot.left = t_ident;
  lhs_dot.has_left = true;
  lhs_dot.right = data_ident;
  lhs_dot.has_right = true;
  lhs_dot.op = ".";
  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(.Expression(lhs_dot));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(.Identifier("Cval"));
  Node* zero = malloc(sizeof(Node));
  *zero = node_new(.Number(.Num(0)));
  Node* zero_args = malloc(sizeof(Node));
  *zero_args = node_new(.ExpressionParenthesis(zero));
  ExprNode rhs_dot = expr_node_new();
  rhs_dot.left = blank;
  rhs_dot.has_left = true;
  rhs_dot.right = variant_ident;
  rhs_dot.has_right = true;
  rhs_dot.op = ".";
  Node* rhs_callee = malloc(sizeof(Node));
  *rhs_callee = node_new(.Expression(rhs_dot));
  ExprNode rhs_call = expr_node_new();
  rhs_call.left = rhs_callee;
  rhs_call.has_left = true;
  rhs_call.right = zero_args;
  rhs_call.has_right = true;
  rhs_call.op = "()";
  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(.Expression(rhs_call));

  ExprNode assign = expr_node_new();
  assign.left = lhs;
  assign.has_left = true;
  assign.right = rhs;
  assign.has_right = true;
  assign.op = "=";
  Node n = node_new(.Expression(assign));

  assert g.emit_statement(n).is_none(), "expected the assignment to emit, resolving the shorthand against 'data's declared type";
  assert equals(
    st.out.build(),
    "(t->data = ((TokenData){ .tag = TokenData_Cval, .payload.Cval = { ._0 = (0) } }));\n"
  ), "expected the bare '.Cval(0)' resolved against TokenData, not rejected";
}

test "emit_expr resolves a bare-shorthand equality comparison's right-hand side against the field's declared type" {
  // `self.kind == .None` puts a bare shorthand in a nested
  // sub-expression, the right operand of `==`, rather than directly in a
  // `ret` value or initializer, and it still needs an expected type.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "Error", true);

  Vec<str> error_fields;
  error_fields.init(0);
  error_fields.push("kind");
  Vec<str> error_field_types;
  error_field_types.init(0);
  error_field_types.push("ErrorKind");
  Vec<bin> error_field_ptrs;
  error_field_ptrs.init(0);
  error_field_ptrs.push(false);
  g.record_compound("Error", error_fields, error_field_types, error_field_ptrs);

  Vec<str> variants;
  variants.init(0);
  variants.push("None");
  variants.push("Io");
  g.record_enum("ErrorKind", variants, false);

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(.Identifier("self"));
  Node* kind_ident = malloc(sizeof(Node));
  *kind_ident = node_new(.Identifier("kind"));
  ExprNode lhs_dot = expr_node_new();
  lhs_dot.left = self_ident;
  lhs_dot.has_left = true;
  lhs_dot.right = kind_ident;
  lhs_dot.has_right = true;
  lhs_dot.op = ".";
  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(.Expression(lhs_dot));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(.Identifier("None"));
  ExprNode rhs_dot = expr_node_new();
  rhs_dot.left = blank;
  rhs_dot.has_left = true;
  rhs_dot.right = variant_ident;
  rhs_dot.has_right = true;
  rhs_dot.op = ".";
  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(.Expression(rhs_dot));

  ExprNode eq = expr_node_new();
  eq.left = lhs;
  eq.has_left = true;
  eq.right = rhs;
  eq.has_right = true;
  eq.op = "==";
  Node n = node_new(.Expression(eq));

  assert g.emit_expr(n).is_none(), "expected 'self.kind == .None' to resolve the shorthand against 'kind's declared type";
  assert equals(st.out.build(), "(self->kind == ErrorKind_None)"), "expected the bare '.None' resolved against ErrorKind (a plain, non-tagged-union enum), not rejected";
}

test "pub transpile resolves a bare-shorthand call argument against the callee's own declared parameter type" {
  // A bare shorthand passed as a call argument resolves against the
  // callee's declared parameter type at that position, recorded by
  // `register_function_signatures`'s whole-program pre-pass.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Vec<str> variants;
  variants.init(0);
  variants.push("None");
  variants.push("Parse");
  g.record_enum("ErrorKind", variants, false);

  DataType* kind_dt = malloc(sizeof(DataType));
  *kind_dt = dtype_new();
  kind_dt.type_str = "ErrorKind";
  VariableNode kindv;
  kindv.var_type = kind_dt;
  kindv.name = "kind";
  kindv.has_val = false;
  kindv.is_const = false;
  Node* kind_param = malloc(sizeof(Node));
  *kind_param = node_new(.Variable(kindv));

  Vec<Node*> params;
  params.init(0);
  params.push(kind_param);

  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(.Body(bn));

  FunctionNode takesfn = function_node_new();
  takesfn.name = "takes_kind";
  takesfn.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "void";
  rtype.kind = .Void;
  takesfn.rtype = rtype;
  takesfn.has_rtype = true;
  takesfn.args = params;
  takesfn.has_args = true;
  takesfn.body = body;
  takesfn.has_body = true;
  Node takes_node = node_new(.Function(takesfn));

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(.Identifier("takes_kind"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(.Identifier("Parse"));
  ExprNode shorthand = expr_node_new();
  shorthand.left = blank;
  shorthand.has_left = true;
  shorthand.right = variant_ident;
  shorthand.has_right = true;
  shorthand.op = ".";
  Node* shorthand_node = malloc(sizeof(Node));
  *shorthand_node = node_new(.Expression(shorthand));
  Node* args = malloc(sizeof(Node));
  *args = node_new(.ExpressionParenthesis(shorthand_node));

  ExprNode call_e = expr_node_new();
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(.Expression(call_e));
  Node* call_ret_stmt = malloc(sizeof(Node));
  *call_ret_stmt = node_new(.StatementReturn(call_node));
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(call_ret_stmt);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "num";
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(takes_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert contains(st.out.build(), "return takes_kind(ErrorKind_Parse);"), "expected the bare '.Parse' resolved against takes_kind's own declared 'kind' parameter type";
}

test "pub transpile monomorphizes a generic function from its own call site, inferring T from a literal argument" {
  // `err_kind<T>(...) Result<T, Error>` is generic, so its bare `T` must
  // never reach the output as a literal C type.
  // `maybe_instantiate_generic_function` infers each type param from the
  // call's arguments, monomorphizes under a mangled name, and rewrites
  // the call to use it.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "T";
  VariableNode pv;
  pv.var_type = pdt;
  pv.name = "value";
  pv.has_val = false;
  pv.is_const = false;
  Node* param = malloc(sizeof(Node));
  *param = node_new(.Variable(pv));
  Vec<Node*> params;
  params.init(0);
  params.push(param);

  Node* val_ident = malloc(sizeof(Node));
  *val_ident = node_new(.Identifier("value"));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(.StatementReturn(val_ident));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(.Body(bn));

  FunctionNode idfn = function_node_new();
  idfn.name = "identity";
  idfn.has_name = true;
  DataType* idrt = malloc(sizeof(DataType));
  *idrt = dtype_new();
  idrt.type_str = "T";
  idfn.rtype = idrt;
  idfn.has_rtype = true;
  idfn.type_params.push("T");
  idfn.has_type_params = true;
  idfn.args = params;
  idfn.has_args = true;
  idfn.body = body;
  idfn.has_body = true;
  Node id_node = node_new(.Function(idfn));

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(.Identifier("identity"));
  Node* arg = malloc(sizeof(Node));
  *arg = node_new(.Number(.Num(5)));
  Node* args_node = malloc(sizeof(Node));
  *args_node = node_new(.ExpressionParenthesis(arg));
  ExprNode call_e = expr_node_new();
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args_node;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(.Expression(call_e));
  Node* main_ret = malloc(sizeof(Node));
  *main_ret = node_new(.StatementReturn(call_node));
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(main_ret);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "num";
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(id_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert equals(
    st.out.build(),
    `#include <stdio.h>
    `#include <stdbool.h>
    `#include <stdint.h>
    `#include <stdarg.h>
    `#include <stdlib.h>
    `#include <string.h>
    `#include <ctype.h>
    `#include <limits.h>
    `static FILE* stdout_stream(void){ return stdout; }
    `static FILE* stderr_stream(void){ return stderr; }
    `static FILE* stdin_stream(void){ return stdin; }
    `#ifdef _WIN32
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#ifndef NOGDI
    `#define NOGDI
    `#endif
    `#include <windows.h>
    `static int setenv(const char* name, const char* value, int overwrite) {
    `  if (!overwrite && getenv(name) != NULL) { return 0; }
    `  return _putenv_s(name, value);
    `}
    `static int unsetenv(const char* name) { return _putenv_s(name, ""); }
    `static void __fun_sleep_seconds(double seconds) {
    `  if (seconds < 0) seconds = 0;
    `  Sleep((DWORD)(seconds * 1000.0));
    `}
    `#ifndef __MINGW32__
    `#ifndef __fun_clock_gettime_defined
    `#define __fun_clock_gettime_defined
    `static long long clock_gettime(long long clk_id, void* tp) {
    `  (void)clk_id;
    `  if (!tp) return -1;
    `  long long* __fun_cgt_out = (long long*)tp;
    `  FILETIME __fun_cgt_ft;
    `  GetSystemTimeAsFileTime(&__fun_cgt_ft);
    `  unsigned long long __fun_cgt_t = ((unsigned long long)__fun_cgt_ft.dwHighDateTime << 32) | __fun_cgt_ft.dwLowDateTime;
    `  __fun_cgt_t -= 116444736000000000ULL;
