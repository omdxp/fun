}

test "emit_statement emits a fit over a '*self'-dereferenced subject using '->'" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "Opt", true);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Opt", variants, true);

  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "*";
  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(.Identifier("self"));
  u.operand = self_ident;
  u.has_indirection = true;
  u.indirection_depth = 1;
  Node* subj = malloc(sizeof(Node));
  *subj = node_new(.Unary(u));

  // `.Some(r) -> { ret r; }`, a bare shorthand resolved against "self"'s
  // recorded local type ("Opt"), same as a plain-identifier subject.
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(.Identifier("Some"));
  ExprNode dot = expr_node_new();
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(.Expression(dot));

  Node* ret_r = malloc(sizeof(Node));
  *ret_r = node_new(.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_r);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;
  br.bindings.push("r");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(.StatementFit(f));
  assert g.emit_statement(n).is_none(), "expected the '*self' fit to emit";
  assert equals(
    st.out.build(),
    `if (self->tag == Opt_Some) {
    `    __auto_type r = self->payload.Some._0;
    `    return;
    `}
    ``
  ), "expected 'self->tag'/'self->payload' (arrow, not dot)";
}

test "emit_statement emits a fit over a chained field-access subject" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("t", "Wrapper", false);

  Vec<str> wrapper_fields;
  wrapper_fields.init(0);
  wrapper_fields.push("data");
  Vec<str> wrapper_field_types;
  wrapper_field_types.init(0);
  wrapper_field_types.push("Opt");
  Vec<bin> wrapper_field_ptrs;
  wrapper_field_ptrs.init(0);
  wrapper_field_ptrs.push(false);
  g.record_compound("Wrapper", wrapper_fields, wrapper_field_types, wrapper_field_ptrs);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Opt", variants, true);

  Node* t_ident = malloc(sizeof(Node));
  *t_ident = node_new(.Identifier("t"));
  Node* data_ident = malloc(sizeof(Node));
  *data_ident = node_new(.Identifier("data"));
  ExprNode subj_dot = expr_node_new();
  subj_dot.left = t_ident;
  subj_dot.has_left = true;
  subj_dot.right = data_ident;
  subj_dot.has_right = true;
  subj_dot.op = ".";
  Node* subj = malloc(sizeof(Node));
  *subj = node_new(.Expression(subj_dot));

  // `.None -> { ret; }`: bare shorthand resolved against the chained
  // subject's resolved type ("Opt"), not just a plain identifier's.
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(.Identifier("None"));
  ExprNode dot = expr_node_new();
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(.Expression(dot));

  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(.StatementFit(f));
  assert g.emit_statement(n).is_none(), "expected the chained-subject fit to emit";
  assert equals(st.out.build(), `if (t.data.tag == Opt_None) {
  `    return;
  `}
  ``), "expected the chain text 't.data' reused as the fit subject";
}

