// Parser-relevant compile state: the token stream and cursor, output
// node storage, scope/symbol tracking, the cross-module duplicate-symbol
// registry, and the current diagnostic position.

imp ..ast.ast;
imp ..lexer.token;
imp ..semantics.scope;
imp ..semantics.symbol;
imp std.vec;
imp std.map;
imp std.string;
imp std.c.mem;

// Tracks a public symbol's declaring file, to detect cross-module name
// collisions. Only public symbols are recorded. `is_compound`
// additionally lets `is_known_compound_symbol` recognize a compound
// declared in an imported file, not just one already declared earlier
// in the same file.
pub compound GlobalSymbolInfo {
  str symbol_name;
  str file_path;
  bin is_function;
  bin is_public;
  bin is_compound;
}

pub fun global_symbol_info_new(str symbol_name, str file_path) GlobalSymbolInfo {
  GlobalSymbolInfo g;
  g.symbol_name = symbol_name;
  g.file_path = file_path;
  g.is_function = false;
  g.is_public = true;
  g.is_compound = false;
  ret g;
}

// All state a parse of a single file needs, from raw tokens down to the
// scope/symbol tables built up as declarations are parsed.
pub compound ParseState {
  // Token stream and read cursor. `pindex` is the index of the next token a
  // peek/advance will return.
  Vec<Token> tokens;
  num pindex;

  // The most recently peeked/advanced-to token, used by `err` to attach a
  // precise source span to a diagnostic.
  Token current_token;
  bin has_current_token;

  // Diagnostic position used when no `current_token` is available yet (e.g.
  // before the first token is read).
  Pos pos;

  // Output AST node storage. Append-only; nodes reference each other via
  // `Node*` pointers obtained at construction time, never by index into this.
  Vec<Node> nodes;

  str input_file_path;
  str input_source;

  // Scope tracking.
  Scope* scope_root;
  bin has_scope_root;
  Scope* scope_current;
  bin has_scope_current;

  // The symbol table currently receiving new declarations, plus every table
  // created so far during this parse (one per module/import, mirroring the
  // original).
  SymbolTable* active_table;
  bin has_active_table;
  Vec<SymbolTable*> tables;

  // Cross-module duplicate-symbol detection (see `register_symbol`).
  Map<str, GlobalSymbolInfo> global_symbols;

  // Gates `err()`'s stderr output; set false by tests that expect a clean
  // parse failure without polluting test output.
  bin emit_stderr;
}

pub fun parse_state_new(str input_file_path, str input_source) ParseState {
  ParseState p;
  p.tokens.init(0);
  p.pindex = 0;
  p.has_current_token = false;
  p.pos.line = 1;
  p.pos.col = 1;
  p.pos.start_col = 1;
  p.pos.end_col = 1;
  p.pos.end_line = 1;
  p.pos.filename = input_file_path;
  p.nodes.init(0);
  p.input_file_path = input_file_path;
  p.input_source = input_source;
  p.scope_root = nil;
  p.has_scope_root = false;
  p.scope_current = nil;
  p.has_scope_current = false;
  // The file's own top-level symbol table, active from construction --
  // matches the original's `TranspileProcess` constructor, which sets
  // `symbols.active_table` up front rather than lazily. `push_symbol`
  // (called by declaration parsers like `parse_compound`) assumes an
  // active table always exists, with no nil check of its own.
  p.tables.init(0);
  SymbolTable* initial_table = malloc(sizeof(SymbolTable));
  *initial_table = symbol_table_new(input_file_path);
  p.active_table = initial_table;
  p.has_active_table = true;
  p.tables.push(initial_table);
  p.global_symbols.init(8);
  p.emit_stderr = true;
  ret p;
}
