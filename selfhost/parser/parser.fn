  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "*"), "expected op '*'";
      assert u.has_indirection, "expected indirection info to be set";
      assert u.indirection_depth == 2, "expected indirection depth 2";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "p"), "expected operand 'p'"; }
        _ -> { panic("expected Identifier 'p'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

