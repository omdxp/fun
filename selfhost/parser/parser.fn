// The self-hosted Fun compiler's parser: turns a token stream into an AST.
// Ported from the previous implementation's parser module.
// 
// This is an early, partial slice of the port: token-cursor navigation,
// diagnostic reporting, and node/scope-entity construction -- the layer
// every actual statement/expression parsing function builds on. The
// statement and expression parsing functions themselves (the bulk of the
// original's ~6,600 lines) are ported incrementally in later sessions; see
// `parse_state.fn` for why the parser gets its own minimal state container
// instead of reusing the full original `TranspileProcess`.
// 
// Deliberately deferred from this slice (documented rather than silently
// dropped):
// - The O(1) significant-token lookahead cache (`sig_indices`/
// `phys_to_rank` in the original) -- `token_peek_n` here always does the
// linear scan the original falls back to when the cache is stale. Safe:
// the original's own comment confirms the linear path is always correct,
// just slower; revisit only if parse time on large files becomes a
// problem.
// - `forward_type_names` pre-scan (forward-declared-type detection for the
// compound-initializer disambiguator) -- not needed until the statement
// parser reaches that disambiguation, so it is deferred to that slice.
// - `deinit_node`/`deinit_root_scope` (manual arena cleanup) -- the
// original frees an arena once per whole compile; a self-hosted `fun`
// invocation is a short-lived process, so nothing here frees per-node
// memory either, matching the same "let the OS reclaim on exit" choice
// already made throughout `stdlib`'s own C bindings usage.
// 
// Known compiler gap worked around throughout this file (and worth fixing
// upstream separately): chaining a further `.field` access directly onto a
// `Vec<T*>.get(...)` call (`vec.get(i).field`) can emit `.` instead of `->`
// for the outer access and fail to compile, because the codegen path that
// picks `.`/`->` doesn't fully resolve a generic method call's monomorphized
// return type through the receiver's type args in every shape. Binding the
// call result to a `let` first (`let x = vec.get(i); x.field`) always works
// and reads at least as clearly, so that's the convention used here.

imp parse_state;
imp datatype_defs;
imp expressionable_defs;
imp ..ast.ast;
imp ..lexer.token;
imp ..lexer.lexer;
imp ..semantics.scope;
imp ..semantics.symbol;
imp std.vec;
imp std.string;
imp std.option;
imp std.io;
imp std.c.io;
imp std.c.mem;

// Errors the parser can report. Mirrors the original's `ParseError` set
// (its `TranspileError`/`LexError` members are not included here since
// those belong to modules not yet ported).
pub enum ParseErrorKind {
  InvalidSymbol,
  InvalidKeyword,
  InvalidDataType,
  InvalidToken,
  InvalidIdentifier,
  InvalidOperand,
  InvalidStatement,
  InvalidString,
  // Note: in the original this specific member actually comes from
  // `LexError`, not `ParseError` (its `ParseError || TranspileError ||
  // LexError` union just makes it usable from parser code too) -- folded
  // into this single enum along with everything else regardless of which
  // original error set it came from, since this port doesn't replicate
  // that three-way split.
  InvalidExpression,
}

impl ParseState {
  // Logs a diagnostic with the current position in the token stream.
  // 
  // Params:
  // - msg: the already-formatted diagnostic message (build it with
  // `std.io.format` before calling, since Fun's varargs sugar is meant
  // for `{placeholder}`-style formatting, not passthrough to `fprintf`)
  pub err(str msg) {
    if !self.emit_stderr {
      ret;
    }
    let out = stderr_stream();
    fprintf(out, "%s", "\n[Error]\n");
    fprintf(out, "%s", msg);
    if self.has_current_token {
      let ct = self.current_token;
      num end_line = ct.pos.end_line;
      if end_line == 0 {
        end_line = ct.pos.line;
      }
      if end_line == ct.pos.line {
        let loc = format(
          "\nLocation: {str}:{num}:{num}-{num}\n",
          ct.pos.filename,
          ct.pos.line,
          ct.pos.start_col,
          ct.pos.end_col
        );
        defer free(loc);
        fprintf(out, "%s", loc);
      } else {
        let loc = format(
          "\nLocation: {str}:{num}:{num}-{num}:{num}\n",
          ct.pos.filename,
          ct.pos.line,
          ct.pos.start_col,
          end_line,
          ct.pos.end_col
        );
        defer free(loc);
        fprintf(out, "%s", loc);
      }
    } else {
      let loc = format(
        "\nLocation: {str}:{num}:{num}\n",
        self.pos.filename,
        self.pos.line,
        self.pos.col
      );
      defer free(loc);
      fprintf(out, "%s", loc);
    }
  }

  // Returns the token at the cursor without advancing, or `.None` past the
  // end of the stream.
  pub tokens_peek_no_increment() Option<Token> {
    ret self.tokens.at(self.pindex);
  }

  // Returns the token at the cursor and advances past it. Returns `.None`
  // (cursor unchanged) past the end of the stream.
  pub tokens_peek() Option<Token> {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        self.pindex = self.pindex + 1;
        ret .Some(t);
      }
      .None -> { ret .None; }
    }
  }

  // Un-reads the most recently peeked token (moves the cursor back by one).
  pub tokens_pop_last_peek() {
    if self.pindex > 0 {
      self.pindex = self.pindex - 1;
    }
  }

  // Advances the cursor past any run of newline/comment/`\` tokens.
  pub skip_nl_or_comment() {
    for {
      fit self.tokens_peek_no_increment() {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            ret;
          }
          self.tokens_peek();
        }
        .None -> { ret; }
      }
    }
  }

  // Peeks at the next significant (non newline/comment) token without
  // consuming it. Updates `current_token` as a side effect, matching the
  // original -- diagnostics reported right after a peek still point at the
  // right place.
  pub token_peek_next() Option<Token> {
    self.skip_nl_or_comment();
    let pk = self.tokens_peek_no_increment();
    fit pk {
      .Some(t) -> {
        self.current_token = t;
        self.has_current_token = true;
      }
      .None -> { self.has_current_token = false; }
    }
    ret pk;
  }

  // Peeks at the n-th significant token at or after the cursor without
  // consuming anything (`n = 0` is equivalent to `token_peek_next`, minus
  // the `current_token` side effect).
  pub token_peek_n(num n) Option<Token> {
    num idx = self.pindex;
    num seen = 0;
    for {
      fit self.tokens_at(idx) {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            if seen == n {
              ret .Some(t);
            }
            seen = seen + 1;
          }
          idx = idx + 1;
        }
        .None -> { ret .None; }
      }
    }
  }

  pub tokens_at(num idx) Option<Token> {
    ret self.tokens.at(idx);
  }

  // Consumes and returns the next significant token, recording it as both
  // the current diagnostic position and `current_token`.
  pub token_next() Option<Token> {
    self.skip_nl_or_comment();
    fit self.tokens_peek_no_increment() {
      .Some(t) -> { self.pos = t.pos; }
      .None -> {}
    }
    let consumed = self.tokens_peek();
    fit consumed {
      .Some(t) -> {
        self.current_token = t;
        self.has_current_token = true;
      }
      .None -> { self.has_current_token = false; }
    }
    ret consumed;
  }

  // True if the next significant token is an `Operator` with text `op`,
  // without consuming it.
  pub next_token_is_operator(str op) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_operator(t, op); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token is the `Keyword` `keyword`, without
  // consuming it.
  pub next_token_is_keyword(str keyword) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_keyword(t, keyword); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token is the `Symbol` `c`, without
  // consuming it.
  pub next_token_is_symbol(chr c) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_symbol(t, c); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token opens a generic-argument list: a
  // `<` (as an `Operator`, the common case, or a lexed `Symbol` in the rare
  // context where it wasn't combined into a longer operator).
  pub next_token_is_angle_open() bin {
    fit self.token_peek_next() {
      .Some(t) -> {
        fit t.type {
          .Operator -> {
            fit t.data {
              .Sval(s) -> { ret len(s) > 0 && s[0] == '<'; }
              _ -> { ret false; }
            }
          }
          .Symbol -> {
            fit t.data {
              .Cval(c) -> { ret c == '<'; }
              _ -> { ret false; }
            }
          }
          _ -> { ret false; }
        }
      }
      .None -> { ret false; }
    }
  }

  // Splits a lexed `>>` token in place into two adjacent `>` tokens, if the
  // next significant token is one. Needed so nested generics (`Vec<Vec<num>>`)
  // parse correctly: the lexer has no way to know `>>` here is two closing
  // angle brackets rather than the right-shift operator, since that
  // depends on the surrounding PARSE context, not just the characters.
  pub split_angle_closer_token_if_needed() {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        if t.type != TokenType.Operator {
          ret;
        }
        bin is_shr = false;
        fit t.data {
          .Sval(s) -> { is_shr = equals(s, ">>"); }
          _ -> {}
        }
        if !is_shr {
          ret;
        }
        Token first = t;
        first.data = TokenData.Sval(">");
        self.tokens.set(self.pindex, first);
        Token second = t;
        second.data = TokenData.Sval(">");
        self.tokens.insert(self.pindex + 1, second);
      }
      .None -> {}
    }
  }

  // Splits a lexed `<<` token in place into two adjacent `<` tokens, if the
  // next significant token is one. The opening-bracket counterpart to
  // `split_angle_closer_token_if_needed`, needed for the same reason when a
  // generic-argument list itself starts right after another `<`
  // (`Map<str, Vec<<T>>` style contexts do not arise from ordinary source,
  // but a `<<` can appear immediately before a nested generic's own opener
  // when the outer angle bracket was itself just split from a longer run).
  pub split_angle_opener_token_if_needed() {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        if t.type != TokenType.Operator {
          ret;
        }
        bin is_shl = false;
        fit t.data {
          .Sval(s) -> { is_shl = equals(s, "<<"); }
          _ -> {}
        }
        if !is_shl {
          ret;
        }
        Token first = t;
        first.data = TokenData.Sval("<");
        self.tokens.set(self.pindex, first);
        Token second = t;
        second.data = TokenData.Sval("<");
        self.tokens.insert(self.pindex + 1, second);
      }
      .None -> {}
    }
  }

  // Counts and consumes a run of `*` pointer-depth markers after a type
  // name (`num**` -> depth 2).
  pub parse_get_pointer_depth() num {
    num depth = 0;
    for self.next_token_is_operator("*") {
      depth = depth + 1;
      self.token_next();
    }
    ret depth;
  }

  // Resolves the n-th significant token strictly before physical index
  // `exclusive_end` (n = 0 -> the closest one). Always a linear backward
  // scan -- see the file-level note on the deferred O(1) lookahead cache.
  pub token_peek_prev_significant(num exclusive_end, num n) Option<Token> {
    num idx = exclusive_end - 1;
    num seen = 0;
    for idx >= 0 {
      fit self.tokens_at(idx) {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            if seen == n {
              ret .Some(t);
            }
            seen = seen + 1;
          }
        }
        .None -> { ret .None; }
      }
      idx = idx - 1;
    }
    ret .None;
  }

  // Peeks the previous non-skippable token (relative to the most recently
  // consumed token).
  pub token_peek_prev() Option<Token> {
    ret self.token_peek_prev_significant(self.pindex - 1, 0);
  }

  // Peeks the n-th previous non-skippable token (relative to the most
  // recently consumed token). `n = 0` is equivalent to `token_peek_prev`.
  pub token_peek_prev_n(num n) Option<Token> {
    ret self.token_peek_prev_significant(self.pindex - 1, n);
  }

  // Peeks the n-th previous non-skippable token relative to the NEXT token
  // to be consumed (i.e. what `token_peek_next` would return sits at
  // `self.pindex`; this looks backward from `pindex - 1`, `pindex - 2`, ...).
  // Often the more intuitive notion of "previous" for context-sensitive
  // parsing that hasn't consumed the token it's inspecting yet.
  pub token_peek_prev_stream_n(num n) Option<Token> {
    ret self.token_peek_prev_significant(self.pindex, n);
  }

  // Expects the next significant token to be the symbol `c`. Reports and
  // returns an error if it is anything else.
  pub expect_sym(chr c) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> {
        if t.type == TokenType.Symbol {
          fit t.data {
            .Cval(v) -> { matched = v == c; }
            _ -> {}
          }
        }
      }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected symbol '{chr}'", c);
    defer free(msg);
    self.err(msg);
    ret .Some(ParseErrorKind.InvalidSymbol);
  }

  // Expects the next significant token to be the operator `op`. Reports and
  // returns an error if it is anything else.
  pub expect_op(str op) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> { matched = token_is_operator(t, op); }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected operator '{str}'", op);
    defer free(msg);
    self.err(msg);
    ret .Some(ParseErrorKind.InvalidOperand);
  }

  // Expects the next significant token to be the keyword `keyword`. Reports
  // and returns an error if it is anything else.
  pub expect_keyword(str keyword) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> { matched = token_is_keyword(t, keyword); }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected keyword '{str}'", keyword);
    defer free(msg);
    self.err(msg);
    ret .Some(ParseErrorKind.InvalidKeyword);
  }

  // Retrieves a symbol by name from the active symbol table.
  pub get_symbol(str name) Option<Symbol> {
    if !self.has_active_table {
      ret .None;
    }
    num i = 0;
    let tbl = self.active_table;
    for i < tbl.symbols.len {
      let s = tbl.symbols.get(i);
      if equals(s.name, name) {
        ret .Some(s);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Adds `s` to the active symbol table.
  pub push_symbol(Symbol s) {
    self.active_table.symbols.push(s);
  }

  // Registers a scope entity in the current scope.
  pub push_scope_entity(ScopeEntity* entity) {
    self.scope_current.entities.push(entity);
  }

  // Looks up a scope entity by name, starting at the current scope and
  // walking up to (but not including) the global/root scope.
  pub get_scope_entity(str name) ScopeEntity* {
    let s = self.scope_current;
    for s != nil {
      let found = s.get_entity_by_name(name);
      if found != nil {
        ret found;
      }
      if !s.has_parent {
        ret nil;
      }
      s = s.parent;
    }
    ret nil;
  }

  // Walks up the current scope chain for the last-declared entity, stopping
  // at (not including) `stop_scope`.
  pub last_scope_entity_stop_at(Scope* stop_scope) ScopeEntity* {
    ret self.scope_current.last_entity_from_scope_stop_at(stop_scope);
  }

  // Pops and returns the last node pushed onto the output node list, or
  // `.None` if it's empty. Expression/statement parsing composes larger
  // nodes by popping their already-parsed children back off this list, the
  // same node-stack discipline the original uses throughout.
  pub node_pop() Option<Node> {
    if self.nodes.len == 0 {
      ret .None;
    }
    ret .Some(self.nodes.pop());
  }

  // Returns the last node WITHOUT popping it, or `.None` if empty.
  pub node_peek_last() Option<Node> {
    ret self.nodes.last();
  }

  // Establishes the root/global scope. Called once, before parsing the
  // first top-level declaration.
  pub init_root_scope() {
    Scope* root = malloc(sizeof(Scope));
    *root = scope_new();
    self.scope_root = root;
    self.has_scope_root = true;
    self.scope_current = root;
    self.has_scope_current = true;
  }

  // Pushes a new child scope (e.g. entering a function/block body), parented
  // to whatever scope was current.
  pub new_scope() {
    Scope* nc = malloc(sizeof(Scope));
    *nc = scope_new();
    if self.has_scope_current {
      nc.parent = self.scope_current;
      nc.has_parent = true;
    }
    self.scope_current = nc;
    self.has_scope_current = true;
  }

  // Pops back to the enclosing scope (e.g. leaving a function/block body).
  // A no-op past the root scope.
  pub finish_scope() {
    if !self.has_scope_current {
      ret;
    }
    let cur = self.scope_current;
    if cur.has_parent {
      self.scope_current = cur.parent;
    } else {
      self.has_scope_current = false;
    }
  }

  // Parses a bracketed generic-argument list (`<T, U>`) into `dt.generic_args`,
  // if the next significant token opens one. A no-op (not an error) when it
  // doesn't, since a type name may simply not be generic.
  // 
  // Deferred from this slice: an array-typed argument (`Vec<num[]>`) --
  // needs `parse_array_brackets`, which needs the expression parser (array
  // sizes are arbitrary expressions), a much later slice. A generic arg
  // that starts with `[` currently falls through to `parse_datatype`
  // reporting `InvalidDataType`, which is the same outcome as any other
  // not-yet-supported syntax in this partial port.
  pub parse_generic_type_args(DataType* dt) Option<ParseErrorKind> {
    self.split_angle_opener_token_if_needed();
    if !self.next_token_is_angle_open() {
      ret .None;
    }
    self.token_next();

    Vec<DataType*> args;
    args.init(0);

    for true {
      DataType* adt = malloc(sizeof(DataType));
      *adt = dtype_new();
      let err = self.parse_datatype(adt);
      if err.is_some() {
        ret err;
      }
      args.push(adt);

      if self.next_token_is_operator(",") {
        self.token_next();
        continue;
      }
      break;
    }

    self.split_angle_closer_token_if_needed();
    if self.next_token_is_operator(">") {
      let err = self.expect_op(">");
      if err.is_some() {
        ret err;
      }
    } else {
      let err = self.expect_sym('>');
      if err.is_some() {
        ret err;
      }
    }
    dt.generic_args = args;
    ret .None;
  }

  // Parses a type annotation into `dt`: a builtin scalar keyword, a
  // user-defined/identifier-based name (optionally alias-qualified,
  // `mod.Type`), its generic arguments if any, then a trailing run of `*`
  // pointer-depth markers.
  // 
  // Deferred from this slice: the `fun(T1, T2) R` function-type parameter
  // form (needs its own arg-list/return-type recursion) and array-bracket
  // suffixes (need the expression parser for array-size expressions) --
  // both are separate later slices, matching the original's own
  // `parse_fn_type_datatype`/`parse_array_brackets` split.
  pub parse_datatype(DataType* dt) Option<ParseErrorKind> {
    let tok = self.token_next();
    if tok.is_none() {
      self.err("expected datatype, got end of input");
      ret .Some(ParseErrorKind.InvalidDataType);
    }
    let dt_token = tok.unwrap();
    if dt_token.type != TokenType.Keyword && dt_token.type != TokenType.Identifier {
      self.err("expected datatype");
      ret .Some(ParseErrorKind.InvalidDataType);
    }

    str name = "";
    fit dt_token.data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    // Builtins use `dt.kind`; user-defined types keep `.Unknown` and rely
    // on `type_str`.
    if dt_token.type == TokenType.Keyword {
      if !keyword_is_datatype(name) {
        self.err(format("unexpected keyword '{str}' in datatype position", name));
        ret .Some(ParseErrorKind.InvalidDataType);
      }
      dt.kind = get_datatype_type(name);
      if dt.kind == DataTypeType.Unknown {
        self.err("unknown datatype");
        ret .Some(ParseErrorKind.InvalidDataType);
      }
    } else {
      // Identifier-based types (e.g. C typedefs like `size_t`, or a
      // user compound/enum) are allowed. A small set of common C typedef
      // names get tagged with a numeric semantic type so arithmetic/
      // comparisons typecheck, while still emitting the original
      // identifier in C via `type_str`.
      let builtin_kind = get_datatype_type(name);
      if builtin_kind != DataTypeType.Unknown {
        dt.kind = builtin_kind;
      } else {
        fit get_c_typedef_alias_datatype_type(name) {
          .Some(k) -> { dt.kind = k; }
          .None -> { dt.kind = .Unknown; }
        }
      }
    }
    dt.type_str = name;

    // Qualified user-defined types via module alias (`imp mod as m; m.Type`).
    // Mangled internally as `a__b` to match symbol/type naming.
    if dt_token.type == TokenType.Identifier {
      for self.next_token_is_operator(".") || self.next_token_is_symbol('.') {
        self.token_next();
        let seg = self.token_next();
        if seg.is_none() || seg.unwrap().type != TokenType.Identifier {
          self.err("expected identifier after '.' in qualified datatype");
          ret .Some(ParseErrorKind.InvalidDataType);
        }
        str seg_name = "";
        fit seg.unwrap().data {
          .Sval(s) -> { seg_name = s; }
          _ -> {}
        }
        dt.kind = .Unknown;
        dt.type_str = format("{str}__{str}", dt.type_str, seg_name);
      }
    }

    let gerr = self.parse_generic_type_args(dt);
    if gerr.is_some() {
      ret gerr;
    }

    let ptr_depth = self.parse_get_pointer_depth();
    if ptr_depth > 0 {
      dt.flags.is_pointer = true;
      dt.pointer_depth = ptr_depth;
    }

    ret .None;
  }
}

// The parser's OWN state, layered on top of the shared `ParseState`: a
// pointer back to that shared state plus the handful of fields that are
// genuinely parser-local (current body/function context for `binded`
// stamping, expression-recursion depth, `fit`-condition tracking). Mirrors
// the original's `ParseProcess` holding a `*TranspileProcess` plus its own
// small field set.
pub compound Parser {
  ParseState* state;

  // The most recently consumed significant token.
  Token last_token;
  bin has_last_token;

  // The body/function node currently being parsed, used to stamp newly
  // created nodes' `binded` context (see `create_node`).
  Node* current_body;
  bin has_current_body;
  Node* current_function;
  bin has_current_function;

  // Current native-recursion depth of the recursive-descent expression
  // parser. See the original's `max_parse_expr_depth` note: guards against
  // stack-overflow crashes on pathological input.
  num expr_depth;

  // True while parsing a `fit` arm CONDITION, where pattern bindings like
  // `Enum.Variant(x, y)` introduce new identifiers not yet in scope.
  bin in_fit_condition;
}

// Creates a new `Parser` over the given shared parse state.
pub fun parser_new(ParseState* state) Parser {
  Parser p;
  p.state = state;
  p.has_last_token = false;
  p.current_body = nil;
  p.has_current_body = false;
  p.current_function = nil;
  p.has_current_function = false;
  p.expr_depth = 0;
  p.in_fit_condition = false;
  ret p;
}

impl Parser {
  // Creates and registers a new node in the parse state's node list,
  // stamping its `binded` owner/function context from whatever body/
  // function is currently being parsed.
  pub create_node(Node* n) {
    BindedNode* binded = nil;
    bin is_bound = false;

    if self.has_current_body {
      Node* owner = malloc(sizeof(Node));
      *owner = *self.current_body;
      owner.has_binded = false;
      owner.binded = nil;
      binded = malloc(sizeof(BindedNode));
      binded.owner = owner;
      binded.has_owner = true;
      binded.function = nil;
      binded.has_function = false;
      is_bound = true;
    }

    if self.has_current_function {
      Node* function = malloc(sizeof(Node));
      *function = *self.current_function;
      function.has_binded = false;
      function.binded = nil;
      if !is_bound {
        binded = malloc(sizeof(BindedNode));
        binded.owner = nil;
        binded.has_owner = false;
      }
      binded.function = function;
      binded.has_function = true;
      is_bound = true;
    }

    if is_bound {
      n.binded = binded;
      n.has_binded = true;
    } else {
      n.binded = nil;
      n.has_binded = false;
    }

    self.state.nodes.push(*n);
  }

  // Consumes the next token and turns it into a single leaf AST node: a
  // number/character literal, an identifier, a string literal, or a
  // boolean literal. Anything else (an operator, a grouping symbol, a
  // keyword, ...) is an error -- this handles exactly the PRIMARY tokens
  // of an expression, not operators or grouping, which belong to the
  // expression parser built on top of this.
  pub parse_single_token_to_node() Option<ParseErrorKind> {
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected token, got eof");
      ret .Some(ParseErrorKind.InvalidToken);
    }
    let t = tok.unwrap();
    fit t.type {
      .Number -> {
        fit t.data {
          .Num(n) -> {
            Node node = node_new(NodeKind.Number(TokenData.Num(n)));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          .Dec(d) -> {
            Node node = node_new(NodeKind.Number(TokenData.Dec(d)));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          // A character literal lexes as a `Number`-type token carrying
          // `Cval` data (see lexer.fn's `_read_char`); it becomes a
          // `Character` AST node here, not a `Number` one.
          .Cval(c) -> {
            Node node = node_new(NodeKind.Character(c));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {
            self.state.err("invalid number token");
            ret .Some(ParseErrorKind.InvalidToken);
          }
        }
      }
      .Identifier -> {
        str name = "";
        fit t.data {
          .Sval(s) -> { name = s; }
          _ -> {}
        }

        let prev = self.state.token_peek_prev();
        bin is_member_access = false;
        fit prev {
          .Some(p) -> { is_member_access = token_is_operator(p, "."); }
          .None -> {}
        }

        // Allow type operands inside `sizeof(Type)` even when the
        // identifier isn't declared as a value symbol yet (supports
        // forward-declared custom types).
        bin is_sizeof_type_operand = false;
        fit prev {
          .Some(p) -> {
            if token_is_operator(p, "(") {
              fit self.state.token_peek_prev_n(1) {
                .Some(p2) -> {
                  if p2.type == TokenType.Identifier {
                    fit p2.data {
                      .Sval(s2) -> { is_sizeof_type_operand = equals(s2, "sizeof"); }
                      _ -> {}
                    }
                  }
                }
                .None -> {}
              }
            }
          }
          .None -> {}
        }

        // `_` is a wildcard identifier (used by `fit` default branches):
        // accepted even when not declared. Otherwise an identifier that
        // isn't a known scope entity/symbol/global symbol is only valid
        // as a member-access target, an ALL_CAPS C-macro-style constant,
        // an out-of-order function call (`foo(...)`), a possible enum
        // member access (`Foo.Bar`), or inside a `fit` condition (where
        // data-carrying-enum pattern bindings aren't in scope yet).
        if !equals(name, "_") {
          if !is_member_access {
            if !is_sizeof_type_operand && self.state.get_scope_entity(name) == nil {
              if self.state.get_symbol(name).is_none() && !self.state.global_symbols.has(name) {
                if !_is_c_macro_ident(name) {
                  bin is_possible_enum_member_access = self.state.next_token_is_operator(".");
                  if !self.state.next_token_is_operator("(") && !is_possible_enum_member_access && !self.in_fit_condition {
                    let msg = format("unknown identifier '{str}'", name);
                    defer free(msg);
                    self.state.err(msg);
                    ret .Some(ParseErrorKind.InvalidIdentifier);
                  }
                }
              }
            }
          }
        }

        Node node = node_new(NodeKind.Identifier(name));
        node.pos = t.pos;
        node.has_pos = true;
        self.create_node(&node);
      }
      .String -> {
        fit t.data {
          .Sval(s) -> {
            Node node = node_new(NodeKind.String(s));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {}
        }
      }
      .Boolean -> {
        fit t.data {
          .Bval(b) -> {
            Node node = node_new(NodeKind.Boolean(b));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {}
        }
      }
      _ -> {
        self.state.err("expected single token");
        ret .Some(ParseErrorKind.InvalidToken);
      }
    }
    ret .None;
  }

  // Builds a binary `Expression` node (`left_node op right_node`) and
  // pushes it via `create_node`. Copies both operands onto the heap so the
  // new node owns stable pointers to them, matching every other
  // node-construction site in this file.
  // 
  // Simplified from the original: takes a required `op_pos` rather than
  // the original's three-way `op_pos orelse left.pos orelse right.pos`
  // fallback, since nothing ported so far ever calls this without a real
  // operator token position. Revisit if a future caller needs the fallback.
  pub make_expression_node(Node* left_node, Node* right_node, str op, Pos op_pos) {
    Node* left = malloc(sizeof(Node));
    *left = *left_node;
    Node* right = malloc(sizeof(Node));
    *right = *right_node;

    ExprNode e;
    e.left = left;
    e.has_left = true;
    e.right = right;
    e.has_right = true;
    e.op = op;

    Node node = node_new(NodeKind.Expression(e));
    node.pos = op_pos;
    node.has_pos = true;
    self.create_node(&node);
  }

  // Rewrites `node = (a op1 (b op2 c))` in place to `((a op1 b) op2 c)`: a
  // left tree rotation used by `parse_reorder_expression` to fix precedence
  // when `op1` should bind tighter than (or equal to) `op2`, but the
  // parser's naive left-to-right build produced the right-heavy shape
  // instead. A no-op when the right child isn't itself an `Expression`
  // (nothing to rotate) or either side is missing.
  // 
  // Structurally identical to `parse_node_move_right_left_to_left` below --
  // the original has the two as separate functions (one additionally frees
  // the detached old right-node shell, which this port doesn't need since
  // nothing here manually frees memory; see the file-level note), called
  // from `parse_reorder_expression`'s two different trigger conditions.
  // Kept as two functions to mirror the original's structure/call sites.
  pub parse_node_shift_children_left(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_right || !exp.has_left {
          ret;
        }
        fit exp.right.kind {
          .Expression(right_exp) -> {
            if !right_exp.has_left || !right_exp.has_right {
              ret;
            }
            ExprNode new_left_e;
            new_left_e.left = exp.left;
            new_left_e.has_left = true;
            new_left_e.right = right_exp.left;
            new_left_e.has_right = true;
            new_left_e.op = exp.op;

            Node* new_left = malloc(sizeof(Node));
            *new_left = node_new(NodeKind.Expression(new_left_e));
            new_left.pos = node.pos;
            new_left.has_pos = true;

            exp.left = new_left;
            exp.right = right_exp.right;
            exp.op = right_exp.op;
            node.kind = NodeKind.Expression(exp);
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // The same `(a op1 (b op2 c))` -> `((a op1 b) op2 c)` rotation as
  // `parse_node_shift_children_left`, used by `parse_reorder_expression`'s
  // OTHER trigger condition (an array-index/call/index left operand paired
  // with an assignment/comma right operand). See that function's doc
  // comment for why this is a separate function despite the identical body.
  pub parse_node_move_right_left_to_left(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_right || !exp.has_left {
          ret;
        }
        fit exp.right.kind {
          .Expression(right_exp) -> {
            if !right_exp.has_left || !right_exp.has_right {
              ret;
            }
            ExprNode completed_e;
            completed_e.left = exp.left;
            completed_e.has_left = true;
            completed_e.right = right_exp.left;
            completed_e.has_right = true;
            completed_e.op = exp.op;

            Node* completed = malloc(sizeof(Node));
            *completed = node_new(NodeKind.Expression(completed_e));
            completed.pos = node.pos;
            completed.has_pos = true;

            exp.left = completed;
            exp.right = right_exp.right;
            exp.op = right_exp.op;
            node.kind = NodeKind.Expression(exp);
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // Recursively reorders `node` (and its descendants) for correct operator
  // precedence, after the naive left-to-right expression build. Two
  // independent fixups:
  // 
  // 1. If the right child is itself an `Expression` and the OUTER operator
  // has priority over the right child's operator (binds tighter, or equal
  // with left-to-right associativity), rotate left via
  // `parse_node_shift_children_left` and recurse into both new children --
  // a single rotation may not be enough for a longer chain (`a + b * c * d`
  // needs two).
  // 2. Independently (not exclusive with the above): if the left operand
  // looks like an array index paired with an assignment on the right
  // (`arr[i] = v` shaped oddly by the naive build), or a call/index operand
  // paired with a comma-expression on the right (multi-arg call/index
  // arguments), apply `parse_node_move_right_left_to_left` to fix that
  // specific shape.
  pub parse_reorder_expression(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_left || !exp.has_right {
          ret;
        }

        bin left_is_expr = _is_expression_kind(exp.left);
        bin right_is_expr = _is_expression_kind(exp.right);
        if !left_is_expr && !right_is_expr {
          ret;
        }

        if right_is_expr {
          fit exp.right.kind {
            .Expression(right_exp) -> {
              if left_has_priority(exp.op, right_exp.op) {
                self.parse_node_shift_children_left(node);
                fit node.kind {
                  .Expression(rotated) -> {
                    self.parse_reorder_expression(rotated.left);
                    self.parse_reorder_expression(rotated.right);
                  }
                  _ -> {}
                }
              }
            }
            _ -> {}
          }
        }

        // Re-read node.kind: the rotation above (if it ran) mutated it.
        fit node.kind {
          .Expression(exp2) -> {
            bin left_is_array = node_is_array(*exp2.left);
            bin right_is_assign = node_is_assignment(*exp2.right);
            bin left_is_call_or_index = node_is_expression(*exp2.left, "()") || node_is_expression(
              *exp2.left,
              "[]"
            );
            bin right_is_comma = node_is_expression(*exp2.right, ",");
            if (left_is_array && right_is_assign) || (left_is_call_or_index && right_is_comma) {
              self.parse_node_move_right_left_to_left(node);
            }
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // The last node on the output list, if it's still a valid expression
  // operand (a literal/identifier/unary/nested-expression -- not, say, a
  // just-finished statement). `.None` when the list is empty or the last
  // node isn't operand-shaped. Used to tell "an operator here continues a
  // left operand already on the stack" (a binary operator) from "an
  // operator here STARTS a new operand" (a prefix/unary position).
  pub node_peek_expressionable() Option<Node> {
    fit self.state.node_peek_last() {
      .Some(n) -> {
        if node_is_expressionable(n) {
          ret .Some(n);
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Parses a single "expressionable" token into a node and pushes it:
  // literals, identifiers, and strings go through `parse_single_token_to_node`;
  // an operator token is handed to `parse_expression` (grouping or a binary
  // continuation). Any other token kind (a keyword, a structural symbol, a
  // newline/comment) is not an error here -- it just means there's nothing
  // (more) to parse at this position, signaled by leaving the output list
  // unchanged (see `parse_expressionable`, which loops on exactly that).
  // 
  // Deliberately simplified from the original for this slice: no unary
  // operators (`-x`, `!x`, `*p`, `&x`, `++x`), no channel operators (`<-`),
  // no enum-variant-shorthand dot-expressions (`.Variant`), no keyword
  // operands (`nil`, `panic(...)`, `await`, `sizeof`). Each is a
  // self-contained follow-up slice once this core binary-expression loop
  // is solid.
  pub parse_expressionable_single() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        // A `fit` arm's comma-separated multi-pattern list only supports
        // string-literal patterns today, not bare enum-variant shorthand
        // (confirmed directly: `.A, .B -> {}` fails to parse where `"a",
        // "b" -> {}` works fine) -- a real language gap, but an unrelated
        // one (lives in the fit-statement grammar, not ported/touched by
        // this slice), so this uses an if/elif chain instead rather than
        // detouring to fix it now.
        if t.type == TokenType.Number || t.type == TokenType.Boolean || t.type == TokenType.Identifier || t.type == TokenType.String {
          ret self.parse_single_token_to_node();
        }
        if t.type == TokenType.Operator {
          ret self.parse_expression();
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Repeatedly parses expressionable tokens until a call makes no further
  // progress (the output list stops growing) or an error occurs.
  pub parse_expressionable() Option<ParseErrorKind> {
    for true {
      num before = self.state.nodes.len;
      let err = self.parse_expressionable_single();
      if err.is_some() {
        ret err;
      }
      if self.state.nodes.len == before {
        ret .None;
      }
    }
  }

  // Like `parse_expressionable`, but requires at least one node to have
  // been produced -- the entry point for a position that MUST be an
  // expression (an initializer, a condition, ...), as opposed to a
  // position where an expression is merely optional.
  pub parse_expressionable_root() Option<ParseErrorKind> {
    num before = self.state.nodes.len;
    let err = self.parse_expressionable();
    if err.is_some() {
      ret err;
    }
    if self.state.nodes.len == before {
      self.state.err("expected expression");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    ret .None;
  }

  // If the next token is an operator, parses another full expressionable
  // continuation (used after a primary/postfix form to pick up whatever
  // binary operator follows, e.g. after closing a parenthesized group).
  pub parse_additional_expression() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        if t.type == TokenType.Operator {
          ret self.parse_expressionable();
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Parses a parenthesized group `(...)`. If a value was already sitting on
  // the output list right before the `(` (e.g. an already-parsed callee
  // identifier), it's popped and combined with the parenthesized contents
  // into a `()`-op call `Expression` node -- this is how function/method
  // calls are represented: `Expression{ left = callee, right =
  // ExpressionParenthesis{ ... }, op = "()" }`. Otherwise the parenthesized
  // contents are pushed as a plain `ExpressionParenthesis` grouping node.
  // Either way, finishes by picking up any further operator continuation
  // via `parse_additional_expression`.
  pub parse_for_parenthesis() Option<ParseErrorKind> {
    let lparen_err = self.state.expect_op("(");
    if lparen_err.is_some() {
      ret lparen_err;
    }

    Node left_node = node_new(NodeKind.Blank);
    bin has_left_node = false;
    fit self.state.node_peek_last() {
      .Some(n) -> {
        if node_is_value_type(n) {
          left_node = n;
          has_left_node = true;
          self.state.node_pop();
        }
      }
      .None -> {}
    }

    Node exp_node = node_new(NodeKind.Blank);
    if !self.state.next_token_is_symbol(')') {
      let err = self.parse_expressionable_root();
      if err.is_some() {
        ret err;
      }
      fit self.state.node_pop() {
        .Some(n) -> { exp_node = n; }
        .None -> {}
      }
    }

    let rparen_err = self.state.expect_sym(')');
    if rparen_err.is_some() {
      ret rparen_err;
    }

    Node* exp = malloc(sizeof(Node));
    *exp = exp_node;
    Node paren_node = node_new(NodeKind.ExpressionParenthesis(exp));
    self.create_node(&paren_node);

    if has_left_node {
      fit self.state.node_pop() {
        .Some(popped_paren) -> {
          Node* left = malloc(sizeof(Node));
          *left = left_node;
          Node* right = malloc(sizeof(Node));
          *right = popped_paren;

          ExprNode call_e;
          call_e.left = left;
          call_e.has_left = true;
          call_e.right = right;
          call_e.has_right = true;
          call_e.op = "()";
          Node call_node = node_new(NodeKind.Expression(call_e));
          self.create_node(&call_node);
        }
        .None -> {}
      }
    }

    ret self.parse_additional_expression();
  }

  // Parses a pointer-indirection unary (`*p`, `**pp`): a run of `*`s
  // (the pointer depth being dereferenced) followed by the operand
  // expression. Kept separate from `parse_for_normal_unary` because a
  // following run of `*`s is a POINTER-DEPTH COUNT, not a chain of
  // separately-nested unary `Expression`/`Unary` operators.
  pub parse_for_indirection_unary() Option<ParseErrorKind> {
    let star_tok = self.state.token_peek_next();
    let depth = self.state.parse_get_pointer_depth();

    let err = self.parse_expressionable();
    if err.is_some() {
      ret err;
    }
    let maybe_operand = self.state.node_pop();
    if maybe_operand.is_none() {
      self.state.err("expected operand for pointer indirection");
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node operand_val = maybe_operand.unwrap();
    Node* operand = malloc(sizeof(Node));
    *operand = operand_val;

    UnaryNode u;
    u.is_left_operanded_unary = false;
    u.op = "*";
    u.operand = operand;
    u.has_indirection = true;
    u.indirection_depth = depth;

    Node unode = node_new(NodeKind.Unary(u));
    fit star_tok {
      .Some(t) -> {
        unode.pos = t.pos;
        unode.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&unode);
    ret .None;
  }

  // Parses a non-indirection prefix unary (`-x`, `!x`, `~x`, `&x`, `++x`,
  // `--x`): consumes the operator, parses its operand, and wraps it in a
  // `Unary` node.
  pub parse_for_normal_unary() Option<ParseErrorKind> {
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected unary operator");
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    let unary_tok = tok.unwrap();
    str unary_op = "";
    fit unary_tok.data {
      .Sval(s) -> { unary_op = s; }
      _ -> {}
    }

    let err = self.parse_expressionable();
    if err.is_some() {
      ret err;
    }
    let maybe_operand = self.state.node_pop();
    if maybe_operand.is_none() {
      let msg = format("expected operand for unary operator '{str}'", unary_op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node operand_val = maybe_operand.unwrap();
    Node* operand = malloc(sizeof(Node));
    *operand = operand_val;

    UnaryNode u;
    u.is_left_operanded_unary = false;
    u.op = unary_op;
    u.operand = operand;
    u.has_indirection = false;
    u.indirection_depth = 0;

    Node unode = node_new(NodeKind.Unary(u));
    unode.pos = unary_tok.pos;
    unode.has_pos = true;
    self.create_node(&unode);
    ret .None;
  }

  // Parses a prefix unary expression, routing indirection (`*p`) to its own
  // parser (a following `*` run is a pointer-depth count, not a normal
  // operand parse) and picking up any further operator continuation
  // afterward (e.g. `-x + 1`).
  pub parse_for_unary() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("expected unary operator");
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    str unary_op = "";
    fit tok.unwrap().data {
      .Sval(s) -> { unary_op = s; }
      _ -> {}
    }
    if is_indirection_operator(unary_op) {
      ret self.parse_for_indirection_unary();
    }
    let err = self.parse_for_normal_unary();
    if err.is_some() {
      ret err;
    }
    ret self.parse_additional_expression();
  }

  // Wraps an already-parsed LEFT operand in a postfix `Unary` node
  // (`x++`/`x--`) instead of treating the operator as a binary continuation.
  pub parse_for_left_operanded_unary(Node* node_left, str unary_op, Pos op_pos) {
    UnaryNode u;
    u.is_left_operanded_unary = true;
    u.op = unary_op;
    u.operand = node_left;
    u.has_indirection = false;
    u.indirection_depth = 0;

    Node unode = node_new(NodeKind.Unary(u));
    unode.pos = op_pos;
    unode.has_pos = true;
    self.create_node(&unode);
  }

  // Dispatches on the next token to the right expression-shape parser: `(`
  // starts a parenthesized group/call, anything else is a binary-operator
  // continuation via `parse_normal_expression`.
  // 
  // Deliberately simplified from the original for this slice: no `,`
  // (comma-expression) or `[` (bracket/array-literal) dispatch yet.
  pub parse_expression() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        bin is_lparen = false;
        fit t.data {
          .Sval(s) -> { is_lparen = equals(s, "("); }
          _ -> {}
        }
        if is_lparen {
          ret self.parse_for_parenthesis();
        }
        ret self.parse_normal_expression();
      }
      .None -> { ret .None; }
    }
  }

  // Parses a binary-operator continuation, a prefix unary (when no left
  // operand precedes the operator), or a postfix unary (`x++`/`x--`, when
  // one does). For the binary case: consumes the operator, parses its
  // right-hand operand, combines it with the left operand already on the
  // output list into an `Expression` node via `make_expression_node`, then
  // fixes precedence via `parse_reorder_expression`.
  // 
  // Deliberately simplified from the original for this slice: no channel
  // `<-` or enum-variant-shorthand `.Variant` prefix forms yet (each needs
  // infrastructure this slice doesn't have), and a binary RHS must be a
  // parenthesized group or another `parse_expressionable` continuation (no
  // unary RHS, e.g. `a + -b` isn't supported yet).
  pub parse_normal_expression() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("expected operator in expression");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    let t = tok.unwrap();
    str op = "";
    fit t.data {
      .Sval(s) -> { op = s; }
      _ -> {}
    }
    let op_pos = t.pos;

    let maybe_left = self.node_peek_expressionable();
    if maybe_left.is_none() {
      if is_unary_operator(op) {
        ret self.parse_for_unary();
      }
      let msg = format("expected left operand for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node node_left = maybe_left.unwrap();

    self.state.token_next();
    self.state.node_pop();

    if is_left_operanded_unary_operator(op) {
      Node* left_ptr = malloc(sizeof(Node));
      *left_ptr = node_left;
      self.parse_for_left_operanded_unary(left_ptr, op, op_pos);
      ret .None;
    }

    let tok2 = self.state.token_peek_next();
    if tok2.is_none() {
      let msg = format("expected expressionable for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    let t2 = tok2.unwrap();
    if t2.type == TokenType.Operator {
      bin is_lparen = false;
      fit t2.data {
        .Sval(s2) -> { is_lparen = equals(s2, "("); }
        _ -> {}
      }
      if is_lparen {
        let perr = self.parse_for_parenthesis();
        if perr.is_some() {
          ret perr;
        }
      } else {
        let msg = format("expected expressionable for '{str}' operator", op);
        defer free(msg);
        self.state.err(msg);
        ret .Some(ParseErrorKind.InvalidOperand);
      }
    } else {
      let err = self.parse_expressionable();
      if err.is_some() {
        ret err;
      }
    }

    let maybe_right = self.state.node_pop();
    if maybe_right.is_none() {
      let msg = format("expected expressionable for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node node_right = maybe_right.unwrap();

    self.make_expression_node(&node_left, &node_right, op, op_pos);
    fit self.state.node_pop() {
      .Some(built) -> {
        Node exp_node = built;
        self.parse_reorder_expression(&exp_node);
        self.state.nodes.push(exp_node);
      }
      .None -> {
        self.state.err("expected expression node");
        ret .Some(ParseErrorKind.InvalidExpression);
      }
    }
    ret .None;
  }

  // Builds a new scope entity for `node`, deriving its lookup name from the
  // node's kind (identifiers/functions/variables are nameable; anything
  // else gets an empty name and is never found by `get_scope_entity`).
  pub new_scope_entity(Node* node) ScopeEntity* {
    ScopeEntity* entity = malloc(sizeof(ScopeEntity));
    *entity = scope_entity_new(_scope_entity_name(node));
    entity.node = node;
    entity.has_node = true;
    ret entity;
  }

  // The last-declared entity in the current scope chain, stopping at (not
  // including) the root/global scope.
  pub scope_last_entity_stop_global_scope() ScopeEntity* {
    ret self.state.last_scope_entity_stop_at(self.state.scope_root);
  }

  // Pushes a placeholder `Body` node (its `.statements` filled in once
  // parsing finishes) via `create_node`, so it picks up `binded` context
  // from whatever body/function currently encloses it.
  pub make_body_node() {
    Node body_node = node_new(NodeKind.Blank);
    self.create_node(&body_node);
  }

  // Parses a `{ ... }` block's statements into a `Body` node: creates the
  // body node, tracks it as `current_body` (so nested node construction
  // stamps `binded.owner` correctly) while parsing each statement in a
  // loop until the closing `}`, then restores the previous `current_body`.
  // 
  // Deliberately simplified from the original for this slice: no
  // `if`/`elif`/`else` chaining validation (nothing produces those node
  // kinds yet) and no "function declared as a statement" rejection
  // (`parse_statement` doesn't dispatch to `parse_function` yet either).
  // On a parse error mid-body, `current_body` is left as whatever it was
  // at the point of failure rather than unwound -- acceptable since a
  // parse error aborts the whole parse anyway.
  pub parse_body_multiple_statements() Option<ParseErrorKind> {
    Vec<Node*> stmts;
    stmts.init(0);

    self.make_body_node();
    let popped = self.state.node_pop();
    if popped.is_none() {
      self.state.err("expected body node");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* bnode_ptr = malloc(sizeof(Node));
    *bnode_ptr = popped.unwrap();

    let prev_body = self.current_body;
    let prev_has_body = self.has_current_body;
    self.current_body = bnode_ptr;
    self.has_current_body = true;

    let lbrace_err = self.state.expect_sym('{');
    if lbrace_err.is_some() {
      ret lbrace_err;
    }

    for true {
      let peeked = self.state.token_peek_next();
      if peeked.is_none() {
        self.state.err("unexpected end of file (expected '}' to close body)");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      if token_is_symbol(peeked.unwrap(), '}') {
        break;
      }
      let serr = self.parse_statement();
      if serr.is_some() {
        ret serr;
      }
      let maybe_stmt = self.state.node_pop();
      if maybe_stmt.is_none() {
        self.state.err("expected statement");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      Node* stmt = malloc(sizeof(Node));
      *stmt = maybe_stmt.unwrap();
      stmts.push(stmt);
    }

    let rbrace_err = self.state.expect_sym('}');
    if rbrace_err.is_some() {
      ret rbrace_err;
    }

    self.current_body = prev_body;
    self.has_current_body = prev_has_body;

    BodyNode bn;
    bn.statements = stmts;
    bnode_ptr.kind = NodeKind.Body(bn);
    self.state.nodes.push(*bnode_ptr);
    ret .None;
  }

  // Parses a `{ ... }` block, wrapping it in its own child scope so
  // declarations inside it don't leak into the enclosing one.
  pub parse_body() Option<ParseErrorKind> {
    self.state.new_scope();
    let err = self.parse_body_multiple_statements();
    self.state.finish_scope();
    ret err;
  }

  // Parses a variable declaration's NAME and optional `= initializer`
  // (the type `dt` is already parsed by the caller): registers a scope
  // entity so later references resolve, and rejects re-declaring a name
  // already visible in the current scope chain -- unconditionally, unlike
  // the original, which only checked this in the has-initializer branch;
  // an uninitialized redeclaration is just as much a bug and this port
  // doesn't see a reason to let it through.
  // 
  // Deliberately simplified from the original for this slice: no `T[]
  // name;` array-bracket form yet (needs `parse_array_brackets`, deferred
  // along with the rest of array support).
  pub parse_variable(DataType* dt, bin is_public, bin require_initializer) Option<ParseErrorKind> {
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected identifier");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    let ident_tok = tok.unwrap();
    if ident_tok.type != TokenType.Identifier {
      self.state.err("expected identifier");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str name = "";
    fit ident_tok.data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    if self.state.get_scope_entity(name) != nil {
      let msg = format("variable '{str}' already declared", name);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    bin has_value = self.state.next_token_is_operator("=");
    if !has_value && require_initializer {
      self.state.err("'let' declarations require an initializer");
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    VariableNode v;
    v.var_type = dt;
    v.name = name;
    v.has_val = false;

    if has_value {
      self.state.token_next();
      let verr = self.parse_expressionable_root();
      if verr.is_some() {
        ret verr;
      }
      let maybe_val = self.state.node_pop();
      if maybe_val.is_none() {
        self.state.err("expected initializer expression");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      Node* val = malloc(sizeof(Node));
      *val = maybe_val.unwrap();
      v.val = val;
      v.has_val = true;
    }

    Node node = node_new(NodeKind.Variable(v));
    node.pos = ident_tok.pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Node* node_ptr = malloc(sizeof(Node));
    *node_ptr = node;
    ScopeEntity* entity = self.new_scope_entity(node_ptr);

    self.create_node(node_ptr);
    self.state.push_scope_entity(entity);
    ret .None;
  }

  // Parses `let NAME = value;`: the declared type is the `__let_infer__`
  // sentinel (real type inference happens at typecheck time, not ported
  // yet), and an initializer is mandatory.
  pub parse_let_declaration(bin is_public) Option<ParseErrorKind> {
    let kw_err = self.state.expect_keyword("let");
    if kw_err.is_some() {
      ret kw_err;
    }

    DataType* dt = malloc(sizeof(DataType));
    *dt = dtype_new();
    dt.type_str = "__let_infer__";

    let verr = self.parse_variable(dt, is_public, true);
    if verr.is_some() {
      ret verr;
    }
    ret self.state.expect_sym(';');
  }

  // Parses `ret;` (bare) or `ret <expr>;`.
  pub parse_return() Option<ParseErrorKind> {
    let ret_tok = self.state.token_peek_next();
    self.state.token_next();

    if self.state.next_token_is_symbol(';') {
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
      Node node = node_new(NodeKind.StatementReturn(nil));
      fit ret_tok {
        .Some(t) -> {
          node.pos = t.pos;
          node.has_pos = true;
        }
        .None -> {}
      }
      self.create_node(&node);
      ret .None;
    }

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    let maybe_exp = self.state.node_pop();
    if maybe_exp.is_none() {
      self.state.err("expected return value");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node* exp = malloc(sizeof(Node));
    *exp = maybe_exp.unwrap();

    Node node = node_new(NodeKind.StatementReturn(exp));
    fit ret_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses `assert <condition>;` or `assert <condition>, <message>;`. The
  // condition expression parse may already consume the whole `cond,
  // message` as a single `,`-Expression (this port's `,` is an ordinary
  // binary operator in the precedence table, unlike the original's
  // separate comma-expression dispatch) -- split that apart when it
  // happens; otherwise look for an explicit trailing `, message`.
  pub parse_assert() Option<ParseErrorKind> {
    let assert_tok = self.state.token_peek_next();
    self.state.token_next();

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    let maybe_exp = self.state.node_pop();
    if maybe_exp.is_none() {
      self.state.err("expected assert condition");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node exp_val = maybe_exp.unwrap();

    bin is_comma_expr = false;
    fit exp_val.kind {
      .Expression(e) -> {
        if equals(e.op, ",") {
          is_comma_expr = true;
        }
      }
      _ -> {}
    }

    Node* cond_ptr = nil;
    Node* msg_ptr = nil;
    bin has_msg = false;

    if is_comma_expr {
      fit exp_val.kind {
        .Expression(e) -> {
          cond_ptr = e.left;
          msg_ptr = e.right;
          has_msg = true;
        }
        _ -> {}
      }
    } else {
      cond_ptr = malloc(sizeof(Node));
      *cond_ptr = exp_val;

      if self.state.next_token_is_operator(",") {
        self.state.token_next();
        let merr = self.parse_expressionable_root();
        if merr.is_some() {
          ret merr;
        }
        let maybe_msg = self.state.node_pop();
        if maybe_msg.is_none() {
          self.state.err("expected assert message");
          ret .Some(ParseErrorKind.InvalidExpression);
        }
        msg_ptr = malloc(sizeof(Node));
        *msg_ptr = maybe_msg.unwrap();
        has_msg = true;
      }
    }

    AssertNode an;
    an.condition = cond_ptr;
    an.message = msg_ptr;
    an.has_message = has_msg;

    Node node = node_new(NodeKind.StatementAssert(an));
    fit assert_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses one statement: a `{ ... }` nested body, a `let` declaration, a
  // `ret`/`assert` statement, or an expression statement terminated by `;`.
  // 
  // Deliberately simplified from the original for this slice: no keyword
  // dispatch beyond `let`/`ret`/`assert` (`if`/`for`/`fit`/`compound`/...
  // each need their own parsing infrastructure not ported yet -- an
  // unsupported keyword reports a clean "not yet supported" error rather
  // than silently misparsing), no `fork`-statement contextual-keyword
  // handling, and no user-defined-type declaration detection (`Point p;`
  // -- needs the same lookahead machinery as the keyword dispatch above,
  // deferred with it).
  pub parse_statement() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("unexpected end of file");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    let t = tok.unwrap();

    if t.type == TokenType.Keyword {
      str kw = "";
      fit t.data {
        .Sval(s) -> { kw = s; }
        _ -> {}
      }
      if equals(kw, "let") {
        ret self.parse_let_declaration(false);
      }
      if equals(kw, "ret") {
        ret self.parse_return();
      }
      if equals(kw, "assert") {
        ret self.parse_assert();
      }
      let msg = format("keyword '{str}' is not yet supported in statement position", kw);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    if token_is_symbol(t, '{') {
      ret self.parse_body();
    }

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    ret self.state.expect_sym(';');
  }
}

// ===== Test helpers =====

fun _state_from(str src) ParseState {
  ParseState st = parse_state_new("test.fn", src);
  st.tokens = tokenize(src, "test.fn").unwrap();
  // Tests exercise expected-failure paths too; keep stdout clean.
  st.emit_stderr = false;
  ret st;
}

test "token cursor advances past whitespace/newlines and reports EOF" {
  ParseState st = _state_from("let\nx");
  let first = st.token_next();
  assert first.is_some(), "expected a first token";
  assert token_is_keyword(first.unwrap(), "let"), "first token should be keyword 'let'";

  let second = st.token_next();
  assert second.is_some(), "expected a second token";
  fit second.unwrap().data {
    .Sval(s) -> { assert equals(s, "x"), "second token should be identifier 'x'"; }
    _ -> { panic("second token should carry Sval"); }
  }

  let third = st.token_next();
  assert third.is_none(), "expected end of stream after 2 tokens";
}

test "token_peek_next does not consume, token_peek_n looks further ahead" {
  ParseState st = _state_from("a b c");

  let peeked = st.token_peek_next();
  assert peeked.is_some(), "expected a peeked token";
  fit peeked.unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "peek should see 'a' without consuming it"; }
    _ -> { panic("expected Sval"); }
  }

  // Peeking again returns the SAME token (not consumed).
  let peeked_again = st.token_peek_next();
  fit peeked_again.unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "second peek should still see 'a'"; }
    _ -> { panic("expected Sval"); }
  }

  // n=1 looks one significant token further ahead without consuming anything.
  let ahead = st.token_peek_n(1);
  fit ahead.unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "token_peek_n(1) should see 'b'"; }
    _ -> { panic("expected Sval"); }
  }

  // Cursor is still at 'a': a real consume gets 'a', then 'b'.
  fit st.token_next().unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "first consume should still be 'a'"; }
    _ -> { panic("expected Sval"); }
  }
  fit st.token_next().unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "second consume should be 'b'"; }
    _ -> { panic("expected Sval"); }
  }
}

test "expect_sym/expect_op/expect_keyword succeed on a match" {
  // `(` lexes as an Operator (see lexdefs.fn's `op_treated_as_one`), not a
  // Symbol -- only the small set of structural delimiters (`{ } ; ) ]`) are
  // Symbol tokens, so `)` is used here to exercise `expect_sym`.
  ParseState st = _state_from(") + let");
  assert st.expect_sym(')').is_none(), "expected ')' to match";
  assert st.expect_op("+").is_none(), "expected '+' to match";
  assert st.expect_keyword("let").is_none(), "expected 'let' to match";
}

test "expect_sym/expect_op/expect_keyword report a typed error on mismatch" {
  ParseState st = _state_from("let");
  let err_sym = st.expect_sym(')');
  assert err_sym.is_some(), "expected a mismatch error";
  fit err_sym.unwrap() {
    .InvalidSymbol -> {}
    _ -> { panic("expected InvalidSymbol"); }
  }

  ParseState st2 = _state_from("let");
  let err_op = st2.expect_op("+");
  assert err_op.is_some(), "expected a mismatch error";
  fit err_op.unwrap() {
    .InvalidOperand -> {}
    _ -> { panic("expected InvalidOperand"); }
  }

  ParseState st3 = _state_from("(");
  let err_kw = st3.expect_keyword("let");
  assert err_kw.is_some(), "expected a mismatch error";
  fit err_kw.unwrap() {
    .InvalidKeyword -> {}
    _ -> { panic("expected InvalidKeyword"); }
  }
}

test "push_symbol/get_symbol round-trip through the active table" {
  ParseState st = _state_from("");
  SymbolTable table = symbol_table_new("test");
  st.active_table = &table;
  st.has_active_table = true;

  assert st.get_symbol("x").is_none(), "expected no symbol before registration";

  Symbol s = symbol_new("x");
  st.push_symbol(s);

  let found = st.get_symbol("x");
  assert found.is_some(), "expected to find the registered symbol";
  assert equals(found.unwrap().name, "x"), "found symbol should be named 'x'";
}

test "push_scope_entity/get_scope_entity walk the scope chain" {
  ParseState st = _state_from("");
  Scope root = scope_new();
  Scope child = scope_new();
  child.parent = &root;
  child.has_parent = true;
  st.scope_root = &root;
  st.has_scope_root = true;
  st.scope_current = &child;
  st.has_scope_current = true;

  assert st.get_scope_entity("x") == nil, "expected no entity before registration";

  ScopeEntity* e = malloc(sizeof(ScopeEntity));
  * e =scope_entity_new("x");
  st.push_scope_entity(e);

  let found = st.get_scope_entity("x");
  assert found != nil, "expected to find the registered entity";
  assert equals(found.name, "x"), "found entity should be named 'x'";
  assert st.get_scope_entity("missing") == nil, "unregistered name should not be found";
}

test "create_node stamps binded owner/function context" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node body_node = node_new(NodeKind.Blank);
  Node fn_node = node_new(NodeKind.Blank);
  p.current_body = &body_node;
  p.has_current_body = true;
  p.current_function = &fn_node;
  p.has_current_function = true;

  Node n = node_new(NodeKind.Blank);
  p.create_node(&n);

  assert n.has_binded, "expected create_node to stamp binded context";
  assert n.binded.has_owner, "expected binded.owner to be set from current_body";
  assert n.binded.has_function, "expected binded.function to be set from current_function";
  assert st.nodes.len == 1, "expected the node to be pushed into state.nodes";
}

test "create_node leaves binded unset with no active body/function" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node n = node_new(NodeKind.Blank);
  p.create_node(&n);

  assert !n.has_binded, "expected no binded context outside any body/function";
  assert st.nodes.len == 1, "expected the node to be pushed into state.nodes";
}

test "new_scope_entity derives its name from the node kind" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node id_node = node_new(NodeKind.Identifier("foo"));
  ScopeEntity* e = p.new_scope_entity(&id_node);
  assert equals(e.name, "foo"), "expected entity name derived from Identifier payload";

  Node blank_node = node_new(NodeKind.Blank);
  ScopeEntity* blank_entity = p.new_scope_entity(&blank_node);
  assert equals(blank_entity.name, ""), "expected empty name for a non-nameable node kind";
}

test "parse_datatype reads a builtin scalar keyword" {
  ParseState st = _state_from("num");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected num to parse";
  assert dt.kind == DataTypeType.Num, "expected kind Num";
  assert equals(dt.type_str, "num"), "expected type_str 'num'";
  assert dt.pointer_depth == 0, "expected no pointer depth";
}

test "parse_datatype reads trailing pointer-depth markers" {
  ParseState st = _state_from("num**");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected num** to parse";
  assert dt.kind == DataTypeType.Num, "expected kind Num";
  assert dt.flags.is_pointer, "expected is_pointer flag set";
  assert dt.pointer_depth == 2, "expected pointer depth 2";
}

test "parse_datatype reads a user-defined identifier type" {
  ParseState st = _state_from("MyCompound");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected MyCompound to parse";
  assert dt.kind == DataTypeType.Unknown, "user types stay Unknown";
  assert equals(dt.type_str, "MyCompound"), "expected type_str 'MyCompound'";
}

test "parse_datatype recognizes a known C typedef alias" {
  ParseState st = _state_from("size_t");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected size_t to parse";
  assert dt.kind == DataTypeType.Num, "size_t should be tagged numeric";
  assert equals(dt.type_str, "size_t"), "expected the original identifier preserved in type_str";
}

test "parse_datatype reads a qualified module-alias type" {
  ParseState st = _state_from("m.Type");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected m.Type to parse";
  assert equals(dt.type_str, "m__Type"), "expected qualified name mangled as m__Type";
}

test "parse_datatype reports an error on end of input" {
  ParseState st = _state_from("");
  st.emit_stderr = false;
  DataType dt = dtype_new();
  let err = st.parse_datatype(&dt);
  assert err.is_some(), "expected an error";
  fit err.unwrap() {
    .InvalidDataType -> {}
    _ -> { panic("expected InvalidDataType"); }
  }
}

test "parse_generic_type_args reads a single generic argument" {
  ParseState st = _state_from("Vec<num>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Vec<num> to parse";
  assert equals(dt.type_str, "Vec"), "expected base type_str 'Vec'";
  assert dt.generic_args.len == 1, "expected 1 generic arg";
  let arg0 = dt.generic_args.get(0);
  assert arg0.kind == DataTypeType.Num, "expected generic arg Num";
}

test "parse_generic_type_args reads multiple comma-separated arguments" {
  ParseState st = _state_from("Map<str, num>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Map<str, num> to parse";
  assert dt.generic_args.len == 2, "expected 2 generic args";
  let arg0 = dt.generic_args.get(0);
  let arg1 = dt.generic_args.get(1);
  assert arg0.kind == DataTypeType.Str, "expected first arg Str";
  assert arg1.kind == DataTypeType.Num, "expected second arg Num";
}

test "parse_generic_type_args splits a lexed '>>' for nested generics" {
  ParseState st = _state_from("Vec<Vec<num>>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Vec<Vec<num>> to parse";
  assert equals(dt.type_str, "Vec"), "expected outer type_str 'Vec'";
  assert dt.generic_args.len == 1, "expected 1 outer generic arg";
  let inner = dt.generic_args.get(0);
  assert equals(inner.type_str, "Vec"), "expected inner type_str 'Vec'";
  assert inner.generic_args.len == 1, "expected 1 inner generic arg";
  let innermost = inner.generic_args.get(0);
  assert innermost.kind == DataTypeType.Num, "expected innermost arg Num";
}

test "parse_generic_type_args pointer-typed generic argument" {
  ParseState st = _state_from("Vec<Node*>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Vec<Node*> to parse";
  let inner = dt.generic_args.get(0);
  assert equals(inner.type_str, "Node"), "expected inner type_str 'Node'";
  assert inner.pointer_depth == 1, "expected inner pointer depth 1";
}

test "token_peek_prev/token_peek_prev_n look backward from the last consumed token" {
  ParseState st = _state_from("a b c");
  st.token_next();
  assert st.token_peek_prev().is_none(), "no token consumed before 'a'";

  st.token_next();
  st.token_next();
  fit st.token_peek_prev().unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "prev of 'c' should be 'b'"; }
    _ -> { panic("expected Sval"); }
  }
  fit st.token_peek_prev_n(1).unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "prev_n(1) of 'c' should be 'a'"; }
    _ -> { panic("expected Sval"); }
  }
}

test "token_peek_prev_stream_n looks backward from the not-yet-consumed token" {
  ParseState st = _state_from("a b c");
  st.token_next();
  // Cursor now sits on 'b' (not yet consumed): prev_stream_n(0) should
  // still see 'a', matching what `token_peek_prev` would see AFTER
  // consuming 'b', without actually consuming it.
  fit st.token_peek_prev_stream_n(0).unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "prev_stream_n(0) should see 'a'"; }
    _ -> { panic("expected Sval"); }
  }
}

test "parse_single_token_to_node reads number/dec/char literals" {
  ParseState st = _state_from("42");
  Parser p = parser_new(&st);
  assert p.parse_single_token_to_node().is_none(), "expected 42 to parse";
  let n = st.nodes.get(0);
  fit n.kind {
    .Number(d) -> {
      fit d {
        .Num(v) -> { assert v == 42, "expected 42"; }
        _ -> { panic("expected Num"); }
      }
    }
    _ -> { panic("expected Number node"); }
  }

  ParseState st2 = _state_from("'x'");
  Parser p2 = parser_new(&st2);
  assert p2.parse_single_token_to_node().is_none(), "expected 'x' to parse";
  let n2 = st2.nodes.get(0);
  fit n2.kind {
    .Character(c) -> { assert c == 'x', "expected 'x'"; }
    _ -> { panic("expected Character node"); }
  }
}

test "parse_single_token_to_node reads string and boolean literals" {
  ParseState st = _state_from("\"hi\"");
  Parser p = parser_new(&st);
  assert p.parse_single_token_to_node().is_none(), "expected \"hi\" to parse";
  let n = st.nodes.get(0);
  fit n.kind {
    .String(s) -> { assert equals(s, "hi"), "expected 'hi'"; }
    _ -> { panic("expected String node"); }
  }

  ParseState st2 = _state_from("true");
  Parser p2 = parser_new(&st2);
  assert p2.parse_single_token_to_node().is_none(), "expected true to parse";
  let n2 = st2.nodes.get(0);
  fit n2.kind {
    .Boolean(b) -> { assert b, "expected true"; }
    _ -> { panic("expected Boolean node"); }
  }
}

test "parse_single_token_to_node accepts a declared identifier" {
  ParseState st = _state_from("x");
  Scope root = scope_new();
  st.scope_root = &root;
  st.has_scope_root = true;
  st.scope_current = &root;
  st.has_scope_current = true;
  ScopeEntity* e = malloc(sizeof(ScopeEntity));
  * e =scope_entity_new("x");
  st.push_scope_entity(e);

  Parser p = parser_new(&st);
  assert p.parse_single_token_to_node().is_none(), "expected declared 'x' to parse";
  let n = st.nodes.get(0);
  fit n.kind {
    .Identifier(s) -> { assert equals(s, "x"), "expected identifier 'x'"; }
    _ -> { panic("expected Identifier node"); }
  }
}

test "parse_single_token_to_node accepts wildcard, macro-style, and call-position identifiers without declaration" {
  ParseState st = _state_from("_");
  Parser p = parser_new(&st);
  assert p.parse_single_token_to_node().is_none(), "expected '_' to parse undeclared";

  ParseState st2 = _state_from("INT_MAX");
  Parser p2 = parser_new(&st2);
  assert p2.parse_single_token_to_node().is_none(), "expected ALL_CAPS macro-style name to parse undeclared";

  ParseState st3 = _state_from("foo(");
  Parser p3 = parser_new(&st3);
  assert p3.parse_single_token_to_node().is_none(), "expected a call-position identifier to parse undeclared";
}

test "parse_single_token_to_node reports an error for an unknown plain identifier" {
  ParseState st = _state_from("mystery");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_single_token_to_node();
  assert err.is_some(), "expected an error for an undeclared, non-special identifier";
  fit err.unwrap() {
    .InvalidIdentifier -> {}
    _ -> { panic("expected InvalidIdentifier"); }
  }
}

test "make_expression_node builds a binary Expression node from two operands" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  Node a = node_new(NodeKind.Identifier("a"));
  Node b = node_new(NodeKind.Identifier("b"));
  Pos p0;
  p0.line = 1;
  p.make_expression_node(&a, &b, "+", p0);

  assert st.nodes.len == 1, "expected exactly 1 pushed node";
  let n = st.nodes.get(0);
  fit n.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected op '+'";
      assert e.has_left && e.has_right, "expected both operands set";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected left 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "b"), "expected right 'b'"; }
        _ -> { panic("expected Identifier 'b'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_reorder_expression rotates a right-heavy naive parse when the outer operator binds tighter" {
  // Simulates the naive left-to-right parse of `a * b + c`, which (since
  // the RHS parse is greedy and swallows the rest of the expression
  // regardless of precedence) builds the right-heavy `(a * (b + c))`
  // instead of the precedence-correct `((a * b) + c)`.
  Node a = node_new(NodeKind.Identifier("a"));
  Node b = node_new(NodeKind.Identifier("b"));
  Node c = node_new(NodeKind.Identifier("c"));

  ExprNode inner_e;
  inner_e.left = &b;
  inner_e.has_left = true;
  inner_e.right = &c;
  inner_e.has_right = true;
  inner_e.op = "+";
  Node inner = node_new(NodeKind.Expression(inner_e));

  ExprNode outer_e;
  outer_e.left = &a;
  outer_e.has_left = true;
  outer_e.right = &inner;
  outer_e.has_right = true;
  outer_e.op = "*";
  Node outer = node_new(NodeKind.Expression(outer_e));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  p.parse_reorder_expression(&outer);

  // Expect ((a * b) + c).
  fit outer.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to become '+' after rotation";
      fit e.left.kind {
        .Expression(le) -> {
          assert equals(le.op, "*"), "expected the new left child's op to stay '*'";
          fit le.left.kind {
            .Identifier(s) -> { assert equals(s, "a"), "expected left-left 'a'"; }
            _ -> { panic("expected Identifier 'a'"); }
          }
          fit le.right.kind {
            .Identifier(s) -> { assert equals(s, "b"), "expected left-right 'b'"; }
            _ -> { panic("expected Identifier 'b'"); }
          }
        }
        _ -> { panic("expected the new left child to be an Expression"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "c"), "expected the outer right to stay 'c'"; }
        _ -> { panic("expected Identifier 'c'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_reorder_expression leaves an already-correct right-heavy shape untouched" {
  // Simulates the naive parse of `a + b * c`: `(a + (b * c))`, which is
  // ALREADY the precedence-correct shape ('*' binds tighter than '+'), so
  // no rotation should happen.
  Node a = node_new(NodeKind.Identifier("a"));
  Node b = node_new(NodeKind.Identifier("b"));
  Node c = node_new(NodeKind.Identifier("c"));

  ExprNode inner_e;
  inner_e.left = &b;
  inner_e.has_left = true;
  inner_e.right = &c;
  inner_e.has_right = true;
  inner_e.op = "*";
  Node inner = node_new(NodeKind.Expression(inner_e));

  ExprNode outer_e;
  outer_e.left = &a;
  outer_e.has_left = true;
  outer_e.right = &inner;
  outer_e.has_right = true;
  outer_e.op = "+";
  Node outer = node_new(NodeKind.Expression(outer_e));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  p.parse_reorder_expression(&outer);

  fit outer.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to stay '+'";
      fit e.right.kind {
        .Expression(re) -> {
          assert equals(re.op, "*"), "expected the right child to stay '(b * c)'";
        }
        _ -> { panic("expected the right child to remain an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_reorder_expression rotates a chain needing two rotations" {
  // Mirrors how the real parser actually builds `a * b * c * d`: the RHS of
  // each operator is parsed (and reordered) FIRST, recursively, so by the
  // time an outer node is built its right child is already a fully
  // reordered sub-expression -- `parse_reorder_expression` is called
  // incrementally, bottom-up, once per level, never on a raw multi-level
  // right-recursive chain built in one shot. (An earlier version of this
  // test built the whole `(a * (b * (c * d)))` chain upfront and called
  // `parse_reorder_expression` on it exactly once, which under-rotates --
  // that single-shot shape can't actually arise from the real incremental
  // algorithm, so it isn't a real bug, just an unrealistic test input.)
  Node a = node_new(NodeKind.Identifier("a"));
  Node b = node_new(NodeKind.Identifier("b"));
  Node c = node_new(NodeKind.Identifier("c"));
  Node d = node_new(NodeKind.Identifier("d"));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  // Innermost first: (c * d).
  ExprNode e_cd;
  e_cd.left = &c;
  e_cd.has_left = true;
  e_cd.right = &d;
  e_cd.has_right = true;
  e_cd.op = "*";
  Node cd = node_new(NodeKind.Expression(e_cd));
  p.parse_reorder_expression(&cd);

  // Then (b * (c * d)) -> rotates to ((b * c) * d).
  ExprNode e_bcd;
  e_bcd.left = &b;
  e_bcd.has_left = true;
  e_bcd.right = &cd;
  e_bcd.has_right = true;
  e_bcd.op = "*";
  Node bcd = node_new(NodeKind.Expression(e_bcd));
  p.parse_reorder_expression(&bcd);

  // Then (a * ((b * c) * d)) -> rotates to (((a * b) * c) * d).
  ExprNode e_top;
  e_top.left = &a;
  e_top.has_left = true;
  e_top.right = &bcd;
  e_top.has_right = true;
  e_top.op = "*";
  Node n1 = node_new(NodeKind.Expression(e_top));
  p.parse_reorder_expression(&n1);

  // Expect (((a * b) * c) * d): top op '*', right = d, left = ((a*b)*c).
  fit n1.kind {
    .Expression(top) -> {
      fit top.right.kind {
        .Identifier(s) -> { assert equals(s, "d"), "expected the outermost right to be 'd'"; }
        _ -> { panic("expected Identifier 'd'"); }
      }
      fit top.left.kind {
        .Expression(mid) -> {
          fit mid.right.kind {
            .Identifier(s) -> { assert equals(s, "c"), "expected the middle right to be 'c'"; }
            _ -> { panic("expected Identifier 'c'"); }
          }
          fit mid.left.kind {
            .Expression(inner) -> {
              fit inner.left.kind {
                .Identifier(s) -> {
                  assert equals(s, "a"), "expected the innermost left to be 'a'";
                }
                _ -> { panic("expected Identifier 'a'"); }
              }
              fit inner.right.kind {
                .Identifier(s) -> {
                  assert equals(s, "b"), "expected the innermost right to be 'b'";
                }
                _ -> { panic("expected Identifier 'b'"); }
              }
            }
            _ -> { panic("expected the innermost left to be an Expression"); }
          }
        }
        _ -> { panic("expected the middle left to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_node_move_right_left_to_left rotates a call/comma-shaped pair" {
  Node callee = node_new(NodeKind.Identifier("foo"));
  Node blank = node_new(NodeKind.Blank);
  ExprNode call_e;
  call_e.left = &callee;
  call_e.has_left = true;
  call_e.right = &blank;
  call_e.has_right = true;
  call_e.op = "()";
  Node call_node = node_new(NodeKind.Expression(call_e));

  Node x = node_new(NodeKind.Identifier("x"));
  Node y = node_new(NodeKind.Identifier("y"));
  ExprNode comma_e;
  comma_e.left = &x;
  comma_e.has_left = true;
  comma_e.right = &y;
  comma_e.has_right = true;
  comma_e.op = ",";
  Node comma_node = node_new(NodeKind.Expression(comma_e));

  // The rotation carries the TOP node's own op onto the new left child
  // (mirroring `parse_node_shift_children_left`'s identical behavior), not
  // `call_node`'s -- so `top`'s own op must be "()" for the new left
  // child to end up "()"-shaped too, matching a real call/index-args fold.
  ExprNode top_e;
  top_e.left = &call_node;
  top_e.has_left = true;
  top_e.right = &comma_node;
  top_e.has_right = true;
  top_e.op = "()";
  Node top = node_new(NodeKind.Expression(top_e));

  ParseState st = _state_from("");
  Parser p = parser_new(&st);
  p.parse_node_move_right_left_to_left(&top);

  // Expect: left = (foo() x) [op "()"], right = y, top op = ",".
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, ","), "expected the top op to become ','";
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "y"), "expected the top right to be 'y'"; }
        _ -> { panic("expected Identifier 'y'"); }
      }
      fit e.left.kind {
        .Expression(le) -> {
          assert equals(le.op, "()"), "expected the new left op to stay '()'";
          fit le.right.kind {
            .Identifier(s) -> {
              assert equals(s, "x"), "expected the new left's right to be 'x'";
            }
            _ -> { panic("expected Identifier 'x'"); }
          }
        }
        _ -> { panic("expected the new left to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

// Sets up a ParseState with a root/current scope and one declared entity
// per name in `names`, so `parse_single_token_to_node`'s identifier
// validation accepts them as ordinary values. Used by the end-to-end
// expression-parsing tests below.
fun _state_with_declared(str src, Vec<str> names) ParseState {
  ParseState st = _state_from(src);
  Scope* root = malloc(sizeof(Scope));
  *root = scope_new();
  st.scope_root = root;
  st.has_scope_root = true;
  st.scope_current = root;
  st.has_scope_current = true;
  num i = 0;
  for i < names.len {
    ScopeEntity* e = malloc(sizeof(ScopeEntity));
    *e = scope_entity_new(names.get(i));
    st.push_scope_entity(e);
    i = i + 1;
  }
  ret st;
}

test "parse_expressionable_root parses a simple binary expression" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("a + b", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a + b' to parse";
  // `node_pop` really removes elements (a genuine stack, not a persistent
  // array with a logical top pointer): `a` and `b` are consumed when
  // combined into the Expression, so only the final combined node remains.
  assert st.nodes.len == 1, "expected only the final Expression node to remain";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected op '+'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected left 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "b"), "expected right 'b'"; }
        _ -> { panic("expected Identifier 'b'"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root respects operator precedence (a * b + c)" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  names.push("c");
  ParseState st = _state_with_declared("a * b + c", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a * b + c' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  // Expect ((a * b) + c).
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to be '+'";
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "c"), "expected the outer right to be 'c'"; }
        _ -> { panic("expected Identifier 'c'"); }
      }
      fit e.left.kind {
        .Expression(le) -> {
          assert equals(le.op, "*"), "expected the left child's op to be '*'";
        }
        _ -> { panic("expected the left child to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root respects operator precedence (a + b * c)" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  names.push("c");
  ParseState st = _state_with_declared("a + b * c", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a + b * c' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  // Expect (a + (b * c)) -- already correct, no rotation needed.
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "+"), "expected the outer op to be '+'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected the outer left to be 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
      fit e.right.kind {
        .Expression(re) -> {
          assert equals(re.op, "*"), "expected the right child's op to be '*'";
        }
        _ -> { panic("expected the right child to be an Expression"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a parenthesized group" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  names.push("c");
  ParseState st = _state_with_declared("(a + b) * c", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '(a + b) * c' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "*"), "expected the outer op to be '*'";
      fit e.right.kind {
        .Identifier(s) -> { assert equals(s, "c"), "expected the outer right to be 'c'"; }
        _ -> { panic("expected Identifier 'c'"); }
      }
      fit e.left.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Expression(ie) -> {
              assert equals(ie.op, "+"), "expected the parenthesized op to be '+'";
            }
            _ -> { panic("expected the parenthesized contents to be an Expression"); }
          }
        }
        _ -> { panic("expected the outer left to be an ExpressionParenthesis"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a zero-arg call" {
  Vec<str> names;
  names.init(0);
  names.push("foo");
  ParseState st = _state_with_declared("foo()", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'foo()' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "()"), "expected op '()'";
      fit e.left.kind {
        .Identifier(s) -> { assert equals(s, "foo"), "expected callee 'foo'"; }
        _ -> { panic("expected Identifier 'foo'"); }
      }
      fit e.right.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Blank -> {}
            _ -> { panic("expected a Blank node for the empty arg list"); }
          }
        }
        _ -> { panic("expected an ExpressionParenthesis for the arg list"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root parses a one-arg call" {
  Vec<str> names;
  names.init(0);
  names.push("foo");
  names.push("x");
  ParseState st = _state_with_declared("foo(x)", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'foo(x)' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Expression(e) -> {
      assert equals(e.op, "()"), "expected op '()'";
      fit e.right.kind {
        .ExpressionParenthesis(inner) -> {
          fit inner.kind {
            .Identifier(s) -> { assert equals(s, "x"), "expected the arg to be 'x'"; }
            _ -> { panic("expected the arg list contents to be Identifier 'x'"); }
          }
        }
        _ -> { panic("expected an ExpressionParenthesis for the arg list"); }
      }
    }
    _ -> { panic("expected an Expression node"); }
  }
}

test "parse_expressionable_root reports an error with no operand at all" {
  ParseState st = _state_from(";");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_expressionable_root();
  assert err.is_some(), "expected an error for an empty expression position";
}

test "parse_expressionable_root parses a prefix unary expression" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("-a", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '-a' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "-"), "expected op '-'";
      assert !u.is_left_operanded_unary, "expected a prefix (not postfix) unary";
      assert !u.has_indirection, "expected no indirection info for a plain '-'";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected operand 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

test "parse_expressionable_root parses pointer indirection with depth" {
  Vec<str> names;
  names.init(0);
  names.push("p");
  ParseState st = _state_with_declared("**p", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '**p' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "*"), "expected op '*'";
      assert u.has_indirection, "expected indirection info to be set";
      assert u.indirection_depth == 2, "expected indirection depth 2";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "p"), "expected operand 'p'"; }
        _ -> { panic("expected Identifier 'p'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

test "parse_expressionable_root parses a postfix unary expression" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("a++", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected 'a++' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "++"), "expected op '++'";
      assert u.is_left_operanded_unary, "expected a postfix (left-operanded) unary";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected operand 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

test "parse_expressionable_root parses a unary operand followed by a binary continuation" {
  // `parse_for_normal_unary` parses its operand via the full greedy
  // `parse_expressionable` (matching the original faithfully), so a
  // binary operator right after a unary's primary operand continues
  // INSIDE the unary, not around it: `-a + b` is `-(a + b)`, not
  // `(-a) + b`. Prefix unary is a WEAK-binding operator in this grammar
  // (as parsed today; `assert !r.is_err()` relies on exactly this to let
  // `!` wrap a whole call result, not just a bare primary).
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("-a + b", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '-a + b' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "-"), "expected the outer node to be unary '-'";
      fit u.operand.kind {
        .Expression(e) -> {
          assert equals(e.op, "+"), "expected the unary's operand to be '(a + b)'";
          fit e.left.kind {
            .Identifier(s) -> { assert equals(s, "a"), "expected left 'a'"; }
            _ -> { panic("expected Identifier 'a'"); }
          }
          fit e.right.kind {
            .Identifier(s) -> { assert equals(s, "b"), "expected right 'b'"; }
            _ -> { panic("expected Identifier 'b'"); }
          }
        }
        _ -> { panic("expected the unary's operand to be an Expression"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

test "parse_body parses a sequence of expression statements" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("{ a; b; }", names);
  Parser p = parser_new(&st);
  assert p.parse_body().is_none(), "expected '{ a; b; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Body(b) -> {
      assert b.statements.len == 2, "expected 2 statements";
      let s0 = b.statements.get(0);
      let s1 = b.statements.get(1);
      fit s0.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected first statement 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
      fit s1.kind {
        .Identifier(s) -> { assert equals(s, "b"), "expected second statement 'b'"; }
        _ -> { panic("expected Identifier 'b'"); }
      }
    }
    _ -> { panic("expected a Body node"); }
  }
}

test "parse_body parses a let declaration" {
  ParseState st = _state_from("{ let x = 1; }");
  Parser p = parser_new(&st);
  assert p.parse_body().is_none(), "expected '{ let x = 1; }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Body(b) -> {
      assert b.statements.len == 1, "expected 1 statement";
      let s0 = b.statements.get(0);
      fit s0.kind {
        .Variable(v) -> {
          assert equals(v.name, "x"), "expected variable name 'x'";
          assert v.has_val, "expected an initializer";
          assert equals(v.var_type.type_str, "__let_infer__"), "expected the __let_infer__ sentinel type";
          fit v.val.kind {
            .Number(d) -> {
              fit d {
                .Num(n) -> { assert n == 1, "expected initializer 1"; }
                _ -> { panic("expected Num"); }
              }
            }
            _ -> { panic("expected a Number initializer"); }
          }
        }
        _ -> { panic("expected a Variable statement"); }
      }
    }
    _ -> { panic("expected a Body node"); }
  }
}

test "parse_body parses a nested body" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("{ { a; } }", names);
  Parser p = parser_new(&st);
  assert p.parse_body().is_none(), "expected '{ { a; } }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Body(outer) -> {
      assert outer.statements.len == 1, "expected 1 outer statement";
      let inner_stmt = outer.statements.get(0);
      fit inner_stmt.kind {
        .Body(inner) -> {
          assert inner.statements.len == 1, "expected 1 inner statement";
          let inner_s0 = inner.statements.get(0);
          fit inner_s0.kind {
            .Identifier(s) -> { assert equals(s, "a"), "expected inner statement 'a'"; }
            _ -> { panic("expected Identifier 'a'"); }
          }
        }
        _ -> { panic("expected the inner statement to be a Body node"); }
      }
      // The nested body's `binded.owner` should point back to the outer body.
      assert inner_stmt.has_binded, "expected the nested body to have binded context";
      assert inner_stmt.binded.has_owner, "expected the nested body's binded.owner to be set";
    }
    _ -> { panic("expected a Body node"); }
  }
}

test "parse_body rejects a duplicate let declaration in the same scope" {
  ParseState st = _state_from("{ let x = 1; let x = 2; }");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_body();
  assert err.is_some(), "expected a duplicate declaration error";
}

test "parse_let_declaration requires an initializer" {
  ParseState st = _state_from("let x;");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_let_declaration(false);
  assert err.is_some(), "expected an error for a let declaration with no initializer";
}

test "parse_statement reports a clean error for an unsupported keyword" {
  ParseState st = _state_from("if a { }");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_statement();
  assert err.is_some(), "expected an error for an unsupported keyword in statement position";
  fit err.unwrap() {
    .InvalidStatement -> {}
    _ -> { panic("expected InvalidStatement"); }
  }
}

test "parse_return parses a bare ret" {
  ParseState st = _state_from("ret;");
  Parser p = parser_new(&st);
  assert p.parse_return().is_none(), "expected 'ret;' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementReturn(exp) -> { assert exp == nil, "expected no return value"; }
    _ -> { panic("expected a StatementReturn node"); }
  }
}

test "parse_return parses ret with a value" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared("ret x + 1;", names);
  Parser p = parser_new(&st);
  assert p.parse_return().is_none(), "expected 'ret x + 1;' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementReturn(exp) -> {
      assert exp != nil, "expected a return value";
      fit exp.kind {
        .Expression(e) -> { assert equals(e.op, "+"), "expected op '+'"; }
        _ -> { panic("expected an Expression return value"); }
      }
    }
    _ -> { panic("expected a StatementReturn node"); }
  }
}

test "parse_assert parses a condition with no message" {
  Vec<str> names;
  names.init(0);
  names.push("cond");
  ParseState st = _state_with_declared("assert cond;", names);
  Parser p = parser_new(&st);
  assert p.parse_assert().is_none(), "expected 'assert cond;' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementAssert(a) -> {
      assert !a.has_message, "expected no message";
      fit a.condition.kind {
        .Identifier(s) -> { assert equals(s, "cond"), "expected condition 'cond'"; }
        _ -> { panic("expected Identifier 'cond'"); }
      }
    }
    _ -> { panic("expected a StatementAssert node"); }
  }
}

test "parse_assert parses a condition with a message" {
  Vec<str> names;
  names.init(0);
  names.push("cond");
  ParseState st = _state_with_declared("assert cond, \"boom\";", names);
  Parser p = parser_new(&st);
  assert p.parse_assert().is_none(), "expected 'assert cond, \"boom\";' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementAssert(a) -> {
      assert a.has_message, "expected a message";
      fit a.condition.kind {
        .Identifier(s) -> { assert equals(s, "cond"), "expected condition 'cond'"; }
        _ -> { panic("expected Identifier 'cond'"); }
      }
      fit a.message.kind {
        .String(s) -> { assert equals(s, "boom"), "expected message 'boom'"; }
        _ -> { panic("expected String message 'boom'"); }
      }
    }
    _ -> { panic("expected a StatementAssert node"); }
  }
}

test "parse_body parses a body mixing let, ret, and assert statements" {
  Vec<str> names;
  names.init(0);
  names.push("cond");
  ParseState st = _state_with_declared("{ let x = 1; assert cond; ret x; }", names);
  Parser p = parser_new(&st);
  assert p.parse_body().is_none(), "expected the mixed body to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Body(b) -> {
      assert b.statements.len == 3, "expected 3 statements";
      let s0 = b.statements.get(0);
      let s1 = b.statements.get(1);
      let s2 = b.statements.get(2);
      fit s0.kind {
        .Variable(v) -> {
          assert equals(v.name, "x"), "expected first statement to declare 'x'";
        }
        _ -> { panic("expected a Variable statement"); }
      }
      fit s1.kind {
        .StatementAssert(a) -> {}
        _ -> { panic("expected a StatementAssert statement"); }
      }
      fit s2.kind {
        .StatementReturn(exp) -> {}
        _ -> { panic("expected a StatementReturn statement"); }
      }
    }
    _ -> { panic("expected a Body node"); }
  }
}

// The lookup name a new scope entity for `node` should carry; empty for a
// node kind that never introduces a nameable binding.
fun _scope_entity_name(Node* node) str {
  fit node.kind {
    .Identifier(s) -> { ret s; }
    .Function(f) -> { ret f.name; }
    .Variable(v) -> { ret v.name; }
    _ -> { ret ""; }
  }
}

// True if `name` looks like a C preprocessor macro constant
// (`SCREAMING_SNAKE_CASE`): starts with an uppercase letter or `_`, and
// every character is an uppercase letter, digit, or `_`. Such identifiers
// are accepted as expression operands even when undeclared, since a
// program using `std.c.*` bindings routinely references real macro
// constants (`INT_MAX`, `O_RDONLY`, ...) that this compiler never sees a
// declaration for.
fun _is_c_macro_ident(str name) bin {
  if len(name) == 0 {
    ret false;
  }
  chr first = name[0];
  if !((first >= 'A' && first <= 'Z') || first == '_') {
    ret false;
  }
  num i = 0;
  for i < len(name) {
    chr c = name[i];
    bin is_upper = c >= 'A' && c <= 'Z';
    bin is_digit_c = c >= '0' && c <= '9';
    if !(is_upper || is_digit_c || c == '_') {
      ret false;
    }
    i = i + 1;
  }
  ret true;
}

// True if `n`'s kind is `Expression` (a binary op node) -- used by the
// precedence-reordering functions to decide whether a child needs further
// rotation, as opposed to being an already-primary operand (a literal,
// identifier, or grouped sub-expression).
fun _is_expression_kind(Node* n) bin {
  fit n.kind {
    .Expression(e) -> { ret true; }
    _ -> { ret false; }
  }
}
