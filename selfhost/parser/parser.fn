test "parse_function defaults to a void return type with no args" {
  ParseState st = _state_from("fun greet() { }");
  Parser p = parser_new(&st);
  assert p.parse_function(false, false).is_none(), "expected the function to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert equals(f.name, "greet"), "expected function name 'greet'";
      assert !top.flags.is_public, "expected the function to be private";
      assert f.args.len == 0, "expected no args";
      assert f.has_rtype, "expected an rtype";
      assert equals(f.rtype.type_str, "void"), "expected the default rtype 'void'";
      fit f.rtype.kind {
        .Void -> {}
        _ -> { panic("expected DataTypeType.Void"); }
      }
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_function parses a bodyless declaration (C-binding style)" {
  ParseState st = _state_from("fun malloc(num size) raw*;");
  Parser p = parser_new(&st);
  assert p.parse_function(true, false).is_none(), "expected the bodyless declaration to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Function(f) -> {
      assert equals(f.name, "malloc"), "expected function name 'malloc'";
      assert !f.has_body, "expected no body";
      assert equals(f.rtype.type_str, "raw"), "expected rtype 'raw'";
      assert f.rtype.pointer_depth == 1, "expected rtype pointer depth 1";
    }
    _ -> { panic("expected a Function node"); }
  }
}

test "parse_function requires an identifier after 'fun'" {
  ParseState st = _state_from("fun () { }");
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_function(false, false);
