// The self-hosted Fun compiler's parser: turns a token stream into an AST.
// Ported from the previous implementation's parser module.
// 
// This is an early, partial slice of the port: token-cursor navigation,
// diagnostic reporting, and node/scope-entity construction -- the layer
// every actual statement/expression parsing function builds on. The
// statement and expression parsing functions themselves (the bulk of the
// original's ~6,600 lines) are ported incrementally in later sessions; see
// `parse_state.fn` for why the parser gets its own minimal state container
// instead of reusing the full original `TranspileProcess`.
// 
// Deliberately deferred from this slice (documented rather than silently
// dropped):
// - The O(1) significant-token lookahead cache (`sig_indices`/
// `phys_to_rank` in the original) -- `token_peek_n` here always does the
// linear scan the original falls back to when the cache is stale. Safe:
// the original's own comment confirms the linear path is always correct,
// just slower; revisit only if parse time on large files becomes a
// problem.
// - `forward_type_names` pre-scan (forward-declared-type detection for the
// compound-initializer disambiguator) -- not needed until the statement
// parser reaches that disambiguation, so it is deferred to that slice.
// - `deinit_node`/`deinit_root_scope` (manual arena cleanup) -- the
// original frees an arena once per whole compile; a self-hosted `fun`
// invocation is a short-lived process, so nothing here frees per-node
// memory either, matching the same "let the OS reclaim on exit" choice
// already made throughout `stdlib`'s own C bindings usage.
// 
// Known compiler gap worked around throughout this file (and worth fixing
// upstream separately): chaining a further `.field` access directly onto a
// `Vec<T*>.get(...)` call (`vec.get(i).field`) can emit `.` instead of `->`
// for the outer access and fail to compile, because the codegen path that
// picks `.`/`->` doesn't fully resolve a generic method call's monomorphized
// return type through the receiver's type args in every shape. Binding the
// call result to a `let` first (`let x = vec.get(i); x.field`) always works
// and reads at least as clearly, so that's the convention used here.

imp parse_state;
imp datatype_defs;
imp expressionable_defs;
imp ..ast.ast;
imp ..lexer.token;
imp ..lexer.lexer;
imp ..semantics.scope;
imp ..semantics.symbol;
imp std.vec;
imp std.string;
imp std.option;
imp std.io;
imp std.c.io;
imp std.c.mem;

// Errors the parser can report. Mirrors the original's `ParseError` set
// (its `TranspileError`/`LexError` members are not included here since
// those belong to modules not yet ported).
pub enum ParseErrorKind {
  InvalidSymbol,
  InvalidKeyword,
  InvalidDataType,
  InvalidToken,
  InvalidIdentifier,
  InvalidOperand,
  InvalidStatement,
  InvalidString,
  // Note: in the original this specific member actually comes from
  // `LexError`, not `ParseError` (its `ParseError || TranspileError ||
  // LexError` union just makes it usable from parser code too) -- folded
  // into this single enum along with everything else regardless of which
  // original error set it came from, since this port doesn't replicate
  // that three-way split.
  InvalidExpression,
}

impl ParseState {
  // Logs a diagnostic with the current position in the token stream.
  // 
  // Params:
  // - msg: the already-formatted diagnostic message (build it with
  // `std.io.format` before calling, since Fun's varargs sugar is meant
  // for `{placeholder}`-style formatting, not passthrough to `fprintf`)
  pub err(str msg) {
    if !self.emit_stderr {
      ret;
    }
    let out = stderr_stream();
    fprintf(out, "%s", "\n[Error]\n");
    fprintf(out, "%s", msg);
    if self.has_current_token {
      let ct = self.current_token;
      num end_line = ct.pos.end_line;
      if end_line == 0 {
        end_line = ct.pos.line;
      }
      if end_line == ct.pos.line {
        let loc = format(
          "\nLocation: {str}:{num}:{num}-{num}\n",
          ct.pos.filename,
          ct.pos.line,
          ct.pos.start_col,
          ct.pos.end_col
        );
        defer free(loc);
        fprintf(out, "%s", loc);
      } else {
        let loc = format(
          "\nLocation: {str}:{num}:{num}-{num}:{num}\n",
          ct.pos.filename,
          ct.pos.line,
          ct.pos.start_col,
          end_line,
          ct.pos.end_col
        );
        defer free(loc);
        fprintf(out, "%s", loc);
      }
    } else {
      let loc = format(
        "\nLocation: {str}:{num}:{num}\n",
        self.pos.filename,
        self.pos.line,
        self.pos.col
      );
      defer free(loc);
      fprintf(out, "%s", loc);
    }
  }

  // Returns the token at the cursor without advancing, or `.None` past the
  // end of the stream.
  pub tokens_peek_no_increment() Option<Token> {
    ret self.tokens.at(self.pindex);
  }

  // Returns the token at the cursor and advances past it. Returns `.None`
  // (cursor unchanged) past the end of the stream.
  pub tokens_peek() Option<Token> {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        self.pindex = self.pindex + 1;
        ret .Some(t);
      }
      .None -> { ret .None; }
    }
  }

  // Un-reads the most recently peeked token (moves the cursor back by one).
  pub tokens_pop_last_peek() {
    if self.pindex > 0 {
      self.pindex = self.pindex - 1;
    }
  }

  // Advances the cursor past any run of newline/comment/`\` tokens.
  pub skip_nl_or_comment() {
    for {
      fit self.tokens_peek_no_increment() {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            ret;
          }
          self.tokens_peek();
        }
        .None -> { ret; }
      }
    }
  }

  // Peeks at the next significant (non newline/comment) token without
  // consuming it. Updates `current_token` as a side effect, matching the
  // original -- diagnostics reported right after a peek still point at the
  // right place.
  pub token_peek_next() Option<Token> {
    self.skip_nl_or_comment();
    let pk = self.tokens_peek_no_increment();
    fit pk {
      .Some(t) -> {
        self.current_token = t;
        self.has_current_token = true;
      }
      .None -> { self.has_current_token = false; }
    }
    ret pk;
  }

  // Peeks at the n-th significant token at or after the cursor without
  // consuming anything (`n = 0` is equivalent to `token_peek_next`, minus
  // the `current_token` side effect).
  pub token_peek_n(num n) Option<Token> {
    num idx = self.pindex;
    num seen = 0;
    for {
      fit self.tokens_at(idx) {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            if seen == n {
              ret .Some(t);
            }
            seen = seen + 1;
          }
          idx = idx + 1;
        }
        .None -> { ret .None; }
      }
    }
  }

  pub tokens_at(num idx) Option<Token> {
    ret self.tokens.at(idx);
  }

  // Consumes and returns the next significant token, recording it as both
  // the current diagnostic position and `current_token`.
  pub token_next() Option<Token> {
    self.skip_nl_or_comment();
    fit self.tokens_peek_no_increment() {
      .Some(t) -> { self.pos = t.pos; }
      .None -> {}
    }
    let consumed = self.tokens_peek();
    fit consumed {
      .Some(t) -> {
        self.current_token = t;
        self.has_current_token = true;
      }
      .None -> { self.has_current_token = false; }
    }
    ret consumed;
  }

  // True if the next significant token is an `Operator` with text `op`,
  // without consuming it.
  pub next_token_is_operator(str op) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_operator(t, op); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token is the `Keyword` `keyword`, without
  // consuming it.
  pub next_token_is_keyword(str keyword) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_keyword(t, keyword); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token is the `Symbol` `c`, without
  // consuming it.
  pub next_token_is_symbol(chr c) bin {
    fit self.token_peek_next() {
      .Some(t) -> { ret token_is_symbol(t, c); }
      .None -> { ret false; }
    }
  }

  // True if the next significant token opens a generic-argument list: a
  // `<` (as an `Operator`, the common case, or a lexed `Symbol` in the rare
  // context where it wasn't combined into a longer operator).
  pub next_token_is_angle_open() bin {
    fit self.token_peek_next() {
      .Some(t) -> {
        fit t.type {
          .Operator -> {
            fit t.data {
              .Sval(s) -> { ret len(s) > 0 && s[0] == '<'; }
              _ -> { ret false; }
            }
          }
          .Symbol -> {
            fit t.data {
              .Cval(c) -> { ret c == '<'; }
              _ -> { ret false; }
            }
          }
          _ -> { ret false; }
        }
      }
      .None -> { ret false; }
    }
  }

  // Splits a lexed `>>` token in place into two adjacent `>` tokens, if the
  // next significant token is one. Needed so nested generics (`Vec<Vec<num>>`)
  // parse correctly: the lexer has no way to know `>>` here is two closing
  // angle brackets rather than the right-shift operator, since that
  // depends on the surrounding PARSE context, not just the characters.
  pub split_angle_closer_token_if_needed() {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        if t.type != TokenType.Operator {
          ret;
        }
        bin is_shr = false;
        fit t.data {
          .Sval(s) -> { is_shr = equals(s, ">>"); }
          _ -> {}
        }
        if !is_shr {
          ret;
        }
        Token first = t;
        first.data = TokenData.Sval(">");
        self.tokens.set(self.pindex, first);
        Token second = t;
        second.data = TokenData.Sval(">");
        self.tokens.insert(self.pindex + 1, second);
      }
      .None -> {}
    }
  }

  // Splits a lexed `<<` token in place into two adjacent `<` tokens, if the
  // next significant token is one. The opening-bracket counterpart to
  // `split_angle_closer_token_if_needed`, needed for the same reason when a
  // generic-argument list itself starts right after another `<`
  // (`Map<str, Vec<<T>>` style contexts do not arise from ordinary source,
  // but a `<<` can appear immediately before a nested generic's own opener
  // when the outer angle bracket was itself just split from a longer run).
  pub split_angle_opener_token_if_needed() {
    fit self.tokens_peek_no_increment() {
      .Some(t) -> {
        if t.type != TokenType.Operator {
          ret;
        }
        bin is_shl = false;
        fit t.data {
          .Sval(s) -> { is_shl = equals(s, "<<"); }
          _ -> {}
        }
        if !is_shl {
          ret;
        }
        Token first = t;
        first.data = TokenData.Sval("<");
        self.tokens.set(self.pindex, first);
        Token second = t;
        second.data = TokenData.Sval("<");
        self.tokens.insert(self.pindex + 1, second);
      }
      .None -> {}
    }
  }

  // Counts and consumes a run of `*` pointer-depth markers after a type
  // name (`num**` -> depth 2).
  pub parse_get_pointer_depth() num {
    num depth = 0;
    for self.next_token_is_operator("*") {
      depth = depth + 1;
      self.token_next();
    }
    ret depth;
  }

  // Resolves the n-th significant token strictly before physical index
  // `exclusive_end` (n = 0 -> the closest one). Always a linear backward
  // scan -- see the file-level note on the deferred O(1) lookahead cache.
  pub token_peek_prev_significant(num exclusive_end, num n) Option<Token> {
    num idx = exclusive_end - 1;
    num seen = 0;
    for idx >= 0 {
      fit self.tokens_at(idx) {
        .Some(t) -> {
          if !token_is_nl_or_comment_or_newline_separator(t) {
            if seen == n {
              ret .Some(t);
            }
            seen = seen + 1;
          }
        }
        .None -> { ret .None; }
      }
      idx = idx - 1;
    }
    ret .None;
  }

  // Peeks the previous non-skippable token (relative to the most recently
  // consumed token).
  pub token_peek_prev() Option<Token> {
    ret self.token_peek_prev_significant(self.pindex - 1, 0);
  }

  // Peeks the n-th previous non-skippable token (relative to the most
  // recently consumed token). `n = 0` is equivalent to `token_peek_prev`.
  pub token_peek_prev_n(num n) Option<Token> {
    ret self.token_peek_prev_significant(self.pindex - 1, n);
  }

  // Peeks the n-th previous non-skippable token relative to the NEXT token
  // to be consumed (i.e. what `token_peek_next` would return sits at
  // `self.pindex`; this looks backward from `pindex - 1`, `pindex - 2`, ...).
  // Often the more intuitive notion of "previous" for context-sensitive
  // parsing that hasn't consumed the token it's inspecting yet.
  pub token_peek_prev_stream_n(num n) Option<Token> {
    ret self.token_peek_prev_significant(self.pindex, n);
  }

  // Expects the next significant token to be the symbol `c`. Reports and
  // returns an error if it is anything else.
  pub expect_sym(chr c) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> {
        if t.type == TokenType.Symbol {
          fit t.data {
            .Cval(v) -> { matched = v == c; }
            _ -> {}
          }
        }
      }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected symbol '{chr}'", c);
    defer free(msg);
    self.err(msg);
    ret .Some(ParseErrorKind.InvalidSymbol);
  }

  // Expects the next significant token to be the operator `op`. Reports and
  // returns an error if it is anything else.
  pub expect_op(str op) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> { matched = token_is_operator(t, op); }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected operator '{str}'", op);
    defer free(msg);
    self.err(msg);
    ret .Some(ParseErrorKind.InvalidOperand);
  }

  // Expects the next significant token to be the keyword `keyword`. Reports
  // and returns an error if it is anything else.
  pub expect_keyword(str keyword) Option<ParseErrorKind> {
    bin matched = false;
    fit self.token_next() {
      .Some(t) -> { matched = token_is_keyword(t, keyword); }
      .None -> {}
    }
    if matched {
      ret .None;
    }
    let msg = format("expected keyword '{str}'", keyword);
    defer free(msg);
    self.err(msg);
    ret .Some(ParseErrorKind.InvalidKeyword);
  }

  // Retrieves a symbol by name from the active symbol table.
  pub get_symbol(str name) Option<Symbol> {
    if !self.has_active_table {
      ret .None;
    }
    num i = 0;
    let tbl = self.active_table;
    for i < tbl.symbols.len {
      let s = tbl.symbols.get(i);
      if equals(s.name, name) {
        ret .Some(s);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Adds `s` to the active symbol table.
  pub push_symbol(Symbol s) {
    self.active_table.symbols.push(s);
  }

  // Registers a scope entity in the current scope.
  pub push_scope_entity(ScopeEntity* entity) {
    self.scope_current.entities.push(entity);
  }

  // Looks up a scope entity by name, starting at the current scope and
  // walking up to (but not including) the global/root scope.
  pub get_scope_entity(str name) ScopeEntity* {
    let s = self.scope_current;
    for s != nil {
      let found = s.get_entity_by_name(name);
      if found != nil {
        ret found;
      }
      if !s.has_parent {
        ret nil;
      }
      s = s.parent;
    }
    ret nil;
  }

  // Walks up the current scope chain for the last-declared entity, stopping
  // at (not including) `stop_scope`.
  pub last_scope_entity_stop_at(Scope* stop_scope) ScopeEntity* {
    ret self.scope_current.last_entity_from_scope_stop_at(stop_scope);
  }

  // Pops and returns the last node pushed onto the output node list, or
  // `.None` if it's empty. Expression/statement parsing composes larger
  // nodes by popping their already-parsed children back off this list, the
  // same node-stack discipline the original uses throughout.
  pub node_pop() Option<Node> {
    if self.nodes.len == 0 {
      ret .None;
    }
    ret .Some(self.nodes.pop());
  }

  // Returns the last node WITHOUT popping it, or `.None` if empty.
  pub node_peek_last() Option<Node> {
    ret self.nodes.last();
  }

  // Establishes the root/global scope. Called once, before parsing the
  // first top-level declaration.
  pub init_root_scope() {
    Scope* root = malloc(sizeof(Scope));
    *root = scope_new();
    self.scope_root = root;
    self.has_scope_root = true;
    self.scope_current = root;
    self.has_scope_current = true;
  }

  // Pushes a new child scope (e.g. entering a function/block body), parented
  // to whatever scope was current.
  pub new_scope() {
    Scope* nc = malloc(sizeof(Scope));
    *nc = scope_new();
    if self.has_scope_current {
      nc.parent = self.scope_current;
      nc.has_parent = true;
    }
    self.scope_current = nc;
    self.has_scope_current = true;
  }

  // Pops back to the enclosing scope (e.g. leaving a function/block body).
  // A no-op past the root scope.
  pub finish_scope() {
    if !self.has_scope_current {
      ret;
    }
    let cur = self.scope_current;
    if cur.has_parent {
      self.scope_current = cur.parent;
    } else {
      self.has_scope_current = false;
    }
  }

  // Parses `<T>` or `<T: a | b, U: c>` generic type PARAMETERS in a
  // function/impl header (as opposed to `parse_generic_type_args`, which
  // parses generic ARGUMENTS at a type-reference site). A no-op (not an
  // error) when there's no `<...>` at all -- generics are optional.
  // 
  // Fills `out_params` with the parameter names. When any parameter
  // carries a `: constraint` bound, also fills `out_forced_insts` with the
  // Cartesian product of every parameter's constraint set: one combo per
  // product term, each a `Vec<str>` of one concrete type per parameter (in
  // parameter order) -- e.g. `<T: num | dec>` produces `[["num"],
  // ["dec"]]`; `<T: num | dec, U: a | b>` produces all four `[T, U]`
  // pairings. Used elsewhere to type-check that a generic call's inferred
  // type arguments satisfy the constraints; parsing doesn't interpret the
  // constraint names itself; they're just captured as strings.
  pub parse_type_params_with_constraints(Vec<str>* out_params, Vec<Vec<str>> *out_forced_insts) Option<ParseErrorKind> {
    self.split_angle_opener_token_if_needed();
    if !self.next_token_is_angle_open() {
      ret .None;
    }
    self.token_next(); // consume '<'

    Vec<Vec<str>> param_constraints;
    param_constraints.init(0);
    bin has_constraints = false;

    for true {
      let tok = self.token_next();
      if tok.is_none() || tok.unwrap().type != TokenType.Identifier {
        self.err("expected generic parameter name");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      str name = "";
      fit tok.unwrap().data {
        .Sval(s) -> { name = s; }
        _ -> {}
      }
      out_params.push(name);

      Vec<str> constraints;
      constraints.init(0);
      if self.next_token_is_operator(":") {
        self.token_next(); // consume ':'
        has_constraints = true;
        for true {
          let ct = self.token_next();
          if ct.is_none() {
            self.err("expected type name in constraint after ':'");
            ret .Some(ParseErrorKind.InvalidIdentifier);
          }
          let ctok = ct.unwrap();
          if ctok.type != TokenType.Keyword && ctok.type != TokenType.Identifier {
            self.err("expected type name in constraint");
            ret .Some(ParseErrorKind.InvalidIdentifier);
          }
          str cname = "";
          fit ctok.data {
            .Sval(s) -> { cname = s; }
            _ -> {}
          }
          constraints.push(cname);
          if self.next_token_is_operator("|") {
            self.token_next();
            continue;
          }
          break;
        }
      }
      param_constraints.push(constraints);

      if self.next_token_is_operator(",") {
        self.token_next();
        continue;
      }
      break;
    }

    self.split_angle_closer_token_if_needed();
    if self.next_token_is_operator(">") {
      let err = self.expect_op(">");
      if err.is_some() {
        ret err;
      }
    } else {
      let err = self.expect_sym('>');
      if err.is_some() {
        ret err;
      }
    }

    if has_constraints {
      Vec<Vec<str>> combos;
      combos.init(0);
      Vec<str> initial;
      initial.init(0);
      combos.push(initial);

      for pc : param_constraints {
        Vec<Vec<str>> new_combos;
        new_combos.init(0);
        for existing : combos {
          for ct : pc {
            Vec<str> new_combo;
            new_combo.init(0);
            for et : existing {
              new_combo.push(et);
            }
            new_combo.push(ct);
            new_combos.push(new_combo);
          }
        }
        combos = new_combos;
      }

      for combo : combos {
        out_forced_insts.push(combo);
      }
    }

    ret .None;
  }

  // Parses a bracketed generic-argument list (`<T, U>`) into `dt.generic_args`,
  // if the next significant token opens one. A no-op (not an error) when it
  // doesn't, since a type name may simply not be generic.
  // 
  // Deferred from this slice: an array-typed argument (`Vec<num[]>`) --
  // needs `parse_array_brackets`, which needs the expression parser (array
  // sizes are arbitrary expressions), a much later slice. A generic arg
  // that starts with `[` currently falls through to `parse_datatype`
  // reporting `InvalidDataType`, which is the same outcome as any other
  // not-yet-supported syntax in this partial port.
  pub parse_generic_type_args(DataType* dt) Option<ParseErrorKind> {
    self.split_angle_opener_token_if_needed();
    if !self.next_token_is_angle_open() {
      ret .None;
    }
    self.token_next();

    Vec<DataType*> args;
    args.init(0);

    for true {
      DataType* adt = malloc(sizeof(DataType));
      *adt = dtype_new();
      let err = self.parse_datatype(adt);
      if err.is_some() {
        ret err;
      }
      args.push(adt);

      if self.next_token_is_operator(",") {
        self.token_next();
        continue;
      }
      break;
    }

    self.split_angle_closer_token_if_needed();
    if self.next_token_is_operator(">") {
      let err = self.expect_op(">");
      if err.is_some() {
        ret err;
      }
    } else {
      let err = self.expect_sym('>');
      if err.is_some() {
        ret err;
      }
    }
    dt.generic_args = args;
    ret .None;
  }

  // Parses a type annotation into `dt`: a builtin scalar keyword, a
  // user-defined/identifier-based name (optionally alias-qualified,
  // `mod.Type`), its generic arguments if any, then a trailing run of `*`
  // pointer-depth markers. Trailing array-bracket suffixes (`num[5]`,
  // `str[]`) are a separate function, `parse_array_brackets` -- matching
  // the original's own `parse_datatype`/`parse_array_brackets` split --
  // called explicitly by each site that allows one (`parse_variable`,
  // compound fields, enum payloads, quirk/function/impl-method
  // arg/return types), not from within this function itself.
  // 
  // Deferred from this slice: the `fun(T1, T2) R` function-type
  // parameter form -- needs its own arg-list/return-type recursion,
  // matching the original's own `parse_fn_type_datatype` split.
  pub parse_datatype(DataType* dt) Option<ParseErrorKind> {
    let tok = self.token_next();
    if tok.is_none() {
      self.err("expected datatype, got end of input");
      ret .Some(ParseErrorKind.InvalidDataType);
    }
    let dt_token = tok.unwrap();
    if dt_token.type != TokenType.Keyword && dt_token.type != TokenType.Identifier {
      self.err("expected datatype");
      ret .Some(ParseErrorKind.InvalidDataType);
    }

    str name = "";
    fit dt_token.data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    // Builtins use `dt.kind`; user-defined types keep `.Unknown` and rely
    // on `type_str`.
    if dt_token.type == TokenType.Keyword {
      if !keyword_is_datatype(name) {
        self.err(format("unexpected keyword '{str}' in datatype position", name));
        ret .Some(ParseErrorKind.InvalidDataType);
      }
      dt.kind = get_datatype_type(name);
      if dt.kind == DataTypeType.Unknown {
        self.err("unknown datatype");
        ret .Some(ParseErrorKind.InvalidDataType);
      }
    } else {
      // Identifier-based types (e.g. C typedefs like `size_t`, or a
      // user compound/enum) are allowed. A small set of common C typedef
      // names get tagged with a numeric semantic type so arithmetic/
      // comparisons typecheck, while still emitting the original
      // identifier in C via `type_str`.
      let builtin_kind = get_datatype_type(name);
      if builtin_kind != DataTypeType.Unknown {
        dt.kind = builtin_kind;
      } else {
        fit get_c_typedef_alias_datatype_type(name) {
          .Some(k) -> { dt.kind = k; }
          .None -> { dt.kind = .Unknown; }
        }
      }
    }
    dt.type_str = name;

    // Qualified user-defined types via module alias (`imp mod as m; m.Type`).
    // Mangled internally as `a__b` to match symbol/type naming.
    if dt_token.type == TokenType.Identifier {
      for self.next_token_is_operator(".") || self.next_token_is_symbol('.') {
        self.token_next();
        let seg = self.token_next();
        if seg.is_none() || seg.unwrap().type != TokenType.Identifier {
          self.err("expected identifier after '.' in qualified datatype");
          ret .Some(ParseErrorKind.InvalidDataType);
        }
        str seg_name = "";
        fit seg.unwrap().data {
          .Sval(s) -> { seg_name = s; }
          _ -> {}
        }
        dt.kind = .Unknown;
        dt.type_str = format("{str}__{str}", dt.type_str, seg_name);
      }
    }

    let gerr = self.parse_generic_type_args(dt);
    if gerr.is_some() {
      ret gerr;
    }

    let ptr_depth = self.parse_get_pointer_depth();
    if ptr_depth > 0 {
      dt.flags.is_pointer = true;
      dt.pointer_depth = ptr_depth;
    }

    ret .None;
  }

  // True if the `<...>` starting at the cursor looks like a type
  // PARAMETER list (`<T>`, `<T, U>`, `<T: a | b>`) rather than concrete
  // generic ARGUMENTS (`<num>`, `<Vec<str>>`) -- pure lookahead, consumes
  // nothing. Used by `parse_impl` to distinguish `impl Vec<T> { ... }`
  // (T is a NEW type param the impl introduces) from `impl Vec<num> {
  // ... }` (a concrete monomorphizing impl for an already-generic type).
  // Every segment must be a bare identifier (optionally with `: constraint
  // | constraint` bounds) all the way to the closing `>`/`>>` -- anything
  // else (a datatype keyword, a nested `<`, ...) means it's argument
  // syntax instead.
  pub impl_generic_args_are_params() bin {
    num off = 0;
    let first_opt = self.token_peek_n(off);
    if first_opt.is_none() {
      ret false;
    }
    let first = first_opt.unwrap();
    if !(token_is_operator(first, "<") || token_is_symbol(first, '<')) {
      ret false;
    }
    off = off + 1;

    bin saw_any = false;
    for true {
      let tok_opt = self.token_peek_n(off);
      if tok_opt.is_none() {
        ret false;
      }
      if tok_opt.unwrap().type != TokenType.Identifier {
        ret false;
      }
      saw_any = true;
      off = off + 1;

      let next_opt = self.token_peek_n(off);
      if next_opt.is_none() {
        ret false;
      }
      let nt = next_opt.unwrap();

      if token_is_operator(nt, ":") {
        off = off + 1;
        for true {
          let ct_opt = self.token_peek_n(off);
          if ct_opt.is_none() {
            ret false;
          }
          let ct = ct_opt.unwrap();
          if ct.type == TokenType.Keyword || ct.type == TokenType.Identifier {
            off = off + 1;
          } else {
            ret false;
          }
          let sep_opt = self.token_peek_n(off);
          if sep_opt.is_none() {
            ret false;
          }
          if token_is_operator(sep_opt.unwrap(), "|") {
            off = off + 1;
            continue;
          }
          break;
        }
        let after_opt = self.token_peek_n(off);
        if after_opt.is_none() {
          ret false;
        }
        let after = after_opt.unwrap();
        if token_is_operator(after, ",") {
          off = off + 1;
          continue;
        }
        if token_is_operator(after, ">") || token_is_operator(after, ">>") || token_is_symbol(
          after,
          '>'
        ) {
          ret saw_any;
        }
        ret false;
      }

      if token_is_operator(nt, ",") {
        off = off + 1;
        continue;
      }
      if token_is_operator(nt, ">") || token_is_operator(nt, ">>") || token_is_symbol(nt, '>') {
        ret saw_any;
      }
      ret false;
    }
  }
}

// The parser's OWN state, layered on top of the shared `ParseState`: a
// pointer back to that shared state plus the handful of fields that are
// genuinely parser-local (current body/function context for `binded`
// stamping, expression-recursion depth, `fit`-condition tracking). Mirrors
// the original's `ParseProcess` holding a `*TranspileProcess` plus its own
// small field set.
pub compound Parser {
  ParseState* state;

  // The most recently consumed significant token.
  Token last_token;
  bin has_last_token;

  // The body/function node currently being parsed, used to stamp newly
  // created nodes' `binded` context (see `create_node`).
  Node* current_body;
  bin has_current_body;
  Node* current_function;
  bin has_current_function;

  // Current native-recursion depth of the recursive-descent expression
  // parser. See the original's `max_parse_expr_depth` note: guards against
  // stack-overflow crashes on pathological input.
  num expr_depth;

  // True while parsing a `fit` arm CONDITION, where pattern bindings like
  // `Enum.Variant(x, y)` introduce new identifiers not yet in scope.
  bin in_fit_condition;

  // True for the ENTIRE duration of parsing a `fit` statement (its subject
  // expression, every arm's condition, and every arm's body) -- stops the
  // general expression loop from swallowing a following `->` as a (bogus)
  // binary operator, since `->` is only ever the fit-arm delimiter, never
  // a real expression operator. Without this, `fit x { 1 -> { a; } ...`
  // over-consumes: after parsing `1`, `parse_expressionable`'s loop sees
  // `->` next and, with nothing telling it otherwise, treats it as a
  // binary-operator continuation and keeps parsing rightward through the
  // arm's whole body.
  bin in_fit_statement;
}

// Creates a new `Parser` over the given shared parse state.
pub fun parser_new(ParseState* state) Parser {
  Parser p;
  p.state = state;
  p.has_last_token = false;
  p.current_body = nil;
  p.has_current_body = false;
  p.current_function = nil;
  p.has_current_function = false;
  p.expr_depth = 0;
  p.in_fit_condition = false;
  p.in_fit_statement = false;
  ret p;
}

impl Parser {
  // Creates and registers a new node in the parse state's node list,
  // stamping its `binded` owner/function context from whatever body/
  // function is currently being parsed.
  pub create_node(Node* n) {
    BindedNode* binded = nil;
    bin is_bound = false;

    if self.has_current_body {
      Node* owner = malloc(sizeof(Node));
      *owner = *self.current_body;
      owner.has_binded = false;
      owner.binded = nil;
      binded = malloc(sizeof(BindedNode));
      binded.owner = owner;
      binded.has_owner = true;
      binded.function = nil;
      binded.has_function = false;
      is_bound = true;
    }

    if self.has_current_function {
      Node* function = malloc(sizeof(Node));
      *function = *self.current_function;
      function.has_binded = false;
      function.binded = nil;
      if !is_bound {
        binded = malloc(sizeof(BindedNode));
        binded.owner = nil;
        binded.has_owner = false;
      }
      binded.function = function;
      binded.has_function = true;
      is_bound = true;
    }

    if is_bound {
      n.binded = binded;
      n.has_binded = true;
    } else {
      n.binded = nil;
      n.has_binded = false;
    }

    self.state.nodes.push(*n);
  }

  // Consumes the next token and turns it into a single leaf AST node: a
  // number/character literal, an identifier, a string literal, or a
  // boolean literal. Anything else (an operator, a grouping symbol, a
  // keyword, ...) is an error -- this handles exactly the PRIMARY tokens
  // of an expression, not operators or grouping, which belong to the
  // expression parser built on top of this.
  pub parse_single_token_to_node() Option<ParseErrorKind> {
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected token, got eof");
      ret .Some(ParseErrorKind.InvalidToken);
    }
    let t = tok.unwrap();
    fit t.type {
      .Number -> {
        fit t.data {
          .Num(n) -> {
            Node node = node_new(NodeKind.Number(TokenData.Num(n)));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          .Dec(d) -> {
            Node node = node_new(NodeKind.Number(TokenData.Dec(d)));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          // A character literal lexes as a `Number`-type token carrying
          // `Cval` data (see lexer.fn's `_read_char`); it becomes a
          // `Character` AST node here, not a `Number` one.
          .Cval(c) -> {
            Node node = node_new(NodeKind.Character(c));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {
            self.state.err("invalid number token");
            ret .Some(ParseErrorKind.InvalidToken);
          }
        }
      }
      .Identifier -> {
        str name = "";
        fit t.data {
          .Sval(s) -> { name = s; }
          _ -> {}
        }

        let prev = self.state.token_peek_prev();
        bin is_member_access = false;
        fit prev {
          .Some(p) -> { is_member_access = token_is_operator(p, "."); }
          .None -> {}
        }

        // Allow type operands inside `sizeof(Type)` even when the
        // identifier isn't declared as a value symbol yet (supports
        // forward-declared custom types).
        bin is_sizeof_type_operand = false;
        fit prev {
          .Some(p) -> {
            if token_is_operator(p, "(") {
              fit self.state.token_peek_prev_n(1) {
                .Some(p2) -> {
                  if p2.type == TokenType.Identifier {
                    fit p2.data {
                      .Sval(s2) -> { is_sizeof_type_operand = equals(s2, "sizeof"); }
                      _ -> {}
                    }
                  }
                }
                .None -> {}
              }
            }
          }
          .None -> {}
        }

        // `_` is a wildcard identifier (used by `fit` default branches):
        // accepted even when not declared. Otherwise an identifier that
        // isn't a known scope entity/symbol/global symbol is only valid
        // as a member-access target, an ALL_CAPS C-macro-style constant,
        // an out-of-order function call (`foo(...)`), a possible enum
        // member access (`Foo.Bar`), or inside a `fit` condition (where
        // data-carrying-enum pattern bindings aren't in scope yet).
        if !equals(name, "_") {
          if !is_member_access {
            if !is_sizeof_type_operand && self.state.get_scope_entity(name) == nil {
              if self.state.get_symbol(name).is_none() && !self.state.global_symbols.has(name) {
                if !_is_c_macro_ident(name) {
                  bin is_possible_enum_member_access = self.state.next_token_is_operator(".");
                  if !self.state.next_token_is_operator("(") && !is_possible_enum_member_access && !self.in_fit_condition {
                    let msg = format("unknown identifier '{str}'", name);
                    defer free(msg);
                    self.state.err(msg);
                    ret .Some(ParseErrorKind.InvalidIdentifier);
                  }
                }
              }
            }
          }
        }

        Node node = node_new(NodeKind.Identifier(name));
        node.pos = t.pos;
        node.has_pos = true;
        self.create_node(&node);
      }
      .String -> {
        fit t.data {
          .Sval(s) -> {
            Node node = node_new(NodeKind.String(s));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {}
        }
      }
      .Boolean -> {
        fit t.data {
          .Bval(b) -> {
            Node node = node_new(NodeKind.Boolean(b));
            node.pos = t.pos;
            node.has_pos = true;
            self.create_node(&node);
          }
          _ -> {}
        }
      }
      _ -> {
        self.state.err("expected single token");
        ret .Some(ParseErrorKind.InvalidToken);
      }
    }
    ret .None;
  }

  // Builds a binary `Expression` node (`left_node op right_node`) and
  // pushes it via `create_node`. Copies both operands onto the heap so the
  // new node owns stable pointers to them, matching every other
  // node-construction site in this file.
  // 
  // Simplified from the original: takes a required `op_pos` rather than
  // the original's three-way `op_pos orelse left.pos orelse right.pos`
  // fallback, since nothing ported so far ever calls this without a real
  // operator token position. Revisit if a future caller needs the fallback.
  pub make_expression_node(Node* left_node, Node* right_node, str op, Pos op_pos) {
    Node* left = malloc(sizeof(Node));
    *left = *left_node;
    Node* right = malloc(sizeof(Node));
    *right = *right_node;

    ExprNode e;
    e.left = left;
    e.has_left = true;
    e.right = right;
    e.has_right = true;
    e.op = op;

    Node node = node_new(NodeKind.Expression(e));
    node.pos = op_pos;
    node.has_pos = true;
    self.create_node(&node);
  }

  // Rewrites `node = (a op1 (b op2 c))` in place to `((a op1 b) op2 c)`: a
  // left tree rotation used by `parse_reorder_expression` to fix precedence
  // when `op1` should bind tighter than (or equal to) `op2`, but the
  // parser's naive left-to-right build produced the right-heavy shape
  // instead. A no-op when the right child isn't itself an `Expression`
  // (nothing to rotate) or either side is missing.
  // 
  // Structurally identical to `parse_node_move_right_left_to_left` below --
  // the original has the two as separate functions (one additionally frees
  // the detached old right-node shell, which this port doesn't need since
  // nothing here manually frees memory; see the file-level note), called
  // from `parse_reorder_expression`'s two different trigger conditions.
  // Kept as two functions to mirror the original's structure/call sites.
  pub parse_node_shift_children_left(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_right || !exp.has_left {
          ret;
        }
        fit exp.right.kind {
          .Expression(right_exp) -> {
            if !right_exp.has_left || !right_exp.has_right {
              ret;
            }
            ExprNode new_left_e;
            new_left_e.left = exp.left;
            new_left_e.has_left = true;
            new_left_e.right = right_exp.left;
            new_left_e.has_right = true;
            new_left_e.op = exp.op;

            Node* new_left = malloc(sizeof(Node));
            *new_left = node_new(NodeKind.Expression(new_left_e));
            new_left.pos = node.pos;
            new_left.has_pos = true;

            exp.left = new_left;
            exp.right = right_exp.right;
            exp.op = right_exp.op;
            node.kind = NodeKind.Expression(exp);
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // The same `(a op1 (b op2 c))` -> `((a op1 b) op2 c)` rotation as
  // `parse_node_shift_children_left`, used by `parse_reorder_expression`'s
  // OTHER trigger condition (an array-index/call/index left operand paired
  // with an assignment/comma right operand). See that function's doc
  // comment for why this is a separate function despite the identical body.
  pub parse_node_move_right_left_to_left(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_right || !exp.has_left {
          ret;
        }
        fit exp.right.kind {
          .Expression(right_exp) -> {
            if !right_exp.has_left || !right_exp.has_right {
              ret;
            }
            ExprNode completed_e;
            completed_e.left = exp.left;
            completed_e.has_left = true;
            completed_e.right = right_exp.left;
            completed_e.has_right = true;
            completed_e.op = exp.op;

            Node* completed = malloc(sizeof(Node));
            *completed = node_new(NodeKind.Expression(completed_e));
            completed.pos = node.pos;
            completed.has_pos = true;

            exp.left = completed;
            exp.right = right_exp.right;
            exp.op = right_exp.op;
            node.kind = NodeKind.Expression(exp);
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // Recursively reorders `node` (and its descendants) for correct operator
  // precedence, after the naive left-to-right expression build. Two
  // independent fixups:
  // 
  // 1. If the right child is itself an `Expression` and the OUTER operator
  // has priority over the right child's operator (binds tighter, or equal
  // with left-to-right associativity), rotate left via
  // `parse_node_shift_children_left` and recurse into both new children --
  // a single rotation may not be enough for a longer chain (`a + b * c * d`
  // needs two).
  // 2. Independently (not exclusive with the above): if the left operand
  // looks like an array index paired with an assignment on the right
  // (`arr[i] = v` shaped oddly by the naive build), or a call/index operand
  // paired with a comma-expression on the right (multi-arg call/index
  // arguments), apply `parse_node_move_right_left_to_left` to fix that
  // specific shape.
  pub parse_reorder_expression(Node* node) {
    fit node.kind {
      .Expression(exp) -> {
        if !exp.has_left || !exp.has_right {
          ret;
        }

        bin left_is_expr = _is_expression_kind(exp.left);
        bin right_is_expr = _is_expression_kind(exp.right);
        if !left_is_expr && !right_is_expr {
          ret;
        }

        if right_is_expr {
          fit exp.right.kind {
            .Expression(right_exp) -> {
              if left_has_priority(exp.op, right_exp.op) {
                self.parse_node_shift_children_left(node);
                fit node.kind {
                  .Expression(rotated) -> {
                    self.parse_reorder_expression(rotated.left);
                    self.parse_reorder_expression(rotated.right);
                  }
                  _ -> {}
                }
              }
            }
            _ -> {}
          }
        }

        // Re-read node.kind: the rotation above (if it ran) mutated it.
        fit node.kind {
          .Expression(exp2) -> {
            bin left_is_array = node_is_array(*exp2.left);
            bin right_is_assign = node_is_assignment(*exp2.right);
            bin left_is_call_or_index = node_is_expression(*exp2.left, "()") || node_is_expression(
              *exp2.left,
              "[]"
            );
            bin right_is_comma = node_is_expression(*exp2.right, ",");
            if (left_is_array && right_is_assign) || (left_is_call_or_index && right_is_comma) {
              self.parse_node_move_right_left_to_left(node);
            }
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // The last node on the output list, if it's still a valid expression
  // operand (a literal/identifier/unary/nested-expression -- not, say, a
  // just-finished statement). `.None` when the list is empty or the last
  // node isn't operand-shaped. Used to tell "an operator here continues a
  // left operand already on the stack" (a binary operator) from "an
  // operator here STARTS a new operand" (a prefix/unary position).
  pub node_peek_expressionable() Option<Node> {
    fit self.state.node_peek_last() {
      .Some(n) -> {
        if node_is_expressionable(n) {
          ret .Some(n);
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Parses a single "expressionable" token into a node and pushes it:
  // literals, identifiers, and strings go through `parse_single_token_to_node`;
  // an operator token is handed to `parse_expression` (grouping or a binary
  // continuation). Any other token kind (a keyword, a structural symbol, a
  // newline/comment) is not an error here -- it just means there's nothing
  // (more) to parse at this position, signaled by leaving the output list
  // unchanged (see `parse_expressionable`, which loops on exactly that).
  // 
  // Deliberately simplified from the original for this slice: no channel
  // operators (`<-`), no keyword operands (`nil`, `panic(...)`, `await`,
  // `sizeof`). Each is a self-contained follow-up slice once this core
  // binary-expression loop is solid. (Prefix/postfix unary operators and
  // enum-variant shorthand, `.Variant`/`.Variant(payload)`, ARE supported --
  // routed through `parse_expression`/`parse_normal_expression` below.)
  pub parse_expressionable_single() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        // A `fit` arm's comma-separated multi-pattern list only supports
        // string-literal patterns today, not bare enum-variant shorthand
        // (confirmed directly: `.A, .B -> {}` fails to parse where `"a",
        // "b" -> {}` works fine) -- a real language gap, but an unrelated
        // one (lives in the fit-statement grammar, not ported/touched by
        // this slice), so this uses an if/elif chain instead rather than
        // detouring to fix it now.
        if t.type == TokenType.Number || t.type == TokenType.Boolean || t.type == TokenType.Identifier || t.type == TokenType.String {
          ret self.parse_single_token_to_node();
        }
        if t.type == TokenType.Operator {
          // `->` is only ever the fit-arm delimiter, never a real
          // expression operator -- while inside a fit statement, treat it
          // as "nothing more to parse here" rather than a binary
          // continuation. See `Parser.in_fit_statement`'s doc comment.
          if self.in_fit_statement && token_is_operator(t, "->") {
            ret .None;
          }
          ret self.parse_expression();
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Repeatedly parses expressionable tokens until a call makes no further
  // progress (the output list stops growing) or an error occurs.
  pub parse_expressionable() Option<ParseErrorKind> {
    for true {
      num before = self.state.nodes.len;
      let err = self.parse_expressionable_single();
      if err.is_some() {
        ret err;
      }
      if self.state.nodes.len == before {
        ret .None;
      }
    }
  }

  // Like `parse_expressionable`, but requires at least one node to have
  // been produced -- the entry point for a position that MUST be an
  // expression (an initializer, a condition, ...), as opposed to a
  // position where an expression is merely optional.
  pub parse_expressionable_root() Option<ParseErrorKind> {
    num before = self.state.nodes.len;
    let err = self.parse_expressionable();
    if err.is_some() {
      ret err;
    }
    if self.state.nodes.len == before {
      self.state.err("expected expression");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    ret .None;
  }

  // If the next token is an operator, parses another full expressionable
  // continuation (used after a primary/postfix form to pick up whatever
  // binary operator follows, e.g. after closing a parenthesized group).
  pub parse_additional_expression() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        if t.type == TokenType.Operator {
          ret self.parse_expressionable();
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
  }

  // Parses a parenthesized group `(...)`. If a value was already sitting on
  // the output list right before the `(` (e.g. an already-parsed callee
  // identifier), it's popped and combined with the parenthesized contents
  // into a `()`-op call `Expression` node -- this is how function/method
  // calls are represented: `Expression{ left = callee, right =
  // ExpressionParenthesis{ ... }, op = "()" }`. Otherwise the parenthesized
  // contents are pushed as a plain `ExpressionParenthesis` grouping node.
  // Either way, finishes by picking up any further operator continuation
  // via `parse_additional_expression`.
  pub parse_for_parenthesis() Option<ParseErrorKind> {
    let lparen_err = self.state.expect_op("(");
    if lparen_err.is_some() {
      ret lparen_err;
    }

    Node left_node = node_new(NodeKind.Blank);
    bin has_left_node = false;
    fit self.state.node_peek_last() {
      .Some(n) -> {
        if node_is_value_type(n) {
          left_node = n;
          has_left_node = true;
          self.state.node_pop();
        }
      }
      .None -> {}
    }

    Node exp_node = node_new(NodeKind.Blank);
    if !self.state.next_token_is_symbol(')') {
      let err = self.parse_expressionable_root();
      if err.is_some() {
        ret err;
      }
      fit self.state.node_pop() {
        .Some(n) -> { exp_node = n; }
        .None -> {}
      }
    }

    let rparen_err = self.state.expect_sym(')');
    if rparen_err.is_some() {
      ret rparen_err;
    }

    Node* exp = malloc(sizeof(Node));
    *exp = exp_node;
    Node paren_node = node_new(NodeKind.ExpressionParenthesis(exp));
    self.create_node(&paren_node);

    if has_left_node {
      fit self.state.node_pop() {
        .Some(popped_paren) -> {
          Node* left = malloc(sizeof(Node));
          *left = left_node;
          Node* right = malloc(sizeof(Node));
          *right = popped_paren;

          ExprNode call_e;
          call_e.left = left;
          call_e.has_left = true;
          call_e.right = right;
          call_e.has_right = true;
          call_e.op = "()";
          Node call_node = node_new(NodeKind.Expression(call_e));
          self.create_node(&call_node);
        }
        .None -> {}
      }
    }

    ret self.parse_additional_expression();
  }

  // Parses a pointer-indirection unary (`*p`, `**pp`): a run of `*`s
  // (the pointer depth being dereferenced) followed by the operand
  // expression. Kept separate from `parse_for_normal_unary` because a
  // following run of `*`s is a POINTER-DEPTH COUNT, not a chain of
  // separately-nested unary `Expression`/`Unary` operators.
  pub parse_for_indirection_unary() Option<ParseErrorKind> {
    let star_tok = self.state.token_peek_next();
    let depth = self.state.parse_get_pointer_depth();

    let err = self.parse_expressionable();
    if err.is_some() {
      ret err;
    }
    let maybe_operand = self.state.node_pop();
    if maybe_operand.is_none() {
      self.state.err("expected operand for pointer indirection");
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node operand_val = maybe_operand.unwrap();
    Node* operand = malloc(sizeof(Node));
    *operand = operand_val;

    UnaryNode u;
    u.is_left_operanded_unary = false;
    u.op = "*";
    u.operand = operand;
    u.has_indirection = true;
    u.indirection_depth = depth;

    Node unode = node_new(NodeKind.Unary(u));
    fit star_tok {
      .Some(t) -> {
        unode.pos = t.pos;
        unode.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&unode);
    ret .None;
  }

  // Parses a non-indirection prefix unary (`-x`, `!x`, `~x`, `&x`, `++x`,
  // `--x`): consumes the operator, parses its operand, and wraps it in a
  // `Unary` node.
  pub parse_for_normal_unary() Option<ParseErrorKind> {
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected unary operator");
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    let unary_tok = tok.unwrap();
    str unary_op = "";
    fit unary_tok.data {
      .Sval(s) -> { unary_op = s; }
      _ -> {}
    }

    let err = self.parse_expressionable();
    if err.is_some() {
      ret err;
    }
    let maybe_operand = self.state.node_pop();
    if maybe_operand.is_none() {
      let msg = format("expected operand for unary operator '{str}'", unary_op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node operand_val = maybe_operand.unwrap();
    Node* operand = malloc(sizeof(Node));
    *operand = operand_val;

    UnaryNode u;
    u.is_left_operanded_unary = false;
    u.op = unary_op;
    u.operand = operand;
    u.has_indirection = false;
    u.indirection_depth = 0;

    Node unode = node_new(NodeKind.Unary(u));
    unode.pos = unary_tok.pos;
    unode.has_pos = true;
    self.create_node(&unode);
    ret .None;
  }

  // Parses a prefix unary expression, routing indirection (`*p`) to its own
  // parser (a following `*` run is a pointer-depth count, not a normal
  // operand parse) and picking up any further operator continuation
  // afterward (e.g. `-x + 1`).
  pub parse_for_unary() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("expected unary operator");
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    str unary_op = "";
    fit tok.unwrap().data {
      .Sval(s) -> { unary_op = s; }
      _ -> {}
    }
    if is_indirection_operator(unary_op) {
      ret self.parse_for_indirection_unary();
    }
    let err = self.parse_for_normal_unary();
    if err.is_some() {
      ret err;
    }
    ret self.parse_additional_expression();
  }

  // Wraps an already-parsed LEFT operand in a postfix `Unary` node
  // (`x++`/`x--`) instead of treating the operator as a binary continuation.
  pub parse_for_left_operanded_unary(Node* node_left, str unary_op, Pos op_pos) {
    UnaryNode u;
    u.is_left_operanded_unary = true;
    u.op = unary_op;
    u.operand = node_left;
    u.has_indirection = false;
    u.indirection_depth = 0;

    Node unode = node_new(NodeKind.Unary(u));
    unode.pos = op_pos;
    unode.has_pos = true;
    self.create_node(&unode);
  }

  // Dispatches on the next token to the right expression-shape parser: `(`
  // starts a parenthesized group/call, anything else is a binary-operator
  // continuation via `parse_normal_expression`.
  // 
  // Deliberately simplified from the original for this slice: no `,`
  // (comma-expression) or `[` (bracket/array-literal) dispatch yet.
  pub parse_expression() Option<ParseErrorKind> {
    fit self.state.token_peek_next() {
      .Some(t) -> {
        bin is_lparen = false;
        fit t.data {
          .Sval(s) -> { is_lparen = equals(s, "("); }
          _ -> {}
        }
        if is_lparen {
          ret self.parse_for_parenthesis();
        }
        ret self.parse_normal_expression();
      }
      .None -> { ret .None; }
    }
  }

  // Parses a binary-operator continuation, a prefix unary (when no left
  // operand precedes the operator), or a postfix unary (`x++`/`x--`, when
  // one does). For the binary case: consumes the operator, parses its
  // right-hand operand, combines it with the left operand already on the
  // output list into an `Expression` node via `make_expression_node`, then
  // fixes precedence via `parse_reorder_expression`.
  // 
  // Deliberately simplified from the original for this slice: no channel
  // `<-` prefix form, and no `.{...}` compound-init shorthand yet (needs
  // `parse_compound_init`, not ported). A binary RHS must be a
  // parenthesized group or another `parse_expressionable` continuation (no
  // unary RHS, e.g. `a + -b` isn't supported yet).
  pub parse_normal_expression() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("expected operator in expression");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    let t = tok.unwrap();
    str op = "";
    fit t.data {
      .Sval(s) -> { op = s; }
      _ -> {}
    }
    let op_pos = t.pos;

    let maybe_left = self.node_peek_expressionable();
    if maybe_left.is_none() {
      // Enum-variant shorthand (`.Variant`, `.Variant(payload)`): parsed as
      // a `.` dot-expression with a BLANK left side, so later passes can
      // resolve it using the expected enum type from context. A following
      // `(...)` (a payload) is picked up afterward by the general postfix
      // continuation, same as any other primary.
      if equals(op, ".") {
        self.state.token_next(); // consume '.'
        let idtok = self.state.token_next();
        if idtok.is_none() || idtok.unwrap().type != TokenType.Identifier {
          self.state.err("expected identifier after '.'");
          ret .Some(ParseErrorKind.InvalidIdentifier);
        }
        let idt = idtok.unwrap();
        str variant_name = "";
        fit idt.data {
          .Sval(s) -> { variant_name = s; }
          _ -> {}
        }
        Node right = node_new(NodeKind.Identifier(variant_name));
        right.pos = idt.pos;
        right.has_pos = true;
        right.flags.inside_expression = true;

        Node left = node_new(NodeKind.Blank);
        left.pos = op_pos;
        left.has_pos = true;
        left.flags.inside_expression = true;

        self.make_expression_node(&left, &right, ".", op_pos);
        fit self.state.node_pop() {
          .Some(built) -> {
            Node shorthand = built;
            self.parse_reorder_expression(&shorthand);
            self.state.nodes.push(shorthand);
          }
          .None -> {
            self.state.err("expected expression node");
            ret .Some(ParseErrorKind.InvalidExpression);
          }
        }
        ret self.parse_additional_expression();
      }
      if is_unary_operator(op) {
        ret self.parse_for_unary();
      }
      let msg = format("expected left operand for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node node_left = maybe_left.unwrap();

    self.state.token_next();
    self.state.node_pop();

    if is_left_operanded_unary_operator(op) {
      Node* left_ptr = malloc(sizeof(Node));
      *left_ptr = node_left;
      self.parse_for_left_operanded_unary(left_ptr, op, op_pos);
      ret .None;
    }

    let tok2 = self.state.token_peek_next();
    if tok2.is_none() {
      let msg = format("expected expressionable for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    let t2 = tok2.unwrap();
    if t2.type == TokenType.Operator {
      bin is_lparen = false;
      fit t2.data {
        .Sval(s2) -> { is_lparen = equals(s2, "("); }
        _ -> {}
      }
      if is_lparen {
        let perr = self.parse_for_parenthesis();
        if perr.is_some() {
          ret perr;
        }
      } else {
        let msg = format("expected expressionable for '{str}' operator", op);
        defer free(msg);
        self.state.err(msg);
        ret .Some(ParseErrorKind.InvalidOperand);
      }
    } else {
      let err = self.parse_expressionable();
      if err.is_some() {
        ret err;
      }
    }

    let maybe_right = self.state.node_pop();
    if maybe_right.is_none() {
      let msg = format("expected expressionable for '{str}' operator", op);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidOperand);
    }
    Node node_right = maybe_right.unwrap();

    self.make_expression_node(&node_left, &node_right, op, op_pos);
    fit self.state.node_pop() {
      .Some(built) -> {
        Node exp_node = built;
        self.parse_reorder_expression(&exp_node);
        self.state.nodes.push(exp_node);
      }
      .None -> {
        self.state.err("expected expression node");
        ret .Some(ParseErrorKind.InvalidExpression);
      }
    }
    ret .None;
  }

  // Builds a new scope entity for `node`, deriving its lookup name from the
  // node's kind (identifiers/functions/variables are nameable; anything
  // else gets an empty name and is never found by `get_scope_entity`).
  pub new_scope_entity(Node* node) ScopeEntity* {
    ScopeEntity* entity = malloc(sizeof(ScopeEntity));
    *entity = scope_entity_new(_scope_entity_name(node));
    entity.node = node;
    entity.has_node = true;
    ret entity;
  }

  // The last-declared entity in the current scope chain, stopping at (not
  // including) the root/global scope.
  pub scope_last_entity_stop_global_scope() ScopeEntity* {
    ret self.state.last_scope_entity_stop_at(self.state.scope_root);
  }

  // Pushes a placeholder `Body` node (its `.statements` filled in once
  // parsing finishes) via `create_node`, so it picks up `binded` context
  // from whatever body/function currently encloses it.
  pub make_body_node() {
    Node body_node = node_new(NodeKind.Blank);
    self.create_node(&body_node);
  }

  // Parses a `{ ... }` block's statements into a `Body` node: creates the
  // body node, tracks it as `current_body` (so nested node construction
  // stamps `binded.owner` correctly) while parsing each statement in a
  // loop until the closing `}`, then restores the previous `current_body`.
  // 
  // Deliberately simplified from the original for this slice: no
  // `if`/`elif`/`else` chaining validation (nothing produces those node
  // kinds yet) and no "function declared as a statement" rejection
  // (`parse_statement` doesn't dispatch to `parse_function` yet either).
  // On a parse error mid-body, `current_body` is left as whatever it was
  // at the point of failure rather than unwound -- acceptable since a
  // parse error aborts the whole parse anyway.
  pub parse_body_multiple_statements() Option<ParseErrorKind> {
    Vec<Node*> stmts;
    stmts.init(0);

    self.make_body_node();
    let popped = self.state.node_pop();
    if popped.is_none() {
      self.state.err("expected body node");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* bnode_ptr = malloc(sizeof(Node));
    *bnode_ptr = popped.unwrap();

    let prev_body = self.current_body;
    let prev_has_body = self.has_current_body;
    self.current_body = bnode_ptr;
    self.has_current_body = true;

    let lbrace_err = self.state.expect_sym('{');
    if lbrace_err.is_some() {
      ret lbrace_err;
    }

    for true {
      let peeked = self.state.token_peek_next();
      if peeked.is_none() {
        self.state.err("unexpected end of file (expected '}' to close body)");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      if token_is_symbol(peeked.unwrap(), '}') {
        break;
      }
      let serr = self.parse_statement();
      if serr.is_some() {
        ret serr;
      }
      let maybe_stmt = self.state.node_pop();
      if maybe_stmt.is_none() {
        self.state.err("expected statement");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      Node* stmt = malloc(sizeof(Node));
      *stmt = maybe_stmt.unwrap();
      stmts.push(stmt);
    }

    let rbrace_err = self.state.expect_sym('}');
    if rbrace_err.is_some() {
      ret rbrace_err;
    }

    self.current_body = prev_body;
    self.has_current_body = prev_has_body;

    BodyNode bn;
    bn.statements = stmts;
    bnode_ptr.kind = NodeKind.Body(bn);
    self.state.nodes.push(*bnode_ptr);
    ret .None;
  }

  // Parses a `{ ... }` block, wrapping it in its own child scope so
  // declarations inside it don't leak into the enclosing one.
  pub parse_body() Option<ParseErrorKind> {
    self.state.new_scope();
    let err = self.parse_body_multiple_statements();
    self.state.finish_scope();
    ret err;
  }

  // Parses a run of `[expr]`/`[]` array-bracket suffixes onto `dt`, right
  // after its base type name (`num[5]`, `str[]`, `num[N][N]` for multi-
  // dimensional): sets `dt.is_array`/`dt.array_depth`, and records each
  // bracket's inner size expression (absent for a bare `[]`) as a
  // `Bracket` node in `dt.array_brackets`. Typecheck/codegen compute the
  // concrete size later; parsing only records what was written.
  pub parse_array_brackets(DataType* dt) Option<ParseErrorKind> {
    Vec<Node*> brackets;
    brackets.init(0);
    num depth = 0;

    for self.state.next_token_is_operator("[") {
      let lbracket_tok = self.state.token_peek_next();
      let lberr = self.state.expect_op("[");
      if lberr.is_some() {
        ret lberr;
      }
      dt.is_array = true;
      dt.flags.is_array = true;
      depth = depth + 1;

      if self.state.next_token_is_symbol(']') {
        self.state.token_next();
        continue;
      }

      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let rberr = self.state.expect_sym(']');
      if rberr.is_some() {
        ret rberr;
      }
      let maybe_exp = self.state.node_pop();
      if maybe_exp.is_none() {
        self.state.err("expected array size expression");
        ret .Some(ParseErrorKind.InvalidExpression);
      }
      Node* exp = malloc(sizeof(Node));
      *exp = maybe_exp.unwrap();

      Node bracket_node = node_new(NodeKind.Bracket(exp));
      fit lbracket_tok {
        .Some(t) -> {
          bracket_node.pos = t.pos;
          bracket_node.has_pos = true;
        }
        .None -> {}
      }
      Node* bracket_ptr = malloc(sizeof(Node));
      *bracket_ptr = bracket_node;
      brackets.push(bracket_ptr);
    }

    dt.array_depth = depth;
    if brackets.len > 0 {
      dt.array_brackets = brackets;
    }
    ret .None;
  }

  // Parses a variable declaration's NAME and optional `= initializer`
  // (the type `dt` is already parsed by the caller): registers a scope
  // entity so later references resolve, and rejects re-declaring a name
  // already visible in the current scope chain -- unconditionally, unlike
  // the original, which only checked this in the has-initializer branch;
  // an uninitialized redeclaration is just as much a bug and this port
  // doesn't see a reason to let it through.
  // 
  // Handles the `T[] name;` array-bracket form (the brackets appear
  // right after the base type, BEFORE the name) via `parse_array_brackets`.
  pub parse_variable(DataType* dt, bin is_public, bin require_initializer) Option<ParseErrorKind> {
    if self.state.next_token_is_operator("[") {
      let aberr = self.parse_array_brackets(dt);
      if aberr.is_some() {
        ret aberr;
      }
    }
    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected identifier");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    let ident_tok = tok.unwrap();
    if ident_tok.type != TokenType.Identifier {
      self.state.err("expected identifier");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str name = "";
    fit ident_tok.data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    if self.state.get_scope_entity(name) != nil {
      let msg = format("variable '{str}' already declared", name);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    bin has_value = self.state.next_token_is_operator("=");
    if !has_value && require_initializer {
      self.state.err("'let' declarations require an initializer");
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    VariableNode v;
    v.var_type = dt;
    v.name = name;
    v.has_val = false;

    if has_value {
      self.state.token_next();
      let verr = self.parse_expressionable_root();
      if verr.is_some() {
        ret verr;
      }
      let maybe_val = self.state.node_pop();
      if maybe_val.is_none() {
        self.state.err("expected initializer expression");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      Node* val = malloc(sizeof(Node));
      *val = maybe_val.unwrap();
      v.val = val;
      v.has_val = true;
    }

    Node node = node_new(NodeKind.Variable(v));
    node.pos = ident_tok.pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Node* node_ptr = malloc(sizeof(Node));
    *node_ptr = node;
    ScopeEntity* entity = self.new_scope_entity(node_ptr);

    self.create_node(node_ptr);
    self.state.push_scope_entity(entity);
    ret .None;
  }

  // Parses `let NAME = value;`: the declared type is the `__let_infer__`
  // sentinel (real type inference happens at typecheck time, not ported
  // yet), and an initializer is mandatory.
  pub parse_let_declaration(bin is_public) Option<ParseErrorKind> {
    let kw_err = self.state.expect_keyword("let");
    if kw_err.is_some() {
      ret kw_err;
    }

    DataType* dt = malloc(sizeof(DataType));
    *dt = dtype_new();
    dt.type_str = "__let_infer__";

    let verr = self.parse_variable(dt, is_public, true);
    if verr.is_some() {
      ret verr;
    }
    ret self.state.expect_sym(';');
  }

  // Parses `ret;` (bare) or `ret <expr>;`.
  pub parse_return() Option<ParseErrorKind> {
    let ret_tok = self.state.token_peek_next();
    self.state.token_next();

    if self.state.next_token_is_symbol(';') {
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
      Node node = node_new(NodeKind.StatementReturn(nil));
      fit ret_tok {
        .Some(t) -> {
          node.pos = t.pos;
          node.has_pos = true;
        }
        .None -> {}
      }
      self.create_node(&node);
      ret .None;
    }

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    let maybe_exp = self.state.node_pop();
    if maybe_exp.is_none() {
      self.state.err("expected return value");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node* exp = malloc(sizeof(Node));
    *exp = maybe_exp.unwrap();

    Node node = node_new(NodeKind.StatementReturn(exp));
    fit ret_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses `assert <condition>;` or `assert <condition>, <message>;`. The
  // condition expression parse may already consume the whole `cond,
  // message` as a single `,`-Expression (this port's `,` is an ordinary
  // binary operator in the precedence table, unlike the original's
  // separate comma-expression dispatch) -- split that apart when it
  // happens; otherwise look for an explicit trailing `, message`.
  pub parse_assert() Option<ParseErrorKind> {
    let assert_tok = self.state.token_peek_next();
    self.state.token_next();

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    let maybe_exp = self.state.node_pop();
    if maybe_exp.is_none() {
      self.state.err("expected assert condition");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node exp_val = maybe_exp.unwrap();

    bin is_comma_expr = false;
    fit exp_val.kind {
      .Expression(e) -> {
        if equals(e.op, ",") {
          is_comma_expr = true;
        }
      }
      _ -> {}
    }

    Node* cond_ptr = nil;
    Node* msg_ptr = nil;
    bin has_msg = false;

    if is_comma_expr {
      fit exp_val.kind {
        .Expression(e) -> {
          cond_ptr = e.left;
          msg_ptr = e.right;
          has_msg = true;
        }
        _ -> {}
      }
    } else {
      cond_ptr = malloc(sizeof(Node));
      *cond_ptr = exp_val;

      if self.state.next_token_is_operator(",") {
        self.state.token_next();
        let merr = self.parse_expressionable_root();
        if merr.is_some() {
          ret merr;
        }
        let maybe_msg = self.state.node_pop();
        if maybe_msg.is_none() {
          self.state.err("expected assert message");
          ret .Some(ParseErrorKind.InvalidExpression);
        }
        msg_ptr = malloc(sizeof(Node));
        *msg_ptr = maybe_msg.unwrap();
        has_msg = true;
      }
    }

    AssertNode an;
    an.condition = cond_ptr;
    an.message = msg_ptr;
    an.has_message = has_msg;

    Node node = node_new(NodeKind.StatementAssert(an));
    fit assert_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses an `if`/`elif` CONDITION and leaves it on top of the node
  // stack: a leading `(...)` is stripped explicitly (rather than left to
  // the general expression parser -- `parse_for_parenthesis` unconditionally
  // tells its caller "there may be more to parse", which is wrong for a
  // bare parenthesized condition immediately followed by an unrelated
  // single-statement body), then any further binary-operator continuation
  // is picked up via the general expression loop.
  // 
  // This exact logic has a documented history: an earlier version of it
  // (in the Zig source this is ported from) dropped the re-wrap step
  // below, silently miscompiling `(a || b) && c` as `a || b && c` --
  // codegen never auto-parenthesizes sub-expressions, and C parses the
  // un-grouped form as `a || (b && c)`, a different result. Ported here
  // with extra care given that history: when the condition DID start with
  // an explicit `(` and a binary operator follows, the parsed condition is
  // re-wrapped in an `ExpressionParenthesis` before continuing, so the
  // grouping survives into codegen.
  _parse_if_or_elif_condition() Option<ParseErrorKind> {
    bin had_leading_paren = false;
    Node cond = node_new(NodeKind.Blank);

    if self.state.next_token_is_operator("(") {
      had_leading_paren = true;
      let operr = self.state.expect_op("(");
      if operr.is_some() {
        ret operr;
      }
      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let maybe_cond = self.state.node_pop();
      if maybe_cond.is_none() {
        self.state.err("expected condition");
        ret .Some(ParseErrorKind.InvalidExpression);
      }
      cond = maybe_cond.unwrap();
      let cerr = self.state.expect_sym(')');
      if cerr.is_some() {
        ret cerr;
      }
    } else {
      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let maybe_cond = self.state.node_pop();
      if maybe_cond.is_none() {
        self.state.err("expected condition");
        ret .Some(ParseErrorKind.InvalidExpression);
      }
      cond = maybe_cond.unwrap();
    }

    fit self.state.token_peek_next() {
      .Some(nt) -> {
        if is_binary_only_operator(nt) {
          if had_leading_paren {
            Node* inner = malloc(sizeof(Node));
            *inner = cond;
            Node wrapped = node_new(NodeKind.ExpressionParenthesis(inner));
            wrapped.pos = inner.pos;
            wrapped.has_pos = inner.has_pos;
            cond = wrapped;
          }
          self.state.nodes.push(cond);
          let cerr2 = self.parse_expressionable();
          if cerr2.is_some() {
            ret cerr2;
          }
          let maybe_cond2 = self.state.node_pop();
          if maybe_cond2.is_none() {
            self.state.err("expected condition");
            ret .Some(ParseErrorKind.InvalidExpression);
          }
          cond = maybe_cond2.unwrap();
        }
      }
      .None -> {}
    }

    bin is_assignment = false;
    fit cond.kind {
      .Expression(e) -> {
        if equals(e.op, "=") {
          is_assignment = true;
        }
      }
      _ -> {}
    }
    if is_assignment {
      self.state.err("expected expression, got assignment");
      ret .Some(ParseErrorKind.InvalidExpression);
    }

    self.state.nodes.push(cond);
    ret .None;
  }

  // Parses an if/elif/else BODY -- a `{ ... }` block, or a single
  // statement -- leaving the resulting node on top of the node stack.
  _parse_if_body() Option<ParseErrorKind> {
    if self.state.next_token_is_symbol('{') {
      ret self.parse_body();
    }
    ret self.parse_statement();
  }

  // Parses `if <condition> <body>`.
  pub parse_if_statement() Option<ParseErrorKind> {
    let if_tok = self.state.token_peek_next();
    let kwerr = self.state.expect_keyword("if");
    if kwerr.is_some() {
      ret kwerr;
    }
    if !self.has_current_function {
      self.state.err("if statement outside of function");
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    let cerr = self._parse_if_or_elif_condition();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected if condition");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node* condition = malloc(sizeof(Node));
    *condition = maybe_cond.unwrap();

    let berr = self._parse_if_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected if body");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    IfStmtNode ifn;
    ifn.condition = condition;
    ifn.body = body;

    Node node = node_new(NodeKind.StatementIf(ifn));
    fit if_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `elif <condition> <body>`. A no-op (not an error) if the next
  // token isn't `elif` -- callers probe with this the same way the
  // original does.
  // 
  // Deliberately simplified from the original for this slice: no
  // if/elif/else CHAINING validation (`parse_body_multiple_statements`
  // doesn't check that an elif/else actually follows an if/elif in this
  // port), so a stray `elif` with no preceding `if` is accepted rather
  // than rejected. Revisit once that validation is ported.
  pub parse_elif_statement() Option<ParseErrorKind> {
    if !self.state.next_token_is_keyword("elif") {
      ret .None;
    }
    let elif_tok = self.state.token_peek_next();
    if !self.has_current_function {
      self.state.err("elif statement outside of function");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    self.state.token_next();

    let cerr = self._parse_if_or_elif_condition();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected elif condition");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node* condition = malloc(sizeof(Node));
    *condition = maybe_cond.unwrap();

    let berr = self._parse_if_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected elif body");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    IfStmtNode ifn;
    ifn.condition = condition;
    ifn.body = body;

    Node node = node_new(NodeKind.StatementElseIf(ifn));
    fit elif_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `else <body>`. A no-op (not an error) if the next token isn't
  // `else`, matching `parse_elif_statement`. Same chaining-validation
  // simplification as above.
  pub parse_else_statement() Option<ParseErrorKind> {
    if !self.state.next_token_is_keyword("else") {
      ret .None;
    }
    let else_tok = self.state.token_peek_next();
    if !self.has_current_function {
      self.state.err("else statement outside of function");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    self.state.token_next();

    let berr = self._parse_if_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected else body");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    Node node = node_new(NodeKind.StatementElse(body));
    fit else_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses a function argument (`<type> <name>`, optionally `= default`):
  // the type, then delegates to `parse_variable` for the name/default.
  _parse_full_variable() Option<ParseErrorKind> {
    DataType* dt = malloc(sizeof(DataType));
    *dt = dtype_new();
    let derr = self.state.parse_datatype(dt);
    if derr.is_some() {
      ret derr;
    }
    ret self.parse_variable(dt, false, false);
  }

  // Parses a comma-separated argument list up to (not including) the
  // closing `)`, appending each argument node to `out_args`. A trailing
  // `...` (either as the whole list, `f(...)`, or after named args,
  // `f(str fmt, ...)`) sets `*out_is_variadic` and stops -- it's never
  // itself an argument node.
  _parse_function_args(Vec<Node*>* out_args, bin* out_is_variadic) Option<ParseErrorKind> {
    for !self.state.next_token_is_symbol(')') {
      if self.state.next_token_is_operator("...") {
        self.state.token_next();
        *out_is_variadic = true;
        break;
      }
      let verr = self._parse_full_variable();
      if verr.is_some() {
        ret verr;
      }
      let maybe_arg = self.state.node_pop();
      if maybe_arg.is_none() {
        self.state.err("expected argument");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      Node* arg = malloc(sizeof(Node));
      *arg = maybe_arg.unwrap();
      out_args.push(arg);

      if !self.state.next_token_is_operator(",") {
        break;
      }
      self.state.token_next();
    }
    ret .None;
  }

  // Parses a function declaration: `fun NAME(args) [rtype] { body }` or,
  // with no body, `fun NAME(args) [rtype];` (a bare signature -- how every
  // `std.c.*` binding is written). Registers its own child scope for the
  // argument list and body, and tracks itself as `current_function` while
  // parsing so nested node construction stamps `binded.function` correctly.
  // 
  // NOT wired into `parse_statement`'s dispatch: a function declaration is
  // only ever valid at the TOP LEVEL (the original enforces this via a
  // check in `parse_body_multiple_statements` rejecting a `.Function`
  // statement result, not ported in this slice's simplified body parser --
  // see its doc comment). `parse_function` is meant to be called from a
  // top-level parse loop, which doesn't exist yet either; callable and
  // tested standalone until that loop is ported.
  // 
  // Deliberately simplified from the original for this slice: no array-
  // bracket return type (`T[]`) -- needs `parse_array_brackets`, deferred
  // along with every other array-bracket use (see `parse_datatype`'s doc
  // comment).
  pub parse_function(bin is_public, bin is_async) Option<ParseErrorKind> {
    self.state.new_scope();

    self.state.token_next(); // skip 'fun'

    let tok = self.state.token_next();
    if tok.is_none() {
      self.state.err("expected identifier after 'fun'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    let ident_tok = tok.unwrap();
    if ident_tok.type != TokenType.Identifier {
      self.state.err("expected identifier after 'fun'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str fname = "";
    fit ident_tok.data {
      .Sval(s) -> { fname = s; }
      _ -> {}
    }

    FunctionNode fnv = function_node_new();
    fnv.name = fname;
    fnv.has_name = true;
    fnv.is_async = is_async;

    Node fn_node = node_new(NodeKind.Function(fnv));
    fn_node.pos = ident_tok.pos;
    fn_node.has_pos = true;
    fn_node.flags.is_public = is_public;

    Node* fn_node_ptr = malloc(sizeof(Node));
    *fn_node_ptr = fn_node;
    self.current_function = fn_node_ptr;
    self.has_current_function = true;

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> type_param_forced_insts;
    type_param_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(
      &type_params,
      &type_param_forced_insts
    );
    if tperr.is_some() {
      ret tperr;
    }
    fit fn_node_ptr.kind {
      .Function(curtp) -> {
        curtp.type_params = type_params;
        curtp.has_type_params = type_params.len > 0;
        curtp.type_param_forced_insts = type_param_forced_insts;
        curtp.has_type_param_forced_insts = type_param_forced_insts.len > 0;
        fn_node_ptr.kind = NodeKind.Function(curtp);
      }
      _ -> {}
    }

    let operr = self.state.expect_op("(");
    if operr.is_some() {
      ret operr;
    }
    Vec<Node*> args;
    args.init(0);
    bin is_variadic = false;
    let aerr = self._parse_function_args(&args, &is_variadic);
    if aerr.is_some() {
      ret aerr;
    }
    let cperr = self.state.expect_sym(')');
    if cperr.is_some() {
      ret cperr;
    }

    fit fn_node_ptr.kind {
      .Function(cur) -> {
        cur.args = args;
        cur.has_args = true;
        cur.is_variadic = is_variadic;
        fn_node_ptr.kind = NodeKind.Function(cur);
      }
      _ -> {}
    }

    // A variadic function's `...` args are collected into a synthetic
    // `vargs: Vec` binding, registered in scope (but NOT emitted as a
    // declaration node -- it's synthesized by codegen, matching the
    // for-loop range/iterator variables' same on-stack-entity treatment)
    // so the body can reference `vargs` by name.
    if is_variadic {
      DataType* vdt = malloc(sizeof(DataType));
      *vdt = dtype_new();
      vdt.kind = DataTypeType.Unknown;
      vdt.type_str = "Vec";

      VariableNode vv;
      vv.var_type = vdt;
      vv.name = "vargs";
      vv.has_val = false;

      Node vnode = node_new(NodeKind.Variable(vv));
      vnode.pos = fn_node_ptr.pos;
      vnode.has_pos = fn_node_ptr.has_pos;

      Node* vnode_ptr = malloc(sizeof(Node));
      *vnode_ptr = vnode;
      ScopeEntity* ventity = self.new_scope_entity(vnode_ptr);
      self.state.push_scope_entity(ventity);
    }

    DataType* rtype = malloc(sizeof(DataType));
    bin has_explicit_rtype = false;
    fit self.state.token_peek_next() {
      .Some(rt) -> {
        bin looks_like_type = false;
        if rt.type == TokenType.Identifier {
          looks_like_type = true;
        }
        if rt.type == TokenType.Keyword {
          fit rt.data {
            .Sval(s) -> { looks_like_type = keyword_is_datatype(s); }
            _ -> {}
          }
        }
        if looks_like_type {
          *rtype = dtype_new();
          let rerr = self.state.parse_datatype(rtype);
          if rerr.is_some() {
            ret rerr;
          }
          if self.state.next_token_is_operator("[") {
            let raberr = self.parse_array_brackets(rtype);
            if raberr.is_some() {
              ret raberr;
            }
          }
          has_explicit_rtype = true;
        }
      }
      .None -> {}
    }
    if !has_explicit_rtype {
      *rtype = dtype_new();
      rtype.kind = DataTypeType.Void;
      rtype.type_str = "void";
    }

    fit fn_node_ptr.kind {
      .Function(cur2) -> {
        cur2.rtype = rtype;
        cur2.has_rtype = true;
        fn_node_ptr.kind = NodeKind.Function(cur2);
      }
      _ -> {}
    }

    if self.state.next_token_is_symbol('{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected function body");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      Node* body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();
      fit fn_node_ptr.kind {
        .Function(cur3) -> {
          cur3.body = body;
          cur3.has_body = true;
          fn_node_ptr.kind = NodeKind.Function(cur3);
        }
        _ -> {}
      }
    } else {
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    self.has_current_function = false;
    self.state.nodes.push(*fn_node_ptr);
    self.state.finish_scope();
    ret .None;
  }

  // Parses the legacy loop-variable forms, once `parse_for_statement` has
  // determined (via lookahead) that's what follows `for`: `for i :
  // start..end { ... }` (range -- `ForKind.Range`) or `for item : arr {
  // ... }` / `for i, item :: arr { ... }` (iterator -- `ForKind.Iter`,
  // `i,`/index tracking is optional). The loop variable(s) are registered
  // as on-stack scope entities (no backing declaration `Node`, matching
  // the original -- they're synthesized by codegen, not declared by the
  // user) in a new scope opened before the body so it can reference them,
  // closed after.
  // 
  // On the one hard error here (range form used with the `i, item ::`
  // syntax, which only iterator loops support), the scope opened just
  // above is deliberately left unfinished -- matching this file's
  // established convention for parse errors (see
  // `parse_body_multiple_statements`'s doc comment): a parse error aborts
  // the whole parse anyway, so there's nothing to unwind for.
  _parse_for_range_or_iter(Option<Token> for_tok) Option<ParseErrorKind> {
    let first = self.state.token_next();
    if first.is_none() || first.unwrap().type != TokenType.Identifier {
      self.state.err("expected identifier after 'for'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str index_name = "";
    bin has_index_name = false;
    str item_name = "";
    fit first.unwrap().data {
      .Sval(s) -> { item_name = s; }
      _ -> {}
    }
    bin used_double_colon = false;

    if self.state.next_token_is_operator(",") {
      index_name = item_name;
      has_index_name = true;
      self.state.token_next(); // skip ','
      let second = self.state.token_next();
      if second.is_none() || second.unwrap().type != TokenType.Identifier {
        self.state.err("expected identifier after ',' in for loop");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      fit second.unwrap().data {
        .Sval(s) -> { item_name = s; }
        _ -> {}
      }
      let dcerr = self.state.expect_op("::");
      if dcerr.is_some() {
        ret dcerr;
      }
      used_double_colon = true;
    } else {
      let cerr = self.state.expect_op(":");
      if cerr.is_some() {
        ret cerr;
      }
    }

    let ierr = self.parse_expressionable_root();
    if ierr.is_some() {
      ret ierr;
    }
    let maybe_iterable = self.state.node_pop();
    if maybe_iterable.is_none() {
      self.state.err("expected for iterable/range expression");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node iterable_node = maybe_iterable.unwrap();

    bin is_range = false;
    fit iterable_node.kind {
      .Expression(e) -> {
        if equals(e.op, "..") {
          is_range = true;
        }
      }
      _ -> {}
    }

    self.state.new_scope();

    if is_range {
      if used_double_colon {
        self.state.err("range for loop does not support 'i, item ::' form");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      ScopeEntity item_entity = scope_entity_new(item_name);
      item_entity.on_stack = true;
      ScopeEntity* item_entity_ptr = malloc(sizeof(ScopeEntity));
      *item_entity_ptr = item_entity;
      self.state.push_scope_entity(item_entity_ptr);
    } else {
      if has_index_name {
        ScopeEntity index_entity = scope_entity_new(index_name);
        index_entity.on_stack = true;
        ScopeEntity* index_entity_ptr = malloc(sizeof(ScopeEntity));
        *index_entity_ptr = index_entity;
        self.state.push_scope_entity(index_entity_ptr);
      }
      ScopeEntity item_entity = scope_entity_new(item_name);
      item_entity.on_stack = true;
      ScopeEntity* item_entity_ptr = malloc(sizeof(ScopeEntity));
      *item_entity_ptr = item_entity;
      self.state.push_scope_entity(item_entity_ptr);
    }

    let berr = self.parse_body_multiple_statements();
    self.state.finish_scope();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected for body");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    Node node = node_new(NodeKind.Blank);
    if is_range {
      Node* range_ptr = malloc(sizeof(Node));
      *range_ptr = iterable_node;
      ForRangeNode fr;
      fr.index_name = item_name;
      fr.range_expr = range_ptr;
      fr.body = body;
      node.kind = NodeKind.StatementFor(ForKind.Range(fr));
    } else {
      Node* iterable_ptr = malloc(sizeof(Node));
      *iterable_ptr = iterable_node;
      ForIterNode fi;
      fi.index_name = index_name;
      fi.has_index_name = has_index_name;
      fi.item_name = item_name;
      fi.iterable = iterable_ptr;
      fi.body = body;
      node.kind = NodeKind.StatementFor(ForKind.Iter(fi));
    }
    fit for_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses a `for` loop: `for { ... }` (infinite), `for <condition> {
  // ... }`, `for i : start..end { ... }` (range), or `for item : arr {
  // ... }` / `for i, item :: arr { ... }` (iterator).
  // 
  // The legacy range/iterator forms are distinguished from a condition
  // loop that happens to start with an identifier (`for x != 0 { ... }`)
  // by a 1-token lookahead: only `for IDENT :` or `for IDENT ,` are the
  // legacy forms (a bare condition never starts with `,`, and `:` isn't a
  // valid expression-continuation operator either), matching the
  // original's identical disambiguation.
  pub parse_for_statement() Option<ParseErrorKind> {
    let for_tok = self.state.token_peek_next();
    let kwerr = self.state.expect_keyword("for");
    if kwerr.is_some() {
      ret kwerr;
    }
    if !self.has_current_function {
      self.state.err("for statement outside of function");
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    if self.state.next_token_is_symbol('{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected for body");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      Node* body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();

      ForCondNode fc;
      fc.condition = nil;
      fc.has_condition = false;
      fc.body = body;

      Node node = node_new(NodeKind.StatementFor(ForKind.Cond(fc)));
      fit for_tok {
        .Some(t) -> {
          node.pos = t.pos;
          node.has_pos = true;
        }
        .None -> {}
      }
      self.create_node(&node);
      ret .None;
    }

    bin is_legacy = false;
    fit self.state.token_peek_next() {
      .Some(nt) -> {
        if nt.type == TokenType.Identifier {
          fit self.state.token_peek_n(1) {
            .Some(after) -> {
              is_legacy = token_is_operator(after, ",") || token_is_operator(after, ":");
            }
            .None -> {}
          }
        }
      }
      .None -> {}
    }
    if is_legacy {
      ret self._parse_for_range_or_iter(for_tok);
    }

    let cerr = self.parse_expressionable_root();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected for condition");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node* cond_ptr = malloc(sizeof(Node));
    *cond_ptr = maybe_cond.unwrap();

    let berr = self.parse_body();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected for body");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    ForCondNode fc;
    fc.condition = cond_ptr;
    fc.has_condition = true;
    fc.body = body;

    Node node = node_new(NodeKind.StatementFor(ForKind.Cond(fc)));
    fit for_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Tries to parse a data-carrying-enum DESTRUCTURING fit pattern at the
  // cursor: `Enum.Variant(a, b)` or shorthand `.Variant(a, b)`. On a
  // match, consumes those tokens, sets `*out_condition` to the variant-
  // path `.` expression (`Enum.Variant`, or `<blank>.Variant` for
  // shorthand), fills `*out_bindings` with the positional binding
  // identifiers, and sets `*out_matched` true. On no match, consumes
  // NOTHING and leaves `*out_matched` false -- the caller parses
  // normally. Detection requires the trailing `(` so a plain
  // `Enum.Variant`/`.Variant` arm (no payload binding) still goes
  // through the ordinary (non-destructuring) path.
  _try_parse_fit_destructure(bin* out_matched, Node* out_condition, Vec<str>* out_bindings) Option<ParseErrorKind> {
    *out_matched = false;
    let p0_opt = self.state.token_peek_n(0);
    let p1_opt = self.state.token_peek_n(1);
    if p0_opt.is_none() || p1_opt.is_none() {
      ret .None;
    }
    let p0 = p0_opt.unwrap();
    let p1 = p1_opt.unwrap();

    bin is_shorthand = token_is_operator(p0, ".") && p1.type == TokenType.Identifier;
    bin is_qualified = false;
    if !is_shorthand {
      is_qualified = p0.type == TokenType.Identifier && token_is_operator(p1, ".");
    }
    if !is_shorthand && !is_qualified {
      ret .None;
    }

    Token variant_tok;
    bin found_lparen = false;
    if is_shorthand {
      let p2_opt = self.state.token_peek_n(2);
      if p2_opt.is_some() && token_is_operator(p2_opt.unwrap(), "(") {
        variant_tok = p1;
        found_lparen = true;
      }
    } else {
      let p2_opt = self.state.token_peek_n(2);
      if p2_opt.is_some() && p2_opt.unwrap().type == TokenType.Identifier {
        let p3_opt = self.state.token_peek_n(3);
        if p3_opt.is_some() && token_is_operator(p3_opt.unwrap(), "(") {
          variant_tok = p2_opt.unwrap();
          found_lparen = true;
        }
      }
    }
    if !found_lparen {
      ret .None;
    }

    // Commit: consume the path tokens.
    Node left = node_new(NodeKind.Blank);
    if is_shorthand {
      self.state.token_next(); // '.'
      self.state.token_next(); // Variant
      left.pos = variant_tok.pos;
      left.has_pos = true;
    } else {
      str enum_name = "";
      fit p0.data {
        .Sval(s) -> { enum_name = s; }
        _ -> {}
      }
      left = node_new(NodeKind.Identifier(enum_name));
      left.pos = p0.pos;
      left.has_pos = true;
      self.state.token_next(); // Enum
      self.state.token_next(); // '.'
      self.state.token_next(); // Variant
    }
    left.flags.inside_expression = true;

    str variant_name = "";
    fit variant_tok.data {
      .Sval(s) -> { variant_name = s; }
      _ -> {}
    }
    Node right = node_new(NodeKind.Identifier(variant_name));
    right.pos = variant_tok.pos;
    right.has_pos = true;
    right.flags.inside_expression = true;

    let lperr = self.state.expect_op("(");
    if lperr.is_some() {
      ret lperr;
    }

    Vec<str> binds;
    binds.init(0);
    for !self.state.next_token_is_symbol(')') {
      let bt = self.state.token_next();
      if bt.is_none() || bt.unwrap().type != TokenType.Identifier {
        self.state.err("expected binding name in fit destructuring pattern");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      str bname = "";
      fit bt.unwrap().data {
        .Sval(s) -> { bname = s; }
        _ -> {}
      }
      binds.push(bname);
      if !self.state.next_token_is_operator(",") {
        break;
      }
      self.state.token_next();
    }
    let rperr = self.state.expect_sym(')');
    if rperr.is_some() {
      ret rperr;
    }
    if binds.len == 0 {
      self.state.err("fit destructuring pattern '()' must bind at least one field");
      ret .Some(ParseErrorKind.InvalidToken);
    }

    self.make_expression_node(&left, &right, ".", variant_tok.pos);
    fit self.state.node_pop() {
      .Some(built) -> { *out_condition = built; }
      .None -> {
        self.state.err("failed to build fit destructuring variant path");
        ret .Some(ParseErrorKind.InvalidExpression);
      }
    }
    *out_bindings = binds;
    *out_matched = true;
    ret .None;
  }

  // Parses one `pattern -> { body }` fit arm, pushing the finished branch
  // onto `out_branches`. `_` (the wildcard default) has no condition and
  // must be the last arm -- signaled back to the caller via
  // `out_has_default` so its loop stops.
  // 
  // Three pattern shapes, tried in order: (1) a data-carrying-enum
  // DESTRUCTURING pattern (`Shape.Circle(r)` / `.Circle(r)`) via
  // `_try_parse_fit_destructure` -- its positional binding names are
  // registered in a scope opened just for the arm body (closed after),
  // so the body can reference them; (2) a bare `.Variant` shorthand
  // (no payload) via the same direct-construction bypass
  // `parse_normal_expression`'s own `.` handling uses, needed because a
  // bare `.Variant` isn't itself a complete expression the general
  // parser recognizes outside of this direct construction; (3) an
  // ordinary expression pattern (literals, identifiers, ...) via
  // `parse_expressionable_root`.
  _parse_fit_arm(Vec<FitBranch>* out_branches, bin* out_has_default) Option<ParseErrorKind> {
    Node arm_condition = node_new(NodeKind.Blank);
    Vec<str> bindings;
    bindings.init(0);

    bin destructure_matched = false;
    Node destructure_condition = node_new(NodeKind.Blank);
    Vec<str> destructure_bindings;
    destructure_bindings.init(0);
    let dxerr = self._try_parse_fit_destructure(
      &destructure_matched,
      &destructure_condition,
      &destructure_bindings
    );
    if dxerr.is_some() {
      ret dxerr;
    }

    if destructure_matched {
      arm_condition = destructure_condition;
      bindings = destructure_bindings;
    } else {
      bin is_dot_shorthand = false;
      Pos op_pos;
      fit self.state.token_peek_next() {
        .Some(t) -> {
          op_pos = t.pos;
          if t.type == TokenType.Operator {
            str op = "";
            fit t.data {
              .Sval(s) -> { op = s; }
              _ -> {}
            }
            is_dot_shorthand = equals(op, ".");
          }
        }
        .None -> {}
      }

      if is_dot_shorthand {
        self.state.token_next(); // consume '.'
        let ierr = self.parse_single_token_to_node();
        if ierr.is_some() {
          ret ierr;
        }
        let maybe_right = self.state.node_pop();
        if maybe_right.is_none() {
          self.state.err("expected identifier after '.' in fit pattern");
          ret .Some(ParseErrorKind.InvalidExpression);
        }
        Node node_right = maybe_right.unwrap();
        node_right.flags.inside_expression = true;

        Node blank_left = node_new(NodeKind.Blank);
        blank_left.pos = op_pos;
        blank_left.has_pos = true;
        blank_left.flags.inside_expression = true;

        self.make_expression_node(&blank_left, &node_right, ".", op_pos);
        fit self.state.node_pop() {
          .Some(built) -> {
            arm_condition = built;
            self.parse_reorder_expression(&arm_condition);
          }
          .None -> {
            self.state.err("expected fit branch condition expression");
            ret .Some(ParseErrorKind.InvalidExpression);
          }
        }
      } else {
        let cerr = self.parse_expressionable_root();
        if cerr.is_some() {
          ret cerr;
        }
        let maybe_cond = self.state.node_pop();
        if maybe_cond.is_none() {
          self.state.err("expected fit branch condition expression");
          ret .Some(ParseErrorKind.InvalidExpression);
        }
        arm_condition = maybe_cond.unwrap();
      }
    }

    bin is_assignment = false;
    fit arm_condition.kind {
      .Expression(e) -> {
        if equals(e.op, "=") {
          is_assignment = true;
        }
      }
      _ -> {}
    }
    if is_assignment {
      self.state.err("expected expression, got assignment");
      ret .Some(ParseErrorKind.InvalidExpression);
    }

    bin is_wildcard = false;
    fit arm_condition.kind {
      .Identifier(s) -> {
        if equals(s, "_") {
          is_wildcard = true;
        }
      }
      _ -> {}
    }

    FitBranch branch = fit_branch_new();
    if !is_wildcard {
      Node* cond_ptr = malloc(sizeof(Node));
      *cond_ptr = arm_condition;
      branch.condition = cond_ptr;
      branch.has_condition = true;
    }
    bin has_bindings = bindings.len > 0;
    if has_bindings {
      branch.bindings = bindings;
      branch.has_bindings = true;
    }

    let arerr = self.state.expect_op("->");
    if arerr.is_some() {
      ret arerr;
    }
    // Register destructuring binding names in a scope so the arm body can
    // reference them at parse time. Opened here and closed after the
    // body is parsed, so bindings don't leak to sibling arms or past the
    // fit. Each binding is a plain (Unknown-typed) scope entity, same as
    // a variadic function's synthetic `vargs` -- typecheck resolves the
    // real payload type later.
    if has_bindings {
      self.state.new_scope();
      for bname : bindings {
        DataType* bdt = malloc(sizeof(DataType));
        *bdt = dtype_new();

        VariableNode bv;
        bv.var_type = bdt;
        bv.name = bname;
        bv.has_val = false;

        Node bvar = node_new(NodeKind.Variable(bv));
        Node* bvar_ptr = malloc(sizeof(Node));
        *bvar_ptr = bvar;
        ScopeEntity* bentity = self.new_scope_entity(bvar_ptr);
        self.state.push_scope_entity(bentity);
      }
    }
    let berr = self.parse_body();
    if has_bindings {
      self.state.finish_scope();
    }
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected fit branch body");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();
    branch.body = body;

    out_branches.push(branch);
    if is_wildcard {
      *out_has_default = true;
    }

    if self.state.next_token_is_operator(",") {
      self.state.token_next();
    }
    ret .None;
  }

  // Parses a fit statement's body: `{ arm , arm , ... }`. Stops early
  // (without requiring `}` to immediately follow) once a wildcard `_`
  // default arm has been parsed -- matching the original, which treats
  // `_` as necessarily the last arm.
  pub parse_fit_body(Node* condition, Pos fit_pos, bin has_fit_pos) Option<ParseErrorKind> {
    let lbrace_err = self.state.expect_sym('{');
    if lbrace_err.is_some() {
      ret lbrace_err;
    }

    Vec<FitBranch> branches;
    branches.init(0);
    bin has_default_branch = false;

    for !self.state.next_token_is_symbol('}') {
      let aerr = self._parse_fit_arm(&branches, &has_default_branch);
      if aerr.is_some() {
        ret aerr;
      }
      if has_default_branch {
        break;
      }
    }

    let rbrace_err = self.state.expect_sym('}');
    if rbrace_err.is_some() {
      ret rbrace_err;
    }

    FitStmtNode fitn = fit_stmt_node_new();
    fitn.exp = condition;
    fitn.branches = branches;
    fitn.has_default_branch = has_default_branch;

    Node node = node_new(NodeKind.StatementFit(fitn));
    if has_fit_pos {
      node.pos = fit_pos;
      node.has_pos = true;
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `fit <condition> { arm , ... }`.
  // 
  // Note the ordering: `in_fit_statement` is set true BEFORE parsing the
  // subject expression too, not just the arms below -- the original
  // threads the same history flag through the whole statement, and a
  // subject like `fit x -> ...` (a stray `->` right after the subject,
  // a malformed-but-plausible typo) should stop there rather than
  // swallowing into the arm list. Left set on an early-error return,
  // matching this file's established convention (see
  // `parse_body_multiple_statements`'s doc comment): a parse error
  // aborts the whole parse anyway, so there's nothing to unwind for.
  pub parse_fit_statement() Option<ParseErrorKind> {
    let fit_tok = self.state.token_peek_next();
    let kwerr = self.state.expect_keyword("fit");
    if kwerr.is_some() {
      ret kwerr;
    }

    let prev_in_fit_statement = self.in_fit_statement;
    self.in_fit_statement = true;

    let cerr = self.parse_expressionable_root();
    if cerr.is_some() {
      ret cerr;
    }
    let maybe_cond = self.state.node_pop();
    if maybe_cond.is_none() {
      self.state.err("expected fit condition");
      ret .Some(ParseErrorKind.InvalidExpression);
    }
    Node* condition = malloc(sizeof(Node));
    *condition = maybe_cond.unwrap();

    bin has_pos = false;
    Pos pos;
    fit fit_tok {
      .Some(t) -> {
        pos = t.pos;
        has_pos = true;
      }
      .None -> {}
    }
    let berr = self.parse_fit_body(condition, pos, has_pos);
    self.in_fit_statement = prev_in_fit_statement;
    ret berr;
  }

  // Parses `break;`.
  pub parse_break_statement() Option<ParseErrorKind> {
    let tok = self.state.token_next(); // consume 'break'
    Node node = node_new(NodeKind.StatementBreak);
    fit tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses `continue;`.
  pub parse_continue_statement() Option<ParseErrorKind> {
    let tok = self.state.token_next(); // consume 'continue'
    Node node = node_new(NodeKind.StatementContinue);
    fit tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret self.state.expect_sym(';');
  }

  // Parses `defer { ... }` (a block) or `defer expr;` (a single
  // expression) -- both run at scope exit, codegen handles the actual
  // ordering/semantics; the parser only records which.
  pub parse_defer_statement() Option<ParseErrorKind> {
    let defer_tok = self.state.token_peek_next();
    if !self.has_current_function {
      self.state.err("defer statement outside of function");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    self.state.token_next(); // consume 'defer'

    let next_tok = self.state.token_peek_next();
    if next_tok.is_none() {
      self.state.err("expected expression or body after 'defer'");
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    Node* body;
    if token_is_symbol(next_tok.unwrap(), '{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected body after 'defer'");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();
    } else {
      let eerr = self.parse_expressionable_root();
      if eerr.is_some() {
        ret eerr;
      }
      let maybe_expr = self.state.node_pop();
      if maybe_expr.is_none() {
        self.state.err("expected expression after 'defer'");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      body = malloc(sizeof(Node));
      *body = maybe_expr.unwrap();
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    Node node = node_new(NodeKind.StatementDefer(body));
    fit defer_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.create_node(&node);
    ret .None;
  }

  // Parses `test "name" { ... }`. Top-level only -- enforced simply by
  // never wiring `test` into `parse_statement`'s own dispatch (only
  // `parse_top_level_declaration` calls this), matching the original's
  // `is_global_scope` check without needing an equivalent flag. Reuses
  // ordinary statement parsing for the body via a synthetic (nameless,
  // argument-less) function context -- the same "act as if inside a
  // function" stand-in the original uses -- so `if`/`for`/`ret`/`defer`/
  // etc. (which check `has_current_function`) work the same inside a
  // test body as inside a real one.
  pub parse_test_declaration() Option<ParseErrorKind> {
    let test_tok = self.state.token_next(); // consume 'test'

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != TokenType.String {
      self.state.err("expected a string name after 'test'");
      ret .Some(ParseErrorKind.InvalidString);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    self.state.new_scope();

    let prev_fn = self.current_function;
    let prev_has_fn = self.has_current_function;
    Node fn_stub = node_new(NodeKind.Function(function_node_new()));
    self.current_function = &fn_stub;
    self.has_current_function = true;

    let berr = self.parse_body();
    self.current_function = prev_fn;
    self.has_current_function = prev_has_fn;
    self.state.finish_scope();
    if berr.is_some() {
      ret berr;
    }
    let maybe_body = self.state.node_pop();
    if maybe_body.is_none() {
      self.state.err("expected test body");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    Node* body = malloc(sizeof(Node));
    *body = maybe_body.unwrap();

    TestDeclNode td;
    td.name = name;
    td.body = body;

    Node node = node_new(NodeKind.Test(td));
    fit test_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.state.nodes.push(node);
    ret .None;
  }

  // Parses one statement: a `{ ... }` nested body, a `let` declaration, a
  // `ret`/`assert`/`if`/`elif`/`else`/`for`/`fit`/`defer`/`break`/
  // `continue` statement, or an expression statement terminated by `;`.
  // 
  // Deliberately simplified from the original for this slice: no keyword
  // dispatch beyond those (`compound`/`quirk`/... each need their own
  // parsing infrastructure not ported yet -- an unsupported keyword
  // reports a clean "not yet supported" error rather than silently
  // misparsing), no `fork`-statement contextual-keyword handling, and no
  // user-defined-type declaration detection (`Point p;` -- needs the same
  // lookahead machinery as the keyword dispatch above, deferred with it).
  pub parse_statement() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("unexpected end of file");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    let t = tok.unwrap();

    if t.type == TokenType.Keyword {
      str kw = "";
      fit t.data {
        .Sval(s) -> { kw = s; }
        _ -> {}
      }
      if equals(kw, "let") {
        ret self.parse_let_declaration(false);
      }
      if equals(kw, "ret") {
        ret self.parse_return();
      }
      if equals(kw, "assert") {
        ret self.parse_assert();
      }
      if equals(kw, "if") {
        ret self.parse_if_statement();
      }
      if equals(kw, "elif") {
        ret self.parse_elif_statement();
      }
      if equals(kw, "else") {
        ret self.parse_else_statement();
      }
      if equals(kw, "for") {
        ret self.parse_for_statement();
      }
      if equals(kw, "fit") {
        ret self.parse_fit_statement();
      }
      if equals(kw, "defer") {
        ret self.parse_defer_statement();
      }
      if equals(kw, "break") {
        ret self.parse_break_statement();
      }
      if equals(kw, "continue") {
        ret self.parse_continue_statement();
      }
      let msg = format("keyword '{str}' is not yet supported in statement position", kw);
      defer free(msg);
      self.state.err(msg);
      ret .Some(ParseErrorKind.InvalidStatement);
    }

    if token_is_symbol(t, '{') {
      ret self.parse_body();
    }

    let eerr = self.parse_expressionable_root();
    if eerr.is_some() {
      ret eerr;
    }
    ret self.state.expect_sym(';');
  }

  // Parses `imp path;` or `imp path as alias;`, including parent-
  // traversal path segments (`imp ..defs.user;`, `imp ...deep.thing;` --
  // each PAIR of leading dots means "go up one directory"; `leading_dots`
  // sums the length of every leading all-dot operator token, so this
  // still works whether the lexer handed back `..` as one token or `.`
  // `.` as two).
  // 
  // Deliberately simplified from the original for this slice: the parsed
  // path/alias is recorded on the `Import` node, but nothing is done to
  // actually RESOLVE it -- the original's `preload_import_global_symbols`
  // / `preload_std_import_global_symbols` read the imported file (or a
  // hardcoded stdlib symbol table) off disk to preload its exported names
  // for identifier validation, which is real filesystem work tied to a
  // whole module-resolution subsystem, not something the parser alone
  // can or should do. Until that's ported, a plain (non-call) reference
  // to an imported name relies on the same "unknown identifier" bypasses
  // `parse_single_token_to_node` already documents (out-of-order calls,
  // `fit` conditions, ALL_CAPS macro-style constants) rather than genuine
  // resolution.
  pub parse_import() Option<ParseErrorKind> {
    let imp_tok = self.state.token_next(); // consume 'imp'

    num leading_dots = 0;
    for true {
      fit self.state.token_peek_next() {
        .Some(t) -> {
          if !_is_dot_run_operator(t) {
            break;
          }
          self.state.token_next();
          str s = "";
          fit t.data {
            .Sval(sv) -> { s = sv; }
            _ -> {}
          }
          leading_dots = leading_dots + len(s);
        }
        .None -> { break; }
      }
    }
    if leading_dots % 2 != 0 {
      self.state.err("invalid import path: expected '.' after '.'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }

    let folder_tok = self.state.token_next();
    if folder_tok.is_none() || folder_tok.unwrap().type != TokenType.Identifier {
      self.state.err("expected folder identifier after import");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str folder_name = "";
    fit folder_tok.unwrap().data {
      .Sval(s) -> { folder_name = s; }
      _ -> {}
    }

    str path = folder_name;
    num i = 0;
    for i < leading_dots {
      path = format("{chr}{str}", '.', path);
      i = i + 1;
    }

    for true {
      bin is_dot_run = false;
      fit self.state.token_peek_next() {
        .Some(t) -> { is_dot_run = _is_dot_run_operator(t); }
        .None -> {}
      }
      if !is_dot_run {
        break;
      }
      let dot_tok = self.state.token_next().unwrap();
      let part_tok = self.state.token_next();
      if part_tok.is_none() || part_tok.unwrap().type != TokenType.Identifier {
        self.state.err("expected identifier after '.' in import path");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      str dot_op = "";
      fit dot_tok.data {
        .Sval(s) -> { dot_op = s; }
        _ -> {}
      }
      str part_name = "";
      fit part_tok.unwrap().data {
        .Sval(s) -> { part_name = s; }
        _ -> {}
      }
      path = format("{str}{str}{str}", path, dot_op, part_name);
    }

    str alias = "";
    bin has_alias = false;
    if self.state.next_token_is_keyword("as") {
      self.state.token_next(); // consume 'as'
      let alias_tok = self.state.token_next();
      if alias_tok.is_none() || alias_tok.unwrap().type != TokenType.Identifier {
        self.state.err("expected alias identifier after 'as'");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      fit alias_tok.unwrap().data {
        .Sval(s) -> { alias = s; }
        _ -> {}
      }
      has_alias = true;
    }

    let serr = self.state.expect_sym(';');
    if serr.is_some() {
      ret serr;
    }

    ImportNode imp_node_data;
    imp_node_data.path = path;
    imp_node_data.alias = alias;
    imp_node_data.has_alias = has_alias;

    Node node = node_new(NodeKind.Import(imp_node_data));
    fit imp_tok {
      .Some(t) -> {
        node.pos = t.pos;
        node.has_pos = true;
      }
      .None -> {}
    }
    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `compound Name { field decls }` (optionally generic, `compound
  // Name<T> { ... }`): a struct-like user-defined type. Fields share a
  // datatype across a comma-separated name list (`dec x, y;`), though
  // only the FIRST field in such a list may be an array type -- deep-
  // cloning the size-expression AST per extra name isn't supported,
  // matching the original. Registers the compound's name as a symbol via
  // `push_symbol` so it can be used as a datatype identifier elsewhere
  // (e.g. `Name x;`, or `Name{ ... }` compound-init once THAT'S ported).
  pub parse_compound(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("compound");
    if kwerr.is_some() {
      ret kwerr;
    }

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != TokenType.Identifier {
      self.state.err("expected identifier after 'compound'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> type_param_forced_insts;
    type_param_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(
      &type_params,
      &type_param_forced_insts
    );
    if tperr.is_some() {
      ret tperr;
    }

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<CompoundField> fields;
    fields.init(0);

    for !self.state.next_token_is_symbol('}') {
      DataType* dt = malloc(sizeof(DataType));
      *dt = dtype_new();
      let derr = self.state.parse_datatype(dt);
      if derr.is_some() {
        ret derr;
      }
      if self.state.next_token_is_operator("[") {
        let aberr = self.parse_array_brackets(dt);
        if aberr.is_some() {
          ret aberr;
        }
      }

      num field_count = 0;
      for true {
        let field_tok = self.state.token_next();
        if field_tok.is_none() || field_tok.unwrap().type != TokenType.Identifier {
          self.state.err("expected field name");
          ret .Some(ParseErrorKind.InvalidIdentifier);
        }
        str fname = "";
        fit field_tok.unwrap().data {
          .Sval(s) -> { fname = s; }
          _ -> {}
        }

        // Only the first field in a combined multi-name list may be an
        // array type -- deep-cloning the size-expression AST per extra
        // name isn't supported, matching the original.
        if field_count > 0 && dt.is_array {
          self.state.err("array fields cannot be declared in a combined list; declare them separately");
          ret .Some(ParseErrorKind.InvalidDataType);
        }

        DataType* field_dt = malloc(sizeof(DataType));
        *field_dt = *dt;

        CompoundField cf;
        cf.name = fname;
        cf.dtype = field_dt;
        fields.push(cf);
        field_count = field_count + 1;

        if !self.state.next_token_is_operator(",") {
          break;
        }
        self.state.token_next();
      }

      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    CompoundNode cn = compound_node_new();
    cn.name = name;
    cn.fields = fields;
    cn.type_params = type_params;
    cn.has_type_params = type_params.len > 0;
    cn.type_param_forced_insts = type_param_forced_insts;
    cn.has_type_param_forced_insts = type_param_forced_insts.len > 0;

    Node node = node_new(NodeKind.Compound(cn));
    node.pos = name_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Symbol sym = symbol_new(name);
    sym.kind = SymbolKind.NodeSym(node);
    self.state.push_symbol(sym);

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `enum Name { variants }` (optionally generic, `enum Name<T> {
  // ... }`): a plain C-style enum, or a tagged union if any variant has a
  // data-carrying payload (`Circle(num)`). Variants are separated by `,`
  // (preferred) or `;` (legacy); a trailing separator before `}` is
  // allowed. Registers the enum's name as a symbol via `push_symbol`,
  // same as `parse_compound`.
  // 
  // Deliberately simplified from the original for this slice: reuses the
  // constraint-AWARE `parse_type_params_with_constraints` for `enum`'s
  // type parameters
  // rather than porting a separate constraint-less
  // `parse_generic_type_params` -- the original's enum path doesn't
  // support `T: a | b` constraints at all, so this is slightly more
  // permissive than the original (an enum written with constraint syntax
  // parses here where the original would error); not worth a whole
  // near-duplicate function just to preserve that rejection.
  pub parse_enum(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("enum");
    if kwerr.is_some() {
      ret kwerr;
    }

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != TokenType.Identifier {
      self.state.err("expected identifier after 'enum'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> unused_forced_insts;
    unused_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(&type_params, &unused_forced_insts);
    if tperr.is_some() {
      ret tperr;
    }

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<EnumVariant> variants;
    variants.init(0);

    for !self.state.next_token_is_symbol('}') {
      let vtok = self.state.token_next();
      if vtok.is_none() || vtok.unwrap().type != TokenType.Identifier {
        self.state.err("expected enum variant name");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      str vname = "";
      fit vtok.unwrap().data {
        .Sval(s) -> { vname = s; }
        _ -> {}
      }

      EnumVariant variant = enum_variant_new();
      variant.name = vname;

      // Optional positional payload for a data-carrying variant:
      // `Circle(num)`, `Rect(num, num)`.
      if self.state.next_token_is_operator("(") {
        self.state.token_next(); // consume '('
        Vec<DataType*> ptypes;
        ptypes.init(0);
        for !self.state.next_token_is_symbol(')') {
          DataType* pdt = malloc(sizeof(DataType));
          *pdt = dtype_new();
          let pderr = self.state.parse_datatype(pdt);
          if pderr.is_some() {
            ret pderr;
          }
          if self.state.next_token_is_operator("[") {
            let paberr = self.parse_array_brackets(pdt);
            if paberr.is_some() {
              ret paberr;
            }
          }
          ptypes.push(pdt);
          if !self.state.next_token_is_operator(",") {
            break;
          }
          self.state.token_next();
        }
        let rperr = self.state.expect_sym(')');
        if rperr.is_some() {
          ret rperr;
        }
        if ptypes.len == 0 {
          self.state.err("enum variant payload '()' must list at least one type");
          ret .Some(ParseErrorKind.InvalidToken);
        }
        variant.payload = ptypes;
        variant.has_payload = true;
      }

      // Optional explicit integer value: `A = 3`, `A = -1`.
      if self.state.next_token_is_operator("=") {
        self.state.token_next(); // consume '='
        bin negate = false;
        if self.state.next_token_is_operator("-") {
          self.state.token_next();
          negate = true;
        }
        let ntok = self.state.token_next();
        if ntok.is_none() || ntok.unwrap().type != TokenType.Number {
          self.state.err("expected integer literal after '='");
          ret .Some(ParseErrorKind.InvalidToken);
        }
        num v = 0;
        bin got_num = false;
        fit ntok.unwrap().data {
          .Num(n) -> {
            v = n;
            got_num = true;
          }
          _ -> {}
        }
        if !got_num {
          self.state.err("enum variant value must be an integer literal");
          ret .Some(ParseErrorKind.InvalidToken);
        }
        if negate {
          v = -v;
        }
        variant.value = v;
        variant.has_value = true;
      }

      if self.state.next_token_is_operator(",") {
        self.state.token_next();
      } elif self.state.next_token_is_symbol(';') {
        self.state.token_next();
      } elif !self.state.next_token_is_symbol('}') {
        self.state.err("expected ',' or ';' after enum variant");
        ret .Some(ParseErrorKind.InvalidToken);
      }

      variants.push(variant);
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    EnumDeclNode en = enum_decl_node_new();
    en.name = name;
    en.variants = variants;
    en.type_params = type_params;
    en.has_type_params = type_params.len > 0;

    Node node = node_new(NodeKind.Enum(en));
    node.pos = name_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Symbol sym = symbol_new(name);
    sym.kind = SymbolKind.NodeSym(node);
    self.state.push_symbol(sym);

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `quirk Name { method sigs }` (optionally generic, `quirk
  // Name<T> { ... }`): a structural interface -- method SIGNATURES only,
  // no bodies (`impl Type as Name { ... }` supplies those). Registers
  // the quirk's name as a symbol via `push_symbol`, same as
  // `parse_compound`/`parse_enum`.
  // 
  // Deliberately simplified from the original for this slice: reuses the
  // constraint-aware `parse_type_params_with_constraints` for the
  // quirk's own type parameters rather than the constraint-less
  // `parse_generic_type_params`, the same documented widening as
  // `parse_enum`'s.
  pub parse_quirk(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("quirk");
    if kwerr.is_some() {
      ret kwerr;
    }

    let name_tok = self.state.token_next();
    if name_tok.is_none() || name_tok.unwrap().type != TokenType.Identifier {
      self.state.err("expected identifier after 'quirk'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str name = "";
    fit name_tok.unwrap().data {
      .Sval(s) -> { name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> unused_forced_insts;
    unused_forced_insts.init(0);
    let tperr = self.state.parse_type_params_with_constraints(&type_params, &unused_forced_insts);
    if tperr.is_some() {
      ret tperr;
    }
    bin is_generic = type_params.len > 0;

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<QuirkMethodSig> methods;
    methods.init(0);

    for !self.state.next_token_is_symbol('}') {
      bin method_is_async = false;
      if self.state.next_token_is_keyword("async") {
        self.state.token_next();
        method_is_async = true;
      }

      let mname_tok = self.state.token_next();
      if mname_tok.is_none() || mname_tok.unwrap().type != TokenType.Identifier {
        self.state.err("expected method name");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      str mname = "";
      fit mname_tok.unwrap().data {
        .Sval(s) -> { mname = s; }
        _ -> {}
      }

      let lperr = self.state.expect_op("(");
      if lperr.is_some() {
        ret lperr;
      }

      Vec<QuirkArg> margs;
      margs.init(0);
      for !self.state.next_token_is_symbol(')') {
        DataType* adt = malloc(sizeof(DataType));
        *adt = dtype_new();
        let aderr = self.state.parse_datatype(adt);
        if aderr.is_some() {
          ret aderr;
        }
        if self.state.next_token_is_operator("[") {
          let qaberr = self.parse_array_brackets(adt);
          if qaberr.is_some() {
            ret qaberr;
          }
        }

        let aname_tok = self.state.token_next();
        if aname_tok.is_none() || aname_tok.unwrap().type != TokenType.Identifier {
          self.state.err("expected argument name");
          ret .Some(ParseErrorKind.InvalidIdentifier);
        }
        str aname = "";
        fit aname_tok.unwrap().data {
          .Sval(s) -> { aname = s; }
          _ -> {}
        }

        QuirkArg qa;
        qa.name = aname;
        qa.dtype = adt;
        margs.push(qa);

        if !self.state.next_token_is_operator(",") {
          break;
        }
        self.state.token_next();
      }
      let rperr = self.state.expect_sym(')');
      if rperr.is_some() {
        ret rperr;
      }

      DataType* rtype = malloc(sizeof(DataType));
      *rtype = dtype_new();
      bin has_explicit_rtype = false;
      fit self.state.token_peek_next() {
        .Some(rt) -> {
          bin looks_like_type = false;
          if rt.type == TokenType.Identifier {
            looks_like_type = true;
          }
          if rt.type == TokenType.Keyword {
            fit rt.data {
              .Sval(s) -> { looks_like_type = keyword_is_datatype(s); }
              _ -> {}
            }
          }
          if looks_like_type {
            let rderr = self.state.parse_datatype(rtype);
            if rderr.is_some() {
              ret rderr;
            }
            if self.state.next_token_is_operator("[") {
              let qrtaberr = self.parse_array_brackets(rtype);
              if qrtaberr.is_some() {
                ret qrtaberr;
              }
            }
            has_explicit_rtype = true;
          }
        }
        .None -> {}
      }
      if !has_explicit_rtype {
        rtype.kind = DataTypeType.Void;
        rtype.type_str = "void";
      }

      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }

      QuirkMethodSig ms = quirk_method_sig_new();
      ms.name = mname;
      ms.rtype = rtype;
      ms.args = margs;
      ms.is_async = method_is_async;
      methods.push(ms);
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    QuirkNode qn = quirk_node_new();
    qn.name = name;
    qn.methods = methods;
    qn.is_generic = is_generic;
    qn.type_params = type_params;
    qn.has_type_params = type_params.len > 0;

    Node node = node_new(NodeKind.Quirk(qn));
    node.pos = name_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    Symbol sym = symbol_new(name);
    sym.kind = SymbolKind.NodeSym(node);
    self.state.push_symbol(sym);

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses `impl Type { methods }` (plain) or `impl Type as Quirk {
  // methods }` (quirk-implementing), including the generic forms `impl
  // Type<T> { ... }` (T is a NEW type param the impl introduces,
  // disambiguated from a CONCRETE monomorphizing impl like `impl
  // Type<num> { ... }` via `impl_generic_args_are_params`'s lookahead)
  // and `impl Type<T> as Quirk<T> { ... }` (a SYMBOLIC quirk binding --
  // the quirk's arg is the impl's own type param -- vs. `as Quirk<num>`,
  // a CONCRETE, distinctly-mangled quirk identity).
  // 
  // Each method compiles to a regular top-level function with a
  // generated, mangled name (`<Type>__<method>`, or
  // `<Type>__<Quirk>__<method>` for a quirk impl) and an implicit `<Type>*
  // self` first argument, reusing the exact same statement/body-parsing
  // infrastructure as `parse_function` (a real `current_function`/scope
  // context, so `if`/`for`/`ret`/`defer`/etc. all work in a method body).
  // A method may also declare its OWN generic type parameter(s) in
  // addition to the impl's (`impl Box<T> { pub map<U>(U x) U { ... } }`).
  // 
  // Deliberately simplified from the original for this slice: unlike
  // the original, an impl method's arg list is parsed via the shared
  // `_parse_function_args` (which also accepts a trailing `...`
  // variadic marker) rather than a near-duplicate variadic-less loop;
  // the original doesn't look for `...` in an impl method's arg list at
  // all, so this is a minor, documented widening (a `...` there is
  // silently accepted and dropped here, where the original would report
  // a clean datatype-parse error) not worth a whole separate function
  // to avoid.
  pub parse_impl(bin is_public) Option<ParseErrorKind> {
    let kwerr = self.state.expect_keyword("impl");
    if kwerr.is_some() {
      ret kwerr;
    }
    let type_tok = self.state.token_next();
    if type_tok.is_none() || type_tok.unwrap().type != TokenType.Identifier {
      self.state.err("expected type name after 'impl'");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str base_type_name = "";
    fit type_tok.unwrap().data {
      .Sval(s) -> { base_type_name = s; }
      _ -> {}
    }

    Vec<str> type_params;
    type_params.init(0);
    Vec<Vec<str>> type_param_forced_insts;
    type_param_forced_insts.init(0);
    str type_name = base_type_name;

    if self.state.next_token_is_angle_open() {
      if self.state.impl_generic_args_are_params() {
        let tperr = self.state.parse_type_params_with_constraints(
          &type_params,
          &type_param_forced_insts
        );
        if tperr.is_some() {
          ret tperr;
        }
      } else {
        DataType* concrete_dt = malloc(sizeof(DataType));
        *concrete_dt = dtype_new();
        concrete_dt.type_str = base_type_name;
        let gaerr = self.state.parse_generic_type_args(concrete_dt);
        if gaerr.is_some() {
          ret gaerr;
        }
        type_name = _mangled_dtype_name(concrete_dt);
      }
    } else {
      let tperr = self.state.parse_type_params_with_constraints(
        &type_params,
        &type_param_forced_insts
      );
      if tperr.is_some() {
        ret tperr;
      }
    }
    bin has_type_params = type_params.len > 0;
    bin has_type_param_forced_insts = type_param_forced_insts.len > 0;

    let peek_after_type = self.state.token_peek_next();

    str quirk_name = "";
    bin has_quirk_name = false;
    str quirk_concrete_instantiation = "";
    bin has_quirk_concrete_instantiation = false;

    if peek_after_type.is_some() && token_is_keyword(peek_after_type.unwrap(), "as") {
      self.state.token_next(); // consume 'as'
      let quirk_tok = self.state.token_next();
      if quirk_tok.is_none() || quirk_tok.unwrap().type != TokenType.Identifier {
        self.state.err("expected quirk name after 'as'");
        ret .Some(ParseErrorKind.InvalidIdentifier);
      }
      str qname = "";
      fit quirk_tok.unwrap().data {
        .Sval(s) -> { qname = s; }
        _ -> {}
      }
      quirk_name = qname;
      has_quirk_name = true;

      // A generic quirk binding is either SYMBOLIC (the arg IS the
      // enclosing impl's own type param -- resolved later by the impl's
      // own generic-instantiation machinery, method mangling keys off
      // just the base quirk name) or CONCRETE (a fixed instantiation
      // that's effectively a distinct quirk identity, mangled the same
      // way a generic compound/enum instantiation is).
      if self.state.next_token_is_angle_open() {
        DataType* quirk_dt = malloc(sizeof(DataType));
        *quirk_dt = dtype_new();
        quirk_dt.type_str = qname;
        let qgaerr = self.state.parse_generic_type_args(quirk_dt);
        if qgaerr.is_some() {
          ret qgaerr;
        }
        bin is_symbolic = _dtype_references_any_param(quirk_dt, type_params);
        if !is_symbolic {
          quirk_concrete_instantiation = _mangled_dtype_name(quirk_dt);
          has_quirk_concrete_instantiation = true;
        }
      }
    } elif peek_after_type.is_some() && peek_after_type.unwrap().type == TokenType.Identifier {
      self.state.err("expected 'as' before quirk name in impl header");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    } elif peek_after_type.is_none() || !token_is_symbol(peek_after_type.unwrap(), '{') {
      self.state.err("expected 'as <Quirk>' or '{' after type name");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }

    let lberr = self.state.expect_sym('{');
    if lberr.is_some() {
      ret lberr;
    }

    Vec<Node*> methods;
    methods.init(0);

    for !self.state.next_token_is_symbol('}') {
      let merr = self._parse_impl_method(
        is_public,
        type_name,
        type_params,
        quirk_name,
        has_quirk_name,
        &methods
      );
      if merr.is_some() {
        ret merr;
      }
    }

    let rberr = self.state.expect_sym('}');
    if rberr.is_some() {
      ret rberr;
    }

    ImplNode impln = impl_node_new();
    impln.type_name = type_name;
    impln.type_params = type_params;
    impln.has_type_params = has_type_params;
    impln.type_param_forced_insts = type_param_forced_insts;
    impln.has_type_param_forced_insts = has_type_param_forced_insts;
    impln.quirk_name = quirk_name;
    impln.has_quirk_name = has_quirk_name;
    impln.quirk_concrete_instantiation = quirk_concrete_instantiation;
    impln.has_quirk_concrete_instantiation = has_quirk_concrete_instantiation;
    impln.methods = methods;

    Node node = node_new(NodeKind.Impl(impln));
    node.pos = type_tok.unwrap().pos;
    node.has_pos = true;
    node.flags.is_public = is_public;

    self.state.nodes.push(node);
    ret .None;
  }

  // Parses one impl method (`[pub] [async] name(args) [rtype] { body }`
  // or `... ;` for a bodyless one) and appends its generated `Function`
  // node to `out_methods`. Split out of `parse_impl` for readability --
  // see that function's own doc comment for the generated-name/implicit-
  // `self` scheme this implements.
  _parse_impl_method(
    bin impl_is_public,
    str type_name,
    Vec<str> type_params,
    str quirk_name,
    bin has_quirk_name,
    Vec<Node*>* out_methods
  ) Option<ParseErrorKind> {
    bin method_is_public = impl_is_public;
    bin method_is_async = false;

    for true {
      let peek = self.state.token_peek_next();
      if peek.is_none() || peek.unwrap().type != TokenType.Keyword {
        break;
      }
      let pk = peek.unwrap();
      if token_is_keyword(pk, "pub") {
        self.state.token_next();
        method_is_public = true;
        continue;
      }
      if token_is_keyword(pk, "async") {
        self.state.token_next();
        method_is_async = true;
        continue;
      }
      break;
    }

    let mname_tok = self.state.token_next();
    if mname_tok.is_none() || mname_tok.unwrap().type != TokenType.Identifier {
      self.state.err("expected method name in impl");
      ret .Some(ParseErrorKind.InvalidIdentifier);
    }
    str mname = "";
    fit mname_tok.unwrap().data {
      .Sval(s) -> { mname = s; }
      _ -> {}
    }

    str gen_name = "";
    if has_quirk_name {
      gen_name = format("{str}__{str}__{str}", type_name, quirk_name, mname);
    } else {
      gen_name = format("{str}__{str}", type_name, mname);
    }

    FunctionNode fnv = function_node_new();
    fnv.name = gen_name;
    fnv.has_name = true;
    fnv.is_async = method_is_async;

    Node fn_node = node_new(NodeKind.Function(fnv));
    fn_node.pos = mname_tok.unwrap().pos;
    fn_node.has_pos = true;
    fn_node.flags.is_public = method_is_public;

    Node* fn_node_ptr = malloc(sizeof(Node));
    *fn_node_ptr = fn_node;

    let prev_fn = self.current_function;
    let prev_has_fn = self.has_current_function;
    self.current_function = fn_node_ptr;
    self.has_current_function = true;

    self.state.new_scope();

    Vec<str> method_type_params;
    method_type_params.init(0);
    Vec<Vec<str>> method_type_param_forced_insts;
    method_type_param_forced_insts.init(0);
    let mtperr = self.state.parse_type_params_with_constraints(
      &method_type_params,
      &method_type_param_forced_insts
    );
    if mtperr.is_some() {
      ret mtperr;
    }
    fit fn_node_ptr.kind {
      .Function(curmtp) -> {
        curmtp.type_params = method_type_params;
        curmtp.has_type_params = method_type_params.len > 0;
        curmtp.type_param_forced_insts = method_type_param_forced_insts;
        curmtp.has_type_param_forced_insts = method_type_param_forced_insts.len > 0;
        fn_node_ptr.kind = NodeKind.Function(curmtp);
      }
      _ -> {}
    }

    let lperr = self.state.expect_op("(");
    if lperr.is_some() {
      ret lperr;
    }

    // Implicit `<Type>* self` first arg. When the impl itself is
    // generic, `self`'s type carries the SAME type params as generic
    // arguments (`Box<T>* self`), so references to `self`'s fields
    // inside the method resolve against the impl's own params.
    DataType* self_dt = malloc(sizeof(DataType));
    *self_dt = dtype_new();
    self_dt.pointer_depth = 1;
    self_dt.flags.is_pointer = true;
    self_dt.type_str = type_name;
    if type_params.len > 0 {
      Vec<DataType*> self_gargs;
      self_gargs.init(0);
      for tp : type_params {
        DataType* ga = malloc(sizeof(DataType));
        *ga = dtype_new();
        ga.type_str = tp;
        self_gargs.push(ga);
      }
      self_dt.generic_args = self_gargs;
    }

    VariableNode selfv;
    selfv.var_type = self_dt;
    selfv.name = "self";
    selfv.has_val = false;

    Node self_node = node_new(NodeKind.Variable(selfv));
    self_node.pos = mname_tok.unwrap().pos;
    self_node.has_pos = true;

    Node* self_node_ptr = malloc(sizeof(Node));
    *self_node_ptr = self_node;
    ScopeEntity* self_entity = self.new_scope_entity(self_node_ptr);
    self.state.push_scope_entity(self_entity);

    Vec<Node*> margs;
    margs.init(0);
    margs.push(self_node_ptr);

    bin method_is_variadic = false;
    let aerr = self._parse_function_args(&margs, &method_is_variadic);
    if aerr.is_some() {
      ret aerr;
    }
    let rperr = self.state.expect_sym(')');
    if rperr.is_some() {
      ret rperr;
    }

    fit fn_node_ptr.kind {
      .Function(curargs) -> {
        curargs.args = margs;
        curargs.has_args = true;
        fn_node_ptr.kind = NodeKind.Function(curargs);
      }
      _ -> {}
    }

    DataType* rtype = malloc(sizeof(DataType));
    bin has_explicit_rtype = false;
    fit self.state.token_peek_next() {
      .Some(rt) -> {
        bin looks_like_type = false;
        if rt.type == TokenType.Identifier {
          looks_like_type = true;
        }
        if rt.type == TokenType.Keyword {
          fit rt.data {
            .Sval(s) -> { looks_like_type = keyword_is_datatype(s); }
            _ -> {}
          }
        }
        if looks_like_type {
          *rtype = dtype_new();
          let rderr = self.state.parse_datatype(rtype);
          if rderr.is_some() {
            ret rderr;
          }
          if self.state.next_token_is_operator("[") {
            let imaberr = self.parse_array_brackets(rtype);
            if imaberr.is_some() {
              ret imaberr;
            }
          }
          has_explicit_rtype = true;
        }
      }
      .None -> {}
    }
    if !has_explicit_rtype {
      *rtype = dtype_new();
      rtype.kind = DataTypeType.Void;
      rtype.type_str = "void";
    }
    fit fn_node_ptr.kind {
      .Function(currt) -> {
        currt.rtype = rtype;
        currt.has_rtype = true;
        fn_node_ptr.kind = NodeKind.Function(currt);
      }
      _ -> {}
    }

    if self.state.next_token_is_symbol('{') {
      let berr = self.parse_body();
      if berr.is_some() {
        ret berr;
      }
      let maybe_body = self.state.node_pop();
      if maybe_body.is_none() {
        self.state.err("expected method body");
        ret .Some(ParseErrorKind.InvalidStatement);
      }
      Node* body = malloc(sizeof(Node));
      *body = maybe_body.unwrap();
      fit fn_node_ptr.kind {
        .Function(curbody) -> {
          curbody.body = body;
          curbody.has_body = true;
          fn_node_ptr.kind = NodeKind.Function(curbody);
        }
        _ -> {}
      }
    } else {
      let serr = self.state.expect_sym(';');
      if serr.is_some() {
        ret serr;
      }
    }

    self.current_function = prev_fn;
    self.has_current_function = prev_has_fn;
    self.state.finish_scope();

    out_methods.push(fn_node_ptr);
    ret .None;
  }

  // Parses one top-level item: `imp`, `test`, `compound`, `enum`,
  // `quirk`, `impl`, `pub`/`async fun`/`fun`, a bare-datatype-keyword
  // global variable (`num x = 5;`), or -- for everything
  // `parse_statement` already understands (`let`, `ret`, `assert`,
  // `if`/`elif`/`else`, `for`, `fit`, `defer`, `break`, `continue`, a
  // `{ ... }` block, or a bare expression statement) -- delegates there
  // directly.
  // 
  // Deliberately simplified from the original for this slice: no
  // `asm`/`await`/`nil`/`allow`/`expect`/`panic` declarations -- a clean
  // "not yet supported" error is reported instead of a misparse. Also no
  // bare
  // `Identifier name;` top-level declaration (public OR private) --
  // needs the same forward-lookahead machinery the original uses to
  // disambiguate a type name from an expression, already documented as
  // deferred in `parse_body_multiple_statements`'s doc comment; `pub`
  // followed by a plain identifier reports the same clean error as any
  // other not-yet-supported `pub` target rather than being silently
  // misparsed as an expression.
  // 
  // Also unlike the original: a bare top-level expression (no leading
  // keyword) DOES require a trailing `;` here, via delegating to
  // `parse_statement` -- more consistent with every other statement
  // position than replicating the original's asymmetry (its top-level
  // `next()` skips the `;` requirement for a bare expression but nothing
  // else does).
  pub parse_top_level_declaration() Option<ParseErrorKind> {
    let tok = self.state.token_peek_next();
    if tok.is_none() {
      self.state.err("unexpected end of file");
      ret .Some(ParseErrorKind.InvalidStatement);
    }
    let t = tok.unwrap();

    if t.type == TokenType.Keyword {
      str kw = "";
      fit t.data {
        .Sval(s) -> { kw = s; }
        _ -> {}
      }

      if equals(kw, "imp") {
        ret self.parse_import();
      }

      if equals(kw, "test") {
        ret self.parse_test_declaration();
      }

      if equals(kw, "compound") {
        ret self.parse_compound(false);
      }

      if equals(kw, "enum") {
        ret self.parse_enum(false);
      }

      if equals(kw, "quirk") {
        ret self.parse_quirk(false);
      }

      if equals(kw, "impl") {
        ret self.parse_impl(false);
      }

      if equals(kw, "pub") {
        self.state.token_next(); // consume 'pub'
        let next_tok = self.state.token_peek_next();
        if next_tok.is_none() {
          self.state.err("expected a declaration after 'pub'");
          ret .Some(ParseErrorKind.InvalidStatement);
        }
        let nt = next_tok.unwrap();
        str nkw = "";
        bin nt_is_keyword = nt.type == TokenType.Keyword;
        if nt_is_keyword {
          fit nt.data {
            .Sval(s) -> { nkw = s; }
            _ -> {}
          }
          if keyword_is_datatype(nkw) {
            ret self._parse_top_level_variable(true);
          }
          if equals(nkw, "let") {
            ret self.parse_let_declaration(true);
          }
          if equals(nkw, "compound") {
            ret self.parse_compound(true);
          }
          if equals(nkw, "enum") {
            ret self.parse_enum(true);
          }
          if equals(nkw, "quirk") {
            ret self.parse_quirk(true);
          }
          if equals(nkw, "impl") {
            ret self.parse_impl(true);
          }
          if equals(nkw, "async") {
            self.state.token_next(); // consume 'async'
            let fun_tok = self.state.token_peek_next();
            if fun_tok.is_none() || !token_is_keyword(fun_tok.unwrap(), "fun") {
              self.state.err("expected 'fun' after 'async'");
              ret .Some(ParseErrorKind.InvalidKeyword);
            }
            ret self.parse_function(true, true);
          }
          if equals(nkw, "fun") {
            ret self.parse_function(true, false);
          }
        }
        if nt_is_keyword {
          let msg = format("keyword '{str}' is not yet supported after 'pub'", nkw);
          defer free(msg);
          self.state.err(msg);
        } else {
          self.state.err("expected a declaration after 'pub'");
        }
        ret .Some(ParseErrorKind.InvalidKeyword);
      }

      if equals(kw, "async") {
        self.state.token_next(); // consume 'async'
        let fun_tok = self.state.token_peek_next();
        if fun_tok.is_none() || !token_is_keyword(fun_tok.unwrap(), "fun") {
          self.state.err("expected 'fun' after 'async'");
          ret .Some(ParseErrorKind.InvalidKeyword);
        }
        ret self.parse_function(false, true);
      }

      if equals(kw, "fun") {
        ret self.parse_function(false, false);
      }

      if keyword_is_datatype(kw) {
        ret self._parse_top_level_variable(false);
      }
    }

    ret self.parse_statement();
  }

  // `<datatype> name [= val];` at the top level (public or private).
  _parse_top_level_variable(bin is_public) Option<ParseErrorKind> {
    DataType* dt = malloc(sizeof(DataType));
    *dt = dtype_new();
    let derr = self.state.parse_datatype(dt);
    if derr.is_some() {
      ret derr;
    }
    let verr = self.parse_variable(dt, is_public, false);
    if verr.is_some() {
      ret verr;
    }
    ret self.state.expect_sym(';');
  }

  // Repeatedly parses top-level items until the token stream is
  // exhausted or a parse error occurs. Opens the file's root scope
  // first (closed by nothing -- matching `parse_body_multiple_statements`'s
  // established convention of not unwinding parser state on error, and a
  // successful parse has no reason to close the root scope since nothing
  // outlives it).
  // 
  // Deliberately simplified from the original for this slice: no forward
  // type-name pre-scan (`prescan_forward_type_names`) -- it exists to let
  // a `Name{...}` compound initializer forward-reference a `compound`/
  // `enum`/`quirk` declared later in the file, and compound-init parsing
  // itself isn't ported yet either. No cross-file `global_symbols`
  // registration (`register_global_node_symbol`,
  // `preload_import_global_symbols`) -- `parse_import` parses `imp`
  // syntax into an `Import` node but doesn't resolve it (see its own doc
  // comment); within a single file, top-level `let`/variable declarations
  // already resolve via the same scope-entity mechanism as any other declaration,
  // and forward/out-of-order function calls are already tolerated by
  // `parse_single_token_to_node`'s identifier check (see its own doc
  // comment).
  pub parse() Option<ParseErrorKind> {
    self.state.init_root_scope();
    for true {
      let peeked = self.state.token_peek_next();
      if peeked.is_none() {
        break;
      }
      let err = self.parse_top_level_declaration();
      if err.is_some() {
        ret err;
      }
    }
    ret .None;
  }
}

// ===== Test helpers =====

fun _state_from(str src) ParseState {
  ParseState st = parse_state_new("test.fn", src);
  st.tokens = tokenize(src, "test.fn").unwrap();
  // Tests exercise expected-failure paths too; keep stdout clean.
  st.emit_stderr = false;
  ret st;
}

test "token cursor advances past whitespace/newlines and reports EOF" {
  ParseState st = _state_from("let\nx");
  let first = st.token_next();
  assert first.is_some(), "expected a first token";
  assert token_is_keyword(first.unwrap(), "let"), "first token should be keyword 'let'";

  let second = st.token_next();
  assert second.is_some(), "expected a second token";
  fit second.unwrap().data {
    .Sval(s) -> { assert equals(s, "x"), "second token should be identifier 'x'"; }
    _ -> { panic("second token should carry Sval"); }
  }

  let third = st.token_next();
  assert third.is_none(), "expected end of stream after 2 tokens";
}

test "token_peek_next does not consume, token_peek_n looks further ahead" {
  ParseState st = _state_from("a b c");

  let peeked = st.token_peek_next();
  assert peeked.is_some(), "expected a peeked token";
  fit peeked.unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "peek should see 'a' without consuming it"; }
    _ -> { panic("expected Sval"); }
  }

  // Peeking again returns the SAME token (not consumed).
  let peeked_again = st.token_peek_next();
  fit peeked_again.unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "second peek should still see 'a'"; }
    _ -> { panic("expected Sval"); }
  }

  // n=1 looks one significant token further ahead without consuming anything.
  let ahead = st.token_peek_n(1);
  fit ahead.unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "token_peek_n(1) should see 'b'"; }
    _ -> { panic("expected Sval"); }
  }

  // Cursor is still at 'a': a real consume gets 'a', then 'b'.
  fit st.token_next().unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "first consume should still be 'a'"; }
    _ -> { panic("expected Sval"); }
  }
  fit st.token_next().unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "second consume should be 'b'"; }
    _ -> { panic("expected Sval"); }
  }
}

test "expect_sym/expect_op/expect_keyword succeed on a match" {
  // `(` lexes as an Operator (see lexdefs.fn's `op_treated_as_one`), not a
  // Symbol -- only the small set of structural delimiters (`{ } ; ) ]`) are
  // Symbol tokens, so `)` is used here to exercise `expect_sym`.
  ParseState st = _state_from(") + let");
  assert st.expect_sym(')').is_none(), "expected ')' to match";
  assert st.expect_op("+").is_none(), "expected '+' to match";
  assert st.expect_keyword("let").is_none(), "expected 'let' to match";
}

test "expect_sym/expect_op/expect_keyword report a typed error on mismatch" {
  ParseState st = _state_from("let");
  let err_sym = st.expect_sym(')');
  assert err_sym.is_some(), "expected a mismatch error";
  fit err_sym.unwrap() {
    .InvalidSymbol -> {}
    _ -> { panic("expected InvalidSymbol"); }
  }

  ParseState st2 = _state_from("let");
  let err_op = st2.expect_op("+");
  assert err_op.is_some(), "expected a mismatch error";
  fit err_op.unwrap() {
    .InvalidOperand -> {}
    _ -> { panic("expected InvalidOperand"); }
  }

  ParseState st3 = _state_from("(");
  let err_kw = st3.expect_keyword("let");
  assert err_kw.is_some(), "expected a mismatch error";
  fit err_kw.unwrap() {
    .InvalidKeyword -> {}
    _ -> { panic("expected InvalidKeyword"); }
  }
}

test "push_symbol/get_symbol round-trip through the active table" {
  ParseState st = _state_from("");
  SymbolTable table = symbol_table_new("test");
  st.active_table = &table;
  st.has_active_table = true;

  assert st.get_symbol("x").is_none(), "expected no symbol before registration";

  Symbol s = symbol_new("x");
  st.push_symbol(s);

  let found = st.get_symbol("x");
  assert found.is_some(), "expected to find the registered symbol";
  assert equals(found.unwrap().name, "x"), "found symbol should be named 'x'";
}

test "push_scope_entity/get_scope_entity walk the scope chain" {
  ParseState st = _state_from("");
  Scope root = scope_new();
  Scope child = scope_new();
  child.parent = &root;
  child.has_parent = true;
  st.scope_root = &root;
  st.has_scope_root = true;
  st.scope_current = &child;
  st.has_scope_current = true;

  assert st.get_scope_entity("x") == nil, "expected no entity before registration";

  ScopeEntity* e = malloc(sizeof(ScopeEntity));
  * e =scope_entity_new("x");
  st.push_scope_entity(e);

  let found = st.get_scope_entity("x");
  assert found != nil, "expected to find the registered entity";
  assert equals(found.name, "x"), "found entity should be named 'x'";
  assert st.get_scope_entity("missing") == nil, "unregistered name should not be found";
}

test "create_node stamps binded owner/function context" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node body_node = node_new(NodeKind.Blank);
  Node fn_node = node_new(NodeKind.Blank);
  p.current_body = &body_node;
  p.has_current_body = true;
  p.current_function = &fn_node;
  p.has_current_function = true;

  Node n = node_new(NodeKind.Blank);
  p.create_node(&n);

  assert n.has_binded, "expected create_node to stamp binded context";
  assert n.binded.has_owner, "expected binded.owner to be set from current_body";
  assert n.binded.has_function, "expected binded.function to be set from current_function";
  assert st.nodes.len == 1, "expected the node to be pushed into state.nodes";
}

test "create_node leaves binded unset with no active body/function" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node n = node_new(NodeKind.Blank);
  p.create_node(&n);

  assert !n.has_binded, "expected no binded context outside any body/function";
  assert st.nodes.len == 1, "expected the node to be pushed into state.nodes";
}

test "new_scope_entity derives its name from the node kind" {
  ParseState st = _state_from("");
  Parser p = parser_new(&st);

  Node id_node = node_new(NodeKind.Identifier("foo"));
  ScopeEntity* e = p.new_scope_entity(&id_node);
  assert equals(e.name, "foo"), "expected entity name derived from Identifier payload";

  Node blank_node = node_new(NodeKind.Blank);
  ScopeEntity* blank_entity = p.new_scope_entity(&blank_node);
  assert equals(blank_entity.name, ""), "expected empty name for a non-nameable node kind";
}

test "parse_datatype reads a builtin scalar keyword" {
  ParseState st = _state_from("num");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected num to parse";
  assert dt.kind == DataTypeType.Num, "expected kind Num";
  assert equals(dt.type_str, "num"), "expected type_str 'num'";
  assert dt.pointer_depth == 0, "expected no pointer depth";
}

test "parse_datatype reads trailing pointer-depth markers" {
  ParseState st = _state_from("num**");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected num** to parse";
  assert dt.kind == DataTypeType.Num, "expected kind Num";
  assert dt.flags.is_pointer, "expected is_pointer flag set";
  assert dt.pointer_depth == 2, "expected pointer depth 2";
}

test "parse_datatype reads a user-defined identifier type" {
  ParseState st = _state_from("MyCompound");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected MyCompound to parse";
  assert dt.kind == DataTypeType.Unknown, "user types stay Unknown";
  assert equals(dt.type_str, "MyCompound"), "expected type_str 'MyCompound'";
}

test "parse_datatype recognizes a known C typedef alias" {
  ParseState st = _state_from("size_t");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected size_t to parse";
  assert dt.kind == DataTypeType.Num, "size_t should be tagged numeric";
  assert equals(dt.type_str, "size_t"), "expected the original identifier preserved in type_str";
}

test "parse_datatype reads a qualified module-alias type" {
  ParseState st = _state_from("m.Type");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected m.Type to parse";
  assert equals(dt.type_str, "m__Type"), "expected qualified name mangled as m__Type";
}

test "parse_datatype reports an error on end of input" {
  ParseState st = _state_from("");
  st.emit_stderr = false;
  DataType dt = dtype_new();
  let err = st.parse_datatype(&dt);
  assert err.is_some(), "expected an error";
  fit err.unwrap() {
    .InvalidDataType -> {}
    _ -> { panic("expected InvalidDataType"); }
  }
}

test "parse_generic_type_args reads a single generic argument" {
  ParseState st = _state_from("Vec<num>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Vec<num> to parse";
  assert equals(dt.type_str, "Vec"), "expected base type_str 'Vec'";
  assert dt.generic_args.len == 1, "expected 1 generic arg";
  let arg0 = dt.generic_args.get(0);
  assert arg0.kind == DataTypeType.Num, "expected generic arg Num";
}

test "parse_generic_type_args reads multiple comma-separated arguments" {
  ParseState st = _state_from("Map<str, num>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Map<str, num> to parse";
  assert dt.generic_args.len == 2, "expected 2 generic args";
  let arg0 = dt.generic_args.get(0);
  let arg1 = dt.generic_args.get(1);
  assert arg0.kind == DataTypeType.Str, "expected first arg Str";
  assert arg1.kind == DataTypeType.Num, "expected second arg Num";
}

test "parse_generic_type_args splits a lexed '>>' for nested generics" {
  ParseState st = _state_from("Vec<Vec<num>>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Vec<Vec<num>> to parse";
  assert equals(dt.type_str, "Vec"), "expected outer type_str 'Vec'";
  assert dt.generic_args.len == 1, "expected 1 outer generic arg";
  let inner = dt.generic_args.get(0);
  assert equals(inner.type_str, "Vec"), "expected inner type_str 'Vec'";
  assert inner.generic_args.len == 1, "expected 1 inner generic arg";
  let innermost = inner.generic_args.get(0);
  assert innermost.kind == DataTypeType.Num, "expected innermost arg Num";
}

test "parse_generic_type_args pointer-typed generic argument" {
  ParseState st = _state_from("Vec<Node*>");
  DataType dt = dtype_new();
  assert st.parse_datatype(&dt).is_none(), "expected Vec<Node*> to parse";
  let inner = dt.generic_args.get(0);
  assert equals(inner.type_str, "Node"), "expected inner type_str 'Node'";
  assert inner.pointer_depth == 1, "expected inner pointer depth 1";
}

test "token_peek_prev/token_peek_prev_n look backward from the last consumed token" {
  ParseState st = _state_from("a b c");
  st.token_next();
  assert st.token_peek_prev().is_none(), "no token consumed before 'a'";

  st.token_next();
  st.token_next();
  fit st.token_peek_prev().unwrap().data {
    .Sval(s) -> { assert equals(s, "b"), "prev of 'c' should be 'b'"; }
    _ -> { panic("expected Sval"); }
  }
  fit st.token_peek_prev_n(1).unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "prev_n(1) of 'c' should be 'a'"; }
    _ -> { panic("expected Sval"); }
  }
}

test "token_peek_prev_stream_n looks backward from the not-yet-consumed token" {
  ParseState st = _state_from("a b c");
  st.token_next();
  // Cursor now sits on 'b' (not yet consumed): prev_stream_n(0) should
  // still see 'a', matching what `token_peek_prev` would see AFTER
  // consuming 'b', without actually consuming it.
  fit st.token_peek_prev_stream_n(0).unwrap().data {
    .Sval(s) -> { assert equals(s, "a"), "prev_stream_n(0) should see 'a'"; }
    _ -> { panic("expected Sval"); }
  }
}

test "parse_single_token_to_node reads number/dec/char literals" {
  ParseState st = _state_from("42");
  Parser p = parser_new(&st);
  assert p.parse_single_token_to_node().is_none(), "expected 42 to parse";
  let n = st.nodes.get(0);
  fit n.kind {
    .Number(d) -> {
      fit d {
        .Num(v) -> { assert v == 42, "expected 42"; }
        _ -> { panic("expected Num"); }
      }
    }
    _ -> { panic("expected Number node"); }
  }

  ParseState st2 = _state_from("'x'");
  Parser p2 = parser_new(&st2);
  assert p2.parse_single_token_to_node().is_none(), "expected 'x' to parse";
  let n2 = st2.nodes.get(0);
  fit n2.kind {
    .Character(c) -> { assert c == 'x', "expected 'x'"; }
    _ -> { panic("expected Character node"); }
  }
}

test "parse_single_token_to_node reads string and boolean literals" {
