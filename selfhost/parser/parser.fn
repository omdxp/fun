      let v0 = e.variants.get(0);
      let pt0 = v0.payload.get(0);
      assert pt0.is_array, "expected the payload element type to be an array";
    }
    _ -> { panic("expected an Enum node"); }
  }
}

test "parse_quirk parses an array-typed arg and return type" {
