  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Quirk(q) -> {
      let m0 = q.methods.get(0);
      assert m0.args.len == 1, "expected 1 arg";
      let a0 = m0.args.get(0);
      assert equals(a0.name, "s"), "expected arg name 's'";
      assert equals(a0.dtype.type_str, "str"), "expected arg type 'str'";
      fit m0.rtype.kind {
        .Void -> {}
        _ -> { panic("expected an omitted return type to default to void"); }
      }
    }
    _ -> { panic("expected a Quirk node"); }
  }
}

