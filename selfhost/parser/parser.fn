  assert p.parse_statement().is_none(), "expected parse_statement to dispatch 'continue'";
  fit st.nodes.get(0).kind {
    .StatementBreak -> {}
    _ -> { panic("expected a StatementBreak node"); }
  }
  fit st.nodes.get(1).kind {
    .StatementContinue -> {}
    _ -> { panic("expected a StatementContinue node"); }
  }
}

test "parse_test_declaration parses a named test body" {
