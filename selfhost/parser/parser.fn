test "parse_impl parses a plain (non-quirk) impl with a method body" {
  ParseState st = _state_from("impl Point { getx() num { ret self.x; } }");
  Parser p = parser_new(&st);
  assert p.parse_impl(true).is_none(), "expected the plain impl to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Impl(i) -> {
      assert equals(i.type_name, "Point"), "expected type name 'Point'";
      assert top.flags.is_public, "expected the impl to be public";
      assert !i.has_quirk_name, "expected no quirk name for a plain impl";
      assert i.methods.len == 1, "expected 1 method";
      let m0 = i.methods.get(0);
      fit m0.kind {
        .Function(f) -> {
          assert equals(f.name, "Point__getx"), "expected generated name 'Point__getx'";
          assert f.args.len == 1, "expected 1 arg (implicit self)";
          let a0 = f.args.get(0);
          fit a0.kind {
            .Variable(v) -> {
              assert equals(v.name, "self"), "expected implicit arg 'self'";
              assert equals(v.var_type.type_str, "Point"), "expected self type 'Point'";
              assert v.var_type.pointer_depth == 1, "expected self to be a pointer";
            }
            _ -> { panic("expected a Variable arg"); }
          }
          assert f.has_body, "expected a body";
        }
        _ -> { panic("expected a Function node"); }
      }
    }
    _ -> { panic("expected an Impl node"); }
  }
}

test "parse_impl parses a symbolic generic quirk binding" {
  ParseState st = _state_from("impl VecIter<T> as Iterator<T> { next() Option<T> { ret .None; } }");
  Parser p = parser_new(&st);
  assert p.parse_impl(false).is_none(), "expected the generic quirk impl to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Impl(i) -> {
      assert equals(i.type_name, "VecIter"), "expected type name 'VecIter' (not mangled -- T is a param)";
      assert i.has_type_params, "expected type params";
      assert equals(i.type_params.get(0), "T"), "expected type param 'T'";
      assert i.has_quirk_name, "expected a quirk name";
      assert equals(i.quirk_name, "Iterator"), "expected quirk name 'Iterator'";
      assert !i.has_quirk_concrete_instantiation, "expected a SYMBOLIC binding (T is the impl's own param), not concrete";
      let m0 = i.methods.get(0);
      fit m0.kind {
        .Function(f) -> {
          assert equals(f.name, "VecIter__Iterator__next"), "expected generated name 'VecIter__Iterator__next'";
        }
        _ -> { panic("expected a Function node"); }
      }
    }
    _ -> { panic("expected an Impl node"); }
  }
}

test "parse_impl parses a concrete generic quirk instantiation" {
  ParseState st = _state_from("impl Point as To<num> { convert() num { ret 0; } }");
  Parser p = parser_new(&st);
  assert p.parse_impl(false).is_none(), "expected the concrete quirk impl to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Impl(i) -> {
      assert equals(i.type_name, "Point"), "expected type name 'Point'";
      assert !i.has_type_params, "expected no type params (Point itself isn't generic)";
      assert i.has_quirk_name, "expected a quirk name";
      assert equals(i.quirk_name, "To"), "expected quirk name 'To'";
      assert i.has_quirk_concrete_instantiation, "expected a CONCRETE instantiation (num isn't a param)";
      assert equals(i.quirk_concrete_instantiation, "To__num"), "expected mangled name 'To__num'";
    }
    _ -> { panic("expected an Impl node"); }
  }
}

test "parse_impl parses a concrete monomorphizing impl on an already-generic type" {
  ParseState st = _state_from("impl Vec<num> { sum() num { ret 0; } }");
  Parser p = parser_new(&st);
  assert p.parse_impl(false).is_none(), "expected the concrete monomorphizing impl to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Impl(i) -> {
      // `<num>` is a datatype keyword, not an identifier -- concrete
      // generic ARGS, not new type PARAMS, so the type name is mangled.
      assert equals(i.type_name, "Vec__num"), "expected mangled type name 'Vec__num'";
      assert !i.has_type_params, "expected no type params for a concrete monomorphizing impl";
      let m0 = i.methods.get(0);
      fit m0.kind {
        .Function(f) -> {
          assert equals(f.name, "Vec__num__sum"), "expected generated name 'Vec__num__sum'";
        }
        _ -> { panic("expected a Function node"); }
      }
    }
    _ -> { panic("expected an Impl node"); }
  }
}

test "parse_impl parses a bodyless method declaration" {
  ParseState st = _state_from("impl Foo { bar(); }");
  Parser p = parser_new(&st);
  assert p.parse_impl(false).is_none(), "expected the impl to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Impl(i) -> {
      let m0 = i.methods.get(0);
      fit m0.kind {
        .Function(f) -> {
          assert !f.has_body, "expected no body";
          fit f.rtype.kind {
            .Void -> {}
            _ -> { panic("expected an omitted return type to default to void"); }
          }
        }
        _ -> { panic("expected a Function node"); }
      }
    }
    _ -> { panic("expected an Impl node"); }
  }
}

test "parse_impl parses pub/async method modifiers and a method's own generic type param" {
  ParseState st = _state_from("impl Box<T> { pub async map<U>(U x) U { ret x; } }");
  Parser p = parser_new(&st);
  assert p.parse_impl(false).is_none(), "expected the impl to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Impl(i) -> {
      let m0 = i.methods.get(0);
      fit m0.kind {
        .Function(f) -> {
          assert f.is_async, "expected 'map' to be async";
          assert m0.flags.is_public, "expected 'map' to be public";
          assert f.has_type_params, "expected the method's own type param";
          assert equals(f.type_params.get(0), "U"), "expected method type param 'U'";
          // The implicit self arg plus the explicit 'x' arg.
          assert f.args.len == 2, "expected 2 args (self, x)";
          let a1 = f.args.get(1);
          fit a1.kind {
            .Variable(v) -> { assert equals(v.name, "x"), "expected explicit arg 'x'"; }
            _ -> { panic("expected a Variable arg"); }
          }
        }
        _ -> { panic("expected a Function node"); }
      }
    }
    _ -> { panic("expected an Impl node"); }
  }
}

