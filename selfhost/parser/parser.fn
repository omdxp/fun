test "parse_if_statement preserves explicit grouping through a following binary operator" {
  // The historically miscompiled shape: `(a || b) && c` must stay grouped
  // as `((a || b)) && c` -- codegen never auto-parenthesizes, so losing
  // the explicit parens here would silently change what the condition
  // means (`||` binds looser than `&&`).
  Vec<str> names;
  names.init(0);
  names.push("a");
  names.push("b");
  names.push("c");
  ParseState st = _state_with_declared("if (a || b) && c { }", names);
  Parser p = parser_new(&st);
  Node fn_stub = node_new(NodeKind.Blank);
  p.current_function = &fn_stub;
  p.has_current_function = true;

  assert p.parse_if_statement().is_none(), "expected 'if (a || b) && c { }' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementIf(ifn) -> {
      fit ifn.condition.kind {
        .Expression(e) -> {
          assert equals(e.op, "&&"), "expected the outer condition op to be '&&'";
          fit e.right.kind {
            .Identifier(s) -> { assert equals(s, "c"), "expected the outer right to be 'c'"; }
            _ -> { panic("expected Identifier 'c'"); }
          }
          fit e.left.kind {
            .ExpressionParenthesis(inner) -> {
              fit inner.kind {
                .Expression(ie) -> {
                  assert equals(ie.op, "||"), "expected the grouped inner op to be '||'";
                  fit ie.left.kind {
                    .Identifier(s) -> { assert equals(s, "a"), "expected inner left 'a'"; }
                    _ -> { panic("expected Identifier 'a'"); }
                  }
                  fit ie.right.kind {
                    .Identifier(s) -> { assert equals(s, "b"), "expected inner right 'b'"; }
                    _ -> { panic("expected Identifier 'b'"); }
                  }
                }
                _ -> { panic("expected the grouped contents to be an Expression"); }
              }
            }
            _ -> { panic("expected the outer left to stay an ExpressionParenthesis"); }
          }
        }
        _ -> { panic("expected an Expression condition"); }
      }
    }
    _ -> { panic("expected a StatementIf node"); }
  }
}

