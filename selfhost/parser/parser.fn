test "parse_fit_statement parses literal patterns with a default branch" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("fit x { 1 -> { a; } _ -> { b; } }", names);
  Parser p = parser_new(&st);
  assert p.parse_fit_statement().is_none(), "expected the fit statement to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFit(f) -> {
      assert f.branches.len == 2, "expected 2 branches";
      assert f.has_default_branch, "expected a default branch";
      fit f.exp.kind {
        .Identifier(s) -> { assert equals(s, "x"), "expected fit condition 'x'"; }
        _ -> { panic("expected Identifier 'x' as the fit condition"); }
      }
      let first = f.branches.get(0);
      assert first.has_condition, "expected the first branch to have a condition";
      fit first.condition.kind {
        .Number(_) -> {}
        _ -> { panic("expected a Number condition for the first branch"); }
      }
      let last = f.branches.get(1);
      assert !last.has_condition, "expected the default branch to have no condition";
    }
    _ -> { panic("expected a StatementFit node"); }
  }
}

test "parse_fit_statement parses bare enum-variant shorthand patterns" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  names.push("a");
  names.push("b");
  ParseState st = _state_with_declared("fit x { .A -> { a; } .B -> { b; } }", names);
  Parser p = parser_new(&st);
  assert p.parse_fit_statement().is_none(), "expected the fit statement to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFit(f) -> {
      assert f.branches.len == 2, "expected 2 branches";
      assert !f.has_default_branch, "expected no default branch";
      let first = f.branches.get(0);
      assert first.has_condition, "expected the first branch to have a condition";
      fit first.condition.kind {
        .Expression(e) -> {
          assert equals(e.op, "."), "expected op '.'";
          fit e.left.kind {
            .Blank -> {}
            _ -> { panic("expected a Blank left side (no explicit enum name)"); }
          }
          fit e.right.kind {
            .Identifier(s) -> { assert equals(s, "A"), "expected variant name 'A'"; }
            _ -> { panic("expected Identifier 'A'"); }
          }
        }
        _ -> { panic("expected an Expression node for the '.' shorthand pattern"); }
      }
    }
    _ -> { panic("expected a StatementFit node"); }
  }
}

test "parse_fit_statement parses a shorthand destructuring pattern, binding names in the arm body" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared("fit x { .Circle(r) -> { r; } }", names);
  Parser p = parser_new(&st);
  assert p.parse_fit_statement().is_none(), "expected the destructuring fit statement to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFit(f) -> {
      assert f.branches.len == 1, "expected 1 branch";
      let first = f.branches.get(0);
      assert first.has_condition, "expected a condition";
      assert first.has_bindings, "expected bindings";
      assert first.bindings.len == 1, "expected 1 binding";
      assert equals(first.bindings.get(0), "r"), "expected binding 'r'";
      fit first.condition.kind {
        .Expression(e) -> {
          assert equals(e.op, "."), "expected op '.'";
          fit e.left.kind {
            .Blank -> {}
            _ -> { panic("expected a Blank left side (shorthand -- no explicit enum name)"); }
          }
          fit e.right.kind {
            .Identifier(s) -> { assert equals(s, "Circle"), "expected variant name 'Circle'"; }
            _ -> { panic("expected Identifier 'Circle'"); }
          }
        }
        _ -> { panic("expected an Expression node for the destructuring pattern"); }
      }
      fit first.body.kind {
        .Body(bn) -> {
          assert bn.statements.len == 1, "expected 1 statement in the body (referencing 'r')";
        }
        _ -> { panic("expected a Body node"); }
      }
    }
    _ -> { panic("expected a StatementFit node"); }
  }
}

test "parse_fit_statement parses a qualified destructuring pattern with multiple bindings" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared("fit x { Shape.Rect(w, h) -> { w; h; } }", names);
  Parser p = parser_new(&st);
  assert p.parse_fit_statement().is_none(), "expected the qualified destructuring fit statement to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFit(f) -> {
      let first = f.branches.get(0);
      assert first.bindings.len == 2, "expected 2 bindings";
      assert equals(first.bindings.get(0), "w"), "expected binding 'w'";
      assert equals(first.bindings.get(1), "h"), "expected binding 'h'";
      fit first.condition.kind {
        .Expression(e) -> {
          fit e.left.kind {
            .Identifier(s) -> { assert equals(s, "Shape"), "expected enum name 'Shape'"; }
            _ -> { panic("expected Identifier 'Shape' (qualified -- explicit enum name)"); }
          }
          fit e.right.kind {
            .Identifier(s) -> { assert equals(s, "Rect"), "expected variant name 'Rect'"; }
            _ -> { panic("expected Identifier 'Rect'"); }
          }
        }
        _ -> { panic("expected an Expression node for the destructuring pattern"); }
      }
    }
    _ -> { panic("expected a StatementFit node"); }
  }
}

test "parse_fit_statement's destructuring bindings don't leak into a sibling arm" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared("fit x { .Circle(r) -> { r; } .Square -> { r; } }", names);
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_fit_statement();
  assert err.is_some(), "expected an error: 'r' should not be visible outside the arm that bound it";
}

test "parse_fit_statement rejects an empty destructuring pattern '()'" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared("fit x { .Circle() -> { } }", names);
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_fit_statement();
  assert err.is_some(), "expected an error for a destructuring pattern binding zero fields";
}

test "parse_fit_statement rejects a non-identifier destructuring binding" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  ParseState st = _state_with_declared("fit x { .Circle(1) -> { } }", names);
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_fit_statement();
  assert err.is_some(), "expected an error for a non-identifier binding name";
}

test "parse_fit_statement rejects an assignment used as a branch pattern" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  names.push("a");
  ParseState st = _state_with_declared("fit x { a = 1 -> { } }", names);
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  let err = p.parse_fit_statement();
  assert err.is_some(), "expected an error for an assignment used as a fit pattern";
}

test "parse_statement dispatches 'fit' to parse_fit_statement" {
  Vec<str> names;
  names.init(0);
  names.push("x");
  names.push("a");
  ParseState st = _state_with_declared("fit x { _ -> { a; } }", names);
  Parser p = parser_new(&st);
  assert p.parse_statement().is_none(), "expected parse_statement to dispatch 'fit'";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .StatementFit(f) -> {
      assert f.has_default_branch, "expected the default branch to be recorded";
    }
    _ -> { panic("expected a StatementFit node"); }
  }
}

// The lookup name a new scope entity for `node` should carry; empty for a
// node kind that never introduces a nameable binding.
fun _scope_entity_name(Node* node) str {
  fit node.kind {
    .Identifier(s) -> { ret s; }
    .Function(f) -> { ret f.name; }
    .Variable(v) -> { ret v.name; }
    _ -> { ret ""; }
  }
}

// True if `t` is an operator token consisting entirely of `.` characters
// (`.`, `..`, or `...` -- the only all-dot operator tokens the lexer can
// produce). Used by `parse_import` to detect path-segment separators and
// leading `..` parent-directory markers, as opposed to any other
// operator.
fun _is_dot_run_operator(Token t) bin {
  if t.type != TokenType.Operator {
    ret false;
  }
  str s = "";
  fit t.data {
    .Sval(sv) -> { s = sv; }
    _ -> { ret false; }
  }
  ret equals(s, ".") || equals(s, "..") || equals(s, "...");
}

// Builds the mangled, flat name for `dt` used to key generic
// instantiations and concrete quirk-binding identities (`Vec<num>` ->
// `Vec__num`, `Box<Node*>` -> `Box__Node_ptr1`) -- mirrors codegen's
// identical mangling scheme so both agree on the same name.
fun _mangled_dtype_name(DataType* dt) str {
  ret _mangled_dtype_name_depth(dt, 0);
}

fun _mangled_dtype_name_depth(DataType* dt, num depth) str {
  str result = dt.type_str;
  // A generic ARG's pointer depth is part of its mangled identity
  // (`Box<Node>` and `Box<Node*>` are distinct instantiations) -- but
  // only at nested (arg) depth, never the outer/top-level name.
  if depth > 0 && dt.pointer_depth > 0 {
    result = format("{str}_ptr{num}", result, dt.pointer_depth);
  }
  Vec<DataType*> gargs = dt.generic_args;
  for ga : gargs {
    result = format("{str}__{str}", result, _mangled_dtype_name_depth(ga, depth + 1));
  }
  ret result;
}

// True if `dt` (or any of its nested generic args) references one of
// `params` by bare name -- distinguishes a SYMBOLIC quirk binding
// (`impl VecIter<T> as Iterator<T>`, where the quirk's arg IS the
// enclosing impl's own type param, handled by the impl's existing
// generic-instantiation machinery) from a CONCRETE one (`impl Point as
// To<num>`, a distinct quirk identity that needs its own mangled name to
// dispatch correctly).
fun _dtype_references_any_param(DataType* dt, Vec<str> params) bin {
  if dt.kind == DataTypeType.Unknown && len(dt.type_str) > 0 {
    for p : params {
      if equals(p, dt.type_str) {
        ret true;
      }
    }
  }
  Vec<DataType*> gargs = dt.generic_args;
  for ga : gargs {
    if _dtype_references_any_param(ga, params) {
      ret true;
    }
  }
  ret false;
}

// True if `name` looks like a C preprocessor macro constant
// (`SCREAMING_SNAKE_CASE`): starts with an uppercase letter or `_`, and
// every character is an uppercase letter, digit, or `_`. Such identifiers
// are accepted as expression operands even when undeclared, since a
// program using `std.c.*` bindings routinely references real macro
// constants (`INT_MAX`, `O_RDONLY`, ...) that this compiler never sees a
// declaration for.
fun _is_c_macro_ident(str name) bin {
  if len(name) == 0 {
    ret false;
  }
  chr first = name[0];
  if !((first >= 'A' && first <= 'Z') || first == '_') {
    ret false;
  }
  num i = 0;
  for i < len(name) {
    chr c = name[i];
    bin is_upper = c >= 'A' && c <= 'Z';
    bin is_digit_c = c >= '0' && c <= '9';
    if !(is_upper || is_digit_c || c == '_') {
      ret false;
    }
    i = i + 1;
  }
  ret true;
}

// True if `n`'s kind is `Expression` (a binary op node) -- used by the
// precedence-reordering functions to decide whether a child needs further
// rotation, as opposed to being an already-primary operand (a literal,
// identifier, or grouped sub-expression).
fun _is_expression_kind(Node* n) bin {
  fit n.kind {
    .Expression(e) -> { ret true; }
    _ -> { ret false; }
  }
}
