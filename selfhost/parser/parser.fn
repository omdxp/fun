test "parse_expressionable_root parses a prefix unary expression" {
  Vec<str> names;
  names.init(0);
  names.push("a");
  ParseState st = _state_with_declared("-a", names);
  Parser p = parser_new(&st);
  assert p.parse_expressionable_root().is_none(), "expected '-a' to parse";
  let top = st.nodes.get(st.nodes.len - 1);
  fit top.kind {
    .Unary(u) -> {
      assert equals(u.op, "-"), "expected op '-'";
      assert !u.is_left_operanded_unary, "expected a prefix (not postfix) unary";
      assert !u.has_indirection, "expected no indirection info for a plain '-'";
      fit u.operand.kind {
        .Identifier(s) -> { assert equals(s, "a"), "expected operand 'a'"; }
        _ -> { panic("expected Identifier 'a'"); }
      }
    }
    _ -> { panic("expected a Unary node"); }
  }
}

