// Language server cases: what a message on the wire is turned into.

imp ..fls.protocol;
imp ..fls.positions;
imp ..fls.symbols;
imp ..fls.navigation;
imp ..fls.outline;
imp ..fls.references;
imp ..fls.completion;
imp ..fls.documents;
imp ..lexer.lexer;
imp ..lexer.token;
imp ..parser.import_resolver;
imp std.vec;
imp std.option;
imp std.result;
imp std.string;
imp std.io;
imp std.fs;

test "a string is written with what JSON reserves escaped" {
  assert equals(json_quote("plain"), `"plain"`), "expected a plain string to be quoted";
  assert equals(json_quote(`say "hi"`), `"say \"hi\""`), "expected the quotes to be escaped";
  assert equals(json_quote("a\nb"), `"a\nb"`), "expected the newline to be escaped";
  assert equals(json_quote("a\\b"), `"a\\b"`), "expected the backslash to be escaped";
}

test "a header name is read whatever case it is written in" {
  assert starts_with_ignore_case("Content-Length: 5", "content-length:"), "expected the header to be recognized";
  assert starts_with_ignore_case("content-length: 5", "Content-Length:"), "expected either case to match";
  assert !starts_with_ignore_case("Content-Type: x", "content-length:"), "expected a different header not to match";
}

test "a reply carries the id it answers" {
  assert contains(response("1", "null"), `"id":1`), "expected a numeric id to be echoed";
  assert contains(response(`"abc"`, "null"), `"id":"abc"`), "expected a string id to be echoed";
  assert contains(response("1", `{"ok":true}`), `"result":{"ok":true}`), "expected the result to be carried";
}

test "a refusal names what could not be done" {
  str refusal = error_response("2", -32601, "unsupported request 'x'");
  assert contains(refusal, `"code":-32601`), "expected the code";
  assert contains(refusal, "unsupported request"), "expected the message";
  assert contains(refusal, `"id":2`), "expected the id";
}

test "a notification carries no id" {
  str note = notification("textDocument/publishDiagnostics", `{"uri":"file:///a.fn"}`);
  assert contains(note, `"method":"textDocument/publishDiagnostics"`), "expected the method";
  assert !contains(note, `"id"`), "expected no id on a notification";
}

test "a sink reads a line and then the bytes that follow it" {
  make_dir_all("fun-out");
  str path = "fun-out/_sink_read.txt";
  write_string(path, "Content-Length: 5\r\n\r\nhello");
  defer remove_file(path);

  File f = open_read(path);
  Sink source = Sink.File(f);
  defer f.close();

  str header = source.read_line_max(64);
  assert equals(trim(header), "Content-Length: 5"), "expected the header line";
  str blank = source.read_line_max(64);
  assert equals(trim(blank), ""), "expected the blank line ending the headers";
  str body = source.read_bytes(5);
  assert equals(body, "hello"), "expected exactly the bytes the header named";
}

test "a number is written as hexadecimal, padded to a width" {
  assert equals(to_hex(0, 4), "0000"), "expected zero padded to the width";
  assert equals(to_hex(255, 2), "ff"), "expected the lower-case digits";
  assert equals(to_hex_upper(255, 2), "FF"), "expected the upper-case digits";
  assert equals(to_hex(10, 4), "000a"), "expected the padding to fill";
  assert equals(to_hex(4096, 4), "1000"), "expected a value filling the width";
  assert equals(to_hex(65536, 4), "10000"), "expected a wider value to keep its digits";
}

test "a position lands on the token the cursor is in" {
  let lexed = tokenize("fun main() num {\n  num total = 1;\n  ret total;\n}\n", "pos.fn");
  assert lexed.is_ok(), "expected the source to lex";
  Vec<Token> tokens = lexed.unwrap();
  defer tokens.free();

  // Line and character are both counted from zero on the wire.
  let on_name = token_at(&tokens, 1, 6);
  assert on_name.is_some(), "expected a token under the cursor";
  assert equals(token_text(on_name.unwrap()), "total"), "expected the name being declared";

  // The last character of a token still counts as being on it, which is
  // where a cursor rests inside a word.
  let at_end = token_at(&tokens, 1, 10);
  assert at_end.is_some(), "expected the cursor at a token's last character to land on it";
  assert equals(token_text(at_end.unwrap()), "total"), "expected the same name";

  // Whitespace belongs to no token.
  assert token_at(&tokens, 1, 11).is_none(), "expected nothing under a space";
}

test "a pointer type keeps its star when spelled back" {
  str src = `compound Holder {
  `  Vec<str>* data;
  `  num len;
  `}
  `fun probe(Holder* h, num len) num { ret len; }`;
  let merged = parse_program_with_source("hover.fn", src);
  assert merged.is_ok(), "expected the program to parse";
  ProgramMergeResult program = merged.unwrap();

  // A field declared as a pointer is reported as one: the old server
  // dropped the star here.
  let field = lookup_field(&program.nodes, "Holder", "data");
  assert field.is_some(), "expected the field to resolve";
  assert equals(field.unwrap().detail, "Vec<str>* data"), "expected the pointer spelling kept";
}

test "a local name wins over a function of the same name" {
  str src = `compound Holder {
  `  num len;
  `}
  `fun probe(Holder* h, num len) num { ret len; }`;
  let merged = parse_program_with_source("hover.fn", src);
  assert merged.is_ok(), "expected the program to parse";
  ProgramMergeResult program = merged.unwrap();

  // `len` is a parameter here, not the standard library's function, and
  // resolving from the inside out is what tells them apart.
  let found = lookup(&program.nodes, "len", "hover.fn", 4);
  assert found.is_some(), "expected the name to resolve";
  assert equals(found.unwrap().detail, "num len"), "expected the parameter, not a function";
}

test "a function is spelled back as its signature" {
  str src = `fun probe(str name, num count) bin { ret true; }`;
  let merged = parse_program_with_source("sig.fn", src);
  assert merged.is_ok(), "expected the program to parse";
  ProgramMergeResult program = merged.unwrap();

  let found = lookup_top_level(&program.nodes, "probe");
  assert found.is_some(), "expected the function to resolve";
  assert equals(found.unwrap().detail, "fun probe(str name, num count) bin"), "expected the whole signature";
}

test "a keyword carries documentation, and an ordinary word does not" {
  assert !equals(keyword_doc("fit"), ""), "expected fit to be documented";
  assert contains(keyword_doc("fit"), "```fun"), "expected a fenced example";
  assert equals(keyword_doc("total"), ""), "expected no documentation for an ordinary name";
}

test "an outline lists what a file declares, by kind" {
  str src = `pub const num LIMIT = 8;
  `pub compound Buffer {
  `  num len;
  `}
  `pub enum Mode {
  `  Fast,
  `}
  `impl Buffer {
  `  pub clear() { self.len = 0; }
  `}
  `fun helper() num { ret 1; }`;
  Document doc;
  doc.uri = "file:///outline.fn";
  doc.path = "outline.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(doc);
  // The protocol's own numbering: 14 constant, 23 struct, 10 enum,
  // 22 enum member, 6 method, 12 function.
  assert contains(out, `"name":"LIMIT","kind":14`), "expected the constant";
  assert contains(out, `"name":"Buffer","kind":23`), "expected the compound";
  assert contains(out, `"name":"Mode","kind":10`), "expected the enum";
  assert contains(out, `"name":"Fast","kind":22`), "expected the variant";
  assert contains(out, `"name":"helper","kind":12`), "expected the function";
}

test "a method is listed under the name it was written as" {
  str src = `compound Buffer {
  `  num len;
  `}
  `impl Buffer {
  `  pub clear() { self.len = 0; }
  `}`;
  Document doc;
  doc.uri = "file:///method.fn";
  doc.path = "method.fn";
  doc.text = src;
  doc.version = 1;

  str out = document_symbols(doc);
  // A method is stored mangled, as `Buffer__clear`; an outline shows the
  // name in the source, with the type beside it.
  assert contains(out, `"name":"clear","kind":6`), "expected the written name";
  assert !contains(out, "Buffer__clear"), "expected the mangling not to reach the client";
  assert contains(out, `"containerName":"Buffer"`), "expected the type it belongs to";
}

test "an outline carries a location a client can jump to" {
  str src = `fun helper() num { ret 1; }`;
  Document doc;
  doc.uri = "file:///loc.fn";
  doc.path = "loc.fn";
  doc.text = src;
  doc.version = 1;

  // The flat form of the reply is what the protocol reads by default,
  // and every entry in it carries its own location.
  str out = document_symbols(doc);
  assert contains(out, `"location"`), "expected a location on the entry";
  assert contains(out, `"uri":"file:///loc.fn"`), "expected the document's own uri";
}

test "a rename is refused when the new name is not one" {
  assert is_identifier("total"), "expected an ordinary name";
  assert is_identifier("_private"), "expected a leading underscore to be allowed";
  assert is_identifier("v2"), "expected digits after the first character";
  assert !is_identifier(""), "expected nothing to be rejected";
  assert !is_identifier("9bad"), "expected a leading digit to be rejected";
  assert !is_identifier("has space"), "expected a space to be rejected";
  assert !is_identifier("has-dash"), "expected punctuation to be rejected";
}

test "every place a name is written is found, and renamed together" {
  str src = `fun helper(num total) num {
  `  ret total + total;
  `}`;
  Documents docs = documents_new();
  defer docs.free();
  docs.opened("file:///ref.fn", src, 1);
  let held = docs.at("file:///ref.fn");
  assert held.is_some(), "expected the document to be held";
  Document doc = held.unwrap();

  // `total` is written three times: the parameter and its two uses.
  str found = references(&docs, doc, 1, 6);
  assert count(found, `"uri"`) == 3, "expected every occurrence";

  str edit = rename_symbol(&docs, doc, 1, 6, "count");
  assert count(edit, `"newText":"count"`) == 3, "expected every occurrence renamed";
  assert contains(edit, `"changes"`), "expected the edit grouped by document";

  // A name a reader could not have written is refused outright.
  assert equals(rename_symbol(&docs, doc, 1, 6, "9bad"), "null"), "expected the rename refused";
}

test "completion after a dot offers what the receiver has" {
  str src = `compound Buffer {
  `  num len;
  `}
  `impl Buffer {
  `  pub clear() { self.len = 0; }
  `}
  `fun helper(Buffer b) num {
  `  num x = b.len;
  `  ret x;
  `}`;
  Document doc;
  doc.uri = "file:///cmp.fn";
  doc.path = "cmp.fn";
  doc.text = src;
  doc.version = 1;

  // Right after `b.` on the line that reads it.
  str out = completion(doc, 7, 12);
  assert contains(out, `"label":"len","kind":5`), "expected the field";
  assert contains(out, `"label":"clear","kind":2`), "expected the method, unmangled";
  assert !contains(out, `"label":"ret"`), "expected no reserved words after a dot";
}

test "completion still answers while the text does not parse" {
  // What a reader is typing is half-written by definition, so a failed
  // parse must not turn into an empty reply.
  str src = `fun helper(num total) num {
  `  tot
  `}`;
  Document doc;
  doc.uri = "file:///half.fn";
  doc.path = "half.fn";
  doc.text = src;
  doc.version = 1;

  str out = completion(doc, 1, 5);
  assert contains(out, `"label":"ret"`), "expected the reserved words";
  assert contains(out, `"label":"total"`), "expected a name already written in the file";
}
