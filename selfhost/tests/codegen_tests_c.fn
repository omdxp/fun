// `impl C as QC { gv() num { ret self.val; } }
// `compound B { C c; }
// `quirk QB { to_c() QC; }
// `impl B as QB { to_c() QC { ret &self.c; } }
// `compound A { B b; }
// `quirk QA { to_b() QB; }
// `impl A as QA { to_b() QB { ret &self.b; } }
// `fun main() num {
// `  A a; a.b.c.val = 123; QA qa = &a;
// `  printf("%lld\n", qa.to_b().to_c().gv());
// `  ret 0;
// `}`;
// let out = emit_c(src, "ra3: deep method chains");
// assert contains(out, "A__QA__to_b"), "expected the outermost quirk method";
// }

test "ra3: deep method chains (generic-method chain)" {
  str src = `imp std.c.io;
  `compound Box<T> { T value; }
  `impl Box<T> { pub get() T { ret self.value; } pub with(T x) Box<T> { ret Box<T>{value = x}; } }
  `fun main() num {
  `  let bx = Box<num>{value = 10};
  `  printf("%lld\n", bx.with(99).get());
  `  ret 0;
  `}`;
  let out = emit_c(src, "ra3: deep method chains (generic-method chain)");
  assert contains(out, "Box__num__with"), "expected the monomorphized generic method";
  assert contains(out, "Box__num__get"), "expected the chained method on its result";
}

test "ra3: quirk coercion of deref, parenthesized address-of, and pointer-field" {
  str src = `imp std.c.io;
  `compound Inner { num v; }
  `compound Outer { Inner* inner; }
  `quirk HasV { getV() num; }
  `impl Inner as HasV { getV() num { ret self.v; } }
  `fun extract(Outer* o) HasV { ret o.inner; }
  `fun main() num {
  `  Inner p = Inner{v = 55};
  `  Inner* pp = &p; Inner** ppp = &pp;
  `  HasV a = *ppp;
  `  HasV b = (&p);
  `  Inner i = Inner{v = 99};
  `  Outer o = Outer{inner = &i};
  `  printf("%lld %lld %lld\n", a.getV(), b.getV(), extract(&o).getV());
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "ra3: quirk coercion of deref, parenthesized address-of, and pointer-field"
  );
  assert contains(out, "Inner__HasV__getV"), "expected the quirk implementation";
  assert contains(out, "__fun_coerce_Inner_HasV"), "expected the coercion helper";
}

test "ra3: generic T[] param accepts a concrete array arg; extra pub method in as-Quirk impl callable" {
  str src = `imp std.c.io;
  `quirk Named { name() str; }
  `compound Box<T> { T[] data; num n; }
  `impl Box<T> { pub fill(T[] src, num c) { self.data = src; self.n = c; } pub at(num i) T { ret self.data[i]; } }
  `compound Dog { num age; }
  `impl Dog as Named { pub name() str { ret "rex"; } pub age_years() num { ret self.age; } }
  `fun main() num {
  `  Box<num> b;
  `  num[] arr = [10, 20, 30];
  `  b.fill(arr, 3);
  `  Dog d; d.age = 5;
  `  printf("%lld %lld\n", b.at(1), d.age_years());
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "ra3: generic T[] param accepts a concrete array arg; extra pub method in as-Quirk impl callable"
  );
  assert contains(out, "Box__num__fill"), "expected the monomorphized fill method";
  assert contains(out, "Dog__Named__age_years"), "expected the extra pub method in the as-Quirk impl";
}

test "P3: nil literal lowers to NULL and coerces to pointer/str" {
  str src = `imp std.c.io;
  `compound Node { num val; Node* next; }
  `fun main() num {
  `  num* p = nil;
  `  Node tail = Node{val = 2, next = nil};
  `  Node head = Node{val = 1, next = &tail};
  `  num isnil = 0; if p == nil { isnil = 1; }
  `  num sum = 0; Node* cur = &head;
  `  for cur != nil { sum = sum + cur.val; cur = cur.next; }
  `  printf("%lld %lld\n", isnil, sum);
  `  ret 0;
  `}`;
  let out = emit_c(src, "P3: nil literal lowers to NULL and coerces to pointer/str");
  assert contains(out, "NULL"), "expected nil to lower to the C null-pointer constant";
}

// The harness compiles a fixture on its own without resolving imports, so
// fixtures that need a channel declare a local stand-in rather than pulling
// in `std.channel`.
test "P3: fork spawns virtual threads onto the M:N scheduler" {
  str src = `imp std.c.io;
  `async fun worker(num v) { printf("%lld\n", v * 10); }
  `fun main() num {
  `  fork worker(1);
  `  fork worker(2);
  `  fork worker(3);
  `  ret 0;
  `}`;
  let out = emit_c(src, "P3: fork spawns virtual threads onto the M:N scheduler");
  assert contains(out, "__fun_go("), "expected the scheduler spawn call";
  assert contains(out, "__fun_fork_call_worker"), "expected the per-callee fork helper";
  assert contains(out, "__fun_sched_wait_idle"), "expected the main drain";
}

test "P3: channel operators ch <- v and <-ch desugar to send/recv" {
  str src = `imp std.c.io;
  `compound Channel<T> { T v; }
  `impl Channel<T> { pub send(T x) { self.v = x; } pub recv() T { ret self.v; } }
  `fun main() num {
  `  Channel<num> ch;
  `  ch <- 7;
  `  ch <- 3 + 4;
  `  let a = <-ch;
  `  num b = <-ch;
  `  printf("%lld %lld\n", a, b);
  `  ret 0;
  `}`;
  let out = emit_c(src, "P3: channel operators ch <- v and <-ch desugar to send/recv");
  assert contains(out, "Channel__num__send(&ch, 7)"), "expected the statement send to desugar";
  assert contains(out, "Channel__num__recv(&ch)"), "expected the recv to desugar";
}

test "P3: a <- b is a channel send, but x < -y stays a comparison (munch)" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num a = 5; num y = 3;
  `  bin lt = a < -y;
  `  bin gt = a > -y;
  `  printf("%d %d\n", lt, gt);
  `  ret 0;
  `}`;
  let out = emit_c(src, "P3: a <- b is a channel send, but x < -y stays a comparison (munch)");
  assert contains(out, "(-y)"), "expected the negation to survive as a unary minus";
  assert !contains(out, "send"), "expected no channel send to be produced";
}

test "fork target async fn is not flagged unused" {
  str src = `imp std.c.io;
  `compound Channel<T> { T v; }
  `impl Channel<T> { pub send(T x) { self.v = x; } pub recv() T { ret self.v; } }
  `async fun worker(Channel<num>* out, num v) {
  `  out <- v * v;
  `}
  `fun main() num {
  `  Channel<num> ch;
  `  fork worker(&ch, 5);
  `  num r = <- ch;
  `  printf("%lld\n", r);
  `  ret 0;
  `}`;
  let out = emit_c(src, "fork target async fn is not flagged unused");
  assert contains(out, "worker"), "expected the forked function to be emitted";
}

test "channel of a data-carrying enum, received and matched with fit" {
  str src = `imp std.c.io;
  `compound Channel<T> { T v; }
  `impl Channel<T> { pub send(T x) { self.v = x; } pub recv() T { ret self.v; } }
  `enum Msg { Compute(num), Result(num), Stop }
  `async fun worker(Channel<Msg>* inbox, Channel<Msg>* outbox) {
  `  fit <- inbox {
  `    Msg.Compute(v) -> { outbox <- Msg.Result(v * v); }
  `    Msg.Stop -> { outbox <- Msg.Stop; }
  `    _ -> {}
  `  }
  `}
  `fun main() num {
  `  Channel<Msg> inbox;
  `  Channel<Msg> outbox;
  `  fork worker(&inbox, &outbox);
  `  inbox <- Msg.Compute(6);
  `  fit <- outbox {
  `    Msg.Result(r) -> { printf("result=%lld\n", r); }
  `    _ -> { printf("other\n"); }
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(src, "channel of a data-carrying enum, received and matched with fit");
  assert contains(out, "Channel__Msg"), "expected the channel to specialize on the enum";
  assert contains(out, "tag == Msg_Result"), "expected the fit to test the variant tag";
}

test "generic data enum: Option<num> construct, pass, fit, payload binding" {
  str src = `imp std.c.io;
  `enum Option<T> { Some(T), None }
  `fun describe(Option<num> o) num {
  `  fit o {
  `    Option.Some(v) -> { ret v; }
  `    Option.None -> { ret -1; }
  `  }
  `  ret -2;
  `}
  `fun main() num {
  `  Option<num> a = Option.Some(42);
  `  Option<num> b = .None;
  `  printf("%lld %lld\n", describe(a), describe(b));
  `  ret 0;
  `}`;
  let out = emit_c(src, "generic data enum: Option<num> construct, pass, fit, payload binding");
  assert contains(out, "Option__num"), "expected the monomorphized enum type";
}

test "generic data enum: Result<T, E> with two type params and mixed payloads" {
  str src = `imp std.c.io;
  `enum Res<T, E> { Ok(T), Err(E) }
  `fun main() num {
  `  Res<num, str> a = Res.Ok(7);
  `  Res<num, str> b = Res.Err("boom");
  `  fit a {
  `    Res.Ok(v) -> { printf("ok %lld\n", v); }
  `    Res.Err(e) -> { printf("err %s\n", e); }
  `  }
  `  fit b {
  `    Res.Ok(v) -> { printf("ok %lld\n", v); }
  `    Res.Err(e) -> { printf("err %s\n", e); }
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(src, "generic data enum: Result<T, E> with two type params and mixed payloads");
  assert contains(out, "Res__num__str"), "expected the two-parameter monomorphization";
}

// gap: a `fit` whose subject is a call expression returning a generic enum is
// rejected as an unsupported node. Binding the result to a local first works.
// test "generic fn returning a generic enum monomorphizes the enum type (regression)" {
// str src = `imp std.c.io;
// `enum RR<T> { Ok(T), Closed, Error(num) }
// `fun wrap<T>(num rc, T value) RR<T> {
// `  if rc == 0 { ret RR.Ok(value); }
// `  ret RR.Error(rc);
// `}
// `fun main() num {
// `  fit wrap(0, 42) {
// `    RR.Ok(v) -> { printf("ok %lld\n", v); }
// `    RR.Closed -> { printf("closed\n"); }
// `    RR.Error(e) -> { printf("err %lld\n", e); }
// `  }
// `  ret 0;
// `}`;
// let out = emit_c(src, "generic fn returning a generic enum monomorphizes the enum type");
// assert contains(out, "RR__num"), "expected the monomorphized enum typedef";
// }

test "generic fn returning a generic enum monomorphizes the enum type via a local" {
  str src = `imp std.c.io;
  `enum RR<T> { Ok(T), Closed, Error(num) }
  `fun wrap<T>(num rc, T value) RR<T> {
  `  if rc == 0 { ret RR.Ok(value); }
  `  ret RR.Error(rc);
  `}
  `fun main() num {
  `  RR<num> r = wrap(0, 42);
  `  fit r {
  `    RR.Ok(v) -> { printf("ok %lld\n", v); }
  `    RR.Closed -> { printf("closed\n"); }
  `    RR.Error(e) -> { printf("err %lld\n", e); }
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "generic fn returning a generic enum monomorphizes the enum type via a local"
  );
  assert contains(out, "RR__num"), "expected the monomorphized enum typedef";
}

test "default parameter values: free fn, method, multi-default, explicit override" {
  str src = `imp std.c.io;
  `fun three(num a, num b = 2, num c = 3) num { ret a * 100 + b * 10 + c; }
  `compound Box { num v; }
  `impl Box {
  `  pub add(num x, num y = 100) num { ret self.v + x + y; }
  `}
  `fun main() num {
  `  printf("%lld %lld %lld\n", three(1), three(1, 5), three(1, 5, 9));
  `  Box b; b.v = 1000;
  `  printf("%lld %lld\n", b.add(1), b.add(1, 1));
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "default parameter values: free fn, method, multi-default, explicit override"
  );
  assert !contains(out, "= 2)"), "expected the C signature to carry no default";
  assert contains(out, "three(1, 2, 3)"), "expected both defaults filled at the call site";
  assert contains(out, "three(1, 5, 3)"), "expected only the trailing default filled";
  assert contains(out, "Box__add(&b, 1, 100)"), "expected a method default to be filled";
}

