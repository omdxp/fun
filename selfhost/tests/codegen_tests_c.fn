// Compiler test corpus, batch C. Each test states its input as source text
// and checks the emitted C. Ported from the `tests/` suite so the same
// expectations run against this compiler.

imp harness;
imp std.string;

test "ra3: no crash on field access of a generic-impl method returning a compound" {
  str src = `imp std.c.io;
  `compound Inner { num code; }
  `compound Box<T> { T v; }
  `impl Box<T> { get_inner() Inner { Inner i; i.code = 42; ret i; } }
  `fun main() num { Box<num> b; printf("%lld\n", b.get_inner().code); ret 0; }`;
  let out = emit_c(
    src,
    "ra3: no crash on field access of a generic-impl method returning a compound"
  );
  assert contains(out, "Box__num"), "expected the monomorphized box type";
  assert contains(out, "get_inner"), "expected the method to be emitted";
}

// gap: chaining a method onto a quirk-returning quirk method result is
// rejected as an unsupported node.
// test "ra3: deep method chains (3-level quirk, fn-returns-generic, generic-method chain)" {
