test "default parameter rejected: default references self" {
  str src = `compound C { num cfg; }
  `impl C { pub poll(num slice = self.cfg) num { ret slice; } }
  `fun main() num { C c; c.cfg = 1; ret c.poll(); }`;
  let r = transpile_source(src);
  assert r.is_err(), "expected a self-referencing default to be rejected";
}

