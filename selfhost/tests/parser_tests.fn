// Parser corpus, ported from the `parser` suite. These run against the
// parser directly and inspect the resulting AST rather than emitted C.

imp ..ast.ast;
imp ..lexer.lexer;
imp ..lexer.token;
imp ..parser.parse_state;
imp ..parser.parser;
imp std.string;
imp std.vec;

// Lexes `src` into a parse state without parsing it.
fun state_from(str src) ParseState {
  ParseState st = parse_state_new("test.fn", src);
  let tr = tokenize(src, "test.fn");
  assert !tr.is_err(), "tokenize() returned an error";
  st.tokens = tr.unwrap();
  // Several tests drive expected-failure paths; keep stderr clean.
  st.emit_stderr = false;
  ret st;
}

// Lexes and parses `src`, aborting the test if either stage rejects it.
fun parse_ok(str src) ParseState {
  ParseState st = state_from(src);
  Parser p = parser_new(&st);
  assert p.parse().is_none(), "expected the source to parse";
  ret st;
}

// True when `src` is rejected by the lexer or the parser.
fun parse_fails(str src) bin {
  ParseState st = parse_state_new("test.fn", src);
  let tr = tokenize(src, "test.fn");
  if tr.is_err() {
    ret true;
  }
  st.tokens = tr.unwrap();
  st.emit_stderr = false;
  Parser p = parser_new(&st);
  ret p.parse().is_some();
}

// Returns the statement list of a function node's body.
fun fn_body_statements(Node fn_node) Vec<Node*> {
  fit fn_node.kind {
    .Function(f) -> {
      assert f.has_body, "expected the function to have a body";
      fit f.body.kind {
        .Body(b) -> { ret b.statements; }
        _ -> { panic("expected a Body node"); }
      }
    }
    _ -> { panic("expected a Function node"); }
  }
  Vec<Node*> empty;
  empty.init(0);
  ret empty;
}

test "parses a function declaration" {
  let st = parse_ok("fun sample() { ret; }");
  assert st.nodes.len == 1, "expected a single top-level node";
  fit st.nodes.get(0).kind {
    .Function(f) -> { assert equals(f.name, "sample"), "expected the declared name"; }
    _ -> { panic("expected a Function node"); }
  }
}

test "parses an async function declaration" {
  let st = parse_ok("async fun sample() { ret; }");
  assert st.nodes.len == 1, "expected a single top-level node";
  fit st.nodes.get(0).kind {
    .Function(f) -> { assert f.is_async, "expected the async flag"; }
    _ -> { panic("expected a Function node"); }
  }
}

test "parses an async impl method" {
  str src = `compound Counter { num base; }
  `impl Counter {
  `  async add(num x) num { ret self.base + x; }
  `}`;
  let st = parse_ok(src);
  assert st.nodes.len == 2, "expected the compound and the impl";
  fit st.nodes.get(0).kind {
    .Compound(_) -> {}
    _ -> { panic("expected a Compound node first"); }
  }
  fit st.nodes.get(1).kind {
    .Impl(im) -> {
      assert im.methods.len == 1, "expected one method";
      let m0 = im.methods.get(0);
      fit m0.kind {
        .Function(f) -> { assert f.is_async, "expected the method's async flag"; }
        _ -> { panic("expected the method to be a Function node"); }
      }
    }
    _ -> { panic("expected an Impl node second"); }
  }
}

test "parses an async quirk method signature" {
  str src = `quirk AsyncQ {
  `  async get() num;
  `}`;
  let st = parse_ok(src);
  assert st.nodes.len == 1, "expected a single top-level node";
  fit st.nodes.get(0).kind {
    .Quirk(q) -> {
      assert q.methods.len == 1, "expected one method signature";
      let q0 = q.methods.get(0);
      assert q0.is_async, "expected the signature's async flag";
    }
    _ -> { panic("expected a Quirk node"); }
  }
}

test "parses an await expression" {
  str src = `fun inc(num x) num { ret x + 1; }
  `fun main() {
  `  num y = await inc(41);
  `  ret y;
  `}`;
  let st = parse_ok(src);
  assert st.nodes.len == 2, "expected two functions";
  let stmts = fn_body_statements(st.nodes.get(1));
  assert stmts.len >= 1, "expected at least one statement in main";
  let s0 = stmts.get(0);
  fit s0.kind {
    .Variable(v) -> {
      assert v.has_val, "expected an initializer";
      fit v.val.kind {
        .Unary(u) -> {
          assert equals(u.op, "await"), "expected an await unary";
          fit u.operand.kind {
            .Expression(e) -> {
              assert equals(e.op, "()"), "expected the awaited operand to be a call";
            }
            _ -> { panic("expected the awaited operand to be an Expression"); }
          }
        }
        _ -> { panic("expected the initializer to be a Unary node"); }
      }
    }
    _ -> { panic("expected a Variable statement"); }
  }
}

test "parses a variadic function declaration" {
  let st = parse_ok("fun v(num a, ...) num;");
  assert st.nodes.len == 1, "expected a single top-level node";
  fit st.nodes.get(0).kind {
    .Function(f) -> { assert f.is_variadic, "expected the variadic flag"; }
    _ -> { panic("expected a Function node"); }
  }
}

test "parses a return statement" {
  let st = parse_ok("ret 42;");
  assert st.nodes.len == 1, "expected a single top-level node";
  fit st.nodes.get(0).kind {
    .StatementReturn(_) -> {}
    _ -> { panic("expected a StatementReturn node"); }
  }
}

