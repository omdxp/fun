test "distinguishes an array literal from an index expression" {
  str src = `fun main() {
  `  num[] arr = [1, 2, 3];
  `  num x = arr[0];
  `}`;
  let st = parse_ok(src);
  assert st.nodes.len == 1, "expected a single function";
  let stmts = fn_body_statements(st.nodes.get(0));
  assert stmts.len >= 2, "expected both declarations";
  let s0 = stmts.get(0);
  fit s0.kind {
    .Variable(v) -> {
      assert v.has_val, "expected an initializer";
      fit v.val.kind {
        .Bracket(_) -> {}
        _ -> { panic("expected the array literal to be a Bracket node"); }
      }
    }
    _ -> { panic("expected a Variable statement"); }
  }
  let s1 = stmts.get(1);
  fit s1.kind {
    .Variable(v) -> {
      assert v.has_val, "expected an initializer";
      fit v.val.kind {
        .Expression(e) -> { assert equals(e.op, "[]"), "expected an index expression"; }
        _ -> { panic("expected the index to be an Expression node"); }
      }
    }
    _ -> { panic("expected a Variable statement"); }
  }
}

test "parses an if condition with the == operator" {
  str src = `fun main() {
  `  num n = 0;
  `  if n == 0 { ret; }
  `}`;
  let st = parse_ok(src);
  let stmts = fn_body_statements(st.nodes.get(0));
  assert stmts.len >= 2, "expected the declaration and the if";
  let s1 = stmts.get(1);
  fit s1.kind {
    .StatementIf(ifn) -> {
      fit ifn.condition.kind {
        .Expression(e) -> { assert equals(e.op, "=="), "expected an equality condition"; }
        _ -> { panic("expected the condition to be an Expression node"); }
      }
    }
    _ -> { panic("expected a StatementIf node"); }
  }
}

test "reports an error on a missing semicolon without crashing" {
  str src = `fun main() {
  `  num x = 1
  `  ret;
  `}`;
  assert parse_fails(src), "expected a parse error";
}

test "reports an error on a malformed dot without crashing" {
  str src = `imp std.;
  `fun main() {
  `  ret;
  `}`;
  assert parse_fails(src), "expected a parse error";
}

test "reports an error on a malformed binary right-hand side without crashing" {
  str src = `fun main() {
  `  num x = 1 + ;
  `  ret;
  `}`;
  assert parse_fails(src), "expected a parse error";
}

test "reports an error on a malformed fit dot branch without crashing" {
  str src = `fun main() {
  `  num x = 1;
  `  fit x {
  `    . -> { ret; },
  `  }
  `}`;
  assert parse_fails(src), "expected a parse error";
}

// Reference forward scan for the n-th significant token at or after `start`.
fun ref_peek_n(Vec<Token> toks, num start, num n) Option<Token> {
  num idx = start;
  num seen = 0;
  for idx < toks.len {
    let t = toks.get(idx);
    if !token_is_nl_or_comment_or_newline_separator(t) {
      if seen == n {
        ret .Some(t);
      }
      seen = seen + 1;
    }
    idx = idx + 1;
  }
  ret .None;
}

// Reference backward scan for the n-th significant token, starting at
// `exclusive_end - 1` and walking down.
fun ref_prev_n(Vec<Token> toks, num exclusive_end, num n) Option<Token> {
  num idx = exclusive_end - 1;
  num seen = 0;
  for idx >= 0 {
    if idx < toks.len {
      let t = toks.get(idx);
      if !token_is_nl_or_comment_or_newline_separator(t) {
        if seen == n {
          ret .Some(t);
        }
        seen = seen + 1;
      }
    }
    idx = idx - 1;
  }
  ret .None;
}

// Two tokens are the same token when their kind and source position agree;
// a position uniquely identifies a token within one lexed stream.
fun same_token(Option<Token> a, Option<Token> b) bin {
  if a.is_none() && b.is_none() {
    ret true;
  }
  if a.is_none() || b.is_none() {
    ret false;
  }
  let ta = a.unwrap();
  let tb = b.unwrap();
  if ta.type != tb.type {
    ret false;
  }
  if ta.pos.line != tb.pos.line {
    ret false;
  }
  if ta.pos.col != tb.pos.col {
    ret false;
  }
  ret ta.pos.start_col == tb.pos.start_col;
}

test "lookahead: token_peek_n matches a linear scan at every cursor and offset" {
  str src = `// leading comment
  `compound Box<T> {
  `  // a field
  `  T value;
  `
  `
  `  num count;
  `}
  `fun main() {
  `  Box<num> b; // trailing
  `  num x = 1 + 2 * 3;
  `  ret;
  `}`;
  ParseState st = state_from(src);
  num total = st.tokens.len;
  assert total > 0, "expected a non-empty token stream";

  num cursor = 0;
  for cursor <= total {
    st.pindex = cursor;
    num n = 0;
    for n <= total {
      let fast = st.token_peek_n(n);
      let slow = ref_peek_n(st.tokens, cursor, n);
      assert same_token(fast, slow), "token_peek_n disagreed with the linear scan";
      if fast.is_none() && slow.is_none() {
        break;
      }
      n = n + 1;
    }
    cursor = cursor + 1;
  }
}

test "lookahead: the prev variants match a linear scan at every cursor and offset" {
  str src = `fun f() {
  `  // comment
  `  num a = sizeof(num);
  `
  `  num b = a + 1;
  `}`;
  ParseState st = state_from(src);
  num total = st.tokens.len;
  assert total > 0, "expected a non-empty token stream";

  num cursor = 0;
  for cursor <= total {
    st.pindex = cursor;
    num n = 0;
    for n <= total {
      // token_peek_prev_n looks backward from pindex - 2 inclusive.
      let prev_n = st.token_peek_prev_n(n);
      assert same_token(prev_n, ref_prev_n(st.tokens, cursor - 1, n)), "token_peek_prev_n disagreed with the linear scan";

      // token_peek_prev_stream_n looks backward from pindex - 1 inclusive.
      let prev_s = st.token_peek_prev_stream_n(n);
      assert same_token(prev_s, ref_prev_n(st.tokens, cursor, n)), "token_peek_prev_stream_n disagreed with the linear scan";

      if prev_n.is_none() && prev_s.is_none() {
        break;
      }
      n = n + 1;
    }
    cursor = cursor + 1;
  }
}

