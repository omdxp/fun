test "std.sync_runtime lifecycle APIs transpile" {
  str src = `imp std.sync_runtime;
  `fun main() {
  `  Mutex m = runtime_mutex_new();
  `  CondVar c = runtime_condvar_new();
  `  _ = runtime_mutex_init(&m);
  `  _ = runtime_mutex_lock(&m);
  `  _ = runtime_mutex_try_lock(&m);
  `  _ = runtime_mutex_unlock(&m);
  `  _ = runtime_condvar_init(&c);
  `  _ = runtime_condvar_wait(&c, &m);
  `  _ = runtime_condvar_timed_wait(&c, &m, NULL);
  `  _ = runtime_condvar_signal(&c);
  `  _ = runtime_condvar_broadcast(&c);
  `  _ = runtime_condvar_destroy(&c);
  `  _ = runtime_mutex_destroy(&m);
  `}`;
  let out = emit_c(src, "std.sync_runtime lifecycle APIs transpile");
  assert contains(out, "runtime_mutex_new("), "expected the mutex constructor call";
  assert contains(out, "runtime_condvar_new("), "expected the condvar constructor call";
  assert contains(out, "runtime_mutex_try_lock("), "expected the try-lock call";
  assert contains(out, "runtime_condvar_timed_wait("), "expected the timed wait call";
  assert contains(out, "runtime_mutex_destroy("), "expected the mutex destroy call";
}

