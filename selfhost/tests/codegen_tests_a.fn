test "async quirk pointer generic receiver await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Box<T> {
  `  T v;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun ptr(Box<AsyncCounter>* b) Box<AsyncCounter>* {
  `  ret b;
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  Box<AsyncCounter> b = Box<AsyncCounter>{ v = q };
  `  num out = await (*ptr(&b)).v.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk pointer generic receiver await transpiles");
  assert contains(out, "vtable->add("), "expected a dereferenced pointer receiver to keep the quirk dispatch";
}

test "async quirk helper pointer generic receiver await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Box<T> {
  `  T v;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun ptr(Box<AsyncCounter>* b) Box<AsyncCounter>* {
  `  ret b;
  `}
  `fun box(Box<AsyncCounter>* b) Box<AsyncCounter> {
  `  ret *b;
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  Box<AsyncCounter> b = Box<AsyncCounter>{ v = q };
  `  num out = await (box(ptr(&b)).v).add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk helper pointer generic receiver await transpiles");
  assert contains(out, "vtable->add("), "expected a chained helper receiver to keep the quirk dispatch";
}

test "async quirk indexed generic receiver await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `Counter[] counters = [Counter{ base = 40 }, Counter{ base = 41 }];
  `async fun main() {
  `  Counter picked = counters[1];
  `  num out = await picked.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk indexed generic receiver await transpiles");
  assert contains(out, "Counter__AsyncCounter__add"), "expected the quirk-impl method to be emitted";
  assert contains(out, "[1]"), "expected the indexed initializer to be preserved";
}

test "function definitions can be out of order (prototypes emitted)" {
  str src = `imp std.c.io;
  `fun main() {
  `  foo();
  `}
  `fun foo() {
  `  printf("ok\n");
  `}`;
  let out = emit_c(src, "function definitions can be out of order (prototypes emitted)");
  num proto = index_of_str(out, "void foo(");
  num main_at = index_of_str(out, "int main");
  assert proto >= 0, "expected a prototype for the later definition";
  assert main_at >= 0, "expected main to be emitted";
  assert proto < main_at, "expected the prototype to precede its first use";
}

test "declaration-only function emits semicolon prototype" {
  str src = `fun someCFunc() str;
  `fun main() {
  `  someCFunc();
  `}`;
  let out = emit_c(src, "declaration-only function emits semicolon prototype");
  assert contains(out, "char* someCFunc(void);"), "expected a bare prototype";
  assert !contains(out, "char* someCFunc(void) ;"), "expected no stray space before the semicolon";
}

test "defer emits in LIFO order before return" {
  str src = `fun a() { ret; }
  `fun b() { ret; }
  `fun foo() num {
  `  defer a();
  `  defer b();
  `  ret 1;
  `}`;
  let out = emit_c(src, "defer emits in LIFO order before return");
  num snapshot = index_of_str(out, "__fun_defer_ret");
  assert snapshot >= 0, "expected the return value to be snapshotted into a temp";
  // Scan from the snapshot so the prelude cannot supply a stray `a();` or `b();`.
  str body = substr(out, snapshot, len(out) - snapshot);
  num b_at = index_of_str(body, "b();");
  num a_at = index_of_str(body, "a();");
  num ret_at = index_of_str(body, "return __fun_defer_ret");
  assert b_at >= 0, "expected the last-deferred call";
  assert a_at >= 0, "expected the first-deferred call";
  assert b_at < a_at, "expected defers to run last-in first-out";
  assert a_at < ret_at, "expected the defers to precede the actual return";
}

test "defer block emits before function end" {
  str src = `fun a() { ret; }
  `fun b() { ret; }
  `fun foo() {
  `  defer {
  `    a();
  `    b();
  `  }
  `}`;
  let out = emit_c(src, "defer block emits before function end");
  assert contains(out, "a();"), "expected the first deferred call";
  assert contains(out, "b();"), "expected the second deferred call";
}

test "enum types can be referenced before declaration" {
  str src = `imp std.c.io;
  `fun takesColor(Color c) num {
  `  if c == .Blue { ret 1; }
  `  ret 0;
  `}
  `fun main() {
  `  num v = takesColor(.Blue);
  `  printf("%d\n", v);
  `}
  `enum Color {
  `  Red,
  `  Blue,
  `}`;
  let out = emit_c(src, "enum types can be referenced before declaration");
  assert contains(out, "Color_Blue"), "expected the variant constant to survive a forward reference";
}

test "std.c.thread symbols are callable after import" {
  str src = `imp std.c.thread;
  `fun main() {
  `  pthread_self();
  `}`;
  let out = emit_c(src, "std.c.thread symbols are callable after import");
  assert contains(out, "pthread_self()"), "expected the imported symbol's call to be emitted";
}

test "std.c.thread_windows symbols are callable after import" {
  str src = `imp std.c.thread_windows;
  `fun main() {
  `  pthread_self();
  `}`;
  let out = emit_c(src, "std.c.thread_windows symbols are callable after import");
  assert contains(out, "pthread_self()"), "expected the imported symbol's call to be emitted";
}

test "transitive std.thread import emits pthread headers" {
  str src = `imp std.thread;
  `fun main() { ret; }`;
  let out = emit_c(src, "transitive std.thread import emits pthread headers");
  assert contains(out, "#include <pthread.h>"), "expected the thread runtime header";
}

test "std.thread helper lifecycle APIs transpile" {
  str src = `imp std.thread;
  `fun main() {
  `  Thread t = thread_new();
  `  _ = thread_start(&t, NULL, NULL);
  `  _ = thread_join(&t, NULL);
  `  _ = thread_detach(&t);
  `}`;
  let out = emit_c(src, "std.thread helper lifecycle APIs transpile");
  assert contains(out, "thread_start("), "expected the start helper call";
  assert contains(out, "thread_join("), "expected the join helper call";
  assert contains(out, "thread_detach("), "expected the detach helper call";
}

test "std.thread accepts named function callbacks" {
  str src = `imp std.thread;
  `fun worker(raw* arg) raw* {
  `  ret arg;
  `}
  `fun main() {
  `  Thread t = thread_new();
  `  _ = thread_start(&t, worker, NULL);
  `  _ = thread_join(&t, NULL);
  `}`;
  let out = emit_c(src, "std.thread accepts named function callbacks");
  assert contains(out, "thread_start("), "expected the start helper call";
  assert contains(out, "worker"), "expected the named callback to be passed by symbol";
}

test "std.sync helper lifecycle APIs transpile" {
  str src = `imp std.sync;
  `fun main() {
  `  Mutex m = mutex_new();
  `  CondVar c = condvar_new();
  `  _ = mutex_init(&m);
  `  _ = mutex_lock(&m);
  `  _ = mutex_try_lock(&m);
  `  _ = mutex_unlock(&m);
  `  _ = condvar_init(&c);
  `  _ = condvar_wait(&c, &m);
  `  _ = condvar_timed_wait(&c, &m, NULL);
  `  _ = condvar_signal(&c);
  `  _ = condvar_broadcast(&c);
  `  _ = condvar_destroy(&c);
  `  _ = mutex_destroy(&m);
  `}`;
  let out = emit_c(src, "std.sync helper lifecycle APIs transpile");
  assert contains(out, "mutex_init("), "expected the mutex init call";
  assert contains(out, "mutex_try_lock("), "expected the try-lock call";
  assert contains(out, "mutex_destroy("), "expected the mutex destroy call";
  assert contains(out, "condvar_timed_wait("), "expected the timed wait call";
  assert contains(out, "condvar_broadcast("), "expected the broadcast call";
  assert contains(out, "condvar_destroy("), "expected the condvar destroy call";
}

