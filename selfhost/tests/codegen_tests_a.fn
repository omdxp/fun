// Compiler test corpus, batch A. Ported from the `tests/` codegen suite so
// the same expectations run against this compiler. Each case states its
// input as source text and checks the emitted C.
// 
// The harness transpiles a source string on its own without resolving
// imports, so a case whose expectation depends on an imported module's body
// (a stdlib generic type, an extern prototype) is noted rather than ported.

imp harness;
imp std.string;

test "defer inside false if branch does not run" {
  str src = `imp std.c.io;
  `fun logLine(str msg) { printf("%s\n", msg); }
  `fun main() num {
  `  num x = 43;
  `  if x == 42 {
  `    defer logLine("defer inside if");
  `  }
  `  defer logLine("always");
  `  ret 0;
  `}`;
  let out = emit_c(src, "defer inside false if branch does not run");
  assert contains(out, "logLine(\"defer inside if\")"), "expected the branch-local defer to be emitted inside the branch";
  assert contains(out, "logLine(\"always\")"), "expected the function-level defer to be emitted";
}

test "defer inside fit branch runs only for matched branch" {
  str src = `imp std.c.io;
  `fun logLine(str msg) { printf("%s\n", msg); }
  `fun runCase(num x) {
  `  printf("case=%lld\n", x);
  `  defer logLine("defer always");
  `  fit x {
  `    1 -> {
  `      logLine("body1");
  `      defer logLine("defer branch1");
  `    }
  `    2 -> {
  `      logLine("body2");
  `    }
  `    _ -> {
  `      logLine("body_");
  `      defer logLine("defer branch_");
  `    }
  `  }
  `}
  `fun main() num {
  `  runCase(1);
  `  ret 0;
  `}`;
  let out = emit_c(src, "defer inside fit branch runs only for matched branch");
  assert contains(out, "logLine(\"defer branch1\")"), "expected the first branch's defer";
  assert contains(out, "logLine(\"defer branch_\")"), "expected the fallback branch's defer";
  assert contains(out, "logLine(\"defer always\")"), "expected the function-level defer";
  assert !contains(out, "logLine(\"defer branch1\"); logLine(\"body2\")"), "expected branch defers to stay in their own branch";
}

test "defer in range loop runs at each iteration end" {
  str src = `imp std.c.io;
  `fun logLine(str msg) { printf("%s\n", msg); }
  `fun main() num {
  `  for i : 0..3 {
  `    printf("body=%lld\n", i);
  `    defer logLine("defer iter");
  `  }
  `  ret 0;
  `}`;
  let out = emit_c(src, "defer in range loop runs at each iteration end");
  assert contains(out, "i < 3"), "expected the range bound";
  assert contains(out, "logLine(\"defer iter\")"), "expected the loop-body defer to be emitted";
}

