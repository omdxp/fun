  `  _ = sync_backend_windows_mutex_init(&m);
  `  _ = sync_backend_windows_mutex_lock(&m);
  `  _ = sync_backend_windows_mutex_try_lock(&m);
  `  _ = sync_backend_windows_mutex_unlock(&m);
  `  _ = sync_backend_windows_condvar_init(&c);
  `  _ = sync_backend_windows_condvar_wait(&c, &m);
  `  _ = sync_backend_windows_condvar_timed_wait(&c, &m, NULL);
  `  _ = sync_backend_windows_condvar_signal(&c);
  `  _ = sync_backend_windows_condvar_broadcast(&c);
  `  _ = sync_backend_windows_condvar_destroy(&c);
  `  _ = sync_backend_windows_mutex_destroy(&m);
  `}`;
  let out = emit_c(src, "std.sync_backend_windows native APIs transpile");
  assert contains(out, "sync_backend_windows_unavailable("), "expected the availability probe";
  assert contains(out, "sync_backend_windows_mutex_try_lock("), "expected the try-lock call";
  assert contains(out, "sync_backend_windows_condvar_timed_wait("), "expected the timed wait call";
  assert !contains(out, "sync_backend_posix_mutex_init("), "expected no posix backend call to leak in";
}

