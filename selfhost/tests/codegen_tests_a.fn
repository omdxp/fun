test "async and await let surface transpiles" {
  str src = `imp std.c.io;
  `async fun inc(num x) num { ret x + 1; }
  `async fun main() {
  `  let out = await inc(41);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async and await let surface transpiles");
  assert contains(out, "__fun_async_call_inc"), "expected the async call thunk behind an inferred binding";
}

test "async await statement form transpiles" {
  str src = `imp std.c.io;
  `async fun inc(num x) num { ret x + 1; }
  `async fun main() {
  `  await inc(40);
  `  num out = await inc(41);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async await statement form transpiles");
  assert contains(out, "__fun_async_call_inc(40)"), "expected a discarded await to still emit the thunk call";
}

