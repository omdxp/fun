test "async generic impl method await transpiles" {
  str src = `imp std.c.io;
  `compound Box<T> {
  `  num pad;
  `}
  `impl Box<T> {
  `  async forty_two() num { ret 42; }
  `}
  `async fun main() {
  `  Box<num> b;
  `  num out = await b.forty_two();
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async generic impl method await transpiles");
  assert contains(out, "__fun_async_call_Box__num__forty_two("), "expected the monomorphized async method thunk";
}

test "async quirk dispatch await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  num out = await q.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk dispatch await transpiles");
  assert contains(out, "vtable->add("), "expected a vtable dispatch";
  assert contains(out, "__fun_async_call_Counter__AsyncCounter__add"), "expected the quirk-impl async thunk";
}

test "async quirk field dispatch await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Holder {
  `  AsyncCounter q;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  Holder h = Holder{ q = &c };
  `  num out = await h.q.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk field dispatch await transpiles");
  assert contains(out, "vtable->add("), "expected a vtable dispatch through the field";
  assert contains(out, "h.q"), "expected the field receiver to be preserved";
}

test "async quirk function-returned receiver await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun passthrough(AsyncCounter q) AsyncCounter {
  `  ret q;
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  num out = await passthrough(q).add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk function-returned receiver await transpiles");
  assert contains(out, "vtable->add("), "expected a vtable dispatch on a call-expression receiver";
  assert contains(out, "passthrough"), "expected the receiver call to be emitted";
}

test "async quirk nested composite receiver await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Holder {
  `  AsyncCounter q;
  `}
  `compound Wrap {
  `  Holder h;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun wrap(AsyncCounter q) Wrap {
  `  ret Wrap{ h = Holder{ q = q } };
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  num out = await wrap(q).h.q.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk nested composite receiver await transpiles");
  assert contains(out, "vtable->add("), "expected a vtable dispatch through a nested receiver";
  assert contains(out, "wrap"), "expected the receiver call to be emitted";
}

test "async quirk generic wrapper receiver await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Box<T> {
  `  T v;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `fun pack(AsyncCounter q) Box<AsyncCounter> {
  `  ret Box<AsyncCounter>{ v = q };
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  AsyncCounter q = &c;
  `  num out = await pack(q).v.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async quirk generic wrapper receiver await transpiles");
  assert contains(out, "vtable->add("), "expected a vtable dispatch through the generic wrapper";
  assert contains(out, "Box"), "expected the wrapper instantiation to be emitted";
}

