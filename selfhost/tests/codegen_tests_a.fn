  assert contains(out, "runtime_backend_name()"), "expected the process selector";
  assert contains(out, "thread_runtime_backend_name()"), "expected the thread selector";
  assert contains(out, "sync_runtime_backend_name()"), "expected the sync selector";
}

test "windows-selected sync runtime lifecycle operations execute" {
  str src = `imp std.sync_runtime;
  `imp std.c.io;
  `fun main() {
  `  Mutex m = runtime_mutex_new();
  `  CondVar c = runtime_condvar_new();
  `  num sum = 0;
  `  sum += runtime_mutex_init(&m);
  `  sum += runtime_condvar_init(&c);
  `  sum += runtime_mutex_lock(&m);
  `  sum += runtime_mutex_unlock(&m);
  `  sum += runtime_condvar_signal(&c);
  `  sum += runtime_condvar_broadcast(&c);
  `  sum += runtime_condvar_destroy(&c);
  `  sum += runtime_mutex_destroy(&m);
  `  printf("%d", sum);
  `}`;
  let out = emit_c(src, "windows-selected sync runtime lifecycle operations execute");
  assert contains(out, "sum += runtime_mutex_init"), "expected each lifecycle call to accumulate its return code";
  assert contains(out, "runtime_condvar_broadcast("), "expected the broadcast call";
}

test "windows-selected thread runtime null-pointer behavior is non-stub" {
  str src = `imp std.thread_runtime;
  `imp std.c.io;
