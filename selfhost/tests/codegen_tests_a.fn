  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `quirk AsyncCounter {
  `  async add(num x) num;
  `}
  `compound Box<T> {
  `  T v;
  `}
  `impl Counter as AsyncCounter {
  `  async add(num x) num { ret self.base + x; }
