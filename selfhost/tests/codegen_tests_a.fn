test "std.io APIs usable in async function transpile" {
  str src = `imp std.io;
  `async fun main() {
  `  str path = "codegen_std_io_async_context_tmp.txt";
  `  _ = write_all(path, "xyz");
  `  File f = open_read(path);
  `  _ = f.read_bytes(3);
  `  f.close();
  `  _ = read_all(path);
  `}`;
  let out = emit_c(src, "std.io APIs usable in async function transpile");
  assert contains(out, "write_all("), "expected the write helper call";
  assert contains(out, "open_read("), "expected the open helper call";
  assert contains(out, "read_bytes("), "expected the read method call";
  assert contains(out, "read_all("), "expected the whole-file read call";
}
