test "compound assignment transpiles" {
  str src = `fun main() {
  `  num x = 1;
  `  x += 2;
  `}`;
  let out = emit_c(src, "compound assignment transpiles");
  assert contains(out, "x += 2"), "expected the compound assignment to survive lowering";
}

test "raw pointer maps to void*" {
  str src = `fun id(raw* p) raw* { ret p; }
  `fun main() { raw* x = id(0); }`;
  let out = emit_c(src, "raw pointer maps to void*");
  assert contains(out, "void* id(void* p)"), "expected raw* to lower to void*";
}

test "async and await surface transpiles" {
  str src = `imp std.c.io;
  `async fun inc(num x) num { ret x + 1; }
  `async fun main() {
  `  num out = await inc(41);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async and await surface transpiles");
  assert contains(out, "int64_t inc(int64_t x)"), "expected the async body to lower to a plain C function";
}

