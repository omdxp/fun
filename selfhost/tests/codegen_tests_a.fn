test "async impl method await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `impl Counter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `async fun main() {
  `  Counter c;
  `  c.base = 41;
  `  num out = await c.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async impl method await transpiles");
  assert contains(out, "__fun_async_call_Counter__add("), "expected the mangled async method thunk";
}

test "async field method await transpiles" {
  str src = `imp std.c.io;
  `compound Counter {
  `  num base;
  `}
  `compound Holder {
  `  Counter counter;
  `}
  `impl Counter {
  `  async add(num x) num { ret self.base + x; }
  `}
  `async fun main() {
  `  Holder h;
  `  h.counter.base = 41;
  `  num out = await h.counter.add(1);
  `  printf("%lld", out);
  `}`;
  let out = emit_c(src, "async field method await transpiles");
  assert contains(out, "__fun_async_call_Counter__add("), "expected the receiver's own type to pick the thunk";
}

