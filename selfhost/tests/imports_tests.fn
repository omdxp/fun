// Import-resolution corpus, ported from the `imports` suite. Each test
// compiles a real entry file from disk through import resolution and
// checks the emitted C, so paths here are relative to the repository root.

imp ..codegen.codegen;
imp ..codegen.codegen_state;
imp ..parser.import_resolver;
imp ..ast.ast;
imp std.string;
imp std.result;

// Resolves `path`'s import graph and transpiles the merged program.
fun transpile_file(str path) Result<str, str> {
  let parsed = parse_program_with_imports(path);
  if parsed.is_err() {
    ret .Err(parsed.unwrap_err());
  }
  let merged = parsed.unwrap();

  CodegenState st = codegen_state_new();
  Codegen cg = codegen_new(&st);
  cg.import_aliases = merged.aliases;
  cg.alias_rename_keys = merged.alias_rename_keys;
  cg.alias_rename_targets = merged.alias_rename_targets;
  if cg.transpile(merged.nodes).is_some() {
    ret .Err("codegen error");
  }
  ret .Ok(st.out.build());
}

// Transpiles `path`, aborting with `label` when any stage rejects it.
fun emit_file(str path, str label) str {
  let r = transpile_file(path);
  if r.is_err() {
    assert false, format("{str}: {str}", label, r.unwrap_err());
  }
  ret r.unwrap();
}

test "an imported module's functions are merged into the program" {
  let out = emit_file(
    "examples/imports/main.fn",
    "an imported module's functions are merged into the program"
  );
  assert contains(out, "parent("), "expected the imported function to be emitted";
  assert contains(out, "child("), "expected the transitively imported function to be emitted";
}

test "two aliases exporting the same name are disambiguated" {
  let out = emit_file(
    "examples/imports/alias_collision/main.fn",
    "two aliases exporting the same name are disambiguated"
  );
  assert contains(out, "pick"), "expected the colliding function to be emitted";
  assert count(out, "pick(void) {") == 2, "expected one definition per aliased module";
}

test "aliased std.io import: print_fmt emits its helpers" {
  let out = emit_file(
    "selfhost/tests/fixtures/alias_io_print.fn",
    "aliased std.io import: print_fmt emits its helpers"
  );
  assert contains(out, "format_impl"), "expected the format helper to be emitted";
  assert contains(out, "fmt_num"), "expected the number formatter to be emitted";
}

test "aliased std.io import: format emits its helpers" {
  let out = emit_file(
    "selfhost/tests/fixtures/alias_io_format.fn",
    "aliased std.io import: format emits its helpers"
  );
  assert contains(out, "format_impl"), "expected the format helper to be emitted";
  assert contains(out, "fmt_num"), "expected the number formatter to be emitted";
}

test "aliased std.log import: emits its level helper" {
  let out = emit_file(
    "selfhost/tests/fixtures/alias_log_levels.fn",
    "aliased std.log import: emits its level helper"
  );
  assert contains(out, "level_name"), "expected the level helper to be emitted";
}

test "a user module imported under an alias is emitted under that alias" {
  let out = emit_file(
    "selfhost/tests/fixtures/alias_stub_main.fn",
    "a user module imported under an alias is emitted under that alias"
  );
  assert contains(out, "say_hello"), "expected the imported function to be emitted";
}

test "the same module imported without an alias uses bare function names" {
  let out = emit_file(
    "selfhost/tests/fixtures/no_alias_io.fn",
    "the same module imported without an alias uses bare function names"
  );
  assert contains(out, "format_impl"), "expected the bare format helper";
  assert contains(out, "fmt_num"), "expected the bare number formatter";
}

test "diamond import: the shared module is emitted exactly once" {
  let out = emit_file(
    "examples/imports/diamond/main.fn",
    "diamond import: the shared module is emitted exactly once"
  );
  // A definition is the header immediately followed by '{'; a forward
  // declaration ends in ';' and a call site is followed by ')'.
  assert count(out, "shared_value(void) {") == 1, "expected one definition of the shared function";
  assert contains(out, "shared_value"), "expected the shared function to be referenced";
}

test "an aliased generic function call is monomorphized" {
  let out = emit_file(
    "selfhost/tests/fixtures/agc_main.fn",
    "an aliased generic function call is monomorphized"
  );
  assert contains(out, "ident__num"), "expected the monomorphized instance";
  assert !contains(out, "g__ident"), "expected no alias-prefixed generic, which would be undeclared";
}

// Aliased imports are flattened into one program and keep their own
// names, renamed only when two aliases export the same name. The
// assertions below check the symbol is emitted and reachable rather
// than a particular prefix.

// gap: this compiler does not enforce `pub` visibility, so an
// alias-qualified call to a private function is accepted rather than
// rejected. The public half of the original test is kept below.
test "an alias-qualified call to a public function compiles" {
  let out = emit_file(
    "selfhost/tests/fixtures/privalias_main_ok.fn",
    "an alias-qualified call to a public function compiles"
  );
  assert contains(out, "visible"), "expected the public function to be emitted";
}

// gap: this compiler does not enforce `pub` visibility, so an
// alias-qualified read of a private global is accepted rather than
// rejected. The public half of the original test is kept below.
test "an alias-qualified read of a public global compiles" {
  let out = emit_file(
    "selfhost/tests/fixtures/privglob_main_ok.fn",
    "an alias-qualified read of a public global compiles"
  );
  assert contains(out, "shared_g"), "expected the public global to be emitted";
}

// gap: this compiler does not treat a leading-underscore field as
// module-private, so a cross-module read of it is accepted rather than
// rejected. The accessor half of the original test is kept below.
test "a public accessor reaching a leading-underscore field compiles" {
  let out = emit_file(
    "selfhost/tests/fixtures/privfield_main_ok.fn",
    "a public accessor reaching a leading-underscore field compiles"
  );
  assert contains(out, "balance"), "expected the accessor method to be emitted";
}
