// Loop-lowering corpus, ported from the `for` suite. Each test states its
// input as source text and checks the emitted C.

imp harness;
imp std.string;

test "for range transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  for i : 0..3 {
  `    printf("%d\n", i);
  `  }
  `}`;
  let out = emit_c(src, "for range transpiles");
  assert contains(out, "for (int64_t i = 0; i < 3; i++)"), "expected an indexed C for over the range";
}

test "for array item transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num[] arr = [1, 2, 3];
  `  for item : arr {
  `    printf("%d\n", item);
  `  }
  `}`;
  let out = emit_c(src, "for array item transpiles");
  assert contains(out, "int64_t arr[] = {1, 2, 3};"), "expected the array declaration";
  assert contains(out, "for (int64_t __fun_i = 0;"), "expected a synthesized index variable";
  assert contains(out, "int64_t item = arr[__fun_i];"), "expected the item binding";
}

test "for array index and item transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num[] arr = [1, 2, 3];
  `  for i, item :: arr {
  `    printf("arr[%d]=%d\n", i, item);
  `  }
  `}`;
  let out = emit_c(src, "for array index and item transpiles");
  assert contains(out, "for (int64_t i = 0;"), "expected the named index variable";
  assert contains(out, "int64_t item = arr[i];"), "expected the item binding to use it";
}

// skipped: the original test for a method call in an index-and-item loop body
// asserts nothing, so there is no expectation to port.

test "for Vec values transpiles via len and data" {
  // The harness compiles a single source string without resolving imports,
  // so the Vec shape the loop lowering keys off is declared inline here.
  str src = `compound Vec<T> {
  `  T* data;
  `  num len;
  `}
  `fun main() {
  `  Vec<str> vals;
  `  for val : vals {
  `    num n = 1;
  `  }
  `}`;
  let out = emit_c(src, "for Vec values transpiles via len and data");
  assert contains(out, "for (int64_t __fun_i = 0; __fun_i < vals.len; __fun_i++)"), "expected the loop bound to read len";
  assert contains(out, "__auto_type val = vals.data[__fun_i];"), "expected the value binding to read data";
}

test "for condition transpiles to while" {
  str src = `imp std.c.io;
  `fun main() {
  `  num i = 0;
  `  for i < 3 {
  `    printf("%d\n", i);
  `    i = i + 1;
  `  }
  `}`;
  let out = emit_c(src, "for condition transpiles to while");
  assert contains(out, "while ("), "expected a C while loop";
  assert contains(out, "i < 3"), "expected the loop condition";
}

test "for infinite transpiles to while(1)" {
  str src = `imp std.c.io;
  `fun main() {
  `  num i = 0;
  `  for {
  `    if i == 3 { break; }
  `    printf("%d\n", i);
  `    i = i + 1;
  `  }
  `}`;
  let out = emit_c(src, "for infinite transpiles to while(1)");
  assert contains(out, "while (1)"), "expected an unconditional loop";
}

test "2D matrix declaration transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num[][] matrix = [[1, 2, 3], [4, 5, 6]];
  `}`;
  let out = emit_c(src, "2D matrix declaration transpiles");
  assert contains(out, "int64_t matrix[][3]"), "expected an unsized outer and sized inner dimension";
  assert contains(out, "{{1, 2, 3}, {4, 5, 6}}"), "expected the nested brace initializer";
}

test "2D matrix for-iter outer loop transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num[][] matrix = [[1, 2, 3], [4, 5, 6]];
  `  for row : matrix {
  `    printf("%p\n", row);
  `  }
  `}`;
  let out = emit_c(src, "2D matrix for-iter outer loop transpiles");
  assert contains(out, "sizeof(matrix)/sizeof(matrix[0])"), "expected the outer bound from sizeof";
  assert contains(out, "int64_t * row = matrix[__fun_i]"), "expected the row to bind as a pointer";
}

test "2D matrix nested for-iter transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num[][] matrix = [[1, 2, 3], [4, 5, 6]];
  `  for row : matrix {
  `    for item : row {
  `      printf("%lld\n", item);
  `    }
  `  }
  `}`;
  let out = emit_c(src, "2D matrix nested for-iter transpiles");
  assert contains(out, "sizeof(matrix)/sizeof(matrix[0])"), "expected the outer bound";
  assert contains(out, "sizeof(matrix[0])/sizeof(matrix[0][0])"), "expected the inner bound";
  assert contains(out, "int64_t item = row[__fun_i]"), "expected the innermost item to bind as a scalar";
}

test "2D matrix let inference transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  let m = [[10, 20], [30, 40]];
  `  for row : m {
  `    for val : row {
  `      printf("%lld\n", val);
  `    }
  `  }
  `}`;
  let out = emit_c(src, "2D matrix let inference transpiles");
  assert contains(out, "int64_t m[][2]"), "expected the inferred matrix type";
  assert contains(out, "sizeof(m)/sizeof(m[0])"), "expected the outer bound";
  assert contains(out, "sizeof(m[0])/sizeof(m[0][0])"), "expected the inner bound";
}

test "3D tensor nested for-iter transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  num[][][] tensor = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
  `  for plane : tensor {
  `    for row : plane {
  `      for item : row {
  `        printf("%lld\n", item);
  `      }
  `    }
  `  }
  `}`;
  let out = emit_c(src, "3D tensor nested for-iter transpiles");
  assert contains(out, "sizeof(tensor)/sizeof(tensor[0])"), "expected the outer bound";
  assert contains(out, "sizeof(tensor[0])/sizeof(tensor[0][0])"), "expected the middle bound";
  assert contains(out, "sizeof(tensor[0][0])/sizeof(tensor[0][0][0])"), "expected the inner bound";
  assert contains(out, "int64_t item = row[__fun_i]"), "expected the innermost item to bind as a scalar";
}

test "3D tensor let inference transpiles" {
  str src = `imp std.c.io;
  `fun main() {
  `  let m = [[[10, 20], [30, 40]], [[50, 60], [70, 80]]];
  `  for plane : m {
  `    for row : plane {
  `      for val : row {
  `        printf("%lld\n", val);
  `      }
  `    }
  `  }
  `}`;
  let out = emit_c(src, "3D tensor let inference transpiles");
  assert contains(out, "int64_t m[][2][2]"), "expected the inferred tensor type";
  assert contains(out, "sizeof(m)/sizeof(m[0])"), "expected the outer bound";
  assert contains(out, "sizeof(m[0])/sizeof(m[0][0])"), "expected the middle bound";
  assert contains(out, "sizeof(m[0][0])/sizeof(m[0][0][0])"), "expected the inner bound";
}
