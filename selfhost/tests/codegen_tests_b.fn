test "reaudit: await binds tighter than a following binary operator" {
  str src = `imp std.c.io;
  `async fun inc(num x) num { ret x + 1; }
  `async fun main() {
  `  num r = await inc(5) + 1;
  `}`;
  let out = emit_c(src, "reaudit: await binds tighter than a following binary operator");
  assert contains(out, "inc(5) + 1)"), "expected the await to bind to the call alone";
}

test "reaudit: defer that mutates a returned variable does not corrupt the value" {
  str src = `imp std.c.io;
  `fun expr_ret() num {
  `  num x = 5;
  `  defer x = 999;
  `  ret x + 1;
  `}
  `fun main() num { ret 0; }`;
  let out = emit_c(
    src,
    "reaudit: defer that mutates a returned variable does not corrupt the value"
  );
  assert contains(out, "__fun_defer_ret = (x + 1)"), "expected the return value snapshotted first";
  assert contains(out, "return __fun_defer_ret"), "expected the snapshot to be returned";
}
