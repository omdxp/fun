test "transitive std.net import emits socket headers" {
  str src = `imp std.net;
  `fun main() {
  `  ret;
  `}`;
  let out = emit_c(src, "transitive std.net import emits socket headers");
  assert contains(out, "#if defined(_WIN32)"), "expected a platform guard";
  assert contains(out, "#include <winsock2.h>"), "expected the Windows socket header";
  assert contains(out, "#include <ws2tcpip.h>"), "expected the Windows address header";
  assert contains(out, "#include <sys/socket.h>"), "expected the POSIX socket header";
  assert contains(out, "#include <netinet/in.h>"), "expected the POSIX address header";
  assert contains(out, "#include <arpa/inet.h>"), "expected the POSIX conversion header";
  assert contains(out, "#include <unistd.h>"), "expected the POSIX process header";
}

test "main num return emits exit status" {
  str src = `fun main() num {
  `  ret 7;
  `}`;
  let out = emit_c(src, "main num return emits exit status");
  assert contains(out, "int main"), "expected main to be declared int";
  assert contains(out, "return 7"), "expected the exit status to be returned";
}

test "hexadecimal literals with a-f and A-F digits compile" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num a = 0xdead;
  `  num b = 0xBEEF;
  `  num c = 0xFF;
  `  num d = 0x1f;
  `  ret 0;
  `}`;
  let out = emit_c(src, "hexadecimal literals with a-f and A-F digits compile");
  assert contains(out, "57005"), "expected 0xdead to decode";
  assert contains(out, "48879"), "expected 0xBEEF to decode";
  assert contains(out, "255"), "expected 0xFF to decode";
  assert contains(out, "31"), "expected 0x1f to decode";
}

test "long type name with quirk impl does not overflow mangled C identifiers" {
  str src = `quirk Greeter {
  `  greet() str;
  `}
  `compound AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA {
  `  num x;
  `}
  `impl AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA as Greeter {
  `  greet() str { ret "hi"; }
  `}
  `fun main() num {
  `  AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA g;
  `  g.x = 1;
  `  ret 0;
  `}`;
  let out = emit_c(src, "long type name with quirk impl does not overflow mangled C identifiers");
  assert contains(out, "AAAAAAAAAA__Greeter__greet"), "expected the mangled impl method";
}

// gap: a compound-initializer expression that names a type declared later in
// the file is rejected with a parse error.
// test "forward-referenced compound struct-initializer expression compiles" { }

test "compound-initializer with a genuinely unknown type is still rejected" {
  str src = `fun main() num {
  `  let z = Nonexistent{q = 1};
  `  ret 0;
  `}`;
  let r = transpile_source(src);
  assert r.is_err(), "expected an undeclared initializer type to be rejected";
}

test "compound-assignment operators %= &= |= ^= transpile" {
  str src = `fun main() num {
  `  num a = 100; a %= 7;
  `  num b = 100; b &= 7;
  `  num c = 100; c |= 7;
  `  num d = 100; d ^= 7;
  `  ret 0;
  `}`;
  let out = emit_c(src, "compound-assignment operators %= &= |= ^= transpile");
  assert contains(out, "a %= 7"), "expected the remainder assignment";
  assert contains(out, "b &= 7"), "expected the bitwise-and assignment";
  assert contains(out, "c |= 7"), "expected the bitwise-or assignment";
  assert contains(out, "d ^= 7"), "expected the bitwise-xor assignment";
}

test "escaped double-quote inside a string literal compiles" {
  str src = `fun main() num {
  `  str s = "she said \"hi\" ok";
  `  ret 0;
  `}`;
  let out = emit_c(src, "escaped double-quote inside a string literal compiles");
  assert contains(out, `she said \"hi\" ok`), "expected the escape to survive into C";
}

test "raw string literal: backslashes and quotes need no escaping" {
  // Stated as an escaped string because the fixture itself contains the raw
  // string delimiter.
  str src = "fun main() num {\n  str path = `C:\\Users\\name\\file.txt`;\n  str msg = `she said \"hi\" and left`;\n  ret 0;\n}\n";
  let out = emit_c(src, "raw string literal: backslashes and quotes need no escaping");
  assert contains(out, `C:\\Users\\name\\file.txt`), "expected backslashes to be escaped for C";
  assert contains(out, `she said \"hi\" and left`), "expected quotes to be escaped for C";
}

test "raw string literal: multi-line block joins lines with a real newline" {
  // Stated as an escaped string because the fixture itself contains the raw
  // string delimiter.
  str src = "fun main() num {\n  let block =\n    `line one\n    `line two\n  ;\n  ret 0;\n}\n";
  let out = emit_c(src, "raw string literal: multi-line block joins lines with a real newline");
  assert contains(out, `line one\nline two`), "expected the lines joined by a newline escape";
}

test "single-letter quirk name emits impl method bodies" {
  str src = `imp std.c.io;
  `quirk Q { getX() num; }
  `compound Foo { num x; }
  `impl Foo as Q { getX() num { ret self.x; } }
  `compound G<T> { T x; }
  `fun main() num {
  `  Foo f = Foo{x = 5};
  `  Q q = &f;
  `  G<num> g; g.x = 9;
  `  ret 0;
  `}`;
  let out = emit_c(src, "single-letter quirk name emits impl method bodies");
  assert contains(out, "Foo__Q__getX(Foo* self) {"), "expected the impl method body, not just a prototype";
  assert contains(out, "G__num"), "expected the generic instantiation";
}

test "stacked unary operator does not crash the parser" {
  str src = `imp std.c.io;
  `fun main() {
  `  num a = 5;
  `  num b = ~~a;
  `}`;
  let out = emit_c(src, "stacked unary operator does not crash the parser");
  assert contains(out, "~(~a)"), "expected both bitwise-not applications";
}

test "member-access multiplied by an identifier parses as multiplication" {
  str src = `imp std.c.io;
  `compound O { num v; }
  `compound W { O inner; }
  `compound S { num id; }
  `impl S { pub m(num x) num { ret self.id * x; } }
  `fun nested(W o, num x) num { ret o.inner.v * x; }
  `fun main() num {
  `  S s; s.id = 3;
  `  W w; w.inner.v = 5;
  `  ret 0;
  `}`;
  let out = emit_c(src, "member-access multiplied by an identifier parses as multiplication");
  assert contains(out, "self->id * x"), "expected self field times parameter";
  assert contains(out, "o.inner.v * x"), "expected nested field times parameter";
}

test "double pointer dereference emits two stars" {
  str src = `imp std.c.io;
  `fun set_via(num** pp, num val) { **pp = val; }
  `fun main() num {
  `  num x = 5;
  `  num* p = &x;
  `  num** pp = &p;
  `  set_via(pp, 42);
  `  num v = **pp;
  `  ret 0;
  `}`;
  let out = emit_c(src, "double pointer dereference emits two stars");
  assert contains(out, "int64_t** pp"), "expected a double pointer type";
  assert contains(out, "**pp"), "expected a double dereference";
}

// gap: an array-of-pointers parameter type (`Item*[] arr`) is rejected by
// codegen with "unsupported node"; the original accepts it and emits
// `arr[0]->id`.
// test "field access on element of array-of-pointers emits arrow" { }

test "fit on a string value lowers to strcmp chain" {
  str src = `imp std.c.io;
  `fun classify(str s) {
  `  fit s {
  `    "go" -> { printf("going\n"); },
  `    "stop" -> { printf("stopped\n"); },
  `    _ -> { printf("idle\n"); }
  `  }
  `}
  `fun main() num {
  `  classify("go");
  `  ret 0;
  `}`;
  let out = emit_c(src, "fit on a string value lowers to strcmp chain");
  assert contains(out, "strcmp(s, \"go\") == 0"), "expected the first label compared by value";
  assert contains(out, "strcmp(s, \"stop\") == 0"), "expected the second label compared by value";
  assert contains(out, "else if"), "expected the labels chained";
}

test "local array of compound stays in the function body" {
  str src = `imp std.c.io;
  `compound P { num x; }
  `fun main() num {
  `  P[] pts = [P{x = 1}, P{x = 2}, P{x = 3}];
  `  num sum = 0;
  `  for p : pts { sum = sum + p.x; }
  `  ret 0;
  `}`;
  let out = emit_c(src, "local array of compound stays in the function body");
  assert contains(out, "P pts[] = {"), "expected the array to keep its local initializer";
  assert contains(out, "sizeof(pts)/sizeof(pts[0])"), "expected the for-each to size the local array";
}

test "local T[] initialized from a pointer emits a C pointer, not an array" {
  str src = `imp std.c.io;
  `imp std.c.mem;
  `fun main() num {
  `  raw* mem = malloc(24);
  `  num[] a = mem;
  `  a[0] = 42;
  `  a[1] = 7;
  `  free(mem);
  `  ret 0;
  `}`;
  let out = emit_c(src, "local T[] initialized from a pointer emits a C pointer, not an array");
  assert contains(out, "int64_t* a = "), "expected a pointer declaration";
}

test "compound initializer field after an address-of-valued field parses correctly" {
  str src = `imp std.c.io;
  `compound Engine { num power; }
  `compound Car { Engine* motor; num wheels; }
  `fun main() num {
  `  Engine e; e.power = 50;
  `  Car c = Car{motor = &e, wheels = 4};
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "compound initializer field after an address-of-valued field parses correctly"
  );
  assert contains(out, ".motor = (&e)"), "expected the address-of field";
  assert contains(out, ".wheels = 4"), "expected the field that follows it";
}

// gap: a generic compound with `impl Box<T> as Lenable` never emits a coercion
// helper, so `Lenable la = &bn;` assigns the raw pointer and dispatch names an
// undeclared `Lenable__size`.
// test "generic compound coerces to a quirk (mangled coercion helper name)" { }

test "sizeof works with generic types, generic instances, and locals" {
  str src = `imp std.c.io;
  `compound Box<T> { T v; }
  `compound Pair<A, B> { A a; B b; }
  `fun main() num {
  `  Box<num> b;
  `  num a = sizeof(Box<num>);
  `  num c = sizeof(b);
  `  num d = sizeof(Pair<num, num>);
  `  num e = sizeof(Box<Box<num>>);
  `  ret 0;
  `}`;
  let out = emit_c(src, "sizeof works with generic types, generic instances, and locals");
  assert contains(out, "sizeof(Box__num)"), "expected a mangled generic operand";
  assert contains(out, "sizeof(b)"), "expected a value operand";
  assert contains(out, "sizeof(Pair__num__num)"), "expected a two-param generic operand";
  assert contains(out, "sizeof(Box__Box__num)"), "expected a nested generic operand";
}

