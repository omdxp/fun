// Compiler test corpus, batch B. Ported from the `tests/` suite so the same
// expectations run against this compiler.
// 
// The harness compiles a source string on its own without resolving imports,
// so corpus tests whose fixtures call into stdlib modules (std.channel,
// std.map, std.net helpers, std.mock_time) have no counterpart here. The
// tests that only need an import to select C headers are ported as-is.

imp harness;
imp std.string;

test "generic function specialization emits concrete names" {
  str src = `fun id<T>(T x) T { ret x; }
  `fun main() {
  `  num a = id(1);
  `  str b = id("hi");
  `}`;
  let out = emit_c(src, "generic function specialization emits concrete names");
  assert contains(out, "id__num"), "expected the num specialization";
  assert contains(out, "id__str"), "expected the str specialization";
  assert !contains(out, "id__T"), "expected no unsubstituted type param";
}

test "generic inference after init transpiles with concrete specializations" {
  str src = `compound Box<T> {
  `  T value;
  `}
  `compound Pair<L, R> {
  `  L left;
  `  R right;
  `}
  `fun make_box<T>(T x) Box<T> {
  `  ret Box<T>{value = x};
  `}
  `fun make_pair<L, R>(L left, R right) Pair<L, R> {
  `  ret Pair<L, R>{left = left, right = right};
  `}
  `fun pick_left<L, R>(Pair<L, R> p) L {
  `  ret p.left;
  `}
  `fun swap_pair<L, R>(Pair<L, R> p) Pair<R, L> {
  `  ret Pair<R, L>{left = p.right, right = p.left};
  `}
  `fun main() {
  `  let nbox = Box{value = 7};
  `  nbox.value += 1;
  `  let sbox = make_box("hi");
  `  let pair = make_pair(nbox.value, sbox.value);
  `  let swapped = swap_pair(pair);
  `  let left_num = pick_left(pair);
  `  let left_str = pick_left(swapped);
  `}`;
  let out = emit_c(src, "generic inference after init transpiles with concrete specializations");
  assert contains(out, "make_pair__num__str"), "expected the inferred pair constructor";
  assert contains(out, "swap_pair__num__str"), "expected the inferred swap";
  assert contains(out, "Pair__num__str"), "expected the forward instantiation";
  assert contains(out, "Pair__str__num"), "expected the swapped instantiation";
  assert !contains(out, "make_pair__L__R"), "expected no unsubstituted function";
  assert !contains(out, "Pair__L__R"), "expected no unsubstituted compound";
}

test "assert emits abort and message" {
  str src = `fun main() {
  `  assert true, "ok";
  `}`;
  let out = emit_c(src, "assert emits abort and message");
  assert contains(out, "Assertion failed"), "expected the failure message";
  assert contains(out, "abort()"), "expected the abort call";
}

test "compounds + quirks + impl vtables transpile" {
  str src = `compound Point { num x; num y; }
  `quirk HasX { getX() num; }
  `impl Point as HasX {
  `  getX() num { ret self.x; }
  `}
  `fun main() {
  `  Point p;
  `  p.x = 1;
  `  HasX h = &p;
  `  num v = h.getX();
  `}`;
  let out = emit_c(src, "compounds + quirks + impl vtables transpile");
  assert contains(out, "typedef struct Point"), "expected the struct typedef";
  assert contains(out, "int64_t x;"), "expected the lowered field";
  assert contains(out, "_vtable"), "expected a vtable type";
  assert contains(out, "__fun_coerce_Point_"), "expected a coercion helper";
  assert contains(out, "HasX h = __fun_coerce_Point_"), "expected the init to coerce";
  assert contains(out, "h.vtable->getX"), "expected vtable dispatch";
  assert contains(out, "h.self"), "expected the receiver to be passed";
}

test "pointer field access uses arrow" {
  str src = `compound Point { num x; }
  `fun main() {
  `  Point p;
  `  Point* pp = &p;
  `  pp.x = 1;
  `}`;
  let out = emit_c(src, "pointer field access uses arrow");
  assert contains(out, "pp->x"), "expected an arrow field access";
}

