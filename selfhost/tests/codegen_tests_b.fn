// gap: a constant-zero divisor (`10 / 0`, `7 % 0`, `8 / (2 - 2)`) is accepted
// and passed through to C.
// test "P5: constant division by zero is rejected at compile time" { }

test "P5: non-zero and runtime divisors still compile" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num x = 2;
  `  num a = 10 / 2;
  `  num b = 9 % x;
  `  ret 0;
  `}`;
  let out = emit_c(src, "P5: non-zero and runtime divisors still compile");
  assert contains(out, "10 / 2"), "expected the constant division to survive";
  assert contains(out, "9 % x"), "expected the runtime remainder to survive";
}

test "P4: multi-dimensional array indexing (2D/3D) type-checks" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num[2][3] m;
  `  m[0][0] = 5;
  `  m[1][2] = 9;
  `  num[2][2] init = [[1, 2], [3, 4]];
  `  num[2][2][2] t;
  `  t[1][1][1] = 7;
  `  ret 0;
  `}`;
  let out = emit_c(src, "P4: multi-dimensional array indexing (2D/3D) type-checks");
  assert contains(out, "m[2][3]"), "expected a real C 2D array, not a flattened pointer";
  assert contains(out, "init[2][2] = {{1, 2}, {3, 4}}"), "expected the nested initializer";
  assert contains(out, "t[2][2][2]"), "expected a 3D declaration";
}

