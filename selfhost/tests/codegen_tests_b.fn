test "transitive std.net import emits socket headers" {
  str src = `imp std.net;
  `fun main() {
  `  ret;
  `}`;
  let out = emit_c(src, "transitive std.net import emits socket headers");
  assert contains(out, "#if defined(_WIN32)"), "expected a platform guard";
  assert contains(out, "#include <winsock2.h>"), "expected the Windows socket header";
  assert contains(out, "#include <ws2tcpip.h>"), "expected the Windows address header";
  assert contains(out, "#include <sys/socket.h>"), "expected the POSIX socket header";
  assert contains(out, "#include <netinet/in.h>"), "expected the POSIX address header";
  assert contains(out, "#include <arpa/inet.h>"), "expected the POSIX conversion header";
  assert contains(out, "#include <unistd.h>"), "expected the POSIX process header";
}

test "main num return emits exit status" {
  str src = `fun main() num {
  `  ret 7;
  `}`;
  let out = emit_c(src, "main num return emits exit status");
  assert contains(out, "int main"), "expected main to be declared int";
  assert contains(out, "return 7"), "expected the exit status to be returned";
}

test "hexadecimal literals with a-f and A-F digits compile" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num a = 0xdead;
  `  num b = 0xBEEF;
  `  num c = 0xFF;
  `  num d = 0x1f;
  `  ret 0;
  `}`;
  let out = emit_c(src, "hexadecimal literals with a-f and A-F digits compile");
  assert contains(out, "57005"), "expected 0xdead to decode";
  assert contains(out, "48879"), "expected 0xBEEF to decode";
  assert contains(out, "255"), "expected 0xFF to decode";
  assert contains(out, "31"), "expected 0x1f to decode";
}

test "long type name with quirk impl does not overflow mangled C identifiers" {
  str src = `quirk Greeter {
  `  greet() str;
  `}
  `compound AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA {
  `  num x;
  `}
  `impl AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA as Greeter {
  `  greet() str { ret "hi"; }
  `}
  `fun main() num {
  `  AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA g;
  `  g.x = 1;
  `  ret 0;
  `}`;
  let out = emit_c(src, "long type name with quirk impl does not overflow mangled C identifiers");
  assert contains(out, "AAAAAAAAAA__Greeter__greet"), "expected the mangled impl method";
}

// gap: a compound-initializer expression that names a type declared later in
// the file is rejected with a parse error.
// test "forward-referenced compound struct-initializer expression compiles" { }

test "compound-initializer with a genuinely unknown type is still rejected" {
  str src = `fun main() num {
  `  let z = Nonexistent{q = 1};
  `  ret 0;
  `}`;
  let r = transpile_source(src);
  assert r.is_err(), "expected an undeclared initializer type to be rejected";
}

test "compound-assignment operators %= &= |= ^= transpile" {
  str src = `fun main() num {
  `  num a = 100; a %= 7;
  `  num b = 100; b &= 7;
  `  num c = 100; c |= 7;
  `  num d = 100; d ^= 7;
  `  ret 0;
  `}`;
  let out = emit_c(src, "compound-assignment operators %= &= |= ^= transpile");
  assert contains(out, "a %= 7"), "expected the remainder assignment";
  assert contains(out, "b &= 7"), "expected the bitwise-and assignment";
  assert contains(out, "c |= 7"), "expected the bitwise-or assignment";
  assert contains(out, "d ^= 7"), "expected the bitwise-xor assignment";
}

test "escaped double-quote inside a string literal compiles" {
  str src = `fun main() num {
  `  str s = "she said \"hi\" ok";
  `  ret 0;
  `}`;
  let out = emit_c(src, "escaped double-quote inside a string literal compiles");
  assert contains(out, `she said \"hi\" ok`), "expected the escape to survive into C";
}

test "raw string literal: backslashes and quotes need no escaping" {
  // Stated as an escaped string because the fixture itself contains the raw
  // string delimiter.
  str src = "fun main() num {\n  str path = `C:\\Users\\name\\file.txt`;\n  str msg = `she said \"hi\" and left`;\n  ret 0;\n}\n";
  let out = emit_c(src, "raw string literal: backslashes and quotes need no escaping");
  assert contains(out, `C:\\Users\\name\\file.txt`), "expected backslashes to be escaped for C";
  assert contains(out, `she said \"hi\" and left`), "expected quotes to be escaped for C";
}

test "raw string literal: a doubled backtick is a literal backtick" {
  // Stated as an escaped string because the fixture itself contains the raw
  // string delimiter.
  str src = "fun main() num {\n  str fence = ```````fun`;\n  ret 0;\n}\n";
  let out = emit_c(src, "raw string literal: a doubled backtick is a literal backtick");
  assert contains(out, "\"```fun\""), "expected three backticks in the C string, from three doubled pairs";
}

test "raw string literal: a single backtick still closes the string" {
  // Stated as an escaped string because the fixture itself contains the raw
  // string delimiter.
  str src = "fun main() num {\n  str empty = ``;\n  ret 0;\n}\n";
  let out = emit_c(src, "raw string literal: a single backtick still closes the string");
  assert contains(out, "\"\""), "expected an empty string, not an escape";
}

test "raw string literal: multi-line block joins lines with a real newline" {
  // Stated as an escaped string because the fixture itself contains the raw
  // string delimiter.
  str src = "fun main() num {\n  let block =\n    `line one\n    `line two\n  ;\n  ret 0;\n}\n";
  let out = emit_c(src, "raw string literal: multi-line block joins lines with a real newline");
  assert contains(out, `line one\nline two`), "expected the lines joined by a newline escape";
}

test "single-letter quirk name emits impl method bodies" {
  str src = `imp std.c.io;
  `quirk Q { getX() num; }
  `compound Foo { num x; }
  `impl Foo as Q { getX() num { ret self.x; } }
  `compound G<T> { T x; }
  `fun main() num {
  `  Foo f = Foo{x = 5};
  `  Q q = &f;
  `  G<num> g; g.x = 9;
  `  ret 0;
  `}`;
  let out = emit_c(src, "single-letter quirk name emits impl method bodies");
  assert contains(out, "Foo__Q__getX(Foo* self) {"), "expected the impl method body, not just a prototype";
  assert contains(out, "G__num"), "expected the generic instantiation";
}

test "stacked unary operator does not crash the parser" {
  str src = `imp std.c.io;
  `fun main() {
  `  num a = 5;
  `  num b = ~~a;
  `}`;
  let out = emit_c(src, "stacked unary operator does not crash the parser");
  assert contains(out, "~(~a)"), "expected both bitwise-not applications";
}

test "member-access multiplied by an identifier parses as multiplication" {
  str src = `imp std.c.io;
  `compound O { num v; }
  `compound W { O inner; }
  `compound S { num id; }
  `impl S { pub m(num x) num { ret self.id * x; } }
  `fun nested(W o, num x) num { ret o.inner.v * x; }
  `fun main() num {
  `  S s; s.id = 3;
  `  W w; w.inner.v = 5;
  `  ret 0;
  `}`;
  let out = emit_c(src, "member-access multiplied by an identifier parses as multiplication");
  assert contains(out, "self->id * x"), "expected self field times parameter";
  assert contains(out, "o.inner.v * x"), "expected nested field times parameter";
}

test "double pointer dereference emits two stars" {
  str src = `imp std.c.io;
  `fun set_via(num** pp, num val) { **pp = val; }
  `fun main() num {
  `  num x = 5;
  `  num* p = &x;
  `  num** pp = &p;
  `  set_via(pp, 42);
  `  num v = **pp;
  `  ret 0;
  `}`;
  let out = emit_c(src, "double pointer dereference emits two stars");
  assert contains(out, "int64_t** pp"), "expected a double pointer type";
  assert contains(out, "**pp"), "expected a double dereference";
}

// gap: an array-of-pointers parameter type (`Item*[] arr`) is rejected by
// codegen with "unsupported node"; the original accepts it and emits
// `arr[0]->id`.
// test "field access on element of array-of-pointers emits arrow" { }

test "fit on a string value lowers to strcmp chain" {
  str src = `imp std.c.io;
  `fun classify(str s) {
  `  fit s {
  `    "go" -> { printf("going\n"); },
  `    "stop" -> { printf("stopped\n"); },
  `    _ -> { printf("idle\n"); }
  `  }
  `}
  `fun main() num {
  `  classify("go");
  `  ret 0;
  `}`;
  let out = emit_c(src, "fit on a string value lowers to strcmp chain");
  assert contains(out, "strcmp(s, \"go\") == 0"), "expected the first label compared by value";
  assert contains(out, "strcmp(s, \"stop\") == 0"), "expected the second label compared by value";
  assert contains(out, "else if"), "expected the labels chained";
}

test "local array of compound stays in the function body" {
  str src = `imp std.c.io;
  `compound P { num x; }
  `fun main() num {
  `  P[] pts = [P{x = 1}, P{x = 2}, P{x = 3}];
  `  num sum = 0;
  `  for p : pts { sum = sum + p.x; }
  `  ret 0;
  `}`;
  let out = emit_c(src, "local array of compound stays in the function body");
  assert contains(out, "P pts[] = {"), "expected the array to keep its local initializer";
  assert contains(out, "sizeof(pts)/sizeof(pts[0])"), "expected the for-each to size the local array";
}

test "local T[] initialized from a pointer emits a C pointer, not an array" {
  str src = `imp std.c.io;
  `imp std.c.mem;
  `fun main() num {
  `  raw* mem = malloc(24);
  `  num[] a = mem;
  `  a[0] = 42;
  `  a[1] = 7;
  `  free(mem);
  `  ret 0;
  `}`;
  let out = emit_c(src, "local T[] initialized from a pointer emits a C pointer, not an array");
  assert contains(out, "int64_t* a = "), "expected a pointer declaration";
}

test "compound initializer field after an address-of-valued field parses correctly" {
  str src = `imp std.c.io;
  `compound Engine { num power; }
  `compound Car { Engine* motor; num wheels; }
  `fun main() num {
  `  Engine e; e.power = 50;
  `  Car c = Car{motor = &e, wheels = 4};
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "compound initializer field after an address-of-valued field parses correctly"
  );
  assert contains(out, ".motor = (&e)"), "expected the address-of field";
  assert contains(out, ".wheels = 4"), "expected the field that follows it";
}

// gap: a generic compound with `impl Box<T> as Lenable` never emits a coercion
// helper, so `Lenable la = &bn;` assigns the raw pointer and dispatch names an
// undeclared `Lenable__size`.
// test "generic compound coerces to a quirk (mangled coercion helper name)" { }

test "sizeof works with generic types, generic instances, and locals" {
  str src = `imp std.c.io;
  `compound Box<T> { T v; }
  `compound Pair<A, B> { A a; B b; }
  `fun main() num {
  `  Box<num> b;
  `  num a = sizeof(Box<num>);
  `  num c = sizeof(b);
  `  num d = sizeof(Pair<num, num>);
  `  num e = sizeof(Box<Box<num>>);
  `  ret 0;
  `}`;
  let out = emit_c(src, "sizeof works with generic types, generic instances, and locals");
  assert contains(out, "sizeof(Box__num)"), "expected a mangled generic operand";
  assert contains(out, "sizeof(b)"), "expected a value operand";
  assert contains(out, "sizeof(Pair__num__num)"), "expected a two-param generic operand";
  assert contains(out, "sizeof(Box__Box__num)"), "expected a nested generic operand";
}

// gap: `sizeof(Nope)` on an undeclared type is accepted and passed through to C.
// test "sizeof on an undeclared type is still rejected" { }

// A constant-zero divisor is rejected by the typechecker, which is where
// the check belongs and where its tests live (typecheck_tests.fn).

test "P5: non-zero and runtime divisors still compile" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num x = 2;
  `  num a = 10 / 2;
  `  num b = 9 % x;
  `  ret 0;
  `}`;
  let out = emit_c(src, "P5: non-zero and runtime divisors still compile");
  assert contains(out, "10 / 2"), "expected the constant division to survive";
  assert contains(out, "9 % x"), "expected the runtime remainder to survive";
}

test "P4: multi-dimensional array indexing (2D/3D) type-checks" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num[2][3] m;
  `  m[0][0] = 5;
  `  m[1][2] = 9;
  `  num[2][2] init = [[1, 2], [3, 4]];
  `  num[2][2][2] t;
  `  t[1][1][1] = 7;
  `  ret 0;
  `}`;
  let out = emit_c(src, "P4: multi-dimensional array indexing (2D/3D) type-checks");
  assert contains(out, "m[2][3]"), "expected a real C 2D array, not a flattened pointer";
  assert contains(out, "init[2][2] = {{1, 2}, {3, 4}}"), "expected the nested initializer";
  assert contains(out, "t[2][2][2]"), "expected a 3D declaration";
}

// gap: a single index of `num[2][3]` yields an array, but assigning it to a
// `num` is accepted instead of rejected.
// test "P4: partial index of a 2D array yields an array, not a num" { }

test "P3: float literals and the range operator coexist" {
  // A trailing dot is a decimal, but a doubled one is the range
  // operator and its first dot must not be eaten by the number.
  str src = `imp std.c.io;
  `fun main() num {
  `  dec a = 1e1;
  `  dec b = 1.5e-1;
  `  dec c = 2E+1;
  `  dec d = 1.;
  `  num total = 0;
  `  for i : 0..3 {
  `    total = total + i;
  `  }
  `  printf("%f %f %f %f %lld\n", a, b, c, d, total);
  `  ret 0;
  `}`;
  let out = emit_c(src, "P3: float literals and the range operator coexist");
  assert contains(out, "10"), "expected the exponent folded into the literal";
  assert contains(out, "0.15"), "expected a negative exponent folded";
  assert contains(out, "20"), "expected an explicitly positive exponent folded";
  assert contains(out, "1.0"), "expected a trailing dot to read as a decimal";
  assert contains(out, "i < 3"), "expected the range operator to survive beside them";
}

test "P3: comparison operators do not maximal-munch a following minus" {
  str src = `imp std.c.io;
  `fun main() num {
  `  num a = 5;
  `  bin ge = a >=-1;
  `  bin le = a <=-1;
  `  bin eq = a ==-5;
  `  bin ne = a !=-5;
  `  num sh = 4; sh >>= 1;
  `  ret 0;
  `}`;
  let out = emit_c(src, "P3: comparison operators do not maximal-munch a following minus");
  assert contains(out, "a >= (-1)"), "expected >= to keep its negative operand";
  assert contains(out, "a <= (-1)"), "expected <= to keep its negative operand";
  assert contains(out, "a == (-5)"), "expected == to keep its negative operand";
  assert contains(out, "a != (-5)"), "expected != to keep its negative operand";
  assert contains(out, "sh >>= 1"), "expected the shift-assign operator to stay intact";
}

test "P3: enum variants accept explicit negative values" {
  str src = `imp std.c.io;
  `enum E { A = -1, B = 0, C = 5 }
  `fun main() num {
  `  E a = E.A;
  `  E c = E.C;
  `  num na = a;
  `  num nc = c;
  `  ret 0;
  `}`;
  let out = emit_c(src, "P3: enum variants accept explicit negative values");
  assert contains(out, "E_A = -1"), "expected the negative variant value";
  assert contains(out, "E_C = 5"), "expected the positive variant value";
}

test "P3: uninstantiated generic compound does not trip false cyclic-dependency" {
  str src = `imp std.c.io;
  `pub compound Box<T> { T v; }
  `pub compound Node<T> { T val; Node<T>* next; }
  `fun main() num {
  `  Node<num> a = Node<num>{val = 7, next = NULL};
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "P3: uninstantiated generic compound does not trip false cyclic-dependency"
  );
  assert contains(out, "Node__num"), "expected the one instantiated template";
  assert !contains(out, "Box__"), "expected the unused template to be dropped";
}

// gap: a genuine by-value compound cycle (A holds B by value, B holds A by
// value) is accepted instead of rejected.
// test "P3: a genuine by-value compound cycle is still rejected" { }

test "private field (leading underscore): same-module read/write/self access works" {
  str src = `imp std.c.io;
  `compound User { num id; num _password; }
  `impl User {
  `  pub set_pw(num p) { self._password = p; }
  `  pub check(num p) bin { ret self._password == p; }
  `}
  `fun main() num {
  `  User u = User{id = 1, _password = 42};
  `  num a = u._password;
  `  u._password = 99;
  `  u.set_pw(7);
  `  ret 0;
  `}`;
  let out = emit_c(
    src,
    "private field (leading underscore): same-module read/write/self access works"
  );
  assert contains(out, "int64_t _password;"), "expected the field name emitted verbatim";
  assert contains(out, "self->_password"), "expected self access inside a method";
  assert contains(out, "u._password = 99"), "expected same-module write access";
}

test "data-carrying enum: construct + pattern-match with payload bindings" {
  str src = `imp std.c.io;
  `enum Val { I(num), Pair(num, num), Nil }
  `fun sum(Val v) num {
  `  fit v {
  `    Val.I(x) -> { ret x; }
  `    Val.Pair(a, b) -> { ret a + b; }
  `    Val.Nil -> { ret 0; }
  `  }
  `  ret -1;
  `}
  `fun main() num {
  `  Val a = Val.I(7);
  `  Val b = Val.Pair(3, 4);
  `  Val c = Val.Nil;
  `  ret 0;
  `}`;
  let out = emit_c(src, "data-carrying enum: construct + pattern-match with payload bindings");
  assert contains(out, "Val_tag"), "expected a discriminant enum";
  assert contains(out, "} payload;"), "expected a payload union";
  assert contains(out, "v.payload.I._0"), "expected the single-payload binding";
  assert contains(out, "v.payload.Pair._0"), "expected the multi-payload binding";
}

test "data-carrying enum: shorthand .Variant(x) and _ catch-all" {
  str src = `imp std.c.io;
  `enum Opt { Some(num), None }
  `fun get(Opt o) num {
  `  fit o {
  `    Opt.Some(v) -> { ret v; }
  `    _ -> { ret -9; }
  `  }
  `  ret 0;
  `}
  `fun main() num { num a = get(Opt.Some(5)); ret 0; }`;
  let out = emit_c(src, "data-carrying enum: shorthand .Variant(x) and _ catch-all");
  assert contains(out, ".tag = Opt_Some"), "expected the tagged construction";
  assert contains(out, "o.payload.Some._0"), "expected the payload binding";
  assert contains(out, "else {"), "expected the catch-all branch";
}

test "data-carrying enum: shorthand construction in typed var-init and return" {
  str src = `imp std.c.io;
  `enum Opt { Some(num), None }
  `fun mk(num x) Opt { ret .Some(x); }
  `fun get(Opt o) num {
  `  fit o {
  `    Opt.Some(v) -> { ret v; }
  `    Opt.None -> { ret -1; }
  `  }
  `  ret 0;
  `}
  `fun main() num {
  `  Opt a = .Some(9);
  `  Opt b = .None;
  `  num c = get(mk(42));
  `  ret 0;
  `}`;
  let out = emit_c(src, "data-carrying enum: shorthand construction in typed var-init and return");
  assert contains(out, ".tag = Opt_Some"), "expected the shorthand to resolve its enum";
  assert contains(out, ".tag = Opt_None"), "expected the payload-free shorthand";
}

test "plain (payload-free) enum still lowers to a C enum" {
  str src = `imp std.c.io;
  `enum Color { Red, Green, Blue }
  `fun main() num { Color c = Color.Green; ret 0; }`;
  let out = emit_c(src, "plain (payload-free) enum still lowers to a C enum");
  assert contains(out, "typedef enum Color {"), "expected a classic C enum";
  assert !contains(out, "Color_tag"), "expected no tagged-union discriminant";
}

test "direct call-site quirk coercion: callee(&concrete) wraps in __fun_coerce" {
  str src = `imp std.c.io;
  `quirk Speaker { speak() str; }
  `compound Dog { num age; }
  `impl Dog as Speaker { speak() str { ret "woof"; } }
  `fun describe(num n, Speaker s, str tag) {
  `  printf("%lld %s %s\n", n, s.speak(), tag);
  `}
  `fun plain(num a, num b) num { ret a + b; }
  `fun main() num {
  `  Dog d = Dog{age = 3};
  `  describe(7, &d, "hi");
  `  ret 0;
  `}`;
  let out = emit_c(src, "direct call-site quirk coercion: callee(&concrete) wraps in __fun_coerce");
  assert contains(out, "describe(7, __fun_coerce_Dog_"), "expected the quirk argument to be wrapped";
  assert contains(out, "int64_t plain(int64_t a, int64_t b)"), "expected the non-quirk callee untouched";
}

test "generic compound coerces to a quirk at a call site and via var-init" {
  str src = `imp std.c.io;
  `quirk Sized { size() num; }
  `compound Box<T> { T v; }
  `impl Box<num> as Sized { size() num { ret 8; } }
  `fun report(Sized s) num { ret s.size(); }
  `fun main() num {
  `  Box<num> b = Box<num>{v = 42};
  `  num viaCall = report(&b);
  `  Sized sz = &b;
  `  num viaVar = sz.size();
  `  ret 0;
  `}`;
  let out = emit_c(src, "generic compound coerces to a quirk at a call site and via var-init");
  assert contains(out, "report(__fun_coerce_Box__num_"), "expected the call site to use the mangled helper";
  assert contains(out, "Sized sz = __fun_coerce_Box__num_"), "expected the var-init to use the mangled helper";
}

// gap: a quirk method called on a call result emits the receiver expression
// twice (`make(&st).vtable->weight(make(&st).self)`), so the receiver call runs
// twice instead of being materialized into a temp.
