// Type checking.
// 
// The checker walks each function body with the types of everything in
// scope, infers the type of every expression it meets, and reports the
// first place where a value cannot stand for the type expected of it.
// Anything it cannot resolve infers as unknown, which stands for any
// type, so a gap in the checker never rejects a correct program.

imp ..ast.ast;
imp ..lexer.token;
imp ..parser.datatype_defs;
imp std.string;
imp std.io;
imp std.vec;
imp std.map;
imp std.set;
imp std.option;
imp std.result;

// What a value is, as far as the checker can tell.
pub compound CheckedType {
  DataTypeType base;
  bin is_array;
  num array_depth;
  num pointer_depth;
  // `nil`, which stands for a pointer or a string of any type.
  bin is_null_literal;
  // `panic(...)`, which never produces a value and so stands for any
  // type expected of it.
  bin is_panic_literal;
  // The written name of a user-defined type, empty for a builtin.
  str name;
  // The arguments a generic instantiation supplied, in the order the
  // type declares its parameters.
  Vec<CheckedType> generic_args;
}

pub fun checked_unknown() CheckedType {
  CheckedType t;
  t.base = .Unknown;
  t.is_array = false;
  t.array_depth = 0;
  t.pointer_depth = 0;
  t.is_null_literal = false;
  t.is_panic_literal = false;
  t.name = "";
  t.generic_args.init(0);
  ret t;
}

pub fun checked_of(DataTypeType base) CheckedType {
  CheckedType t = checked_unknown();
  t.base = base;
  ret t;
}

// The checked form of a written type annotation.
pub fun checked_from_dtype(DataType* dt) CheckedType {
  CheckedType t = checked_unknown();
  if dt == nil {
    ret t;
  }
  t.base = dt.kind;
  t.is_array = dt.is_array;
  t.array_depth = dt.array_depth;
  // An array written without a size carries no depth of its own, but it
  // is still one deep.
  if t.is_array && t.array_depth == 0 {
    t.array_depth = 1;
  }
  t.pointer_depth = dt.pointer_depth;
  if dt.flags.is_pointer && t.pointer_depth == 0 {
    t.pointer_depth = 1;
  }
  if t.base == DataTypeType.Unknown {
    t.name = dt.type_str;
  }
  num i = 0;
  for i < dt.generic_args.len {
    t.generic_args.push(checked_from_dtype(dt.generic_args.get(i)));
    i = i + 1;
  }
  ret t;
}

// Replaces each type parameter in `t` with what the instantiation
// supplied for it, leaving anything else as written.
pub fun substitute(CheckedType t, Vec<str>* params, Vec<CheckedType>* args) CheckedType {
  if params.len == 0 || args.len == 0 {
    ret t;
  }
  num i = 0;
  for i < params.len && i < args.len {
    if !equals(t.name, "") && equals(params.get(i), t.name) {
      // The parameter stands for the argument, while whatever was
      // written around it (a pointer, an array) still applies.
      CheckedType out = args.get(i);
      out.pointer_depth = out.pointer_depth + t.pointer_depth;
      if t.is_array {
        out.is_array = true;
        out.array_depth = out.array_depth + t.array_depth;
      }
      ret out;
    }
    i = i + 1;
  }
  ret t;
}

// A name the checker cannot resolve stands for any type, so it never
// rejects what it does not understand.
pub fun is_unknown(CheckedType t) bin {
  if t.base != DataTypeType.Unknown {
    ret false;
  }
  // A `let` carries a placeholder until its value is known, which is
  // exactly what the checker fills in.
  ret equals(t.name, "") || equals(t.name, LET_INFER_TYPE);
}

// The placeholder the parser writes for a `let` declaration's type.
pub const str LET_INFER_TYPE = "__let_infer__";

pub fun type_name(CheckedType t) str {
  str base = "unknown";
  fit t.base {
    .Void -> { base = "void"; }
    .Raw -> { base = "raw"; }
    .Chr -> { base = "chr"; }
    .Str -> { base = "str"; }
    .Dec -> { base = "dec"; }
    .Num -> { base = "num"; }
    .Bin -> { base = "bin"; }
    .Unknown -> {
      if !equals(t.name, "") {
        base = t.name;
      }
    }
  }
  StringBuilder b = string_builder_init(len(base) + 4);
  b.append(base);
  num i = 0;
  for i < t.pointer_depth {
    b.append("*");
    i = i + 1;
  }
  i = 0;
  for i < t.array_depth {
    b.append("[]");
    i = i + 1;
  }
  ret b.build();
}

// The name an instantiation is registered under, which carries its
// arguments the way an impl on a concrete instantiation is written
// (`impl Vec<str>` registers as `Vec__str`).
pub fun mangled_name(CheckedType t) str {
  if t.generic_args.len == 0 {
    ret t.name;
  }
  StringBuilder b = string_builder_init(len(t.name) + 8);
  b.append(t.name);
  num i = 0;
  for i < t.generic_args.len {
    b.append("__");
    b.append(mangled_name(t.generic_args.get(i)));
    i = i + 1;
  }
  ret b.build();
}

// True when a value of type `from` can stand where `to` is expected.
pub fun can_assign(CheckedType to, CheckedType from) bin {
  if is_unknown(to) || is_unknown(from) {
    ret true;
  }
  if from.is_panic_literal {
    ret true;
  }
  // `nil`, and the zero it is written as, stand for any pointer, and
  // for a string, which is one. Zero remains a number besides.
  if from.is_null_literal && (to.pointer_depth > 0 || to.base == DataTypeType.Str || to.base == DataTypeType.Raw) {
    ret true;
  }
  // A raw pointer stands for any pointer, in either direction, and a
  // string is a pointer.
  if to.base == DataTypeType.Raw && (from.pointer_depth > 0 || from.base == DataTypeType.Str) {
    ret true;
  }
  if from.base == DataTypeType.Raw && (to.pointer_depth > 0 || to.base == DataTypeType.Str) {
    ret true;
  }
  // An array stands for a pointer to what it holds, as it does in C,
  // and an array of characters is what a string is.
  if from.is_array && !to.is_array {
    if to.base == DataTypeType.Str && from.base == DataTypeType.Chr {
      ret true;
    }
    // An array of depth N stands for a pointer of depth N.
    if to.pointer_depth == from.array_depth + from.pointer_depth {
      if to.base == DataTypeType.Raw {
        ret true;
      }
      ret to.base == from.base && equals(to.name, from.name);
    }
  }
  if to.pointer_depth != from.pointer_depth {
    ret false;
  }
  if to.array_depth != from.array_depth {
    ret false;
  }
  // A whole number widens into a decimal, but a decimal does not narrow
  // back into one without being asked to.
  if _is_numeric(to) && _is_numeric(from) {
    ret to.base == DataTypeType.Dec || from.base != DataTypeType.Dec;
  }
  if to.base != from.base {
    ret false;
  }
  if to.base == DataTypeType.Unknown {
    ret equals(to.name, from.name);
  }
  ret true;
}

fun _is_numeric(CheckedType t) bin {
  if t.pointer_depth > 0 || t.is_array {
    ret false;
  }
  // A truth value is not a number: it neither widens into one nor
  // stands for one.
  ret t.base == DataTypeType.Num || t.base == DataTypeType.Dec || t.base == DataTypeType.Chr;
}

// What a function accepts and returns.
pub compound FnSig {
  CheckedType rtype;
  Vec<CheckedType> args;
  // The number of leading parameters a caller must pass; the rest carry
  // defaults.
  num min_args;
  bin is_variadic;
  bin is_async;
  // A generic function's checks are left to the instantiation, since a
  // type parameter stands for whatever the call site supplies.
  bin is_generic;
  // Set when the name belongs to more than one declaration, where a
  // call cannot be matched to one of them by name alone.
  bin ambiguous;
  // The type parameters the declaration names, the types each one is
  // allowed to stand for (empty where unconstrained), and, per
  // parameter, the type parameter it is written as (empty otherwise).
  Vec<str> type_params;
  Vec<Vec<str>> bounds;
  Vec<str> arg_params;
}

// Where checking failed, and why.
pub compound TypeError {
  str message;
  Pos pos;
  bin has_pos;
}

fun _error(str message, Node* node) TypeError {
  TypeError e;
  e.message = message;
  e.has_pos = false;
  if node != nil && node.has_pos {
    e.pos = node.pos;
    e.has_pos = true;
  }
  ret e;
}

// A name in scope: what it holds, and whether it may be assigned again.
pub compound Binding {
  CheckedType type;
  bin is_const;
}

// The names in scope, innermost last.
pub compound TypeEnv {
  Vec<Map<str, Binding>> scopes;
}

pub fun type_env_new() TypeEnv {
  TypeEnv e;
  e.scopes.init(4);
  ret e;
}

impl TypeEnv {
  pub push() {
    Map<str, Binding> scope;
    scope.init(8);
    self.scopes.push(scope);
  }

  pub pop() {
    if self.scopes.len == 0 {
      ret;
    }
    Map<str, Binding> scope = self.scopes.pop();
    scope.free();
  }

  pub define(str name, CheckedType type) {
    self.bind(name, type, false);
  }

  pub bind(str name, CheckedType type, bin is_const) {
    if self.scopes.len == 0 {
      self.push();
    }
    Binding b;
    b.type = type;
    b.is_const = is_const;
    Map<str, Binding>* scope = &self.scopes.data[self.scopes.len - 1];
    scope.put(name, b);
  }

  // What `name` is bound to, searching inner scopes first.
  pub binding(str name) Option<Binding> {
    num i = self.scopes.len;
    for i > 0 {
      i = i - 1;
      Map<str, Binding>* scope = &self.scopes.data[i];
      let found = scope.at(name);
      if found.is_some() {
        ret found;
      }
    }
    ret .None;
  }

  // The type bound to `name`, searching inner scopes first.
  pub lookup(str name) Option<CheckedType> {
    let found = self.binding(name);
    if found.is_none() {
      ret .None;
    }
    ret .Some(found.unwrap().type);
  }

  pub free() {
    for self.scopes.len > 0 {
      self.pop();
    }
    self.scopes.free();
  }
}

// What a compound holds, keyed by field name.
compound CompoundInfo {
  Map<str, CheckedType> fields;
  // The parameters the fields are written in terms of, which an
  // instantiation supplies arguments for.
  Vec<str> type_params;
  // A generic compound's fields mention its type parameters, which
  // stand for whatever an instantiation supplies.
  bin is_generic;
}

// The methods declared on a type, keyed by method name. A quirk's
// methods are registered the same way, since a call reads the same.
compound MethodTable {
  Map<str, FnSig> methods;
}

fun _method_table_new() MethodTable {
  MethodTable t;
  t.methods.init(8);
  ret t;
}

// The bare name of a method whose declared name carries the type it
// belongs to, as `Counter__add` carries `Counter`.
// Drops a method's receiver, which is declared as its first parameter
// but supplied by the call's receiver rather than its arguments.
fun _without_self(FnSig sig, FunctionNode f) FnSig {
  if f.args.len == 0 {
    ret sig;
  }
  bin leads_with_self = false;
  Node* first = f.args.get(0);
  fit first.kind {
    .Variable(v) -> { leads_with_self = equals(v.name, "self"); }
    _ -> {}
  }
  if !leads_with_self {
    ret sig;
  }
  FnSig out = sig;
  out.args.init(sig.args.len);
  num i = 1;
  for i < sig.args.len {
    out.args.push(sig.args.get(i));
    i = i + 1;
  }
  out.min_args = sig.min_args;
  if out.min_args > 0 {
    out.min_args = out.min_args - 1;
  }
  ret out;
}

fun _method_leaf_name(str declared, str type_name) str {
  _ = type_name;
  // The declared name carries the type, and a quirk impl's carries the
  // quirk as well, so the call's own name is what follows the last
  // separator.
  num cut = -1;
  num i = 0;
  for i + 1 < len(declared) {
    if declared[i] == '_' && declared[i + 1] == '_' {
      cut = i + 2;
    }
    i = i + 1;
  }
  if cut < 0 || cut >= len(declared) {
    ret declared;
  }
  ret substr(declared, cut, len(declared) - cut);
}

// The signature a quirk's method declaration promises.
fun _signature_of_quirk_method(QuirkMethodSig m) FnSig {
  FnSig sig;
  sig.args.init(m.args.len);
  sig.rtype = checked_unknown();
  if m.rtype != nil {
    sig.rtype = checked_from_dtype(m.rtype);
  }
  sig.is_variadic = false;
  sig.is_async = m.is_async;
  sig.is_generic = false;
  sig.ambiguous = false;
  sig.min_args = m.args.len;
  for a : m.args {
    sig.args.push(checked_from_dtype(a.dtype));
  }
  ret sig;
}

// What the checker carries while walking one program.
compound Checker {
  Map<str, FnSig> fns;
  // The quirks a program declares. A pointer to a compound that
  // implements one stands where the quirk is expected.
  Set<str> quirks;
  // Enums whose variants carry no payload, which stand for the numbers
  // they are written as.
  Set<str> plain_enums;
  // What each declared compound holds, and what each type and quirk
  // declares as methods.
  Map<str, CompoundInfo> compounds;
  Map<str, MethodTable> methods;
  // The return type of the function being walked, and whether it may
  // await.
  CheckedType rtype;
  bin in_async;
  bin failed;
  TypeError error;
}

fun _checker_new() Checker {
  Checker c;
  c.fns.init(32);
  c.quirks = set_init("", 16);
  c.plain_enums = set_init("", 16);
  c.compounds.init(16);
  c.methods.init(16);
  c.rtype = checked_unknown();
  c.in_async = false;
  c.failed = false;
  ret c;
}

impl Checker {
  // Records the methods an impl block supplies for its type. A generic
  // impl's methods mention type parameters, which stand for whatever an
  // instantiation supplies.
  register_impl(ImplNode block) {
    let existing = self.methods.at(block.type_name);
    MethodTable table = _method_table_new();
    if existing.is_some() {
      table = existing.unwrap();
    }
    for m : block.methods {
      fit m.kind {
        .Function(f) -> {
          if !f.has_name {
            continue;
          }
          FnSig sig = _without_self(_signature_of(f), f);
          if block.has_type_params && block.type_params.len > 0 {
            sig.is_generic = true;
            sig = _erase_signature(sig, &block.type_params);
          }
          // A method's declared name carries the type it belongs to
          // (`Counter__add`), while a call names it on its own.
          table.methods.put(_method_leaf_name(f.name, block.type_name), sig);
        }
        _ -> {}
      }
    }
    self.methods.put(block.type_name, table);
  }

  // True when a value of type `from` can stand where `to` is expected,
  // including where `to` is a quirk a pointer satisfies.
  assignable(CheckedType to, CheckedType from) bin {
    if can_assign(to, from) {
      ret true;
    }
    // An enum with no payloads is written as, and reads as, a number.
    if self.reads_as_number(to) && self.reads_as_number(from) {
      ret true;
    }
    if self.quirks.has(to.name) {
      ret from.pointer_depth > 0 || self.quirks.has(from.name);
    }
    ret false;
  }

  // True for a value that stands in a numeric position: a number, or an
  // enum whose variants carry no payload.
  reads_as_number(CheckedType t) bin {
    if t.pointer_depth > 0 || t.is_array {
      ret false;
    }
    if t.base != DataTypeType.Unknown {
      ret t.base == DataTypeType.Num || t.base == DataTypeType.Chr;
    }
    ret self.plain_enums.has(t.name);
  }

  // Records the first failure; later ones are consequences of it.
  fail(str message, Node* node) {
    if self.failed {
      ret;
    }
    self.failed = true;
    self.error = _error(message, node);
  }
}

// Calls the language supplies rather than a program declaring them.
fun _is_builtin_call(str name) bin {
  fit name {
    "sizeof", "va_start", "va_end", "va_copy", "va_arg_num", "va_arg_dec", "va_arg_bin", "va_arg_chr", "va_arg_str", "va_arg_raw" -> {
      ret true;
    }
    _ -> { ret false; }
  }
}

// True for a name that reads as a type rather than a value, which is
// what `sizeof` measures.
fun _names_a_type(Node* node) bin {
  if node == nil {
    ret false;
  }
  fit node.kind {
    .Identifier(name) -> {
      if keyword_is_datatype(name) {
        ret true;
      }
      ret len(name) > 0 && name[0] >= 'A' && name[0] <= 'Z';
    }
    .Unary(u) -> {
      // A pointer or array spelling of a type still names one.
      ret _names_a_type(u.operand);
    }
    // A generic instantiation is written the way a comparison is, so its
    // type is the name on the left.
    .Expression(e) -> {
      if !e.has_left {
        ret false;
      }
      ret _names_a_type(e.left);
    }
    .ExpressionParenthesis(inner) -> { ret _names_a_type(inner); }
    // A generic instantiation written without fields parses as a
    // compound literal carrying the type it names.
    .CompoundInit(init) -> { ret init.has_dtype && init.fields.len == 0; }
    _ -> { ret false; }
  }
  ret false;
}

// The signature a function declaration promises.
// True when `name` is one of the function's own type parameters, which
// stands for whatever a call site supplies rather than a fixed type.
fun _is_type_param(FunctionNode f, str name) bin {
  if !f.has_type_params {
    ret false;
  }
  for p : f.type_params {
    if equals(p, name) {
      ret true;
    }
  }
  ret false;
}

fun _erase_type_params(FunctionNode f, CheckedType t) CheckedType {
  if _is_type_param(f, t.name) {
    ret checked_unknown();
  }
  ret t;
}

// Erases a type named by one of `names`, which stands for whatever an
// instantiation supplies rather than a type of its own.
fun _erase_named(CheckedType t, Vec<str>* names) CheckedType {
  if equals(t.name, "") {
    ret t;
  }
  num i = 0;
  for i < names.len {
    if equals(names.get(i), t.name) {
      ret checked_unknown();
    }
    i = i + 1;
  }
  ret t;
}

// The same, over a whole signature: an impl's type parameters reach its
// methods' return types and parameters.
fun _erase_signature(FnSig sig, Vec<str>* names) FnSig {
  if names.len == 0 {
    ret sig;
  }
  FnSig out = sig;
  out.rtype = _erase_named(sig.rtype, names);
  out.args.init(sig.args.len);
  num i = 0;
  for i < sig.args.len {
    out.args.push(_erase_named(sig.args.get(i), names));
    i = i + 1;
  }
  ret out;
}

fun _signature_of(FunctionNode f) FnSig {
  FnSig sig;
  sig.args.init(f.args.len);
  sig.rtype = checked_unknown();
  if f.has_rtype {
    sig.rtype = _erase_type_params(f, checked_from_dtype(f.rtype));
  }
  sig.is_variadic = f.is_variadic;
  sig.is_async = f.is_async;
  sig.is_generic = f.has_type_params && f.type_params.len > 0;
  sig.ambiguous = false;
  sig.type_params.init(0);
  sig.bounds.init(0);
  sig.arg_params.init(f.args.len);
  if f.has_type_params {
    for p : f.type_params {
      sig.type_params.push(p);
    }
  }
  if f.has_type_param_forced_insts {
    for b : f.type_param_forced_insts {
      sig.bounds.push(b);
    }
  }
  sig.min_args = 0;
  bin counting = true;
  for a : f.args {
    fit a.kind {
      .Variable(v) -> {
        CheckedType declared = checked_from_dtype(v.var_type);
        str written = "";
        if _is_type_param(f, declared.name) {
          written = declared.name;
        }
        sig.arg_params.push(written);
        sig.args.push(_erase_type_params(f, declared));
        // A parameter with a default value, and everything after it,
        // may be left out by the caller.
        if v.has_val {
          counting = false;
        } elif counting {
          sig.min_args = sig.min_args + 1;
        }
      }
      _ -> {
        sig.arg_params.push("");
        sig.args.push(checked_unknown());
      }
    }
  }
  ret sig;
}

// The name a call's callee refers to, empty when it is not a plain call
// to a named function.
fun _callee_name(Node* callee) str {
  if callee == nil {
    ret "";
  }
  fit callee.kind {
    .Identifier(name) -> { ret name; }
    _ -> { ret ""; }
  }
}

// The arguments of a call, whose AST shape is a comma expression when
// there is more than one.
fun _call_args(Node* node, Vec<Node*>* out) {
  if node == nil {
    ret;
  }
  fit node.kind {
    .Expression(e) -> {
      if equals(e.op, ",") && e.has_left && e.has_right {
        _call_args(e.left, out);
        _call_args(e.right, out);
        ret;
      }
    }
    // A call's argument list is parenthesized, and the parentheses are
    // a node of their own.
    .ExpressionParenthesis(inner) -> {
      _call_args(inner, out);
      ret;
    }
    // An empty argument list still carries a node, which is not an
    // argument.
    .Blank -> { ret; }
    _ -> {}
  }
  out.push(node);
}

impl Checker {
  // The type a literal, name, or operator expression produces. Anything
  // the checker does not model infers as unknown.
  infer(Node* node, TypeEnv* env) CheckedType {
    if node == nil {
      ret checked_unknown();
    }
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Dec(_) -> { ret checked_of(DataTypeType.Dec); }
          .Cval(_) -> { ret checked_of(DataTypeType.Chr); }
          .Num(value) -> {
            CheckedType t = checked_of(DataTypeType.Num);
            // Zero is how a null pointer is written.
            t.is_null_literal = value == 0;
            ret t;
          }
          _ -> { ret checked_of(DataTypeType.Num); }
        }
      }
      .String(_) -> { ret checked_of(DataTypeType.Str); }
      .Character(_) -> { ret checked_of(DataTypeType.Chr); }
      .Boolean(_) -> { ret checked_of(DataTypeType.Bin); }
      .Nil -> {
        CheckedType t = checked_of(DataTypeType.Raw);
        t.is_null_literal = true;
        ret t;
      }
      .Panic(_) -> {
        CheckedType t = checked_unknown();
        t.is_panic_literal = true;
        ret t;
      }
      .Identifier(name) -> {
        let found = env.lookup(name);
        if found.is_some() {
          ret found.unwrap();
        }
        ret checked_unknown();
      }
      .ExpressionParenthesis(inner) -> { ret self.infer(inner, env); }
      .Bracket(items) -> { ret self.infer_bracket(node, items, env); }
      .Unary(u) -> { ret self.infer_unary(u, env); }
      .Expression(e) -> { ret self.infer_expression(node, e, env); }
      _ -> { ret checked_unknown(); }
    }
    ret checked_unknown();
  }

  // The type an array literal holds, which every element must share.
  infer_bracket(Node* node, Node* items, TypeEnv* env) CheckedType {
    Vec<Node*> elements;
    elements.init(4);
    defer elements.free();
    _call_args(items, &elements);

    CheckedType held = checked_unknown();
    num i = 0;
    for i < elements.len {
      CheckedType element = self.infer(elements.get(i), env);
      i = i + 1;
      if is_unknown(element) {
        continue;
      }
      if is_unknown(held) {
        held = element;
        continue;
      }
      if !can_assign(held, element) && !can_assign(element, held) {
        self.fail(
          format(
            "an array literal holds one type, found {str} and {str}",
            type_name(held),
            type_name(element)
          ),
          node
        );
        ret checked_unknown();
      }
    }
    if is_unknown(held) {
      ret checked_unknown();
    }
    CheckedType t = held;
    t.is_array = true;
    t.array_depth = held.array_depth + 1;
    ret t;
  }

  infer_unary(UnaryNode u, TypeEnv* env) CheckedType {
    if equals(u.op, "await") {
      ret self.check_await(u, env);
    }
    CheckedType operand = self.infer(u.operand, env);
    if equals(u.op, "&") {
      CheckedType t = operand;
      t.pointer_depth = operand.pointer_depth + 1;
      ret t;
    }
    if equals(u.op, "*") {
      if operand.pointer_depth == 0 {
        ret checked_unknown();
      }
      CheckedType t = operand;
      t.pointer_depth = operand.pointer_depth - 1;
      ret t;
    }
    if equals(u.op, "!") {
      ret checked_of(DataTypeType.Bin);
    }
    ret operand;
  }

  // The type a binary operator produces, checking a call's arguments
  // against what the callee declares along the way.
  infer_expression(Node* node, ExprNode e, TypeEnv* env) CheckedType {
    if equals(e.op, "()") {
      ret self.check_call(node, e, env, false);
    }
    if _is_assignment(e.op) {
      self.check_assignment(node, e, env);
      ret checked_unknown();
    }
    // A decimal has no remainder to take.
    if equals(e.op, "%") && e.has_left && e.has_right {
      CheckedType left = self.infer(e.left, env);
      CheckedType right = self.infer(e.right, env);
      if left.base == DataTypeType.Dec || right.base == DataTypeType.Dec {
        self.fail("the remainder operator does not apply to a decimal", node);
        ret checked_unknown();
      }
    }
    if equals(e.op, ".") {
      ret self.infer_field(node, e, env);
    }
    // An index reads what the sequence holds, which the checker follows
    // only through an array.
    if equals(e.op, "[]") {
      if !e.has_left {
        ret checked_unknown();
      }
      CheckedType base = self.infer(e.left, env);
      if !base.is_array {
        ret checked_unknown();
      }
      CheckedType held = base;
      held.array_depth = base.array_depth - 1;
      held.is_array = held.array_depth > 0;
      ret held;
    }
    if equals(e.op, ",") {
      ret checked_unknown();
    }
    if _is_comparison(e.op) || _is_logical(e.op) {
      ret checked_of(DataTypeType.Bin);
    }
    if !e.has_left {
      ret checked_unknown();
    }
    CheckedType left = self.infer(e.left, env);
    if !e.has_right {
      ret left;
    }
    CheckedType right = self.infer(e.right, env);
    // Arithmetic on two numeric kinds widens to the wider one.
    if right.base == DataTypeType.Dec && left.base == DataTypeType.Num {
      ret right;
    }
    if is_unknown(left) {
      ret right;
    }
    ret left;
  }

  // The type a field access reads, and the name of the type it reads
  // from. A method call is a field access whose result is called.
  infer_field(Node* node, ExprNode e, TypeEnv* env) CheckedType {
    if !e.has_left || !e.has_right {
      ret checked_unknown();
    }
    CheckedType receiver = self.infer(e.left, env);
    str field = _callee_name(e.right);
    if equals(field, "") {
      ret checked_unknown();
    }
    let info = self.compounds.at(receiver.name);
    if info.is_none() {
      ret checked_unknown();
    }
    CompoundInfo holder = info.unwrap();
    let found = holder.fields.at(field);
    if found.is_some() {
      CheckedType declared = found.unwrap();
      if holder.is_generic {
        // Without the arguments the instantiation supplied, the field's
        // type is whatever the parameter stood for.
        if receiver.generic_args.len == 0 {
          ret checked_unknown();
        }
        ret substitute(declared, &holder.type_params, &receiver.generic_args);
      }
      ret declared;
    }
    if holder.is_generic && receiver.generic_args.len == 0 {
      ret checked_unknown();
    }
    // A method reads as a field until it is called.
    if self.has_method(receiver.name, field) {
      ret checked_unknown();
    }
    self.fail(format("'{str}' has no field '{str}'", receiver.name, field), node);
    ret checked_unknown();
  }

  has_method(str type_name, str method) bin {
    let table = self.methods.at(type_name);
    if table.is_none() {
      ret false;
    }
    MethodTable found = table.unwrap();
    ret found.methods.at(method).is_some();
  }

  // A method reaches a receiver either through an impl on its
  // instantiation or through one on the type itself.
  receiver_method(CheckedType receiver, str method) Option<FnSig> {
    str instantiated = mangled_name(receiver);
    if !equals(instantiated, receiver.name) {
      let found = self.method_signature(instantiated, method);
      if found.is_some() {
        ret found;
      }
    }
    ret self.method_signature(receiver.name, method);
  }

  // The signature of `method` on `type_name`, if the type declares one.
  method_signature(str type_name, str method) Option<FnSig> {
    let table = self.methods.at(type_name);
    if table.is_none() {
      ret .None;
    }
    MethodTable found = table.unwrap();
    ret found.methods.at(method);
  }

  // The signature a call through a receiver resolves to, if the checker
  // can name both the receiver's type and the method.
  resolve_method_call(ExprNode callee, TypeEnv* env) Option<FnSig> {
    if !callee.has_left || !callee.has_right {
      ret .None;
    }
    CheckedType receiver = self.infer(callee.left, env);
    if equals(receiver.name, "") {
      ret .None;
    }
    str method = _callee_name(callee.right);
    if equals(method, "") {
      ret .None;
    }
    ret self.receiver_method(receiver, method);
  }

  // True when a call through a receiver reaches an async method, or one
  // the checker cannot resolve, which it does not second-guess.
  awaits_async_method(ExprNode e, TypeEnv* env) bin {
    if !e.has_left {
      ret true;
    }
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") {
          ret true;
        }
        let resolved = self.resolve_method_call(callee, env);
        if resolved.is_none() {
          ret true;
        }
        ret resolved.unwrap().is_async;
      }
      _ -> { ret true; }
    }
    ret true;
  }

  // Checks a call written through a receiver, which resolves to a
  // method the receiver's type declares.
  check_method_call(Node* node, ExprNode e, Vec<Node*>* args, TypeEnv* env, bin awaited) CheckedType {
    if !e.has_left {
      ret checked_unknown();
    }
    Option<FnSig> resolved = .None;
    str method = "";
    fit e.left.kind {
      .Expression(callee) -> {
        if equals(callee.op, ".") {
          method = _callee_name(callee.right);
          resolved = self.resolve_method_call(callee, env);
        }
      }
      _ -> {}
    }
    if resolved.is_none() {
      self.check_receiver_has_method(node, e, method, env);
      ret checked_unknown();
    }
    FnSig sig = resolved.unwrap();
    if sig.is_async && !awaited {
      self.fail(format("call to async method '{str}' needs await", method), node);
      ret checked_unknown();
    }
    self.check_arguments(node, method, sig, args, env);
    ret sig.rtype;
  }

  // Checks the types a call supplies for the callee's type parameters
  // against the types each one is allowed to stand for.
  check_type_bounds(Node* node, str name, FnSig sig, Vec<Node*>* args, TypeEnv* env) {
    if sig.bounds.len == 0 || sig.type_params.len == 0 {
      ret;
    }
    num p = 0;
    for p < sig.type_params.len {
      str param = sig.type_params.get(p);
      // Each entry names one concrete type per parameter, so what this
      // parameter may stand for is that position across the entries.
      Vec<str> allowed;
      allowed.init(sig.bounds.len);
      defer allowed.free();
      num b = 0;
      for b < sig.bounds.len {
        Vec<str> combination = sig.bounds.get(b);
        b = b + 1;
        if p < combination.len {
          allowed.push(combination.get(p));
        }
      }
      p = p + 1;
      if allowed.len == 0 {
        continue;
      }
      // The first argument written as this parameter is what it stands
      // for at this call.
      num i = 0;
      for i < args.len && i < sig.arg_params.len {
        str written = sig.arg_params.get(i);
        num at = i;
        i = i + 1;
        if !equals(written, param) {
          continue;
        }
        CheckedType supplied = self.infer(args.get(at), env);
        if is_unknown(supplied) {
          break;
        }
        str supplied_name = type_name(supplied);
        bin listed = false;
        num a = 0;
        for a < allowed.len {
          if equals(allowed.get(a), supplied_name) {
            listed = true;
          }
          a = a + 1;
        }
        if !listed {
          self.fail(
            format("'{str}' does not accept {str} for '{str}'", name, supplied_name, param),
            node
          );
          ret;
        }
        break;
      }
    }
  }

  // Reports a method called on a value whose type declares none. Only a
  // receiver the checker resolved completely is judged, so an unmodelled
  // one is left alone.
  check_receiver_has_method(Node* node, ExprNode e, str method, TypeEnv* env) {
    if equals(method, "") || !e.has_left {
      ret;
    }
    fit e.left.kind {
      .Expression(callee) -> {
        if !equals(callee.op, ".") || !callee.has_left {
          ret;
        }
        CheckedType receiver = self.infer(callee.left, env);
        // Only a builtin is judged here: it declares no methods at all,
        // while a named type reaches them through impls the checker does
        // not always see, and a pointer or array is not the receiver
        // itself.
        if receiver.base == DataTypeType.Unknown || receiver.pointer_depth > 0 || receiver.is_array {
          ret;
        }
        if self.receiver_method(receiver, method).is_some() {
          ret;
        }
        self.fail(format("{str} has no method '{str}'", type_name(receiver), method), node);
      }
      _ -> {}
    }
  }

  // Checks the arguments of a call against what the callee declares. A
  // generic callee's parameters stand for whatever the call supplies,
  // so only the shape of such a call is checked.
  check_arguments(Node* node, str name, FnSig sig, Vec<Node*>* args, TypeEnv* env) {
    if !sig.is_variadic {
      if args.len > sig.args.len {
        self.fail(format("too many arguments to '{str}'", name), node);
        ret;
      }
      if args.len < sig.min_args {
        self.fail(format("too few arguments to '{str}'", name), node);
        ret;
      }
    }
    if sig.is_generic {
      self.check_type_bounds(node, name, sig, args, env);
      ret;
    }
    num i = 0;
    for i < args.len && i < sig.args.len {
      CheckedType want = sig.args.get(i);
      CheckedType got = self.infer(args.get(i), env);
      if !self.assignable(want, got) {
        self.fail(
          format(
            "argument {num} of '{str}' expects {str}, found {str}",
            i + 1,
            name,
            type_name(want),
            type_name(got)
          ),
          args.get(i)
        );
        ret;
      }
      i = i + 1;
    }
  }

  // Checks `await operand`: only an async function may await, and only
  // an async call is worth awaiting.
  check_await(UnaryNode u, TypeEnv* env) CheckedType {
    if !self.in_async {
      self.fail("await is only allowed in an async function", u.operand);
      ret checked_unknown();
    }
    if !self.awaits_async_call(u.operand, env) {
      self.fail("await expects a call to an async function", u.operand);
      ret checked_unknown();
    }
    ret self.infer_awaited(u.operand, env);
  }

  // The type an awaited call produces, checked as an ordinary call.
  infer_awaited(Node* operand, TypeEnv* env) CheckedType {
    if operand == nil {
      ret checked_unknown();
    }
    fit operand.kind {
      .Expression(e) -> {
        if equals(e.op, "()") {
          ret self.check_call(operand, e, env, true);
        }
      }
      .ExpressionParenthesis(inner) -> { ret self.infer_awaited(inner, env); }
      _ -> {}
    }
    ret self.infer(operand, env);
  }

  // True when `node` calls something the checker knows to be async, or
  // something it cannot resolve, which it does not second-guess.
  awaits_async_call(Node* node, TypeEnv* env) bin {
    if node == nil {
      ret false;
    }
    fit node.kind {
      .ExpressionParenthesis(inner) -> { ret self.awaits_async_call(inner, env); }
      .Expression(e) -> {
        if !equals(e.op, "()") {
          ret false;
        }
        if !e.has_left {
          ret true;
        }
        str name = _callee_name(e.left);
        if equals(name, "") {
          ret self.awaits_async_method(e, env);
        }
        let known = self.fns.at(name);
        if known.is_none() {
          ret true;
        }
        FnSig sig = known.unwrap();
        if sig.ambiguous {
          ret true;
        }
        ret sig.is_async;
      }
      _ -> { ret false; }
    }
    ret false;
  }

  // Checks a call against the callee's signature and reports its return
  // type.
  check_call(Node* node, ExprNode e, TypeEnv* env, bin awaited) CheckedType {
    Vec<Node*> args;
    args.init(4);
    defer args.free();
    if e.has_right {
      _call_args(e.right, &args);
    }

    num i = 0;
    for i < args.len {
      _ = self.infer(args.get(i), env);
      i = i + 1;
    }

    str name = "";
    if e.has_left {
      name = _callee_name(e.left);
    }
    if equals(name, "") {
      ret self.check_method_call(node, e, &args, env, awaited);
    }
    if _is_builtin_call(name) {
      if equals(name, "sizeof") {
        if args.len != 1 || !_names_a_type(args.get(0)) {
          self.fail("sizeof measures a type", node);
        }
        ret checked_of(DataTypeType.Num);
      }
      ret checked_unknown();
    }
    let known = self.fns.at(name);
    if known.is_none() {
      // A name bound in scope holds a function rather than naming one.
      if env.lookup(name).is_none() {
        self.fail(format("no function named '{str}'", name), node);
      }
      ret checked_unknown();
    }
    FnSig sig = known.unwrap();
    if sig.ambiguous {
      ret checked_unknown();
    }
    // An async call produces its value only once awaited.
    if sig.is_async && !awaited {
      self.fail(format("call to async function '{str}' needs await", name), node);
      ret checked_unknown();
    }
    self.check_arguments(node, name, sig, &args, env);
    ret sig.rtype;
  }
}

// True for `=` and the operators that read and write in one step.
fun _is_assignment(str op) bin {
  if equals(op, "=") {
    ret true;
  }
  if len(op) < 2 || op[len(op) - 1] != '=' {
    ret false;
  }
  str head = substr(op, 0, len(op) - 1);
  ret equals(head, "+") || equals(head, "-") || equals(head, "*") || equals(head, "/") || equals(
    head,
    "%"
  ) || equals(head, "&") || equals(head, "|") || equals(head, "^") || equals(head, "<<") || equals(
    head,
    ">>"
  );
}

fun _is_comparison(str op) bin {
  ret equals(op, "==") || equals(op, "!=") || equals(op, "<") || equals(op, ">") || equals(
    op,
    "<="
  ) || equals(op, ">=");
}

fun _is_logical(str op) bin {
  ret equals(op, "&&") || equals(op, "||");
}

impl Checker {
  // A condition asks a question, so it holds a truth value rather than
  // something that merely stands in for one.
  check_condition(Node* condition, TypeEnv* env) {
    CheckedType t = self.infer(condition, env);
    if is_unknown(t) || t.base == DataTypeType.Bin {
      ret;
    }
    self.fail(format("a condition expects bin, found {str}", type_name(t)), condition);
  }

  // Walks an expression written as a statement, for the checks made
  // along the way rather than for the type it produces.
  walk_expr(Node* node, TypeEnv* env) {
    _ = self.infer(node, env);
  }

  // Walks a statement, checking whatever it declares, returns, or
  // evaluates.
  check_statement(Node* stmt, TypeEnv* env) {
    if stmt == nil || self.failed {
      ret;
    }
    fit stmt.kind {
      .Body(body) -> {
        env.push();
        for s : body.statements {
          self.check_statement(s, env);
        }
        env.pop();
      }
      .Variable(v) -> { self.check_variable(stmt, v, env); }
      .StatementReturn(value) -> { self.check_return(stmt, value, env); }
      .StatementIf(ifn) -> {
        self.check_condition(ifn.condition, env);
        self.check_statement(ifn.body, env);
      }
      .StatementElseIf(ein) -> {
        self.check_condition(ein.condition, env);
        self.check_statement(ein.body, env);
      }
      .StatementElse(body) -> { self.check_statement(body, env); }
      .StatementDefer(inner) -> { self.check_statement(inner, env); }
      .StatementFor(kind) -> { self.check_for(kind, env); }
      .Expression(_) -> { self.walk_expr(stmt, env); }
      .ExpressionParenthesis(_) -> { self.walk_expr(stmt, env); }
      .Unary(_) -> { self.walk_expr(stmt, env); }
      _ -> {}
    }
  }

  check_for(ForKind kind, TypeEnv* env) {
    env.push();
    fit kind {
      .Cond(c) -> {
        if c.has_condition {
          _ = self.infer(c.condition, env);
        }
        self.check_statement(c.body, env);
      }
      .Range(r) -> {
        env.define(r.index_name, checked_of(DataTypeType.Num));
        self.check_statement(r.body, env);
      }
      .Iter(it) -> {
        // What the loop walks holds values of a type the checker does
        // not model yet.
        env.define(it.item_name, checked_unknown());
        if it.has_index_name {
          env.define(it.index_name, checked_of(DataTypeType.Num));
        }
        self.check_statement(it.body, env);
      }
    }
    env.pop();
  }

  // Rejects an assignment to a name declared const, and checks that the
  // value assigned fits what the name holds.
  check_assignment(Node* node, ExprNode e, TypeEnv* env) {
    if !e.has_left {
      ret;
    }
    fit e.left.kind {
      .Identifier(name) -> {
        let bound = env.binding(name);
        if bound.is_none() {
          ret;
        }
        Binding b = bound.unwrap();
        if b.is_const {
          self.fail(format("cannot assign to '{str}', which is const", name), node);
          ret;
        }
        if !equals(e.op, "=") || !e.has_right {
          ret;
        }
        CheckedType value = self.infer(e.right, env);
        if !self.assignable(b.type, value) {
          self.fail(
            format(
              "cannot assign {str} to '{str}' of type {str}",
              type_name(value),
              name,
              type_name(b.type)
            ),
            node
          );
        }
      }
      _ -> {}
    }
  }

  check_variable(Node* stmt, VariableNode v, TypeEnv* env) {
    CheckedType declared = checked_from_dtype(v.var_type);
    if v.has_val {
      CheckedType value = self.infer(v.val, env);
      // A `let` takes the type of its value rather than checking one.
      if is_unknown(declared) {
        // A quirk names a contract rather than a type a value can be
        // stored as, so it cannot be what a `let` infers.
        if self.quirks.has(value.name) {
          self.fail(
            format("cannot infer a type for '{str}': '{str}' is a quirk", v.name, value.name),
            stmt
          );
          ret;
        }
        declared = value;
      } elif !self.assignable(declared, value) {
        self.fail(
          format(
            "cannot initialize '{str}' of type {str} with {str}",
            v.name,
            type_name(declared),
            type_name(value)
          ),
          stmt
        );
        ret;
      }
    }
    env.bind(v.name, declared, v.is_const);
  }

  check_return(Node* stmt, Node* value, TypeEnv* env) {
    if value == nil {
      ret;
    }
    CheckedType got = self.infer(value, env);
    if !self.assignable(self.rtype, got) {
      self.fail(
        format(
          "cannot return {str} from a function returning {str}",
          type_name(got),
          type_name(self.rtype)
        ),
        stmt
      );
    }
  }

  // Walks one function with the globals and its parameters in scope.
  // Walks the methods an impl block supplies, with the receiver bound to
  // the type they belong to.
  check_impl(ImplNode block, Vec<Node>* nodes) {
    // A generic impl's methods are written in terms of type parameters
    // the checker does not substitute, so their bodies are left alone.
    if block.has_type_params && block.type_params.len > 0 {
      ret;
    }
    for m : block.methods {
      fit m.kind {
        .Function(f) -> { self.check_function_with_self(f, nodes, block.type_name); }
        _ -> {}
      }
      if self.failed {
        ret;
      }
    }
  }

  // Reports a method a quirk requires that the impl block does not
  // supply.
  check_quirk_conformance(ImplNode block) {
    if !block.has_quirk_name {
      ret;
    }
    let declared = self.methods.at(block.quirk_name);
    if declared.is_none() {
      ret;
    }
    MethodTable required = declared.unwrap();
    Vec<str> names = required.methods.keys();
    defer names.free();
    num i = 0;
    for i < names.len {
      str name = names.get(i);
      i = i + 1;
      let supplied = self.method_signature(block.type_name, name);
      if supplied.is_none() {
        self.fail(
          format(
            "'{str}' does not supply '{str}', which '{str}' requires",
            block.type_name,
            name,
            block.quirk_name
          ),
          nil
        );
        ret;
      }
      // A method that must be awaited is not interchangeable with one
      // that must not be.
      let promised = required.methods.at(name);
      if promised.is_some() && promised.unwrap().is_async != supplied.unwrap().is_async {
        self.fail(
          format(
            "'{str}' does not match how '{str}' declares '{str}'",
            block.type_name,
            block.quirk_name,
            name
          ),
          nil
        );
        ret;
      }
    }
  }

  check_function(FunctionNode f, Vec<Node>* nodes) {
    self.check_function_with_self(f, nodes, "");
  }

  check_function_with_self(FunctionNode f, Vec<Node>* nodes, str self_type) {
    if !f.has_body {
      ret;
    }
    TypeEnv env = type_env_new();
    defer env.free();
    env.push();
    num g = 0;
    for g < nodes.len {
      Node* global = &nodes.data[g];
      g = g + 1;
      fit global.kind {
        .Variable(v) -> {
          env.bind(v.name, checked_from_dtype(v.var_type), v.is_const);
        }
        _ -> {}
      }
    }
    env.push();
    if !equals(self_type, "") {
      CheckedType receiver = checked_unknown();
      receiver.name = self_type;
      env.define("self", receiver);
    }
    for a : f.args {
      fit a.kind {
        .Variable(v) -> {
          env.define(v.name, _erase_type_params(f, checked_from_dtype(v.var_type)));
        }
        _ -> {}
      }
    }
    CheckedType previous = self.rtype;
    bin previous_async = self.in_async;
    self.in_async = f.is_async;
    self.rtype = checked_unknown();
    if f.has_rtype {
      self.rtype = _erase_type_params(f, checked_from_dtype(f.rtype));
    }
    self.check_statement(f.body, &env);
    self.rtype = previous;
    self.in_async = previous_async;
    env.pop();
    env.pop();
  }
}

// Checks a whole program, reporting the first type error it finds.
pub fun typecheck_program(Vec<Node>* nodes) Result<bin, TypeError> {
  Checker checker = _checker_new();
  defer checker.fns.free();
  defer checker.quirks.free();
  defer checker.plain_enums.free();
  defer checker.compounds.free();
  defer checker.methods.free();

  num i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .Function(f) -> {
        if f.has_name {
          FnSig sig = _signature_of(f);
          // A name that resolves to more than one declaration cannot be
          // matched to one of them here.
          let existing = checker.fns.at(f.name);
          if existing.is_some() {
            sig.ambiguous = true;
          }
          checker.fns.put(f.name, sig);
        }
      }
      .Quirk(q) -> {
        checker.quirks.add(q.name);
        MethodTable table = _method_table_new();
        for m : q.methods {
          // A generic quirk's methods mention its type parameters, which
          // stand for whatever the implementing type supplies.
          FnSig sig = _signature_of_quirk_method(m);
          if q.is_generic {
            sig = _erase_signature(sig, &q.type_params);
          }
          table.methods.put(m.name, sig);
        }
        checker.methods.put(q.name, table);
      }
      .Enum(e) -> {
        bin carries_data = false;
        for v : e.variants {
          if v.has_payload && v.payload.len > 0 {
            carries_data = true;
          }
        }
        if !carries_data {
          checker.plain_enums.add(e.name);
        }
      }
      .Compound(c) -> {
        CompoundInfo info;
        info.fields.init(c.fields.len + 1);
        info.type_params.init(0);
        info.is_generic = c.has_type_params && c.type_params.len > 0;
        if c.has_type_params {
          for p : c.type_params {
            info.type_params.push(p);
          }
        }
        for field : c.fields {
          info.fields.put(field.name, checked_from_dtype(field.dtype));
        }
        checker.compounds.put(c.name, info);
      }
      .Impl(block) -> { checker.register_impl(block); }
      _ -> {}
    }
  }

  i = 0;
  for i < nodes.len {
    Node* node = &nodes.data[i];
    i = i + 1;
    fit node.kind {
      .Function(f) -> { checker.check_function(f, nodes); }
      .Impl(block) -> {
        checker.check_quirk_conformance(block);
        checker.check_impl(block, nodes);
      }
      _ -> {}
    }
    if checker.failed {
      ret .Err(checker.error);
    }
  }
  ret .Ok(true);
}

test "a value stands for a type it can be assigned to" {
  CheckedType num_t = checked_of(DataTypeType.Num);
  CheckedType dec_t = checked_of(DataTypeType.Dec);
  CheckedType str_t = checked_of(DataTypeType.Str);
  CheckedType bin_t = checked_of(DataTypeType.Bin);
  assert can_assign(dec_t, num_t), "expected a whole number to widen into a decimal";
  assert !can_assign(num_t, dec_t), "expected a decimal not to narrow on its own";
  assert !can_assign(num_t, str_t), "expected a string not to stand for a number";
  assert !can_assign(num_t, bin_t), "expected a truth value not to stand for a number";
  assert can_assign(checked_unknown(), str_t), "expected an unresolved type to accept anything";
}

test "nil and zero stand for a pointer, and zero stays a number" {
  CheckedType raw_t = checked_of(DataTypeType.Raw);
  raw_t.pointer_depth = 1;
  CheckedType zero = checked_of(DataTypeType.Num);
  zero.is_null_literal = true;
  assert can_assign(raw_t, zero), "expected zero to stand for a null pointer";
  assert can_assign(checked_of(DataTypeType.Num), zero), "expected zero to remain a number";
}

test "an array stands for a pointer to what it holds" {
  CheckedType chars;
  chars = checked_of(DataTypeType.Chr);
  chars.is_array = true;
  chars.array_depth = 1;
  assert can_assign(checked_of(DataTypeType.Str), chars), "expected characters to stand for a string";
}

test "a written type reads back as what it was written as" {
  CheckedType pointer = checked_of(DataTypeType.Num);
  pointer.pointer_depth = 1;
  assert equals(type_name(pointer), "num*"), "expected the pointer spelling";
  CheckedType named = checked_unknown();
  named.name = "Counter";
  assert equals(type_name(named), "Counter"), "expected the written name";
}

test "a scope hides an outer binding of the same name" {
  TypeEnv env = type_env_new();
  defer env.free();
  env.push();
  env.define("x", checked_of(DataTypeType.Num));
  env.push();
  env.define("x", checked_of(DataTypeType.Str));
  let inner = env.lookup("x");
  assert inner.is_some(), "expected the name to resolve";
  assert inner.unwrap().base == DataTypeType.Str, "expected the inner binding";
  env.pop();
  let outer = env.lookup("x");
  assert outer.unwrap().base == DataTypeType.Num, "expected the outer binding to return";
}
