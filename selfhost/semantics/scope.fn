// Lexical scope tracking for the self-hosted Fun compiler.
// 
// Ported from the original semantics module's scope tracking. `iterate_back`/
// `start_iteration` (a "peek pointer" backward-iteration mechanism on the
// original's entity vector) are dropped -- confirmed via grepping the whole
// codebase that nothing calls them anywhere outside their own definitions.

imp ..ast.ast;
imp std.vec;
imp std.string;

// A single declared name (variable, parameter, loop binding, ...) visible
// within a Scope.
pub compound ScopeEntity {
  bin on_stack;
  Node* node;
  bin has_node;
  str name;
  // For multi-dimensional array elements: the root array name used to
  // compute sizeof chain bounds for nested for-iter loops. Empty for
  // non-multidim entities.
  str multidim_root;
  bin has_multidim_root;
  // How many dimensions deep this element is from multidim_root (0 = root
  // itself).
  num multidim_depth;
}

pub fun scope_entity_new(str name) ScopeEntity {
  ScopeEntity e;
  e.on_stack = false;
  e.node = nil;
  e.has_node = false;
  e.name = name;
  e.multidim_root = "";
  e.has_multidim_root = false;
  e.multidim_depth = 0;
  ret e;
}

// One lexical scope level (a function body, a block, a loop, ...), holding
// the names declared directly in it and a link to its enclosing scope.
pub compound Scope {
  Vec<ScopeEntity*> entities;
  Scope* parent;
  bin has_parent;
}

pub fun scope_new() Scope {
  Scope s;
  s.entities.init(0);
  s.parent = nil;
  s.has_parent = false;
  ret s;
}

impl Scope {
  // The most recently declared entity directly in THIS scope (not its
  // parents), or nil if none.
  pub last_entity_at_scope() ScopeEntity* {
    if self.entities.len == 0 {
      ret nil;
    }
    ret self.entities.get(self.entities.len - 1);
  }

  // Walks up the parent chain for the last-declared entity, stopping at (not
  // including) `stop_scope`. `stop_scope` may be nil to search the whole chain.
  pub last_entity_from_scope_stop_at(Scope* stop_scope) ScopeEntity* {
    if self == stop_scope {
      ret nil;
    }
    let last = self.last_entity_at_scope();
    if last != nil {
      ret last;
    }
    if self.has_parent {
      ret self.parent.last_entity_from_scope_stop_at(stop_scope);
    }
    ret nil;
  }

  // Looks up an entity declared directly in THIS scope (not its parents) by
  // name, or nil if not found.
  pub get_entity_by_name(str name) ScopeEntity* {
    num i = 0;
    for i < self.entities.len {
      let e = self.entities.get(i);
      if equals(e.name, name) {
        ret e;
      }
      i = i + 1;
    }
    ret nil;
  }

  // Scope does not own the entity pointers (some call sites hold pointers to
  // stack-allocated entities); only the backing vector is freed.
  pub deinit() {
    self.entities.free();
  }
}
