test "emit_statement resolves a bare-shorthand 'ret' against the enclosing function's return type" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Option", variants, true);

  FunctionNode fnv = function_node_new();
  fnv.name = "mk";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "Option";
  fnv.rtype = rtype;
  fnv.has_rtype = true;

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Expression(dot));

  Node* arg = malloc(sizeof(Node));
  *arg = node_new(NodeKind.Identifier("x"));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(arg));

  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* ret_val = malloc(sizeof(Node));
  *ret_val = node_new(NodeKind.Expression(call_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(ret_val));

  DataType* x_dt = malloc(sizeof(DataType));
  *x_dt = dtype_new();
  x_dt.type_str = "num";
  VariableNode xv;
  xv.var_type = x_dt;
  xv.name = "x";
  xv.has_val = false;
  xv.is_const = false;
  Node* x_param = malloc(sizeof(Node));
  *x_param = node_new(NodeKind.Variable(xv));
  Vec<Node*> params;
  params.init(0);
  params.push(x_param);
  fnv.args = params;
  fnv.has_args = true;

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected the function to emit";
  assert equals(
    st.out.build(),
    `Option mk(int64_t x) {
    `    return ((Option){ .tag = Option_Some, .payload.Some = { ._0 = (x) } });
    `}
    ``
  ), "expected the bare 'ret .Some(x);' to resolve against the function's own 'Option' return type";
}

test "emit_compound emits a non-generic compound as a C struct typedef" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* dt_x = malloc(sizeof(DataType));
  *dt_x = dtype_new();
  dt_x.type_str = "num";
  CompoundField fx;
  fx.name = "x";
  fx.dtype = dt_x;

  DataType* dt_y = malloc(sizeof(DataType));
  *dt_y = dtype_new();
  dt_y.type_str = "num";
  CompoundField fy;
  fy.name = "y";
  fy.dtype = dt_y;

  CompoundNode c = compound_node_new();
  c.name = "Point";
  c.fields.push(fx);
  c.fields.push(fy);

  Node n = node_new(NodeKind.Compound(c));
  assert g.emit_compound(n).is_none(), "expected the compound to emit";
  assert equals(
    st.out.build(),
    `typedef struct Point {
    `  int64_t x;
    `  int64_t y;
    `} Point;
    `
    ``
  ), "expected a C struct typedef with both fields";
}

