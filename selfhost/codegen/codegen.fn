}

test "emit_function emits a deferred statement at ordinary fall-through, after the rest of the body" {
  // Regression test: `.StatementDefer` (e.g. `ParseState.err`'s own real
  // body, `defer free(loc);`, found via the self-compile experiment) had
  // no `emit_statement` case at all. A `defer` doesn't emit anything at
  // its OWN source position -- it's replicated at the block's actual
  // exit point instead, here just ordinary fall-through off the end of
  // the function body.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "cleanup";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "void";
  rtype.kind = DataTypeType.Void;
  fnv.rtype = rtype;
  fnv.has_rtype = true;

  Node* free_callee = malloc(sizeof(Node));
  *free_callee = node_new(NodeKind.Identifier("free"));
  Node* x_ident = malloc(sizeof(Node));
  *x_ident = node_new(NodeKind.Identifier("x"));
  Node* free_args = malloc(sizeof(Node));
  *free_args = node_new(NodeKind.ExpressionParenthesis(x_ident));
  ExprNode free_call;
  free_call.left = free_callee;
  free_call.has_left = true;
  free_call.right = free_args;
  free_call.has_right = true;
  free_call.op = "()";
  Node* free_call_node = malloc(sizeof(Node));
  *free_call_node = node_new(NodeKind.Expression(free_call));
  Node* defer_stmt = malloc(sizeof(Node));
  *defer_stmt = node_new(NodeKind.StatementDefer(free_call_node));

  Node* g_callee = malloc(sizeof(Node));
  *g_callee = node_new(NodeKind.Identifier("g"));
  Node* g_blank = malloc(sizeof(Node));
  *g_blank = node_new(NodeKind.Blank);
  Node* g_args = malloc(sizeof(Node));
  *g_args = node_new(NodeKind.ExpressionParenthesis(g_blank));
  ExprNode g_call;
  g_call.left = g_callee;
  g_call.has_left = true;
  g_call.right = g_args;
  g_call.has_right = true;
  g_call.op = "()";
  Node* g_call_node = malloc(sizeof(Node));
  *g_call_node = node_new(NodeKind.Expression(g_call));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(defer_stmt);
  stmts.push(g_call_node);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected the function to emit";
  assert equals(st.out.build(), "void cleanup(void) {\n    g();\n    free(x);\n}\n"), "expected the deferred 'free(x)' emitted AFTER 'g()', at the block's actual (fall-through) exit, not at its own source position";
}

test "emit_function emits a deferred statement before an early 'ret', snapshotting the return value first" {
  // Regression test for the correctness subtlety: `ret <expr>;` must
  // evaluate `<expr>` BEFORE any pending defer runs (a defer might
  // mutate a variable the expression already read), so a `ret` with
  // pending defers snapshots into `__auto_type __fun_defer_ret` first.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "read_val";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;

  Node* free_callee = malloc(sizeof(Node));
  *free_callee = node_new(NodeKind.Identifier("free"));
  Node* x_ident = malloc(sizeof(Node));
  *x_ident = node_new(NodeKind.Identifier("x"));
  Node* free_args = malloc(sizeof(Node));
  *free_args = node_new(NodeKind.ExpressionParenthesis(x_ident));
  ExprNode free_call;
  free_call.left = free_callee;
  free_call.has_left = true;
  free_call.right = free_args;
  free_call.has_right = true;
  free_call.op = "()";
  Node* free_call_node = malloc(sizeof(Node));
  *free_call_node = node_new(NodeKind.Expression(free_call));
  Node* defer_stmt = malloc(sizeof(Node));
  *defer_stmt = node_new(NodeKind.StatementDefer(free_call_node));

  Node* five = malloc(sizeof(Node));
  *five = node_new(NodeKind.Number(TokenData.Num(5)));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(five));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(defer_stmt);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected the function to emit";
  assert equals(
    st.out.build(),
    "int64_t read_val(void) {\n    __auto_type __fun_defer_ret = 5;\n    free(x);\n    return __fun_defer_ret;\n}\n"
  ), "expected the return value snapshotted BEFORE the deferred 'free(x)' runs";
}

test "emit_function emits nested-block defers in their own LIFO order, scoped to their own block" {
  // Two defers registered in the SAME block emit in REVERSE (LIFO)
  // order; a defer registered inside an if-branch fires at THAT
  // branch's own exit, not smeared across the whole function.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "two_defers";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "void";
  rtype.kind = DataTypeType.Void;
  fnv.rtype = rtype;
  fnv.has_rtype = true;

  Node* a_callee = malloc(sizeof(Node));
  *a_callee = node_new(NodeKind.Identifier("a"));
  Node* a_blank = malloc(sizeof(Node));
  *a_blank = node_new(NodeKind.Blank);
  Node* a_args = malloc(sizeof(Node));
  *a_args = node_new(NodeKind.ExpressionParenthesis(a_blank));
  ExprNode a_call;
  a_call.left = a_callee;
  a_call.has_left = true;
  a_call.right = a_args;
  a_call.has_right = true;
  a_call.op = "()";
  Node* a_call_node = malloc(sizeof(Node));
  *a_call_node = node_new(NodeKind.Expression(a_call));
  Node* defer_a = malloc(sizeof(Node));
  *defer_a = node_new(NodeKind.StatementDefer(a_call_node));

  Node* b_callee = malloc(sizeof(Node));
  *b_callee = node_new(NodeKind.Identifier("b"));
  Node* b_blank = malloc(sizeof(Node));
  *b_blank = node_new(NodeKind.Blank);
  Node* b_args = malloc(sizeof(Node));
  *b_args = node_new(NodeKind.ExpressionParenthesis(b_blank));
  ExprNode b_call;
  b_call.left = b_callee;
  b_call.has_left = true;
  b_call.right = b_args;
  b_call.has_right = true;
  b_call.op = "()";
  Node* b_call_node = malloc(sizeof(Node));
  *b_call_node = node_new(NodeKind.Expression(b_call));
  Node* defer_b = malloc(sizeof(Node));
  *defer_b = node_new(NodeKind.StatementDefer(b_call_node));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(defer_a);
  stmts.push(defer_b);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected the function to emit";
  assert equals(st.out.build(), "void two_defers(void) {\n    b();\n    a();\n}\n"), "expected 'b()' (registered second) emitted before 'a()' (registered first) -- LIFO order";
}

test "emit_function emits parameters, and a call to it" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "add";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;

  DataType* dt_a = malloc(sizeof(DataType));
  *dt_a = dtype_new();
  dt_a.type_str = "num";
  VariableNode va;
  va.var_type = dt_a;
  va.name = "a";
  va.has_val = false;
  Node* param_a = malloc(sizeof(Node));
  *param_a = node_new(NodeKind.Variable(va));

  DataType* dt_b = malloc(sizeof(DataType));
  *dt_b = dtype_new();
  dt_b.type_str = "num";
  VariableNode vb;
  vb.var_type = dt_b;
  vb.name = "b";
  vb.has_val = false;
  Node* param_b = malloc(sizeof(Node));
  *param_b = node_new(NodeKind.Variable(vb));

  Vec<Node*> params;
  params.init(0);
  params.push(param_a);
  params.push(param_b);
  fnv.args = params;
  fnv.has_args = true;

  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(NodeKind.Identifier("a"));
  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(NodeKind.Identifier("b"));
  ExprNode sum;
  sum.left = lhs;
  sum.has_left = true;
  sum.right = rhs;
  sum.has_right = true;
  sum.op = "+";
  Node* sum_node = malloc(sizeof(Node));
  *sum_node = node_new(NodeKind.Expression(sum));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(sum_node));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected the function to emit";
  assert equals(st.out.build(), "int64_t add(int64_t a, int64_t b) {\n    return (a + b);\n}\n"), "expected a two-param C function definition";
}

test "emit_function_param emits a function-type parameter using C's function-pointer declarator shape" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* p0 = malloc(sizeof(DataType));
  *p0 = dtype_new();
  p0.type_str = "num";
  DataType* p1 = malloc(sizeof(DataType));
  *p1 = dtype_new();
  p1.type_str = "num";
  Vec<DataType*> params;
  params.init(0);
  params.push(p0);
  params.push(p1);
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  FnTypeSig sig = fn_type_sig_new();
  sig.params = params;
  sig.rtype = rtype;
  FnTypeSig* sig_ptr = malloc(sizeof(FnTypeSig));
  *sig_ptr = sig;

  DataType* cb_dt = malloc(sizeof(DataType));
  *cb_dt = dtype_new();
  cb_dt.fn_sig = sig_ptr;
  cb_dt.has_fn_sig = true;
  VariableNode cbv;
  cbv.var_type = cb_dt;
  cbv.name = "cb";
  cbv.has_val = false;
  Node param = node_new(NodeKind.Variable(cbv));

  assert g.emit_function_param(param).is_none(), "expected the function-type parameter to emit";
  assert equals(st.out.build(), "int64_t (*cb)(int64_t, int64_t)"), "expected C's 'R (*name)(T1, T2)' function-pointer declarator";
}

test "emit_function emits a function-type parameter's signature, and calls through it in the body" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* p0 = malloc(sizeof(DataType));
  *p0 = dtype_new();
  p0.type_str = "num";
  DataType* p1 = malloc(sizeof(DataType));
  *p1 = dtype_new();
  p1.type_str = "num";
  Vec<DataType*> sig_params;
  sig_params.init(0);
  sig_params.push(p0);
  sig_params.push(p1);
  DataType* sig_rtype = malloc(sizeof(DataType));
  *sig_rtype = dtype_new();
  sig_rtype.type_str = "num";
  FnTypeSig sig = fn_type_sig_new();
  sig.params = sig_params;
  sig.rtype = sig_rtype;
  FnTypeSig* sig_ptr = malloc(sizeof(FnTypeSig));
  *sig_ptr = sig;

  DataType* cb_dt = malloc(sizeof(DataType));
  *cb_dt = dtype_new();
  cb_dt.fn_sig = sig_ptr;
  cb_dt.has_fn_sig = true;
  VariableNode cbv;
  cbv.var_type = cb_dt;
  cbv.name = "cb";
  cbv.has_val = false;
  Node* cb_param = malloc(sizeof(Node));
  *cb_param = node_new(NodeKind.Variable(cbv));

  DataType* dt_a = malloc(sizeof(DataType));
  *dt_a = dtype_new();
  dt_a.type_str = "num";
  VariableNode av;
  av.var_type = dt_a;
  av.name = "a";
  av.has_val = false;
  Node* a_param = malloc(sizeof(Node));
  *a_param = node_new(NodeKind.Variable(av));

  DataType* dt_b = malloc(sizeof(DataType));
  *dt_b = dtype_new();
  dt_b.type_str = "num";
  VariableNode bv;
  bv.var_type = dt_b;
  bv.name = "b";
  bv.has_val = false;
  Node* b_param = malloc(sizeof(Node));
  *b_param = node_new(NodeKind.Variable(bv));

  Vec<Node*> params;
  params.init(0);
  params.push(cb_param);
  params.push(a_param);
  params.push(b_param);

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("cb"));
  Node* arg_a = malloc(sizeof(Node));
  *arg_a = node_new(NodeKind.Identifier("a"));
  Node* arg_b = malloc(sizeof(Node));
  *arg_b = node_new(NodeKind.Identifier("b"));
  ExprNode comma;
  comma.left = arg_a;
  comma.has_left = true;
  comma.right = arg_b;
  comma.has_right = true;
  comma.op = ",";
  Node* args_node = malloc(sizeof(Node));
  *args_node = node_new(NodeKind.Expression(comma));
  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args_node;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(call_node));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  fnv.name = "apply";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = params;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected 'apply' to emit";
  assert equals(
    st.out.build(),
    "int64_t apply(int64_t (*cb)(int64_t, int64_t), int64_t a, int64_t b) {\n    return cb(a, b);\n}\n"
  ), "expected the function-pointer param declarator, and an ordinary (uncast) call through it in the body";
}

test "emit_statement emits a conditional for as a while loop" {
  CodegenState st = codegen_state_new();
