  *callee_left = node_new(NodeKind.Blank);
  Node* callee_right = malloc(sizeof(Node));
  *callee_right = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = callee_left;
  dot.has_left = true;
  dot.right = callee_right;
  dot.has_right = true;
  dot.op = ".";
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Expression(dot));

  Node* arg = malloc(sizeof(Node));
  *arg = node_new(NodeKind.Number(TokenData.Num(9)));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(arg));

  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected the bare-shorthand construction to emit";
  assert equals(st.out.build(), "((Option){ .tag = Option_Some, .payload.Some = { ._0 = (9) } })"), "expected 'Option' resolved from expected_enum_type, not a qualifier";
}

test "emit_expr resolves a bare-shorthand construction NESTED inside another variant's own construction" {
  // `.Ok(.Some(t))`, a bare-shorthand construction nested inside
  // another variant's construction, needs its inner shorthand's
  // expected type resolved too: `emit_enum_variant_construction` sets
  // `expected_enum_type` per argument position via
  // `lookup_enum_variant_payload_type`, the same registry
  // `emit_fit_enum_branch`'s binding registration uses.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Vec<str> outer_variants;
  outer_variants.init(0);
  outer_variants.push("Wrap");
  g.record_enum("Outer", outer_variants, true);
  Vec<str> wrap_payload_types;
  wrap_payload_types.init(0);
  wrap_payload_types.push("Inner");
  Vec<bin> wrap_payload_ptrs;
  wrap_payload_ptrs.init(0);
  wrap_payload_ptrs.push(false);
  g.record_enum_variant_payload("Outer", "Wrap", wrap_payload_types, wrap_payload_ptrs);

  Vec<str> inner_variants;
  inner_variants.init(0);
  inner_variants.push("Some");
  inner_variants.push("None");
  g.record_enum("Inner", inner_variants, true);

  Node* outer_ident = malloc(sizeof(Node));
  *outer_ident = node_new(NodeKind.Identifier("Outer"));
  Node* wrap_ident = malloc(sizeof(Node));
  *wrap_ident = node_new(NodeKind.Identifier("Wrap"));
  ExprNode outer_dot;
  outer_dot.left = outer_ident;
  outer_dot.has_left = true;
  outer_dot.right = wrap_ident;
  outer_dot.has_right = true;
  outer_dot.op = ".";
  Node* outer_callee = malloc(sizeof(Node));
  *outer_callee = node_new(NodeKind.Expression(outer_dot));

  Node* inner_blank = malloc(sizeof(Node));
  *inner_blank = node_new(NodeKind.Blank);
  Node* some_ident = malloc(sizeof(Node));
  *some_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode inner_dot;
  inner_dot.left = inner_blank;
  inner_dot.has_left = true;
  inner_dot.right = some_ident;
  inner_dot.has_right = true;
  inner_dot.op = ".";
  Node* inner_callee = malloc(sizeof(Node));
  *inner_callee = node_new(NodeKind.Expression(inner_dot));
  Node* inner_arg = malloc(sizeof(Node));
  *inner_arg = node_new(NodeKind.Number(TokenData.Num(9)));
  Node* inner_args = malloc(sizeof(Node));
  *inner_args = node_new(NodeKind.ExpressionParenthesis(inner_arg));
  ExprNode inner_call;
  inner_call.left = inner_callee;
  inner_call.has_left = true;
  inner_call.right = inner_args;
  inner_call.has_right = true;
  inner_call.op = "()";
  Node* inner_call_node = malloc(sizeof(Node));
  *inner_call_node = node_new(NodeKind.Expression(inner_call));

  Node* outer_args = malloc(sizeof(Node));
  *outer_args = node_new(NodeKind.ExpressionParenthesis(inner_call_node));
  ExprNode outer_call;
  outer_call.left = outer_callee;
  outer_call.has_left = true;
  outer_call.right = outer_args;
  outer_call.has_right = true;
  outer_call.op = "()";
  Node n = node_new(NodeKind.Expression(outer_call));

  assert g.emit_expr(n).is_none(), "expected the nested construction to emit";
  assert equals(
    st.out.build(),
    "((Outer){ .tag = Outer_Wrap, .payload.Wrap = { ._0 = (((Inner){ .tag = Inner_Some, .payload.Some = { ._0 = (9) } })) } })"
  ), "expected the INNER bare '.Some(9)' resolved against 'Inner' (Wrap's own recorded payload type), not rejected";
}

