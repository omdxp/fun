  variants.push("Green");
  g.record_enum("Color", variants, false);

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("Color"));
  Node* variant = malloc(sizeof(Node));
  *variant = node_new(NodeKind.Identifier("Green"));
  ExprNode e;
  e.left = recv;
  e.has_left = true;
  e.right = variant;
  e.has_right = true;
  e.op = ".";
  Node n = node_new(NodeKind.Expression(e));

  assert g.emit_expr(n).is_none(), "expected the enum-variant access to emit";
  assert equals(st.out.build(), "Color_Green"), "expected 'Color_Green'";
}

