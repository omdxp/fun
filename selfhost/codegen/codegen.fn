  *i_ident = node_new(NodeKind.Identifier("i"));
  Node* bracket_inner = malloc(sizeof(Node));
  *bracket_inner = node_new(NodeKind.Bracket(i_ident));
  ExprNode idx;
  idx.left = arr_ident;
  idx.has_left = true;
  idx.right = bracket_inner;
  idx.has_right = true;
  idx.op = "[]";
  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(NodeKind.Expression(idx));

  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(NodeKind.Identifier("x"));
  ExprNode assign;
  assign.left = lhs;
  assign.has_left = true;
  assign.right = rhs;
