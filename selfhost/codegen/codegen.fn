  assert g.emit_expr(n).is_some(), "expected a bare compound literal with no ambient expected type to be rejected, not guessed";
}

test "emit_statement resolves a bare '.{...}' compound-literal assignment right-hand side against the field's declared type" {
  // The full real shape: `dt.flags = .{is_pointer = false, ...};` as an
  // ASSIGNMENT STATEMENT, exercising the actual `resolve_field_chain`
  // wiring in `emit_expr`'s `=` case, not just a pre-set
  // expected_compound_type.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("dt", "DataType", false);

  Vec<str> field_names;
  field_names.init(0);
  field_names.push("flags");
  Vec<str> field_types;
  field_types.init(0);
  field_types.push("DataTypeFlags");
  Vec<bin> field_ptrs;
  field_ptrs.init(0);
  field_ptrs.push(false);
  g.record_compound("DataType", field_names, field_types, field_ptrs);

  Node* dt_ident = malloc(sizeof(Node));
  *dt_ident = node_new(NodeKind.Identifier("dt"));
  Node* flags_ident = malloc(sizeof(Node));
  *flags_ident = node_new(NodeKind.Identifier("flags"));
  ExprNode field_e;
  field_e.left = dt_ident;
  field_e.has_left = true;
  field_e.right = flags_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_node = malloc(sizeof(Node));
  *field_node = node_new(NodeKind.Expression(field_e));

  CompoundInitField f1;
  f1.name = "is_pointer";
  Node* v1 = malloc(sizeof(Node));
  *v1 = node_new(NodeKind.Boolean(false));
  f1.value = v1;
  CompoundInitNode ci = compound_init_node_new();
  ci.has_dtype = false;
  ci.fields.push(f1);
  Node* ci_node = malloc(sizeof(Node));
  *ci_node = node_new(NodeKind.CompoundInit(ci));

  ExprNode assign;
  assign.left = field_node;
  assign.has_left = true;
  assign.right = ci_node;
  assign.has_right = true;
  assign.op = "=";
  Node n = node_new(NodeKind.Expression(assign));

  assert g.emit_statement(n).is_none(), "expected the assignment statement to emit";
  assert equals(st.out.build(), "(dt.flags = (DataTypeFlags){.is_pointer = false});\n"), "expected 'DataTypeFlags' resolved from the field's own declared type";
}

test "emit_expr emits a chained field access followed by indexing (self.data[i])" {
