test "emit_statement emits 'break;' inside a for loop's own if branch" {
  Node* break_stmt = malloc(sizeof(Node));
  *break_stmt = node_new(NodeKind.StatementBreak);
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(break_stmt);
  BodyNode if_bn;
  if_bn.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_bn));

  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Boolean(true));
  IfStmtNode ifn;
  ifn.condition = cond;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Vec<Node*> for_stmts;
  for_stmts.init(0);
  for_stmts.push(if_stmt);
  BodyNode for_bn;
  for_bn.statements = for_stmts;
  Node* for_body = malloc(sizeof(Node));
  *for_body = node_new(NodeKind.Body(for_bn));

  ForCondNode fc;
  fc.condition = nil;
  fc.has_condition = false;
  fc.body = for_body;
  Node n = node_new(NodeKind.StatementFor(ForKind.Cond(fc)));

  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  assert g.emit_statement(n).is_none(), "expected the for-loop-with-a-conditional-break to emit";
  assert equals(
    st.out.build(),
    `while (1) {
    `    if (true) {
    `        break;
    `    }
    `}
    ``
  ), "expected the C 'break;' nested inside the if inside the while loop";
}

