// The self-hosted Fun compiler's codegen: transpiles an AST into C source.
// Ported from the previous implementation's `modules/codegen/transpiler.zig`,
// incrementally, the same way `selfhost/parser` was.
// 
// Coverage so far: literal expressions (number/decimal/string/character/
// boolean/`nil`, the last emitting C `NULL`), identifiers, unary
// operators (prefix, pointer-indirection depth, postfix `++`/`--`),
// binary operators (arithmetic/comparison/logical/bitwise/assignment --
// every one shares an identical C spelling), array indexing (`arr[i]`,
// as an rvalue or an assignment target -- see `emit_index`'s doc
// comment), calls with a plain-identifier callee (any argument count,
// flattening the parser's comma-chained argument-list representation --
// see `flatten_call_args`), variable declarations -- explicit type, or
// `let` (emits GNU C's own `__auto_type`, letting the C compiler infer
// the real type, since this codegen has no type-checker of its own --
// `infer_let_expr_type` ALSO best-effort infers the declared type for
// this file's OWN bookkeeping, purely so a later bare-shorthand `fit`/
// field access/method call on that local still resolves; failing to
// infer only means the local isn't usable that way afterward, not that
// the declaration itself is rejected) -- `ret` statements, bare
// `break;`/`continue;`
// (an identical C spelling, no translation needed), `if`/`elif`/`else`
// (chained correctly into one C construct even though they're three
// independent sibling AST statements -- see `emit_if_chain`'s doc
// comment), `for` (condition/infinite form as a C `while`, integer-range
// form as a C counted `for`, and the `Vec` iterator form -- `for item :
// arr { ... }` / `for i, item :: arr { ... }` -- as the original's own
// `.len`/`.data` fast-path loop; see `emit_for_cond`/`emit_for_range`/
// `emit_for_iter`),
// bare expression statements (an assignment, a call for its side effect,
// `x++;` -- these have no dedicated `StatementExpression` AST wrapper,
// they're a plain `.Expression`/`.Unary` node straight in the statement
// list), a `compound Name { fields }` declaration as a C struct (see
// `emit_compound`) -- a GENERIC one (`compound Box<T> { ... }`) is
// recorded as a template and monomorphized on demand the first time a
// concrete instantiation (`Box<num>`) is actually used, via
// `ensure_compound_instantiated`. A monomorphized struct/enum typedef or
// generic impl method is emitted at whatever point first triggers it,
// which is often INSIDE some function's own body (`Box<num> b;` as a
// local, say) -- when `pub transpile` is driving emission, that
// definition is spliced in just before the enclosing top-level
// function/impl instead of left nested inside its `{ }` (fatal for a
// method's own C function definition, which can never nest; merely
// oddly-scoped, not fatal, for a typedef) -- see `Codegen.
// hoist_insert_pos`/`emit_hoisted`'s doc comments) -- `ident.field`
// member access -- including a
// CHAINED access (`a.b.c`) -- deciding `.`/`->` at every link from each
// receiver's DECLARED type (a deliberately narrow, non-inference-based
// heuristic -- see `emit_field_access`/`emit_receiver_and_resolve_type`'s
// doc comments for exactly what it can't handle), a
// `impl Type { methods }` block, PLAIN or quirk-implementing, generic or
// not (each method is ALREADY parsed as a pre-mangled, self-first-arg
// `Function` node -- see `emit_impl`'s doc comment -- so a non-generic
// one is emitted exactly like any other function; a GENERIC impl's
// methods instead monomorphize the same way a generic compound/enum
// does, lazily, the first time a concrete instantiation of the
// enclosing type is used -- see
// `maybe_instantiate_generic_impl_methods`'s doc comment), a method call
// `recv.method(...)` -- `recv` a plain local OR a chained field access
// (`self.parts.push(s)`) -- resolved statically to `Type__method(<self-
// arg>, ...)` (or `Type__Quirk__method(...)` when a quirk-implementing
// impl defined it -- see `register_impl_methods`/`emit_method_call`'s
// doc comments) from the receiver's own resolved type, `fit subject {
// patterns -> { body } ... }` over a plain identifier, a `*name`
// dereference (`fit *self { ... }`), a chained field access (`fit
// t.data { ... }`), or a `receiver.method()` call (`fit self.next_tok()
// { ... }`, hoisted into a temp `__auto_type` variable first since,
// unlike the other three subject shapes, it can't just be re-evaluated
// per branch -- see `Codegen.impl_method_rtype`'s doc comment) subject
// -- either a literal-pattern chain, or a
// tagged-union enum-variant pattern (bare `.Variant`/`.Variant(x)`,
// resolved against the SUBJECT's own declared/resolved type, or
// qualified `EnumName.Variant`/`EnumName.Variant(x)`),
// destructuring any positional bindings out of the payload -- as a C
// `if`/`else if`/`else` chain (see `emit_fit`/`emit_fit_enum_branch`'s
// doc comments), an `enum Name { variants }` declaration -- either a
// plain C enum, or, when any variant carries a payload, the original's
// own discriminant-enum-plus-tagged-struct/union layout (see
// `emit_enum`/`emit_tagged_union_enum`'s doc comments); a GENERIC one
// (`enum Option<T> { ... }`) monomorphizes the same way a generic
// compound does, lazily, on first concrete use (see
// `ensure_enum_instantiated`'s doc comment) -- together with
// a QUALIFIED enum-variant access (`EnumName.Variant` bare, or
// `EnumName.Variant(args...)` a payload construction, both recognized
// without a call needed to disambiguate from a method call), OR a BARE
// enum-variant shorthand (`.Variant`/`.Variant(x)`, no qualifier) in a
// `ret <shorthand>;` statement or a `Variable` declaration's own
// initializer -- resolved against the enclosing function's declared
// return type, or that variable's own declared type, respectively (see
// `Codegen.expected_enum_type`'s doc comment for this "already fully
// explicit declared-type, not real inference" mechanism, and
// `emit_field_access`/`emit_enum_variant_construction`'s doc comments for
// how it's consumed), and a top-level function declaration with any
// number of parameters (still no generics/variadics). Verified end to
// end: the self-hosted lexer -> self-hosted parser -> this codegen, on
// programs using variables, comparisons, if-elif-else, assignment
// statements, all three `for` loop forms above, multi-arg function
// calls, a compound with field reads/writes, a plain impl method called
// both directly and through `self`, a `fit` over a `num` subject with a
// comma-chained pattern and a default arm, a plain enum whose variant
// constants are compared and returned, and a tagged-union enum
// constructed three ways (qualified, bare-shorthand as a `ret` value,
// and bare-shorthand as a `Variable` initializer) and destructured back
// out through a `fit` with a bare-shorthand binding pattern and a bare
// no-payload variant match, produces C that compiles and runs with the
// correct exit code.
// 
// Deliberately deferred from this slice (documented rather than silently
// dropped):
// - Reading a tagged union's own `.payload.Variant._N` fields back out
// WITHOUT going through a `fit` destructuring pattern, and calls/access
// through an aliased/imported module -- both share the
// `Identifier . Identifier` AST shape with plain field access and
// qualified enum-variant access, and `emit_field_access`/
// `emit_receiver_and_resolve_type` deliberately refuse to guess at either
// of them (see their own doc comments). The former needs the tagged-union
// payload layout threaded into the compound-field-type registry; the
// latter needs import support, neither of which exists yet.
// - A bare enum-variant shorthand anywhere OTHER than directly as a `ret`
// value, a `Variable` initializer, an assignment's right-hand side, an
// equality/inequality comparison's right-hand side (`self.kind ==
// .None`, `is_ok`/`is_err`-style predicate methods throughout this
// codebase's own real stdlib -- `Codegen.expected_enum_type` resolves
// against the LEFT side's own declared/resolved type for `=`/`==`/`!=`
// alike), or a call argument to a PLAIN function (`err_kind(.Parse,
// "msg", 0)`, resolved against the CALLEE's own declared parameter type
// at that position -- see `Codegen.function_names`'s doc comment; a
// method-call argument doesn't resolve this way yet) -- a compound-
// literal field initializer, a shorthand on the LEFT of `=`/`==`/`!=`,
// or a nested sub-expression anywhere deeper still, would all need a
// real expected-type mechanism threaded through arbitrary expression
// contexts, which this narrow, site-by-site approach deliberately isn't.
// - A generic COMPOUND (`compound Box<T> { ... }`), a generic ENUM
// (`enum Option<T> { ... }`), a generic impl's OWN methods (`impl
// Box<T> { ... }`), and a generic FUNCTION (`fun err_kind<T>(...) ...`)
// all monomorphize now -- the first three lazily, the first time a
// concrete instantiation is actually used (see
// `ensure_compound_instantiated`/`ensure_enum_instantiated`/
// `maybe_instantiate_generic_impl_methods`'s doc comments); the last
// from its own CALL site, inferring each type param's binding from the
// arguments actually passed (see
// `maybe_instantiate_generic_function`/`infer_arg_type_name`'s doc
// comments -- only a known local, a literal, or a call to an already-
// registered plain function can be inferred FROM; anything else is
// rejected, not guessed) -- but only for a template whose fields/
// variant-payloads/method-or-function self-and-param-and-return types
// are bare `T`-shaped (no array-of-generic field, e.g. the real
// `Vec<T>`'s own `T[] data;`) and concrete arguments with no generic
// args of their own -- a NESTED generic argument (`Result<Option<Token>,
// Error>`, `Box<Box<num>>`) resolves fine now (see `ensure_compound_
// instantiated`'s doc comment), recursing to arbitrary depth; only an
// argument whose own template ISN'T registered at all is rejected.
// A bare enum-variant shorthand nested inside ANOTHER variant's own
// construction (`.Ok(.Some(t))`) resolves against that position's own
// recorded payload type too (`Codegen.enum_variant_payload_owner`'s doc
// comment). TRUE dynamic dispatch through an abstract quirk-typed
// receiver (see below) still doesn't reach a generic impl's methods
// either, same as a non-generic one's.
// - TRUE dynamic dispatch through a receiver declared as an ABSTRACT
// quirk type itself (a vtable lookup) -- a separate, larger deferred
// item. A quirk-implementing impl's OWN methods emit fine now (see
// `emit_impl`), and a STATIC call through a receiver whose declared
// type is already the CONCRETE implementing type resolves correctly
// (see `emit_method_call`/`register_impl_methods`'s doc comments) --
// only the abstract-quirk-typed-variable case is still unreachable.
// - The iterator form of `for` over anything other than a known-`Vec`
// local (an array literal, or a general `Iterator`-implementing quirk
// value dispatched through `.next()`) -- see `emit_for_iter`'s doc
// comment. `[]` indexing (`arr[i]`, as an rvalue or an assignment
// target) DOES work now -- see `emit_index`'s doc comment -- needing no
// type resolution at all, since C's own `[]` composes directly with
// whatever the receiver already emitted as.
// - A `fit` subject that isn't a plain identifier, a single `*name`
// dereference, a chained field access, or a `receiver.method()` call
// matching `emit_method_call`'s own recognized shape (this last one now
// works: a temp `__auto_type` variable holds the call's result, and its
// bare-shorthand enum type resolves from the CALLEE's own declared
// return type -- see `emit_fit`'s doc comment and `Codegen.
// impl_method_rtype`) -- a plain-FUNCTION-call subject, or a chained
// call (`a.b().c()`), is still rejected rather than guessed.
// - Every declaration kind besides a plain function/compound (generic or
// not)/enum (generic or not)/impl (generic or not) (a top-level `quirk`
// declaration itself needs no C emission at all -- it's a structural,
// compile-time-only interface spec).
// - Type INFERENCE: a function's return type and every literal's type are
// already fully explicit at this stage (an omitted `let` type, or a
// function relying on inferred generics, isn't reachable yet), so no
// `infer_expr_type`-equivalent exists yet either.
// - Quirk/vtable dispatch, async/channels -- each is a substantial slice
// of its own in the original and will get one here too. Multi-file
// resolution/merging itself now exists (`selfhost/parser/
// import_resolver.fn`'s `parse_program_with_imports` recursively
// resolves, parses, and flattens an entire `imp`-connected program into
// one `Vec<Node>` this codegen's own `transpile` can take unchanged) --
// but an ALIASED import's `alias.symbol` QUALIFIED access at a call site
// is still unrecognized (it shares the `Identifier . Identifier` AST
// shape with plain field access and qualified enum-variant access,
// same as the tagged-union payload gap above), and cross-file
// duplicate-symbol detection doesn't exist yet either.
// - Exotic literal-escaping edge cases the original handles (splitting a
// string literal around a `\xFF`-then-more-hex-digits run so C doesn't
// fold extra digits into the escape) -- string content is written back
// out verbatim otherwise, relying on the lexer already having preserved
// escape sequences byte-for-byte from source (confirmed: `lexes string
// literals with escapes preserved verbatim` in the lexer's own test
// suite), which is valid C escape syntax already.
// - Decimal literals are emitted in FIXED-point (`format_dec(d, 6)`)
// rather than the original's scientific-notation (`{e}`) convention --
// both are valid C floating-point literal syntax representing the same
// value; the original's choice wasn't semantically required, and fixed-
// point is simpler to produce with the stdlib helpers already at hand.

imp codegen_state;
imp typedefs;
imp ..ast.ast;
imp ..lexer.token;
imp ..parser.datatype_defs;
imp std.string;
imp std.option;
imp std.io;

pub enum CodegenErrorKind {
  UnsupportedNode,
  InvalidNode,
}

// A resolved compound field's declared type: its type name and whether
// it's a pointer -- exactly the same two facts `local_type_name`/
// `local_is_pointer` track for a LOCAL, but for a COMPOUND FIELD instead,
// so a chained field access (`a.b.c`) can determine `.`/`->` at each
// link without a real type-inference engine. See
// `emit_receiver_and_resolve_type`'s doc comment.
// `dtype` additionally carries the field's FULL, un-mangled declared
// `DataType` (its own `generic_args` intact), when the recording call
// site had one on hand (`record_compound_typed`, e.g. `emit_compound`'s
// own real field pass) -- `.None` for a hand-built unit test's stand-in
// field (`record_compound`). Lets a caller that needs REAL structure (a
// generic arg, e.g. `Vec<T>`'s own `T`) read it directly instead of
// reverse-engineering it out of a mangled name string -- see
// `emit_for_iter`'s own doc comment for the motivating case (a for-each
// iterable that's itself a field access, `for a : dt.generic_args { ...
// }`, needing to know ITS OWN element type to record `a` as a known
// local too).
compound FieldTypeInfo {
  str type_name;
  bin is_pointer;
  Option<DataType> dtype;
}

// Same facts as `FieldTypeInfo`, plus the RESOLVED C text itself -- the
// pure counterpart of `emit_receiver_and_resolve_type` (which writes
// text as it resolves, fine for a receiver emitted exactly once inline).
// `emit_fit`'s subject needs its text computed once but WRITTEN once per
// branch, so resolution has to happen without touching the output buffer
// -- see `resolve_field_chain`'s doc comment.
compound ChainResolution {
  str text;
  str type_name;
  bin is_pointer;
  Option<DataType> dtype;
}

// The result of monomorphizing a generic function CALL (see
// `maybe_instantiate_generic_function`'s doc comment): the mangled
// call-site name, plus each of the template's OWN parameters'
// declared type ALREADY substituted against this call's concrete
// bindings (positional, parallel to the template's own `f.args`) --
// `emit_call` uses these to resolve a bare-shorthand ARGUMENT (`ok(
// .None)`) against the param's ACTUAL (substituted) type, not the
// template's raw, unsubstituted one (which could itself be a bare type
// param like `T`, never a real enum name).
compound GenericCallResolution {
  str mangled_name;
  Vec<DataType> param_types;
}

// One variant's template shape within a generic enum template (see
// `Codegen.generic_enum_names`'s doc comment): its bare name, whether it
// carries a payload, and -- if so -- each payload position's OWN
// pre-substitution declared type (possibly a bare occurrence of one of
// the enclosing template's type-param names, e.g. `T` in `Some(T)`),
// substituted per concrete instantiation the same way a generic
// compound's own fields are (see `ensure_compound_instantiated`'s doc
// comment).
compound GenericEnumVariantTemplate {
  str name;
  bin has_payload;
  Vec<str> payload_type_strs;
  Vec<bin> payload_is_pointer;
}

pub compound Codegen {
  CodegenState* state;
  // A best-effort, function-local (reset at the start of every
  // `emit_function`, see its own doc comment) record of which local names
  // (parameters and `Variable` declarations seen so far, in source order)
  // are pointer-typed, and their declared type name -- just enough to
  // decide `.`/`->` for a plain `ident.field` access, and to build a
  // method call's mangled callee name, without a real type-inference
  // engine. See `emit_field_access`/`emit_method_call`'s doc comments for
  // what this deliberately can't handle yet.
  Vec<str> local_names;
  Vec<bin> local_is_pointer;
  Vec<str> local_type_name;
  // The FULL structured type for a local, when the call site recording
  // it actually had one on hand (a real `Variable` declaration or
  // function/method parameter's own `DataType`, post-substitution --
  // see `record_local_typed`) -- `.None` for everything recorded through
  // plain `record_local` (a name derived/synthesized from something
  // else, like a `let`-inferred bookkeeping type, a `fit` destructuring
  // binding, or a hand-built unit test's stand-in local). Lets a site
  // that needs REAL structure (a generic arg, e.g. `Vec<T>`'s own `T`,
  // not just the resolved/mangled NAME string `local_type_name` has) read
  // it directly instead of reverse-engineering it out of a mangled name
  // -- see `emit_for_iter`'s own doc comment for the motivating case
  // (determining a `for item : vec_local` loop's own `item` element
  // type, needed to support a FURTHER nested `for x : item` iteration).
  Vec<Option<DataType>> local_dtype;
  // Whole-program record of every non-generic enum's name, its variants'
  // names, and whether it's a tagged union (any variant has a payload),
  // populated by `transpile`'s own first pass over top-level `Enum`
  // nodes -- lets `emit_expr`/`emit_call` recognize a qualified
  // enum-variant access (`EnumName.Variant` bare, or `EnumName.Variant(
  // args...)` a construction call) and emit the right C, without a real
  // type-inference engine (see `emit_field_access`/`emit_enum`'s doc
  // comments for what's deliberately not registered here).
  Vec<str> enum_names;
  Vec<Vec<str>> enum_variant_names;
  Vec<bin> enum_is_tagged_union;
  // Whole-program record of a tagged-union enum's OWN per-variant
  // payload field types (positional, parallel to
  // `enum_variant_payload_type_names`/`enum_variant_payload_is_pointer`)
  // -- lets `emit_fit_enum_branch` register each destructuring binding
  // (`.Some(t) -> { ... }`) as a KNOWN LOCAL via `record_local`, so
  // FURTHER access on it (`t.data`, another `fit`, a method call) still
  // resolves, instead of `t` only ever being usable as a bare value.
  // Populated by `emit_tagged_union_enum`/`emit_tagged_union_enum_
  // instance` (both the plain and the monomorphized path) right after
  // computing each payload field's own resolved type, the same "already
  // fully explicit" bookkeeping this file uses everywhere else.
  Vec<str> enum_variant_payload_owner;
  Vec<str> enum_variant_payload_variant;
  Vec<Vec<str>> enum_variant_payload_type_names;
  Vec<Vec<bin>> enum_variant_payload_is_pointer;
  // The CURRENT function's declared return type name, refreshed at the
  // start of every `emit_function` -- feeds `expected_enum_type` for a
  // `ret <shorthand>;` statement's own expression (see `emit_statement`'s
  // `StatementReturn` case).
  str current_fn_rtype_name;
  // The same CURRENT function's return type, as a full (substituted)
  // `DataType` rather than just its resolved name -- lets
  // `maybe_instantiate_generic_function` fall back to CONTEXTUAL
  // inference when a type param's binding can't be read off the call's
  // own arguments (`ret ok(.None);` inside `_next_inner`'s real body --
  // `ok<T>(value) Result<T, Error>` called with a bare shorthand that
  // carries no type info by itself; `T` instead comes from matching
  // `ok`'s own declared `Result<T, Error>` return shape POSITIONALLY
  // against `_next_inner`'s OWN concrete return type, `Result<
  // Option<Token>, Error>`, the same "bare occurrence only" restriction
  // as everywhere else). See `infer_generic_function_type_param_from_
  // context`'s doc comment for the actual matching logic.
  Option<DataType> current_fn_rtype_dt;
  // The enum name a BARE `.Variant`/`.Variant(x)` shorthand (no
  // `EnumName.` qualifier -- `e.left`/`recv_e.left` is `.Blank`) should
  // resolve against, standing in for the "expected type from context"
  // this codegen doesn't have a real inference engine for. Empty when
  // nothing in the immediately enclosing statement provides one. Scoped
  // narrowly by the three sites that set it (`emit_statement`'s
  // `StatementReturn`/`Variable` cases, and `emit_expr`'s `=` assignment
  // case, each saving and restoring the previous value around just their
  // own value/initializer/right-hand expression) rather than left set
  // for a whole function body, so it can't leak into an unrelated
  // shorthand elsewhere in the same function -- e.g. a `Variable`
  // declaration's own initializer must resolve against THAT variable's
  // declared type, not the enclosing function's return type.
  str expected_enum_type;
  // The compound type name a BARE `.{ field = value, ... }` compound-
  // literal shorthand (no `Type` before the `{` -- `ci.has_dtype ==
  // false`) should resolve against, standing in for "the expected type
  // from context" the same way `expected_enum_type` does for a bare
  // `.Variant`/`.Variant(x)` enum shorthand -- see that field's own doc
  // comment for the general shape of this pattern (this codegen has no
  // type-checker of its own, so context has to be threaded through
  // explicitly like this rather than resolved by an earlier pass, unlike
  // the original transpiler's `bind_compound_init_expected`). Populated
  // only at the ONE real site found so far (`emit_expr`'s `=` assignment
  // case, e.g. `dtype_new`'s own real body in this codebase, `dt.flags =
  // .{is_pointer = false, ...};`) -- an EXPLICIT `Type{...}` compound
  // literal (`DynamicIntType{is_signed = true, bits = 8}`, also real,
  // `typedefs.fn`'s own body) carries its own type name directly and
  // never consults this at all.
  str expected_compound_type;
  // `defer <body>;` support: a FLAT list of every pending deferred
  // statement body currently in scope, across ALL nested blocks of the
  // function being emitted right now (registered in source order by
  // `emit_statement`'s `.StatementDefer` case), plus a stack of frame
  // markers (each an index into `defer_stack` where that block's OWN
  // defers begin, pushed/popped by `emit_statements` around its own
  // statement loop -- see its doc comment). Mirrors the original
  // transpiler's `defer_stack`/`defer_scope_stack` pair, simplified: this
  // codegen doesn't yet distinguish a LOOP frame from a plain block frame
  // (no real `break`/`continue`-past-a-`defer` usage has been found yet
  // to require it -- see `emit_function_scope_defers`'s doc comment for
  // the resulting limitation), so there is only ever "the current
  // block's own frame" and "everything back to function entry".
  // Deferred bodies are never actually POPPED off `defer_stack` by an
  // early exit (a `ret` inside a nested block) -- only replicated as
  // ordinary C statements at that exit point (`emit_defers_from`) -- the
  // ACTUAL pop happens once, when the owning block finishes being
  // emitted at all (`emit_statements`' own `pop_defer_scope` call),
  // regardless of how many early-exit copies were already emitted from
  // it. This is the standard compile-time "replicate the cleanup at
  // every exit point" lowering (no runtime unwind table), matching the
  // original.
  Vec<Node*> defer_stack;
  Vec<num> defer_scope_starts;
  // Whole-program record of every non-generic compound's name and its
  // fields' declared types, populated by `emit_compound`'s own emission
  // pass -- lets a CHAINED field access (`a.b.c`) determine `.`/`->` at
  // each link by looking up the PREVIOUS link's resolved type's field,
  // instead of just the outermost receiver's (see
  // `emit_receiver_and_resolve_type`'s doc comment).
  Vec<str> compound_names;
  Vec<Vec<str>> compound_field_names;
  Vec<Vec<str>> compound_field_type_names;
  Vec<Vec<bin>> compound_field_is_pointer;
  // The FULL, un-mangled declared `DataType` for each field, when the
  // recording call site had one on hand -- see `FieldTypeInfo.dtype`'s
  // doc comment for why (a field-access iterable's own element type,
  // `for a : dt.generic_args { ... }`).
  Vec<Vec<Option<DataType>>> compound_field_dtype;
  // Whole-program record of every impl method's owning type, its OWN
  // bare name, and its FULLY MANGLED C call-site name -- populated by
  // `register_impl_methods`' own dedicated pre-pass (see `transpile`'s
  // doc comment for why this can't just happen as a side effect of
  // `emit_impl` itself). A PLAIN impl's method mangles to
  // `Type__method`; a QUIRK-implementing impl's mangles to
  // `Type__Quirk__method` instead (`_parse_impl_method`'s own scheme in
  // the parser -- codegen doesn't invent this, it only has to
  // reconstruct which one applies at a CALL site). Lets
  // `emit_method_call` resolve the right one regardless of which kind of
  // impl actually defined the method being called.
  Vec<str> impl_method_owner_type;
  Vec<str> impl_method_bare_name;
  Vec<str> impl_method_mangled_name;
  // Each entry's OWN declared return type, parallel to the three arrays
  // above -- lets `emit_fit` resolve a bare-shorthand enum pattern
  // (`.Some(x) -> { ... }`) against a `fit self.method() { ... }`
  // subject (a CALL, not a plain local) by looking up the CALLEE's own
  // declared return type instead of a local's, then hoisting a temp
  // `__auto_type` variable to hold the call's result (see
  // `emit_fit`'s doc comment for why a call subject specifically needs
  // one). Populated ONLY for a PLAIN (non-generic) impl's methods, by
  // `register_impl_methods` -- a generic impl's own monomorphized
  // methods aren't registered here yet (a separate, smaller follow-up:
  // `maybe_instantiate_generic_impl_methods` would need to resolve the
  // SUBSTITUTED return type, not the template's raw `T`).
  Vec<DataType*> impl_method_rtype;
  // A PLAIN top-level function's own name and its parameters' OWN
  // declared types (positional, parallel Vecs) -- lets `emit_call`
  // resolve a bare enum-variant shorthand (`.Parse`) passed as a CALL
  // ARGUMENT (`err_kind(.Parse, "msg", 0)`, e.g. `_read_comment_block`'s
  // real body in the self-hosted lexer's own source) against the
  // CALLEE's own declared parameter type at that position, the same
  // "expected type from the one place that actually declares it, not
  // real inference" trick as `Codegen.expected_enum_type`'s other three
  // sites. Populated by `register_function_signatures`, a whole-program
  // pre-pass over every top-level `Function` node (see `pub transpile`'s
  // doc comment for why forward references need their own pass, same
  // reasoning as `register_impl_methods`) -- NOT populated for an impl
  // method's own params (a separate, narrower case: `emit_method_call`'s
  // args don't go through this lookup yet).
  Vec<str> function_names;
  Vec<Vec<DataType *>> function_param_types;
  // Each entry's OWN declared return type, parallel to `function_names`
  // -- lets `infer_arg_type_name` bind a generic function's type
  // parameter from a call-site argument that's ITSELF a call to an
  // already-registered plain function (`err_kind(.Parse, "msg",
  // token_zero())`, binding `T` from `token_zero`'s own `Token` return
  // type -- see `maybe_instantiate_generic_function`'s doc comment).
  Vec<DataType*> function_rtypes;
  // Every GENERIC top-level function (`fun err_kind<T>(...) ...`),
  // recorded whole by `register_function_signatures` when it sees
  // `has_type_params`, instead of registering it into `function_names`
  // -- see `maybe_instantiate_generic_function`'s doc comment for how
  // (and when) one gets monomorphized.
  Vec<Node> generic_function_templates;
  // A generic COMPOUND template (`compound Box<T> { ... }`): its name,
  // type-param names, and each field's OWN pre-substitution declared
  // type -- recorded by `emit_compound` when it sees `has_type_params`,
  // WITHOUT emitting any C (a template is never emitted directly, only
  // a concrete monomorphization of it -- see
  // `ensure_compound_instantiated`'s doc comment).
  Vec<str> generic_compound_names;
  Vec<Vec<str>> generic_compound_type_params;
  Vec<Vec<str>> generic_compound_field_names;
  Vec<Vec<str>> generic_compound_field_type_names;
  Vec<Vec<bin>> generic_compound_field_is_pointer;
  // A generic ENUM template (`enum Option<T> { ... }`): its name,
  // type-param names, and each variant's OWN pre-substitution template
  // shape -- recorded by `emit_enum` when it sees `has_type_params`,
  // WITHOUT emitting any C, same reasoning as the generic COMPOUND
  // registry above (see `ensure_enum_instantiated`'s doc comment).
  Vec<str> generic_enum_names;
  Vec<Vec<str>> generic_enum_type_params;
  Vec<Vec<GenericEnumVariantTemplate>> generic_enum_variants;
  // Mangled names already monomorphized (see `ensure_compound_
  // instantiated`/`ensure_enum_instantiated`), so instantiating the SAME
  // concrete type arguments twice doesn't emit a duplicate C typedef --
  // shared across both compound and enum instantiations, since their
  // mangled names are drawn from the same namespace (a compound and an
  // enum can never share a bare name in this language).
  Vec<str> emitted_generic_instantiations;
  // Every GENERIC impl block (`impl Box<T> { ... }` or `impl Box<T> as
  // Quirk { ... }`), recorded whole (not decomposed into parallel arrays
  // like the generic compound/enum registries above -- a whole `Impl`
  // node already carries its own `type_params`/`quirk_name`/`methods`,
  // and re-reading them straight from the node avoids a second
  // hand-rolled copy of the same data) by `register_impl_methods` when it
  // sees `has_type_params`, WITHOUT emitting any C. Monomorphized lazily
  // by `maybe_instantiate_generic_impl_methods`, the same "only on first
  // concrete use" rule as a generic compound/enum template.
  Vec<Node> generic_impl_templates;
  // The ACTIVE type-param substitution for a generic impl method
  // currently being monomorphized (see
  // `maybe_instantiate_generic_impl_methods`) -- parallel arrays, `
  // type_subst_param_names.get(i)` (one of the impl's OWN type-param
  // names, e.g. `"T"`) substitutes to `type_subst_arg_type_strs.get(i)`/
  // `type_subst_arg_is_pointer.get(i)` (this instantiation's concrete
  // argument). Empty (the default, and restored to empty around any
  // nested instantiation -- see that function's doc comment) means no
  // substitution is active, so `resolve_type_subst` is a free no-op for
  // every ordinary (non-generic-impl-method) emission -- this is NOT a
  // general type-inference mechanism, just enough to re-resolve a bare
  // occurrence of the impl's own type param (see `resolve_type_subst`'s
  // doc comment for exactly what shape it handles).
  Vec<str> type_subst_param_names;
  Vec<str> type_subst_arg_type_strs;
  Vec<bin> type_subst_arg_is_pointer;
  // Where a lazily-monomorphized struct/enum typedef or generic impl
  // method definition should land in `self.state.out`, instead of at
  // whatever position happens to be CURRENT when it's first triggered
  // (which, for a type first used inside a function's own body -- the
  // common case, not an edge case -- would nest the definition INSIDE
  // that function's `{ }`; harmless for a typedef (block-scoped, valid
  // C), but a hard syntax error for an impl method's own FUNCTION
  // DEFINITION, which C never allows nested). `.None` (the default, and
  // what every hand-built unit test below leaves it at, since none of
  // them call `pub transpile`) means "no enclosing top-level
  // function/impl is being tracked -- just append at the current tail,"
  // preserving every existing test's exact expected output. `pub
  // transpile` sets this to `.Some(<position right before this
  // top-level item's own emission started>)` around each `emit_impl`/
  // `emit_function` call in its own passes, so a definition triggered
  // from inside gets spliced in just before that enclosing item instead
  // -- see `emit_hoisted`'s doc comment for the actual splice mechanism.
  Option<num> hoist_insert_pos;
  // Whether ANY `fork` statement appears anywhere in the program being
  // transpiled -- computed once by `uses_fork_in` at the very start of
  // `pub transpile`, before the prelude is written, mirroring the
  // original implementation's own `uses_fork` field/pre-scan. Not yet
  // read by anything (the M:N scheduler this eventually selects between
  // is a later slice of this port); `write_prelude` currently always
  // emits the plain, scheduler-less watchdog.
  bin uses_fork;
}

pub fun codegen_new(CodegenState* state) Codegen {
  Codegen g;
  g.state = state;
  g.local_names.init(0);
  g.local_is_pointer.init(0);
  g.local_type_name.init(0);
  g.local_dtype.init(0);
  g.enum_names.init(0);
  g.enum_variant_names.init(0);
  g.enum_is_tagged_union.init(0);
  g.enum_variant_payload_owner.init(0);
  g.enum_variant_payload_variant.init(0);
  g.enum_variant_payload_type_names.init(0);
  g.enum_variant_payload_is_pointer.init(0);
  g.compound_names.init(0);
  g.compound_field_names.init(0);
  g.compound_field_type_names.init(0);
  g.compound_field_is_pointer.init(0);
  g.compound_field_dtype.init(0);
  g.impl_method_owner_type.init(0);
  g.impl_method_bare_name.init(0);
  g.impl_method_mangled_name.init(0);
  g.impl_method_rtype.init(0);
  g.function_names.init(0);
  g.function_param_types.init(0);
  g.function_rtypes.init(0);
  g.generic_function_templates.init(0);
  g.generic_compound_names.init(0);
  g.generic_compound_type_params.init(0);
  g.generic_compound_field_names.init(0);
  g.generic_compound_field_type_names.init(0);
  g.generic_compound_field_is_pointer.init(0);
  g.generic_enum_names.init(0);
  g.generic_enum_type_params.init(0);
  g.generic_enum_variants.init(0);
  g.emitted_generic_instantiations.init(0);
  g.generic_impl_templates.init(0);
  g.type_subst_param_names.init(0);
  g.type_subst_arg_type_strs.init(0);
  g.type_subst_arg_is_pointer.init(0);
  g.hoist_insert_pos = .None;
  g.current_fn_rtype_name = "";
  g.current_fn_rtype_dt = .None;
  g.expected_enum_type = "";
  g.expected_compound_type = "";
  g.defer_stack.init(0);
  g.defer_scope_starts.init(0);
  g.uses_fork = false;
  ret g;
}

// True if `node`'s subtree contains a `fork <call>;` statement anywhere,
// through nested if/elif/else/defer/for/fit bodies -- ported from the
// original implementation's own `node_contains_fork`. A `fork` is always
// a statement, never nested inside an expression, so only the statement/
// body shapes that can directly contain one need walking.
fun node_contains_fork(Node* node) bin {
  fit node.kind {
    .StatementFork(_) -> { ret true; }
    .Body(bn) -> {
      for s : bn.statements {
        if node_contains_fork(s) {
          ret true;
        }
      }
      ret false;
    }
    .StatementIf(ifn) -> { ret node_contains_fork(ifn.body); }
    .StatementElseIf(ein) -> { ret node_contains_fork(ein.body); }
    .StatementElse(ebody) -> { ret node_contains_fork(ebody); }
    .StatementDefer(body) -> { ret node_contains_fork(body); }
    .StatementFor(fk) -> {
      fit fk {
        .Cond(fc) -> { ret node_contains_fork(fc.body); }
        .Range(fr) -> { ret node_contains_fork(fr.body); }
        .Iter(fi) -> { ret node_contains_fork(fi.body); }
      }
    }
    .StatementFit(f) -> {
      for br : f.branches {
        if node_contains_fork(br.body) {
          ret true;
        }
      }
      ret false;
    }
    .Function(fnv) -> {
      if fnv.has_body {
        ret node_contains_fork(fnv.body);
      }
      ret false;
    }
    .Impl(i) -> {
      for m : i.methods {
        if node_contains_fork(m) {
          ret true;
        }
      }
      ret false;
    }
    _ -> { ret false; }
  }
}

// True if any `fork` statement appears anywhere across `nodes` -- the
// program's whole flattened top-level declaration list. Unlike the
// original implementation's own `uses_fork_recursive`, there is no
// separate "recurse into imported children" step to port: selfhost's
// `nodes` is already the WHOLE program, imports already resolved and
// flattened in before codegen ever runs (see `import_resolver.fn`).
fun uses_fork_in(Vec<Node> nodes) bin {
  for n : nodes {
    if node_contains_fork(&n) {
      ret true;
    }
  }
  ret false;
}

// True when `dt` is a pointer of any depth -- mirrors `write_type`'s own
// `ptr_depth`/`flags.is_pointer` check.
fun dtype_is_pointer(DataType dt) bin {
  if dt.pointer_depth > 0 {
    ret true;
  }
  ret dt.flags.is_pointer;
}

impl Codegen {

  // Writes `type_name`'s bare C spelling (no pointer stars): a sized/
  // dynamic int (`iN`/`uN`) via `dynamic_int_type_to_c`, else the
  // builtin mapping via `map_type_to_c` (a user-defined type name passes
  // through unchanged, matching the original). Split out of `write_type`
  // so `ensure_compound_instantiated` can apply the exact same rule to
  // an already-RESOLVED field type name, not just a raw `DataType`.
  write_type_name(str type_name) {
    fit parse_dynamic_int_datatype(type_name) {
      .Some(dyn) -> { self.state.write(dynamic_int_type_to_c(dyn)); }
      .None -> { self.state.write(map_type_to_c(type_name)); }
    }
  }

  // When an active substitution context exists (see `Codegen.
  // type_subst_param_names`'s doc comment -- set only while emitting a
  // monomorphized generic impl method, see
  // `maybe_instantiate_generic_impl_methods`), returns a COPY of `dt`
  // with every BARE occurrence of one of the active type-param names
  // substituted for its concrete argument -- either `dt` itself (a
  // method's own `T` param/return type substitutes directly to `num`),
  // or one of `dt`'s OWN generic arguments (a `Vec<T>` local inside the
  // method body substitutes to `Vec<num>`), matching the exact same
  // "must be a bare occurrence, no nested generic args of its own"
  // restriction `ensure_compound_instantiated` already applies to a
  // generic compound template's own fields. Returns `dt` UNCHANGED (not
  // a copy) when no substitution context is active at all, so every
  // ordinary (non-generic-impl-method) call site pays zero cost.
  resolve_type_subst(DataType dt) DataType {
    if self.type_subst_param_names.len == 0 {
      ret dt;
    }
    if dt.generic_args.len == 0 {
      for i : 0..self.type_subst_param_names.len {
        if equals(self.type_subst_param_names.get(i), dt.type_str) {
          DataType out = dtype_new();
          out.type_str = self.type_subst_arg_type_strs.get(i);
          out.flags = dt.flags;
          num extra = 0;
          if self.type_subst_arg_is_pointer.get(i) {
            extra = 1;
          }
          out.pointer_depth = dt.pointer_depth + extra;
          ret out;
        }
      }
      ret dt;
    }
    DataType out = dtype_new();
    out.type_str = dt.type_str;
    out.pointer_depth = dt.pointer_depth;
    out.flags = dt.flags;
    Vec<DataType*> new_args;
    new_args.init(0);
    for a : dt.generic_args {
      bin substituted = false;
      if a.generic_args.len == 0 {
        for i : 0..self.type_subst_param_names.len {
          if equals(self.type_subst_param_names.get(i), a.type_str) {
            DataType* sub = malloc(sizeof(DataType));
            *sub = dtype_new();
            sub.type_str = self.type_subst_arg_type_strs.get(i);
            num extra = 0;
            if self.type_subst_arg_is_pointer.get(i) {
              extra = 1;
            }
            sub.pointer_depth = a.pointer_depth + extra;
            new_args.push(sub);
            substituted = true;
            break;
          }
        }
      }
      if !substituted {
        new_args.push(a);
      }
    }
    out.generic_args = new_args;
    ret out;
  }

  // Writes `dt`'s C spelling via `write_type_name`, followed by one `*`
  // per pointer-depth level, and returns the RESOLVED type name used --
  // ordinarily just `dt.type_str` unchanged, but the MANGLED
  // monomorphization name (`Box__num`, `Option__num`) when `dt` is a
  // generic instantiation (`dt.generic_args` non-empty, resolved via
  // `ensure_compound_instantiated` or, when that doesn't recognize the
  // base name, `ensure_enum_instantiated`). `dt` is first passed through
  // `resolve_type_subst`, so a bare occurrence of a generic impl
  // method's own type param (`T`) resolves against the active
  // instantiation instead of being (wrongly) looked up as a plain
  // user-defined type name. Callers that need to register this type for
  // later lookup (`record_local`, a compound field's own registry
  // entry) must use the RETURNED name, not `dt.type_str` directly -- for
  // a generic instantiation those differ, and only the mangled name is
  // what `record_compound`/`record_enum`
  // register fields/variants under.
  // 
  // `.None` means `dt` is a generic instantiation this codegen can't
  // resolve (an unrecognized template, wrong argument count, or a
  // nested generic argument -- see `ensure_compound_instantiated`/
  // `ensure_enum_instantiated`'s doc comments) -- the caller must reject
  // rather than emit guessed/wrong C. Deliberately simplified from the
  // original for this slice: no C-typedef-alias resolution.
  pub write_type(DataType dt) Option<str> {
    let resolved = self.resolve_type_name(dt);
    if resolved.is_none() {
      ret .None;
    }
    str resolved_name = resolved.unwrap();
    self.write_type_name(resolved_name);
    let rdt = self.resolve_type_subst(dt);
    num ptr_depth = rdt.pointer_depth;
    if ptr_depth == 0 && rdt.flags.is_pointer {
      ptr_depth = 1;
    }
    num i = 0;
    for i < ptr_depth {
      self.state.write("*");
      i = i + 1;
    }
    ret .Some(resolved_name);
  }

  // The name-resolution half of `write_type`, split out so a caller that
  // only needs `dt`'s resolved NAME (not to emit its C spelling inline
  // right now) can trigger the same monomorphization side effect without
  // writing anything -- `emit_fit` uses this to resolve a `fit self.
  // method() { ... }` CALL subject's declared return type (see its own
  // doc comment), where a temp `__auto_type` variable holds the value
  // and no explicit C type needs to be written at all.
  resolve_type_name(DataType dt) Option<str> {
    let rdt = self.resolve_type_subst(dt);
    if rdt.generic_args.len == 0 {
      ret .Some(rdt.type_str);
    }
    let compound_inst = self.ensure_compound_instantiated(rdt);
    if compound_inst.is_some() {
      ret compound_inst;
    }
    ret self.ensure_enum_instantiated(rdt);
  }

  // Appends `text` (a fully-rendered struct/enum typedef or generic impl
  // method definition -- see the three call sites, each of which builds
  // its own text into a SCRATCH `CodegenState` first, by temporarily
  // pointing `self.state` at it, so their existing `self.state.write`
  // calls need no changes) either at the current tail of `self.state.out`
  // (when `hoist_insert_pos` is `.None` -- every hand-built unit test
  // below, which never calls `pub transpile`) or SPLICED in at the
  // tracked earlier position (when driven by `pub transpile`, so a
  // definition triggered from inside some top-level function/impl's own
  // body lands BEFORE that enclosing item instead of nested inside it --
  // see `Codegen.hoist_insert_pos`'s doc comment for why that distinction
  // matters). Advances `hoist_insert_pos` by `text`'s own length after a
  // splice, so a SECOND hoisted definition lands right after the first,
  // not before it.
  emit_hoisted(str text) {
    if self.hoist_insert_pos.is_none() {
      self.state.write(text);
      ret;
    }
    num pos = self.hoist_insert_pos.unwrap();
    str full = self.state.out.build();
    str head = substr(full, 0, pos);
    str tail = substr(full, pos, len(full) - pos);
    StringBuilder rebuilt = string_builder_init(len(full) + len(text) + 16);
    rebuilt.append(head);
    rebuilt.append(text);
    rebuilt.append(tail);
    self.state.out = rebuilt;
    self.hoist_insert_pos = .Some(pos + len(text));
  }

  // Given a DataType with `generic_args` non-empty (`Box<num>`),
  // resolves -- and, the FIRST time this exact instantiation is seen,
  // EMITS -- the concrete monomorphized C struct for it, returning the
  // mangled name (`Box__num`). Mangling matches the original
  // transpiler's own scheme (`append_mangled_type`): `<base>__<arg1>__
  // <arg2>...`, each arg's own Fun-level type name (`arg.type_str`),
  // with a `_ptrN` suffix when that arg itself has pointer depth
  // (`Vec<Node*>` -> `Vec__Node_ptr1`, distinct from `Vec<Node>` ->
  // `Vec__Node` -- these need DIFFERENT monomorphizations, a `T` field
  // substituting to `Node` by value vs. `Node*` by pointer). A repeat
  // instantiation with the SAME mangled name is recognized via
  // `emitted_generic_instantiations` and not re-emitted.
  // 
  // A NESTED generic argument (`Vec<Vec<num>>`, `Result<Option<Token>,
  // Error>`) resolves (and, on first use, emits) the inner instantiation
  // FIRST via `resolve_type_name`, then uses ITS OWN mangled name as
  // this position's arg name -- this recurses to arbitrary depth, not
  // just one level.
  // 
  // `.None` means: `dt.type_str` isn't a known generic compound
  // template, the argument COUNT doesn't match the template's own
  // type-param count, or a nested argument itself couldn't be resolved.
  // Each template field must be a bare occurrence of one of the
  // template's OWN type-param names (`T value;`) to be substituted --
  // an array-of-generic field (`T[] data;`, e.g. the real `Vec<T>`'s own
  // `data` field) or any other non-matching field type is left
  // UNCHANGED (not substituted), which is only correct when that field
  // doesn't actually depend on the type param -- a template with a
  // genuinely generic array field isn't fully supported by this slice
  // yet.
  ensure_compound_instantiated(DataType dt) Option<str> {
    num template_idx = 0;
    bin found = false;
    for template_idx < self.generic_compound_names.len {
      if equals(self.generic_compound_names.get(template_idx), dt.type_str) {
        found = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found {
      ret .None;
    }

    let type_params = self.generic_compound_type_params.get(template_idx);
    if type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder name_sb = string_builder_init(16);
    name_sb.append(dt.type_str);
    Vec<str> arg_type_names;
    arg_type_names.init(0);
    Vec<bin> arg_is_pointer;
    arg_is_pointer.init(0);
    num ai = 0;
    for ai < dt.generic_args.len {
      let arg = dt.generic_args.get(ai);
      str arg_name = arg.type_str;
      if arg.generic_args.len > 0 {
        // A NESTED generic argument (`Result<Option<Token>, Error>`'s
        // own first arg, `Option<Token>`) -- resolve (and, on first
        // use, EMIT) it FIRST via the exact same `resolve_type_name`
        // dispatch `write_type` itself uses, so it's already hoisted
        // and dedup-registered before the OUTER type's own mangled name
        // even gets built. Its OWN resolved (mangled) name becomes THIS
        // position's arg name, same as any other arg.
        let nested_name = self.resolve_type_name(*arg);
        if nested_name.is_none() {
          ret .None;
        }
        arg_name = nested_name.unwrap();
      }
      name_sb.append("__");
      name_sb.append(arg_name);
      bin arg_ptr = dtype_is_pointer(*arg);
      if arg_ptr {
        name_sb.append("_ptr");
        name_sb.append(format_num(arg.pointer_depth));
      }
      arg_type_names.push(arg_name);
      arg_is_pointer.push(arg_ptr);
      ai = ai + 1;
    }
    str mangled_name = name_sb.build();

    num ei = 0;
    for ei < self.emitted_generic_instantiations.len {
      if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
        ret .Some(mangled_name);
      }
      ei = ei + 1;
    }

    let field_names = self.generic_compound_field_names.get(template_idx);
    let field_type_names = self.generic_compound_field_type_names.get(template_idx);
    let field_is_pointer = self.generic_compound_field_is_pointer.get(template_idx);

    Vec<str> resolved_field_names;
    resolved_field_names.init(0);
    Vec<str> resolved_field_type_names;
    resolved_field_type_names.init(0);
    Vec<bin> resolved_field_is_pointer;
    resolved_field_is_pointer.init(0);

    CodegenState typedef_scratch = codegen_state_new();
    CodegenState* saved_state = self.state;
    self.state = &typedef_scratch;
    self.state.write("typedef struct ");
    self.state.write(mangled_name);
    self.state.write(" {\n");
    num fi = 0;
    for fi < field_names.len {
      str ftype = field_type_names.get(fi);
      bin fptr = field_is_pointer.get(fi);
      str resolved_type = ftype;
      bin resolved_ptr = fptr;
      num pi = 0;
      for pi < type_params.len {
        if equals(type_params.get(pi), ftype) {
          resolved_type = arg_type_names.get(pi);
          resolved_ptr = arg_is_pointer.get(pi);
          break;
        }
        pi = pi + 1;
      }
      self.state.write("  ");
      self.write_type_name(resolved_type);
      if resolved_ptr {
        self.state.write("*");
      }
      self.state.write(" ");
      self.state.write(field_names.get(fi));
      self.state.write(";\n");
      resolved_field_names.push(field_names.get(fi));
      resolved_field_type_names.push(resolved_type);
      resolved_field_is_pointer.push(resolved_ptr);
      fi = fi + 1;
    }
    self.state.write("} ");
    self.state.write(mangled_name);
    self.state.write(";\n\n");
    self.state = saved_state;
    self.emit_hoisted(typedef_scratch.out.build());

    self.record_compound(
      mangled_name,
      resolved_field_names,
      resolved_field_type_names,
      resolved_field_is_pointer
    );
    self.emitted_generic_instantiations.push(mangled_name);
    self.maybe_instantiate_generic_impl_methods(
      dt.type_str,
      mangled_name,
      arg_type_names,
      arg_is_pointer
    );
    ret .Some(mangled_name);
  }

  // Given a DataType with `generic_args` non-empty (`Option<num>`),
  // resolves -- and, the FIRST time this exact instantiation is seen,
  // EMITS -- the concrete monomorphized C enum/tagged-union for it,
  // returning the mangled name (`Option__num`). Mirrors
  // `ensure_compound_instantiated` almost exactly (same mangling
  // scheme -- including resolving a NESTED generic argument first, to
  // arbitrary depth, via `resolve_type_name` -- same `.None` conditions,
  // same repeat-instantiation dedup via `emitted_generic_instantiations`, shared
  // with compounds since a compound and an enum can never share a bare
  // name); the difference is purely in what gets emitted per variant
  // (see `emit_tagged_union_enum_instance`'s doc comment for the
  // tagged-union layout, or a plain C enum inline below when no variant
  // has a payload).
  // 
  // Only called from `write_type` AFTER `ensure_compound_instantiated`
  // already found no matching compound template -- so this only needs
  // to search the ENUM registry, not re-check compounds.
  ensure_enum_instantiated(DataType dt) Option<str> {
    num template_idx = 0;
    bin found = false;
    for template_idx < self.generic_enum_names.len {
      if equals(self.generic_enum_names.get(template_idx), dt.type_str) {
        found = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found {
      ret .None;
    }

    let type_params = self.generic_enum_type_params.get(template_idx);
    if type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder name_sb = string_builder_init(16);
    name_sb.append(dt.type_str);
    Vec<str> arg_type_names;
    arg_type_names.init(0);
    Vec<bin> arg_is_pointer;
    arg_is_pointer.init(0);
    num ai = 0;
    for ai < dt.generic_args.len {
      let arg = dt.generic_args.get(ai);
      str arg_name = arg.type_str;
      if arg.generic_args.len > 0 {
        // See `ensure_compound_instantiated`'s own doc comment: a nested
        // generic argument resolves (and, on first use, emits) FIRST via
        // `resolve_type_name`, recursing to arbitrary depth.
        let nested_name = self.resolve_type_name(*arg);
        if nested_name.is_none() {
          ret .None;
        }
        arg_name = nested_name.unwrap();
      }
      name_sb.append("__");
      name_sb.append(arg_name);
      bin arg_ptr = dtype_is_pointer(*arg);
      if arg_ptr {
        name_sb.append("_ptr");
        name_sb.append(format_num(arg.pointer_depth));
      }
      arg_type_names.push(arg_name);
      arg_is_pointer.push(arg_ptr);
      ai = ai + 1;
    }
    str mangled_name = name_sb.build();

    num ei = 0;
    for ei < self.emitted_generic_instantiations.len {
      if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
        ret .Some(mangled_name);
      }
      ei = ei + 1;
    }

    let variant_templates = self.generic_enum_variants.get(template_idx);

    bin is_tagged_union = false;
    for vt : variant_templates {
      if vt.has_payload {
        is_tagged_union = true;
      }
    }

    Vec<str> variant_names;
    variant_names.init(0);
    for vt : variant_templates {
      variant_names.push(vt.name);
    }

    CodegenState enum_scratch = codegen_state_new();
    CodegenState* saved_enum_state = self.state;
    self.state = &enum_scratch;
    if is_tagged_union {
      self.emit_tagged_union_enum_instance(
        mangled_name,
        variant_templates,
        type_params,
        arg_type_names,
        arg_is_pointer
      );
    } else {
      self.state.write("typedef enum ");
      self.state.write(mangled_name);
      self.state.write(" {\n");
      for vt : variant_templates {
        self.state.write("  ");
        self.state.write(mangled_name);
        self.state.write("_");
        self.state.write(vt.name);
        self.state.write(",\n");
      }
      self.state.write("} ");
      self.state.write(mangled_name);
      self.state.write(";\n\n");
    }
    self.state = saved_enum_state;
    self.emit_hoisted(enum_scratch.out.build());

    self.record_enum(mangled_name, variant_names, is_tagged_union);
    self.emitted_generic_instantiations.push(mangled_name);
    self.maybe_instantiate_generic_impl_methods(
      dt.type_str,
      mangled_name,
      arg_type_names,
      arg_is_pointer
    );
    ret .Some(mangled_name);
  }

  // Called by `ensure_compound_instantiated`/`ensure_enum_instantiated`
  // right after emitting a NEW concrete monomorphization of a generic
  // compound/enum template (`base_name` is the template's own bare name,
  // e.g. `"Box"`; `mangled_name` this instantiation's mangled name, e.g.
  // `"Box__num"`), monomorphizing and emitting every method of a generic
  // impl block matching `base_name` (`impl Box<T> { ... }` or `impl
  // Box<T> as Quirk { ... }`), if one was registered (see
  // `Codegen.generic_impl_templates`'s doc comment) -- a NO-OP when no
  // such impl exists (a generic compound/enum needn't have one). Called
  // only on FIRST instantiation (guarded by the caller's own
  // `emitted_generic_instantiations` dedup check), so a method is never
  // emitted twice for the same concrete arguments.
  // 
  // Each method's self/param/return/local types resolve against
  // `arg_type_names`/`arg_is_pointer` (positionally matched to the
  // impl's own `type_params`) via the `type_subst_*` substitution
  // context (see `resolve_type_subst`'s doc comment), pushed here and
  // restored afterward -- a method BODY can itself trigger a NESTED
  // instantiation (e.g. using some other generic type with the same
  // type param), which must not clobber the outer, still-in-progress
  // substitution once that nested call returns. A method's C symbol
  // mangles to `<mangled_name>__<bare_method_name>` (or `<mangled_name>
  // __<Quirk>__<bare_method_name>` for a quirk-implementing impl),
  // registered via `record_impl_method` under `mangled_name` as the
  // owner type so a call through a receiver of this monomorphized type
  // (recorded under `mangled_name` by `record_local`, since that's what
  // `write_type` returns for it) resolves via the ordinary
  // `emit_method_call` path with no changes needed there.
  // 
  // `emit_function_named`'s own `Option<CodegenErrorKind>` result is
  // deliberately discarded per method (matching the same simplification
  // `emit_tagged_union_enum`'s own `write_type` call already makes for a
  // payload field) -- this function is itself called from deep inside
  // `write_type`'s own `Option<str>`-returning call chain
  // (`ensure_compound_instantiated`/`ensure_enum_instantiated`), and
  // propagating a per-method-instantiation failure through THAT chain's
  // different error type is a separate, larger plumbing change than this
  // slice's scope; an unsupported generic method body will simply emit
  // no/partial C for that one method rather than surface a codegen
  // error, which no existing test exercises.
  // 
  // A side-effect-free SIGNATURE-only emission of one generic impl
  // method's monomorphized C prototype (`<rtype> <new_name>(<params>);`),
  // used by `maybe_instantiate_generic_impl_methods` to forward-declare
  // every method of an instantiation BEFORE any of their bodies -- one
  // method's body can call ANOTHER method of the SAME instantiation
  // declared LATER in the source (`Option<T>.unwrap()` calling its own
  // `self.zero()`, `Vec<T>.init()` calling its own `self.grow()`), and
  // without a forward declaration the C compiler sees an implicit
  // (wrongly `int`-returning) declaration at the call site, then a
  // "conflicting types" error at the real definition. Deliberately does
  // NOT reuse `emit_function_param` (which also REGISTERS each param as a
  // known local, a side effect only appropriate during real body
  // emission) -- just resolves and writes each param's type.
  emit_generic_impl_method_prototype(Node m, str new_name) Option<CodegenErrorKind> {
    fit m.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        let rt = self.write_type(*f.rtype);
        if rt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write(" ");
        self.state.write(new_name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  let sig = v.var_type.fn_sig;
                  let prt = self.write_type(*sig.rtype);
                  if prt.is_none() {
                    ret .Some(CodegenErrorKind.UnsupportedNode);
                  }
                  self.state.write(" (*");
                  self.state.write(v.name);
                  self.state.write(")(");
                  bin pfirst = true;
                  for p : sig.params {
                    if !pfirst {
                      self.state.write(", ");
                    }
                    pfirst = false;
                    let pt = self.write_type(*p);
                    if pt.is_none() {
                      ret .Some(CodegenErrorKind.UnsupportedNode);
                    }
                  }
                  self.state.write(")");
                } else {
                  let wt = self.write_type(*v.var_type);
                  if wt.is_none() {
                    ret .Some(CodegenErrorKind.UnsupportedNode);
                  }
                  self.state.write(" ");
                  self.state.write(v.name);
                }
              }
              _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(");\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  maybe_instantiate_generic_impl_methods(
    str base_name,
    str mangled_name,
    Vec<str> arg_type_names,
    Vec<bin> arg_is_pointer
  ) {
    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if equals(i.type_name, base_name) && i.type_params.len == arg_type_names.len {
            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            self.type_subst_param_names = i.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            StringBuilder pfx = string_builder_init(16);
            pfx.append(i.type_name);
            pfx.append("__");
            if i.has_quirk_name {
              pfx.append(i.quirk_name);
              pfx.append("__");
            }
            str prefix = pfx.build();

            // Forward-declare every method of THIS instantiation before any
            // of their bodies (see `emit_generic_impl_method_prototype`'s
            // own doc comment for why) -- one shared scratch buffer, hoisted
            // as a single block right before the per-method bodies below
            // (`emit_hoisted` appends each call after the last, so this
            // block always lands first).
            CodegenState proto_scratch = codegen_state_new();
            CodegenState* saved_proto_state = self.state;
            let saved_proto_hoist_pos = self.hoist_insert_pos;
            self.state = &proto_scratch;
            self.hoist_insert_pos = .None;
            for pm : i.methods {
              str proto_tmpl_name = "";
              fit pm.kind {
                .Function(pfnv) -> { proto_tmpl_name = pfnv.name; }
                _ -> {}
              }
              let proto_bare_name = strip_prefix(proto_tmpl_name, prefix);
              StringBuilder pnb = string_builder_init(16);
              pnb.append(mangled_name);
              pnb.append("__");
              if i.has_quirk_name {
                pnb.append(i.quirk_name);
                pnb.append("__");
              }
              pnb.append(proto_bare_name);
              self.emit_generic_impl_method_prototype(*pm, pnb.build());
            }
            self.state = saved_proto_state;
            self.hoist_insert_pos = saved_proto_hoist_pos;
            self.emit_hoisted(proto_scratch.out.build());

            for m : i.methods {
              str tmpl_name = "";
              DataType* tmpl_rtype = nil;
              fit m.kind {
                .Function(fnv) -> {
                  tmpl_name = fnv.name;
                  if fnv.has_rtype {
                    tmpl_rtype = fnv.rtype;
                  }
                }
                _ -> {}
              }
              let bare_name = strip_prefix(tmpl_name, prefix);

              StringBuilder nb = string_builder_init(16);
              nb.append(mangled_name);
              nb.append("__");
              if i.has_quirk_name {
                nb.append(i.quirk_name);
                nb.append("__");
              }
              nb.append(bare_name);
              str new_name = nb.build();

              // The TEMPLATE's own declared return type (often a bare
              // `T`) substituted against THIS instantiation's concrete
              // binding, so `infer_let_expr_type` can resolve `let out =
              // res.unwrap();`-style locals against a monomorphized
              // generic impl method's return type too -- previously
              // always recorded as `nil` (untracked), so a `let` local
              // holding such a call's result was never a known local
              // afterward.
              DataType* recorded_rtype = nil;
              if tmpl_rtype != nil {
                DataType substituted_rtype = self.resolve_type_subst(*tmpl_rtype);
                recorded_rtype = malloc(sizeof(DataType));
                *recorded_rtype = substituted_rtype;
              }
              self.record_impl_method(mangled_name, bare_name, new_name, recorded_rtype);

              // `hoist_insert_pos` (if set) is a position measured
              // against the OUTER, now-swapped-away buffer -- suspending
              // it for the duration of the swap makes any NESTED
              // instantiation triggered from inside this method's own
              // signature/body (e.g. a return type that's ITSELF a
              // generic enum) append inline to `method_scratch` instead
              // of splicing at a stale position into the wrong buffer
              // (which corrupts `substr`'s own length arithmetic and
              // crashes) -- the whole scratch buffer still ends up
              // hoisted to the correct outer position via `emit_hoisted`
              // below regardless.
              // `emit_function_named` unconditionally resets/overwrites
              // `local_names`/`local_is_pointer`/`local_type_name`/
              // `current_fn_rtype_name` for ITS OWN target function, with
              // no awareness that it might be running NESTED inside
              // another function's own (still in-progress) emission --
              // e.g. this monomorphization can be triggered from
              // resolving an OUTER method's own return type, BEFORE that
              // outer method's own `self`/params are recorded. Without
              // saving/restoring these too, the outer method's `self`
              // would end up SHADOWED by this nested call's own leftover
              // entries (linear lookup finds the earlier, now-stale one
              // first), resolving field/method access against the WRONG
              // type entirely once the outer method's own body runs.
              CodegenState method_scratch = codegen_state_new();
              CodegenState* saved_method_state = self.state;
              let saved_hoist_pos = self.hoist_insert_pos;
              let saved_local_names = self.local_names;
              let saved_local_is_pointer = self.local_is_pointer;
              let saved_local_type_name = self.local_type_name;
              let saved_local_dtype = self.local_dtype;
              let saved_fn_rtype_name = self.current_fn_rtype_name;
              let saved_fn_rtype_dt = self.current_fn_rtype_dt;
              let saved_defer_stack = self.defer_stack;
              let saved_defer_scope_starts = self.defer_scope_starts;
              self.state = &method_scratch;
              self.hoist_insert_pos = .None;
              self.emit_function_named(*m, new_name);
              self.state = saved_method_state;
              self.hoist_insert_pos = saved_hoist_pos;
              self.local_names = saved_local_names;
              self.local_is_pointer = saved_local_is_pointer;
              self.local_type_name = saved_local_type_name;
              self.local_dtype = saved_local_dtype;
              self.current_fn_rtype_name = saved_fn_rtype_name;
              self.current_fn_rtype_dt = saved_fn_rtype_dt;
              self.defer_stack = saved_defer_stack;
              self.defer_scope_starts = saved_defer_scope_starts;
              self.emit_hoisted(method_scratch.out.build());
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
          }
        }
        _ -> {}
      }
    }
  }

  // Emits ONE concrete monomorphization of a generic tagged-union enum
  // template -- same C layout as `emit_tagged_union_enum`, but using
  // `mangled_name` throughout instead of the template's own bare name,
  // and substituting each variant's payload types against the
  // template's OWN type-param names (`type_params`), positionally
  // matched to this instantiation's concrete `arg_type_names`/
  // `arg_is_pointer` -- the exact same substitution
  // `ensure_compound_instantiated` applies to a generic compound's own
  // fields. A payload type that ISN'T a bare occurrence of one of
  // `type_params` is left unchanged, same limitation/reasoning as the
  // compound case (see `ensure_compound_instantiated`'s doc comment) --
  // covers `Option<T> { Some(T), None }`/`Result<T, E> { Ok(T), Err(E) }`
  // exactly, not a payload that's itself a nested generic instantiation
  // of the type param.
  emit_tagged_union_enum_instance(
    str mangled_name,
    Vec<GenericEnumVariantTemplate> variant_templates,
    Vec<str> type_params,
    Vec<str> arg_type_names,
    Vec<bin> arg_is_pointer
  ) {
    self.state.write("typedef enum ");
    self.state.write(mangled_name);
    self.state.write("_tag {\n");
    for vt : variant_templates {
      self.state.write("  ");
      self.state.write(mangled_name);
      self.state.write("_");
      self.state.write(vt.name);
      self.state.write(",\n");
    }
    self.state.write("} ");
    self.state.write(mangled_name);
    self.state.write("_tag;\n");

    self.state.write("typedef struct ");
    self.state.write(mangled_name);
    self.state.write(" {\n  ");
    self.state.write(mangled_name);
    self.state.write("_tag tag;\n  union {\n");
    for vt : variant_templates {
      if vt.has_payload {
        self.state.write("    struct { ");
        num i = 0;
        Vec<str> resolved_payload_names;
        resolved_payload_names.init(0);
        Vec<bin> resolved_payload_ptrs;
        resolved_payload_ptrs.init(0);
        for i < vt.payload_type_strs.len {
          str ptype = vt.payload_type_strs.get(i);
          bin pptr = vt.payload_is_pointer.get(i);
          str resolved_type = ptype;
          bin resolved_ptr = pptr;
          num pi = 0;
          for pi < type_params.len {
            if equals(type_params.get(pi), ptype) {
              resolved_type = arg_type_names.get(pi);
              resolved_ptr = arg_is_pointer.get(pi);
            }
            pi = pi + 1;
          }
          self.write_type_name(resolved_type);
          if resolved_ptr {
            self.state.write("*");
          }
          self.state.write(" _");
          self.state.write(format_num(i));
          self.state.write("; ");
          resolved_payload_names.push(resolved_type);
          resolved_payload_ptrs.push(resolved_ptr);
          i = i + 1;
        }
        self.state.write("} ");
        self.state.write(vt.name);
        self.state.write(";\n");
        self.record_enum_variant_payload(
          mangled_name,
          vt.name,
          resolved_payload_names,
          resolved_payload_ptrs
        );
      }
    }
    self.state.write("  } payload;\n} ");
    self.state.write(mangled_name);
    self.state.write(";\n\n");
  }

  // Records that local `name` is (or isn't) a pointer, and its declared
  // type name, for later `ident.field`/`recv.method(...)` decisions. See
  // the `Codegen.local_names`/`local_is_pointer`/`local_type_name` field
  // doc comment for the scope of this tracking. No FULL `DataType` on
  // hand here (a derived/synthesized name, not a real declaration's own
  // type) -- see `record_local_typed` for the sites that have one.
  record_local(str name, str type_name, bin is_pointer) {
    self.local_names.push(name);
    self.local_is_pointer.push(is_pointer);
    self.local_type_name.push(type_name);
    self.local_dtype.push(.None);
  }

  // Like `record_local`, but for a call site that has the local's REAL,
  // already-substituted `DataType` on hand (a `Variable` declaration or a
  // function/method parameter -- see `Codegen.local_dtype`'s doc
  // comment). `type_name`/`is_pointer` are still passed explicitly
  // (rather than re-derived from `dtype` here) since callers already
  // computed them via `write_type`/`dtype_is_pointer` for the C
  // declaration itself; this only ALSO keeps the structured type around.
  record_local_typed(str name, str type_name, bin is_pointer, DataType dtype) {
    self.local_names.push(name);
    self.local_is_pointer.push(is_pointer);
    self.local_type_name.push(type_name);
    self.local_dtype.push(.Some(dtype));
  }

  // Looks up whether `name` was recorded as a pointer local. `.None` means
  // `name` isn't a known local at all (e.g. it's a type name in an enum-
  // variant-constant or module-alias access, or a not-yet-supported
  // `self`) -- the caller must treat that as "can't handle this", not
  // "assume value type".
  lookup_local_is_pointer(str name) Option<bin> {
    num i = 0;
    for i < self.local_names.len {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_is_pointer.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `name`'s declared type name (e.g. "Point"), for building a
  // method call's mangled callee name. See `lookup_local_is_pointer`'s
  // doc comment -- same scope, same "can't handle this" contract on
  // `.None`.
  lookup_local_type_name(str name) Option<str> {
    num i = 0;
    for i < self.local_names.len {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_type_name.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `name`'s FULL structured `DataType`, when it was recorded
  // via `record_local_typed` -- see `Codegen.local_dtype`'s doc comment.
  // `.None` covers BOTH "not a known local at all" and "a known local,
  // but only recorded via plain `record_local`" -- the caller can't tell
  // these apart from this result alone (use `lookup_local_type_name`
  // first to distinguish, if that matters).
  lookup_local_dtype(str name) Option<DataType> {
    num i = 0;
    for i < self.local_names.len {
      if equals(self.local_names.get(i), name) {
        ret self.local_dtype.get(i);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Records `name` as a known enum with the given variant names and
  // tagged-union-ness, for later `EnumName.Variant` access recognition.
  // See the `Codegen.enum_names`/`enum_variant_names`/
  // `enum_is_tagged_union` field doc comment.
  record_enum(str name, Vec<str> variant_names, bin is_tagged_union) {
    self.enum_names.push(name);
    self.enum_variant_names.push(variant_names);
    self.enum_is_tagged_union.push(is_tagged_union);
  }

  // Records `variant_name`'s own OWN payload field types (positional),
  // for a tagged-union enum `enum_name` -- see `Codegen.
  // enum_variant_payload_owner`'s doc comment.
  record_enum_variant_payload(
    str enum_name,
    str variant_name,
    Vec<str> type_names,
    Vec<bin> is_pointer
  ) {
    self.enum_variant_payload_owner.push(enum_name);
    self.enum_variant_payload_variant.push(variant_name);
    self.enum_variant_payload_type_names.push(type_names);
    self.enum_variant_payload_is_pointer.push(is_pointer);
  }

  // Looks up `variant_name`'s own payload field type at `position`
  // (0-based) for the tagged-union enum `enum_name` -- see `Codegen.
  // enum_variant_payload_owner`'s doc comment. `.None` means the
  // enum/variant isn't recorded, or `position` is out of range -- the
  // caller must treat that as "can't resolve this binding's type," not
  // guess.
  lookup_enum_variant_payload_type(str enum_name, str variant_name, num position) Option<FieldTypeInfo> {
    num i = 0;
    for i < self.enum_variant_payload_owner.len {
      if equals(self.enum_variant_payload_owner.get(i), enum_name) && equals(
        self.enum_variant_payload_variant.get(i),
        variant_name
      ) {
        let type_names = self.enum_variant_payload_type_names.get(i);
        if position < 0 || position >= type_names.len {
          ret .None;
        }
        let is_pointers = self.enum_variant_payload_is_pointer.get(i);
        FieldTypeInfo info;
        info.type_name = type_names.get(position);
        info.is_pointer = is_pointers.get(position);
        info.dtype = .None;
        ret .Some(info);
      }
      i = i + 1;
    }
    ret .None;
  }

  // True if `enum_name` was recorded as a known enum with a variant
  // named `variant_name`. False for an unrecognized enum name OR a
  // recognized enum with no such variant -- either way, the caller must
  // treat that as "not a qualified enum-variant access", not guess.
  enum_has_variant(str enum_name, str variant_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        let variants = self.enum_variant_names.get(i);
        num j = 0;
        for j < variants.len {
          if equals(variants.get(j), variant_name) {
            ret true;
          }
          j = j + 1;
        }
        ret false;
      }
      i = i + 1;
    }
    ret false;
  }

  // True if `enum_name` was recorded as a known TAGGED-UNION enum. False
  // for an unrecognized name OR a recognized plain enum -- either way,
  // the caller must treat "unrecognized" as "can't handle this", not
  // guess (there's no ambiguity for a RECOGNIZED plain enum, though:
  // `false` there correctly means "just the bare constant").
  enum_is_tagged_union_named(str enum_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        ret self.enum_is_tagged_union.get(i);
      }
      i = i + 1;
    }
    ret false;
  }

  // Records `name` as a known compound with the given fields' names and
  // declared types, for later chained-field-access resolution. See the
  // `Codegen.compound_names`/etc. field doc comment. No full per-field
  // `DataType` on hand here (a hand-built unit test's stand-in fields,
  // not a real declaration's own) -- see `record_compound_typed` for the
  // call site that has one.
  record_compound(
    str name,
    Vec<str> field_names,
    Vec<str> field_type_names,
    Vec<bin> field_is_pointer
  ) {
    Vec<Option<DataType>> field_dtypes;
    field_dtypes.init(0);
    num k = 0;
    for k < field_names.len {
      field_dtypes.push(.None);
      k = k + 1;
    }
    self.compound_names.push(name);
    self.compound_field_names.push(field_names);
    self.compound_field_type_names.push(field_type_names);
    self.compound_field_is_pointer.push(field_is_pointer);
    self.compound_field_dtype.push(field_dtypes);
  }

  // Like `record_compound`, but for a call site that has each field's
  // REAL, un-mangled `DataType` on hand (`emit_compound`'s own real
  // field pass) -- see `FieldTypeInfo.dtype`'s doc comment.
  record_compound_typed(
    str name,
    Vec<str> field_names,
    Vec<str> field_type_names,
    Vec<bin> field_is_pointer,
    Vec<DataType> field_dtypes_raw
  ) {
    Vec<Option<DataType>> field_dtypes;
    field_dtypes.init(0);
    for d : field_dtypes_raw {
      field_dtypes.push(.Some(d));
    }
    self.compound_names.push(name);
    self.compound_field_names.push(field_names);
    self.compound_field_type_names.push(field_type_names);
    self.compound_field_is_pointer.push(field_is_pointer);
    self.compound_field_dtype.push(field_dtypes);
  }

  // Looks up `field_name`'s declared type on the known compound
  // `compound_name`. `.None` means either isn't recognized -- the
  // caller must treat that as "can't handle this", not guess.
  lookup_compound_field(str compound_name, str field_name) Option<FieldTypeInfo> {
    num i = 0;
    for i < self.compound_names.len {
      if equals(self.compound_names.get(i), compound_name) {
        let field_names = self.compound_field_names.get(i);
        let field_types = self.compound_field_type_names.get(i);
        let field_ptrs = self.compound_field_is_pointer.get(i);
        let field_dtypes = self.compound_field_dtype.get(i);
        num j = 0;
        for j < field_names.len {
          if equals(field_names.get(j), field_name) {
            FieldTypeInfo info;
            info.type_name = field_types.get(j);
            info.is_pointer = field_ptrs.get(j);
            info.dtype = field_dtypes.get(j);
            ret .Some(info);
          }
          j = j + 1;
        }
        ret .None;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Records one impl method's owning type, bare name, fully mangled
  // C call-site name, and OWN declared return type (`nil` when unknown,
  // e.g. a generic impl's method -- see `Codegen.impl_method_rtype`'s
  // doc comment) -- see `Codegen.impl_method_owner_type`'s doc comment.
  record_impl_method(str owner_type, str bare_name, str mangled_name, DataType* rtype) {
    self.impl_method_owner_type.push(owner_type);
    self.impl_method_bare_name.push(bare_name);
    self.impl_method_mangled_name.push(mangled_name);
    self.impl_method_rtype.push(rtype);
  }

  // Looks up `bare_name`'s OWN declared return type on the known
  // impl-implementing type `owner_type` -- see `Codegen.
  // impl_method_rtype`'s doc comment. `.None` means either the method
  // isn't recognized at all, or it IS but its return type wasn't
  // recorded (a generic impl's method).
  lookup_impl_method_rtype(str owner_type, str bare_name) Option<DataType*> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) && equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        let rtype = self.impl_method_rtype.get(i);
        if rtype == nil {
          ret .None;
        }
        ret .Some(rtype);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s fully mangled C call-site name on the known
  // impl-implementing type `owner_type`. `.None` means either isn't
  // recognized -- the caller must treat that as "not registered yet (or
  // ever)", not guess.
  lookup_impl_method(str owner_type, str bare_name) Option<str> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) && equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        ret .Some(self.impl_method_mangled_name.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Writes a backtick RAW string literal's literal bytes as a C
  // string-literal body. Unlike an ordinary string (whose bytes already
  // ARE valid C escape syntax, verbatim from the lexer), a raw string's
  // bytes are the user's literal, unescaped content -- this encodes the
  // handful of bytes that would otherwise break or change the meaning of
  // a C string literal: a backslash (else read as the start of an
  // escape), a double-quote (else ends the literal early), and a real
  // newline (a multi-line raw string's line-joins -- C string literals
  // can't contain one directly). Everything else passes through
  // unchanged.
  write_raw_string_body(str s) {
    num i = 0;
    num n = len(s);
    for i < n {
      chr c = s[i];
      if c == '\\' {
        self.state.write("\\\\");
      } elif c == '"' {
        self.state.write("\\\"");
      } elif c == '\n' {
        self.state.write("\\n");
      } elif c == '\r' {
        self.state.write("\\r");
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
      i = i + 1;
    }
  }

  // Writes a single-quoted C character literal for `c`, escaping the
  // same fixed set the original does (backslash/quote/newline/CR/tab/
  // NUL), and any other non-printable-ASCII byte as `\xHH`.
  write_char_literal(chr c) {
    self.state.write("'");
    if c == '\\' {
      self.state.write("\\\\");
    } elif c == '\'' {
      self.state.write("\\'");
    } elif c == '\n' {
      self.state.write("\\n");
    } elif c == '\r' {
      self.state.write("\\r");
    } elif c == '\t' {
      self.state.write("\\t");
    } elif c == 0 {
      self.state.write("\\0");
    } else {
      num code = c;
      if code < 0x20 || code >= 0x7f {
        self.state.write(format("\\x{num}", code));
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
    }
    self.state.write("'");
  }

  // Emits `node` as a C expression. Only literal (primary) expression
  // kinds are supported this slice -- see this file's own top-level doc
  // comment for what's deliberately still missing.
  pub emit_expr(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Num(n) -> {
            self.state.write(format_num(n));
            ret .None;
          }
          .Dec(d) -> {
            self.state.write(format_dec(d, 6));
            ret .None;
          }
          _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
        }
      }
      .String(s) -> {
        self.state.write("\"");
        if node.flags.is_raw_string {
          self.write_raw_string_body(s);
        } else {
          self.state.write(s);
        }
        self.state.write("\"");
        ret .None;
      }
      .Character(c) -> {
        self.write_char_literal(c);
        ret .None;
      }
      .Boolean(b) -> {
        if b {
          self.state.write("true");
        } else {
          self.state.write("false");
        }
        ret .None;
      }
      .Nil -> {
        self.state.write("NULL");
        ret .None;
      }
      .Panic(msg) -> {
        // `panic(msg)` "unifies with whatever type is expected at its use
        // site" (see `NodeKind.Panic`'s own doc comment in ast.fn) --
        // prints the message and aborts, never actually producing a
        // value. Matches the original's own general (non-`ret`-special-
        // cased) lowering exactly: a GNU C statement expression that
        // prints, aborts, and trails off with a plain `0` so it type-checks
        // as almost any scalar/pointer context (though not a struct/union
        // one -- not supported, same as the original). Deliberately
        // simplified from the original for this slice: no separate,
        // slightly terser lowering for `ret panic(msg);` specifically
        // (the original skips the trailing `0` there, since `abort()`
        // never returns) -- this one form covers every context.
        self.state.write("({ fprintf(stderr_stream(), \"panic: %s\\n\", ");
        let merr = self.emit_expr(*msg);
        if merr.is_some() {
          ret merr;
        }
        self.state.write("); abort(); 0; })");
        ret .None;
      }
      .CompoundInit(ci) -> {
        // `Type{ field = value, ... }` (explicit -- `ci.has_dtype`, e.g.
        // `typedefs.fn`'s own real `DynamicIntType{is_signed = ..., bits
        // = ...}`) or `.{ field = value, ... }` (bare, resolved against
        // `Codegen.expected_compound_type` -- see its own doc comment,
        // e.g. `dtype_new`'s own real `dt.flags = .{is_pointer = false,
        // ...};`). Lowers to a GNU C compound literal, same shape as the
        // original's own (non-typechecking) emission: `(Type){ .field =
        // value, ... }`, or `(Type){0}` for an empty initializer.
        str type_name = "";
        if ci.has_dtype {
          let resolved = self.resolve_type_name(*ci.init_dtype);
          if resolved.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          type_name = resolved.unwrap();
        } elif !equals(self.expected_compound_type, "") {
          type_name = self.expected_compound_type;
        } else {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write("(");
        self.state.write(type_name);
        self.state.write("){");
        if ci.fields.len == 0 {
          self.state.write("0");
        } else {
          bin first = true;
          for f : ci.fields {
            if !first {
              self.state.write(", ");
            }
            first = false;
            self.state.write(".");
            self.state.write(f.name);
            self.state.write(" = ");
            let ferr = self.emit_expr(*f.value);
            if ferr.is_some() {
              ret ferr;
            }
          }
        }
        self.state.write("}");
        ret .None;
      }
      .Identifier(name) -> {
        self.state.write(name);
        ret .None;
      }
      .ExpressionParenthesis(inner) -> {
        // An explicit parenthesized sub-expression (`(a + b)`), reached
        // directly -- not the argument-list wrapper of a call, which
        // `emit_call`/`flatten_call_args` consume before this dispatch is
        // ever reached for it.
        self.state.write("(");
        let ierr = self.emit_expr(*inner);
        if ierr.is_some() {
          ret ierr;
        }
        self.state.write(")");
        ret .None;
      }
      .Unary(u) -> {
        self.state.write("(");
        if u.is_left_operanded_unary {
          // Postfix: `x++`/`x--`.
          let oerr = self.emit_expr(*u.operand);
          if oerr.is_some() {
            ret oerr;
          }
          self.state.write(u.op);
        } elif u.has_indirection {
          // Pointer indirection (`*p`, `**pp`, ...): a run of `*`s for the
          // depth, not the single `u.op` (always "*" here anyway).
          num i = 0;
          for i < u.indirection_depth {
            self.state.write("*");
            i = i + 1;
          }
          let oerr2 = self.emit_expr(*u.operand);
          if oerr2.is_some() {
            ret oerr2;
          }
        } else {
          // Prefix (`-x`, `!x`, `~x`, `&x`).
          self.state.write(u.op);
          let oerr3 = self.emit_expr(*u.operand);
          if oerr3.is_some() {
            ret oerr3;
          }
        }
        self.state.write(")");
        ret .None;
      }
      .Expression(e) -> {
        // A bare `,` (reached directly, i.e. NOT as part of a call's
        // argument list -- see `emit_call`/`flatten_call_args`) doesn't
        // have dedicated handling yet. `()` (calls), `.` (member access,
        // single-level only -- see `emit_field_access`'s doc comment),
        // and `[]` (indexing -- see `emit_index`'s doc comment) ARE
        // handled. Every OTHER binary operator (arithmetic/comparison/
        // logical/bitwise/assignment) already has an identical C
        // spelling and a plain `(left op right)` emission is correct
        // as-is.
        if equals(e.op, "()") {
          ret self.emit_call(e);
        }
        if equals(e.op, ".") {
          ret self.emit_field_access(e);
        }
        if equals(e.op, "[]") {
          ret self.emit_index(e);
        }
        if equals(e.op, ",") {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        if !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.state.write("(");
        let lerr = self.emit_expr(*e.left);
        if lerr.is_some() {
          ret lerr;
        }
        self.state.write(" ");
        self.state.write(e.op);
        self.state.write(" ");

        // An assignment's right-hand side (`t.data = .Cval(0);`, an
        // extremely common shape in this codebase's own real source --
        // see `Codegen.expected_enum_type`'s doc comment), or an
        // equality/inequality comparison's right-hand side (`self.kind ==
        // .None`, equally common -- `is_ok()`/`is_err()`-style predicate
        // methods throughout this codebase's own real stdlib), may itself
        // be a bare enum-variant shorthand. Resolve the LEFT side's own
        // declared/resolved type via `resolve_field_chain` (a plain
        // identifier or a field-access chain both work; `e.left` was
        // already EMITTED just above, this is a second, non-writing
        // resolution purely to learn its type) and use it as the
        // shorthand's expected type for just this right-hand expression.
        // An unresolvable left side (anything `resolve_field_chain`
        // rejects) leaves `expected_enum_type` untouched -- if the right
        // side needs it and it's still empty/stale, it's rejected same
        // as ever, not guessed. Deliberately narrow for this slice: only
        // the RIGHT side is ever treated as a possible shorthand -- `.
        // None == self.kind` (shorthand on the LEFT) isn't reachable,
        // since `e.left` is already emitted by the time either side's
        // type could be known.
        bin resolves_rhs_shorthand = equals(e.op, "=") || equals(e.op, "==") || equals(e.op, "!=");
        str prev_expected = self.expected_enum_type;
        str prev_expected_compound = self.expected_compound_type;
        if resolves_rhs_shorthand {
          let lhs_resolved = self.resolve_field_chain(e.left);
          if lhs_resolved.is_some() {
            let lhs_type_name = lhs_resolved.unwrap().type_name;
            self.expected_enum_type = lhs_type_name;
            // See `Codegen.expected_compound_type`'s doc comment: a bare
            // `.{...}` compound-literal shorthand on the right (`dt.flags
            // = .{is_pointer = false, ...};`, `dtype_new`'s own real
            // body) resolves against the SAME left-hand declared type as
            // a bare enum shorthand would -- the AST distinguishes which
            // one actually applies (`.CompoundInit` vs `.Expression` with
            // op `.`), so setting both unconditionally here is safe.
            self.expected_compound_type = lhs_type_name;
          }
        }
        let rerr = self.emit_expr(*e.right);
        if resolves_rhs_shorthand {
          self.expected_enum_type = prev_expected;
          self.expected_compound_type = prev_expected_compound;
        }
        if rerr.is_some() {
          ret rerr;
        }
        self.state.write(")");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Recursively flattens a call's argument-list node (the right side of
  // an `Expression{ op = "()" }`, always an `ExpressionParenthesis`
  // wrapping either `.Blank` for zero args, a single expression for one
  // arg, or a left-associative `,`-chained `Expression` tree for several
  // -- see `parse_for_parenthesis`'s doc comment) into individual
  // argument nodes, appended in left-to-right source order.
  flatten_call_args(Node* node, Vec<Node*>* out) {
    fit node.kind {
      .ExpressionParenthesis(inner) -> { self.flatten_call_args(inner, out); }
      .Blank -> {}
      .Expression(e) -> {
        if equals(e.op, ",") {
          if e.has_left {
            self.flatten_call_args(e.left, out);
          }
          if e.has_right {
            self.flatten_call_args(e.right, out);
          }
        } else {
          out.push(node);
        }
      }
      _ -> { out.push(node); }
    }
  }

  // Emits a call `callee(arg1, arg2, ...)`: a plain-identifier callee (an
  // ordinary free-function call) directly, or delegates to
  // `emit_method_call` when the callee is itself a `.`-Expression
  // (`recv.method(...)`).
  // 
  // Deliberately simplified from the original for this slice: a call
  // through another call's result (`f()()`) isn't reachable yet. No name
  // resolution/mangling for the free-function case either (aliasing,
  // generics, overload-by-arity) -- the callee's Fun name and its C name
  // are assumed identical, true for every plain function this slice can
  // otherwise construct.
  emit_call(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str callee_name = "";
    fit e.left.kind {
      .Identifier(name) -> { callee_name = name; }
      .Expression(recv_e) -> {
        if equals(recv_e.op, ".") {
          // `EnumName.Variant(args...)` (a tagged-union payload
          // construction) shares the exact same AST shape as a method
          // call (`recv.method(...)`) -- disambiguate by checking
          // whether the left side is a KNOWN ENUM NAME with that
          // variant first. See `emit_enum_variant_construction`'s doc
          // comment for the C this constructs.
          if recv_e.has_left && recv_e.has_right {
            str enum_name = "";
            bin have_enum_name = false;
            fit recv_e.left.kind {
              .Identifier(name) -> {
                enum_name = name;
                have_enum_name = true;
              }
              // Bare shorthand (`.Some(x)`, no `EnumName.` qualifier) --
              // see `Codegen.expected_enum_type`'s doc comment. If it
              // doesn't resolve to a known enum/variant below, this
              // falls through to `emit_method_call`, which already
              // rejects a non-identifier receiver on its own.
              .Blank -> {
                if !equals(self.expected_enum_type, "") {
                  enum_name = self.expected_enum_type;
                  have_enum_name = true;
                }
              }
              _ -> {}
            }
            if have_enum_name {
              fit recv_e.right.kind {
                .Identifier(variant_name) -> {
                  if self.enum_has_variant(enum_name, variant_name) {
                    ret self.emit_enum_variant_construction(enum_name, variant_name, e.right);
                  }
                }
                _ -> {}
              }
            }
          }
          ret self.emit_method_call(recv_e, e.right);
        }
        ret .Some(CodegenErrorKind.UnsupportedNode);
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(e.right, &args);

    // `sizeof(T)` where `T` is the bare type param of the generic impl
    // method currently being monomorphized (`Option<T>.zero()`'s own
    // `memset(&out, 0, sizeof(T))`) needs the SAME substitution every
    // other reference to `T` in this method body already gets via
    // `resolve_type_subst` -- but a `sizeof(...)` argument is parsed as
    // an ordinary call argument EXPRESSION (see `parser.fn`'s own
    // `parse_expressionable_single` doc comment: 'sizeof' isn't a real
    // keyword, just an identifier callee), never as a `DataType` that
    // flows through the type-substitution machinery at all -- so it was
    // previously emitted verbatim as the literal identifier `T`, which
    // doesn't exist in the generated C. Only fires when a substitution
    // context is ACTUALLY active and the argument matches one of its
    // params; every other `sizeof(...)` (a real, non-generic type name,
    // the overwhelmingly common case) falls through unchanged below.
    if equals(callee_name, "sizeof") && self.type_subst_param_names.len > 0 && args.len == 1 {
      str sizeof_operand = "";
      bin have_sizeof_operand = false;
      fit args.get(0).kind {
        .Identifier(name) -> {
          sizeof_operand = name;
          have_sizeof_operand = true;
        }
        _ -> {}
      }
      if have_sizeof_operand {
        num spi = 0;
        for spi < self.type_subst_param_names.len {
          if equals(self.type_subst_param_names.get(spi), sizeof_operand) {
            self.state.write("sizeof(");
            self.write_type_name(self.type_subst_arg_type_strs.get(spi));
            if self.type_subst_arg_is_pointer.get(spi) {
              self.state.write("*");
            }
            self.state.write(")");
            ret .None;
          }
          spi = spi + 1;
        }
      }
    }

    // A call to a GENERIC function (`err_kind(.Parse, "msg",
    // token_zero())`) is monomorphized from THIS call site's own
    // arguments, under a mangled name -- see
    // `maybe_instantiate_generic_function`'s doc comment. A plain
    // (already-registered non-generic) callee, or one this codegen
    // doesn't recognize at all, is left as `callee_name` unchanged --
    // matching this file's "no name resolution for the free-function
    // case" simplification elsewhere. `template_callee_name` (the
    // ORIGINAL, un-mangled name) is kept separately for the per-argument
    // bare-shorthand lookup below -- `lookup_function_param_type` only
    // recognizes a generic template under ITS OWN bare name, not the
    // mangled call-site name `callee_name` becomes once monomorphized.
    str template_callee_name = callee_name;
    let generic_inst = self.maybe_instantiate_generic_function(callee_name, args);
    if generic_inst.is_some() {
      callee_name = generic_inst.unwrap().mangled_name;
    }
    self.state.write(callee_name);
    self.state.write("(");

    bin first = true;
    num arg_idx = 0;
    for arg : args {
      if !first {
        self.state.write(", ");
      }
      first = false;

      // A bare enum-variant shorthand (`.Parse`) passed as a call
      // argument (`err_kind(.Parse, "msg", 0)`, e.g.
      // `_read_comment_block`'s real body in the self-hosted lexer's own
      // source, found via the self-compile experiment) resolves against
      // the CALLEE's own declared parameter type at this position. For
      // a GENERIC callee (`ok(.None)`, e.g.), this MUST be the call's
      // own ALREADY-SUBSTITUTED param type (`generic_inst`'s own
      // `param_types`, e.g. `Option<num>` -> `Option__num`, not the
      // template's raw, unsubstituted `T`) -- `T` alone would resolve to
      // nothing (not a real enum name) and reject a shorthand that
      // should actually work. Falls back to the plain (non-generic)
      // registry -- `Codegen.function_names`'s doc comment -- when this
      // callee wasn't a generic template at all. An unresolvable
      // callee/position leaves `expected_enum_type` untouched, same as
      // every other site.
      Option<DataType> ptype = .None;
      if generic_inst.is_some() {
        let call_res = generic_inst.unwrap();
        if arg_idx < call_res.param_types.len {
          ptype = .Some(call_res.param_types.get(arg_idx));
        }
      }
      if ptype.is_none() {
        let plain_ptype = self.lookup_function_param_type(template_callee_name, arg_idx);
        if plain_ptype.is_some() {
          ptype = .Some(*plain_ptype.unwrap());
        }
      }
      str prev_expected = self.expected_enum_type;
      if ptype.is_some() {
        let resolved = self.resolve_type_name(ptype.unwrap());
        if resolved.is_some() {
          self.expected_enum_type = resolved.unwrap();
        }
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      if aerr.is_some() {
        ret aerr;
      }
      arg_idx = arg_idx + 1;
    }
    self.state.write(")");
    ret .None;
  }

  // Emits a method call `recv.method(arg1, ...)` as C
  // `TypeName__method(<self-arg>, arg1, ...)` -- or `TypeName__Quirk__
  // method(...)` when `method` was defined by a QUIRK-implementing impl
  // instead of a plain one, resolved via `lookup_impl_method` (populated
  // by `register_impl_methods`' own pre-pass -- see `transpile`'s pass
  // ordering). Falls back to the plain `TypeName__method` naming
  // directly when nothing's registered (an isolated call to
  // `emit_method_call` outside `transpile`, as every existing unit test
  // below does) -- codegen doesn't invent either mangling scheme itself,
  // it only has to reproduce whichever one `_parse_impl_method` already
  // used for that method's `Function` node in the parser. The self-arg
  // is `recv` directly when `recv` is already a pointer local, or `&recv`
  // when it's a value local (the callee always expects a pointer,
  // matching the implicit `self` parameter's type).
  // 
  // Deliberately narrow for this slice: `recv` must be a plain
  // identifier OR a chained field access `resolve_field_chain` can
  // resolve (`self.parts.push(s)`, e.g. `StringBuilder.append`'s real
  // body in stdlib/std/string.fn, found via the self-compile
  // experiment -- reuses the exact same resolution `emit_fit`'s subject
  // and the bare-shorthand assignment case already use, rather than a
  // second, narrower bare-identifier-only lookup), and `method` a plain
  // identifier. An unrecognized receiver is REJECTED rather than
  // guessed, same spirit as `emit_field_access`. TRUE dynamic dispatch
  // (calling through a receiver declared as the ABSTRACT quirk type
  // itself, via a vtable) isn't reachable yet -- only a STATIC call
  // resolved by the receiver's own DECLARED (concrete) type name,
  // whether that type implements the method via a plain impl or a
  // quirk-implementing one.
  emit_method_call(ExprNode recv_e, Node* args_node) Option<CodegenErrorKind> {
    if !recv_e.has_left || !recv_e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    let recv_r_opt = self.resolve_field_chain(recv_e.left);
    if recv_r_opt.is_none() {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }
    let recv_r = recv_r_opt.unwrap();
    str method_name = "";
    fit recv_e.right.kind {
      .Identifier(name) -> { method_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    let registered = self.lookup_impl_method(recv_r.type_name, method_name);
    if registered.is_some() {
      self.state.write(registered.unwrap());
    } else {
      self.state.write(recv_r.type_name);
      self.state.write("__");
      self.state.write(method_name);
    }
    self.state.write("(");
    if recv_r.is_pointer {
      self.state.write(recv_r.text);
    } else {
      self.state.write("&");
      self.state.write(recv_r.text);
    }

    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);
    for arg : args {
      self.state.write(", ");
      let aerr = self.emit_expr(*arg);
      if aerr.is_some() {
        ret aerr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits a tagged-union compound literal for `EnumName.Variant(args...)`:
  // ((EnumName){ .tag = EnumName_Variant, .payload.Variant = { ._0 = (a0), ... } })
  // matching the struct layout `emit_tagged_union_enum` emits -- payload
  // field names `_0`, `_1`, ... line up positionally with the union
  // struct's own fields. `args_node` is the call's (possibly
  // comma-flattened) argument-list node; reuses `flatten_call_args`
  // directly, same as an ordinary call.
  emit_enum_variant_construction(str enum_name, str variant_name, Node* args_node) Option<CodegenErrorKind> {
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);

    self.state.write("((");
    self.state.write(enum_name);
    self.state.write("){ .tag = ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(", .payload.");
    self.state.write(variant_name);
    self.state.write(" = { ");
    num i = 0;
    for arg : args {
      if i > 0 {
        self.state.write(", ");
      }
      self.state.write("._");
      self.state.write(format_num(i));
      self.state.write(" = (");
      // A bare enum-variant shorthand nested inside ANOTHER variant's
      // own construction (`.Ok(.Some(t))` -- `check`'s real body once
      // `Result<Option<Token>, Error>` monomorphizes, e.g.) resolves
      // against THIS position's own payload type -- see `Codegen.
      // enum_variant_payload_owner`'s doc comment. An unresolvable
      // enum/variant/position leaves `expected_enum_type` untouched,
      // same as every other site.
      let payload_info = self.lookup_enum_variant_payload_type(enum_name, variant_name, i);
      str prev_expected = self.expected_enum_type;
      if payload_info.is_some() {
        self.expected_enum_type = payload_info.unwrap().type_name;
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      if aerr.is_some() {
        ret aerr;
      }
      self.state.write(")");
      i = i + 1;
    }
    self.state.write(" } })");
    ret .None;
  }

  // Emits `arr[i]` as C `arr[i]` -- the parser already built this as
  // `Expression{ op = "[]", left = arr, right = Bracket(i) }` (see
  // `parser.parse_for_bracket`'s doc comment, which also builds a bare
  // `Bracket` node with no left for an array LITERAL, `[1, 2, 3]` --
  // structurally distinct, not reachable through here). Needs no type
  // resolution at all: C's own `[]` composes directly with whatever
  // `arr` already emitted as (a raw array, a pointer, or a `.`/`->`
  // field access -- `self.data[i]` and `self->data[i]` both just work,
  // since `emit_expr(e.left)` already resolved that), and this codegen
  // doesn't track element types the way it tracks a LOCAL's own
  // compound/enum type, so there's nothing further to look up here
  // either. Reused automatically as an ASSIGNMENT target too (`arr[i] =
  // x;`) since the `=` case dispatches its own left side through this
  // same `emit_expr` -> `.Expression` path, exactly like `.`/`->` field
  // access already does.
  emit_index(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    let lerr = self.emit_expr(*e.left);
    if lerr.is_some() {
      ret lerr;
    }
    self.state.write("[");
    fit e.right.kind {
      .Bracket(inner) -> {
        let ierr = self.emit_expr(*inner);
        if ierr.is_some() {
          ret ierr;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
    self.state.write("]");
    ret .None;
  }

  // Emits `recv.field` as C `recv.field` or `recv->field`, deciding
  // `.`/`->` from `recv`'s DECLARED pointer-ness (`lookup_local_is_pointer`
  // -- no type inference, just the same "already fully explicit" model
  // this whole file uses elsewhere). Also recognizes a QUALIFIED
  // enum-variant-constant access (`EnumName.Variant`, checked first --
  // see `enum_has_variant`) and emits its mangled C constant
  // (`EnumName_Variant`, single underscore, matching `emit_enum`'s own
  // naming) instead of treating `EnumName` as a receiver, and a BARE
  // shorthand (`.Variant`, no qualifier) resolved against
  // `expected_enum_type`. A CHAINED access (`a.b.c`) recurses through
  // `emit_receiver_and_resolve_type` to resolve `.`/`->` at every link,
  // not just the outermost receiver.
  // 
  // Deliberately narrow for this slice: the enum-variant paths (qualified
  // or bare shorthand) only ever apply to a SINGLE-level receiver
  // (`Identifier`/`Blank`) -- the exact same AST shape also parses
  // `alias.symbol` (a module-aliased access), which isn't reachable yet
  // (needs import support), so an unrecognized single-level receiver is
  // rejected rather than guessed. See `emit_receiver_and_resolve_type`'s
  // own doc comment for what the chained-access path can't handle yet.
  emit_field_access(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str field_name = "";
    fit e.right.kind {
      .Identifier(name) -> { field_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    str enum_recv_name = "";
    bin is_bare_shorthand = false;
    bin left_is_single_level = false;
    fit e.left.kind {
      .Identifier(name) -> {
        enum_recv_name = name;
        left_is_single_level = true;
      }
      .Blank -> {
        // Bare shorthand (`.Variant`, no `EnumName.` qualifier) -- see
        // `Codegen.expected_enum_type`'s doc comment. Must NOT fall
        // through to the chained-access path below if this doesn't pan
        // out (there's no receiver identifier to look up at all).
        is_bare_shorthand = true;
        left_is_single_level = true;
        enum_recv_name = self.expected_enum_type;
      }
      _ -> {}
    }
    if left_is_single_level && !equals(enum_recv_name, "") && self.enum_has_variant(
      enum_recv_name,
      field_name
    ) {
      if self.enum_is_tagged_union_named(enum_recv_name) {
        // A tagged union's payload-less variant used as a bare VALUE
        // (no call) still needs the tag set: `((Enum){ .tag =
        // Enum_Variant })`, not just the bare discriminant constant --
        // see `emit_enum`'s doc comment for the struct layout this
        // constructs. `EnumName_Variant` alone would only be the
        // discriminant, not a complete `Enum`-typed value.
        self.state.write("((");
        self.state.write(enum_recv_name);
        self.state.write("){ .tag = ");
        self.state.write(enum_recv_name);
        self.state.write("_");
        self.state.write(field_name);
        self.state.write(" })");
      } else {
        self.state.write(enum_recv_name);
        self.state.write("_");
        self.state.write(field_name);
      }
      ret .None;
    }
    if is_bare_shorthand {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }

    let recv_info_opt = self.emit_receiver_and_resolve_type(e.left);
    if recv_info_opt.is_none() {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }
    if recv_info_opt.unwrap().is_pointer {
      self.state.write("->");
    } else {
      self.state.write(".");
    }
    self.state.write(field_name);
    ret .None;
  }

  // Resolves `recv`'s C text and declared type (name + pointer-ness)
  // WITHOUT writing anything to `self.state` -- the pure counterpart to
  // `emit_receiver_and_resolve_type` below, which delegates to this
  // function and then writes the resolved text in one shot. Needed
  // wherever a receiver's text must be computed ONCE but written
  // MULTIPLE times (e.g. `emit_fit`'s subject, re-emitted per branch).
  // `recv` is either a plain identifier -- a KNOWN local (see
  // `record_local`), resolved directly -- or itself a `.`-Expression
  // (`a.b` inside `a.b.c`, which this language's LEFT-associative `.`
  // precedence produces for a chain -- see `op_precedence_for`'s table in
  // `expressionable_defs.fn`), recursed through this same function to
  // resolve ITS OWN receiver first, then looking up the resulting type's
  // field via `lookup_compound_field`.
  // 
  // `.None` means `recv` isn't a shape/type this codegen can resolve (an
  // unknown local, an unrecognized compound/field, or anything besides a
  // plain identifier or a chained `.`-Expression) -- the caller must
  // treat that as "can't handle this," not guess. Deliberately narrow for
  // this slice: no enum-variant or bare-shorthand handling INSIDE a
  // chain (`a.Some.b` isn't reachable -- those only ever appear as a
  // single-level receiver, handled by `emit_field_access` itself before
  // this function is ever reached for the outermost level).
  resolve_field_chain(Node* recv) Option<ChainResolution> {
    fit recv.kind {
      .Identifier(name) -> {
        let type_found = self.lookup_local_type_name(name);
        let ptr_found = self.lookup_local_is_pointer(name);
        if type_found.is_none() || ptr_found.is_none() {
          ret .None;
        }
        ChainResolution r;
        r.text = name;
        r.type_name = type_found.unwrap();
        r.is_pointer = ptr_found.unwrap();
        r.dtype = self.lookup_local_dtype(name);
        ret .Some(r);
      }
      .Expression(inner_e) -> {
        // A CALL as the receiver (`tok.unwrap().type`, e.g. `ParseState.
        // parse_type_params_with_constraints`'s own real body, found via
        // the self-compile experiment -- `tok.unwrap()` is the call,
        // `.type` the field read off its result, with NO intermediate
        // `let` binding). Resolved in two steps: the call's own declared
        // return type (a plain function via `lookup_function_rtype`, or
        // a method call via `resolve_field_chain` on ITS OWN receiver +
        // `lookup_impl_method_rtype` -- the exact same two lookups
        // `infer_let_expr_type`'s identical "()" case already uses),
        // then the call's OWN rendered C text -- which, unlike every
        // other link in a chain, this function can't build by simple
        // string concatenation, since a call has real emission logic
        // (argument lists, mangled callee names, ...) already living in
        // `emit_expr`/`emit_call`. Rendered into a throwaway SCRATCH
        // buffer (same swap-self.state-then-restore technique
        // `emit_hoisted`'s three callers already use) purely to capture
        // that text without writing it here.
        if equals(inner_e.op, "()") && inner_e.has_left {
          Option<DataType> call_rtype = .None;
          fit inner_e.left.kind {
            .Identifier(fn_name) -> {
              let rt = self.lookup_function_rtype(fn_name);
              if rt.is_some() {
                call_rtype = .Some(*rt.unwrap());
              }
            }
            .Expression(recv_e) -> {
              if equals(recv_e.op, ".") && recv_e.has_left && recv_e.has_right {
                str method_name = "";
                fit recv_e.right.kind {
                  .Identifier(n) -> { method_name = n; }
                  _ -> {}
                }
                if !equals(method_name, "") {
                  let recv_r_opt = self.resolve_field_chain(recv_e.left);
                  if recv_r_opt.is_some() {
                    let rt = self.lookup_impl_method_rtype(
                      recv_r_opt.unwrap().type_name,
                      method_name
                    );
                    if rt.is_some() {
                      call_rtype = .Some(*rt.unwrap());
                    }
                  }
                }
              }
            }
            _ -> {}
          }
          if call_rtype.is_none() {
            ret .None;
          }
          let rdt = self.resolve_type_subst(call_rtype.unwrap());
          let resolved_name_opt = self.resolve_type_name(rdt);
          if resolved_name_opt.is_none() {
            ret .None;
          }

          CodegenState call_scratch = codegen_state_new();
          CodegenState* saved_call_state = self.state;
          self.state = &call_scratch;
          let cerr = self.emit_expr(*recv);
          self.state = saved_call_state;
          if cerr.is_some() {
            ret .None;
          }

          ChainResolution r;
          r.text = call_scratch.out.build();
          r.type_name = resolved_name_opt.unwrap();
          r.is_pointer = dtype_is_pointer(rdt);
          r.dtype = .Some(rdt);
          ret .Some(r);
        }
        if !equals(inner_e.op, ".") || !inner_e.has_left || !inner_e.has_right {
          ret .None;
        }
        str field_name = "";
        fit inner_e.right.kind {
          .Identifier(name) -> { field_name = name; }
          _ -> { ret .None; }
        }
        let recv_r_opt = self.resolve_field_chain(inner_e.left);
        if recv_r_opt.is_none() {
          ret .None;
        }
        let recv_r = recv_r_opt.unwrap();
        let field_info_opt = self.lookup_compound_field(recv_r.type_name, field_name);
        if field_info_opt.is_none() {
          ret .None;
        }
        let field_info = field_info_opt.unwrap();
        StringBuilder sb = string_builder_init(8);
        sb.append(recv_r.text);
        if recv_r.is_pointer {
          sb.append("->");
        } else {
          sb.append(".");
        }
        sb.append(field_name);
        ChainResolution r;
        r.text = sb.build();
        r.type_name = field_info.type_name;
        r.is_pointer = field_info.is_pointer;
        r.dtype = field_info.dtype;
        ret .Some(r);
      }
      _ -> { ret .None; }
    }
  }

  // Emits `recv`'s C text (via `resolve_field_chain`) and returns its
  // resolved declared type, so the caller (`emit_field_access`) can
  // decide `.`/`->` for the NEXT link in a chain it's emitting inline.
  emit_receiver_and_resolve_type(Node* recv) Option<FieldTypeInfo> {
    let resolved = self.resolve_field_chain(recv);
    if resolved.is_none() {
      ret .None;
    }
    let r = resolved.unwrap();
    self.state.write(r.text);
    FieldTypeInfo info;
    info.type_name = r.type_name;
    info.is_pointer = r.is_pointer;
    info.dtype = r.dtype;
    ret .Some(info);
  }

  // Emits one statement, followed by its own trailing newline (statements
  // are the unit `emit_statements` iterates, so each ends its own line).
  // `StatementIf`/`StatementElseIf`/`StatementElse` are deliberately NOT
  // handled here -- they're only ever valid chained together, which needs
  // sibling lookahead only `emit_statements` (its caller) has; reaching
  // this function directly (an if/elif/else with no chain context) is a
  // bug in the caller, so it's an explicit error rather than emitting a
  // lone, invalid C `if`/`else if`/`else` fragment.
  pub emit_statement(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .StatementReturn(exp) -> {
        // A `ret` unwinds EVERY enclosing block at once, so any
        // currently pending `defer` (this function's own, or an
        // enclosing block's) must run first -- see
        // `Codegen.defer_stack`'s doc comment. Common case (no `defer`
        // anywhere in this function) keeps the exact prior single-
        // statement form untouched. When defers ARE pending, the return
        // expression is evaluated into a temp FIRST (`__auto_type`, this
        // codegen's usual no-type-checker inference dodge -- see
        // `Variable`'s own doc comment below) so a deferred statement
        // can't retroactively change what gets returned by mutating a
        // variable the expression already read (matching the original's
        // own `has_pending_function_defers` guard).
        if self.defer_stack.len == 0 {
          self.state.write_indent();
          self.state.write("return");
          if exp != nil {
            self.state.write(" ");
            let prev_expected = self.expected_enum_type;
            self.expected_enum_type = self.current_fn_rtype_name;
            let eerr = self.emit_expr(*exp);
            self.expected_enum_type = prev_expected;
            if eerr.is_some() {
              ret eerr;
            }
          }
          self.state.write(";\n");
          ret .None;
        }
        if exp != nil {
          self.state.write_indent();
          self.state.write("__auto_type __fun_defer_ret = ");
          let prev_expected = self.expected_enum_type;
          self.expected_enum_type = self.current_fn_rtype_name;
          let eerr = self.emit_expr(*exp);
          self.expected_enum_type = prev_expected;
          if eerr.is_some() {
            ret eerr;
          }
          self.state.write(";\n");
        }
        let dferr = self.emit_function_scope_defers();
        if dferr.is_some() {
          ret dferr;
        }
        self.state.write_indent();
        if exp != nil {
          self.state.write("return __fun_defer_ret;\n");
        } else {
          self.state.write("return;\n");
        }
        ret .None;
      }
      .StatementBreak -> {
        self.state.write_indent();
        self.state.write("break;\n");
        ret .None;
      }
      .StatementContinue -> {
        self.state.write_indent();
        self.state.write("continue;\n");
        ret .None;
      }
      .Variable(v) -> {
        self.state.write_indent();
        // `let NAME = <expr>;` (no explicit type -- `parse_let`'s own
        // `__let_infer__` sentinel, see its doc comment in parser.fn)
        // ALWAYS emits GNU C's own `__auto_type` for the declaration
        // itself, letting the C compiler do the real inference -- this
        // codegen has no type-checker of its own. `infer_let_expr_type`
        // is then tried PURELY as a bonus for THIS codegen's OWN later
        // bookkeeping (so a bare-shorthand `fit`/a chained field access/
        // a method call reading `NAME` afterward still resolves); when
        // it can't infer anything, `NAME` just isn't a known local
        // afterward (rejected by whatever reads it next, not guessed --
        // the C declaration itself is unaffected either way).
        bin is_let = equals(v.var_type.type_str, "__let_infer__");
        bin have_resolved = false;
        str resolved_name = "";
        bin resolved_ptr = false;
        Option<DataType> resolved_dtype = .None;

        if is_let {
          self.state.write("__auto_type");
        } else {
          let wt = self.write_type(*v.var_type);
          if wt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let subst_dt = self.resolve_type_subst(*v.var_type);
          resolved_name = wt.unwrap();
          resolved_ptr = dtype_is_pointer(subst_dt);
          resolved_dtype = .Some(subst_dt);
          have_resolved = true;
        }
        self.state.write(" ");
        self.state.write(v.name);
        if v.has_val {
          self.state.write(" = ");
          // See `Codegen.expected_enum_type`'s doc comment: a bare
          // shorthand in a `Variable` declaration's own initializer
          // resolves against THAT variable's declared type, not
          // whatever the enclosing function returns. For `let`, this is
          // just `__let_infer__` (never a real enum name), so a bare
          // shorthand initializer still correctly fails to resolve
          // rather than guessing.
          let prev_expected = self.expected_enum_type;
          self.expected_enum_type = v.var_type.type_str;
          let verr = self.emit_expr(*v.val);
          self.expected_enum_type = prev_expected;
          if verr.is_some() {
            ret verr;
          }
        }
        self.state.write(";\n");
        if is_let && v.has_val {
          let inferred = self.infer_let_expr_type(v.val);
          if inferred.is_some() {
            let idt = inferred.unwrap();
            let resolved = self.resolve_type_name(idt);
            if resolved.is_some() {
              let subst_idt = self.resolve_type_subst(idt);
              resolved_name = resolved.unwrap();
              resolved_ptr = dtype_is_pointer(subst_idt);
              resolved_dtype = .Some(subst_idt);
              have_resolved = true;
            }
          }
        }
        if have_resolved {
          if resolved_dtype.is_some() {
            self.record_local_typed(v.name, resolved_name, resolved_ptr, resolved_dtype.unwrap());
          } else {
            self.record_local(v.name, resolved_name, resolved_ptr);
          }
        }
        ret .None;
      }
      .StatementFor(fk) -> {
        self.state.write_indent();
        fit fk {
          .Cond(fc) -> { ret self.emit_for_cond(fc); }
          .Range(fr) -> { ret self.emit_for_range(fr); }
          .Iter(fi) -> { ret self.emit_for_iter(fi); }
        }
      }
      .StatementFit(f) -> {
        self.state.write_indent();
        ret self.emit_fit(f);
      }
      // A bare expression used as a statement (an assignment, a call for
      // its side effect, `x++;`, ...) parses as a plain `.Expression`/
      // `.Unary` node directly in the statement list -- there's no
      // dedicated `StatementExpression` wrapper (see `parse_statement`'s
      // fallthrough to `parse_expressionable_root` in the parser). Emit it
      // as `<expr>;` followed by its own newline, same as every other
      // statement.
      .Expression(_) -> {
        self.state.write_indent();
        let eerr = self.emit_expr(node);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .Unary(_) -> {
        self.state.write_indent();
        let uerr = self.emit_expr(node);
        if uerr.is_some() {
          ret uerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .Panic(_) -> {
        // A bare `panic("msg");` statement (e.g. `_push_back`'s own real
        // body in the self-hosted lexer's own source) -- same "no
        // dedicated statement wrapper" reasoning as `.Expression`/
        // `.Unary` just above.
        self.state.write_indent();
        let perr = self.emit_expr(node);
        if perr.is_some() {
          ret perr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .StatementAssert(a) -> {
        // `assert cond;` / `assert cond, "msg";` (e.g. `_lex`'s own real
        // body in the self-hosted lexer's own source, found via the
        // self-compile experiment) -- lowers to a plain `if (!(cond)) {
        // ...; abort(); }`, matching the original's own non-test-mode
        // lowering exactly (this codegen has no test-mode runner of its
        // own yet -- `.Test` nodes are skipped entirely by an ordinary
        // compile, see `NodeKind.Test`'s doc comment -- so there is no
        // recovered-assertion path to support here).
        self.state.write_indent();
        self.state.write("if (!(");
        let cerr = self.emit_expr(*a.condition);
        if cerr.is_some() {
          ret cerr;
        }
        self.state.write(")) { ");
        if a.has_message {
          self.state.write("fprintf(stderr_stream(), \"Assertion failed: %s\\n\", ");
          let merr = self.emit_expr(*a.message);
          if merr.is_some() {
            ret merr;
          }
          self.state.write("); ");
        }
        self.state.write("abort(); }\n");
        ret .None;
      }
      .StatementDefer(body) -> {
        // `defer <body>;` (e.g. `ParseState.err`'s own real body,
        // `defer free(loc);`, found via the self-compile experiment) --
        // registers `body` onto `Codegen.defer_stack` rather than
        // emitting anything here directly; it's replicated as an
        // ordinary statement at every point this block's scope actually
        // ends (`emit_statements`' fall-through, or a `ret` anywhere
        // inside it -- see `Codegen.defer_stack`'s doc comment).
        self.defer_stack.push(body);
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Emits `for { ... }` (infinite) or `for cond { ... }` as the direct C
  // equivalent: `while (1) { ... }` / `while (cond) { ... }` -- a
  // conditional `for` has no init/increment clauses of its own, so a
  // `while` loop is exactly the same construct.
  emit_for_cond(ForCondNode fc) Option<CodegenErrorKind> {
    if fc.has_condition {
      self.state.write("while (");
      let cerr = self.emit_expr(*fc.condition);
      if cerr.is_some() {
        ret cerr;
      }
      self.state.write(") {\n");
    } else {
      self.state.write("while (1) {\n");
    }
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*fc.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    ret .None;
  }

  // Emits `for i : start..end { ... }` as `for (int64_t i = start; i <
  // end; i++) { ... }`. `range_expr` is always an `Expression{ op = ".." }`
  // (start on the left, end on the right) -- see `parse_for_statement`'s
  // doc comment in the parser for how the range/condition forms are
  // disambiguated at parse time.
  emit_for_range(ForRangeNode fr) Option<CodegenErrorKind> {
    fit fr.range_expr.kind {
      .Expression(e) -> {
        if !equals(e.op, "..") || !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.state.write("for (int64_t ");
        self.state.write(fr.index_name);
        self.state.write(" = ");
        let serr = self.emit_expr(*e.left);
        if serr.is_some() {
          ret serr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write(" < ");
        let eerr = self.emit_expr(*e.right);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write("++) {\n");
        self.state.indent_level = self.state.indent_level + 1;
        let berr = self.emit_body(*fr.body);
        if berr.is_some() {
          ret berr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits `for item : arr { ... }` / `for i, item :: arr { ... }` as the
  // original's own "Vec fast path": `for (int64_t idx = 0; idx <
  // arr.len; idx++) { __auto_type item = arr.data[idx]; ... }` -- `idx`
  // is `fi.index_name` when given, else a synthetic `__fun_i`. Reads
  // straight from `Vec<T>`'s own `.len`/`.data` fields rather than a
  // generic `Iterator`-quirk `.next()` dispatch (dynamic quirk dispatch
  // isn't reachable yet -- see this file's own top-level doc comment).
  // `__auto_type` (a GNU C extension) lets the C compiler infer `item`'s
  // type from `arr.data[idx]` -- this codegen never needs to know `T`
  // itself, matching the original's own choice here.
  // 
  // Deliberately narrow for this slice: `arr` must be a plain identifier
  // that's a known local whose declared type is SOME instantiation of
  // `Vec<T>` (an array literal or a general `Iterator`-implementing
  // quirk value isn't reachable yet either). Prefers a STRUCTURAL check
  // via `lookup_local_dtype` (the local's real `DataType` -- base
  // `type_str == "Vec"` with exactly one generic arg, `T`) when the
  // local was recorded with one (`record_local_typed`, e.g. a real
  // `Variable` declaration or function/method parameter); falls back to
  // a NAME-based check (bare "Vec", or a "Vec__"-prefixed mangled
  // instantiation) for a local recorded through plain `record_local`
  // instead (no structured type on hand at all -- e.g. a hand-built unit
  // test's stand-in local, or `item` from an OUTER `for` whose element
  // type couldn't be read structurally either). A REAL local's recorded
  // NAME is never the bare "Vec" -- `record_local`/`record_local_typed`
  // always store `write_type`'s own RESOLVED (monomorphized) name
  // (`Vec__str`, `Vec__Vec__str`, ...) -- a real bug found via the self-
  // compile experiment (`param_constraints: Vec<Vec<str>>` in
  // `ParseState.parse_type_params_with_constraints`'s own real body,
  // rejected outright since its recorded name, "Vec__Vec__str", isn't
  // the bare "Vec" this check used to require -- apparently never
  // exercised by a REAL declaration before, only ever by hand-recorded
  // test locals).
  emit_for_iter(ForIterNode fi) Option<CodegenErrorKind> {
    // The iterable is either a plain identifier (a known local, checked
    // structurally via `lookup_local_dtype` or by name otherwise -- see
    // this function's own doc comment) OR a chained field access (`for a
    // : dt.generic_args { ... }` -- `Codegen.resolve_type_subst`'s own
    // real body, found via the self-compile experiment) resolved via
    // `resolve_field_chain` (any depth) instead, the same lookup several
    // other sites in this file already use for a chained receiver.
    // `resolve_field_chain`'s own `ChainResolution.dtype` (see its doc
    // comment) carries the field's FULL structured `DataType` too, when
    // `record_compound_typed` recorded it (a real declaration's own
    // field, not a hand-built unit test's stand-in) -- letting `item` be
    // recorded as a known local of its real element type here too, same
    // as the identifier case below.
    str arr_text = "";
    Option<DataType> arr_dtype = .None;
    Option<str> arr_type_name = .None;
    fit fi.iterable.kind {
      .Identifier(name) -> {
        arr_text = name;
        arr_dtype = self.lookup_local_dtype(name);
        arr_type_name = self.lookup_local_type_name(name);
      }
      .Expression(e) -> {
        if !equals(e.op, ".") {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        let resolved = self.resolve_field_chain(fi.iterable);
        if resolved.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        let r = resolved.unwrap();
        arr_text = r.text;
        arr_type_name = .Some(r.type_name);
        arr_dtype = r.dtype;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    // Element `DataType`, when knowable STRUCTURALLY (see this
    // function's own doc comment) -- lets `item` be recorded as a known
    // local of its REAL type below, so a FURTHER nested iteration over
    // it (`for existing : combos { for et : existing { ... } }`,
    // `parse_type_params_with_constraints`'s own real body building
    // `Vec<Vec<str>>` cross-products, found via the self-compile
    // experiment) resolves too -- without this, `existing` (that OUTER
    // loop's own `item`) was never a known local at all (see below on
    // why `item` isn't normally recorded), so the INNER `for et :
    // existing` rejected it outright.
    // 
    // `arr_dtype` being `.Some` does NOT always mean it's structural,
    // though: a local whose type came from a MONOMORPHIZED generic
    // method's own registered return type (`let variant_templates =
    // self.generic_enum_variants.get(template_idx);` --
    // `ensure_enum_instantiated`'s own real body, found via the self-
    // compile experiment) has an ALREADY-MANGLED `type_str`
    // ("Vec__GenericEnumVariantTemplate") with EMPTY `generic_args` --
    // the structural information was already collapsed into a name
    // upstream (`maybe_instantiate_generic_impl_methods` records a
    // template method's substituted return type as a plain resolved
    // name, not a re-expanded structural one). Recognized as a Vec
    // either way (structurally, or by name via `arr_dt.type_str` itself
    // OR the name-only fallback), but only the STRUCTURAL case can also
    // resolve `item`'s own element type.
    Option<DataType> elem_dt = .None;
    bin is_vec = false;
    if arr_dtype.is_some() {
      let arr_dt = arr_dtype.unwrap();
      if equals(arr_dt.type_str, "Vec") && arr_dt.generic_args.len == 1 {
        elem_dt = .Some(self.resolve_type_subst(*arr_dt.generic_args.get(0)));
        is_vec = true;
      } elif equals(arr_dt.type_str, "Vec") || starts_with(arr_dt.type_str, "Vec__") {
        is_vec = true;
      }
    }
    if !is_vec && arr_type_name.is_some() {
      let found_name = arr_type_name.unwrap();
      if equals(found_name, "Vec") || starts_with(found_name, "Vec__") {
        is_vec = true;
      }
    }
    if !is_vec {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }

    str idx_name = "__fun_i";
    if fi.has_index_name {
      idx_name = fi.index_name;
    }

    self.state.write("for (int64_t ");
    self.state.write(idx_name);
    self.state.write(" = 0; ");
    self.state.write(idx_name);
    self.state.write(" < ");
    self.state.write(arr_text);
    self.state.write(".len; ");
    self.state.write(idx_name);
    self.state.write("++) {\n");
    self.state.indent_level = self.state.indent_level + 1;
    self.state.write_indent();
    self.state.write("__auto_type ");
    self.state.write(fi.item_name);
    self.state.write(" = ");
    self.state.write(arr_text);
    self.state.write(".data[");
    self.state.write(idx_name);
    self.state.write("];\n");
    // `item` is recorded as a known local of the ELEMENT type too, when
    // `elem_dt` was resolved above (see this function's own doc
    // comment); otherwise it's left unrecorded -- its declared Fun type
    // is unknown here (that's the whole point of `__auto_type`), so a
    // later `item.field`/nested-iteration read is correctly rejected by
    // whatever needs it rather than guessed at; dereferencing it
    // (`*item`, common when `T` is itself a pointer) works fine either
    // way since that doesn't need a locals lookup at all.
    if elem_dt.is_some() {
      let edt = elem_dt.unwrap();
      let elem_name = self.resolve_type_name(edt);
      if elem_name.is_some() {
        self.record_local_typed(fi.item_name, elem_name.unwrap(), dtype_is_pointer(edt), edt);
      }
    }
    let berr = self.emit_body(*fi.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    ret .None;
  }

  // Emits one `fit` branch that matches a tagged-union enum variant
  // (bare shorthand `.Variant`/`.Variant(x)`, or qualified
  // `EnumName.Variant`/`EnumName.Variant(x)`, with or without
  // destructuring bindings) as `subj.tag == EnumName_Variant { ... }` (or
  // `subj->tag == ...` when `subj_is_pointer`, e.g. a `fit *self { ... }`
  // subject), chained with a leading `if`/`else if` per `wrote_branch`
  // matching the literal-chain path's own convention in `emit_fit`. Each
  // positional binding name gets its own `__auto_type name =
  // subj.payload.Variant._N;` declaration first (matching
  // `emit_for_iter`'s own reason for `__auto_type`: the C compiler
  // infers the actual type). Also registers each binding as a known
  // LOCAL when its own payload field type is on record (see `Codegen.
  // enum_variant_payload_owner`'s doc comment), so further access on it
  // inside the branch still resolves.
  emit_fit_enum_branch(
    str subj_name,
    bin subj_is_pointer,
    str enum_name,
    str variant_name,
    FitBranch br,
    bin wrote_branch
  ) Option<CodegenErrorKind> {
    if wrote_branch {
      self.state.write(" else if (");
    } else {
      self.state.write("if (");
    }
    self.state.write(subj_name);
    if subj_is_pointer {
      self.state.write("->");
    } else {
      self.state.write(".");
    }
    self.state.write("tag == ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    if br.has_bindings {
      num bi = 0;
      for bname : br.bindings {
        self.state.write_indent();
        self.state.write("__auto_type ");
        self.state.write(bname);
        self.state.write(" = ");
        self.state.write(subj_name);
        if subj_is_pointer {
          self.state.write("->");
        } else {
          self.state.write(".");
        }
        self.state.write("payload.");
        self.state.write(variant_name);
        self.state.write("._");
        self.state.write(format_num(bi));
        self.state.write(";\n");
        // See `Codegen.enum_variant_payload_owner`'s doc comment: a
        // known payload field type means `bname` is registered as a
        // known local too, so further access on it inside the branch
        // (a chained field access, another `fit`, a method call --
        // `_prev_token_is_bare_zero`'s real body, e.g., destructures
        // `t` then reads `t.data`) resolves. An unresolvable payload
        // type just leaves `bname` unregistered, same as everywhere
        // else in this file.
        let payload_info = self.lookup_enum_variant_payload_type(enum_name, variant_name, bi);
        if payload_info.is_some() {
          let info = payload_info.unwrap();
          self.record_local(bname, info.type_name, info.is_pointer);
        }
        bi = bi + 1;
      }
    }
    let berr = self.emit_body(*br.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits `fit subject { patterns -> { body } ... }` as a chain of C
  // `if`/`else if`/`else` blocks. Two pattern kinds are recognized, tried
  // in order for each branch: (1) a tagged-union enum-variant pattern
  // (bare or qualified, destructuring or not -- see
  // `emit_fit_enum_branch`'s doc comment) whenever the branch's
  // condition has the `Identifier . Identifier` (qualified) or `Blank .
  // Identifier` (bare shorthand) shape AND names a known enum/variant --
  // a BARE shorthand's enum name comes from the SUBJECT's own declared
  // local type, the same "already fully explicit, no real inference"
  // trick used throughout this file; (2) otherwise, a literal pattern
  // compared against `subject` directly -- mirrors the original's own
  // `str`/`dec` "if/else-if chain" lowering, but applied UNIFORMLY here
  // (no `switch` path for an integral subject, since this codegen has no
  // type inference to pick a subject-wide strategy). A `str` pattern
  // label compares via `strcmp(...) == 0`; every other literal kind
  // compares via `==` -- decided PER LABEL from that label's own literal
  // kind, not once for the whole subject.
  // 
  // Deliberately narrow for this slice: the subject must be a plain
  // identifier, a single `*name` dereference of a pointer local (the
  // `fit *self { ... }` idiom used throughout this codebase's own real
  // stdlib), a chained field access (`fit t.data { ... }`, resolved via
  // `resolve_field_chain`), or a METHOD CALL (`fit self.method() {
  // ... }`, the single most common shape in this codebase's own real
  // parser -- e.g. `fit self.tokens_peek_no_increment() { .Some(t) -> {
  // ... } .None -> { ... } }`) -- the first three are each re-evaluated
  // once per branch instead of hoisted into a temp variable, safe only
  // because none of them has a side effect when read twice; a CALL
  // subject can't be re-evaluated (a real side effect, e.g. advancing a
  // cursor) so it's hoisted into ONE `__auto_type __fit_subj = <call>;`
  // temp declaration first (mirroring `emit_for_iter`'s own fixed-name,
  // no-real-hygiene `__fun_i` -- a SECOND `fit`-over-a-call nested
  // inside this one's own branch body would shadow it, an accepted,
  // narrow limitation, not a silently wrong one), with its bare-
  // shorthand enum type resolved from the CALLEE's own declared return
  // type (`Codegen.impl_method_rtype`, populated by
  // `register_impl_methods` -- see its own doc comment for why this is
  // ONLY populated for a non-generic impl's methods so far) rather than
  // a local's. Only a receiver.method() call matching `emit_method_call`
  // exactly (plain-identifier receiver that's a known local, plain-
  // identifier method name) is recognized; anything else (a plain-
  // function call, a chained call, an unknown receiver/method) is
  // rejected rather than guessed. A comma-chained LITERAL pattern (`1, 2
  // -> ...`) matches any of its values (OR-ed comparisons); reuses
  // `flatten_call_args` directly for that, since it's the exact same
  // comma-flattening a call's argument list needs. A destructuring/
  // enum-variant pattern whose enum/variant ISN'T recognized (an unknown
  // bare shorthand with no resolvable subject type, say) is rejected
  // outright rather than falling through to the literal path, which
  // could never validly compare against it anyway.
  emit_fit(FitStmtNode f) Option<CodegenErrorKind> {
    str subj_name = "";
    bin subj_is_pointer = false;
    Option<str> subj_type = .None;
    fit f.exp.kind {
      .Identifier(name) -> {
        subj_name = name;
        subj_type = self.lookup_local_type_name(name);
        subj_is_pointer = self.lookup_local_is_pointer(name).unwrap_or(false);
      }
      .Unary(u) -> {
        if u.is_left_operanded_unary || !u.has_indirection || u.indirection_depth != 1 {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        fit u.operand.kind {
          .Identifier(name) -> {
            subj_name = name;
            subj_type = self.lookup_local_type_name(name);
            subj_is_pointer = true;
          }
          _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
        }
      }
      .Expression(dot_e) -> {
        if equals(dot_e.op, "()") {
          if !dot_e.has_left || !dot_e.has_right {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          // `fit <plain function call>(...) { ... }` (e.g. `fit
          // get_c_typedef_alias_datatype_type(name) { ... }` --
          // `ParseState.parse_datatype`'s own real body, found via the
          // self-compile experiment): the callee is a bare `.Identifier`,
          // not a `recv.method()` `.Expression` -- resolved via the same
          // `lookup_function_rtype` lookup `infer_let_expr_type`'s own
          // "()" case uses for a plain call, and emitted the same way
          // the method-call branch below does (a temp `__auto_type
          // __fit_subj` holding the call's result).
          bin is_plain_fn_call = false;
          str plain_fn_name = "";
          fit dot_e.left.kind {
            .Identifier(fn_name) -> {
              is_plain_fn_call = true;
              plain_fn_name = fn_name;
            }
            _ -> {}
          }
          if is_plain_fn_call {
            let rtype = self.lookup_function_rtype(plain_fn_name);
            if rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let resolved_rtype = self.resolve_type_name(*rtype.unwrap());
            if resolved_rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            self.state.write("__auto_type __fit_subj = ");
            let cerr = self.emit_expr(*f.exp);
            if cerr.is_some() {
              ret cerr;
            }
            self.state.write(";\n");
            self.state.write_indent();
            subj_name = "__fit_subj";
            subj_type = resolved_rtype;
            subj_is_pointer = false;
          } else {
            ExprNode recv_e;
            fit dot_e.left.kind {
              .Expression(inner) -> { recv_e = inner; }
              _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
            }
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            // The receiver itself may be a CHAINED field access, not
            // just a bare local (`fit self.state.token_peek_prev_n(1)
            // { ... }` -- `Parser.parse_single_token_to_node`'s own real
            // body, found via the self-compile experiment) -- resolved
            // via `resolve_field_chain` (any depth), the same lookup
            // `emit_method_call`/`infer_let_expr_type` already use for a
            // chained method-call receiver, instead of requiring a bare
            // `.Identifier`.
            let recv_chain = self.resolve_field_chain(recv_e.left);
            if recv_chain.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let owner_type_name = recv_chain.unwrap().type_name;
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(n) -> { method_name = n; }
              _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
            }
            let rtype = self.lookup_impl_method_rtype(owner_type_name, method_name);
            if rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let resolved_rtype = self.resolve_type_name(*rtype.unwrap());
            if resolved_rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            self.state.write("__auto_type __fit_subj = ");
            let merr = self.emit_method_call(recv_e, dot_e.right);
            if merr.is_some() {
              ret merr;
            }
            self.state.write(";\n");
            self.state.write_indent();
            subj_name = "__fit_subj";
            subj_type = resolved_rtype;
            subj_is_pointer = false;
          }
        } else {
          if !equals(dot_e.op, ".") {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let resolved = self.resolve_field_chain(f.exp);
          if resolved.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let r = resolved.unwrap();
          subj_name = r.text;
          subj_type = .Some(r.type_name);
          subj_is_pointer = r.is_pointer;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    bin wrote_branch = false;
    Node* default_body = nil;
    bin has_default = false;

    for br : f.branches {
      if !br.has_condition {
        if br.has_bindings && br.bindings.len > 0 {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        default_body = br.body;
        has_default = true;
        continue;
      }

      bin handled_as_enum = false;
      fit br.condition.kind {
        .Expression(dot_e) -> {
          if equals(dot_e.op, ".") && dot_e.has_left && dot_e.has_right {
            str enum_name = "";
            bin have_enum_name = false;
            fit dot_e.left.kind {
              .Identifier(en) -> {
                enum_name = en;
                have_enum_name = true;
              }
              .Blank -> {
                if subj_type.is_some() {
                  enum_name = subj_type.unwrap();
                  have_enum_name = true;
                }
              }
              _ -> {}
            }
            str variant_name = "";
            fit dot_e.right.kind {
              .Identifier(vn) -> { variant_name = vn; }
              _ -> {}
            }
            if have_enum_name && self.enum_has_variant(enum_name, variant_name) {
              let eerr = self.emit_fit_enum_branch(
                subj_name,
                subj_is_pointer,
                enum_name,
                variant_name,
                br,
                wrote_branch
              );
              if eerr.is_some() {
                ret eerr;
              }
              handled_as_enum = true;
              wrote_branch = true;
            }
          }
        }
        _ -> {}
      }
      if handled_as_enum {
        continue;
      }

      if br.has_bindings && br.bindings.len > 0 {
        ret .Some(CodegenErrorKind.UnsupportedNode);
      }

      if wrote_branch {
        self.state.write(" else if (");
      } else {
        self.state.write("if (");
      }

      Vec<Node*> labels;
      labels.init(0);
      defer labels.free();
      self.flatten_call_args(br.condition, &labels);

      bin first_label = true;
      for lbl : labels {
        if !first_label {
          self.state.write(" || ");
        }
        first_label = false;
        bin is_str_label = false;
        fit lbl.kind {
          .String(_) -> { is_str_label = true; }
          _ -> {}
        }
        if is_str_label {
          self.state.write("strcmp(");
          self.state.write(subj_name);
          self.state.write(", ");
          let lerr = self.emit_expr(*lbl);
          if lerr.is_some() {
            ret lerr;
          }
          self.state.write(") == 0");
        } else {
          self.state.write(subj_name);
          self.state.write(" == ");
          let lerr2 = self.emit_expr(*lbl);
          if lerr2.is_some() {
            ret lerr2;
          }
        }
      }

      self.state.write(") {\n");
      self.state.indent_level = self.state.indent_level + 1;
      let berr = self.emit_body(*br.body);
      if berr.is_some() {
        ret berr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
      wrote_branch = true;
    }

    if has_default {
      if wrote_branch {
        self.state.write(" else {\n");
      } else {
        self.state.write("{\n");
      }
      self.state.indent_level = self.state.indent_level + 1;
      let dberr = self.emit_body(*default_body);
      if dberr.is_some() {
        ret dberr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
    }
    self.state.write("\n");
    ret .None;
  }

  // Emits an `if (cond) { ... }` block, WITHOUT the trailing newline (the
  // caller -- either `emit_statements` chaining a following elif/else, or
  // this same function recursing for one) decides what comes next).
  emit_if_block(Node* condition, Node* body) Option<CodegenErrorKind> {
    self.state.write("if (");
    let cerr = self.emit_expr(*condition);
    if cerr.is_some() {
      ret cerr;
    }
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits `stmts[start_i]` (a `StatementIf`) chained with every
  // immediately-following `StatementElseIf`/`StatementElse` sibling as a
  // single C `if (...) { } else if (...) { } else { }` construct, and
  // returns the index just past the whole chain.
  // 
  // `if`/`elif`/`else` are parsed as three INDEPENDENT sibling statement
  // kinds, not a nested tree (see `StatementIf`/`StatementElseIf`/
  // `StatementElse`'s own doc comments in ast.fn) -- so chaining them into
  // one C construct needs this adjacency lookahead over the statement
  // list, mirroring the original's `current_statement_type`/
  // `next_statement_type` tracking for the same purpose.
  emit_if_chain(Vec<Node*> stmts, num start_i, num* out_next_i) Option<CodegenErrorKind> {
    Node* if_stmt = stmts.get(start_i);
    fit if_stmt.kind {
      .StatementIf(ifn) -> {
        let ferr = self.emit_if_block(ifn.condition, ifn.body);
        if ferr.is_some() {
          ret ferr;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }

    num i = start_i + 1;
    for i < stmts.len {
      Node* next = stmts.get(i);
      bin chained = false;
      fit next.kind {
        .StatementElseIf(ein) -> {
          self.state.write(" else ");
          let eerr = self.emit_if_block(ein.condition, ein.body);
          if eerr.is_some() {
            ret eerr;
          }
          chained = true;
        }
        .StatementElse(ebody) -> {
          self.state.write(" else {\n");
          self.state.indent_level = self.state.indent_level + 1;
          let elerr = self.emit_body(*ebody);
          if elerr.is_some() {
            ret elerr;
          }
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}");
          chained = true;
        }
        _ -> {}
      }
      if !chained {
        break;
      }
      i = i + 1;
    }
    self.state.write("\n");
    *out_next_i = i;
    ret .None;
  }

  // True for a statement kind that's KNOWN to always leave its enclosing
  // block (a `ret`/`break`/`continue`, or a bare `panic(...)` statement,
  // which always aborts) -- used by `emit_statements` to decide whether
  // ordinary fall-through defer cleanup is needed after the LAST
  // statement in a block. Conservative, matching the original's own
  // `node_is_scope_terminator`: an if/elif/else chain is never treated as
  // a terminator here even when every one of its own branches returns --
  // proving that would need real branch-coverage analysis this codegen
  // doesn't do, so a block ending in such a chain harmlessly emits (dead
  // but valid) fall-through defer cleanup after it too.
  node_is_scope_terminator(Node stmt) bin {
    fit stmt.kind {
      .StatementReturn(_) -> { ret true; }
      .StatementBreak -> { ret true; }
      .StatementContinue -> { ret true; }
      .Panic(_) -> { ret true; }
      _ -> { ret false; }
    }
  }

  // Pushes a new `defer` scope frame, marking `defer_stack`'s CURRENT
  // length as where THIS block's own defers begin -- see
  // `Codegen.defer_stack`'s doc comment.
  push_defer_scope() {
    self.defer_scope_starts.push(self.defer_stack.len);
  }

  // Pops the innermost `defer` scope frame and discards its (by now
  // already-emitted, one way or another) entries from `defer_stack`.
  pop_defer_scope() {
    if self.defer_scope_starts.len == 0 {
      ret;
    }
    let start = self.defer_scope_starts.pop();
    self.defer_stack.resize(start, nil);
  }

  // Emits (WITHOUT removing -- see `Codegen.defer_stack`'s doc comment)
  // every pending defer from `defer_stack`'s end back down to
  // `start_index`, in REVERSE (LIFO) registration order, each as an
  // ordinary statement via `emit_body` (a deferred body is either a
  // single statement or a `{ ... }` block, exactly what `emit_body`
  // already dispatches on).
  emit_defers_from(num start_index) Option<CodegenErrorKind> {
    num i = self.defer_stack.len;
    for i > start_index {
      i = i - 1;
      let d = self.defer_stack.get(i);
      let derr = self.emit_body(*d);
      if derr.is_some() {
        ret derr;
      }
    }
    ret .None;
  }

  // Emits just the CURRENT (innermost) block's own pending defers --
  // used at ordinary fall-through (the block ends without an explicit
  // `ret`/`break`/`continue`/`panic` as its last statement).
  emit_current_scope_defers() Option<CodegenErrorKind> {
    if self.defer_scope_starts.len == 0 {
      ret .None;
    }
    let start = self.defer_scope_starts.get(self.defer_scope_starts.len - 1);
    ret self.emit_defers_from(start);
  }

  // Emits EVERY currently pending defer, back to function entry -- used
  // at a `ret` statement, which unwinds every enclosing block at once
  // regardless of nesting depth. Simplified from the original's own
  // `emit_function_scope_defers` (which stops at the nearest FUNCTION-
  // kind frame specifically, distinct from a LOOP frame): this codegen
  // doesn't yet distinguish frame kinds at all -- see
  // `Codegen.defer_stack`'s doc comment -- so "back to function entry"
  // and "back to index 0" are the same thing here.
  emit_function_scope_defers() Option<CodegenErrorKind> {
    ret self.emit_defers_from(0);
  }

  // Emits `stmts` in order, one statement per line, chaining any
  // `StatementIf`/`StatementElseIf`/`StatementElse` run into a single C
  // if/else-if/else construct via `emit_if_chain`. Pushes/pops its OWN
  // `defer` scope frame around the whole statement list (see
  // `Codegen.defer_stack`'s doc comment) -- every block, not just a
  // function's top-level body, is its own defer scope.
  emit_statements(Vec<Node*> stmts) Option<CodegenErrorKind> {
    self.push_defer_scope();
    num i = 0;
    bin last_is_terminator = false;
    for i < stmts.len {
      Node* stmt = stmts.get(i);
      bin is_if = false;
      fit stmt.kind {
        .StatementIf(ifn) -> { is_if = true; }
        _ -> {}
      }
      if is_if {
        self.state.write_indent();
        num next_i = i;
        let cherr = self.emit_if_chain(stmts, i, &next_i);
        if cherr.is_some() {
          self.pop_defer_scope();
          ret cherr;
        }
        i = next_i;
        last_is_terminator = false;
        continue;
      }
      last_is_terminator = self.node_is_scope_terminator(*stmt);
      let serr = self.emit_statement(*stmt);
      if serr.is_some() {
        self.pop_defer_scope();
        ret serr;
      }
      i = i + 1;
    }
    if !last_is_terminator {
      let dferr = self.emit_current_scope_defers();
      if dferr.is_some() {
        self.pop_defer_scope();
        ret dferr;
      }
    }
    self.pop_defer_scope();
    ret .None;
  }

  // Emits `body`: every statement in order when it's a `Body` block, or
  // just the one statement when it's a single braceless statement (an
  // `if`/`for`/... body doesn't require `{ }` when it's a single
  // statement -- see `_parse_if_body`'s doc comment in the parser).
  emit_body(Node body) Option<CodegenErrorKind> {
    fit body.kind {
      .Body(bn) -> { ret self.emit_statements(bn.statements); }
      _ -> { ret self.emit_statement(body); }
    }
  }

  // Emits one function parameter (a `Variable` node with no initializer)
  // as `<type> <name>`, and records it as a local for `.`/`->` decisions
  // (see `Codegen.local_names`'s doc comment). A function-TYPE parameter
  // (`fun(T1, T2) R name`, see `parser.parse_fn_type_datatype`'s doc
  // comment) instead needs C's function-pointer declarator shape, which
  // wraps the NAME rather than preceding it (`R (*name)(T1, T2)`) --
  // handled as its OWN case before the ordinary `write_type` path below,
  // matching the original's own special case for the exact same reason.
  // A call THROUGH such a parameter (`cb(a, b)`) needs no special
  // handling at the call site itself: its own C type is already a real
  // function pointer, so ordinary call syntax just works (see
  // `emit_call`'s doc comment). Recorded as a local under an empty type
  // name (never matches a real compound/enum, so a later `.field`/
  // `.method()` off of it is correctly rejected rather than guessed --
  // this codegen has no sensible "type name" for a function pointer to
  // begin with).
  emit_function_param(Node param) Option<CodegenErrorKind> {
    fit param.kind {
      .Variable(v) -> {
        if v.var_type.has_fn_sig {
          let sig = v.var_type.fn_sig;
          let rt = self.write_type(*sig.rtype);
          if rt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          self.state.write(" (*");
          self.state.write(v.name);
          self.state.write(")(");
          bin first = true;
          for p : sig.params {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let pt = self.write_type(*p);
            if pt.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
          }
          self.state.write(")");
          self.record_local(v.name, "", false);
          ret .None;
        }
        let wt = self.write_type(*v.var_type);
        if wt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write(" ");
        self.state.write(v.name);
        let param_dt = self.resolve_type_subst(*v.var_type);
        self.record_local_typed(v.name, wt.unwrap(), dtype_is_pointer(param_dt), param_dt);
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a plain (no generics, no variadics) top-level function
  // declaration as a C function definition: `<rtype> <name>(<args>) {
  // <body> }` (or `(void)` for a zero-arg function, matching C
  // convention -- an empty `()` in C means "unspecified arguments", not
  // "no arguments").
  pub emit_function(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> { ret self.emit_function_named(node, f.name); }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Does the actual work of `pub emit_function`, under an explicit
  // `emit_name` rather than always `node`'s own already-mangled
  // `Function.name` -- so `maybe_instantiate_generic_impl_methods` can
  // emit the SAME template method body once per concrete instantiation,
  // each under its own further-mangled C symbol (`Box__num__get`,
  // `Box__str__get`, ...), without a second copy of this function. `
  // current_fn_rtype_name` is set from the RESOLVED (post-`write_type`,
  // so post-substitution) return type name rather than `f.rtype.
  // type_str` directly, so a generic method's own bare-`T` return type
  // resolves against the active instantiation for `ret <shorthand>;`
  // (see `Codegen.current_fn_rtype_name`'s doc comment) -- identical to
  // `f.rtype.type_str` for every non-generic-impl-method call, so this
  // doesn't change behavior anywhere else.
  emit_function_named(Node node, str emit_name) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        // Fresh per function -- see `Codegen.local_names`'s doc comment;
        // this is deliberately NOT scoped to nested blocks (an inner `{
        // }` shadowing an outer local of the same name would get this
        // wrong), which is fine for now since nothing this slice's tests
        // exercise shadows a local.
        self.local_names.init(0);
        self.local_is_pointer.init(0);
        self.local_type_name.init(0);
        self.local_dtype.init(0);
        // Fresh per function too -- see `Codegen.defer_stack`'s doc
        // comment; a previous function's leftover pending defers (or
        // frame markers) must never bleed into this one.
        self.defer_stack.init(0);
        self.defer_scope_starts.init(0);
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        let rt = self.write_type(*f.rtype);
        if rt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.current_fn_rtype_name = rt.unwrap();
        self.current_fn_rtype_dt = .Some(self.resolve_type_subst(*f.rtype));
        self.state.write(" ");
        self.state.write(emit_name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let aerr = self.emit_function_param(*arg);
            if aerr.is_some() {
              ret aerr;
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(") {\n");
        self.state.indent_level = self.state.indent_level + 1;
        if f.has_body {
          let berr = self.emit_body(*f.body);
          if berr.is_some() {
            ret berr;
          }
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a non-generic `enum Name { variants }` declaration -- either a
  // plain C enum typedef (`typedef enum Name { Name_Variant1,
  // Name_Variant2 = <val>, ... } Name;`, single underscore, distinct
  // from the double-underscore `Type__method` impl-method mangling) when
  // no variant carries a payload, or the tagged-union discriminant-
  // enum-plus-struct/union layout (see `emit_tagged_union_enum`'s doc
  // comment) when at least one does. Also registers the enum
  // (`record_enum`) so a later `EnumName.Variant` qualified access
  // resolves to the right constant -- see `emit_field_access`'s doc
  // comment.
  // 
  // A GENERIC enum (`has_type_params`, e.g. `enum Option<T> { ... }`) is
  // instead only RECORDED as a template (see
  // `Codegen.generic_enum_names`'s doc comment) -- never emitted
  // directly itself, matching `emit_compound`'s own rule for a generic
  // compound: only a concrete monomorphized specialization
  // (`ensure_enum_instantiated`) is ever actually emitted.
  emit_enum(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Enum(e) -> {
        if e.has_type_params {
          Vec<GenericEnumVariantTemplate> variant_templates;
          variant_templates.init(0);
          for v : e.variants {
            GenericEnumVariantTemplate vt;
            vt.name = v.name;
            vt.has_payload = v.has_payload && v.payload.len > 0;
            Vec<str> payload_type_strs;
            payload_type_strs.init(0);
            Vec<bin> payload_is_pointer;
            payload_is_pointer.init(0);
            for pt : v.payload {
              payload_type_strs.push(pt.type_str);
              payload_is_pointer.push(dtype_is_pointer(*pt));
            }
            vt.payload_type_strs = payload_type_strs;
            vt.payload_is_pointer = payload_is_pointer;
            variant_templates.push(vt);
          }
          self.generic_enum_names.push(e.name);
          self.generic_enum_type_params.push(e.type_params);
          self.generic_enum_variants.push(variant_templates);
          ret .None;
        }
        bin is_tagged_union = false;
        for v : e.variants {
          if v.has_payload && v.payload.len > 0 {
            is_tagged_union = true;
          }
        }

        Vec<str> variant_names;
        variant_names.init(0);
        for v : e.variants {
          variant_names.push(v.name);
        }

        if is_tagged_union {
          self.emit_tagged_union_enum(e);
        } else {
          self.state.write("typedef enum ");
          self.state.write(e.name);
          self.state.write(" {\n");
          for v : e.variants {
            self.state.write("  ");
            self.state.write(e.name);
            self.state.write("_");
            self.state.write(v.name);
            if v.has_value {
              self.state.write(" = ");
              self.state.write(format_num(v.value));
            }
            self.state.write(",\n");
          }
          self.state.write("} ");
          self.state.write(e.name);
          self.state.write(";\n\n");
        }
        self.record_enum(e.name, variant_names, is_tagged_union);
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a data-carrying (tagged-union) enum as the original's own
  // layout:
  // typedef enum Name_tag { Name_Variant1, Name_Variant2, ... } Name_tag;
  // typedef struct Name {
  // Name_tag tag;
  // union {
  // struct { <type> _0; <type> _1; ... } Variant1;
  // ...
  // } payload;
  // } Name;
  // A payload-less variant occupies a tag slot but no union member.
  // Payload fields are named positionally (`_0`, `_1`, ...), matching
  // `emit_enum_variant_construction`'s own field names.
  emit_tagged_union_enum(EnumDeclNode e) {
    self.state.write("typedef enum ");
    self.state.write(e.name);
    self.state.write("_tag {\n");
    for v : e.variants {
      self.state.write("  ");
      self.state.write(e.name);
      self.state.write("_");
      self.state.write(v.name);
      self.state.write(",\n");
    }
    self.state.write("} ");
    self.state.write(e.name);
    self.state.write("_tag;\n");

    self.state.write("typedef struct ");
    self.state.write(e.name);
    self.state.write(" {\n  ");
    self.state.write(e.name);
    self.state.write("_tag tag;\n  union {\n");
    for v : e.variants {
      if v.has_payload && v.payload.len > 0 {
        self.state.write("    struct { ");
        num i = 0;
        Vec<str> payload_type_names;
        payload_type_names.init(0);
        Vec<bin> payload_is_pointer;
        payload_is_pointer.init(0);
        for pt : v.payload {
          let wt = self.write_type(*pt);
          if wt.is_some() {
            payload_type_names.push(wt.unwrap());
          } else {
            payload_type_names.push("");
          }
          payload_is_pointer.push(dtype_is_pointer(self.resolve_type_subst(*pt)));
          self.state.write(" _");
          self.state.write(format_num(i));
          self.state.write("; ");
          i = i + 1;
        }
        self.state.write("} ");
        self.state.write(v.name);
        self.state.write(";\n");
        self.record_enum_variant_payload(e.name, v.name, payload_type_names, payload_is_pointer);
      }
    }
    self.state.write("  } payload;\n} ");
    self.state.write(e.name);
    self.state.write(";\n\n");
  }

  // Emits a non-generic `compound Name { fields }` declaration as a C
  // struct typedef: `typedef struct Name { <type> <field>; ... } Name;`.
  // A GENERIC compound (`has_type_params`) is instead only RECORDED as a
  // template (see `Codegen.generic_compound_names`'s doc comment) --
  // never emitted directly itself, matching the original's own rule
  // that only a concrete monomorphized specialization of a generic
  // template is ever emitted (see `ensure_compound_instantiated`).
  // 
  // Deliberately simplified from the original for this slice: no
  // forward declaration and no dependency-ordering pass for by-value
  // nested compounds either (the original topologically sorts these,
  // treating generic instantiations and plain compounds/enums as one
  // unified worklist -- see `emit_generic_compound_specializations`'s
  // own "topological pass" comment in `modules/codegen/transpiler.zig`
  // around its `remaining_specs`/`remaining_enum_specs` worklists) --
  // this assumes source order already satisfies it, same as a plain
  // sequential C struct-after-struct listing would require.
  // 
  // CONFIRMED BROKEN for a real multi-file program (found via the
  // self-hosted driver's own first end-to-end run, `selfhost/cli/
  // main.fn`, compiling something as simple as `imp std.io;`): `pub
  // transpile` emits ALL enums in one pass, THEN all plain compounds in
  // a separate one (see `pub transpile`'s own doc comment) -- but
  // stdlib's own types depend on each other in BOTH directions
  // (`std.io`'s `Sink` enum holds a `File` compound BY VALUE in one
  // variant, needing compounds-before-enums; `std.error`'s `Error`
  // compound holds an `ErrorKind` enum BY VALUE as a field, needing
  // enums-before-compounds) -- so neither pass ORDER is universally
  // safe, and a plain two-pass swap just trades one break for the
  // other. A real fix needs the SAME lazy, first-reference-triggers-
  // emission mechanism generic types already get via
  // `ensure_compound_instantiated`/`ensure_enum_instantiated`, extended
  // to cover plain (non-generic) compounds/enums too -- not a bigger
  // hard-coded pass ordering. Left as a known, documented gap rather
  // than a quick patch; no array-typed fields (`T[3]`/`T[]`) either --
  // only scalar/pointer field types.
  emit_compound(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Compound(c) -> {
        Vec<str> field_names;
        field_names.init(0);
        Vec<str> field_type_names;
        field_type_names.init(0);
        Vec<bin> field_is_pointer;
        field_is_pointer.init(0);

        if c.has_type_params {
          for f : c.fields {
            field_names.push(f.name);
            field_type_names.push(f.dtype.type_str);
            field_is_pointer.push(dtype_is_pointer(*f.dtype));
          }
          self.generic_compound_names.push(c.name);
          self.generic_compound_type_params.push(c.type_params);
          self.generic_compound_field_names.push(field_names);
          self.generic_compound_field_type_names.push(field_type_names);
          self.generic_compound_field_is_pointer.push(field_is_pointer);
          ret .None;
        }

        Vec<DataType> field_dtypes;
        field_dtypes.init(0);
        self.state.write("typedef struct ");
        self.state.write(c.name);
        self.state.write(" {\n");
        for f : c.fields {
          self.state.write("  ");
          let wt = self.write_type(*f.dtype);
          if wt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          self.state.write(" ");
          self.state.write(f.name);
          self.state.write(";\n");
          field_names.push(f.name);
          field_type_names.push(wt.unwrap());
          field_is_pointer.push(dtype_is_pointer(*f.dtype));
          field_dtypes.push(self.resolve_type_subst(*f.dtype));
        }
        self.state.write("} ");
        self.state.write(c.name);
        self.state.write(";\n\n");
        self.record_compound_typed(
          c.name,
          field_names,
          field_type_names,
          field_is_pointer,
          field_dtypes
        );
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Pre-registers every PLAIN top-level function's name and its own
  // parameters' declared types (see `Codegen.function_names`'s doc
  // comment), WITHOUT emitting any C -- its own whole-program pass, run
  // before ANY function body is emitted, so a call to a function defined
  // LATER in source order still resolves (same reasoning as
  // `register_impl_methods`'s own separate pass). A generic function
  // (`f.has_type_params`) is instead only RECORDED whole (see
  // `Codegen.generic_function_templates`'s doc comment) -- monomorphized
  // lazily, from its own CALL site, by
  // `maybe_instantiate_generic_function`.
  register_function_signatures(Vec<Node> nodes) {
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          if f.has_type_params {
            self.generic_function_templates.push(n);
          } else {
            Vec<DataType*> param_types;
            param_types.init(0);
            if f.has_args {
              for arg : f.args {
                fit arg.kind {
                  .Variable(v) -> { param_types.push(v.var_type); }
                  _ -> {}
                }
              }
            }
            self.function_names.push(f.name);
            self.function_param_types.push(param_types);
            if f.has_rtype {
              self.function_rtypes.push(f.rtype);
            } else {
              self.function_rtypes.push(nil);
            }
          }
        }
        _ -> {}
      }
    }
  }

  // Looks up `fn_name`'s OWN declared return type -- see
  // `Codegen.function_rtypes`'s doc comment. `.None` means the function
  // isn't registered (unknown, a method, or a generic function).
  lookup_function_rtype(str fn_name) Option<DataType*> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        let rt = self.function_rtypes.get(i);
        if rt == nil {
          ret .None;
        }
        ret .Some(rt);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Infers a call ARGUMENT expression's own bare type name, for binding
  // one of a generic function's type parameters from its actual call
  // site (see `maybe_instantiate_generic_function`'s doc comment) --
  // deliberately narrow, the same "already fully explicit, no real
  // inference" spirit as everywhere else in this file: a known LOCAL
  // (its own recorded type), a call to an already-registered PLAIN
  // function (its own declared return type -- `err_kind`'s real call
  // site infers `T` from `token_zero()` this way), or a literal
  // (num/dec/str/chr/bin, from the literal's own kind). Anything else
  // (a field access, a method call, a nested generic call, ...) is
  // unresolvable, rejected rather than guessed.
  infer_arg_type_name(Node* arg) Option<str> {
    fit arg.kind {
      .Identifier(name) -> { ret self.lookup_local_type_name(name); }
      .Number(data) -> {
        fit data {
          .Num(_) -> { ret .Some("num"); }
          .Dec(_) -> { ret .Some("dec"); }
          _ -> { ret .None; }
        }
      }
      .String(_) -> { ret .Some("str"); }
      .Character(_) -> { ret .Some("chr"); }
      .Boolean(_) -> { ret .Some("bin"); }
      .Expression(e) -> {
        if !equals(e.op, "()") || !e.has_left {
          ret .None;
        }
        fit e.left.kind {
          .Identifier(callee_name) -> {
            let rt = self.lookup_function_rtype(callee_name);
            if rt.is_none() {
              ret .None;
            }
            ret .Some(rt.unwrap().type_str);
          }
          _ -> { ret .None; }
        }
      }
      _ -> { ret .None; }
    }
  }

  // Infers a `let NAME = <expr>;` declaration's own type, for THIS
  // codegen's OWN bookkeeping (`record_local`, so a later bare-shorthand
  // `fit`/chained field access/method call on `NAME` still resolves) --
  // the C DECLARATION itself always emits GNU C's own `__auto_type`
  // regardless (see `emit_statement`'s `.Variable` case), so a failed
  // inference here only means `NAME` isn't a known local afterward, not
  // that the declaration itself is rejected. Covers the same shapes
  // `infer_arg_type_name` does (a known local, a literal, a call to an
  // already-registered plain function) PLUS a method call
  // (`recv.method()`, e.g. `let last = self.tokens.last();` --
  // `_prev_token_is_bare_zero`'s real body in the self-hosted lexer's
  // own source -- resolved via `resolve_field_chain` + `
  // lookup_impl_method_rtype`, the exact same two lookups `emit_fit`'s
  // own call-subject handling already uses). Anything else (a nested
  // generic call, a chained method call whose OWN receiver is itself a
  // call, ...) is unresolvable, rejected rather than guessed.
  infer_let_expr_type(Node* val) Option<DataType> {
    fit val.kind {
      .Identifier(name) -> {
        let t = self.lookup_local_type_name(name);
        let p = self.lookup_local_is_pointer(name);
        if t.is_none() || p.is_none() {
          ret .None;
        }
        DataType dt = dtype_new();
        dt.type_str = t.unwrap();
        if p.unwrap() {
          dt.pointer_depth = 1;
        }
        ret .Some(dt);
      }
      .Number(data) -> {
        DataType dt = dtype_new();
        fit data {
          .Num(_) -> {
            dt.type_str = "num";
            ret .Some(dt);
          }
          .Dec(_) -> {
            dt.type_str = "dec";
            ret .Some(dt);
          }
          _ -> { ret .None; }
        }
      }
      .String(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "str";
        ret .Some(dt);
      }
      .Character(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "chr";
        ret .Some(dt);
      }
      .Boolean(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "bin";
        ret .Some(dt);
      }
      .Expression(e) -> {
        // A plain field-access initializer (`let ct = self.current_token;`
        // -- `ParseState.err`'s own real body, found via the self-compile
        // experiment): resolve the WHOLE chain (any depth) via
        // `resolve_field_chain`, the same resolution a later `ct.pos.line`
        // read of this local would need to already have registered.
        // Without this case, `ct` was never recorded as a known local at
        // all (falling through to the `_ -> { ret .None; }` catch-all
        // below), so any FURTHER field access off of it was rejected as
        // an unrecognized local -- not a `defer`-specific bug, just never
        // exercised until a real chained-field-copy-then-read pattern
        // showed up.
        if equals(e.op, ".") {
          let chain = self.resolve_field_chain(val);
          if chain.is_none() {
            ret .None;
          }
          let r = chain.unwrap();
          DataType dt = dtype_new();
          dt.type_str = r.type_name;
          if r.is_pointer {
            dt.pointer_depth = 1;
          }
          ret .Some(dt);
        }
        if !equals(e.op, "()") || !e.has_left {
          ret .None;
        }
        fit e.left.kind {
          .Identifier(fn_name) -> {
            let rt = self.lookup_function_rtype(fn_name);
            if rt.is_none() {
              ret .None;
            }
            ret .Some(*rt.unwrap());
          }
          .Expression(recv_e) -> {
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .None;
            }
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(n) -> { method_name = n; }
              _ -> { ret .None; }
            }
            let recv_r_opt = self.resolve_field_chain(recv_e.left);
            if recv_r_opt.is_none() {
              ret .None;
            }
            let recv_r = recv_r_opt.unwrap();
            let rt = self.lookup_impl_method_rtype(recv_r.type_name, method_name);
            if rt.is_none() {
              ret .None;
            }
            ret .Some(*rt.unwrap());
          }
          _ -> { ret .None; }
        }
      }
      _ -> { ret .None; }
    }
  }

  // Given `fn_name` (a call's plain-identifier callee) and its already-
  // flattened, actual call ARGUMENTS, checks whether `fn_name` matches a
  // registered GENERIC function template (see `Codegen.
  // generic_function_templates`'s doc comment); if so, infers each of
  // the template's own type parameters' concrete binding from whichever
  // positional argument's OWN declared parameter type is a bare
  // occurrence of that type param (`T _default_value` -- matching
  // `ensure_compound_instantiated`'s own "bare occurrence only"
  // restriction, via `infer_arg_type_name`), monomorphizes the function
  // body under a mangled name (`<name>__<arg1>__<arg2>...`, deduped via
  // `emitted_generic_instantiations`, the SAME shared registry generic
  // compounds/enums/impls already use), and returns that mangled name
  // for `emit_call` to use as the actual C callee. `.None` means either
  // `fn_name` isn't a generic function template at all (the ordinary,
  // ALREADY-registered-non-generic case, or genuinely unknown), or a
  // type param's binding couldn't be inferred from this call's own
  // arguments -- `emit_call` must reject rather than guess in that case.
  // 
  // Deliberately narrow for this slice: no pointer-arg mangling (unlike
  // the compound/enum/impl-method cases, every inferred binding is
  // treated as a bare value type, matching every call site this slice
  // was verified against), and the monomorphized body's OWN call
  // arguments don't get bare-shorthand resolution the way a plain
  // (non-generic) function's calls do (`Codegen.function_names`'s own
  // per-argument lookup isn't consulted here).
  // Falls back to CONTEXTUAL inference for a generic function's type
  // param `tp` when the call's own arguments don't reveal it at all
  // (`ret ok(.None);` inside `_next_inner`'s real body -- `ok<T>(value)
  // Result<T, Error>` called with a bare shorthand that carries no type
  // info by itself) -- matches `f`'s OWN declared return type
  // STRUCTURALLY against the CURRENT enclosing function's own concrete
  // return type (`Codegen.current_fn_rtype_dt`, same base name, same
  // generic-arg count), finds the position where `tp` appears as a bare
  // occurrence in `f`'s own return type, and resolves the ENCLOSING
  // function's own return type at that SAME position (`_next_inner`'s
  // `Result<Option<Token>, Error>`, position 0 -> `Option<Token>` ->
  // `T`). `.None` when there's no enclosing function context, the
  // return-type SHAPES don't match, or `tp` doesn't appear (bare) in
  // `f`'s own return type at all -- the caller must reject rather than
  // guess.
  infer_generic_function_type_param_from_context(FunctionNode f, str tp) Option<str> {
    if !f.has_rtype || self.current_fn_rtype_dt.is_none() {
      ret .None;
    }
    let caller_rtype = self.current_fn_rtype_dt.unwrap();
    if !equals(f.rtype.type_str, caller_rtype.type_str) || f.rtype.generic_args.len != caller_rtype.generic_args.len {
      ret .None;
    }
    num pi = 0;
    for pi < f.rtype.generic_args.len {
      let templ_arg = f.rtype.generic_args.get(pi);
      if equals(templ_arg.type_str, tp) && templ_arg.generic_args.len == 0 {
        let caller_arg = caller_rtype.generic_args.get(pi);
        ret self.resolve_type_name(*caller_arg);
      }
      pi = pi + 1;
    }
    ret .None;
  }

  maybe_instantiate_generic_function(str fn_name, Vec<Node*> args) Option<GenericCallResolution> {
    for tmpl : self.generic_function_templates {
      fit tmpl.kind {
        .Function(f) -> {
          if equals(f.name, fn_name) {
            Vec<str> arg_type_names;
            arg_type_names.init(0);
            Vec<bin> arg_is_pointer;
            arg_is_pointer.init(0);
            for tp : f.type_params {
              bin found = false;
              str found_name = "";
              num ai = 0;
              for parg : f.args {
                fit parg.kind {
                  .Variable(v) -> {
                    if equals(v.var_type.type_str, tp) && v.var_type.generic_args.len == 0 && ai < args.len {
                      let inferred = self.infer_arg_type_name(args.get(ai));
                      if inferred.is_some() {
                        found_name = inferred.unwrap();
                        found = true;
                      }
                    }
                  }
                  _ -> {}
                }
                ai = ai + 1;
              }
              if !found {
                let ctx_inferred = self.infer_generic_function_type_param_from_context(f, tp);
                if ctx_inferred.is_some() {
                  found_name = ctx_inferred.unwrap();
                  found = true;
                }
              }
              if !found {
                ret .None;
              }
              arg_type_names.push(found_name);
              arg_is_pointer.push(false);
            }

            StringBuilder nb = string_builder_init(16);
            nb.append(fn_name);
            for an : arg_type_names {
              nb.append("__");
              nb.append(an);
            }
            str mangled_name = nb.build();

            // The substitution context is set up-front (BEFORE the
            // dedup check below) so `substituted param types` can be
            // computed -- and returned to the caller via
            // `GenericCallResolution.param_types` for its OWN
            // bare-shorthand argument resolution (`ok(.None)`, e.g.) --
            // on EITHER path: a repeat call resolves to the
            // already-monomorphized instance without re-emitting
            // anything, but its params still need to be resolved fresh
            // for THIS call site.
            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            self.type_subst_param_names = f.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            Vec<DataType> param_types;
            param_types.init(0);
            for parg : f.args {
              fit parg.kind {
                .Variable(v) -> {
                  param_types.push(self.resolve_type_subst(*v.var_type));
                }
                _ -> {}
              }
            }

            num ei = 0;
            bin already_emitted = false;
            for ei < self.emitted_generic_instantiations.len {
              if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
                already_emitted = true;
              }
              ei = ei + 1;
            }

            if !already_emitted {
              self.emitted_generic_instantiations.push(mangled_name);

              // `hoist_insert_pos` (if set) is a position measured
              // against the OUTER, now-swapped-away buffer -- suspending
              // it for the duration of the swap makes any NESTED
              // instantiation triggered from inside this function's own
              // signature/body (e.g. a return type that's ITSELF a
              // generic enum, like `err_kind<T>`'s own `Result<T,
              // Error>`) append inline to `scratch` instead of splicing
              // at a stale position into the wrong buffer (which
              // corrupts `substr`'s own length arithmetic and crashes)
              // -- the whole scratch buffer still ends up hoisted to
              // the correct outer position via `emit_hoisted` below
              // regardless. Same reasoning as
              // `maybe_instantiate_generic_impl_methods`'s own
              // local-state save/restore: this can run NESTED inside
              // another function's own (still in-progress) emission
              // (e.g. triggered from resolving ITS OWN return type), so
              // `local_names`/`local_is_pointer`/`local_type_name`/
              // `current_fn_rtype_name`/`current_fn_rtype_dt` -- all
              // unconditionally overwritten by `emit_function_named`
              // for ITS OWN target -- must be saved and restored too,
              // not just `hoist_insert_pos`.
              CodegenState scratch = codegen_state_new();
              CodegenState* saved_state = self.state;
              let saved_hoist_pos = self.hoist_insert_pos;
              let saved_local_names = self.local_names;
              let saved_local_is_pointer = self.local_is_pointer;
              let saved_local_type_name = self.local_type_name;
              let saved_local_dtype = self.local_dtype;
              let saved_fn_rtype_name = self.current_fn_rtype_name;
              let saved_fn_rtype_dt = self.current_fn_rtype_dt;
              let saved_defer_stack = self.defer_stack;
              let saved_defer_scope_starts = self.defer_scope_starts;
              self.state = &scratch;
              self.hoist_insert_pos = .None;
              self.emit_function_named(tmpl, mangled_name);
              self.state = saved_state;
              self.hoist_insert_pos = saved_hoist_pos;
              self.local_names = saved_local_names;
              self.local_is_pointer = saved_local_is_pointer;
              self.local_type_name = saved_local_type_name;
              self.local_dtype = saved_local_dtype;
              self.current_fn_rtype_name = saved_fn_rtype_name;
              self.current_fn_rtype_dt = saved_fn_rtype_dt;
              self.defer_stack = saved_defer_stack;
              self.defer_scope_starts = saved_defer_scope_starts;
              self.emit_hoisted(scratch.out.build());
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;

            GenericCallResolution res;
            res.mangled_name = mangled_name;
            res.param_types = param_types;
            ret .Some(res);
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Looks up the declared type of `fn_name`'s parameter at `arg_index`
  // (0-based) -- see `Codegen.function_names`'s doc comment. Falls back
  // to a GENERIC function template's OWN declared parameter type at that
  // position when `fn_name` isn't in the plain registry (`err_kind(
  // .Invalid, "msg", "")` -- try_substr's real body, e.g. -- needs
  // `.Invalid` resolved against `kind`'s own `ErrorKind` type even
  // though `err_kind` itself is generic; the TEMPLATE's own param type
  // at a non-generic position is already fully concrete, no
  // substitution needed for bare-shorthand purposes). `.None` means
  // `fn_name` isn't registered ANYWHERE (unknown, or a method -- see
  // `register_function_signatures`), or `arg_index` is out of range (a
  // variadic C binding's trailing `...` args, say) -- the caller must
  // treat that as "can't resolve this argument's expected type," not
  // guess.
  lookup_function_param_type(str fn_name, num arg_index) Option<DataType*> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        let params = self.function_param_types.get(i);
        if arg_index < 0 || arg_index >= params.len {
          ret .None;
        }
        ret .Some(params.get(arg_index));
      }
      i = i + 1;
    }
    for tmpl : self.generic_function_templates {
      fit tmpl.kind {
        .Function(f) -> {
          if equals(f.name, fn_name) {
            if arg_index < 0 || !f.has_args || arg_index >= f.args.len {
              ret .None;
            }
            let param_node = f.args.get(arg_index);
            fit param_node.kind {
              .Variable(v) -> { ret .Some(v.var_type); }
              _ -> { ret .None; }
            }
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Pre-registers every method of a plain OR quirk-implementing
  // (non-generic) impl block under its own bare name and fully mangled
  // C call-site name (see `Codegen.impl_method_owner_type`'s doc
  // comment), WITHOUT emitting any C -- run as its OWN whole-program
  // pass, before ANY impl method body is generated (see `transpile`'s
  // doc comment for why: a method that calls another type's method
  // needs that OTHER type's row recorded already, regardless of which
  // impl block happens to come first in source order -- the same
  // reason `emit_enum`/`emit_compound` get their own full passes before
  // impl bodies are emitted at all). The bare name is recovered by
  // stripping the known prefix (`Type__` for a plain impl, `Type__
  // Quirk__` for a quirk-implementing one) off each method's ALREADY
  // pre-mangled `Function` node name -- `_parse_impl_method`'s own
  // scheme in the parser, not something this file invents. A GENERIC
  // impl (`has_type_params`) is instead only RECORDED whole (see
  // `Codegen.generic_impl_templates`'s doc comment) -- never registered
  // under its bare (un-instantiated) name here, matching
  // `emit_compound`/`emit_enum`'s own rule for a generic template:
  // monomorphization happens lazily, on first concrete use (see
  // `maybe_instantiate_generic_impl_methods`).
  register_impl_methods(Node node) {
    fit node.kind {
      .Impl(i) -> {
        if i.has_type_params {
          self.generic_impl_templates.push(node);
          ret;
        }
        StringBuilder pfx = string_builder_init(16);
        pfx.append(i.type_name);
        pfx.append("__");
        if i.has_quirk_name {
          pfx.append(i.quirk_name);
          pfx.append("__");
        }
        str prefix = pfx.build();
        for m : i.methods {
          str mangled_name = "";
          DataType* rtype = nil;
          fit m.kind {
            .Function(fnv) -> {
              mangled_name = fnv.name;
              if fnv.has_rtype {
                rtype = fnv.rtype;
              }
            }
            _ -> {}
          }
          let bare_name = strip_prefix(mangled_name, prefix);
          self.record_impl_method(i.type_name, bare_name, mangled_name, rtype);
        }
      }
      _ -> {}
    }
  }

  // Emits every method of a plain OR quirk-implementing (non-generic)
  // `impl Type { methods }` block as an ordinary top-level C function --
  // the parser ALREADY did the work that makes this trivial: each
  // method is parsed as a `Function` node pre-mangled to `Type__method`
  // (or `Type__Quirk__method`) with `<Type>* self` as its real first arg
  // (`_parse_impl_method`'s doc comment in the parser), so a method is
  // emitted exactly like any other function via the existing
  // `emit_function` -- no separate self-injection or name-mangling
  // logic needed here. Assumes `register_impl_methods` already ran for
  // every impl in the program (see its own doc comment and `transpile`'s
  // pass ordering) -- this function only EMITS, it doesn't register.
  // 
  // Still deliberately narrow for this slice: TRUE dynamic dispatch
  // through an abstract quirk-TYPED value (assigning a concrete
  // quirk-implementor to a variable declared as the quirk itself, then
  // calling through it via a vtable) isn't reachable yet -- only a
  // STATIC call through a receiver whose OWN declared type is already
  // the concrete implementing type works (see `emit_method_call`'s doc
  // comment), which is by far the common case in this codebase's own
  // real source. A generic impl (`has_type_params`) is skipped too,
  // same reasoning as `emit_compound`'s generic-template skip.
  emit_impl(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Impl(i) -> {
        if i.has_type_params {
          ret .None;
        }
        for m : i.methods {
          let merr = self.emit_function(*m);
          if merr.is_some() {
            ret merr;
          }
        }
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Writes the fixed set of C headers the original always includes
  // (before any conditional ones gated on stdlib usage, threads, sockets,
  // etc. -- none of which are reachable yet since imports aren't ported),
  // plus the same fixed `stderr_stream()` helper the original's own
  // prelude always defines too -- `emit_expr`'s `.Panic` case calls it
  // unconditionally, so it must always be present regardless of whether
  // this particular program uses `panic(...)` at all (matching the
  // original's own reasoning: cheap, harmless when unused, and avoids
  // conditionally tracking "does this program need it").
  pub write_prelude() {
    self.state.write("#include <stdio.h>\n");
    self.state.write("#include <stdbool.h>\n");
    self.state.write("#include <stdint.h>\n");
    self.state.write("#include <stdarg.h>\n");
    self.state.write("#include <stdlib.h>\n");
    self.state.write("#include <string.h>\n");
    self.state.write("static FILE* stderr_stream(void){ return stderr; }\n");
    // The compiler's own private thread primitive -- always emitted,
    // regardless of whether this program uses `fork`/`async`/channels.
    // `await`/`fork` support (ported next) build directly on
    // `__fun_thread_start`/`__fun_thread_join`; the M:N scheduler
    // (`fork`'s own task queue) builds on top of THIS, not the other way
    // around. Kept as a byte-for-byte copy of the original implementation's
    // own prelude text for this layer.
    self.state.write("#ifdef _WIN32\n");
    self.state.write("#include <windows.h>\n");
    self.state.write("typedef HANDLE __fun_thread_t;\n");
    self.state.write("typedef void* (*__fun_thread_entry_t)(void*);\n");
    self.state.write("typedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;\n");
    self.state.write("static DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }\n");
    self.state.write("static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 0, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }\n");
    self.state.write("static int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }\n");
    self.state.write("#else\n");
    self.state.write("#include <pthread.h>\n");
    self.state.write("typedef pthread_t __fun_thread_t;\n");
    self.state.write("typedef void* (*__fun_thread_entry_t)(void*);\n");
    self.state.write("static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { return pthread_create(t, NULL, entry, arg); }\n");
    self.state.write("static int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }\n");
    self.state.write("#endif\n");
    // A plain (non-fork) program can still deadlock on a channel wait (e.g.
    // a lone `ch.recv()` with no sender) -- `std/channel.fn` calls
    // `__fun_wd_enter_wait`/`__fun_wd_leave_wait` around every blocking wait
    // unconditionally, so these three symbols must always exist regardless
    // of whether `fork` is used. This minimal, self-contained watchdog
    // (no task queue to track, since nothing is scheduled -- just "at least
    // one blocking wait open, no progress for the configured threshold") is
    // ALWAYS what gets emitted today; the M:N scheduler's own alternative
    // watchdog (gated on `self.uses_fork`, once `fork` support itself is
    // ported) is a later slice of this port. Dormant unless
    // FUN_DEADLOCK_WATCHDOG_MS is set. Byte-for-byte copy of the original
    // implementation's own text for this block.
    self.state.write(`typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
    `static __fun_wd_state __fun_g_wd;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `static void* __fun_wd_thread(void* unused){ (void)unused;
    `  long long last_seq=-1; long long stall_ms=0;
    `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
    `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_wd.threshold_ms){
    `      __fun_wd_warn((long long)blk, 0, stall_ms);
    `      if(__fun_g_wd.abort_on_fire) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `void __fun_wd_enter_wait(void){
    `  if(!__fun_g_wd.started){
    `    __fun_g_wd.started=1;
    `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm=(w && w[0])?atoll(w):0;
    `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
    `    const char* a=getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
    `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
    `  }
    `  if(!__fun_g_wd.armed) return;
    `  __fun_g_wd.blocked++;
    `}
    `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
    ``);
  }

  // Transpiles every top-level `Enum`/`Compound`/`Impl`/`Function` node
  // in `nodes` (anything else is skipped -- not an error, since a
  // whole-file parse can contain declarations not reachable yet, like
  // `imp`). EVERY impl's methods are pre-registered
  // (`register_impl_methods`) FIRST, before enums or compounds are even
  // looked at -- a generic impl's own template must already be in
  // `generic_impl_templates` before the enum/compound pass runs, since a
  // plain compound/enum's OWN field can itself be a generic
  // instantiation (`compound Lexer { Vec<Token> tokens; }`) that
  // immediately triggers monomorphizing `Vec<T>`'s own methods (see
  // `pub transpile`'s own inline comment for the bug this ordering
  // fixes). Enums are emitted next (registering their names/variants as
  // a side effect -- see `emit_enum`'s doc comment), then compounds, all
  // before any impl-method/function BODY is generated -- so a method
  // calling another type's method, or referencing an enum/compound,
  // resolves correctly regardless of which declaration comes first in
  // source order (see `emit_compound`'s doc comment for what that pass
  // deliberately doesn't handle yet: dependency ordering between
  // compounds themselves). Impl methods are then emitted (each becomes
  // an ordinary C function, see `emit_impl`) in a fourth pass, before
  // plain top-level functions in a fifth, so a plain function calling a
  // method doesn't need a forward declaration.
  pub transpile(Vec<Node> nodes) Option<CodegenErrorKind> {
    // Computed before the prelude is written -- not read yet (see
    // `uses_fork`'s own doc comment), but the original implementation
    // requires this ordering once the scheduler starts reading it, so
    // matching it now avoids a reorder later.
    self.uses_fork = uses_fork_in(nodes);
    self.write_prelude();
    self.register_function_signatures(nodes);
    // Impl methods are pre-registered FIRST, before either the enum or
    // compound pass -- a generic impl's own template must already be in
    // `generic_impl_templates` by the time `emit_enum`/`emit_compound`
    // run, since a NON-generic compound/enum's OWN field can itself be a
    // generic instantiation (`compound Lexer { Vec<Token> tokens; }`)
    // that immediately triggers `maybe_instantiate_generic_impl_methods`
    // -- registering impls AFTER the enum/compound pass (the previous
    // order) meant that first-use trigger found no template registered
    // yet, silently skipping Vec<T>'s own methods instead of
    // monomorphizing them.
    for n : nodes {
      fit n.kind {
        .Impl(i) -> { self.register_impl_methods(n); }
        _ -> {}
      }
    }
    for n : nodes {
      fit n.kind {
        .Enum(e) -> {
          self.hoist_insert_pos = .Some(self.state.out.len());
          let eerr = self.emit_enum(n);
          if eerr.is_some() {
            ret eerr;
          }
        }
        _ -> {}
      }
    }
    for n : nodes {
      fit n.kind {
        .Compound(c) -> {
          self.hoist_insert_pos = .Some(self.state.out.len());
          let cerr = self.emit_compound(n);
          if cerr.is_some() {
            ret cerr;
          }
        }
        _ -> {}
      }
    }
    for n : nodes {
      fit n.kind {
        .Impl(i) -> {
          self.hoist_insert_pos = .Some(self.state.out.len());
          let ierr = self.emit_impl(n);
          if ierr.is_some() {
            ret ierr;
          }
        }
        _ -> {}
      }
    }
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          if !f.has_type_params {
            self.hoist_insert_pos = .Some(self.state.out.len());
            let ferr = self.emit_function(n);
            if ferr.is_some() {
              ret ferr;
            }
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }
}

test "write_type emits builtin scalar C types with pointer depth" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "num";
  g.write_type(dt);
  assert equals(st.out.build(), "int64_t"), "expected 'int64_t'";

  CodegenState st2 = codegen_state_new();
  Codegen g2 = codegen_new(&st2);
  DataType dt2 = dtype_new();
  dt2.type_str = "chr";
  dt2.pointer_depth = 2;
  g2.write_type(dt2);
  assert equals(st2.out.build(), "char**"), "expected 'char**'";
}

test "write_type emits a sized int via dynamic_int_type_to_c" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "u32";
  g.write_type(dt);
  assert equals(st.out.build(), "uint32_t"), "expected 'uint32_t'";
}

test "emit_expr emits a number literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Number(TokenData.Num(42)));
  assert g.emit_expr(n).is_none(), "expected the number to emit";
  assert equals(st.out.build(), "42"), "expected '42'";
}

test "emit_expr emits a string literal verbatim between quotes" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("hello"));
  assert g.emit_expr(n).is_none(), "expected the string to emit";
  assert equals(st.out.build(), "\"hello\""), "expected a quoted string";
}

test "emit_expr escapes a raw string's literal bytes when node.flags.is_raw_string is set" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("C:\\Users\\name"));
  n.flags.is_raw_string = true;
  assert g.emit_expr(n).is_none(), "expected the raw string to emit";
  // Each literal backslash must become an escaped pair in the C output.
  assert equals(st.out.build(), "\"C:\\\\Users\\\\name\""), "expected backslashes escaped for C";
}

test "emit_expr escapes an embedded double-quote and newline in a raw string" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("she said \"hi\"\nbye"));
  n.flags.is_raw_string = true;
  assert g.emit_expr(n).is_none(), "expected the raw string to emit";
  assert equals(st.out.build(), "\"she said \\\"hi\\\"\\nbye\""), "expected the quote and newline escaped for C";
}

test "emit_expr emits a boolean literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Boolean(true));
  assert g.emit_expr(n).is_none(), "expected the boolean to emit";
  assert equals(st.out.build(), "true"), "expected 'true'";
}

test "emit_expr emits the nil literal as C NULL" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Nil);
  assert g.emit_expr(n).is_none(), "expected 'nil' to emit";
  assert equals(st.out.build(), "NULL"), "expected 'NULL'";
}

test "emit_expr emits a panic expression as a GNU statement expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(NodeKind.String("oops"));
  Node n = node_new(NodeKind.Panic(msg));
  assert g.emit_expr(n).is_none(), "expected the panic expression to emit";
  assert equals(
    st.out.build(),
    "({ fprintf(stderr_stream(), \"panic: %s\\n\", \"oops\"); abort(); 0; })"
  ), "expected the GNU statement-expression lowering, printing the message and aborting";
}

test "emit_statement emits a bare panic(...) as a statement" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(NodeKind.String("internal error"));
  Node n = node_new(NodeKind.Panic(msg));
  assert g.emit_statement(n).is_none(), "expected the bare panic statement to emit";
  assert equals(
    st.out.build(),
    "({ fprintf(stderr_stream(), \"panic: %s\\n\", \"internal error\"); abort(); 0; });\n"
  ), "expected the panic expression followed by a trailing ';\\n', same as any other bare-expression statement";
}

test "emit_statement emits 'assert cond, msg;' as an if/abort with the message printed" {
  // Regression test: `_lex`'s own real body in the self-hosted lexer's
  // own source (`assert !r.is_err(), "tokenize() returned an error";`)
  // -- found via the self-compile experiment -- was entirely unhandled
  // (`.StatementAssert` had no `emit_statement` case at all, rejected as
  // `CodegenErrorKind.UnsupportedNode`).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Boolean(false));
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(NodeKind.String("should not happen"));
  AssertNode a;
  a.condition = cond;
  a.message = msg;
  a.has_message = true;
  Node n = node_new(NodeKind.StatementAssert(a));
  assert g.emit_statement(n).is_none(), "expected the assert statement to emit";
  assert equals(
    st.out.build(),
    "if (!(false)) { fprintf(stderr_stream(), \"Assertion failed: %s\\n\", \"should not happen\"); abort(); }\n"
  ), "expected an if/abort guard printing the assert's own message on failure";
}

test "emit_statement emits a message-less 'assert cond;' as a plain if/abort" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Boolean(true));
  AssertNode a;
  a.condition = cond;
  a.has_message = false;
  Node n = node_new(NodeKind.StatementAssert(a));
  assert g.emit_statement(n).is_none(), "expected the message-less assert statement to emit";
  assert equals(st.out.build(), "if (!(true)) { abort(); }\n"), "expected a plain if/abort guard with no message printed";
}

test "emit_expr escapes a character literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Character('\n'));
  assert g.emit_expr(n).is_none(), "expected the character to emit";
  assert equals(st.out.build(), "'\\n'"), "expected an escaped newline character literal";
}

test "emit_expr emits an identifier" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Identifier("x"));
  assert g.emit_expr(n).is_none(), "expected the identifier to emit";
  assert equals(st.out.build(), "x"), "expected 'x'";
}

test "emit_expr emits a prefix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "-";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(-x)"), "expected '(-x)'";
}

test "emit_expr emits pointer indirection as a run of stars" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "*";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("p"));
  u.operand = operand;
  u.has_indirection = true;
  u.indirection_depth = 2;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(**p)"), "expected '(**p)'";
}

test "emit_expr emits a postfix unary expression" {
