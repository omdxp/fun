test "emit_statement rejects a conditionless fit branch that carries bindings" {
  // Not reachable from real parsed source (a `_` default arm never has
  // destructuring bindings), but exercised directly as a defensive
  // invariant check: `has_bindings` must not be treated as a normal
  // default arm just because `has_condition` is false.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* subj = malloc(sizeof(Node));
  *subj = node_new(NodeKind.Identifier("x"));

  BodyNode bn;
  bn.statements.init(0);
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FitBranch br = fit_branch_new();
  br.body = body;
  br.bindings.push("r");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(n).is_some(), "expected a conditionless branch with bindings to be rejected";
}

test "emit_statement emits a fit destructuring a bare enum-variant shorthand pattern" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("o", "Opt", false);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Opt", variants, true);

  Node* subj = malloc(sizeof(Node));
  *subj = node_new(NodeKind.Identifier("o"));

  // `.Some(r) -> { ret r; }` -- bare shorthand: left is Blank, resolved
  // against the subject's own recorded local type ("Opt").
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Expression(dot));

  Node* ret_r = malloc(sizeof(Node));
  *ret_r = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_r);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;
  br.bindings.push("r");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(n).is_none(), "expected the bare-shorthand destructuring fit to emit";
  assert equals(
    st.out.build(),
    "if (o.tag == Opt_Some) {\n    __auto_type r = o.payload.Some._0;\n    return;\n}\n"
  ), "expected a tag check plus a payload-field binding";
}

test "emit_statement emits a fit over a method-call subject, hoisting a temp __auto_type var" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("h", "Holder", false);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Opt", variants, true);

  DataType* opt_rtype = malloc(sizeof(DataType));
  *opt_rtype = dtype_new();
  opt_rtype.type_str = "Opt";
  g.record_impl_method("Holder", "get_opt", "Holder__get_opt", opt_rtype);

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("h"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("get_opt"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank_arg = malloc(sizeof(Node));
  *blank_arg = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank_arg));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* subj = malloc(sizeof(Node));
  *subj = node_new(NodeKind.Expression(call_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Expression(dot));

  Node* ret_r = malloc(sizeof(Node));
  *ret_r = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_r);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;
  br.bindings.push("r");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(n).is_none(), "expected the fit-over-a-method-call to emit";
  assert equals(
    st.out.build(),
    "__auto_type __fit_subj = Holder__get_opt(&h);\nif (__fit_subj.tag == Opt_Some) {\n    __auto_type r = __fit_subj.payload.Some._0;\n    return;\n}\n"
  ), "expected the call hoisted into a temp var first, then the tag check/binding against IT, not the call re-evaluated per branch";
}

