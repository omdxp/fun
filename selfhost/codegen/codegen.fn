  assert equals(
    st.out.build(),
    `typedef enum Color {
    `  Color_Red,
    `  Color_Green = 5,
    `} Color;
    `
    ``
  ), "expected a C enum typedef with an auto and an explicit variant value";
}

test "emit_enum emits a tagged-union enum as a discriminant enum plus a tagged struct/union" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* payload_dt = malloc(sizeof(DataType));
  *payload_dt = dtype_new();
  payload_dt.type_str = "num";
  EnumVariant some_v = enum_variant_new();
  some_v.name = "Some";
  some_v.payload.push(payload_dt);
  some_v.has_payload = true;

  EnumVariant none_v = enum_variant_new();
  none_v.name = "None";

  EnumDeclNode e = enum_decl_node_new();
  e.name = "Option";
  e.variants.push(some_v);
  e.variants.push(none_v);

  Node n = node_new(NodeKind.Enum(e));
  assert g.emit_enum(n).is_none(), "expected the tagged-union enum to emit";
  assert equals(
    st.out.build(),
    `typedef enum Option_tag {
    `  Option_Some,
    `  Option_None,
    `} Option_tag;
    `typedef struct Option {
    `  Option_tag tag;
    `  union {
    `    struct { int64_t _0; } Some;
    `  } payload;
    `} Option;
    `
    ``
  ), "expected a discriminant enum, a tag field, and a union with only the payload variant present";
}

