test "emit_statement emits a range for as a counted C for loop" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* start = malloc(sizeof(Node));
  *start = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* end = malloc(sizeof(Node));
  *end = node_new(NodeKind.Identifier("n"));
  ExprNode range;
  range.left = start;
  range.has_left = true;
  range.right = end;
  range.has_right = true;
  range.op = "..";
  Node* range_node = malloc(sizeof(Node));
  *range_node = node_new(NodeKind.Expression(range));

  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> body_stmts;
  body_stmts.init(0);
  body_stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = body_stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  ForRangeNode fr;
  fr.index_name = "i";
  fr.range_expr = range_node;
  fr.body = body;
  Node n = node_new(NodeKind.StatementFor(ForKind.Range(fr)));

  assert g.emit_statement(n).is_none(), "expected the for-range to emit";
  assert equals(st.out.build(), "for (int64_t i = 0; i < n; i++) {\n    return;\n}\n"), "expected a counted C for loop";
}

