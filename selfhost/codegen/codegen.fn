test "emit_expr emits a tagged-union payload construction as a compound literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Option", variants, true);

  Node* callee_left = malloc(sizeof(Node));
  *callee_left = node_new(NodeKind.Identifier("Option"));
  Node* callee_right = malloc(sizeof(Node));
  *callee_right = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = callee_left;
  dot.has_left = true;
  dot.right = callee_right;
  dot.has_right = true;
  dot.op = ".";
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Expression(dot));

  Node* arg = malloc(sizeof(Node));
  *arg = node_new(NodeKind.Number(TokenData.Num(5)));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(arg));

  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected the enum-variant construction to emit";
  assert equals(st.out.build(), "((Option){ .tag = Option_Some, .payload.Some = { ._0 = (5) } })"), "expected a tagged-union compound literal with the payload set";
}

test "emit_compound emits a non-generic compound as a C struct typedef" {
