  br.body = body;
  br.bindings.push("r");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(n).is_some(), "expected a destructuring fit branch to be rejected (no enum support yet)";
}

