  Codegen g = codegen_new(&st);

  DataType* dt_x = malloc(sizeof(DataType));
  *dt_x = dtype_new();
  dt_x.type_str = "num";
  CompoundField fx;
  fx.name = "x";
  fx.dtype = dt_x;

  DataType* dt_y = malloc(sizeof(DataType));
  *dt_y = dtype_new();
  dt_y.type_str = "num";
  CompoundField fy;
  fy.name = "y";
  fy.dtype = dt_y;

  CompoundNode c = compound_node_new();
  c.name = "Point";
  c.fields.push(fx);
  c.fields.push(fy);

  Node n = node_new(NodeKind.Compound(c));
  assert g.emit_compound(n).is_none(), "expected the compound to emit";
  assert equals(st.out.build(), "typedef struct Point {\n  int64_t x;\n  int64_t y;\n} Point;\n\n"), "expected a C struct typedef with both fields";
}

test "emit_expr emits a method call on a value-typed receiver, taking its address" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("p", "Point", false);

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("p"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("get_x"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected the method call to emit";
  assert equals(st.out.build(), "Point__get_x(&p)"), "expected 'Point__get_x(&p)'";
}

test "emit_expr emits a method call on a pointer-typed receiver directly, with extra args" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("p", "Point", true);

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("p"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("set_x"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* arg = malloc(sizeof(Node));
  *arg = node_new(NodeKind.Number(TokenData.Num(5)));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(arg));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected the method call to emit";
  assert equals(st.out.build(), "Point__set_x(p, 5)"), "expected 'Point__set_x(p, 5)'";
}

test "emit_expr rejects a method call on a receiver that isn't a known local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("mod_alias"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("symbol"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_some(), "expected an unrecognized receiver to be rejected rather than guessed";
}

test "emit_impl emits each method as a mangled top-level C function, with self recorded as a pointer local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Point";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(NodeKind.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("x"));
  ExprNode field_e;
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  fnv.name = "Point__get_x";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.methods.push(method_node);

  Node impl_node = node_new(NodeKind.Impl(impln));
  assert g.emit_impl(impl_node).is_none(), "expected the impl to emit";
  assert equals(st.out.build(), "int64_t Point__get_x(Point* self) {\n    return self->x;\n}\n"), "expected the method emitted as a plain C function reading 'self->x'";
}

test "emit_impl skips a quirk-implementing impl (dynamic dispatch not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.quirk_name = "To";
  impln.has_quirk_name = true;

  Node impl_node = node_new(NodeKind.Impl(impln));
  assert g.emit_impl(impl_node).is_none(), "expected a quirk-implementing impl to be silently skipped";
  assert equals(st.out.build(), ""), "expected nothing emitted for a quirk-implementing impl";
}

test "emit_compound skips a generic compound (monomorphization not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;

  Node n = node_new(NodeKind.Compound(c));
  assert g.emit_compound(n).is_none(), "expected a generic compound to be silently skipped";
  assert equals(st.out.build(), ""), "expected nothing emitted for a generic compound";
}

test "emit_statement emits a bare assignment expression as a statement" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(NodeKind.Identifier("x"));
  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(NodeKind.Number(TokenData.Num(3)));
  ExprNode assign;
  assign.left = lhs;
  assign.has_left = true;
  assign.right = rhs;
  assign.has_right = true;
  assign.op = "=";
  Node n = node_new(NodeKind.Expression(assign));

  assert g.emit_statement(n).is_none(), "expected the assignment to emit";
  assert equals(st.out.build(), "(x = 3);\n"), "expected '(x = 3);\\n'";
}

test "transpile emits the prelude followed by every top-level function" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "main";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(val));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;
  Node fn_node = node_new(NodeKind.Function(fnv));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(fn_node);

  assert g.transpile(nodes).is_none(), "expected the whole file to transpile";
  let out = st.out.build();
  assert contains(out, "#include <stdint.h>"), "expected the prelude to be present";
  assert contains(out, "int64_t main(void) {"), "expected the function definition to be present";
}
