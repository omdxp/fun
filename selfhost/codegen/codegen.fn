test "emit_expr emits a prefix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "-";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(-x)"), "expected '(-x)'";
}

test "emit_expr emits pointer indirection as a run of stars" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "*";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("p"));
  u.operand = operand;
  u.has_indirection = true;
  u.indirection_depth = 2;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(**p)"), "expected '(**p)'";
}

test "emit_expr emits a postfix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = true;
  u.op = "++";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(x++)"), "expected '(x++)'";
}

test "emit_expr emits a binary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "+";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the expression to emit";
  assert equals(st.out.build(), "(a + b)"), "expected '(a + b)'";
}

test "emit_expr emits an explicit parenthesized sub-expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "+";
  Node* sum = malloc(sizeof(Node));
  *sum = node_new(NodeKind.Expression(e));
  Node n = node_new(NodeKind.ExpressionParenthesis(sum));
  assert g.emit_expr(n).is_none(), "expected the parenthesized expression to emit";
  assert equals(st.out.build(), "((a + b))"), "expected '((a + b))'";
}

test "emit_expr rejects an index/comma expression (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "[]";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected an index expression to be rejected this slice";
}

test "emit_expr emits a zero-arg call" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo()"), "expected 'foo()'";
}

test "emit_expr emits a multi-arg call, flattening the comma-chained argument list" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));

  Node* arg_a = malloc(sizeof(Node));
  *arg_a = node_new(NodeKind.Identifier("a"));
  Node* arg_b = malloc(sizeof(Node));
  *arg_b = node_new(NodeKind.Identifier("b"));
  ExprNode comma;
  comma.left = arg_a;
  comma.has_left = true;
  comma.right = arg_b;
  comma.has_right = true;
  comma.op = ",";
  Node* comma_node = malloc(sizeof(Node));
  *comma_node = node_new(NodeKind.Expression(comma));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(comma_node));

  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo(a, b)"), "expected 'foo(a, b)'";
}

test "emit_expr rejects a call whose callee isn't a plain identifier (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected a non-identifier callee to be rejected this slice";
}

test "emit_statement emits a variable declaration with an initializer" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "num";
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(5)));
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.val = val;
  v.has_val = true;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "int64_t x = 5;\n"), "expected 'int64_t x = 5;\\n'";
}

test "emit_statement emits an uninitialized variable declaration" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "bin";
  VariableNode v;
  v.var_type = dt;
  v.name = "done";
  v.val = nil;
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "bool done;\n"), "expected 'bool done;\\n'";
}

test "emit_body emits a plain if statement with no elif/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Identifier("ok"));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret_stmt);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));

  IfStmtNode ifn;
  ifn.condition = cond;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if statement to emit";
  assert equals(st.out.build(), "if (ok) {\n    return;\n}\n"), "expected a plain if block";
}

test "emit_body chains StatementIf/StatementElseIf/StatementElse into one if/else-if/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  // if a { ret 1; } elif b { ret 2; } else { ret 3; }
  Node* cond_a = malloc(sizeof(Node));
  *cond_a = node_new(NodeKind.Identifier("a"));
  Node* val1 = malloc(sizeof(Node));
  *val1 = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* ret1 = malloc(sizeof(Node));
  *ret1 = node_new(NodeKind.StatementReturn(val1));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret1);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));
  IfStmtNode ifn;
  ifn.condition = cond_a;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Node* cond_b = malloc(sizeof(Node));
  *cond_b = node_new(NodeKind.Identifier("b"));
  Node* val2 = malloc(sizeof(Node));
  *val2 = node_new(NodeKind.Number(TokenData.Num(2)));
  Node* ret2 = malloc(sizeof(Node));
  *ret2 = node_new(NodeKind.StatementReturn(val2));
  Vec<Node*> elif_stmts;
  elif_stmts.init(0);
  elif_stmts.push(ret2);
  BodyNode elif_body_n;
  elif_body_n.statements = elif_stmts;
  Node* elif_body = malloc(sizeof(Node));
  *elif_body = node_new(NodeKind.Body(elif_body_n));
  IfStmtNode ein;
  ein.condition = cond_b;
  ein.body = elif_body;
  Node* elif_stmt = malloc(sizeof(Node));
  *elif_stmt = node_new(NodeKind.StatementElseIf(ein));

  Node* val3 = malloc(sizeof(Node));
  *val3 = node_new(NodeKind.Number(TokenData.Num(3)));
  Node* ret3 = malloc(sizeof(Node));
  *ret3 = node_new(NodeKind.StatementReturn(val3));
  Vec<Node*> else_stmts;
  else_stmts.init(0);
  else_stmts.push(ret3);
  BodyNode else_body_n;
  else_body_n.statements = else_stmts;
  Node* else_body = malloc(sizeof(Node));
  *else_body = node_new(NodeKind.Body(else_body_n));
  Node* else_stmt = malloc(sizeof(Node));
  *else_stmt = node_new(NodeKind.StatementElse(else_body));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  stmts.push(elif_stmt);
  stmts.push(else_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if/elif/else chain to emit";
  let out = st.out.build();
  assert equals(
    out,
    "if (a) {\n    return 1;\n} else if (b) {\n    return 2;\n} else {\n    return 3;\n}\n"
  ), "expected a single chained if/else-if/else C construct";
}

