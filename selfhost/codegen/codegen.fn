test "emit_expr emits a method call through a CHAINED field-access receiver (self.parts.push(s))" {
  // Regression test: `self.parts.push(s)` (StringBuilder.append's real
  // body in stdlib/std/string.fn, found via the self-compile experiment)
  // used to be rejected outright -- emit_method_call only accepted a
  // bare identifier receiver, not a chained field access. Fixed by
  // resolving the receiver through the SAME resolve_field_chain
  // machinery emit_fit's subject and the bare-shorthand assignment case
  // already use, rather than a second, narrower lookup.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "StringBuilder", true);

  Vec<str> sb_fields;
  sb_fields.init(0);
  sb_fields.push("parts");
  Vec<str> sb_field_types;
  sb_field_types.init(0);
  sb_field_types.push("Vec__str");
  Vec<bin> sb_field_ptrs;
  sb_field_ptrs.init(0);
  sb_field_ptrs.push(false);
  g.record_compound("StringBuilder", sb_fields, sb_field_types, sb_field_ptrs);

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(NodeKind.Identifier("self"));
  Node* parts_ident = malloc(sizeof(Node));
  *parts_ident = node_new(NodeKind.Identifier("parts"));
  ExprNode chain_dot;
  chain_dot.left = self_ident;
  chain_dot.has_left = true;
  chain_dot.right = parts_ident;
  chain_dot.has_right = true;
  chain_dot.op = ".";
  Node* chain_node = malloc(sizeof(Node));
  *chain_node = node_new(NodeKind.Expression(chain_dot));

  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("push"));
  ExprNode dot_e;
  dot_e.left = chain_node;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* arg = malloc(sizeof(Node));
  *arg = node_new(NodeKind.Identifier("s"));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(arg));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected 'self.parts.push(s)' to emit";
  assert equals(st.out.build(), "Vec__str__push(&self->parts, s)"), "expected the chained receiver resolved to 'self->parts', taking its address since 'parts' is a value field";
}

