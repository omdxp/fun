  opt_rtype.type_str = "Opt";
  Vec<DataType*> get_opt_param_types;
  get_opt_param_types.init(0);
  Vec<Node*> get_opt_default_values;
  get_opt_default_values.init(0);
  g.record_impl_method(
    "Holder",
    "get_opt",
    "Holder__get_opt",
    opt_rtype,
    get_opt_param_types,
    get_opt_default_values
  );

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("h"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("get_opt"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank_arg = malloc(sizeof(Node));
  *blank_arg = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank_arg));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* subj = malloc(sizeof(Node));
  *subj = node_new(NodeKind.Expression(call_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Expression(dot));

  Node* ret_r = malloc(sizeof(Node));
  *ret_r = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_r);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;
  br.bindings.push("r");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(n).is_none(), "expected the fit-over-a-method-call to emit";
  assert equals(
    st.out.build(),
    `__auto_type __fit_subj1 = Holder__get_opt(&h);
    `if (__fit_subj1.tag == Opt_Some) {
    `    __auto_type r = __fit_subj1.payload.Some._0;
    `    return;
    `}
    ``
  ), "expected the call hoisted into a temp var first, then the tag check/binding against IT, not the call re-evaluated per branch";
}

test "emit_statement emits a fit over a method-call subject with a CHAINED field-access receiver" {
  // Regression test: `fit self.state.token_peek_prev_n(1) { ... }` --
  // `Parser.parse_single_token_to_node`'s own real body, found via the
  // self-compile experiment -- rejected outright since the receiver
  // (`self.state`) is itself a chained field access, not a bare local;
  // the method-call-subject branch previously required `recv_e.left` to
  // be a plain `.Identifier`. Fixed by resolving the receiver via
  // `resolve_field_chain` (any depth) instead, the same lookup
  // `emit_method_call`/`infer_let_expr_type` already use.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "Parser", true);

  Vec<str> parser_fields;
  parser_fields.init(0);
  parser_fields.push("state");
  Vec<str> parser_field_types;
  parser_field_types.init(0);
  parser_field_types.push("ParseState");
  Vec<bin> parser_field_ptrs;
  parser_field_ptrs.init(0);
  parser_field_ptrs.push(true);
  g.record_compound("Parser", parser_fields, parser_field_types, parser_field_ptrs);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Opt", variants, true);

  DataType* opt_rtype = malloc(sizeof(DataType));
  *opt_rtype = dtype_new();
  opt_rtype.type_str = "Opt";
  Vec<DataType*> token_peek_prev_n_param_types;
  token_peek_prev_n_param_types.init(0);
  Vec<Node*> token_peek_prev_n_default_values;
  token_peek_prev_n_default_values.init(0);
  g.record_impl_method(
    "ParseState",
    "token_peek_prev_n",
    "ParseState__token_peek_prev_n",
    opt_rtype,
    token_peek_prev_n_param_types,
    token_peek_prev_n_default_values
  );

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(NodeKind.Identifier("self"));
  Node* state_ident = malloc(sizeof(Node));
  *state_ident = node_new(NodeKind.Identifier("state"));
  ExprNode field_e;
  field_e.left = self_ident;
  field_e.has_left = true;
  field_e.right = state_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Expression(field_e));

  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("token_peek_prev_n"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* one_arg = malloc(sizeof(Node));
  *one_arg = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(one_arg));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* subj = malloc(sizeof(Node));
  *subj = node_new(NodeKind.Expression(call_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("None"));
  ExprNode dot;
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Expression(dot));

  Node* ret_r = malloc(sizeof(Node));
  *ret_r = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_r);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br);

  Node n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(n).is_none(), "expected the fit over a chained-receiver method call to emit";
  assert equals(
    st.out.build(),
    `__auto_type __fit_subj1 = ParseState__token_peek_prev_n(self->state, 1);
    `if (__fit_subj1.tag == Opt_None) {
    `    return;
    `}
    ``
  ), "expected 'self->state' resolved as the call's receiver via resolve_field_chain, hoisted into a temp var";
}

