  inner_dot.left = rect_ident;
  inner_dot.has_left = true;
  inner_dot.right = a_ident;
  inner_dot.has_right = true;
  inner_dot.op = ".";
  Node* inner = malloc(sizeof(Node));
  *inner = node_new(NodeKind.Expression(inner_dot));

  Node* x_ident = malloc(sizeof(Node));
