test "emit_statement accepts a Vec iterator for over a REAL (mangled) generic Vec instantiation, not just the bare 'Vec' stand-in" {
  // Regression test: a REAL `Vec<str> local;` declaration (found via the
  // self-compile experiment, `parse_type_params_with_constraints`'s own
  // real body) records its local under `write_type`'s own RESOLVED
  // (mangled) name -- "Vec__str" -- never the bare "Vec" every OTHER
  // test in this file hand-records via `record_local` directly.
  // `emit_for_iter`'s own "is this a Vec?" check required an EXACT match
  // against "Vec", rejecting every real declaration outright -- an
  // apparently never-before-exercised combination (a real `Vec<T>` local
  // fed into a `for x : local` loop) until the self-compile experiment.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("items", "Vec__str", false);

  Node* iterable = malloc(sizeof(Node));
  *iterable = node_new(NodeKind.Identifier("items"));
  BodyNode bn;
  bn.statements.init(0);
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  ForIterNode fi;
  fi.index_name = "";
  fi.has_index_name = false;
  fi.item_name = "item";
  fi.iterable = iterable;
  fi.body = body;
  Node n = node_new(NodeKind.StatementFor(ForKind.Iter(fi)));

  assert g.emit_statement(n).is_none(), "expected the Vec__str iterator for to emit";
  assert equals(
    st.out.build(),
    `for (int64_t __fun_i = 0; __fun_i < items.len; __fun_i++) {
    `    __auto_type item = items.data[__fun_i];
    `}
    ``
  ), "expected the same .len/.data fast path as the bare 'Vec' stand-in";
}

test "emit_statement records a Vec iterator's own item as a known local, so a NESTED iterator over it resolves" {
  // Regression test: `parse_type_params_with_constraints`'s own real
  // cross-product-building body (`for existing : combos { for et :
  // existing { ... } }`, `combos: Vec<Vec<str>>`) -- found via the
  // self-compile experiment. The OUTER loop's own item ("existing") was
  // never recorded as a known local at all (deliberately, per this
  // function's own doc comment -- `__auto_type` means its Fun type is
  // usually unknowable), so the INNER loop over it rejected it outright.
  // Fixed via `Codegen.local_dtype`: `combos`'s own FULL `DataType`
  // (`Vec<Vec<str>>`, recorded via `record_local_typed` the same way a
  // REAL `Variable` declaration/parameter now does) lets `emit_for_iter`
  // read the element type (`Vec<str>`) directly off `generic_args`,
  // rather than reverse-engineering it out of a mangled name string.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode vecc = compound_node_new();
  vecc.name = "Vec";
  vecc.type_params.push("T");
  vecc.has_type_params = true;
  CompoundField vecf;
  vecf.name = "len";
  DataType* vecfdt = malloc(sizeof(DataType));
  *vecfdt = dtype_new();
  vecfdt.type_str = "num";
  vecf.dtype = vecfdt;
  vecc.fields.push(vecf);
  Node vec_tmpl_node = node_new(NodeKind.Compound(vecc));
  g.emit_compound(vec_tmpl_node);

  DataType* inner_str_arg = malloc(sizeof(DataType));
  *inner_str_arg = dtype_new();
  inner_str_arg.type_str = "str";
  DataType* inner_vec = malloc(sizeof(DataType));
  *inner_vec = dtype_new();
  inner_vec.type_str = "Vec";
  inner_vec.generic_args.push(inner_str_arg);
  DataType outer_vec = dtype_new();
  outer_vec.type_str = "Vec";
  outer_vec.generic_args.push(inner_vec);
  g.record_local_typed("combos", "Vec__Vec__str", false, outer_vec);

  // Pre-warm Vec<str>'s own monomorphization (into a throwaway scratch
  // buffer) so the assertion below can match the for-loop's exact text
  // without also accounting for the one-time "typedef struct Vec__str
  // {...}" emission emit_for_iter's own element-type resolution below
  // would otherwise trigger inline.
  CodegenState warm_st = codegen_state_new();
  CodegenState* real_state = g.state;
  g.state = &warm_st;
  g.resolve_type_name(*inner_vec);
  g.state = real_state;

  Node* outer_iterable = malloc(sizeof(Node));
  *outer_iterable = node_new(NodeKind.Identifier("combos"));

  Node* inner_iterable = malloc(sizeof(Node));
  *inner_iterable = node_new(NodeKind.Identifier("existing"));
  BodyNode inner_bn;
  inner_bn.statements.init(0);
  Node* inner_body = malloc(sizeof(Node));
  *inner_body = node_new(NodeKind.Body(inner_bn));
  ForIterNode inner_fi;
  inner_fi.index_name = "";
  inner_fi.has_index_name = false;
  inner_fi.item_name = "et";
  inner_fi.iterable = inner_iterable;
  inner_fi.body = inner_body;
  Node* inner_for = malloc(sizeof(Node));
  *inner_for = node_new(NodeKind.StatementFor(ForKind.Iter(inner_fi)));
  Vec<Node*> outer_stmts;
  outer_stmts.init(0);
  outer_stmts.push(inner_for);
  BodyNode outer_bn;
  outer_bn.statements = outer_stmts;
  Node* outer_body = malloc(sizeof(Node));
  *outer_body = node_new(NodeKind.Body(outer_bn));

  ForIterNode outer_fi;
  outer_fi.index_name = "";
  outer_fi.has_index_name = false;
  outer_fi.item_name = "existing";
  outer_fi.iterable = outer_iterable;
  outer_fi.body = outer_body;
  Node n = node_new(NodeKind.StatementFor(ForKind.Iter(outer_fi)));

  assert g.emit_statement(n).is_none(), "expected the nested Vec iterator for to emit, with 'existing' resolved as a known Vec__str local";
  assert equals(
    st.out.build(),
    `for (int64_t __fun_i = 0; __fun_i < combos.len; __fun_i++) {
    `    __auto_type existing = combos.data[__fun_i];
    `    for (int64_t __fun_i = 0; __fun_i < existing.len; __fun_i++) {
    `        __auto_type et = existing.data[__fun_i];
    `    }
    `}
    ``
  ), "expected the inner loop over 'existing' to emit via the same .len/.data fast path";
}

test "emit_statement rejects an iterator for over a receiver that isn't a known Vec local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* iterable = malloc(sizeof(Node));
  *iterable = node_new(NodeKind.Identifier("items"));
  BodyNode bn;
  bn.statements.init(0);
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  ForIterNode fi;
  fi.index_name = "";
  fi.has_index_name = false;
  fi.item_name = "item";
  fi.iterable = iterable;
  fi.body = body;
  Node n = node_new(NodeKind.StatementFor(ForKind.Iter(fi)));

  assert g.emit_statement(n).is_some(), "expected an unrecognized iterable to be rejected rather than guessed";
}

test "emit_statement emits a fit over a num subject with a comma-chained pattern and a default arm" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* subj = malloc(sizeof(Node));
  *subj = node_new(NodeKind.Identifier("x"));

  Node* lbl1 = malloc(sizeof(Node));
  *lbl1 = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* lbl2 = malloc(sizeof(Node));
  *lbl2 = node_new(NodeKind.Number(TokenData.Num(2)));
  ExprNode comma;
  comma.left = lbl1;
  comma.has_left = true;
  comma.right = lbl2;
  comma.has_right = true;
  comma.op = ",";
  Node* comma_node = malloc(sizeof(Node));
  *comma_node = node_new(NodeKind.Expression(comma));

  Node* ret_a = malloc(sizeof(Node));
  *ret_a = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> a_stmts;
  a_stmts.init(0);
  a_stmts.push(ret_a);
  BodyNode a_bn;
  a_bn.statements = a_stmts;
  Node* a_body = malloc(sizeof(Node));
  *a_body = node_new(NodeKind.Body(a_bn));

  FitBranch br_a = fit_branch_new();
  br_a.condition = comma_node;
  br_a.has_condition = true;
  br_a.body = a_body;

  Node* val9 = malloc(sizeof(Node));
  *val9 = node_new(NodeKind.Number(TokenData.Num(9)));
  Node* ret_default = malloc(sizeof(Node));
  *ret_default = node_new(NodeKind.StatementReturn(val9));
  Vec<Node*> d_stmts;
  d_stmts.init(0);
  d_stmts.push(ret_default);
  BodyNode d_bn;
  d_bn.statements = d_stmts;
  Node* d_body = malloc(sizeof(Node));
  *d_body = node_new(NodeKind.Body(d_bn));

  FitBranch br_default = fit_branch_new();
  br_default.body = d_body;

  FitStmtNode f = fit_stmt_node_new();
  f.exp = subj;
  f.branches.push(br_a);
  f.branches.push(br_default);
  f.has_default_branch = true;

  Node n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(n).is_none(), "expected the fit statement to emit";
  assert equals(
    st.out.build(),
    `if (x == 1 || x == 2) {
    `    return;
    `} else {
    `    return 9;
    `}
    ``
  ), "expected an if/else chain with an OR-ed comma pattern";
}

test "emit_statement emits a fit over a str subject using strcmp" {
