test "emit_impl emits each method as a mangled top-level C function, with self recorded as a pointer local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Point";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(NodeKind.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("x"));
  ExprNode field_e;
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  fnv.name = "Point__get_x";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.methods.push(method_node);

  Node impl_node = node_new(NodeKind.Impl(impln));
  assert g.emit_impl(impl_node).is_none(), "expected the impl to emit";
  assert equals(st.out.build(), "int64_t Point__get_x(Point* self) {\n    return self->x;\n}\n"), "expected the method emitted as a plain C function reading 'self->x'";
}

test "emit_impl emits a quirk-implementing impl's method under its already-double-mangled name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Point";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(val));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  // Double-mangled, exactly as `_parse_impl_method` names a quirk-impl's
  // method (`Type__Quirk__method`) -- codegen must reproduce this
  // verbatim, not invent its own scheme.
  fnv.name = "Point__To__convert";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.quirk_name = "To";
  impln.has_quirk_name = true;
  impln.methods.push(method_node);

  Node impl_node = node_new(NodeKind.Impl(impln));
  assert g.emit_impl(impl_node).is_none(), "expected the quirk-implementing impl's method to emit";
  assert equals(st.out.build(), "int64_t Point__To__convert(Point* self) {\n    return 0;\n}\n"), "expected the method emitted under its own already-mangled name, unmodified";
}

test "register_impl_methods lets emit_method_call resolve a quirk-implementing impl's double-mangled name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("p", "Point", false);

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Point";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  FunctionNode fnv = function_node_new();
  fnv.name = "Point__To__convert";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.quirk_name = "To";
  impln.has_quirk_name = true;
  impln.methods.push(method_node);
  Node impl_node = node_new(NodeKind.Impl(impln));

  // Registration only (no emission) -- mirrors `transpile`'s own
  // dedicated pre-pass, run before any method body/call is emitted.
  g.register_impl_methods(impl_node);

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("p"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("convert"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected the method call to emit";
  assert equals(st.out.build(), "Point__To__convert(&p)"), "expected the double-mangled quirk name, not the naive 'Point__convert'";
}

test "emit_compound records a generic compound as a template without emitting it" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;
  CompoundField f;
  f.name = "value";
  DataType* fdt = malloc(sizeof(DataType));
  *fdt = dtype_new();
  fdt.type_str = "T";
  f.dtype = fdt;
  c.fields.push(f);

  Node n = node_new(NodeKind.Compound(c));
  assert g.emit_compound(n).is_none(), "expected the generic template to record without error";
  assert equals(st.out.build(), ""), "expected nothing emitted for a generic template itself, only its monomorphizations";
}

// Shared setup for the generic-compound-instantiation tests below: records
// `compound Box<T> { T value; }` as a template (no C emitted for the
// template itself -- see the test above).
fun _record_box_template(Codegen* g) {
  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;
  CompoundField f;
  f.name = "value";
  DataType* fdt = malloc(sizeof(DataType));
  *fdt = dtype_new();
  fdt.type_str = "T";
  f.dtype = fdt;
  c.fields.push(f);
  Node n = node_new(NodeKind.Compound(c));
  g.emit_compound(n);
}

// A `Box<num> name;` Variable declaration node.
fun _box_num_var_decl(str name) Node {
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* box_dt = malloc(sizeof(DataType));
  *box_dt = dtype_new();
  box_dt.type_str = "Box";
  box_dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = box_dt;
  v.name = name;
  v.has_val = false;
  ret node_new(NodeKind.Variable(v));
}

// Records a generic tagged-union enum template equivalent to
// `enum Opt<T> { Some(T), None }`, for the monomorphization tests below.
fun _record_opt_template(Codegen* g) {
  EnumDeclNode e = enum_decl_node_new();
  e.name = "Opt";
  e.type_params.push("T");
  e.has_type_params = true;

  EnumVariant some_v = enum_variant_new();
  some_v.name = "Some";
  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "T";
  some_v.payload.push(pdt);
  some_v.has_payload = true;
  e.variants.push(some_v);

  EnumVariant none_v = enum_variant_new();
  none_v.name = "None";
  e.variants.push(none_v);

  Node n = node_new(NodeKind.Enum(e));
  g.emit_enum(n);
}

// An `Opt<num> name;` Variable declaration node.
fun _opt_num_var_decl(str name) Node {
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* opt_dt = malloc(sizeof(DataType));
  *opt_dt = dtype_new();
  opt_dt.type_str = "Opt";
  opt_dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = opt_dt;
  v.name = name;
  v.has_val = false;
  ret node_new(NodeKind.Variable(v));
}

test "emit_statement instantiates a generic compound's monomorphized struct on first use" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  Node n = _box_num_var_decl("b");
  assert g.emit_statement(n).is_none(), "expected the Box<num> declaration to emit";
  assert equals(
    st.out.build(),
    "typedef struct Box__num {\n  int64_t value;\n} Box__num;\n\nBox__num b;\n"
  ), "expected the monomorphized struct emitted once, then the declaration using its mangled name";
}

test "emit_statement does not re-emit an already-instantiated generic compound" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  Node n1 = _box_num_var_decl("b1");
  Node n2 = _box_num_var_decl("b2");
  assert g.emit_statement(n1).is_none(), "expected the first Box<num> declaration to emit";
  assert g.emit_statement(n2).is_none(), "expected the second Box<num> declaration to emit";
  assert equals(
    st.out.build(),
    "typedef struct Box__num {\n  int64_t value;\n} Box__num;\n\nBox__num b1;\nBox__num b2;\n"
  ), "expected the struct typedef only once, even though Box<num> is used twice";
}

test "emit_expr resolves chained field access through a generic-compound-instantiated local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  Node decl = _box_num_var_decl("b");
  assert g.emit_statement(decl).is_none(), "expected the Box<num> declaration to emit";

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("b"));
  Node* field = malloc(sizeof(Node));
  *field = node_new(NodeKind.Identifier("value"));
  ExprNode e;
  e.left = recv;
  e.has_left = true;
  e.right = field;
  e.has_right = true;
  e.op = ".";
  Node access = node_new(NodeKind.Expression(e));

  assert g.emit_expr(access).is_none(), "expected 'b.value' to resolve through the monomorphized Box__num's own registered field";
  assert equals(
    st.out.build(),
    "typedef struct Box__num {\n  int64_t value;\n} Box__num;\n\nBox__num b;\nb.value"
  ), "expected the field access appended after the declaration, resolved via the mangled compound's registry";
}

test "emit_expr resolves a chained field access through a CALL receiver, with no intermediate 'let'" {
  // Regression test: `ParseState.check`'s own real shape (`tok.unwrap().
  // type`, `ParseState.parse_type_params_with_constraints`'s own real
  // body -- found via the self-compile experiment) -- a field access
  // whose RECEIVER is itself a call (a plain function OR a method call),
  // not a known local. `resolve_field_chain` previously only handled a
  // plain identifier or a nested `.`-Expression receiver; a call receiver
  // rejected outright since there was no case for it at all. Fixed by
  // resolving the call's own declared return type (the same
  // lookup_function_rtype/lookup_impl_method_rtype lookups
  // `infer_let_expr_type`'s identical "()" case already uses), then
  // rendering the call's OWN text into a throwaway scratch buffer (a
  // field-chain link otherwise has no emission logic of its own).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "Token";
  FunctionNode fnv = function_node_new();
  fnv.name = "mk";
  fnv.has_name = true;
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.has_args = false;
  Node fn_node = node_new(NodeKind.Function(fnv));
  Vec<Node> sig_nodes;
  sig_nodes.init(0);
  sig_nodes.push(fn_node);
  g.register_function_signatures(sig_nodes);

  Vec<str> tok_fields;
  tok_fields.init(0);
  tok_fields.push("type");
  Vec<str> tok_field_types;
  tok_field_types.init(0);
  tok_field_types.push("TokenType");
  Vec<bin> tok_field_ptrs;
  tok_field_ptrs.init(0);
  tok_field_ptrs.push(false);
  g.record_compound("Token", tok_fields, tok_field_types, tok_field_ptrs);

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("mk"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));

  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("type"));
  ExprNode field_e;
  field_e.left = call_node;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node access = node_new(NodeKind.Expression(field_e));

  assert g.emit_expr(access).is_none(), "expected 'mk().type' to resolve";
  assert equals(st.out.build(), "mk().type"), "expected the call rendered inline, then '.type' appended";
}

// Registers a generic impl equivalent to `impl Box<T> { pub get() T { ret
// self.value; } }` (matching `_record_box_template`'s own `Box<T> { T value;
// }` compound) as a template, via `register_impl_methods` -- no C emitted
// yet, same as the compound/enum template-recording helpers above.
fun _record_box_get_impl(Codegen* g) {
  DataType* t_arg = malloc(sizeof(DataType));
  *t_arg = dtype_new();
  t_arg.type_str = "T";
  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Box";
  self_dt.pointer_depth = 1;
  self_dt.generic_args.push(t_arg);
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(NodeKind.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("value"));
  ExprNode field_e;
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  fnv.name = "Box__get";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "T";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Box";
  impln.type_params.push("T");
  impln.has_type_params = true;
  impln.methods.push(method_node);

  Node impl_node = node_new(NodeKind.Impl(impln));
  g.register_impl_methods(impl_node);
}

test "emit_statement instantiates a generic impl's monomorphized method the first time its compound is used" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);
  _record_box_get_impl(&g);

  Node n = _box_num_var_decl("b");
  assert g.emit_statement(n).is_none(), "expected the Box<num> declaration to emit";
  assert equals(
    st.out.build(),
    "typedef struct Box__num {\n  int64_t value;\n} Box__num;\n\nint64_t Box__num__get(Box__num* self);\nint64_t Box__num__get(Box__num* self) {\n    return self->value;\n}\nBox__num b;\n"
  ), "expected the struct, a forward declaration, AND its generic impl's method (self/return type substituted T -> num) emitted once, before the declaration";
}

test "emit_statement does not re-emit a generic impl's monomorphized method on a second use" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);
  _record_box_get_impl(&g);

  Node n1 = _box_num_var_decl("b1");
  Node n2 = _box_num_var_decl("b2");
  assert g.emit_statement(n1).is_none(), "expected the first Box<num> declaration to emit";
  assert g.emit_statement(n2).is_none(), "expected the second Box<num> declaration to emit";
  assert equals(
    st.out.build(),
    "typedef struct Box__num {\n  int64_t value;\n} Box__num;\n\nint64_t Box__num__get(Box__num* self);\nint64_t Box__num__get(Box__num* self) {\n    return self->value;\n}\nBox__num b1;\nBox__num b2;\n"
  ), "expected the struct and the method (plus its forward declaration) emitted only once, even though Box<num> is used twice";
}

test "emit_expr calls a generic impl's monomorphized method through a value-typed instance" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);
  _record_box_get_impl(&g);

  Node decl = _box_num_var_decl("b");
  assert g.emit_statement(decl).is_none(), "expected the Box<num> declaration to emit";

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("b"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("get"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected 'b.get()' to resolve to the monomorphized method";
  assert equals(
    st.out.build(),
    "typedef struct Box__num {\n  int64_t value;\n} Box__num;\n\nint64_t Box__num__get(Box__num* self);\nint64_t Box__num__get(Box__num* self) {\n    return self->value;\n}\nBox__num b;\nBox__num__get(&b)"
  ), "expected 'Box__num__get(&b)', resolved via the same lookup_impl_method path a non-generic impl uses";
}

test "pub transpile monomorphizes a generic impl's methods even when a PLAIN compound's OWN field is the first trigger" {
  // Regression test: `compound Lexer { Vec<Token> tokens; }` (the real
  // self-hosted lexer's own shape, found via the self-compile
  // experiment) never got Vec<T>'s own impl methods monomorphized at
  // all -- pub transpile's enum/compound pass ran BEFORE its
  // register_impl_methods pass, so `generic_impl_templates` was still
  // EMPTY at the moment Lexer's own field triggered
  // ensure_compound_instantiated for Vec<Token>, and
  // maybe_instantiate_generic_impl_methods silently found no template
  // to monomorphize (not an error -- a compound needn't have one).
  // Fixed by moving the impl-registration pass to run FIRST.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode vecc = compound_node_new();
  vecc.name = "Vec";
  vecc.type_params.push("T");
  vecc.has_type_params = true;
  CompoundField vecf;
  vecf.name = "len";
  DataType* vecfdt = malloc(sizeof(DataType));
  *vecfdt = dtype_new();
  vecfdt.type_str = "T";
  vecf.dtype = vecfdt;
  vecc.fields.push(vecf);
  Node vec_node = node_new(NodeKind.Compound(vecc));

  DataType* selfdt = malloc(sizeof(DataType));
  *selfdt = dtype_new();
  selfdt.type_str = "Vec";
  selfdt.pointer_depth = 1;
  DataType* t_arg = malloc(sizeof(DataType));
  *t_arg = dtype_new();
  t_arg.type_str = "T";
  selfdt.generic_args.push(t_arg);
  VariableNode selfv;
  selfv.var_type = selfdt;
  selfv.name = "self";
  selfv.has_val = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(NodeKind.Identifier("self"));
  Node* len_ident = malloc(sizeof(Node));
  *len_ident = node_new(NodeKind.Identifier("len"));
  ExprNode field_e;
  field_e.left = self_ident;
  field_e.has_left = true;
  field_e.right = len_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> mstmts;
  mstmts.init(0);
  mstmts.push(ret_stmt);
  BodyNode mbn;
  mbn.statements = mstmts;
  Node* mbody = malloc(sizeof(Node));
  *mbody = node_new(NodeKind.Body(mbn));

  FunctionNode lastfn = function_node_new();
  lastfn.name = "Vec__last";
  lastfn.has_name = true;
  DataType* lastrt = malloc(sizeof(DataType));
  *lastrt = dtype_new();
  lastrt.type_str = "T";
  lastfn.rtype = lastrt;
  lastfn.has_rtype = true;
  lastfn.args = margs;
  lastfn.has_args = true;
  lastfn.body = mbody;
  lastfn.has_body = true;
  Node* last_method_node = malloc(sizeof(Node));
  *last_method_node = node_new(NodeKind.Function(lastfn));

  ImplNode vecimpl = impl_node_new();
  vecimpl.type_name = "Vec";
  vecimpl.type_params.push("T");
  vecimpl.has_type_params = true;
  vecimpl.methods.push(last_method_node);
  Node vec_impl_node = node_new(NodeKind.Impl(vecimpl));

  CompoundNode lexerc = compound_node_new();
  lexerc.name = "Lexer";
  CompoundField tokensf;
  tokensf.name = "tokens";
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* tokensdt = malloc(sizeof(DataType));
  *tokensdt = dtype_new();
  tokensdt.type_str = "Vec";
  tokensdt.generic_args.push(num_arg);
  tokensf.dtype = tokensdt;
  lexerc.fields.push(tokensf);
  Node lexer_node = node_new(NodeKind.Compound(lexerc));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(vec_node);
  nodes.push(vec_impl_node);
  nodes.push(lexer_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert contains(st.out.build(), "int64_t Vec__num__last(Vec__num* self)"), "expected Vec<T>'s own impl method monomorphized from Lexer's field alone, not silently skipped";
}

test "pub transpile hoists a generic compound's monomorphized typedef BEFORE another compound whose OWN field first triggers it" {
  // Regression test: `StringBuilder { Vec<str> parts; ... }` (the real
  // stdlib's own shape, found via the self-compile experiment) used to
  // emit `Vec__str`'s struct typedef NESTED INSIDE StringBuilder's own
  // `typedef struct StringBuilder { ... }` field list -- valid-looking
  // but actually illegal C (a typedef can't be declared in the middle of
  // another struct's member list). `pub transpile`'s enum/compound
  // passes didn't set `hoist_insert_pos` at all (only the impl/function
  // passes did, from the EARLIER function-nested-inside-a-function fix)
  // -- this covers the exact same hoisting mechanism for the compound
  // pass too.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode boxc = compound_node_new();
  boxc.name = "Box";
  boxc.type_params.push("T");
  boxc.has_type_params = true;
  CompoundField boxf;
  boxf.name = "value";
  DataType* boxfdt = malloc(sizeof(DataType));
  *boxfdt = dtype_new();
  boxfdt.type_str = "T";
  boxf.dtype = boxfdt;
  boxc.fields.push(boxf);
  Node box_node = node_new(NodeKind.Compound(boxc));

  CompoundNode outerc = compound_node_new();
  outerc.name = "Outer";
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_dt = malloc(sizeof(DataType));
  *inner_dt = dtype_new();
  inner_dt.type_str = "Box";
  inner_dt.generic_args.push(num_arg);
  CompoundField innerf;
  innerf.name = "inner";
  innerf.dtype = inner_dt;
  outerc.fields.push(innerf);
  Node outer_node = node_new(NodeKind.Compound(outerc));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(box_node);
  nodes.push(outer_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert equals(
    st.out.build(),
    "#include <stdio.h>\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdarg.h>\n#include <stdlib.h>\n#include <string.h>\nstatic FILE* stderr_stream(void){ return stderr; }\n#ifdef _WIN32\n#include <windows.h>\ntypedef HANDLE __fun_thread_t;\ntypedef void* (*__fun_thread_entry_t)(void*);\ntypedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;\nstatic DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }\nstatic int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 0, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }\nstatic int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }\n#else\n#include <pthread.h>\ntypedef pthread_t __fun_thread_t;\ntypedef void* (*__fun_thread_entry_t)(void*);\nstatic int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { return pthread_create(t, NULL, entry, arg); }\nstatic int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }\n#endif\ntypedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;\nstatic __fun_wd_state __fun_g_wd;\nvoid __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){\n  fprintf(stderr, \"fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\\n\", blocked_or_count, pending_or_cap, stall_ms);\n}\nstatic void* __fun_wd_thread(void* unused){ (void)unused;\n  long long last_seq=-1; long long stall_ms=0;\n  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;\n  for(;;){\n#ifdef _WIN32\n    Sleep((DWORD)step);\n#else\n    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);\n#endif\n    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;\n    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }\n    last_seq=seq;\n    if(stall_ms>=__fun_g_wd.threshold_ms){\n      __fun_wd_warn((long long)blk, 0, stall_ms);\n      if(__fun_g_wd.abort_on_fire) abort();\n      stall_ms=0;\n    }\n  }\n}\nvoid __fun_wd_enter_wait(void){\n  if(!__fun_g_wd.started){\n    __fun_g_wd.started=1;\n    const char* w=getenv(\"FUN_DEADLOCK_WATCHDOG_MS\");\n    long long wm=(w && w[0])?atoll(w):0;\n    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;\n    const char* a=getenv(\"FUN_DEADLOCK_ABORT\");\n    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;\n    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }\n  }\n  if(!__fun_g_wd.armed) return;\n  __fun_g_wd.blocked++;\n}\nvoid __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }\ntypedef struct Box__num {\n  int64_t value;\n} Box__num;\n\ntypedef struct Outer {\n  Box__num inner;\n} Outer;\n\n"
  ), "expected Box__num's typedef BEFORE Outer's, not nested inside its field list";
}

test "pub transpile hoists a generic impl method's monomorphized definition BEFORE the function that first triggers it, not nested inside it" {
  // Regression test for a real bug found via end-to-end verification (self-
  // hosted lexer -> parser -> this codegen, then the resulting C actually
  // compiled with a system C compiler): `Box<num>` used for the FIRST time
  // INSIDE `main`'s own body -- the common case, not an edge case -- used
  // to emit `Box__num`'s struct typedef AND `Box__num__get`'s C function
  // DEFINITION nested inside `main`'s `{ }`. A nested typedef is valid (if
  // oddly-scoped) C, but a nested FUNCTION DEFINITION is a hard C syntax
  // error clang actually rejects ("function definition is not allowed
  // here"). See `Codegen.hoist_insert_pos`/`emit_hoisted`'s doc comments
  // for the fix: `pub transpile` tracks where `main` itself started, and
  // anything hoisted from inside it is spliced in right before that point
  // instead.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;
  CompoundField f;
  f.name = "value";
  DataType* fdt = malloc(sizeof(DataType));
  *fdt = dtype_new();
  fdt.type_str = "T";
  f.dtype = fdt;
  c.fields.push(f);
  Node compound_node = node_new(NodeKind.Compound(c));

  DataType* t_arg = malloc(sizeof(DataType));
  *t_arg = dtype_new();
  t_arg.type_str = "T";
  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Box";
  self_dt.pointer_depth = 1;
  self_dt.generic_args.push(t_arg);
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(NodeKind.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("value"));
  ExprNode field_e;
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* method_ret_stmt = malloc(sizeof(Node));
  *method_ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> method_stmts;
  method_stmts.init(0);
  method_stmts.push(method_ret_stmt);
  BodyNode method_bn;
  method_bn.statements = method_stmts;
  Node* method_body = malloc(sizeof(Node));
  *method_body = node_new(NodeKind.Body(method_bn));

  FunctionNode getfn = function_node_new();
  getfn.name = "Box__get";
  getfn.has_name = true;
  DataType* get_rtype = malloc(sizeof(DataType));
  *get_rtype = dtype_new();
  get_rtype.type_str = "T";
  getfn.rtype = get_rtype;
  getfn.has_rtype = true;
  getfn.args = margs;
  getfn.has_args = true;
  getfn.body = method_body;
  getfn.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(getfn));

  ImplNode implb = impl_node_new();
  implb.type_name = "Box";
  implb.type_params.push("T");
  implb.has_type_params = true;
  implb.methods.push(method_node);
  Node impl_node = node_new(NodeKind.Impl(implb));

  Node main_decl = _box_num_var_decl("b");
  Node* main_decl_ptr = malloc(sizeof(Node));
  *main_decl_ptr = main_decl;
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(main_decl_ptr);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(NodeKind.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "num";
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(NodeKind.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(compound_node);
  nodes.push(impl_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert equals(
    st.out.build(),
    "#include <stdio.h>\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdarg.h>\n#include <stdlib.h>\n#include <string.h>\nstatic FILE* stderr_stream(void){ return stderr; }\n#ifdef _WIN32\n#include <windows.h>\ntypedef HANDLE __fun_thread_t;\ntypedef void* (*__fun_thread_entry_t)(void*);\ntypedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;\nstatic DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }\nstatic int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 0, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }\nstatic int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }\n#else\n#include <pthread.h>\ntypedef pthread_t __fun_thread_t;\ntypedef void* (*__fun_thread_entry_t)(void*);\nstatic int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { return pthread_create(t, NULL, entry, arg); }\nstatic int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }\n#endif\ntypedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;\nstatic __fun_wd_state __fun_g_wd;\nvoid __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){\n  fprintf(stderr, \"fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\\n\", blocked_or_count, pending_or_cap, stall_ms);\n}\nstatic void* __fun_wd_thread(void* unused){ (void)unused;\n  long long last_seq=-1; long long stall_ms=0;\n  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;\n  for(;;){\n#ifdef _WIN32\n    Sleep((DWORD)step);\n#else\n    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);\n#endif\n    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;\n    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }\n    last_seq=seq;\n    if(stall_ms>=__fun_g_wd.threshold_ms){\n      __fun_wd_warn((long long)blk, 0, stall_ms);\n      if(__fun_g_wd.abort_on_fire) abort();\n      stall_ms=0;\n    }\n  }\n}\nvoid __fun_wd_enter_wait(void){\n  if(!__fun_g_wd.started){\n    __fun_g_wd.started=1;\n    const char* w=getenv(\"FUN_DEADLOCK_WATCHDOG_MS\");\n    long long wm=(w && w[0])?atoll(w):0;\n    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;\n    const char* a=getenv(\"FUN_DEADLOCK_ABORT\");\n    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;\n    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }\n  }\n  if(!__fun_g_wd.armed) return;\n  __fun_g_wd.blocked++;\n}\nvoid __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }\ntypedef struct Box__num {\n  int64_t value;\n} Box__num;\n\nint64_t Box__num__get(Box__num* self);\nint64_t Box__num__get(Box__num* self) {\n    return self->value;\n}\nint64_t main(void) {\n    Box__num b;\n}\n"
  ), "expected the struct typedef AND the monomorphized method BEFORE 'main', not nested inside its braces";
}

test "ensure_compound_instantiated rejects an unrecognized generic template name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Unrecognized";
  dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected an unrecognized generic template name to be rejected rather than guessed";
}

test "ensure_compound_instantiated rejects a wrong generic argument count" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* str_arg = malloc(sizeof(DataType));
  *str_arg = dtype_new();
  str_arg.type_str = "str";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(num_arg);
  dt.generic_args.push(str_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Box (one type param) instantiated with two arguments to be rejected";
}

test "ensure_compound_instantiated rejects a nested generic argument whose OWN template isn't registered" {
  // Nested generic arguments themselves DO resolve now (see the
  // "instantiates a nested generic argument" test below) -- this one
  // specifically covers the argument still being rejected when the
  // NESTED type itself is unresolvable (here, "Vec" was never
  // registered as a template at all), same "reject rather than guess"
  // reasoning as an unrecognized template name anywhere else.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_vec = malloc(sizeof(DataType));
  *inner_vec = dtype_new();
  inner_vec.type_str = "Vec";
  inner_vec.generic_args.push(num_arg);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(inner_vec);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Box<Vec<num>> rejected because 'Vec' itself was never registered as a template, not because nesting itself is unsupported";
}

test "ensure_compound_instantiated instantiates a nested generic argument (Box<Box<num>>)" {
  // Regression test for real, previously-rejected code: `Result<Option<
  // Token>, Error>` (Lexer.next's real return type in the self-hosted
  // lexer's own source, found via the self-compile experiment) is a
  // NESTED generic instantiation -- a generic argument that's itself a
  // generic instantiation. Fixed by resolving (and, on first use,
  // emitting) the nested argument FIRST via resolve_type_name, using
  // its own mangled name as the outer instantiation's arg name --
  // recurses to arbitrary depth, not just one level.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_box = malloc(sizeof(DataType));
  *inner_box = dtype_new();
  inner_box.type_str = "Box";
  inner_box.generic_args.push(num_arg);
  DataType* outer_dt = malloc(sizeof(DataType));
  *outer_dt = dtype_new();
  outer_dt.type_str = "Box";
  outer_dt.generic_args.push(inner_box);
  VariableNode v;
  v.var_type = outer_dt;
  v.name = "x";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_none(), "expected Box<Box<num>> to instantiate, resolving the nested Box<num> first";
  let out = st.out.build();
  assert contains(out, "typedef struct Box__num {\n  int64_t value;\n} Box__num;"), "expected the INNER instantiation (Box__num) emitted";
  assert contains(out, "typedef struct Box__Box__num {\n  Box__num value;\n} Box__Box__num;"), "expected the OUTER instantiation (Box__Box__num) using the inner's own mangled name as its field type";
  assert contains(out, "Box__Box__num x;"), "expected the declaration itself to use the outer mangled name";
}

test "ensure_compound_instantiated mangles a pointer-typed generic argument distinctly" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* node_ptr_arg = malloc(sizeof(DataType));
  *node_ptr_arg = dtype_new();
  node_ptr_arg.type_str = "Node";
  node_ptr_arg.pointer_depth = 1;
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(node_ptr_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "b";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_none(), "expected Box<Node*> to instantiate";
  assert equals(
    st.out.build(),
    "typedef struct Box__Node_ptr1 {\n  Node* value;\n} Box__Node_ptr1;\n\nBox__Node_ptr1 b;\n"
  ), "expected the mangled name to include the pointer depth, and the field itself to be a pointer";
}

test "emit_statement instantiates a generic tagged-union enum on first use" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  Node n = _opt_num_var_decl("o");
  assert g.emit_statement(n).is_none(), "expected the Opt<num> declaration to emit";
  assert equals(
    st.out.build(),
    "typedef enum Opt__num_tag {\n  Opt__num_Some,\n  Opt__num_None,\n} Opt__num_tag;\ntypedef struct Opt__num {\n  Opt__num_tag tag;\n  union {\n    struct { int64_t _0; } Some;\n  } payload;\n} Opt__num;\n\nOpt__num o;\n"
  ), "expected the monomorphized tagged-union emitted once, then the declaration using its mangled name";
}

test "emit_statement does not re-emit an already-instantiated generic enum" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  Node n1 = _opt_num_var_decl("o1");
  Node n2 = _opt_num_var_decl("o2");
  assert g.emit_statement(n1).is_none(), "expected the first Opt<num> declaration to emit";
  assert g.emit_statement(n2).is_none(), "expected the second Opt<num> declaration to emit";
  let out = st.out.build();
  assert count(out, "typedef struct Opt__num {") == 1, "expected the tagged-union struct typedef only once, even though Opt<num> is used twice";
}

test "fit destructures a bare-shorthand pattern against a monomorphized generic enum local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  Node decl = _opt_num_var_decl("o");
  assert g.emit_statement(decl).is_none(), "expected the Opt<num> declaration to emit";

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = blank;
  dot.has_left = true;
  dot.right = variant_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Expression(dot));

  Node* ret_r = malloc(sizeof(Node));
  *ret_r = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_r);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = body;
  br.bindings.push("v");
  br.has_bindings = true;

  FitStmtNode f = fit_stmt_node_new();
  Node* o_ident = malloc(sizeof(Node));
  *o_ident = node_new(NodeKind.Identifier("o"));
  f.exp = o_ident;
  f.branches.push(br);

  Node fit_n = node_new(NodeKind.StatementFit(f));
  assert g.emit_statement(fit_n).is_none(), "expected the bare-shorthand destructuring fit to emit against the monomorphized Opt__num local";
  let out = st.out.build();
  assert contains(out, "if (o.tag == Opt__num_Some) {"), "expected the tag check to use the MANGLED enum name, resolved via the local's own registered (mangled) type";
  assert contains(out, "__auto_type v = o.payload.Some._0;"), "expected the payload binding to resolve too";
  assert equals(g.lookup_local_type_name("v").unwrap(), "num"), "expected 'v' registered as a known local (type 'num', Opt<num>'s own payload type) so further access on it inside the branch -- a chained field access, another fit, a method call -- still resolves, not just usable as a bare value";
}

