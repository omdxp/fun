test "emit_impl emits each method as a mangled top-level C function, with self recorded as a pointer local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Point";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(NodeKind.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("x"));
  ExprNode field_e;
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  fnv.name = "Point__get_x";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.methods.push(method_node);

  Node impl_node = node_new(NodeKind.Impl(impln));
  assert g.emit_impl(impl_node).is_none(), "expected the impl to emit";
  assert equals(
    st.out.build(),
    `int64_t Point__get_x(Point* self) {
    `    return self->x;
    `}
    ``
  ), "expected the method emitted as a plain C function reading 'self->x'";
}

test "emit_impl emits a quirk-implementing impl's method under its already-double-mangled name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Point";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(val));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  // Double-mangled, exactly as `_parse_impl_method` names a quirk-impl's
  // method (`Type__Quirk__method`) -- codegen must reproduce this
  // verbatim, not invent its own scheme.
  fnv.name = "Point__To__convert";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.quirk_name = "To";
  impln.has_quirk_name = true;
  impln.methods.push(method_node);

  Node impl_node = node_new(NodeKind.Impl(impln));
  assert g.emit_impl(impl_node).is_none(), "expected the quirk-implementing impl's method to emit";
  assert equals(
    st.out.build(),
    `int64_t Point__To__convert(Point* self) {
    `    return 0;
    `}
    ``
  ), "expected the method emitted under its own already-mangled name, unmodified";
}

test "register_impl_methods lets emit_method_call resolve a quirk-implementing impl's double-mangled name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("p", "Point", false);

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Point";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  FunctionNode fnv = function_node_new();
  fnv.name = "Point__To__convert";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Point";
  impln.quirk_name = "To";
  impln.has_quirk_name = true;
  impln.methods.push(method_node);
  Node impl_node = node_new(NodeKind.Impl(impln));

  // Registration only (no emission) -- mirrors `transpile`'s own
  // dedicated pre-pass, run before any method body/call is emitted.
  g.register_impl_methods(impl_node);

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("p"));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("convert"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node n = node_new(NodeKind.Expression(call_e));

  assert g.emit_expr(n).is_none(), "expected the method call to emit";
  assert equals(st.out.build(), "Point__To__convert(&p)"), "expected the double-mangled quirk name, not the naive 'Point__convert'";
}

test "emit_compound records a generic compound as a template without emitting it" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;
  CompoundField f;
  f.name = "value";
  DataType* fdt = malloc(sizeof(DataType));
  *fdt = dtype_new();
  fdt.type_str = "T";
  f.dtype = fdt;
  c.fields.push(f);

  Node n = node_new(NodeKind.Compound(c));
  assert g.emit_compound(n).is_none(), "expected the generic template to record without error";
  assert equals(st.out.build(), ""), "expected nothing emitted for a generic template itself, only its monomorphizations";
}

// Shared setup for the generic-compound-instantiation tests below: records
// `compound Box<T> { T value; }` as a template (no C emitted for the
// template itself -- see the test above).
fun _record_box_template(Codegen* g) {
  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;
  CompoundField f;
  f.name = "value";
  DataType* fdt = malloc(sizeof(DataType));
  *fdt = dtype_new();
  fdt.type_str = "T";
  f.dtype = fdt;
  c.fields.push(f);
  Node n = node_new(NodeKind.Compound(c));
  g.emit_compound(n);
}

// A `Box<num> name;` Variable declaration node.
fun _box_num_var_decl(str name) Node {
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* box_dt = malloc(sizeof(DataType));
  *box_dt = dtype_new();
  box_dt.type_str = "Box";
  box_dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = box_dt;
  v.name = name;
  v.has_val = false;
  v.is_const = false;
  ret node_new(NodeKind.Variable(v));
}

// Records a generic tagged-union enum template equivalent to
// `enum Opt<T> { Some(T), None }`, for the monomorphization tests below.
fun _record_opt_template(Codegen* g) {
  EnumDeclNode e = enum_decl_node_new();
  e.name = "Opt";
  e.type_params.push("T");
  e.has_type_params = true;

  EnumVariant some_v = enum_variant_new();
  some_v.name = "Some";
  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "T";
  some_v.payload.push(pdt);
  some_v.has_payload = true;
  e.variants.push(some_v);

  EnumVariant none_v = enum_variant_new();
  none_v.name = "None";
  e.variants.push(none_v);

  Node n = node_new(NodeKind.Enum(e));
  g.emit_enum(n);
}

// An `Opt<num> name;` Variable declaration node.
fun _opt_num_var_decl(str name) Node {
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* opt_dt = malloc(sizeof(DataType));
  *opt_dt = dtype_new();
  opt_dt.type_str = "Opt";
  opt_dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = opt_dt;
  v.name = name;
  v.has_val = false;
  v.is_const = false;
  ret node_new(NodeKind.Variable(v));
}

test "emit_statement instantiates a generic compound's monomorphized struct on first use" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  Node n = _box_num_var_decl("b");
  assert g.emit_statement(n).is_none(), "expected the Box<num> declaration to emit";
  assert equals(
    st.out.build(),
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `Box__num b;
    ``
  ), "expected the monomorphized struct emitted once, then the declaration using its mangled name";
}

test "emit_statement does not re-emit an already-instantiated generic compound" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  Node n1 = _box_num_var_decl("b1");
  Node n2 = _box_num_var_decl("b2");
  assert g.emit_statement(n1).is_none(), "expected the first Box<num> declaration to emit";
  assert g.emit_statement(n2).is_none(), "expected the second Box<num> declaration to emit";
  assert equals(
    st.out.build(),
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `Box__num b1;
    `Box__num b2;
    ``
  ), "expected the struct typedef only once, even though Box<num> is used twice";
}

test "emit_expr resolves chained field access through a generic-compound-instantiated local" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  Node decl = _box_num_var_decl("b");
  assert g.emit_statement(decl).is_none(), "expected the Box<num> declaration to emit";

  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier("b"));
  Node* field = malloc(sizeof(Node));
  *field = node_new(NodeKind.Identifier("value"));
  ExprNode e;
  e.left = recv;
  e.has_left = true;
  e.right = field;
  e.has_right = true;
  e.op = ".";
  Node access = node_new(NodeKind.Expression(e));

  assert g.emit_expr(access).is_none(), "expected 'b.value' to resolve through the monomorphized Box__num's own registered field";
  assert equals(
    st.out.build(),
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `Box__num b;
    `b.value`
  ), "expected the field access appended after the declaration, resolved via the mangled compound's registry";
}

test "emit_expr resolves a chained field access through a CALL receiver, with no intermediate 'let'" {
  // `tok.unwrap().type`, a field access whose receiver
  // is itself a call (a plain function or a method call), not a known
  // local. `resolve_field_chain` handles a call receiver by
  // resolving the call's declared return type (the same
  // `lookup_function_rtype`/`lookup_impl_method_rtype` lookups
  // `infer_let_expr_type`'s "()" case uses), then rendering the call's
  // text into a throwaway scratch buffer, since a field-chain link
  // otherwise has no emission logic of its own.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "Token";
  FunctionNode fnv = function_node_new();
  fnv.name = "mk";
  fnv.has_name = true;
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.has_args = false;
  Node fn_node = node_new(NodeKind.Function(fnv));
  Vec<Node> sig_nodes;
  sig_nodes.init(0);
  sig_nodes.push(fn_node);
  g.register_function_signatures(sig_nodes);

  Vec<str> tok_fields;
  tok_fields.init(0);
  tok_fields.push("type");
  Vec<str> tok_field_types;
  tok_field_types.init(0);
  tok_field_types.push("TokenType");
  Vec<bin> tok_field_ptrs;
  tok_field_ptrs.init(0);
  tok_field_ptrs.push(false);
  g.record_compound("Token", tok_fields, tok_field_types, tok_field_ptrs);

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("mk"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));

  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("type"));
  ExprNode field_e;
  field_e.left = call_node;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node access = node_new(NodeKind.Expression(field_e));

  assert g.emit_expr(access).is_none(), "expected 'mk().type' to resolve";
  assert equals(st.out.build(), "mk().type"), "expected the call rendered inline, then '.type' appended";
}

// Registers a generic impl equivalent to `impl Box<T> { pub get() T { ret
// self.value; } }` (matching `_record_box_template`'s own `Box<T> { T value;
// }` compound) as a template, via `register_impl_methods` -- no C emitted
// yet, same as the compound/enum template-recording helpers above.
fun _record_box_get_impl(Codegen* g) {
  DataType* t_arg = malloc(sizeof(DataType));
  *t_arg = dtype_new();
  t_arg.type_str = "T";
  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Box";
  self_dt.pointer_depth = 1;
  self_dt.generic_args.push(t_arg);
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(NodeKind.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("value"));
  ExprNode field_e;
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode fnv = function_node_new();
  fnv.name = "Box__get";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "T";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.args = margs;
  fnv.has_args = true;
  fnv.body = body;
  fnv.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(fnv));

  ImplNode impln = impl_node_new();
  impln.type_name = "Box";
  impln.type_params.push("T");
  impln.has_type_params = true;
  impln.methods.push(method_node);

  Node impl_node = node_new(NodeKind.Impl(impln));
  g.register_impl_methods(impl_node);
}

test "emit_statement declaring a generic Box<num> does not emit its impl's method until it's actually called" {
  // A generic impl method is emitted lazily, at its first call site for
  // a given instantiation; see `ensure_generic_impl_method_emitted`.
  // Merely instantiating `Box<num>` via this declaration records the
  // method's metadata, so a later call resolves correctly, but emits no
  // C for it.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);
  _record_box_get_impl(&g);

  Node n = _box_num_var_decl("b");
  assert g.emit_statement(n).is_none(), "expected the Box<num> declaration to emit";
  assert equals(
    st.out.build(),
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `Box__num b;
    ``
  ), "expected only the struct and the declaration -- no method C, since 'get' is never called";
  assert g.lookup_impl_method("Box__num", "get").is_some(), "expected the method's metadata still registered, even though unemitted";
}

fun _box_get_call_node(str recv_name) Node {
  Node* recv = malloc(sizeof(Node));
  *recv = node_new(NodeKind.Identifier(recv_name));
  Node* method = malloc(sizeof(Node));
  *method = node_new(NodeKind.Identifier("get"));
  ExprNode dot_e;
  dot_e.left = recv;
  dot_e.has_left = true;
  dot_e.right = method;
  dot_e.has_right = true;
  dot_e.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot_e));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));

  ExprNode call_e;
  call_e.left = dot_node;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  ret node_new(NodeKind.Expression(call_e));
}

test "emit_statement does not re-emit a generic impl's monomorphized method on a second call" {
  // See the previous test: the method is emitted lazily, at its first
  // call. This covers the dedup half: a second call, even through a
  // different instance of the same instantiation, must not re-emit its
  // prototype/body.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);
  _record_box_get_impl(&g);

  Node n1 = _box_num_var_decl("b1");
  Node n2 = _box_num_var_decl("b2");
  assert g.emit_statement(n1).is_none(), "expected the first Box<num> declaration to emit";
  assert g.emit_statement(n2).is_none(), "expected the second Box<num> declaration to emit";
  Node call1 = _box_get_call_node("b1");
  Node call2 = _box_get_call_node("b2");
  assert g.emit_expr(call1).is_none(), "expected 'b1.get()' to resolve";
  assert g.emit_expr(call2).is_none(), "expected 'b2.get()' to resolve";
  assert equals(
    st.out.build(),
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `Box__num b1;
    `Box__num b2;
    `int64_t Box__num__get(Box__num* self);
    `int64_t Box__num__get(Box__num* self) {
    `    return self->value;
    `}
    `Box__num__get(&b1)Box__num__get(&b2)`
  ), "expected the struct emitted once (unaffected), and the method (plus its forward declaration) emitted only once despite two calls";
}

test "emit_expr calls a generic impl's monomorphized method through a value-typed instance" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);
  _record_box_get_impl(&g);

  Node decl = _box_num_var_decl("b");
  assert g.emit_statement(decl).is_none(), "expected the Box<num> declaration to emit";

  Node n = _box_get_call_node("b");
  assert g.emit_expr(n).is_none(), "expected 'b.get()' to resolve to the monomorphized method";
  assert equals(
    st.out.build(),
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `Box__num b;
    `int64_t Box__num__get(Box__num* self);
    `int64_t Box__num__get(Box__num* self) {
    `    return self->value;
    `}
    `Box__num__get(&b)`
  ), "expected the struct+declaration first, THEN the method (lazily triggered by this call, not the earlier declaration), THEN the call itself";
}

test "pub transpile registers a generic impl's method metadata even when a PLAIN compound's OWN field is the first trigger" {
  // `compound Lexer { Vec<Token> tokens; }` needs
  // `Vec<T>`'s impl method metadata registered. `pub transpile`'s
  // enum/compound pass runs after its `register_impl_methods` pass, so
  // `generic_impl_templates` is already populated by the time Lexer's
  // field triggers `ensure_compound_instantiated` for `Vec<Token>`,
  // and `maybe_instantiate_generic_impl_methods` can find its template.
  // 
  // `last` is never called anywhere in this test, so its C body must
  // not appear at all; the method's metadata (`lookup_impl_method`)
  // still resolves correctly regardless of whether emission itself is
  // eager or lazy (see `ensure_generic_impl_method_emitted`).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode vecc = compound_node_new();
  vecc.name = "Vec";
  vecc.type_params.push("T");
  vecc.has_type_params = true;
  CompoundField vecf;
  vecf.name = "len";
  DataType* vecfdt = malloc(sizeof(DataType));
  *vecfdt = dtype_new();
  vecfdt.type_str = "T";
  vecf.dtype = vecfdt;
  vecc.fields.push(vecf);
  Node vec_node = node_new(NodeKind.Compound(vecc));

  DataType* selfdt = malloc(sizeof(DataType));
  *selfdt = dtype_new();
  selfdt.type_str = "Vec";
  selfdt.pointer_depth = 1;
  DataType* t_arg = malloc(sizeof(DataType));
  *t_arg = dtype_new();
  t_arg.type_str = "T";
  selfdt.generic_args.push(t_arg);
  VariableNode selfv;
  selfv.var_type = selfdt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(NodeKind.Identifier("self"));
  Node* len_ident = malloc(sizeof(Node));
  *len_ident = node_new(NodeKind.Identifier("len"));
  ExprNode field_e;
  field_e.left = self_ident;
  field_e.has_left = true;
  field_e.right = len_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> mstmts;
  mstmts.init(0);
  mstmts.push(ret_stmt);
  BodyNode mbn;
  mbn.statements = mstmts;
  Node* mbody = malloc(sizeof(Node));
  *mbody = node_new(NodeKind.Body(mbn));

  FunctionNode lastfn = function_node_new();
  lastfn.name = "Vec__last";
  lastfn.has_name = true;
  DataType* lastrt = malloc(sizeof(DataType));
  *lastrt = dtype_new();
  lastrt.type_str = "T";
  lastfn.rtype = lastrt;
  lastfn.has_rtype = true;
  lastfn.args = margs;
  lastfn.has_args = true;
  lastfn.body = mbody;
  lastfn.has_body = true;
  Node* last_method_node = malloc(sizeof(Node));
  *last_method_node = node_new(NodeKind.Function(lastfn));

  ImplNode vecimpl = impl_node_new();
  vecimpl.type_name = "Vec";
  vecimpl.type_params.push("T");
  vecimpl.has_type_params = true;
  vecimpl.methods.push(last_method_node);
  Node vec_impl_node = node_new(NodeKind.Impl(vecimpl));

  CompoundNode lexerc = compound_node_new();
  lexerc.name = "Lexer";
  CompoundField tokensf;
  tokensf.name = "tokens";
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* tokensdt = malloc(sizeof(DataType));
  *tokensdt = dtype_new();
  tokensdt.type_str = "Vec";
  tokensdt.generic_args.push(num_arg);
  tokensf.dtype = tokensdt;
  lexerc.fields.push(tokensf);
  Node lexer_node = node_new(NodeKind.Compound(lexerc));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(vec_node);
  nodes.push(vec_impl_node);
  nodes.push(lexer_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert !contains(st.out.build(), "Vec__num__last"), "expected the never-called method to NOT be emitted at all (lazy per-method emission)";
  assert g.lookup_impl_method("Vec__num", "last").is_some(), "expected Vec<T>'s own impl method metadata registered from Lexer's field alone, not silently skipped";
}

test "pub transpile hoists a generic compound's monomorphized typedef BEFORE another compound whose OWN field first triggers it" {
  // `StringBuilder { Vec<str> parts; ... }` must not
  // emit `Vec__str`'s struct typedef nested inside StringBuilder's own
  // `typedef struct StringBuilder { ... }` field list, which is illegal
  // C: a typedef can't be declared in the middle of another struct's
  // member list. `pub transpile`'s enum/compound passes need to set
  // `hoist_insert_pos` too, not just the impl/function passes.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode boxc = compound_node_new();
  boxc.name = "Box";
  boxc.type_params.push("T");
  boxc.has_type_params = true;
  CompoundField boxf;
  boxf.name = "value";
  DataType* boxfdt = malloc(sizeof(DataType));
  *boxfdt = dtype_new();
  boxfdt.type_str = "T";
  boxf.dtype = boxfdt;
  boxc.fields.push(boxf);
  Node box_node = node_new(NodeKind.Compound(boxc));

  CompoundNode outerc = compound_node_new();
  outerc.name = "Outer";
  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_dt = malloc(sizeof(DataType));
  *inner_dt = dtype_new();
  inner_dt.type_str = "Box";
  inner_dt.generic_args.push(num_arg);
  CompoundField innerf;
  innerf.name = "inner";
  innerf.dtype = inner_dt;
  outerc.fields.push(innerf);
  Node outer_node = node_new(NodeKind.Compound(outerc));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(box_node);
  nodes.push(outer_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert equals(
    st.out.build(),
    `#include <stdio.h>
    `#include <stdbool.h>
    `#include <stdint.h>
    `#include <stdarg.h>
    `#include <stdlib.h>
    `#include <string.h>
    `#include <ctype.h>
    `#include <limits.h>
    `#include <math.h>
    `static FILE* stdout_stream(void){ return stdout; }
    `static FILE* stderr_stream(void){ return stderr; }
    `static FILE* stdin_stream(void){ return stdin; }
    `static long long __fun_str_key_hash(const char* s) { long long h = 2166136261LL; if (s) { for (; *s; ++s) { h ^= (unsigned char)*s; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } } if (h < 0) h = -h; return h; }
    `static long long __fun_bytes_key_hash(const void* p, unsigned long n) { long long h = 2166136261LL; const unsigned char* b = (const unsigned char*)p; for (unsigned long i = 0; i < n; ++i) { h ^= b[i]; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } if (h < 0) h = -h; return h; }
    `#define __fun_tag(x) _Generic((x), char*: 's', const char*: 's', long long: 'n', long: 'n', int: 'n', unsigned long long: 'n', unsigned long: 'n', unsigned int: 'n', double: 'd', float: 'd', _Bool: 'b', char: 'c', void*: 'p', default: 'p')
    `#ifdef _WIN32
    `#include <windows.h>
    `#include <direct.h>
    `#include <sys/stat.h>
    `typedef struct { HANDLE h; WIN32_FIND_DATAA data; int started; } __fun_dir_iter;
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; char pattern[4096]; snprintf(pattern, sizeof(pattern), "%s\\*", path); __fun_dir_iter* it = (__fun_dir_iter*)malloc(sizeof(__fun_dir_iter)); if (!it) return NULL; it->h = FindFirstFileA(pattern, &it->data); it->started = 0; if (it->h == INVALID_HANDLE_VALUE) { free(it); return NULL; } return it; }
    `static char* __fun_dir_read_name(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return NULL; if (it->started) { if (!FindNextFileA(it->h, &it->data)) return NULL; } else { it->started = 1; } return it->data.cFileName; }
    `static long long __fun_dir_close(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return -1; FindClose(it->h); free(it); return 0; }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct _stat st; if (_stat(path, &st) != 0) return 0; return (st.st_mode & _S_IFDIR) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return _mkdir(path); }
    `#else
    `#include <dirent.h>
    `#include <sys/stat.h>
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; return (void*)opendir(path); }
    `static char* __fun_dir_read_name(void* dirp) { if (!dirp) return NULL; struct dirent* e = readdir((DIR*)dirp); return e ? e->d_name : NULL; }
    `static long long __fun_dir_close(void* dirp) { if (!dirp) return -1; return (long long)closedir((DIR*)dirp); }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct stat st; if (stat(path, &st) != 0) return 0; return S_ISDIR(st.st_mode) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return mkdir(path, 0755); }
    `#endif
    `#ifdef _WIN32
    `#include <windows.h>
    `typedef HANDLE __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `typedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;
    `static DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 0, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }
    `static int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }
    `#else
    `#include <pthread.h>
    `typedef pthread_t __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { return pthread_create(t, NULL, entry, arg); }
    `static int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }
    `#endif
    `#if defined(_WIN32)
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#include <winsock2.h>
    `#include <ws2tcpip.h>
    `#pragma comment(lib, "Ws2_32.lib")
    `#ifndef close
    `#define close closesocket
    `#endif
    `#else
    `#include <sys/socket.h>
    `#include <netinet/in.h>
    `#include <arpa/inet.h>
    `#include <unistd.h>
    `#endif
    `typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
    `static __fun_wd_state __fun_g_wd;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `static void* __fun_wd_thread(void* unused){ (void)unused;
    `  long long last_seq=-1; long long stall_ms=0;
    `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
    `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_wd.threshold_ms){
    `      __fun_wd_warn((long long)blk, 0, stall_ms);
    `      if(__fun_g_wd.abort_on_fire) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `void __fun_wd_enter_wait(void){
    `  if(!__fun_g_wd.started){
    `    __fun_g_wd.started=1;
    `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm=(w && w[0])?atoll(w):0;
    `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
    `    const char* a=getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
    `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
    `  }
    `  if(!__fun_g_wd.armed) return;
    `  __fun_g_wd.blocked++;
    `}
    `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
    `typedef struct Outer Outer;
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `typedef struct Outer {
    `  Box__num inner;
    `} Outer;
    `
    ``
  ), "expected Box__num's typedef BEFORE Outer's, not nested inside its field list";
}

test "pub transpile hoists a generic impl method's monomorphized definition BEFORE the function that first triggers it, not nested inside it" {
  // `Box<num>` used for the first time inside `main`'s
  // body, the common case, must not emit `Box__num`'s struct typedef and
  // `Box__num__get`'s C function definition nested inside `main`'s
  // `{ }`. A nested typedef is valid (if oddly-scoped) C, but a nested
  // function definition is a hard C syntax error clang rejects
  // ("function definition is not allowed here"). See
  // `Codegen.hoist_insert_pos`/`emit_hoisted`: `pub transpile` tracks
  // where `main` started, and anything hoisted from inside it is
  // spliced in right before that point instead.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode c = compound_node_new();
  c.name = "Box";
  c.type_params.push("T");
  c.has_type_params = true;
  CompoundField f;
  f.name = "value";
  DataType* fdt = malloc(sizeof(DataType));
  *fdt = dtype_new();
  fdt.type_str = "T";
  f.dtype = fdt;
  c.fields.push(f);
  Node compound_node = node_new(NodeKind.Compound(c));

  DataType* t_arg = malloc(sizeof(DataType));
  *t_arg = dtype_new();
  t_arg.type_str = "T";
  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Box";
  self_dt.pointer_depth = 1;
  self_dt.generic_args.push(t_arg);
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> margs;
  margs.init(0);
  margs.push(self_param);

  Node* field_recv = malloc(sizeof(Node));
  *field_recv = node_new(NodeKind.Identifier("self"));
  Node* field_name = malloc(sizeof(Node));
  *field_name = node_new(NodeKind.Identifier("value"));
  ExprNode field_e;
  field_e.left = field_recv;
  field_e.has_left = true;
  field_e.right = field_name;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* method_ret_stmt = malloc(sizeof(Node));
  *method_ret_stmt = node_new(NodeKind.StatementReturn(field_expr));
  Vec<Node*> method_stmts;
  method_stmts.init(0);
  method_stmts.push(method_ret_stmt);
  BodyNode method_bn;
  method_bn.statements = method_stmts;
  Node* method_body = malloc(sizeof(Node));
  *method_body = node_new(NodeKind.Body(method_bn));

  FunctionNode getfn = function_node_new();
  getfn.name = "Box__get";
  getfn.has_name = true;
  DataType* get_rtype = malloc(sizeof(DataType));
  *get_rtype = dtype_new();
  get_rtype.type_str = "T";
  getfn.rtype = get_rtype;
  getfn.has_rtype = true;
  getfn.args = margs;
  getfn.has_args = true;
  getfn.body = method_body;
  getfn.has_body = true;
  Node* method_node = malloc(sizeof(Node));
  *method_node = node_new(NodeKind.Function(getfn));

  ImplNode implb = impl_node_new();
  implb.type_name = "Box";
  implb.type_params.push("T");
  implb.has_type_params = true;
  implb.methods.push(method_node);
  Node impl_node = node_new(NodeKind.Impl(implb));

  Node main_decl = _box_num_var_decl("b");
  Node* main_decl_ptr = malloc(sizeof(Node));
  *main_decl_ptr = main_decl;
  // A call, not just a declaration: lazy per-method emission (see
  // `ensure_generic_impl_method_emitted`) only triggers a method's C
  // body at its first call, so it's the call that needs to be hoisted
  // here, not the declaration alone.
  Node* main_call_ptr = malloc(sizeof(Node));
  *main_call_ptr = _box_get_call_node("b");
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(main_decl_ptr);
  main_stmts.push(main_call_ptr);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(NodeKind.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "num";
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(NodeKind.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(compound_node);
  nodes.push(impl_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert equals(
    st.out.build(),
    `#include <stdio.h>
    `#include <stdbool.h>
    `#include <stdint.h>
    `#include <stdarg.h>
    `#include <stdlib.h>
    `#include <string.h>
    `#include <ctype.h>
    `#include <limits.h>
    `#include <math.h>
    `static FILE* stdout_stream(void){ return stdout; }
    `static FILE* stderr_stream(void){ return stderr; }
    `static FILE* stdin_stream(void){ return stdin; }
    `static long long __fun_str_key_hash(const char* s) { long long h = 2166136261LL; if (s) { for (; *s; ++s) { h ^= (unsigned char)*s; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } } if (h < 0) h = -h; return h; }
    `static long long __fun_bytes_key_hash(const void* p, unsigned long n) { long long h = 2166136261LL; const unsigned char* b = (const unsigned char*)p; for (unsigned long i = 0; i < n; ++i) { h ^= b[i]; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } if (h < 0) h = -h; return h; }
    `#define __fun_tag(x) _Generic((x), char*: 's', const char*: 's', long long: 'n', long: 'n', int: 'n', unsigned long long: 'n', unsigned long: 'n', unsigned int: 'n', double: 'd', float: 'd', _Bool: 'b', char: 'c', void*: 'p', default: 'p')
    `#ifdef _WIN32
    `#include <windows.h>
    `#include <direct.h>
    `#include <sys/stat.h>
    `typedef struct { HANDLE h; WIN32_FIND_DATAA data; int started; } __fun_dir_iter;
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; char pattern[4096]; snprintf(pattern, sizeof(pattern), "%s\\*", path); __fun_dir_iter* it = (__fun_dir_iter*)malloc(sizeof(__fun_dir_iter)); if (!it) return NULL; it->h = FindFirstFileA(pattern, &it->data); it->started = 0; if (it->h == INVALID_HANDLE_VALUE) { free(it); return NULL; } return it; }
    `static char* __fun_dir_read_name(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return NULL; if (it->started) { if (!FindNextFileA(it->h, &it->data)) return NULL; } else { it->started = 1; } return it->data.cFileName; }
    `static long long __fun_dir_close(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return -1; FindClose(it->h); free(it); return 0; }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct _stat st; if (_stat(path, &st) != 0) return 0; return (st.st_mode & _S_IFDIR) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return _mkdir(path); }
    `#else
    `#include <dirent.h>
    `#include <sys/stat.h>
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; return (void*)opendir(path); }
    `static char* __fun_dir_read_name(void* dirp) { if (!dirp) return NULL; struct dirent* e = readdir((DIR*)dirp); return e ? e->d_name : NULL; }
    `static long long __fun_dir_close(void* dirp) { if (!dirp) return -1; return (long long)closedir((DIR*)dirp); }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct stat st; if (stat(path, &st) != 0) return 0; return S_ISDIR(st.st_mode) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return mkdir(path, 0755); }
    `#endif
    `#ifdef _WIN32
    `#include <windows.h>
    `typedef HANDLE __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `typedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;
    `static DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 0, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }
    `static int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }
    `#else
    `#include <pthread.h>
    `typedef pthread_t __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { return pthread_create(t, NULL, entry, arg); }
    `static int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }
    `#endif
    `#if defined(_WIN32)
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#include <winsock2.h>
    `#include <ws2tcpip.h>
    `#pragma comment(lib, "Ws2_32.lib")
    `#ifndef close
    `#define close closesocket
    `#endif
    `#else
    `#include <sys/socket.h>
    `#include <netinet/in.h>
    `#include <arpa/inet.h>
    `#include <unistd.h>
    `#endif
    `typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
    `static __fun_wd_state __fun_g_wd;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `static void* __fun_wd_thread(void* unused){ (void)unused;
    `  long long last_seq=-1; long long stall_ms=0;
    `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
    `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_wd.threshold_ms){
    `      __fun_wd_warn((long long)blk, 0, stall_ms);
    `      if(__fun_g_wd.abort_on_fire) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `void __fun_wd_enter_wait(void){
    `  if(!__fun_g_wd.started){
    `    __fun_g_wd.started=1;
    `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm=(w && w[0])?atoll(w):0;
    `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
    `    const char* a=getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
    `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
    `  }
    `  if(!__fun_g_wd.armed) return;
    `  __fun_g_wd.blocked++;
    `}
    `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
    `typedef struct Box__num {
    `  int64_t value;
    `} Box__num;
    `
    `int64_t Box__num__get(Box__num* self) {
    `    return self->value;
    `}
    `int main(int argc, char** argv) {
    `    Box__num b;
    `    int64_t Box__num__get(Box__num* self);
    `    Box__num__get(&b);
    `}
    ``
  ), "expected the struct typedef AND the monomorphized method's DEFINITION (lazily triggered by the call inside main's own body) BEFORE 'main', not nested inside its braces -- its bare PROTOTYPE, unlike the definition, is legal (if unusually placed) right at its own first-use point, since a declaration (not a full definition) is valid C at block scope. Also expects `main`'s own C signature forced to the real entry-point shape (`int main(int argc, char** argv)`), not its naive Fun-level `num`-returning, no-arg signature";
}

test "ensure_compound_instantiated rejects an unrecognized generic template name" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Unrecognized";
  dt.generic_args.push(num_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected an unrecognized generic template name to be rejected rather than guessed";
}

test "ensure_compound_instantiated rejects a wrong generic argument count" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* str_arg = malloc(sizeof(DataType));
  *str_arg = dtype_new();
  str_arg.type_str = "str";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(num_arg);
  dt.generic_args.push(str_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Box (one type param) instantiated with two arguments to be rejected";
}

test "ensure_compound_instantiated rejects a nested generic argument whose OWN template isn't registered" {
  // Nested generic arguments themselves resolve (see the "instantiates
  // a nested generic argument" test below); this one covers the
  // argument still being rejected when the nested type itself is
  // unresolvable, here "Vec" was never registered as a template, same
  // "reject rather than guess" reasoning as an unrecognized template
  // name anywhere else.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_vec = malloc(sizeof(DataType));
  *inner_vec = dtype_new();
  inner_vec.type_str = "Vec";
  inner_vec.generic_args.push(num_arg);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Box";
  dt.generic_args.push(inner_vec);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Box<Vec<num>> rejected because 'Vec' itself was never registered as a template, not because nesting itself is unsupported";
}

test "ensure_compound_instantiated instantiates a nested generic argument (Box<Box<num>>)" {
  // `Result<Option<Token>, Error>` is a nested generic instantiation, a
  // generic argument that's itself a generic instantiation. The nested
  // argument is resolved (and, on first use, emitted) first via
  // `resolve_type_name`, using its mangled name as the outer
  // instantiation's arg name; this recurses to arbitrary depth.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_box = malloc(sizeof(DataType));
  *inner_box = dtype_new();
  inner_box.type_str = "Box";
  inner_box.generic_args.push(num_arg);
  DataType* outer_dt = malloc(sizeof(DataType));
  *outer_dt = dtype_new();
  outer_dt.type_str = "Box";
  outer_dt.generic_args.push(inner_box);
  VariableNode v;
  v.var_type = outer_dt;
  v.name = "x";
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_none(), "expected Box<Box<num>> to instantiate, resolving the nested Box<num> first";
  let out = st.out.build();
  assert contains(out, "typedef struct Box__num {\n  int64_t value;\n} Box__num;"), "expected the INNER instantiation (Box__num) emitted";
  assert contains(out, "typedef struct Box__Box__num {\n  Box__num value;\n} Box__Box__num;"), "expected the OUTER instantiation (Box__Box__num) using the inner's own mangled name as its field type";
  assert contains(out, "Box__Box__num x;"), "expected the declaration itself to use the outer mangled name";
}

test "ensure_compound_instantiated mangles a pointer-typed generic argument distinctly" {
