// Transpiles a Fun AST into C source.
// 
// Generic compounds, enums, impl methods, and functions are monomorphized
// lazily, the first time a concrete instantiation is actually used. A
// definition triggered from inside another function's body is spliced in
// just before the enclosing top-level item rather than left nested inside
// it (see `Codegen.hoist_insert_pos`/`emit_hoisted`). There is no
// standalone type-checker: declared types are taken at face value, and a
// `let` binding without one relies on the C compiler's own `__auto_type`
// inference.

imp codegen_state;
imp typedefs;
imp ..ast.ast;
imp ..lexer.token;
imp ..parser.datatype_defs;
imp std.string;
imp std.option;
imp std.io;

pub enum CodegenErrorKind {
  UnsupportedNode,
  InvalidNode,
}

// A resolved compound field's declared type: its type name and whether
// it's a pointer -- exactly the same two facts `local_type_name`/
// `local_is_pointer` track for a LOCAL, but for a COMPOUND FIELD instead,
// so a chained field access (`a.b.c`) can determine `.`/`->` at each
// link without a real type-inference engine. See
// `emit_receiver_and_resolve_type`'s doc comment.
// `dtype` additionally carries the field's FULL, un-mangled declared
// `DataType` (its own `generic_args` intact), when the recording call
// site had one on hand (`record_compound_typed`, e.g. `emit_compound`'s
// own real field pass) -- `.None` for a hand-built unit test's stand-in
// field (`record_compound`). Lets a caller that needs REAL structure (a
// generic arg, e.g. `Vec<T>`'s own `T`) read it directly instead of
// reverse-engineering it out of a mangled name string -- see
// `emit_for_iter`'s own doc comment for the motivating case (a for-each
// iterable that's itself a field access, `for a : dt.generic_args { ...
// }`, needing to know ITS OWN element type to record `a` as a known
// local too).
// A multi-dimensional array's root name and index depth; see
// `lookup_local_multidim`.
compound MultidimInfo {
  str root;
  num depth;
}

// An array literal's element type and nesting depth; see
// `infer_array_literal_elem_type_and_depth`.
compound ArrayLiteralElemInfo {
  str type_name;
  num depth;
}

compound FieldTypeInfo {
  str type_name;
  bin is_pointer;
  Option<DataType> dtype;
}

// Like `FieldTypeInfo`, plus the resolved C text. Used where a receiver's
// text needs to be computed once but written multiple times, such as a
// `fit` subject shared across several branches.
compound ChainResolution {
  str text;
  str type_name;
  bin is_pointer;
  Option<DataType> dtype;
  // Set when `text` is a call's own rendered result (an rvalue) rather
  // than an addressable lvalue. A caller that needs `&text` must hoist
  // it into a temp first.
  bin is_call_result;
}

// Which mangled `to_string` function to call for a `Display` argument in
// a `format`/`println_fmt` `{}` placeholder, and whether it needs `&`
// first.
compound DisplayResolution {
  str fn_name;
  bin pass_by_ref;
}

// A monomorphized generic function call: its mangled name, plus each
// parameter's declared type already substituted against this call's
// concrete arguments.
compound GenericCallResolution {
  str mangled_name;
  Vec<DataType> param_types;
  // The return type, substituted the same way. Kept separately since it
  // can't be recovered once the substitution context is torn down.
  DataType rtype;
}

// Result of `maybe_instantiate_generic_impl_method_own_params`: mangled
// name plus substituted return type, for the same reason as
// `GenericCallResolution.rtype`.
compound OwnParamCallResolution {
  str mangled_name;
  DataType rtype;
}

// One variant's shape within a generic enum template: its name, whether
// it carries a payload, and each payload position's declared type before
// substitution.
compound GenericEnumVariantTemplate {
  str name;
  bin has_payload;
  Vec<str> payload_type_strs;
  Vec<bin> payload_is_pointer;
}

pub compound Codegen {
  CodegenState* state;
  // Local names seen so far in the current function (reset per
  // `emit_function`), with pointer-ness and declared type name -- enough
  // to decide `.`/`->` for a field access and build a method call's
  // mangled name without a real type-inference engine.
  Vec<str> local_names;
  Vec<bin> local_is_pointer;
  Vec<str> local_type_name;
  // A local's full structured type, when known (`record_local_typed`);
  // `.None` for a local recorded without one (`record_local`). Lets a
  // caller read a generic argument's real structure instead of
  // reverse-engineering it from a mangled name.
  Vec<Option<DataType>> local_dtype;
  // Sparse record of a multi-dimensional array's iteration variable,
  // mapping it back to the root array name and how many `[0]` levels
  // separate it -- a nested loop's length bound can't be computed from
  // the (possibly pointer-decayed) loop variable itself, only by
  // re-indexing the original array. Reset between top-level functions.
  Vec<str> local_multidim_names;
  Vec<str> local_multidim_roots;
  Vec<num> local_multidim_depths;
  // Every non-generic enum's name, variant names, and whether it's a
  // tagged union, so a qualified enum-variant access resolves without a
  // real type-inference engine.
  Vec<str> enum_names;
  Vec<Vec<str>> enum_variant_names;
  Vec<bin> enum_is_tagged_union;
  // A tagged-union enum's per-variant payload field types, so a `fit`
  // destructuring binding is registered as a known local and further
  // access on it (a field, another `fit`, a method call) resolves.
  Vec<str> enum_variant_payload_owner;
  Vec<str> enum_variant_payload_variant;
  Vec<Vec<str>> enum_variant_payload_type_names;
  Vec<Vec<bin>> enum_variant_payload_is_pointer;
  // The current function's declared return type name, refreshed at the
  // start of every `emit_function`; feeds `expected_enum_type` for a
  // bare-shorthand `ret`.
  str current_fn_rtype_name;
  // The current function's return type as a full substituted `DataType`.
  // Lets `maybe_instantiate_generic_function` fall back to inferring a
  // type param from the enclosing function's own return type when it
  // can't be read off the call's arguments.
  Option<DataType> current_fn_rtype_dt;
  // The enum a bare `.Variant`/`.Variant(x)` shorthand should resolve
  // against, standing in for "the expected type from context." Empty
  // when nothing in the enclosing statement provides one; scoped to just
  // the statement's own value/initializer/right-hand side so it can't
  // leak into an unrelated shorthand elsewhere in the same function.
  str expected_enum_type;
  // Same idea as `expected_enum_type`, for a bare `.{ field = value }`
  // compound-literal shorthand.
  str expected_compound_type;
  // True while emitting a context where a bare `{...}` brace-list is the
  // correct form for an array literal: an array variable's initializer, a
  // nested row, or a compound-init field value. When false, a bare array
  // literal is rejected outright rather than emitting invalid C.
  bin in_array_initializer;
  // Names of every quirk with at least one concrete (non-generic) impl
  // emitted so far, used to recognize a receiver/declared type as a
  // quirk (dispatched through a vtable) rather than a concrete compound.
  // A generic quirk impl never adds its name here -- dynamic dispatch
  // through an unbound type param has no single C vtable signature.
  Vec<str> quirk_names;
  // Keys (`<type_name>::<quirk_name>`) of every concrete quirk impl
  // whose vtable machinery has already run, so a plain compound with a
  // quirk-typed field can trigger it early without the normal pass
  // re-emitting it later.
  Vec<str> emitted_quirk_impl_vtables;
  // Every generic quirk's own declaration, registered up front so a
  // concrete instantiation's vtable can be derived structurally even
  // when no impl of it exists in the current translation unit. A
  // non-generic quirk's vtable is instead derived from its first
  // concrete impl.
  Vec<str> quirk_decl_names;
  Vec<Vec<str>> quirk_decl_type_params;
  Vec<Vec<QuirkMethodSig>> quirk_decl_methods;
  // Every import alias name (`imp x as y;`'s own `y`) seen across the
  // transitive import graph. Set by the caller right after `codegen_new`;
  // empty for a hand-built unit test.
  // 
  // Consulted wherever a `y.symbol` qualified reference could otherwise
  // be misread as a receiver or type: `resolve_type_name` (a declared
  // type `y.Type`, already mangled to `y__Type` by the parser),
  // `emit_call` (`y.func(args)`), and `emit_field_access` (`y.EnumName.
  // Variant` used as a value). Each site strips a
  // recognized `<alias>__`/`<alias>.` prefix and resolves the rest
  // unqualified, since an alias's own declarations are already merged
  // in under their real names.
  Vec<str> import_aliases;
  // Exception to the rule above: `<alias>::<bare_name>` -> the real
  // mangled name, for a function that collided with a differently
  // aliased import and got renamed at merge time (see `import_resolver.
  // _rename_colliding_functions`). Checked by `lookup_alias_rename`
  // before falling back to the plain unqualified name.
  Vec<str> alias_rename_keys;
  Vec<str> alias_rename_targets;
  // `defer` support: every pending deferred statement body in scope for
  // the function being emitted, in source order, plus a stack of frame
  // markers (an index into `defer_stack` where each block's own defers
  // begin). Doesn't yet distinguish a loop frame from a plain block
  // frame. A deferred body is replicated as ordinary statements at each
  // early exit; the real pop happens once, when the owning block
  // finishes.
  Vec<Node*> defer_stack;
  Vec<num> defer_scope_starts;
  // Every non-generic compound's name and its fields' declared types, so
  // a chained field access can determine `.`/`->` at each link.
  Vec<str> compound_names;
  Vec<Vec<str>> compound_field_names;
  Vec<Vec<str>> compound_field_type_names;
  Vec<Vec<bin>> compound_field_is_pointer;
  // Each field's full, un-mangled declared type, when known.
  Vec<Vec<Option<DataType>>> compound_field_dtype;
  // Every impl method's owning type, bare name, and fully mangled
  // call-site name. A plain impl's method mangles to `Type__method`; a
  // quirk-implementing impl's mangles to `Type__Quirk__method`.
  Vec<str> impl_method_owner_type;
  Vec<str> impl_method_bare_name;
  Vec<str> impl_method_mangled_name;
  // Each method's declared return type, parallel to the three arrays
  // above. Populated only for a plain (non-generic) impl's methods.
  Vec<DataType*> impl_method_rtype;
  // Each method's declared parameter types, excluding the implicit
  // `self`, parallel to the arrays above.
  Vec<Vec<DataType *>> impl_method_param_types;
  // Each impl method's trailing default parameter values, parallel to
  // `impl_method_param_types`; `nil` for a parameter with no default.
  // Defaults are evaluated fresh at the call site, so re-emitting the
  // same expression per call is correct, not wasteful.
  Vec<Vec<Node *>> impl_method_default_values;
  // Every plain top-level function's name and declared parameter types,
  // so a bare enum-variant shorthand passed as a call argument resolves
  // against the callee's own declared parameter type.
  Vec<str> function_names;
  Vec<Vec<DataType *>> function_param_types;
  // Each plain top-level function's trailing default parameter values,
  // parallel to `function_param_types`/`function_names`.
  Vec<Vec<Node *>> function_default_values;
  // Whether each registered plain function is variadic, parallel to
  // `function_names`.
  Vec<bin> function_is_variadic;
  // Each function's declared return type, parallel to `function_names`.
  Vec<DataType*> function_rtypes;
  // Every generic top-level function, recorded whole rather than
  // registered into `function_names` -- monomorphized lazily from its
  // own call site.
  Vec<Node> generic_function_templates;
  // A generic compound template: its name, type-param names, and each
  // field's declared type before substitution. A template is never
  // emitted directly, only a concrete monomorphization of it.
  Vec<str> generic_compound_names;
  Vec<Vec<str>> generic_compound_type_params;
  Vec<Vec<str>> generic_compound_field_names;
  Vec<Vec<str>> generic_compound_field_type_names;
  Vec<Vec<bin>> generic_compound_field_is_pointer;
  // Each field's full pre-substitution type, generic arguments included,
  // so a field whose own type is itself a nested generic instantiation
  // can be substituted correctly.
  Vec<Vec<DataType *>> generic_compound_field_dtypes;
  // A generic enum template: its name, type-param names, and each
  // variant's shape before substitution.
  Vec<str> generic_enum_names;
  Vec<Vec<str>> generic_enum_type_params;
  Vec<Vec<GenericEnumVariantTemplate>> generic_enum_variants;
  // Mangled names already monomorphized, so instantiating the same
  // concrete type arguments twice doesn't emit a duplicate C typedef --
  // shared across both compound and enum instantiations, since their
  // mangled names are drawn from the same namespace (a compound and an
  // enum can never share a bare name in this language).
  Vec<str> emitted_generic_instantiations;
  // Every PLAIN (non-generic) compound/enum's name already emitted --
  // the same "don't emit the same thing twice" bookkeeping `emitted_
  // generic_instantiations` gives generics, but for plain types (see
  // `ensure_plain_type_emitted`'s doc comment for why plain types need
  // this too: a lazily-triggered, dependency-ordered emission, not
  // `pub transpile`'s old flat "all enums, then all compounds" passes).
  // Pushed the moment emission STARTS (not after it finishes), so a
  // genuine cycle in the source (impossible to lay out in C at all --
  // a compound embedding itself BY VALUE, transitively) is caught as
  // "already being emitted" rather than recursing forever.
  Vec<str> emitted_plain_types;
  // The whole program's flattened top-level node list, stashed ONCE at
  // the start of `pub transpile` -- lets `ensure_plain_type_emitted`
  // (and anything triggering it, e.g. `ensure_compound_instantiated`'s
  // own generic-argument handling) search for a plain type BY NAME
  // without needing `nodes` threaded as an explicit parameter through
  // every call in between.
  Vec<Node> all_nodes;
  // Every GENERIC impl block (`impl Box<T> { ... }` or `impl Box<T> as
  // Quirk { ... }`), recorded whole (not decomposed into parallel arrays
  // like the generic compound/enum registries above -- a whole `Impl`
  // node already carries its own `type_params`/`quirk_name`/`methods`,
  // and re-reading them straight from the node avoids a second
  // hand-rolled copy of the same data) by `register_impl_methods` when it
  // sees `has_type_params`, WITHOUT emitting any C. Monomorphized lazily
  // by `maybe_instantiate_generic_impl_methods`, the same "only on first
  // concrete use" rule as a generic compound/enum template.
  Vec<Node> generic_impl_templates;
  // One entry per concrete generic compound/enum instantiation (`Vec
  // <str>`, e.g.) -- `instantiation_mangled_name.get(i)`'s own template
  // base name, and the exact substitution context (arg type names/
  // pointer-ness/full structural dtypes) that was active when it was
  // instantiated. Recorded by `maybe_instantiate_generic_impl_methods`
  // (parallel to, but NOT the same as, `emitted_generic_instantiations`
  // -- that one just dedups the STRUCT/ENUM typedef itself) so `ensure_
  // generic_impl_method_emitted` can re-establish the SAME substitution
  // context later, on demand, when a SPECIFIC method first gets called
  // -- rather than requiring every method to be monomorphized eagerly,
  // all at once, the moment the type itself is first instantiated (see
  // that function's own doc comment for why eager blanket monomorphization
  // is actually wrong, not just wasteful).
  Vec<str> instantiation_mangled_name;
  Vec<str> instantiation_base_name;
  Vec<Vec<str>> instantiation_arg_type_names;
  Vec<Vec<bin>> instantiation_arg_is_pointer;
  Vec<Vec<DataType *>> instantiation_arg_dtypes;
  // Every generic impl method actually EMITTED (or enqueued to be, see
  // `pending_generic_impl_method_owner`'s doc comment) so far, keyed
  // `"<mangled_name>::<bare_method_name>"` -- see `ensure_generic_impl_
  // method_emitted`'s own doc comment.
  Vec<str> emitted_generic_impl_methods;
  // Every combined-substitution monomorphization of a method that
  // declares its OWN generic type param(s) (on top of the impl's own --
  // `impl Box<T> { pub wrap<U>(U x) Box<U> { ... } }`) already emitted,
  // keyed by the FULL combined mangled name (`Box__num__wrap__str`) --
  // see `maybe_instantiate_generic_impl_method_own_params`'s own doc
  // comment. A separate dimension from `emitted_generic_impl_methods`
  // (keyed by owner+bare name alone, with no room for the method's own
  // additional binding).
  Vec<str> emitted_method_own_param_insts;
  // Every PLAIN (non-generic) impl method that already got its own
  // inline forward-declared bare prototype from `ensure_plain_impl_
  // method_prototype_emitted`, keyed `"<owner_type>::<bare_name>"`. Kept
  // separate from `emitted_generic_impl_methods`: this is one specific
  // non-generic method, never a per-instantiation monomorphization.
  Vec<str> emitted_plain_method_protos;
  // Every plain top-level function that already got its own inline
  // forward-declared prototype, keyed by bare name.
  Vec<str> emitted_plain_function_protos;
  // A FIFO queue of (owner mangled name, bare method name) pairs still
  // needing their prototype and body emitted. A generic impl method's
  // body may call another not-yet-emitted method of the same
  // instantiation; queuing instead of emitting immediately lets the
  // outermost call drain every entry against the real output buffer,
  // never nested inside another method's own braces.
  Vec<str> pending_generic_impl_method_owner;
  Vec<str> pending_generic_impl_method_bare;
  // Parallel to the queue above: whether this entry's prototype was
  // already written at discovery time. False only for an entry
  // discovered while draining was suppressed, whose prototype the drain
  // loop still needs to write itself before the body.
  Vec<bin> pending_generic_impl_method_proto_written;
  // How many entries at the front of the queue have already been
  // processed, so a later, unrelated drain resumes instead of
  // re-processing everything from the start.
  num pending_generic_impl_method_cursor;
  // True for the duration of the outermost drain loop. A call arriving
  // while this is already true just enqueues and returns.
  bin draining_generic_impl_methods;
  // True while `self.state` points at a throwaway text-capture probe
  // (`resolve_field_chain`'s call-as-receiver case, capturing a call's
  // rendered text without going through the usual splice machinery).
  // A generic impl method reached for the first time inside such a
  // probe can't be spliced there, so this suppresses immediate draining
  // in favor of enqueuing; the probe drains the queue itself once it
  // restores the real buffer.
  bin suppress_generic_impl_method_draining;
  // The active type-param substitution for a generic impl method
  // currently being monomorphized: parallel arrays mapping each of the
  // impl's own type-param names to this instantiation's concrete
  // argument. Empty means no substitution is active.
  Vec<str> type_subst_param_names;
  Vec<str> type_subst_arg_type_strs;
  Vec<bin> type_subst_arg_is_pointer;
  // Each argument's full structural type, parallel to the two arrays
  // above, kept separately so a further-generic argument substitutes
  // with its own generic arguments intact rather than collapsing to an
  // opaque mangled name.
  Vec<DataType*> type_subst_arg_dtypes;
  // Where a lazily-monomorphized typedef or generic impl method
  // definition should be spliced, instead of wherever the current
  // output happens to be when it's first triggered (which, for a type
  // used inside a function body, would nest a method definition inside
  // that function's braces -- invalid C). `.None` means append at the
  // current tail.
  Option<num> hoist_insert_pos;
  // Position right before the currently executing statement, updated
  // before dispatching each statement in a body. Lets a lazily-triggered
  // prototype land as its own declaration right before the current
  // statement rather than at the live tail.
  Option<num> current_stmt_start_pos;
  // Unique counter for `resolve_field_chain`'s call-as-receiver temp
  // names.
  num call_recv_temp_counter;
  // Unique counter for `emit_for_iter`'s Set/Map iterator temp names.
  num for_iter_temp_counter;
  // How many levels deep the codegen is nested inside one of its own
  // scratch buffers with `hoist_insert_pos`/`current_stmt_start_pos`
  // suspended (0 when not nested). Several scratch-buffer swaps share
  // this counter since any can trigger another recursively. `root_
  // state`/`root_hoist_pos`/`root_stmt_start_pos` are captured only on
  // the 0-to-1 transition, holding the true outermost buffer and
  // positions; `emit_hoisted` reads them instead of the live (nested)
  // ones whenever this is above zero.
  num hoist_scratch_depth;
  CodegenState* root_state;
  Option<num> root_hoist_pos;
  Option<num> root_stmt_start_pos;
  // Unique counter for `emit_fit`'s call-subject temp names.
  num fit_subj_temp_counter;
  // Whether any `fork` statement appears in the program, computed once
  // before the prelude is written.
  bin uses_fork;
  // Whether the program defines its own top-level function under a name
  // `<math.h>` also declares; `write_prelude` skips `#include <math.h>`
  // when true.
  bin skip_math_h;
  // True while emitting `main`'s own body. `main`'s forced `int` C
  // signature means `ret <expr>;` can only emit the real expression when
  // its declared return type is a scalar `num`; any other type discards
  // it. Saved and restored around any nested function-body emission so
  // an inner function's own returns don't inherit this.
  bin in_main;
}

pub fun codegen_new(CodegenState* state) Codegen {
  Codegen g;
  g.state = state;
  g.local_names.init(0);
  g.local_is_pointer.init(0);
  g.local_type_name.init(0);
  g.local_dtype.init(0);
  g.local_multidim_names.init(0);
  g.local_multidim_roots.init(0);
  g.local_multidim_depths.init(0);
  g.enum_names.init(0);
  g.enum_variant_names.init(0);
  g.enum_is_tagged_union.init(0);
  g.enum_variant_payload_owner.init(0);
  g.enum_variant_payload_variant.init(0);
  g.enum_variant_payload_type_names.init(0);
  g.enum_variant_payload_is_pointer.init(0);
  g.compound_names.init(0);
  g.compound_field_names.init(0);
  g.compound_field_type_names.init(0);
  g.compound_field_is_pointer.init(0);
  g.compound_field_dtype.init(0);
  g.impl_method_owner_type.init(0);
  g.impl_method_bare_name.init(0);
  g.impl_method_mangled_name.init(0);
  g.impl_method_rtype.init(0);
  g.impl_method_param_types.init(0);
  g.impl_method_default_values.init(0);
  g.function_names.init(0);
  g.function_param_types.init(0);
  g.function_default_values.init(0);
  g.function_is_variadic.init(0);
  g.function_rtypes.init(0);
  g.generic_function_templates.init(0);
  g.generic_compound_names.init(0);
  g.generic_compound_type_params.init(0);
  g.generic_compound_field_names.init(0);
  g.generic_compound_field_type_names.init(0);
  g.generic_compound_field_is_pointer.init(0);
  g.generic_compound_field_dtypes.init(0);
  g.generic_enum_names.init(0);
  g.generic_enum_type_params.init(0);
  g.generic_enum_variants.init(0);
  g.emitted_generic_instantiations.init(0);
  g.emitted_plain_types.init(0);
  g.all_nodes.init(0);
  g.generic_impl_templates.init(0);
  g.instantiation_mangled_name.init(0);
  g.instantiation_base_name.init(0);
  g.instantiation_arg_type_names.init(0);
  g.instantiation_arg_is_pointer.init(0);
  g.instantiation_arg_dtypes.init(0);
  g.emitted_generic_impl_methods.init(0);
  g.emitted_method_own_param_insts.init(0);
  g.emitted_plain_method_protos.init(0);
  g.emitted_plain_function_protos.init(0);
  g.pending_generic_impl_method_owner.init(0);
  g.pending_generic_impl_method_bare.init(0);
  g.pending_generic_impl_method_proto_written.init(0);
  g.pending_generic_impl_method_cursor = 0;
  g.draining_generic_impl_methods = false;
  g.suppress_generic_impl_method_draining = false;
  g.type_subst_param_names.init(0);
  g.type_subst_arg_type_strs.init(0);
  g.type_subst_arg_is_pointer.init(0);
  g.type_subst_arg_dtypes.init(0);
  g.hoist_insert_pos = .None;
  g.current_stmt_start_pos = .None;
  g.call_recv_temp_counter = 0;
  g.for_iter_temp_counter = 0;
  g.hoist_scratch_depth = 0;
  g.root_state = nil;
  g.root_hoist_pos = .None;
  g.root_stmt_start_pos = .None;
  g.fit_subj_temp_counter = 0;
  g.current_fn_rtype_name = "";
  g.current_fn_rtype_dt = .None;
  g.expected_enum_type = "";
  g.expected_compound_type = "";
  g.in_array_initializer = false;
  g.quirk_names.init(0);
  g.emitted_quirk_impl_vtables.init(0);
  g.quirk_decl_names.init(0);
  g.quirk_decl_type_params.init(0);
  g.quirk_decl_methods.init(0);
  g.import_aliases.init(0);
  g.alias_rename_keys.init(0);
  g.alias_rename_targets.init(0);
  g.defer_stack.init(0);
  g.defer_scope_starts.init(0);
  g.uses_fork = false;
  g.skip_math_h = false;
  g.in_main = false;
  ret g;
}

// True if `node`'s subtree contains a `fork <call>;` statement anywhere,
// through nested if/elif/else/defer/for/fit bodies -- ported from the
// original implementation's own `node_contains_fork`. A `fork` is always
// a statement, never nested inside an expression, so only the statement/
// body shapes that can directly contain one need walking.
fun node_contains_fork(Node* node) bin {
  fit node.kind {
    .StatementFork(_) -> { ret true; }
    .Body(bn) -> {
      for s : bn.statements {
        if node_contains_fork(s) {
          ret true;
        }
      }
      ret false;
    }
    .StatementIf(ifn) -> { ret node_contains_fork(ifn.body); }
    .StatementElseIf(ein) -> { ret node_contains_fork(ein.body); }
    .StatementElse(ebody) -> { ret node_contains_fork(ebody); }
    .StatementDefer(body) -> { ret node_contains_fork(body); }
    .StatementFor(fk) -> {
      fit fk {
        .Cond(fc) -> { ret node_contains_fork(fc.body); }
        .Range(fr) -> { ret node_contains_fork(fr.body); }
        .Iter(fi) -> { ret node_contains_fork(fi.body); }
      }
    }
    .StatementFit(f) -> {
      for br : f.branches {
        if node_contains_fork(br.body) {
          ret true;
        }
      }
      ret false;
    }
    .Function(fnv) -> {
      if fnv.has_body {
        ret node_contains_fork(fnv.body);
      }
      ret false;
    }
    .Impl(i) -> {
      for m : i.methods {
        if node_contains_fork(m) {
          ret true;
        }
      }
      ret false;
    }
    _ -> { ret false; }
  }
}

// True if any `fork` statement appears anywhere across `nodes` -- the
// program's whole flattened top-level declaration list. Unlike the
// original implementation's own `uses_fork_recursive`, there is no
// separate "recurse into imported children" step to port: selfhost's
// `nodes` is already the WHOLE program, imports already resolved and
// flattened in before codegen ever runs (see `import_resolver.fn`).
fun uses_fork_in(Vec<Node> nodes) bin {
  for n : nodes {
    if node_contains_fork(&n) {
      ret true;
    }
  }
  ret false;
}

// True when the program defines its OWN top-level (free-function, never
// mangled, so the only kind that could collide) function under a name
// `<math.h>` ALSO declares (`log`, `sin`, `pow`, ...) -- write_prelude
// includes `<math.h>` unconditionally (same "no way to see which std.c.*
// modules a program imports" reasoning as every other header there), but
// a program's OWN same-named function (`std/log.fn`'s own real `pub fun
// log(LogLevel level, str msg) { ... }`) then collides with libm's
// declaration of the same bare name. Checked
// once, before the prelude is written (mirrors `uses_fork_in`'s own
// pre-scan), so `write_prelude` can skip the `#include` entirely in that
// case -- a program defining its own `log`/`pow`/etc. is never ALSO
// calling libm's version of the same name under the same name, so
// skipping the include costs nothing real.
fun program_defines_libm_colliding_name(Vec<Node> nodes) bin {
  for n : nodes {
    fit n.kind {
      .Function(f) -> {
        // A BODYLESS function (`std.c.math`'s own `pub fun sqrt(dec x)
        // dec;`, no body -- a real signature binding, not a definition)
        // is a re-declaration of the SAME libm symbol, not a collision:
        // it's imported transitively by `std.math` into EVERY one of
        // these examples, and genuinely NEEDS `<math.h>`'s own
        // declaration visible to be valid at all. Only a REAL, BODIED
        // Fun function under one of these names (`std/log.fn`'s own
        // actual `pub fun log(LogLevel level, str msg) { ... }`) is a
        // genuine collision.
        if !f.has_body {
          continue;
        }
        if equals(f.name, "sqrt") || equals(f.name, "sin") || equals(f.name, "cos") || equals(
          f.name,
          "tan"
        ) || equals(f.name, "asin") || equals(f.name, "acos") || equals(f.name, "atan") || equals(
          f.name,
          "atan2"
        ) || equals(f.name, "cbrt") || equals(f.name, "pow") || equals(f.name, "exp") || equals(
          f.name,
          "log"
        ) || equals(f.name, "log10") || equals(f.name, "log2") || equals(f.name, "floor") || equals(
          f.name,
          "ceil"
        ) || equals(f.name, "round") || equals(f.name, "trunc") || equals(f.name, "fmod") {
          ret true;
        }
      }
      _ -> {}
    }
  }
  ret false;
}

// Shifts a tracked buffer position right by `splice_len` if it falls at
// or after `splice_at`, to account for text just spliced in there.
fun adjust_pos_after_splice(Option<num> pos, num splice_at, num splice_len) Option<num> {
  if pos.is_none() {
    ret pos;
  }
  if splice_at <= pos.unwrap() {
    ret .Some(pos.unwrap() + splice_len);
  }
  ret pos;
}

// True when `dt` is a pointer of any depth -- mirrors `write_type`'s own
// `ptr_depth`/`flags.is_pointer` check.
fun dtype_is_pointer(DataType dt) bin {
  if dt.pointer_depth > 0 {
    ret true;
  }
  ret dt.flags.is_pointer;
}

// True for an unsized array type (`T[]`, no bracket dimension) -- such a
// field decays to a plain C pointer, the same as an unsized C array
// parameter. A sized array (`T[3]`) is excluded; it stays a fixed-size
// inline array.
fun dtype_is_array_as_pointer(DataType dt) bin {
  if !dt.is_array {
    ret false;
  }
  if dt.array_brackets.len > 0 {
    ret false;
  }
  ret dt.array_depth <= 1;
}

// True when `dt` matches a constraint name from an `impl Vec<T: num |
// dec>`-style forced-instantiation list. A builtin scalar matches by
// kind; a named type matches by its bare name, or by the base name
// before a mangled `__` separator.
fun dtype_matches_constraint_name(DataType dt, str expected) bin {
  fit dt.kind {
    .Num -> { ret equals(expected, "num"); }
    .Dec -> { ret equals(expected, "dec"); }
    .Str -> { ret equals(expected, "str"); }
    .Chr -> { ret equals(expected, "chr"); }
    .Bin -> { ret equals(expected, "bin"); }
    .Raw -> { ret equals(expected, "raw"); }
    .Void -> { ret equals(expected, "void"); }
    .Unknown -> {
      if equals(dt.type_str, expected) {
        ret true;
      }
      num sep = index_of_str(dt.type_str, "__");
      if sep < 0 {
        ret false;
      }
      ret equals(substr(dt.type_str, 0, sep), expected);
    }
  }
}

// True when `gargs` (a generic impl instantiation's concrete arguments)
// is allowed by `forced_insts`, one of the concrete-type combinations
// from an `impl Vec<T: num | dec>`-style constraint. An unconstrained
// template always allows any instantiation.
fun impl_allows_generic_args(bin has_forced, Vec<Vec<str>> forced_insts, Vec<DataType*> gargs) bin {
  if !has_forced {
    ret true;
  }
  for inst : forced_insts {
    if inst.len != gargs.len {
      continue;
    }
    bin all_match = true;
    num i = 0;
    for i < inst.len {
      if !dtype_matches_constraint_name(*gargs.get(i), inst.get(i)) {
        all_match = false;
        break;
      }
      i = i + 1;
    }
    if all_match {
      ret true;
    }
  }
  ret false;
}

impl Codegen {

  // Writes `type_name`'s bare C spelling, with no pointer stars.
  write_type_name(str type_name) {
    fit parse_dynamic_int_datatype(type_name) {
      .Some(dyn) -> { self.state.write(dynamic_int_type_to_c(dyn)); }
      .None -> { self.state.write(map_type_to_c(type_name)); }
    }
  }

  // Returns a copy of `dt` with every bare occurrence of an active
  // type-param name substituted for its concrete argument, either `dt`
  // itself or one of its own generic arguments. Returns `dt` unchanged
  // when no substitution context is active.
  resolve_type_subst(DataType dt) DataType {
    if self.type_subst_param_names.len == 0 {
      ret dt;
    }
    if dt.generic_args.len == 0 {
      for i : 0..self.type_subst_param_names.len {
        if equals(self.type_subst_param_names.get(i), dt.type_str) {
          // Prefer the argument's own full structural type, which keeps
          // a further-generic argument's own structure intact. Falls
          // back to the flat strings for a call site that only
          // populated those.
          if i < self.type_subst_arg_dtypes.len {
            let arg_dt = self.type_subst_arg_dtypes.get(i);
            DataType out2 = *arg_dt;
            out2.pointer_depth = out2.pointer_depth + dt.pointer_depth;
            ret out2;
          }
          DataType out = dtype_new();
          out.type_str = self.type_subst_arg_type_strs.get(i);
          out.flags = dt.flags;
          num extra = 0;
          if self.type_subst_arg_is_pointer.get(i) {
            extra = 1;
          }
          out.pointer_depth = dt.pointer_depth + extra;
          ret out;
        }
      }
      ret dt;
    }
    DataType out = dtype_new();
    out.type_str = dt.type_str;
    out.pointer_depth = dt.pointer_depth;
    out.flags = dt.flags;
    Vec<DataType*> new_args;
    new_args.init(0);
    for a : dt.generic_args {
      bin substituted = false;
      if a.generic_args.len == 0 {
        for i : 0..self.type_subst_param_names.len {
          if equals(self.type_subst_param_names.get(i), a.type_str) {
            if i < self.type_subst_arg_dtypes.len {
              let arg_dt2 = self.type_subst_arg_dtypes.get(i);
              DataType* sub2 = malloc(sizeof(DataType));
              *sub2 = *arg_dt2;
              sub2.pointer_depth = sub2.pointer_depth + a.pointer_depth;
              new_args.push(sub2);
              substituted = true;
              break;
            }
            DataType* sub = malloc(sizeof(DataType));
            *sub = dtype_new();
            sub.type_str = self.type_subst_arg_type_strs.get(i);
            num extra = 0;
            if self.type_subst_arg_is_pointer.get(i) {
              extra = 1;
            }
            sub.pointer_depth = a.pointer_depth + extra;
            new_args.push(sub);
            substituted = true;
            break;
          }
        }
      }
      if !substituted {
        new_args.push(a);
      }
    }
    out.generic_args = new_args;
    ret out;
  }

  // Writes `dt`'s C spelling via `write_type_name`, followed by one `*`
  // per pointer-depth level, and returns the RESOLVED type name used --
  // ordinarily just `dt.type_str` unchanged, but the MANGLED
  // monomorphization name (`Box__num`, `Option__num`) when `dt` is a
  // generic instantiation (`dt.generic_args` non-empty, resolved via
  // `ensure_compound_instantiated` or, when that doesn't recognize the
  // base name, `ensure_enum_instantiated`). `dt` is first passed through
  // `resolve_type_subst`, so a bare occurrence of a generic impl
  // method's own type param (`T`) resolves against the active
  // instantiation instead of being (wrongly) looked up as a plain
  // Writes `dt`'s C spelling plus pointer stars, returning the resolved
  // name -- the mangled name for a generic instantiation, `dt.type_str`
  // otherwise. A caller that needs to register this type for later
  // lookup must use the returned name, not `dt.type_str` directly.
  // `.None` when `dt` is a generic instantiation that can't be resolved.
  pub write_type(DataType dt) Option<str> {
    let resolved = self.resolve_type_name(dt);
    if resolved.is_none() {
      ret .None;
    }
    str resolved_name = resolved.unwrap();
    self.write_type_name(resolved_name);
    let rdt = self.resolve_type_subst(dt);
    num ptr_depth = rdt.pointer_depth;
    if ptr_depth == 0 && rdt.flags.is_pointer {
      ptr_depth = 1;
    }
    num i = 0;
    for i < ptr_depth {
      self.state.write("*");
      i = i + 1;
    }
    ret .Some(resolved_name);
  }

  // Strips a declared type name's leading `<alias>__` segment back to
  // the bare name, since an alias's declarations are merged in
  // unqualified. Only strips a real, known alias -- a generic
  // instantiation's mangled name has the same `X__Y` shape but never
  // matches one.
  strip_known_alias_prefix(str type_str) str {
    for alias : self.import_aliases {
      StringBuilder pfx = string_builder_init(16);
      pfx.append(alias);
      pfx.append("__");
      str prefix = pfx.build();
      if starts_with(type_str, prefix) {
        ret strip_prefix(type_str, prefix);
      }
    }
    ret type_str;
  }

  // The name-resolution half of `write_type`, for a caller that needs
  // `dt`'s resolved name (triggering monomorphization) without writing
  // its C spelling.
  resolve_type_name(DataType dt) Option<str> {
    dt.type_str = self.strip_known_alias_prefix(dt.type_str);
    let rdt = self.resolve_type_subst(dt);
    if rdt.generic_args.len == 0 {
      ret .Some(rdt.type_str);
    }
    let compound_inst = self.ensure_compound_instantiated(rdt);
    if compound_inst.is_some() {
      ret compound_inst;
    }
    let enum_inst = self.ensure_enum_instantiated(rdt);
    if enum_inst.is_some() {
      ret enum_inst;
    }
    // A concrete instantiation of a generic quirk used directly as a
    // type -- neither a compound nor an enum template recognizes it.
    ret self.ensure_quirk_instantiated(rdt);
  }

  // Appends a fully-rendered typedef or method definition either at the
  // current tail (when `hoist_insert_pos` is `.None`) or spliced at the
  // tracked earlier position, so a definition triggered from inside a
  // function body lands before the enclosing item rather than nested
  // inside it. Advances `hoist_insert_pos` so a second hoisted
  // definition lands after the first.
  emit_hoisted(str text) {
    if self.hoist_insert_pos.is_none() {
      if self.hoist_scratch_depth > 0 {
        // Nested inside another scratch buffer -- route through the
        // root buffer/position instead of the suspended local one.
        if self.root_hoist_pos.is_none() {
          self.root_state.write(text);
          ret;
        }
        num rpos = self.root_hoist_pos.unwrap();
        str rfull = self.root_state.out.build();
        str rhead = substr(rfull, 0, rpos);
        str rtail = substr(rfull, rpos, len(rfull) - rpos);
        StringBuilder rrebuilt = string_builder_init(len(rfull) + len(text) + 16);
        rrebuilt.append(rhead);
        rrebuilt.append(text);
        rrebuilt.append(rtail);
        self.root_state.out = rrebuilt;
        self.root_hoist_pos = .Some(rpos + len(text));
        self.root_stmt_start_pos = adjust_pos_after_splice(
          self.root_stmt_start_pos,
          rpos,
          len(text)
        );
        ret;
      }
      self.state.write(text);
      ret;
    }
    num pos = self.hoist_insert_pos.unwrap();
    str full = self.state.out.build();
    str head = substr(full, 0, pos);
    str tail = substr(full, pos, len(full) - pos);
    StringBuilder rebuilt = string_builder_init(len(full) + len(text) + 16);
    rebuilt.append(head);
    rebuilt.append(text);
    rebuilt.append(tail);
    self.state.out = rebuilt;
    self.hoist_insert_pos = .Some(pos + len(text));
    // Tracked independently of `hoist_insert_pos`, so it needs the same
    // shift.
    self.current_stmt_start_pos = adjust_pos_after_splice(
      self.current_stmt_start_pos,
      pos,
      len(text)
    );
  }

  // Given a generic compound template's bare name (from a literal with
  // no explicit type arguments) and its initializer fields, infers each
  // type param's concrete binding from whichever field's declared type
  // is a bare occurrence of that param. `.None` when `base_name` isn't a
  // generic template, or a type param can't be inferred from any field.
  infer_generic_compound_init_args(str base_name, Vec<CompoundInitField> init_fields) Option<Vec<DataType *>> {
    num template_idx = 0;
    bin found_tmpl = false;
    for template_idx < self.generic_compound_names.len {
      if equals(self.generic_compound_names.get(template_idx), base_name) {
        found_tmpl = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found_tmpl {
      ret .None;
    }
    let type_params = self.generic_compound_type_params.get(template_idx);
    let tmpl_field_names = self.generic_compound_field_names.get(template_idx);
    let tmpl_field_dtypes = self.generic_compound_field_dtypes.get(template_idx);

    Vec<DataType*> resolved_args;
    resolved_args.init(0);
    for tp : type_params {
      bin tp_found = false;
      str tp_name = "";
      bin tp_is_pointer = false;
      num fi = 0;
      for fi < tmpl_field_names.len {
        if tp_found {
          break;
        }
        let tfdt = tmpl_field_dtypes.get(fi);
        if equals(tfdt.type_str, tp) && tfdt.generic_args.len == 0 {
          let fname = tmpl_field_names.get(fi);
          num ii = 0;
          for ii < init_fields.len {
            let ifield = init_fields.get(ii);
            if equals(ifield.name, fname) {
              let inferred_name = self.infer_arg_type_name(ifield.value);
              if inferred_name.is_some() {
                tp_name = inferred_name.unwrap();
                tp_is_pointer = self.infer_arg_is_pointer(ifield.value);
                tp_found = true;
              }
            }
            ii = ii + 1;
          }
        }
        fi = fi + 1;
      }
      if !tp_found {
        ret .None;
      }
      DataType* tp_dt = malloc(sizeof(DataType));
      *tp_dt = dtype_new();
      tp_dt.type_str = tp_name;
      if tp_is_pointer {
        tp_dt.pointer_depth = 1;
      }
      resolved_args.push(tp_dt);
    }
    ret .Some(resolved_args);
  }

  // Resolves and, the first time this exact instantiation is seen,
  // emits the concrete monomorphized C struct for a generic compound
  // (`Box<num>` -> `Box__num`), mangled as `<base>__<arg1>__<arg2>...`
  // with a `_ptrN` suffix for a pointer argument. A nested generic
  // argument resolves (and emits) first, recursing to arbitrary depth.
  // `.None` when `dt.type_str` isn't a known generic compound template,
  // the argument count doesn't match, or a nested argument can't be
  // resolved. A field must be a bare occurrence of a type param to be
  // substituted; anything else is left unchanged.
  ensure_compound_instantiated(DataType dt) Option<str> {
    num template_idx = 0;
    bin found = false;
    for template_idx < self.generic_compound_names.len {
      if equals(self.generic_compound_names.get(template_idx), dt.type_str) {
        found = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found {
      ret .None;
    }

    let type_params = self.generic_compound_type_params.get(template_idx);
    if type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder name_sb = string_builder_init(16);
    name_sb.append(dt.type_str);
    Vec<str> arg_type_names;
    arg_type_names.init(0);
    Vec<bin> arg_is_pointer;
    arg_is_pointer.init(0);
    Vec<DataType*> arg_dtypes;
    arg_dtypes.init(0);
    num ai = 0;
    for ai < dt.generic_args.len {
      let arg = dt.generic_args.get(ai);
      str arg_name = arg.type_str;
      if arg.generic_args.len > 0 {
        // A nested generic argument resolves (and, on first use, emits)
        // first, so it's already hoisted before the outer type's own
        // mangled name is built.
        let nested_name = self.resolve_type_name(*arg);
        if nested_name.is_none() {
          ret .None;
        }
        arg_name = nested_name.unwrap();
      }
      name_sb.append("__");
      name_sb.append(arg_name);
      bin arg_ptr = dtype_is_pointer(*arg);
      if arg_ptr {
        name_sb.append("_ptr");
        name_sb.append(format_num(arg.pointer_depth));
      }
      arg_type_names.push(arg_name);
      arg_is_pointer.push(arg_ptr);
      // Keeps the argument's full structural type, not just its
      // flattened name, for a further-generic argument.
      arg_dtypes.push(arg);
      ai = ai + 1;
    }
    str mangled_name = name_sb.build();

    num ei = 0;
    for ei < self.emitted_generic_instantiations.len {
      if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
        ret .Some(mangled_name);
      }
      ei = ei + 1;
    }
    // Registered before the struct body is resolved: a self-referential
    // field resolves its own type via `resolve_type_name` in pass 1
    // below, which recurses back into this function for the same
    // mangled name -- registering only at the end would recurse forever.
    self.emitted_generic_instantiations.push(mangled_name);
    let field_names = self.generic_compound_field_names.get(template_idx);
    let field_type_names = self.generic_compound_field_type_names.get(template_idx);
    let field_is_pointer = self.generic_compound_field_is_pointer.get(template_idx);
    let field_dtypes = self.generic_compound_field_dtypes.get(template_idx);
    // Forward-declares the struct name immediately when the template is
    // directly self-referential, so a field like `Box<T>* next;` inside
    // `compound Box<T>` has a type name to reference before its own full
    // body is written below.
    bin is_self_referential = false;
    for fdt : field_dtypes {
      if equals(fdt.type_str, dt.type_str) {
        is_self_referential = true;
      }
    }
    if is_self_referential {
      StringBuilder fwd_sb = string_builder_init(32);
      fwd_sb.append("typedef struct ");
      fwd_sb.append(mangled_name);
      fwd_sb.append(" ");
      fwd_sb.append(mangled_name);
      fwd_sb.append(";\n");
      self.emit_hoisted(fwd_sb.build());
    }

    Vec<str> resolved_field_names;
    resolved_field_names.init(0);
    Vec<str> resolved_field_type_names;
    resolved_field_type_names.init(0);
    Vec<bin> resolved_field_is_pointer;
    resolved_field_is_pointer.init(0);
    // The actual star count for each field's C declaration, needed
    // because an array-decayed field substituting a pointer-typed
    // argument needs both the array decay's own star and the argument's
    // pointer depth (e.g. `Vec<Node*>`'s `data` field is `Node** data;`).
    Vec<num> resolved_field_ptr_depth;
    resolved_field_ptr_depth.init(0);

    // Pass 1: resolve every field's substituted type before `self.state`
    // is swapped to the scratch buffer below, so a nested instantiation
    // triggered along the way still splices against the real buffer
    // rather than the in-progress scratch one.
    num fi = 0;
    for fi < field_names.len {
      str ftype = field_type_names.get(fi);
      bin fptr = field_is_pointer.get(fi);
      str resolved_type = ftype;
      bin resolved_ptr = fptr;
      bin matched_bare_param = false;
      num ptr_depth = 0;
      if fptr {
        ptr_depth = 1;
      }
      num pi = 0;
      for pi < type_params.len {
        if equals(type_params.get(pi), ftype) {
          resolved_type = arg_type_names.get(pi);
          // `fptr` carries the field's own array-decay pointer-ness,
          // independent of whether this particular argument is itself
          // pointer-shaped.
          resolved_ptr = arg_is_pointer.get(pi) || fptr;
          // The argument's own pointer depth stacks on top of the array
          // decay's single level.
          let matched_arg = arg_dtypes.get(pi);
          ptr_depth = ptr_depth + matched_arg.pointer_depth;
          matched_bare_param = true;
          break;
        }
        pi = pi + 1;
      }
      // `ftype` only ever records a field's bare base name, dropping its
      // own generic args -- `field_dtypes` keeps the full type, letting
      // this reuse the same substitution machinery a generic impl
      // method's own body gets.
      if !matched_bare_param {
        let field_dt = field_dtypes.get(fi);
        if field_dt.generic_args.len > 0 {
          let prev_params = self.type_subst_param_names;
          let prev_arg_names = self.type_subst_arg_type_strs;
          let prev_arg_ptrs = self.type_subst_arg_is_pointer;
          self.type_subst_param_names = type_params;
          self.type_subst_arg_type_strs = arg_type_names;
          self.type_subst_arg_is_pointer = arg_is_pointer;
          let nested_name = self.resolve_type_name(*field_dt);
          self.type_subst_param_names = prev_params;
          self.type_subst_arg_type_strs = prev_arg_names;
          self.type_subst_arg_is_pointer = prev_arg_ptrs;
          if nested_name.is_some() {
            resolved_type = nested_name.unwrap();
            resolved_ptr = dtype_is_pointer(*field_dt) || fptr;
            if resolved_ptr {
              ptr_depth = 1;
            }
          }
        }
      }
      resolved_field_names.push(field_names.get(fi));
      resolved_field_type_names.push(resolved_type);
      resolved_field_is_pointer.push(resolved_ptr);
      resolved_field_ptr_depth.push(ptr_depth);
      fi = fi + 1;
    }

    // Pass 2: write the struct body verbatim from the already-resolved
    // vectors above -- no further resolution (and so no further
    // recursive instantiation) happens while `self.state` is swapped.
    CodegenState typedef_scratch = codegen_state_new();
    CodegenState* saved_state = self.state;
    self.state = &typedef_scratch;
    self.state.write("typedef struct ");
    self.state.write(mangled_name);
    self.state.write(" {\n");
    num wi = 0;
    for wi < resolved_field_names.len {
      self.state.write("  ");
      self.write_type_name(resolved_field_type_names.get(wi));
      // Uses the field's real star count, not `resolved_field_is_
      // pointer`'s single boolean.
      num pdi = 0;
      for pdi < resolved_field_ptr_depth.get(wi) {
        self.state.write("*");
        pdi = pdi + 1;
      }
      self.state.write(" ");
      self.state.write(resolved_field_names.get(wi));
      self.state.write(";\n");
      wi = wi + 1;
    }
    self.state.write("} ");
    self.state.write(mangled_name);
    self.state.write(";\n\n");
    self.state = saved_state;
    self.emit_hoisted(typedef_scratch.out.build());

    self.record_compound(
      mangled_name,
      resolved_field_names,
      resolved_field_type_names,
      resolved_field_is_pointer
    );
    self.maybe_instantiate_generic_impl_methods(
      dt.type_str,
      mangled_name,
      arg_type_names,
      arg_is_pointer,
      arg_dtypes
    );
    ret .Some(mangled_name);
  }

  // Resolves and, the first time this exact instantiation is seen,
  // emits the concrete monomorphized C enum/tagged-union for a generic
  // enum (`Option<num>` -> `Option__num`). Mirrors `ensure_compound_
  // instantiated` almost exactly; the difference is only in what gets
  // emitted per variant.
  ensure_enum_instantiated(DataType dt) Option<str> {
    num template_idx = 0;
    bin found = false;
    for template_idx < self.generic_enum_names.len {
      if equals(self.generic_enum_names.get(template_idx), dt.type_str) {
        found = true;
        break;
      }
      template_idx = template_idx + 1;
    }
    if !found {
      ret .None;
    }

    let type_params = self.generic_enum_type_params.get(template_idx);
    if type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder name_sb = string_builder_init(16);
    name_sb.append(dt.type_str);
    Vec<str> arg_type_names;
    arg_type_names.init(0);
    Vec<bin> arg_is_pointer;
    arg_is_pointer.init(0);
    Vec<DataType*> arg_dtypes;
    arg_dtypes.init(0);
    num ai = 0;
    for ai < dt.generic_args.len {
      let arg = dt.generic_args.get(ai);
      str arg_name = arg.type_str;
      if arg.generic_args.len > 0 {
        // A nested generic argument resolves first, recursing to
        // arbitrary depth.
        let nested_name = self.resolve_type_name(*arg);
        if nested_name.is_none() {
          ret .None;
        }
        arg_name = nested_name.unwrap();
      }
      name_sb.append("__");
      name_sb.append(arg_name);
      bin arg_ptr = dtype_is_pointer(*arg);
      if arg_ptr {
        name_sb.append("_ptr");
        name_sb.append(format_num(arg.pointer_depth));
      }
      arg_type_names.push(arg_name);
      arg_is_pointer.push(arg_ptr);
      // See `ensure_compound_instantiated`'s own doc comment for why
      // this position's OWN full, structural `DataType*` is kept
      // alongside the flattened name/pointer-ness above.
      arg_dtypes.push(arg);
      ai = ai + 1;
    }
    str mangled_name = name_sb.build();

    num ei = 0;
    for ei < self.emitted_generic_instantiations.len {
      if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
        ret .Some(mangled_name);
      }
      ei = ei + 1;
    }
    // Pushed BEFORE the enum body is actually resolved/written, AND
    // forward-declared immediately WHEN self-referential -- see
    // `ensure_compound_instantiated`'s own identical fix/doc comment for
    // why and for the exact same gating (avoids an extra forward-declare
    // line for the ordinary, non-recursive case, which several hand-
    // built unit tests assert the exact byte output for).
    self.emitted_generic_instantiations.push(mangled_name);
    let variant_templates = self.generic_enum_variants.get(template_idx);
    bin enum_is_self_referential = false;
    for vt : variant_templates {
      for pt : vt.payload_type_strs {
        if equals(pt, dt.type_str) {
          enum_is_self_referential = true;
        }
      }
    }
    if enum_is_self_referential {
      StringBuilder efwd_sb = string_builder_init(32);
      efwd_sb.append("typedef struct ");
      efwd_sb.append(mangled_name);
      efwd_sb.append(" ");
      efwd_sb.append(mangled_name);
      efwd_sb.append(";\n");
      self.emit_hoisted(efwd_sb.build());
    }

    bin is_tagged_union = false;
    for vt : variant_templates {
      if vt.has_payload {
        is_tagged_union = true;
      }
    }

    Vec<str> variant_names;
    variant_names.init(0);
    for vt : variant_templates {
      variant_names.push(vt.name);
    }

    CodegenState enum_scratch = codegen_state_new();
    CodegenState* saved_enum_state = self.state;
    self.state = &enum_scratch;
    if is_tagged_union {
      self.emit_tagged_union_enum_instance(
        mangled_name,
        variant_templates,
        type_params,
        arg_type_names,
        arg_is_pointer
      );
    } else {
      self.state.write("typedef enum ");
      self.state.write(mangled_name);
      self.state.write(" {\n");
      for vt : variant_templates {
        self.state.write("  ");
        self.state.write(mangled_name);
        self.state.write("_");
        self.state.write(vt.name);
        self.state.write(",\n");
      }
      self.state.write("} ");
      self.state.write(mangled_name);
      self.state.write(";\n\n");
    }
    self.state = saved_enum_state;
    self.emit_hoisted(enum_scratch.out.build());

    self.record_enum(mangled_name, variant_names, is_tagged_union);
    self.maybe_instantiate_generic_impl_methods(
      dt.type_str,
      mangled_name,
      arg_type_names,
      arg_is_pointer,
      arg_dtypes
    );
    ret .Some(mangled_name);
  }

  // Resolves and, the first time this exact instantiation is seen,
  // emits a concrete generic-quirk instantiation's vtable struct/fat
  // pointer type, deriving each method's signature from the quirk's own
  // declaration. Needed for a type reference to a concrete quirk
  // instantiation with no impl in the current translation unit. `.None`
  // when `dt.type_str` doesn't name a registered generic quirk, or the
  // argument count doesn't match.
  ensure_quirk_instantiated(DataType dt) Option<str> {
    num qdi = 0;
    bin qfound = false;
    for qdi < self.quirk_decl_names.len {
      if equals(self.quirk_decl_names.get(qdi), dt.type_str) {
        qfound = true;
        break;
      }
      qdi = qdi + 1;
    }
    if !qfound {
      ret .None;
    }
    let q_type_params = self.quirk_decl_type_params.get(qdi);
    if q_type_params.len != dt.generic_args.len {
      ret .None;
    }

    StringBuilder qname_sb = string_builder_init(16);
    qname_sb.append(dt.type_str);
    Vec<str> q_arg_type_names;
    q_arg_type_names.init(0);
    Vec<bin> q_arg_is_pointer;
    q_arg_is_pointer.init(0);
    for qarg : dt.generic_args {
      qname_sb.append("__");
      qname_sb.append(qarg.type_str);
      q_arg_type_names.push(qarg.type_str);
      q_arg_is_pointer.push(dtype_is_pointer(*qarg));
    }
    str q_mangled = qname_sb.build();

    if self.quirk_names.contains(q_mangled) {
      ret .Some(q_mangled);
    }

    let q_methods = self.quirk_decl_methods.get(qdi);

    let prev_params = self.type_subst_param_names;
    let prev_arg_names = self.type_subst_arg_type_strs;
    let prev_arg_ptrs = self.type_subst_arg_is_pointer;
    self.type_subst_param_names = q_type_params;
    self.type_subst_arg_type_strs = q_arg_type_names;
    self.type_subst_arg_is_pointer = q_arg_is_pointer;

    CodegenState qvt_scratch = codegen_state_new();
    CodegenState* saved_qvt_state = self.state;
    self.state = &qvt_scratch;
    self.state.write("typedef struct ");
    self.state.write(q_mangled);
    self.state.write("_vtable ");
    self.state.write(q_mangled);
    self.state.write("_vtable;\n");
    self.state.write("struct ");
    self.state.write(q_mangled);
    self.state.write("_vtable {\n");
    bin q_write_err = false;
    for qm : q_methods {
      self.state.write("  ");
      if qm.rtype != nil {
        let qwt = self.write_type(*qm.rtype);
        if qwt.is_none() {
          q_write_err = true;
        }
      } else {
        self.state.write("void");
      }
      self.state.write(" (*");
      self.state.write(qm.name);
      self.state.write(")(void* self");
      for qarg3 : qm.args {
        self.state.write(", ");
        let qpwt = self.write_type(*qarg3.dtype);
        if qpwt.is_none() {
          q_write_err = true;
        }
      }
      self.state.write(");\n");
    }
    self.state.write("};\n");
    self.state.write("typedef struct ");
    self.state.write(q_mangled);
    self.state.write(" { void* self; const ");
    self.state.write(q_mangled);
    self.state.write("_vtable* vtable; } ");
    self.state.write(q_mangled);
    self.state.write(";\n\n");
    self.state = saved_qvt_state;
    self.type_subst_param_names = prev_params;
    self.type_subst_arg_type_strs = prev_arg_names;
    self.type_subst_arg_is_pointer = prev_arg_ptrs;
    if q_write_err {
      ret .None;
    }
    self.emit_hoisted(qvt_scratch.out.build());
    self.quirk_names.push(q_mangled);
    ret .Some(q_mangled);
  }

  // Emits a monomorphized generic impl method's C prototype only (no
  // body), so `maybe_instantiate_generic_impl_methods` can forward-
  // declare every method of an instantiation before any of their bodies
  // -- one method's body can call another declared later in the source.
  // Doesn't reuse `emit_function_param`, which also registers each
  // param as a known local.
  emit_generic_impl_method_prototype(Node m, str new_name) Option<CodegenErrorKind> {
    fit m.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        let rt = self.write_type(*f.rtype);
        if rt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write(" ");
        self.state.write(new_name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  let sig = v.var_type.fn_sig;
                  let prt = self.write_type(*sig.rtype);
                  if prt.is_none() {
                    ret .Some(CodegenErrorKind.UnsupportedNode);
                  }
                  self.state.write(" (*");
                  self.state.write(v.name);
                  self.state.write(")(");
                  bin pfirst = true;
                  for p : sig.params {
                    if !pfirst {
                      self.state.write(", ");
                    }
                    pfirst = false;
                    let pt = self.write_type(*p);
                    if pt.is_none() {
                      ret .Some(CodegenErrorKind.UnsupportedNode);
                    }
                  }
                  self.state.write(")");
                } else {
                  // See `emit_function_param`'s own doc comment: an
                  // unsized array parameter's decay star must be added
                  // here too, matching the real definition this prototype
                  // stands in for -- otherwise the two disagree.
                  bin arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
                  let wt = self.write_type(*v.var_type);
                  if wt.is_none() {
                    ret .Some(CodegenErrorKind.UnsupportedNode);
                  }
                  if arr_as_ptr {
                    self.state.write("*");
                  }
                  self.state.write(" ");
                  self.state.write(v.name);
                }
              }
              _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(");\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Forward-declares an async generic impl method's `__fun_async_call_
  // <new_name>` helper, needed when a sibling async method on the same
  // impl calls this one via `await` before its own support block has
  // been emitted anywhere.
  emit_async_call_helper_prototype(Node m, str new_name) Option<CodegenErrorKind> {
    fit m.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.state.write("static ");
        let rt = self.write_type(*f.rtype);
        if rt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write(" __fun_async_call_");
        self.state.write(new_name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  ret .Some(CodegenErrorKind.UnsupportedNode);
                }
                if !first {
                  self.state.write(", ");
                }
                first = false;
                let wt = self.write_type(*v.var_type);
                if wt.is_none() {
                  ret .Some(CodegenErrorKind.UnsupportedNode);
                }
              }
              _ -> {}
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(");\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // True when `dt` can't safely appear in the early function/method
  // forward-declare pass: a plain enum, or a generic instantiation of
  // either kind. Unlike a compound, whose bare name is already forward-
  // declared, C has no way to name an enum without its full definition,
  // and no separate name-only forward-declare for a generic
  // instantiation either.
  prototype_type_is_unsafe_early(DataType dt) bin {
    if dt.generic_args.len > 0 {
      ret true;
    }
    // A concrete impl's own `self` parameter carries an already-mangled
    // bare name with no generic_args, so the check above misses it --
    // detected instead by checking whether the name starts with a
    // registered generic template's own prefix.
    for tmpl_name : self.generic_compound_names {
      StringBuilder tmpl_pfx2 = string_builder_init(16);
      tmpl_pfx2.append(tmpl_name);
      tmpl_pfx2.append("__");
      if starts_with(dt.type_str, tmpl_pfx2.build()) {
        ret true;
      }
    }
    for tmpl_name2 : self.generic_enum_names {
      StringBuilder tmpl_pfx3 = string_builder_init(16);
      tmpl_pfx3.append(tmpl_name2);
      tmpl_pfx3.append("__");
      if starts_with(dt.type_str, tmpl_pfx3.build()) {
        ret true;
      }
    }
    for n : self.all_nodes {
      fit n.kind {
        .Enum(e) -> {
          if equals(e.name, dt.type_str) {
            ret true;
          }
        }
        // A quirk name's own C typedef (the vtable/fat-pointer struct)
        // isn't emitted until its FIRST concrete impl is processed, in
        // the LATER combined pass (see `emit_quirk_vtable_machinery`'s
        // own doc comment) -- unsafe here for the exact same reason a
        // plain enum is: this early pass would forward-declare a
        // signature naming a type that doesn't exist yet. A GENERIC
        // quirk has no monomorphic struct to speak of at all, so it's
        // never actually reachable as a real return/param type here
        // either way -- excluded for clarity, not correctness.
        .Quirk(q) -> {
          if !q.is_generic && equals(q.name, dt.type_str) {
            ret true;
          }
        }
        _ -> {}
      }
    }
    ret false;
  }

  // True when EVERY one of `n`'s (a `Function` node's) own declared
  // param/return types is safe for the early forward-declare pass --
  // see `prototype_type_is_unsafe_early`'s own doc comment. A function-
  // pointer-typed parameter (`v.var_type.has_fn_sig`) is treated as
  // always safe without inspecting its own nested param/return types --
  // rare in practice, and always pointer-shaped at the OUTER level
  // regardless, so not worth the extra recursion until a real failure
  // shows otherwise.
  function_prototype_is_safe_early(Node n) bin {
    fit n.kind {
      .Function(f) -> {
        if f.has_rtype && self.prototype_type_is_unsafe_early(*f.rtype) {
          ret false;
        }
        if f.has_args {
          for arg : f.args {
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  continue;
                }
                if self.prototype_type_is_unsafe_early(*v.var_type) {
                  ret false;
                }
              }
              _ -> {}
            }
          }
        }
        ret true;
      }
      _ -> { ret false; }
    }
  }

  // Forward-declares a PLAIN (non-generic) top-level function's OR
  // plain impl method's own C prototype, under its OWN real name --
  // for a method, that's ALREADY the parser's own pre-mangled `Type__
  // method` name (see `emit_impl`'s doc comment), so no separate
  // mangled-name computation is needed the way a GENERIC impl's own
  // per-instantiation mangling requires. Reuses `emit_generic_impl_
  // method_prototype`'s identical param-writing logic (that function
  // takes the callee's own name as an explicit argument rather than
  // reading it off the node, precisely so this can share it).
  emit_function_prototype(Node n) Option<CodegenErrorKind> {
    fit n.kind {
      .Function(f) -> { ret self.emit_generic_impl_method_prototype(n, f.name); }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Records the instantiation's substitution context and each method's
  // substituted return/param types, without emitting any C -- a
  // template method's body may only type-check for some of the concrete
  // types it could be instantiated with, so the body itself is emitted
  // lazily, on first call, by `ensure_generic_impl_method_emitted`.
  maybe_instantiate_generic_impl_methods(
    str base_name,
    str mangled_name,
    Vec<str> arg_type_names,
    Vec<bin> arg_is_pointer,
    Vec<DataType*> arg_dtypes
  ) {
    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if equals(i.type_name, base_name) && i.type_params.len == arg_type_names.len && impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            self.instantiation_mangled_name.push(mangled_name);
            self.instantiation_base_name.push(base_name);
            self.instantiation_arg_type_names.push(arg_type_names);
            self.instantiation_arg_is_pointer.push(arg_is_pointer);
            self.instantiation_arg_dtypes.push(arg_dtypes);

            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            let prev_arg_dtypes = self.type_subst_arg_dtypes;
            self.type_subst_param_names = i.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_dtypes = arg_dtypes;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            StringBuilder pfx = string_builder_init(16);
            pfx.append(i.type_name);
            pfx.append("__");
            if i.has_quirk_name {
              pfx.append(i.quirk_name);
              pfx.append("__");
            }
            str prefix = pfx.build();

            for m : i.methods {
              str tmpl_name = "";
              DataType* tmpl_rtype = nil;
              Vec<DataType*> tmpl_param_dtypes;
              tmpl_param_dtypes.init(0);
              // Each param's default value expression, `nil` when it has
              // none. Needs no substitution -- it's evaluated fresh at
              // the call site.
              Vec<Node*> tmpl_default_values;
              tmpl_default_values.init(0);
              fit m.kind {
                .Function(fnv) -> {
                  tmpl_name = fnv.name;
                  if fnv.has_rtype {
                    tmpl_rtype = fnv.rtype;
                  }
                  if fnv.has_args {
                    bin skipped_tmpl_self = false;
                    for arg : fnv.args {
                      if !skipped_tmpl_self {
                        skipped_tmpl_self = true;
                        continue;
                      }
                      fit arg.kind {
                        .Variable(v) -> {
                          tmpl_param_dtypes.push(v.var_type);
                          if v.has_val {
                            tmpl_default_values.push(v.val);
                          } else {
                            tmpl_default_values.push(nil);
                          }
                        }
                        _ -> {}
                      }
                    }
                  }
                }
                _ -> {}
              }
              let bare_name = strip_prefix(tmpl_name, prefix);

              StringBuilder nb = string_builder_init(16);
              nb.append(mangled_name);
              nb.append("__");
              if i.has_quirk_name {
                nb.append(i.quirk_name);
                nb.append("__");
              }
              nb.append(bare_name);
              str new_name = nb.build();

              // The template's declared return type, substituted against
              // this instantiation's concrete binding, so a `let`
              // binding can resolve against a monomorphized method's
              // return type too.
              DataType* recorded_rtype = nil;
              if tmpl_rtype != nil {
                DataType substituted_rtype = self.resolve_type_subst(*tmpl_rtype);
                recorded_rtype = malloc(sizeof(DataType));
                *recorded_rtype = substituted_rtype;
              }
              // Each param's substituted type too.
              Vec<DataType*> recorded_param_types;
              recorded_param_types.init(0);
              for pdt : tmpl_param_dtypes {
                DataType substituted_pdt = self.resolve_type_subst(*pdt);
                DataType* recorded_pdt = malloc(sizeof(DataType));
                *recorded_pdt = substituted_pdt;
                recorded_param_types.push(recorded_pdt);
              }
              self.record_impl_method(
                mangled_name,
                bare_name,
                new_name,
                recorded_rtype,
                recorded_param_types,
                tmpl_default_values
              );
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
            self.type_subst_arg_dtypes = prev_arg_dtypes;
          }
        }
        _ -> {}
      }
    }
  }

  // Writes one generic impl method's prototype immediately, wherever
  // `self.state` currently is -- a bare declaration is legal C at block
  // scope regardless of nesting depth. Called before the method's body
  // is queued for deferred emission, so its own body can call another
  // not-yet-bodied method of the same instantiation and still compile.
  // A silent no-op when `owner_type` isn't a known instantiation, or
  // while `self.state` points at a throwaway text-capture probe.
  emit_generic_impl_method_prototype_now(str owner_type, str bare_name) {
    num ii = 0;
    bin found_inst = false;
    for ii < self.instantiation_mangled_name.len {
      if equals(self.instantiation_mangled_name.get(ii), owner_type) {
        found_inst = true;
        break;
      }
      ii = ii + 1;
    }
    if !found_inst {
      ret;
    }
    str base_name = self.instantiation_base_name.get(ii);
    let arg_type_names = self.instantiation_arg_type_names.get(ii);
    let arg_is_pointer = self.instantiation_arg_is_pointer.get(ii);
    let arg_dtypes = self.instantiation_arg_dtypes.get(ii);

    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) || i.type_params.len != arg_type_names.len {
            continue;
          }
          if !impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            continue;
          }
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          if i.has_quirk_name {
            pfx.append(i.quirk_name);
            pfx.append("__");
          }
          str prefix = pfx.build();

          for m : i.methods {
            str tmpl_name = "";
            fit m.kind {
              .Function(fnv) -> { tmpl_name = fnv.name; }
              _ -> {}
            }
            if !equals(strip_prefix(tmpl_name, prefix), bare_name) {
              continue;
            }

            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            let prev_arg_dtypes = self.type_subst_arg_dtypes;
            self.type_subst_param_names = i.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_dtypes = arg_dtypes;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            StringBuilder nb = string_builder_init(16);
            nb.append(owner_type);
            nb.append("__");
            if i.has_quirk_name {
              nb.append(i.quirk_name);
              nb.append("__");
            }
            nb.append(bare_name);
            str new_name = nb.build();

            // Pre-resolves the method's return/param types before
            // `self.state` swaps to the scratch buffer below, so a
            // generic instantiation triggered by one of them splices its
            // typedef at top level rather than nested inside the scratch.
            fit m.kind {
              .Function(proto_fnv) -> {
                if proto_fnv.has_rtype {
                  self.resolve_type_name(self.resolve_type_subst(*proto_fnv.rtype));
                }
                if proto_fnv.has_args {
                  for proto_arg : proto_fnv.args {
                    fit proto_arg.kind {
                      .Variable(proto_v) -> {
                        if !proto_v.var_type.has_fn_sig {
                          self.resolve_type_name(self.resolve_type_subst(*proto_v.var_type));
                        }
                      }
                      _ -> {}
                    }
                  }
                }
              }
              _ -> {}
            }

            // Built into a scratch buffer, then spliced at the current
            // statement's own start -- writing directly at the live tail
            // would land mid-statement if the triggering call is a
            // sub-expression rather than a bare statement.
            CodegenState proto_scratch = codegen_state_new();
            CodegenState* saved_proto_state = self.state;
            let saved_proto_hoist_pos = self.hoist_insert_pos;
            proto_scratch.indent_level = saved_proto_state.indent_level;
            self.state = &proto_scratch;
            self.hoist_insert_pos = .None;
            self.state.write_indent();
            self.emit_generic_impl_method_prototype(*m, new_name);
            self.state = saved_proto_state;
            let proto_splice_pos = self.current_stmt_start_pos;
            self.hoist_insert_pos = proto_splice_pos;
            str proto_text = proto_scratch.out.build();
            self.emit_hoisted(proto_text);
            // `saved_proto_hoist_pos` is a plain captured local, so it
            // needs the same shift `emit_hoisted` only applies
            // automatically to `current_stmt_start_pos`.
            if proto_splice_pos.is_some() {
              saved_proto_hoist_pos = adjust_pos_after_splice(
                saved_proto_hoist_pos,
                proto_splice_pos.unwrap(),
                len(proto_text)
              );
            }
            self.hoist_insert_pos = saved_proto_hoist_pos;

            // An async method's own call-helper forward declaration is
            // `static`, which C forbids at block scope -- spliced at the
            // real top-level position instead.
            fit m.kind {
              .Function(proto_async_fnv) -> {
                if proto_async_fnv.is_async {
                  CodegenState async_proto_scratch = codegen_state_new();
                  CodegenState* saved_async_state = self.state;
                  self.state = &async_proto_scratch;
                  self.emit_async_call_helper_prototype(*m, new_name);
                  self.state = saved_async_state;
                  self.emit_hoisted(async_proto_scratch.out.build());
                }
              }
              _ -> {}
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
            self.type_subst_arg_dtypes = prev_arg_dtypes;
            ret;
          }
        }
        _ -> {}
      }
    }
  }

  // Ensures a plain (non-generic) impl method has an inline prototype
  // declared right before its own first call site, when its signature
  // was too unsafe for the early forward-declare pass. A no-op when the
  // method is unknown, its signature is already safe, it already got
  // its own prototype, or `self.state` currently points at a throwaway
  // text-capture probe rather than the real output.
  ensure_plain_impl_method_prototype_emitted(str owner_type, str bare_name) {
    if self.suppress_generic_impl_method_draining {
      ret;
    }
    StringBuilder pm_key_sb = string_builder_init(16);
    pm_key_sb.append(owner_type);
    pm_key_sb.append("::");
    pm_key_sb.append(bare_name);
    str pm_key = pm_key_sb.build();
    num pmki = 0;
    for pmki < self.emitted_plain_method_protos.len {
      if equals(self.emitted_plain_method_protos.get(pmki), pm_key) {
        ret;
      }
      pmki = pmki + 1;
    }

    num pmi = 0;
    bin found_pm = false;
    for pmi < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(pmi), owner_type) && equals(
        self.impl_method_bare_name.get(pmi),
        bare_name
      ) {
        found_pm = true;
        break;
      }
      pmi = pmi + 1;
    }
    if !found_pm {
      ret;
    }
    DataType* pm_rtype = self.impl_method_rtype.get(pmi);
    if pm_rtype == nil {
      ret;
    }
    let pm_param_types = self.impl_method_param_types.get(pmi);
    for pm_pt : pm_param_types {
      if pm_pt.has_fn_sig {
        ret;
      }
    }

    // The receiver's own type needs the same "plain enum, not yet
    // defined this early" check as any other param -- `impl_method_
    // param_types` excludes the implicit `self`. Narrower than
    // `prototype_type_is_unsafe_early` itself: only the plain-enum/
    // quirk-name check, since a mangled generic instantiation is
    // already handled by a separate, correct path.
    bin pm_owner_unsafe = false;
    for pm_owner_n : self.all_nodes {
      fit pm_owner_n.kind {
        .Enum(pm_oe) -> {
          if equals(pm_oe.name, owner_type) {
            pm_owner_unsafe = true;
          }
        }
        .Quirk(pm_oq) -> {
          if !pm_oq.is_generic && equals(pm_oq.name, owner_type) {
            pm_owner_unsafe = true;
          }
        }
        _ -> {}
      }
    }
    bin pm_unsafe = pm_owner_unsafe;
    if !pm_unsafe {
      pm_unsafe = self.prototype_type_is_unsafe_early(*pm_rtype);
    }
    if !pm_unsafe {
      for pm_pt2 : pm_param_types {
        if self.prototype_type_is_unsafe_early(*pm_pt2) {
          pm_unsafe = true;
        }
      }
    }
    if !pm_unsafe {
      ret;
    }

    self.emitted_plain_method_protos.push(pm_key);
    str pm_mangled = self.impl_method_mangled_name.get(pmi);

    // Pre-resolved before swapping to the scratch buffer below, so a
    // generic instantiation triggered by one of these types splices at
    // top level rather than into this throwaway scratch.
    self.resolve_type_name(*pm_rtype);
    for pm_pt3 : pm_param_types {
      self.resolve_type_name(*pm_pt3);
    }

    CodegenState pm_scratch = codegen_state_new();
    CodegenState* saved_pm_state = self.state;
    let saved_pm_hoist_pos = self.hoist_insert_pos;
    pm_scratch.indent_level = saved_pm_state.indent_level;
    self.state = &pm_scratch;
    self.hoist_insert_pos = .None;
    self.state.write_indent();
    let pm_rt = self.write_type(*pm_rtype);
    if pm_rt.is_some() {
      self.state.write(" ");
      self.state.write(pm_mangled);
      self.state.write("(");
      self.state.write(owner_type);
      self.state.write("* self");
      for pm_pt4 : pm_param_types {
        self.state.write(", ");
        self.write_type(*pm_pt4);
      }
      self.state.write(");\n");
    }
    self.state = saved_pm_state;
    // `saved_pm_hoist_pos` is a plain captured local, so it needs manual
    // adjustment for this splice.
    let pm_splice_pos = self.current_stmt_start_pos;
    self.hoist_insert_pos = pm_splice_pos;
    str pm_text = pm_scratch.out.build();
    self.emit_hoisted(pm_text);
    if pm_splice_pos.is_some() {
      saved_pm_hoist_pos = adjust_pos_after_splice(
        saved_pm_hoist_pos,
        pm_splice_pos.unwrap(),
        len(pm_text)
      );
    }
    self.hoist_insert_pos = saved_pm_hoist_pos;
  }

  // Ensures a PLAIN top-level FUNCTION (not an impl method) has an
  // inline bare prototype declared right before its OWN first call
  // site, when its signature was too UNSAFE for the early forward-
  // declare pass to cover it (see `prototype_type_is_unsafe_early`'s own
  // doc comment -- a generic return/param type, e.g. `_dtype_
  // references_any_param(DataType* dt, Vec<str> params)`'s own `Vec<
  // str>` parameter) -- such a function falls back to relying on
  // natural source order, which breaks the moment it's called from
  // another plain function defined EARLIER in the same file (a self-
  // recursive helper, e.g., or a forward-referenced sibling). Mirrors
  // `ensure_plain_impl_method_prototype_emitted` exactly, just sourced
  // from the plain-function registry (`function_rtypes`/`function_
  // param_types`) instead of the impl-method one, and with no `self`
  // param to prepend. See that function's own doc comment for the
  // shared reasoning (suppress-during-probe guard, splice position,
  // memoization, the `has_fn_sig` param bail).
  ensure_plain_function_prototype_emitted(str fn_name) {
    if self.suppress_generic_impl_method_draining {
      ret;
    }
    num pfi = 0;
    for pfi < self.emitted_plain_function_protos.len {
      if equals(self.emitted_plain_function_protos.get(pfi), fn_name) {
        ret;
      }
      pfi = pfi + 1;
    }

    num fi = 0;
    bin found_pf = false;
    for fi < self.function_names.len {
      if equals(self.function_names.get(fi), fn_name) {
        found_pf = true;
        break;
      }
      fi = fi + 1;
    }
    if !found_pf {
      ret;
    }
    DataType* pf_rtype = self.function_rtypes.get(fi);
    if pf_rtype == nil {
      ret;
    }
    let pf_param_types = self.function_param_types.get(fi);
    for pf_pt : pf_param_types {
      if pf_pt.has_fn_sig {
        ret;
      }
    }

    bin pf_unsafe = self.prototype_type_is_unsafe_early(*pf_rtype);
    if !pf_unsafe {
      for pf_pt2 : pf_param_types {
        if self.prototype_type_is_unsafe_early(*pf_pt2) {
          pf_unsafe = true;
        }
      }
    }
    if !pf_unsafe {
      ret;
    }

    self.emitted_plain_function_protos.push(fn_name);

    self.resolve_type_name(*pf_rtype);
    for pf_pt3 : pf_param_types {
      self.resolve_type_name(*pf_pt3);
    }

    CodegenState pf_scratch = codegen_state_new();
    CodegenState* saved_pf_state = self.state;
    let saved_pf_hoist_pos = self.hoist_insert_pos;
    pf_scratch.indent_level = saved_pf_state.indent_level;
    self.state = &pf_scratch;
    self.hoist_insert_pos = .None;
    self.state.write_indent();
    let pf_rt = self.write_type(*pf_rtype);
    if pf_rt.is_some() {
      self.state.write(" ");
      self.state.write(fn_name);
      self.state.write("(");
      bin pf_first = true;
      for pf_pt4 : pf_param_types {
        if !pf_first {
          self.state.write(", ");
        }
        pf_first = false;
        self.write_type(*pf_pt4);
      }
      if pf_first {
        self.state.write("void");
      }
      self.state.write(");\n");
    }
    self.state = saved_pf_state;
    // See `adjust_pos_after_splice`'s own doc comment for why
    // `saved_pf_hoist_pos` needs manual adjustment here too.
    let pf_splice_pos = self.current_stmt_start_pos;
    self.hoist_insert_pos = pf_splice_pos;
    str pf_text = pf_scratch.out.build();
    self.emit_hoisted(pf_text);
    if pf_splice_pos.is_some() {
      saved_pf_hoist_pos = adjust_pos_after_splice(
        saved_pf_hoist_pos,
        pf_splice_pos.unwrap(),
        len(pf_text)
      );
    }
    self.hoist_insert_pos = saved_pf_hoist_pos;
  }

  // Lazily emits one concrete monomorphization of a generic impl
  // method's prototype and body, called from every generic-impl-method
  // call site, so a method is only emitted for the instantiations
  // actually called. Enqueues rather than emitting and recursing
  // directly, draining the queue only when not already draining, since
  // a queued method's body may call another not-yet-emitted method
  // while `self.state` is still the outer method's in-progress scratch
  // buffer. `.None` when `owner_type` isn't a known generic
  // instantiation.
  ensure_generic_impl_method_emitted(str owner_type, str bare_name) Option<CodegenErrorKind> {
    StringBuilder key_sb = string_builder_init(16);
    key_sb.append(owner_type);
    key_sb.append("::");
    key_sb.append(bare_name);
    str key = key_sb.build();
    num ei = 0;
    for ei < self.emitted_generic_impl_methods.len {
      if equals(self.emitted_generic_impl_methods.get(ei), key) {
        ret .None;
      }
      ei = ei + 1;
    }
    // Pushed before this entry is processed, so a self-recursive call
    // sees "already handled" rather than recursing forever.
    self.emitted_generic_impl_methods.push(key);
    bin proto_written = !self.suppress_generic_impl_method_draining;
    if proto_written {
      self.emit_generic_impl_method_prototype_now(owner_type, bare_name);
    }
    self.pending_generic_impl_method_owner.push(owner_type);
    self.pending_generic_impl_method_bare.push(bare_name);
    self.pending_generic_impl_method_proto_written.push(proto_written);

    // Also deferred while `self.state` points at a throwaway probe --
    // the probe itself drains this queue once it restores the real
    // buffer.
    if self.draining_generic_impl_methods || self.suppress_generic_impl_method_draining {
      ret .None;
    }
    ret self.drain_pending_generic_impl_methods();
  }

  // Processes every queued (owner, bare name) pair. Safe to call
  // directly against `self.state`/`self.hoist_insert_pos`, provided the
  // caller has already ensured those are the real ones.
  drain_pending_generic_impl_methods() Option<CodegenErrorKind> {
    self.draining_generic_impl_methods = true;
    // Not saved/restored around the whole drain: each splice this loop
    // makes legitimately advances `current_stmt_start_pos`, and
    // restoring it to the pre-drain value would undo that.
    Option<CodegenErrorKind> first_err = .None;
    num qi = self.pending_generic_impl_method_cursor;
    for qi < self.pending_generic_impl_method_owner.len {
      let q_owner = self.pending_generic_impl_method_owner.get(qi);
      let q_bare = self.pending_generic_impl_method_bare.get(qi);
      if !self.pending_generic_impl_method_proto_written.get(qi) {
        self.emit_generic_impl_method_prototype_now(q_owner, q_bare);
      }
      let err = self.emit_one_generic_impl_method(q_owner, q_bare);
      if err.is_some() && first_err.is_none() {
        first_err = err;
      }
      qi = qi + 1;
      self.pending_generic_impl_method_cursor = qi;
    }
    self.draining_generic_impl_methods = false;
    ret first_err;
  }

  // Emits the body for one queued (owner, bare name) pair; the
  // prototype is already written by now.
  emit_one_generic_impl_method(str owner_type, str bare_name) Option<CodegenErrorKind> {
    num ii = 0;
    bin found_inst = false;
    for ii < self.instantiation_mangled_name.len {
      if equals(self.instantiation_mangled_name.get(ii), owner_type) {
        found_inst = true;
        break;
      }
      ii = ii + 1;
    }
    if !found_inst {
      ret .None;
    }
    str base_name = self.instantiation_base_name.get(ii);
    let arg_type_names = self.instantiation_arg_type_names.get(ii);
    let arg_is_pointer = self.instantiation_arg_is_pointer.get(ii);
    let arg_dtypes = self.instantiation_arg_dtypes.get(ii);

    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) || i.type_params.len != arg_type_names.len {
            continue;
          }
          if !impl_allows_generic_args(
            i.has_type_param_forced_insts,
            i.type_param_forced_insts,
            arg_dtypes
          ) {
            continue;
          }
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          if i.has_quirk_name {
            pfx.append(i.quirk_name);
            pfx.append("__");
          }
          str prefix = pfx.build();

          for m : i.methods {
            str tmpl_name = "";
            fit m.kind {
              .Function(fnv) -> { tmpl_name = fnv.name; }
              _ -> {}
            }
            if !equals(strip_prefix(tmpl_name, prefix), bare_name) {
              continue;
            }

            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            let prev_arg_dtypes = self.type_subst_arg_dtypes;
            self.type_subst_param_names = i.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_dtypes = arg_dtypes;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            StringBuilder nb = string_builder_init(16);
            nb.append(owner_type);
            nb.append("__");
            if i.has_quirk_name {
              nb.append(i.quirk_name);
              nb.append("__");
            }
            nb.append(bare_name);
            str new_name = nb.build();

            CodegenState method_scratch = codegen_state_new();
            CodegenState* saved_method_state = self.state;
            let saved_hoist_pos = self.hoist_insert_pos;
            // `emit_function_named` recurses into `emit_statements`,
            // which sets `current_stmt_start_pos` to positions measured
            // against this scratch buffer -- suspended and restored in
            // lockstep with `hoist_insert_pos` so it can't leak a
            // scratch-relative position to a caller splicing against the
            // real buffer.
            let saved_stmt_start_pos = self.current_stmt_start_pos;
            // Doesn't suppress `suppress_generic_impl_method_draining`:
            // this is only ever called from inside `drain_pending_
            // generic_impl_methods`'s own loop, which already has
            // `draining_generic_impl_methods` set for its whole
            // duration, so a nested trigger just enqueues and the same
            // outer loop picks it up once back at the real buffer.
            let saved_local_names = self.local_names;
            let saved_local_is_pointer = self.local_is_pointer;
            let saved_local_type_name = self.local_type_name;
            let saved_local_dtype = self.local_dtype;
            let saved_fn_rtype_name = self.current_fn_rtype_name;
            let saved_fn_rtype_dt = self.current_fn_rtype_dt;
            let saved_defer_stack = self.defer_stack;
            let saved_defer_scope_starts = self.defer_scope_starts;
            // Participates in the same `hoist_scratch_depth` nesting
            // counter other scratch-buffer swaps use, since this
            // method's body can trigger another one recursively.
            if self.hoist_scratch_depth == 0 {
              self.root_state = self.state;
              self.root_hoist_pos = self.hoist_insert_pos;
              self.root_stmt_start_pos = self.current_stmt_start_pos;
            }
            self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
            self.state = &method_scratch;
            self.hoist_insert_pos = .None;
            self.current_stmt_start_pos = .None;
            let body_err = self.emit_function_named(*m, new_name);
            self.state = saved_method_state;
            self.hoist_insert_pos = saved_hoist_pos;
            self.current_stmt_start_pos = saved_stmt_start_pos;
            self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
            if self.hoist_scratch_depth == 0 {
              // The just-restored local snapshots above can be stale.
              self.hoist_insert_pos = self.root_hoist_pos;
              self.current_stmt_start_pos = self.root_stmt_start_pos;
            }
            self.local_names = saved_local_names;
            self.local_is_pointer = saved_local_is_pointer;
            self.local_type_name = saved_local_type_name;
            self.local_dtype = saved_local_dtype;
            self.current_fn_rtype_name = saved_fn_rtype_name;
            self.current_fn_rtype_dt = saved_fn_rtype_dt;
            self.defer_stack = saved_defer_stack;
            self.defer_scope_starts = saved_defer_scope_starts;
            self.emit_hoisted(method_scratch.out.build());

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;
            self.type_subst_arg_dtypes = prev_arg_dtypes;
            ret body_err;
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // True when `bare_name`, resolved against `owner_type`'s abstract impl
  // template, declares its own generic type parameter(s) on top of the
  // impl's own (`impl Box<T> { pub wrap<U>(U x) Box<U> { ... } }`).
  impl_method_has_own_type_params(str owner_type, str bare_name) bin {
    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          str tpfx = pfx.build();
          if !starts_with(owner_type, tpfx) {
            continue;
          }
          for m : i.methods {
            fit m.kind {
              .Function(fnv) -> {
                if fnv.has_type_params && equals(strip_prefix(fnv.name, tpfx), bare_name) {
                  ret true;
                }
              }
              _ -> {}
            }
          }
        }
        _ -> {}
      }
    }
    ret false;
  }

  // Monomorphizes a method that declares its own generic type param(s),
  // combining the impl's already-known substitution with a fresh one
  // for the method's own param(s), inferred from `args`. A one-shot
  // emission: the whole signature and body are hoisted to the current
  // statement's position, no separate prototype step. Returns the
  // combined mangled name plus the substituted return type, or `.None`
  // when inference fails or `owner_type` isn't a known instantiation.
  maybe_instantiate_generic_impl_method_own_params(str owner_type, str bare_name, Vec<Node*> args) Option<OwnParamCallResolution> {
    num ii = 0;
    bin found_inst = false;
    for ii < self.instantiation_mangled_name.len {
      if equals(self.instantiation_mangled_name.get(ii), owner_type) {
        found_inst = true;
        break;
      }
      ii = ii + 1;
    }
    if !found_inst {
      ret .None;
    }
    str base_name = self.instantiation_base_name.get(ii);
    let impl_arg_type_names = self.instantiation_arg_type_names.get(ii);
    let impl_arg_is_pointer = self.instantiation_arg_is_pointer.get(ii);
    let impl_arg_dtypes = self.instantiation_arg_dtypes.get(ii);

    for tmpl : self.generic_impl_templates {
      fit tmpl.kind {
        .Impl(i) -> {
          if !equals(i.type_name, base_name) || i.type_params.len != impl_arg_type_names.len {
            continue;
          }
          StringBuilder pfx = string_builder_init(16);
          pfx.append(i.type_name);
          pfx.append("__");
          str prefix = pfx.build();

          for m : i.methods {
            fit m.kind {
              .Function(fnv) -> {
                if !fnv.has_type_params || !equals(strip_prefix(fnv.name, prefix), bare_name) {
                  continue;
                }

                Vec<str> own_arg_type_names;
                own_arg_type_names.init(0);
                Vec<bin> own_arg_is_pointer;
                own_arg_is_pointer.init(0);
                for tp : fnv.type_params {
                  bin found = false;
                  str found_name = "";
                  num ai = 0;
                  num arg_i = 0;
                  if fnv.has_args {
                    for parg : fnv.args {
                      if ai == 0 {
                        // Skip the implicit `self` param.
                        ai = ai + 1;
                        continue;
                      }
                      fit parg.kind {
                        .Variable(v) -> {
                          if equals(v.var_type.type_str, tp) && v.var_type.generic_args.len == 0 && arg_i < args.len {
                            let inferred = self.infer_arg_type_name(args.get(arg_i));
                            if inferred.is_some() {
                              found_name = inferred.unwrap();
                              found = true;
                            }
                          }
                        }
                        _ -> {}
                      }
                      ai = ai + 1;
                      arg_i = arg_i + 1;
                    }
                  }
                  if !found {
                    ret .None;
                  }
                  own_arg_type_names.push(found_name);
                  own_arg_is_pointer.push(false);
                }

                StringBuilder nb = string_builder_init(24);
                nb.append(owner_type);
                nb.append("__");
                nb.append(bare_name);
                for oan : own_arg_type_names {
                  nb.append("__");
                  nb.append(oan);
                }
                str new_name = nb.build();

                Vec<str> combined_params;
                combined_params.init(0);
                Vec<str> combined_arg_names;
                combined_arg_names.init(0);
                Vec<bin> combined_arg_ptrs;
                combined_arg_ptrs.init(0);
                for tpn : i.type_params {
                  combined_params.push(tpn);
                }
                for tpn2 : fnv.type_params {
                  combined_params.push(tpn2);
                }
                for an3 : impl_arg_type_names {
                  combined_arg_names.push(an3);
                }
                for an4 : own_arg_type_names {
                  combined_arg_names.push(an4);
                }
                for ap : impl_arg_is_pointer {
                  combined_arg_ptrs.push(ap);
                }
                for ap2 : own_arg_is_pointer {
                  combined_arg_ptrs.push(ap2);
                }

                // The COMBINED substitution is set up BEFORE the dedup
                // check below (moved earlier than this used to be) --
                // A repeat call still needs the return type resolved
                // fresh even though its body isn't re-emitted.
                let prev_params = self.type_subst_param_names;
                let prev_arg_names = self.type_subst_arg_type_strs;
                let prev_arg_ptrs = self.type_subst_arg_is_pointer;
                let prev_arg_dtypes = self.type_subst_arg_dtypes;
                self.type_subst_param_names = combined_params;
                self.type_subst_arg_type_strs = combined_arg_names;
                self.type_subst_arg_is_pointer = combined_arg_ptrs;
                // Left at the impl's own shorter list on purpose --
                // `resolve_type_subst` falls back to the flat strings
                // for any index at or beyond its length.
                self.type_subst_arg_dtypes = impl_arg_dtypes;

                DataType resolved_rtype = dtype_new();
                if fnv.has_rtype {
                  resolved_rtype = self.resolve_type_subst(*fnv.rtype);
                }

                num ei = 0;
                bin already_emitted = false;
                for ei < self.emitted_method_own_param_insts.len {
                  if equals(self.emitted_method_own_param_insts.get(ei), new_name) {
                    already_emitted = true;
                  }
                  ei = ei + 1;
                }
                if already_emitted {
                  self.type_subst_param_names = prev_params;
                  self.type_subst_arg_type_strs = prev_arg_names;
                  self.type_subst_arg_is_pointer = prev_arg_ptrs;
                  self.type_subst_arg_dtypes = prev_arg_dtypes;
                  OwnParamCallResolution res0;
                  res0.mangled_name = new_name;
                  res0.rtype = resolved_rtype;
                  ret .Some(res0);
                }
                self.emitted_method_own_param_insts.push(new_name);

                // Same scratch-buffer/state-swap discipline as
                // `emit_one_generic_impl_method`.
                CodegenState method_scratch = codegen_state_new();
                CodegenState* saved_method_state = self.state;
                let saved_hoist_pos = self.hoist_insert_pos;
                let saved_stmt_start_pos = self.current_stmt_start_pos;
                let saved_local_names = self.local_names;
                let saved_local_is_pointer = self.local_is_pointer;
                let saved_local_type_name = self.local_type_name;
                let saved_local_dtype = self.local_dtype;
                let saved_fn_rtype_name = self.current_fn_rtype_name;
                let saved_fn_rtype_dt = self.current_fn_rtype_dt;
                let saved_defer_stack = self.defer_stack;
                let saved_defer_scope_starts = self.defer_scope_starts;
                let prev_suppress = self.suppress_generic_impl_method_draining;
                if self.hoist_scratch_depth == 0 {
                  self.root_state = self.state;
                  self.root_hoist_pos = self.hoist_insert_pos;
                  self.root_stmt_start_pos = self.current_stmt_start_pos;
                }
                self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
                self.state = &method_scratch;
                self.hoist_insert_pos = .None;
                self.current_stmt_start_pos = .None;
                self.suppress_generic_impl_method_draining = true;
                let body_err = self.emit_function_named(*m, new_name);
                self.state = saved_method_state;
                self.hoist_insert_pos = saved_hoist_pos;
                self.current_stmt_start_pos = saved_stmt_start_pos;
                self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
                if self.hoist_scratch_depth == 0 {
                  self.hoist_insert_pos = self.root_hoist_pos;
                  self.current_stmt_start_pos = self.root_stmt_start_pos;
                }
                self.suppress_generic_impl_method_draining = prev_suppress;
                self.local_names = saved_local_names;
                self.local_is_pointer = saved_local_is_pointer;
                self.local_type_name = saved_local_type_name;
                self.local_dtype = saved_local_dtype;
                self.current_fn_rtype_name = saved_fn_rtype_name;
                self.current_fn_rtype_dt = saved_fn_rtype_dt;
                self.defer_stack = saved_defer_stack;
                self.defer_scope_starts = saved_defer_scope_starts;
                self.emit_hoisted(method_scratch.out.build());

                self.type_subst_param_names = prev_params;
                self.type_subst_arg_type_strs = prev_arg_names;
                self.type_subst_arg_is_pointer = prev_arg_ptrs;
                self.type_subst_arg_dtypes = prev_arg_dtypes;
                if body_err.is_some() {
                  ret .None;
                }
                OwnParamCallResolution res;
                res.mangled_name = new_name;
                res.rtype = resolved_rtype;
                ret .Some(res);
              }
              _ -> {}
            }
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Emits one concrete monomorphization of a generic tagged-union enum
  // template, substituting each variant's payload types against the
  // template's type-param names. A payload type that isn't a bare
  // occurrence of a type param is left unchanged.
  emit_tagged_union_enum_instance(
    str mangled_name,
    Vec<GenericEnumVariantTemplate> variant_templates,
    Vec<str> type_params,
    Vec<str> arg_type_names,
    Vec<bin> arg_is_pointer
  ) {
    self.state.write("typedef enum ");
    self.state.write(mangled_name);
    self.state.write("_tag {\n");
    for vt : variant_templates {
      self.state.write("  ");
      self.state.write(mangled_name);
      self.state.write("_");
      self.state.write(vt.name);
      self.state.write(",\n");
    }
    self.state.write("} ");
    self.state.write(mangled_name);
    self.state.write("_tag;\n");

    self.state.write("typedef struct ");
    self.state.write(mangled_name);
    self.state.write(" {\n  ");
    self.state.write(mangled_name);
    self.state.write("_tag tag;\n  union {\n");
    for vt : variant_templates {
      if vt.has_payload {
        self.state.write("    struct { ");
        num i = 0;
        Vec<str> resolved_payload_names;
        resolved_payload_names.init(0);
        Vec<bin> resolved_payload_ptrs;
        resolved_payload_ptrs.init(0);
        for i < vt.payload_type_strs.len {
          str ptype = vt.payload_type_strs.get(i);
          bin pptr = vt.payload_is_pointer.get(i);
          str resolved_type = ptype;
          bin resolved_ptr = pptr;
          num pi = 0;
          for pi < type_params.len {
            if equals(type_params.get(pi), ptype) {
              resolved_type = arg_type_names.get(pi);
              resolved_ptr = arg_is_pointer.get(pi);
            }
            pi = pi + 1;
          }
          self.write_type_name(resolved_type);
          if resolved_ptr {
            self.state.write("*");
          }
          self.state.write(" _");
          self.state.write(format_num(i));
          self.state.write("; ");
          resolved_payload_names.push(resolved_type);
          resolved_payload_ptrs.push(resolved_ptr);
          i = i + 1;
        }
        self.state.write("} ");
        self.state.write(vt.name);
        self.state.write(";\n");
        self.record_enum_variant_payload(
          mangled_name,
          vt.name,
          resolved_payload_names,
          resolved_payload_ptrs
        );
      }
    }
    self.state.write("  } payload;\n} ");
    self.state.write(mangled_name);
    self.state.write(";\n\n");
  }

  // Records that local `name` is (or isn't) a pointer, and its declared
  // type name, for later field-access/method-call decisions. No full
  // `DataType` on hand here; see `record_local_typed` for that case.
  record_local(str name, str type_name, bin is_pointer) {
    self.local_names.push(name);
    self.local_is_pointer.push(is_pointer);
    self.local_type_name.push(type_name);
    self.local_dtype.push(.None);
  }

  // Like `record_local`, but for a call site that has the local's real,
  // already-substituted `DataType` on hand.
  record_local_typed(str name, str type_name, bin is_pointer, DataType dtype) {
    self.local_names.push(name);
    self.local_is_pointer.push(is_pointer);
    self.local_type_name.push(type_name);
    self.local_dtype.push(.Some(dtype));
  }

  // Looks up whether `name` was recorded as a pointer local. `.None`
  // means `name` isn't a known local at all. Searches backward (most
  // recently recorded entry first), so a later local shadowing an
  // earlier one with the same name (two sibling `fit` arms each binding
  // a payload as `doc`, e.g.) resolves against the right one -- this
  // codegen has no block-scope popping, so both entries live in the
  // same flat list.
  lookup_local_is_pointer(str name) Option<bin> {
    num i = self.local_names.len - 1;
    for i >= 0 {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_is_pointer.get(i));
      }
      i = i - 1;
    }
    ret .None;
  }

  // Looks up `name`'s declared type name (e.g. "Point"), for building a
  // method call's mangled callee name. See `lookup_local_is_pointer`'s
  // doc comment -- same scope, same "can't handle this" contract on
  // `.None`, and the SAME backward-scan reasoning for shadowing.
  lookup_local_type_name(str name) Option<str> {
    num i = self.local_names.len - 1;
    for i >= 0 {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_type_name.get(i));
      }
      i = i - 1;
    }
    ret .None;
  }

  // Looks up `name`'s FULL structured `DataType`, when it was recorded
  // via `record_local_typed` -- see `Codegen.local_dtype`'s doc comment.
  // `.None` covers BOTH "not a known local at all" and "a known local,
  // but only recorded via plain `record_local`" -- the caller can't tell
  // these apart from this result alone (use `lookup_local_type_name`
  // first to distinguish, if that matters). Same backward-scan reasoning
  // as `lookup_local_is_pointer`'s own doc comment.
  lookup_local_dtype(str name) Option<DataType> {
    num i = self.local_names.len - 1;
    for i >= 0 {
      if equals(self.local_names.get(i), name) {
        ret self.local_dtype.get(i);
      }
      i = i - 1;
    }
    ret .None;
  }

  // Registers `name` (a multi-dimensional array's for-loop item) as
  // needing its length bound computed via `root`, the true declared
  // array, with `depth` leading `[0]` index levels.
  record_local_multidim(str name, str root, num depth) {
    self.local_multidim_names.push(name);
    self.local_multidim_roots.push(root);
    self.local_multidim_depths.push(depth);
  }

  // Looks up `name`'s multi-dim root/depth, if registered. `.None` for an
  // ordinary local.
  lookup_local_multidim(str name) Option<MultidimInfo> {
    num i = self.local_multidim_names.len - 1;
    for i >= 0 {
      if equals(self.local_multidim_names.get(i), name) {
        MultidimInfo m;
        m.root = self.local_multidim_roots.get(i);
        m.depth = self.local_multidim_depths.get(i);
        ret .Some(m);
      }
      i = i - 1;
    }
    ret .None;
  }

  // Records `name` as a known enum with the given variant names and
  // tagged-union-ness, for later `EnumName.Variant` access recognition.
  record_enum(str name, Vec<str> variant_names, bin is_tagged_union) {
    self.enum_names.push(name);
    self.enum_variant_names.push(variant_names);
    self.enum_is_tagged_union.push(is_tagged_union);
  }

  // Records `variant_name`'s payload field types, positional, for a
  // tagged-union enum `enum_name`.
  record_enum_variant_payload(
    str enum_name,
    str variant_name,
    Vec<str> type_names,
    Vec<bin> is_pointer
  ) {
    self.enum_variant_payload_owner.push(enum_name);
    self.enum_variant_payload_variant.push(variant_name);
    self.enum_variant_payload_type_names.push(type_names);
    self.enum_variant_payload_is_pointer.push(is_pointer);
  }

  // Looks up `variant_name`'s payload field type at `position` (0-based)
  // for the tagged-union enum `enum_name`. `.None` when the enum/variant
  // isn't recorded, or `position` is out of range.
  lookup_enum_variant_payload_type(str enum_name, str variant_name, num position) Option<FieldTypeInfo> {
    num i = 0;
    for i < self.enum_variant_payload_owner.len {
      if equals(self.enum_variant_payload_owner.get(i), enum_name) && equals(
        self.enum_variant_payload_variant.get(i),
        variant_name
      ) {
        let type_names = self.enum_variant_payload_type_names.get(i);
        if position < 0 || position >= type_names.len {
          ret .None;
        }
        let is_pointers = self.enum_variant_payload_is_pointer.get(i);
        FieldTypeInfo info;
        info.type_name = type_names.get(position);
        info.is_pointer = is_pointers.get(position);
        info.dtype = .None;
        ret .Some(info);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Resolves a bare enum-variant shorthand (`.Red`) by global
  // uniqueness: the one enum whose variants include `variant_name`, when
  // exactly one exists across the whole program. Needed for a `let`
  // declaration, which has no declared type to resolve against
  // otherwise. `.None` when zero or more than one enum matches.
  resolve_unique_enum_for_variant(str variant_name) Option<str> {
    str found_name = "";
    num found_count = 0;
    num i = 0;
    for i < self.enum_names.len {
      let variants = self.enum_variant_names.get(i);
      num j = 0;
      for j < variants.len {
        if equals(variants.get(j), variant_name) {
          found_name = self.enum_names.get(i);
          found_count = found_count + 1;
        }
        j = j + 1;
      }
      i = i + 1;
    }
    if found_count == 1 {
      ret .Some(found_name);
    }
    ret .None;
  }

  // True if `enum_name` is a known enum with a variant named
  // `variant_name`.
  enum_has_variant(str enum_name, str variant_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        let variants = self.enum_variant_names.get(i);
        num j = 0;
        for j < variants.len {
          if equals(variants.get(j), variant_name) {
            ret true;
          }
          j = j + 1;
        }
        ret false;
      }
      i = i + 1;
    }
    ret false;
  }

  // True if `enum_name` is a known tagged-union enum.
  enum_is_tagged_union_named(str enum_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        ret self.enum_is_tagged_union.get(i);
      }
      i = i + 1;
    }
    ret false;
  }

  // Records `name` as a known compound with the given fields' names and
  // declared types, for later chained-field-access resolution. No full
  // per-field `DataType` on hand here; see `record_compound_typed`.
  record_compound(
    str name,
    Vec<str> field_names,
    Vec<str> field_type_names,
    Vec<bin> field_is_pointer
  ) {
    Vec<Option<DataType>> field_dtypes;
    field_dtypes.init(0);
    num k = 0;
    for k < field_names.len {
      field_dtypes.push(.None);
      k = k + 1;
    }
    self.compound_names.push(name);
    self.compound_field_names.push(field_names);
    self.compound_field_type_names.push(field_type_names);
    self.compound_field_is_pointer.push(field_is_pointer);
    self.compound_field_dtype.push(field_dtypes);
  }

  // Like `record_compound`, but for a call site that has each field's
  // real, un-mangled `DataType` on hand.
  record_compound_typed(
    str name,
    Vec<str> field_names,
    Vec<str> field_type_names,
    Vec<bin> field_is_pointer,
    Vec<DataType> field_dtypes_raw
  ) {
    Vec<Option<DataType>> field_dtypes;
    field_dtypes.init(0);
    for d : field_dtypes_raw {
      field_dtypes.push(.Some(d));
    }
    self.compound_names.push(name);
    self.compound_field_names.push(field_names);
    self.compound_field_type_names.push(field_type_names);
    self.compound_field_is_pointer.push(field_is_pointer);
    self.compound_field_dtype.push(field_dtypes);
  }

  // Looks up `field_name`'s declared type on the known compound
  // `compound_name`. `.None` when either isn't recognized.
  lookup_compound_field(str compound_name, str field_name) Option<FieldTypeInfo> {
    num i = 0;
    for i < self.compound_names.len {
      if equals(self.compound_names.get(i), compound_name) {
        let field_names = self.compound_field_names.get(i);
        let field_types = self.compound_field_type_names.get(i);
        let field_ptrs = self.compound_field_is_pointer.get(i);
        let field_dtypes = self.compound_field_dtype.get(i);
        num j = 0;
        for j < field_names.len {
          if equals(field_names.get(j), field_name) {
            FieldTypeInfo info;
            info.type_name = field_types.get(j);
            info.is_pointer = field_ptrs.get(j);
            info.dtype = field_dtypes.get(j);
            ret .Some(info);
          }
          j = j + 1;
        }
        ret .None;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Records one impl method's owning type, bare name, fully mangled
  // Records an impl method's C call-site name, declared return type
  // (nil when unknown, e.g. a generic impl's method), and declared
  // parameter types excluding the implicit `self`.
  record_impl_method(
    str owner_type,
    str bare_name,
    str mangled_name,
    DataType* rtype,
    Vec<DataType*> param_types,
    Vec<Node*> default_values
  ) {
    self.impl_method_owner_type.push(owner_type);
    self.impl_method_bare_name.push(bare_name);
    self.impl_method_mangled_name.push(mangled_name);
    self.impl_method_rtype.push(rtype);
    self.impl_method_param_types.push(param_types);
    self.impl_method_default_values.push(default_values);
  }

  // Looks up `bare_name`'s declared return type on `owner_type`. `.None`
  // means the method isn't recognized, or its return type wasn't
  // recorded (a generic impl's method).
  lookup_impl_method_rtype(str owner_type, str bare_name) Option<DataType*> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) && equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        let rtype = self.impl_method_rtype.get(i);
        if rtype == nil {
          ret .None;
        }
        ret .Some(rtype);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s declared parameter type at `arg_index`
  // (excluding `self`) on `owner_type`. `.None` when the method isn't
  // recognized, or `arg_index` is out of range.
  lookup_impl_method_param_type(str owner_type, str bare_name, num arg_index) Option<DataType*> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) && equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        let param_types = self.impl_method_param_types.get(i);
        if arg_index >= param_types.len {
          ret .None;
        }
        ret .Some(param_types.get(arg_index));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s full declared param list (excluding `self`),
  // for `emit_method_call`'s default-parameter fill-in.
  lookup_impl_method_param_types(str owner_type, str bare_name) Option<Vec<DataType *>> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) && equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        ret .Some(self.impl_method_param_types.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s trailing default-parameter value expressions.
  lookup_impl_method_default_values(str owner_type, str bare_name) Option<Vec<Node *>> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) && equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        ret .Some(self.impl_method_default_values.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `bare_name`'s fully mangled C call-site name on `owner_type`.
  lookup_impl_method(str owner_type, str bare_name) Option<str> {
    num i = 0;
    for i < self.impl_method_owner_type.len {
      if equals(self.impl_method_owner_type.get(i), owner_type) && equals(
        self.impl_method_bare_name.get(i),
        bare_name
      ) {
        ret .Some(self.impl_method_mangled_name.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Writes a raw string literal's bytes as a C string-literal body,
  // escaping backslash, double-quote, and newline; everything else
  // passes through unchanged.
  write_raw_string_body(str s) {
    num i = 0;
    num n = len(s);
    for i < n {
      chr c = s[i];
      if c == '\\' {
        self.state.write("\\\\");
      } elif c == '"' {
        self.state.write("\\\"");
      } elif c == '\n' {
        self.state.write("\\n");
      } elif c == '\r' {
        self.state.write("\\r");
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
      i = i + 1;
    }
  }

  // Writes a single-quoted C character literal for `c`, escaping
  // backslash/quote/newline/CR/tab/NUL, and any other non-printable-ASCII
  // byte as `\xHH`.
  write_char_literal(chr c) {
    self.state.write("'");
    if c == '\\' {
      self.state.write("\\\\");
    } elif c == '\'' {
      self.state.write("\\'");
    } elif c == '\n' {
      self.state.write("\\n");
    } elif c == '\r' {
      self.state.write("\\r");
    } elif c == '\t' {
      self.state.write("\\t");
    } elif c == 0 {
      self.state.write("\\0");
    } else {
      num code = c;
      if code < 0x20 || code >= 0x7f {
        self.state.write(format("\\x{num}", code));
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
    }
    self.state.write("'");
  }

  // Emits `node` as a C expression.
  pub emit_expr(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Num(n) -> {
            self.state.write(format_num(n));
            ret .None;
          }
          .Dec(d) -> {
            self.state.write(format_dec(d, 6));
            ret .None;
          }
          _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
        }
      }
      .String(s) -> {
        self.state.write("\"");
        if node.flags.is_raw_string {
          self.write_raw_string_body(s);
        } else {
          self.state.write(s);
        }
        self.state.write("\"");
        ret .None;
      }
      .Character(c) -> {
        self.write_char_literal(c);
        ret .None;
      }
      .Boolean(b) -> {
        if b {
          self.state.write("true");
        } else {
          self.state.write("false");
        }
        ret .None;
      }
      .Nil -> {
        self.state.write("NULL");
        ret .None;
      }
      .Panic(msg) -> {
        // Prints the message and aborts. Trails off with a plain `0` so
        // it type-checks in almost any scalar/pointer context.
        self.state.write("({ fprintf(stderr_stream(), \"panic: %s\\n\", ");
        let merr = self.emit_expr(*msg);
        if merr.is_some() {
          ret merr;
        }
        self.state.write("); abort(); 0; })");
        ret .None;
      }
      .CompoundInit(ci) -> {
        // `Type{ field = value, ... }` (explicit) or `.{ field = value,
        // ... }` (bare, resolved against `expected_compound_type`).
        // Lowers to a GNU C compound literal: `(Type){ .field = value,
        // ... }`, or `(Type){0}` for an empty initializer.
        str type_name = "";
        if ci.has_dtype {
          bin have_type_name = false;
          // A bare `Type{...}` inside a generic impl method's own body,
          // naming that method's own return type's bare template,
          // resolves against `current_fn_rtype_name`. Checked before the
          // field-based inference below, since a generic method body's
          // own fields are typically set from still-abstract type-param
          // locals, not concrete values.
          if ci.init_dtype.generic_args.len == 0 && self.current_fn_rtype_dt.is_some() {
            let crt = self.current_fn_rtype_dt.unwrap();
            if crt.generic_args.len > 0 && equals(crt.type_str, ci.init_dtype.type_str) {
              type_name = self.current_fn_rtype_name;
              have_type_name = true;
            }
          }
          // A bare `Box{value = 7}` infers `T`'s concrete binding from
          // the initializer's field values.
          if !have_type_name && ci.init_dtype.generic_args.len == 0 {
            let inferred_gargs = self.infer_generic_compound_init_args(
              ci.init_dtype.type_str,
              ci.fields
            );
            if inferred_gargs.is_some() {
              DataType effective_dtype = *ci.init_dtype;
              effective_dtype.generic_args = inferred_gargs.unwrap();
              let resolved2 = self.resolve_type_name(effective_dtype);
              if resolved2.is_some() {
                type_name = resolved2.unwrap();
                have_type_name = true;
              }
            }
          }
          if !have_type_name {
            let resolved = self.resolve_type_name(*ci.init_dtype);
            if resolved.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            type_name = resolved.unwrap();
          }
        } elif !equals(self.expected_compound_type, "") {
          type_name = self.expected_compound_type;
        } else {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write("(");
        self.state.write(type_name);
        self.state.write("){");
        if ci.fields.len == 0 {
          self.state.write("0");
        } else {
          bin first = true;
          for f : ci.fields {
            if !first {
              self.state.write(", ");
            }
            first = false;
            self.state.write(".");
            self.state.write(f.name);
            self.state.write(" = ");
            // A field value may itself be a bare enum-variant shorthand
            // or a nested bare `.{...}` compound shorthand; both need
            // the expected type set from the field's declared type
            // before recursing.
            let field_info = self.lookup_compound_field(type_name, f.name);
            let prev_expected_enum = self.expected_enum_type;
            let prev_expected_compound = self.expected_compound_type;
            if field_info.is_some() {
              let finfo = field_info.unwrap();
              if self.enum_names.contains(finfo.type_name) {
                self.expected_enum_type = finfo.type_name;
              } else {
                self.expected_compound_type = finfo.type_name;
              }
            }
            // A field value may itself be an array literal, needing the
            // bare-brace-list form.
            let prev_arr_init = self.in_array_initializer;
            self.in_array_initializer = true;
            let ferr = self.emit_expr(*f.value);
            self.in_array_initializer = prev_arr_init;
            self.expected_enum_type = prev_expected_enum;
            self.expected_compound_type = prev_expected_compound;
            if ferr.is_some() {
              ret ferr;
            }
          }
        }
        self.state.write("}");
        ret .None;
      }
      // A bare `[elem, elem, ...]` array literal. Only valid where
      // `in_array_initializer` is already set.
      .Bracket(inner) -> {
        if !self.in_array_initializer {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        Vec<Node*> elems;
        elems.init(0);
        self.flatten_call_args(inner, &elems);
        self.state.write("{");
        bin first = true;
        for elem : elems {
          if !first {
            self.state.write(", ");
          }
          first = false;
          let eerr = self.emit_expr(*elem);
          if eerr.is_some() {
            ret eerr;
          }
        }
        self.state.write("}");
        ret .None;
      }
      .Identifier(name) -> {
        self.state.write(name);
        ret .None;
      }
      .ExpressionParenthesis(inner) -> {
        // An explicit parenthesized sub-expression (`(a + b)`).
        self.state.write("(");
        let ierr = self.emit_expr(*inner);
        if ierr.is_some() {
          ret ierr;
        }
        self.state.write(")");
        ret .None;
      }
      .Unary(u) -> {
        if equals(u.op, "await") {
          ret self.emit_await(u.operand);
        }
        self.state.write("(");
        if u.is_left_operanded_unary {
          // Postfix: `x++`/`x--`.
          let oerr = self.emit_expr(*u.operand);
          if oerr.is_some() {
            ret oerr;
          }
          self.state.write(u.op);
        } elif u.has_indirection {
          // Pointer indirection (`*p`, `**pp`, ...): a run of `*`s for
          // the depth.
          num i = 0;
          for i < u.indirection_depth {
            self.state.write("*");
            i = i + 1;
          }
          let oerr2 = self.emit_expr(*u.operand);
          if oerr2.is_some() {
            ret oerr2;
          }
        } else {
          // Prefix (`-x`, `!x`, `~x`, `&x`).
          self.state.write(u.op);
          let oerr3 = self.emit_expr(*u.operand);
          if oerr3.is_some() {
            ret oerr3;
          }
        }
        self.state.write(")");
        ret .None;
      }
      .Expression(e) -> {
        // Every binary operator besides `()`/`.`/`[]` already has an
        // identical C spelling; a plain `(left op right)` emission is
        // correct as-is.
        if equals(e.op, "()") {
          ret self.emit_call(e);
        }
        if equals(e.op, ".") {
          ret self.emit_field_access(e);
        }
        if equals(e.op, "[]") {
          ret self.emit_index(e);
        }
        if equals(e.op, ",") {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        if !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        // `_ = expr;` discards a return value on purpose; `_` isn't a
        // declared variable in C, so this lowers to `(void)(expr)`.
        if equals(e.op, "=") && e.has_left {
          fit e.left.kind {
            .Identifier(lname) -> {
              if equals(lname, "_") {
                self.state.write("(void)(");
                let derr = self.emit_expr(*e.right);
                if derr.is_some() {
                  ret derr;
                }
                self.state.write(")");
                ret .None;
              }
            }
            _ -> {}
          }
        }
        self.state.write("(");
        let lerr = self.emit_expr(*e.left);
        if lerr.is_some() {
          ret lerr;
        }
        self.state.write(" ");
        self.state.write(e.op);
        self.state.write(" ");

        // An assignment or equality/inequality's right-hand side may be a
        // bare enum-variant shorthand. Resolve the left side's declared
        // type via `resolve_field_chain` and use it as the expected type
        // for the right-hand expression only.
        bin resolves_rhs_shorthand = equals(e.op, "=") || equals(e.op, "==") || equals(e.op, "!=");
        str prev_expected = self.expected_enum_type;
        str prev_expected_compound = self.expected_compound_type;
        if resolves_rhs_shorthand {
          let lhs_resolved = self.resolve_field_chain(e.left);
          if lhs_resolved.is_some() {
            let lhs_type_name = lhs_resolved.unwrap().type_name;
            self.expected_enum_type = lhs_type_name;
            // A bare `.{...}` compound-literal shorthand resolves against
            // the same left-hand type as an enum shorthand would, so both
            // are set here; the AST already distinguishes which applies.
            self.expected_compound_type = lhs_type_name;
          }
        }
        let rerr = self.emit_expr(*e.right);
        if resolves_rhs_shorthand {
          self.expected_enum_type = prev_expected;
          self.expected_compound_type = prev_expected_compound;
        }
        if rerr.is_some() {
          ret rerr;
        }
        self.state.write(")");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Flattens a call's argument-list node into individual argument nodes,
  // appended in left-to-right source order.
  flatten_call_args(Node* node, Vec<Node*>* out) {
    fit node.kind {
      .ExpressionParenthesis(inner) -> { self.flatten_call_args(inner, out); }
      .Blank -> {}
      .Expression(e) -> {
        if equals(e.op, ",") {
          if e.has_left {
            self.flatten_call_args(e.left, out);
          }
          if e.has_right {
            self.flatten_call_args(e.right, out);
          }
        } else {
          out.push(node);
        }
      }
      _ -> { out.push(node); }
    }
  }

  // Writes the inner dimension declarators `[N1][N2]...` for a multi-
  // dimensional array local's declaration. The leading dimension stays
  // unsized (C infers it from the initializer), but every other dimension
  // must be explicit. Sizes are derived by counting the first element at
  // each nesting level, assuming a rectangular literal. `outer_lit` is
  // the `.Bracket` node at the current nesting level; `remaining` is how
  // many more inner dimensions still need writing.
  emit_multidim_inner_declarators(Node* outer_lit, num remaining) {
    if remaining == 0 {
      ret;
    }
    fit outer_lit.kind {
      .Bracket(outer_inner) -> {
        Vec<Node*> outer_elems;
        outer_elems.init(0);
        self.flatten_call_args(outer_inner, &outer_elems);
        if outer_elems.len == 0 {
          ret;
        }
        let first_elem = outer_elems.get(0);
        fit first_elem.kind {
          .Bracket(first_inner) -> {
            Vec<Node*> inner_elems;
            inner_elems.init(0);
            self.flatten_call_args(first_inner, &inner_elems);
            self.state.write("[");
            self.state.write(format_num(inner_elems.len));
            self.state.write("]");
            if remaining > 1 {
              self.emit_multidim_inner_declarators(first_elem, remaining - 1);
            }
          }
          _ -> {}
        }
      }
      _ -> {}
    }
  }

  // Structural nesting depth of a bare array literal: 1 for a flat
  // `[1, 2, 3]`, one more per level of further uniform nesting. Only
  // checks whether the first element at each level is itself a
  // `.Bracket`, so it always succeeds regardless of element type.
  array_literal_nesting_depth(Node* lit) num {
    fit lit.kind {
      .Bracket(inner) -> {
        Vec<Node*> elems;
        elems.init(0);
        self.flatten_call_args(inner, &elems);
        if elems.len == 0 {
          ret 1;
        }
        let first = elems.get(0);
        fit first.kind {
          .Bracket(_) -> { ret 1 + self.array_literal_nesting_depth(first); }
          _ -> { ret 1; }
        }
      }
      _ -> { ret 1; }
    }
  }

  // True when `arg`'s declared type, resolved through the active generic
  // substitution, is the builtin string type. Used by the
  // `__fun_key_eq`/`__fun_key_hash` intrinsics to choose string-contents
  // vs raw-byte comparison/hash semantics. Only a bare `.Identifier`
  // argument is resolvable; anything else conservatively answers false.
  _key_arg_is_str(Node* arg) bin {
    fit arg.kind {
      .Identifier(name) -> {
        let dt_opt = self.lookup_local_dtype(name);
        if dt_opt.is_none() {
          ret false;
        }
        let resolved = self.resolve_type_subst(dt_opt.unwrap());
        if resolved.pointer_depth != 0 {
          ret false;
        }
        ret equals(resolved.type_str, "str");
      }
      _ -> { ret false; }
    }
  }

  // Resolves whether `expr` (a variadic `format`/`println_fmt` `{}`
  // argument) should be pre-converted through its own type's `Display`
  // impl instead of passed raw. Handles a bare local, a field access, or
  // a unary `*`/`&` wrapping either, whose resolved type has a
  // registered `to_string` method.
  resolve_display_dispatch(Node* expr) Option<DisplayResolution> {
    // `*ptr` dereferences down to the pointee's declared type; `&x`
    // takes a Display value's address directly. Checked first, since a
    // `.Unary` node never matches `eligible` below.
    fit expr.kind {
      .Unary(u) -> {
        bin want_ptr = equals(u.op, "*");
        bin want_addr = equals(u.op, "&");
        if want_ptr || want_addr {
          fit u.operand.kind {
            .Identifier(name) -> {
              let is_ptr = self.lookup_local_is_pointer(name);
              let type_name = self.lookup_local_type_name(name);
              if is_ptr.is_some() && type_name.is_some() {
                bin shape_ok = false;
                if want_ptr && is_ptr.unwrap() {
                  shape_ok = true;
                }
                if want_addr && !is_ptr.unwrap() {
                  shape_ok = true;
                }
                if shape_ok {
                  let fn_name_opt2 = self.lookup_impl_method(type_name.unwrap(), "to_string");
                  if fn_name_opt2.is_some() {
                    // A Display impl reached only through this
                    // unary-wrapped dispatch needs its own forward
                    // prototype, or an earlier-defined caller in the same
                    // file hits an implicit-declaration error.
                    self.ensure_plain_impl_method_prototype_emitted(
                      type_name.unwrap(),
                      "to_string"
                    );
                    self.ensure_generic_impl_method_emitted(type_name.unwrap(), "to_string");
                    DisplayResolution res2;
                    res2.fn_name = fn_name_opt2.unwrap();
                    // `*p` evaluates to a plain value, so a pointer-
                    // receiver `to_string` needs its address taken; `&x`
                    // is already a pointer and needs no further `&`.
                    res2.pass_by_ref = want_ptr;
                    ret .Some(res2);
                  }
                }
              }
            }
            _ -> {}
          }
        }
        ret .None;
      }
      _ -> {}
    }
    bin eligible = false;
    fit expr.kind {
      .Identifier(_) -> { eligible = true; }
      .Expression(e) -> {
        if equals(e.op, ".") {
          eligible = true;
        }
      }
      _ -> {}
    }
    if !eligible {
      ret .None;
    }
    let r_opt = self.resolve_field_chain(expr);
    if r_opt.is_none() {
      ret .None;
    }
    let r = r_opt.unwrap();
    if r.is_call_result {
      ret .None;
    }
    let fn_name_opt = self.lookup_impl_method(r.type_name, "to_string");
    if fn_name_opt.is_none() {
      ret .None;
    }
    // Same as `emit_method_call`'s dispatch: ensures a forward prototype
    // exists for both a plain impl method and, harmlessly if not
    // applicable, a generic compound's mangled instantiation.
    self.ensure_plain_impl_method_prototype_emitted(r.type_name, "to_string");
    self.ensure_generic_impl_method_emitted(r.type_name, "to_string");
    DisplayResolution res;
    res.fn_name = fn_name_opt.unwrap();
    res.pass_by_ref = !r.is_pointer;
    ret .Some(res);
  }

  // Emits a call `callee(arg1, arg2, ...)`: a plain-identifier callee (an
  // ordinary free-function call) directly, or delegates to
  // `emit_method_call` when the callee is itself a `.`-Expression
  // (`recv.method(...)`).
  // 
  // Deliberately simplified from the original for this slice: a call
  // through another call's result (`f()()`) isn't reachable yet. No name
  // resolution/mangling for the free-function case either (aliasing,
  // generics, overload-by-arity) -- the callee's Fun name and its C name
  // are assumed identical, true for every plain function this slice can
  // otherwise construct.
  emit_call(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str callee_name = "";
    fit e.left.kind {
      .Identifier(name) -> { callee_name = name; }
      .Expression(recv_e) -> {
        if equals(recv_e.op, ".") {
          // `alias.func(args)` -- a plain function call qualified by an
          // import alias (see `Codegen.import_aliases`'s own doc
          // comment). Checked FIRST: without this, the alias identifier
          // reads as an ordinary receiver value, and this whole call
          // falls through to `emit_method_call` (which then correctly
          // rejects it, since an alias is never a known local) instead
          // of the plain call it actually is.
          // 
          // Gated on NOT already a known local: `import_aliases` is a
          // whole-PROGRAM list, so a coincidentally-same-named LOCAL
          // parameter/variable in some OTHER function (`std/error.fn`'s
          // own `error_with_context(Error* e, ...) { e.with_context(...);
          // }`, found via a real example whose entry file also happens
          // to declare `imp ... as e;`) must shadow it -- a real local
          // always wins over a same-named global alias, same as ordinary
          // scoping.
          bin left_is_known_alias = false;
          str known_alias_name = "";
          if recv_e.has_left {
            fit recv_e.left.kind {
              .Identifier(lname) -> {
                if self.import_aliases.contains(lname) && self.lookup_local_type_name(lname).is_none() {
                  left_is_known_alias = true;
                  known_alias_name = lname;
                }
              }
              _ -> {}
            }
          }
          if left_is_known_alias {
            if !recv_e.has_right {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            fit recv_e.right.kind {
              .Identifier(fname) -> {
                // A collision-renamed function (`two.pick()` where
                // `pick` collided with a DIFFERENTLY-aliased import's
                // own same-named one, `examples/imports/alias_collision
                // /main.fn`'s own real body) resolves to its REAL
                // mangled name here instead of the bare one -- see
                // `lookup_alias_rename`'s own doc comment. Falls back
                // to the bare name unqualified (the overwhelmingly
                // common case) when nothing matches.
                let renamed = self.lookup_alias_rename(known_alias_name, fname);
                if renamed.is_some() {
                  callee_name = renamed.unwrap();
                } else {
                  callee_name = fname;
                }
              }
              _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
            }
          } else {
            // `EnumName.Variant(args...)` (a tagged-union payload
            // construction) shares the exact same AST shape as a method
            // call (`recv.method(...)`) -- disambiguate by checking
            // whether the left side is a KNOWN ENUM NAME with that
            // variant first. See `emit_enum_variant_construction`'s doc
            // comment for the C this constructs.
            if recv_e.has_left && recv_e.has_right {
              str enum_name = "";
              bin have_enum_name = false;
              fit recv_e.left.kind {
                .Identifier(name) -> {
                  enum_name = name;
                  have_enum_name = true;
                }
                // Bare shorthand (`.Some(x)`, no `EnumName.` qualifier) --
                // see `Codegen.expected_enum_type`'s doc comment. If it
                // doesn't resolve to a known enum/variant below, this
                // falls through to `emit_method_call`, which already
                // rejects a non-identifier receiver on its own.
                .Blank -> {
                  if !equals(self.expected_enum_type, "") {
                    enum_name = self.expected_enum_type;
                    have_enum_name = true;
                  }
                }
                _ -> {}
              }
              if have_enum_name {
                fit recv_e.right.kind {
                  .Identifier(variant_name) -> {
                    // `Option<str> x = Option.Some("v");` -- a QUALIFIED
                    // construction written against a GENERIC enum's own
                    // bare TEMPLATE name ("Option"), which is never
                    // itself registered in `enum_names` (only a concrete
                    // INSTANTIATION is, e.g. "Option__str") -- same gap
                    // `emit_field_access`'s own identical fallback
                    // already fixed for a NO-payload variant READ
                    // (`Option.None`); needed here too for a payload-
                    // carrying variant CONSTRUCTION CALL. `expected_
                    // enum_type` already holds the mangled name here
                    // (set by the enclosing `ret`/`Variable`-declaration/
                    // call-argument context) whenever it's a concrete
                    // instantiation of THIS same bare template.
                    if !self.enum_has_variant(enum_name, variant_name) {
                      StringBuilder ec_tmpl_pfx = string_builder_init(16);
                      ec_tmpl_pfx.append(enum_name);
                      ec_tmpl_pfx.append("__");
                      if starts_with(self.expected_enum_type, ec_tmpl_pfx.build()) && self.enum_has_variant(
                        self.expected_enum_type,
                        variant_name
                      ) {
                        enum_name = self.expected_enum_type;
                      }
                    }
                    if self.enum_has_variant(enum_name, variant_name) {
                      ret self.emit_enum_variant_construction(enum_name, variant_name, e.right);
                    }
                  }
                  _ -> {}
                }
              }
            }
            ret self.emit_method_call(recv_e, e.right);
          }
        } else {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(e.right, &args);

    // A call to a known VARIADIC plain function (`format("...", a, b)`,
    // `fun format(str fmt, ...)`'s own real call sites) needs an EXTRA
    // trailing argument beyond its own real varargs: a `__fun_vtags`
    // type-tag string, one character per vararg (built via the `__fun_
    // tag(x)` `_Generic` macro -- see `write_prelude`'s own doc comment),
    // that the callee's own body-prefix shim (`emit_function_named`'s
    // own doc comment) reads back with `va_arg` to stringify each one
    // into a `Vec<str>` named `vargs`. Each vararg expression is bound
    // to its own `__auto_type __fun_va_N` temp FIRST (inside a GNU C
    // statement expression, since this needs to declare locals but is
    // itself used as a plain expression) -- it's read TWICE below (once
    // tagged, once passed as the real argument), and a call/side-
    // effecting expression must not be evaluated twice. Matches the
    // original transpiler's own identical lowering exactly (minus its
    // `Display`-trait dispatch for a non-builtin vararg value --
    // deliberately narrow here, see `emit_function_named`'s own doc
    // comment for why that's safe to skip for this codegen's real call
    // graph). Found via a real stage-2 self-compilation C error ("use of
    // undeclared identifier 'vargs'") for `std/io.fn`'s own real `format`/
    // `print_fmt`/`println_fmt` bodies.
    let var_fixed_len = self.lookup_function_variadic_fixed_len(callee_name);
    if var_fixed_len.is_some() {
      num fixed_len = var_fixed_len.unwrap();
      num var_len = 0;
      if args.len > fixed_len {
        var_len = args.len - fixed_len;
      }
      if var_len == 0 {
        self.state.write(callee_name);
        self.state.write("(");
        num vc_i = 0;
        for vc_i < fixed_len {
          if vc_i > 0 {
            self.state.write(", ");
          }
          let vc_err = self.emit_expr(*args.get(vc_i));
          if vc_err.is_some() {
            ret vc_err;
          }
          vc_i = vc_i + 1;
        }
        if fixed_len > 0 {
          self.state.write(", ");
        }
        self.state.write("(const char[]){0})");
        ret .None;
      }
      // Resolved ONCE per position, up front, and reused across all
      // three loops below (binding, tag string, pass-through argument)
      // -- see `resolve_display_dispatch`'s own doc comment for what
      // this detects and why.
      Vec<bin> va_is_display;
      va_is_display.init(var_len);
      Vec<str> va_disp_fn;
      va_disp_fn.init(var_len);
      Vec<bin> va_disp_by_ref;
      va_disp_by_ref.init(var_len);
      num vd_i = 0;
      for vd_i < var_len {
        let disp = self.resolve_display_dispatch(args.get(fixed_len + vd_i));
        if disp.is_some() {
          let d = disp.unwrap();
          va_is_display.push(true);
          va_disp_fn.push(d.fn_name);
          va_disp_by_ref.push(d.pass_by_ref);
        } else {
          va_is_display.push(false);
          va_disp_fn.push("");
          va_disp_by_ref.push(false);
        }
        vd_i = vd_i + 1;
      }

      self.state.write("({ ");
      num va_i = 0;
      for va_i < var_len {
        Node* va_arg = args.get(fixed_len + va_i);
        // A bare CHARACTER LITERAL (`'.'`) has type `int` in C, not
        // `char` -- a real, general C language rule (unlike C++), not a
        // selfhost-specific quirk. Left uncast, `__auto_type __fun_va_N
        // = '.';` infers `int`, so `__fun_tag`'s own `_Generic` dispatch
        // (see `write_prelude`'s own doc comment) matches the `int` case
        // ('n', "number") instead of `char` ('c') -- the callee's own
        // vararg-unpacking shim then stringifies the literal's ASCII
        // CODE (`fmt_num(46)` -> "46") instead of the character itself
        // (`fmt_chr('.')` -> "."). An explicit `(char)` cast here forces
        // `__auto_type` to infer the right type instead. A `chr`-typed
        // VARIABLE (not a literal) doesn't need this -- its own C
        // declaration is already `char`, so `__auto_type` already
        // infers correctly from it. Found via a real stage-2-compiled-
        // by-itself divergence: a repeated run of `.` characters in an
        // import path (`parser.parse_import`'s own `format("{chr}{str}",
        // '.', path)`) came out as the literal text "4646" instead of
        // "..", one generation further into self-hosting than where
        // this bug was introduced.
        bin va_is_chr_literal = false;
        fit va_arg.kind {
          .Character(_) -> { va_is_chr_literal = true; }
          _ -> {}
        }
        self.state.write("__auto_type __fun_va_");
        self.state.write(format_num(va_i));
        self.state.write(" = ");
        if va_is_chr_literal {
          self.state.write("(char)");
        }
        let va_err = self.emit_expr(*va_arg);
        if va_err.is_some() {
          ret va_err;
        }
        self.state.write("; ");
        if va_is_display.get(va_i) {
          self.state.write("char* __fun_disp_");
          self.state.write(format_num(va_i));
          self.state.write(" = ");
          self.state.write(va_disp_fn.get(va_i));
          self.state.write("(");
          if va_disp_by_ref.get(va_i) {
            self.state.write("&");
          }
          self.state.write("__fun_va_");
          self.state.write(format_num(va_i));
          self.state.write("); ");
        }
        va_i = va_i + 1;
      }
      self.state.write(callee_name);
      self.state.write("(");
      num vf_i = 0;
      for vf_i < fixed_len {
        if vf_i > 0 {
          self.state.write(", ");
        }
        let vf_err = self.emit_expr(*args.get(vf_i));
        if vf_err.is_some() {
          ret vf_err;
        }
        vf_i = vf_i + 1;
      }
      if fixed_len > 0 {
        self.state.write(", ");
      }
      self.state.write("(const char[]){");
      num vt_i = 0;
      for vt_i < var_len {
        if vt_i > 0 {
          self.state.write(", ");
        }
        if va_is_display.get(vt_i) {
          self.state.write("'s'");
        } else {
          self.state.write("__fun_tag(__fun_va_");
          self.state.write(format_num(vt_i));
          self.state.write(")");
        }
        vt_i = vt_i + 1;
      }
      if var_len > 0 {
        self.state.write(", ");
      }
      self.state.write("0}");
      num vp_i = 0;
      for vp_i < var_len {
        self.state.write(", ");
        if va_is_display.get(vp_i) {
          self.state.write("__fun_disp_");
        } else {
          self.state.write("__fun_va_");
        }
        self.state.write(format_num(vp_i));
        vp_i = vp_i + 1;
      }
      self.state.write("); })");
      ret .None;
    }

    // `__fun_key_eq(a, b)`/`__fun_key_hash(x)` are compiler INTRINSICS
    // (special-cased plain-function-call names, not real functions) used
    // by `std/map.fn`/`std/set.fn`'s own generic `impl Map<K, V>`/`impl
    // Set<T>` bodies to compare/hash a key BY CONTENTS when it's a
    // string, or by RAW BYTES otherwise (matching the original
    // transpiler's own identical intrinsics -- fixes `Map<str>`/`Set<
    // str>` keys that would otherwise compare/hash the pointer itself).
    // `_key_arg_is_str` resolves the argument's OWN declared type
    // through the active generic substitution (a bare type-param name
    // like `K` may concretely be `str` in THIS monomorphization) --
    // mirrors `arg_concrete_type_is_str`'s identical reasoning. Found
    // via a real stage-2 self-compilation C error ("call to undeclared
    // function '__fun_key_hash'").
    if equals(callee_name, "__fun_key_eq") && args.len == 2 {
      self.state.write("(");
      if self._key_arg_is_str(args.get(0)) {
        self.state.write("strcmp((");
        let keq_a_err = self.emit_expr(*args.get(0));
        if keq_a_err.is_some() {
          ret keq_a_err;
        }
        self.state.write("), (");
        let keq_b_err = self.emit_expr(*args.get(1));
        if keq_b_err.is_some() {
          ret keq_b_err;
        }
        self.state.write(")) == 0)");
      } else {
        self.state.write("memcmp(&(");
        let keq_a_err2 = self.emit_expr(*args.get(0));
        if keq_a_err2.is_some() {
          ret keq_a_err2;
        }
        self.state.write("), &(");
        let keq_b_err2 = self.emit_expr(*args.get(1));
        if keq_b_err2.is_some() {
          ret keq_b_err2;
        }
        self.state.write("), sizeof(");
        let keq_a_err3 = self.emit_expr(*args.get(0));
        if keq_a_err3.is_some() {
          ret keq_a_err3;
        }
        self.state.write(")) == 0)");
      }
      ret .None;
    }
    if equals(callee_name, "__fun_key_hash") && args.len == 1 {
      if self._key_arg_is_str(args.get(0)) {
        self.state.write("__fun_str_key_hash((");
        let kh_err = self.emit_expr(*args.get(0));
        if kh_err.is_some() {
          ret kh_err;
        }
        self.state.write("))");
      } else {
        self.state.write("__fun_bytes_key_hash(&(");
        let kh_err2 = self.emit_expr(*args.get(0));
        if kh_err2.is_some() {
          ret kh_err2;
        }
        self.state.write("), sizeof(");
        let kh_err3 = self.emit_expr(*args.get(0));
        if kh_err3.is_some() {
          ret kh_err3;
        }
        self.state.write("))");
      }
      ret .None;
    }

    // `sizeof(T)` where `T` is the bare type param of the generic impl
    // method currently being monomorphized (`Option<T>.zero()`'s own
    // `memset(&out, 0, sizeof(T))`) needs the SAME substitution every
    // other reference to `T` in this method body already gets via
    // `resolve_type_subst` -- but a `sizeof(...)` argument is parsed as
    // an ordinary call argument EXPRESSION (see `parser.fn`'s own
    // `parse_expressionable_single` doc comment: 'sizeof' isn't a real
    // keyword, just an identifier callee), never as a `DataType` that
    // flows through the type-substitution machinery at all -- so it was
    // previously emitted verbatim as the literal identifier `T`, which
    // doesn't exist in the generated C. Only fires when a substitution
    // context is ACTUALLY active and the argument matches one of its
    // params.
    // 
    // Falls through to a SECOND, unconditional check below (any bare-
    // identifier `sizeof` argument, substitution context or not) for a
    // builtin scalar keyword (`sizeof(bin)`, `sizeof(chr)`, ...) --
    // same underlying problem, just without a generic type param
    // involved at all: the argument is an ordinary identifier
    // expression, emitted verbatim with no builtin-name mapping, so
    // `sizeof(bin)` (a real, non-generic `Vec<bin>`-storage `alloc`
    // body, e.g.) came out as literal C `sizeof(bin)` -- "bin" isn't a
    // real C type. `write_type_name` is always safe here even when the
    // identifier ISN'T a builtin keyword (a real local variable name, or
    // a user-defined compound/enum name): `map_type_to_c` passes any
    // unrecognized name through UNCHANGED, matching the previous plain-
    // identifier emission exactly for every case this fix doesn't apply
    // to.
    if equals(callee_name, "sizeof") && args.len == 1 {
      // `sizeof(Generic<T>)` -- parser.fn's own `.CompoundInit` node with
      // ZERO fields, used as a plain "type reference, no literal body"
      // carrier for exactly this shape (see `parse_expressionable_
      // single`'s own doc comment for why no new AST node was needed).
      // Resolved (and, on first use, monomorphized) the SAME way any
      // other generic-type reference is, via `resolve_type_name`.
      fit args.get(0).kind {
        .CompoundInit(ci) -> {
          if ci.has_dtype {
            let resolved = self.resolve_type_name(*ci.init_dtype);
            if resolved.is_some() {
              self.state.write("sizeof(");
              self.write_type_name(resolved.unwrap());
              self.state.write(")");
              ret .None;
            }
          }
        }
        _ -> {}
      }
      str sizeof_operand = "";
      bin have_sizeof_operand = false;
      fit args.get(0).kind {
        .Identifier(name) -> {
          sizeof_operand = name;
          have_sizeof_operand = true;
        }
        _ -> {}
      }
      if have_sizeof_operand {
        if self.type_subst_param_names.len > 0 {
          num spi = 0;
          for spi < self.type_subst_param_names.len {
            if equals(self.type_subst_param_names.get(spi), sizeof_operand) {
              self.state.write("sizeof(");
              self.write_type_name(self.type_subst_arg_type_strs.get(spi));
              if self.type_subst_arg_is_pointer.get(spi) {
                self.state.write("*");
              }
              self.state.write(")");
              ret .None;
            }
            spi = spi + 1;
          }
        }
        self.state.write("sizeof(");
        self.write_type_name(sizeof_operand);
        self.state.write(")");
        ret .None;
      }
    }

    // A call to a GENERIC function (`err_kind(.Parse, "msg",
    // token_zero())`) is monomorphized from THIS call site's own
    // arguments, under a mangled name -- see
    // `maybe_instantiate_generic_function`'s doc comment. A plain
    // (already-registered non-generic) callee, or one this codegen
    // doesn't recognize at all, is left as `callee_name` unchanged --
    // matching this file's "no name resolution for the free-function
    // case" simplification elsewhere. `template_callee_name` (the
    // ORIGINAL, un-mangled name) is kept separately for the per-argument
    // bare-shorthand lookup below -- `lookup_function_param_type` only
    // recognizes a generic template under ITS OWN bare name, not the
    // mangled call-site name `callee_name` becomes once monomorphized.
    str template_callee_name = callee_name;
    let generic_inst = self.maybe_instantiate_generic_function(callee_name, args);
    if generic_inst.is_some() {
      callee_name = generic_inst.unwrap().mangled_name;
    } else {
      // See `ensure_plain_function_prototype_emitted`'s own doc comment:
      // a NON-generic plain function's signature can still be unsafe for
      // the early forward-declare pass. Only reached for the already-
      // non-generic case (`generic_inst.is_none()`) -- a generic
      // function's own prototype+body is handled entirely by `maybe_
      // instantiate_generic_function` above instead.
      self.ensure_plain_function_prototype_emitted(callee_name);
    }
    self.state.write(callee_name);
    self.state.write("(");

    bin first = true;
    num arg_idx = 0;
    for arg : args {
      if !first {
        self.state.write(", ");
      }
      first = false;

      // A bare enum-variant shorthand (`.Parse`) passed as a call
      // argument (`err_kind(.Parse, "msg", 0)`, e.g.
      // `_read_comment_block`'s real body in the self-hosted lexer's own
      // source, found via the self-compile experiment) resolves against
      // the CALLEE's own declared parameter type at this position. For
      // a GENERIC callee (`ok(.None)`, e.g.), this MUST be the call's
      // own ALREADY-SUBSTITUTED param type (`generic_inst`'s own
      // `param_types`, e.g. `Option<num>` -> `Option__num`, not the
      // template's raw, unsubstituted `T`) -- `T` alone would resolve to
      // nothing (not a real enum name) and reject a shorthand that
      // should actually work. Falls back to the plain (non-generic)
      // registry -- `Codegen.function_names`'s doc comment -- when this
      // callee wasn't a generic template at all. An unresolvable
      // callee/position leaves `expected_enum_type` untouched, same as
      // every other site.
      Option<DataType> ptype = .None;
      if generic_inst.is_some() {
        let call_res = generic_inst.unwrap();
        if arg_idx < call_res.param_types.len {
          ptype = .Some(call_res.param_types.get(arg_idx));
        }
      }
      if ptype.is_none() {
        let plain_ptype = self.lookup_function_param_type(template_callee_name, arg_idx);
        if plain_ptype.is_some() {
          ptype = .Some(*plain_ptype.unwrap());
        }
      }
      str prev_expected = self.expected_enum_type;
      bin arg_did_quirk_coerce = false;
      if ptype.is_some() {
        let resolved = self.resolve_type_name(ptype.unwrap());
        if resolved.is_some() {
          self.expected_enum_type = resolved.unwrap();
          // A concrete-typed argument (`show(&w)`, `w`'s type `Wrapper`)
          // passed where the callee's OWN declared parameter is a QUIRK
          // type (`fun show(To<num> t)`, `examples/stdlib/generic_to_
          // from.fn`'s own real `to_json_value(&c)`) needs the same
          // coercion wrap a `Variable` declaration's/`ret`'s own
          // initializer already gets -- see `resolve_quirk_coerce_
          // concrete_type`'s own doc comment. Without this, the argument
          // passed its own concrete pointer type directly where C
          // expects the quirk's fat-pointer struct by value.
          if self.quirk_names.contains(resolved.unwrap()) {
            let arg_concrete = self.resolve_quirk_coerce_concrete_type(arg);
            if arg_concrete.is_some() {
              self.state.write("__fun_coerce_");
              self.state.write(arg_concrete.unwrap());
              self.state.write("_");
              self.state.write(resolved.unwrap());
              self.state.write("(");
              arg_did_quirk_coerce = true;
            }
          }
        }
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      if aerr.is_some() {
        ret aerr;
      }
      if arg_did_quirk_coerce {
        self.state.write(")");
      }
      arg_idx = arg_idx + 1;
    }
    // Any trailing param(s) OMITTED at this call site (`greet("a")`
    // calling `greet(str name, num times = 2, str sep = "-")`) get
    // their own declared DEFAULT value expression filled in here --
    // see `Codegen.function_default_values`'s own doc comment. A
    // GENERIC call (`generic_inst.is_some()`) never reaches this: a
    // generic function's own defaults aren't tracked at all (see that
    // field's own doc comment), so `lookup_function_default_values`
    // (keyed by the PLAIN registry, `template_callee_name` here would
    // be the unsubstituted template name anyway) is skipped for it.
    if generic_inst.is_none() {
      let defaults = self.lookup_function_default_values(template_callee_name);
      if defaults.is_some() {
        let dparam_types = self.lookup_function_param_types(template_callee_name);
        let derr = self.emit_default_trailing_args(defaults.unwrap(), dparam_types, args.len);
        if derr.is_some() {
          ret derr;
        }
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits `, <default value expr>` for each trailing parameter position
  // from `provided_count` onward that HAS a recorded default (a `nil`
  // entry means no default, and stops filling further positions right
  // there -- the language's own rule that defaults must be trailing
  // means a real gap here is a call-arity error the ORIGINAL compiler's
  // typechecker already catches upstream, not something this codegen
  // needs to re-diagnose). Shared by `emit_call`/`emit_method_call`, see
  // `Codegen.function_default_values`'s own doc comment for why
  // defaults are evaluated FRESH at each call site rather than cached.
  // 
  // `param_types` (when the caller has it -- `.None` for the rare case
  // it doesn't) is that SAME position's own declared param type,
  // resolved into `expected_enum_type`/`expected_compound_type` before
  // emitting each default -- needed the moment a default value is
  // ITSELF a bare shorthand (`LogFormat format = .Text;`, `std/log.fn`'s
  // own real `logger_init` signature, found via a real "unsupported
  // node" error): without this, a bare `.Text` default has nothing to
  // resolve against, the exact same gap a caller-PROVIDED bare-shorthand
  // argument would have without its own equivalent lookup.
  emit_default_trailing_args(
    Vec<Node*> defaults,
    Option<Vec<DataType *>> param_types,
    num provided_count
  ) Option<CodegenErrorKind> {
    num i = provided_count;
    for i < defaults.len {
      Node* d = defaults.get(i);
      if d == nil {
        ret .None;
      }
      self.state.write(", ");
      str prev_expected_e = self.expected_enum_type;
      str prev_expected_c = self.expected_compound_type;
      if param_types.is_some() {
        let ptypes = param_types.unwrap();
        if i < ptypes.len {
          let resolved = self.resolve_type_name(*ptypes.get(i));
          if resolved.is_some() {
            self.expected_enum_type = resolved.unwrap();
            self.expected_compound_type = resolved.unwrap();
          }
        }
      }
      let derr = self.emit_expr(*d);
      self.expected_enum_type = prev_expected_e;
      self.expected_compound_type = prev_expected_c;
      if derr.is_some() {
        ret derr;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Infers a best-effort C element type for a bare array literal
  // (`[1, 2, 3]`) from its FIRST element -- needed ONLY for a `let`
  // declaration's own initializer (`let arr = [1, 2, 3];`): C rejects
  // `__auto_type x = {1, 2, 3};` outright ("cannot use '__auto_type'
  // with initializer list"), unlike an EXPLICITLY typed declaration
  // (`num[] arr = [1, 2, 3];`), which just declares the real array type
  // on the LHS and needs no C-side inference at all. The bare brace-
  // list this codegen otherwise emits for an array literal (`Codegen.
  // in_array_initializer`'s own doc comment) needs a GNU compound-
  // literal cast (`(int64_t[]){1, 2, 3}`) wrapped around it instead, for
  // `let` specifically -- this resolves just the `int64_t` part.
  // Defaults to `int64_t` for anything unrecognized (an empty literal,
  // or a first element this narrow check doesn't cover) -- a reasonable
  // fallback, not a guess that could silently miscompile: worst case a
  // numeric-shaped default on a non-numeric array is a C type error,
  // not a wrong VALUE.
  infer_array_literal_elem_c_type(Node* inner) str {
    Vec<Node*> elems;
    elems.init(0);
    defer elems.free();
    self.flatten_call_args(inner, &elems);
    if elems.len == 0 {
      ret "int64_t";
    }
    let first = elems.get(0);
    fit first.kind {
      .Number(data) -> {
        fit data {
          .Dec(_) -> { ret "double"; }
          _ -> { ret "int64_t"; }
        }
      }
      .String(_) -> { ret "char*"; }
      .Character(_) -> { ret "char"; }
      .Boolean(_) -> { ret "bool"; }
      .Identifier(name) -> {
        let tn = self.lookup_local_type_name(name);
        if tn.is_some() {
          ret map_type_to_c(tn.unwrap());
        }
        ret "int64_t";
      }
      // `[Point{x = 0, y = 1}, Point{x = 2, y = 3}]` -- an explicit
      // compound literal carries its own type name directly, same as
      // `infer_let_expr_type`'s own identical `.CompoundInit` case.
      .CompoundInit(ci) -> {
        if ci.has_dtype {
          ret ci.init_dtype.type_str;
        }
        ret "int64_t";
      }
      // `[make_point(n, n + 1), make_point(n2, n2 + 1)]` -- a call to a
      // registered PLAIN function's own declared return type.
      .Expression(e2) -> {
        if equals(e2.op, "()") && e2.has_left {
          fit e2.left.kind {
            .Identifier(fn_name) -> {
              let rt = self.lookup_function_rtype(fn_name);
              if rt.is_some() {
                ret rt.unwrap().type_str;
              }
            }
            _ -> {}
          }
        }
        ret "int64_t";
      }
      _ -> { ret "int64_t"; }
    }
  }

  // Emits `recv.method(args...)` as C `recv.vtable->method(recv.self,
  // args...)` (`recv->vtable->...`/`recv->self` when `recv` is itself a
  // pointer to the quirk's fat-pointer struct, rather than the struct
  // value directly) -- the dynamic-dispatch counterpart to
  // `emit_method_call`'s own static dispatch, called from there once
  // `recv_r.type_name` is recognized as a quirk name (see
  // `emit_quirk_vtable_machinery`'s doc comment for the vtable/`self`
  // field this reads). No temp-hoisting needed even when `recv_r` is a
  // CALL's own rendered text (an rvalue) -- unlike taking `&recv` (the
  // static path's own self-arg), C allows plain `.field` access on a
  // struct rvalue directly.
  emit_quirk_dispatch_call(ChainResolution recv_r, str method_name, Node* args_node) Option<CodegenErrorKind> {
    str sep = ".";
    if recv_r.is_pointer {
      sep = "->";
    }
    self.state.write(recv_r.text);
    self.state.write(sep);
    self.state.write("vtable->");
    self.state.write(method_name);
    self.state.write("(");
    self.state.write(recv_r.text);
    self.state.write(sep);
    self.state.write("self");
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);
    for arg : args {
      self.state.write(", ");
      let aerr = self.emit_expr(*arg);
      if aerr.is_some() {
        ret aerr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Resolves the CONCRETE type an expression's own value coerces FROM,
  // for a quirk-typed destination (a `Variable` declaration's own
  // initializer, or a `ret` whose enclosing function's declared return
  // type is a quirk -- see each call site's own doc comment) -- the
  // `__fun_coerce_<Type>_<Quirk>` helper (`emit_quirk_vtable_
  // machinery`'s own doc comment) needs `<Type>` by name to call the
  // right one. Resolved structurally, same "known local, not fully
  // inferred" style as everywhere else in this file -- two shapes:
  // - `&identifier` (`Shape s = &rect;`): the concrete type is
  // `identifier`'s own recorded local type name.
  // - a bare identifier that's ALREADY a pointer (`ret p;` inside `fun
  // as_hasx(Point* p) HasX`): same lookup, no `&` to see through first.
  // `.None` for anything else (a chained receiver, a call result, ...)
  // -- not yet reachable by anything ported so far.
  resolve_quirk_coerce_concrete_type(Node* exp) Option<str> {
    fit exp.kind {
      .Unary(u) -> {
        if equals(u.op, "&") && !u.is_left_operanded_unary {
          fit u.operand.kind {
            .Identifier(oname) -> { ret self.lookup_local_type_name(oname); }
            _ -> {}
          }
        }
      }
      .Identifier(name) -> {
        let is_ptr = self.lookup_local_is_pointer(name);
        if is_ptr.is_some() && is_ptr.unwrap() {
          ret self.lookup_local_type_name(name);
        }
      }
      _ -> {}
    }
    ret .None;
  }

  // Emits a method call `recv.method(arg1, ...)` as C
  // `TypeName__method(<self-arg>, arg1, ...)` -- or `TypeName__Quirk__
  // method(...)` when `method` was defined by a QUIRK-implementing impl
  // instead of a plain one, resolved via `lookup_impl_method` (populated
  // by `register_impl_methods`' own pre-pass -- see `transpile`'s pass
  // ordering). Falls back to the plain `TypeName__method` naming
  // directly when nothing's registered (an isolated call to
  // `emit_method_call` outside `transpile`, as every existing unit test
  // below does) -- codegen doesn't invent either mangling scheme itself,
  // it only has to reproduce whichever one `_parse_impl_method` already
  // used for that method's `Function` node in the parser. The self-arg
  // is `recv` directly when `recv` is already a pointer local, or `&recv`
  // when it's a value local (the callee always expects a pointer,
  // matching the implicit `self` parameter's type).
  // 
  // Deliberately narrow for this slice: `recv` must be a plain
  // identifier OR a chained field access `resolve_field_chain` can
  // resolve (`self.parts.push(s)`, e.g. `StringBuilder.append`'s real
  // body in stdlib/std/string.fn, found via the self-compile
  // experiment -- reuses the exact same resolution `emit_fit`'s subject
  // and the bare-shorthand assignment case already use, rather than a
  // second, narrower bare-identifier-only lookup), and `method` a plain
  // identifier. An unrecognized receiver is REJECTED rather than
  // guessed, same spirit as `emit_field_access`. A receiver whose
  // resolved type name is a known QUIRK (`Codegen.quirk_names`, see
  // `emit_quirk_vtable_machinery`'s doc comment) dispatches dynamically
  // through its vtable instead of the STATIC dispatch below (resolved by
  // the receiver's own DECLARED CONCRETE type name, whether that type
  // implements the method via a plain impl or a quirk-implementing one).
  emit_method_call(ExprNode recv_e, Node* args_node) Option<CodegenErrorKind> {
    if !recv_e.has_left || !recv_e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    let recv_r_opt = self.resolve_field_chain(recv_e.left);
    if recv_r_opt.is_none() {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }
    let recv_r = recv_r_opt.unwrap();
    str method_name = "";
    fit recv_e.right.kind {
      .Identifier(name) -> { method_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    if self.quirk_names.contains(recv_r.type_name) {
      ret self.emit_quirk_dispatch_call(recv_r, method_name, args_node);
    }

    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);

    // A method declaring its OWN generic type param (`impl Box<T> { pub
    // wrap<U>(U x) Box<U> { ... } }`) needs a COMBINED substitution
    // (impl's T + this call's own U, inferred from `args`) that neither
    // `ensure_generic_impl_method_emitted` (impl-only) nor the plain
    // static-dispatch fallback below knows how to build -- see
    // `maybe_instantiate_generic_impl_method_own_params`'s own doc
    // comment. Checked FIRST, before either of those.
    bin used_own_param_inst = false;
    if self.impl_method_has_own_type_params(recv_r.type_name, method_name) {
      let own_inst = self.maybe_instantiate_generic_impl_method_own_params(
        recv_r.type_name,
        method_name,
        args
      );
      if own_inst.is_some() {
        self.state.write(own_inst.unwrap().mangled_name);
        used_own_param_inst = true;
      }
    }

    if !used_own_param_inst {
      // A generic impl method (`Vec<str>.sum()`, e.g.) only gets its
      // actual C prototype+body emitted here, at its first real call site
      // for THIS instantiation -- see `ensure_generic_impl_method_
      // emitted`'s own doc comment for why. A no-op (`.None`, nothing
      // emitted) for a plain (non-generic) type's method, already emitted
      // unconditionally elsewhere.
      let emit_err = self.ensure_generic_impl_method_emitted(recv_r.type_name, method_name);
      if emit_err.is_some() {
        ret emit_err;
      }
      let registered = self.lookup_impl_method(recv_r.type_name, method_name);
      if registered.is_some() {
        // A PLAIN impl method's own signature can be UNSAFE for the early
        // forward-declare pass (a generic return/param type, e.g. `Lexer.
        // _next_inner()`'s own `Result<Option<Token>, Error>`) -- such a
        // method falls back to natural source order there, which breaks
        // the moment it's called from a method defined EARLIER in the
        // same file (`Lexer.next()`'s own real body calling `self.
        // _next_inner()`, itself defined further down in the same `impl
        // Lexer` block). Ensures an inline bare prototype exists at this
        // call's own first-use point instead (see `ensure_plain_impl_
        // method_prototype_emitted`'s own doc comment) -- a no-op once
        // the early pass already covered it, or once this exact method
        // already got its own inline prototype from an earlier call site.
        self.ensure_plain_impl_method_prototype_emitted(recv_r.type_name, method_name);
        self.state.write(registered.unwrap());
      } else {
        self.state.write(recv_r.type_name);
        self.state.write("__");
        self.state.write(method_name);
      }
    }
    self.state.write("(");
    if recv_r.is_pointer {
      self.state.write(recv_r.text);
    } elif recv_r.is_call_result {
      // `recv_r.text` is a CALL's own rendered text (an RVALUE, see
      // `ChainResolution.is_call_result`'s own doc comment) -- `&
      // <rvalue>` is invalid C ("cannot take the address of an
      // rvalue"), found via a real stage-2 self-compilation C error for
      // `is_dynamic_int_datatype`'s own real body, `parse_dynamic_int_
      // datatype(s).is_some()`. Hoisted into a fresh `__auto_type` temp,
      // spliced (via the SAME `current_stmt_start_pos` splice `emit_
      // generic_impl_method_prototype_now` uses, for the identical
      // "this call site can be arbitrarily deep inside a larger
      // statement, not just a first-in-body call" reason) as its own
      // declaration statement right before the CURRENT one, then `&`
      // the temp instead -- a genuine addressable local.
      self.call_recv_temp_counter = self.call_recv_temp_counter + 1;
      StringBuilder recv_tmp_name_sb = string_builder_init(24);
      recv_tmp_name_sb.append("__fun_recv_tmp");
      recv_tmp_name_sb.append(format_num(self.call_recv_temp_counter));
      str recv_tmp_name = recv_tmp_name_sb.build();

      StringBuilder recv_tmp_stmt_sb = string_builder_init(64);
      num recv_tmp_ii = 0;
      for recv_tmp_ii < self.state.indent_level {
        recv_tmp_stmt_sb.append("    ");
        recv_tmp_ii = recv_tmp_ii + 1;
      }
      recv_tmp_stmt_sb.append("__auto_type ");
      recv_tmp_stmt_sb.append(recv_tmp_name);
      recv_tmp_stmt_sb.append(" = ");
      recv_tmp_stmt_sb.append(recv_r.text);
      recv_tmp_stmt_sb.append(";\n");

      if self.hoist_scratch_depth > 0 {
        // Nested inside `resolve_field_chain`'s own call-as-receiver
        // scratch buffer (a multi-level chained call receiver, e.g.
        // `logger_init(.Info).with_timestamps(false).named("app")`) --
        // `hoist_insert_pos`/`current_stmt_start_pos` only ever reach
        // THIS immediately-enclosing scratch buffer, which is supposed
        // to hold a pure EXPRESSION result, not a STATEMENT. Reach
        // through to the TRUE root buffer/position instead -- see
        // `Codegen.hoist_scratch_depth`'s own doc comment.
        CodegenState* saved_nested_state = self.state;
        let saved_nested_hoist_pos = self.hoist_insert_pos;
        let saved_nested_stmt_pos = self.current_stmt_start_pos;
        self.state = self.root_state;
        self.hoist_insert_pos = self.root_stmt_start_pos;
        self.current_stmt_start_pos = self.root_stmt_start_pos;
        str recv_tmp_text_root = recv_tmp_stmt_sb.build();
        // `root_hoist_pos` tracks a DIFFERENT (coarser) position into
        // this SAME root buffer -- see `adjust_pos_after_splice`'s own
        // doc comment for why it needs the same shift `current_stmt_
        // start_pos` gets automatically from `emit_hoisted` below.
        let root_splice_pos_before = self.current_stmt_start_pos;
        self.emit_hoisted(recv_tmp_text_root);
        if root_splice_pos_before.is_some() {
          self.root_hoist_pos = adjust_pos_after_splice(
            self.root_hoist_pos,
            root_splice_pos_before.unwrap(),
            len(recv_tmp_text_root)
          );
        }
        self.root_stmt_start_pos = self.current_stmt_start_pos;
        self.state = saved_nested_state;
        self.hoist_insert_pos = saved_nested_hoist_pos;
        self.current_stmt_start_pos = saved_nested_stmt_pos;
      } else {
        let saved_recv_tmp_hoist_pos = self.hoist_insert_pos;
        let recv_tmp_splice_pos = self.current_stmt_start_pos;
        self.hoist_insert_pos = recv_tmp_splice_pos;
        str recv_tmp_text = recv_tmp_stmt_sb.build();
        self.emit_hoisted(recv_tmp_text);
        // See `adjust_pos_after_splice`'s own doc comment for why
        // `saved_recv_tmp_hoist_pos` needs manual adjustment here too.
        if recv_tmp_splice_pos.is_some() {
          saved_recv_tmp_hoist_pos = adjust_pos_after_splice(
            saved_recv_tmp_hoist_pos,
            recv_tmp_splice_pos.unwrap(),
            len(recv_tmp_text)
          );
        }
        self.hoist_insert_pos = saved_recv_tmp_hoist_pos;
      }

      self.state.write("&");
      self.state.write(recv_tmp_name);
    } else {
      self.state.write("&");
      self.state.write(recv_r.text);
    }

    num arg_idx = 0;
    for arg : args {
      self.state.write(", ");
      // A bare enum-variant shorthand (`self.local_dtype.push(.None)`,
      // e.g.) resolves against the callee METHOD's own declared
      // parameter type at this position -- see `Codegen.impl_method_
      // param_types`'s doc comment for why this needed its own
      // lookup/tracking, mirroring `emit_call`'s identical handling for
      // a PLAIN function call exactly. An unresolvable callee/position
      // leaves `expected_enum_type`/`expected_compound_type` untouched,
      // same as every other site.
      let ptype = self.lookup_impl_method_param_type(recv_r.type_name, method_name, arg_idx);
      str prev_expected = self.expected_enum_type;
      str prev_expected_compound = self.expected_compound_type;
      if ptype.is_some() {
        let resolved = self.resolve_type_name(*ptype.unwrap());
        if resolved.is_some() {
          self.expected_enum_type = resolved.unwrap();
          self.expected_compound_type = resolved.unwrap();
        }
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      self.expected_compound_type = prev_expected_compound;
      if aerr.is_some() {
        ret aerr;
      }
      arg_idx = arg_idx + 1;
    }
    // See `emit_call`'s own identical fill-in for a plain function's
    // trailing defaults -- same mechanism, just keyed by (owner type,
    // bare method name) instead of a plain function name.
    let method_defaults = self.lookup_impl_method_default_values(recv_r.type_name, method_name);
    if method_defaults.is_some() {
      let mdparam_types = self.lookup_impl_method_param_types(recv_r.type_name, method_name);
      let mderr = self.emit_default_trailing_args(
        method_defaults.unwrap(),
        mdparam_types,
        args.len
      );
      if mderr.is_some() {
        ret mderr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits `await expr` -- `expr` must be a call (`f(args...)` or
  // `recv.method(args...)`; see `emit_async_function_support`'s own doc
  // comment for what these ultimately call). Lowers to a call to that
  // callee's own "call helper" (`__fun_async_call_<mangled name>`)
  // instead of the callee's plain mangled name -- see
  // `emit_async_or_fork_call`'s own doc comment for how the receiver/
  // mangled-name resolution works.
  // 
  // Deliberately narrow for this slice: no generic PLAIN async function
  // instantiation (`maybe_instantiate_generic_function`) -- only a
  // generic IMPL METHOD's async method is supported (channel.fn's own
  // real shape, always `await self.foo(...)`/`await dst.foo(...)`
  // inside `impl<T> Channel<T>`; `emit_method_call`'s own resolution
  // already returns the correctly mangled per-instantiation name via
  // `lookup_impl_method`, so nothing extra is needed for that case to
  // work).
  // 
  // A QUIRK-typed receiver (`await passthrough(q).add(1)` where `q`'s
  // static type is a quirk, `examples/advanced/async_quirk_await_*.fn`'s
  // own real bodies) is handled SEPARATELY, below -- the CONCRETE
  // callee behind a quirk dispatch isn't known until runtime, so there's
  // no single mangled name to build a `__fun_async_call_<name>` fiber
  // helper around at all. Matches the original transpiler's own
  // identical fallback (`is_await_dynamic_quirk_dispatch`): `await`
  // degrades to a plain SYNCHRONOUS call in this case, reusing ordinary
  // quirk-vtable dispatch (`emit_method_call`'s own `quirk_names.
  // contains` check, including its already-correct receiver-temp-hoist
  // for a call-result receiver like `passthrough(q)` here) completely
  // unchanged.
  emit_await(Node* operand) Option<CodegenErrorKind> {
    fit operand.kind {
      .Expression(e) -> {
        if equals(e.op, "()") && e.has_left {
          fit e.left.kind {
            .Expression(recv_e) -> {
              if equals(recv_e.op, ".") && recv_e.has_left && recv_e.has_right {
                let recv_r_opt = self.resolve_field_chain(recv_e.left);
                if recv_r_opt.is_some() && self.quirk_names.contains(recv_r_opt.unwrap().type_name) {
                  ret self.emit_expr(*operand);
                }
              }
            }
            _ -> {}
          }
        }
      }
      _ -> {}
    }
    ret self.emit_async_or_fork_call(operand, "__fun_async_call_");
  }

  // `fork expr;` -- `expr` (the parser's own `StatementFork` payload, a
  // call directly, no `Unary` wrapper the way `await`'s operand has --
  // see `parse_statement`'s `"fork"` dispatch in parser.fn) is
  // fire-and-forget: enqueued onto the scheduler (`__fun_go`, see
  // `emit_async_function_support`'s own fork-helper section) rather than
  // spawned-and-joined. Otherwise identical lowering to `await`, just
  // `__fun_fork_call_` instead of `__fun_async_call_` -- see
  // `emit_async_or_fork_call`'s own doc comment.
  emit_fork_stmt(Node* expr) Option<CodegenErrorKind> {
    ret self.emit_async_or_fork_call(expr, "__fun_fork_call_");
  }

  // Shared lowering for `await f(args...)`/`await recv.method(args...)`
  // and `fork f(args...)`/`fork recv.method(args...)` -- both rewrite a
  // call to `<prefix><mangled callee name>(args...)`, with the SAME
  // receiver/self-arg handling an ordinary (non-async) call already
  // gets (reusing `resolve_field_chain`/`lookup_impl_method`, matching
  // `emit_call`/`emit_method_call`'s own resolution exactly) -- neither
  // of those two functions has a seam to intercept just the callee NAME
  // they write, so this is a separate (if structurally near-identical)
  // implementation rather than a shared call.
  emit_async_or_fork_call(Node* operand, str prefix) Option<CodegenErrorKind> {
    fit operand.kind {
      .Expression(e) -> {
        if !equals(e.op, "()") || !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        fit e.left.kind {
          .Identifier(name) -> {
            self.state.write(prefix);
            self.state.write(name);
            self.state.write("(");
            Vec<Node*> args;
            args.init(0);
            defer args.free();
            self.flatten_call_args(e.right, &args);
            bin first = true;
            for arg : args {
              if !first {
                self.state.write(", ");
              }
              first = false;
              let aerr = self.emit_expr(*arg);
              if aerr.is_some() {
                ret aerr;
              }
            }
            self.state.write(")");
            ret .None;
          }
          .Expression(recv_e) -> {
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let recv_r_opt = self.resolve_field_chain(recv_e.left);
            if recv_r_opt.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let recv_r = recv_r_opt.unwrap();
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(mname) -> { method_name = mname; }
              _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
            }
            // See `emit_method_call`'s own doc comment: this is a
            // generic impl method's first real call site for THIS
            // instantiation.
            let emit_err = self.ensure_generic_impl_method_emitted(recv_r.type_name, method_name);
            if emit_err.is_some() {
              ret emit_err;
            }
            let registered = self.lookup_impl_method(recv_r.type_name, method_name);
            self.state.write(prefix);
            if registered.is_some() {
              self.state.write(registered.unwrap());
            } else {
              self.state.write(recv_r.type_name);
              self.state.write("__");
              self.state.write(method_name);
            }
            self.state.write("(");
            if recv_r.is_pointer {
              self.state.write(recv_r.text);
            } else {
              self.state.write("&");
              self.state.write(recv_r.text);
            }
            Vec<Node*> margs;
            margs.init(0);
            defer margs.free();
            self.flatten_call_args(e.right, &margs);
            for marg : margs {
              self.state.write(", ");
              let maerr = self.emit_expr(*marg);
              if maerr.is_some() {
                ret maerr;
              }
            }
            self.state.write(")");
            ret .None;
          }
          _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
        }
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Emits a tagged-union compound literal for `EnumName.Variant(args...)`:
  // ((EnumName){ .tag = EnumName_Variant, .payload.Variant = { ._0 = (a0), ... } })
  // matching the struct layout `emit_tagged_union_enum` emits -- payload
  // field names `_0`, `_1`, ... line up positionally with the union
  // struct's own fields. `args_node` is the call's (possibly
  // comma-flattened) argument-list node; reuses `flatten_call_args`
  // directly, same as an ordinary call.
  emit_enum_variant_construction(str enum_name, str variant_name, Node* args_node) Option<CodegenErrorKind> {
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);

    self.state.write("((");
    self.state.write(enum_name);
    self.state.write("){ .tag = ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(", .payload.");
    self.state.write(variant_name);
    self.state.write(" = { ");
    num i = 0;
    for arg : args {
      if i > 0 {
        self.state.write(", ");
      }
      self.state.write("._");
      self.state.write(format_num(i));
      self.state.write(" = (");
      // A bare enum-variant shorthand nested inside ANOTHER variant's
      // own construction (`.Ok(.Some(t))` -- `check`'s real body once
      // `Result<Option<Token>, Error>` monomorphizes, e.g.) resolves
      // against THIS position's own payload type -- see `Codegen.
      // enum_variant_payload_owner`'s doc comment. An unresolvable
      // enum/variant/position leaves `expected_enum_type` untouched,
      // same as every other site.
      let payload_info = self.lookup_enum_variant_payload_type(enum_name, variant_name, i);
      str prev_expected = self.expected_enum_type;
      if payload_info.is_some() {
        self.expected_enum_type = payload_info.unwrap().type_name;
      }
      let aerr = self.emit_expr(*arg);
      self.expected_enum_type = prev_expected;
      if aerr.is_some() {
        ret aerr;
      }
      self.state.write(")");
      i = i + 1;
    }
    self.state.write(" } })");
    ret .None;
  }

  // Emits `arr[i]` as C `arr[i]` -- the parser already built this as
  // `Expression{ op = "[]", left = arr, right = Bracket(i) }` (see
  // `parser.parse_for_bracket`'s doc comment, which also builds a bare
  // `Bracket` node with no left for an array LITERAL, `[1, 2, 3]` --
  // structurally distinct, not reachable through here). Needs no type
  // resolution at all: C's own `[]` composes directly with whatever
  // `arr` already emitted as (a raw array, a pointer, or a `.`/`->`
  // field access -- `self.data[i]` and `self->data[i]` both just work,
  // since `emit_expr(e.left)` already resolved that), and this codegen
  // doesn't track element types the way it tracks a LOCAL's own
  // compound/enum type, so there's nothing further to look up here
  // either. Reused automatically as an ASSIGNMENT target too (`arr[i] =
  // x;`) since the `=` case dispatches its own left side through this
  // same `emit_expr` -> `.Expression` path, exactly like `.`/`->` field
  // access already does.
  emit_index(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    let lerr = self.emit_expr(*e.left);
    if lerr.is_some() {
      ret lerr;
    }
    self.state.write("[");
    fit e.right.kind {
      .Bracket(inner) -> {
        let ierr = self.emit_expr(*inner);
        if ierr.is_some() {
          ret ierr;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
    self.state.write("]");
    ret .None;
  }

  // Emits `recv.field` as C `recv.field` or `recv->field`, deciding
  // `.`/`->` from `recv`'s DECLARED pointer-ness (`lookup_local_is_pointer`
  // -- no type inference, just the same "already fully explicit" model
  // this whole file uses elsewhere). Also recognizes a QUALIFIED
  // enum-variant-constant access (`EnumName.Variant`, checked first --
  // see `enum_has_variant`) and emits its mangled C constant
  // (`EnumName_Variant`, single underscore, matching `emit_enum`'s own
  // naming) instead of treating `EnumName` as a receiver, and a BARE
  // shorthand (`.Variant`, no qualifier) resolved against
  // `expected_enum_type`. A CHAINED access (`a.b.c`) recurses through
  // `emit_receiver_and_resolve_type` to resolve `.`/`->` at every link,
  // not just the outermost receiver.
  // 
  // Deliberately narrow for this slice: the enum-variant paths (qualified
  // or bare shorthand) only ever apply to a SINGLE-level receiver
  // (`Identifier`/`Blank`) -- the exact same AST shape also parses
  // `alias.symbol` (a module-aliased access), which isn't reachable yet
  // (needs import support), so an unrecognized single-level receiver is
  // rejected rather than guessed. See `emit_receiver_and_resolve_type`'s
  // own doc comment for what the chained-access path can't handle yet.
  emit_field_access(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str field_name = "";
    fit e.right.kind {
      .Identifier(name) -> { field_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    str enum_recv_name = "";
    bin is_bare_shorthand = false;
    bin left_is_single_level = false;

    // `alias.EnumName.Variant` used as a VALUE (not a call, which
    // `emit_call` handles separately) -- `e.left` here is `alias.
    // EnumName` (an Expression, not a bare Identifier), so this needs
    // checking BEFORE the ordinary single-level `fit e.left.kind` below,
    // which only ever recognizes a bare identifier receiver. See
    // `Codegen.import_aliases`'s own doc comment.
    fit e.left.kind {
      .Expression(inner_e) -> {
        if equals(inner_e.op, ".") && inner_e.has_left && inner_e.has_right {
          // Gated on NOT already a known local -- see `emit_call`'s own
          // identical gate for why (a real local always shadows a
          // same-named global alias).
          bin inner_left_is_alias = false;
          fit inner_e.left.kind {
            .Identifier(aname) -> {
              if self.import_aliases.contains(aname) && self.lookup_local_type_name(aname).is_none() {
                inner_left_is_alias = true;
              }
            }
            _ -> {}
          }
          if inner_left_is_alias {
            fit inner_e.right.kind {
              .Identifier(ename) -> {
                enum_recv_name = ename;
                left_is_single_level = true;
              }
              _ -> {}
            }
          }
        }
      }
      _ -> {}
    }
    if left_is_single_level {
      // Matched the alias case above -- skip the ordinary single-level
      // check below entirely (it would otherwise see `e.left` as an
      // unrecognized `.Expression` and leave `left_is_single_level`
      // untouched anyway, but skipping is clearer than relying on that).
    } else {
      fit e.left.kind {
        .Identifier(name) -> {
          enum_recv_name = name;
          left_is_single_level = true;
        }
        .Blank -> {
          // Bare shorthand (`.Variant`, no `EnumName.` qualifier) -- see
          // `Codegen.expected_enum_type`'s doc comment. Must NOT fall
          // through to the chained-access path below if this doesn't pan
          // out (there's no receiver identifier to look up at all).
          is_bare_shorthand = true;
          left_is_single_level = true;
          enum_recv_name = self.expected_enum_type;
        }
        _ -> {}
      }
    }
    // `Option<num> b = Option.None;` -- a QUALIFIED variant written
    // against a GENERIC enum's own bare TEMPLATE name ("Option"),
    // which is never itself registered in `enum_names` (only a
    // concrete INSTANTIATION is, once `ensure_enum_instantiated` mangles
    // it, e.g. "Option__num"). `self.expected_enum_type` already holds
    // that exact mangled name here (set from the declared type just
    // above, in the `Variable`-declaration case -- see `resolve_type_
    // name`'s own generic-arg handling) -- fall back to it when the
    // bare template name alone doesn't resolve.
    if left_is_single_level && !is_bare_shorthand && !self.enum_has_variant(
      enum_recv_name,
      field_name
    ) {
      StringBuilder tmpl_pfx = string_builder_init(16);
      tmpl_pfx.append(enum_recv_name);
      tmpl_pfx.append("__");
      if starts_with(self.expected_enum_type, tmpl_pfx.build()) && self.enum_has_variant(
        self.expected_enum_type,
        field_name
      ) {
        enum_recv_name = self.expected_enum_type;
      }
    }
    if left_is_single_level && !equals(enum_recv_name, "") && self.enum_has_variant(
      enum_recv_name,
      field_name
    ) {
      if self.enum_is_tagged_union_named(enum_recv_name) {
        // A tagged union's payload-less variant used as a bare VALUE
        // (no call) still needs the tag set: `((Enum){ .tag =
        // Enum_Variant })`, not just the bare discriminant constant --
        // see `emit_enum`'s doc comment for the struct layout this
        // constructs. `EnumName_Variant` alone would only be the
        // discriminant, not a complete `Enum`-typed value.
        self.state.write("((");
        self.state.write(enum_recv_name);
        self.state.write("){ .tag = ");
        self.state.write(enum_recv_name);
        self.state.write("_");
        self.state.write(field_name);
        self.state.write(" })");
      } else {
        self.state.write(enum_recv_name);
        self.state.write("_");
        self.state.write(field_name);
      }
      ret .None;
    }
    if is_bare_shorthand {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }

    let recv_info_opt = self.emit_receiver_and_resolve_type(e.left);
    if recv_info_opt.is_none() {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }
    if recv_info_opt.unwrap().is_pointer {
      self.state.write("->");
    } else {
      self.state.write(".");
    }
    self.state.write(field_name);
    ret .None;
  }

  // Resolves `recv`'s C text and declared type (name + pointer-ness)
  // WITHOUT writing anything to `self.state` -- the pure counterpart to
  // `emit_receiver_and_resolve_type` below, which delegates to this
  // function and then writes the resolved text in one shot. Needed
  // wherever a receiver's text must be computed ONCE but written
  // MULTIPLE times (e.g. `emit_fit`'s subject, re-emitted per branch).
  // `recv` is either a plain identifier -- a KNOWN local (see
  // `record_local`), resolved directly -- or itself a `.`-Expression
  // (`a.b` inside `a.b.c`, which this language's LEFT-associative `.`
  // precedence produces for a chain -- see `op_precedence_for`'s table in
  // `expressionable_defs.fn`), recursed through this same function to
  // resolve ITS OWN receiver first, then looking up the resulting type's
  // field via `lookup_compound_field`.
  // 
  // `.None` means `recv` isn't a shape/type this codegen can resolve (an
  // unknown local, an unrecognized compound/field, or anything besides a
  // plain identifier or a chained `.`-Expression) -- the caller must
  // treat that as "can't handle this," not guess. Deliberately narrow for
  // this slice: no enum-variant or bare-shorthand handling INSIDE a
  // chain (`a.Some.b` isn't reachable -- those only ever appear as a
  // single-level receiver, handled by `emit_field_access` itself before
  // this function is ever reached for the outermost level).
  resolve_field_chain(Node* recv) Option<ChainResolution> {
    fit recv.kind {
      .Identifier(name) -> {
        let type_found = self.lookup_local_type_name(name);
        let ptr_found = self.lookup_local_is_pointer(name);
        if type_found.is_none() || ptr_found.is_none() {
          ret .None;
        }
        ChainResolution r;
        r.text = name;
        r.type_name = type_found.unwrap();
        r.is_pointer = ptr_found.unwrap();
        r.dtype = self.lookup_local_dtype(name);
        r.is_call_result = false;
        ret .Some(r);
      }
      .Expression(inner_e) -> {
        // A CALL as the receiver (`tok.unwrap().type`, e.g. `ParseState.
        // parse_type_params_with_constraints`'s own real body, found via
        // the self-compile experiment -- `tok.unwrap()` is the call,
        // `.type` the field read off its result, with NO intermediate
        // `let` binding). Resolved in two steps: the call's own declared
        // return type (a plain function via `lookup_function_rtype`, or
        // a method call via `resolve_field_chain` on ITS OWN receiver +
        // `lookup_impl_method_rtype` -- the exact same two lookups
        // `infer_let_expr_type`'s identical "()" case already uses),
        // then the call's OWN rendered C text -- which, unlike every
        // other link in a chain, this function can't build by simple
        // string concatenation, since a call has real emission logic
        // (argument lists, mangled callee names, ...) already living in
        // `emit_expr`/`emit_call`. Rendered into a throwaway SCRATCH
        // buffer (same swap-self.state-then-restore technique
        // `emit_hoisted`'s three callers already use) purely to capture
        // that text without writing it here.
        if equals(inner_e.op, "()") && inner_e.has_left {
          Option<DataType> call_rtype = .None;
          fit inner_e.left.kind {
            .Identifier(fn_name) -> {
              let rt = self.lookup_function_rtype(fn_name);
              if rt.is_some() {
                call_rtype = .Some(*rt.unwrap());
              }
            }
            .Expression(recv_e) -> {
              if equals(recv_e.op, ".") && recv_e.has_left && recv_e.has_right {
                str method_name = "";
                fit recv_e.right.kind {
                  .Identifier(n) -> { method_name = n; }
                  _ -> {}
                }
                // `alias.func(args)` -- a plain function call qualified
                // by an import alias (`m.to_async(&c)`, `examples/
                // imports/async_quirk_alias/main.fn`'s own real body),
                // sharing this exact `.`-`()`  AST shape with an
                // ordinary method call. Same alias-vs-method
                // disambiguation `emit_call`'s own identical check
                // already uses: `recv_e.left` (here "m") is a KNOWN
                // ALIAS, not a receiver OBJECT, so `method_name` (here
                // "to_async") is really the CALLEE's own bare name --
                // resolved via the ordinary plain-function lookup, not
                // `lookup_impl_method_rtype`, which would otherwise try
                // (and fail) to resolve "m" as a typed local. Checked
                // FIRST, before assuming `recv_e.left` is a real
                // receiver.
                bin left_is_known_alias2 = false;
                if !equals(method_name, "") {
                  fit recv_e.left.kind {
                    .Identifier(lname2) -> {
                      if self.import_aliases.contains(lname2) && self.lookup_local_type_name(lname2).is_none() {
                        left_is_known_alias2 = true;
                      }
                    }
                    _ -> {}
                  }
                }
                if left_is_known_alias2 {
                  let alias_rt = self.lookup_function_rtype(method_name);
                  if alias_rt.is_some() {
                    call_rtype = .Some(*alias_rt.unwrap());
                  }
                } elif !equals(method_name, "") {
                  let recv_r_opt = self.resolve_field_chain(recv_e.left);
                  if recv_r_opt.is_some() {
                    let recv_r2 = recv_r_opt.unwrap();
                    // A method declaring its OWN generic type param
                    // (`impl Box<T> { pub wrap<U>(...) Box<U> { ... }
                    // }`) needs the COMBINED (impl's + this call's own)
                    // substitution `maybe_instantiate_generic_impl_
                    // method_own_params` builds -- `lookup_impl_method_
                    // rtype` below only ever knows the impl's OWN
                    // static registration, which for such a method is
                    // the raw, unsubstituted template return type
                    // (`Box<U>` -> the literal, invalid "Box__U").
                    // Checked FIRST, letting CHAINING off such a call's
                    // own result (`b.wrap("hello").get()`, `examples/
                    // advanced/method_own_type_param.fn`'s own real
                    // body) resolve correctly.
                    if inner_e.has_right && self.impl_method_has_own_type_params(
                      recv_r2.type_name,
                      method_name
                    ) {
                      Vec<Node*> own_args;
                      own_args.init(0);
                      self.flatten_call_args(inner_e.right, &own_args);
                      let own_res = self.maybe_instantiate_generic_impl_method_own_params(
                        recv_r2.type_name,
                        method_name,
                        own_args
                      );
                      if own_res.is_some() {
                        call_rtype = .Some(own_res.unwrap().rtype);
                      }
                    }
                    if call_rtype.is_none() {
                      let rt = self.lookup_impl_method_rtype(recv_r2.type_name, method_name);
                      if rt.is_some() {
                        call_rtype = .Some(*rt.unwrap());
                      }
                    }
                  }
                }
              }
            }
            _ -> {}
          }
          if call_rtype.is_none() {
            ret .None;
          }
          let rdt = self.resolve_type_subst(call_rtype.unwrap());
          let resolved_name_opt = self.resolve_type_name(rdt);
          if resolved_name_opt.is_none() {
            ret .None;
          }

          // `hoist_insert_pos` (if set) is a position measured against
          // the OUTER, now-swapped-away buffer -- suspending it for the
          // duration of this swap, same as every OTHER scratch-buffer
          // swap in this file, keeps a NESTED hoisted emission
          // triggered from inside this call (e.g. a generic impl
          // method reached for the first time right here, as this
          // call's own receiver) from splicing at a stale position
          // into THIS tiny scratch buffer instead of the real one --
          // confirmed via a real crash (`emit_hoisted` -> `StringBuilder.
          // append` -> null deref) when this swap didn't suspend it.
          // 
          // `current_stmt_start_pos` needs the EXACT same suspension,
          // for the exact same reason -- missed the first time around
          // (only `hoist_insert_pos` was fixed then), found via a
          // SECOND, deeper real crash: a MULTI-LEVEL chained call as a
          // receiver (`logger_init(.Info).with_timestamps(false).named(
          // "app")`, `examples/stdlib/log_structured.fn`'s own real
          // body) recurses into THIS same swap a second time while
          // still nested inside the first one's own scratch buffer --
          // `emit_method_call`'s own receiver-temp-hoisting path (for
          // the INNER call, itself also a call result) then reads
          // `current_stmt_start_pos` as a splice position, but it still
          // pointed into the OUTER (real, much larger) buffer, not this
          // inner scratch one -- out-of-bounds, the same "corrupting
          // substr's own length arithmetic and crashing" failure mode
          // `adjust_pos_after_splice`'s own doc comment describes.
          // 
          // `suppress_generic_impl_method_draining` additionally stops
          // such a method from being emitted WHILE `self.state` points
          // here at all -- there's no sensible place to splice a
          // definition into this throwaway buffer. It's only enqueued;
          // once `self.state`/`hoist_insert_pos` are restored to the
          // real ones below, draining is safe again, so this drains
          // whatever accumulated -- but only when NEITHER an outer
          // drain nor an outer probe is already in progress (either
          // one further up the call stack will reach it instead).
          // The FIRST time this goes from not-nested to nested (depth
          // 0 -> 1), capture the TRUE outermost real state/positions --
          // see `Codegen.hoist_scratch_depth`'s own doc comment for why
          // a DEEPER (1 -> 2, ...) transition must leave them alone.
          if self.hoist_scratch_depth == 0 {
            self.root_state = self.state;
            self.root_hoist_pos = self.hoist_insert_pos;
            self.root_stmt_start_pos = self.current_stmt_start_pos;
          }
          self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
          CodegenState call_scratch = codegen_state_new();
          CodegenState* saved_call_state = self.state;
          let saved_call_hoist_pos = self.hoist_insert_pos;
          let saved_call_stmt_start_pos = self.current_stmt_start_pos;
          let prev_suppress = self.suppress_generic_impl_method_draining;
          self.state = &call_scratch;
          self.hoist_insert_pos = .None;
          self.current_stmt_start_pos = .None;
          self.suppress_generic_impl_method_draining = true;
          let cerr = self.emit_expr(*recv);
          self.state = saved_call_state;
          self.hoist_insert_pos = saved_call_hoist_pos;
          self.current_stmt_start_pos = saved_call_stmt_start_pos;
          self.suppress_generic_impl_method_draining = prev_suppress;
          self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
          if self.hoist_scratch_depth == 0 {
            // Exiting nested receiver-chain territory entirely --
            // `root_stmt_start_pos` holds the TRUE current position
            // after any receiver-temp-hoist splices that happened
            // anywhere during this nested session (see `Codegen.
            // hoist_scratch_depth`'s own doc comment), which may be
            // AHEAD of the `saved_call_stmt_start_pos` snapshot just
            // restored above (taken before any of those splices
            // existed). Sync back to it so a FURTHER receiver-temp-
            // hoist for an enclosing call (now itself back at depth 0)
            // splices AFTER, not before, everything already spliced
            // during the nested session -- found via a real stage-2
            // run against `examples/stdlib/log_structured.fn`'s own
            // three-level chained receiver, where the outer call's own
            // temp landed textually ABOVE the inner one it depends on.
            // `hoist_insert_pos` needs the same resync, for the same
            // reason -- a nested generic-function/impl-method
            // instantiation triggered from inside `recv`'s own
            // evaluation (see `Codegen.hoist_scratch_depth`'s own doc
            // comment) advances `root_hoist_pos` via `emit_hoisted`
            // directly, which `saved_call_hoist_pos`'s stale snapshot
            // above never sees.
            self.current_stmt_start_pos = self.root_stmt_start_pos;
            self.hoist_insert_pos = self.root_hoist_pos;
          }
          if !prev_suppress && !self.draining_generic_impl_methods {
            self.drain_pending_generic_impl_methods();
          }
          if cerr.is_some() {
            ret .None;
          }

          // The call's own rendered text is an RVALUE -- fine to embed
          // directly for a further `.field` read (`tok.unwrap().type`,
          // this branch's own original/still-common case), but NOT
          // addressable: a caller needing `&<receiver>` (`emit_method_
          // call`'s own non-pointer-receiver case, `Type* self` taking
          // the address of a BY-VALUE result) would otherwise emit
          // `&some_call(...)`, "address of an rvalue" -- invalid C.
          // `is_call_result` flags this for such a caller to hoist into
          // an addressable temp itself, right before taking the address
          // (see `emit_method_call`'s own doc comment for where/why) --
          // NOT hoisted unconditionally here, which would needlessly
          // (and, for this exact test, WRONGLY -- see its own doc
          // comment) inject an extra statement even for a plain field
          // READ that never needs addressing at all.
          ChainResolution r;
          r.text = call_scratch.out.build();
          r.type_name = resolved_name_opt.unwrap();
          r.is_pointer = dtype_is_pointer(rdt);
          r.dtype = .Some(rdt);
          r.is_call_result = true;
          ret .Some(r);
        }
        if !equals(inner_e.op, ".") || !inner_e.has_left || !inner_e.has_right {
          ret .None;
        }
        str field_name = "";
        fit inner_e.right.kind {
          .Identifier(name) -> { field_name = name; }
          _ -> { ret .None; }
        }
        let recv_r_opt = self.resolve_field_chain(inner_e.left);
        if recv_r_opt.is_none() {
          ret .None;
        }
        let recv_r = recv_r_opt.unwrap();
        let field_info_opt = self.lookup_compound_field(recv_r.type_name, field_name);
        if field_info_opt.is_none() {
          ret .None;
        }
        let field_info = field_info_opt.unwrap();
        StringBuilder sb = string_builder_init(8);
        sb.append(recv_r.text);
        if recv_r.is_pointer {
          sb.append("->");
        } else {
          sb.append(".");
        }
        sb.append(field_name);
        ChainResolution r;
        r.text = sb.build();
        r.type_name = field_info.type_name;
        r.is_pointer = field_info.is_pointer;
        r.dtype = field_info.dtype;
        // Propagated, not reset to `false`: reading a `.field` off a
        // call-result receiver (`some_call().field`) is STILL not
        // addressable in C (a by-value struct return has no lvalue at
        // all, not even one of its own fields) -- the whole chain
        // inherits the innermost receiver's own rvalue-ness.
        r.is_call_result = recv_r.is_call_result;
        ret .Some(r);
      }
      // `(expr).field`/`await (expr).method(...)` -- a parenthesized
      // receiver (`examples/advanced/async_quirk_await_parenthesized_
      // receiver.fn`'s own real `(pack(q).v).add(1)`) resolves exactly
      // like its unwrapped inner expression; the parens themselves carry
      // no separate meaning here (C doesn't need them preserved -- `.`/
      // `->` already bind tighter than anything that could be inside).
      .ExpressionParenthesis(inner) -> { ret self.resolve_field_chain(inner); }
      // `(*ptr_expr).field` -- a single pointer-dereference receiver
      // (`examples/advanced/async_quirk_await_pointer_receiver.fn`'s own
      // real `(*pb).v.add(1)`) resolves its OWN operand first, then
      // flips `is_pointer` (a dereferenced pointer is a plain VALUE,
      // addressed with `.` for any FURTHER link, not `->`) and drops one
      // level of `dtype`'s own `pointer_depth` to match. Only a single,
      // non-left-operanded `*` -- `u.has_indirection`'s own multi-level
      // form (`**pp`) isn't a shape any real caller here produces.
      .Unary(u) -> {
        if !equals(u.op, "*") || u.is_left_operanded_unary || !u.has_indirection || u.indirection_depth != 1 {
          ret .None;
        }
        let recv_r_opt = self.resolve_field_chain(u.operand);
        if recv_r_opt.is_none() {
          ret .None;
        }
        let recv_r = recv_r_opt.unwrap();
        if !recv_r.is_pointer {
          ret .None;
        }
        StringBuilder deref_sb = string_builder_init(8);
        deref_sb.append("(*");
        deref_sb.append(recv_r.text);
        deref_sb.append(")");
        Option<DataType> deref_dtype = recv_r.dtype;
        if deref_dtype.is_some() {
          DataType dd = deref_dtype.unwrap();
          if dd.pointer_depth > 0 {
            dd.pointer_depth = dd.pointer_depth - 1;
          }
          // `dtype_is_pointer` also honors `flags.is_pointer`
          // independently of `pointer_depth` (a `T*` PARAMETER's own
          // flag) -- clearing only `pointer_depth` left it `true`,
          // wrongly still reading as a pointer after the deref.
          dd.flags.is_pointer = false;
          deref_dtype = .Some(dd);
        }
        ChainResolution r;
        r.text = deref_sb.build();
        r.type_name = recv_r.type_name;
        r.is_pointer = false;
        r.dtype = deref_dtype;
        r.is_call_result = false;
        ret .Some(r);
      }
      _ -> { ret .None; }
    }
  }

  // Emits `recv`'s C text (via `resolve_field_chain`) and returns its
  // resolved declared type, so the caller (`emit_field_access`) can
  // decide `.`/`->` for the NEXT link in a chain it's emitting inline.
  emit_receiver_and_resolve_type(Node* recv) Option<FieldTypeInfo> {
    let resolved = self.resolve_field_chain(recv);
    if resolved.is_none() {
      ret .None;
    }
    let r = resolved.unwrap();
    self.state.write(r.text);
    FieldTypeInfo info;
    info.type_name = r.type_name;
    info.is_pointer = r.is_pointer;
    info.dtype = r.dtype;
    ret .Some(info);
  }

  // Emits one statement, followed by its own trailing newline (statements
  // are the unit `emit_statements` iterates, so each ends its own line).
  // `StatementIf`/`StatementElseIf`/`StatementElse` are deliberately NOT
  // handled here -- they're only ever valid chained together, which needs
  // sibling lookahead only `emit_statements` (its caller) has; reaching
  // this function directly (an if/elif/else with no chain context) is a
  // bug in the caller, so it's an explicit error rather than emitting a
  // lone, invalid C `if`/`else if`/`else` fragment.
  pub emit_statement(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .StatementReturn(exp) -> {
        // `main` always emits as `int main(...)` in C regardless of its
        // OWN declared Fun-level return type (see `emit_function_
        // named`'s own doc comment) -- a `ret <expr>;` inside it can
        // only write the real expression when that declared type is
        // itself a scalar `num` (implicitly narrows to `int` just
        // fine); anything else (a struct/enum, `void`, ...) must
        // discard the expression entirely and just report success,
        // since returning e.g. a tagged-union VALUE from a function C
        // itself declares to return `int` is a real compile error, not
        // merely an implicit-narrowing warning. Pending defers still
        // run first either way -- only the VALUE is ever skipped, not
        // the cleanup. Mirrors the original transpiler's own identical
        // `in_main`/"default-void main ignores expression" rule.
        bin main_discards_return = false;
        if self.in_main {
          main_discards_return = true;
          if self.current_fn_rtype_dt.is_some() {
            let main_rt = self.current_fn_rtype_dt.unwrap();
            if equals(main_rt.type_str, "num") && !main_rt.is_array && main_rt.pointer_depth == 0 {
              main_discards_return = false;
            }
          }
        }
        if main_discards_return {
          // The discarded expression is still EVALUATED (into a
          // throwaway scratch buffer, then thrown away whole) rather
          // than skipped outright, purely for its Fun-level SIDE
          // EFFECTS (a call with side effects as main's own "return"
          // is unusual but not invalid). `hoist_insert_pos` is
          // suspended for the swap, same as every other scratch-buffer
          // swap in this file, so a nested hoisted TYPE dependency
          // triggered from inside doesn't crash by splicing at a
          // stale position into this tiny buffer.
          // 
          // A generic function/type reached ONLY from here (e.g. some
          // `wrap<T>()` called ONLY as `main`'s own discarded return
          // value, never anywhere else) does NOT get hoisted -- this
          // codegen's lazy triggers all fire as a side effect of
          // `emit_expr` actually WRITING somewhere real, which this
          // deliberately never does. Matches the original transpiler's
          // own simpler behavior here (it doesn't even evaluate the
          // expression in this case) closely enough: something ONLY
          // ever reachable through a discarded main-return has no
          // other real call site needing it monomorphized anyway.
          if exp != nil {
            CodegenState main_discard_scratch = codegen_state_new();
            CodegenState* saved_discard_state = self.state;
            let saved_discard_hoist_pos = self.hoist_insert_pos;
            // `current_stmt_start_pos` suspended too, same as `hoist_
            // insert_pos` just above -- `ensure_plain_impl_method_
            // prototype_emitted`, reached via an ordinary method call
            // inside this discarded expression, would otherwise use a
            // REAL-buffer-sized position as a slice bound against THIS
            // tiny scratch buffer, corrupting `substr`'s own length
            // arithmetic and crashing (the exact same failure mode
            // `hoist_insert_pos`'s own suspension already prevents for
            // `emit_hoisted`'s other callers).
            let saved_discard_stmt_start_pos = self.current_stmt_start_pos;
            self.state = &main_discard_scratch;
            self.hoist_insert_pos = .None;
            self.current_stmt_start_pos = .None;
            let discard_eerr = self.emit_expr(*exp);
            self.state = saved_discard_state;
            self.hoist_insert_pos = saved_discard_hoist_pos;
            self.current_stmt_start_pos = saved_discard_stmt_start_pos;
            if discard_eerr.is_some() {
              ret discard_eerr;
            }
          }
          let main_dferr = self.emit_function_scope_defers();
          if main_dferr.is_some() {
            ret main_dferr;
          }
          self.state.write_indent();
          self.state.write("return 0;\n");
          ret .None;
        }
        // A `ret` unwinds EVERY enclosing block at once, so any
        // currently pending `defer` (this function's own, or an
        // enclosing block's) must run first -- see
        // `Codegen.defer_stack`'s doc comment. Common case (no `defer`
        // anywhere in this function) keeps the exact prior single-
        // statement form untouched. When defers ARE pending, the return
        // expression is evaluated into a temp FIRST (`__auto_type`, this
        // codegen's usual no-type-checker inference dodge -- see
        // `Variable`'s own doc comment below) so a deferred statement
        // can't retroactively change what gets returned by mutating a
        // variable the expression already read (matching the original's
        // own `has_pending_function_defers` guard).
        // A `ret` value coerced to a quirk-typed return (`fun as_hasx(
        // Point* p) HasX { ret p; }`) needs the same coercion call
        // wrapped around it as a `Variable` declaration's own
        // initializer does -- see `resolve_quirk_coerce_concrete_type`'s
        // own doc comment.
        bin ret_did_quirk_coerce = false;
        str ret_quirk_concrete = "";
        if exp != nil && self.quirk_names.contains(self.current_fn_rtype_name) {
          let ret_concrete = self.resolve_quirk_coerce_concrete_type(exp);
          if ret_concrete.is_some() {
            ret_did_quirk_coerce = true;
            ret_quirk_concrete = ret_concrete.unwrap();
          }
        }
        if self.defer_stack.len == 0 {
          self.state.write_indent();
          self.state.write("return");
          if exp != nil {
            self.state.write(" ");
            if ret_did_quirk_coerce {
              self.state.write("__fun_coerce_");
              self.state.write(ret_quirk_concrete);
              self.state.write("_");
              self.state.write(self.current_fn_rtype_name);
              self.state.write("(");
            }
            let prev_expected = self.expected_enum_type;
            self.expected_enum_type = self.current_fn_rtype_name;
            let eerr = self.emit_expr(*exp);
            self.expected_enum_type = prev_expected;
            if eerr.is_some() {
              ret eerr;
            }
            if ret_did_quirk_coerce {
              self.state.write(")");
            }
          }
          self.state.write(";\n");
          ret .None;
        }
        if exp != nil {
          self.state.write_indent();
          self.state.write("__auto_type __fun_defer_ret = ");
          if ret_did_quirk_coerce {
            self.state.write("__fun_coerce_");
            self.state.write(ret_quirk_concrete);
            self.state.write("_");
            self.state.write(self.current_fn_rtype_name);
            self.state.write("(");
          }
          let prev_expected = self.expected_enum_type;
          self.expected_enum_type = self.current_fn_rtype_name;
          let eerr = self.emit_expr(*exp);
          self.expected_enum_type = prev_expected;
          if eerr.is_some() {
            ret eerr;
          }
          if ret_did_quirk_coerce {
            self.state.write(")");
          }
          self.state.write(";\n");
        }
        let dferr = self.emit_function_scope_defers();
        if dferr.is_some() {
          ret dferr;
        }
        self.state.write_indent();
        if exp != nil {
          self.state.write("return __fun_defer_ret;\n");
        } else {
          self.state.write("return;\n");
        }
        ret .None;
      }
      .StatementBreak -> {
        self.state.write_indent();
        self.state.write("break;\n");
        ret .None;
      }
      .StatementContinue -> {
        self.state.write_indent();
        self.state.write("continue;\n");
        ret .None;
      }
      .Variable(v) -> {
        self.state.write_indent();
        // `let NAME = <expr>;` (no explicit type -- `parse_let`'s own
        // `__let_infer__` sentinel, see its doc comment in parser.fn)
        // ALWAYS emits GNU C's own `__auto_type` for the declaration
        // itself, letting the C compiler do the real inference -- this
        // codegen has no type-checker of its own. `infer_let_expr_type`
        // is then tried PURELY as a bonus for THIS codegen's OWN later
        // bookkeeping (so a bare-shorthand `fit`/a chained field access/
        // a method call reading `NAME` afterward still resolves); when
        // it can't infer anything, `NAME` just isn't a known local
        // afterward (rejected by whatever reads it next, not guessed --
        // the C declaration itself is unaffected either way).
        bin is_let = equals(v.var_type.type_str, "__let_infer__");
        bin have_resolved = false;
        str resolved_name = "";
        bin resolved_ptr = false;
        Option<DataType> resolved_dtype = .None;

        // An UNSIZED array LOCAL (`T[] new_data = malloc(...);`, e.g.
        // `Channel<T>`'s own resize -- see `dtype_is_array_as_pointer`'s
        // doc comment) decays to a pointer, same as an unsized array
        // FIELD does -- but only when it's NOT initialized with a real
        // bracket array literal (`num[] xs = [1, 2, 3];`, which stays a
        // genuine stack array; a malloc-returning/other expression
        // initializer is the pointer-decay case). `write_type` itself
        // doesn't know about the initializer, so this is decided here,
        // not inside `write_type`.
        bin arr_as_ptr = false;
        if !is_let {
          arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
          if arr_as_ptr && v.has_val {
            fit v.val.kind {
              .Bracket(_) -> { arr_as_ptr = false; }
              _ -> {}
            }
          }
        }

        // `const` on a POINTER-typed binding must land AFTER the pointer
        // star(s) (`Type* const name`, "the pointer itself can't be
        // reassigned") rather than before the base type (`const Type*
        // name`, "what it points to can't be mutated" -- a stricter,
        // different guarantee than what this codegen's own const-
        // reassignment check enforces). For a `__auto_type`-inferred
        // const, the eventual pointer-ness isn't known yet at this point
        // in emission, so `const` always lands BEFORE -- a reasonable
        // simplification (`const __auto_type x = 5;` is valid GNU C
        // either way).
        bin const_is_ptr_binding = !is_let && (dtype_is_pointer(*v.var_type) || arr_as_ptr);
        if v.is_const && !const_is_ptr_binding {
          self.state.write("const ");
        }

        // `let arr = [1, 2, 3];` needs a REAL, EXPLICITLY-typed array
        // declaration (`int64_t arr[] = {1, 2, 3};`), NOT `__auto_type`
        // -- confirmed empirically: `__auto_type x = (int64_t[]){1, 2,
        // 3};` DECAYS to a pointer at the point of initialization (GCC/
        // Clang both agree: `sizeof(x)` there is just the pointer's own
        // size, 8), unlike a genuinely DECLARED array local, which never
        // decays. Since this codegen's whole 1D/multi-dim raw-array
        // iteration fast path (`emit_for_iter`) depends on `sizeof(arr)/
        // sizeof(arr[0])` giving the REAL element count, `__auto_type`
        // here silently broke iteration down to a SINGLE element for
        // ANY `let`-inferred array literal (1D or multi-dim alike) --
        // found via `examples/advanced/matrix.fn`'s own `let m2 = [[10,
        // 20], [30, 40]];` printing nothing at all for `m2`'s own rows.
        // `let_lit_elem_c_type`/`let_lit_depth` are reused below (both
        // for the array declarator after the name, and to skip the
        // compound-literal cast the OLD `__auto_type`-based approach
        // needed but a real typed declaration doesn't).
        bin let_is_bracket_literal = false;
        str let_lit_elem_c_type = "int64_t";
        num let_lit_depth = 1;
        if is_let && v.has_val {
          fit v.val.kind {
            .Bracket(bracket_inner) -> {
              let_is_bracket_literal = true;
              let_lit_elem_c_type = self.infer_array_literal_elem_c_type(bracket_inner);
              let_lit_depth = self.array_literal_nesting_depth(v.val);
            }
            _ -> {}
          }
        }
        if let_is_bracket_literal {
          self.state.write(let_lit_elem_c_type);
        } elif is_let {
          self.state.write("__auto_type");
        } else {
          let wt = self.write_type(*v.var_type);
          if wt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let subst_dt = self.resolve_type_subst(*v.var_type);
          resolved_name = wt.unwrap();
          resolved_ptr = dtype_is_pointer(subst_dt) || arr_as_ptr;
          // Unconditional on `arr_as_ptr` alone -- see `emit_function_
          // param`'s own doc comment for why: the array-decay's own
          // pointer level is always ADDITIONAL to whatever `write_type`
          // already wrote for `subst_dt`'s own pointer depth, even when
          // `subst_dt` is ITSELF already a pointer (a generic `T[]` local
          // substituting a pointer-typed argument).
          if arr_as_ptr {
            self.state.write("*");
          }
          resolved_dtype = .Some(subst_dt);
          have_resolved = true;
        }
        if v.is_const && const_is_ptr_binding {
          self.state.write(" const");
        }
        self.state.write(" ");
        self.state.write(v.name);
        // A sized/unsized array declarator (`[24]`, `[]`) lands AFTER the
        // name in C, unlike every other type modifier above -- mirrors the
        // original transpiler's own local-variable emission. `let_is_
        // bracket_literal`'s own declarator (leading `[]`, C infers the
        // outer count from the initializer, same as the explicitly-typed
        // path below does; inner dims -- if any -- from `emit_multidim_
        // inner_declarators`) is entirely separate from the ordinary
        // explicitly-typed one below (no `v.var_type.array_brackets` to
        // read at all for a `let`). Otherwise skipped for `let` and for
        // `arr_as_ptr` (already decayed to a `*` above, so no brackets).
        if let_is_bracket_literal {
          self.state.write("[]");
          if let_lit_depth > 1 {
            self.emit_multidim_inner_declarators(v.val, let_lit_depth - 1);
          }
        } elif !is_let && !arr_as_ptr && v.var_type.is_array {
          if v.var_type.array_brackets.len > 0 {
            for bnode : v.var_type.array_brackets {
              self.state.write("[");
              fit bnode.kind {
                .Bracket(inner) -> {
                  let berr = self.emit_expr(*inner);
                  if berr.is_some() {
                    ret berr;
                  }
                }
                _ -> {
                  let berr = self.emit_expr(*bnode);
                  if berr.is_some() {
                    ret berr;
                  }
                }
              }
              self.state.write("]");
            }
          } elif v.var_type.array_depth > 1 {
            // A multi-dimensional array with NO explicit bracket sizes
            // anywhere (`num[][] matrix = [[1, 2, 3], [4, 5, 6]];`) --
            // the leading dimension stays `[]` (C infers it from the
            // initializer), but every OTHER dimension needs an EXPLICIT
            // size (`T[][N]` is legal C, `T[][]` is not) -- derived from
            // the initializer literal's own shape via `emit_multidim_
            // inner_declarators`. Falls back to plain `[]`-per-dimension
            // (matching the ORIGINAL transpiler's own identical
            // fallback) when there's no bracket-literal initializer to
            // derive sizes from at all (a plain forward declaration,
            // e.g.) -- invalid C on its own, but no worse than what this
            // codegen already emitted before this fix existed.
            self.state.write("[]");
            bin wrote_inner_dims = false;
            if v.has_val {
              fit v.val.kind {
                .Bracket(_) -> {
                  self.emit_multidim_inner_declarators(v.val, v.var_type.array_depth - 1);
                  wrote_inner_dims = true;
                }
                _ -> {}
              }
            }
            if !wrote_inner_dims {
              num mdim_d = 1;
              for mdim_d < v.var_type.array_depth {
                self.state.write("[]");
                mdim_d = mdim_d + 1;
              }
            }
          } else {
            self.state.write("[]");
          }
        }
        if v.has_val {
          self.state.write(" = ");
          // See `Codegen.expected_enum_type`'s doc comment: a bare
          // shorthand in a `Variable` declaration's own initializer
          // resolves against THAT variable's declared type, not
          // whatever the enclosing function returns. For `let`, this is
          // just `__let_infer__` (never a real enum name), so a bare
          // shorthand initializer still correctly fails to resolve
          // rather than guessing.
          // 
          // Resolved via `resolve_type_name`, NOT the bare `v.var_type.
          // type_str` directly (`Option<DataType> ptype = .None;`,
          // e.g. -- `ensure_enum_instantiated`'s own real body found
          // continuing the stage-2 self-compilation attempt): for a
          // GENERIC declared type, the bare type_str is just the
          // unresolved template name ("Option"), which `enum_has_
          // variant` never recognizes -- only the mangled concrete
          // instantiation ("Option__DataType") is ever registered.
          // `resolve_type_name` is a no-op passthrough for a NON-generic
          // type (including the `let`-inference sentinel above), so
          // this doesn't change behavior for either of those.
          let prev_expected = self.expected_enum_type;
          let resolved_decl_type = self.resolve_type_name(*v.var_type);
          if resolved_decl_type.is_some() {
            self.expected_enum_type = resolved_decl_type.unwrap();
          } else {
            self.expected_enum_type = v.var_type.type_str;
          }
          // A bare `.{...}` compound-literal shorthand initializer
          // (`User u2 = .{name = "Bob"};`) resolves against
          // `expected_compound_type` the exact same way a bare enum
          // shorthand resolves against `expected_enum_type` just above
          // -- but nothing set it for a `Variable` declaration's own
          // initializer at all until now (only a `.` assignment RHS did
          // -- see the `Expression`/`"="` case elsewhere in this file).
          let prev_expected_compound = self.expected_compound_type;
          self.expected_compound_type = self.expected_enum_type;
          // A `let` has no declared type of its own to resolve a bare
          // enum-variant shorthand initializer against (`let color =
          // .Red;` -- `expected_enum_type` is just the `__let_infer__`
          // sentinel set above, never a real enum name) -- fall back to
          // GLOBAL uniqueness (`resolve_unique_enum_for_variant`'s own
          // doc comment): if exactly one enum in the whole program has
          // a variant by that name, that's unambiguously what this
          // resolves to.
          if is_let {
            fit v.val.kind {
              .Expression(ve) -> {
                if equals(ve.op, ".") && ve.has_left && ve.has_right {
                  fit ve.left.kind {
                    .Blank -> {
                      fit ve.right.kind {
                        .Identifier(vname) -> {
                          let unique = self.resolve_unique_enum_for_variant(vname);
                          if unique.is_some() {
                            self.expected_enum_type = unique.unwrap();
                          }
                        }
                        _ -> {}
                      }
                    }
                    _ -> {}
                  }
                }
              }
              _ -> {}
            }
          }
          // See `Codegen.in_array_initializer`'s doc comment: a
          // declaration's own initializer is one of the contexts where a
          // bare `[1, 2, 3]` array literal needs the bare brace-list form.
          let prev_arr_init = self.in_array_initializer;
          self.in_array_initializer = true;
          // A quirk-typed declaration's own initializer (`Shape s =
          // &rect;`) needs a coercion call wrapped around the RHS -- see
          // `resolve_quirk_coerce_concrete_type`'s own doc comment.
          bin did_quirk_coerce = false;
          // A CONCRETE quirk instantiation (`To<num> t = ...;`) is
          // registered under its MANGLED identity (`To__num`), not the
          // bare `v.var_type.type_str` ("To") -- see `resolve_type_name`'s
          // own identical fallback/doc comment for why.
          str var_quirk_type = v.var_type.type_str;
          if !self.quirk_names.contains(var_quirk_type) && v.var_type.generic_args.len > 0 {
            StringBuilder vq_sb = string_builder_init(16);
            vq_sb.append(v.var_type.type_str);
            for vqarg : v.var_type.generic_args {
              vq_sb.append("__");
              vq_sb.append(vqarg.type_str);
            }
            let vq_candidate = vq_sb.build();
            if self.quirk_names.contains(vq_candidate) {
              var_quirk_type = vq_candidate;
            }
          }
          if self.quirk_names.contains(var_quirk_type) {
            let concrete = self.resolve_quirk_coerce_concrete_type(v.val);
            if concrete.is_some() {
              self.state.write("__fun_coerce_");
              self.state.write(concrete.unwrap());
              self.state.write("_");
              self.state.write(var_quirk_type);
              self.state.write("(");
              did_quirk_coerce = true;
            }
          }
          // `let_is_bracket_literal` already declared a REAL, explicitly-
          // typed array above (not `__auto_type`) -- `emit_expr`'s own
          // `.Bracket` case just needs the bare brace-list form here,
          // same as any other array-typed declaration's own initializer;
          // no GNU compound-literal cast wrapper needed (that was only
          // ever `__auto_type`'s own requirement).
          let verr = self.emit_expr(*v.val);
          if did_quirk_coerce {
            self.state.write(")");
          }
          self.in_array_initializer = prev_arr_init;
          self.expected_enum_type = prev_expected;
          self.expected_compound_type = prev_expected_compound;
          if verr.is_some() {
            ret verr;
          }
        }
        self.state.write(";\n");
        if is_let && v.has_val {
          let inferred = self.infer_let_expr_type(v.val);
          if inferred.is_some() {
            let idt = inferred.unwrap();
            let resolved = self.resolve_type_name(idt);
            if resolved.is_some() {
              let subst_idt = self.resolve_type_subst(idt);
              resolved_name = resolved.unwrap();
              resolved_ptr = dtype_is_pointer(subst_idt);
              resolved_dtype = .Some(subst_idt);
              have_resolved = true;
            }
          }
        }
        if have_resolved {
          if resolved_dtype.is_some() {
            self.record_local_typed(v.name, resolved_name, resolved_ptr, resolved_dtype.unwrap());
          } else {
            self.record_local(v.name, resolved_name, resolved_ptr);
          }
        }
        ret .None;
      }
      .StatementFor(fk) -> {
        self.state.write_indent();
        fit fk {
          .Cond(fc) -> { ret self.emit_for_cond(fc); }
          .Range(fr) -> { ret self.emit_for_range(fr); }
          .Iter(fi) -> { ret self.emit_for_iter(fi); }
        }
      }
      .StatementFit(f) -> {
        self.state.write_indent();
        ret self.emit_fit(f);
      }
      // A bare expression used as a statement (an assignment, a call for
      // its side effect, `x++;`, ...) parses as a plain `.Expression`/
      // `.Unary` node directly in the statement list -- there's no
      // dedicated `StatementExpression` wrapper (see `parse_statement`'s
      // fallthrough to `parse_expressionable_root` in the parser). Emit it
      // as `<expr>;` followed by its own newline, same as every other
      // statement.
      .Expression(_) -> {
        self.state.write_indent();
        let eerr = self.emit_expr(node);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .Unary(_) -> {
        self.state.write_indent();
        let uerr = self.emit_expr(node);
        if uerr.is_some() {
          ret uerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .Panic(_) -> {
        // A bare `panic("msg");` statement (e.g. `_push_back`'s own real
        // body in the self-hosted lexer's own source) -- same "no
        // dedicated statement wrapper" reasoning as `.Expression`/
        // `.Unary` just above.
        self.state.write_indent();
        let perr = self.emit_expr(node);
        if perr.is_some() {
          ret perr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .StatementAssert(a) -> {
        // `assert cond;` / `assert cond, "msg";` (e.g. `_lex`'s own real
        // body in the self-hosted lexer's own source, found via the
        // self-compile experiment) -- lowers to a plain `if (!(cond)) {
        // ...; abort(); }`, matching the original's own non-test-mode
        // lowering exactly (this codegen has no test-mode runner of its
        // own yet -- `.Test` nodes are skipped entirely by an ordinary
        // compile, see `NodeKind.Test`'s doc comment -- so there is no
        // recovered-assertion path to support here).
        self.state.write_indent();
        self.state.write("if (!(");
        let cerr = self.emit_expr(*a.condition);
        if cerr.is_some() {
          ret cerr;
        }
        self.state.write(")) { ");
        if a.has_message {
          self.state.write("fprintf(stderr_stream(), \"Assertion failed: %s\\n\", ");
          let merr = self.emit_expr(*a.message);
          if merr.is_some() {
            ret merr;
          }
          self.state.write("); ");
        }
        self.state.write("abort(); }\n");
        ret .None;
      }
      .StatementDefer(body) -> {
        // `defer <body>;` (e.g. `ParseState.err`'s own real body,
        // `defer free(loc);`, found via the self-compile experiment) --
        // registers `body` onto `Codegen.defer_stack` rather than
        // emitting anything here directly; it's replicated as an
        // ordinary statement at every point this block's scope actually
        // ends (`emit_statements`' fall-through, or a `ret` anywhere
        // inside it -- see `Codegen.defer_stack`'s doc comment).
        self.defer_stack.push(body);
        ret .None;
      }
      .StatementFork(expr) -> {
        self.state.write_indent();
        let ferr = self.emit_fork_stmt(expr);
        if ferr.is_some() {
          ret ferr;
        }
        self.state.write(";\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Emits `for { ... }` (infinite) or `for cond { ... }` as the direct C
  // equivalent: `while (1) { ... }` / `while (cond) { ... }` -- a
  // conditional `for` has no init/increment clauses of its own, so a
  // `while` loop is exactly the same construct.
  emit_for_cond(ForCondNode fc) Option<CodegenErrorKind> {
    if fc.has_condition {
      self.state.write("while (");
      let cerr = self.emit_expr(*fc.condition);
      if cerr.is_some() {
        ret cerr;
      }
      self.state.write(") {\n");
    } else {
      self.state.write("while (1) {\n");
    }
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*fc.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    ret .None;
  }

  // Emits `for i : start..end { ... }` as `for (int64_t i = start; i <
  // end; i++) { ... }`. `range_expr` is always an `Expression{ op = ".." }`
  // (start on the left, end on the right) -- see `parse_for_statement`'s
  // doc comment in the parser for how the range/condition forms are
  // disambiguated at parse time.
  emit_for_range(ForRangeNode fr) Option<CodegenErrorKind> {
    fit fr.range_expr.kind {
      .Expression(e) -> {
        if !equals(e.op, "..") || !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.state.write("for (int64_t ");
        self.state.write(fr.index_name);
        self.state.write(" = ");
        let serr = self.emit_expr(*e.left);
        if serr.is_some() {
          ret serr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write(" < ");
        let eerr = self.emit_expr(*e.right);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write("++) {\n");
        self.state.indent_level = self.state.indent_level + 1;
        let berr = self.emit_body(*fr.body);
        if berr.is_some() {
          ret berr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits `for item : arr { ... }` / `for i, item :: arr { ... }` as the
  // original's own "Vec fast path": `for (int64_t idx = 0; idx <
  // arr.len; idx++) { __auto_type item = arr.data[idx]; ... }` -- `idx`
  // is `fi.index_name` when given, else a synthetic `__fun_i`. Reads
  // straight from `Vec<T>`'s own `.len`/`.data` fields rather than a
  // generic `Iterator`-quirk `.next()` dispatch (dynamic quirk dispatch
  // isn't reachable yet -- see this file's own top-level doc comment).
  // `__auto_type` (a GNU C extension) lets the C compiler infer `item`'s
  // type from `arr.data[idx]` -- this codegen never needs to know `T`
  // itself, matching the original's own choice here.
  // 
  // Deliberately narrow for this slice: `arr` must be a plain identifier
  // that's a known local whose declared type is SOME instantiation of
  // `Vec<T>` (an array literal or a general `Iterator`-implementing
  // quirk value isn't reachable yet either). Prefers a STRUCTURAL check
  // via `lookup_local_dtype` (the local's real `DataType` -- base
  // `type_str == "Vec"` with exactly one generic arg, `T`) when the
  // local was recorded with one (`record_local_typed`, e.g. a real
  // `Variable` declaration or function/method parameter); falls back to
  // a NAME-based check (bare "Vec", or a "Vec__"-prefixed mangled
  // instantiation) for a local recorded through plain `record_local`
  // instead (no structured type on hand at all -- e.g. a hand-built unit
  // test's stand-in local, or `item` from an OUTER `for` whose element
  // type couldn't be read structurally either). A REAL local's recorded
  // NAME is never the bare "Vec" -- `record_local`/`record_local_typed`
  // always store `write_type`'s own RESOLVED (monomorphized) name
  // (`Vec__str`, `Vec__Vec__str`, ...) -- a real bug found via the self-
  // compile experiment (`param_constraints: Vec<Vec<str>>` in
  // `ParseState.parse_type_params_with_constraints`'s own real body,
  // rejected outright since its recorded name, "Vec__Vec__str", isn't
  // the bare "Vec" this check used to require -- apparently never
  // exercised by a REAL declaration before, only ever by hand-recorded
  // test locals).
  emit_for_iter(ForIterNode fi) Option<CodegenErrorKind> {
    // The iterable is either a plain identifier (a known local, checked
    // structurally via `lookup_local_dtype` or by name otherwise -- see
    // this function's own doc comment) OR a chained field access (`for a
    // : dt.generic_args { ... }` -- `Codegen.resolve_type_subst`'s own
    // real body, found via the self-compile experiment) resolved via
    // `resolve_field_chain` (any depth) instead, the same lookup several
    // other sites in this file already use for a chained receiver.
    // `resolve_field_chain`'s own `ChainResolution.dtype` (see its doc
    // comment) carries the field's FULL structured `DataType` too, when
    // `record_compound_typed` recorded it (a real declaration's own
    // field, not a hand-built unit test's stand-in) -- letting `item` be
    // recorded as a known local of its real element type here too, same
    // as the identifier case below.
    str arr_text = "";
    Option<DataType> arr_dtype = .None;
    Option<str> arr_type_name = .None;
    bin iterable_is_identifier = false;
    fit fi.iterable.kind {
      .Identifier(name) -> {
        arr_text = name;
        arr_dtype = self.lookup_local_dtype(name);
        arr_type_name = self.lookup_local_type_name(name);
        iterable_is_identifier = true;
      }
      .Expression(e) -> {
        // `.` (a chained field access) or `()` (a call, `for k : squares.
        // keys() { ... }` -- the Vec returned by a method call used
        // directly as the iterable, `examples/stdlib/collections_iter.fn`'s
        // own real body) -- `resolve_field_chain` already handles a call
        // node passed directly to it (its own "call as receiver" case
        // works for ANY call, not just one nested as someone else's
        // receiver).
        if !equals(e.op, ".") && !equals(e.op, "()") {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        let resolved = self.resolve_field_chain(fi.iterable);
        if resolved.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        let r = resolved.unwrap();
        arr_text = r.text;
        arr_type_name = .Some(r.type_name);
        arr_dtype = r.dtype;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    // Element `DataType`, when knowable STRUCTURALLY (see this
    // function's own doc comment) -- lets `item` be recorded as a known
    // local of its REAL type below, so a FURTHER nested iteration over
    // it (`for existing : combos { for et : existing { ... } }`,
    // `parse_type_params_with_constraints`'s own real body building
    // `Vec<Vec<str>>` cross-products, found via the self-compile
    // experiment) resolves too -- without this, `existing` (that OUTER
    // loop's own `item`) was never a known local at all (see below on
    // why `item` isn't normally recorded), so the INNER `for et :
    // existing` rejected it outright.
    // 
    // `arr_dtype` being `.Some` does NOT always mean it's structural,
    // though: a local whose type came from a MONOMORPHIZED generic
    // method's own registered return type (`let variant_templates =
    // self.generic_enum_variants.get(template_idx);` --
    // `ensure_enum_instantiated`'s own real body, found via the self-
    // compile experiment) has an ALREADY-MANGLED `type_str`
    // ("Vec__GenericEnumVariantTemplate") with EMPTY `generic_args` --
    // the structural information was already collapsed into a name
    // upstream (`maybe_instantiate_generic_impl_methods` records a
    // template method's substituted return type as a plain resolved
    // name, not a re-expanded structural one). Recognized as a Vec
    // either way (structurally, or by name via `arr_dt.type_str` itself
    // OR the name-only fallback), but only the STRUCTURAL case can also
    // resolve `item`'s own element type.
    Option<DataType> elem_dt = .None;
    bin is_vec = false;
    if arr_dtype.is_some() {
      let arr_dt = arr_dtype.unwrap();
      if equals(arr_dt.type_str, "Vec") && arr_dt.generic_args.len == 1 {
        elem_dt = .Some(self.resolve_type_subst(*arr_dt.generic_args.get(0)));
        is_vec = true;
      } elif equals(arr_dt.type_str, "Vec") || starts_with(arr_dt.type_str, "Vec__") {
        is_vec = true;
      }
    }
    if !is_vec && arr_type_name.is_some() {
      let found_name = arr_type_name.unwrap();
      if equals(found_name, "Vec") || starts_with(found_name, "Vec__") {
        is_vec = true;
      }
    }
    // A genuine SIZED array local (`num[] arr`, `is_array` and NOT
    // decayed to a pointer -- see `dtype_is_array_as_pointer`'s doc
    // comment) has no `.len`/`.data` at all in C; its length comes from
    // the classic `sizeof(arr)/sizeof(arr[0])` trick instead, matching
    // the original transpiler's own identical raw-array fast path --
    // see this function's own tail (past the `is_vec`/`Set`/`Map`
    // dispatch below) for how a MULTI-DIMENSIONAL raw array (`arr_dt.
    // array_depth > 1`) generalizes this, via `Codegen.local_multidim_
    // names`.
    bin is_raw_array = false;
    str elem_c_type = "int64_t";
    // Defaults to 1 (an ordinary single-dimension array) when `arr_dt.
    // array_depth` wasn't populated at all -- mirrors the original
    // transpiler's own identical default for a hand-built/legacy `DataType`
    // that predates `array_depth`'s own introduction.
    num raw_array_depth = 1;
    Option<DataType> raw_arr_dt = .None;
    if !is_vec && arr_dtype.is_some() {
      let arr_dt = arr_dtype.unwrap();
      if arr_dt.is_array && arr_dt.pointer_depth == 0 {
        is_raw_array = true;
        elem_c_type = map_type_to_c(arr_dt.type_str);
        raw_arr_dt = .Some(arr_dt);
        if arr_dt.array_depth > 0 {
          raw_array_depth = arr_dt.array_depth;
        }
      }
    }
    // `Set<T>`/`Map<K, V>` (a bare identifier, structurally known --
    // narrower than the original transpiler's own fully general Iterator-
    // quirk resolution, which works for ANY type implementing `Iterator`,
    // not just these two built-ins; scoped to what `examples/stdlib/
    // collections_iter.fn` and the stdlib itself actually need) drive
    // `for item : set`/`for key : map`/`for key, value :: map` through
    // the `iter()`/`next()`/`Option` protocol instead of a direct index --
    // see `emit_iter_protocol_for` in the original transpiler for the
    // reference shape this mirrors. Requires the collection's own
    // STRUCTURAL generic args (the mangled-name-only case, `arr_dtype`
    // with empty `generic_args`, can't recover the element type needed to
    // instantiate `SetIter<T>`/`MapIter<K, V>`/`Option<T>` here) and a
    // bare identifier receiver (an expression receiver, e.g. `map.keys()`
    // -- itself a `Vec`, handled by the ordinary Vec path above -- would
    // be an RVALUE, and `&<rvalue>` to call `.iter()` on it is invalid C;
    // not needed by any real caller today).
    if !is_vec && !is_raw_array && iterable_is_identifier && arr_dtype.is_some() {
      let coll_dt = arr_dtype.unwrap();
      bin is_set = equals(coll_dt.type_str, "Set") && coll_dt.generic_args.len == 1;
      bin is_map = equals(coll_dt.type_str, "Map") && coll_dt.generic_args.len == 2;
      if is_set || is_map {
        DataType elem_key_dt = *coll_dt.generic_args.get(0);
        DataType* elem_key_ptr = malloc(sizeof(DataType));
        *elem_key_ptr = elem_key_dt;

        DataType iter_dt = dtype_new();
        Vec<DataType*> iter_args;
        iter_args.init(2);
        iter_args.push(elem_key_ptr);
        if is_map {
          iter_dt.type_str = "MapIter";
          DataType val_dt = *coll_dt.generic_args.get(1);
          DataType* val_ptr = malloc(sizeof(DataType));
          *val_ptr = val_dt;
          iter_args.push(val_ptr);
        } else {
          iter_dt.type_str = "SetIter";
        }
        iter_dt.generic_args = iter_args;

        DataType opt_dt = dtype_new();
        opt_dt.type_str = "Option";
        Vec<DataType*> opt_args;
        opt_args.init(1);
        DataType* opt_elem_ptr = malloc(sizeof(DataType));
        *opt_elem_ptr = elem_key_dt;
        opt_args.push(opt_elem_ptr);
        opt_dt.generic_args = opt_args;

        let coll_name_opt = self.resolve_type_name(coll_dt);
        let iter_name_opt = self.resolve_type_name(iter_dt);
        let opt_name_opt = self.resolve_type_name(opt_dt);
        if coll_name_opt.is_none() || iter_name_opt.is_none() || opt_name_opt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        str coll_name = coll_name_opt.unwrap();
        str iter_name = iter_name_opt.unwrap();
        str opt_name = opt_name_opt.unwrap();

        self.ensure_generic_impl_method_emitted(coll_name, "iter");
        self.ensure_generic_impl_method_emitted(iter_name, "next");
        if is_map && fi.has_index_name {
          self.ensure_generic_impl_method_emitted(coll_name, "get");
        }

        self.for_iter_temp_counter = self.for_iter_temp_counter + 1;
        StringBuilder it_tmp_sb = string_builder_init(24);
        it_tmp_sb.append("__fun_iter_it");
        it_tmp_sb.append(format_num(self.for_iter_temp_counter));
        str it_tmp = it_tmp_sb.build();
        StringBuilder opt_tmp_sb = string_builder_init(24);
        opt_tmp_sb.append("__fun_iter_opt");
        opt_tmp_sb.append(format_num(self.for_iter_temp_counter));
        str opt_tmp = opt_tmp_sb.build();

        self.state.write("{\n");
        self.state.indent_level = self.state.indent_level + 1;
        self.state.write_indent();
        self.state.write(iter_name);
        self.state.write(" ");
        self.state.write(it_tmp);
        self.state.write(" = ");
        self.state.write(coll_name);
        self.state.write("__iter(&");
        self.state.write(arr_text);
        self.state.write(");\n");
        self.state.write_indent();
        self.state.write("for (;;) {\n");
        self.state.indent_level = self.state.indent_level + 1;
        self.state.write_indent();
        self.state.write(opt_name);
        self.state.write(" ");
        self.state.write(opt_tmp);
        self.state.write(" = ");
        self.state.write(iter_name);
        // `SetIter<T>`/`MapIter<K, V>` both declare `next` under `impl ...
        // as Iterator<...>` (a QUIRKED impl block, unlike `iter`/`get`'s
        // own plain ones just above) -- a quirked impl's own mangled
        // method name embeds the quirk name (`owner__QuirkName__method`,
        // see `emit_one_generic_impl_method`'s own naming), so the plain
        // `owner__method` this function otherwise uses everywhere else
        // doesn't resolve here. Hardcoding "Iterator" matches both
        // stdlib types' own actual declarations exactly -- acceptable
        // given this whole branch is already scoped to Set/Map
        // specifically, not a general Iterator-quirk dispatch.
        self.state.write("__Iterator__next(&");
        self.state.write(it_tmp);
        self.state.write(");\n");
        self.state.write_indent();
        self.state.write("if (");
        self.state.write(opt_tmp);
        self.state.write(".tag == ");
        self.state.write(opt_name);
        self.state.write("_None) break;\n");
        self.state.write_indent();
        if is_map && fi.has_index_name {
          self.state.write("__auto_type ");
          self.state.write(fi.index_name);
          self.state.write(" = ");
          self.state.write(opt_tmp);
          self.state.write(".payload.Some._0;\n");
          self.state.write_indent();
          self.state.write("__auto_type ");
          self.state.write(fi.item_name);
          self.state.write(" = ");
          self.state.write(coll_name);
          self.state.write("__get(&");
          self.state.write(arr_text);
          self.state.write(", ");
          self.state.write(fi.index_name);
          self.state.write(");\n");
          let key_name = self.resolve_type_name(elem_key_dt);
          if key_name.is_some() {
            self.record_local_typed(
              fi.index_name,
              key_name.unwrap(),
              dtype_is_pointer(elem_key_dt),
              elem_key_dt
            );
          }
          let val_dt2 = *coll_dt.generic_args.get(1);
          let val_name = self.resolve_type_name(val_dt2);
          if val_name.is_some() {
            self.record_local_typed(
              fi.item_name,
              val_name.unwrap(),
              dtype_is_pointer(val_dt2),
              val_dt2
            );
          }
        } else {
          self.state.write("__auto_type ");
          self.state.write(fi.item_name);
          self.state.write(" = ");
          self.state.write(opt_tmp);
          self.state.write(".payload.Some._0;\n");
          let elem_name = self.resolve_type_name(elem_key_dt);
          if elem_name.is_some() {
            self.record_local_typed(
              fi.item_name,
              elem_name.unwrap(),
              dtype_is_pointer(elem_key_dt),
              elem_key_dt
            );
          }
        }
        let berr = self.emit_body(*fi.body);
        if berr.is_some() {
          ret berr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        ret .None;
      }
    }

    if !is_vec && !is_raw_array {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }

    str idx_name = "__fun_i";
    if fi.has_index_name {
      idx_name = fi.index_name;
    }

    // A Vec-typed iterable that ISN'T a bare identifier (`squares.keys()`,
    // `examples/stdlib/collections_iter.fn`'s own real body) is an RVALUE
    // -- `arr_text` is its own rendered CALL text, re-embedding it in both
    // the loop condition (`arr_text.len`) and the body (`arr_text.data[
    // idx]`) would re-evaluate the call once per condition check AND once
    // per iteration, re-allocating a brand new Vec every single time
    // (wasteful, and leaks every one of those but the last). Materialized
    // into a temp ONCE up front instead, matching the original
    // transpiler's own identical reasoning for this exact shape. Raw
    // arrays never reach here as a non-identifier (the earlier `is_array`
    // check already requires a real local), so this only ever applies to
    // the Vec case.
    bin needs_vec_src_temp = is_vec && !iterable_is_identifier;
    str vec_src_text = arr_text;
    if needs_vec_src_temp {
      self.for_iter_temp_counter = self.for_iter_temp_counter + 1;
      StringBuilder vsrc_sb = string_builder_init(24);
      vsrc_sb.append("__fun_iter_src");
      vsrc_sb.append(format_num(self.for_iter_temp_counter));
      vec_src_text = vsrc_sb.build();
      self.state.write("{\n");
      self.state.indent_level = self.state.indent_level + 1;
      self.state.write_indent();
      self.state.write("__auto_type ");
      self.state.write(vec_src_text);
      self.state.write(" = ");
      self.state.write(arr_text);
      self.state.write(";\n");
      self.state.write_indent();
    }

    // A MULTI-DIMENSIONAL raw array's own length bound (for THIS level)
    // can't be computed from `arr_text` itself once `arr_text` is a
    // NESTED item (`row` in `for item : row`, itself a PREVIOUS `for row
    // : matrix` loop's own item) -- `row`'s own runtime value has
    // already decayed to a pointer by then (`sizeof(row)` would just be
    // the pointer's own size, not the real row length). `Codegen.local_
    // multidim_names` tracks exactly this: when `arr_text` was itself
    // registered as a multi-dim item (below, the FIRST time this ever
    // recurses), `len_root`/`len_offset` redirect the bound expression
    // back to the TRUE root array name with the right number of leading
    // `[0]` index levels instead -- `sizeof(matrix[0])/sizeof(matrix[0][
    // 0])` for the inner loop, e.g., not `sizeof(row)/sizeof(row[0])`.
    // Defaults to `arr_text` itself with zero leading `[0]`s -- the
    // ordinary case, an array that's either 1D or the OUTERMOST loop
    // over a multi-dim one (`arr_text` still names the real declared
    // array directly).
    str len_root = arr_text;
    num len_offset = 0;
    if is_raw_array && iterable_is_identifier {
      let mdim = self.lookup_local_multidim(arr_text);
      if mdim.is_some() {
        let m = mdim.unwrap();
        len_root = m.root;
        len_offset = m.depth;
      }
    }
    // How many dimensions are left BELOW this one -- 0 for an ordinary
    // 1D array or the innermost level of a multi-dim one (`item` is a
    // plain scalar), 1 for a 2D array's own row (`item` decays to a
    // single-star pointer), 2+ for a 3D+ array's own layer (`item` needs
    // `__auto_type` to correctly deduce a "pointer to array" type --
    // see below).
    num element_depth = 0;
    if is_raw_array && raw_array_depth > 0 {
      element_depth = raw_array_depth - 1;
    }
    self.state.write("for (int64_t ");
    self.state.write(idx_name);
    self.state.write(" = 0; ");
    self.state.write(idx_name);
    self.state.write(" < ");
    if is_vec {
      self.state.write(vec_src_text);
      self.state.write(".len; ");
    } else {
      self.state.write("(int64_t)(sizeof(");
      self.state.write(len_root);
      num lo_i = 0;
      for lo_i < len_offset {
        self.state.write("[0]");
        lo_i = lo_i + 1;
      }
      self.state.write(")/sizeof(");
      self.state.write(len_root);
      num lo_j = 0;
      for lo_j < len_offset + 1 {
        self.state.write("[0]");
        lo_j = lo_j + 1;
      }
      self.state.write(")); ");
    }
    self.state.write(idx_name);
    self.state.write("++) {\n");
    self.state.indent_level = self.state.indent_level + 1;
    self.state.write_indent();
    // An element that's ITSELF still an array of 2+ dimensions (a 3D+
    // array's own layer, `item = tensor[idx]` where `tensor` is `num[][]
    // []`) needs `__auto_type` so the compiler deduces the correct
    // "pointer to array" type (`int64_t (*)[4]`, e.g.) -- naive pointer-
    // star expansion (`elem_c_type **item`) would be a flat double
    // pointer instead, wrong (loses the inner dimension's own stride).
    // Confirmed empirically: array-to-pointer decay on assignment always
    // takes the FIRST-ELEMENT's own type as the pointee, never flattens
    // further. A 1D array or a 2D array's own row (`element_depth` 0 or
    // 1) has no such ambiguity -- plain `elem_c_type` plus the right
    // number of stars matches the original transpiler's own identical
    // distinction exactly.
    if is_vec || element_depth >= 2 {
      self.state.write("__auto_type ");
    } else {
      self.state.write(elem_c_type);
      num star_i = 0;
      for star_i < element_depth {
        self.state.write(" *");
        star_i = star_i + 1;
      }
      self.state.write(" ");
    }
    self.state.write(fi.item_name);
    self.state.write(" = ");
    self.state.write(vec_src_text);
    if is_vec {
      self.state.write(".data[");
    } else {
      self.state.write("[");
    }
    self.state.write(idx_name);
    self.state.write("];\n");
    // `item` is recorded as a known local of the ELEMENT type too, when
    // `elem_dt` was resolved above (see this function's own doc
    // comment); otherwise it's left unrecorded -- its declared Fun type
    // is unknown here (that's the whole point of `__auto_type`), so a
    // later `item.field`/nested-iteration read is correctly rejected by
    // whatever needs it rather than guessed at; dereferencing it
    // (`*item`, common when `T` is itself a pointer) works fine either
    // way since that doesn't need a locals lookup at all.
    if elem_dt.is_some() {
      let edt = elem_dt.unwrap();
      let elem_name = self.resolve_type_name(edt);
      if elem_name.is_some() {
        self.record_local_typed(fi.item_name, elem_name.unwrap(), dtype_is_pointer(edt), edt);
      }
    }
    // A raw array's own item is ALSO recorded as a known local of the
    // decremented-depth type -- needed for `item` itself to be
    // recognized as a (possibly STILL multi-dimensional) raw array by a
    // FURTHER nested `for x : item`, which re-enters this exact function
    // and needs `arr_dtype`/`is_raw_array` to resolve structurally for
    // `item`'s own name, not just to track its multidim root/depth
    // (registered separately, right below, only when `item` is STILL an
    // array after this level).
    if is_raw_array && raw_arr_dt.is_some() {
      DataType item_dt = raw_arr_dt.unwrap();
      item_dt.array_depth = element_depth;
      item_dt.is_array = element_depth > 0;
      let item_name_opt = self.resolve_type_name(item_dt);
      if item_name_opt.is_some() {
        self.record_local_typed(fi.item_name, item_name_opt.unwrap(), false, item_dt);
      }
      if element_depth > 0 {
        self.record_local_multidim(fi.item_name, len_root, len_offset + 1);
      }
    }
    let berr = self.emit_body(*fi.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    if needs_vec_src_temp {
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}\n");
    }
    ret .None;
  }

  // Emits one `fit` branch that matches a tagged-union enum variant
  // (bare shorthand `.Variant`/`.Variant(x)`, or qualified
  // `EnumName.Variant`/`EnumName.Variant(x)`, with or without
  // destructuring bindings) as `subj.tag == EnumName_Variant { ... }` (or
  // `subj->tag == ...` when `subj_is_pointer`, e.g. a `fit *self { ... }`
  // subject), chained with a leading `if`/`else if` per `wrote_branch`
  // matching the literal-chain path's own convention in `emit_fit`. Each
  // positional binding name gets its own `__auto_type name =
  // subj.payload.Variant._N;` declaration first (matching
  // `emit_for_iter`'s own reason for `__auto_type`: the C compiler
  // infers the actual type). Also registers each binding as a known
  // LOCAL when its own payload field type is on record (see `Codegen.
  // enum_variant_payload_owner`'s doc comment), so further access on it
  // inside the branch still resolves.
  emit_fit_enum_branch(
    str subj_name,
    bin subj_is_pointer,
    str enum_name,
    str variant_name,
    FitBranch br,
    bin wrote_branch
  ) Option<CodegenErrorKind> {
    if wrote_branch {
      self.state.write(" else if (");
    } else {
      self.state.write("if (");
    }
    self.state.write(subj_name);
    if subj_is_pointer {
      self.state.write("->");
    } else {
      self.state.write(".");
    }
    self.state.write("tag == ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    if br.has_bindings {
      num bi = 0;
      for bname : br.bindings {
        self.state.write_indent();
        self.state.write("__auto_type ");
        self.state.write(bname);
        self.state.write(" = ");
        self.state.write(subj_name);
        if subj_is_pointer {
          self.state.write("->");
        } else {
          self.state.write(".");
        }
        self.state.write("payload.");
        self.state.write(variant_name);
        self.state.write("._");
        self.state.write(format_num(bi));
        self.state.write(";\n");
        // See `Codegen.enum_variant_payload_owner`'s doc comment: a
        // known payload field type means `bname` is registered as a
        // known local too, so further access on it inside the branch
        // (a chained field access, another `fit`, a method call --
        // `_prev_token_is_bare_zero`'s real body, e.g., destructures
        // `t` then reads `t.data`) resolves. An unresolvable payload
        // type just leaves `bname` unregistered, same as everywhere
        // else in this file.
        let payload_info = self.lookup_enum_variant_payload_type(enum_name, variant_name, bi);
        if payload_info.is_some() {
          let info = payload_info.unwrap();
          self.record_local(bname, info.type_name, info.is_pointer);
        }
        bi = bi + 1;
      }
    }
    let berr = self.emit_body(*br.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits one `fit` branch that matches a PLAIN (payload-less) enum's
  // variant (bare shorthand `.Variant`, or qualified `EnumName.Variant`
  // -- no destructuring, a plain enum has no payload to bind) as
  // `subj == EnumName_Variant { ... }` (or `(*subj) == ...` when
  // `subj_is_pointer`) -- the direct C-enum-value comparison, matching
  // the original transpiler's own `fit_subject_tagged_union_name`
  // returning null for a non-data-carrying enum and falling back to a
  // plain equality chain, NOT `emit_fit_enum_branch`'s `.tag ==` (that
  // shape only exists on a TAGGED-union struct -- a bare C enum has no
  // `tag` field at all, "member reference base type ... is not a
  // structure or union"). Found via a real stage-2 self-compilation C
  // error on `WarningId as To<str>`'s own `fit *self { .Variant -> ...
  // }` body -- `WarningId` has only payload-less variants, so `emit_
  // enum` already compiles it as a bare `typedef enum`, but `emit_fit`
  // itself had no branch for that shape and always assumed tagged-union.
  emit_fit_plain_enum_branch(
    str subj_name,
    bin subj_is_pointer,
    str enum_name,
    str variant_name,
    FitBranch br,
    bin wrote_branch
  ) Option<CodegenErrorKind> {
    if wrote_branch {
      self.state.write(" else if (");
    } else {
      self.state.write("if (");
    }
    if subj_is_pointer {
      self.state.write("(*");
      self.state.write(subj_name);
      self.state.write(")");
    } else {
      self.state.write(subj_name);
    }
    self.state.write(" == ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*br.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits `fit subject { patterns -> { body } ... }` as a chain of C
  // `if`/`else if`/`else` blocks. Two pattern kinds are recognized, tried
  // in order for each branch: (1) a tagged-union enum-variant pattern
  // (bare or qualified, destructuring or not -- see
  // `emit_fit_enum_branch`'s doc comment) whenever the branch's
  // condition has the `Identifier . Identifier` (qualified) or `Blank .
  // Identifier` (bare shorthand) shape AND names a known enum/variant --
  // a BARE shorthand's enum name comes from the SUBJECT's own declared
  // local type, the same "already fully explicit, no real inference"
  // trick used throughout this file; (2) otherwise, a literal pattern
  // compared against `subject` directly -- mirrors the original's own
  // `str`/`dec` "if/else-if chain" lowering, but applied UNIFORMLY here
  // (no `switch` path for an integral subject, since this codegen has no
  // type inference to pick a subject-wide strategy). A `str` pattern
  // label compares via `strcmp(...) == 0`; every other literal kind
  // compares via `==` -- decided PER LABEL from that label's own literal
  // kind, not once for the whole subject.
  // 
  // Deliberately narrow for this slice: the subject must be a plain
  // identifier, a single `*name` dereference of a pointer local (the
  // `fit *self { ... }` idiom used throughout this codebase's own real
  // stdlib), a chained field access (`fit t.data { ... }`, resolved via
  // `resolve_field_chain`), or a METHOD CALL (`fit self.method() {
  // ... }`, the single most common shape in this codebase's own real
  // parser -- e.g. `fit self.tokens_peek_no_increment() { .Some(t) -> {
  // ... } .None -> { ... } }`) -- the first three are each re-evaluated
  // once per branch instead of hoisted into a temp variable, safe only
  // because none of them has a side effect when read twice; a CALL
  // subject can't be re-evaluated (a real side effect, e.g. advancing a
  // cursor) so it's hoisted into ONE `__auto_type __fit_subjN = <call>;`
  // temp declaration first (`next_fit_subj_name`'s own counter keeps
  // each one unique -- two SIBLING `fit`-over-a-call statements in the
  // same block scope, not just a nested one, both need a fixed name
  // "__fit_subj" a real C "redefinition" error), with its bare-
  // shorthand enum type resolved from the CALLEE's own declared return
  // type (`Codegen.impl_method_rtype`, populated by
  // `register_impl_methods` -- see its own doc comment for why this is
  // ONLY populated for a non-generic impl's methods so far) rather than
  // a local's. Only a receiver.method() call matching `emit_method_call`
  // exactly (plain-identifier receiver that's a known local, plain-
  // identifier method name) is recognized; anything else (a plain-
  // function call, a chained call, an unknown receiver/method) is
  // rejected rather than guessed. A comma-chained LITERAL pattern (`1, 2
  // -> ...`) matches any of its values (OR-ed comparisons); reuses
  // `flatten_call_args` directly for that, since it's the exact same
  // comma-flattening a call's argument list needs. A destructuring/
  // enum-variant pattern whose enum/variant ISN'T recognized (an unknown
  // bare shorthand with no resolvable subject type, say) is rejected
  // outright rather than falling through to the literal path, which
  // could never validly compare against it anyway.
  // Next unique name for `emit_fit`'s own call-subject temp
  // (`__fit_subj1`, `__fit_subj2`, ...) -- see `Codegen.fit_subj_temp_
  // counter`'s own doc comment.
  next_fit_subj_name() str {
    self.fit_subj_temp_counter = self.fit_subj_temp_counter + 1;
    ret format("__fit_subj{num}", self.fit_subj_temp_counter);
  }

  emit_fit(FitStmtNode f) Option<CodegenErrorKind> {
    str subj_name = "";
    bin subj_is_pointer = false;
    Option<str> subj_type = .None;
    fit f.exp.kind {
      .Identifier(name) -> {
        subj_name = name;
        subj_type = self.lookup_local_type_name(name);
        subj_is_pointer = self.lookup_local_is_pointer(name).unwrap_or(false);
      }
      .Unary(u) -> {
        // `fit await self.foo(...) { ... }` (e.g. `std/fs.fn`'s real
        // `copy_file_with_progress_cancellable` body, found continuing
        // the stage-2 self-compilation attempt) -- the subject is an
        // `await`-wrapped call, not a plain identifier/indirection/call.
        // Resolves the callee's own return type via the EXACT SAME two
        // lookups the plain "()"-call case below uses (a bare-
        // identifier plain function, or a `recv.method()` chain), then
        // hoists a temp `__auto_type __fit_subj` holding the LOWERED
        // await call (`emit_await`, not a plain `emit_expr`/
        // `emit_method_call`) -- same reasoning as that case's own doc
        // comment for why a call subject needs one at all.
        if equals(u.op, "await") {
          ExprNode await_call;
          fit u.operand.kind {
            .Expression(ac) -> { await_call = ac; }
            _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
          }
          if !equals(await_call.op, "()") || !await_call.has_left || !await_call.has_right {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          Option<DataType*> await_rtype = .None;
          fit await_call.left.kind {
            .Identifier(fn_name) -> { await_rtype = self.lookup_function_rtype(fn_name); }
            .Expression(recv_e2) -> {
              if equals(recv_e2.op, ".") && recv_e2.has_left && recv_e2.has_right {
                let recv_chain2 = self.resolve_field_chain(recv_e2.left);
                if recv_chain2.is_some() {
                  str method_name2 = "";
                  fit recv_e2.right.kind {
                    .Identifier(n2) -> { method_name2 = n2; }
                    _ -> {}
                  }
                  if !equals(method_name2, "") {
                    await_rtype = self.lookup_impl_method_rtype(
                      recv_chain2.unwrap().type_name,
                      method_name2
                    );
                  }
                }
              }
            }
            _ -> {}
          }
          if await_rtype.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let resolved_await_rtype = self.resolve_type_name(*await_rtype.unwrap());
          if resolved_await_rtype.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let fit_subj_name1 = self.next_fit_subj_name();
          self.state.write("__auto_type ");
          self.state.write(fit_subj_name1);
          self.state.write(" = ");
          let awerr = self.emit_await(u.operand);
          if awerr.is_some() {
            ret awerr;
          }
          self.state.write(";\n");
          self.state.write_indent();
          subj_name = fit_subj_name1;
          subj_type = resolved_await_rtype;
          subj_is_pointer = false;
        } elif u.is_left_operanded_unary || !u.has_indirection || u.indirection_depth != 1 {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        } else {
          fit u.operand.kind {
            .Identifier(name) -> {
              subj_name = name;
              subj_type = self.lookup_local_type_name(name);
              subj_is_pointer = true;
            }
            _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
          }
        }
      }
      .Expression(dot_e) -> {
        if equals(dot_e.op, "()") {
          if !dot_e.has_left || !dot_e.has_right {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          // `fit <plain function call>(...) { ... }` (e.g. `fit
          // get_c_typedef_alias_datatype_type(name) { ... }` --
          // `ParseState.parse_datatype`'s own real body, found via the
          // self-compile experiment): the callee is a bare `.Identifier`,
          // not a `recv.method()` `.Expression` -- resolved via the same
          // `lookup_function_rtype` lookup `infer_let_expr_type`'s own
          // "()" case uses for a plain call, and emitted the same way
          // the method-call branch below does (a temp `__auto_type
          // __fit_subj` holding the call's result).
          bin is_plain_fn_call = false;
          str plain_fn_name = "";
          fit dot_e.left.kind {
            .Identifier(fn_name) -> {
              is_plain_fn_call = true;
              plain_fn_name = fn_name;
            }
            _ -> {}
          }
          if is_plain_fn_call {
            let rtype = self.lookup_function_rtype(plain_fn_name);
            if rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let resolved_rtype = self.resolve_type_name(*rtype.unwrap());
            if resolved_rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let fit_subj_name2 = self.next_fit_subj_name();
            self.state.write("__auto_type ");
            self.state.write(fit_subj_name2);
            self.state.write(" = ");
            let cerr = self.emit_expr(*f.exp);
            if cerr.is_some() {
              ret cerr;
            }
            self.state.write(";\n");
            self.state.write_indent();
            subj_name = fit_subj_name2;
            subj_type = resolved_rtype;
            subj_is_pointer = false;
          } else {
            ExprNode recv_e;
            fit dot_e.left.kind {
              .Expression(inner) -> { recv_e = inner; }
              _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
            }
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            // The receiver itself may be a CHAINED field access, not
            // just a bare local (`fit self.state.token_peek_prev_n(1)
            // { ... }` -- `Parser.parse_single_token_to_node`'s own real
            // body, found via the self-compile experiment) -- resolved
            // via `resolve_field_chain` (any depth), the same lookup
            // `emit_method_call`/`infer_let_expr_type` already use for a
            // chained method-call receiver, instead of requiring a bare
            // `.Identifier`.
            let recv_chain = self.resolve_field_chain(recv_e.left);
            if recv_chain.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let owner_type_name = recv_chain.unwrap().type_name;
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(n) -> { method_name = n; }
              _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
            }
            let rtype = self.lookup_impl_method_rtype(owner_type_name, method_name);
            if rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let resolved_rtype = self.resolve_type_name(*rtype.unwrap());
            if resolved_rtype.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            let fit_subj_name3 = self.next_fit_subj_name();
            self.state.write("__auto_type ");
            self.state.write(fit_subj_name3);
            self.state.write(" = ");
            let merr = self.emit_method_call(recv_e, dot_e.right);
            if merr.is_some() {
              ret merr;
            }
            self.state.write(";\n");
            self.state.write_indent();
            subj_name = fit_subj_name3;
            subj_type = resolved_rtype;
            subj_is_pointer = false;
          }
        } else {
          if !equals(dot_e.op, ".") {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let resolved = self.resolve_field_chain(f.exp);
          if resolved.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          let r = resolved.unwrap();
          subj_name = r.text;
          subj_type = .Some(r.type_name);
          subj_is_pointer = r.is_pointer;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    bin wrote_branch = false;
    Node* default_body = nil;
    bin has_default = false;

    for br : f.branches {
      if !br.has_condition {
        if br.has_bindings && br.bindings.len > 0 {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        default_body = br.body;
        has_default = true;
        continue;
      }

      bin handled_as_enum = false;
      fit br.condition.kind {
        .Expression(dot_e) -> {
          if equals(dot_e.op, ".") && dot_e.has_left && dot_e.has_right {
            str enum_name = "";
            bin have_enum_name = false;
            fit dot_e.left.kind {
              .Identifier(en) -> {
                enum_name = en;
                have_enum_name = true;
              }
              .Blank -> {
                if subj_type.is_some() {
                  enum_name = subj_type.unwrap();
                  have_enum_name = true;
                }
              }
              _ -> {}
            }
            str variant_name = "";
            fit dot_e.right.kind {
              .Identifier(vn) -> { variant_name = vn; }
              _ -> {}
            }
            // An EXPLICIT `EnumName.Variant` condition (`Option.Some(x)
            // ->`, e.g. `std/set.fn`'s real `to_string` body) writes the
            // enum's own BARE TEMPLATE name when the subject is a
            // generic enum -- there's no C symbol spelled "Option" for
            // `enum_has_variant` to recognize, only the MONOMORPHIZED
            // instantiation's own mangled name ("Option__num", already
            // resolved into `subj_type` above). The bare-shorthand form
            // (`.Some(x) ->`, `dot_e.left` a `.Blank` above) doesn't hit
            // this at all -- it already falls back to `subj_type`
            // directly, with no template-name prefix to conflict with.
            // Recognizing a written template name against a
            // monomorphized subject just needs the same mangling
            // convention `ensure_enum_instantiated` itself always
            // produces (`<base>__<arg1>__...`): if the plain lookup
            // fails, but `enum_name` is a known generic template AND
            // `subj_type` is one of ITS OWN concrete instantiations
            // (its mangled name starts with `enum_name + "__"`), treat
            // the condition as matching `subj_type`'s own variant
            // instead.
            bin has_variant = self.enum_has_variant(enum_name, variant_name);
            str effective_enum_name = enum_name;
            if !has_variant && have_enum_name && subj_type.is_some() {
              let subj = subj_type.unwrap();
              StringBuilder tmpl_pfx = string_builder_init(16);
              tmpl_pfx.append(enum_name);
              tmpl_pfx.append("__");
              if starts_with(subj, tmpl_pfx.build()) && self.enum_has_variant(subj, variant_name) {
                has_variant = true;
                effective_enum_name = subj;
              }
            }
            if have_enum_name && has_variant {
              // A PLAIN (payload-less) enum has no `.tag` field at all --
              // see `emit_fit_plain_enum_branch`'s own doc comment -- so
              // it needs a genuinely different comparison than a tagged-
              // union subject's `.tag == ...`, decided here per the
              // recorded enum, not assumed tagged unconditionally.
              if self.enum_is_tagged_union_named(effective_enum_name) {
                let eerr = self.emit_fit_enum_branch(
                  subj_name,
                  subj_is_pointer,
                  effective_enum_name,
                  variant_name,
                  br,
                  wrote_branch
                );
                if eerr.is_some() {
                  ret eerr;
                }
              } else {
                if br.has_bindings && br.bindings.len > 0 {
                  ret .Some(CodegenErrorKind.UnsupportedNode);
                }
                let peerr = self.emit_fit_plain_enum_branch(
                  subj_name,
                  subj_is_pointer,
                  effective_enum_name,
                  variant_name,
                  br,
                  wrote_branch
                );
                if peerr.is_some() {
                  ret peerr;
                }
              }
              handled_as_enum = true;
              wrote_branch = true;
            }
          }
        }
        _ -> {}
      }
      if handled_as_enum {
        continue;
      }

      if br.has_bindings && br.bindings.len > 0 {
        ret .Some(CodegenErrorKind.UnsupportedNode);
      }

      if wrote_branch {
        self.state.write(" else if (");
      } else {
        self.state.write("if (");
      }

      Vec<Node*> labels;
      labels.init(0);
      defer labels.free();
      self.flatten_call_args(br.condition, &labels);

      bin first_label = true;
      for lbl : labels {
        if !first_label {
          self.state.write(" || ");
        }
        first_label = false;
        bin is_str_label = false;
        fit lbl.kind {
          .String(_) -> { is_str_label = true; }
          _ -> {}
        }
        if is_str_label {
          self.state.write("strcmp(");
          self.state.write(subj_name);
          self.state.write(", ");
          let lerr = self.emit_expr(*lbl);
          if lerr.is_some() {
            ret lerr;
          }
          self.state.write(") == 0");
        } else {
          self.state.write(subj_name);
          self.state.write(" == ");
          let lerr2 = self.emit_expr(*lbl);
          if lerr2.is_some() {
            ret lerr2;
          }
        }
      }

      self.state.write(") {\n");
      self.state.indent_level = self.state.indent_level + 1;
      let berr = self.emit_body(*br.body);
      if berr.is_some() {
        ret berr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
      wrote_branch = true;
    }

    if has_default {
      if wrote_branch {
        self.state.write(" else {\n");
      } else {
        self.state.write("{\n");
      }
      self.state.indent_level = self.state.indent_level + 1;
      let dberr = self.emit_body(*default_body);
      if dberr.is_some() {
        ret dberr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
    }
    self.state.write("\n");
    ret .None;
  }

  // Emits an `if (cond) { ... }` block, WITHOUT the trailing newline (the
  // caller -- either `emit_statements` chaining a following elif/else, or
  // this same function recursing for one) decides what comes next).
  emit_if_block(Node* condition, Node* body) Option<CodegenErrorKind> {
    self.state.write("if (");
    let cerr = self.emit_expr(*condition);
    if cerr.is_some() {
      ret cerr;
    }
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits `stmts[start_i]` (a `StatementIf`) chained with every
  // immediately-following `StatementElseIf`/`StatementElse` sibling as a
  // single C `if (...) { } else if (...) { } else { }` construct, and
  // returns the index just past the whole chain.
  // 
  // `if`/`elif`/`else` are parsed as three INDEPENDENT sibling statement
  // kinds, not a nested tree (see `StatementIf`/`StatementElseIf`/
  // `StatementElse`'s own doc comments in ast.fn) -- so chaining them into
  // one C construct needs this adjacency lookahead over the statement
  // list, mirroring the original's `current_statement_type`/
  // `next_statement_type` tracking for the same purpose.
  emit_if_chain(Vec<Node*> stmts, num start_i, num* out_next_i) Option<CodegenErrorKind> {
    Node* if_stmt = stmts.get(start_i);
    fit if_stmt.kind {
      .StatementIf(ifn) -> {
        let ferr = self.emit_if_block(ifn.condition, ifn.body);
        if ferr.is_some() {
          ret ferr;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }

    num i = start_i + 1;
    for i < stmts.len {
      Node* next = stmts.get(i);
      bin chained = false;
      fit next.kind {
        .StatementElseIf(ein) -> {
          self.state.write(" else ");
          let eerr = self.emit_if_block(ein.condition, ein.body);
          if eerr.is_some() {
            ret eerr;
          }
          chained = true;
        }
        .StatementElse(ebody) -> {
          self.state.write(" else {\n");
          self.state.indent_level = self.state.indent_level + 1;
          let elerr = self.emit_body(*ebody);
          if elerr.is_some() {
            ret elerr;
          }
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}");
          chained = true;
        }
        _ -> {}
      }
      if !chained {
        break;
      }
      i = i + 1;
    }
    self.state.write("\n");
    *out_next_i = i;
    ret .None;
  }

  // True for a statement kind that's KNOWN to always leave its enclosing
  // block (a `ret`/`break`/`continue`, or a bare `panic(...)` statement,
  // which always aborts) -- used by `emit_statements` to decide whether
  // ordinary fall-through defer cleanup is needed after the LAST
  // statement in a block. Conservative, matching the original's own
  // `node_is_scope_terminator`: an if/elif/else chain is never treated as
  // a terminator here even when every one of its own branches returns --
  // proving that would need real branch-coverage analysis this codegen
  // doesn't do, so a block ending in such a chain harmlessly emits (dead
  // but valid) fall-through defer cleanup after it too.
  node_is_scope_terminator(Node stmt) bin {
    fit stmt.kind {
      .StatementReturn(_) -> { ret true; }
      .StatementBreak -> { ret true; }
      .StatementContinue -> { ret true; }
      .Panic(_) -> { ret true; }
      _ -> { ret false; }
    }
  }

  // Pushes a new `defer` scope frame, marking `defer_stack`'s CURRENT
  // length as where THIS block's own defers begin -- see
  // `Codegen.defer_stack`'s doc comment.
  push_defer_scope() {
    self.defer_scope_starts.push(self.defer_stack.len);
  }

  // Pops the innermost `defer` scope frame and discards its (by now
  // already-emitted, one way or another) entries from `defer_stack`.
  pop_defer_scope() {
    if self.defer_scope_starts.len == 0 {
      ret;
    }
    let start = self.defer_scope_starts.pop();
    self.defer_stack.resize(start, nil);
  }

  // Emits (WITHOUT removing -- see `Codegen.defer_stack`'s doc comment)
  // every pending defer from `defer_stack`'s end back down to
  // `start_index`, in REVERSE (LIFO) registration order, each as an
  // ordinary statement via `emit_body` (a deferred body is either a
  // single statement or a `{ ... }` block, exactly what `emit_body`
  // already dispatches on).
  emit_defers_from(num start_index) Option<CodegenErrorKind> {
    num i = self.defer_stack.len;
    for i > start_index {
      i = i - 1;
      let d = self.defer_stack.get(i);
      let derr = self.emit_body(*d);
      if derr.is_some() {
        ret derr;
      }
    }
    ret .None;
  }

  // Emits just the CURRENT (innermost) block's own pending defers --
  // used at ordinary fall-through (the block ends without an explicit
  // `ret`/`break`/`continue`/`panic` as its last statement).
  emit_current_scope_defers() Option<CodegenErrorKind> {
    if self.defer_scope_starts.len == 0 {
      ret .None;
    }
    let start = self.defer_scope_starts.get(self.defer_scope_starts.len - 1);
    ret self.emit_defers_from(start);
  }

  // Emits EVERY currently pending defer, back to function entry -- used
  // at a `ret` statement, which unwinds every enclosing block at once
  // regardless of nesting depth. Simplified from the original's own
  // `emit_function_scope_defers` (which stops at the nearest FUNCTION-
  // kind frame specifically, distinct from a LOOP frame): this codegen
  // doesn't yet distinguish frame kinds at all -- see
  // `Codegen.defer_stack`'s doc comment -- so "back to function entry"
  // and "back to index 0" are the same thing here.
  emit_function_scope_defers() Option<CodegenErrorKind> {
    ret self.emit_defers_from(0);
  }

  // Emits `stmts` in order, one statement per line, chaining any
  // `StatementIf`/`StatementElseIf`/`StatementElse` run into a single C
  // if/else-if/else construct via `emit_if_chain`. Pushes/pops its OWN
  // `defer` scope frame around the whole statement list (see
  // `Codegen.defer_stack`'s doc comment) -- every block, not just a
  // function's top-level body, is its own defer scope.
  emit_statements(Vec<Node*> stmts) Option<CodegenErrorKind> {
    self.push_defer_scope();
    num i = 0;
    bin last_is_terminator = false;
    for i < stmts.len {
      Node* stmt = stmts.get(i);
      // Armed fresh for EVERY statement, relative to whatever buffer
      // `self.state` CURRENTLY is -- when that's an isolated scratch
      // (`method_scratch`, e.g., mid-swap), this correctly tracks a
      // position WITHIN that scratch, letting a NESTED trigger from
      // deeper in this same body (`Vec<T>.init()`'s own `self.grow(cap)`
      // call, e.g.) splice its own inline prototype right into that
      // SAME scratch, before whichever statement triggered it -- exactly
      // matching where `self.state` itself is at the time, so the
      // splice always lands in the right buffer. Restored to the OUTER
      // (real-buffer) value by the swap's own code once it's done, same
      // as `hoist_insert_pos`.
      self.current_stmt_start_pos = .Some(self.state.out.len());
      bin is_if = false;
      fit stmt.kind {
        .StatementIf(ifn) -> { is_if = true; }
        _ -> {}
      }
      if is_if {
        self.state.write_indent();
        num next_i = i;
        let cherr = self.emit_if_chain(stmts, i, &next_i);
        if cherr.is_some() {
          self.pop_defer_scope();
          ret cherr;
        }
        i = next_i;
        last_is_terminator = false;
        continue;
      }
      last_is_terminator = self.node_is_scope_terminator(*stmt);
      let serr = self.emit_statement(*stmt);
      if serr.is_some() {
        self.pop_defer_scope();
        ret serr;
      }
      i = i + 1;
    }
    if !last_is_terminator {
      let dferr = self.emit_current_scope_defers();
      if dferr.is_some() {
        self.pop_defer_scope();
        ret dferr;
      }
    }
    self.pop_defer_scope();
    ret .None;
  }

  // Emits `body`: every statement in order when it's a `Body` block, or
  // just the one statement when it's a single braceless statement (an
  // `if`/`for`/... body doesn't require `{ }` when it's a single
  // statement -- see `_parse_if_body`'s doc comment in the parser).
  emit_body(Node body) Option<CodegenErrorKind> {
    fit body.kind {
      .Body(bn) -> { ret self.emit_statements(bn.statements); }
      _ -> { ret self.emit_statement(body); }
    }
  }

  // Emits one function parameter (a `Variable` node with no initializer)
  // as `<type> <name>`, and records it as a local for `.`/`->` decisions
  // (see `Codegen.local_names`'s doc comment). A function-TYPE parameter
  // (`fun(T1, T2) R name`, see `parser.parse_fn_type_datatype`'s doc
  // comment) instead needs C's function-pointer declarator shape, which
  // wraps the NAME rather than preceding it (`R (*name)(T1, T2)`) --
  // handled as its OWN case before the ordinary `write_type` path below,
  // matching the original's own special case for the exact same reason.
  // A call THROUGH such a parameter (`cb(a, b)`) needs no special
  // handling at the call site itself: its own C type is already a real
  // function pointer, so ordinary call syntax just works (see
  // `emit_call`'s doc comment). Recorded as a local under an empty type
  // name (never matches a real compound/enum, so a later `.field`/
  // `.method()` off of it is correctly rejected rather than guessed --
  // this codegen has no sensible "type name" for a function pointer to
  // begin with).
  emit_function_param(Node param) Option<CodegenErrorKind> {
    fit param.kind {
      .Variable(v) -> {
        if v.var_type.has_fn_sig {
          let sig = v.var_type.fn_sig;
          let rt = self.write_type(*sig.rtype);
          if rt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          self.state.write(" (*");
          self.state.write(v.name);
          self.state.write(")(");
          bin first = true;
          for p : sig.params {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let pt = self.write_type(*p);
            if pt.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
          }
          self.state.write(")");
          self.record_local(v.name, "", false);
          ret .None;
        }
        // An UNSIZED array parameter (`T[] src`, e.g. `Vec<T>`'s own
        // `push_many`/`extend`) decays to a pointer, same as an unsized
        // array FIELD/local does (see `dtype_is_array_as_pointer`'s doc
        // comment) -- but `write_type` itself never adds this star (it
        // only knows about `pointer_depth`/`flags.is_pointer`, neither of
        // which an array type sets), so it's added here explicitly,
        // matching the `Variable` local-declaration case just above.
        // Found via a real stage-2 self-compilation C error
        // (`subscripted value is not an array, pointer, or vector` on
        // `Vec<Vec<str>>`'s monomorphized `push_many`'s own `src`
        // parameter, emitted with zero stars).
        // 
        // Added UNCONDITIONALLY when `arr_as_ptr` (not only when `param_
        // dt` isn't already a pointer) -- `resolve_type_subst` never
        // folds the array-decay's own level into `pointer_depth` (an
        // unsized array's `dt.pointer_depth` is always 0 going in,
        // regardless of what it substitutes to), so this level is always
        // ADDITIONAL, stacking on top of whatever `write_type` already
        // wrote for the substituted argument's own pointer depth. Gating
        // this on `!dtype_is_pointer(param_dt)` (tried first) silently
        // dropped the array's own level whenever the argument ITSELF was
        // already a pointer (`Vec<Node*>`'s `push_many(Node* src, ...)`
        // needs `Node** src`, two levels: one because it's an array, one
        // because each element is already a `Node*` -- found the same
        // way, one field further down the very same stage-2 error list).
        bin arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
        let wt = self.write_type(*v.var_type);
        if wt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        let param_dt = self.resolve_type_subst(*v.var_type);
        if arr_as_ptr {
          self.state.write("*");
        }
        self.state.write(" ");
        self.state.write(v.name);
        self.record_local_typed(
          v.name,
          wt.unwrap(),
          dtype_is_pointer(param_dt) || arr_as_ptr,
          param_dt
        );
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a plain (no generics, no variadics) top-level function
  // declaration as a C function definition: `<rtype> <name>(<args>) {
  // <body> }` (or `(void)` for a zero-arg function, matching C
  // convention -- an empty `()` in C means "unspecified arguments", not
  // "no arguments").
  pub emit_function(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> { ret self.emit_function_named(node, f.name); }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Does the actual work of `pub emit_function`, under an explicit
  // `emit_name` rather than always `node`'s own already-mangled
  // `Function.name` -- so `maybe_instantiate_generic_impl_methods` can
  // emit the SAME template method body once per concrete instantiation,
  // each under its own further-mangled C symbol (`Box__num__get`,
  // `Box__str__get`, ...), without a second copy of this function. `
  // current_fn_rtype_name` is set from the RESOLVED (post-`write_type`,
  // so post-substitution) return type name rather than `f.rtype.
  // type_str` directly, so a generic method's own bare-`T` return type
  // resolves against the active instantiation for `ret <shorthand>;`
  // (see `Codegen.current_fn_rtype_name`'s doc comment) -- identical to
  // `f.rtype.type_str` for every non-generic-impl-method call, so this
  // doesn't change behavior anywhere else.
  // True when `node` was declared in a `std/c/*.fn` binding file (a
  // signature-only module documenting an existing C header, e.g.
  // `std/c/time.fn`'s `tm`/`timespec` or `std/c/io.fn`'s `FILE`). Such a
  // declaration exists purely so Fun call sites/field accesses can be
  // typechecked against it; the REAL system header (already `#include`d
  // by `write_std_imports`) is the sole source of truth for the actual
  // C definition, so codegen must never emit competing C text for one
  // of these nodes (a struct redefinition, e.g. `tm`/`timespec`/`FILE`
  // clashing with `<time.h>`/`<stdio.h>`'s own).
  is_std_c_signature_node(Node node) bin {
    if !node.has_pos {
      ret false;
    }
    ret contains(node.pos.filename, "/std/c/") || contains(node.pos.filename, "\\std\\c\\");
  }

  // Emits the wrapper C functions an `async fun`/`async` method needs
  // around its own (otherwise perfectly ordinary) body: a per-function
  // "payload" struct holding its args plus its result, an entry
  // trampoline that runs on a dedicated OS thread and unpacks/repacks
  // through that payload, a spawn helper, an await helper (join +
  // extract result + free), a call helper -- the thing `await expr`
  // actually calls (see `emit_await`'s own doc comment) -- and, when
  // `fork` is used anywhere in the program, a SECOND entry/call pair
  // (reusing the same payload struct) that `fork expr;` calls instead
  // (see `emit_fork_stmt`'s own doc comment). Matches the original
  // implementation's identical mechanism exactly: there is no state
  // machine or coroutine transform anywhere -- `await` is "spawn a
  // thread running the whole function body, then immediately join it,"
  // and `fork` is "enqueue the whole function body onto the scheduler's
  // worker pool, don't wait for it."
  // `emit_name` is the function's OWN final emitted C name (its bare
  // name for a plain function, or the fully mangled name for a generic
  // impl method instantiation -- see `emit_function_named`'s own
  // `emit_name` parameter doc comment) so this naturally covers a
  // monomorphized `async` method (e.g. `Channel<T>`'s `send_timeout_
  // async`) once per concrete instantiation, with no separate wiring
  // needed at the generic-impl-instantiation call site.
  // 
  // Both the entry trampoline's call AND the call helper's own two
  // "degrade to a direct synchronous call" fallbacks (on `malloc`
  // failure or a spawn failure) call `emit_name` directly -- matching
  // the original's identical fallback, and relying on `emit_name`'s own
  // ordinary (non-wrapped) definition being emitted right after this
  // returns (see `emit_function_named`'s own call site).
  // 
  // Deliberately narrower than the original for this slice: no
  // rejection diagnostic for a call to a known-async function that's
  // neither `await`ed nor `fork`ed (a validation nicety, not load-bearing for
  // correct codegen); a function-pointer-typed argument
  // (`v.var_type.has_fn_sig`) is also rejected outright rather than
  // supported, since nothing this slice needs passes one to an async
  // function.
  emit_async_function_support(Node node, str emit_name) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        bin is_void = equals(f.rtype.type_str, "void");

        Vec<str> arg_names;
        arg_names.init(0);
        Vec<DataType*> arg_dtypes;
        arg_dtypes.init(0);
        if f.has_args {
          for arg : f.args {
            fit arg.kind {
              .Variable(v) -> {
                if v.var_type.has_fn_sig {
                  ret .Some(CodegenErrorKind.UnsupportedNode);
                }
                arg_names.push(v.name);
                arg_dtypes.push(v.var_type);
              }
              _ -> {}
            }
          }
        }

        // 0. Forward-declare `emit_name` itself: the entry trampoline
        // and the call helper's own sync-fallback paths (below) both
        // call it directly, but its REAL definition is emitted right
        // AFTER this whole helper set returns (see `emit_function_named`
        // 's own call site) -- without this, that's a forward reference
        // to an as-yet-undeclared C function.
        let fwt = self.write_type(*f.rtype);
        if fwt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write(" ");
        self.state.write(emit_name);
        self.state.write("(");
        num fi = 0;
        for fi < arg_dtypes.len {
          if fi > 0 {
            self.state.write(", ");
          }
          let fpt = self.write_type(*arg_dtypes.get(fi));
          if fpt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          fi = fi + 1;
        }
        if arg_dtypes.len == 0 {
          self.state.write("void");
        }
        self.state.write(");\n");

        StringBuilder pnb = string_builder_init(32);
        pnb.append("__fun_async_payload_");
        pnb.append(emit_name);
        str payload_name = pnb.build();

        // 1. Payload struct: one field per arg, plus `__result` unless
        // `f`'s own return type is `void`.
        self.state.write("typedef struct ");
        self.state.write(payload_name);
        self.state.write(" {\n");
        num ai = 0;
        for ai < arg_names.len {
          self.state.write("  ");
          let awt = self.write_type(*arg_dtypes.get(ai));
          if awt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          self.state.write(" __arg");
          self.state.write(format_num(ai));
          self.state.write(";\n");
          ai = ai + 1;
        }
        if !is_void {
          self.state.write("  ");
          let rwt = self.write_type(*f.rtype);
          if rwt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          self.state.write(" __result;\n");
        }
        self.state.write("} ");
        self.state.write(payload_name);
        self.state.write(";\n");

        // 2. Entry trampoline: runs on the spawned thread.
        self.state.write("static void* __fun_async_entry_");
        self.state.write(emit_name);
        self.state.write("(void* __arg) {\n");
        self.state.write("  ");
        self.state.write(payload_name);
        self.state.write("* __payload = (");
        self.state.write(payload_name);
        self.state.write("*)__arg;\n");
        self.state.write("  ");
        if !is_void {
          self.state.write("__payload->__result = ");
        }
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          self.state.write("__payload->__arg");
          self.state.write(format_num(ai));
          ai = ai + 1;
        }
        self.state.write(");\n");
        self.state.write("  return NULL;\n");
        self.state.write("}\n");

        // 3. Spawn helper.
        self.state.write("static int __fun_async_spawn_");
        self.state.write(emit_name);
        self.state.write("(");
        self.state.write(payload_name);
        self.state.write("* __payload, __fun_thread_t* __thr) {\n");
        self.state.write("  return __fun_thread_start(__thr, __fun_async_entry_");
        self.state.write(emit_name);
        self.state.write(", __payload);\n");
        self.state.write("}\n");

        // 4. Await helper: join, extract the result, free the payload.
        self.state.write("static ");
        let awt2 = self.write_type(*f.rtype);
        if awt2.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write(" __fun_async_await_");
        self.state.write(emit_name);
        self.state.write("(");
        self.state.write(payload_name);
        self.state.write("* __payload, __fun_thread_t __thr) {\n");
        self.state.write("  (void)__fun_thread_join(__thr);\n");
        if is_void {
          self.state.write("  free(__payload);\n");
        } else {
          self.state.write("  ");
          let rwt2 = self.write_type(*f.rtype);
          if rwt2.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          self.state.write(" __result = __payload->__result;\n");
          self.state.write("  free(__payload);\n");
          self.state.write("  return __result;\n");
        }
        self.state.write("}\n");

        // 5. Call helper -- what `await expr` actually lowers to (see
        // `emit_expr`'s `"await"` case). Degrades to a direct
        // synchronous call to `emit_name` on `malloc`/spawn failure,
        // matching the original exactly.
        self.state.write("static ");
        let cwt = self.write_type(*f.rtype);
        if cwt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.state.write(" __fun_async_call_");
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          let pwt = self.write_type(*arg_dtypes.get(ai));
          if pwt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          self.state.write(" ");
          self.state.write(arg_names.get(ai));
          ai = ai + 1;
        }
        if arg_names.len == 0 {
          self.state.write("void");
        }
        self.state.write(") {\n");
        self.state.write("  ");
        self.state.write(payload_name);
        self.state.write("* __payload = malloc(sizeof(");
        self.state.write(payload_name);
        self.state.write("));\n");
        self.state.write("  if (__payload == NULL) { ");
        if !is_void {
          self.state.write("return ");
        }
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          self.state.write(arg_names.get(ai));
          ai = ai + 1;
        }
        self.state.write(");");
        if is_void {
          self.state.write(" return;");
        }
        self.state.write(" }\n");
        ai = 0;
        for ai < arg_names.len {
          self.state.write("  __payload->__arg");
          self.state.write(format_num(ai));
          self.state.write(" = ");
          self.state.write(arg_names.get(ai));
          self.state.write(";\n");
          ai = ai + 1;
        }
        self.state.write("  __fun_thread_t __thr;\n");
        self.state.write("  int __rc = __fun_async_spawn_");
        self.state.write(emit_name);
        self.state.write("(__payload, &__thr);\n");
        self.state.write("  if (__rc != 0) { free(__payload); ");
        if !is_void {
          self.state.write("return ");
        }
        self.state.write(emit_name);
        self.state.write("(");
        ai = 0;
        for ai < arg_names.len {
          if ai > 0 {
            self.state.write(", ");
          }
          self.state.write(arg_names.get(ai));
          ai = ai + 1;
        }
        self.state.write(");");
        if is_void {
          self.state.write(" return;");
        }
        self.state.write(" }\n");
        if is_void {
          self.state.write("  __fun_async_await_");
          self.state.write(emit_name);
          self.state.write("(__payload, __thr);\n");
        } else {
          self.state.write("  return __fun_async_await_");
          self.state.write(emit_name);
          self.state.write("(__payload, __thr);\n");
        }
        self.state.write("}\n\n");

        // 6. Fork support -- only when `fork` is used ANYWHERE in the
        // program (not just on THIS function specifically; matches the
        // original's identical `if (self.uses_fork)` gate). Reuses the
        // SAME payload struct as above. The entry runs the function then
        // frees the payload itself (no join, no result capture -- the
        // result is discarded, `fork` is fire-and-forget); the call
        // helper enqueues onto the scheduler (`__fun_go`, see
        // `write_prelude`'s scheduler-runtime block) instead of
        // spawning+joining, with the same malloc-failure degrade-to-sync
        // fallback as the await call helper.
        if self.uses_fork {
          self.state.write("static void __fun_fork_entry_");
          self.state.write(emit_name);
          self.state.write("(void* __arg) {\n");
          self.state.write("  ");
          self.state.write(payload_name);
          self.state.write("* __payload = (");
          self.state.write(payload_name);
          self.state.write("*)__arg;\n");
          self.state.write("  ");
          self.state.write(emit_name);
          self.state.write("(");
          ai = 0;
          for ai < arg_names.len {
            if ai > 0 {
              self.state.write(", ");
            }
            self.state.write("__payload->__arg");
            self.state.write(format_num(ai));
            ai = ai + 1;
          }
          self.state.write(");\n");
          self.state.write("  free(__payload);\n");
          self.state.write("}\n");

          self.state.write("static void __fun_fork_call_");
          self.state.write(emit_name);
          self.state.write("(");
          ai = 0;
          for ai < arg_names.len {
            if ai > 0 {
              self.state.write(", ");
            }
            let fpt = self.write_type(*arg_dtypes.get(ai));
            if fpt.is_none() {
              ret .Some(CodegenErrorKind.UnsupportedNode);
            }
            self.state.write(" ");
            self.state.write(arg_names.get(ai));
            ai = ai + 1;
          }
          if arg_names.len == 0 {
            self.state.write("void");
          }
          self.state.write(") {\n");
          self.state.write("  ");
          self.state.write(payload_name);
          self.state.write("* __payload = malloc(sizeof(");
          self.state.write(payload_name);
          self.state.write("));\n");
          self.state.write("  if (__payload == NULL) { ");
          self.state.write(emit_name);
          self.state.write("(");
          ai = 0;
          for ai < arg_names.len {
            if ai > 0 {
              self.state.write(", ");
            }
            self.state.write(arg_names.get(ai));
            ai = ai + 1;
          }
          self.state.write("); return; }\n");
          ai = 0;
          for ai < arg_names.len {
            self.state.write("  __payload->__arg");
            self.state.write(format_num(ai));
            self.state.write(" = ");
            self.state.write(arg_names.get(ai));
            self.state.write(";\n");
            ai = ai + 1;
          }
          self.state.write("  __fun_go(__fun_fork_entry_");
          self.state.write(emit_name);
          self.state.write(", __payload);\n");
          self.state.write("}\n\n");
        }
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  emit_function_named(Node node, str emit_name) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        // A bodyless function (`;`-only, e.g. every `std.c.*` binding --
        // `malloc`, `pthread_mutex_init`, ...) is a signature-only
        // declaration, not something this codegen should emit C text
        // for at all: the REAL system header (already `#include`d by
        // `write_std_imports`) is the authoritative declaration, with
        // its own real parameter/return types -- this codegen's own
        // param types (`num`/`raw*`-derived) are a Fun-level ABI
        // convenience, not necessarily identical to the system header's
        // (e.g. `size_t` vs `int64_t`), so emitting a SECOND, competing
        // prototype/definition here caused either an outright
        // redefinition (an earlier version of this fix emitted an
        // empty-bodied `{ }` DEFINITION, shadowing libc's own `malloc`)
        // or a "conflicting types" error (a bare prototype with
        // different parameter types than `<pthread.h>`'s own). Skipping
        // entirely matches the original implementation's own
        // `write_function_prototype`/emission guards (`if (fnv.body ==
        // null) continue/return;`, throughout) exactly. The function's
        // signature is still fully known to THIS codegen's own
        // typechecking-adjacent bookkeeping via `register_function_
        // signatures` (called before any emission pass runs) --
        // skipping C-text emission here doesn't affect call-site
        // resolution anywhere.
        if !f.has_body {
          ret .None;
        }
        // An `async fun`/`async` method's OWN body is transpiled as a
        // completely ordinary C function below -- there's no state
        // machine/coroutine transform. All the "asyncness" lives in a
        // small set of WRAPPER functions generated around it (payload
        // struct + entry trampoline + spawn/await/call helpers, see
        // `emit_async_function_support`'s own doc comment) -- `await
        // expr` lowers to a call to the "call helper" (see `emit_expr`'s
        // `"await"` case), which runs THIS function on a dedicated OS
        // thread and joins it. `main` is excluded (matches the original
        // implementation exactly) -- nothing ever `await`s `main`.
        if f.is_async && !equals(emit_name, "main") {
          let aserr = self.emit_async_function_support(node, emit_name);
          if aserr.is_some() {
            ret aserr;
          }
        }
        // Fresh per function -- see `Codegen.local_names`'s doc comment;
        // this is deliberately NOT scoped to nested blocks (an inner `{
        // }` shadowing an outer local of the same name would get this
        // wrong), which is fine for now since nothing this slice's tests
        // exercise shadows a local.
        self.local_names.init(0);
        self.local_is_pointer.init(0);
        self.local_type_name.init(0);
        self.local_dtype.init(0);
        self.local_multidim_names.init(0);
        self.local_multidim_roots.init(0);
        self.local_multidim_depths.init(0);
        // Fresh per function too -- see `Codegen.defer_stack`'s doc
        // comment; a previous function's leftover pending defers (or
        // frame markers) must never bleed into this one.
        self.defer_stack.init(0);
        self.defer_scope_starts.init(0);
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        // `write_type` always writes the return type's OWN naive C
        // spelling directly to `self.state` as a side effect of
        // resolving it -- for `main`, that text must never reach the
        // real output (its own written return type is always the
        // literal `int`, forced below), so it's captured into a
        // throwaway scratch buffer instead when this is `main`, and
        // simply discarded once `rt` (the RESOLVED NAME, still needed
        // for `current_fn_rtype_name`/`_dt` bookkeeping) is in hand.
        // `hoist_insert_pos` (if set) is a position measured against
        // the OUTER, now-swapped-away buffer -- suspending it for the
        // duration of this swap, same as every OTHER scratch-buffer
        // swap in this file, keeps a NESTED hoisted emission triggered
        // from inside `write_type` (e.g. `main`'s declared return type
        // is itself a generic enum instantiation, first use) from
        // splicing at a stale position into THIS tiny scratch buffer
        // instead of the real one -- confirmed via a real crash
        // (`emit_hoisted` -> `StringBuilder.append` -> null deref) when
        // this swap didn't suspend it.
        bin is_main = equals(emit_name, "main");
        CodegenState rtype_scratch = codegen_state_new();
        CodegenState* saved_rtype_state = self.state;
        let saved_rtype_hoist_pos = self.hoist_insert_pos;
        if is_main {
          self.state = &rtype_scratch;
          self.hoist_insert_pos = .None;
        }
        let rt = self.write_type(*f.rtype);
        if is_main {
          self.state = saved_rtype_state;
          self.hoist_insert_pos = saved_rtype_hoist_pos;
        }
        if rt.is_none() {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        self.current_fn_rtype_name = rt.unwrap();
        self.current_fn_rtype_dt = .Some(self.resolve_type_subst(*f.rtype));
        // C's own `main` MUST be `int main(void)`, `int main(int argc,
        // char** argv)`, or `int main(int argc, char** argv, char**
        // envp)` -- never anything else, regardless of what THIS
        // function's own Fun-level signature says (`num`/`str[] args`,
        // the surface this language exposes). `self.current_fn_rtype_
        // name`/`_dt` above are still set from the REAL Fun-declared
        // return type (needed for `ret <shorthand>;`/local-inference
        // bookkeeping inside the body) -- only the WRITTEN C signature
        // is overridden here. A bare `int64_t`-returning `return expr;`
        // inside an `int`-declared function is valid C (implicit
        // narrowing), so the body itself needs no special handling.
        // Mirrors the original transpiler's own identical `main` rules
        // exactly: no params emits the standard `argc`/`argv` pair;
        // exactly one `str[] name` param keeps that name but still
        // takes real OS argv (`str[] args` prints as `char* args[]`,
        // valid for argv); anything else (rare in practice) emits the
        // user's own params verbatim. Found via a real stage-2 self-
        // compilation C error ("first parameter of 'main' must be of
        // type 'int'") -- selfhost never ported this special-casing at
        // all, so `main`'s own params/return type were written like
        // any other ordinary function's.
        bin main_is_single_str_array = false;
        if is_main && f.has_args && f.args.len == 1 {
          let main_arg0 = f.args.get(0);
          fit main_arg0.kind {
            .Variable(v) -> {
              if equals(v.var_type.type_str, "str") && v.var_type.is_array {
                main_is_single_str_array = true;
              }
            }
            _ -> {}
          }
        }
        if is_main {
          self.state.write("int");
        }
        self.state.write(" ");
        self.state.write(emit_name);
        self.state.write("(");
        if is_main && ( !f.has_args || f.args.len == 0) {
          self.state.write("int argc, char** argv");
        } elif is_main && main_is_single_str_array {
          self.state.write("int argc, ");
          let margerr = self.emit_function_param(*f.args.get(0));
          if margerr.is_some() {
            ret margerr;
          }
        } elif f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let aerr = self.emit_function_param(*arg);
            if aerr.is_some() {
              ret aerr;
            }
          }
        } elif !f.is_variadic {
          self.state.write("void");
        }
        // A variadic function (`fun f(str fmt, ...)`) gets TWO extra
        // trailing C params beyond its own named ones: `const char*
        // __fun_vtags` (a per-call type-tag string, one char per vararg,
        // NUL-terminated -- built at each CALL site, see `emit_call`'s
        // own doc comment) then the real `...`. Matches the original
        // transpiler's own identical signature shape exactly.
        if f.is_variadic {
          if f.has_args && f.args.len > 0 {
            self.state.write(", ");
          }
          self.state.write("const char* __fun_vtags, ...");
        }
        // A bodyless function (`;`-only, e.g. every `std.c.*` binding --
        // `malloc`, `pthread_mutex_init`, ...) is a signature-only
        // declaration, not a definition: it must emit as a bare
        // prototype (`TYPE name(params);`), relying on the real C
        // library's own definition being linked in separately. Emitting
        // `{ }` here (an empty-bodied DEFINITION) previously shadowed
        // libc's own `malloc`/`calloc`/`realloc`/`free` with conflicting,
        // no-op redefinitions -- a real link/compile error the moment
        // any program actually compiled+ran through this codegen (not
        // just transpiled to C text), first caught trying to run a
        // channel-using program end to end.
        if !f.has_body {
          self.state.write(");\n");
          ret .None;
        }
        self.state.write(") {\n");
        self.state.indent_level = self.state.indent_level + 1;
        // A variadic function's own body always starts by unpacking its
        // real varargs (via `__fun_vtags`/C's own `va_arg`) into a
        // `Vec<str>` named `vargs` -- `vargs` is a synthetic, scope-
        // registered-but-never-declared local the PARSER already
        // recognizes (see `parser.fn`'s own `_parse_impl_method`/
        // function-parsing doc comment on `is_variadic`), so the body
        // can read it by name; this is what actually materializes it.
        // Every vararg gets STRINGIFIED (via `fmt_num`/`fmt_dec`/
        // `fmt_bin`/`fmt_chr`/`fmt_raw`, matching each `__fun_tag`
        // character `emit_call`'s own call-site tagging writes) rather
        // than kept as its own native C type -- `vargs` is always a
        // `Vec<str>`, matching `format_impl`'s own real body (a
        // placeholder-substitution loop over `{str}`-shaped tokens, no
        // per-type dispatch of its own). Mirrors the original
        // transpiler's own identical shim exactly. No `Display`-trait
        // dispatch for a non-builtin vararg value (the original's OWN
        // fuller version has one) -- deliberately narrow for this
        // slice: every real vararg reaching this codegen's own call
        // graph is a builtin scalar (`str`/`num`/`chr`), confirmed by
        // inspection.
        if f.is_variadic {
          self.state.write_indent();
          self.state.write("Vec__str vargs;\n");
          self.state.write_indent();
          self.state.write("vargs.len = 0; vargs.cap = 0; vargs.data = NULL;\n");
          self.state.write_indent();
          self.state.write("if (__fun_vtags) {\n");
          self.state.indent_level = self.state.indent_level + 1;
          self.state.write_indent();
          self.state.write("size_t __fun_vc = 0; while (__fun_vtags[__fun_vc] != 0) { __fun_vc++; }\n");
          self.state.write_indent();
          self.state.write("vargs.len = (int64_t)__fun_vc; vargs.cap = (int64_t)__fun_vc;\n");
          self.state.write_indent();
          self.state.write("if (__fun_vc > 0) { vargs.data = (char**)malloc(sizeof(char*) * __fun_vc); }\n");
          self.state.write_indent();
          self.state.write("va_list __fun_ap; va_start(__fun_ap, __fun_vtags);\n");
          self.state.write_indent();
          self.state.write("size_t __fun_vi = 0; while (__fun_vi < __fun_vc) {\n");
          self.state.indent_level = self.state.indent_level + 1;
          self.state.write_indent();
          self.state.write("char __fun_tagc = __fun_vtags[__fun_vi];\n");
          self.state.write_indent();
          self.state.write("switch (__fun_tagc) {\n");
          self.state.indent_level = self.state.indent_level + 1;
          self.state.write_indent();
          self.state.write("case 's': vargs.data[__fun_vi] = va_arg(__fun_ap, char*); break;\n");
          self.state.write_indent();
          self.state.write("case 'n': vargs.data[__fun_vi] = fmt_num((int64_t)va_arg(__fun_ap, long long)); break;\n");
          self.state.write_indent();
          self.state.write("case 'd': vargs.data[__fun_vi] = fmt_dec((double)va_arg(__fun_ap, double)); break;\n");
          self.state.write_indent();
          self.state.write("case 'b': vargs.data[__fun_vi] = fmt_bin((bool)va_arg(__fun_ap, int)); break;\n");
          self.state.write_indent();
          self.state.write("case 'c': vargs.data[__fun_vi] = fmt_chr((char)va_arg(__fun_ap, int)); break;\n");
          self.state.write_indent();
          self.state.write("case 'p': vargs.data[__fun_vi] = fmt_raw((void*)va_arg(__fun_ap, void*)); break;\n");
          self.state.write_indent();
          self.state.write("default: vargs.data[__fun_vi] = fmt_raw((void*)va_arg(__fun_ap, void*)); break;\n");
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}\n");
          self.state.write_indent();
          self.state.write("__fun_vi = __fun_vi + 1;\n");
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}\n");
          self.state.write_indent();
          self.state.write("va_end(__fun_ap);\n");
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}\n");
          // Recorded as a known LOCAL so the body's own reads of `vargs`
          // (`vargs.len`, `vargs.get(i)`, ...) resolve like any other
          // `Vec<str>` value would -- `resolve_type_name` ensures `Vec__
          // str` is actually instantiated regardless of program order
          // (usually already is, `Vec<str>` being ubiquitous, but not
          // guaranteed).
          DataType* vargs_str_arg = malloc(sizeof(DataType));
          *vargs_str_arg = dtype_new();
          vargs_str_arg.type_str = "str";
          DataType vargs_dt = dtype_new();
          vargs_dt.type_str = "Vec";
          vargs_dt.generic_args.push(vargs_str_arg);
          self.resolve_type_name(vargs_dt);
          self.record_local_typed("vargs", "Vec__str", false, vargs_dt);
        }
        let saved_in_main = self.in_main;
        self.in_main = is_main;
        let berr = self.emit_body(*f.body);
        self.in_main = saved_in_main;
        if berr.is_some() {
          ret berr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Companion to `ensure_plain_type_emitted` (below), for a by-value
  // field whose type is a QUIRK rather than a plain compound/enum --
  // `emit_quirk_vtable_machinery` (the only thing that ever emits a
  // quirk's own vtable struct/fat-pointer typedef) normally only runs
  // once per CONCRETE impl, in `pub transpile`'s own late, per-impl
  // pass, in that impl's OWN source position -- too late for a plain
  // compound embedding the quirk BY VALUE earlier in the file (`compound
  // Holder { AsyncCounter q; }`, `examples/advanced/async_quirk_await_
  // nested_receiver.fn`'s own real body), which needs the vtable TYPE
  // complete by the time `Holder`'s own body is emitted. Finds the
  // FIRST CONCRETE (non-generic) impl of `type_name` anywhere in the
  // program and triggers its machinery early instead -- safe to call
  // regardless of whether that impl's own turn in the later pass has
  // already happened or not, via `Codegen.emitted_quirk_impl_vtables`'s
  // own memoization (and the vtable STRUCT itself is identical no
  // matter WHICH concrete impl of the same quirk builds it, so it
  // doesn't matter which one is found first when several exist). A
  // no-op when `type_name` isn't a quirk with any concrete impl at all
  // -- a builtin scalar, a plain compound/enum (already handled by
  // `ensure_plain_type_emitted` itself), or a quirk with only GENERIC
  // impls (no single vtable signature to speak of, same skip `emit_
  // quirk_vtable_machinery` itself already applies).
  ensure_quirk_vtable_emitted_early(str type_name) Option<CodegenErrorKind> {
    for n : self.all_nodes {
      fit n.kind {
        .Impl(i) -> {
          if i.has_quirk_name && equals(i.quirk_name, type_name) && !i.has_type_params {
            ret self.emit_quirk_vtable_machinery(n);
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Ensures a PLAIN (non-generic) compound or enum named `type_name` is
  // fully emitted, recursively emitting any OTHER plain compound/enum
  // it embeds BY VALUE first. `pub transpile` previously emitted every
  // plain enum, then every plain compound, in two flat passes over the
  // whole program -- correct only when EVERY by-value dependency runs
  // in that one direction. Real stdlib code has both directions in
  // different files (found via the stage-2 self-compilation attempt --
  // codegen succeeding completely, but the resulting C failing with
  // "field has incomplete type"): `selfhost/ast/ast.fn`'s own tagged-
  // union `NodeKind` embeds compound payloads like `ExprNode`/
  // `VariableNode` BY VALUE, needing compounds-before-enums, while
  // `std/io.fn`'s `Sink` enum holds a `File` compound by value the SAME
  // way, but `std/error.fn`'s `Error` compound holds an `ErrorKind`
  // enum by value -- needing the OPPOSITE order in that file. Neither
  // flat pass order can satisfy both at once; this replaces both passes
  // with the same lazy, dependency-triggered, memoized emission generic
  // types already get (`ensure_compound_instantiated`/`ensure_enum_
  // instantiated`), just keyed by a PLAIN type's own bare name instead
  // of a mangled one.
  // 
  // A BY-POINTER field/payload (`Node* left;`) is exempt -- it only
  // ever needs the forward-declared struct NAME (already handled,
  // unconditionally and up front, by `pub transpile`'s own forward-
  // declare pass), never a complete type, so recursing into it here
  // would just be extra work for no reason (and could misfire on a
  // genuinely self-referential type, `Node` containing `Node*`
  // children, which is completely fine in C but would loop forever if
  // treated as a by-value dependency).
  // 
  // `.None` (success, not an error) when `type_name` isn't a known
  // plain compound/enum in `nodes` at all -- a builtin scalar, a
  // generic template's own bare name, or a name this codegen doesn't
  // otherwise recognize. `nodes` is searched by NAME each call (a
  // linear scan, matching this file's own established style
  // elsewhere) rather than threading a separate name->node lookup
  // table through the recursion.
  ensure_plain_type_emitted(str type_name) Option<CodegenErrorKind> {
    num ei = 0;
    for ei < self.emitted_plain_types.len {
      if equals(self.emitted_plain_types.get(ei), type_name) {
        ret .None;
      }
      ei = ei + 1;
    }
    for n : self.all_nodes {
      fit n.kind {
        .Compound(c) -> {
          if equals(c.name, type_name) && !c.has_type_params {
            // Pushed BEFORE recursing (not after emission finishes) --
            // see `Codegen.emitted_plain_types`'s own doc comment for
            // why: a genuine cycle (impossible to lay out in C) is
            // caught as "already emitted" instead of recursing forever.
            self.emitted_plain_types.push(type_name);
            for f : c.fields {
              if !dtype_is_pointer(*f.dtype) && !dtype_is_array_as_pointer(*f.dtype) {
                let fderr = self.ensure_plain_type_emitted(f.dtype.type_str);
                if fderr.is_some() {
                  ret fderr;
                }
                // A by-value field whose type is a QUIRK (`compound
                // Holder { AsyncCounter q; }`, `examples/advanced/
                // async_quirk_await_nested_receiver.fn`'s own real
                // body) needs the SAME early-emission treatment, but
                // `ensure_plain_type_emitted` just above never finds
                // anything for it at all (a quirk is neither a
                // `.Compound` nor an `.Enum` node) -- see `ensure_quirk_
                // vtable_emitted_early`'s own doc comment.
                let fqerr = self.ensure_quirk_vtable_emitted_early(f.dtype.type_str);
                if fqerr.is_some() {
                  ret fqerr;
                }
                // A by-value field that's ITSELF a generic instantiation
                // (`Vec<DataType*> generic_args;` -- `f.dtype.type_str` is
                // just the bare "Vec", which never matches a plain type
                // above) hides its own dependency inside `generic_args`:
                // the instantiation's monomorphized methods may pointer-
                // subscript a field/param typed as a CONCRETE argument
                // (`self.data[i]` on `DataType*`), which needs that
                // argument's COMPLETE type, not just a forward decl. This
                // must run HERE, before `self.emit_compound(n)` below
                // starts writing THIS type's own body -- doing it later,
                // as a side effect of `write_type` resolving this same
                // field mid-write (tried first, reverted), spliced a
                // nested type's full definition into the MIDDLE of this
                // type's still-open struct, since nothing protects
                // `self.state` from a fresh top-level-style emission
                // triggered deep inside an already-started one. Skips a
                // FURTHER-generic argument (`Vec<Vec<T>*>`) -- no known
                // case needs recursing past one level yet.
                for garg : f.dtype.generic_args {
                  if garg.generic_args.len == 0 {
                    let gerr = self.ensure_plain_type_emitted(garg.type_str);
                    if gerr.is_some() {
                      ret gerr;
                    }
                  }
                }
              }
            }
            self.hoist_insert_pos = .Some(self.state.out.len());
            ret self.emit_compound(n);
          }
        }
        .Enum(e) -> {
          if equals(e.name, type_name) && !e.has_type_params {
            self.emitted_plain_types.push(type_name);
            bin is_tagged_union = false;
            for v : e.variants {
              if v.has_payload && v.payload.len > 0 {
                is_tagged_union = true;
              }
            }
            if is_tagged_union {
              for v : e.variants {
                for pt : v.payload {
                  if !dtype_is_pointer(*pt) {
                    let pderr = self.ensure_plain_type_emitted(pt.type_str);
                    if pderr.is_some() {
                      ret pderr;
                    }
                    // See the identical `f.dtype.generic_args` loop in
                    // the `.Compound` branch above for why this matters.
                    for garg : pt.generic_args {
                      if garg.generic_args.len == 0 {
                        let gerr = self.ensure_plain_type_emitted(garg.type_str);
                        if gerr.is_some() {
                          ret gerr;
                        }
                      }
                    }
                  }
                }
              }
            }
            self.hoist_insert_pos = .Some(self.state.out.len());
            ret self.emit_enum(n);
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Emits a non-generic `enum Name { variants }` declaration -- either a
  // plain C enum typedef (`typedef enum Name { Name_Variant1,
  // Name_Variant2 = <val>, ... } Name;`, single underscore, distinct
  // from the double-underscore `Type__method` impl-method mangling) when
  // no variant carries a payload, or the tagged-union discriminant-
  // enum-plus-struct/union layout (see `emit_tagged_union_enum`'s doc
  // comment) when at least one does. Also registers the enum
  // (`record_enum`) so a later `EnumName.Variant` qualified access
  // resolves to the right constant -- see `emit_field_access`'s doc
  // comment.
  // 
  // A GENERIC enum (`has_type_params`, e.g. `enum Option<T> { ... }`) is
  // instead only RECORDED as a template (see
  // `Codegen.generic_enum_names`'s doc comment) -- never emitted
  // directly itself, matching `emit_compound`'s own rule for a generic
  // compound: only a concrete monomorphized specialization
  // (`ensure_enum_instantiated`) is ever actually emitted.
  emit_enum(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Enum(e) -> {
        if e.has_type_params {
          Vec<GenericEnumVariantTemplate> variant_templates;
          variant_templates.init(0);
          for v : e.variants {
            GenericEnumVariantTemplate vt;
            vt.name = v.name;
            vt.has_payload = v.has_payload && v.payload.len > 0;
            Vec<str> payload_type_strs;
            payload_type_strs.init(0);
            Vec<bin> payload_is_pointer;
            payload_is_pointer.init(0);
            for pt : v.payload {
              payload_type_strs.push(pt.type_str);
              payload_is_pointer.push(dtype_is_pointer(*pt));
            }
            vt.payload_type_strs = payload_type_strs;
            vt.payload_is_pointer = payload_is_pointer;
            variant_templates.push(vt);
          }
          self.generic_enum_names.push(e.name);
          self.generic_enum_type_params.push(e.type_params);
          self.generic_enum_variants.push(variant_templates);
          ret .None;
        }
        bin is_tagged_union = false;
        for v : e.variants {
          if v.has_payload && v.payload.len > 0 {
            is_tagged_union = true;
          }
        }

        Vec<str> variant_names;
        variant_names.init(0);
        for v : e.variants {
          variant_names.push(v.name);
        }

        if is_tagged_union {
          self.emit_tagged_union_enum(e);
        } else {
          self.state.write("typedef enum ");
          self.state.write(e.name);
          self.state.write(" {\n");
          for v : e.variants {
            self.state.write("  ");
            self.state.write(e.name);
            self.state.write("_");
            self.state.write(v.name);
            if v.has_value {
              self.state.write(" = ");
              self.state.write(format_num(v.value));
            }
            self.state.write(",\n");
          }
          self.state.write("} ");
          self.state.write(e.name);
          self.state.write(";\n\n");
        }
        self.record_enum(e.name, variant_names, is_tagged_union);
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a data-carrying (tagged-union) enum as the original's own
  // layout:
  // typedef enum Name_tag { Name_Variant1, Name_Variant2, ... } Name_tag;
  // typedef struct Name {
  // Name_tag tag;
  // union {
  // struct { <type> _0; <type> _1; ... } Variant1;
  // ...
  // } payload;
  // } Name;
  // A payload-less variant occupies a tag slot but no union member.
  // Payload fields are named positionally (`_0`, `_1`, ...), matching
  // `emit_enum_variant_construction`'s own field names.
  emit_tagged_union_enum(EnumDeclNode e) {
    self.state.write("typedef enum ");
    self.state.write(e.name);
    self.state.write("_tag {\n");
    for v : e.variants {
      self.state.write("  ");
      self.state.write(e.name);
      self.state.write("_");
      self.state.write(v.name);
      self.state.write(",\n");
    }
    self.state.write("} ");
    self.state.write(e.name);
    self.state.write("_tag;\n");

    self.state.write("typedef struct ");
    self.state.write(e.name);
    self.state.write(" {\n  ");
    self.state.write(e.name);
    self.state.write("_tag tag;\n  union {\n");
    for v : e.variants {
      if v.has_payload && v.payload.len > 0 {
        self.state.write("    struct { ");
        num i = 0;
        Vec<str> payload_type_names;
        payload_type_names.init(0);
        Vec<bin> payload_is_pointer;
        payload_is_pointer.init(0);
        for pt : v.payload {
          let wt = self.write_type(*pt);
          if wt.is_some() {
            payload_type_names.push(wt.unwrap());
          } else {
            payload_type_names.push("");
          }
          payload_is_pointer.push(dtype_is_pointer(self.resolve_type_subst(*pt)));
          self.state.write(" _");
          self.state.write(format_num(i));
          self.state.write("; ");
          i = i + 1;
        }
        self.state.write("} ");
        self.state.write(v.name);
        self.state.write(";\n");
        self.record_enum_variant_payload(e.name, v.name, payload_type_names, payload_is_pointer);
      }
    }
    self.state.write("  } payload;\n} ");
    self.state.write(e.name);
    self.state.write(";\n\n");
  }

  // Emits a non-generic `compound Name { fields }` declaration as a C
  // struct typedef: `typedef struct Name { <type> <field>; ... } Name;`.
  // A GENERIC compound (`has_type_params`) is instead only RECORDED as a
  // template (see `Codegen.generic_compound_names`'s doc comment) --
  // never emitted directly itself, matching the original's own rule
  // that only a concrete monomorphized specialization of a generic
  // template is ever emitted (see `ensure_compound_instantiated`).
  // 
  // Deliberately simplified from the original for this slice: no
  // forward declaration and no dependency-ordering pass for by-value
  // nested compounds either (the original topologically sorts these,
  // treating generic instantiations and plain compounds/enums as one
  // unified worklist -- see `emit_generic_compound_specializations`'s
  // own "topological pass" comment in `modules/codegen/transpiler.zig`
  // around its `remaining_specs`/`remaining_enum_specs` worklists) --
  // this assumes source order already satisfies it, same as a plain
  // sequential C struct-after-struct listing would require.
  // 
  // CONFIRMED BROKEN for a real multi-file program (found via the
  // self-hosted driver's own first end-to-end run, `selfhost/cli/
  // main.fn`, compiling something as simple as `imp std.io;`): `pub
  // transpile` emits ALL enums in one pass, THEN all plain compounds in
  // a separate one (see `pub transpile`'s own doc comment) -- but
  // stdlib's own types depend on each other in BOTH directions
  // (`std.io`'s `Sink` enum holds a `File` compound BY VALUE in one
  // variant, needing compounds-before-enums; `std.error`'s `Error`
  // compound holds an `ErrorKind` enum BY VALUE as a field, needing
  // enums-before-compounds) -- so neither pass ORDER is universally
  // safe, and a plain two-pass swap just trades one break for the
  // other. A real fix needs the SAME lazy, first-reference-triggers-
  // emission mechanism generic types already get via
  // `ensure_compound_instantiated`/`ensure_enum_instantiated`, extended
  // to cover plain (non-generic) compounds/enums too -- not a bigger
  // hard-coded pass ordering. Left as a known, documented gap rather
  // than a quick patch. An UNSIZED array field (`T[]`, e.g. `Channel<T>`
  // 's own `data` field) IS handled -- see `dtype_is_array_as_pointer`'s
  // doc comment -- but a SIZED array (`T[3]`) still isn't.
  emit_compound(Node node) Option<CodegenErrorKind> {
    if self.is_std_c_signature_node(node) {
      ret .None;
    }
    fit node.kind {
      .Compound(c) -> {
        Vec<str> field_names;
        field_names.init(0);
        Vec<str> field_type_names;
        field_type_names.init(0);
        Vec<bin> field_is_pointer;
        field_is_pointer.init(0);

        if c.has_type_params {
          Vec<DataType*> field_template_dtypes;
          field_template_dtypes.init(0);
          for f : c.fields {
            field_names.push(f.name);
            field_type_names.push(f.dtype.type_str);
            field_is_pointer.push(dtype_is_pointer(*f.dtype) || dtype_is_array_as_pointer(*f.dtype));
            field_template_dtypes.push(f.dtype);
          }
          self.generic_compound_names.push(c.name);
          self.generic_compound_type_params.push(c.type_params);
          self.generic_compound_field_names.push(field_names);
          self.generic_compound_field_type_names.push(field_type_names);
          self.generic_compound_field_is_pointer.push(field_is_pointer);
          self.generic_compound_field_dtypes.push(field_template_dtypes);
          ret .None;
        }

        Vec<DataType> field_dtypes;
        field_dtypes.init(0);
        self.state.write("typedef struct ");
        self.state.write(c.name);
        self.state.write(" {\n");
        for f : c.fields {
          self.state.write("  ");
          let wt = self.write_type(*f.dtype);
          if wt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          bin fld_ptr = dtype_is_pointer(*f.dtype);
          bin fld_arr_ptr = dtype_is_array_as_pointer(*f.dtype);
          if fld_arr_ptr && !fld_ptr {
            self.state.write("*");
          }
          self.state.write(" ");
          self.state.write(f.name);
          self.state.write(";\n");
          field_names.push(f.name);
          field_type_names.push(wt.unwrap());
          field_is_pointer.push(fld_ptr || fld_arr_ptr);
          field_dtypes.push(self.resolve_type_subst(*f.dtype));
        }
        self.state.write("} ");
        self.state.write(c.name);
        self.state.write(";\n\n");
        self.record_compound_typed(
          c.name,
          field_names,
          field_type_names,
          field_is_pointer,
          field_dtypes
        );
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a top-level `const`/`let` declaration (e.g. `pub const num
  // CHANNEL_RC_NULL_ARG = -1;` in `std/channel.fn`) as a C file-scope
  // global. Deliberately does NOT reuse the local-`Variable` statement
  // case's indent/`record_local*` bookkeeping -- there's no enclosing
  // function scope at this point, and no later codegen pass currently
  // needs a top-level const's inferred type recorded anywhere. `pub
  // transpile` runs this pass BEFORE impls/functions so a global used
  // inside any function/method body already has its C declaration
  // textually earlier in the file (selfhost has no forward-declaration
  // pass for globals the way the original implementation does).
  emit_global_variable(Node node) Option<CodegenErrorKind> {
    if self.is_std_c_signature_node(node) {
      ret .None;
    }
    fit node.kind {
      .Variable(v) -> {
        bin is_let = equals(v.var_type.type_str, "__let_infer__");
        // `pub transpile`'s own top-level pass ordering emits every
        // GLOBAL before any plain compound/enum's own full body (see its
        // own doc comment: "constants are simple literals with no
        // compound/enum type dependency of their own" -- true when this
        // pass was written, no longer true for a global whose OWN
        // declared type IS a plain compound/enum, `Counter[] counters =
        // [Counter{...}, Counter{...}];`, `examples/advanced/async_
        // quirk_await_indexed_receiver.fn`'s own real body). Ensures
        // `Counter`'s full body is emitted FIRST (a harmless no-op, via
        // `Codegen.emitted_plain_types`'s own memoization, for a builtin
        // scalar/generic template's bare name/anything already emitted)
        // -- without this, `counters` referenced `Counter` as a COMPLETE
        // type (an array element, and each `(Counter){...}` compound-
        // literal cast) before it existed as anything more than a bare
        // forward-declared name, "incomplete type".
        let gt_err = self.ensure_plain_type_emitted(v.var_type.type_str);
        if gt_err.is_some() {
          ret gt_err;
        }
        // An UNSIZED array GLOBAL (`T[] buf = malloc(...);`) decays to a
        // pointer, same reasoning as `emit_statement`'s identical LOCAL
        // check -- but only when it's NOT initialized with a real
        // bracket array literal (which stays a genuine, fixed-size
        // global array).
        bin arr_as_ptr = false;
        if !is_let {
          arr_as_ptr = dtype_is_array_as_pointer(*v.var_type);
          if arr_as_ptr && v.has_val {
            fit v.val.kind {
              .Bracket(_) -> { arr_as_ptr = false; }
              _ -> {}
            }
          }
        }
        bin const_is_ptr_binding = !is_let && (dtype_is_pointer(*v.var_type) || arr_as_ptr);
        if v.is_const && !const_is_ptr_binding {
          self.state.write("const ");
        }
        if is_let {
          self.state.write("__auto_type");
        } else {
          let wt = self.write_type(*v.var_type);
          if wt.is_none() {
            ret .Some(CodegenErrorKind.UnsupportedNode);
          }
          if arr_as_ptr {
            self.state.write("*");
          }
        }
        if v.is_const && const_is_ptr_binding {
          self.state.write(" const");
        }
        self.state.write(" ");
        self.state.write(v.name);
        // An array declarator (`[24]`, `[]`) lands AFTER the name in C,
        // same as `emit_statement`'s identical LOCAL handling -- missing
        // here entirely until now, so a global array (`Counter[]
        // counters = [Counter{...}, Counter{...}];`, `examples/advanced/
        // async_quirk_await_indexed_receiver.fn`'s own real body) lost
        // its array-ness completely, declaring what looked like a single
        // bare `Counter` holding a brace-list of TWO structs -- invalid
        // C, and (since the SAME bug meant the struct's own full
        // typedef also hadn't been forward-declared as an array element
        // yet at that point) "variable has incomplete type" on top of
        // it. Deliberately narrower than the local case: no `let`-
        // inferred bracket-literal special handling (a bare `let arr =
        // [...]` GLOBAL isn't exercised by any real example yet) --
        // only an EXPLICITLY array-typed global, which is what's
        // actually needed here.
        if !is_let && !arr_as_ptr && v.var_type.is_array {
          if v.var_type.array_brackets.len > 0 {
            for bnode : v.var_type.array_brackets {
              self.state.write("[");
              fit bnode.kind {
                .Bracket(inner) -> {
                  let berr = self.emit_expr(*inner);
                  if berr.is_some() {
                    ret berr;
                  }
                }
                _ -> {
                  let berr = self.emit_expr(*bnode);
                  if berr.is_some() {
                    ret berr;
                  }
                }
              }
              self.state.write("]");
            }
          } elif v.var_type.array_depth > 1 {
            self.state.write("[]");
            bin wrote_inner_dims = false;
            if v.has_val {
              fit v.val.kind {
                .Bracket(_) -> {
                  self.emit_multidim_inner_declarators(v.val, v.var_type.array_depth - 1);
                  wrote_inner_dims = true;
                }
                _ -> {}
              }
            }
            if !wrote_inner_dims {
              num mdim_d = 1;
              for mdim_d < v.var_type.array_depth {
                self.state.write("[]");
                mdim_d = mdim_d + 1;
              }
            }
          } else {
            self.state.write("[]");
          }
        }
        if v.has_val {
          self.state.write(" = ");
          // See `Codegen.in_array_initializer`'s doc comment: a top-level
          // global's own initializer is a declaration context too.
          let prev_arr_init = self.in_array_initializer;
          self.in_array_initializer = true;
          let verr = self.emit_expr(*v.val);
          self.in_array_initializer = prev_arr_init;
          if verr.is_some() {
            ret verr;
          }
        }
        self.state.write(";\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Pre-registers every PLAIN top-level function's name and its own
  // parameters' declared types (see `Codegen.function_names`'s doc
  // comment), WITHOUT emitting any C -- its own whole-program pass, run
  // before ANY function body is emitted, so a call to a function defined
  // LATER in source order still resolves (same reasoning as
  // `register_impl_methods`'s own separate pass). A generic function
  // (`f.has_type_params`) is instead only RECORDED whole (see
  // `Codegen.generic_function_templates`'s doc comment) -- monomorphized
  // lazily, from its own CALL site, by
  // `maybe_instantiate_generic_function`.
  register_function_signatures(Vec<Node> nodes) {
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          if f.has_type_params {
            self.generic_function_templates.push(n);
          } else {
            Vec<DataType*> param_types;
            param_types.init(0);
            // Each param's own default VALUE expression (`nil` when it
            // has none) -- see `Codegen.function_default_values`'s own
            // doc comment.
            Vec<Node*> default_values;
            default_values.init(0);
            if f.has_args {
              for arg : f.args {
                fit arg.kind {
                  .Variable(v) -> {
                    param_types.push(v.var_type);
                    if v.has_val {
                      default_values.push(v.val);
                    } else {
                      default_values.push(nil);
                    }
                  }
                  _ -> {}
                }
              }
            }
            self.function_names.push(f.name);
            self.function_param_types.push(param_types);
            self.function_default_values.push(default_values);
            // Only a Fun-DEFINED variadic function (`f.has_body`) gets
            // the `__fun_vtags`-tag-array call-site treatment (see
            // `emit_call`'s own doc comment) -- a BODYLESS variadic
            // binding (`std.c.io`'s own `pub fun snprintf(str dst, num
            // n, str fmt, ...) num;`, e.g.) is a REAL C variadic
            // function, expecting ORDINARY C varargs, with no `__fun_
            // vtags` param and no tag array at all. Marking it variadic
            // here too made `format_dec`'s own `snprintf(buf, 48, fmt,
            // d)` call pass a tag-array pointer where `%f` expects a
            // `double`, silently reading garbage (0.0) instead of the
            // real value -- found via a real stage-2-compiled-by-itself
            // divergence (every decimal literal came out as 0.0 one
            // generation further into self-hosting, even though the
            // exact same source compiles correctly one generation
            // earlier).
            self.function_is_variadic.push(f.is_variadic && f.has_body);
            if f.has_rtype {
              self.function_rtypes.push(f.rtype);
            } else {
              self.function_rtypes.push(nil);
            }
          }
        }
        _ -> {}
      }
    }
  }

  // Looks up `fn_name`'s own FIXED (named, non-`...`) argument count when
  // it's a known, registered VARIADIC plain function -- see `emit_call`'s
  // own doc comment for how a call site uses this. `.None` means either
  // the function isn't registered at all, or it IS but isn't variadic
  // (an ordinary call, no special handling needed).
  lookup_function_variadic_fixed_len(str fn_name) Option<num> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        if self.function_is_variadic.get(i) {
          ret .Some(self.function_param_types.get(i).len);
        }
        ret .None;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `fn_name`'s OWN declared return type -- see
  // `Codegen.function_rtypes`'s doc comment. `.None` means the function
  // isn't registered (unknown, a method, or a generic function).
  lookup_function_rtype(str fn_name) Option<DataType*> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        let rt = self.function_rtypes.get(i);
        if rt == nil {
          ret .None;
        }
        ret .Some(rt);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up whether `bare_name`, referenced through `alias` (`two.pick(
  // )` -> `alias = "two"`, `bare_name = "pick"`), was renamed at merge
  // time due to a collision with a DIFFERENTLY-aliased import's own
  // same-named function -- see `Codegen.alias_rename_keys`'s own doc
  // comment. `.None` means no such rename happened (the common case --
  // callers fall back to the bare name unqualified).
  lookup_alias_rename(str alias, str bare_name) Option<str> {
    str key = format("{str}::{str}", alias, bare_name);
    num i = 0;
    for i < self.alias_rename_keys.len {
      if equals(self.alias_rename_keys.get(i), key) {
        ret .Some(self.alias_rename_targets.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Infers a call ARGUMENT expression's own bare type name, for binding
  // one of a generic function's type parameters from its actual call
  // site (see `maybe_instantiate_generic_function`'s doc comment) --
  // deliberately narrow, the same "already fully explicit, no real
  // inference" spirit as everywhere else in this file: a known LOCAL
  // (its own recorded type), a call to an already-registered PLAIN
  // function (its own declared return type -- `err_kind`'s real call
  // site infers `T` from `token_zero()` this way), a literal (num/dec/
  // str/chr/bin, from the literal's own kind), or a plain field chain
  // (`nbox.value`, via `resolve_field_chain` -- `make_pair(nbox.value,
  // sbox.value)`'s own real call site in `examples/advanced/generic_
  // inference_after_init.fn`). Anything else (a method call, a nested
  // generic call, ...) is unresolvable, rejected rather than guessed.
  infer_arg_type_name(Node* arg) Option<str> {
    fit arg.kind {
      .Identifier(name) -> { ret self.lookup_local_type_name(name); }
      .Number(data) -> {
        fit data {
          .Num(_) -> { ret .Some("num"); }
          .Dec(_) -> { ret .Some("dec"); }
          _ -> { ret .None; }
        }
      }
      .String(_) -> { ret .Some("str"); }
      .Character(_) -> { ret .Some("chr"); }
      .Boolean(_) -> { ret .Some("bin"); }
      .Expression(e) -> {
        // A QUALIFIED enum-variant constant (`Job.Quit`, e.g.
        // `channel_new_cap<T>(T default_value, num capacity)`'s own
        // real call site `channel_new_cap(Job.Quit, 8)`) infers `T` as
        // the enum's own name directly -- checked BEFORE the `()` call
        // case below, since a qualified access and a call share nothing
        // structurally except both being `.Expression` nodes.
        if equals(e.op, ".") && e.has_left && e.has_right {
          fit e.left.kind {
            .Identifier(enum_name) -> {
              fit e.right.kind {
                .Identifier(variant_name) -> {
                  if self.enum_has_variant(enum_name, variant_name) {
                    ret .Some(enum_name);
                  }
                }
                _ -> {}
              }
            }
            _ -> {}
          }
          // Not a qualified enum-variant constant -- a PLAIN field
          // chain (`nbox.value`, `make_pair(nbox.value, sbox.value)`'s
          // own real call site in `examples/advanced/generic_inference_
          // after_init.fn`) resolves via the same `resolve_field_chain`
          // a method call's own receiver resolution already uses.
          let chain = self.resolve_field_chain(arg);
          if chain.is_some() {
            ret .Some(chain.unwrap().type_name);
          }
          ret .None;
        }
        if !equals(e.op, "()") || !e.has_left {
          ret .None;
        }
        fit e.left.kind {
          .Identifier(callee_name) -> {
            let rt = self.lookup_function_rtype(callee_name);
            if rt.is_none() {
              ret .None;
            }
            ret .Some(rt.unwrap().type_str);
          }
          _ -> { ret .None; }
        }
      }
      _ -> { ret .None; }
    }
  }

  // Companion to `infer_arg_type_name`, for the ONE shape that matters
  // to its own caller (`maybe_instantiate_generic_function`'s own type-
  // param inference, which needs to know whether the generated
  // function's param should be `T` or `T*`) -- a known local's OWN
  // recorded pointer-ness. `false` for every other shape `infer_arg_
  // type_name` itself resolves (a literal is never a pointer; a call's
  // return type isn't tracked structurally enough here to say either
  // way, matching that function's own scope).
  infer_arg_is_pointer(Node* arg) bin {
    fit arg.kind {
      .Identifier(name) -> {
        let p = self.lookup_local_is_pointer(name);
        if p.is_some() {
          ret p.unwrap();
        }
        ret false;
      }
      .Expression(e) -> {
        if equals(e.op, ".") && e.has_left && e.has_right {
          let chain = self.resolve_field_chain(arg);
          if chain.is_some() {
            ret chain.unwrap().is_pointer;
          }
        }
        ret false;
      }
      _ -> { ret false; }
    }
  }

  // Infers a BARE array literal's own Fun-level element type name and
  // nesting DEPTH (1 for a flat `[1, 2, 3]`, one more per level of
  // further nesting, `[[1, 2], [3, 4]]` -> 2) -- needed for `infer_let_
  // expr_type`'s own `.Bracket` case (`let arr = [1, 2, 3];`), which has
  // no DECLARED type to read at all. Only the FIRST element at each
  // level is inspected (assumes a rectangular/uniform literal, same
  // assumption `emit_multidim_inner_declarators` already makes for the
  // DECLARATION side of this same feature). `.None` when the first
  // element's own type can't be determined this way (anything besides a
  // scalar literal `infer_arg_type_name` itself resolves, or a further-
  // nested bracket) or the literal has no elements at all.
  infer_array_literal_elem_type_and_depth(Node* lit) Option<ArrayLiteralElemInfo> {
    fit lit.kind {
      .Bracket(inner) -> {
        Vec<Node*> elems;
        elems.init(0);
        self.flatten_call_args(inner, &elems);
        if elems.len == 0 {
          ret .None;
        }
        let first = elems.get(0);
        fit first.kind {
          .Bracket(_) -> {
            let sub = self.infer_array_literal_elem_type_and_depth(first);
            if sub.is_none() {
              ret .None;
            }
            let s = sub.unwrap();
            ArrayLiteralElemInfo r;
            r.type_name = s.type_name;
            r.depth = s.depth + 1;
            ret .Some(r);
          }
          _ -> {
            let tn = self.infer_arg_type_name(first);
            if tn.is_none() {
              ret .None;
            }
            ArrayLiteralElemInfo r;
            r.type_name = tn.unwrap();
            r.depth = 1;
            ret .Some(r);
          }
        }
      }
      _ -> { ret .None; }
    }
  }

  // Companion to `infer_arg_type_name`, for `maybe_instantiate_generic_
  // function`'s NESTED type-param inference (a param declared `Pair<L,
  // R> p`, matching a type param inside the param's own `generic_args`
  // rather than the param's bare type itself -- see that function's own
  // doc comment). Needs the argument's FULL structural `DataType`
  // (including ITS OWN `generic_args`, e.g. `pair`'s recorded `Pair<num,
  // str>`), not just the bare name `infer_arg_type_name` returns.
  // Covers a known local (via `lookup_local_dtype`, when it was recorded
  // with one; a bare name-only local has no generic args to offer, so
  // this yields `.None` for it same as an unknown name) and a literal
  // (a bare `DataType` with no generic args, matching `infer_arg_type_
  // name`'s own literal cases). Anything else is unresolvable here.
  infer_arg_dtype(Node* arg) Option<DataType> {
    fit arg.kind {
      .Identifier(name) -> { ret self.lookup_local_dtype(name); }
      .Number(data) -> {
        fit data {
          .Num(_) -> {
            DataType dt = dtype_new();
            dt.type_str = "num";
            ret .Some(dt);
          }
          .Dec(_) -> {
            DataType dt = dtype_new();
            dt.type_str = "dec";
            ret .Some(dt);
          }
          _ -> { ret .None; }
        }
      }
      .String(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "str";
        ret .Some(dt);
      }
      .Character(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "chr";
        ret .Some(dt);
      }
      .Boolean(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "bin";
        ret .Some(dt);
      }
      .Expression(e) -> {
        if equals(e.op, ".") && e.has_left && e.has_right {
          let chain = self.resolve_field_chain(arg);
          if chain.is_some() {
            ret chain.unwrap().dtype;
          }
        }
        ret .None;
      }
      _ -> { ret .None; }
    }
  }

  // Infers a `let NAME = <expr>;` declaration's own type, for THIS
  // codegen's OWN bookkeeping (`record_local`, so a later bare-shorthand
  // `fit`/chained field access/method call on `NAME` still resolves) --
  // the C DECLARATION itself always emits GNU C's own `__auto_type`
  // regardless (see `emit_statement`'s `.Variable` case), so a failed
  // inference here only means `NAME` isn't a known local afterward, not
  // that the declaration itself is rejected. Covers the same shapes
  // `infer_arg_type_name` does (a known local, a literal, a call to an
  // already-registered plain function) PLUS a method call
  // (`recv.method()`, e.g. `let last = self.tokens.last();` --
  // `_prev_token_is_bare_zero`'s real body in the self-hosted lexer's
  // own source -- resolved via `resolve_field_chain` + `
  // lookup_impl_method_rtype`, the exact same two lookups `emit_fit`'s
  // own call-subject handling already uses). Anything else (a nested
  // generic call, a chained method call whose OWN receiver is itself a
  // call, ...) is unresolvable, rejected rather than guessed.
  infer_let_expr_type(Node* val) Option<DataType> {
    fit val.kind {
      .Identifier(name) -> {
        let t = self.lookup_local_type_name(name);
        let p = self.lookup_local_is_pointer(name);
        if t.is_none() || p.is_none() {
          ret .None;
        }
        DataType dt = dtype_new();
        dt.type_str = t.unwrap();
        if p.unwrap() {
          dt.pointer_depth = 1;
        }
        ret .Some(dt);
      }
      // `let arr = [1, 2, 3];` (and its multi-dimensional generalization,
      // `let m2 = [[10, 20], [30, 40]];`) -- a BARE array literal, no
      // declared type to read at all. Without this, `arr`/`m2` was never
      // recorded as a known local afterward (this whole `fit` falls
      // through to `_ -> { ret .None; }` below), so a later `for x : arr`
      // rejected it outright as an unrecognized iterable ("codegen
      // failed: unsupported node") -- confirmed via `examples/advanced/
      // matrix.fn`'s own real `let m2 = [[10, 20], [30, 40]];` followed
      // by `for r : m2 { for v : r { ... } }`. See `infer_array_literal_
      // elem_type_and_depth`'s own doc comment for how the element type/
      // nesting depth are derived.
      .Bracket(_) -> {
        let info = self.infer_array_literal_elem_type_and_depth(val);
        if info.is_none() {
          ret .None;
        }
        let i = info.unwrap();
        DataType dt = dtype_new();
        dt.type_str = i.type_name;
        dt.is_array = true;
        dt.array_depth = i.depth;
        ret .Some(dt);
      }
      // `let p = Point{x = 1, y = 2};` -- an EXPLICIT compound literal
      // (`ci.has_dtype`) carries its own type name directly, no
      // inference needed. A BARE `.{...}` shorthand initializer has no
      // `expected_compound_type` to resolve against here either (the
      // exact same "let has no declared type" gap `resolve_unique_enum_
      // for_variant`'s own doc comment covers for a bare enum shorthand
      // -- not attempted here, since a compound literal's own FIELD
      // NAMES aren't a reliable global-uniqueness key the way an enum
      // variant's name is).
      .CompoundInit(ci) -> {
        if ci.has_dtype {
          // A bare `Box{value = 7}` (no explicit `<T>`) needs the SAME
          // field-value-based generic-arg inference `emit_expr`'s own
          // `.CompoundInit` case uses -- see `infer_generic_compound_
          // init_args`'s own doc comment. Without this, `nbox`'s own
          // recorded local type stayed the template's bare, ungeneric
          // name (`Box`, `generic_args` empty), so a LATER `nbox.value`
          // field read (or passing it as a generic function's own
          // argument) couldn't resolve `value`'s real type at all.
          DataType effective_dtype = *ci.init_dtype;
          if effective_dtype.generic_args.len == 0 {
            let inferred_gargs = self.infer_generic_compound_init_args(
              effective_dtype.type_str,
              ci.fields
            );
            if inferred_gargs.is_some() {
              effective_dtype.generic_args = inferred_gargs.unwrap();
            }
          }
          ret .Some(effective_dtype);
        }
        ret .None;
      }
      .Number(data) -> {
        DataType dt = dtype_new();
        fit data {
          .Num(_) -> {
            dt.type_str = "num";
            ret .Some(dt);
          }
          .Dec(_) -> {
            dt.type_str = "dec";
            ret .Some(dt);
          }
          _ -> { ret .None; }
        }
      }
      .String(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "str";
        ret .Some(dt);
      }
      .Character(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "chr";
        ret .Some(dt);
      }
      .Boolean(_) -> {
        DataType dt = dtype_new();
        dt.type_str = "bin";
        ret .Some(dt);
      }
      .Expression(e) -> {
        // A plain field-access initializer (`let ct = self.current_token;`
        // -- `ParseState.err`'s own real body, found via the self-compile
        // experiment): resolve the WHOLE chain (any depth) via
        // `resolve_field_chain`, the same resolution a later `ct.pos.line`
        // read of this local would need to already have registered.
        // Without this case, `ct` was never recorded as a known local at
        // all (falling through to the `_ -> { ret .None; }` catch-all
        // below), so any FURTHER field access off of it was rejected as
        // an unrecognized local -- not a `defer`-specific bug, just never
        // exercised until a real chained-field-copy-then-read pattern
        // showed up.
        if equals(e.op, ".") {
          let chain = self.resolve_field_chain(val);
          if chain.is_none() {
            ret .None;
          }
          let r = chain.unwrap();
          DataType dt = dtype_new();
          dt.type_str = r.type_name;
          if r.is_pointer {
            dt.pointer_depth = 1;
          }
          ret .Some(dt);
        }
        // `let m = f[0];` where `f` is a known POINTER-typed local
        // (`Foo* f`): C's `pointer[0]` is `*pointer`, a VALUE of the
        // pointee's own type, not another pointer -- e.g. the
        // read-mutate-writeback pattern this repo's own
        // `sync_backend_windows_mutex_init` uses (`let m = mutex[0]; ...;
        // mutex[0] = m;`). Only a bare-identifier receiver is resolved
        // here (matching `infer_let_expr_type`'s own established
        // narrowness elsewhere); a chained/computed receiver falls
        // through to `.None` same as ever.
        if equals(e.op, "[]") && e.has_left {
          fit e.left.kind {
            .Identifier(recv_name) -> {
              let t = self.lookup_local_type_name(recv_name);
              let p = self.lookup_local_is_pointer(recv_name);
              if t.is_some() && p.is_some() && p.unwrap() {
                DataType dt = dtype_new();
                dt.type_str = t.unwrap();
                ret .Some(dt);
              }
            }
            _ -> {}
          }
          ret .None;
        }
        if !equals(e.op, "()") || !e.has_left {
          ret .None;
        }
        fit e.left.kind {
          .Identifier(fn_name) -> {
            let rt = self.lookup_function_rtype(fn_name);
            if rt.is_some() {
              ret .Some(*rt.unwrap());
            }
            // A call to a GENERIC function template (`let p2 =
            // pick_first(p1, p2);`, `pick_first<T>(T a, T b) T`, or `let
            // b = make_box(5);`, `make_box<T>(T x) Box<T>` -- the return
            // type ITSELF a generic instantiation, not just a bare type
            // param) isn't in the plain registry `lookup_function_rtype`
            // reads -- infer its ACTUAL, substituted return type via the
            // same instantiation `emit_call` already triggers for this
            // exact call (idempotent: `maybe_instantiate_generic_function`
            // dedups via `emitted_generic_instantiations`, so calling it
            // again here -- this runs AFTER `emit_expr(v.val)` already
            // did, in the `Variable`-declaration case -- is a cheap
            // no-op past the first time). `GenericCallResolution.rtype`
            // already carries the substituted return type directly (see
            // its own doc comment) -- no need to separately hunt for a
            // same-named parameter as a proxy for it, this function's OWN
            // previous, narrower approach (which only worked for a BARE
            // `T` return, not `Box<T>`).
            if e.has_right {
              for tmpl : self.generic_function_templates {
                fit tmpl.kind {
                  .Function(f) -> {
                    if !equals(f.name, fn_name) || !f.has_rtype {
                      continue;
                    }
                    Vec<Node*> gargs;
                    gargs.init(0);
                    self.flatten_call_args(e.right, &gargs);
                    let ginst = self.maybe_instantiate_generic_function(fn_name, gargs);
                    if ginst.is_none() {
                      ret .None;
                    }
                    ret .Some(ginst.unwrap().rtype);
                  }
                  _ -> {}
                }
              }
            }
            ret .None;
          }
          .Expression(recv_e) -> {
            if !equals(recv_e.op, ".") || !recv_e.has_left || !recv_e.has_right {
              ret .None;
            }
            str method_name = "";
            fit recv_e.right.kind {
              .Identifier(n) -> { method_name = n; }
              _ -> { ret .None; }
            }
            let recv_r_opt = self.resolve_field_chain(recv_e.left);
            if recv_r_opt.is_none() {
              ret .None;
            }
            let recv_r = recv_r_opt.unwrap();
            // A QUIRK-typed receiver (`let v = value.to();` where `value`
            // is `To<MyEnum>`, `std/json.fn`'s own real `to_json_string`
            // body) dispatches through the quirk's OWN declared method
            // signature, not `lookup_impl_method_rtype` (which only knows
            // about CONCRETE impls' own registered methods, never a
            // quirk's abstract contract) -- `recv_r.type_name` is the
            // quirk's mangled CONCRETE identity (`To__MyEnum`); strip the
            // matching quirk's own bare-name prefix off it to recover the
            // concrete argument, then substitute it for the quirk's own
            // (single) type param in the matching method's declared
            // return type, mirroring `ensure_quirk_instantiated`'s own
            // identical substitution.
            if self.quirk_names.contains(recv_r.type_name) {
              num qdi2 = 0;
              for qdi2 < self.quirk_decl_names.len {
                let qn = self.quirk_decl_names.get(qdi2);
                StringBuilder qpfx_sb = string_builder_init(16);
                qpfx_sb.append(qn);
                qpfx_sb.append("__");
                str qpfx = qpfx_sb.build();
                if starts_with(recv_r.type_name, qpfx) {
                  str qarg_name = strip_prefix(recv_r.type_name, qpfx);
                  let qmethods = self.quirk_decl_methods.get(qdi2);
                  for qm2 : qmethods {
                    if equals(qm2.name, method_name) {
                      if qm2.rtype == nil {
                        ret .None;
                      }
                      DataType qm_rdt = *qm2.rtype;
                      let q_type_params2 = self.quirk_decl_type_params.get(qdi2);
                      if q_type_params2.len == 1 && equals(qm_rdt.type_str, q_type_params2.get(0)) && qm_rdt.generic_args.len == 0 {
                        DataType subst_dt = dtype_new();
                        subst_dt.type_str = qarg_name;
                        ret .Some(subst_dt);
                      }
                      ret .Some(qm_rdt);
                    }
                  }
                }
                qdi2 = qdi2 + 1;
              }
              ret .None;
            }
            let rt = self.lookup_impl_method_rtype(recv_r.type_name, method_name);
            if rt.is_none() {
              ret .None;
            }
            ret .Some(*rt.unwrap());
          }
          _ -> { ret .None; }
        }
      }
      // `let boxed = *pb;` -- a single pointer-dereference initializer
      // (`examples/advanced/async_quirk_await_pointer_receiver.fn`'s own
      // real body) resolves `pb`'s own chain first (any depth, via
      // `resolve_field_chain`, same reasoning as the `.Expression` case
      // above), then drops one level of `pointer_depth` to match -- a
      // dereferenced pointer local is a plain VALUE. Without this,
      // `boxed` was never recorded as a known local at all, rejecting
      // any FURTHER field access off it.
      .Unary(u) -> {
        if !equals(u.op, "*") || u.is_left_operanded_unary || !u.has_indirection || u.indirection_depth != 1 {
          ret .None;
        }
        let recv_r_opt = self.resolve_field_chain(u.operand);
        if recv_r_opt.is_none() {
          ret .None;
        }
        let recv_r = recv_r_opt.unwrap();
        if !recv_r.is_pointer {
          ret .None;
        }
        if recv_r.dtype.is_some() {
          DataType dd = recv_r.dtype.unwrap();
          if dd.pointer_depth > 0 {
            dd.pointer_depth = dd.pointer_depth - 1;
          }
          // `dtype_is_pointer` also honors `flags.is_pointer`
          // independently of `pointer_depth` (a `T*` PARAMETER's own
          // flag) -- clearing only `pointer_depth` left it `true`,
          // wrongly still reading as a pointer after the deref.
          dd.flags.is_pointer = false;
          ret .Some(dd);
        }
        DataType dt = dtype_new();
        dt.type_str = recv_r.type_name;
        ret .Some(dt);
      }
      _ -> { ret .None; }
    }
  }

  // Given `fn_name` (a call's plain-identifier callee) and its already-
  // flattened, actual call ARGUMENTS, checks whether `fn_name` matches a
  // registered GENERIC function template (see `Codegen.
  // generic_function_templates`'s doc comment); if so, infers each of
  // the template's own type parameters' concrete binding from whichever
  // positional argument's OWN declared parameter type is a bare
  // occurrence of that type param (`T _default_value` -- matching
  // `ensure_compound_instantiated`'s own "bare occurrence only"
  // restriction, via `infer_arg_type_name`), monomorphizes the function
  // body under a mangled name (`<name>__<arg1>__<arg2>...`, deduped via
  // `emitted_generic_instantiations`, the SAME shared registry generic
  // compounds/enums/impls already use), and returns that mangled name
  // for `emit_call` to use as the actual C callee. `.None` means either
  // `fn_name` isn't a generic function template at all (the ordinary,
  // ALREADY-registered-non-generic case, or genuinely unknown), or a
  // type param's binding couldn't be inferred from this call's own
  // arguments -- `emit_call` must reject rather than guess in that case.
  // 
  // Deliberately narrow for this slice: no pointer-arg mangling (unlike
  // the compound/enum/impl-method cases, every inferred binding is
  // treated as a bare value type, matching every call site this slice
  // was verified against), and the monomorphized body's OWN call
  // arguments don't get bare-shorthand resolution the way a plain
  // (non-generic) function's calls do (`Codegen.function_names`'s own
  // per-argument lookup isn't consulted here).
  // Falls back to CONTEXTUAL inference for a generic function's type
  // param `tp` when the call's own arguments don't reveal it at all
  // (`ret ok(.None);` inside `_next_inner`'s real body -- `ok<T>(value)
  // Result<T, Error>` called with a bare shorthand that carries no type
  // info by itself) -- matches `f`'s OWN declared return type
  // STRUCTURALLY against the CURRENT enclosing function's own concrete
  // return type (`Codegen.current_fn_rtype_dt`, same base name, same
  // generic-arg count), finds the position where `tp` appears as a bare
  // occurrence in `f`'s own return type, and resolves the ENCLOSING
  // function's own return type at that SAME position (`_next_inner`'s
  // `Result<Option<Token>, Error>`, position 0 -> `Option<Token>` ->
  // `T`). `.None` when there's no enclosing function context, the
  // return-type SHAPES don't match, or `tp` doesn't appear (bare) in
  // `f`'s own return type at all -- the caller must reject rather than
  // guess.
  infer_generic_function_type_param_from_context(FunctionNode f, str tp) Option<str> {
    if !f.has_rtype || self.current_fn_rtype_dt.is_none() {
      ret .None;
    }
    let caller_rtype = self.current_fn_rtype_dt.unwrap();
    if !equals(f.rtype.type_str, caller_rtype.type_str) || f.rtype.generic_args.len != caller_rtype.generic_args.len {
      ret .None;
    }
    num pi = 0;
    for pi < f.rtype.generic_args.len {
      let templ_arg = f.rtype.generic_args.get(pi);
      if equals(templ_arg.type_str, tp) && templ_arg.generic_args.len == 0 {
        let caller_arg = caller_rtype.generic_args.get(pi);
        ret self.resolve_type_name(*caller_arg);
      }
      pi = pi + 1;
    }
    ret .None;
  }

  maybe_instantiate_generic_function(str fn_name, Vec<Node*> args) Option<GenericCallResolution> {
    for tmpl : self.generic_function_templates {
      fit tmpl.kind {
        .Function(f) -> {
          if equals(f.name, fn_name) {
            Vec<str> arg_type_names;
            arg_type_names.init(0);
            Vec<bin> arg_is_pointer;
            arg_is_pointer.init(0);
            for tp : f.type_params {
              bin found = false;
              str found_name = "";
              bin found_is_pointer = false;
              num ai = 0;
              for parg : f.args {
                fit parg.kind {
                  .Variable(v) -> {
                    if equals(v.var_type.type_str, tp) && v.var_type.generic_args.len == 0 && ai < args.len {
                      let arg_node = args.get(ai);
                      let inferred = self.infer_arg_type_name(arg_node);
                      if inferred.is_some() {
                        found_name = inferred.unwrap();
                        // A POINTER argument (`err(1, "...", result)`
                        // where `result` is `Expr*`, `examples/imports/
                        // torture_compiler/parser.fn`'s own real body)
                        // needs the generated function's own param to
                        // ALSO be a pointer -- `infer_arg_type_name`
                        // only ever returns the bare type NAME, dropping
                        // pointer-ness entirely, which this hardcoded
                        // `false` below used to just accept. Captured
                        // HERE, at the exact matching arg position --
                        // `ai` itself is stale by the time this loop
                        // ends (incremented past every param, not just
                        // the matching one).
                        found_is_pointer = self.infer_arg_is_pointer(arg_node);
                        found = true;
                      }
                    }
                  }
                  _ -> {}
                }
                ai = ai + 1;
              }
              // Falls back to a NESTED match when no param is a bare
              // occurrence of `tp` itself: a param declared `Pair<L, R>
              // p` (`swap_pair<L, R>(Pair<L, R> p) Pair<R, L>`, e.g.)
              // never matches the bare-occurrence loop above (`v.
              // var_type.generic_args.len == 0` fails, since `Pair<L,
              // R>` has two), but `tp` still appears -- as a bare
              // occurrence ONE LEVEL DOWN, inside the param's own
              // `generic_args`. Resolved by finding `tp`'s POSITION
              // there, then reading that same position out of the
              // ACTUAL argument's own structural `DataType` (`pair`'s
              // recorded `Pair<num, str>`, via `infer_arg_dtype`) --
              // e.g. position 0 -> `num` for `L`, position 1 -> `str`
              // for `R`. Only one level of nesting is matched (matching
              // `infer_arg_dtype`'s own scope); a param whose actual
              // argument itself lacks recorded generic args (a plain
              // `record_local` local, not `record_local_typed`) can't
              // be resolved this way either.
              if !found {
                num ai3 = 0;
                for parg3 : f.args {
                  fit parg3.kind {
                    .Variable(v3) -> {
                      if v3.var_type.generic_args.len > 0 && ai3 < args.len {
                        num gi = 0;
                        for garg : v3.var_type.generic_args {
                          if !found && equals(garg.type_str, tp) && garg.generic_args.len == 0 {
                            let arg_dt3 = self.infer_arg_dtype(args.get(ai3));
                            if arg_dt3.is_some() {
                              let adt3 = arg_dt3.unwrap();
                              if gi < adt3.generic_args.len {
                                let nested = adt3.generic_args.get(gi);
                                let nested_name = self.resolve_type_name(*nested);
                                if nested_name.is_some() {
                                  found_name = nested_name.unwrap();
                                  found = true;
                                }
                              }
                            }
                          }
                          gi = gi + 1;
                        }
                      }
                    }
                    _ -> {}
                  }
                  ai3 = ai3 + 1;
                }
              }
              if !found {
                let ctx_inferred = self.infer_generic_function_type_param_from_context(f, tp);
                if ctx_inferred.is_some() {
                  found_name = ctx_inferred.unwrap();
                  found = true;
                }
              }
              if !found {
                ret .None;
              }
              arg_type_names.push(found_name);
              arg_is_pointer.push(found_is_pointer);
            }

            StringBuilder nb = string_builder_init(16);
            nb.append(fn_name);
            for an : arg_type_names {
              nb.append("__");
              nb.append(an);
            }
            str mangled_name = nb.build();

            // The substitution context is set up-front (BEFORE the
            // dedup check below) so `substituted param types` can be
            // computed -- and returned to the caller via
            // `GenericCallResolution.param_types` for its OWN
            // bare-shorthand argument resolution (`ok(.None)`, e.g.) --
            // on EITHER path: a repeat call resolves to the
            // already-monomorphized instance without re-emitting
            // anything, but its params still need to be resolved fresh
            // for THIS call site.
            let prev_params = self.type_subst_param_names;
            let prev_arg_names = self.type_subst_arg_type_strs;
            let prev_arg_ptrs = self.type_subst_arg_is_pointer;
            self.type_subst_param_names = f.type_params;
            self.type_subst_arg_type_strs = arg_type_names;
            self.type_subst_arg_is_pointer = arg_is_pointer;

            Vec<DataType> param_types;
            param_types.init(0);
            for parg : f.args {
              fit parg.kind {
                .Variable(v) -> {
                  param_types.push(self.resolve_type_subst(*v.var_type));
                }
                _ -> {}
              }
            }

            num ei = 0;
            bin already_emitted = false;
            for ei < self.emitted_generic_instantiations.len {
              if equals(self.emitted_generic_instantiations.get(ei), mangled_name) {
                already_emitted = true;
              }
              ei = ei + 1;
            }

            if !already_emitted {
              self.emitted_generic_instantiations.push(mangled_name);

              // `hoist_insert_pos` (if set) is a position measured
              // against the OUTER, now-swapped-away buffer -- suspending
              // it for the duration of the swap makes any NESTED
              // instantiation triggered from inside this function's own
              // signature/body (e.g. a return type that's ITSELF a
              // generic enum, like `err_kind<T>`'s own `Result<T,
              // Error>`) append inline to `scratch` instead of splicing
              // at a stale position into the wrong buffer (which
              // corrupts `substr`'s own length arithmetic and crashes)
              // -- the whole scratch buffer still ends up hoisted to
              // the correct outer position via `emit_hoisted` below
              // regardless. Same reasoning as
              // `maybe_instantiate_generic_impl_methods`'s own
              // local-state save/restore: this can run NESTED inside
              // another function's own (still in-progress) emission
              // (e.g. triggered from resolving ITS OWN return type), so
              // `local_names`/`local_is_pointer`/`local_type_name`/
              // `current_fn_rtype_name`/`current_fn_rtype_dt` -- all
              // unconditionally overwritten by `emit_function_named`
              // for ITS OWN target -- must be saved and restored too,
              // not just `hoist_insert_pos`.
              CodegenState scratch = codegen_state_new();
              CodegenState* saved_state = self.state;
              let saved_hoist_pos = self.hoist_insert_pos;
              let saved_local_names = self.local_names;
              let saved_local_is_pointer = self.local_is_pointer;
              let saved_local_type_name = self.local_type_name;
              let saved_local_dtype = self.local_dtype;
              let saved_fn_rtype_name = self.current_fn_rtype_name;
              let saved_fn_rtype_dt = self.current_fn_rtype_dt;
              let saved_defer_stack = self.defer_stack;
              let saved_defer_scope_starts = self.defer_scope_starts;
              // See `maybe_instantiate_generic_impl_methods`'s own
              // identical `method_scratch` swap for why `current_stmt_
              // start_pos` needs the exact same suspend/restore
              // treatment as `hoist_insert_pos` here too: `emit_
              // function_named` recurses into `emit_statements`,
              // overwriting it with a position measured against THIS
              // scratch buffer.
              let saved_stmt_start_pos = self.current_stmt_start_pos;
              // Also suspended, same as `resolve_field_chain`'s own
              // call-as-receiver probe: without this, a generic impl
              // method reached for the FIRST time from inside THIS
              // function's own body (`set_init<T>`'s real body calling
              // `Map<K, V>.init()`, e.g.) gets DRAINED immediately --
              // its own prototype+FULL BODY splice falls back to "append
              // at self.state's current tail" (since `hoist_insert_pos`/
              // `current_stmt_start_pos` are BOTH suspended here already)
              // -- which, since `self.state` still points at THIS
              // scratch, lands the drained method's own full definition
              // NESTED inside this function's own `{ }` -- a hard C
              // syntax error ("function definition is not allowed
              // here"). Only ENQUEUED while suppressed; drained
              // explicitly below, once `self.state`/`hoist_insert_pos`
              // are back to the real ones. Found via a real stage-2
              // self-compilation C error for exactly this shape (`set_
              // init<T>` monomorphized to `str`, calling `Map<str,
              // bin>.init()` for the first time).
              let prev_suppress2 = self.suppress_generic_impl_method_draining;
              // See `emit_one_generic_impl_method`'s own identical
              // `hoist_scratch_depth` participation for why -- this
              // function's OWN body can be reached from inside another
              // generic impl method's own first instantiation
              // (`Person<T>.new`'s body calling `some("none")`), which
              // this counter is exactly for.
              if self.hoist_scratch_depth == 0 {
                self.root_state = self.state;
                self.root_hoist_pos = self.hoist_insert_pos;
                self.root_stmt_start_pos = self.current_stmt_start_pos;
              }
              self.hoist_scratch_depth = self.hoist_scratch_depth + 1;
              self.state = &scratch;
              self.hoist_insert_pos = .None;
              self.current_stmt_start_pos = .None;
              self.suppress_generic_impl_method_draining = true;
              self.emit_function_named(tmpl, mangled_name);
              self.state = saved_state;
              self.hoist_insert_pos = saved_hoist_pos;
              self.current_stmt_start_pos = saved_stmt_start_pos;
              self.hoist_scratch_depth = self.hoist_scratch_depth - 1;
              if self.hoist_scratch_depth == 0 {
                self.hoist_insert_pos = self.root_hoist_pos;
                self.current_stmt_start_pos = self.root_stmt_start_pos;
              }
              self.suppress_generic_impl_method_draining = prev_suppress2;
              self.local_names = saved_local_names;
              self.local_is_pointer = saved_local_is_pointer;
              self.local_type_name = saved_local_type_name;
              self.local_dtype = saved_local_dtype;
              self.current_fn_rtype_name = saved_fn_rtype_name;
              self.current_fn_rtype_dt = saved_fn_rtype_dt;
              self.defer_stack = saved_defer_stack;
              self.defer_scope_starts = saved_defer_scope_starts;
              self.emit_hoisted(scratch.out.build());
              if !prev_suppress2 && !self.draining_generic_impl_methods {
                // A method enqueued from INSIDE the just-spliced `scratch`
                // text (`tmpl`'s own body, e.g. `set_init<T>` calling
                // `Map<K, V>.init()` for the first time) needs its own
                // inline prototype findable from BEFORE `scratch`'s own
                // text -- not `self.hoist_insert_pos`'s CURRENT value
                // (`saved_hoist_pos` already advanced past `scratch`'s
                // own just-spliced length by the `emit_hoisted` call
                // directly above), which would land the prototype AFTER
                // `scratch`, too late for the CALL inside its own body to
                // reach it. `saved_hoist_pos` (captured before that
                // splice, still `scratch`'s own pre-splice position) is
                // the right target -- realigned here ONLY for the
                // duration of this drain, restored to the outer
                // statement's own position afterward so nothing leaks to
                // whatever called this function. `emit_one_generic_impl_
                // method`'s own FULL BODY splice (unlike the prototype)
                // still correctly uses `self.hoist_insert_pos` directly
                // (now past `scratch`), landing right AFTER it -- exactly
                // where a definition (as opposed to a mere forward
                // declaration) is expected to go.
                let saved_stmt_start_pos_for_drain = self.current_stmt_start_pos;
                self.current_stmt_start_pos = saved_hoist_pos;
                self.drain_pending_generic_impl_methods();
                self.current_stmt_start_pos = saved_stmt_start_pos_for_drain;
              }
            }

            // Computed BEFORE the substitution context below gets torn
            // down -- see `GenericCallResolution.rtype`'s own doc
            // comment for why this can't just be derived by the caller
            // afterward. `f.rtype` is optional (`void`-returning generic
            // function); left as an unsubstituted, harmless placeholder
            // when absent -- no caller reads `rtype` without checking
            // `f.has_rtype` (or the equivalent) itself first.
            DataType resolved_rtype = dtype_new();
            if f.has_rtype {
              resolved_rtype = self.resolve_type_subst(*f.rtype);
            }

            self.type_subst_param_names = prev_params;
            self.type_subst_arg_type_strs = prev_arg_names;
            self.type_subst_arg_is_pointer = prev_arg_ptrs;

            GenericCallResolution res;
            res.mangled_name = mangled_name;
            res.param_types = param_types;
            res.rtype = resolved_rtype;
            ret .Some(res);
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Looks up the declared type of `fn_name`'s parameter at `arg_index`
  // (0-based) -- see `Codegen.function_names`'s doc comment. Falls back
  // to a GENERIC function template's OWN declared parameter type at that
  // position when `fn_name` isn't in the plain registry (`err_kind(
  // .Invalid, "msg", "")` -- try_substr's real body, e.g. -- needs
  // `.Invalid` resolved against `kind`'s own `ErrorKind` type even
  // though `err_kind` itself is generic; the TEMPLATE's own param type
  // at a non-generic position is already fully concrete, no
  // substitution needed for bare-shorthand purposes). `.None` means
  // `fn_name` isn't registered ANYWHERE (unknown, or a method -- see
  // `register_function_signatures`), or `arg_index` is out of range (a
  // variadic C binding's trailing `...` args, say) -- the caller must
  // treat that as "can't resolve this argument's expected type," not
  // guess.
  lookup_function_param_type(str fn_name, num arg_index) Option<DataType*> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        let params = self.function_param_types.get(i);
        if arg_index < 0 || arg_index >= params.len {
          ret .None;
        }
        ret .Some(params.get(arg_index));
      }
      i = i + 1;
    }
    for tmpl : self.generic_function_templates {
      fit tmpl.kind {
        .Function(f) -> {
          if equals(f.name, fn_name) {
            if arg_index < 0 || !f.has_args || arg_index >= f.args.len {
              ret .None;
            }
            let param_node = f.args.get(arg_index);
            fit param_node.kind {
              .Variable(v) -> { ret .Some(v.var_type); }
              _ -> { ret .None; }
            }
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }

  // Looks up `fn_name`'s OWN full param COUNT and trailing default-
  // parameter VALUE expressions -- see `Codegen.function_default_
  // values`'s own doc comment. `.None` means `fn_name` isn't registered
  // as a plain (non-generic) function at all.
  lookup_function_default_values(str fn_name) Option<Vec<Node *>> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        ret .Some(self.function_default_values.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `fn_name`'s OWN full param list (the WHOLE `Vec<DataType*>`,
  // not just one arg's type) -- needed by `emit_default_trailing_args`
  // so a default VALUE that's itself a bare enum shorthand (`LogFormat
  // format = .Text;`, `std/log.fn`'s own real `logger_init` signature)
  // resolves against that PARAM's own declared type, the same way a
  // caller-PROVIDED argument already does. `.None` means `fn_name` isn't
  // registered as a plain (non-generic) function at all.
  lookup_function_param_types(str fn_name) Option<Vec<DataType *>> {
    num i = 0;
    for i < self.function_names.len {
      if equals(self.function_names.get(i), fn_name) {
        ret .Some(self.function_param_types.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Pre-registers every method of a plain OR quirk-implementing
  // (non-generic) impl block under its own bare name and fully mangled
  // C call-site name (see `Codegen.impl_method_owner_type`'s doc
  // comment), WITHOUT emitting any C -- run as its OWN whole-program
  // pass, before ANY impl method body is generated (see `transpile`'s
  // doc comment for why: a method that calls another type's method
  // needs that OTHER type's row recorded already, regardless of which
  // impl block happens to come first in source order -- the same
  // reason `emit_enum`/`emit_compound` get their own full passes before
  // impl bodies are emitted at all). The bare name is recovered by
  // stripping the known prefix (`Type__` for a plain impl, `Type__
  // Quirk__` for a quirk-implementing one) off each method's ALREADY
  // pre-mangled `Function` node name -- `_parse_impl_method`'s own
  // scheme in the parser, not something this file invents. A GENERIC
  // impl (`has_type_params`) is instead only RECORDED whole (see
  // `Codegen.generic_impl_templates`'s doc comment) -- never registered
  // under its bare (un-instantiated) name here, matching
  // `emit_compound`/`emit_enum`'s own rule for a generic template:
  // monomorphization happens lazily, on first concrete use (see
  // `maybe_instantiate_generic_impl_methods`).
  register_impl_methods(Node node) {
    fit node.kind {
      .Impl(i) -> {
        if i.has_type_params {
          self.generic_impl_templates.push(node);
          ret;
        }
        StringBuilder pfx = string_builder_init(16);
        pfx.append(i.type_name);
        pfx.append("__");
        if i.has_quirk_name {
          pfx.append(i.quirk_name);
          pfx.append("__");
        }
        str prefix = pfx.build();
        for m : i.methods {
          str mangled_name = "";
          DataType* rtype = nil;
          Vec<DataType*> param_types;
          param_types.init(0);
          // Each param's own default VALUE expression (`nil` when it has
          // none) -- see `Codegen.impl_method_default_values`'s own doc
          // comment.
          Vec<Node*> default_values;
          default_values.init(0);
          fit m.kind {
            .Function(fnv) -> {
              mangled_name = fnv.name;
              if fnv.has_rtype {
                rtype = fnv.rtype;
              }
              if fnv.has_args {
                bin skipped_self = false;
                for arg : fnv.args {
                  if !skipped_self {
                    skipped_self = true;
                    continue;
                  }
                  fit arg.kind {
                    .Variable(v) -> {
                      param_types.push(v.var_type);
                      if v.has_val {
                        default_values.push(v.val);
                      } else {
                        default_values.push(nil);
                      }
                    }
                    _ -> {}
                  }
                }
              }
            }
            _ -> {}
          }
          let bare_name = strip_prefix(mangled_name, prefix);
          self.record_impl_method(
            i.type_name,
            bare_name,
            mangled_name,
            rtype,
            param_types,
            default_values
          );
        }
      }
      _ -> {}
    }
  }

  // Emits every method of a plain OR quirk-implementing (non-generic)
  // `impl Type { methods }` block as an ordinary top-level C function --
  // the parser ALREADY did the work that makes this trivial: each
  // method is parsed as a `Function` node pre-mangled to `Type__method`
  // (or `Type__Quirk__method`) with `<Type>* self` as its real first arg
  // (`_parse_impl_method`'s doc comment in the parser), so a method is
  // emitted exactly like any other function via the existing
  // `emit_function` -- no separate self-injection or name-mangling
  // logic needed here. Assumes `register_impl_methods` already ran for
  // every impl in the program (see its own doc comment and `transpile`'s
  // pass ordering) -- this function only EMITS, it doesn't register.
  // 
  // TRUE dynamic dispatch through an abstract quirk-TYPED value (assigning
  // a concrete quirk-implementor to a variable declared as the quirk
  // itself, then calling through it via a vtable) is handled by
  // `emit_quirk_vtable_machinery`, called for every quirk-implementing
  // impl right after this function emits its own concrete method bodies
  // (see `transpile`'s final combined pass) -- kept as a SEPARATE
  // function rather than folded in here since it only applies to
  // `i.has_quirk_name` impls, while this one emits a PLAIN impl's methods
  // identically either way. A STATIC call through a receiver whose OWN
  // declared type is already the concrete implementing type (still by
  // far the common case in this codebase's own real source) is
  // untouched by any of this, resolved entirely by `emit_method_call`'s
  // existing lookup. A generic impl (`has_type_params`) is skipped here
  // too, same reasoning as `emit_compound`'s generic-template skip.
  emit_impl(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Impl(i) -> {
        if i.has_type_params {
          ret .None;
        }
        for m : i.methods {
          let merr = self.emit_function(*m);
          if merr.is_some() {
            ret merr;
          }
        }
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits the C machinery backing dynamic dispatch through an abstract
  // quirk-typed value (`Shape s = &rect; s.area();`) for one CONCRETE,
  // non-generic quirk-implementing impl (`impl Rectangle as Shape {
  // ... }`) -- a no-op for a plain impl (`!i.has_quirk_name`) or a
  // generic one (skipped by `transpile`'s own caller, same as
  // `emit_impl`). Simpler than the original transpiler's own identical
  // mechanism in one deliberate way: this emits ONE vtable struct per
  // QUIRK NAME directly (`Shape_vtable`), not the original's
  // per-METHOD-SIGNATURE-HASH canonical struct shared across
  // differently-named quirks with identical signatures -- that dedup is
  // a size optimization, not a correctness requirement, and skipping it
  // keeps this considerably simpler to port.
  // 
  // Three pieces, in order:
  // 1. The FIRST time this quirk name is seen (`Codegen.quirk_names`
  // doesn't have it yet): the vtable struct itself (one function-pointer
  // field per quirk method, each taking `void* self` first) and the
  // "fat pointer" wrapper struct (`typedef struct Shape { void* self;
  // const Shape_vtable* vtable; } Shape;`) that `Shape` itself resolves
  // to as a C type -- derived from THIS impl's own method signatures,
  // which every other impl of the same quirk must structurally match
  // (the language's own quirk-conformance rule; this codegen has no
  // typechecker to verify it, so it's simply assumed).
  // 2. Always: a `void* self`-taking wrapper trampoline per method (casts
  // back to `Type*` and calls the already-mangled, already-emitted
  // `Type__Quirk__method`), plus a `static const` vtable instance
  // (`__fun_impl_Type_Quirk_vtable`) populated with those wrappers.
  // 3. Always: the coercion helper (`__fun_coerce_Type_Quirk`) that
  // builds a `Shape` value from a `Type*` -- called from a `Shape s =
  // &rect;` declaration's own initializer (see the `Variable`
  // declaration's own coercion check).
  emit_quirk_vtable_machinery(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Impl(i) -> {
        // A GENERIC quirk impl (`impl Vec<T> as Sized { ... }`) has no
        // single monomorphic vtable signature to speak of -- an unbound
        // `T` in a method's own return/arg type can't be expressed in
        // one C function-pointer signature. Same skip `emit_impl` itself
        // already applies for generic impls generally.
        if !i.has_quirk_name || i.has_type_params {
          ret .None;
        }
        str quirk_name = i.quirk_name;
        str type_name = i.type_name;
        // See `Codegen.emitted_quirk_impl_vtables`'s own doc comment --
        // a no-op when THIS impl's own machinery already ran (triggered
        // early by `ensure_plain_type_emitted`'s field-dependency check,
        // e.g.), so the normal per-impl pass reaching it again later
        // doesn't re-emit its wrapper trampolines/vtable instance/
        // coerce helper a second time.
        StringBuilder eqiv_key_sb = string_builder_init(16);
        eqiv_key_sb.append(type_name);
        eqiv_key_sb.append("::");
        eqiv_key_sb.append(quirk_name);
        str eqiv_key = eqiv_key_sb.build();
        if self.emitted_quirk_impl_vtables.contains(eqiv_key) {
          ret .None;
        }
        self.emitted_quirk_impl_vtables.push(eqiv_key);
        // The VTABLE/fat-pointer TYPE's own identity: a CONCRETE
        // instantiation of a generic quirk (`impl Config as To<JsonValue>`,
        // `examples/stdlib/generic_to_from.fn`'s own real body) is a
        // DISTINCT type from `To<str>` or any other instantiation, and
        // needs its OWN mangled name (`To__JsonValue`) to avoid colliding
        // with them -- `i.quirk_concrete_instantiation` already carries
        // exactly that (mangled the same way `ensure_compound_
        // instantiated` mangles any other generic instantiation),
        // populated by the parser but never read by codegen until now.
        // Method NAME mangling (`prefix`/`strip_prefix` below) stays keyed
        // on the BARE quirk name regardless -- `fnv.name` is ALREADY pre-
        // mangled that way by `_parse_impl_method`, independent of this.
        str quirk_type_identity = quirk_name;
        if i.has_quirk_concrete_instantiation {
          quirk_type_identity = i.quirk_concrete_instantiation;
        }

        StringBuilder pfx = string_builder_init(16);
        pfx.append(type_name);
        pfx.append("__");
        pfx.append(quirk_name);
        pfx.append("__");
        str prefix = pfx.build();

        if !self.quirk_names.contains(quirk_type_identity) {
          self.state.write("typedef struct ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable;\n");
          self.state.write("struct ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable {\n");
          for m : i.methods {
            fit m.kind {
              .Function(fnv) -> {
                self.state.write("  ");
                if fnv.has_rtype {
                  let wt = self.write_type(*fnv.rtype);
                  if wt.is_none() {
                    ret .Some(CodegenErrorKind.UnsupportedNode);
                  }
                } else {
                  self.state.write("void");
                }
                let base = strip_prefix(fnv.name, prefix);
                self.state.write(" (*");
                self.state.write(base);
                self.state.write(")(void* self");
                if fnv.has_args {
                  bin skipped_self = false;
                  for arg : fnv.args {
                    if !skipped_self {
                      skipped_self = true;
                      continue;
                    }
                    fit arg.kind {
                      .Variable(v) -> {
                        self.state.write(", ");
                        let pwt = self.write_type(*v.var_type);
                        if pwt.is_none() {
                          ret .Some(CodegenErrorKind.UnsupportedNode);
                        }
                      }
                      _ -> {}
                    }
                  }
                }
                self.state.write(");\n");
              }
              _ -> {}
            }
          }
          self.state.write("};\n");
          self.state.write("typedef struct ");
          self.state.write(quirk_type_identity);
          self.state.write(" { void* self; const ");
          self.state.write(quirk_type_identity);
          self.state.write("_vtable* vtable; } ");
          self.state.write(quirk_type_identity);
          self.state.write(";\n\n");
          self.quirk_names.push(quirk_type_identity);
        }

        StringBuilder vsb = string_builder_init(24);
        vsb.append("__fun_impl_");
        vsb.append(type_name);
        vsb.append("_");
        vsb.append(quirk_type_identity);
        vsb.append("_vtable");
        str vtbl_instance_name = vsb.build();

        for m : i.methods {
          fit m.kind {
            .Function(fnv) -> {
              let base = strip_prefix(fnv.name, prefix);
              StringBuilder wsb = string_builder_init(32);
              wsb.append("__fun_wrap_");
              wsb.append(type_name);
              wsb.append("_");
              wsb.append(quirk_type_identity);
              wsb.append("_");
              wsb.append(base);
              str wrap_name = wsb.build();

              self.state.write("static ");
              if fnv.has_rtype {
                let wt2 = self.write_type(*fnv.rtype);
                if wt2.is_none() {
                  ret .Some(CodegenErrorKind.UnsupportedNode);
                }
              } else {
                self.state.write("void");
              }
              self.state.write(" ");
              self.state.write(wrap_name);
              self.state.write("(void* self");
              Vec<str> arg_names;
              arg_names.init(0);
              if fnv.has_args {
                bin skipped_self2 = false;
                num arg_i = 0;
                for arg : fnv.args {
                  if !skipped_self2 {
                    skipped_self2 = true;
                    continue;
                  }
                  fit arg.kind {
                    .Variable(v) -> {
                      self.state.write(", ");
                      let pwt2 = self.write_type(*v.var_type);
                      if pwt2.is_none() {
                        ret .Some(CodegenErrorKind.UnsupportedNode);
                      }
                      StringBuilder an_sb = string_builder_init(8);
                      an_sb.append(" __fun_a");
                      an_sb.append(format_num(arg_i));
                      str an = an_sb.build();
                      self.state.write(an);
                      arg_names.push(an);
                      arg_i = arg_i + 1;
                    }
                    _ -> {}
                  }
                }
              }
              self.state.write(") {\n  ");
              if fnv.has_rtype {
                self.state.write("return ");
              }
              self.state.write(fnv.name);
              self.state.write("((");
              self.state.write(type_name);
              self.state.write("*)self");
              for an2 : arg_names {
                self.state.write(",");
                self.state.write(an2);
              }
              self.state.write(");\n}\n\n");
            }
            _ -> {}
          }
        }

        self.state.write("static const ");
        self.state.write(quirk_type_identity);
        self.state.write("_vtable ");
        self.state.write(vtbl_instance_name);
        self.state.write(" = {\n");
        for m : i.methods {
          fit m.kind {
            .Function(fnv) -> {
              let base2 = strip_prefix(fnv.name, prefix);
              StringBuilder wsb2 = string_builder_init(32);
              wsb2.append("__fun_wrap_");
              wsb2.append(type_name);
              wsb2.append("_");
              wsb2.append(quirk_type_identity);
              wsb2.append("_");
              wsb2.append(base2);
              self.state.write("  .");
              self.state.write(base2);
              self.state.write(" = ");
              self.state.write(wsb2.build());
              self.state.write(",\n");
            }
            _ -> {}
          }
        }
        self.state.write("};\n\n");

        self.state.write("static inline ");
        self.state.write(quirk_type_identity);
        self.state.write(" __fun_coerce_");
        self.state.write(type_name);
        self.state.write("_");
        self.state.write(quirk_type_identity);
        self.state.write("(");
        self.state.write(type_name);
        self.state.write("* self) { return (");
        self.state.write(quirk_type_identity);
        self.state.write("){ .self = self, .vtable = &");
        self.state.write(vtbl_instance_name);
        self.state.write(" }; }\n\n");

        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Writes the fixed set of C headers the original always includes
  // (before any conditional ones gated on stdlib usage, threads, sockets,
  // etc. -- none of which are reachable yet since imports aren't ported),
  // plus the same fixed `stderr_stream()` helper the original's own
  // prelude always defines too -- `emit_expr`'s `.Panic` case calls it
  // unconditionally, so it must always be present regardless of whether
  // this particular program uses `panic(...)` at all (matching the
  // original's own reasoning: cheap, harmless when unused, and avoids
  // conditionally tracking "does this program need it"). `<ctype.h>` is
  // ALSO unconditional here for the same reason, rather than gated on an
  // actual `imp std.c.ctype;` the way the original conditionally includes
  // it -- import nodes never survive `import_resolver.fn`'s own
  // flattening (`_parse_and_merge` discards `.Import` after recursing
  // into it), so this codegen has no way to see WHICH `std.c.*` modules
  // a program imported at all yet; unconditionally including it is cheap
  // and harmless when unused, same as every other header here. Found via
  // a real stage-2 self-compilation C error ("call to undeclared library
  // function 'isalnum'") for `std/lexer.fn`'s own real char-
  // classification calls.
  pub write_prelude() {
    self.state.write(`#include <stdio.h>
    `#include <stdbool.h>
    `#include <stdint.h>
    `#include <stdarg.h>
    `#include <stdlib.h>
    `#include <string.h>
    `#include <ctype.h>
    `#include <limits.h>
    ``);
    // See `Codegen.skip_math_h`'s own doc comment: a program defining
    // its OWN top-level function under a name libm also declares
    // (`std/log.fn`'s own real `log`) collides with `<math.h>`'s
    // declaration of the same bare name if this were unconditional.
    if !self.skip_math_h {
      self.state.write("#include <math.h>\n");
    }
    // `stdout`/`stderr`/`stdin` are macros/globals (not callable), and
    // differ per libc -- wrapping each in a tiny `static` function lets
    // `std.c.io`'s own bodyless `stdout_stream()`/`stderr_stream()`/
    // `stdin_stream()` bindings resolve portably, matching the original
    // transpiler's own identical prelude helpers exactly. Only `stderr_
    // stream` was ever added here before (needed unconditionally by
    // `panic`/`assert`'s own codegen) -- `stdout_stream`/`stdin_stream`
    // were simply missing, found via a real stage-2 self-compilation C
    // error ("call to undeclared function 'stdout_stream'") for `std/
    // io.fn`'s own real `print`/`read_line` bodies.
    self.state.write(`static FILE* stdout_stream(void){ return stdout; }
    `static FILE* stderr_stream(void){ return stderr; }
    `static FILE* stdin_stream(void){ return stdin; }
    ``);
    // Runtime helpers backing the `__fun_key_hash` intrinsic (see
    // `emit_call`'s own doc comment) -- an FNV-1a-style hash, matching
    // the original transpiler's own identical prelude helpers exactly.
    // Always emitted, same "cheap, harmless when unused" reasoning as
    // every other prelude helper here.
    self.state.write(`static long long __fun_str_key_hash(const char* s) { long long h = 2166136261LL; if (s) { for (; *s; ++s) { h ^= (unsigned char)*s; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } } if (h < 0) h = -h; return h; }
    `static long long __fun_bytes_key_hash(const void* p, unsigned long n) { long long h = 2166136261LL; const unsigned char* b = (const unsigned char*)p; for (unsigned long i = 0; i < n; ++i) { h ^= b[i]; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } if (h < 0) h = -h; return h; }
    ``);
    // `__fun_tag(x)` maps a single vararg's own C type to the one-
    // character tag `emit_call`'s own call-site tagging embeds in
    // `__fun_vtags` (see `emit_function_named`'s own doc comment for the
    // callee-side unpacking that reads it back) -- matching the original
    // transpiler's own identical macro exactly.
    self.state.write("#define __fun_tag(x) _Generic((x), char*: 's', const char*: 's', long long: 'n', long: 'n', int: 'n', unsigned long long: 'n', unsigned long: 'n', unsigned int: 'n', double: 'd', float: 'd', _Bool: 'b', char: 'c', void*: 'p', default: 'p')\n");
    // Directory iteration/creation/kind-check helpers for `std.c.dirent`
    // (backing `std.fs`'s `list_dir`/`walk_dir`/`is_dir`/`make_dir`). Real
    // libc directory APIs differ enough across platforms (POSIX opendir/
    // readdir/DIR* vs. Win32 FindFirstFile/FindNextFile) that hand-
    // written wrappers -- same approach as `stdout_stream` above -- are
    // the portable option, each signature matched to a Fun type exactly
    // (`void*` <-> `raw*`, `long long` <-> `num`, `char*`/`const char*`
    // <-> `str`). Matches the original transpiler's own identical
    // prelude helpers exactly, both platform branches. Found via a real
    // stage-2 self-compilation C error ("call to undeclared function
    // '__fun_dir_open'") for `std/fs.fn`'s own real directory-walking
    // bodies.
    self.state.write(`#ifdef _WIN32
    `#include <windows.h>
    `#include <direct.h>
    `#include <sys/stat.h>
    `typedef struct { HANDLE h; WIN32_FIND_DATAA data; int started; } __fun_dir_iter;
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; char pattern[4096]; snprintf(pattern, sizeof(pattern), "%s\\*", path); __fun_dir_iter* it = (__fun_dir_iter*)malloc(sizeof(__fun_dir_iter)); if (!it) return NULL; it->h = FindFirstFileA(pattern, &it->data); it->started = 0; if (it->h == INVALID_HANDLE_VALUE) { free(it); return NULL; } return it; }
    `static char* __fun_dir_read_name(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return NULL; if (it->started) { if (!FindNextFileA(it->h, &it->data)) return NULL; } else { it->started = 1; } return it->data.cFileName; }
    `static long long __fun_dir_close(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return -1; FindClose(it->h); free(it); return 0; }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct _stat st; if (_stat(path, &st) != 0) return 0; return (st.st_mode & _S_IFDIR) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return _mkdir(path); }
    `#else
    `#include <dirent.h>
    `#include <sys/stat.h>
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; return (void*)opendir(path); }
    `static char* __fun_dir_read_name(void* dirp) { if (!dirp) return NULL; struct dirent* e = readdir((DIR*)dirp); return e ? e->d_name : NULL; }
    `static long long __fun_dir_close(void* dirp) { if (!dirp) return -1; return (long long)closedir((DIR*)dirp); }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct stat st; if (stat(path, &st) != 0) return 0; return S_ISDIR(st.st_mode) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return mkdir(path, 0755); }
    `#endif
    ``);
    // The compiler's own private thread primitive -- always emitted,
    // regardless of whether this program uses `fork`/`async`/channels.
    // `await`/`fork` support (ported next) build directly on
    // `__fun_thread_start`/`__fun_thread_join`; the M:N scheduler
    // (`fork`'s own task queue) builds on top of THIS, not the other way
    // around. Kept as a byte-for-byte copy of the original implementation's
    // own prelude text for this layer.
    self.state.write(`#ifdef _WIN32
    `#include <windows.h>
    `typedef HANDLE __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `typedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;
    `static DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 0, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }
    `static int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }
    `#else
    `#include <pthread.h>
    `typedef pthread_t __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { return pthread_create(t, NULL, entry, arg); }
    `static int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }
    `#endif
    ``);
    // `std.c.net`'s own POSIX socket bindings (`socket`/`bind`/`listen`/
    // `accept`/`recv`/`send`/`close`) resolved to undeclared library
    // functions -- same "no way to see which std.c.* modules a program
    // imports" reasoning as every other prelude header here, so always
    // emitted. Copied verbatim from the original transpiler's own
    // identical (there, conditionally emitted) block, including its
    // Windows/POSIX split -- untested on Windows by this port itself,
    // but matches ALREADY-shipped, already-reviewed behavior exactly
    // rather than inventing a new one.
    self.state.write(`#if defined(_WIN32)
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#include <winsock2.h>
    `#include <ws2tcpip.h>
    `#pragma comment(lib, "Ws2_32.lib")
    `#ifndef close
    `#define close closesocket
    `#endif
    `#else
    `#include <sys/socket.h>
    `#include <netinet/in.h>
    `#include <arpa/inet.h>
    `#include <unistd.h>
    `#endif
    ``);
    // A plain (non-fork) program can still deadlock on a channel wait (e.g.
    // a lone `ch.recv()` with no sender) -- `std/channel.fn` calls
    // `__fun_wd_enter_wait`/`__fun_wd_leave_wait` around every blocking wait
    // unconditionally, so these three symbols must always exist regardless
    // of whether `fork` is used. When `fork` ISN'T used anywhere, this
    // minimal, self-contained watchdog (no task queue to track, since
    // nothing is scheduled -- just "at least one blocking wait open, no
    // progress for the configured threshold") is emitted; when `fork` IS
    // used, `emit_scheduler_runtime` below emits its OWN alternative
    // watchdog (integrated with the scheduler's task queue) instead, and
    // defines the same three symbols there. Dormant unless
    // FUN_DEADLOCK_WATCHDOG_MS is set. Byte-for-byte copy of the original
    // implementation's own text for this block.
    if self.uses_fork {
      self.emit_scheduler_runtime();
    } else {
      self.state.write(`typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
      `static __fun_wd_state __fun_g_wd;
      `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
      `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
      `}
      `static void* __fun_wd_thread(void* unused){ (void)unused;
      `  long long last_seq=-1; long long stall_ms=0;
      `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
      `  for(;;){
      `#ifdef _WIN32
      `    Sleep((DWORD)step);
      `#else
      `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
      `#endif
      `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
      `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
      `    last_seq=seq;
      `    if(stall_ms>=__fun_g_wd.threshold_ms){
      `      __fun_wd_warn((long long)blk, 0, stall_ms);
      `      if(__fun_g_wd.abort_on_fire) abort();
      `      stall_ms=0;
      `    }
      `  }
      `}
      `void __fun_wd_enter_wait(void){
      `  if(!__fun_g_wd.started){
      `    __fun_g_wd.started=1;
      `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
      `    long long wm=(w && w[0])?atoll(w):0;
      `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
      `    const char* a=getenv("FUN_DEADLOCK_ABORT");
      `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
      `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
      `  }
      `  if(!__fun_g_wd.armed) return;
      `  __fun_g_wd.blocked++;
      `}
      `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
      ``);
    }
  }

  // Emits the M:N cooperative task scheduler runtime used by `fork`: a
  // fixed pool of OS worker threads (sized to the CPU count) drains a
  // shared FIFO task queue; each `fork f(args)` enqueues one task (a
  // function pointer plus a heap-allocated argument payload, see
  // `emit_async_function_support`'s own fork-helper section) which a
  // worker pops and runs to completion. Genuine M:N scheduling (many
  // cheap `fork` tasks onto a few OS threads), not one-thread-per-fork
  // the way `await` is. The pool starts lazily on the first fork;
  // `__fun_sched_wait_idle()` blocks until every queued task has run --
  // deliberately NOT wired up to run automatically at every `main` exit
  // point yet (the original's own `emit_fork_wait_idle_if_main`), so an
  // orphaned `fork` with no other synchronization (no `WaitGroup`/
  // channel recv afterward) isn't guaranteed to finish before `main`
  // returns -- every real use in this codebase's own stdlib (`std/task.
  // fn`/`std/testing.fn`/`std/process.fn`) already synchronizes via a
  // `WaitGroup`/channel, so this doesn't block getting `fork` itself
  // working. Cooperative, not preemptive: a task that blocks (e.g. on a
  // channel op) holds its worker -- the yield points are the blocking
  // primitives. Reuses the prelude's `__fun_thread_start`/
  // `__fun_thread_t` (already emitted above, POSIX + Windows both).
  // Byte-for-byte copy of the original implementation's own text.
  emit_scheduler_runtime() {
    self.state.write(` // --- M:N cooperative virtual-thread scheduler (the fork keyword) ---
    `typedef void (*__fun_task_fn)(void*);
    `typedef struct __fun_task { __fun_task_fn fn; void* arg; } __fun_task;
    `#ifdef _WIN32
    `typedef CRITICAL_SECTION __fun_sched_mtx; typedef CONDITION_VARIABLE __fun_sched_cv;
    `static void __fun_sched_mtx_init(__fun_sched_mtx* m){InitializeCriticalSection(m);}
    `static void __fun_sched_mtx_lock(__fun_sched_mtx* m){EnterCriticalSection(m);}
    `static void __fun_sched_mtx_unlock(__fun_sched_mtx* m){LeaveCriticalSection(m);}
    `static void __fun_sched_cv_init(__fun_sched_cv* c){InitializeConditionVariable(c);}
    `static void __fun_sched_cv_wait(__fun_sched_cv* c, __fun_sched_mtx* m){SleepConditionVariableCS(c, m, INFINITE);}
    `static void __fun_sched_cv_signal(__fun_sched_cv* c){WakeConditionVariable(c);}
    `static void __fun_sched_cv_broadcast(__fun_sched_cv* c){WakeAllConditionVariable(c);}
    `static int __fun_cpu_count(void){SYSTEM_INFO si; GetSystemInfo(&si); int n=(int)si.dwNumberOfProcessors; return n>0?n:1;}
    `#else
    `typedef pthread_mutex_t __fun_sched_mtx; typedef pthread_cond_t __fun_sched_cv;
    `static void __fun_sched_mtx_init(__fun_sched_mtx* m){pthread_mutex_init(m,NULL);}
    `static void __fun_sched_mtx_lock(__fun_sched_mtx* m){pthread_mutex_lock(m);}
    `static void __fun_sched_mtx_unlock(__fun_sched_mtx* m){pthread_mutex_unlock(m);}
    `static void __fun_sched_cv_init(__fun_sched_cv* c){pthread_cond_init(c,NULL);}
    `static void __fun_sched_cv_wait(__fun_sched_cv* c, __fun_sched_mtx* m){pthread_cond_wait(c,m);}
    `static void __fun_sched_cv_signal(__fun_sched_cv* c){pthread_cond_signal(c);}
    `static void __fun_sched_cv_broadcast(__fun_sched_cv* c){pthread_cond_broadcast(c);}
    `#include <unistd.h>
    `#include <time.h>
    `static int __fun_cpu_count(void){long n=sysconf(_SC_NPROCESSORS_ONLN); return n>0?(int)n:1;}
    `#endif
    `#define __FUN_SCHED_QCAP 4096
    `typedef struct __fun_sched {
    `  __fun_sched_mtx mu; __fun_sched_cv not_empty; __fun_sched_cv not_full; __fun_sched_cv idle;
    `  __fun_task q[__FUN_SCHED_QCAP]; int head, tail, count;
    `  long long pending;
    `  int started, shutting_down, nworkers;
    `  int wd_armed; long long wd_threshold_ms; int wd_abort;
    `  int blocked; long long progress_seq;
    `} __fun_sched;
    `static __fun_sched __fun_g_sched;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `void __fun_wd_enter_wait(void){ if(!__fun_g_sched.wd_armed) return; __fun_sched_mtx_lock(&__fun_g_sched.mu); __fun_g_sched.blocked++; __fun_sched_mtx_unlock(&__fun_g_sched.mu); }
    `void __fun_wd_leave_wait(void){ if(!__fun_g_sched.wd_armed) return; __fun_sched_mtx_lock(&__fun_g_sched.mu); if(__fun_g_sched.blocked>0)__fun_g_sched.blocked--; __fun_g_sched.progress_seq++; __fun_sched_mtx_unlock(&__fun_g_sched.mu); }
    `static void* __fun_sched_watchdog(void* unused){ (void)unused;
    `  long long last_seq = -1; long long stall_ms = 0;
    `  long long step = __fun_g_sched.wd_threshold_ms/4; if(step<1) step=1; if(step>1000) step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `    long long pend=__fun_g_sched.pending; int blk=__fun_g_sched.blocked; int nw=__fun_g_sched.nworkers;
    `    long long seq=__fun_g_sched.progress_seq; int down=__fun_g_sched.shutting_down;
    `    __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `    if(down) return NULL;
    `    (void)nw;
    `    if(pend>0 && blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_sched.wd_threshold_ms){
    `      __fun_wd_warn((long long)blk, pend, stall_ms);
    `      if(__fun_g_sched.wd_abort) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `static void* __fun_sched_worker(void* unused){ (void)unused;
    `  for(;;){
    `    __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `    while(__fun_g_sched.count==0 && !__fun_g_sched.shutting_down)
    `      __fun_sched_cv_wait(&__fun_g_sched.not_empty, &__fun_g_sched.mu);
    `    if(__fun_g_sched.count==0 && __fun_g_sched.shutting_down){ __fun_sched_mtx_unlock(&__fun_g_sched.mu); return NULL; }
    `    __fun_task t = __fun_g_sched.q[__fun_g_sched.head];
    `    __fun_g_sched.head = (__fun_g_sched.head+1) % __FUN_SCHED_QCAP;
    `    __fun_g_sched.count--;
    `    if(__fun_g_sched.wd_armed) __fun_g_sched.progress_seq++;
    `    __fun_sched_cv_signal(&__fun_g_sched.not_full);
    `    __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `    if(t.fn) t.fn(t.arg);
    `    __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `    __fun_g_sched.pending--;
    `    if(__fun_g_sched.wd_armed) __fun_g_sched.progress_seq++;
    `    if(__fun_g_sched.pending==0) __fun_sched_cv_broadcast(&__fun_g_sched.idle);
    `    __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `  }
    `}
    `static void __fun_sched_init_once(void){
    `  static int once=0; if(once) return; once=1;
    `  __fun_sched_mtx_init(&__fun_g_sched.mu);
    `  __fun_sched_cv_init(&__fun_g_sched.not_empty);
    `  __fun_sched_cv_init(&__fun_g_sched.not_full);
    `  __fun_sched_cv_init(&__fun_g_sched.idle);
    `  { const char* w = getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm = (w && w[0]) ? atoll(w) : 0;
    `    __fun_g_sched.wd_armed = (wm > 0) ? 1 : 0;
    `    __fun_g_sched.wd_threshold_ms = (wm > 0) ? wm : 0;
    `    const char* a = getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_sched.wd_abort = (a && a[0]=='1') ? 1 : 0;
    `    __fun_g_sched.blocked = 0; __fun_g_sched.progress_seq = 0; }
    `}
    `static void __fun_sched_ensure_started(void){
    `  __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `  if(!__fun_g_sched.started){
    `    __fun_g_sched.started=1; __fun_g_sched.head=__fun_g_sched.tail=__fun_g_sched.count=0;
    `    __fun_g_sched.pending=0; __fun_g_sched.shutting_down=0;
    `    int n=__fun_cpu_count(); if(n<1)n=1; if(n>64)n=64; __fun_g_sched.nworkers=n;
    `    for(int i=0;i<n;i++){ __fun_thread_t th; __fun_thread_start(&th, __fun_sched_worker, NULL); }
    `    if(__fun_g_sched.wd_armed){ __fun_thread_t wt; __fun_thread_start(&wt, __fun_sched_watchdog, NULL); }
    `  }
    `  __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `}
    `static void __fun_go(__fun_task_fn fn, void* arg){
    `  __fun_sched_init_once(); __fun_sched_ensure_started();
    `  __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `  while(__fun_g_sched.count==__FUN_SCHED_QCAP && !__fun_g_sched.shutting_down)
    `    __fun_sched_cv_wait(&__fun_g_sched.not_full, &__fun_g_sched.mu);
    `  if(__fun_g_sched.shutting_down){ __fun_sched_mtx_unlock(&__fun_g_sched.mu); if(fn) fn(arg); return; }
    `  __fun_g_sched.q[__fun_g_sched.tail].fn=fn; __fun_g_sched.q[__fun_g_sched.tail].arg=arg;
    `  __fun_g_sched.tail=(__fun_g_sched.tail+1)%__FUN_SCHED_QCAP; __fun_g_sched.count++; __fun_g_sched.pending++;
    `  if(__fun_g_sched.wd_armed) __fun_g_sched.progress_seq++;
    `  __fun_sched_cv_signal(&__fun_g_sched.not_empty);
    `  __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `}
    `static void __fun_sched_wait_idle(void){
    `  if(!__fun_g_sched.started) return;
    `  __fun_sched_mtx_lock(&__fun_g_sched.mu);
    `  while(__fun_g_sched.pending>0) __fun_sched_cv_wait(&__fun_g_sched.idle, &__fun_g_sched.mu);
    `  __fun_sched_mtx_unlock(&__fun_g_sched.mu);
    `}
    `
    ``);
  }

  // Transpiles every top-level `Enum`/`Compound`/`Impl`/`Function` node
  // in `nodes` (anything else is skipped -- not an error, since a
  // whole-file parse can contain declarations not reachable yet, like
  // `imp`). EVERY impl's methods are pre-registered
  // (`register_impl_methods`) FIRST, before enums or compounds are even
  // looked at -- a generic impl's own template must already be in
  // `generic_impl_templates` before the enum/compound pass runs, since a
  // plain compound/enum's OWN field can itself be a generic
  // instantiation (`compound Lexer { Vec<Token> tokens; }`) that
  // immediately triggers monomorphizing `Vec<T>`'s own methods (see
  // `pub transpile`'s own inline comment for the bug this ordering
  // fixes). Enums are emitted next (registering their names/variants as
  // a side effect -- see `emit_enum`'s doc comment), then compounds, all
  // before any impl-method/function BODY is generated -- so a method
  // calling another type's method, or referencing an enum/compound,
  // resolves correctly regardless of which declaration comes first in
  // source order (see `emit_compound`'s doc comment for what that pass
  // deliberately doesn't handle yet: dependency ordering between
  // compounds themselves). Impl methods are then emitted (each becomes
  // an ordinary C function, see `emit_impl`) in a fourth pass, before
  // plain top-level functions in a fifth, so a plain function calling a
  // method doesn't need a forward declaration.
  pub transpile(Vec<Node> nodes) Option<CodegenErrorKind> {
    self.all_nodes = nodes;
    // Computed before the prelude is written -- not read yet (see
    // `uses_fork`'s own doc comment), but the original implementation
    // requires this ordering once the scheduler starts reading it, so
    // matching it now avoids a reorder later.
    self.uses_fork = uses_fork_in(nodes);
    self.skip_math_h = program_defines_libm_colliding_name(nodes);
    self.write_prelude();
    self.register_function_signatures(nodes);
    // Registers every GENERIC quirk's own declaration -- pure bookkeeping,
    // no C text -- before anything that could reference a CONCRETE
    // instantiation of one as a bare type (a function parameter/return
    // type, e.g.) needs to resolve it. See `Codegen.quirk_decl_names`'s
    // own doc comment for why this can't just wait for a concrete impl to
    // be processed first.
    for n : nodes {
      fit n.kind {
        .Quirk(q) -> {
          if q.has_type_params {
            self.quirk_decl_names.push(q.name);
            self.quirk_decl_type_params.push(q.type_params);
            self.quirk_decl_methods.push(q.methods);
          }
        }
        _ -> {}
      }
    }
    // Impl methods are pre-registered FIRST, before either the enum or
    // compound pass -- a generic impl's own template must already be in
    // `generic_impl_templates` by the time `emit_enum`/`emit_compound`
    // run, since a NON-generic compound/enum's OWN field can itself be a
    // generic instantiation (`compound Lexer { Vec<Token> tokens; }`)
    // that immediately triggers `maybe_instantiate_generic_impl_methods`
    // -- registering impls AFTER the enum/compound pass (the previous
    // order) meant that first-use trigger found no template registered
    // yet, silently skipping Vec<T>'s own methods instead of
    // monomorphizing them.
    for n : nodes {
      fit n.kind {
        .Impl(i) -> { self.register_impl_methods(n); }
        _ -> {}
      }
    }
    // Forward-declares every PLAIN (non-generic) compound's own struct
    // NAME (`typedef struct X X;`, no body) before ANY compound/enum's
    // FULL body -- OR the function-prototype pass right below, which
    // needs every type NAME nameable regardless of param/return
    // position -- is emitted. Mirrors the original implementation's
    // own identical forward-typedef pass exactly. `emit_compound`/
    // `emit_enum` themselves rely purely on SOURCE ORDER (a type
    // referencing another must be declared textually after it), which
    // breaks down for a set of MUTUALLY self-referential compounds
    // (`selfhost/ast/ast.fn`'s own real `Node`/`ExprNode`/
    // `VariableNode`/... -- found via the stage-2 self-compilation
    // attempt: codegen itself succeeds with zero unsupported-node
    // errors, but the resulting C fails with "unknown type name" for
    // exactly these types, since nothing ever forward-declares a NAME
    // used by POINTER before its own full definition is reached). Only
    // handles COMPOUNDS directly below -- a PLAIN (non-generic) tagged-
    // union enum needs the exact same treatment for a SELF-referential
    // (or mutually-referential) pointer payload (`enum Expr { Neg(Expr*),
    // ... }`, `examples/imports/torture_compiler/ast.fn`'s own real
    // body) -- confirmed via the original transpiler's own identical
    // blanket forward-declare pass, which covers every struct-backed
    // type (compounds AND tagged-union enums alike), not just compounds.
    for n : nodes {
      fit n.kind {
        .Compound(c) -> {
          if !c.has_type_params && !self.is_std_c_signature_node(n) {
            self.state.write("typedef struct ");
            self.state.write(c.name);
            self.state.write(" ");
            self.state.write(c.name);
            self.state.write(";\n");
          }
        }
        .Enum(e) -> {
          if !e.has_type_params {
            bin en_is_tagged_union = false;
            for v : e.variants {
              if v.has_payload && v.payload.len > 0 {
                en_is_tagged_union = true;
              }
            }
            if en_is_tagged_union {
              self.state.write("typedef struct ");
              self.state.write(e.name);
              self.state.write(" ");
              self.state.write(e.name);
              self.state.write(";\n");
            }
          }
        }
        _ -> {}
      }
    }
    // Registers every GENERIC enum/compound TEMPLATE (pure bookkeeping,
    // no C text -- see `emit_enum`/`emit_compound`'s own `has_type_
    // params` branches) before the function-prototype pass just below
    // -- a plain function/method's OWN signature can reference a
    // generic instantiation (`fun wrap<T>(T value) Opt<T>`'s `main`
    // caller returning `Opt<num>` directly, e.g.), which needs the
    // template already known to resolve at all. Also needed before ANY
    // non-generic type's OWN fields get resolved further below (a
    // plain type's field can itself be a generic instantiation,
    // `compound Lexer { Vec<Token> tokens; }`).
    for n : nodes {
      fit n.kind {
        .Enum(e) -> {
          if e.has_type_params {
            let eerr = self.emit_enum(n);
            if eerr.is_some() {
              ret eerr;
            }
          }
        }
        .Compound(c) -> {
          if c.has_type_params {
            let cerr = self.emit_compound(n);
            if cerr.is_some() {
              ret cerr;
            }
          }
        }
        _ -> {}
      }
    }
    // Forward-declares every PLAIN (non-generic) top-level function's
    // AND every plain impl's own method's C prototype, before ANY of
    // their bodies -- `emit_function`/`emit_impl` themselves rely
    // purely on SOURCE order (a function calling another must be
    // declared textually after it), which breaks down the moment ANY
    // plain function/method calls another declared LATER in the file.
    // Mirrors the plain-compound forward-declare pass just above, for the
    // same reason. Found via a real stage-2 self-compilation C error
    // ("call to undeclared function") for `std/string.fn`'s own
    // `_str_len`/`_str_cmp`/`format_num`, called from `impl Vec<str> {
    // ... }`'s own methods -- a plain impl whose methods only actually
    // got reached once the type-param-constraint fix (see `impl_allows_
    // generic_args`'s own doc comment) stopped a WRONG generic template
    // from shadowing it, so this ordering gap was never hit before.
    // 
    // Positioned here, right after `register_impl_methods` -- NOT
    // further down alongside the plain-compound pass, where this was
    // tried first -- because a plain impl method can get called from
    // WAY earlier than its own textual position: a GENERIC method
    // reached lazily during the enum/compound pass below (`Vec<T>`'s
    // own `push` calling `self.grow()`) can resolve to a CONCRETE
    // override (`impl Vec<str> { pub grow() {...} }`, registered by
    // `register_impl_methods` just above) and get its body emitted
    // right then -- long before a forward-declare pass positioned
    // alongside the later compound/impl/function passes would ever
    // run.
    // 
    // Excludes a `std/c/*.fn` binding node (see `is_std_c_signature_
    // node`'s own doc comment) -- one of those exists purely to
    // typecheck against an ALREADY-`#include`d system header's own
    // real declaration (`malloc`/`printf`/...), so forward-declaring
    // it here too is a competing, conflicting-types redeclaration, not
    // a harmless duplicate. Also excludes any function/method whose
    // own signature isn't SAFE this early (see `prototype_type_is_
    // unsafe_early`'s own doc comment) -- one calling another declared
    // later in the file, where EITHER end's signature involves a plain
    // enum or generic instantiation, falls back to depending on
    // natural source order, same as before this pass existed.
    // 
    // Also excludes `main` outright -- `emit_function_prototype`
    // doesn't know about `main`'s own special C-entry-point signature
    // handling (see `emit_function_named`'s own doc comment: forced
    // `int`, forced `argc`/`argv`), so a forward-declared prototype
    // here would have the WRONG (naive) signature, disagreeing with
    // the real definition emitted later ("conflicting types"). Not a
    // real gap: nothing else in the program ever calls `main`
    // recursively, so it never NEEDED forward-declaring to begin with.
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          if !f.has_type_params && !self.is_std_c_signature_node(n) && !equals(f.name, "main") && !f.is_variadic && self.function_prototype_is_safe_early(n) {
            self.hoist_insert_pos = .Some(self.state.out.len());
            let ferr = self.emit_function_prototype(n);
            if ferr.is_some() {
              ret ferr;
            }
          }
        }
        .Impl(i) -> {
          if !i.has_type_params {
            for m : i.methods {
              if self.is_std_c_signature_node(*m) || !self.function_prototype_is_safe_early(*m) {
                continue;
              }
              self.hoist_insert_pos = .Some(self.state.out.len());
              let merr = self.emit_function_prototype(*m);
              if merr.is_some() {
                ret merr;
              }
            }
          }
        }
        _ -> {}
      }
    }
    // Top-level `const`/`let` globals are emitted BEFORE enums/compounds
    // -- not just before impls/functions, as an earlier version of this
    // ordering had it. Every OTHER pass here can lazily HOIST a
    // monomorphized generic definition to whatever `self.state.out.len()`
    // happens to be at the moment it's first triggered (see
    // `Codegen.hoist_insert_pos`'s doc comment) -- and that first trigger
    // can fire as early as the ENUM/COMPOUND pass itself (e.g. a plain
    // compound field whose type is a generic instantiation, `compound
    // WaitGroup { Channel<num> done_ch; }`-shaped). A global emitted
    // AFTER that point would land textually LATER than a hoisted method
    // body that already references it -- a real bug found via `std/task
    // .fn`'s own real `WaitGroup`, whose generic `Channel<num>` field
    // triggers `Channel<T>`'s methods (which reference `std/channel.fn`'s
    // own `CHANNEL_RC_OK`-shaped constants) to hoist during the compound
    // pass below, before a later-positioned global pass had run at all.
    // Constants are simple literals with no compound/enum type
    // dependency of their own (confirmed across every real one in this
    // codebase's stdlib), so moving them first has nothing to lose.
    for n : nodes {
      fit n.kind {
        .Variable(v) -> {
          self.hoist_insert_pos = .Some(self.state.out.len());
          let gerr = self.emit_global_variable(n);
          if gerr.is_some() {
            ret gerr;
          }
        }
        _ -> {}
      }
    }
    // Every PLAIN (non-generic) enum/compound is emitted lazily, on
    // first reference, instead of via two flat "all enums, then all
    // compounds" passes -- see `ensure_plain_type_emitted`'s own doc
    // comment for why a flat pass order can't satisfy every real
    // dependency direction (a tagged-union enum embedding a compound
    // BY VALUE needs that compound emitted first; a compound embedding
    // a tagged-union enum BY VALUE needs the reverse -- BOTH shapes are
    // real, in different stdlib files, found via the stage-2 self-
    // compilation attempt). Iterating `nodes` here just walks every
    // plain type in SOURCE order and ensures each is emitted -- most
    // will already be done by the time this reaches them, having been
    // pulled in as a DEPENDENCY of an earlier one.
    for n : nodes {
      fit n.kind {
        .Enum(e) -> {
          if !e.has_type_params {
            let eerr2 = self.ensure_plain_type_emitted(e.name);
            if eerr2.is_some() {
              ret eerr2;
            }
          }
        }
        .Compound(c) -> {
          if !c.has_type_params {
            let cerr2 = self.ensure_plain_type_emitted(c.name);
            if cerr2.is_some() {
              ret cerr2;
            }
          }
        }
        _ -> {}
      }
    }
    // Forces a CONCRETE monomorphizing impl's own target type (`impl
    // Vec<num> { ... }`, `i.concrete_dtype` holding the real `Vec<num>`
    // DataType this was mangled FROM -- see `ImplNode.concrete_dtype`'s
    // own doc comment) to be instantiated NOW, before this impl's own
    // method bodies are emitted below. Positioned AFTER the enum/
    // compound pass above (so `Vec<T>`'s own TEMPLATE is registered by
    // now -- `ensure_compound_instantiated`/`ensure_enum_instantiated`
    // both need that) but BEFORE the impl-body pass below: a method's
    // own implicit `self` parameter is already a bare, non-generic
    // `Vec__num*` (see `_parse_impl_method`'s `self`-injection), so
    // referencing `self.<field>` inside such a method NEVER goes
    // through the ordinary "a generic_args-bearing DataType triggers
    // lazy instantiation" path at all -- without this, `Vec__num`'s own
    // field records only exist if something ELSE in the program
    // happens to instantiate `Vec<num>` first, which isn't guaranteed
    // (a real bug found via `std/set.fn`'s own `impl Set<num> as
    // Display`, whose `self.map.len` failed to resolve when nothing
    // else in the compiled program's import graph had already used
    // `Set<num>`). Tries compound first, then enum (either the target
    // is a generic compound or a generic tagged-union enum); neither
    // matching is not an error here -- a plain, already-non-generic
    // impl's `has_concrete_dtype` is simply false and skips this
    // entirely.
    for n : nodes {
      fit n.kind {
        .Impl(i) -> {
          if !i.has_type_params && i.has_concrete_dtype {
            self.hoist_insert_pos = .Some(self.state.out.len());
            let forced_compound = self.ensure_compound_instantiated(*i.concrete_dtype);
            if forced_compound.is_none() {
              self.ensure_enum_instantiated(*i.concrete_dtype);
            }
          }
        }
        _ -> {}
      }
    }
    // A single COMBINED pass, walking `nodes` once in true source order,
    // emits every plain impl's methods AND every plain function's body --
    // NOT two separate flat "all impls, then all functions" passes (the
    // previous shape here). Two flat passes unconditionally emit every
    // impl method BEFORE every plain function, even when a plain
    // function is textually EARLIER in source and an impl method calls
    // it -- exactly `std/warnings.fn`'s own `WarningId as From<str>`
    // (an impl method) calling the plain function `warning_id_from_
    // string`, declared earlier in the same file: both are excluded from
    // the early forward-declare pass above (`Option<WarningId>` is a
    // generic instantiation, see `prototype_type_is_unsafe_early`'s own
    // doc comment), so ordering falls back to natural source position --
    // and the flat two-pass shape got that position wrong. Same
    // "one combined pass, source order" fix already applied to plain
    // enums/compounds above.
    for n : nodes {
      fit n.kind {
        .Impl(i) -> {
          self.hoist_insert_pos = .Some(self.state.out.len());
          let ierr = self.emit_impl(n);
          if ierr.is_some() {
            ret ierr;
          }
          let qerr = self.emit_quirk_vtable_machinery(n);
          if qerr.is_some() {
            ret qerr;
          }
        }
        .Function(f) -> {
          if !f.has_type_params {
            self.hoist_insert_pos = .Some(self.state.out.len());
            let ferr = self.emit_function(n);
            if ferr.is_some() {
              ret ferr;
            }
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }
}

test "write_type emits builtin scalar C types with pointer depth" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "num";
  g.write_type(dt);
  assert equals(st.out.build(), "int64_t"), "expected 'int64_t'";

  CodegenState st2 = codegen_state_new();
  Codegen g2 = codegen_new(&st2);
  DataType dt2 = dtype_new();
  dt2.type_str = "chr";
  dt2.pointer_depth = 2;
  g2.write_type(dt2);
  assert equals(st2.out.build(), "char**"), "expected 'char**'";
}

test "write_type emits a sized int via dynamic_int_type_to_c" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "u32";
  g.write_type(dt);
  assert equals(st.out.build(), "uint32_t"), "expected 'uint32_t'";
}

test "emit_expr emits a number literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Number(TokenData.Num(42)));
  assert g.emit_expr(n).is_none(), "expected the number to emit";
  assert equals(st.out.build(), "42"), "expected '42'";
}

test "emit_expr emits a string literal verbatim between quotes" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("hello"));
  assert g.emit_expr(n).is_none(), "expected the string to emit";
  assert equals(st.out.build(), "\"hello\""), "expected a quoted string";
}

test "emit_expr escapes a raw string's literal bytes when node.flags.is_raw_string is set" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("C:\\Users\\name"));
  n.flags.is_raw_string = true;
  assert g.emit_expr(n).is_none(), "expected the raw string to emit";
  // Each literal backslash must become an escaped pair in the C output.
  assert equals(st.out.build(), "\"C:\\\\Users\\\\name\""), "expected backslashes escaped for C";
}

test "emit_expr escapes an embedded double-quote and newline in a raw string" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("she said \"hi\"\nbye"));
  n.flags.is_raw_string = true;
  assert g.emit_expr(n).is_none(), "expected the raw string to emit";
  assert equals(st.out.build(), "\"she said \\\"hi\\\"\\nbye\""), "expected the quote and newline escaped for C";
}

test "emit_expr emits a boolean literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Boolean(true));
  assert g.emit_expr(n).is_none(), "expected the boolean to emit";
  assert equals(st.out.build(), "true"), "expected 'true'";
}

test "emit_expr emits the nil literal as C NULL" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Nil);
  assert g.emit_expr(n).is_none(), "expected 'nil' to emit";
  assert equals(st.out.build(), "NULL"), "expected 'NULL'";
}

test "emit_expr emits a panic expression as a GNU statement expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(NodeKind.String("oops"));
  Node n = node_new(NodeKind.Panic(msg));
  assert g.emit_expr(n).is_none(), "expected the panic expression to emit";
  assert equals(
    st.out.build(),
    "({ fprintf(stderr_stream(), \"panic: %s\\n\", \"oops\"); abort(); 0; })"
  ), "expected the GNU statement-expression lowering, printing the message and aborting";
}

test "emit_statement emits a bare panic(...) as a statement" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(NodeKind.String("internal error"));
  Node n = node_new(NodeKind.Panic(msg));
  assert g.emit_statement(n).is_none(), "expected the bare panic statement to emit";
  assert equals(
    st.out.build(),
    "({ fprintf(stderr_stream(), \"panic: %s\\n\", \"internal error\"); abort(); 0; });\n"
  ), "expected the panic expression followed by a trailing ';\\n', same as any other bare-expression statement";
}

test "emit_statement emits 'assert cond, msg;' as an if/abort with the message printed" {
  // Regression test: `_lex`'s own real body in the self-hosted lexer's
  // own source (`assert !r.is_err(), "tokenize() returned an error";`)
  // -- found via the self-compile experiment -- was entirely unhandled
  // (`.StatementAssert` had no `emit_statement` case at all, rejected as
  // `CodegenErrorKind.UnsupportedNode`).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Boolean(false));
  Node* msg = malloc(sizeof(Node));
  *msg = node_new(NodeKind.String("should not happen"));
  AssertNode a;
  a.condition = cond;
  a.message = msg;
  a.has_message = true;
  Node n = node_new(NodeKind.StatementAssert(a));
  assert g.emit_statement(n).is_none(), "expected the assert statement to emit";
  assert equals(
    st.out.build(),
    "if (!(false)) { fprintf(stderr_stream(), \"Assertion failed: %s\\n\", \"should not happen\"); abort(); }\n"
  ), "expected an if/abort guard printing the assert's own message on failure";
}

test "emit_statement emits a message-less 'assert cond;' as a plain if/abort" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Boolean(true));
  AssertNode a;
  a.condition = cond;
  a.has_message = false;
  Node n = node_new(NodeKind.StatementAssert(a));
  assert g.emit_statement(n).is_none(), "expected the message-less assert statement to emit";
  assert equals(st.out.build(), "if (!(true)) { abort(); }\n"), "expected a plain if/abort guard with no message printed";
}

test "emit_expr escapes a character literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Character('\n'));
  assert g.emit_expr(n).is_none(), "expected the character to emit";
  assert equals(st.out.build(), "'\\n'"), "expected an escaped newline character literal";
}

test "emit_expr emits an identifier" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Identifier("x"));
  assert g.emit_expr(n).is_none(), "expected the identifier to emit";
  assert equals(st.out.build(), "x"), "expected 'x'";
}

test "emit_expr emits a prefix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "-";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(-x)"), "expected '(-x)'";
}

test "emit_expr emits pointer indirection as a run of stars" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "*";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("p"));
  u.operand = operand;
  u.has_indirection = true;
  u.indirection_depth = 2;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(**p)"), "expected '(**p)'";
}

test "emit_expr emits a postfix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = true;
  u.op = "++";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(x++)"), "expected '(x++)'";
}

test "emit_expr emits a binary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "+";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the expression to emit";
  assert equals(st.out.build(), "(a + b)"), "expected '(a + b)'";
}

test "emit_expr emits an explicit parenthesized sub-expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "+";
  Node* sum = malloc(sizeof(Node));
  *sum = node_new(NodeKind.Expression(e));
  Node n = node_new(NodeKind.ExpressionParenthesis(sum));
  assert g.emit_expr(n).is_none(), "expected the parenthesized expression to emit";
  assert equals(st.out.build(), "((a + b))"), "expected '((a + b))'";
}

test "emit_expr rejects an index/comma expression (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "[]";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected an index expression to be rejected this slice";
}

test "emit_expr emits a zero-arg call" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo()"), "expected 'foo()'";
}

test "emit_expr emits a multi-arg call, flattening the comma-chained argument list" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));

  Node* arg_a = malloc(sizeof(Node));
  *arg_a = node_new(NodeKind.Identifier("a"));
  Node* arg_b = malloc(sizeof(Node));
  *arg_b = node_new(NodeKind.Identifier("b"));
  ExprNode comma;
  comma.left = arg_a;
  comma.has_left = true;
  comma.right = arg_b;
  comma.has_right = true;
  comma.op = ",";
  Node* comma_node = malloc(sizeof(Node));
  *comma_node = node_new(NodeKind.Expression(comma));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(comma_node));

  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo(a, b)"), "expected 'foo(a, b)'";
}

test "emit_expr rejects a call whose callee isn't a plain identifier (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected a non-identifier callee to be rejected this slice";
}

test "emit_statement emits a variable declaration with an initializer" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "num";
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(5)));
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.val = val;
  v.has_val = true;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "int64_t x = 5;\n"), "expected 'int64_t x = 5;\\n'";
}

test "emit_statement emits a 'let' declaration as '__auto_type', inferring its type from a plain function call" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  FunctionNode fnv = function_node_new();
  fnv.name = "mk";
  fnv.has_name = true;
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  fnv.has_args = false;
  Node fn_node = node_new(NodeKind.Function(fnv));
  Vec<Node> sig_nodes;
  sig_nodes.init(0);
  sig_nodes.push(fn_node);
  g.register_function_signatures(sig_nodes);

  DataType* let_dt = malloc(sizeof(DataType));
  *let_dt = dtype_new();
  let_dt.type_str = "__let_infer__";
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("mk"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Expression(call_e));
  VariableNode v;
  v.var_type = let_dt;
  v.name = "r";
  v.val = val;
  v.has_val = true;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_none(), "expected the 'let' declaration to emit";
  assert equals(st.out.build(), "__auto_type r = mk();\n"), "expected '__auto_type', not the '__let_infer__' sentinel, in the emitted C";
  assert equals(g.lookup_local_type_name("r").unwrap(), "num"), "expected 'r' inferred as 'num' from mk's own declared return type, so a later fit/field access on 'r' still resolves";
}

test "emit_statement infers a 'let' declaration's type from a plain field-access initializer, so a chained field read off of it still resolves" {
  // Regression test: `ParseState.err`'s own real body (`let ct = self.
  // current_token; ... ct.pos.line ...`) -- found via the self-compile
  // experiment while verifying the new 'defer' feature -- rejected the
  // LATER `ct.pos.line` read as an unrecognized local, since
  // `infer_let_expr_type` had no case for a plain `.`-field-access
  // initializer at all (only a known local/literal/call). Fixed by
  // resolving the WHOLE chain via `resolve_field_chain`, the same
  // resolution a later read off of it would need.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "ParseState", true);

  Vec<str> ps_fields;
  ps_fields.init(0);
  ps_fields.push("current_token");
  Vec<str> ps_field_types;
  ps_field_types.init(0);
  ps_field_types.push("Token");
  Vec<bin> ps_field_ptrs;
  ps_field_ptrs.init(0);
  ps_field_ptrs.push(false);
  g.record_compound("ParseState", ps_fields, ps_field_types, ps_field_ptrs);

  Vec<str> tok_fields;
  tok_fields.init(0);
  tok_fields.push("pos");
  Vec<str> tok_field_types;
  tok_field_types.init(0);
  tok_field_types.push("Pos");
  Vec<bin> tok_field_ptrs;
  tok_field_ptrs.init(0);
  tok_field_ptrs.push(false);
  g.record_compound("Token", tok_fields, tok_field_types, tok_field_ptrs);

  DataType* let_dt = malloc(sizeof(DataType));
  *let_dt = dtype_new();
  let_dt.type_str = "__let_infer__";
  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(NodeKind.Identifier("self"));
  Node* ct_field_ident = malloc(sizeof(Node));
  *ct_field_ident = node_new(NodeKind.Identifier("current_token"));
  ExprNode field_e;
  field_e.left = self_ident;
  field_e.has_left = true;
  field_e.right = ct_field_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Expression(field_e));
  VariableNode v;
  v.var_type = let_dt;
  v.name = "ct";
  v.val = val;
  v.has_val = true;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_none(), "expected the 'let' declaration to emit";
  assert equals(st.out.build(), "__auto_type ct = self->current_token;\n"), "expected '__auto_type', not the '__let_infer__' sentinel, in the emitted C";
  assert equals(g.lookup_local_type_name("ct").unwrap(), "Token"), "expected 'ct' inferred as 'Token' from 'self.current_token's own declared field type, so a later 'ct.pos' read still resolves";
}

test "pub transpile resolves a 'fit' over a 'let'-declared local whose type was inferred from a method call" {
  // Regression test: `let last = self.tokens.last(); fit last { .Some(t)
  // -> {...} .None -> {...} }` (_prev_token_is_bare_zero's real body in
  // the self-hosted lexer's own source) used to fail -- `last`'s type
  // was recorded as the literal, un-inferred "__let_infer__" sentinel,
  // so `fit`'s bare-shorthand pattern match against it was rejected
  // (unrecognized "enum"). Fixed via infer_let_expr_type, resolving a
  // method-call initializer's type through the SAME resolve_field_chain
  // + lookup_impl_method_rtype lookups emit_fit's own call-subject
  // handling already uses.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  EnumDeclNode optd = enum_decl_node_new();
  optd.name = "Option";
  EnumVariant some_v = enum_variant_new();
  some_v.name = "Some";
  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "num";
  some_v.payload.push(pdt);
  some_v.has_payload = true;
  optd.variants.push(some_v);
  EnumVariant none_v = enum_variant_new();
  none_v.name = "None";
  optd.variants.push(none_v);
  Node opt_node = node_new(NodeKind.Enum(optd));

  CompoundNode holderc = compound_node_new();
  holderc.name = "Holder";
  CompoundField hf;
  hf.name = "v";
  DataType* hfdt = malloc(sizeof(DataType));
  *hfdt = dtype_new();
  hfdt.type_str = "num";
  hf.dtype = hfdt;
  holderc.fields.push(hf);
  Node holder_node = node_new(NodeKind.Compound(holderc));

  DataType* self_dt = malloc(sizeof(DataType));
  *self_dt = dtype_new();
  self_dt.type_str = "Holder";
  self_dt.pointer_depth = 1;
  VariableNode selfv;
  selfv.var_type = self_dt;
  selfv.name = "self";
  selfv.has_val = false;
  selfv.is_const = false;
  Node* self_param = malloc(sizeof(Node));
  *self_param = node_new(NodeKind.Variable(selfv));
  Vec<Node*> get_params;
  get_params.init(0);
  get_params.push(self_param);

  Node* self_ident_g = malloc(sizeof(Node));
  *self_ident_g = node_new(NodeKind.Identifier("self"));
  Node* v_ident = malloc(sizeof(Node));
  *v_ident = node_new(NodeKind.Identifier("v"));
  ExprNode field_e;
  field_e.left = self_ident_g;
  field_e.has_left = true;
  field_e.right = v_ident;
  field_e.has_right = true;
  field_e.op = ".";
  Node* field_expr = malloc(sizeof(Node));
  *field_expr = node_new(NodeKind.Expression(field_e));
  Node* get_blank = malloc(sizeof(Node));
  *get_blank = node_new(NodeKind.Blank);
  Node* some_ident = malloc(sizeof(Node));
  *some_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode some_dot;
  some_dot.left = get_blank;
  some_dot.has_left = true;
  some_dot.right = some_ident;
  some_dot.has_right = true;
  some_dot.op = ".";
  Node* some_dot_node = malloc(sizeof(Node));
  *some_dot_node = node_new(NodeKind.Expression(some_dot));
  Node* some_args = malloc(sizeof(Node));
  *some_args = node_new(NodeKind.ExpressionParenthesis(field_expr));
  ExprNode some_call;
  some_call.left = some_dot_node;
  some_call.has_left = true;
  some_call.right = some_args;
  some_call.has_right = true;
  some_call.op = "()";
  Node* some_call_node = malloc(sizeof(Node));
  *some_call_node = node_new(NodeKind.Expression(some_call));
  Node* get_ret = malloc(sizeof(Node));
  *get_ret = node_new(NodeKind.StatementReturn(some_call_node));
  Vec<Node*> get_stmts;
  get_stmts.init(0);
  get_stmts.push(get_ret);
  BodyNode get_bn;
  get_bn.statements = get_stmts;
  Node* get_body = malloc(sizeof(Node));
  *get_body = node_new(NodeKind.Body(get_bn));

  FunctionNode getfn = function_node_new();
  getfn.name = "Holder__get";
  getfn.has_name = true;
  DataType* get_rt = malloc(sizeof(DataType));
  *get_rt = dtype_new();
  get_rt.type_str = "Option";
  getfn.rtype = get_rt;
  getfn.has_rtype = true;
  getfn.args = get_params;
  getfn.has_args = true;
  getfn.body = get_body;
  getfn.has_body = true;
  Node* get_method_node = malloc(sizeof(Node));
  *get_method_node = node_new(NodeKind.Function(getfn));

  ImplNode holderimpl = impl_node_new();
  holderimpl.type_name = "Holder";
  holderimpl.methods.push(get_method_node);
  Node holder_impl_node = node_new(NodeKind.Impl(holderimpl));

  DataType* param_dt = malloc(sizeof(DataType));
  *param_dt = dtype_new();
  param_dt.type_str = "Holder";
  VariableNode hparam;
  hparam.var_type = param_dt;
  hparam.name = "h";
  hparam.has_val = false;
  hparam.is_const = false;
  Node* h_param = malloc(sizeof(Node));
  *h_param = node_new(NodeKind.Variable(hparam));
  Vec<Node*> check_params;
  check_params.init(0);
  check_params.push(h_param);

  DataType* let_dt = malloc(sizeof(DataType));
  *let_dt = dtype_new();
  let_dt.type_str = "__let_infer__";
  Node* h_ident = malloc(sizeof(Node));
  *h_ident = node_new(NodeKind.Identifier("h"));
  Node* get_ident = malloc(sizeof(Node));
  *get_ident = node_new(NodeKind.Identifier("get"));
  ExprNode call_dot;
  call_dot.left = h_ident;
  call_dot.has_left = true;
  call_dot.right = get_ident;
  call_dot.has_right = true;
  call_dot.op = ".";
  Node* call_dot_node = malloc(sizeof(Node));
  *call_dot_node = node_new(NodeKind.Expression(call_dot));
  Node* call_blank = malloc(sizeof(Node));
  *call_blank = node_new(NodeKind.Blank);
  Node* call_args = malloc(sizeof(Node));
  *call_args = node_new(NodeKind.ExpressionParenthesis(call_blank));
  ExprNode call_e;
  call_e.left = call_dot_node;
  call_e.has_left = true;
  call_e.right = call_args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));
  VariableNode letv;
  letv.var_type = let_dt;
  letv.name = "last";
  letv.val = call_node;
  letv.has_val = true;
  letv.is_const = false;
  Node* let_stmt = malloc(sizeof(Node));
  *let_stmt = node_new(NodeKind.Variable(letv));

  Node* fit_subj = malloc(sizeof(Node));
  *fit_subj = node_new(NodeKind.Identifier("last"));
  Node* true_ret = malloc(sizeof(Node));
  *true_ret = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> true_stmts;
  true_stmts.init(0);
  true_stmts.push(true_ret);
  BodyNode true_bn;
  true_bn.statements = true_stmts;
  Node* true_body = malloc(sizeof(Node));
  *true_body = node_new(NodeKind.Body(true_bn));
  Node* some_blank = malloc(sizeof(Node));
  *some_blank = node_new(NodeKind.Blank);
  Node* some_variant = malloc(sizeof(Node));
  *some_variant = node_new(NodeKind.Identifier("Some"));
  ExprNode some_pat;
  some_pat.left = some_blank;
  some_pat.has_left = true;
  some_pat.right = some_variant;
  some_pat.has_right = true;
  some_pat.op = ".";
  Node* some_pat_node = malloc(sizeof(Node));
  *some_pat_node = node_new(NodeKind.Expression(some_pat));
  Vec<str> some_bindings;
  some_bindings.init(0);
  some_bindings.push("t");
  FitBranch some_branch;
  some_branch.condition = some_pat_node;
  some_branch.has_condition = true;
  some_branch.body = true_body;
  some_branch.bindings = some_bindings;
  some_branch.has_bindings = true;

  FitStmtNode fitn = fit_stmt_node_new();
  fitn.exp = fit_subj;
  fitn.branches.push(some_branch);
  fitn.has_default_branch = false;
  Node* fit_node = malloc(sizeof(Node));
  *fit_node = node_new(NodeKind.StatementFit(fitn));

  Vec<Node*> check_stmts;
  check_stmts.init(0);
  check_stmts.push(let_stmt);
  check_stmts.push(fit_node);
  BodyNode check_bn;
  check_bn.statements = check_stmts;
  Node* check_body = malloc(sizeof(Node));
  *check_body = node_new(NodeKind.Body(check_bn));

  FunctionNode checkfn = function_node_new();
  checkfn.name = "check";
  checkfn.has_name = true;
  DataType* check_rt = malloc(sizeof(DataType));
  *check_rt = dtype_new();
  check_rt.type_str = "bin";
  checkfn.rtype = check_rt;
  checkfn.has_rtype = true;
  checkfn.args = check_params;
  checkfn.has_args = true;
  checkfn.body = check_body;
  checkfn.has_body = true;
  Node check_node = node_new(NodeKind.Function(checkfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(opt_node);
  nodes.push(holder_node);
  nodes.push(holder_impl_node);
  nodes.push(check_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  let out = st.out.build();
  assert contains(out, "__auto_type last = Holder__get(&h);"), "expected '__auto_type', not '__let_infer__', in the emitted C";
  assert contains(out, "if (last.tag == Option_Some)"), "expected the fit's bare '.Some' pattern resolved against Option, inferred from Holder__get's own declared return type";
}

test "emit_statement emits an uninitialized variable declaration" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "bin";
  VariableNode v;
  v.var_type = dt;
  v.name = "done";
  v.val = nil;
  v.has_val = false;
  v.is_const = false;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "bool done;\n"), "expected 'bool done;\\n'";
}

test "emit_body emits a plain if statement with no elif/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Identifier("ok"));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret_stmt);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));

  IfStmtNode ifn;
  ifn.condition = cond;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if statement to emit";
  assert equals(st.out.build(), `if (ok) {
  `    return;
  `}
  ``), "expected a plain if block";
}

test "emit_body chains StatementIf/StatementElseIf/StatementElse into one if/else-if/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  // if a { ret 1; } elif b { ret 2; } else { ret 3; }
  Node* cond_a = malloc(sizeof(Node));
  *cond_a = node_new(NodeKind.Identifier("a"));
  Node* val1 = malloc(sizeof(Node));
  *val1 = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* ret1 = malloc(sizeof(Node));
  *ret1 = node_new(NodeKind.StatementReturn(val1));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret1);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));
  IfStmtNode ifn;
  ifn.condition = cond_a;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Node* cond_b = malloc(sizeof(Node));
  *cond_b = node_new(NodeKind.Identifier("b"));
  Node* val2 = malloc(sizeof(Node));
  *val2 = node_new(NodeKind.Number(TokenData.Num(2)));
  Node* ret2 = malloc(sizeof(Node));
  *ret2 = node_new(NodeKind.StatementReturn(val2));
  Vec<Node*> elif_stmts;
  elif_stmts.init(0);
  elif_stmts.push(ret2);
  BodyNode elif_body_n;
  elif_body_n.statements = elif_stmts;
  Node* elif_body = malloc(sizeof(Node));
  *elif_body = node_new(NodeKind.Body(elif_body_n));
  IfStmtNode ein;
  ein.condition = cond_b;
  ein.body = elif_body;
  Node* elif_stmt = malloc(sizeof(Node));
  *elif_stmt = node_new(NodeKind.StatementElseIf(ein));

  Node* val3 = malloc(sizeof(Node));
  *val3 = node_new(NodeKind.Number(TokenData.Num(3)));
  Node* ret3 = malloc(sizeof(Node));
  *ret3 = node_new(NodeKind.StatementReturn(val3));
  Vec<Node*> else_stmts;
  else_stmts.init(0);
  else_stmts.push(ret3);
  BodyNode else_body_n;
  else_body_n.statements = else_stmts;
  Node* else_body = malloc(sizeof(Node));
  *else_body = node_new(NodeKind.Body(else_body_n));
  Node* else_stmt = malloc(sizeof(Node));
  *else_stmt = node_new(NodeKind.StatementElse(else_body));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  stmts.push(elif_stmt);
  stmts.push(else_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if/elif/else chain to emit";
  let out = st.out.build();
  assert equals(
    out,
    `if (a) {
    `    return 1;
    `} else if (b) {
    `    return 2;
    `} else {
    `    return 3;
    `}
    ``
  ), "expected a single chained if/else-if/else C construct";
}

test "emit_statement emits a bare 'ret;' as 'return;'" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
