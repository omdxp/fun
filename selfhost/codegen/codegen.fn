// The self-hosted Fun compiler's codegen: transpiles an AST into C source.
// Ported from the previous implementation's `modules/codegen/transpiler.zig`,
// incrementally, the same way `selfhost/parser` was.
// 
// Coverage so far: literal expressions (number/decimal/string/character/
// boolean), identifiers, unary operators (prefix, pointer-indirection
// depth, postfix `++`/`--`), binary operators (arithmetic/comparison/
// logical/bitwise/assignment -- every one shares an identical C
// spelling), calls with a plain-identifier callee (any argument count,
// flattening the parser's comma-chained argument-list representation --
// see `flatten_call_args`), variable declarations (explicit type only,
// no `let` inference yet), `ret` statements, `if`/`elif`/`else` (chained
// correctly into one C construct even though they're three independent
// sibling AST statements -- see `emit_if_chain`'s doc comment), and a
// top-level function declaration with any number of parameters (still
// no generics/variadics). Verified end to end: the self-hosted lexer ->
// self-hosted parser -> this codegen, on programs using variables,
// comparisons, if-elif-else, and multi-arg function calls, produces C
// that compiles and runs with the correct exit code.
// 
// Deliberately deferred from this slice (documented rather than silently
// dropped):
// - `[]` (indexing), `.` (member access) -- the latter needs `.`/`->`
// disambiguation based on pointer-ness, so it also blocks method calls
// (`recv.method(...)`, a callee that ISN'T a plain identifier) and calls
// through an aliased/imported module.
// - `for`/`fit`, and every declaration kind besides a plain function
// (`compound`/`enum`/`quirk`/`impl`).
// - Type INFERENCE: a function's return type and every literal's type are
// already fully explicit at this stage (an omitted `let` type, or a
// function relying on inferred generics, isn't reachable yet), so no
// `infer_expr_type`-equivalent exists yet either.
// - Multi-file imports, generics monomorphization, quirk/vtable dispatch,
// async/channels -- each is a substantial slice of its own in the
// original and will get one here too.
// - Exotic literal-escaping edge cases the original handles (splitting a
// string literal around a `\xFF`-then-more-hex-digits run so C doesn't
// fold extra digits into the escape) -- string content is written back
// out verbatim otherwise, relying on the lexer already having preserved
// escape sequences byte-for-byte from source (confirmed: `lexes string
// literals with escapes preserved verbatim` in the lexer's own test
// suite), which is valid C escape syntax already.
// - Decimal literals are emitted in FIXED-point (`format_dec(d, 6)`)
// rather than the original's scientific-notation (`{e}`) convention --
// both are valid C floating-point literal syntax representing the same
// value; the original's choice wasn't semantically required, and fixed-
// point is simpler to produce with the stdlib helpers already at hand.

imp codegen_state;
imp typedefs;
imp ..ast.ast;
imp ..lexer.token;
imp ..parser.datatype_defs;
imp std.string;
imp std.option;
imp std.io;

pub enum CodegenErrorKind {
  UnsupportedNode,
  InvalidNode,
}

pub compound Codegen {
  CodegenState* state;
}

pub fun codegen_new(CodegenState* state) Codegen {
  Codegen g;
  g.state = state;
  ret g;
}

impl Codegen {
  // Writes `dt`'s C spelling: a sized/dynamic int (`iN`/`uN`) via
  // `dynamic_int_type_to_c`, else the builtin mapping via `map_type_to_c`
  // (a user-defined type name passes through unchanged, matching the
  // original), followed by one `*` per pointer-depth level.
  // 
  // Deliberately simplified from the original for this slice: no C-
  // typedef-alias resolution or generic-name mangling for a user-defined
  // type -- neither is reachable yet (no `compound`/generics support).
  pub write_type(DataType dt) {
    fit parse_dynamic_int_datatype(dt.type_str) {
      .Some(dyn) -> { self.state.write(dynamic_int_type_to_c(dyn)); }
      .None -> { self.state.write(map_type_to_c(dt.type_str)); }
    }
    num ptr_depth = dt.pointer_depth;
    if ptr_depth == 0 && dt.flags.is_pointer {
      ptr_depth = 1;
    }
    num i = 0;
    for i < ptr_depth {
      self.state.write("*");
      i = i + 1;
    }
  }

  // Writes a single-quoted C character literal for `c`, escaping the
  // same fixed set the original does (backslash/quote/newline/CR/tab/
  // NUL), and any other non-printable-ASCII byte as `\xHH`.
  write_char_literal(chr c) {
    self.state.write("'");
    if c == '\\' {
      self.state.write("\\\\");
    } elif c == '\'' {
      self.state.write("\\'");
    } elif c == '\n' {
      self.state.write("\\n");
    } elif c == '\r' {
      self.state.write("\\r");
    } elif c == '\t' {
      self.state.write("\\t");
    } elif c == 0 {
      self.state.write("\\0");
    } else {
      num code = c;
      if code < 0x20 || code >= 0x7f {
        self.state.write(format("\\x{num}", code));
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
    }
    self.state.write("'");
  }

  // Emits `node` as a C expression. Only literal (primary) expression
  // kinds are supported this slice -- see this file's own top-level doc
  // comment for what's deliberately still missing.
  pub emit_expr(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Num(n) -> {
            self.state.write(format_num(n));
            ret .None;
          }
          .Dec(d) -> {
            self.state.write(format_dec(d, 6));
            ret .None;
          }
          _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
        }
      }
      .String(s) -> {
        self.state.write("\"");
        self.state.write(s);
        self.state.write("\"");
        ret .None;
      }
      .Character(c) -> {
        self.write_char_literal(c);
        ret .None;
      }
      .Boolean(b) -> {
        if b {
          self.state.write("true");
        } else {
          self.state.write("false");
        }
        ret .None;
      }
      .Identifier(name) -> {
        self.state.write(name);
        ret .None;
      }
      .Unary(u) -> {
        self.state.write("(");
        if u.is_left_operanded_unary {
          // Postfix: `x++`/`x--`.
          let oerr = self.emit_expr(*u.operand);
          if oerr.is_some() {
            ret oerr;
          }
          self.state.write(u.op);
        } elif u.has_indirection {
          // Pointer indirection (`*p`, `**pp`, ...): a run of `*`s for the
          // depth, not the single `u.op` (always "*" here anyway).
          num i = 0;
          for i < u.indirection_depth {
            self.state.write("*");
            i = i + 1;
          }
          let oerr2 = self.emit_expr(*u.operand);
          if oerr2.is_some() {
            ret oerr2;
          }
        } else {
          // Prefix (`-x`, `!x`, `~x`, `&x`).
          self.state.write(u.op);
          let oerr3 = self.emit_expr(*u.operand);
          if oerr3.is_some() {
            ret oerr3;
          }
        }
        self.state.write(")");
        ret .None;
      }
      .Expression(e) -> {
        // `[]` (indexing), `.` (member access), and a bare `,` (comma
        // reached directly, i.e. NOT as part of a call's argument list --
        // see `emit_call`/`flatten_call_args`) each need their own
        // dedicated handling -- member access needs `.`/`->`
        // disambiguation based on pointer-ness, and none of that exists
        // yet. `()` (calls) IS handled, but only for a plain-identifier
        // callee (see `emit_call`'s own doc comment). Every OTHER binary
        // operator (arithmetic/comparison/logical/bitwise/assignment)
        // already has an identical C spelling and a plain `(left op
        // right)` emission is correct as-is.
        if equals(e.op, "()") {
          ret self.emit_call(e);
        }
        if equals(e.op, "[]") || equals(e.op, ".") || equals(e.op, ",") {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        if !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.state.write("(");
        let lerr = self.emit_expr(*e.left);
        if lerr.is_some() {
          ret lerr;
        }
        self.state.write(" ");
        self.state.write(e.op);
        self.state.write(" ");
        let rerr = self.emit_expr(*e.right);
        if rerr.is_some() {
          ret rerr;
        }
        self.state.write(")");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Recursively flattens a call's argument-list node (the right side of
  // an `Expression{ op = "()" }`, always an `ExpressionParenthesis`
  // wrapping either `.Blank` for zero args, a single expression for one
  // arg, or a left-associative `,`-chained `Expression` tree for several
  // -- see `parse_for_parenthesis`'s doc comment) into individual
  // argument nodes, appended in left-to-right source order.
  flatten_call_args(Node* node, Vec<Node*>* out) {
    fit node.kind {
      .ExpressionParenthesis(inner) -> { self.flatten_call_args(inner, out); }
      .Blank -> {}
      .Expression(e) -> {
        if equals(e.op, ",") {
          if e.has_left {
            self.flatten_call_args(e.left, out);
          }
          if e.has_right {
            self.flatten_call_args(e.right, out);
          }
        } else {
          out.push(node);
        }
      }
      _ -> { out.push(node); }
    }
  }

  // Emits a call `callee(arg1, arg2, ...)`.
  // 
  // Deliberately simplified from the original for this slice: the callee
  // must be a plain identifier (an ordinary free-function call) -- a
  // method call (`recv.method(...)`, callee is itself a `.`-Expression)
  // or a call through another call's result (`f()()`) isn't reachable
  // yet, since `.` member access isn't emitted yet either (see
  // `emit_expr`'s own doc comment). No name resolution/mangling either
  // (aliasing, generics, overload-by-arity) -- the callee's Fun name and
  // its C name are assumed identical, true for every plain function this
  // slice can otherwise construct.
  emit_call(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str callee_name = "";
    fit e.left.kind {
      .Identifier(name) -> { callee_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    self.state.write(callee_name);
    self.state.write("(");

    Vec<Node*> args;
    args.init(0);
    self.flatten_call_args(e.right, &args);

    bin first = true;
    for arg : args {
      if !first {
        self.state.write(", ");
      }
      first = false;
      let aerr = self.emit_expr(*arg);
      if aerr.is_some() {
        ret aerr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits one statement, followed by its own trailing newline (statements
  // are the unit `emit_statements` iterates, so each ends its own line).
  // `StatementIf`/`StatementElseIf`/`StatementElse` are deliberately NOT
  // handled here -- they're only ever valid chained together, which needs
  // sibling lookahead only `emit_statements` (its caller) has; reaching
  // this function directly (an if/elif/else with no chain context) is a
  // bug in the caller, so it's an explicit error rather than emitting a
  // lone, invalid C `if`/`else if`/`else` fragment.
  pub emit_statement(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .StatementReturn(exp) -> {
        self.state.write_indent();
        self.state.write("return");
        if exp != nil {
          self.state.write(" ");
          let eerr = self.emit_expr(*exp);
          if eerr.is_some() {
            ret eerr;
          }
        }
        self.state.write(";\n");
        ret .None;
      }
      .Variable(v) -> {
        self.state.write_indent();
        self.write_type(*v.var_type);
        self.state.write(" ");
        self.state.write(v.name);
        if v.has_val {
          self.state.write(" = ");
          let verr = self.emit_expr(*v.val);
          if verr.is_some() {
            ret verr;
          }
        }
        self.state.write(";\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Emits an `if (cond) { ... }` block, WITHOUT the trailing newline (the
  // caller -- either `emit_statements` chaining a following elif/else, or
  // this same function recursing for one) decides what comes next).
  emit_if_block(Node* condition, Node* body) Option<CodegenErrorKind> {
    self.state.write("if (");
    let cerr = self.emit_expr(*condition);
    if cerr.is_some() {
      ret cerr;
    }
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits `stmts[start_i]` (a `StatementIf`) chained with every
  // immediately-following `StatementElseIf`/`StatementElse` sibling as a
  // single C `if (...) { } else if (...) { } else { }` construct, and
  // returns the index just past the whole chain.
  // 
  // `if`/`elif`/`else` are parsed as three INDEPENDENT sibling statement
  // kinds, not a nested tree (see `StatementIf`/`StatementElseIf`/
  // `StatementElse`'s own doc comments in ast.fn) -- so chaining them into
  // one C construct needs this adjacency lookahead over the statement
  // list, mirroring the original's `current_statement_type`/
  // `next_statement_type` tracking for the same purpose.
  emit_if_chain(Vec<Node*> stmts, num start_i, num* out_next_i) Option<CodegenErrorKind> {
    Node* if_stmt = stmts.get(start_i);
    fit if_stmt.kind {
      .StatementIf(ifn) -> {
        let ferr = self.emit_if_block(ifn.condition, ifn.body);
        if ferr.is_some() {
          ret ferr;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }

    num i = start_i + 1;
    for i < stmts.len {
      Node* next = stmts.get(i);
      bin chained = false;
      fit next.kind {
        .StatementElseIf(ein) -> {
          self.state.write(" else ");
          let eerr = self.emit_if_block(ein.condition, ein.body);
          if eerr.is_some() {
            ret eerr;
          }
          chained = true;
        }
        .StatementElse(ebody) -> {
          self.state.write(" else {\n");
          self.state.indent_level = self.state.indent_level + 1;
          let elerr = self.emit_body(*ebody);
          if elerr.is_some() {
            ret elerr;
          }
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}");
          chained = true;
        }
        _ -> {}
      }
      if !chained {
        break;
      }
      i = i + 1;
    }
    self.state.write("\n");
    *out_next_i = i;
    ret .None;
  }

  // Emits `stmts` in order, one statement per line, chaining any
  // `StatementIf`/`StatementElseIf`/`StatementElse` run into a single C
  // if/else-if/else construct via `emit_if_chain`.
  emit_statements(Vec<Node*> stmts) Option<CodegenErrorKind> {
    num i = 0;
    for i < stmts.len {
      Node* stmt = stmts.get(i);
      bin is_if = false;
      fit stmt.kind {
        .StatementIf(ifn) -> { is_if = true; }
        _ -> {}
      }
      if is_if {
        self.state.write_indent();
        num next_i = i;
        let cherr = self.emit_if_chain(stmts, i, &next_i);
        if cherr.is_some() {
          ret cherr;
        }
        i = next_i;
        continue;
      }
      let serr = self.emit_statement(*stmt);
      if serr.is_some() {
        ret serr;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Emits `body`: every statement in order when it's a `Body` block, or
  // just the one statement when it's a single braceless statement (an
  // `if`/`for`/... body doesn't require `{ }` when it's a single
  // statement -- see `_parse_if_body`'s doc comment in the parser).
  emit_body(Node body) Option<CodegenErrorKind> {
    fit body.kind {
      .Body(bn) -> { ret self.emit_statements(bn.statements); }
      _ -> { ret self.emit_statement(body); }
    }
  }

  // Emits one function parameter (a `Variable` node with no initializer)
  // as `<type> <name>`.
  emit_function_param(Node param) Option<CodegenErrorKind> {
    fit param.kind {
      .Variable(v) -> {
        self.write_type(*v.var_type);
        self.state.write(" ");
        self.state.write(v.name);
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a plain (no generics, no variadics) top-level function
  // declaration as a C function definition: `<rtype> <name>(<args>) {
  // <body> }` (or `(void)` for a zero-arg function, matching C
  // convention -- an empty `()` in C means "unspecified arguments", not
  // "no arguments").
  pub emit_function(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.write_type(*f.rtype);
        self.state.write(" ");
        self.state.write(f.name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let aerr = self.emit_function_param(*arg);
            if aerr.is_some() {
              ret aerr;
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(") {\n");
        self.state.indent_level = self.state.indent_level + 1;
        if f.has_body {
          let berr = self.emit_body(*f.body);
          if berr.is_some() {
            ret berr;
          }
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Writes the fixed set of C headers the original always includes
  // (before any conditional ones gated on stdlib usage, threads, sockets,
  // etc. -- none of which are reachable yet since imports aren't ported).
  pub write_prelude() {
    self.state.write("#include <stdio.h>\n");
    self.state.write("#include <stdbool.h>\n");
    self.state.write("#include <stdint.h>\n");
    self.state.write("#include <stdarg.h>\n");
    self.state.write("#include <stdlib.h>\n");
    self.state.write("#include <string.h>\n");
  }

  // Transpiles every top-level `Function` node in `nodes` (anything else
  // is skipped -- not an error, since a whole-file parse can contain
  // declarations not reachable yet, like `imp`).
  pub transpile(Vec<Node> nodes) Option<CodegenErrorKind> {
    self.write_prelude();
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          let ferr = self.emit_function(n);
          if ferr.is_some() {
            ret ferr;
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }
}

test "write_type emits builtin scalar C types with pointer depth" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "num";
  g.write_type(dt);
  assert equals(st.out.build(), "int64_t"), "expected 'int64_t'";

  CodegenState st2 = codegen_state_new();
  Codegen g2 = codegen_new(&st2);
  DataType dt2 = dtype_new();
  dt2.type_str = "chr";
  dt2.pointer_depth = 2;
  g2.write_type(dt2);
  assert equals(st2.out.build(), "char**"), "expected 'char**'";
}

test "write_type emits a sized int via dynamic_int_type_to_c" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "u32";
  g.write_type(dt);
  assert equals(st.out.build(), "uint32_t"), "expected 'uint32_t'";
}

test "emit_expr emits a number literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Number(TokenData.Num(42)));
  assert g.emit_expr(n).is_none(), "expected the number to emit";
  assert equals(st.out.build(), "42"), "expected '42'";
}

test "emit_expr emits a string literal verbatim between quotes" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("hello"));
  assert g.emit_expr(n).is_none(), "expected the string to emit";
  assert equals(st.out.build(), "\"hello\""), "expected a quoted string";
}

test "emit_expr emits a boolean literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Boolean(true));
  assert g.emit_expr(n).is_none(), "expected the boolean to emit";
  assert equals(st.out.build(), "true"), "expected 'true'";
}

test "emit_expr escapes a character literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Character('\n'));
  assert g.emit_expr(n).is_none(), "expected the character to emit";
  assert equals(st.out.build(), "'\\n'"), "expected an escaped newline character literal";
}

test "emit_expr emits an identifier" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Identifier("x"));
  assert g.emit_expr(n).is_none(), "expected the identifier to emit";
  assert equals(st.out.build(), "x"), "expected 'x'";
}

test "emit_expr emits a prefix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "-";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(-x)"), "expected '(-x)'";
}

test "emit_expr emits pointer indirection as a run of stars" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "*";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("p"));
  u.operand = operand;
  u.has_indirection = true;
  u.indirection_depth = 2;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(**p)"), "expected '(**p)'";
}

test "emit_expr emits a postfix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = true;
  u.op = "++";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(x++)"), "expected '(x++)'";
}

test "emit_expr emits a binary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "+";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the expression to emit";
  assert equals(st.out.build(), "(a + b)"), "expected '(a + b)'";
}

test "emit_expr rejects an index/member-access/comma expression (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "[]";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected an index expression to be rejected this slice";
}

test "emit_expr emits a zero-arg call" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo()"), "expected 'foo()'";
}

test "emit_expr emits a multi-arg call, flattening the comma-chained argument list" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));

  Node* arg_a = malloc(sizeof(Node));
  *arg_a = node_new(NodeKind.Identifier("a"));
  Node* arg_b = malloc(sizeof(Node));
  *arg_b = node_new(NodeKind.Identifier("b"));
  ExprNode comma;
  comma.left = arg_a;
  comma.has_left = true;
  comma.right = arg_b;
  comma.has_right = true;
  comma.op = ",";
  Node* comma_node = malloc(sizeof(Node));
  *comma_node = node_new(NodeKind.Expression(comma));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(comma_node));

  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo(a, b)"), "expected 'foo(a, b)'";
}

test "emit_expr rejects a call whose callee isn't a plain identifier (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected a non-identifier callee to be rejected this slice";
}

test "emit_statement emits a variable declaration with an initializer" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "num";
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(5)));
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.val = val;
  v.has_val = true;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "int64_t x = 5;\n"), "expected 'int64_t x = 5;\\n'";
}

test "emit_statement emits an uninitialized variable declaration" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "bin";
  VariableNode v;
  v.var_type = dt;
  v.name = "done";
  v.val = nil;
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "bool done;\n"), "expected 'bool done;\\n'";
}

test "emit_body emits a plain if statement with no elif/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Identifier("ok"));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret_stmt);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));

  IfStmtNode ifn;
  ifn.condition = cond;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if statement to emit";
  assert equals(st.out.build(), "if (ok) {\n    return;\n}\n"), "expected a plain if block";
}

test "emit_body chains StatementIf/StatementElseIf/StatementElse into one if/else-if/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  // if a { ret 1; } elif b { ret 2; } else { ret 3; }
  Node* cond_a = malloc(sizeof(Node));
  *cond_a = node_new(NodeKind.Identifier("a"));
  Node* val1 = malloc(sizeof(Node));
  *val1 = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* ret1 = malloc(sizeof(Node));
  *ret1 = node_new(NodeKind.StatementReturn(val1));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret1);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));
  IfStmtNode ifn;
  ifn.condition = cond_a;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Node* cond_b = malloc(sizeof(Node));
  *cond_b = node_new(NodeKind.Identifier("b"));
  Node* val2 = malloc(sizeof(Node));
  *val2 = node_new(NodeKind.Number(TokenData.Num(2)));
  Node* ret2 = malloc(sizeof(Node));
  *ret2 = node_new(NodeKind.StatementReturn(val2));
  Vec<Node*> elif_stmts;
  elif_stmts.init(0);
  elif_stmts.push(ret2);
  BodyNode elif_body_n;
  elif_body_n.statements = elif_stmts;
  Node* elif_body = malloc(sizeof(Node));
  *elif_body = node_new(NodeKind.Body(elif_body_n));
  IfStmtNode ein;
  ein.condition = cond_b;
  ein.body = elif_body;
  Node* elif_stmt = malloc(sizeof(Node));
  *elif_stmt = node_new(NodeKind.StatementElseIf(ein));

  Node* val3 = malloc(sizeof(Node));
  *val3 = node_new(NodeKind.Number(TokenData.Num(3)));
  Node* ret3 = malloc(sizeof(Node));
  *ret3 = node_new(NodeKind.StatementReturn(val3));
  Vec<Node*> else_stmts;
  else_stmts.init(0);
  else_stmts.push(ret3);
  BodyNode else_body_n;
  else_body_n.statements = else_stmts;
  Node* else_body = malloc(sizeof(Node));
  *else_body = node_new(NodeKind.Body(else_body_n));
  Node* else_stmt = malloc(sizeof(Node));
  *else_stmt = node_new(NodeKind.StatementElse(else_body));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  stmts.push(elif_stmt);
  stmts.push(else_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if/elif/else chain to emit";
  let out = st.out.build();
  assert equals(
    out,
    "if (a) {\n    return 1;\n} else if (b) {\n    return 2;\n} else {\n    return 3;\n}\n"
  ), "expected a single chained if/else-if/else C construct";
}

test "emit_statement emits a bare 'ret;' as 'return;'" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.StatementReturn(nil));
  assert g.emit_statement(n).is_none(), "expected the return to emit";
  assert equals(st.out.build(), "return;\n"), "expected 'return;\\n'";
}

test "emit_statement emits 'ret <value>;' with the value expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(7)));
  Node n = node_new(NodeKind.StatementReturn(val));
  assert g.emit_statement(n).is_none(), "expected the return to emit";
  assert equals(st.out.build(), "return 7;\n"), "expected 'return 7;\\n'";
}

test "emit_function emits a plain no-arg function definition with indentation" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "main";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;

  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(val));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected the function to emit";
  assert equals(st.out.build(), "int64_t main(void) {\n    return 0;\n}\n"), "expected a complete C function definition";
}

test "emit_function emits parameters, and a call to it" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "add";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;

  DataType* dt_a = malloc(sizeof(DataType));
  *dt_a = dtype_new();
  dt_a.type_str = "num";
  VariableNode va;
  va.var_type = dt_a;
  va.name = "a";
  va.has_val = false;
  Node* param_a = malloc(sizeof(Node));
  *param_a = node_new(NodeKind.Variable(va));

  DataType* dt_b = malloc(sizeof(DataType));
  *dt_b = dtype_new();
  dt_b.type_str = "num";
  VariableNode vb;
  vb.var_type = dt_b;
  vb.name = "b";
  vb.has_val = false;
  Node* param_b = malloc(sizeof(Node));
  *param_b = node_new(NodeKind.Variable(vb));

  Vec<Node*> params;
  params.init(0);
  params.push(param_a);
  params.push(param_b);
  fnv.args = params;
  fnv.has_args = true;

  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(NodeKind.Identifier("a"));
  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(NodeKind.Identifier("b"));
  ExprNode sum;
  sum.left = lhs;
  sum.has_left = true;
  sum.right = rhs;
  sum.has_right = true;
  sum.op = "+";
  Node* sum_node = malloc(sizeof(Node));
  *sum_node = node_new(NodeKind.Expression(sum));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(sum_node));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;

  Node fn_node = node_new(NodeKind.Function(fnv));
  assert g.emit_function(fn_node).is_none(), "expected the function to emit";
  assert equals(st.out.build(), "int64_t add(int64_t a, int64_t b) {\n    return (a + b);\n}\n"), "expected a two-param C function definition";
}

test "transpile emits the prelude followed by every top-level function" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  FunctionNode fnv = function_node_new();
  fnv.name = "main";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(val));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;
  Node fn_node = node_new(NodeKind.Function(fnv));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(fn_node);

  assert g.transpile(nodes).is_none(), "expected the whole file to transpile";
  let out = st.out.build();
  assert contains(out, "#include <stdint.h>"), "expected the prelude to be present";
  assert contains(out, "int64_t main(void) {"), "expected the function definition to be present";
}
