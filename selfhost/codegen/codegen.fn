test "emit_expr emits a chained field access followed by indexing (self.data[i])" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "Vec", true);

  Vec<str> vec_fields;
  vec_fields.init(0);
  vec_fields.push("data");
  Vec<str> vec_field_types;
  vec_field_types.init(0);
  vec_field_types.push("str");
  Vec<bin> vec_field_ptrs;
  vec_field_ptrs.init(0);
  vec_field_ptrs.push(true);
  g.record_compound("Vec", vec_fields, vec_field_types, vec_field_ptrs);

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(NodeKind.Identifier("self"));
  Node* data_ident = malloc(sizeof(Node));
  *data_ident = node_new(NodeKind.Identifier("data"));
  ExprNode dot;
  dot.left = self_ident;
  dot.has_left = true;
  dot.right = data_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* dot_node = malloc(sizeof(Node));
  *dot_node = node_new(NodeKind.Expression(dot));

  Node* i_ident = malloc(sizeof(Node));
  *i_ident = node_new(NodeKind.Identifier("i"));
  Node* bracket_inner = malloc(sizeof(Node));
  *bracket_inner = node_new(NodeKind.Bracket(i_ident));
  ExprNode idx;
  idx.left = dot_node;
  idx.has_left = true;
  idx.right = bracket_inner;
  idx.has_right = true;
  idx.op = "[]";
  Node n = node_new(NodeKind.Expression(idx));

  assert g.emit_expr(n).is_none(), "expected 'self.data[i]' to emit";
  assert equals(st.out.build(), "self->data[i]"), "expected 'self->data[i]', deciding '->' from self's own pointer-ness";
}

test "emit_statement emits an index assignment as a statement (arr[i] = x)" {
  CodegenState st = codegen_state_new();
