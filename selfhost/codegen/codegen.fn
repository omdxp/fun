}

test "ensure_enum_instantiated rejects a wrong generic argument count" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* str_arg = malloc(sizeof(DataType));
  *str_arg = dtype_new();
  str_arg.type_str = "str";
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Opt";
  dt.generic_args.push(num_arg);
  dt.generic_args.push(str_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Opt (one type param) instantiated with two arguments to be rejected";
}

test "ensure_enum_instantiated rejects a nested generic argument whose OWN template isn't registered" {
  // Nested generic arguments themselves DO resolve now (see the
  // "instantiates a nested generic argument" test below) -- this one
  // specifically covers the argument still being rejected when the
  // NESTED type itself is unresolvable (here, "Vec" was never
  // registered as a template at all).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_vec = malloc(sizeof(DataType));
  *inner_vec = dtype_new();
  inner_vec.type_str = "Vec";
  inner_vec.generic_args.push(num_arg);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Opt";
  dt.generic_args.push(inner_vec);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_some(), "expected Opt<Vec<num>> rejected because 'Vec' itself was never registered as a template, not because nesting itself is unsupported";
}

test "ensure_enum_instantiated instantiates a nested generic argument (Opt<Box<num>>)" {
  // Regression test mirroring ensure_compound_instantiated's own nested-
  // generic test, for the enum side (a generic enum whose OWN argument
  // is itself a generic COMPOUND instantiation) -- see
  // `ensure_compound_instantiated`'s doc comment for the real code this
  // fixes (`Result<Option<Token>, Error>`).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_box_template(&g);
  _record_opt_template(&g);

  DataType* num_arg = malloc(sizeof(DataType));
  *num_arg = dtype_new();
  num_arg.type_str = "num";
  DataType* inner_box = malloc(sizeof(DataType));
  *inner_box = dtype_new();
  inner_box.type_str = "Box";
  inner_box.generic_args.push(num_arg);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Opt";
  dt.generic_args.push(inner_box);
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_none(), "expected Opt<Box<num>> to instantiate, resolving the nested Box<num> first";
  let out = st.out.build();
  assert contains(out, "typedef struct Box__num {\n  int64_t value;\n} Box__num;"), "expected the INNER instantiation (Box__num) emitted";
  assert contains(out, "typedef enum Opt__Box__num_tag {"), "expected the OUTER tagged-union instantiation using the inner's own mangled name";
  assert contains(out, "struct { Box__num _0; } Some;"), "expected the Some variant's payload typed as the inner's own mangled name";
}

test "ensure_enum_instantiated mangles a pointer-typed generic argument distinctly" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  _record_opt_template(&g);

  DataType* node_ptr_arg = malloc(sizeof(DataType));
  *node_ptr_arg = dtype_new();
  node_ptr_arg.type_str = "Node";
  node_ptr_arg.pointer_depth = 1;
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "Opt";
  dt.generic_args.push(node_ptr_arg);
  VariableNode v;
  v.var_type = dt;
  v.name = "o";
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));

  assert g.emit_statement(n).is_none(), "expected Opt<Node*> to instantiate";
  let out = st.out.build();
  assert contains(out, "Opt__Node_ptr1"), "expected the mangled name to include the pointer depth";
  assert contains(out, "Node* _0;"), "expected the Some payload field itself to be a pointer";
}

test "emit_statement emits a bare assignment expression as a statement" {
  CodegenState st = codegen_state_new();
