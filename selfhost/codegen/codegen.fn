// The self-hosted Fun compiler's codegen: transpiles an AST into C source.
// Ported from the previous implementation's `modules/codegen/transpiler.zig`,
// incrementally, the same way `selfhost/parser` was.
// 
// Coverage so far: literal expressions (number/decimal/string/character/
// boolean), identifiers, unary operators (prefix, pointer-indirection
// depth, postfix `++`/`--`), binary operators (arithmetic/comparison/
// logical/bitwise/assignment -- every one shares an identical C
// spelling), calls with a plain-identifier callee (any argument count,
// flattening the parser's comma-chained argument-list representation --
// see `flatten_call_args`), variable declarations (explicit type only,
// no `let` inference yet), `ret` statements, `if`/`elif`/`else` (chained
// correctly into one C construct even though they're three independent
// sibling AST statements -- see `emit_if_chain`'s doc comment), `for`
// (condition/infinite form as a C `while`, integer-range form as a C
// counted `for`, and the `Vec` iterator form -- `for item : arr { ... }`
// / `for i, item :: arr { ... }` -- as the original's own `.len`/`.data`
// fast-path loop; see `emit_for_cond`/`emit_for_range`/`emit_for_iter`),
// bare expression statements (an assignment, a call for its side effect,
// `x++;` -- these have no dedicated `StatementExpression` AST wrapper,
// they're a plain `.Expression`/`.Unary` node straight in the statement
// list), a non-generic `compound Name { fields }` declaration as a C
// struct (see `emit_compound`), single-level `ident.field` member access
// deciding `.`/`->` from the receiver's DECLARED pointer-ness (a
// deliberately narrow, non-inference-based heuristic -- see
// `emit_field_access`'s doc comment for exactly what it can't handle), a
// plain (non-quirk, non-generic) `impl Type { methods }` block (each
// method is ALREADY parsed as a pre-mangled, self-first-arg `Function`
// node -- see `emit_impl`'s doc comment -- so it's emitted exactly like
// any other function), a method call `recv.method(...)` resolved
// statically to `Type__method(<self-arg>, ...)` from the receiver's
// known local type (see `emit_method_call`'s doc comment), `fit subject {
// patterns -> { body } ... }` over a plain-identifier subject with
// literal patterns as a C `if`/`else if`/`else` chain (see `emit_fit`'s
// doc comment), a non-generic `enum Name { variants }` declaration --
// either a plain C enum, or, when any variant carries a payload, the
// original's own discriminant-enum-plus-tagged-struct/union layout (see
// `emit_enum`/`emit_tagged_union_enum`'s doc comments) -- together with
// a QUALIFIED enum-variant access (`EnumName.Variant` bare, or
// `EnumName.Variant(args...)` a payload construction, both recognized
// without a call needed to disambiguate from a method call -- see
// `emit_field_access`/`emit_enum_variant_construction`'s doc comments),
// and a top-level function declaration with any number of parameters
// (still no generics/variadics). Verified end to end: the self-hosted
// lexer -> self-hosted parser -> this codegen, on programs using
// variables, comparisons, if-elif-else, assignment statements, all three
// `for` loop forms above, multi-arg function calls, a compound with
// field reads/writes, a plain impl method called both directly and
// through `self`, a `fit` over a `num` subject with a comma-chained
// pattern and a default arm, a plain enum whose variant constants are
// compared and returned, and a tagged-union enum constructed both with a
// payload and payload-less (as a function's return value, assigned to a
// local), produces C that compiles and runs with the correct exit code.
// 
// Deliberately deferred from this slice (documented rather than silently
// dropped):
// - Chained field access (`a.b.c`, including reading a tagged union's own
// `.payload.Variant._N` fields back out), and calls/access through an
// aliased/imported module -- both share the `Identifier . Identifier`
// AST shape with plain field access and qualified enum-variant access,
// and `emit_field_access` deliberately refuses to guess at either of
// them (see its own doc comment). Each needs real infrastructure this
// slice doesn't have yet: a compound-field-type registry, and import
// support respectively.
// - A BARE enum-variant shorthand (`.Some(x)`, `.None`, no `EnumName.`
// qualifier) -- resolving which enum it refers to needs type inference
// from the expected type (a function's declared return type, a
// variable's declared type, ...), which doesn't exist yet; only the
// explicitly-qualified form is supported this slice. A `fit` branch
// matching a bare enum-variant shorthand or destructuring pattern is
// deferred for the same reason (plus needing the tag comparison/payload-
// binding machinery on top).
// - A GENERIC enum (`enum Option<T> { ... }`) -- monomorphization is a
// separate, larger deferred item, same as generic compounds/impls.
// - Quirk-implementing impls (`impl Type as Quirk { ... }`) -- their
// methods are dispatched dynamically through a vtable in the original,
// a separate, larger deferred item; a plain impl's methods are resolved
// statically instead (see `emit_method_call`'s doc comment).
// - The iterator form of `for` over anything other than a known-`Vec`
// local (an array literal, or a general `Iterator`-implementing quirk
// value dispatched through `.next()`) -- see `emit_for_iter`'s doc
// comment; `[]` (indexing).
// - A `fit` subject that isn't a plain identifier (needs a temp variable
// AND a type to declare it with -- see `emit_fit`'s doc comment).
// - Every declaration kind besides a plain function/non-generic
// compound/non-generic enum/non-quirk-non-generic impl (`quirk`, a
// GENERIC compound's/enum's monomorphized specializations, and a generic
// or quirk-implementing impl's methods).
// - Type INFERENCE: a function's return type and every literal's type are
// already fully explicit at this stage (an omitted `let` type, or a
// function relying on inferred generics, isn't reachable yet), so no
// `infer_expr_type`-equivalent exists yet either.
// - Multi-file imports, generics monomorphization, quirk/vtable dispatch,
// async/channels -- each is a substantial slice of its own in the
// original and will get one here too.
// - Exotic literal-escaping edge cases the original handles (splitting a
// string literal around a `\xFF`-then-more-hex-digits run so C doesn't
// fold extra digits into the escape) -- string content is written back
// out verbatim otherwise, relying on the lexer already having preserved
// escape sequences byte-for-byte from source (confirmed: `lexes string
// literals with escapes preserved verbatim` in the lexer's own test
// suite), which is valid C escape syntax already.
// - Decimal literals are emitted in FIXED-point (`format_dec(d, 6)`)
// rather than the original's scientific-notation (`{e}`) convention --
// both are valid C floating-point literal syntax representing the same
// value; the original's choice wasn't semantically required, and fixed-
// point is simpler to produce with the stdlib helpers already at hand.

imp codegen_state;
imp typedefs;
imp ..ast.ast;
imp ..lexer.token;
imp ..parser.datatype_defs;
imp std.string;
imp std.option;
imp std.io;

pub enum CodegenErrorKind {
  UnsupportedNode,
  InvalidNode,
}

pub compound Codegen {
  CodegenState* state;
  // A best-effort, function-local (reset at the start of every
  // `emit_function`, see its own doc comment) record of which local names
  // (parameters and `Variable` declarations seen so far, in source order)
  // are pointer-typed, and their declared type name -- just enough to
  // decide `.`/`->` for a plain `ident.field` access, and to build a
  // method call's mangled callee name, without a real type-inference
  // engine. See `emit_field_access`/`emit_method_call`'s doc comments for
  // what this deliberately can't handle yet.
  Vec<str> local_names;
  Vec<bin> local_is_pointer;
  Vec<str> local_type_name;
  // Whole-program record of every non-generic enum's name, its variants'
  // names, and whether it's a tagged union (any variant has a payload),
  // populated by `transpile`'s own first pass over top-level `Enum`
  // nodes -- lets `emit_expr`/`emit_call` recognize a qualified
  // enum-variant access (`EnumName.Variant` bare, or `EnumName.Variant(
  // args...)` a construction call) and emit the right C, without a real
  // type-inference engine (see `emit_field_access`/`emit_enum`'s doc
  // comments for what's deliberately not registered here).
  Vec<str> enum_names;
  Vec<Vec<str>> enum_variant_names;
  Vec<bin> enum_is_tagged_union;
}

pub fun codegen_new(CodegenState* state) Codegen {
  Codegen g;
  g.state = state;
  g.local_names.init(0);
  g.local_is_pointer.init(0);
  g.local_type_name.init(0);
  g.enum_names.init(0);
  g.enum_variant_names.init(0);
  g.enum_is_tagged_union.init(0);
  ret g;
}

// True when `dt` is a pointer of any depth -- mirrors `write_type`'s own
// `ptr_depth`/`flags.is_pointer` check.
fun dtype_is_pointer(DataType dt) bin {
  if dt.pointer_depth > 0 {
    ret true;
  }
  ret dt.flags.is_pointer;
}

impl Codegen {
  // Writes `dt`'s C spelling: a sized/dynamic int (`iN`/`uN`) via
  // `dynamic_int_type_to_c`, else the builtin mapping via `map_type_to_c`
  // (a user-defined type name passes through unchanged, matching the
  // original), followed by one `*` per pointer-depth level.
  // 
  // Deliberately simplified from the original for this slice: no C-
  // typedef-alias resolution or generic-name mangling for a user-defined
  // type -- neither is reachable yet (no `compound`/generics support).
  pub write_type(DataType dt) {
    fit parse_dynamic_int_datatype(dt.type_str) {
      .Some(dyn) -> { self.state.write(dynamic_int_type_to_c(dyn)); }
      .None -> { self.state.write(map_type_to_c(dt.type_str)); }
    }
    num ptr_depth = dt.pointer_depth;
    if ptr_depth == 0 && dt.flags.is_pointer {
      ptr_depth = 1;
    }
    num i = 0;
    for i < ptr_depth {
      self.state.write("*");
      i = i + 1;
    }
  }

  // Records that local `name` is (or isn't) a pointer, and its declared
  // type name, for later `ident.field`/`recv.method(...)` decisions. See
  // the `Codegen.local_names`/`local_is_pointer`/`local_type_name` field
  // doc comment for the scope of this tracking.
  record_local(str name, str type_name, bin is_pointer) {
    self.local_names.push(name);
    self.local_is_pointer.push(is_pointer);
    self.local_type_name.push(type_name);
  }

  // Looks up whether `name` was recorded as a pointer local. `.None` means
  // `name` isn't a known local at all (e.g. it's a type name in an enum-
  // variant-constant or module-alias access, or a not-yet-supported
  // `self`) -- the caller must treat that as "can't handle this", not
  // "assume value type".
  lookup_local_is_pointer(str name) Option<bin> {
    num i = 0;
    for i < self.local_names.len {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_is_pointer.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Looks up `name`'s declared type name (e.g. "Point"), for building a
  // method call's mangled callee name. See `lookup_local_is_pointer`'s
  // doc comment -- same scope, same "can't handle this" contract on
  // `.None`.
  lookup_local_type_name(str name) Option<str> {
    num i = 0;
    for i < self.local_names.len {
      if equals(self.local_names.get(i), name) {
        ret .Some(self.local_type_name.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Records `name` as a known enum with the given variant names and
  // tagged-union-ness, for later `EnumName.Variant` access recognition.
  // See the `Codegen.enum_names`/`enum_variant_names`/
  // `enum_is_tagged_union` field doc comment.
  record_enum(str name, Vec<str> variant_names, bin is_tagged_union) {
    self.enum_names.push(name);
    self.enum_variant_names.push(variant_names);
    self.enum_is_tagged_union.push(is_tagged_union);
  }

  // True if `enum_name` was recorded as a known enum with a variant
  // named `variant_name`. False for an unrecognized enum name OR a
  // recognized enum with no such variant -- either way, the caller must
  // treat that as "not a qualified enum-variant access", not guess.
  enum_has_variant(str enum_name, str variant_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        let variants = self.enum_variant_names.get(i);
        num j = 0;
        for j < variants.len {
          if equals(variants.get(j), variant_name) {
            ret true;
          }
          j = j + 1;
        }
        ret false;
      }
      i = i + 1;
    }
    ret false;
  }

  // True if `enum_name` was recorded as a known TAGGED-UNION enum. False
  // for an unrecognized name OR a recognized plain enum -- either way,
  // the caller must treat "unrecognized" as "can't handle this", not
  // guess (there's no ambiguity for a RECOGNIZED plain enum, though:
  // `false` there correctly means "just the bare constant").
  enum_is_tagged_union_named(str enum_name) bin {
    num i = 0;
    for i < self.enum_names.len {
      if equals(self.enum_names.get(i), enum_name) {
        ret self.enum_is_tagged_union.get(i);
      }
      i = i + 1;
    }
    ret false;
  }

  // Writes a single-quoted C character literal for `c`, escaping the
  // same fixed set the original does (backslash/quote/newline/CR/tab/
  // NUL), and any other non-printable-ASCII byte as `\xHH`.
  write_char_literal(chr c) {
    self.state.write("'");
    if c == '\\' {
      self.state.write("\\\\");
    } elif c == '\'' {
      self.state.write("\\'");
    } elif c == '\n' {
      self.state.write("\\n");
    } elif c == '\r' {
      self.state.write("\\r");
    } elif c == '\t' {
      self.state.write("\\t");
    } elif c == 0 {
      self.state.write("\\0");
    } else {
      num code = c;
      if code < 0x20 || code >= 0x7f {
        self.state.write(format("\\x{num}", code));
      } else {
        str buf = malloc(2);
        buf[0] = c;
        buf[1] = 0;
        self.state.write(buf);
      }
    }
    self.state.write("'");
  }

  // Emits `node` as a C expression. Only literal (primary) expression
  // kinds are supported this slice -- see this file's own top-level doc
  // comment for what's deliberately still missing.
  pub emit_expr(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Number(data) -> {
        fit data {
          .Num(n) -> {
            self.state.write(format_num(n));
            ret .None;
          }
          .Dec(d) -> {
            self.state.write(format_dec(d, 6));
            ret .None;
          }
          _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
        }
      }
      .String(s) -> {
        self.state.write("\"");
        self.state.write(s);
        self.state.write("\"");
        ret .None;
      }
      .Character(c) -> {
        self.write_char_literal(c);
        ret .None;
      }
      .Boolean(b) -> {
        if b {
          self.state.write("true");
        } else {
          self.state.write("false");
        }
        ret .None;
      }
      .Identifier(name) -> {
        self.state.write(name);
        ret .None;
      }
      .ExpressionParenthesis(inner) -> {
        // An explicit parenthesized sub-expression (`(a + b)`), reached
        // directly -- not the argument-list wrapper of a call, which
        // `emit_call`/`flatten_call_args` consume before this dispatch is
        // ever reached for it.
        self.state.write("(");
        let ierr = self.emit_expr(*inner);
        if ierr.is_some() {
          ret ierr;
        }
        self.state.write(")");
        ret .None;
      }
      .Unary(u) -> {
        self.state.write("(");
        if u.is_left_operanded_unary {
          // Postfix: `x++`/`x--`.
          let oerr = self.emit_expr(*u.operand);
          if oerr.is_some() {
            ret oerr;
          }
          self.state.write(u.op);
        } elif u.has_indirection {
          // Pointer indirection (`*p`, `**pp`, ...): a run of `*`s for the
          // depth, not the single `u.op` (always "*" here anyway).
          num i = 0;
          for i < u.indirection_depth {
            self.state.write("*");
            i = i + 1;
          }
          let oerr2 = self.emit_expr(*u.operand);
          if oerr2.is_some() {
            ret oerr2;
          }
        } else {
          // Prefix (`-x`, `!x`, `~x`, `&x`).
          self.state.write(u.op);
          let oerr3 = self.emit_expr(*u.operand);
          if oerr3.is_some() {
            ret oerr3;
          }
        }
        self.state.write(")");
        ret .None;
      }
      .Expression(e) -> {
        // `[]` (indexing) and a bare `,` (reached directly, i.e. NOT as
        // part of a call's argument list -- see `emit_call`/
        // `flatten_call_args`) don't have dedicated handling yet. `()`
        // (calls) and `.` (member access, single-level only -- see
        // `emit_field_access`'s doc comment) ARE handled. Every OTHER
        // binary operator (arithmetic/comparison/logical/bitwise/
        // assignment) already has an identical C spelling and a plain
        // `(left op right)` emission is correct as-is.
        if equals(e.op, "()") {
          ret self.emit_call(e);
        }
        if equals(e.op, ".") {
          ret self.emit_field_access(e);
        }
        if equals(e.op, "[]") || equals(e.op, ",") {
          ret .Some(CodegenErrorKind.UnsupportedNode);
        }
        if !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.state.write("(");
        let lerr = self.emit_expr(*e.left);
        if lerr.is_some() {
          ret lerr;
        }
        self.state.write(" ");
        self.state.write(e.op);
        self.state.write(" ");
        let rerr = self.emit_expr(*e.right);
        if rerr.is_some() {
          ret rerr;
        }
        self.state.write(")");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Recursively flattens a call's argument-list node (the right side of
  // an `Expression{ op = "()" }`, always an `ExpressionParenthesis`
  // wrapping either `.Blank` for zero args, a single expression for one
  // arg, or a left-associative `,`-chained `Expression` tree for several
  // -- see `parse_for_parenthesis`'s doc comment) into individual
  // argument nodes, appended in left-to-right source order.
  flatten_call_args(Node* node, Vec<Node*>* out) {
    fit node.kind {
      .ExpressionParenthesis(inner) -> { self.flatten_call_args(inner, out); }
      .Blank -> {}
      .Expression(e) -> {
        if equals(e.op, ",") {
          if e.has_left {
            self.flatten_call_args(e.left, out);
          }
          if e.has_right {
            self.flatten_call_args(e.right, out);
          }
        } else {
          out.push(node);
        }
      }
      _ -> { out.push(node); }
    }
  }

  // Emits a call `callee(arg1, arg2, ...)`: a plain-identifier callee (an
  // ordinary free-function call) directly, or delegates to
  // `emit_method_call` when the callee is itself a `.`-Expression
  // (`recv.method(...)`).
  // 
  // Deliberately simplified from the original for this slice: a call
  // through another call's result (`f()()`) isn't reachable yet. No name
  // resolution/mangling for the free-function case either (aliasing,
  // generics, overload-by-arity) -- the callee's Fun name and its C name
  // are assumed identical, true for every plain function this slice can
  // otherwise construct.
  emit_call(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str callee_name = "";
    fit e.left.kind {
      .Identifier(name) -> { callee_name = name; }
      .Expression(recv_e) -> {
        if equals(recv_e.op, ".") {
          // `EnumName.Variant(args...)` (a tagged-union payload
          // construction) shares the exact same AST shape as a method
          // call (`recv.method(...)`) -- disambiguate by checking
          // whether the left side is a KNOWN ENUM NAME with that
          // variant first. See `emit_enum_variant_construction`'s doc
          // comment for the C this constructs.
          if recv_e.has_left && recv_e.has_right {
            fit recv_e.left.kind {
              .Identifier(enum_name) -> {
                fit recv_e.right.kind {
                  .Identifier(variant_name) -> {
                    if self.enum_has_variant(enum_name, variant_name) {
                      ret self.emit_enum_variant_construction(enum_name, variant_name, e.right);
                    }
                  }
                  _ -> {}
                }
              }
              _ -> {}
            }
          }
          ret self.emit_method_call(recv_e, e.right);
        }
        ret .Some(CodegenErrorKind.UnsupportedNode);
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    self.state.write(callee_name);
    self.state.write("(");

    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(e.right, &args);

    bin first = true;
    for arg : args {
      if !first {
        self.state.write(", ");
      }
      first = false;
      let aerr = self.emit_expr(*arg);
      if aerr.is_some() {
        ret aerr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits a method call `recv.method(arg1, ...)` as C
  // `TypeName__method(<self-arg>, arg1, ...)`, mirroring the parser's own
  // implicit-`self`/mangled-name scheme (`_parse_impl_method`'s doc
  // comment: a plain impl's method `mname` on type `TypeName` is parsed
  // straight into a `Function` node ALREADY named `TypeName__mname` with
  // `self` as its first arg -- codegen doesn't invent any mangling of its
  // own, it just has to reproduce the same recipe at the CALL site). The
  // self-arg is `recv` directly when `recv` is already a pointer local,
  // or `&recv` when it's a value local (the callee always expects a
  // pointer, matching the implicit `self` parameter's type).
  // 
  // Deliberately narrow for this slice, same spirit as
  // `emit_field_access` (whose doc comment explains why an unrecognized
  // receiver is REJECTED rather than guessed): `recv` must be a plain
  // identifier that's a KNOWN local, and `method` a plain identifier.
  // Quirk-dispatched calls (dynamic vtable dispatch) aren't reachable
  // yet either -- only a plain (non-quirk) impl's method, resolved
  // statically by the receiver's DECLARED type name.
  emit_method_call(ExprNode recv_e, Node* args_node) Option<CodegenErrorKind> {
    if !recv_e.has_left || !recv_e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str recv_name = "";
    fit recv_e.left.kind {
      .Identifier(name) -> { recv_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    str method_name = "";
    fit recv_e.right.kind {
      .Identifier(name) -> { method_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    let type_found = self.lookup_local_type_name(recv_name);
    let ptr_found = self.lookup_local_is_pointer(recv_name);
    if type_found.is_none() || ptr_found.is_none() {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }

    self.state.write(type_found.unwrap());
    self.state.write("__");
    self.state.write(method_name);
    self.state.write("(");
    if ptr_found.unwrap() {
      self.state.write(recv_name);
    } else {
      self.state.write("&");
      self.state.write(recv_name);
    }

    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);
    for arg : args {
      self.state.write(", ");
      let aerr = self.emit_expr(*arg);
      if aerr.is_some() {
        ret aerr;
      }
    }
    self.state.write(")");
    ret .None;
  }

  // Emits a tagged-union compound literal for `EnumName.Variant(args...)`:
  // ((EnumName){ .tag = EnumName_Variant, .payload.Variant = { ._0 = (a0), ... } })
  // matching the struct layout `emit_tagged_union_enum` emits -- payload
  // field names `_0`, `_1`, ... line up positionally with the union
  // struct's own fields. `args_node` is the call's (possibly
  // comma-flattened) argument-list node; reuses `flatten_call_args`
  // directly, same as an ordinary call.
  emit_enum_variant_construction(str enum_name, str variant_name, Node* args_node) Option<CodegenErrorKind> {
    Vec<Node*> args;
    args.init(0);
    defer args.free();
    self.flatten_call_args(args_node, &args);

    self.state.write("((");
    self.state.write(enum_name);
    self.state.write("){ .tag = ");
    self.state.write(enum_name);
    self.state.write("_");
    self.state.write(variant_name);
    self.state.write(", .payload.");
    self.state.write(variant_name);
    self.state.write(" = { ");
    num i = 0;
    for arg : args {
      if i > 0 {
        self.state.write(", ");
      }
      self.state.write("._");
      self.state.write(format_num(i));
      self.state.write(" = (");
      let aerr = self.emit_expr(*arg);
      if aerr.is_some() {
        ret aerr;
      }
      self.state.write(")");
      i = i + 1;
    }
    self.state.write(" } })");
    ret .None;
  }

  // Emits `recv.field` as C `recv.field` or `recv->field`, deciding
  // `.`/`->` from `recv`'s DECLARED pointer-ness (`lookup_local_is_pointer`
  // -- no type inference, just the same "already fully explicit" model
  // this whole file uses elsewhere). Also recognizes a QUALIFIED
  // enum-variant-constant access (`EnumName.Variant`, checked first --
  // see `enum_has_variant`) and emits its mangled C constant
  // (`EnumName_Variant`, single underscore, matching `emit_enum`'s own
  // naming) instead of treating `EnumName` as a receiver.
  // 
  // Deliberately narrow for this slice: `recv` must be a plain identifier
  // that's either a known enum name (for the qualified-variant case) or a
  // KNOWN local (a function parameter or a `Variable` declaration already
  // emitted earlier in this same function -- see `record_local`, for the
  // field-access case). This is a conservative choice, not just a missing
  // feature: the exact same AST shape (`Identifier . Identifier`) is ALSO
  // how a BARE enum-variant shorthand's qualified form and `alias.symbol`
  // (a module-aliased access) parse, and neither is reachable yet (bare
  // shorthand needs type inference from the expected type; module aliases
  // need import support). Silently guessing "not a pointer, use `.`" for
  // an unrecognized receiver would emit plausible-looking but WRONG C
  // (e.g. treating an unregistered enum name as a struct value) -- so it's
  // rejected rather than guessed. Chained access (`a.b.c`) is also
  // deferred: it needs the FIELD's own declared type (not just a local's),
  // which needs a compound-field-type registry that doesn't exist yet
  // either.
  emit_field_access(ExprNode e) Option<CodegenErrorKind> {
    if !e.has_left || !e.has_right {
      ret .Some(CodegenErrorKind.InvalidNode);
    }
    str recv_name = "";
    fit e.left.kind {
      .Identifier(name) -> { recv_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    str field_name = "";
    fit e.right.kind {
      .Identifier(name) -> { field_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    if self.enum_has_variant(recv_name, field_name) {
      if self.enum_is_tagged_union_named(recv_name) {
        // A tagged union's payload-less variant used as a bare VALUE
        // (no call) still needs the tag set: `((Enum){ .tag =
        // Enum_Variant })`, not just the bare discriminant constant --
        // see `emit_enum`'s doc comment for the struct layout this
        // constructs. `EnumName_Variant` alone would only be the
        // discriminant, not a complete `Enum`-typed value.
        self.state.write("((");
        self.state.write(recv_name);
        self.state.write("){ .tag = ");
        self.state.write(recv_name);
        self.state.write("_");
        self.state.write(field_name);
        self.state.write(" })");
      } else {
        self.state.write(recv_name);
        self.state.write("_");
        self.state.write(field_name);
      }
      ret .None;
    }
    let found = self.lookup_local_is_pointer(recv_name);
    if found.is_none() {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }
    self.state.write(recv_name);
    if found.unwrap() {
      self.state.write("->");
    } else {
      self.state.write(".");
    }
    self.state.write(field_name);
    ret .None;
  }

  // Emits one statement, followed by its own trailing newline (statements
  // are the unit `emit_statements` iterates, so each ends its own line).
  // `StatementIf`/`StatementElseIf`/`StatementElse` are deliberately NOT
  // handled here -- they're only ever valid chained together, which needs
  // sibling lookahead only `emit_statements` (its caller) has; reaching
  // this function directly (an if/elif/else with no chain context) is a
  // bug in the caller, so it's an explicit error rather than emitting a
  // lone, invalid C `if`/`else if`/`else` fragment.
  pub emit_statement(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .StatementReturn(exp) -> {
        self.state.write_indent();
        self.state.write("return");
        if exp != nil {
          self.state.write(" ");
          let eerr = self.emit_expr(*exp);
          if eerr.is_some() {
            ret eerr;
          }
        }
        self.state.write(";\n");
        ret .None;
      }
      .Variable(v) -> {
        self.state.write_indent();
        self.write_type(*v.var_type);
        self.state.write(" ");
        self.state.write(v.name);
        if v.has_val {
          self.state.write(" = ");
          let verr = self.emit_expr(*v.val);
          if verr.is_some() {
            ret verr;
          }
        }
        self.state.write(";\n");
        self.record_local(v.name, v.var_type.type_str, dtype_is_pointer(*v.var_type));
        ret .None;
      }
      .StatementFor(fk) -> {
        self.state.write_indent();
        fit fk {
          .Cond(fc) -> { ret self.emit_for_cond(fc); }
          .Range(fr) -> { ret self.emit_for_range(fr); }
          .Iter(fi) -> { ret self.emit_for_iter(fi); }
        }
      }
      .StatementFit(f) -> {
        self.state.write_indent();
        ret self.emit_fit(f);
      }
      // A bare expression used as a statement (an assignment, a call for
      // its side effect, `x++;`, ...) parses as a plain `.Expression`/
      // `.Unary` node directly in the statement list -- there's no
      // dedicated `StatementExpression` wrapper (see `parse_statement`'s
      // fallthrough to `parse_expressionable_root` in the parser). Emit it
      // as `<expr>;` followed by its own newline, same as every other
      // statement.
      .Expression(_) -> {
        self.state.write_indent();
        let eerr = self.emit_expr(node);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      .Unary(_) -> {
        self.state.write_indent();
        let uerr = self.emit_expr(node);
        if uerr.is_some() {
          ret uerr;
        }
        self.state.write(";\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
  }

  // Emits `for { ... }` (infinite) or `for cond { ... }` as the direct C
  // equivalent: `while (1) { ... }` / `while (cond) { ... }` -- a
  // conditional `for` has no init/increment clauses of its own, so a
  // `while` loop is exactly the same construct.
  emit_for_cond(ForCondNode fc) Option<CodegenErrorKind> {
    if fc.has_condition {
      self.state.write("while (");
      let cerr = self.emit_expr(*fc.condition);
      if cerr.is_some() {
        ret cerr;
      }
      self.state.write(") {\n");
    } else {
      self.state.write("while (1) {\n");
    }
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*fc.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    ret .None;
  }

  // Emits `for i : start..end { ... }` as `for (int64_t i = start; i <
  // end; i++) { ... }`. `range_expr` is always an `Expression{ op = ".." }`
  // (start on the left, end on the right) -- see `parse_for_statement`'s
  // doc comment in the parser for how the range/condition forms are
  // disambiguated at parse time.
  emit_for_range(ForRangeNode fr) Option<CodegenErrorKind> {
    fit fr.range_expr.kind {
      .Expression(e) -> {
        if !equals(e.op, "..") || !e.has_left || !e.has_right {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.state.write("for (int64_t ");
        self.state.write(fr.index_name);
        self.state.write(" = ");
        let serr = self.emit_expr(*e.left);
        if serr.is_some() {
          ret serr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write(" < ");
        let eerr = self.emit_expr(*e.right);
        if eerr.is_some() {
          ret eerr;
        }
        self.state.write("; ");
        self.state.write(fr.index_name);
        self.state.write("++) {\n");
        self.state.indent_level = self.state.indent_level + 1;
        let berr = self.emit_body(*fr.body);
        if berr.is_some() {
          ret berr;
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write_indent();
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits `for item : arr { ... }` / `for i, item :: arr { ... }` as the
  // original's own "Vec fast path": `for (int64_t idx = 0; idx <
  // arr.len; idx++) { __auto_type item = arr.data[idx]; ... }` -- `idx`
  // is `fi.index_name` when given, else a synthetic `__fun_i`. Reads
  // straight from `Vec<T>`'s own `.len`/`.data` fields rather than a
  // generic `Iterator`-quirk `.next()` dispatch (dynamic quirk dispatch
  // isn't reachable yet -- see this file's own top-level doc comment).
  // `__auto_type` (a GNU C extension) lets the C compiler infer `item`'s
  // type from `arr.data[idx]` -- this codegen never needs to know `T`
  // itself, matching the original's own choice here.
  // 
  // Deliberately narrow for this slice: `arr` must be a plain identifier
  // that's a known local whose declared type name is EXACTLY "Vec" (an
  // array literal or a general `Iterator`-implementing quirk value isn't
  // reachable yet either). `item` is NOT recorded in the locals table --
  // its declared Fun type is unknown here (that's the whole point of
  // `__auto_type`), so a later `item.field` inside the body is correctly
  // rejected by `emit_field_access` rather than guessed at; dereferencing
  // it (`*item`, common when `T` is itself a pointer) works fine since
  // that doesn't need a locals lookup at all.
  emit_for_iter(ForIterNode fi) Option<CodegenErrorKind> {
    str arr_name = "";
    fit fi.iterable.kind {
      .Identifier(name) -> { arr_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }
    let type_found = self.lookup_local_type_name(arr_name);
    if type_found.is_none() || !equals(type_found.unwrap(), "Vec") {
      ret .Some(CodegenErrorKind.UnsupportedNode);
    }

    str idx_name = "__fun_i";
    if fi.has_index_name {
      idx_name = fi.index_name;
    }

    self.state.write("for (int64_t ");
    self.state.write(idx_name);
    self.state.write(" = 0; ");
    self.state.write(idx_name);
    self.state.write(" < ");
    self.state.write(arr_name);
    self.state.write(".len; ");
    self.state.write(idx_name);
    self.state.write("++) {\n");
    self.state.indent_level = self.state.indent_level + 1;
    self.state.write_indent();
    self.state.write("__auto_type ");
    self.state.write(fi.item_name);
    self.state.write(" = ");
    self.state.write(arr_name);
    self.state.write(".data[");
    self.state.write(idx_name);
    self.state.write("];\n");
    let berr = self.emit_body(*fi.body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}\n");
    ret .None;
  }

  // Emits `fit subject { patterns -> { body } ... }` as a chain of C
  // `if`/`else if`/`else` blocks comparing `subject` against each
  // branch's literal pattern(s) -- mirrors the original's own `str`/
  // `dec` "if/else-if chain" lowering, but applied UNIFORMLY here (no
  // `switch` path for an integral/enum subject, since this codegen has
  // no type inference to pick a subject-wide strategy). A `str` pattern
  // label compares via `strcmp(...) == 0`; every other literal kind
  // compares via `==` -- decided PER LABEL from that label's own literal
  // kind, not once for the whole subject.
  // 
  // Deliberately narrow for this slice: the subject must be a plain
  // identifier, re-evaluated once per branch instead of hoisted into a
  // temp variable -- safe only because reading a plain identifier twice
  // has no side effects (a call subject would need a temp var, and this
  // codegen has no type to declare one with anyway). A comma-chained
  // pattern (`1, 2 -> ...`) matches any of its values (OR-ed
  // comparisons); reuses `flatten_call_args` directly for that, since
  // it's the exact same comma-flattening a call's argument list needs.
  // Bare enum-variant shorthand/destructuring patterns (`.Some(x) ->
  // ...`) aren't reachable yet (no enum support) -- such a branch's
  // condition naturally fails with `UnsupportedNode` rather than
  // emitting wrong C, since it isn't a literal `emit_expr` can compare
  // an identifier against. Explicit destructuring bindings
  // (`has_bindings`) are rejected outright for the same reason.
  emit_fit(FitStmtNode f) Option<CodegenErrorKind> {
    str subj_name = "";
    fit f.exp.kind {
      .Identifier(name) -> { subj_name = name; }
      _ -> { ret .Some(CodegenErrorKind.UnsupportedNode); }
    }

    bin wrote_branch = false;
    Node* default_body = nil;
    bin has_default = false;

    for br : f.branches {
      if br.has_bindings && br.bindings.len > 0 {
        ret .Some(CodegenErrorKind.UnsupportedNode);
      }
      if !br.has_condition {
        default_body = br.body;
        has_default = true;
        continue;
      }

      if wrote_branch {
        self.state.write(" else if (");
      } else {
        self.state.write("if (");
      }

      Vec<Node*> labels;
      labels.init(0);
      defer labels.free();
      self.flatten_call_args(br.condition, &labels);

      bin first_label = true;
      for lbl : labels {
        if !first_label {
          self.state.write(" || ");
        }
        first_label = false;
        bin is_str_label = false;
        fit lbl.kind {
          .String(_) -> { is_str_label = true; }
          _ -> {}
        }
        if is_str_label {
          self.state.write("strcmp(");
          self.state.write(subj_name);
          self.state.write(", ");
          let lerr = self.emit_expr(*lbl);
          if lerr.is_some() {
            ret lerr;
          }
          self.state.write(") == 0");
        } else {
          self.state.write(subj_name);
          self.state.write(" == ");
          let lerr2 = self.emit_expr(*lbl);
          if lerr2.is_some() {
            ret lerr2;
          }
        }
      }

      self.state.write(") {\n");
      self.state.indent_level = self.state.indent_level + 1;
      let berr = self.emit_body(*br.body);
      if berr.is_some() {
        ret berr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
      wrote_branch = true;
    }

    if has_default {
      if wrote_branch {
        self.state.write(" else {\n");
      } else {
        self.state.write("{\n");
      }
      self.state.indent_level = self.state.indent_level + 1;
      let dberr = self.emit_body(*default_body);
      if dberr.is_some() {
        ret dberr;
      }
      self.state.indent_level = self.state.indent_level - 1;
      self.state.write_indent();
      self.state.write("}");
    }
    self.state.write("\n");
    ret .None;
  }

  // Emits an `if (cond) { ... }` block, WITHOUT the trailing newline (the
  // caller -- either `emit_statements` chaining a following elif/else, or
  // this same function recursing for one) decides what comes next).
  emit_if_block(Node* condition, Node* body) Option<CodegenErrorKind> {
    self.state.write("if (");
    let cerr = self.emit_expr(*condition);
    if cerr.is_some() {
      ret cerr;
    }
    self.state.write(") {\n");
    self.state.indent_level = self.state.indent_level + 1;
    let berr = self.emit_body(*body);
    if berr.is_some() {
      ret berr;
    }
    self.state.indent_level = self.state.indent_level - 1;
    self.state.write_indent();
    self.state.write("}");
    ret .None;
  }

  // Emits `stmts[start_i]` (a `StatementIf`) chained with every
  // immediately-following `StatementElseIf`/`StatementElse` sibling as a
  // single C `if (...) { } else if (...) { } else { }` construct, and
  // returns the index just past the whole chain.
  // 
  // `if`/`elif`/`else` are parsed as three INDEPENDENT sibling statement
  // kinds, not a nested tree (see `StatementIf`/`StatementElseIf`/
  // `StatementElse`'s own doc comments in ast.fn) -- so chaining them into
  // one C construct needs this adjacency lookahead over the statement
  // list, mirroring the original's `current_statement_type`/
  // `next_statement_type` tracking for the same purpose.
  emit_if_chain(Vec<Node*> stmts, num start_i, num* out_next_i) Option<CodegenErrorKind> {
    Node* if_stmt = stmts.get(start_i);
    fit if_stmt.kind {
      .StatementIf(ifn) -> {
        let ferr = self.emit_if_block(ifn.condition, ifn.body);
        if ferr.is_some() {
          ret ferr;
        }
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }

    num i = start_i + 1;
    for i < stmts.len {
      Node* next = stmts.get(i);
      bin chained = false;
      fit next.kind {
        .StatementElseIf(ein) -> {
          self.state.write(" else ");
          let eerr = self.emit_if_block(ein.condition, ein.body);
          if eerr.is_some() {
            ret eerr;
          }
          chained = true;
        }
        .StatementElse(ebody) -> {
          self.state.write(" else {\n");
          self.state.indent_level = self.state.indent_level + 1;
          let elerr = self.emit_body(*ebody);
          if elerr.is_some() {
            ret elerr;
          }
          self.state.indent_level = self.state.indent_level - 1;
          self.state.write_indent();
          self.state.write("}");
          chained = true;
        }
        _ -> {}
      }
      if !chained {
        break;
      }
      i = i + 1;
    }
    self.state.write("\n");
    *out_next_i = i;
    ret .None;
  }

  // Emits `stmts` in order, one statement per line, chaining any
  // `StatementIf`/`StatementElseIf`/`StatementElse` run into a single C
  // if/else-if/else construct via `emit_if_chain`.
  emit_statements(Vec<Node*> stmts) Option<CodegenErrorKind> {
    num i = 0;
    for i < stmts.len {
      Node* stmt = stmts.get(i);
      bin is_if = false;
      fit stmt.kind {
        .StatementIf(ifn) -> { is_if = true; }
        _ -> {}
      }
      if is_if {
        self.state.write_indent();
        num next_i = i;
        let cherr = self.emit_if_chain(stmts, i, &next_i);
        if cherr.is_some() {
          ret cherr;
        }
        i = next_i;
        continue;
      }
      let serr = self.emit_statement(*stmt);
      if serr.is_some() {
        ret serr;
      }
      i = i + 1;
    }
    ret .None;
  }

  // Emits `body`: every statement in order when it's a `Body` block, or
  // just the one statement when it's a single braceless statement (an
  // `if`/`for`/... body doesn't require `{ }` when it's a single
  // statement -- see `_parse_if_body`'s doc comment in the parser).
  emit_body(Node body) Option<CodegenErrorKind> {
    fit body.kind {
      .Body(bn) -> { ret self.emit_statements(bn.statements); }
      _ -> { ret self.emit_statement(body); }
    }
  }

  // Emits one function parameter (a `Variable` node with no initializer)
  // as `<type> <name>`, and records it as a local for `.`/`->` decisions
  // (see `Codegen.local_names`'s doc comment).
  emit_function_param(Node param) Option<CodegenErrorKind> {
    fit param.kind {
      .Variable(v) -> {
        self.write_type(*v.var_type);
        self.state.write(" ");
        self.state.write(v.name);
        self.record_local(v.name, v.var_type.type_str, dtype_is_pointer(*v.var_type));
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a plain (no generics, no variadics) top-level function
  // declaration as a C function definition: `<rtype> <name>(<args>) {
  // <body> }` (or `(void)` for a zero-arg function, matching C
  // convention -- an empty `()` in C means "unspecified arguments", not
  // "no arguments").
  pub emit_function(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Function(f) -> {
        // Fresh per function -- see `Codegen.local_names`'s doc comment;
        // this is deliberately NOT scoped to nested blocks (an inner `{
        // }` shadowing an outer local of the same name would get this
        // wrong), which is fine for now since nothing this slice's tests
        // exercise shadows a local.
        self.local_names.init(0);
        self.local_is_pointer.init(0);
        if !f.has_rtype {
          ret .Some(CodegenErrorKind.InvalidNode);
        }
        self.write_type(*f.rtype);
        self.state.write(" ");
        self.state.write(f.name);
        self.state.write("(");
        if f.has_args && f.args.len > 0 {
          bin first = true;
          for arg : f.args {
            if !first {
              self.state.write(", ");
            }
            first = false;
            let aerr = self.emit_function_param(*arg);
            if aerr.is_some() {
              ret aerr;
            }
          }
        } else {
          self.state.write("void");
        }
        self.state.write(") {\n");
        self.state.indent_level = self.state.indent_level + 1;
        if f.has_body {
          let berr = self.emit_body(*f.body);
          if berr.is_some() {
            ret berr;
          }
        }
        self.state.indent_level = self.state.indent_level - 1;
        self.state.write("}\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a non-generic, non-tagged-union (no variant has a payload)
  // `enum Name { variants }` declaration as a C enum typedef: `typedef
  // enum Name { Name_Variant1, Name_Variant2 = <val>, ... } Name;` --
  // single underscore between the enum name and each variant, matching
  // the original and distinct from the double-underscore `Type__method`
  // impl-method mangling. Also registers the enum (`record_enum`) so a
  // later `EnumName.Variant` qualified access resolves to the right
  // constant -- see `emit_field_access`'s doc comment.
  // 
  // Deliberately simplified from the original for this slice: a
  // TAGGED-UNION enum (any variant with a payload, `has_payload`) is
  // silently skipped -- that lowers to a `struct { tag; union; }` in the
  // original, a separate, larger deferred item (this also blocks bare
  // enum-variant-shorthand patterns like `.Some(x)`, since those need a
  // payload-carrying enum's tag/union machinery, not just a constant). A
  // GENERIC enum (`has_type_params`) is skipped too, same reasoning as
  // `emit_compound`'s generic-template skip -- monomorphization is
  // separate.
  emit_enum(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Enum(e) -> {
        if e.has_type_params {
          ret .None;
        }
        bin is_tagged_union = false;
        for v : e.variants {
          if v.has_payload && v.payload.len > 0 {
            is_tagged_union = true;
          }
        }

        Vec<str> variant_names;
        variant_names.init(0);
        for v : e.variants {
          variant_names.push(v.name);
        }

        if is_tagged_union {
          self.emit_tagged_union_enum(e);
        } else {
          self.state.write("typedef enum ");
          self.state.write(e.name);
          self.state.write(" {\n");
          for v : e.variants {
            self.state.write("  ");
            self.state.write(e.name);
            self.state.write("_");
            self.state.write(v.name);
            if v.has_value {
              self.state.write(" = ");
              self.state.write(format_num(v.value));
            }
            self.state.write(",\n");
          }
          self.state.write("} ");
          self.state.write(e.name);
          self.state.write(";\n\n");
        }
        self.record_enum(e.name, variant_names, is_tagged_union);
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits a data-carrying (tagged-union) enum as the original's own
  // layout:
  // typedef enum Name_tag { Name_Variant1, Name_Variant2, ... } Name_tag;
  // typedef struct Name {
  // Name_tag tag;
  // union {
  // struct { <type> _0; <type> _1; ... } Variant1;
  // ...
  // } payload;
  // } Name;
  // A payload-less variant occupies a tag slot but no union member.
  // Payload fields are named positionally (`_0`, `_1`, ...), matching
  // `emit_enum_variant_construction`'s own field names.
  emit_tagged_union_enum(EnumDeclNode e) {
    self.state.write("typedef enum ");
    self.state.write(e.name);
    self.state.write("_tag {\n");
    for v : e.variants {
      self.state.write("  ");
      self.state.write(e.name);
      self.state.write("_");
      self.state.write(v.name);
      self.state.write(",\n");
    }
    self.state.write("} ");
    self.state.write(e.name);
    self.state.write("_tag;\n");

    self.state.write("typedef struct ");
    self.state.write(e.name);
    self.state.write(" {\n  ");
    self.state.write(e.name);
    self.state.write("_tag tag;\n  union {\n");
    for v : e.variants {
      if v.has_payload && v.payload.len > 0 {
        self.state.write("    struct { ");
        num i = 0;
        for pt : v.payload {
          self.write_type(*pt);
          self.state.write(" _");
          self.state.write(format_num(i));
          self.state.write("; ");
          i = i + 1;
        }
        self.state.write("} ");
        self.state.write(v.name);
        self.state.write(";\n");
      }
    }
    self.state.write("  } payload;\n} ");
    self.state.write(e.name);
    self.state.write(";\n\n");
  }

  // Emits a non-generic `compound Name { fields }` declaration as a C
  // struct typedef: `typedef struct Name { <type> <field>; ... } Name;`.
  // 
  // Deliberately simplified from the original for this slice: a generic
  // compound (`has_type_params`) is silently skipped rather than emitted
  // (matching the original's own rule that a generic TEMPLATE is never
  // emitted directly, only its concrete monomorphized specializations --
  // monomorphization itself is a separate, larger deferred item). No
  // forward declaration and no dependency-ordering pass for by-value
  // nested compounds either (the original topologically sorts these) --
  // this assumes source order already satisfies it, same as a plain
  // sequential C struct-after-struct listing would require. No array-
  // typed fields (`T[3]`/`T[]`) -- only scalar/pointer field types.
  emit_compound(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Compound(c) -> {
        if c.has_type_params {
          ret .None;
        }
        self.state.write("typedef struct ");
        self.state.write(c.name);
        self.state.write(" {\n");
        for f : c.fields {
          self.state.write("  ");
          self.write_type(*f.dtype);
          self.state.write(" ");
          self.state.write(f.name);
          self.state.write(";\n");
        }
        self.state.write("} ");
        self.state.write(c.name);
        self.state.write(";\n\n");
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Emits every method of a plain (non-quirk, non-generic) `impl Type {
  // methods }` block as an ordinary top-level C function -- the parser
  // ALREADY did the work that makes this trivial: each method is parsed
  // as a `Function` node pre-mangled to `Type__method` with `<Type>*
  // self` as its real first arg (`_parse_impl_method`'s doc comment in
  // the parser), so a method is emitted exactly like any other function
  // via the existing `emit_function` -- no separate self-injection or
  // name-mangling logic needed here.
  // 
  // Deliberately simplified from the original for this slice: a
  // quirk-implementing impl (`impl Type as Quirk { ... }`, `has_quirk_
  // name`) is silently skipped -- its methods are still dispatched
  // dynamically through a vtable in the original, which is a separate,
  // larger deferred item (see this file's own top-level doc comment). A
  // generic impl (`has_type_params`) is skipped too, same reasoning as
  // `emit_compound`'s generic-template skip.
  emit_impl(Node node) Option<CodegenErrorKind> {
    fit node.kind {
      .Impl(i) -> {
        if i.has_type_params || i.has_quirk_name {
          ret .None;
        }
        for m : i.methods {
          let merr = self.emit_function(*m);
          if merr.is_some() {
            ret merr;
          }
        }
        ret .None;
      }
      _ -> { ret .Some(CodegenErrorKind.InvalidNode); }
    }
  }

  // Writes the fixed set of C headers the original always includes
  // (before any conditional ones gated on stdlib usage, threads, sockets,
  // etc. -- none of which are reachable yet since imports aren't ported).
  pub write_prelude() {
    self.state.write("#include <stdio.h>\n");
    self.state.write("#include <stdbool.h>\n");
    self.state.write("#include <stdint.h>\n");
    self.state.write("#include <stdarg.h>\n");
    self.state.write("#include <stdlib.h>\n");
    self.state.write("#include <string.h>\n");
  }

  // Transpiles every top-level `Enum`/`Compound`/`Impl`/`Function` node
  // in `nodes` (anything else is skipped -- not an error, since a
  // whole-file parse can contain declarations not reachable yet, like
  // `imp`). Enums are emitted first (registering their names/variants as
  // a side effect -- see `emit_enum`'s doc comment), then compounds, all
  // before any impl-method/function, so those can reference any of them
  // regardless of source order -- see `emit_compound`'s doc comment for
  // what that pass deliberately doesn't handle yet (dependency ordering
  // between compounds themselves). Impl methods are emitted in a third
  // pass (each becomes an ordinary C function, see `emit_impl`), before
  // plain top-level functions in a fourth, so a plain function calling a
  // method doesn't need a forward declaration.
  pub transpile(Vec<Node> nodes) Option<CodegenErrorKind> {
    self.write_prelude();
    for n : nodes {
      fit n.kind {
        .Enum(e) -> {
          let eerr = self.emit_enum(n);
          if eerr.is_some() {
            ret eerr;
          }
        }
        _ -> {}
      }
    }
    for n : nodes {
      fit n.kind {
        .Compound(c) -> {
          let cerr = self.emit_compound(n);
          if cerr.is_some() {
            ret cerr;
          }
        }
        _ -> {}
      }
    }
    for n : nodes {
      fit n.kind {
        .Impl(i) -> {
          let ierr = self.emit_impl(n);
          if ierr.is_some() {
            ret ierr;
          }
        }
        _ -> {}
      }
    }
    for n : nodes {
      fit n.kind {
        .Function(f) -> {
          let ferr = self.emit_function(n);
          if ferr.is_some() {
            ret ferr;
          }
        }
        _ -> {}
      }
    }
    ret .None;
  }
}

test "write_type emits builtin scalar C types with pointer depth" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "num";
  g.write_type(dt);
  assert equals(st.out.build(), "int64_t"), "expected 'int64_t'";

  CodegenState st2 = codegen_state_new();
  Codegen g2 = codegen_new(&st2);
  DataType dt2 = dtype_new();
  dt2.type_str = "chr";
  dt2.pointer_depth = 2;
  g2.write_type(dt2);
  assert equals(st2.out.build(), "char**"), "expected 'char**'";
}

test "write_type emits a sized int via dynamic_int_type_to_c" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType dt = dtype_new();
  dt.type_str = "u32";
  g.write_type(dt);
  assert equals(st.out.build(), "uint32_t"), "expected 'uint32_t'";
}

test "emit_expr emits a number literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Number(TokenData.Num(42)));
  assert g.emit_expr(n).is_none(), "expected the number to emit";
  assert equals(st.out.build(), "42"), "expected '42'";
}

test "emit_expr emits a string literal verbatim between quotes" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.String("hello"));
  assert g.emit_expr(n).is_none(), "expected the string to emit";
  assert equals(st.out.build(), "\"hello\""), "expected a quoted string";
}

test "emit_expr emits a boolean literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Boolean(true));
  assert g.emit_expr(n).is_none(), "expected the boolean to emit";
  assert equals(st.out.build(), "true"), "expected 'true'";
}

test "emit_expr escapes a character literal" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Character('\n'));
  assert g.emit_expr(n).is_none(), "expected the character to emit";
  assert equals(st.out.build(), "'\\n'"), "expected an escaped newline character literal";
}

test "emit_expr emits an identifier" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.Identifier("x"));
  assert g.emit_expr(n).is_none(), "expected the identifier to emit";
  assert equals(st.out.build(), "x"), "expected 'x'";
}

test "emit_expr emits a prefix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "-";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(-x)"), "expected '(-x)'";
}

test "emit_expr emits pointer indirection as a run of stars" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = false;
  u.op = "*";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("p"));
  u.operand = operand;
  u.has_indirection = true;
  u.indirection_depth = 2;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(**p)"), "expected '(**p)'";
}

test "emit_expr emits a postfix unary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  UnaryNode u;
  u.is_left_operanded_unary = true;
  u.op = "++";
  Node* operand = malloc(sizeof(Node));
  *operand = node_new(NodeKind.Identifier("x"));
  u.operand = operand;
  u.has_indirection = false;
  u.indirection_depth = 0;
  Node n = node_new(NodeKind.Unary(u));
  assert g.emit_expr(n).is_none(), "expected the unary to emit";
  assert equals(st.out.build(), "(x++)"), "expected '(x++)'";
}

test "emit_expr emits a binary expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "+";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the expression to emit";
  assert equals(st.out.build(), "(a + b)"), "expected '(a + b)'";
}

test "emit_expr emits an explicit parenthesized sub-expression" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "+";
  Node* sum = malloc(sizeof(Node));
  *sum = node_new(NodeKind.Expression(e));
  Node n = node_new(NodeKind.ExpressionParenthesis(sum));
  assert g.emit_expr(n).is_none(), "expected the parenthesized expression to emit";
  assert equals(st.out.build(), "((a + b))"), "expected '((a + b))'";
}

test "emit_expr rejects an index/comma expression (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* left = malloc(sizeof(Node));
  *left = node_new(NodeKind.Identifier("a"));
  Node* right = malloc(sizeof(Node));
  *right = node_new(NodeKind.Identifier("b"));
  ExprNode e;
  e.left = left;
  e.has_left = true;
  e.right = right;
  e.has_right = true;
  e.op = "[]";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected an index expression to be rejected this slice";
}

test "emit_expr emits a zero-arg call" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo()"), "expected 'foo()'";
}

test "emit_expr emits a multi-arg call, flattening the comma-chained argument list" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("foo"));

  Node* arg_a = malloc(sizeof(Node));
  *arg_a = node_new(NodeKind.Identifier("a"));
  Node* arg_b = malloc(sizeof(Node));
  *arg_b = node_new(NodeKind.Identifier("b"));
  ExprNode comma;
  comma.left = arg_a;
  comma.has_left = true;
  comma.right = arg_b;
  comma.has_right = true;
  comma.op = ",";
  Node* comma_node = malloc(sizeof(Node));
  *comma_node = node_new(NodeKind.Expression(comma));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(comma_node));

  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_none(), "expected the call to emit";
  assert equals(st.out.build(), "foo(a, b)"), "expected 'foo(a, b)'";
}

test "emit_expr rejects a call whose callee isn't a plain identifier (not yet supported)" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(blank));
  ExprNode e;
  e.left = callee;
  e.has_left = true;
  e.right = args;
  e.has_right = true;
  e.op = "()";
  Node n = node_new(NodeKind.Expression(e));
  assert g.emit_expr(n).is_some(), "expected a non-identifier callee to be rejected this slice";
}

test "emit_statement emits a variable declaration with an initializer" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "num";
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(5)));
  VariableNode v;
  v.var_type = dt;
  v.name = "x";
  v.val = val;
  v.has_val = true;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "int64_t x = 5;\n"), "expected 'int64_t x = 5;\\n'";
}

test "emit_statement emits an uninitialized variable declaration" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "bin";
  VariableNode v;
  v.var_type = dt;
  v.name = "done";
  v.val = nil;
  v.has_val = false;
  Node n = node_new(NodeKind.Variable(v));
  assert g.emit_statement(n).is_none(), "expected the variable declaration to emit";
  assert equals(st.out.build(), "bool done;\n"), "expected 'bool done;\\n'";
}

test "emit_body emits a plain if statement with no elif/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Identifier("ok"));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret_stmt);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));

  IfStmtNode ifn;
  ifn.condition = cond;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if statement to emit";
  assert equals(st.out.build(), "if (ok) {\n    return;\n}\n"), "expected a plain if block";
}

test "emit_body chains StatementIf/StatementElseIf/StatementElse into one if/else-if/else" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  // if a { ret 1; } elif b { ret 2; } else { ret 3; }
  Node* cond_a = malloc(sizeof(Node));
  *cond_a = node_new(NodeKind.Identifier("a"));
  Node* val1 = malloc(sizeof(Node));
  *val1 = node_new(NodeKind.Number(TokenData.Num(1)));
  Node* ret1 = malloc(sizeof(Node));
  *ret1 = node_new(NodeKind.StatementReturn(val1));
  Vec<Node*> if_stmts;
  if_stmts.init(0);
  if_stmts.push(ret1);
  BodyNode if_body_n;
  if_body_n.statements = if_stmts;
  Node* if_body = malloc(sizeof(Node));
  *if_body = node_new(NodeKind.Body(if_body_n));
  IfStmtNode ifn;
  ifn.condition = cond_a;
  ifn.body = if_body;
  Node* if_stmt = malloc(sizeof(Node));
  *if_stmt = node_new(NodeKind.StatementIf(ifn));

  Node* cond_b = malloc(sizeof(Node));
  *cond_b = node_new(NodeKind.Identifier("b"));
  Node* val2 = malloc(sizeof(Node));
  *val2 = node_new(NodeKind.Number(TokenData.Num(2)));
  Node* ret2 = malloc(sizeof(Node));
  *ret2 = node_new(NodeKind.StatementReturn(val2));
  Vec<Node*> elif_stmts;
  elif_stmts.init(0);
  elif_stmts.push(ret2);
  BodyNode elif_body_n;
  elif_body_n.statements = elif_stmts;
  Node* elif_body = malloc(sizeof(Node));
  *elif_body = node_new(NodeKind.Body(elif_body_n));
  IfStmtNode ein;
  ein.condition = cond_b;
  ein.body = elif_body;
  Node* elif_stmt = malloc(sizeof(Node));
  *elif_stmt = node_new(NodeKind.StatementElseIf(ein));

  Node* val3 = malloc(sizeof(Node));
  *val3 = node_new(NodeKind.Number(TokenData.Num(3)));
  Node* ret3 = malloc(sizeof(Node));
  *ret3 = node_new(NodeKind.StatementReturn(val3));
  Vec<Node*> else_stmts;
  else_stmts.init(0);
  else_stmts.push(ret3);
  BodyNode else_body_n;
  else_body_n.statements = else_stmts;
  Node* else_body = malloc(sizeof(Node));
  *else_body = node_new(NodeKind.Body(else_body_n));
  Node* else_stmt = malloc(sizeof(Node));
  *else_stmt = node_new(NodeKind.StatementElse(else_body));

  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(if_stmt);
  stmts.push(elif_stmt);
  stmts.push(else_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node body = node_new(NodeKind.Body(bn));

  assert g.emit_body(body).is_none(), "expected the if/elif/else chain to emit";
  let out = st.out.build();
  assert equals(
    out,
    "if (a) {\n    return 1;\n} else if (b) {\n    return 2;\n} else {\n    return 3;\n}\n"
  ), "expected a single chained if/else-if/else C construct";
}

test "emit_statement emits a bare 'ret;' as 'return;'" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  Node n = node_new(NodeKind.StatementReturn(nil));
  assert g.emit_statement(n).is_none(), "expected the return to emit";
  assert equals(st.out.build(), "return;\n"), "expected 'return;\\n'";
}

