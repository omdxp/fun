test "emit_statement resolves a bare-shorthand assignment right-hand side against the field's declared type" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("t", "Token", true);

  Vec<str> token_fields;
  token_fields.init(0);
  token_fields.push("data");
  Vec<str> token_field_types;
  token_field_types.init(0);
  token_field_types.push("TokenData");
  Vec<bin> token_field_ptrs;
  token_field_ptrs.init(0);
  token_field_ptrs.push(false);
  g.record_compound("Token", token_fields, token_field_types, token_field_ptrs);

  Vec<str> variants;
  variants.init(0);
  variants.push("Cval");
  variants.push("Num");
  g.record_enum("TokenData", variants, true);

  // `t.data = .Cval(0);` -- t is a POINTER local (mirroring `t.data`'s
  // real usage in selfhost/lexer/lexer.fn, where the token being built is
  // always passed/held by pointer), so the left side itself needs `->`.
  Node* t_ident = malloc(sizeof(Node));
  *t_ident = node_new(NodeKind.Identifier("t"));
  Node* data_ident = malloc(sizeof(Node));
  *data_ident = node_new(NodeKind.Identifier("data"));
  ExprNode lhs_dot;
  lhs_dot.left = t_ident;
  lhs_dot.has_left = true;
  lhs_dot.right = data_ident;
  lhs_dot.has_right = true;
  lhs_dot.op = ".";
  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(NodeKind.Expression(lhs_dot));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("Cval"));
  Node* zero = malloc(sizeof(Node));
  *zero = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* zero_args = malloc(sizeof(Node));
  *zero_args = node_new(NodeKind.ExpressionParenthesis(zero));
  ExprNode rhs_dot;
  rhs_dot.left = blank;
  rhs_dot.has_left = true;
  rhs_dot.right = variant_ident;
  rhs_dot.has_right = true;
  rhs_dot.op = ".";
  Node* rhs_callee = malloc(sizeof(Node));
  *rhs_callee = node_new(NodeKind.Expression(rhs_dot));
  ExprNode rhs_call;
  rhs_call.left = rhs_callee;
  rhs_call.has_left = true;
  rhs_call.right = zero_args;
  rhs_call.has_right = true;
  rhs_call.op = "()";
  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(NodeKind.Expression(rhs_call));

  ExprNode assign;
  assign.left = lhs;
  assign.has_left = true;
  assign.right = rhs;
  assign.has_right = true;
  assign.op = "=";
  Node n = node_new(NodeKind.Expression(assign));

  assert g.emit_statement(n).is_none(), "expected the assignment to emit, resolving the shorthand against 'data's declared type";
  assert equals(
    st.out.build(),
    "(t->data = ((TokenData){ .tag = TokenData_Cval, .payload.Cval = { ._0 = (0) } }));\n"
  ), "expected the bare '.Cval(0)' resolved against TokenData, not rejected";
}

test "emit_expr resolves a bare-shorthand equality comparison's right-hand side against the field's declared type" {
  // Regression test: `self.kind == .None` (Error.is_ok's real body in
  // stdlib/std/error.fn, found via the self-compile experiment) used to
  // fail -- a bare shorthand as a NESTED sub-expression (the right
  // operand of '==', not directly a 'ret' value/Variable initializer/
  // assignment RHS) had no expected-type context to resolve against.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.record_local("self", "Error", true);

  Vec<str> error_fields;
  error_fields.init(0);
  error_fields.push("kind");
  Vec<str> error_field_types;
  error_field_types.init(0);
  error_field_types.push("ErrorKind");
  Vec<bin> error_field_ptrs;
  error_field_ptrs.init(0);
  error_field_ptrs.push(false);
  g.record_compound("Error", error_fields, error_field_types, error_field_ptrs);

  Vec<str> variants;
  variants.init(0);
  variants.push("None");
  variants.push("Io");
  g.record_enum("ErrorKind", variants, false);

  Node* self_ident = malloc(sizeof(Node));
  *self_ident = node_new(NodeKind.Identifier("self"));
  Node* kind_ident = malloc(sizeof(Node));
  *kind_ident = node_new(NodeKind.Identifier("kind"));
  ExprNode lhs_dot;
  lhs_dot.left = self_ident;
  lhs_dot.has_left = true;
  lhs_dot.right = kind_ident;
  lhs_dot.has_right = true;
  lhs_dot.op = ".";
  Node* lhs = malloc(sizeof(Node));
  *lhs = node_new(NodeKind.Expression(lhs_dot));

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("None"));
  ExprNode rhs_dot;
  rhs_dot.left = blank;
  rhs_dot.has_left = true;
  rhs_dot.right = variant_ident;
  rhs_dot.has_right = true;
  rhs_dot.op = ".";
  Node* rhs = malloc(sizeof(Node));
  *rhs = node_new(NodeKind.Expression(rhs_dot));

  ExprNode eq;
  eq.left = lhs;
  eq.has_left = true;
  eq.right = rhs;
  eq.has_right = true;
  eq.op = "==";
  Node n = node_new(NodeKind.Expression(eq));

  assert g.emit_expr(n).is_none(), "expected 'self.kind == .None' to resolve the shorthand against 'kind's declared type";
  assert equals(st.out.build(), "(self->kind == ErrorKind_None)"), "expected the bare '.None' resolved against ErrorKind (a plain, non-tagged-union enum), not rejected";
}

test "pub transpile resolves a bare-shorthand call argument against the callee's own declared parameter type" {
  // Regression test: `err_kind(.Parse, "msg", 0)` (_read_comment_block's
  // real body in the self-hosted lexer's own source, calling
  // std.result's err_kind) used to fail -- a bare shorthand passed as a
  // CALL ARGUMENT had no expected-type context to resolve against
  // (unlike a 'ret' value/Variable initializer/assignment or comparison
  // RHS, which already worked). Fixed via a new whole-program pre-pass,
  // register_function_signatures, recording each plain function's own
  // parameter types so emit_call can resolve a bare shorthand argument
  // against the position it's actually passed to.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Vec<str> variants;
  variants.init(0);
  variants.push("None");
  variants.push("Parse");
  g.record_enum("ErrorKind", variants, false);

  DataType* kind_dt = malloc(sizeof(DataType));
  *kind_dt = dtype_new();
  kind_dt.type_str = "ErrorKind";
  VariableNode kindv;
  kindv.var_type = kind_dt;
  kindv.name = "kind";
  kindv.has_val = false;
  kindv.is_const = false;
  Node* kind_param = malloc(sizeof(Node));
  *kind_param = node_new(NodeKind.Variable(kindv));

  Vec<Node*> params;
  params.init(0);
  params.push(kind_param);

  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode takesfn = function_node_new();
  takesfn.name = "takes_kind";
  takesfn.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "void";
  rtype.kind = DataTypeType.Void;
  takesfn.rtype = rtype;
  takesfn.has_rtype = true;
  takesfn.args = params;
  takesfn.has_args = true;
  takesfn.body = body;
  takesfn.has_body = true;
  Node takes_node = node_new(NodeKind.Function(takesfn));

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("takes_kind"));
  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* variant_ident = malloc(sizeof(Node));
  *variant_ident = node_new(NodeKind.Identifier("Parse"));
  ExprNode shorthand;
  shorthand.left = blank;
  shorthand.has_left = true;
  shorthand.right = variant_ident;
  shorthand.has_right = true;
  shorthand.op = ".";
  Node* shorthand_node = malloc(sizeof(Node));
  *shorthand_node = node_new(NodeKind.Expression(shorthand));
  Node* args = malloc(sizeof(Node));
  *args = node_new(NodeKind.ExpressionParenthesis(shorthand_node));

  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));
  Node* call_ret_stmt = malloc(sizeof(Node));
  *call_ret_stmt = node_new(NodeKind.StatementReturn(call_node));
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(call_ret_stmt);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(NodeKind.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "num";
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(NodeKind.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(takes_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert contains(st.out.build(), "return takes_kind(ErrorKind_Parse);"), "expected the bare '.Parse' resolved against takes_kind's own declared 'kind' parameter type";
}

test "pub transpile monomorphizes a generic function from its own call site, inferring T from a literal argument" {
  // Regression test: found via the self-compile experiment continuing
  // past _read_comment_block's own bare-shorthand-argument fix --
  // std.result's err_kind<T>(...) Result<T, Error> is a GENERIC
  // FUNCTION (as opposed to a generic impl's methods/a generic compound/
  // a generic enum, all of which already worked), and this codegen used
  // to silently emit its bare, unsubstituted `T` as a literal (invalid)
  // C type instead of monomorphizing it. Fixed by
  // maybe_instantiate_generic_function: infers each type param's
  // concrete binding from the CALL site's own arguments (here, a plain
  // Number literal infers "num"), monomorphizes under a mangled name
  // reusing the exact same type_subst_*/emit_hoisted machinery already
  // built for generic impl methods, and rewrites the call to use it.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "T";
  VariableNode pv;
  pv.var_type = pdt;
  pv.name = "value";
  pv.has_val = false;
  pv.is_const = false;
  Node* param = malloc(sizeof(Node));
  *param = node_new(NodeKind.Variable(pv));
  Vec<Node*> params;
  params.init(0);
  params.push(param);

  Node* val_ident = malloc(sizeof(Node));
  *val_ident = node_new(NodeKind.Identifier("value"));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(val_ident));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));

  FunctionNode idfn = function_node_new();
  idfn.name = "identity";
  idfn.has_name = true;
  DataType* idrt = malloc(sizeof(DataType));
  *idrt = dtype_new();
  idrt.type_str = "T";
  idfn.rtype = idrt;
  idfn.has_rtype = true;
  idfn.type_params.push("T");
  idfn.has_type_params = true;
  idfn.args = params;
  idfn.has_args = true;
  idfn.body = body;
  idfn.has_body = true;
  Node id_node = node_new(NodeKind.Function(idfn));

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("identity"));
  Node* arg = malloc(sizeof(Node));
  *arg = node_new(NodeKind.Number(TokenData.Num(5)));
  Node* args_node = malloc(sizeof(Node));
  *args_node = node_new(NodeKind.ExpressionParenthesis(arg));
  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = args_node;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));
  Node* main_ret = malloc(sizeof(Node));
  *main_ret = node_new(NodeKind.StatementReturn(call_node));
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(main_ret);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(NodeKind.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "num";
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(NodeKind.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(id_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  assert equals(
    st.out.build(),
    `#include <stdio.h>
    `#include <stdbool.h>
    `#include <stdint.h>
    `#include <stdarg.h>
    `#include <stdlib.h>
    `#include <string.h>
    `#include <ctype.h>
    `#include <limits.h>
    `#include <math.h>
    `static FILE* stdout_stream(void){ return stdout; }
    `static FILE* stderr_stream(void){ return stderr; }
    `static FILE* stdin_stream(void){ return stdin; }
    `static long long __fun_str_key_hash(const char* s) { long long h = 2166136261LL; if (s) { for (; *s; ++s) { h ^= (unsigned char)*s; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } } if (h < 0) h = -h; return h; }
    `static long long __fun_bytes_key_hash(const void* p, unsigned long n) { long long h = 2166136261LL; const unsigned char* b = (const unsigned char*)p; for (unsigned long i = 0; i < n; ++i) { h ^= b[i]; if (h < 0) h = -h; h = (h % 1000000007LL) * 16777619LL % 1000000007LL; } if (h < 0) h = -h; return h; }
    `#define __fun_tag(x) _Generic((x), char*: 's', const char*: 's', long long: 'n', long: 'n', int: 'n', unsigned long long: 'n', unsigned long: 'n', unsigned int: 'n', double: 'd', float: 'd', _Bool: 'b', char: 'c', void*: 'p', default: 'p')
    `#ifdef _WIN32
    `#include <windows.h>
    `#include <direct.h>
    `#include <sys/stat.h>
    `typedef struct { HANDLE h; WIN32_FIND_DATAA data; int started; } __fun_dir_iter;
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; char pattern[4096]; snprintf(pattern, sizeof(pattern), "%s\\*", path); __fun_dir_iter* it = (__fun_dir_iter*)malloc(sizeof(__fun_dir_iter)); if (!it) return NULL; it->h = FindFirstFileA(pattern, &it->data); it->started = 0; if (it->h == INVALID_HANDLE_VALUE) { free(it); return NULL; } return it; }
    `static char* __fun_dir_read_name(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return NULL; if (it->started) { if (!FindNextFileA(it->h, &it->data)) return NULL; } else { it->started = 1; } return it->data.cFileName; }
    `static long long __fun_dir_close(void* dirp) { __fun_dir_iter* it = (__fun_dir_iter*)dirp; if (!it) return -1; FindClose(it->h); free(it); return 0; }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct _stat st; if (_stat(path, &st) != 0) return 0; return (st.st_mode & _S_IFDIR) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return _mkdir(path); }
    `#else
    `#include <dirent.h>
    `#include <sys/stat.h>
    `static void* __fun_dir_open(const char* path) { if (!path) return NULL; return (void*)opendir(path); }
    `static char* __fun_dir_read_name(void* dirp) { if (!dirp) return NULL; struct dirent* e = readdir((DIR*)dirp); return e ? e->d_name : NULL; }
    `static long long __fun_dir_close(void* dirp) { if (!dirp) return -1; return (long long)closedir((DIR*)dirp); }
    `static long long __fun_path_is_dir(const char* path) { if (!path) return 0; struct stat st; if (stat(path, &st) != 0) return 0; return S_ISDIR(st.st_mode) ? 1 : 0; }
    `static long long __fun_make_dir(const char* path) { if (!path) return -1; return mkdir(path, 0755); }
    `#endif
    `#ifdef _WIN32
    `#include <windows.h>
    `typedef HANDLE __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `typedef struct __fun_thread_start_pack { __fun_thread_entry_t entry; void* arg; } __fun_thread_start_pack;
    `static DWORD WINAPI __fun_thread_entry_win(LPVOID p) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)p; if (pack) { pack->entry(pack->arg); free(pack); } return 0; }
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { __fun_thread_start_pack* pack = (__fun_thread_start_pack*)malloc(sizeof(__fun_thread_start_pack)); if (!pack) return -1; pack->entry = entry; pack->arg = arg; HANDLE h = CreateThread(NULL, 0, __fun_thread_entry_win, pack, 0, NULL); if (!h) { free(pack); return -1; } *t = h; return 0; }
    `static int __fun_thread_join(__fun_thread_t t) { DWORD rc = WaitForSingleObject(t, INFINITE); CloseHandle(t); return rc == WAIT_OBJECT_0 ? 0 : -1; }
    `#else
    `#include <pthread.h>
    `typedef pthread_t __fun_thread_t;
    `typedef void* (*__fun_thread_entry_t)(void*);
    `static int __fun_thread_start(__fun_thread_t* t, __fun_thread_entry_t entry, void* arg) { return pthread_create(t, NULL, entry, arg); }
    `static int __fun_thread_join(__fun_thread_t t) { return pthread_join(t, NULL); }
    `#endif
    `#if defined(_WIN32)
    `#ifndef WIN32_LEAN_AND_MEAN
    `#define WIN32_LEAN_AND_MEAN
    `#endif
    `#include <winsock2.h>
    `#include <ws2tcpip.h>
    `#pragma comment(lib, "Ws2_32.lib")
    `#ifndef close
    `#define close closesocket
    `#endif
    `#else
    `#include <sys/socket.h>
    `#include <netinet/in.h>
    `#include <arpa/inet.h>
    `#include <unistd.h>
    `#endif
    `typedef struct __fun_wd_state { int armed; long long threshold_ms; int abort_on_fire; int blocked; long long progress_seq; int started; } __fun_wd_state;
    `static __fun_wd_state __fun_g_wd;
    `void __fun_wd_warn(long long blocked_or_count, long long pending_or_cap, long long stall_ms){
    `  fprintf(stderr, "fun: possible deadlock: %lld blocked, %lld pending/cap, no progress for %lldms\n", blocked_or_count, pending_or_cap, stall_ms);
    `}
    `static void* __fun_wd_thread(void* unused){ (void)unused;
    `  long long last_seq=-1; long long stall_ms=0;
    `  long long step=__fun_g_wd.threshold_ms/4; if(step<1)step=1; if(step>1000)step=1000;
    `  for(;;){
    `#ifdef _WIN32
    `    Sleep((DWORD)step);
    `#else
    `    struct timespec __ts; __ts.tv_sec=step/1000; __ts.tv_nsec=(step%1000)*1000000L; nanosleep(&__ts,NULL);
    `#endif
    `    int blk=__fun_g_wd.blocked; long long seq=__fun_g_wd.progress_seq;
    `    if(blk>0 && seq==last_seq){ stall_ms+=step; } else { stall_ms=0; }
    `    last_seq=seq;
    `    if(stall_ms>=__fun_g_wd.threshold_ms){
    `      __fun_wd_warn((long long)blk, 0, stall_ms);
    `      if(__fun_g_wd.abort_on_fire) abort();
    `      stall_ms=0;
    `    }
    `  }
    `}
    `void __fun_wd_enter_wait(void){
    `  if(!__fun_g_wd.started){
    `    __fun_g_wd.started=1;
    `    const char* w=getenv("FUN_DEADLOCK_WATCHDOG_MS");
    `    long long wm=(w && w[0])?atoll(w):0;
    `    __fun_g_wd.armed=(wm>0)?1:0; __fun_g_wd.threshold_ms=(wm>0)?wm:0;
    `    const char* a=getenv("FUN_DEADLOCK_ABORT");
    `    __fun_g_wd.abort_on_fire=(a && a[0]=='1')?1:0;
    `    if(__fun_g_wd.armed){ __fun_thread_t th; __fun_thread_start(&th, __fun_wd_thread, NULL); }
    `  }
    `  if(!__fun_g_wd.armed) return;
    `  __fun_g_wd.blocked++;
    `}
    `void __fun_wd_leave_wait(void){ if(!__fun_g_wd.armed) return; if(__fun_g_wd.blocked>0)__fun_g_wd.blocked--; __fun_g_wd.progress_seq++; }
    `int64_t identity__num(int64_t value) {
    `    return value;
    `}
    `int main(int argc, char** argv) {
    `    return identity__num(5);
    `}
    ``
  ), "expected only the monomorphized 'identity__num', never the unsubstituted 'identity' template itself -- and 'main' forced to its real C entry-point signature";
}

test "pub transpile does not crash when a generic function's OWN return type is itself a generic enum instantiation" {
  // Regression test for a real crash found via the self-compile
  // experiment: std.result's err_kind<T>(...) Result<T, Error> is a
  // generic function whose OWN return type (Result<T, Error>) is
  // ITSELF a generic enum instantiation -- so monomorphizing err_kind
  // (which swaps self.state to a scratch buffer) triggers a NESTED
  // ensure_enum_instantiated call (for Result__num__Error) that ALSO
  // swaps self.state, while `hoist_insert_pos` still held a position
  // measured against the OUTER (now-swapped-away) buffer. The nested
  // emit_hoisted then spliced at that stale position into the WRONG
  // (much shorter) scratch buffer, corrupting substr's own length
  // arithmetic and crashing outright -- not a clean CodegenErrorKind
  // rejection. Fixed by suspending hoist_insert_pos (like
  // type_subst_param_names already was) for the duration of
  // maybe_instantiate_generic_function's/
  // maybe_instantiate_generic_impl_methods's own state swap.
  // 
  // `main`'s own OWN return type here (`Opt<num>`) exercises a SECOND,
  // unrelated concern (`main` forces to `int` in C -- see `emit_
  // function_named`'s own doc comment): its `ret wrap(5);` can't write
  // the real value (a struct assigned to an `int`-returning function
  // is a compile error), so it's evaluated ONLY for side effects, into
  // a throwaway scratch buffer. This means `wrap`/`Opt` -- reachable
  // ONLY through this discarded return, nowhere else in this test's
  // own `nodes` -- are correctly never hoisted at all; nothing else
  // needs them monomorphized. `main` returning something interesting
  // is exactly what the OTHER "main forces int" tests already cover.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  EnumDeclNode optd = enum_decl_node_new();
  optd.name = "Opt";
  optd.type_params.push("T");
  optd.has_type_params = true;
  EnumVariant some_v = enum_variant_new();
  some_v.name = "Some";
  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "T";
  some_v.payload.push(pdt);
  some_v.has_payload = true;
  optd.variants.push(some_v);
  EnumVariant none_v = enum_variant_new();
  none_v.name = "None";
  optd.variants.push(none_v);
  Node opt_node = node_new(NodeKind.Enum(optd));

  DataType* pdt2 = malloc(sizeof(DataType));
  *pdt2 = dtype_new();
  pdt2.type_str = "T";
  VariableNode wv;
  wv.var_type = pdt2;
  wv.name = "value";
  wv.has_val = false;
  wv.is_const = false;
  Node* wparam = malloc(sizeof(Node));
  *wparam = node_new(NodeKind.Variable(wv));
  Vec<Node*> wparams;
  wparams.init(0);
  wparams.push(wparam);

  Node* val_ident = malloc(sizeof(Node));
  *val_ident = node_new(NodeKind.Identifier("value"));
  Node* wrap_blank = malloc(sizeof(Node));
  *wrap_blank = node_new(NodeKind.Blank);
  Node* some_ident = malloc(sizeof(Node));
  *some_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode some_dot;
  some_dot.left = wrap_blank;
  some_dot.has_left = true;
  some_dot.right = some_ident;
  some_dot.has_right = true;
  some_dot.op = ".";
  Node* some_dot_node = malloc(sizeof(Node));
  *some_dot_node = node_new(NodeKind.Expression(some_dot));
  Node* some_args = malloc(sizeof(Node));
  *some_args = node_new(NodeKind.ExpressionParenthesis(val_ident));
  ExprNode some_call;
  some_call.left = some_dot_node;
  some_call.has_left = true;
  some_call.right = some_args;
  some_call.has_right = true;
  some_call.op = "()";
  Node* some_call_node = malloc(sizeof(Node));
  *some_call_node = node_new(NodeKind.Expression(some_call));
  Node* wrap_ret = malloc(sizeof(Node));
  *wrap_ret = node_new(NodeKind.StatementReturn(some_call_node));
  Vec<Node*> wrap_stmts;
  wrap_stmts.init(0);
  wrap_stmts.push(wrap_ret);
  BodyNode wrap_bn;
  wrap_bn.statements = wrap_stmts;
  Node* wrap_body = malloc(sizeof(Node));
  *wrap_body = node_new(NodeKind.Body(wrap_bn));

  FunctionNode wrapfn = function_node_new();
  wrapfn.name = "wrap";
  wrapfn.has_name = true;
  DataType* wrap_rt_arg = malloc(sizeof(DataType));
  *wrap_rt_arg = dtype_new();
  wrap_rt_arg.type_str = "T";
  DataType* wrap_rt = malloc(sizeof(DataType));
  *wrap_rt = dtype_new();
  wrap_rt.type_str = "Opt";
  wrap_rt.generic_args.push(wrap_rt_arg);
  wrapfn.rtype = wrap_rt;
  wrapfn.has_rtype = true;
  wrapfn.type_params.push("T");
  wrapfn.has_type_params = true;
  wrapfn.args = wparams;
  wrapfn.has_args = true;
  wrapfn.body = wrap_body;
  wrapfn.has_body = true;
  Node wrap_node = node_new(NodeKind.Function(wrapfn));

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("wrap"));
  Node* call_arg = malloc(sizeof(Node));
  *call_arg = node_new(NodeKind.Number(TokenData.Num(5)));
  Node* call_args_node = malloc(sizeof(Node));
  *call_args_node = node_new(NodeKind.ExpressionParenthesis(call_arg));
  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = call_args_node;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));
  Node* main_ret = malloc(sizeof(Node));
  *main_ret = node_new(NodeKind.StatementReturn(call_node));
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(main_ret);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(NodeKind.Body(main_bn));

  FunctionNode mainfn = function_node_new();
  mainfn.name = "main";
  mainfn.has_name = true;
  DataType* main_rt_arg = malloc(sizeof(DataType));
  *main_rt_arg = dtype_new();
  main_rt_arg.type_str = "num";
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "Opt";
  main_rtype.generic_args.push(main_rt_arg);
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(NodeKind.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(opt_node);
  nodes.push(wrap_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile without crashing";
  assert contains(st.out.build(), "int main(int argc, char** argv) {\n    return 0;\n}"), "expected main's discarded 'Opt<num>' return to just report success, its own signature still forced to the real C entry-point shape";
  assert !contains(st.out.build(), "wrap__num"), "expected 'wrap', reachable ONLY through main's own discarded return, to never be monomorphized at all -- nothing else in this program calls it";
}

test "pub transpile infers a generic function's type param from the CALLER's expected return type, not the argument itself" {
  // Regression test: `ret ok(.None);` (_next_inner's real body once
  // Result<Option<Token>, Error> monomorphizes -- see
  // `ensure_compound_instantiated`'s own doc comment for the nested-
  // generic fix this builds on) used to fail -- `ok<T>(value) Result<T,
  // Error>`'s type param can't be read off `.None` alone (a bare
  // shorthand carries no type info by itself), only from the ENCLOSING
  // function's own declared return type (`Result<Opt<num>, Error>`
  // here), matched structurally against `ok`'s own `Result<T, Error>`
  // shape at the SAME generic-arg position. Fixed via
  // infer_generic_function_type_param_from_context (Codegen.
  // current_fn_rtype_dt) plus threading the resulting ALREADY-
  // SUBSTITUTED param types back through GenericCallResolution so the
  // bare '.None' argument ITSELF also resolves (not just the
  // instantiation's own mangled name).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  EnumDeclNode optd = enum_decl_node_new();
  optd.name = "Opt";
  optd.type_params.push("T");
  optd.has_type_params = true;
  EnumVariant some_v = enum_variant_new();
  some_v.name = "Some";
  DataType* pdt = malloc(sizeof(DataType));
  *pdt = dtype_new();
  pdt.type_str = "T";
  some_v.payload.push(pdt);
  some_v.has_payload = true;
  optd.variants.push(some_v);
  EnumVariant none_v = enum_variant_new();
  none_v.name = "None";
  optd.variants.push(none_v);
  Node opt_node = node_new(NodeKind.Enum(optd));

  EnumDeclNode resultd = enum_decl_node_new();
  resultd.name = "Result";
  resultd.type_params.push("T");
  resultd.type_params.push("E");
  resultd.has_type_params = true;
  EnumVariant ok_v = enum_variant_new();
  ok_v.name = "Ok";
  DataType* ok_pdt = malloc(sizeof(DataType));
  *ok_pdt = dtype_new();
  ok_pdt.type_str = "T";
  ok_v.payload.push(ok_pdt);
  ok_v.has_payload = true;
  resultd.variants.push(ok_v);
  EnumVariant err_v = enum_variant_new();
  err_v.name = "Err";
  DataType* err_pdt = malloc(sizeof(DataType));
  *err_pdt = dtype_new();
  err_pdt.type_str = "E";
  err_v.payload.push(err_pdt);
  err_v.has_payload = true;
  resultd.variants.push(err_v);
  Node result_node = node_new(NodeKind.Enum(resultd));

  CompoundNode errorc = compound_node_new();
  errorc.name = "Error";
  CompoundField errf;
  errf.name = "code";
  DataType* errfdt = malloc(sizeof(DataType));
  *errfdt = dtype_new();
  errfdt.type_str = "num";
  errf.dtype = errfdt;
  errorc.fields.push(errf);
  Node error_node = node_new(NodeKind.Compound(errorc));

  DataType* okp_dt = malloc(sizeof(DataType));
  *okp_dt = dtype_new();
  okp_dt.type_str = "T";
  VariableNode okv;
  okv.var_type = okp_dt;
  okv.name = "value";
  okv.has_val = false;
  okv.is_const = false;
  Node* ok_param = malloc(sizeof(Node));
  *ok_param = node_new(NodeKind.Variable(okv));
  Vec<Node*> ok_params;
  ok_params.init(0);
  ok_params.push(ok_param);

  Node* ok_val_ident = malloc(sizeof(Node));
  *ok_val_ident = node_new(NodeKind.Identifier("value"));
  Node* ok_blank = malloc(sizeof(Node));
  *ok_blank = node_new(NodeKind.Blank);
  Node* ok_ident = malloc(sizeof(Node));
  *ok_ident = node_new(NodeKind.Identifier("Ok"));
  ExprNode ok_dot;
  ok_dot.left = ok_blank;
  ok_dot.has_left = true;
  ok_dot.right = ok_ident;
  ok_dot.has_right = true;
  ok_dot.op = ".";
  Node* ok_dot_node = malloc(sizeof(Node));
  *ok_dot_node = node_new(NodeKind.Expression(ok_dot));
  Node* ok_args = malloc(sizeof(Node));
  *ok_args = node_new(NodeKind.ExpressionParenthesis(ok_val_ident));
  ExprNode ok_call;
  ok_call.left = ok_dot_node;
  ok_call.has_left = true;
  ok_call.right = ok_args;
  ok_call.has_right = true;
  ok_call.op = "()";
  Node* ok_call_node = malloc(sizeof(Node));
  *ok_call_node = node_new(NodeKind.Expression(ok_call));
  Node* ok_ret = malloc(sizeof(Node));
  *ok_ret = node_new(NodeKind.StatementReturn(ok_call_node));
  Vec<Node*> ok_stmts;
  ok_stmts.init(0);
  ok_stmts.push(ok_ret);
  BodyNode ok_bn;
  ok_bn.statements = ok_stmts;
  Node* ok_body = malloc(sizeof(Node));
  *ok_body = node_new(NodeKind.Body(ok_bn));

  FunctionNode okfn = function_node_new();
  okfn.name = "ok";
  okfn.has_name = true;
  DataType* ok_rt_targ = malloc(sizeof(DataType));
  *ok_rt_targ = dtype_new();
  ok_rt_targ.type_str = "T";
  DataType* ok_rt_earg = malloc(sizeof(DataType));
  *ok_rt_earg = dtype_new();
  ok_rt_earg.type_str = "Error";
  DataType* ok_rt = malloc(sizeof(DataType));
  *ok_rt = dtype_new();
  ok_rt.type_str = "Result";
  ok_rt.generic_args.push(ok_rt_targ);
  ok_rt.generic_args.push(ok_rt_earg);
  okfn.rtype = ok_rt;
  okfn.has_rtype = true;
  okfn.type_params.push("T");
  okfn.has_type_params = true;
  okfn.args = ok_params;
  okfn.has_args = true;
  okfn.body = ok_body;
  okfn.has_body = true;
  Node ok_node = node_new(NodeKind.Function(okfn));

  Node* callee = malloc(sizeof(Node));
  *callee = node_new(NodeKind.Identifier("ok"));
  Node* none_blank = malloc(sizeof(Node));
  *none_blank = node_new(NodeKind.Blank);
  Node* none_ident = malloc(sizeof(Node));
  *none_ident = node_new(NodeKind.Identifier("None"));
  ExprNode none_dot;
  none_dot.left = none_blank;
  none_dot.has_left = true;
  none_dot.right = none_ident;
  none_dot.has_right = true;
  none_dot.op = ".";
  Node* none_node = malloc(sizeof(Node));
  *none_node = node_new(NodeKind.Expression(none_dot));
  Node* call_args_node = malloc(sizeof(Node));
  *call_args_node = node_new(NodeKind.ExpressionParenthesis(none_node));
  ExprNode call_e;
  call_e.left = callee;
  call_e.has_left = true;
  call_e.right = call_args_node;
  call_e.has_right = true;
  call_e.op = "()";
  Node* call_node = malloc(sizeof(Node));
  *call_node = node_new(NodeKind.Expression(call_e));
  Node* main_ret = malloc(sizeof(Node));
  *main_ret = node_new(NodeKind.StatementReturn(call_node));
  Vec<Node*> main_stmts;
  main_stmts.init(0);
  main_stmts.push(main_ret);
  BodyNode main_bn;
  main_bn.statements = main_stmts;
  Node* main_body = malloc(sizeof(Node));
  *main_body = node_new(NodeKind.Body(main_bn));

  DataType* main_rt_targ = malloc(sizeof(DataType));
  *main_rt_targ = dtype_new();
  main_rt_targ.type_str = "num";
  DataType* main_rt_opt = malloc(sizeof(DataType));
  *main_rt_opt = dtype_new();
  main_rt_opt.type_str = "Opt";
  main_rt_opt.generic_args.push(main_rt_targ);
  DataType* main_rt_earg = malloc(sizeof(DataType));
  *main_rt_earg = dtype_new();
  main_rt_earg.type_str = "Error";
  DataType* main_rtype = malloc(sizeof(DataType));
  *main_rtype = dtype_new();
  main_rtype.type_str = "Result";
  main_rtype.generic_args.push(main_rt_opt);
  main_rtype.generic_args.push(main_rt_earg);

  FunctionNode mainfn = function_node_new();
  mainfn.name = "check";
  mainfn.has_name = true;
  mainfn.rtype = main_rtype;
  mainfn.has_rtype = true;
  mainfn.has_args = false;
  mainfn.body = main_body;
  mainfn.has_body = true;
  Node main_node = node_new(NodeKind.Function(mainfn));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(opt_node);
  nodes.push(result_node);
  nodes.push(error_node);
  nodes.push(ok_node);
  nodes.push(main_node);

  assert g.transpile(nodes).is_none(), "expected the whole program to transpile";
  let out = st.out.build();
  assert contains(out, "Result__Opt__num__Error ok__Opt__num(Opt__num value)"), "expected 'T' inferred as 'Opt__num' from check's own declared return type, not from the bare '.None' argument";
  assert contains(out, "return ok__Opt__num(((Opt__num){ .tag = Opt__num_None }));"), "expected the bare '.None' argument ITSELF also resolved against 'Opt__num', not just the instantiation's own name";
}

test "transpile emits the prelude followed by every top-level function" {
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  // Named "run", not "main" -- this test is about generic top-level
  // function emission, not `main`'s own special C-entry-point
  // signature handling (which has its own dedicated tests).
  FunctionNode fnv = function_node_new();
  fnv.name = "run";
  fnv.has_name = true;
  DataType* rtype = malloc(sizeof(DataType));
  *rtype = dtype_new();
  rtype.type_str = "num";
  fnv.rtype = rtype;
  fnv.has_rtype = true;
  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.Number(TokenData.Num(0)));
  Node* ret_stmt = malloc(sizeof(Node));
  *ret_stmt = node_new(NodeKind.StatementReturn(val));
  Vec<Node*> stmts;
  stmts.init(0);
  stmts.push(ret_stmt);
  BodyNode bn;
  bn.statements = stmts;
  Node* body = malloc(sizeof(Node));
  *body = node_new(NodeKind.Body(bn));
  fnv.body = body;
  fnv.has_body = true;
  Node fn_node = node_new(NodeKind.Function(fnv));

  Vec<Node> nodes;
  nodes.init(0);
  nodes.push(fn_node);

  assert g.transpile(nodes).is_none(), "expected the whole file to transpile";
  let out = st.out.build();
  assert contains(out, "#include <stdint.h>"), "expected the prelude to be present";
  assert contains(out, "int64_t run(void) {"), "expected the function definition to be present";
}

test "emit_function resets the locals table's type-name column between functions" {
  // Regression test: `emit_function` reset `local_names`/
  // `local_is_pointer` between functions but NOT `local_type_name`, so
  // it kept accumulating across every function `transpile` emits while
  // the other two columns emptied out -- the next function's OWN
  // params then read back a STALE type name at their own (now
  // misaligned) index instead of their real one. Silent for
  // `lookup_local_is_pointer`-only callers (`emit_field_access`), but
  // wrong for anything reading the type name -- exactly what a
  // bare-shorthand `fit` pattern needs to resolve which enum it's
  // matching.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  Vec<str> variants;
  variants.init(0);
  variants.push("Some");
  variants.push("None");
  g.record_enum("Opt", variants, true);

  FunctionNode fa = function_node_new();
  fa.name = "fn_a";
  fa.has_name = true;
  DataType* fa_rtype = malloc(sizeof(DataType));
  *fa_rtype = dtype_new();
  fa_rtype.type_str = "num";
  fa.rtype = fa_rtype;
  fa.has_rtype = true;
  DataType* x_dt = malloc(sizeof(DataType));
  *x_dt = dtype_new();
  x_dt.type_str = "num";
  VariableNode xv;
  xv.var_type = x_dt;
  xv.name = "x";
  xv.has_val = false;
  xv.is_const = false;
  Node* x_param = malloc(sizeof(Node));
  *x_param = node_new(NodeKind.Variable(xv));
  Vec<Node*> fa_params;
  fa_params.init(0);
  fa_params.push(x_param);
  fa.args = fa_params;
  fa.has_args = true;
  Node* x_ident = malloc(sizeof(Node));
  *x_ident = node_new(NodeKind.Identifier("x"));
  Node* fa_ret = malloc(sizeof(Node));
  *fa_ret = node_new(NodeKind.StatementReturn(x_ident));
  Vec<Node*> fa_stmts;
  fa_stmts.init(0);
  fa_stmts.push(fa_ret);
  BodyNode fa_bn;
  fa_bn.statements = fa_stmts;
  Node* fa_body = malloc(sizeof(Node));
  *fa_body = node_new(NodeKind.Body(fa_bn));
  fa.body = fa_body;
  fa.has_body = true;
  Node fa_node = node_new(NodeKind.Function(fa));

  assert g.emit_function(fa_node).is_none(), "expected fn_a to emit";

  FunctionNode fb = function_node_new();
  fb.name = "fn_b";
  fb.has_name = true;
  DataType* fb_rtype = malloc(sizeof(DataType));
  *fb_rtype = dtype_new();
  fb_rtype.type_str = "num";
  fb.rtype = fb_rtype;
  fb.has_rtype = true;
  DataType* o_dt = malloc(sizeof(DataType));
  *o_dt = dtype_new();
  o_dt.type_str = "Opt";
  VariableNode ov;
  ov.var_type = o_dt;
  ov.name = "o";
  ov.has_val = false;
  ov.is_const = false;
  Node* o_param = malloc(sizeof(Node));
  *o_param = node_new(NodeKind.Variable(ov));
  Vec<Node*> fb_params;
  fb_params.init(0);
  fb_params.push(o_param);
  fb.args = fb_params;
  fb.has_args = true;

  Node* blank = malloc(sizeof(Node));
  *blank = node_new(NodeKind.Blank);
  Node* some_ident = malloc(sizeof(Node));
  *some_ident = node_new(NodeKind.Identifier("Some"));
  ExprNode dot;
  dot.left = blank;
  dot.has_left = true;
  dot.right = some_ident;
  dot.has_right = true;
  dot.op = ".";
  Node* cond = malloc(sizeof(Node));
  *cond = node_new(NodeKind.Expression(dot));

  Node* ret_v = malloc(sizeof(Node));
  *ret_v = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> some_stmts;
  some_stmts.init(0);
  some_stmts.push(ret_v);
  BodyNode some_bn;
  some_bn.statements = some_stmts;
  Node* some_body = malloc(sizeof(Node));
  *some_body = node_new(NodeKind.Body(some_bn));

  FitBranch br = fit_branch_new();
  br.condition = cond;
  br.has_condition = true;
  br.body = some_body;
  br.bindings.push("v");
  br.has_bindings = true;

  FitStmtNode fit_n = fit_stmt_node_new();
  Node* o_ident = malloc(sizeof(Node));
  *o_ident = node_new(NodeKind.Identifier("o"));
  fit_n.exp = o_ident;
  fit_n.branches.push(br);

  Node* fit_stmt = malloc(sizeof(Node));
  *fit_stmt = node_new(NodeKind.StatementFit(fit_n));
  Vec<Node*> fb_stmts;
  fb_stmts.init(0);
  fb_stmts.push(fit_stmt);
  BodyNode fb_bn;
  fb_bn.statements = fb_stmts;
  Node* fb_body = malloc(sizeof(Node));
  *fb_body = node_new(NodeKind.Body(fb_bn));
  fb.body = fb_body;
  fb.has_body = true;
  Node fb_node = node_new(NodeKind.Function(fb));

  assert g.emit_function(fb_node).is_none(), "expected fn_b to emit, resolving 'o' as Opt not a stale leaked type";
  assert contains(st.out.build(), "o.tag == Opt_Some"), "expected the bare-shorthand pattern to resolve against Opt, not a leaked type name";
}

test "emit_function resets local_dtype (not just local_names/local_type_name) between functions" {
  // Regression test: `Codegen.local_dtype` (added for `emit_for_iter`'s
  // own structural element-type lookup -- see its doc comment) was
  // never reset in `emit_function_named`, unlike its three sibling
  // columns. Since `local_names` WAS reset but `local_dtype` kept
  // growing, a later function's OWN local ended up reading back an
  // EARLIER function's STALE dtype at the same (now misaligned) index --
  // exactly the same class of bug the sibling
  // "resets the locals table's type-name column" test above already
  // covers for `local_type_name`. Found via the self-compile experiment
  // (`ParseState.parse_type_params_with_constraints`'s own real
  // `Vec<Vec<str>>` local read back a stale `str` element type from an
  // EARLIER method's own first parameter).
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);

  CompoundNode vecc = compound_node_new();
  vecc.name = "Vec";
  vecc.type_params.push("T");
  vecc.has_type_params = true;
  CompoundField vecf;
  vecf.name = "len";
  DataType* vecfdt = malloc(sizeof(DataType));
  *vecfdt = dtype_new();
  vecfdt.type_str = "num";
  vecf.dtype = vecfdt;
  vecc.fields.push(vecf);
  Node vec_tmpl_node = node_new(NodeKind.Compound(vecc));
  g.emit_compound(vec_tmpl_node);

  // fn_a: one param, `Vec<str> unused` -- populates local_dtype's ONLY
  // entry (index 0) with a Vec<str> dtype, then returns.
  DataType* str_arg_a = malloc(sizeof(DataType));
  *str_arg_a = dtype_new();
  str_arg_a.type_str = "str";
  DataType* a_param_dt = malloc(sizeof(DataType));
  *a_param_dt = dtype_new();
  a_param_dt.type_str = "Vec";
  a_param_dt.generic_args.push(str_arg_a);
  VariableNode av;
  av.var_type = a_param_dt;
  av.name = "unused";
  av.has_val = false;
  av.is_const = false;
  Node* a_param = malloc(sizeof(Node));
  *a_param = node_new(NodeKind.Variable(av));
  Vec<Node*> fa_params;
  fa_params.init(0);
  fa_params.push(a_param);

  Node* fa_ret = malloc(sizeof(Node));
  *fa_ret = node_new(NodeKind.StatementReturn(nil));
  Vec<Node*> fa_stmts;
  fa_stmts.init(0);
  fa_stmts.push(fa_ret);
  BodyNode fa_bn;
  fa_bn.statements = fa_stmts;
  Node* fa_body = malloc(sizeof(Node));
  *fa_body = node_new(NodeKind.Body(fa_bn));

  FunctionNode fa = function_node_new();
  fa.name = "fn_a";
  fa.has_name = true;
  DataType* fa_rtype = malloc(sizeof(DataType));
  *fa_rtype = dtype_new();
  fa_rtype.type_str = "void";
  fa_rtype.kind = DataTypeType.Void;
  fa.rtype = fa_rtype;
  fa.has_rtype = true;
  fa.args = fa_params;
  fa.has_args = true;
  fa.body = fa_body;
  fa.has_body = true;
  Node fa_node = node_new(NodeKind.Function(fa));

  assert g.emit_function(fa_node).is_none(), "expected fn_a to emit";

  // fn_b: one param, `Vec<Vec<str>> y` -- its OWN index-0 local. If
  // local_dtype wasn't reset, looking it up would instead read back
  // fn_a's stale Vec<str> entry (also at index 0), giving 'item' the
  // WRONG (too-shallow) element type and rejecting the NESTED iteration.
  DataType* str_arg_b = malloc(sizeof(DataType));
  *str_arg_b = dtype_new();
  str_arg_b.type_str = "str";
  DataType* inner_vec_b = malloc(sizeof(DataType));
  *inner_vec_b = dtype_new();
  inner_vec_b.type_str = "Vec";
  inner_vec_b.generic_args.push(str_arg_b);
  DataType* b_param_dt = malloc(sizeof(DataType));
  *b_param_dt = dtype_new();
  b_param_dt.type_str = "Vec";
  b_param_dt.generic_args.push(inner_vec_b);
  VariableNode bv;
  bv.var_type = b_param_dt;
  bv.name = "y";
  bv.has_val = false;
  bv.is_const = false;
  Node* b_param = malloc(sizeof(Node));
  *b_param = node_new(NodeKind.Variable(bv));
  Vec<Node*> fb_params;
  fb_params.init(0);
  fb_params.push(b_param);

  Node* outer_iterable = malloc(sizeof(Node));
  *outer_iterable = node_new(NodeKind.Identifier("y"));
  Node* inner_iterable = malloc(sizeof(Node));
  *inner_iterable = node_new(NodeKind.Identifier("item"));
  BodyNode inner_bn;
  inner_bn.statements.init(0);
  Node* inner_body = malloc(sizeof(Node));
  *inner_body = node_new(NodeKind.Body(inner_bn));
  ForIterNode inner_fi;
  inner_fi.index_name = "";
  inner_fi.has_index_name = false;
  inner_fi.item_name = "s";
  inner_fi.iterable = inner_iterable;
  inner_fi.body = inner_body;
  Node* inner_for = malloc(sizeof(Node));
  *inner_for = node_new(NodeKind.StatementFor(ForKind.Iter(inner_fi)));
  Vec<Node*> outer_stmts;
  outer_stmts.init(0);
  outer_stmts.push(inner_for);
  BodyNode outer_bn;
  outer_bn.statements = outer_stmts;
  Node* outer_body = malloc(sizeof(Node));
  *outer_body = node_new(NodeKind.Body(outer_bn));
  ForIterNode outer_fi;
  outer_fi.index_name = "";
  outer_fi.has_index_name = false;
  outer_fi.item_name = "item";
  outer_fi.iterable = outer_iterable;
  outer_fi.body = outer_body;
  Node* outer_for = malloc(sizeof(Node));
  *outer_for = node_new(NodeKind.StatementFor(ForKind.Iter(outer_fi)));
  Vec<Node*> fb_stmts;
  fb_stmts.init(0);
  fb_stmts.push(outer_for);
  BodyNode fb_bn;
  fb_bn.statements = fb_stmts;
  Node* fb_body = malloc(sizeof(Node));
  *fb_body = node_new(NodeKind.Body(fb_bn));

  FunctionNode fb = function_node_new();
  fb.name = "fn_b";
  fb.has_name = true;
  DataType* fb_rtype = malloc(sizeof(DataType));
  *fb_rtype = dtype_new();
  fb_rtype.type_str = "void";
  fb_rtype.kind = DataTypeType.Void;
  fb.rtype = fb_rtype;
  fb.has_rtype = true;
  fb.args = fb_params;
  fb.has_args = true;
  fb.body = fb_body;
  fb.has_body = true;
  Node fb_node = node_new(NodeKind.Function(fb));

  assert g.emit_function(fb_node).is_none(), "expected fn_b to emit, with 'y' resolved as its OWN Vec<Vec<str>> dtype, not fn_a's stale Vec<str> entry";
  assert contains(
    st.out.build(),
    `for (int64_t __fun_i = 0; __fun_i < item.len; __fun_i++) {
    `            __auto_type s = item.data[__fun_i];
    `        }
    ``
  ), "expected the NESTED loop over 'item' (Vec<str>) to emit via the .len/.data fast path, proving 'item' resolved its real (not stale) element type";
}
