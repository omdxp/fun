}

test "emit_expr resolves a bare '.{ field = value, ... }' compound literal against expected_compound_type" {
  // Regression test: `dtype_new`'s own real body (`dt.flags = .{
  // is_pointer = false, ... };`) -- found via the self-compile
  // experiment -- likewise rejected outright: the bare (no explicit
  // `Type`) form has no dtype of its own, and needs
  // `Codegen.expected_compound_type` (set by `emit_expr`'s own `=`
  // assignment case from the left-hand side's resolved field type,
  // mirroring `expected_enum_type`) to know which struct to emit.
  CodegenState st = codegen_state_new();
  Codegen g = codegen_new(&st);
  g.expected_compound_type = "DataTypeFlags";

  CompoundInitField f1;
  f1.name = "is_pointer";
  Node* v1 = malloc(sizeof(Node));
  *v1 = node_new(NodeKind.Boolean(false));
  f1.value = v1;

  CompoundInitNode ci = compound_init_node_new();
  ci.has_dtype = false;
  ci.fields.push(f1);
  Node n = node_new(NodeKind.CompoundInit(ci));

  assert g.emit_expr(n).is_none(), "expected the bare compound literal to emit";
  assert equals(st.out.build(), "(DataTypeFlags){.is_pointer = false}"), "expected 'DataTypeFlags' resolved from expected_compound_type, not a written-out type name";
}

test "emit_expr rejects a bare '.{...}' compound literal with no expected_compound_type in context" {
