// Command-line driver: turns arguments into a compile, and optionally
// builds and runs the result.
// 
// Compiling a program happens in two steps. The first lowers Fun to C,
// which this module owns. The second hands that C to a host compiler,
// chosen by `FUN_CC` or by platform default, and runs the executable it
// produces.

imp ..parser.import_resolver;
imp ..semantics.typecheck;
imp ..semantics.warnings;
imp ..lexer.lexer;
imp ..lexer.token;
imp fmt;
imp ..ast.ast;
imp manifest;
imp ..codegen.codegen;
imp ..codegen.codegen_state;
imp std.string;
imp std.vec;
imp std.option;
imp std.result;
imp std.io;
imp std.fs;
imp std.sys;
imp std.cli;
imp std.process;
imp std.path;
imp std.set;
imp std.runtime_backend;
imp std.c.mem;

// A constant supplied by the build rather than written in source.
pub compound Define {
  str name;
  str value;
}

// What the arguments asked for.
pub compound Options {
  // `build`, `test`, or "" for a plain compile.
  str subcommand;
  str input;
  str output;
  // Compile only, leaving the executable unrun.
  bin no_exec;
  // Keep the generated C instead of removing it after the build.
  bin keep_c;
  // Build with debug information.
  bin debug_info;
  bin show_help;
  bin show_version;
  // Report declarations nothing reads.
  bin warn_unused;
  // Rewrite the input in place, and with `fmt_all` its local imports too.
  bin fmt;
  bin fmt_all;
  // Report whether the input, or everything under it, is formatted,
  // without rewriting anything.
  bin fmt_check;
  bin fmt_check_all;
  // Arguments after `--`, passed to the compiled program.
  Vec<str> program_args;
  // Constants injected into the program, from `-D name=value`.
  Vec<Define> defines;
  // Set when parsing failed, with `error_text` explaining why.
  bin has_error;
  str error_text;
}

fun _options_new() Options {
  Options o;
  o.subcommand = "";
  o.input = "";
  o.output = "";
  o.no_exec = false;
  o.keep_c = false;
  o.debug_info = false;
  o.show_help = false;
  o.show_version = false;
  o.warn_unused = false;
  o.fmt = false;
  o.fmt_all = false;
  o.fmt_check = false;
  o.fmt_check_all = false;
  o.program_args.init(0);
  o.defines.init(0);
  o.has_error = false;
  o.error_text = "";
  ret o;
}

impl Options {
  pub free() {
    self.program_args.free();
    self.defines.free();
  }
}

// The flags that take a separate value.
fun _value_flags() Vec<str> {
  Vec<str> out;
  out.init(0);
  out.push("in");
  out.push("out");
  out.push("D");
  ret out;
}

// Reads `argv` into `Options`. A subcommand, when present, is the first
// argument, and anything after `--` belongs to the compiled program.
pub fun parse_args(str[] argv) Options {
  Options o = _options_new();

  Vec<str> value_flags = _value_flags();
  defer value_flags.free();
  CliArgs parsed = cli_parse_flags(argv, &value_flags);
  defer parsed.free();

  num first_positional = 0;
  let leading = parsed.at_positional(0);
  if leading.is_some() {
    str head = leading.unwrap();
    if equals(head, "build") || equals(head, "test") {
      o.subcommand = head;
      first_positional = 1;
    }
  }

  o.show_help = parsed.has("help") || parsed.has("h");
  o.show_version = parsed.has("version");
  o.no_exec = parsed.has("no-exec");
  o.keep_c = parsed.has("outf");
  o.debug_info = parsed.has("g");
  o.warn_unused = parsed.has("warn-unused");
  o.fmt = parsed.has("fmt");
  o.fmt_all = parsed.has("fmt-all");
  o.fmt_check = parsed.has("fmt-check");
  o.fmt_check_all = parsed.has("fmt-check-all");
  o.input = parsed.get_or("in", "");
  o.output = parsed.get_or("out", "");

  let define = parsed.at("D");
  if define.is_some() {
    str pair = define.unwrap();
    let eq = index_of_char(pair, '=');
    if eq == -1 {
      o.has_error = true;
      o.error_text = format("-D expects `name=value`, found `{str}`", pair);
      ret o;
    }
    Define d;
    d.name = substr(pair, 0, eq);
    d.value = substr(pair, eq + 1, len(pair) - (eq + 1));
    o.defines.push(d);
  }

  // A bare path is the input, so `fun file.fn` works without `-in`.
  num i = first_positional;
  for i < parsed.positionals.len {
    str arg = parsed.positionals.get(i);
    if equals(o.input, "") {
      o.input = arg;
    } else {
      o.program_args.push(arg);
    }
    i = i + 1;
  }
  ret o;
}

// Replaces `path`'s extension with `ext`, or appends when it has none.
pub fun with_extension(str path, str ext) str {
  if equals(ext, "") {
    ret strip_ext(path);
  }
  ret change_ext(path, ext);
}

// The suffix an executable carries on this platform.
pub fun exe_suffix() str {
  if runtime_backend_is_windows() {
    ret ".exe";
  }
  ret "";
}

// Where build output goes, so nothing lands next to the sources.
pub fun out_dir() str {
  ret "fun-out";
}

// The generated C for `input`, under the build directory.
pub fun default_c_path(str input, str suffix) str {
  make_dir_all(out_dir());
  StringBuilder b = string_builder_init(16);
  b.append(strip_ext(basename(input)));
  b.append(suffix);
  ret path_join(out_dir(), b.build());
}

// The executable built from `input`, under the build directory.
pub fun default_exe_path(str input, str suffix) str {
  str dir = path_join(out_dir(), "bin");
  make_dir_all(dir);
  StringBuilder b = string_builder_init(16);
  b.append(strip_ext(basename(input)));
  b.append(suffix);
  b.append(exe_suffix());
  ret path_join(dir, b.build());
}

// The host C compiler to shell, honoring `FUN_CC`.
pub fun c_compiler() str {
  str override_cc = env("FUN_CC");
  if !equals(override_cc, "") {
    ret override_cc;
  }
  if runtime_backend_is_windows() {
    ret "cl";
  }
  ret "cc";
}

// True when `cc` takes MSVC-style arguments rather than gcc-style ones.
pub fun compiler_is_msvc(str cc) bin {
  let name = basename(cc);
  ret equals(name, "cl") || equals(name, "cl.exe");
}

// Builds a `pub const str name = "value";` declaration, so a value known
// only to the build is reachable from source as an ordinary constant.
fun _const_string_node(str name, str value) Node {
  DataType* dt = malloc(sizeof(DataType));
  *dt = dtype_new();
  dt.type_str = "str";

  Node* val = malloc(sizeof(Node));
  *val = node_new(NodeKind.String(value));

  VariableNode v;
  v.var_type = dt;
  v.name = name;
  v.val = val;
  v.has_val = true;
  v.is_const = true;
  ret node_new(NodeKind.Variable(v));
}

// Lowers `input` to C at `out_path`, with `defines` available to the
// program as constants. The error text names the stage that rejected the
// program.
pub fun compile_to_c(str input, str out_path, Vec<Define>* defines) Result<bin, str> {
  ret compile_to_c_mode(input, out_path, defines, false, false);
}

// Lowers `input` to C, reporting declarations nothing reads.
pub fun compile_to_c_warning_unused(str input, str out_path, Vec<Define>* defines) Result<bin, str> {
  ret compile_to_c_mode(input, out_path, defines, false, true);
}

// Lowers `input` to C, emitting a test runner in place of the program's
// own entry point when `test_mode` is set.
pub fun compile_to_c_mode(
  str input,
  str out_path,
  Vec<Define>* defines,
  bin test_mode,
  bin warn_unused
) Result<bin, str> {
  let parsed = parse_program_with_imports(input);
  if parsed.is_err() {
    ret .Err(parsed.unwrap_err());
  }
  let merged = parsed.unwrap();

  // Injected ahead of the program's own declarations, so anything in it
  // can refer to them.
  num di = defines.len;
  for di > 0 {
    di = di - 1;
    Define* d = &defines.data[di];
    merged.nodes.insert(0, _const_string_node(d.name, d.value));
  }

  // Type checking runs over the merged program, so a call into an
  // imported module is checked against the signature it was declared
  // with.
  let checked = typecheck_program(&merged.nodes);
  if checked.is_err() {
    TypeError e = checked.unwrap_err();
    if e.has_pos {
      // The node's own file, which is not the entry file when the error
      // is in something it imported.
      str where = e.pos.filename;
      if equals(where, "") {
        where = input;
      }
      ret .Err(format(
        "{str}\nLocation: {str}:{num}:{num}",
        e.message,
        where,
        e.pos.line,
        e.pos.col
      ));
    }
    ret .Err(e.message);
  }

  // Warnings are reported after checking, so a program that does not
  // compile is not also told what it might have meant. They are read
  // from the file's own parse: merging drops the import statements, and
  // what another file declares is its own business.
  let noticed = analyze(&merged.entry_nodes, &merged.nodes, warn_unused, input);
  if noticed.is_err() {
    ret .Err(noticed.unwrap_err());
  }
  Vec<Warning> warnings = noticed.unwrap();
  defer warnings.free();
  num wi = 0;
  for wi < warnings.len {
    Warning w = warnings.get(wi);
    wi = wi + 1;
    StringBuilder line = string_builder_init(96);
    line.append("[Warning:");
    line.append(warning_id_name(w.id));
    line.append("] ");
    line.append(w.message);
    if w.has_pos {
      line.append(format("\nLocation: {str}:{num}:{num}", w.pos.filename, w.pos.line, w.pos.col));
    }
    writeln_to(Sink.Stderr, line.build());
  }

  CodegenState state = codegen_state_new();
  Codegen cg = codegen_new(&state);
  cg.test_mode = test_mode;
  cg.import_aliases = merged.aliases;
  cg.alias_rename_keys = merged.alias_rename_keys;
  cg.alias_rename_targets = merged.alias_rename_targets;

  let cg_err = cg.transpile(merged.nodes);
  fit cg_err {
    .Some(kind) -> {
      str what = "unsupported node";
      fit kind {
        .UnsupportedNode -> {}
        .InvalidNode -> { what = "invalid node"; }
      }
      if !equals(cg.error_note, "") {
        if !equals(cg.last_where, "") {
          ret .Err(format(
            "codegen failed: {str}: {str}, near {str}",
            what,
            cg.error_note,
            cg.last_where
          ));
        }
        ret .Err(format("codegen failed: {str}: {str}", what, cg.error_note));
      }
      if !equals(cg.last_where, "") {
        ret .Err(format("codegen failed: {str}, near {str}", what, cg.last_where));
      }
      ret .Err(format("codegen failed: {str}", what));
    }
    .None -> {}
  }

  str c_source = state.out.build();
  if !write_string(out_path, c_source) {
    ret .Err(format("could not write {str}", out_path));
  }
  ret .Ok(true);
}

// Builds `c_path` into `exe_path`. Returns the compiler's exit code.
// MSVC spells its arguments differently and links the C runtime itself,
// so the thread and math flags apply only to gcc-style compilers.
pub fun compile_c_to_exe(str c_path, str exe_path, bin debug_info) num {
  str cc = c_compiler();
  Vec<str> argv_args;
  argv_args.init(0);
  defer argv_args.free();
  argv_args.push(cc);

  if compiler_is_msvc(cc) {
    argv_args.push("/nologo");
    argv_args.push(c_path);
    if debug_info {
      argv_args.push("/Zi");
    }
    argv_args.push(format("/Fe:{str}", exe_path));
  } else {
    argv_args.push(c_path);
    argv_args.push("-o");
    argv_args.push(exe_path);
    if debug_info {
      argv_args.push("-g");
    } else {
      argv_args.push("-g0");
    }
    argv_args.push("-pthread");
    argv_args.push("-lm");
  }

  str[] argv = argv_from(&argv_args);
  let code = spawn_inherited(argv);
  free_argv(argv);
  ret code;
}

// Compiles `c_path` to an object at `obj_path` without linking, which is
// how a library target is checked: it has no entry point to link.
pub fun compile_c_to_object(str c_path, str obj_path) num {
  str cc = c_compiler();
  Vec<str> argv_args;
  argv_args.init(0);
  defer argv_args.free();
  argv_args.push(cc);

  if compiler_is_msvc(cc) {
    argv_args.push("/nologo");
    argv_args.push("/c");
    argv_args.push(c_path);
    argv_args.push(format("/Fo:{str}", obj_path));
  } else {
    argv_args.push("-c");
    argv_args.push(c_path);
    argv_args.push("-o");
    argv_args.push(obj_path);
  }

  str[] argv = argv_from(&argv_args);
  let code = spawn_inherited(argv);
  free_argv(argv);
  ret code;
}

// Qualifies a bare executable name so it is run from the current
// directory rather than searched for on `PATH`. Windows already looks in
// the current directory, so only POSIX needs the prefix.
pub fun executable_path(str path) str {
  if runtime_backend_is_windows() {
    ret path;
  }
  if contains(path, "/") || contains(path, "\\") {
    ret path;
  }
  StringBuilder b = string_builder_init(16);
  b.append("./");
  b.append(path);
  ret b.build();
}

// Runs `exe_path` with `args`, inheriting this process's streams, and
// returns its exit code.
pub fun run_exe(str exe_path, Vec<str>* args) num {
  Vec<str> argv_args;
  argv_args.init(0);
  defer argv_args.free();
  argv_args.push(executable_path(exe_path));
  num i = 0;
  for i < args.len {
    argv_args.push(args.get(i));
    i = i + 1;
  }

  str[] argv = argv_from(&argv_args);
  let code = spawn_inherited(argv);
  free_argv(argv);
  ret code;
}

pub fun help_text() str {
  ret `usage:
  `  fun -in <input.fn> [-out <output>] [-no-exec] [-outf] [-g] [-- <program args>]
  `  fun -in <input.fn> [-fmt | -fmt-all | -fmt-check]
  `  fun -fmt-check-all [-in <file_or_dir>]
  `  fun -version
  `
  `  -in <file>        Input file to compile.
  `  -out <file>       Write the generated C here.
  `  -no-exec          Compile only, without running the result.
  `  -outf             Keep the generated C file.
  `  -g                Build with debug information.
  `  -fmt              Format the input file in place.
  `  -fmt-all          Format the input file and the modules it imports.
  `  -fmt-check        Report the input if it is unformatted, and exit 1.
  `  -fmt-check-all    Report every unformatted file under the input, and exit 1.
  `  --                Pass every following argument to the compiled program.`;
}

fun _argv(Vec<str>* parts) str[] {
  str[] out = malloc(sizeof(str) * (parts.len + 2));
  out[0] = "fun";
  num i = 0;
  for i < parts.len {
    out[i + 1] = parts.get(i);
    i = i + 1;
  }
  out[parts.len + 1] = nil;
  ret out;
}

test "parses an input path and an output path" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("-out");
  a.push("prog");
  let o = parse_args(_argv(&a));
  assert !o.has_error, "expected the arguments to parse";
  assert equals(o.input, "main.fn"), "expected the input path";
  assert equals(o.output, "prog"), "expected the output path";
}

test "accepts a bare path as the input" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("main.fn");
  let o = parse_args(_argv(&a));
  assert equals(o.input, "main.fn"), "expected the input path";
}

test "collects the flags" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("-no-exec");
  a.push("-outf");
  a.push("-g");
  let o = parse_args(_argv(&a));
  assert o.no_exec, "expected -no-exec";
  assert o.keep_c, "expected -outf";
  assert o.debug_info, "expected -g";
}

test "everything after -- belongs to the program" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-in");
  a.push("main.fn");
  a.push("--");
  a.push("passed");
  let o = parse_args(_argv(&a));
  defer o.free();
  assert o.program_args.len == 1, "expected the program argument";
  assert equals(o.program_args.get(0), "passed"), "expected the argument verbatim";
}

test "recognizes a build subcommand" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("build");
  let o = parse_args(_argv(&a));
  assert equals(o.subcommand, "build"), "expected the build subcommand";
}

test "reads a -D define" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-D");
  a.push("TAG=v1.2.3");
  a.push("main.fn");
  let o = parse_args(_argv(&a));
  defer o.free();
  assert o.defines.len == 1, "expected the define";
  assert equals(o.defines.get(0).name, "TAG"), "expected the define's name";
  assert equals(o.defines.get(0).value, "v1.2.3"), "expected the define's value";
}

test "a malformed -D is reported" {
  Vec<str> a;
  a.init(0);
  defer a.free();
  a.push("-D");
  a.push("NOEQUALS");
  let o = parse_args(_argv(&a));
  assert o.has_error, "expected a malformed define to be rejected";
}

test "with_extension replaces an existing extension" {
  assert equals(with_extension("main.fn", ".c"), "main.c"), "expected the extension replaced";
  assert equals(with_extension("src/main.fn", ".c"), "src/main.c"), "expected the directory kept";
}

test "with_extension appends when there is none" {
  assert equals(with_extension("main", ".c"), "main.c"), "expected the extension appended";
}

test "with_extension ignores a dot in a parent directory" {
  assert equals(with_extension("a.b/main", ".c"), "a.b/main.c"), "expected only the file's own name to matter";
}

test "executable_path qualifies a bare name" {
  assert equals(executable_path("prog"), "./prog"), "expected a bare name to be qualified";
}

test "executable_path leaves a path alone" {
  assert equals(executable_path("./prog"), "./prog"), "expected an explicit path to be kept";
  assert equals(executable_path("build/prog"), "build/prog"), "expected a directory path to be kept";
}

test "with_extension handles a windows-style path" {
  assert equals(with_extension("src\\main.fn", ".c"), "src\\main.c"), "expected a backslash path to keep its directory";
}

test "the msvc compiler is recognized by name" {
  assert compiler_is_msvc("cl"), "expected cl to be msvc";
  assert compiler_is_msvc("cl.exe"), "expected cl.exe to be msvc";
  assert !compiler_is_msvc("cc"), "expected cc to be gcc-style";
  assert !compiler_is_msvc("/usr/bin/gcc"), "expected gcc to be gcc-style";
}

// Reads `./fun.toml` and fills in whatever it left implicit.
pub fun load_manifest() Result<Manifest, str> {
  if !exists("fun.toml") {
    ret .Err("no fun.toml in this directory");
  }
  let parsed = parse_manifest(read_to_string("fun.toml"));
  if parsed.is_err() {
    ret .Err(parsed.unwrap_err());
  }
  Manifest m = parsed.unwrap();
  resolve_targets(&m, "");
  ret .Ok(m);
}

// The constants every build makes available to the program: the package
// name and version, taken from the manifest.
pub fun manifest_defines(Manifest* m) Vec<Define> {
  Vec<Define> out;
  out.init(0);
  Define name;
  name.name = "PACKAGE_NAME";
  name.value = m.package_name;
  out.push(name);
  Define version;
  version.name = "PACKAGE_VERSION";
  version.value = m.version;
  out.push(version);
  ret out;
}

// Compiles every target the manifest declares, writing executables to
// `fun-out/bin`. A library has no entry point, so it is compiled to an
// object under `fun-out/lib` to prove it builds, never linked.
pub fun build_project() num {
  let loaded = load_manifest();
  if loaded.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", loaded.unwrap_err()));
    ret 1;
  }
  Manifest m = loaded.unwrap();
  defer m.free();

  if m.kind() == PackageKind.Empty {
    writeln_to(
      Sink.Stderr,
      format("[Error]\npackage `{str}` declares no [lib] or [[bin]] target", m.package_name)
    );
    ret 1;
  }

  Vec<Define> defines = manifest_defines(&m);
  defer defines.free();

  if m.has_lib {
    make_dir_all("fun-out/lib");
    str c_path = path_join("fun-out/lib", format("{str}.c", m.lib.name));
    let lowered = compile_to_c(m.lib.path, c_path, &defines);
    if lowered.is_err() {
      writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
      ret 1;
    }
    let code = compile_c_to_object(c_path, path_join("fun-out/lib", format("{str}.o", m.lib.name)));
    if code != 0 {
      ret 1;
    }
    println(format("checked {str}", m.lib.name));
  }

  num i = 0;
  for i < m.bins.len {
    BinTarget* b = &m.bins.data[i];
    make_dir_all("fun-out/bin");
    str c_path = path_join("fun-out/bin", format("{str}.c", b.name));
    let lowered = compile_to_c(b.path, c_path, &defines);
    if lowered.is_err() {
      writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
      ret 1;
    }
    str exe = path_join("fun-out/bin", format("{str}{str}", b.name, exe_suffix()));
    let code = compile_c_to_exe(c_path, exe, false);
    if code != 0 {
      ret 1;
    }
    println(format("built {str} -> {str}", b.name, exe));
    i = i + 1;
  }
  ret 0;
}

// Compiles `input` with its test blocks and runs them, passing `args` on
// so a single test can be named. Returns the runner's exit code.
pub fun run_tests(str input, Vec<str>* args) num {
  Vec<Define> defines;
  defines.init(0);
  defer defines.free();
  if exists("fun.toml") {
    let loaded = load_manifest();
    if loaded.is_ok() {
      Manifest m = loaded.unwrap();
      defines.free();
      defines = manifest_defines(&m);
    }
  }

  str c_path = default_c_path(input, ".test.c");
  let lowered = compile_to_c_mode(input, c_path, &defines, true, false);
  if lowered.is_err() {
    writeln_to(Sink.Stderr, format("[Error]\n{str}", lowered.unwrap_err()));
    ret 1;
  }

  str exe = default_exe_path(input, ".test");
  let cc_code = compile_c_to_exe(c_path, exe, false);
  remove_file(c_path);
  if cc_code != 0 {
    ret 1;
  }

  let code = run_exe(exe, args);
  remove_file(exe);
  ret code;
}

// True when `path` declares at least one top level `test "name" { ... }`
// block. A lightweight token scan rather than a real parse: a `test`
// keyword token immediately followed by a string literal doesn't occur
// any other way in valid Fun source, so the shape alone is enough to
// decide whether a file belongs in a directory-wide run. Any read or lex
// failure is treated as "doesn't declare one". The real compile below
// reports the actual error.
fun _declares_test_block(str path) bin {
  if !exists(path) {
    ret false;
  }
  str src = read_to_string(path);
  let lexed = tokenize(src, path);
  if lexed.is_err() {
    ret false;
  }
  Vec<Token> tokens = lexed.unwrap();
  defer tokens.free();

  num i = 0;
  for i + 1 < tokens.len {
    Token t = tokens.get(i);
    i = i + 1;
    if t.type != TokenType.Keyword || !equals(token_text(t), "test") {
      continue;
    }
    if tokens.get(i).type == TokenType.String {
      ret true;
    }
  }
  ret false;
}

// `fun test <dir>`/`fun test` (no path): discovers every `.fn` file under
// `root` that declares a `test` block, runs each with `run_tests`, and
// prints an aggregate pass/fail summary. Every file gets its own compile
// pass and its own process for the compiled binary, so one file's failure
// or crash can't take the rest of the run down with it.
pub fun run_test_suite(str root) num {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);
  files.sort();

  Vec<str> no_args;
  no_args.init(0);
  defer no_args.free();

  num passed = 0;
  num failed = 0;
  num i = 0;
  for i < files.len {
    str path = files.get(i);
    i = i + 1;
    if !_declares_test_block(path) {
      continue;
    }
    println(format("== {str} ==", path));
    let code = run_tests(path, &no_args);
    if code == 0 {
      passed = passed + 1;
    } else {
      failed = failed + 1;
    }
  }

  if passed + failed == 0 {
    println(format("no `test` blocks found under {str}", dir));
    ret 0;
  }

  println(format("\n{num}/{num} test files passed", passed, passed + failed));
  if failed > 0 {
    ret 1;
  }
  ret 0;
}

// Formats `path` in place, reporting whether the file changed. A file
// that is already formatted is left untouched, so its timestamp only
// moves when its contents do.
pub fun format_file(str path) Result<bin, str> {
  if !exists(path) {
    ret .Err(format("no such file: {str}", path));
  }
  str src = read_to_string(path);
  let formatted = format_source(src, path);
  if formatted.is_err() {
    ret .Err(formatted.unwrap_err());
  }
  str out = formatted.unwrap();
  if equals(out, src) {
    ret .Ok(false);
  }
  if !write_string(path, out) {
    ret .Err(format("could not write {str}", path));
  }
  ret .Ok(true);
}

// True when `path` is already formatted.
pub fun format_file_is_clean(str path) bin {
  if !exists(path) {
    ret false;
  }
  str src = read_to_string(path);
  let formatted = format_source(src, path);
  if formatted.is_err() {
    ret false;
  }
  ret equals(formatted.unwrap(), src);
}

// The dotted paths that `src` imports, in the order they are written.
fun _imported_paths(str src, str filename) Vec<str> {
  Vec<str> out;
  out.init(0);
  let lexed = tokenize(src, filename);
  if lexed.is_err() {
    ret out;
  }
  Vec<Token> tokens = lexed.unwrap();
  defer tokens.free();

  num i = 0;
  for i < tokens.len {
    Token t = tokens.get(i);
    if t.type != TokenType.Keyword || !equals(token_text(t), "imp") {
      i = i + 1;
      continue;
    }
    StringBuilder b = string_builder_init(32);
    num j = i + 1;
    for j < tokens.len {
      Token it = tokens.get(j);
      if it.type == TokenType.NewLine || it.type == TokenType.Comment {
        j = j + 1;
        continue;
      }
      str text = token_text(it);
      if equals(text, ";") {
        break;
      }
      // An alias renames the import; the path is what precedes it.
      if it.type == TokenType.Keyword && equals(text, "as") {
        break;
      }
      b.append(text);
      j = j + 1;
    }
    str path = b.build();
    if !equals(path, "") {
      out.push(path);
    }
    i = j + 1;
  }
  ret out;
}

// Formats `path` and every module it imports, directly or not, leaving
// the stdlib alone. Reports how many files changed.
pub fun format_file_and_imports(str path) Result<num, str> {
  Vec<str> queue;
  queue.init(4);
  defer queue.free();
  queue.push(path);

  Set<str> seen = set_init("", 8);
  defer seen.free();

  num changed = 0;
  num i = 0;
  for i < queue.len {
    str current = queue.get(i);
    i = i + 1;
    if seen.has(current) {
      continue;
    }
    seen.add(current);

    let done = format_file(current);
    if done.is_err() {
      ret .Err(done.unwrap_err());
    }
    if done.unwrap() {
      changed = changed + 1;
    }

    Vec<str> imports = _imported_paths(read_to_string(current), current);
    defer imports.free();
    num k = 0;
    for k < imports.len {
      str dotted = imports.get(k);
      k = k + 1;
      // The stdlib ships formatted and is not the caller's to rewrite.
      if starts_with(dotted, "std.") {
        continue;
      }
      str resolved = resolve_import_path(current, dotted);
      if exists(resolved) {
        queue.push(resolved);
      }
    }
  }
  ret .Ok(changed);
}

// Directories that hold generated or vendored files, which are not the
// project's own source.
fun _skip_scan_dir(str name) bin {
  fit name {
    ".git", ".funsand", "fun-out", "build", "node_modules" -> { ret true; }
    _ -> { ret false; }
  }
}

fun _collect_fun_files(str dir, Vec<str>* out) {
  let listed = list_dir(dir);
  if listed.is_err() {
    ret;
  }
  Vec<str> entries = listed.unwrap();
  defer entries.free();
  entries.sort();

  num i = 0;
  for i < entries.len {
    str name = entries.get(i);
    i = i + 1;
    str full = path_join(dir, name);
    if is_dir(full) {
      if !_skip_scan_dir(name) {
        _collect_fun_files(full, out);
      }
      continue;
    }
    if ends_with(name, ".fn") {
      out.push(full);
    }
  }
}

// The unformatted `.fn` files under `root`, which may name a directory
// or a file whose directory is scanned instead.
pub fun collect_unformatted(str root) Vec<str> {
  str dir = root;
  if equals(dir, "") {
    dir = ".";
  } elif !is_dir(dir) {
    dir = dirname(dir);
    if equals(dir, "") {
      dir = ".";
    }
  }

  Vec<str> files;
  files.init(16);
  defer files.free();
  _collect_fun_files(dir, &files);

  Vec<str> out;
  out.init(0);
  num i = 0;
  for i < files.len {
    str path = files.get(i);
    i = i + 1;
    if !format_file_is_clean(path) {
      out.push(path);
    }
  }
  ret out;
}

test "lists the modules a file imports, aliases and stdlib included" {
  str src = `imp sub.helper;
  `imp std.io as out;
  `
  `fun main() num {
  `  ret 0;
  `}`;
  Vec<str> found = _imported_paths(src, "main.fn");
  defer found.free();
  assert found.len == 2, "expected both imports to be listed";
  assert equals(found.get(0), "sub.helper"), "expected the local import first";
  assert equals(found.get(1), "std.io"), "expected the alias dropped from the path";
}

test "formatting reports a change only when the file is rewritten" {
  make_dir_all("fun-out");
  str path = "fun-out/_fmt_probe.fn";
  write_string(path, "fun probe() num{ret 1;}\n");
  defer remove_file(path);

  let first = format_file(path);
  assert first.is_ok(), "expected the file to format";
  assert first.unwrap(), "expected the unformatted file to change";
  assert format_file_is_clean(path), "expected the file to be formatted now";

  let second = format_file(path);
  assert second.is_ok(), "expected the formatted file to format again";
  assert !second.unwrap(), "expected no second rewrite";
}

test "an unformatted file is reported by a scan of its directory" {
  make_dir_all("fun-out/_fmt_scan");
  str path = "fun-out/_fmt_scan/dirty.fn";
  write_string(path, "fun dirty() num{ret 1;}\n");
  defer remove_file(path);

  Vec<str> offenders = collect_unformatted("fun-out/_fmt_scan");
  defer offenders.free();
  assert offenders.len == 1, "expected the unformatted file to be reported";
  assert ends_with(offenders.get(0), "dirty.fn"), "expected the offender's path";
}
