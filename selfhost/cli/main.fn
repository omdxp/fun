// Compiler entry point: reads the command line, lowers the input to C,
// then builds and runs it unless asked not to.

imp driver;
imp manifest;
imp std.string;
imp std.vec;
imp std.io;
imp std.fs;

fun _fail(str msg) num {
  writeln_to(Sink.Stderr, format(`[Error]
  `{str}`, msg));
  ret 1;
}

// The version of the package in the working directory. `fun build`
// injects this into a program it builds, so a compiled program reads its
// own version as a constant instead of reading the manifest at runtime.
fun package_version() str {
  if !exists("fun.toml") {
    ret "0.0.0";
  }
  let parsed = parse_manifest(read_to_string("fun.toml"));
  if parsed.is_err() {
    ret "0.0.0";
  }
  ret parsed.unwrap().version;
}

fun main(str[] args) num {
  Options opts = parse_args(args);
  defer opts.free();

  if opts.has_error {
    ret _fail(opts.error_text);
  }
  if opts.show_version {
    println(package_version());
    ret 0;
  }
  if opts.show_help {
    println(help_text());
    ret 0;
  }
  if equals(opts.subcommand, "build") {
    ret build_project();
  }
  if equals(opts.subcommand, "test") {
    if equals(opts.input, "") {
      ret _fail("`fun test` needs a file to test");
    }
    ret run_tests(opts.input, &opts.program_args);
  }
  if equals(opts.input, "") {
    println(help_text());
    ret 1;
  }
  if !exists(opts.input) {
    ret _fail(format("no such file: {str}", opts.input));
  }

  // `-out` names the generated C file, defaulting to the input's own
  // name with a `.c` extension.
  str c_path = opts.output;
  if equals(c_path, "") {
    c_path = with_extension(opts.input, ".c");
  }
  let lowered = compile_to_c(opts.input, c_path, &opts.defines);
  if lowered.is_err() {
    ret _fail(lowered.unwrap_err());
  }

  // `-no-exec` stops at the C, which is the artifact it was asked for.
  if opts.no_exec {
    ret 0;
  }

  str exe_path = format("{str}{str}", with_extension(opts.input, ""), exe_suffix());

  let cc_code = compile_c_to_exe(c_path, exe_path, opts.debug_info);
  if !opts.keep_c {
    remove_file(c_path);
  }
  if cc_code != 0 {
    ret _fail("the C compiler rejected the generated program");
  }

  ret run_exe(exe_path, &opts.program_args);
}
