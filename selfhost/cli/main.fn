// The self-hosted Fun compiler's own entry point: the first place all of
// `selfhost/`'s previously-independent, individually-tested pieces (lexer,
// import-aware parser, codegen) are actually wired together into one
// program that turns a real `.fn` file into C output.
// 
// Deliberately narrow for this first end-to-end slice, matching every
// other "deliberately narrow for now" precedent throughout `selfhost/`:
// - Only compiles to a `.c` file -- unlike the bootstrap `fun` binary's
// own CLI, this does NOT shell a C compiler or run the result. Process
// spawning with captured output is real, separate work (`std.process`
// has no such binding yet) rather than something to improvise here.
// - Positional arguments only (`<input.fn> [<output.c>]`), not the
// bootstrap CLI's `-in`/`-out` flag syntax -- matching that exactly is
// a later compatibility concern, not a blocker for proving the pipeline
// itself works.
// - Codegen error reporting is as coarse as `codegen.fn`'s own
// `CodegenErrorKind` today (a bare `UnsupportedNode`/`InvalidNode` tag,
// no location or message) -- richer codegen diagnostics are a separate
// improvement to `codegen.fn` itself, not something this driver can add
// from the outside.

imp ..parser.import_resolver;
imp ..codegen.codegen;
imp ..codegen.codegen_state;
imp std.cli;
imp std.fs;
imp std.io;
imp std.c.mem;

// Renders a `CodegenErrorKind` as a human-readable word -- `codegen.fn`
// itself carries no message/location for these (see this file's own
// header comment), so this is the coarsest possible diagnostic: which of
// the two failure shapes it was, nothing more.
fun _codegen_error_kind_name(CodegenErrorKind kind) str {
  fit kind {
    .UnsupportedNode -> { ret "unsupported node"; }
    .InvalidNode -> { ret "invalid node"; }
  }
}

fun _fail(str msg) num {
  writeln_to(Sink.Stderr, format(`[Error]
    `{str}`, msg));
  ret 1;
}

// Lexes, resolves `imp`s, parses, and transpiles `in_path` to C, writing
// the result to `out_path`. Returns a C-style exit code (0 success).
fun compile_file(str in_path, str out_path) num {
  let parsed = parse_program_with_imports(in_path);
  if parsed.is_err() {
    ret _fail(parsed.unwrap_err());
  }
  let nodes = parsed.unwrap();

  CodegenState state = codegen_state_new();
  Codegen cg = codegen_new(&state);
  let cg_err = cg.transpile(nodes);
  fit cg_err {
    .Some(kind) -> {
      let msg = format("codegen failed: {str}", _codegen_error_kind_name(kind));
      defer free(msg);
      ret _fail(msg);
    }
    .None -> {}
  }

  str c_source = state.out.build();
  if !write_string(out_path, c_source) {
    let msg = format("failed to write output file: {str}", out_path);
    defer free(msg);
    ret _fail(msg);
  }
  ret 0;
}

fun main(str[] args) num {
  CliArgs cli = cli_parse(args);
  fit cli.at_positional(0) {
    .Some(in_path) -> {
      let out_path = cli.at_positional(1).unwrap_or("a.out.c");
      ret compile_file(in_path, out_path);
    }
    .None -> { ret _fail("usage: selfhost_main <input.fn> [<output.c>]"); }
  }
}
