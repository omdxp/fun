// Path helpers.
// 
// Usage:
// ```
// Path p = path("/tmp");
// str joined = p.join("file.txt");
// ```

imp std.c.mem;
imp std.string;
imp std.vec;
imp std.result;
imp std.error;

// Path wrapper.
pub compound Path {
  // Path string.
  str value;
}

// Create a Path wrapper.
// 
// Params:
// - value: path string
// 
// Returns:
// - initialized path wrapper
pub fun path(str value) Path {
  Path p;
  p.value = value;
  ret p;
}

impl Path {
  // Join this path with another path segment.
  // 
  // Params:
  // - other: child path segment
  // 
  // Returns:
  // - joined path string
  pub join(str other) str {
    ret path_join(self.value, other);
  }

  // Return the base name of the path.
  // 
  // Returns:
  // - final path segment
  pub basename() str {
    ret basename(self.value);
  }

  // Return the directory portion of the path.
  // 
  // Returns:
  // - directory component of the path
  pub dirname() str {
    ret dirname(self.value);
  }

  // Return the file extension of the path.
  // 
  // Returns:
  // - file extension including the leading dot
  // - empty string when no extension is present
  pub extname() str {
    ret extname(self.value);
  }

  // Return true when the path is absolute.
  // 
  // Returns:
  // - true when the path is absolute under POSIX rules
  pub is_abs() bin {
    ret is_abs(self.value);
  }
}

// Join two path segments.
// 
// Params:
// - a: base path
// - b: child path
// 
// Returns:
// - joined path
pub fun path_join(str a, str b) str {
  let alen = len(a);
  let blen = len(b);
  bin a_slash = false;
  bin b_slash = false;
  if alen > 0 && a[alen - 1] == '/' {
    a_slash = true;
  }
  if blen > 0 && b[0] == '/' {
    b_slash = true;
  }

  num extra = 1;
  if a_slash != false {
    extra = 0;
  } elif b_slash != false {
    extra = 0;
  }

  str out = malloc(alen + blen + extra + 1);
  if out == nil {
    ret nil;
  }

  num pos = 0;
  num i = 0;
  for i < alen {
    out[pos] = a[i];
    pos = pos + 1;
    i = i + 1;
  }
  if extra == 1 {
    out[pos] = '/';
    pos = pos + 1;
  }

  num b_start = 0;
  if b_slash != false && extra == 0 && alen > 0 && a_slash != false {
    b_start = 1;
  }
  i = b_start;
  for i < blen {
    out[pos] = b[i];
    pos = pos + 1;
    i = i + 1;
  }

  out[pos] = '\0';
  ret out;
}

// Join two path segments and report allocation failure as a Result.
// 
// Params:
// - a: base path
// - b: child path
// 
// Returns:
// - `Ok(joined_path)` on success
// - `Err` when allocation fails
pub fun try_path_join(str a, str b) Result<str, Error> {
  let out = path_join(a, b);
  if out == nil {
    ret err_kind(.Invalid, "path_join failed", "");
  }
  ret .Ok(out);
}

// Join multiple segments.
// 
// Params:
// - parts: vector of path parts
// 
// Returns:
// - joined path
pub fun path_join_many(Vec<str>* parts) str {
  if parts.len() == 0 {
    ret "";
  }
  let out = parts.get(0);
  num i = 1;
  for i < parts.len() {
    out = path_join(out, parts.get(i));
    // A failed allocation in path_join yields nil; feeding it back in would
    // deref a null pointer on the next len() call. Stop and propagate nil.
    if out == nil {
      ret nil;
    }
    i = i + 1;
  }
  ret out;
}

// Join multiple path segments and report allocation failure as a Result.
// 
// Params:
// - parts: vector of path parts
// 
// Returns:
// - `Ok(joined_path)` on success
// - `Err` when allocation fails
pub fun try_path_join_many(Vec<str>* parts) Result<str, Error> {
  let out = path_join_many(parts);
  if out == nil {
    ret err_kind(.Invalid, "path_join_many failed", "");
  }
  ret .Ok(out);
}

// True if path is absolute (posix).
// 
// Params:
// - path: path string
// 
// Returns:
// - true if absolute
pub fun is_abs(str path) bin {
  if len(path) == 0 {
    ret false;
  }
  ret path[0] == '/';
}

// Base name of a path.
// 
// Params:
// - path: path string
// 
// Returns:
// - last path segment
pub fun basename(str path) str {
  let path_len = len(path);
  if path_len == 0 {
    ret path;
  }
  num i = path_len;
  num last = -1;
  for i > 0 {
    if path[i - 1] == '/' {
      last = i - 1;
      break;
    }
    i = i - 1;
  }
  if last == -1 {
    ret substr(path, 0, path_len);
  }
  let start = last + 1;
  ret substr(path, start, path_len - start);
}

// Directory name of a path.
// 
// Params:
// - path: path string
// 
// Returns:
// - directory portion
pub fun dirname(str path) str {
  let path_len = len(path);
  if path_len == 0 {
    ret substr(path, 0, 0);
  }
  num i = path_len;
  num last = -1;
  for i > 0 {
    if path[i - 1] == '/' {
      last = i - 1;
      break;
    }
    i = i - 1;
  }
  if last == -1 {
    ret substr(path, 0, path_len);
  }
  if last == 0 {
    ret substr("/", 0, 1);
  }
  ret substr(path, 0, last);
}

// File extension of a path.
// 
// Params:
// - path: path string
// 
// Returns:
// - extension (including leading dot) or empty string
pub fun extname(str path) str {
  let path_len = len(path);
  num i = path_len;
  num last_slash = -1;
  num last_dot = -1;
  for i > 0 {
    if last_dot == -1 && path[i - 1] == '.' {
      last_dot = i - 1;
    }
    if path[i - 1] == '/' {
      last_slash = i - 1;
      break;
    }
    i = i - 1;
  }
  if last_dot == -1 {
    ret "";
  }
  if last_slash != -1 && last_dot < last_slash {
    ret "";
  }
  ret substr(path, last_dot, path_len - last_dot);
}

// Strip extension from a path.
// 
// Params:
// - path: path string
// 
// Returns:
// - path without extension
pub fun strip_ext(str path) str {
  let ext = extname(path);
  if len(ext) == 0 {
    ret substr(path, 0, len(path));
  }
  let plen = len(path);
  let elen = len(ext);
  ret substr(path, 0, plen - elen);
}

// Change or add an extension.
// 
// Params:
// - path: path string
// - new_ext: new extension (with or without leading dot)
// 
// Returns:
// - path with new extension
pub fun change_ext(str path, str new_ext) str {
  let base = strip_ext(path);
  if len(new_ext) == 0 {
    ret base;
  }
  let base_len = len(base);
  let ext_len = len(new_ext);
  let has_dot = new_ext[0] == '.';
  num extra = 0;
  if has_dot == false {
    extra = 1;
  }

  str out = malloc(base_len + ext_len + extra + 1);
  if out == nil {
    ret nil;
  }

  num i = 0;
  num pos = 0;
  for i < base_len {
    out[pos] = base[i];
    pos = pos + 1;
    i = i + 1;
  }
  if has_dot == false {
    out[pos] = '.';
    pos = pos + 1;
  }
  i = 0;
  for i < ext_len {
    out[pos] = new_ext[i];
    pos = pos + 1;
    i = i + 1;
  }
  out[pos] = '\0';
  ret out;
}

// Change or add an extension and report allocation failure as a Result.
// 
// Params:
// - path: path string
// - new_ext: new extension with or without a leading dot
// 
// Returns:
// - `Ok(path_with_new_extension)` on success
// - `Err` when allocation fails
pub fun try_change_ext(str path, str new_ext) Result<str, Error> {
  let out = change_ext(path, new_ext);
  if out == nil {
    ret err_kind(.Invalid, "change_ext failed", "");
  }
  ret .Ok(out);
}
