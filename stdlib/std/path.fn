// Path helpers.

imp std.c.mem;
imp std.c.def;
imp std.string;

// Path wrapper.
// 
// Fields:
// - value: path string
pub compound Path {
  // value: path string
  str value;
}

// Create a Path wrapper.
// 
// Params:
// - value: path string
// 
// Returns:
// - Path wrapper
pub fun path(str value) Path {
  Path p;
  p.value = value;
  ret p;
}

impl Path {
  // Join with another path segment.
  pub join(str other) str {
    ret path_join(self.value, other);
  }

  // Base name of the path.
  pub basename() str {
    ret basename(self.value);
  }

  // Directory name of the path.
  pub dirname() str {
    ret dirname(self.value);
  }

  // File extension of the path.
  pub extname() str {
    ret extname(self.value);
  }
}

// Join two path segments.
// 
// Params:
// - a: base path
// - b: child path
// 
// Returns:
// - joined path
pub fun path_join(str a, str b) str {
  num alen = len(a);
  num blen = len(b);
  bin a_slash = false;
  bin b_slash = false;
  if alen > 0 {
    if a[alen - 1] == '/' {
      a_slash = true;
    }
  }
  if blen > 0 {
    if b[0] == '/' {
      b_slash = true;
    }
  }

  num extra = 1;
  if a_slash != false {
    extra = 0;
  } elif b_slash != false {
    extra = 0;
  }

  str out = malloc(alen + blen + extra + 1);
  if out == NULL {
    ret NULL;
  }

  num pos = 0;
  num i = 0;
  for i < alen {
    out[pos] = a[i];
    pos = pos + 1;
    i = i + 1;
  }
  if extra == 1 {
    out[pos] = '/';
    pos = pos + 1;
  }

  num b_start = 0;
  if b_slash != false && extra == 0 && alen > 0 && a_slash != false {
    b_start = 1;
  }
  i = b_start;
  for i < blen {
    out[pos] = b[i];
    pos = pos + 1;
    i = i + 1;
  }

  out[pos] = '\0';
  ret out;
}

// Base name of a path.
// 
// Params:
// - path: path string
// 
// Returns:
// - last path segment
pub fun basename(str path) str {
  num path_len = len(path);
  if path_len == 0 {
    ret path;
  }
  num i = path_len;
  num last = -1;
  for i > 0 {
    if path[i - 1] == '/' {
      last = i - 1;
      break;
    }
    i = i - 1;
  }
  if last == -1 {
    ret substr(path, 0, path_len);
  }
  num start = last + 1;
  ret substr(path, start, path_len - start);
}

// Directory name of a path.
// 
// Params:
// - path: path string
// 
// Returns:
// - directory portion
pub fun dirname(str path) str {
  num path_len = len(path);
  if path_len == 0 {
    ret substr(path, 0, 0);
  }
  num i = path_len;
  num last = -1;
  for i > 0 {
    if path[i - 1] == '/' {
      last = i - 1;
      break;
    }
    i = i - 1;
  }
  if last == -1 {
    ret substr(path, 0, path_len);
  }
  if last == 0 {
    ret substr("/", 0, 1);
  }
  ret substr(path, 0, last);
}

// File extension of a path.
// 
// Params:
// - path: path string
// 
// Returns:
// - extension (including leading dot) or empty string
pub fun extname(str path) str {
  num path_len = len(path);
  num i = path_len;
  num last_slash = -1;
  num last_dot = -1;
  for i > 0 {
    if last_dot == -1 && path[i - 1] == '.' {
      last_dot = i - 1;
    }
    if path[i - 1] == '/' {
      last_slash = i - 1;
      break;
    }
    i = i - 1;
  }
  if last_dot == -1 {
    ret "";
  }
  if last_slash != -1 {
    if last_dot < last_slash {
      ret "";
    }
  }
  ret substr(path, last_dot, path_len - last_dot);
}
