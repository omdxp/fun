// Path helpers.

use std.c.mem;
use std.string;
use std.vec;
use std.result;
use std.error;

// Path wrapper.
pub compound Path {
  // Path string.
  str value;
}

// Creates a Path wrapper around a path string.
pub fun path(str value) Path {
  Path p;
  p.value = value;
  ret p;
}

impl Path {
  // Joins this path with another path segment.
  pub join(str other) str {
    ret path_join(self.value, other);
  }

  // Final segment of the path.
  pub basename() str {
    ret basename(self.value);
  }

  // Directory portion of the path.
  pub dirname() str {
    ret dirname(self.value);
  }

  // File extension including the leading dot, or empty string if none.
  pub extname() str {
    ret extname(self.value);
  }

  // True when the path is absolute under POSIX rules.
  pub is_abs() flag {
    ret is_abs(self.value);
  }
}

// Joins two path segments.
pub fun path_join(str a, str b) str {
  let alen = len(a);
  let blen = len(b);
  flag a_slash = false;
  flag b_slash = false;
  if alen > 0 && a[alen - 1] == '/' {
    a_slash = true;
  }
  if blen > 0 && b[0] == '/' {
    b_slash = true;
  }

  num extra = 1;
  if a_slash != false {
    extra = 0;
  } elif b_slash != false {
    extra = 0;
  }

  str out = malloc(alen + blen + extra + 1);
  if out == nil {
    ret nil;
  }

  num pos = 0;
  num i = 0;
  for i < alen {
    out[pos] = a[i];
    pos = pos + 1;
    i = i + 1;
  }
  if extra == 1 {
    out[pos] = '/';
    pos = pos + 1;
  }

  num b_start = 0;
  if b_slash != false && extra == 0 && alen > 0 && a_slash != false {
    b_start = 1;
  }
  i = b_start;
  for i < blen {
    out[pos] = b[i];
    pos = pos + 1;
    i = i + 1;
  }

  out[pos] = '\0';
  ret out;
}

// Joins two path segments, returning `Err` when allocation fails.
pub fun try_path_join(str a, str b) Result<str, Error> {
  let out = path_join(a, b);
  if out == nil {
    ret err_kind(.Invalid, "path_join failed", "");
  }
  ret .Ok(out);
}

// Joins multiple path segments in order.
pub fun path_join_many(Vec<str>* parts) str {
  if parts.len() == 0 {
    ret "";
  }
  let out = parts.get(0);
  num i = 1;
  for i < parts.len() {
    out = path_join(out, parts.get(i));
    // A failed allocation in path_join yields nil; feeding it back in would
    // deref a null pointer on the next len() call. Stop and propagate nil.
    if out == nil {
      ret nil;
    }
    i = i + 1;
  }
  ret out;
}

// Joins multiple path segments, returning `Err` when allocation fails.
pub fun try_path_join_many(Vec<str>* parts) Result<str, Error> {
  let out = path_join_many(parts);
  if out == nil {
    ret err_kind(.Invalid, "path_join_many failed", "");
  }
  ret .Ok(out);
}

// True if path is absolute (POSIX rules).
// True for an absolute path on any platform: a leading `/` or `\`
// (POSIX root, Windows root-of-drive or `\\server` share), or a Windows
// drive letter followed by a separator (`C:\`, `C:/`).
pub fun is_abs(str path) flag {
  num n = len(path);
  if n == 0 {
    ret false;
  }
  if path[0] == '/' || path[0] == '\\' {
    ret true;
  }
  flag drive_letter = (path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z');
  ret n >= 3 && drive_letter && path[1] == ':' && (path[2] == '/' || path[2] == '\\');
}

// Last segment of a path.
pub fun basename(str path) str {
  let path_len = len(path);
  if path_len == 0 {
    ret path;
  }
  num i = path_len;
  num last = -1;
  for i > 0 {
    if path[i - 1] == '/' || path[i - 1] == '\\' {
      last = i - 1;
      break;
    }
    i = i - 1;
  }
  if last == -1 {
    ret substr(path, 0, path_len);
  }
  let start = last + 1;
  ret substr(path, start, path_len - start);
}

// Directory portion of a path.
pub fun dirname(str path) str {
  let path_len = len(path);
  if path_len == 0 {
    ret substr(path, 0, 0);
  }
  num i = path_len;
  num last = -1;
  for i > 0 {
    if path[i - 1] == '/' || path[i - 1] == '\\' {
      last = i - 1;
      break;
    }
    i = i - 1;
  }
  if last == -1 {
    ret substr(path, 0, path_len);
  }
  if last == 0 {
    ret substr("/", 0, 1);
  }
  ret substr(path, 0, last);
}

// File extension of a path, including the leading dot, or empty string.
pub fun extname(str path) str {
  let path_len = len(path);
  num i = path_len;
  num last_slash = -1;
  num last_dot = -1;
  for i > 0 {
    if last_dot == -1 && path[i - 1] == '.' {
      last_dot = i - 1;
    }
    if path[i - 1] == '/' || path[i - 1] == '\\' {
      last_slash = i - 1;
      break;
    }
    i = i - 1;
  }
  if last_dot == -1 {
    ret "";
  }
  if last_slash != -1 && last_dot < last_slash {
    ret "";
  }
  ret substr(path, last_dot, path_len - last_dot);
}

// Strips the extension from a path.
pub fun strip_ext(str path) str {
  let ext = extname(path);
  if len(ext) == 0 {
    ret substr(path, 0, len(path));
  }
  let plen = len(path);
  let elen = len(ext);
  ret substr(path, 0, plen - elen);
}

// Changes or adds an extension (`new_ext` with or without a leading dot).
pub fun change_ext(str path, str new_ext) str {
  let base = strip_ext(path);
  if len(new_ext) == 0 {
    ret base;
  }
  let base_len = len(base);
  let ext_len = len(new_ext);
  let has_dot = new_ext[0] == '.';
  num extra = 0;
  if has_dot == false {
    extra = 1;
  }

  str out = malloc(base_len + ext_len + extra + 1);
  if out == nil {
    ret nil;
  }

  num i = 0;
  num pos = 0;
  for i < base_len {
    out[pos] = base[i];
    pos = pos + 1;
    i = i + 1;
  }
  if has_dot == false {
    out[pos] = '.';
    pos = pos + 1;
  }
  i = 0;
  for i < ext_len {
    out[pos] = new_ext[i];
    pos = pos + 1;
    i = i + 1;
  }
  out[pos] = '\0';
  ret out;
}

// Changes or adds an extension, returning `Err` when allocation fails.
pub fun try_change_ext(str path, str new_ext) Result<str, Error> {
  let out = change_ext(path, new_ext);
  if out == nil {
    ret err_kind(.Invalid, "change_ext failed", "");
  }
  ret .Ok(out);
}

// True when `text` matches the glob `pattern`: `*` is any run of
// characters within one path segment, `**` any run across segments
// (`**/` also matching no segment at all), `?` one character other
// than `/`, `[abc]`/`[a-z]` one character from a set (`[!...]` or
// `[^...]` one character outside it), and `\` takes the next character
// literally. The same dialect `.gitignore` patterns are written in.
pub fun glob_match(str pattern, str text) flag {
  ret _glob_match_at(pattern, 0, text, 0);
}

fun _glob_match_at(str p, num pi, str t, num ti) flag {
  num pn = len(p);
  num tn = len(t);
  for pi < pn {
    chr c = p[pi];
    if c == '*' {
      flag crosses = pi + 1 < pn && p[pi + 1] == '*';
      num next = pi + 1;
      if crosses {
        next = pi + 2;
        if next < pn && p[next] == '/' && _glob_match_at(p, next + 1, t, ti) {
          ret true;
        }
      }
      num k = ti;
      for k <= tn {
        if _glob_match_at(p, next, t, k) {
          ret true;
        }
        if k == tn || (!crosses && t[k] == '/') {
          ret false;
        }
        k = k + 1;
      }
      ret false;
    }
    if ti >= tn {
      ret false;
    }
    if c == '?' {
      if t[ti] == '/' {
        ret false;
      }
      pi = pi + 1;
      ti = ti + 1;
      continue;
    }
    if c == '[' {
      num close = pi + 1;
      if close < pn && (p[close] == '!' || p[close] == '^') {
        close = close + 1;
      }
      if close < pn && p[close] == ']' {
        close = close + 1;
      }
      for close < pn && p[close] != ']' {
        close = close + 1;
      }
      if close < pn {
        flag negated = p[pi + 1] == '!' || p[pi + 1] == '^';
        num ci = pi + 1;
        if negated {
          ci = ci + 1;
        }
        flag in_set = false;
        flag first = true;
        for ci < close {
          if !first || p[ci] != ']' {
            if ci + 2 < close && p[ci + 1] == '-' {
              if t[ti] >= p[ci] && t[ti] <= p[ci + 2] {
                in_set = true;
              }
              ci = ci + 3;
              first = false;
              continue;
            }
          }
          if p[ci] == t[ti] {
            in_set = true;
          }
          ci = ci + 1;
          first = false;
        }
        if in_set == negated || t[ti] == '/' {
          ret false;
        }
        pi = close + 1;
        ti = ti + 1;
        continue;
      }
    }
    if c == '\\' && pi + 1 < pn {
      pi = pi + 1;
      c = p[pi];
    }
    if c != t[ti] {
      ret false;
    }
    pi = pi + 1;
    ti = ti + 1;
  }
  ret ti == tn;
}

test "is_abs recognizes POSIX and Windows absolute paths" {
  assert is_abs("/usr/lib"), "expected a POSIX root";
  assert is_abs("C:\\Users\\me") && is_abs("c:/x"), "expected a drive-letter path";
  assert is_abs("\\\\server\\share"), "expected a UNC share";
  assert !is_abs("src/main.fn") && !is_abs("C:rel") && !is_abs(""), "expected relative paths rejected";
}

test "glob_match covers the .gitignore dialect" {
  assert glob_match("*.c", "main.c"), "expected * within a segment";
  assert !glob_match("*.c", "src/main.c"), "expected * never to cross a slash";
  assert glob_match("**/*.c", "src/deep/main.c"), "expected ** to cross segments";
  assert glob_match("**/*.c", "main.c"), "expected **/ to also match no segment";
  assert glob_match("src/**", "src/a/b.fn"), "expected a trailing ** to match everything below";
  assert glob_match("a?c", "abc") && !glob_match("a?c", "a/c"), "expected ? to match one non-slash character";
  assert glob_match("*.p[0-9]*n[0-9]*.fn", "x.p123n4.fn"), "expected digit ranges";
  assert !glob_match("*.p[0-9]*n[0-9]*.fn", "x.pAn4.fn"), "expected a range to reject outside characters";
  assert glob_match("[!a]bc", "xbc") && !glob_match("[!a]bc", "abc"), "expected a negated set";
  assert glob_match("\\*lit", "*lit") && !glob_match("\\*lit", "xlit"), "expected an escaped star to be literal";
  assert glob_match("node_modules", "node_modules") &&
    !glob_match("node_modules", "node_modules2"), "expected a plain name to match exactly";
}
