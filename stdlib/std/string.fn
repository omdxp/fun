// String helpers.

use std.c.mem;
use std.c.string;
use std.c.io;
use std.vec;
use std.quirks;
use std.result;
use std.error;

// String builder for efficient concatenation. One growable byte
// buffer, copied into directly on each append rather than holding a
// list of separately-owned fragments, since a fragment's own literal
// or allocated status can't be told apart later.
pub compound StringBuilder {
  str buf;
  num total_len;
  num cap;
}

// Creates a string builder with the given initial capacity.
pub fun string_builder_init(num cap) StringBuilder {
  StringBuilder b;
  if cap <= 0 {
    cap = 16;
  }
  b.buf = malloc(cap);
  b.total_len = 0;
  b.cap = cap;
  ret b;
}

impl StringBuilder as Sized {
  // Returns the total length of appended content.
  pub len() num {
    ret self.total_len;
  }

  // True when no content has been appended.
  pub is_empty() flag {
    ret self.total_len == 0;
  }
}

impl StringBuilder {
  // Grows `buf` so at least `additional` more bytes fit, doubling
  // capacity (or exactly meeting the request, whichever is bigger)
  // rather than growing one byte at a time. A failed `realloc` leaves
  // the builder as it was, its existing content untouched; the append
  // that asked for the room silently drops what it was about to add,
  // matching every other allocation-failure path here.
  _ensure_cap(num additional) {
    num needed = self.total_len + additional;
    if needed <= self.cap {
      ret;
    }
    num new_cap = self.cap * 2;
    if new_cap < needed {
      new_cap = needed;
    }
    str grown = realloc(self.buf, new_cap);
    if grown == nil {
      ret;
    }
    self.buf = grown;
    self.cap = new_cap;
  }

  // Appends a string fragment: copied byte-for-byte into this
  // builder's own buffer, `s` itself never touched afterward, so it
  // makes no difference whether it's a literal or something this
  // caller owns and frees on its own.
  pub append(str s) {
    if s == nil {
      ret;
    }
    num n = _string_len(s);
    if n == 0 {
      ret;
    }
    self._ensure_cap(n);
    if self.total_len + n > self.cap {
      ret;
    }
    num i = 0;
    for i < n {
      self.buf[self.total_len + i] = s[i];
      i = i + 1;
    }
    self.total_len = self.total_len + n;
  }

  // True when `needle` occurs entirely within the first `limit` bytes,
  // searched in place and stopping at the first match. Asking this of a
  // large buffer through `peek()` and `contains` copies and scans all of
  // it every time. The search runs on libc's `strstr` with a terminator
  // briefly written at `limit` (the byte there is restored before
  // returning), so the buffer must not be read from another thread while
  // this runs. Text containing a nul byte is searched only up to it.
  pub contains_within(str needle, num limit) flag {
    num nl = _string_len(needle);
    if nl == 0 {
      ret true;
    }
    num end = limit;
    if end > self.total_len {
      end = self.total_len;
    }
    if end < nl {
      ret false;
    }
    if end == self.total_len {
      self._ensure_cap(1);
    }
    if end < self.cap {
      chr saved = self.buf[end];
      self.buf[end] = '\0';
      str hit = strstr(self.buf, needle);
      self.buf[end] = saved;
      ret hit != nil;
    }
    num i = 0;
    for i + nl <= end {
      num j = 0;
      flag ok = true;
      for j < nl {
        if self.buf[i + j] != needle[j] {
          ok = false;
          break;
        }
        j = j + 1;
      }
      if ok {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Inserts `s` so it starts at byte `pos` (clamped to the current
  // content), shifting only what follows it. Splicing into the middle of
  // a large buffer this way costs the length of the tail, where
  // rebuilding the whole string around the insertion costs the whole
  // buffer every time.
  pub insert_at(num pos, str s) {
    if s == nil {
      ret;
    }
    num n = _string_len(s);
    if n == 0 {
      ret;
    }
    num at = pos;
    if at < 0 {
      at = 0;
    }
    if at > self.total_len {
      at = self.total_len;
    }
    self._ensure_cap(n);
    if self.total_len + n > self.cap {
      ret;
    }
    num i = self.total_len - 1;
    for i >= at {
      self.buf[i + n] = self.buf[i];
      i = i - 1;
    }
    num k = 0;
    for k < n {
      self.buf[at + k] = s[k];
      k = k + 1;
    }
    self.total_len = self.total_len + n;
  }

  // Appends a single character.
  pub append_char(chr c) {
    self._ensure_cap(1);
    if self.total_len + 1 > self.cap {
      ret;
    }
    self.buf[self.total_len] = c;
    self.total_len = self.total_len + 1;
  }

  // Appends a number as decimal digits.
  pub append_num(num n) {
    let s = format_num(n);
    if s == nil {
      ret;
    }
    self.append(s);
    free(s);
  }

  // Appends a decimal value with the given number of decimal places.
  pub append_dec(dec d, num places) {
    let s = format_dec(d, places);
    if s == nil {
      ret;
    }
    self.append(s);
    free(s);
  }

  // Empties the builder while keeping its buffer's current capacity.
  pub clear() {
    self.total_len = 0;
  }

  // Frees the builder's own buffer and resets it.
  pub free() {
    if self.buf != nil {
      free(self.buf);
      self.buf = nil;
    }
    self.total_len = 0;
    self.cap = 0;
  }

  // The byte already appended at `i`, read directly from this
  // builder's own buffer with no copy - `build()` materializes the
  // whole thing into a fresh string, O(n) every call; a caller that
  // only needs to look at one byte (checking what sits at a candidate
  // splice position, say) does that copy for nothing, repeatedly, and
  // it adds up on a large buffer. Out-of-range reads a nul byte,
  // matching how the built string's own trailing terminator reads.
  pub char_at(num i) chr {
    if i < 0 || i >= self.total_len {
      ret '\0';
    }
    ret self.buf[i];
  }

  // A fresh copy of everything appended so far, with this builder
  // untouched. For a caller still using it afterward; everyone else
  // wants `build()` below.
  pub peek() str {
    str out = malloc(self.total_len + 1);
    if out == nil {
      ret "";
    }
    num i = 0;
    for i < self.total_len {
      out[i] = self.buf[i];
      i = i + 1;
    }
    out[self.total_len] = '\0';
    ret out;
  }

  // A fresh copy of everything appended so far, and the last use of
  // this builder: its own buffer is freed here rather than left for
  // the caller to remember (a redundant explicit `free()` after is a
  // harmless no-op).
  pub build() str {
    str out = self.peek();
    self.free();
    ret out;
  }
}

fun _string_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

fun _is_space(chr c) flag {
  // A carriage return counts: text that arrives with Windows line
  // endings would otherwise keep one after being trimmed.
  if c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == '\0' {
    ret true;
  }
  ret false;
}

// Length of a string.
pub fun len(str s) num {
  ret _string_len(s);
}

// True when string is empty.
pub fun is_empty(str s) flag {
  ret _string_len(s) == 0;
}

// Compares two strings for equality.
pub fun equals(str a, str b) flag {
  num i = 0;
  for true {
    let ca = a[i];
    let cb = b[i];
    if ca != cb {
      ret false;
    }
    if ca == 0 {
      ret true;
    }
    i = i + 1;
  }
}

// True when s starts with prefix.
pub fun starts_with(str s, str prefix) flag {
  let sl = _string_len(s);
  let pl = _string_len(prefix);
  if pl > sl {
    ret false;
  }
  num i = 0;
  for i < pl {
    if s[i] != prefix[i] {
      ret false;
    }
    i = i + 1;
  }
  ret true;
}

// True when s ends with suffix.
pub fun ends_with(str s, str suffix) flag {
  let sl = _string_len(s);
  let su = _string_len(suffix);
  if su > sl {
    ret false;
  }
  num i = 0;
  let start = sl - su;
  for i < su {
    if s[start + i] != suffix[i] {
      ret false;
    }
    i = i + 1;
  }
  ret true;
}

// True when needle appears in s.
pub fun contains(str s, str needle) flag {
  ret index_of_str(s, needle) != -1;
}

// Substring by start/length (nil on allocation failure). A negative `start` or
// `length` counts as zero, so `substr(s, 1, len(s) - 2)` on a one-character
// string is "" instead of a wrapped-around huge allocation. It does not check
// against the end of `s`; `try_substr` does.
pub fun substr(str s, num start, num length) str {
  if start < 0 {
    start = 0;
  }
  if length < 0 {
    length = 0;
  }
  str out = malloc(length + 1);
  if out == nil {
    ret nil;
  }
  num i = 0;
  for i < length {
    out[i] = s[start + i];
    i = i + 1;
  }
  out[length] = '\0';
  ret out;
}

// Bounds-checked substring. `Ok(slice)` when `start`/`length` fall within `s`,
// otherwise `Err` — unlike `substr`, which reads past the string on a bad range.
pub fun try_substr(str s, num start, num length) Result<str, Error> {
  if start < 0 || length < 0 {
    ret err_kind(.Invalid, "substr: negative start or length", "");
  }
  if start + length > _string_len(s) {
    ret err_kind(.Invalid, "substr: range exceeds string length", "");
  }
  let out = substr(s, start, length);
  if out == nil {
    ret err_kind(.OutOfMemory, "substr: allocation failed", "");
  }
  ret .Ok(out);
}

// Trims whitespace from both ends.
pub fun trim(str s) str {
  let n = _string_len(s);
  if n == 0 {
    ret substr(s, 0, 0);
  }

  num start = 0;
  for start < n {
    let c = s[start];
    if _is_space(c) == false {
      break;
    }
    start = start + 1;
  }

  if start == n {
    ret substr(s, 0, 0);
  }

  num end = n;
  for end > 0 {
    let c = s[end - 1];
    if _is_space(c) == false {
      break;
    }
    end = end - 1;
  }

  let out_len = end - start;
  ret substr(s, start, out_len);
}

// Trims whitespace from the left.
pub fun trim_left(str s) str {
  let n = _string_len(s);
  if n == 0 {
    ret substr(s, 0, 0);
  }

  num start = 0;
  for start < n {
    let c = s[start];
    if _is_space(c) == false {
      break;
    }
    start = start + 1;
  }
  ret substr(s, start, n - start);
}

// Trims whitespace from the right.
pub fun trim_right(str s) str {
  let n = _string_len(s);
  if n == 0 {
    ret substr(s, 0, 0);
  }

  num end = n;
  for end > 0 {
    let c = s[end - 1];
    if _is_space(c) == false {
      break;
    }
    end = end - 1;
  }
  ret substr(s, 0, end);
}

// Splits s on delim into a Vec<str> of segments.
pub fun split(str s, chr delim) Vec<str> {
  Vec<str> parts;
  parts.init(4);
  let n = _string_len(s);
  num start = 0;
  num i = 0;
  for i <= n {
    if s[i] == delim {
      let seg_len = i - start;
      let seg = substr(s, start, seg_len);
      parts.push(seg);
      start = i + 1;
    } elif s[i] == 0 {
      let seg_len = i - start;
      let seg = substr(s, start, seg_len);
      parts.push(seg);
      start = i + 1;
    }
    i = i + 1;
  }
  ret parts;
}

// Splits s on runs of whitespace into a Vec<str> of segments.
pub fun split_whitespace(str s) Vec<str> {
  Vec<str> parts;
  parts.init(4);

  let n = _string_len(s);
  num i = 0;
  for i < n {
    for i < n {
      if _is_space(s[i]) == false {
        break;
      }
      i = i + 1;
    }
    if i >= n {
      break;
    }
    let start = i;
    for i < n {
      if _is_space(s[i]) != false {
        break;
      }
      i = i + 1;
    }
    let seg_len = i - start;
    parts.push(substr(s, start, seg_len));
  }
  ret parts;
}

// Joins parts with sep.
pub fun join(Vec<str>* parts, str sep) str {
  ret parts.join(sep);
}

// First index of ch in s, or -1 if not found.
pub fun index_of_char(str s, chr ch) num {
  num i = 0;
  for s[i] != 0 {
    if s[i] == ch {
      ret i;
    }
    i = i + 1;
  }
  ret -1;
}

// Last index of ch in s, or -1 if not found.
pub fun last_index_of_char(str s, chr ch) num {
  let i = _string_len(s);
  for i > 0 {
    if s[i - 1] == ch {
      ret i - 1;
    }
    i = i - 1;
  }
  ret -1;
}

// First index of needle in s, or -1 if not found.
pub fun index_of_str(str s, str needle) num {
  let sl = _string_len(s);
  let nl = _string_len(needle);
  if nl == 0 {
    ret 0;
  }
  if nl > sl {
    ret -1;
  }
  num i = 0;
  for i <= sl - nl {
    num j = 0;
    flag ok = true;
    for j < nl {
      if s[i + j] != needle[j] {
        ok = false;
        break;
      }
      j = j + 1;
    }
    if ok {
      ret i;
    }
    i = i + 1;
  }
  ret -1;
}

// Counts non-overlapping occurrences of needle in s.
pub fun count(str s, str needle) num {
  let nl = _string_len(needle);
  if nl == 0 {
    ret 0;
  }
  let sl = _string_len(s);
  num i = 0;
  num total = 0;
  for i <= sl - nl {
    num j = 0;
    flag ok = true;
    for j < nl {
      if s[i + j] != needle[j] {
        ok = false;
        break;
      }
      j = j + 1;
    }
    if ok {
      total = total + 1;
      i = i + nl;
    } else {
      i = i + 1;
    }
  }
  ret total;
}

// Strips prefix if present, else returns s unchanged.
pub fun strip_prefix(str s, str prefix) str {
  if starts_with(s, prefix) == false {
    ret substr(s, 0, _string_len(s));
  }
  ret substr(s, _string_len(prefix), _string_len(s) - _string_len(prefix));
}

// Strips suffix if present, else returns s unchanged.
pub fun strip_suffix(str s, str suffix) str {
  if ends_with(s, suffix) == false {
    ret substr(s, 0, _string_len(s));
  }
  let sl = _string_len(s);
  let su = _string_len(suffix);
  ret substr(s, 0, sl - su);
}

// Splits s into lines.
pub fun split_lines(str s) Vec<str> {
  let parts = split(s, '\n');
  num i = 0;
  for i < parts.len {
    let line = parts.get(i);
    let l = _string_len(line);
    if l > 0 {
      if line[l - 1] == '\0' {
        let trimmed = substr(line, 0, l - 1);
        parts.set(i, trimmed);
      }
    }
    i = i + 1;
  }
  ret parts;
}

// Converts an ASCII string to lowercase.
pub fun to_lower(str s) str {
  let n = _string_len(s);
  str out = malloc(n + 1);
  if out == nil {
    ret nil;
  }
  str upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  str lower = "abcdefghijklmnopqrstuvwxyz";
  num i = 0;
  for i < n {
    let c = s[i];
    num j = 0;
    flag changed = false;
    for j < 26 {
      if c == upper[j] {
        out[i] = lower[j];
        changed = true;
        break;
      }
      j = j + 1;
    }
    if changed == false {
      out[i] = c;
    }
    i = i + 1;
  }
  out[n] = '\0';
  ret out;
}

// Converts an ASCII string to uppercase.
pub fun to_upper(str s) str {
  let n = _string_len(s);
  str out = malloc(n + 1);
  if out == nil {
    ret nil;
  }
  str upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  str lower = "abcdefghijklmnopqrstuvwxyz";
  num i = 0;
  for i < n {
    let c = s[i];
    num j = 0;
    flag changed = false;
    for j < 26 {
      if c == lower[j] {
        out[i] = upper[j];
        changed = true;
        break;
      }
      j = j + 1;
    }
    if changed == false {
      out[i] = c;
    }
    i = i + 1;
  }
  out[n] = '\0';
  ret out;
}

// Repeats s the given number of times.
pub fun repeat(str s, num times) str {
  if times <= 0 {
    ret substr(s, 0, 0);
  }
  let sl = _string_len(s);
  let total = sl * times;
  str out = malloc(total + 1);
  if out == nil {
    ret nil;
  }
  num i = 0;
  for i < times {
    num j = 0;
    for j < sl {
      out[i * sl + j] = s[j];
      j = j + 1;
    }
    i = i + 1;
  }
  out[total] = '\0';
  ret out;
}

// Replaces all occurrences of one character with another.
pub fun replace_char(str s, chr from, chr to) str {
  let n = _string_len(s);
  str out = malloc(n + 1);
  if out == nil {
    ret nil;
  }
  num i = 0;
  for i < n {
    let c = s[i];
    if c == from {
      c = to;
    }
    out[i] = c;
    i = i + 1;
  }
  out[n] = '\0';
  ret out;
}

// Replaces all occurrences of needle with repl.
pub fun replace_str(str s, str needle, str repl) str {
  let nl = _string_len(needle);
  if nl == 0 {
    ret substr(s, 0, _string_len(s));
  }

  let b = string_builder_init(8);
  let sl = _string_len(s);
  num i = 0;
  for i < sl {
    flag match = true;
    if i + nl > sl {
      match = false;
    } else {
      num j = 0;
      for j < nl {
        if s[i + j] != needle[j] {
          match = false;
          break;
        }
        j = j + 1;
      }
    }

    if match != false {
      b.append(repl);
      i = i + nl;
    } else {
      b.append_char(s[i]);
      i = i + 1;
    }
  }
  let out = b.build();
  b.free();
  ret out;
}

// Parses a signed integer from a string (lenient: stops at the first non-digit and
// returns what it parsed, so `"12x"` -> 12 and `"abc"` -> 0). When you need to know
// the string was a *valid* integer, use `try_parse_int`.
pub fun parse_int(str s) num {
  num i = 0;
  num sign = 1;
  if s[0] == '-' {
    sign = -1;
    i = 1;
  }
  num value = 0;
  for s[i] != 0 {
    if s[i] < '0' {
      break;
    }
    if s[i] > '9' {
      break;
    }
    value = value * 10 + (s[i] - '0');
    i = i + 1;
  }
  ret value * sign;
}

// Parse a signed integer, validating the whole string. `Ok(n)` only when `s` is a
// non-empty run of digits (with an optional leading `-`); otherwise `Err`. Use this
// for untrusted input where `parse_int`'s silent 0/partial result is a footgun.
pub fun try_parse_int(str s) Result<num, Error> {
  num n = _string_len(s);
  if n == 0 {
    ret err_kind(.Parse, "parse_int: empty string", 0);
  }
  num i = 0;
  if s[0] == '-' {
    i = 1;
    if n == 1 {
      ret err_kind(.Parse, "parse_int: lone '-'", 0);
    }
  }
  for i < n {
    if s[i] < '0' || s[i] > '9' {
      ret err_kind(.Parse, "parse_int: invalid digit", 0);
    }
    i = i + 1;
  }
  ret .Ok(parse_int(s));
}

// Formats a num as a decimal string (heap-allocated; caller owns the memory).
pub fun format_num(num n) str {
  // Max i64 is 19 digits + sign + NUL = 21 bytes.
  str buf = malloc(21);
  if buf == nil {
    ret nil;
  }
  if n == 0 {
    buf[0] = '0';
    buf[1] = '\0';
    ret buf;
  }
  let neg = n < 0;
  if neg {
    n = 0 - n;
  }
  // Digit lookup.
  str digits = "0123456789";
  // Write digits in reverse.
  num pos = 0;
  for n > 0 {
    buf[pos] = digits[n % 10];
    n = n / 10;
    pos = pos + 1;
  }
  if neg {
    buf[pos] = '-';
    pos = pos + 1;
  }
  buf[pos] = '\0';
  // Reverse the string in-place.
  num lo = 0;
  num hi = pos - 1;
  for lo < hi {
    let tmp = buf[lo];
    buf[lo] = buf[hi];
    buf[hi] = tmp;
    lo = lo + 1;
    hi = hi - 1;
  }
  ret buf;
}

// Formats a dec as a string with the given number of decimal places
// (clamped to 0..9); heap-allocated, caller owns the memory.
pub fun format_dec(dec d, num places) str {
  if places < 0 {
    places = 0;
  }
  if places > 9 {
    places = 9;
  }
  // 48 bytes is enough for any double with up to 9 decimal places.
  str buf = malloc(48);
  if buf == nil {
    ret nil;
  }
  // Build format string "%.Nf" where N is the places digit.
  str fmt = malloc(6);
  if fmt == nil {
    free(buf);
    ret nil;
  }
  str digits = "0123456789";
  fmt[0] = '%';
  fmt[1] = '.';
  fmt[2] = digits[places];
  fmt[3] = 'f';
  fmt[4] = '\0';
  _ = snprintf(buf, 48, fmt, d);
  free(fmt);
  ret buf;
}

// The text of `d` that reads back as exactly `d`, using as few digits as it
// takes (up to 17), and always spelled as a decimal (`3` becomes `3.0`) so a C
// compiler does not read it as an integer. Unlike `format_dec` it never
// truncates to a fixed number of places. The caller frees the result.
pub fun format_dec_exact(dec d) str {
  str buf = malloc(48);
  if buf == nil {
    ret nil;
  }
  _ = snprintf(buf, 48, "%.15g", d);
  if atof(buf) != d {
    _ = snprintf(buf, 48, "%.16g", d);
  }
  if atof(buf) != d {
    _ = snprintf(buf, 48, "%.17g", d);
  }
  num n = _string_len(buf);
  flag marked = false;
  num i = 0;
  for i < n {
    chr c = buf[i];
    if c == '.' || c == 'e' || c == 'E' || c == 'n' || c == 'i' {
      marked = true;
    }
    i = i + 1;
  }
  if !marked {
    buf[n] = '.';
    buf[n + 1] = '0';
    buf[n + 2] = '\0';
  }
  ret buf;
}

// Formats a flag as "true" or "false" (static string, do not free).
pub fun format_flag(flag b) str {
  if b {
    ret "true";
  }
  ret "false";
}

// Parses a decimal string into a dec, leniently: the longest numeric prefix is
// read (an optional `-`, digits, an optional `.` and digits, an optional
// exponent) and anything after it is ignored, so malformed input yields a
// partial or 0.0 result. The conversion itself is the C library's, which
// rounds correctly, so `parse_dec("0.1")` is exactly the double nearest 0.1.
// Use `try_parse_dec` to validate.
pub fun parse_dec(str s) dec {
  num n = _string_len(s);
  num i = 0;
  if n > 0 && s[0] == '-' {
    i = 1;
  }
  num end = i;
  num digits = 0;
  for end < n && s[end] >= '0' && s[end] <= '9' {
    end = end + 1;
    digits = digits + 1;
  }
  if end < n && s[end] == '.' {
    end = end + 1;
    for end < n && s[end] >= '0' && s[end] <= '9' {
      end = end + 1;
      digits = digits + 1;
    }
  }
  if digits == 0 {
    ret 0.0;
  }
  // An exponent counts only when digits follow it; a bare `e` is not one.
  if end < n && (s[end] == 'e' || s[end] == 'E') {
    num j = end + 1;
    if j < n && (s[j] == '+' || s[j] == '-') {
      j = j + 1;
    }
    num k = j;
    for k < n && s[k] >= '0' && s[k] <= '9' {
      k = k + 1;
    }
    if k > j {
      end = k;
    }
  }
  str text = substr(s, 0, end);
  dec value = atof(text);
  free(text);
  ret value;
}

// Parse a decimal, validating the whole string. `Ok(d)` only when `s` is a non-empty
// number — optional leading `-`, digits, at most one `.` — otherwise `Err`. Use this
// for untrusted input where `parse_dec`'s silent partial result is a footgun.
pub fun try_parse_dec(str s) Result<dec, Error> {
  num n = _string_len(s);
  if n == 0 {
    ret err_kind(.Parse, "parse_dec: empty string", 0.0);
  }
  num i = 0;
  if s[0] == '-' {
    i = 1;
  }
  num digits = 0;
  num dots = 0;
  for i < n {
    let c = s[i];
    if c == '.' {
      dots = dots + 1;
      if dots > 1 {
        ret err_kind(.Parse, "parse_dec: multiple '.'", 0.0);
      }
    } elif c >= '0' && c <= '9' {
      digits = digits + 1;
    } elif c == 'e' || c == 'E' {
      // What follows is the exponent: an optional sign, then at least
      // one digit, and nothing after it.
      if digits == 0 {
        ret err_kind(.Parse, "parse_dec: no digits", 0.0);
      }
      i = i + 1;
      if i < n && (s[i] == '+' || s[i] == '-') {
        i = i + 1;
      }
      num exponent_digits = 0;
      for i < n {
        let e = s[i];
        if e < '0' || e > '9' {
          ret err_kind(.Parse, "parse_dec: invalid char", 0.0);
        }
        exponent_digits = exponent_digits + 1;
        i = i + 1;
      }
      if exponent_digits == 0 {
        ret err_kind(.Parse, "parse_dec: no exponent digits", 0.0);
      }
      ret .Ok(parse_dec(s));
    } else {
      ret err_kind(.Parse, "parse_dec: invalid char", 0.0);
    }
    i = i + 1;
  }
  if digits == 0 {
    ret err_kind(.Parse, "parse_dec: no digits", 0.0);
  }
  ret .Ok(parse_dec(s));
}

// Formats `value` as hexadecimal, padded with leading zeros to `width`
// digits, in lower case. A value wider than `width` keeps its digits
// rather than being cut short.
pub fun to_hex(num value, num width) str {
  ret _to_hex_with(value, width, "0123456789abcdef");
}

// The same, in upper case, for the places that spell hexadecimal that
// way: a percent-escape in a URI, for one.
pub fun to_hex_upper(num value, num width) str {
  ret _to_hex_with(value, width, "0123456789ABCDEF");
}

fun _to_hex_with(num value, num width, str digits) str {
  ret _to_base_with(value, width, 16, digits);
}

// Formats `value` in binary (`0`/`1` digits only), padded with leading
// zeros to `width` digits. A value wider than `width` keeps its digits
// rather than being cut short. "" for a negative value, the same as
// `to_hex`.
pub fun to_binary(num value, num width) str {
  ret _to_base_with(value, width, 2, "01");
}

// Formats `value` in octal, padded with leading zeros to `width`
// digits. "" for a negative value, the same as `to_hex`.
pub fun to_octal(num value, num width) str {
  ret _to_base_with(value, width, 8, "01234567");
}

fun _to_base_with(num value, num width, num base, str digits) str {
  if value < 0 {
    ret "";
  }
  StringBuilder b = string_builder_init(16);
  if value == 0 {
    b.append_char(digits[0]);
  }
  num remaining = value;
  for remaining > 0 {
    b.append_char(digits[remaining % base]);
    remaining = remaining / base;
  }
  str reversed = b.build();
  StringBuilder out = string_builder_init(16);
  num pad = width - len(reversed);
  num i = 0;
  for i < pad {
    out.append_char(digits[0]);
    i = i + 1;
  }
  i = len(reversed);
  for i > 0 {
    i = i - 1;
    out.append_char(reversed[i]);
  }
  ret out.build();
}

// The number of bytes the UTF-8 sequence starting at `lead` occupies,
// read from the lead byte's own high bits: 1 for ASCII, 2/3/4 for a
// multi-byte lead. A continuation byte or an invalid lead (malformed
// input) is treated as its own one-byte sequence, so a bad byte can't
// desync a walk past it.
pub fun utf8_seq_len(chr lead) num {
  num b = lead - '\0';
  if b < 0 {
    b = b + 256;
  }
  if b < 0x80 {
    ret 1;
  }
  if b >= 0xC0 && b < 0xE0 {
    ret 2;
  }
  if b >= 0xE0 && b < 0xF0 {
    ret 3;
  }
  if b >= 0xF0 && b < 0xF8 {
    ret 4;
  }
  ret 1;
}

// How many UTF-16 code units a codepoint encoded in `seq_len` UTF-8
// bytes takes: one for anything in the Basic Multilingual Plane (every
// codepoint up to U+FFFF fits in at most 3 UTF-8 bytes), two (a
// surrogate pair) for anything past it, which always takes 4.
pub fun utf16_units_for_utf8_seq_len(num seq_len) num {
  if seq_len >= 4 {
    ret 2;
  }
  ret 1;
}

test "StringBuilder.insert_at splices in the middle, at the ends, and clamps a stray position" {
  StringBuilder b = string_builder_init(4);
  b.append("ad");
  b.insert_at(1, "bc");
  str middle = b.peek();
  assert equals(middle, "abcd"), "expected an insert between the first and last byte";
  free(middle);
  b.insert_at(0, ">");
  b.insert_at(99, "<");
  b.insert_at(-5, "^");
  str ends = b.peek();
  assert equals(ends, "^>abcd<"), "expected the start, the end, and clamped positions to land where they belong";
  free(ends);
  assert b.len() == 7, "expected the length to track every insert";
  b.free();
}

test "StringBuilder.insert_at ignores nil and empty text" {
  StringBuilder b = string_builder_init(4);
  b.append("ok");
  b.insert_at(1, nil);
  b.insert_at(1, "");
  str out = b.peek();
  assert equals(out, "ok"), "expected nothing inserted";
  free(out);
  b.free();
}

test "StringBuilder.contains_within searches only the first limit bytes" {
  StringBuilder b = string_builder_init(8);
  b.append("typedef struct Foo; typedef enum Bar;");
  assert b.contains_within("typedef struct Foo", 40), "expected a match inside the limit";
  assert b.contains_within("typedef enum Bar", 999), "expected a limit past the end to search everything";
  assert !b.contains_within("typedef enum Bar", 20), "expected a match starting past the limit to be missed";
  assert !b.contains_within("struct Foo;", 15), "expected a match cut off by the limit to be missed";
  assert !b.contains_within("nothing like this", 40), "expected no match for absent text";
  assert b.contains_within("", 0), "expected an empty needle to always match";
  b.free();
}

test "parse_dec reads the longest numeric prefix and rounds correctly" {
  assert parse_dec("12abc") == 12.0 && parse_dec("-0.5") == -0.5, "expected a prefix and a negative";
  assert parse_dec(".5") == 0.5 && parse_dec("5.") == 5.0, "expected a missing whole or fractional part to be fine";
  assert parse_dec("abc") == 0.0 && parse_dec("") == 0.0 && parse_dec("-") == 0.0 &&
    parse_dec(".") == 0.0, "expected no digits to give 0";
  assert parse_dec("1e3") == 1000.0 && parse_dec("2.5E-1") == 0.25 &&
    parse_dec("1e+2") == 100.0, "expected exponents";
  assert parse_dec("1e") == 1.0 && parse_dec("1ex") == 1.0, "expected a bare e to end the number";
  assert parse_dec("0.1") == 0.1 && parse_dec("1e-9") == 0.000000001, "expected the nearest double, not an accumulated one";
  assert parse_dec("3.141592653589793") == 3.141592653589793, "expected full precision";
  assert parse_dec("1e300") == 1e300, "expected a large exponent without a loop of multiplications";
}

test "format_dec_exact reads back exactly, with as few digits as it takes" {
  str a = format_dec_exact(0.1);
  assert equals(a, "0.1"), "expected the shortest text for 0.1";
  free(a);
  str b = format_dec_exact(2.5);
  assert equals(b, "2.5"), "expected 2.5";
  free(b);
  str c = format_dec_exact(3.0);
  assert equals(c, "3.0"), "expected a whole decimal to keep a decimal point";
  free(c);
  str d = format_dec_exact(-0.000000001);
  assert contains(d, "e-") && atof(d) == -0.000000001, "expected a tiny value to survive, in exponent form";
  free(d);
  str e = format_dec_exact(123456789.123456789);
  assert atof(e) == 123456789.123456789, "expected 17 digits when fewer do not round-trip";
  free(e);
  str f = format_dec_exact(3.141592653589793);
  assert equals(f, "3.141592653589793"), "expected pi without truncation";
  free(f);
}

test "substr treats a negative start or length as zero" {
  str a = substr("hello", 1, 3);
  assert equals(a, "ell"), "expected an ordinary substring";
  free(a);
  str b = substr("hello", 1, -2);
  assert equals(b, ""), "expected a negative length to give an empty string";
  free(b);
  str c = substr("hello", -3, 2);
  assert equals(c, "he"), "expected a negative start to count from the beginning";
  free(c);
  str d = substr("x", 1, -1);
  assert equals(d, ""), "expected the len - 2 shape on a one-character string to be safe";
  free(d);
}
