// Option container for optional values.
// 
// Usage:
// ```
// Option<num> v = some(1);
// Option<num> w = none(0);
// if v.is_some() { ... }
// ```
imp std.result;
imp std.error;

pub compound Option<T> {
  // Whether a value is present.
  bin has;
  // Stored value (meaningful when `has == true`).
  T value;
}

impl Option<T> {
  // Returns true when a value is present.
  pub is_some() bin {
    ret self.has;
  }

  // Returns true when no value is present.
  pub is_none() bin {
    ret self.has == false;
  }

  // Returns the stored value or a default when empty.
  pub unwrap_or(T default_value) T {
    if self.has {
      ret self.value;
    }
    ret default_value;
  }

  // Returns the stored value (uses internal default when empty).
  pub unwrap() T {
    ret self.value;
  }

  // Set the option to a value.
  pub set_some(T value) {
    self.has = true;
    self.value = value;
  }

  // Clear the option and store a default value.
  pub set_none(T default_value) {
    self.has = false;
    self.value = default_value;
  }

  // Convert to a Result with the provided error if empty.
  pub ok_or(num code, str message) Result<T> {
    Result<T> r;
    if self.has {
      r.ok = true;
      r.value = self.value;
      r.err = error_ok();
      ret r;
    }
    r.ok = false;
    r.value = self.value;
    r.err = error_new(code, message);
    ret r;
  }

  // Convert to a Result with a provided Error if empty.
  pub ok_or_error(Error err) Result<T> {
    Result<T> r;
    if self.has {
      r.ok = true;
      r.value = self.value;
      r.err = error_ok();
      ret r;
    }
    r.ok = false;
    r.value = self.value;
    r.err = err;
    ret r;
  }

  // Return other if empty; otherwise keep this value.
  pub or(Option<T> other) Option<T> {
    if self.has {
      Option<T> out;
      out.has = self.has;
      out.value = self.value;
      ret out;
    }
    Option<T> out;
    out.has = other.has;
    out.value = other.value;
    ret out;
  }

  // Return other if present; otherwise return none.
  pub and(Option<T> other) Option<T> {
    if self.has {
      Option<T> out;
      out.has = other.has;
      out.value = other.value;
      ret out;
    }
    Option<T> out;
    out.has = self.has;
    out.value = self.value;
    ret out;
  }
}

// Construct an Option with a value.
pub fun some<T>(T value) Option<T> {
  Option<T> o;
  o.set_some(value);
  ret o;
}

// Construct an empty Option with a default value.
pub fun none<T>(T default_value) Option<T> {
  Option<T> o;
  o.set_none(default_value);
  ret o;
}
