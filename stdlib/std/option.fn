// Option<T>: a value that may be present (`Some`) or absent (`None`).
// 
// Option is a data-carrying enum (a sum type), so you pattern-match it with `fit`:
// 
// ```
// Option<num> o = some(42);
// fit o {
//   Option.Some(v) -> { print_num(v); }
//   Option.None -> { print("nothing"); }
// }
// ```
// 
// Or use the combinator methods for the common cases:
// 
// ```
// num n = find_user(id).unwrap_or(0); // value, or a fallback when None
// ```
// 
// Construct with `some(v)` (infers T from v) or the variant directly:
// 
// ```
// Option<num> a = some(42);
// Option<num> b = Option.None; // or the shorthand `.None`
// ```

imp std.result;
imp std.error;

// An optional value: `Some(v)` holds a `T`; `None` holds nothing.
pub enum Option<T> {
  Some(T),
  None,
}

impl Option<T> {
  // True when a value is present.
  pub is_some() bin {
    fit *self {
      .Some(v) -> { ret true; }
      .None -> { ret false; }
    }
    ret false;
  }

  // True when no value is present.
  pub is_none() bin {
    fit *self {
      .Some(v) -> { ret false; }
      .None -> { ret true; }
    }
    ret true;
  }

  // The contained value, or `fallback` when None.
  pub unwrap_or(T fallback) T {
    fit *self {
      .Some(v) -> { ret v; }
      .None -> { ret fallback; }
    }
    ret fallback;
  }

  // The contained value. Prefer `unwrap_or`: on None this returns a zero value
  // (there is no panic mechanism), so only use it when you have already checked
  // `is_some()` or matched the variant.
  pub unwrap() T {
    fit *self {
      .Some(v) -> { ret v; }
      .None -> { ret self.zero(); }
    }
    ret self.zero();
  }

  // A zero-initialized T, used as the empty fallback for `unwrap`.
  zero() T {
    T out;
    ret out;
  }

  // This option if it is Some, otherwise `other`.
  pub or(Option<T> other) Option<T> {
    fit *self {
      .Some(v) -> { ret .Some(v); }
      .None -> { ret other; }
    }
    ret other;
  }

  // `other` if this is Some, otherwise None (logical AND of presence).
  pub and(Option<T> other) Option<T> {
    fit *self {
      .Some(v) -> { ret other; }
      .None -> { ret .None; }
    }
    ret .None;
  }

  // Keep the value when `keep` is true; otherwise None. `keep` is a plain
  // boolean you compute at the call site (Fun has no first-class predicate
  // functions), e.g. `opt.filter(n > 0)`.
  pub filter(bin keep) Option<T> {
    fit *self {
      .Some(v) -> {
        if keep {
          ret .Some(v);
        }
        ret .None;
      }
      .None -> { ret .None; }
    }
    ret .None;
  }
}

// Construct `Some(value)` (T is inferred from `value`).
pub fun some<T>(T value) Option<T> {
  ret .Some(value);
}

// Convert an Option to a Result: Some(v) -> Ok(v); None -> Err tagged with `kind`.
// Provided as a free function (rather than a method) so the Result type parameter
// resolves from the call site.
pub fun ok_or<T>(Option<T> o, ErrorKind kind, str message) Result<T> {
  fit o {
    .Some(v) -> { ret ok(v); }
    .None -> {
      T zero;
      ret err_kind(kind, message, zero);
    }
  }
  T zero;
  ret err_kind(kind, message, zero);
}
