// Thread pool helpers built on std.thread.
// 
// Notes:
// - This module manages groups of worker thread handles.
// - Worker entrypoints use pthread-style function pointers (`raw*`).

imp std.thread;
imp std.thread_runtime;
imp std.c.mem;
imp std.result;
imp std.quirks;

// Managed pool of worker threads.
pub compound ThreadPool {
  // Contiguous worker thread handles.
  Thread[] workers;
  // Number of worker slots.
  num size;
  // True when worker storage is usable.
  bin has_storage;
}

// Create a thread pool with `size` worker handles.
// 
// Params:
// - size: requested worker count (negative values become 0)
// 
// Returns:
// - initialized pool; `has_storage == false` when allocation fails
pub fun thread_pool_new(num size) ThreadPool {
  ThreadPool pool;
  raw* workers_ptr = nil;
  pool.workers = workers_ptr;
  pool.size = 0;
  pool.has_storage = true;

  if size < 0 {
    size = 0;
  }
  pool.size = size;
  if size == 0 {
    ret pool;
  }

  raw* data_ptr = malloc(sizeof(Thread) * size);
  pool.workers = data_ptr;
  if data_ptr == nil {
    pool.has_storage = false;
    ret pool;
  }

  num i = 0;
  for i < size {
    pool.workers[i] = runtime_thread_new();
    i = i + 1;
  }

  ret pool;
}

impl ThreadPool as Sized {
  // Number of worker handles in this pool.
  pub len() num {
    ret self.size;
  }

  // True when the pool has no worker handles.
  pub is_empty() bin {
    ret self.size == 0;
  }
}

impl ThreadPool {
  // Returns true when worker storage is usable.
  pub is_ready() bin {
    ret self.has_storage;
  }

  // Number of worker handles in this pool (alias for `len`, kept for clarity at call sites).
  pub count() num {
    ret self.size;
  }

  // Start all workers with a shared entrypoint.
  // 
  // Params:
  // - entry: pthread-style entry function pointer
  // - args: optional per-worker argument array (`args[i]` for worker i)
  // 
  // Returns:
  // - 0 on success
  // - -2 when pool allocation failed
  // - first nonzero thread start error code
  pub start_all(raw* entry, raw** args) num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      raw* arg = nil;
      if args != nil {
        arg = args[i];
      }

      let worker = self.workers[i];
      let rc = runtime_thread_start(&worker, entry, arg);
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Start all workers with Result. `Ok(count)` (workers started) on success, `Err`
  // when storage failed or a worker couldn't start — clearer than the -2/raw-code
  // sentinels of `start_all`.
  pub try_start_all(raw* entry, raw** args) Result<num> {
    let rc = self.start_all(entry, args);
    if rc != 0 {
      ret err_kind_code(.System, rc, "thread pool start_all failed", rc);
    }
    ret ok(self.size);
  }

  // Join all started workers.
  // 
  // Params:
  // - out_rets: optional per-worker return-pointer array (`out_rets[i]`)
  // 
  // Returns:
  // - 0 on success
  // - -2 when pool allocation failed
  // - first nonzero thread join error code
  pub join_all(raw** out_rets) num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      raw* out_ret = nil;
      if out_rets != nil {
        out_ret = out_rets[i];
      }

      let worker = self.workers[i];
      let rc = runtime_thread_join(&worker, out_ret);
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Join all started workers with Result. `Ok(count)` on success, `Err` otherwise.
  pub try_join_all(raw** out_rets) Result<num> {
    let rc = self.join_all(out_rets);
    if rc != 0 {
      ret err_kind_code(.System, rc, "thread pool join_all failed", rc);
    }
    ret ok(self.size);
  }

  // Detach all started workers.
  // 
  // Returns:
  // - 0 on success
  // - -2 when pool allocation failed
  // - first nonzero thread detach error code
  pub detach_all() num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      let worker = self.workers[i];
      let rc = runtime_thread_detach(&worker);
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Detach all started workers with Result. `Ok(count)` on success, `Err` otherwise.
  pub try_detach_all() Result<num> {
    let rc = self.detach_all();
    if rc != 0 {
      ret err_kind_code(.System, rc, "thread pool detach_all failed", rc);
    }
    ret ok(self.size);
  }

  // Free worker storage and reset the pool to an empty ready state.
  // 
  // Returns:
  // - 0 always
  pub destroy() num {
    if self.has_storage == true && self.size > 0 {
      free(self.workers);
    }
    raw* workers_ptr = nil;
    self.workers = workers_ptr;
    self.size = 0;
    self.has_storage = true;
    ret 0;
  }
}
