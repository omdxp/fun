// Thread pool helpers built on std.thread.
// 
// Notes:
// - This module manages groups of worker thread handles.
// - Worker entrypoints use pthread-style function pointers (`raw*`).

imp std.thread;
imp std.c.thread;
imp std.c.mem;
imp std.c.def;

// Managed pool of worker threads.
pub compound ThreadPool {
  // Contiguous worker thread handles.
  Thread[] workers;
  // Number of worker slots.
  num size;
  // True when worker storage is usable.
  bin has_storage;
}

// Create a thread pool with `size` worker handles.
// 
// Params:
// - size: requested worker count (negative values become 0)
// 
// Returns:
// - initialized pool; `has_storage == false` when allocation fails
pub fun thread_pool_new(num size) ThreadPool {
  ThreadPool pool;
  raw* workers_ptr = NULL;
  pool.workers = workers_ptr;
  pool.size = 0;
  pool.has_storage = true;

  if size < 0 {
    size = 0;
  }
  pool.size = size;
  if size == 0 {
    ret pool;
  }

  raw* data_ptr = malloc(sizeof(Thread) * size);
  pool.workers = data_ptr;
  if data_ptr == NULL {
    pool.has_storage = false;
    ret pool;
  }

  num i = 0;
  for i < size {
    pool.workers[i] = thread_new();
    i = i + 1;
  }

  ret pool;
}

impl ThreadPool {
  // Returns true when worker storage is usable.
  pub is_ready() bin {
    ret self.has_storage;
  }

  // Number of worker handles in this pool.
  pub count() num {
    ret self.size;
  }

  // Start all workers with a shared entrypoint.
  // 
  // Params:
  // - entry: pthread-style entry function pointer
  // - args: optional per-worker argument array (`args[i]` for worker i)
  // 
  // Returns:
  // - 0 on success
  // - -2 when pool allocation failed
  // - first nonzero thread start error code
  pub start_all(raw* entry, raw **args) num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      raw* arg = NULL;
      if args != NULL {
        arg = args[i];
      }

      Thread worker = self.workers[i];
      num rc = 0;
      if worker.started == false {
        rc = pthread_create(&worker.handle, NULL, entry, arg);
        if rc == 0 {
          worker.started = true;
        }
      }
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Join all started workers.
  // 
  // Params:
  // - out_rets: optional per-worker return-pointer array (`out_rets[i]`)
  // 
  // Returns:
  // - 0 on success
  // - -2 when pool allocation failed
  // - first nonzero thread join error code
  pub join_all(raw **out_rets) num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      raw* out_ret = NULL;
      if out_rets != NULL {
        out_ret = out_rets[i];
      }

      Thread worker = self.workers[i];
      num rc = 0;
      if worker.started == true {
        rc = pthread_join(worker.handle, out_ret);
        if rc == 0 {
          worker.started = false;
        }
      }
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Detach all started workers.
  // 
  // Returns:
  // - 0 on success
  // - -2 when pool allocation failed
  // - first nonzero thread detach error code
  pub detach_all() num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      Thread worker = self.workers[i];
      num rc = 0;
      if worker.started == true {
        rc = pthread_detach(worker.handle);
        if rc == 0 {
          worker.started = false;
        }
      }
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Free worker storage.
  // 
  // Returns:
  // - 0 always
  pub destroy() num {
    if self.has_storage == true && self.size > 0 {
      free(self.workers);
    }
    raw* workers_ptr = NULL;
    self.workers = workers_ptr;
    self.size = 0;
    self.has_storage = true;
    ret 0;
  }
}
