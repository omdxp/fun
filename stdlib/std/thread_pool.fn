// Thread pool helpers built on std.thread.
//
// Manages groups of worker thread handles. Worker entrypoints use
// pthread-style function pointers (`raw*`).

use std.thread;
use std.thread_runtime;
use std.c.mem;
use std.result;
use std.error;
use std.quirks;
use std.atomic;
use std.time;

// Managed pool of worker threads.
pub compound ThreadPool {
  // Contiguous worker thread handles.
  Thread[] workers;
  // Number of worker slots.
  num size;
  // True when worker storage is usable.
  flag has_storage;
}

// Creates a thread pool with `size` worker handles (negative values become
// 0). `has_storage` is false on the returned pool when allocation fails.
pub fun thread_pool_new(num size) ThreadPool {
  ThreadPool pool;
  raw* workers_ptr = nil;
  pool.workers = workers_ptr;
  pool.size = 0;
  pool.has_storage = true;

  if size < 0 {
    size = 0;
  }
  pool.size = size;
  if size == 0 {
    ret pool;
  }

  raw* data_ptr = malloc(sizeof(Thread) * size);
  pool.workers = data_ptr;
  if data_ptr == nil {
    pool.has_storage = false;
    ret pool;
  }

  num i = 0;
  for i < size {
    pool.workers[i] = runtime_thread_new();
    i = i + 1;
  }

  ret pool;
}

impl ThreadPool as Sized {
  // Number of worker handles in this pool.
  pub len() num {
    ret self.size;
  }

  // True when the pool has no worker handles.
  pub is_empty() flag {
    ret self.size == 0;
  }
}

impl ThreadPool {
  // Returns true when worker storage is usable.
  pub is_ready() flag {
    ret self.has_storage;
  }

  // Number of worker handles in this pool (alias for `len`, kept for clarity at call sites).
  pub count() num {
    ret self.size;
  }

  // Starts all workers running `entry`, with an optional per-worker
  // argument array (`args[i]` for worker i). Returns 0 on success, -2 when
  // pool allocation failed, or the first nonzero thread start error code.
  pub start_all(raw* entry, raw** args) num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      raw* arg = nil;
      if args != nil {
        arg = args[i];
      }

      let worker = self.workers[i];
      let rc = runtime_thread_start(&worker, entry, arg);
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Start all workers with Result. `Ok(count)` (workers started) on success, `Err`
  // when storage failed or a worker couldn't start — clearer than the -2/raw-code
  // sentinels of `start_all`.
  pub try_start_all(raw* entry, raw** args) Result<num, Error> {
    let rc = self.start_all(entry, args);
    if rc != 0 {
      ret err_kind_code(.System, rc, "thread pool start_all failed", rc);
    }
    ret .Ok(self.size);
  }

  // Joins all started workers, with an optional per-worker return-pointer
  // array (`out_rets[i]`). Returns 0 on success, -2 when pool allocation
  // failed, or the first nonzero thread join error code.
  pub join_all(raw** out_rets) num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      raw* out_ret = nil;
      if out_rets != nil {
        out_ret = out_rets[i];
      }

      let worker = self.workers[i];
      let rc = runtime_thread_join(&worker, out_ret);
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Join all started workers with Result. `Ok(count)` on success, `Err` otherwise.
  pub try_join_all(raw** out_rets) Result<num, Error> {
    let rc = self.join_all(out_rets);
    if rc != 0 {
      ret err_kind_code(.System, rc, "thread pool join_all failed", rc);
    }
    ret .Ok(self.size);
  }

  // Detaches all started workers. Returns 0 on success, -2 when pool
  // allocation failed, or the first nonzero thread detach error code.
  pub detach_all() num {
    if self.has_storage == false {
      ret -2;
    }

    num i = 0;
    for i < self.size {
      let worker = self.workers[i];
      let rc = runtime_thread_detach(&worker);
      self.workers[i] = worker;
      if rc != 0 {
        ret rc;
      }

      i = i + 1;
    }

    ret 0;
  }

  // Detach all started workers with Result. `Ok(count)` on success, `Err` otherwise.
  pub try_detach_all() Result<num, Error> {
    let rc = self.detach_all();
    if rc != 0 {
      ret err_kind_code(.System, rc, "thread pool detach_all failed", rc);
    }
    ret .Ok(self.size);
  }

  // Frees worker storage and resets the pool to an empty ready state.
  // Always returns 0.
  pub destroy() num {
    if self.has_storage == true && self.size > 0 {
      free(self.workers);
    }
    raw* workers_ptr = nil;
    self.workers = workers_ptr;
    self.size = 0;
    self.has_storage = true;
    ret 0;
  }
}

// Each worker bumps the counter it was handed.
fun _pool_worker(raw* arg) raw* {
  Atomic<num>* hits = arg;
  hits.fetch_add(1);
  ret nil;
}

// One argument per worker, all pointing at `hits`.
fun _pool_args(Atomic<num>* hits, num workers) raw** {
  raw** args = malloc(sizeof(raw*) * workers);
  num i = 0;
  for i < workers {
    args[i] = hits;
    i = i + 1;
  }
  ret args;
}

test "a pool starts every worker and joins them all" {
  Atomic<num> hits;
  hits.store(0);
  ThreadPool pool = thread_pool_new(4);
  assert pool.is_ready() && pool.count() == 4 && pool.len() == 4 && !pool.is_empty(), "expected four workers";
  raw** args = _pool_args(&hits, 4);
  assert pool.start_all(_pool_worker, args) == 0, "expected the workers to start";
  assert pool.join_all(nil) == 0, "expected the workers to join";
  assert hits.load() == 4, "expected each worker to have run once";
  free(args);
  assert pool.destroy() == 0 && pool.is_empty(), "expected destroy to empty the pool";
}

test "the try_ forms report the pool size" {
  Atomic<num> hits;
  hits.store(0);
  ThreadPool pool = thread_pool_new(2);
  raw** args = _pool_args(&hits, 2);
  let started = pool.try_start_all(_pool_worker, args);
  assert started.is_ok() && started.unwrap() == 2, "expected the start to report two workers";
  let joined = pool.try_join_all(nil);
  assert joined.is_ok() && joined.unwrap() == 2, "expected the join to report two workers";
  assert hits.load() == 2, "expected both to have run";
  free(args);
  pool.destroy();
}

test "detached workers run to completion" {
  Atomic<num> hits;
  hits.store(0);
  ThreadPool pool = thread_pool_new(2);
  raw** args = _pool_args(&hits, 2);
  assert pool.start_all(_pool_worker, args) == 0, "expected the workers to start";
  assert pool.detach_all() == 0, "expected the workers to detach";
  num waited = 0;
  for hits.load() < 2 && waited < 300 {
    sleep_ms(10);
    waited = waited + 1;
  }
  assert hits.load() == 2, "expected both detached workers to finish";
  free(args);
  pool.destroy();
}

test "an empty or negative pool has no workers and nothing to do" {
  ThreadPool none = thread_pool_new(0);
  assert none.is_empty() && none.start_all(_pool_worker, nil) == 0 &&
    none.join_all(nil) == 0, "expected an empty pool to start and join trivially";
  ThreadPool negative = thread_pool_new(-3);
  assert negative.count() == 0, "expected a negative size to read as zero";
}
