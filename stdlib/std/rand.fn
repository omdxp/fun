// Simple PRNG.

imp std.vec;
imp std.result;
imp std.error;

// Pseudo-random number generator.
pub compound Rand {
  // Internal PRNG state.
  num state;
}

// Initialize a PRNG with a seed.
// 
// Params:
// - seed: initial seed
// 
// Returns:
// - initialized generator
pub fun rand_init(num seed) Rand {
  Rand r;
  r.state = seed;
  ret r;
}

impl Rand {
  // Return the next pseudo-random integer.
  // 
  // Returns:
  // - next pseudo-random integer value
  pub next() num {
    let s = self.state % 32768;
    s = (s * 1103 + 12345) % 32768;
    self.state = s;
    ret s;
  }

  // Return a random integer in `[min, max]`.
  // 
  // Params:
  // - min: inclusive lower bound
  // - max: inclusive upper bound
  // 
  // Notes:
  // - When `max - min + 1 <= 0`, this returns `min`.
  // 
  // Returns:
  // - pseudo-random integer in the requested range
  pub range(num min, num max) num {
    let v = self.next();
    let span = max - min + 1;
    if span <= 0 {
      ret min;
    }
    ret min + (v % span);
  }

  // Return a random integer in `[min, max]` with validation.
  // 
  // Params:
  // - min: inclusive lower bound
  // - max: inclusive upper bound
  // 
  // Returns:
  // - `Ok(value)` when `min <= max`
  // - `Err` when the bounds are invalid
  pub try_range(num min, num max) Result<num, Error> {
    if min > max {
      ret err_kind(.Invalid, "range: min > max", min);
    }
    ret .Ok(self.range(min, max));
  }

  // Return the next pseudo-random decimal in `[0, 1)`.
  // 
  // Returns:
  // - next pseudo-random decimal value
  pub next_dec() dec {
    dec v = self.next();
    ret v / 32768;
  }

  // Return a random decimal in `[min, max)`.
  // 
  // Params:
  // - min: inclusive lower bound
  // - max: exclusive upper bound
  // 
  // Returns:
  // - pseudo-random decimal in the requested range
  pub range_dec(dec min, dec max) dec {
    let v = self.next_dec();
    ret min + (max - min) * v;
  }

  // Return a random decimal in `[min, max)` with validation.
  // 
  // Params:
  // - min: inclusive lower bound
  // - max: exclusive upper bound
  // 
  // Returns:
  // - `Ok(value)` when `min <= max`
  // - `Err` when the bounds are invalid
  pub try_range_dec(dec min, dec max) Result<dec, Error> {
    if min > max {
      ret err_kind(.Invalid, "range_dec: min > max", min);
    }
    ret .Ok(self.range_dec(min, max));
  }

  // Return true with probability `p`.
  // 
  // Params:
  // - p: probability in the range `[0, 1]`
  // 
  // Returns:
  // - true with probability `p`
  pub chance(dec p) bin {
    if p <= 0 {
      ret false;
    }
    if p >= 1 {
      ret true;
    }
    ret self.next_dec() < p;
  }
}

// C-style wrapper for next().
// 
// Params:
// - r: generator
// 
// Returns:
// - next number
pub fun rand_next(Rand* r) num {
  ret r.next();
}

// C-style wrapper for range().
// 
// Params:
// - r: generator
// - min: lower bound
// - max: upper bound
// 
// Returns:
// - random value in range
pub fun rand_range(Rand* r, num min, num max) num {
  ret r.range(min, max);
}

// C-style wrapper for next_dec().
// 
// Params:
// - r: generator
// 
// Returns:
// - random value in [0, 1)
pub fun rand_dec(Rand* r) dec {
  ret r.next_dec();
}

// C-style wrapper for range_dec().
// 
// Params:
// - r: generator
// - min: lower bound
// - max: upper bound
// 
// Returns:
// - random value in range
pub fun rand_range_dec(Rand* r, dec min, dec max) dec {
  ret r.range_dec(min, max);
}

// C-style wrapper for chance().
// 
// Params:
// - r: generator
// - p: probability (0..1)
// 
// Returns:
// - true with probability p
pub fun rand_chance(Rand* r, dec p) bin {
  ret r.chance(p);
}

// Shuffle a Vec<T> in-place (Fisher-Yates).
// 
// Params:
// - r: generator
// - v: vector
pub fun rand_shuffle<T>(Rand* r, Vec<T>* v) {
  if v.len() <= 1 {
    ret;
  }
  num i = v.len() - 1;
  for i > 0 {
    let j = r.range(0, i);
    let tmp = v.data[i];
    v.data[i] = v.data[j];
    v.data[j] = tmp;
    i = i - 1;
  }
}
