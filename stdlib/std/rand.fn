// Simple PRNG.

imp std.vec;
imp std.result;
imp std.error;

// Pseudo-random number generator.
pub compound Rand {
  // Internal PRNG state.
  num state;
}

// Initializes a PRNG with the given seed.
pub fun rand_init(num seed) Rand {
  Rand r;
  r.state = seed;
  ret r;
}

impl Rand {
  // Returns the next pseudo-random integer.
  pub next() num {
    let s = self.state % 32768;
    s = (s * 1103 + 12345) % 32768;
    self.state = s;
    ret s;
  }

  // Returns a random integer in `[min, max]`. Returns `min` when
  // `max - min + 1 <= 0`.
  pub range(num min, num max) num {
    let v = self.next();
    let span = max - min + 1;
    if span <= 0 {
      ret min;
    }
    ret min + (v % span);
  }

  // Returns a random integer in `[min, max]`, or `Err` when `min > max`.
  pub try_range(num min, num max) Result<num, Error> {
    if min > max {
      ret err_kind(.Invalid, "range: min > max", min);
    }
    ret .Ok(self.range(min, max));
  }

  // Returns the next pseudo-random decimal in `[0, 1)`.
  pub next_dec() dec {
    dec v = self.next();
    ret v / 32768;
  }

  // Returns a random decimal in `[min, max)`.
  pub range_dec(dec min, dec max) dec {
    let v = self.next_dec();
    ret min + (max - min) * v;
  }

  // Returns a random decimal in `[min, max)`, or `Err` when `min > max`.
  pub try_range_dec(dec min, dec max) Result<dec, Error> {
    if min > max {
      ret err_kind(.Invalid, "range_dec: min > max", min);
    }
    ret .Ok(self.range_dec(min, max));
  }

  // Returns true with probability `p` (clamped to `[0, 1]`).
  pub chance(dec p) bin {
    if p <= 0 {
      ret false;
    }
    if p >= 1 {
      ret true;
    }
    ret self.next_dec() < p;
  }
}

// C-style wrapper for next().
pub fun rand_next(Rand* r) num {
  ret r.next();
}

// C-style wrapper for range().
pub fun rand_range(Rand* r, num min, num max) num {
  ret r.range(min, max);
}

// C-style wrapper for next_dec().
pub fun rand_dec(Rand* r) dec {
  ret r.next_dec();
}

// C-style wrapper for range_dec().
pub fun rand_range_dec(Rand* r, dec min, dec max) dec {
  ret r.range_dec(min, max);
}

// C-style wrapper for chance().
pub fun rand_chance(Rand* r, dec p) bin {
  ret r.chance(p);
}

// Shuffles a Vec<T> in-place (Fisher-Yates).
pub fun rand_shuffle<T>(Rand* r, Vec<T>* v) {
  if v.len() <= 1 {
    ret;
  }
  num i = v.len() - 1;
  for i > 0 {
    let j = r.range(0, i);
    let tmp = v.data[i];
    v.data[i] = v.data[j];
    v.data[j] = tmp;
    i = i - 1;
  }
}
