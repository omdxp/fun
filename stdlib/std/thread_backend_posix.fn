// POSIX thread backend implementation.
// 
// Notes:
// - This module defines the POSIX backend contract used by std.thread_runtime.

imp std.thread;

// Create a new POSIX backend thread handle.
pub fun thread_backend_posix_new() Thread {
  ret thread_new();
}

// Start a POSIX backend thread handle.
pub fun thread_backend_posix_start(Thread* thread, raw* entry, raw* arg) num {
  ret thread_start(thread, entry, arg);
}

// Join a POSIX backend thread handle.
pub fun thread_backend_posix_join(Thread* thread, raw* out_ret) num {
  ret thread_join(thread, out_ret);
}

// Detach a POSIX backend thread handle.
pub fun thread_backend_posix_detach(Thread* thread) num {
  ret thread_detach(thread);
}
