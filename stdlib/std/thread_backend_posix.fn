// POSIX thread backend implementation.
// 
// Defines the POSIX backend contract used by std.thread_runtime. Functions
// are thin forwards to std.thread helpers.

imp std.thread;

// Creates a new POSIX backend thread handle.
pub fun thread_backend_posix_new() Thread {
  ret thread_new();
}

// Starts a POSIX backend thread handle (same return codes as thread_start).
pub fun thread_backend_posix_start(Thread* thread, raw* entry, raw* arg) num {
  ret thread_start(thread, entry, arg);
}

// Joins a POSIX backend thread handle (same return codes as thread_join).
pub fun thread_backend_posix_join(Thread* thread, raw* out_ret) num {
  ret thread_join(thread, out_ret);
}

// Detaches a POSIX backend thread handle (same return codes as thread_detach).
pub fun thread_backend_posix_detach(Thread* thread) num {
  ret thread_detach(thread);
}
