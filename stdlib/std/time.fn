// Time and date (time.h)

compound tm {
  num tm_sec;
  num tm_min;
  num tm_hour;
  num tm_mday;
  num tm_mon;
  num tm_year;
  num tm_wday;
  num tm_yday;
  num tm_isdst;
}

fun time(num* tloc) num;
fun clock() num;
fun difftime(num time1, num time0) dec;
fun mktime(tm* t) num;

fun asctime(tm* t) str;
fun ctime(num* timep) str;
fun gmtime(num* timep) tm*;
fun localtime(num* timep) tm*;

fun strftime(str s, num max, str format, tm* t) num;
