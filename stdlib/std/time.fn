// Time helpers.

imp std.c.time;
imp std.c.io;
imp std.c.mem;
imp std.c.string;
imp std.result;
imp std.error;

// Timestamp wrapper (epoch seconds).
pub compound Timestamp {
  // seconds since Unix epoch
  num epoch;
}

// Current timestamp (epoch seconds).
pub fun now() Timestamp {
  Timestamp t;
  t.epoch = time(nil);
  ret t;
}

// Suspends the calling thread for `seconds` whole seconds. Works on every
// platform: `__fun_sleep_seconds` is a compiler-provided helper, not a
// direct libc binding, since POSIX's `nanosleep` has no Windows
// equivalent to bind under the same name.
pub fun sleep_seconds(num seconds) {
  __fun_sleep_seconds(seconds);
}

// Suspends the calling thread for `milliseconds`, sub-second
// precision included - what a short, precise wait (a debounce timer,
// a retry backoff) needs that `sleep_seconds`'s own whole-second
// resolution can't give it.
pub fun sleep_ms(num milliseconds) {
  __fun_sleep_seconds(milliseconds / 1000.0);
}

fun _copy_str(str dst, num dst_len, str src) num {
  if dst == nil {
    ret 0;
  }
  if dst_len <= 0 {
    ret 0;
  }
  num i = 0;
  for i < dst_len - 1 {
    if src[i] == 0 {
      break;
    }
    dst[i] = src[i];
    i = i + 1;
  }
  dst[i] = '\0';
  ret i;
}

fun _time_buf_from_epoch(num epoch) raw* {
  raw* buf = malloc(8);
  if buf == nil {
    ret nil;
  }
  memset(buf, 0, 8);
  num* p = buf;
  *p = epoch;
  ret buf;
}

fun _localtime_from_epoch(num epoch) raw* {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret nil;
  }
  raw* tm = localtime(tbuf);
  free(tbuf);
  ret tm;
}

fun _gmtime_from_epoch(num epoch) raw* {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret nil;
  }
  raw* tm = gmtime(tbuf);
  free(tbuf);
  ret tm;
}

impl Timestamp {
  // Format using a custom strftime format.
  pub format_local(str buf, num buf_len, str format) num {
    raw* t = _localtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, format, t);
  }

  // Format using a custom strftime format (UTC).
  pub format_utc(str buf, num buf_len, str format) num {
    raw* t = _gmtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, format, t);
  }

  // Format using a default pattern.
  pub to_string(str buf, num buf_len) num {
    raw* t = _localtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, "%Y-%m-%d %H:%M:%S", t);
  }

  // Format using a default pattern (UTC).
  pub to_string_utc(str buf, num buf_len) num {
    raw* t = _gmtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, "%Y-%m-%d %H:%M:%S", t);
  }
}

// Current epoch seconds.
pub fun now_epoch() num {
  let t = now();
  ret t.epoch;
}

// Adds `delta` seconds to an epoch value.
pub fun add_seconds(num epoch, num delta) num {
  ret epoch + delta;
}

// Difference between two epoch values in seconds.
pub fun diff_seconds(num a, num b) dec {
  ret difftime(a, b);
}

// Formats an epoch value with a custom strftime format. Returns the number
// of bytes written.
pub fun format_local(num epoch, str buf, num buf_len, str format) num {
  Timestamp t;
  t.epoch = epoch;
  ret t.format_local(buf, buf_len, format);
}

// Format an epoch value with a custom format (Result).
pub fun try_format_local(num epoch, str buf, num buf_len, str format) Result<num, Error> {
  let n = format_local(epoch, buf, buf_len, format);
  if n <= 0 {
    ret err_kind(.Unexpected, "format_local failed", 0);
  }
  ret .Ok(n);
}

// Formats an epoch value with a custom strftime format (UTC). Returns the
// number of bytes written.
pub fun format_utc(num epoch, str buf, num buf_len, str format) num {
  Timestamp t;
  t.epoch = epoch;
  ret t.format_utc(buf, buf_len, format);
}

// Format an epoch value with a custom format (UTC) with Result.
pub fun try_format_utc(num epoch, str buf, num buf_len, str format) Result<num, Error> {
  let n = format_utc(epoch, buf, buf_len, format);
  if n <= 0 {
    ret err_kind(.Unexpected, "format_utc failed", 0);
  }
  ret .Ok(n);
}

// Formats an epoch value using C's human-readable format (ctime). Returns
// the number of bytes written.
pub fun format_human(num epoch, str buf, num buf_len) num {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret 0;
  }
  str cstr = ctime(tbuf);
  num n = 0;
  if cstr != nil {
    n = _copy_str(buf, buf_len, cstr);
  }
  free(tbuf);
  ret n;
}

// Formats an epoch value using C's human-readable format (ctime), returning
// a pointer into a shared static buffer (or null). Don't free it or hold it
// across another time call, since the next ctime/localtime overwrites it;
// use `format_human(epoch, buf, len)` for a caller-owned, copy-safe result.
pub fun format_human_cstr(num epoch) str {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret nil;
  }
  str cstr = ctime(tbuf);
  free(tbuf);
  ret cstr;
}

// Formats the current time with the default format. Returns the number of
// bytes written.
pub fun now_string(str buf, num buf_len) num {
  let t = now();
  let n = t.to_string(buf, buf_len);
  if n > 0 {
    ret n;
  }
  ret snprintf(buf, buf_len, "%lld", t.epoch);
}

// Format current time with default format (Result).
pub fun try_now_string(str buf, num buf_len) Result<num, Error> {
  let n = now_string(buf, buf_len);
  if n <= 0 {
    ret err_kind(.Unexpected, "now_string failed", 0);
  }
  ret .Ok(n);
}

// Formats the current time with the default format (UTC). Returns the
// number of bytes written.
pub fun now_string_utc(str buf, num buf_len) num {
  let t = now();
  let n = t.to_string_utc(buf, buf_len);
  if n > 0 {
    ret n;
  }
  ret snprintf(buf, buf_len, "%lld", t.epoch);
}

// Format current time with default format (UTC) with Result.
pub fun try_now_string_utc(str buf, num buf_len) Result<num, Error> {
  let n = now_string_utc(buf, buf_len);
  if n <= 0 {
    ret err_kind(.Unexpected, "now_string_utc failed", 0);
  }
  ret .Ok(n);
}

// Formats the current time using C's human-readable format (ctime).
// Returns the number of bytes written.
pub fun now_human(str buf, num buf_len) num {
  let t = now();
  ret format_human(t.epoch, buf, buf_len);
}

// Human-readable string for the current time (ctime), as a pointer into a
// shared static buffer (or null). Don't free it or hold it across another
// time call; use `now_human(buf, len)` for a caller-owned result.
pub fun now_human_cstr() str {
  let t = now();
  ret format_human_cstr(t.epoch);
}
