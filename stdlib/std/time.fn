// Time helpers.
// 
// Usage:
// ```
// Timestamp t = now();
// str iso = time_format_iso(t);
// ```

imp std.c.time;
imp std.c.io;
imp std.c.mem;
imp std.c.string;
imp std.result;

// Timestamp wrapper (epoch seconds).
pub compound Timestamp {
  // seconds since Unix epoch
  num epoch;
}

// Current timestamp (epoch seconds).
// 
// Returns:
// - Timestamp with epoch seconds
pub fun now() Timestamp {
  Timestamp t;
  t.epoch = time(nil);
  ret t;
}

fun _copy_str(str dst, num dst_len, str src) num {
  if dst == nil {
    ret 0;
  }
  if dst_len <= 0 {
    ret 0;
  }
  num i = 0;
  for i < dst_len - 1 {
    if src[i] == 0 {
      break;
    }
    dst[i] = src[i];
    i = i + 1;
  }
  dst[i] = '\0';
  ret i;
}

fun _time_buf_from_epoch(num epoch) raw* {
  raw* buf = malloc(8);
  if buf == nil {
    ret nil;
  }
  memset(buf, 0, 8);
  num* p = buf;
  *p = epoch;
  ret buf;
}

fun _localtime_from_epoch(num epoch) raw* {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret nil;
  }
  raw* tm = localtime(tbuf);
  free(tbuf);
  ret tm;
}

fun _gmtime_from_epoch(num epoch) raw* {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret nil;
  }
  raw* tm = gmtime(tbuf);
  free(tbuf);
  ret tm;
}

impl Timestamp {
  // Format using a custom strftime format.
  pub format_local(str buf, num buf_len, str format) num {
    raw* t = _localtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, format, t);
  }

  // Format using a custom strftime format (UTC).
  pub format_utc(str buf, num buf_len, str format) num {
    raw* t = _gmtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, format, t);
  }

  // Format using a default pattern.
  pub to_string(str buf, num buf_len) num {
    raw* t = _localtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, "%Y-%m-%d %H:%M:%S", t);
  }

  // Format using a default pattern (UTC).
  pub to_string_utc(str buf, num buf_len) num {
    raw* t = _gmtime_from_epoch(self.epoch);
    if t == nil {
      ret 0;
    }
    ret strftime(buf, buf_len, "%Y-%m-%d %H:%M:%S", t);
  }
}

// Current epoch seconds.
// 
// Returns:
// - seconds since epoch
pub fun now_epoch() num {
  Timestamp t = now();
  ret t.epoch;
}

// Add seconds to an epoch value.
// 
// Params:
// - epoch: seconds since epoch
// - delta: seconds to add
// 
// Returns:
// - new epoch value
pub fun add_seconds(num epoch, num delta) num {
  ret epoch + delta;
}

// Difference between two epoch values in seconds.
// 
// Params:
// - a: first epoch
// - b: second epoch
// 
// Returns:
// - difference in seconds
pub fun diff_seconds(num a, num b) dec {
  ret difftime(a, b);
}

// Format an epoch value with a custom format.
// 
// Params:
// - epoch: seconds since epoch
// - buf: output buffer
// - buf_len: buffer capacity
// - format: strftime format
// 
// Returns:
// - number of bytes written
pub fun format_local(num epoch, str buf, num buf_len, str format) num {
  Timestamp t;
  t.epoch = epoch;
  ret t.format_local(buf, buf_len, format);
}

// Format an epoch value with a custom format (Result).
pub fun try_format_local(num epoch, str buf, num buf_len, str format) Result<num> {
  num n = format_local(epoch, buf, buf_len, format);
  if n <= 0 {
    ret err(1, "format_local failed", 0);
  }
  ret ok(n);
}

// Format an epoch value with a custom format (UTC).
// 
// Params:
// - epoch: seconds since epoch
// - buf: output buffer
// - buf_len: buffer capacity
// - format: strftime format
// 
// Returns:
// - number of bytes written
pub fun format_utc(num epoch, str buf, num buf_len, str format) num {
  Timestamp t;
  t.epoch = epoch;
  ret t.format_utc(buf, buf_len, format);
}

// Format an epoch value with a custom format (UTC) with Result.
pub fun try_format_utc(num epoch, str buf, num buf_len, str format) Result<num> {
  num n = format_utc(epoch, buf, buf_len, format);
  if n <= 0 {
    ret err(1, "format_utc failed", 0);
  }
  ret ok(n);
}

// Format an epoch value using C's human-readable format (ctime).
// 
// Params:
// - epoch: seconds since epoch
// - buf: output buffer
// - buf_len: buffer capacity
// 
// Returns:
// - number of bytes written
pub fun format_human(num epoch, str buf, num buf_len) num {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret 0;
  }
  str cstr = ctime(tbuf);
  num n = 0;
  if cstr != nil {
    n = _copy_str(buf, buf_len, cstr);
  }
  free(tbuf);
  ret n;
}

// Format an epoch value using C's human-readable format (ctime) as a C string.
// 
// Params:
// - epoch: seconds since epoch
// 
// Returns:
// - pointer to static C string (or null)
pub fun format_human_cstr(num epoch) str {
  raw* tbuf = _time_buf_from_epoch(epoch);
  if tbuf == nil {
    ret nil;
  }
  str cstr = ctime(tbuf);
  free(tbuf);
  ret cstr;
}

// Format current time with default format.
// 
// Params:
// - buf: output buffer
// - buf_len: buffer capacity
// 
// Returns:
// - number of bytes written
pub fun now_string(str buf, num buf_len) num {
  Timestamp t = now();
  num n = t.to_string(buf, buf_len);
  if n > 0 {
    ret n;
  }
  ret snprintf(buf, buf_len, "%d", t.epoch);
}

// Format current time with default format (Result).
pub fun try_now_string(str buf, num buf_len) Result<num> {
  num n = now_string(buf, buf_len);
  if n <= 0 {
    ret err(1, "now_string failed", 0);
  }
  ret ok(n);
}

// Format current time with default format (UTC).
// 
// Params:
// - buf: output buffer
// - buf_len: buffer capacity
// 
// Returns:
// - number of bytes written
pub fun now_string_utc(str buf, num buf_len) num {
  Timestamp t = now();
  num n = t.to_string_utc(buf, buf_len);
  if n > 0 {
    ret n;
  }
  ret snprintf(buf, buf_len, "%d", t.epoch);
}

// Format current time with default format (UTC) with Result.
pub fun try_now_string_utc(str buf, num buf_len) Result<num> {
  num n = now_string_utc(buf, buf_len);
  if n <= 0 {
    ret err(1, "now_string_utc failed", 0);
  }
  ret ok(n);
}

// Format current time using C's human-readable format (ctime).
// 
// Params:
// - buf: output buffer
// - buf_len: buffer capacity
// 
// Returns:
// - number of bytes written
pub fun now_human(str buf, num buf_len) num {
  Timestamp t = now();
  ret format_human(t.epoch, buf, buf_len);
}

// Return a human-readable string for the current time (ctime).
// 
// Returns:
// - pointer to static C string (or null)
pub fun now_human_cstr() str {
  Timestamp t = now();
  ret format_human_cstr(t.epoch);
}
