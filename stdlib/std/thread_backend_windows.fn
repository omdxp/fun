// Windows thread backend implementation.
// 
// Notes:
// - This module defines the Windows backend contract used by std.thread_runtime.
// - It talks directly to pthread-shaped primitives from std.c.thread_windows.
// - Return codes follow the Windows compatibility backend.

imp std.c.thread_windows;
imp std.thread;

// Legacy compatibility function kept for API stability.
pub fun thread_backend_windows_unavailable() num {
  ret 0;
}

// Create a new Windows backend thread handle.
pub fun thread_backend_windows_new() Thread {
  Thread t;
  t.started = false;
  ret t;
}

// Start a Windows backend thread handle.
// 
// Returns:
// - 0 on success
// - 0 when already started (no-op)
// - -1 when thread is null
// - -2 when entry is null
// - nonzero backend error code on failure
pub fun thread_backend_windows_start(Thread* thread, raw* entry, raw* arg) num {
  if thread == nil {
    ret -1;
  }
  if entry == nil {
    ret -2;
  }

  let t = thread[0];
  if t.started == true {
    ret 0;
  }

  let rc = pthread_create(&t.handle, nil, entry, arg);
  if rc == 0 {
    t.started = true;
  }
  thread[0] = t;
  ret rc;
}

// Join a Windows backend thread handle.
// 
// Returns:
// - 0 on success
// - 0 when not started (no-op)
// - -1 when thread is null
// - nonzero backend error code on failure
pub fun thread_backend_windows_join(Thread* thread, raw* out_ret) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  if t.started == false {
    ret 0;
  }

  let rc = pthread_join(t.handle, out_ret);
  if rc == 0 {
    t.started = false;
  }
  thread[0] = t;
  ret rc;
}

// Detach a Windows backend thread handle.
// 
// Returns:
// - 0 on success
// - 0 when not started (no-op)
// - -1 when thread is null
// - nonzero backend error code on failure
pub fun thread_backend_windows_detach(Thread* thread) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  if t.started == false {
    ret 0;
  }

  let rc = pthread_detach(t.handle);
  if rc == 0 {
    t.started = false;
  }
  thread[0] = t;
  ret rc;
}
