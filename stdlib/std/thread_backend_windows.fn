// Windows thread backend implementation.
// 
// Defines the Windows backend contract used by std.thread_runtime. Talks
// directly to pthread-shaped primitives from std.c.thread_windows. Unless
// noted otherwise, these return 0 on success (including as a no-op when
// already in the target state) and a nonzero backend error code on failure.

imp std.c.thread_windows;
imp std.thread;

// Always returns 0; kept for API stability across backend implementations.
pub fun thread_backend_windows_unavailable() num {
  ret 0;
}

// Creates a new Windows backend thread handle.
pub fun thread_backend_windows_new() Thread {
  Thread t;
  t.started = false;
  ret t;
}

// Starts a Windows backend thread handle. Returns -1 when `thread` is null,
// -2 when `entry` is null.
pub fun thread_backend_windows_start(Thread* thread, raw* entry, raw* arg) num {
  if thread == nil {
    ret -1;
  }
  if entry == nil {
    ret -2;
  }

  let t = thread[0];
  if t.started == true {
    ret 0;
  }

  let rc = pthread_create(&t.handle, nil, entry, arg);
  if rc == 0 {
    t.started = true;
  }
  thread[0] = t;
  ret rc;
}

// Joins a Windows backend thread handle. Returns -1 when `thread` is null.
pub fun thread_backend_windows_join(Thread* thread, raw* out_ret) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  if t.started == false {
    ret 0;
  }

  let rc = pthread_join(t.handle, out_ret);
  if rc == 0 {
    t.started = false;
  }
  thread[0] = t;
  ret rc;
}

// Detaches a Windows backend thread handle. Returns -1 when `thread` is null.
pub fun thread_backend_windows_detach(Thread* thread) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  if t.started == false {
    ret 0;
  }

  let rc = pthread_detach(t.handle);
  if rc == 0 {
    t.started = false;
  }
  thread[0] = t;
  ret rc;
}
