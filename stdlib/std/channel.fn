// Blocking bounded channels built on std.sync.
// 
// This module provides a minimal channel primitive suitable as a runtime
// building block for higher-level concurrency features.
// 
// Notes:
// - Synchronization is dispatched through std.sync_runtime backends.
// - Async wrappers are await-friendly APIs over the same blocking semantics.

imp std.sync;
imp std.sync_runtime;
imp std.c.mem;
imp std.c.string;
imp std.c.time;

// Bounded blocking channel implemented as a ring buffer.
pub compound Channel<T> {
  // Channel mutex.
  Mutex mu;
  // Signaled when buffer transitions from full to not-full.
  CondVar can_send;
  // Signaled when buffer transitions from empty to not-empty.
  CondVar can_recv;

  // Ring buffer storage.
  T[] data;
  // True when ring storage is allocated.
  bin has_buffer;
  // Buffer capacity.
  num cap;
  // Read cursor.
  num head;
  // Write cursor.
  num tail;
  // Number of queued values.
  num count;

  // True once close() is called.
  bin closed;

  // Per-channel select wait slice in milliseconds.
  num select_wait_slice_ms;
  // Per-channel adaptive select backoff steps (0 disables backoff).
  num select_wait_backoff_steps;
}

// Create a single-slot channel.
// 
// Params:
// - default_value: initial value used to initialize storage
// 
// Returns:
// - initialized channel
pub fun channel_new<T>(T default_value) Channel<T> {
  Channel<T> ch;
  ch.mu = runtime_mutex_new();
  ch.can_send = runtime_condvar_new();
  ch.can_recv = runtime_condvar_new();

  // Eagerly initialize synchronization primitives before sharing the channel.
  // This avoids racy first-use init under heavy multi-thread contention.
  _ = runtime_mutex_init(&ch.mu);
  _ = runtime_condvar_init(&ch.can_send);
  _ = runtime_condvar_init(&ch.can_recv);

  ch.cap = 1;
  ch.has_buffer = false;
  ch.head = 0;
  ch.tail = 0;
  ch.count = 0;
  ch.closed = false;
  ch.select_wait_slice_ms = 5;
  ch.select_wait_backoff_steps = 3;

  raw* data_ptr = malloc(sizeof(T));
  ch.data = data_ptr;
  if data_ptr != nil {
    ch.has_buffer = true;
    ch.data[0] = default_value;
  }

  ret ch;
}

// Create a bounded channel with explicit capacity.
// 
// Params:
// - default_value: initial value used to initialize storage
// - capacity: requested channel capacity (values <= 0 become 1)
// 
// Returns:
// - initialized channel
pub fun channel_new_cap<T>(T default_value, num capacity) Channel<T> {
  if capacity <= 0 {
    capacity = 1;
  }

  Channel<T> ch;
  ch.mu = runtime_mutex_new();
  ch.can_send = runtime_condvar_new();
  ch.can_recv = runtime_condvar_new();

  // Eagerly initialize synchronization primitives before sharing the channel.
  // This avoids racy first-use init under heavy multi-thread contention.
  _ = runtime_mutex_init(&ch.mu);
  _ = runtime_condvar_init(&ch.can_send);
  _ = runtime_condvar_init(&ch.can_recv);

  ch.cap = capacity;
  ch.has_buffer = false;
  ch.head = 0;
  ch.tail = 0;
  ch.count = 0;
  ch.closed = false;
  ch.select_wait_slice_ms = 5;
  ch.select_wait_backoff_steps = 3;

  raw* data_ptr = malloc(sizeof(T) * capacity);
  ch.data = data_ptr;
  if data_ptr != nil {
    ch.has_buffer = true;
    num i = 0;
    for i < capacity {
      ch.data[i] = default_value;
      i = i + 1;
    }
  }

  ret ch;
}

// Absolute timeout payload used with pthread timed waits.
compound ChannelAbsTime {
  num tv_sec;
  num tv_nsec;
}

// Normalize absolute time values so tv_nsec always stays in [0, 1e9).
fun channel_normalize_abs_time(ChannelAbsTime* ts) {
  if ts == nil {
    ret;
  }

  if ts.tv_nsec <= -1000000000 || ts.tv_nsec >= 1000000000 {
    ts.tv_sec = ts.tv_sec + (ts.tv_nsec / 1000000000);
    ts.tv_nsec = ts.tv_nsec % 1000000000;
  }

  if ts.tv_nsec < 0 {
    ts.tv_sec = ts.tv_sec - 1;
    ts.tv_nsec = ts.tv_nsec + 1000000000;
  }
}

// Build an absolute timeout from a millisecond duration.
// 
// Note:
// - Uses `clock_gettime` and keeps millisecond-scale precision.
fun channel_make_abs_time(num timeout_ms, ChannelAbsTime* out) num {
  if out == nil {
    ret channel_rc_null_arg();
  }
  if timeout_ms < 0 {
    timeout_ms = 0;
  }

  // Zero fields before clock_gettime so any partial writes (e.g. 32-bit tv_nsec on Windows)
  // cannot leave stale high bits that would corrupt normalization/deadline math.
  out.tv_sec = 0;
  out.tv_nsec = 0;
  raw* out_raw = out;
  let rc = clock_gettime(0, out_raw);
  if rc != 0 {
    ret channel_rc_clock_failed();
  }

  channel_normalize_abs_time(out);

  let add_sec = timeout_ms / 1000;
  let add_nsec = (timeout_ms % 1000) * 1000000;

  out.tv_sec = out.tv_sec + add_sec;
  out.tv_nsec = out.tv_nsec + add_nsec;
  channel_normalize_abs_time(out);

  ret channel_rc_ok();
}

// Returns true when the absolute timeout is reached.
fun channel_deadline_reached(ChannelAbsTime* abs_time) bin {
  if abs_time == nil {
    ret true;
  }

  ChannelAbsTime target;
  target.tv_sec = abs_time.tv_sec;
  target.tv_nsec = abs_time.tv_nsec;
  channel_normalize_abs_time(&target);

  ChannelAbsTime now;
  now.tv_sec = 0;
  now.tv_nsec = 0;
  raw* now_raw = &now;
  let rc = clock_gettime(0, now_raw);
  if rc != 0 {
    ret true;
  }
  channel_normalize_abs_time(&now);

  if now.tv_sec > target.tv_sec {
    ret true;
  }
  if now.tv_sec == target.tv_sec && now.tv_nsec >= target.tv_nsec {
    ret true;
  }
  ret false;
}

// Clamp configurable select wait slice to a sane positive value.
fun channel_sanitize_wait_slice_ms(num wait_slice_ms) num {
  if wait_slice_ms <= 0 {
    ret 1;
  }
  ret wait_slice_ms;
}

// Clamp adaptive select backoff steps to a sane nonnegative range.
fun channel_sanitize_backoff_steps(num backoff_steps) num {
  if backoff_steps < 0 {
    ret 0;
  }
  if backoff_steps > 8 {
    ret 8;
  }
  ret backoff_steps;
}

// Remaining time (ms) until absolute deadline.
// 
// Returns:
// - remaining milliseconds rounded up
// - 0 when already expired or on clock failure
fun channel_deadline_remaining_ms(ChannelAbsTime* abs_time) num {
  if abs_time == nil {
    ret 0;
  }

  ChannelAbsTime target;
  target.tv_sec = abs_time.tv_sec;
  target.tv_nsec = abs_time.tv_nsec;
  channel_normalize_abs_time(&target);

  ChannelAbsTime now;
  now.tv_sec = 0;
  now.tv_nsec = 0;
  raw* now_raw = &now;
  let rc = clock_gettime(0, now_raw);
  if rc != 0 {
    ret 0;
  }
  channel_normalize_abs_time(&now);

  let sec_diff = target.tv_sec - now.tv_sec;
  let nsec_diff = target.tv_nsec - now.tv_nsec;
  if nsec_diff < 0 {
    sec_diff = sec_diff - 1;
    nsec_diff = nsec_diff + 1000000000;
  }

  if sec_diff < 0 {
    ret 0;
  }

  let out_ms = sec_diff * 1000 + (nsec_diff / 1000000);
  if nsec_diff % 1000000 != 0 {
    out_ms = out_ms + 1;
  }
  ret out_ms;
}

// Compute per-round select wait duration with bounded adaptive backoff.
// 
// Strategy:
// - Start from base_wait_slice_ms.
// - Back off exponentially with idle rounds.
// - Clamp to rem_ms when rem_ms >= 0.
fun channel_compute_wait_slice_ms(
  num base_wait_slice_ms,
  num rem_ms,
  num idle_rounds,
  num max_backoff_steps
) num {
  let wait_ms = channel_sanitize_wait_slice_ms(base_wait_slice_ms);
  max_backoff_steps = channel_sanitize_backoff_steps(max_backoff_steps);

  if idle_rounds < 0 {
    idle_rounds = 0;
  }

  let backoff_steps = idle_rounds;
  if backoff_steps > max_backoff_steps {
    backoff_steps = max_backoff_steps;
  }

  num i = 0;
  for i < backoff_steps {
    wait_ms = wait_ms * 2;
    i = i + 1;
  }

  if rem_ms >= 0 && wait_ms > rem_ms {
    wait_ms = rem_ms;
  }
  if wait_ms <= 0 {
    ret 1;
  }
  ret wait_ms;
}

// Returns true when an optional cancellation flag is set.
// 
// Convention:
// - nil flag pointer means cancellation is disabled.
// - nonzero flag value means cancelled.
fun channel_is_cancelled(num* cancel_flag) bin {
  if cancel_flag == nil {
    ret false;
  }
  ret cancel_flag[0] != 0;
}

// Dedicated cancellation token for channel APIs.
pub compound ChannelCancelToken {
  // Cancellation flag (0 = active, nonzero = cancelled).
  num flag;
}

// Create a non-cancelled channel token.
pub fun channel_cancel_token_new() ChannelCancelToken {
  ChannelCancelToken token;
  token.flag = 0;
  ret token;
}

// Create an already-cancelled channel token.
pub fun channel_cancel_token_cancelled() ChannelCancelToken {
  ChannelCancelToken token;
  token.flag = 1;
  ret token;
}

// Set cancellation state to cancelled.
pub fun channel_cancel_token_cancel(ChannelCancelToken* token) num {
  if token == nil {
    ret channel_rc_null_arg();
  }
  token.flag = 1;
  ret channel_rc_ok();
}

// Set cancellation state to not-cancelled.
pub fun channel_cancel_token_reset(ChannelCancelToken* token) num {
  if token == nil {
    ret channel_rc_null_arg();
  }
  token.flag = 0;
  ret channel_rc_ok();
}

// Read cancellation state.
pub fun channel_cancel_token_is_cancelled(ChannelCancelToken* token) bin {
  if token == nil {
    ret false;
  }
  ret token.flag != 0;
}

// Convert optional token pointer into optional raw cancellation flag pointer.
fun channel_cancel_token_flag_ptr(ChannelCancelToken* token) num* {
  if token == nil {
    ret nil;
  }
  ret &token.flag;
}

// Shared channel return codes exposed as helpers.
// 
// Note:
// - Some APIs intentionally alias meanings to the same numeric code.
pub fun channel_rc_ok() num {
  ret 0;
}

pub fun channel_rc_closed() num {
  ret 1;
}

pub fun channel_rc_timeout() num {
  ret 2;
}

pub fun channel_rc_full() num {
  ret 2;
}

pub fun channel_rc_empty() num {
  ret 2;
}

pub fun channel_rc_default() num {
  ret 3;
}

pub fun channel_rc_cancelled() num {
  ret 3;
}

pub fun channel_rc_null_arg() num {
  ret -1;
}

pub fun channel_rc_send_closed_blocking() num {
  ret -1;
}

pub fun channel_rc_alloc_failed() num {
  ret -2;
}

pub fun channel_rc_clock_failed() num {
  ret -3;
}

// Select index helpers for readability.
pub fun channel_select_index_default() num {
  ret -1;
}

pub fun channel_select_index_self() num {
  ret 0;
}

pub fun channel_select_index_other() num {
  ret 1;
}

pub fun channel_select_index_other_b() num {
  ret 2;
}

// The outcome of a receive, as a value you can `fit` on instead of decoding a raw
// status code. This is the ergonomic layer over the `recv_*_into` core (which returns
// a `channel_rc_*` code + writes the value through an out-pointer): each distinct
// outcome the status codes encode becomes its own variant.
pub enum RecvResult<T> {
  // A value was received.
  Ok(T),
  // The channel was closed and drained — no more values will ever arrive.
  Closed,
  // The receive timed out while the channel was still empty.
  Timeout,
  // The receive was cancelled via a cancel flag/token.
  Cancelled,
  // A lower-level failure (the underlying channel_rc_* / pthread error code).
  Error(num),
}

// The outcome of a send, as a value you can `fit` on. The ergonomic layer over the
// `send*` core (which returns a `channel_rc_*` code). Send carries no value back, so
// this is a plain (non-generic) enum.
pub enum SendResult {
  // The value was enqueued.
  Ok,
  // The channel was closed, so the value could not be sent.
  Closed,
  // The channel was full and the (timed/non-blocking) send gave up without enqueuing.
  Full,
  // The send was cancelled via a cancel flag/token.
  Cancelled,
  // A lower-level failure (the underlying channel_rc_* / pthread error code).
  Error(num),
}

impl Channel<T> {
  // Return a zeroed value for T.
  zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Map a recv status code + received value into a RecvResult<T>. (A method rather
  // than a free function so it monomorphizes with this channel's concrete T.)
  // Codes 2/3 mean timeout/cancelled in a recv context.
  result_from_rc(num rc, T value) RecvResult<T> {
    if rc == channel_rc_ok() {
      ret .Ok(value);
    }
    if rc == channel_rc_closed() {
      ret .Closed;
    }
    if rc == channel_rc_timeout() {
      ret .Timeout;
    }
    if rc == channel_rc_cancelled() {
      ret .Cancelled;
    }
    ret .Error(rc);
  }

  // Map a send status code into a SendResult. Codes 2/3 mean full/cancelled in a send
  // context (full and timeout share code 2; in a send the meaning is "couldn't enqueue").
  send_result_from_rc(num rc) SendResult {
    if rc == channel_rc_ok() {
      ret .Ok;
    }
    if rc == channel_rc_closed() {
      ret .Closed;
    }
    if rc == channel_rc_send_closed_blocking() {
      ret .Closed;
    }
    if rc == channel_rc_full() {
      ret .Full;
    }
    if rc == channel_rc_cancelled() {
      ret .Cancelled;
    }
    ret .Error(rc);
  }

  // Initialize internal synchronization primitives.
  // 
  // Returns:
  // - 0 on success, nonzero error code on failure
  pub init() num {
    if self.has_buffer == false {
      ret channel_rc_alloc_failed();
    }

    if self.mu.initialized == true && self.can_send.initialized == true && self.can_recv.initialized == true {
      self.select_wait_slice_ms = channel_sanitize_wait_slice_ms(self.select_wait_slice_ms);
      self.select_wait_backoff_steps = channel_sanitize_backoff_steps(self.select_wait_backoff_steps);
      ret channel_rc_ok();
    }

    let rc = runtime_mutex_init(&self.mu);
    if rc != 0 {
      ret rc;
    }
    rc = runtime_condvar_init(&self.can_send);
    if rc != 0 {
      ret rc;
    }
    rc = runtime_condvar_init(&self.can_recv);
    if rc != 0 {
      ret rc;
    }
    self.select_wait_slice_ms = channel_sanitize_wait_slice_ms(self.select_wait_slice_ms);
    self.select_wait_backoff_steps = channel_sanitize_backoff_steps(self.select_wait_backoff_steps);
    ret channel_rc_ok();
  }

  // Configure the per-channel select wait slice (in milliseconds).
  pub set_select_wait_slice_ms(num wait_slice_ms) {
    self.select_wait_slice_ms = channel_sanitize_wait_slice_ms(wait_slice_ms);
  }

  // Read the per-channel select wait slice (in milliseconds).
  pub get_select_wait_slice_ms() num {
    ret self.select_wait_slice_ms;
  }

  // Configure max adaptive select backoff steps (0 disables backoff).
  pub set_select_wait_backoff_steps(num backoff_steps) {
    self.select_wait_backoff_steps = channel_sanitize_backoff_steps(backoff_steps);
  }

  // Read max adaptive select backoff steps.
  pub get_select_wait_backoff_steps() num {
    ret self.select_wait_backoff_steps;
  }

  // Send one value, blocking while the slot is full.
  // 
  // Returns:
  // - 0 on success
  // - -1 when channel is closed
  // - nonzero pthread error codes on synchronization failures
  pub send(T value) num {
    let rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = runtime_mutex_lock(&self.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&self.mu);

    for self.count == self.cap && self.closed == false {
      rc = runtime_condvar_wait(&self.can_send, &self.mu);
      if rc != 0 {
        ret rc;
      }
    }

    if self.closed == true {
      ret channel_rc_send_closed_blocking();
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = runtime_condvar_signal(&self.can_recv);
    ret channel_rc_ok();
  }

  // Send one value, blocking up to timeout_ms while full.
  // 
  // Params:
  // - value: value to send
  // - timeout_ms: max wait in milliseconds
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 2 on timeout while still full
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub send_timeout(T value, num timeout_ms) num {
    ret self.send_timeout_with_cancel(value, timeout_ms, nil);
  }

  // Send one value, blocking up to timeout_ms while full, with optional cancellation.
  // 
  // Params:
  // - value: value to send
  // - timeout_ms: max wait in milliseconds (negative means wait forever)
  // - cancel_flag: optional pointer to cancellation flag (nonzero => cancelled)
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 2 on timeout while still full
  // - 3 when cancelled
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub send_timeout_with_cancel(T value, num timeout_ms, num* cancel_flag) num {
    let rc = self.init();
    if rc != 0 {
      ret rc;
    }

    let wait_forever = timeout_ms < 0;
    let base_wait_slice_ms = channel_sanitize_wait_slice_ms(self.select_wait_slice_ms);
    let max_backoff_steps = channel_sanitize_backoff_steps(self.select_wait_backoff_steps);
    num idle_rounds = 0;

    rc = runtime_mutex_lock(&self.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&self.mu);

    if self.closed == true {
      ret channel_rc_closed();
    }

    ChannelAbsTime abs_time;
    if wait_forever == false {
      if timeout_ms < 0 {
        timeout_ms = 0;
      }
      rc = channel_make_abs_time(timeout_ms, &abs_time);
      if rc != 0 {
        ret rc;
      }
    }

    for self.count == self.cap && self.closed == false {
      if channel_is_cancelled(cancel_flag) == true {
        ret channel_rc_cancelled();
      }

      num rem_ms = -1;
      if wait_forever == false {
        rem_ms = channel_deadline_remaining_ms(&abs_time);
        if rem_ms <= 0 {
          ret channel_rc_timeout();
        }
      }

      let wait_now_ms = channel_compute_wait_slice_ms(
        base_wait_slice_ms,
        rem_ms,
        idle_rounds,
        max_backoff_steps
      );
      ChannelAbsTime round_abs;
      rc = channel_make_abs_time(wait_now_ms, &round_abs);
      if rc != 0 {
        ret rc;
      }

      rc = runtime_condvar_timed_wait(&self.can_send, &self.mu, &round_abs);
      if rc != 0 {
        if self.count < self.cap || self.closed == true {
          idle_rounds = 0;
          break;
        }

        if channel_deadline_reached(&round_abs) == true {
          if wait_forever == false && channel_deadline_reached(&abs_time) == true {
            ret channel_rc_timeout();
          }

          if idle_rounds < max_backoff_steps {
            idle_rounds = idle_rounds + 1;
          }
          continue;
        }

        if wait_forever == false && channel_deadline_reached(&abs_time) == true {
          ret channel_rc_timeout();
        }

        ret rc;
      }

      idle_rounds = 0;
    }

    if channel_is_cancelled(cancel_flag) == true {
      ret channel_rc_cancelled();
    }

    if self.closed == true {
      ret channel_rc_closed();
    }
    if self.count == self.cap {
      ret channel_rc_timeout();
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = runtime_condvar_signal(&self.can_recv);
    ret channel_rc_ok();
  }

  // Send one value, waiting forever while full, with optional cancellation.
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 3 when cancelled
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub send_with_cancel(T value, num* cancel_flag) num {
    ret self.send_timeout_with_cancel(value, -1, cancel_flag);
  }

  // Send one value, blocking up to timeout_ms while full, with optional token cancellation.
  // 
  // Returns:
  // - same return codes as send_timeout_with_cancel
  pub send_timeout_with_token(T value, num timeout_ms, ChannelCancelToken* cancel_token) num {
    ret self.send_timeout_with_cancel(
      value,
      timeout_ms,
      channel_cancel_token_flag_ptr(cancel_token)
    );
  }

  // Send one value, waiting forever while full, with optional token cancellation.
  // 
  // Returns:
  // - same return codes as send_with_cancel
  pub send_with_token(T value, ChannelCancelToken* cancel_token) num {
    ret self.send_with_cancel(value, channel_cancel_token_flag_ptr(cancel_token));
  }

  // Await-friendly wrapper for send.
  // 
  // Note:
  // - This remains a blocking channel send under the hood.
  pub async send_async(T value) num {
    ret self.send(value);
  }

  // Await-friendly wrapper for send_timeout.
  pub async send_timeout_async(T value, num timeout_ms) num {
    ret self.send_timeout(value, timeout_ms);
  }

  // Await-friendly wrapper for send_with_token.
  pub async send_with_token_async(T value, ChannelCancelToken* cancel_token) num {
    ret self.send_with_token(value, cancel_token);
  }

  // Await-friendly wrapper for send_timeout_with_token.
  pub async send_timeout_with_token_async(T value, num timeout_ms, ChannelCancelToken* cancel_token) num {
    ret self.send_timeout_with_token(value, timeout_ms, cancel_token);
  }

  // Try sending one value without blocking.
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 2 when channel is full
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub try_send(T value) num {
    let rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = runtime_mutex_lock(&self.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&self.mu);

    if self.closed == true {
      ret channel_rc_closed();
    }
    if self.count == self.cap {
      ret channel_rc_full();
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = runtime_condvar_signal(&self.can_recv);
    ret channel_rc_ok();
  }

  // Receive one value into out, blocking while empty.
  // 
  // Params:
  // - out: destination pointer
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and no value is available
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_into(T* out) num {
    if out == nil {
      ret channel_rc_null_arg();
    }

    let rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = runtime_mutex_lock(&self.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&self.mu);

    for self.count == 0 && self.closed == false {
      rc = runtime_condvar_wait(&self.can_recv, &self.mu);
      if rc != 0 {
        ret rc;
      }
    }

    if self.count == 0 {
      ret channel_rc_closed();
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = runtime_condvar_signal(&self.can_send);
    ret channel_rc_ok();
  }

  // Receive one value into out, blocking up to timeout_ms while empty.
  // 
  // Params:
  // - out: destination pointer
  // - timeout_ms: max wait in milliseconds
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and empty
  // - 2 on timeout while still empty
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_timeout_into(T* out, num timeout_ms) num {
    ret self.recv_timeout_into_with_cancel(out, timeout_ms, nil);
  }

  // Receive one value into out, blocking up to timeout_ms while empty,
  // with optional cancellation.
  // 
  // Params:
  // - out: destination pointer
  // - timeout_ms: max wait in milliseconds (negative means wait forever)
  // - cancel_flag: optional pointer to cancellation flag (nonzero => cancelled)
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and empty
  // - 2 on timeout while still empty
  // - 3 when cancelled
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_timeout_into_with_cancel(T* out, num timeout_ms, num* cancel_flag) num {
    if out == nil {
      ret channel_rc_null_arg();
    }

    let rc = self.init();
    if rc != 0 {
      ret rc;
    }

    let wait_forever = timeout_ms < 0;
    let base_wait_slice_ms = channel_sanitize_wait_slice_ms(self.select_wait_slice_ms);
    let max_backoff_steps = channel_sanitize_backoff_steps(self.select_wait_backoff_steps);
    num idle_rounds = 0;

    rc = runtime_mutex_lock(&self.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&self.mu);

    ChannelAbsTime abs_time;
    if wait_forever == false {
      if timeout_ms < 0 {
        timeout_ms = 0;
      }
      rc = channel_make_abs_time(timeout_ms, &abs_time);
      if rc != 0 {
        ret rc;
      }
    }

    for self.count == 0 && self.closed == false {
      if channel_is_cancelled(cancel_flag) == true {
        ret channel_rc_cancelled();
      }

      num rem_ms = -1;
      if wait_forever == false {
        rem_ms = channel_deadline_remaining_ms(&abs_time);
        if rem_ms <= 0 {
          ret channel_rc_timeout();
        }
      }

      let wait_now_ms = channel_compute_wait_slice_ms(
        base_wait_slice_ms,
        rem_ms,
        idle_rounds,
        max_backoff_steps
      );
      ChannelAbsTime round_abs;
      rc = channel_make_abs_time(wait_now_ms, &round_abs);
      if rc != 0 {
        ret rc;
      }

      rc = runtime_condvar_timed_wait(&self.can_recv, &self.mu, &round_abs);
      if rc != 0 {
        if self.count > 0 || self.closed == true {
          idle_rounds = 0;
          break;
        }

        if channel_deadline_reached(&round_abs) == true {
          if wait_forever == false && channel_deadline_reached(&abs_time) == true {
            ret channel_rc_timeout();
          }

          if idle_rounds < max_backoff_steps {
            idle_rounds = idle_rounds + 1;
          }
          continue;
        }

        if wait_forever == false && channel_deadline_reached(&abs_time) == true {
          ret channel_rc_timeout();
        }

        ret rc;
      }

      idle_rounds = 0;
    }

    if channel_is_cancelled(cancel_flag) == true {
      ret channel_rc_cancelled();
    }

    if self.count == 0 {
      if self.closed == true {
        ret channel_rc_closed();
      }
      ret channel_rc_timeout();
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = runtime_condvar_signal(&self.can_send);
    ret channel_rc_ok();
  }

  // Receive one value, blocking while empty.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when channel is closed and empty or on sync failure
  pub recv() T {
    let out = self.zero_value();
    let rc = self.recv_into(&out);
    if rc != 0 {
      ret self.zero_value();
    }
    ret out;
  }

  // Receive one value into out, waiting forever while empty, with optional cancellation.
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and empty
  // - 3 when cancelled
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_into_with_cancel(T* out, num* cancel_flag) num {
    ret self.recv_timeout_into_with_cancel(out, -1, cancel_flag);
  }

  // Receive one value into out, blocking up to timeout_ms while empty,
  // with optional token cancellation.
  // 
  // Returns:
  // - same return codes as recv_timeout_into_with_cancel
  pub recv_timeout_into_with_token(T* out, num timeout_ms, ChannelCancelToken* cancel_token) num {
    ret self.recv_timeout_into_with_cancel(
      out,
      timeout_ms,
      channel_cancel_token_flag_ptr(cancel_token)
    );
  }

  // Receive one value into out, waiting forever while empty,
  // with optional token cancellation.
  // 
  // Returns:
  // - same return codes as recv_into_with_cancel
  pub recv_into_with_token(T* out, ChannelCancelToken* cancel_token) num {
    ret self.recv_into_with_cancel(out, channel_cancel_token_flag_ptr(cancel_token));
  }

  // Receive one value, blocking up to timeout_ms while empty.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when timeout/closed empty/sync error occurs
  pub recv_timeout(num timeout_ms) T {
    let out = self.zero_value();
    let rc = self.recv_timeout_into(&out, timeout_ms);
    if rc != 0 {
      ret self.zero_value();
    }
    ret out;
  }

  // Receive one value, blocking up to timeout_ms while empty, with optional cancellation.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when timeout/closed empty/cancelled/sync error occurs
  pub recv_timeout_with_cancel(num timeout_ms, num* cancel_flag) T {
    let out = self.zero_value();
    let rc = self.recv_timeout_into_with_cancel(&out, timeout_ms, cancel_flag);
    if rc != 0 {
      ret self.zero_value();
    }
    ret out;
  }

  // Receive one value, waiting forever while empty, with optional cancellation.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when closed/cancelled/sync error occurs
  pub recv_with_cancel(num* cancel_flag) T {
    ret self.recv_timeout_with_cancel(-1, cancel_flag);
  }

  // Receive one value, blocking up to timeout_ms while empty,
  // with optional token cancellation.
  // 
  // Returns:
  // - same return behavior as recv_timeout_with_cancel
  pub recv_timeout_with_token(num timeout_ms, ChannelCancelToken* cancel_token) T {
    ret self.recv_timeout_with_cancel(timeout_ms, channel_cancel_token_flag_ptr(cancel_token));
  }

  // Receive one value, waiting forever while empty,
  // with optional token cancellation.
  // 
  // Returns:
  // - same return behavior as recv_with_cancel
  pub recv_with_token(ChannelCancelToken* cancel_token) T {
    ret self.recv_with_cancel(channel_cancel_token_flag_ptr(cancel_token));
  }

  // Await-friendly wrapper for recv.
  // 
  // Note:
  // - This remains a blocking channel receive under the hood.
  pub async recv_async() T {
    ret self.recv();
  }

  // Await-friendly wrapper for recv_timeout.
  pub async recv_timeout_async(num timeout_ms) T {
    ret self.recv_timeout(timeout_ms);
  }

  // Await-friendly wrapper for recv_into.
  pub async recv_into_async(T* out) num {
    ret self.recv_into(out);
  }

  // Await-friendly wrapper for recv_timeout_into.
  pub async recv_timeout_into_async(T* out, num timeout_ms) num {
    ret self.recv_timeout_into(out, timeout_ms);
  }

  // Await-friendly wrapper for recv_timeout_into_with_token.
  pub async recv_timeout_into_with_token_async(
    T* out,
    num timeout_ms,
    ChannelCancelToken* cancel_token
  ) num {
    ret self.recv_timeout_into_with_token(out, timeout_ms, cancel_token);
  }

  // Await-friendly wrapper for recv_with_token.
  pub async recv_with_token_async(ChannelCancelToken* cancel_token) T {
    ret self.recv_with_token(cancel_token);
  }

  // Await-friendly wrapper for recv_timeout_with_token.
  pub async recv_timeout_with_token_async(num timeout_ms, ChannelCancelToken* cancel_token) T {
    ret self.recv_timeout_with_token(timeout_ms, cancel_token);
  }

  // Receive one value as a RecvResult you can `fit` on. Blocks while empty; resolves
  // to Ok(value)/Closed/Error — never Timeout (no deadline) or Cancelled (no token).
  // 
  // Returns:
  // - RecvResult.Ok(value) on success; Closed when drained+closed; Error(rc) otherwise
  pub recv_result() RecvResult<T> {
    let out = self.zero_value();
    let rc = self.recv_into(&out);
    ret self.result_from_rc(rc, out);
  }

  // Receive within `timeout_ms` as a RecvResult. Resolves to Ok/Closed/Timeout/Error.
  // A negative timeout waits forever (never Timeout).
  pub recv_result_timeout(num timeout_ms) RecvResult<T> {
    let out = self.zero_value();
    let rc = self.recv_timeout_into(&out, timeout_ms);
    ret self.result_from_rc(rc, out);
  }

  // Receive within `timeout_ms` with token cancellation, as a RecvResult. Resolves to
  // Ok/Closed/Timeout/Cancelled/Error.
  pub recv_result_timeout_with_token(num timeout_ms, ChannelCancelToken* cancel_token) RecvResult<T> {
    let out = self.zero_value();
    let rc = self.recv_timeout_into_with_token(&out, timeout_ms, cancel_token);
    ret self.result_from_rc(rc, out);
  }

  // Receive forever-or-until-cancelled with a token, as a RecvResult. Resolves to
  // Ok/Closed/Cancelled/Error (never Timeout).
  pub recv_result_with_token(ChannelCancelToken* cancel_token) RecvResult<T> {
    let out = self.zero_value();
    let rc = self.recv_into_with_token(&out, cancel_token);
    ret self.result_from_rc(rc, out);
  }

  // Try to receive without blocking, as a RecvResult. Resolves to Ok when a value is
  // ready, Closed when drained+closed, Timeout when open-but-empty, or Error.
  pub try_recv_result() RecvResult<T> {
    let out = self.zero_value();
    let rc = self.try_recv(&out);
    ret self.result_from_rc(rc, out);
  }

  // Await-friendly wrapper for recv_result.
  pub async recv_result_async() RecvResult<T> {
    ret self.recv_result();
  }

  // Await-friendly wrapper for recv_result_timeout.
  pub async recv_result_timeout_async(num timeout_ms) RecvResult<T> {
    ret self.recv_result_timeout(timeout_ms);
  }

  // Await-friendly wrapper for recv_result_timeout_with_token.
  pub async recv_result_timeout_with_token_async(num timeout_ms, ChannelCancelToken* cancel_token) RecvResult<T> {
    ret self.recv_result_timeout_with_token(timeout_ms, cancel_token);
  }

  // Send `value`, returning a SendResult you can `fit` on (blocks while full; resolves
  // to Ok/Closed/Error — never Full/Cancelled since there's no deadline/token).
  pub send_result(T value) SendResult {
    ret self.send_result_from_rc(self.send(value));
  }

  // Send within `timeout_ms`, as a SendResult (Ok/Closed/Full/Error). A negative
  // timeout waits forever; on a full channel within the deadline, resolves to Full.
  pub send_result_timeout(T value, num timeout_ms) SendResult {
    ret self.send_result_from_rc(self.send_timeout(value, timeout_ms));
  }

  // Send within `timeout_ms` with token cancellation, as a SendResult
  // (Ok/Closed/Full/Cancelled/Error).
  pub send_result_timeout_with_token(T value, num timeout_ms, ChannelCancelToken* cancel_token) SendResult {
    ret self.send_result_from_rc(self.send_timeout_with_token(value, timeout_ms, cancel_token));
  }

  // Send forever-or-until-cancelled with a token, as a SendResult
  // (Ok/Closed/Cancelled/Error).
  pub send_result_with_token(T value, ChannelCancelToken* cancel_token) SendResult {
    ret self.send_result_from_rc(self.send_with_token(value, cancel_token));
  }

  // Try to send without blocking, as a SendResult: Ok when enqueued, Full when the
  // channel is full, Closed when closed, or Error.
  pub try_send_result(T value) SendResult {
    ret self.send_result_from_rc(self.try_send(value));
  }

  // Await-friendly wrapper for send_result.
  pub async send_result_async(T value) SendResult {
    ret self.send_result(value);
  }

  // Await-friendly wrapper for send_result_timeout.
  pub async send_result_timeout_async(T value, num timeout_ms) SendResult {
    ret self.send_result_timeout(value, timeout_ms);
  }

  // Await-friendly wrapper for send_result_timeout_with_token.
  pub async send_result_timeout_with_token_async(
    T value,
    num timeout_ms,
    ChannelCancelToken* cancel_token
  ) SendResult {
    ret self.send_result_timeout_with_token(value, timeout_ms, cancel_token);
  }

  // Await-friendly wrapper for send_result_with_token (waits forever or until cancelled).
  pub async send_result_with_token_async(T value, ChannelCancelToken* cancel_token) SendResult {
    ret self.send_result_with_token(value, cancel_token);
  }

  // Try receiving one value without blocking.
  // 
  // Params:
  // - out: destination pointer
  // 
  // Returns:
  // - 0 on success
  // - 1 when closed and empty
  // - 2 when open but empty
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub try_recv(T* out) num {
    if out == nil {
      ret channel_rc_null_arg();
    }

    let rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = runtime_mutex_lock(&self.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&self.mu);

    if self.count == 0 {
      if self.closed == true {
        ret channel_rc_closed();
      }
      ret channel_rc_empty();
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = runtime_condvar_signal(&self.can_send);
    ret channel_rc_ok();
  }

  // Wait for a receive signal on a hint channel for up to timeout_ms.
  // 
  // Returns:
  // - 0 when woken or wait skipped
  // - 2 on timeout
  // - -1 when hint is null
  // - other nonzero codes on synchronization failures
  pub wait_recv_hint_timeout(Channel<T>* hint, num timeout_ms) num {
    if hint == nil {
      ret channel_rc_null_arg();
    }
    if timeout_ms < 0 {
      timeout_ms = 0;
    }

    let rc = hint.init();
    if rc != 0 {
      ret rc;
    }

    rc = runtime_mutex_lock(&hint.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&hint.mu);

    if hint.count > 0 || hint.closed == true {
      ret channel_rc_ok();
    }

    ChannelAbsTime abs_time;
    rc = channel_make_abs_time(timeout_ms, &abs_time);
    if rc != 0 {
      ret rc;
    }

    rc = runtime_condvar_timed_wait(&hint.can_recv, &hint.mu, &abs_time);
    if rc != 0 {
      if channel_deadline_reached(&abs_time) == true {
        ret channel_rc_timeout();
      }
      ret rc;
    }

    ret channel_rc_ok();
  }

  // Try receiving from self or another channel without blocking.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 when both channels are open/empty in this polling step
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_try_recv_with(Channel<T>* other, T* out, num* out_index) num {
    if other == nil || out == nil || out_index == nil {
      ret channel_rc_null_arg();
    }

    out_index[0] = channel_select_index_default();

    let rc_self = self.try_recv(out);
    if rc_self == channel_rc_ok() {
      out_index[0] = channel_select_index_self();
      ret channel_rc_ok();
    }
    if rc_self != channel_rc_closed() && rc_self != channel_rc_empty() {
      ret rc_self;
    }

    let rc_other = other.try_recv(out);
    if rc_other == channel_rc_ok() {
      out_index[0] = channel_select_index_other();
      ret channel_rc_ok();
    }
    if rc_other != channel_rc_closed() && rc_other != channel_rc_empty() {
      ret rc_other;
    }

    if rc_self == channel_rc_closed() && rc_other == channel_rc_closed() {
      ret channel_rc_closed();
    }
    ret channel_rc_empty();
  }

  // Try receiving from self or another channel, else take the default branch.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other, -1 for default)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 3 when default branch is selected (both open/empty in this step)
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_default_with(Channel<T>* other, T* out, num* out_index) num {
    let rc = self.select_try_recv_with(other, out, out_index);
    if rc == channel_rc_empty() {
      out_index[0] = channel_select_index_default();
      ret channel_rc_default();
    }
    ret rc;
  }

  // Receive from self or another channel, polling until timeout, with
  // explicit wait-slice/backoff-step overrides and optional cancellation.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // - timeout_ms: max wait in ms (negative means wait forever)
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // - backoff_steps: max adaptive backoff steps (clamped to 0..8)
  // - cancel_flag: optional pointer to cancellation flag (nonzero => cancelled)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 on timeout
  // - 3 when cancelled
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout_with_tuning_cancel(
    Channel<T>* other,
    T* out,
    num* out_index,
    num timeout_ms = -1,
    num wait_slice_ms = -1,
    num backoff_steps = -1,
    num* cancel_flag = nil
  ) num {
    if other == nil || out == nil || out_index == nil {
      ret channel_rc_null_arg();
    }

    // `-1` sentinels mean "use this channel's configured tuning" (default params
    // can't reference `self`, so the substitution happens here in the body).
    num eff_slice_ms = wait_slice_ms;
    if eff_slice_ms < 0 {
      eff_slice_ms = self.select_wait_slice_ms;
    }
    num eff_backoff_steps = backoff_steps;
    if eff_backoff_steps < 0 {
      eff_backoff_steps = self.select_wait_backoff_steps;
    }

    let base_wait_slice_ms = channel_sanitize_wait_slice_ms(eff_slice_ms);
    let max_backoff_steps = channel_sanitize_backoff_steps(eff_backoff_steps);

    let wait_forever = timeout_ms < 0;
    ChannelAbsTime abs_time;
    if wait_forever == false {
      let time_rc = channel_make_abs_time(timeout_ms, &abs_time);
      if time_rc != 0 {
        ret time_rc;
      }
    }

    let wait_slot = channel_select_index_self();
    num idle_rounds = 0;

    for true {
      if channel_is_cancelled(cancel_flag) == true {
        out_index[0] = channel_select_index_default();
        ret channel_rc_cancelled();
      }

      out_index[0] = channel_select_index_default();

      let rc_self = self.try_recv(out);
      if rc_self == channel_rc_ok() {
        out_index[0] = channel_select_index_self();
        ret channel_rc_ok();
      }
      if rc_self != channel_rc_closed() && rc_self != channel_rc_empty() {
        ret rc_self;
      }

      let rc_other = other.try_recv(out);
      if rc_other == channel_rc_ok() {
        out_index[0] = channel_select_index_other();
        ret channel_rc_ok();
      }
      if rc_other != channel_rc_closed() && rc_other != channel_rc_empty() {
        ret rc_other;
      }

      if rc_self == channel_rc_closed() && rc_other == channel_rc_closed() {
        ret channel_rc_closed();
      }
      if wait_forever == false && channel_deadline_reached(&abs_time) == true {
        ret channel_rc_timeout();
      }

      let hint = self;
      if wait_slot == channel_select_index_other() {
        hint = other;
      }
      wait_slot = wait_slot + 1;
      if wait_slot >= 2 {
        wait_slot = channel_select_index_self();
      }

      num rem_ms = -1;
      if wait_forever == false {
        rem_ms = channel_deadline_remaining_ms(&abs_time);
        if rem_ms <= 0 {
          ret channel_rc_timeout();
        }
      }

      let wait_now_ms = channel_compute_wait_slice_ms(
        base_wait_slice_ms,
        rem_ms,
        idle_rounds,
        max_backoff_steps
      );

      let wait_rc = self.wait_recv_hint_timeout(hint, wait_now_ms);
      if wait_rc != channel_rc_ok() && wait_rc != channel_rc_timeout() {
        ret wait_rc;
      }
      if idle_rounds < max_backoff_steps {
        idle_rounds = idle_rounds + 1;
      }
      if wait_rc == channel_rc_ok() {
        idle_rounds = 0;
      }
    }

    ret channel_rc_timeout();
  }

  // Receive from self or another channel, polling until timeout, with
  // explicit wait tuning and optional token cancellation.
  // 
  // Returns:
  // - same return codes as select_recv_timeout_with_tuning_cancel
  pub select_recv_timeout_with_tuning_token(
    Channel<T>* other,
    T* out,
    num* out_index,
    num timeout_ms,
    num wait_slice_ms,
    num backoff_steps,
    ChannelCancelToken* cancel_token
  ) num {
    ret self.select_recv_timeout_with_tuning_cancel(
      other,
      out,
      out_index,
      timeout_ms,
      wait_slice_ms,
      backoff_steps,
      channel_cancel_token_flag_ptr(cancel_token)
    );
  }

  // Await-friendly select-recv (2-channel). All tuning knobs default to this
  // channel's configuration (-1 sentinels), so `await a.select_recv_..._async(&b, &out, &idx)`
  // blocks-on-the-scheduler until a value arrives on either channel.
  pub async select_recv_timeout_with_tuning_cancel_async(
    Channel<T>* other,
    T* out,
    num* out_index,
    num timeout_ms = -1,
    num wait_slice_ms = -1,
    num backoff_steps = -1,
    num* cancel_flag = nil
  ) num {
    ret self.select_recv_timeout_with_tuning_cancel(
      other,
      out,
      out_index,
      timeout_ms,
      wait_slice_ms,
      backoff_steps,
      cancel_flag
    );
  }

  // Await-friendly select-recv (2-channel) with token cancellation.
  pub async select_recv_timeout_with_tuning_token_async(
    Channel<T>* other,
    T* out,
    num* out_index,
    num timeout_ms,
    num wait_slice_ms,
    num backoff_steps,
    ChannelCancelToken* cancel_token
  ) num {
    ret self.select_recv_timeout_with_tuning_token(
      other,
      out,
      out_index,
      timeout_ms,
      wait_slice_ms,
      backoff_steps,
      cancel_token
    );
  }

  // Try receiving from self + two other channels without blocking, using
  // a rotating start index for fairness.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - 2 when all three channels are open/empty in this polling step
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_try_recv3_rr_with(
    Channel<T>* other_a,
    Channel<T>* other_b,
    num* next_index,
    T* out,
    num* out_index
  ) num {
    if other_a == nil || other_b == nil || next_index == nil || out == nil || out_index == nil {
      ret channel_rc_null_arg();
    }

    out_index[0] = channel_select_index_default();

    let start = next_index[0] % 3;
    if start < 0 {
      start = start + 3;
    }

    num closed_count = 0;
    num i = 0;
    for i < 3 {
      let slot = start + i;
      if slot >= 3 {
        slot = slot - 3;
      }

      let rc = channel_rc_empty();
      if slot == channel_select_index_self() {
        rc = self.try_recv(out);
      } elif slot == channel_select_index_other() {
        rc = other_a.try_recv(out);
      } else {
        rc = other_b.try_recv(out);
      }

      if rc == channel_rc_ok() {
        out_index[0] = slot;
        let nxt = slot + 1;
        if nxt >= 3 {
          nxt = channel_select_index_self();
        }
        next_index[0] = nxt;
        ret channel_rc_ok();
      }

      if rc != channel_rc_closed() && rc != channel_rc_empty() {
        ret rc;
      }
      if rc == channel_rc_closed() {
        closed_count = closed_count + 1;
      }

      i = i + 1;
    }

    if closed_count == 3 {
      ret channel_rc_closed();
    }
    ret channel_rc_empty();
  }

  // Try receiving from self + two other channels, else take the default branch.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (-1 for default)
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - 3 when default branch is selected (all open/empty in this step)
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv3_rr_default_with(
    Channel<T>* other_a,
    Channel<T>* other_b,
    num* next_index,
    T* out,
    num* out_index
  ) num {
    let rc = self.select_try_recv3_rr_with(other_a, other_b, next_index, out, out_index);
    if rc == channel_rc_empty() {
      out_index[0] = channel_select_index_default();
      ret channel_rc_default();
    }
    ret rc;
  }

  // Receive from self + two other channels, polling until timeout, with
  // fairness rotation, explicit wait tuning, and optional cancellation.
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - 2 on timeout
  // - 3 when cancelled
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout3_rr_with_tuning_cancel(
    Channel<T>* other_a,
    Channel<T>* other_b,
    num* next_index,
    T* out,
    num* out_index,
    num timeout_ms = -1,
    num wait_slice_ms = -1,
    num backoff_steps = -1,
    num* cancel_flag = nil
  ) num {
    if other_a == nil || other_b == nil || next_index == nil || out == nil || out_index == nil {
      ret channel_rc_null_arg();
    }

    // `-1` sentinels mean "use this channel's configured tuning" (default params
    // can't reference `self`, so the substitution happens here in the body).
    num eff_slice_ms = wait_slice_ms;
    if eff_slice_ms < 0 {
      eff_slice_ms = self.select_wait_slice_ms;
    }
    num eff_backoff_steps = backoff_steps;
    if eff_backoff_steps < 0 {
      eff_backoff_steps = self.select_wait_backoff_steps;
    }

    let base_wait_slice_ms = channel_sanitize_wait_slice_ms(eff_slice_ms);
    let max_backoff_steps = channel_sanitize_backoff_steps(eff_backoff_steps);

    let wait_forever = timeout_ms < 0;
    ChannelAbsTime abs_time;
    if wait_forever == false {
      let time_rc = channel_make_abs_time(timeout_ms, &abs_time);
      if time_rc != 0 {
        ret time_rc;
      }
    }

    let wait_slot = next_index[0] % 3;
    if wait_slot < 0 {
      wait_slot = wait_slot + 3;
    }
    num idle_rounds = 0;

    for true {
      if channel_is_cancelled(cancel_flag) == true {
        out_index[0] = channel_select_index_default();
        ret channel_rc_cancelled();
      }

      let rc = self.select_try_recv3_rr_with(other_a, other_b, next_index, out, out_index);
      if rc == channel_rc_ok() {
        ret channel_rc_ok();
      }
      if rc == channel_rc_closed() {
        ret channel_rc_closed();
      }
      if rc != channel_rc_empty() {
        ret rc;
      }

      if wait_forever == false && channel_deadline_reached(&abs_time) == true {
        ret channel_rc_timeout();
      }

      let hint = self;
      if wait_slot == channel_select_index_other() {
        hint = other_a;
      } elif wait_slot == channel_select_index_other_b() {
        hint = other_b;
      }
      wait_slot = wait_slot + 1;
      if wait_slot >= 3 {
        wait_slot = 0;
      }

      num rem_ms = -1;
      if wait_forever == false {
        rem_ms = channel_deadline_remaining_ms(&abs_time);
        if rem_ms <= 0 {
          ret channel_rc_timeout();
        }
      }

      let wait_now_ms = channel_compute_wait_slice_ms(
        base_wait_slice_ms,
        rem_ms,
        idle_rounds,
        max_backoff_steps
      );

      let wait_rc = self.wait_recv_hint_timeout(hint, wait_now_ms);
      if wait_rc != channel_rc_ok() && wait_rc != channel_rc_timeout() {
        ret wait_rc;
      }
      if idle_rounds < max_backoff_steps {
        idle_rounds = idle_rounds + 1;
      }
      if wait_rc == channel_rc_ok() {
        idle_rounds = 0;
      }
    }

    ret channel_rc_timeout();
  }

  // Receive from self + two other channels, polling until timeout, with
  // fairness rotation, explicit wait tuning, and optional token cancellation.
  // 
  // Returns:
  // - same return codes as select_recv_timeout3_rr_with_tuning_cancel
  pub select_recv_timeout3_rr_with_tuning_token(
    Channel<T>* other_a,
    Channel<T>* other_b,
    num* next_index,
    T* out,
    num* out_index,
    num timeout_ms,
    num wait_slice_ms,
    num backoff_steps,
    ChannelCancelToken* cancel_token
  ) num {
    ret self.select_recv_timeout3_rr_with_tuning_cancel(
      other_a,
      other_b,
      next_index,
      out,
      out_index,
      timeout_ms,
      wait_slice_ms,
      backoff_steps,
      channel_cancel_token_flag_ptr(cancel_token)
    );
  }

  // Await-friendly select-recv (3-channel round-robin). Tuning knobs default to
  // this channel's configuration via -1 sentinels.
  pub async select_recv_timeout3_rr_with_tuning_cancel_async(
    Channel<T>* other_a,
    Channel<T>* other_b,
    num* next_index,
    T* out,
    num* out_index,
    num timeout_ms = -1,
    num wait_slice_ms = -1,
    num backoff_steps = -1,
    num* cancel_flag = nil
  ) num {
    ret self.select_recv_timeout3_rr_with_tuning_cancel(
      other_a,
      other_b,
      next_index,
      out,
      out_index,
      timeout_ms,
      wait_slice_ms,
      backoff_steps,
      cancel_flag
    );
  }

  // Receive one value from self and forward it to dst using async channel APIs.
  // 
  // Returns:
  // - 0 on success
  // - timeout/closed/cancelled/null_arg values propagated from recv/send paths
  pub async forward_one_to_async(Channel<T>* dst, num timeout_ms) num {
    if dst == nil {
      ret channel_rc_null_arg();
    }

    let value = self.zero_value();
    let rc = await self.recv_timeout_into_async(&value, timeout_ms);
    if rc != channel_rc_ok() {
      ret rc;
    }

    ret await dst.send_timeout_async(value, timeout_ms);
  }

  // Token-aware variant of forward_one_to_async.
  // 
  // Returns:
  // - 0 on success
  // - timeout/closed/cancelled/null_arg values propagated from recv/send paths
  pub async forward_one_to_with_token_async(
    Channel<T>* dst,
    num timeout_ms,
    ChannelCancelToken* cancel_token
  ) num {
    if dst == nil {
      ret channel_rc_null_arg();
    }

    let value = self.zero_value();
    let rc = await self.recv_timeout_into_with_token_async(&value, timeout_ms, cancel_token);
    if rc != channel_rc_ok() {
      ret rc;
    }

    ret await dst.send_timeout_with_token_async(value, timeout_ms, cancel_token);
  }

  // Receive one value from self or other and forward it to dst using async APIs.
  // 
  // Params:
  // - other: second source channel pointer
  // - dst: destination channel pointer
  // - timeout_ms: max wait in ms (negative means wait forever)
  // - out_index: selected source index (0=self, 1=other)
  // 
  // Returns:
  // - 0 on success
  // - timeout/closed/cancelled/null_arg values propagated from select/send paths
  pub async select_forward_one_to_async(
    Channel<T>* other,
    Channel<T>* dst,
    num timeout_ms,
    num* out_index
  ) num {
    if other == nil || dst == nil || out_index == nil {
      ret channel_rc_null_arg();
    }

    let value = self.zero_value();
    let rc = self.select_recv_timeout_with_tuning_cancel(
      other,
      &value,
      out_index,
      timeout_ms,
      -1,
      -1,
      nil
    );
    if rc != channel_rc_ok() {
      ret rc;
    }

    ret await dst.send_timeout_async(value, timeout_ms);
  }

  // Token-aware variant of select_forward_one_to_async.
  // 
  // Returns:
  // - 0 on success
  // - timeout/closed/cancelled/null_arg values propagated from select/send paths
  pub async select_forward_one_to_with_token_async(
    Channel<T>* other,
    Channel<T>* dst,
    num timeout_ms,
    num* out_index,
    ChannelCancelToken* cancel_token
  ) num {
    if other == nil || dst == nil || out_index == nil {
      ret channel_rc_null_arg();
    }

    let value = self.zero_value();
    let rc = self.select_recv_timeout_with_tuning_token(
      other,
      &value,
      out_index,
      timeout_ms,
      -1,
      -1,
      cancel_token
    );
    if rc != channel_rc_ok() {
      ret rc;
    }

    ret await dst.send_timeout_with_token_async(value, timeout_ms, cancel_token);
  }

  // Close channel and wake blocked senders/receivers.
  // 
  // Notes:
  // - Idempotent: calling close() multiple times keeps the channel closed.
  // 
  // Returns:
  // - 0 on success
  // - nonzero backend sync/init code on failure
  pub close() num {
    let rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = runtime_mutex_lock(&self.mu);
    if rc != 0 {
      ret rc;
    }
    defer runtime_mutex_unlock(&self.mu);

    self.closed = true;
    _ = runtime_condvar_broadcast(&self.can_recv);
    _ = runtime_condvar_broadcast(&self.can_send);
    ret channel_rc_ok();
  }

  // Read closed state as an unsynchronized snapshot.
  // 
  // Note:
  // - For coordinated checks, guard state with the channel mutex.
  pub is_closed() bin {
    ret self.closed;
  }

  // Current queued value count as an unsynchronized snapshot.
  // 
  // Note:
  // - For coordinated checks, guard state with the channel mutex.
  pub len() num {
    ret self.count;
  }

  // True when no values are currently queued (unsynchronized snapshot).
  // 
  // Note:
  // - For coordinated checks, guard state with the channel mutex.
  pub is_empty() bin {
    ret self.count == 0;
  }

  // Configured channel capacity.
  pub capacity() num {
    ret self.cap;
  }

  // Destroy channel storage and synchronization primitives.
  // 
  // Note:
  // - Call only after all send/recv activity has stopped.
  // 
  // Returns:
  // - 0 on success
  // - nonzero backend sync destroy code on failure
  pub destroy() num {
    if self.has_buffer == true {
      free(self.data);
      self.has_buffer = false;
    }

    let rc = runtime_condvar_destroy(&self.can_recv);
    if rc != 0 {
      ret rc;
    }
    rc = runtime_condvar_destroy(&self.can_send);
    if rc != 0 {
      ret rc;
    }
    ret runtime_mutex_destroy(&self.mu);
  }
}
