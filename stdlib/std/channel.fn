// Blocking bounded channels built on std.sync.
// 
// This module provides a minimal channel primitive suitable as a runtime
// building block for higher-level concurrency features.

imp std.sync;
imp std.c.mem;
imp std.c.string;
imp std.c.time;
imp std.c.def;

// Bounded blocking channel implemented as a ring buffer.
pub compound Channel<T> {
  // Channel mutex.
  Mutex mu;
  // Signaled when buffer transitions from full to not-full.
  CondVar can_send;
  // Signaled when buffer transitions from empty to not-empty.
  CondVar can_recv;

  // Ring buffer storage.
  T[] data;
  // True when ring storage is allocated.
  bin has_buffer;
  // Buffer capacity.
  num cap;
  // Read cursor.
  num head;
  // Write cursor.
  num tail;
  // Number of queued values.
  num count;

  // True once close() is called.
  bin closed;
}

// Create a single-slot channel.
// 
// Params:
// - default_value: initial value used to initialize storage
// 
// Returns:
// - initialized channel
pub fun channel_new<T>(T default_value) Channel<T> {
  Channel<T> ch;
  ch.mu = mutex_new();
  ch.can_send = condvar_new();
  ch.can_recv = condvar_new();

  ch.cap = 1;
  ch.has_buffer = false;
  ch.head = 0;
  ch.tail = 0;
  ch.count = 0;
  ch.closed = false;

  raw* data_ptr = malloc(sizeof(T));
  ch.data = data_ptr;
  if data_ptr != NULL {
    ch.has_buffer = true;
    ch.data[0] = default_value;
  }

  ret ch;
}

// Create a bounded channel with explicit capacity.
// 
// Params:
// - default_value: initial value used to initialize storage
// - capacity: requested channel capacity (values <= 0 become 1)
// 
// Returns:
// - initialized channel
pub fun channel_new_cap<T>(T default_value, num capacity) Channel<T> {
  if capacity <= 0 {
    capacity = 1;
  }

  Channel<T> ch;
  ch.mu = mutex_new();
  ch.can_send = condvar_new();
  ch.can_recv = condvar_new();

  ch.cap = capacity;
  ch.has_buffer = false;
  ch.head = 0;
  ch.tail = 0;
  ch.count = 0;
  ch.closed = false;

  raw* data_ptr = malloc(sizeof(T) * capacity);
  ch.data = data_ptr;
  if data_ptr != NULL {
    ch.has_buffer = true;
    num i = 0;
    for i < capacity {
      ch.data[i] = default_value;
      i = i + 1;
    }
  }

  ret ch;
}

// Absolute timeout payload used with pthread timed waits.
compound ChannelAbsTime {
  num tv_sec;
  num tv_nsec;
}

// Build an absolute timeout from a millisecond duration.
// 
// Note:
// - Resolution is rounded up to whole seconds (uses `time()` backend).
fun channel_make_abs_time(num timeout_ms, ChannelAbsTime* out) num {
  if out == NULL {
    ret -1;
  }
  if timeout_ms < 0 {
    timeout_ms = 0;
  }

  num now_sec = time(NULL);
  if now_sec < 0 {
    ret -3;
  }

  num add_sec = timeout_ms / 1000;
  if timeout_ms % 1000 != 0 {
    add_sec = add_sec + 1;
  }

  out.tv_sec = now_sec + add_sec;
  out.tv_nsec = 0;
  ret 0;
}

// Returns true when the absolute timeout is reached.
fun channel_deadline_reached(ChannelAbsTime* abs_time) bin {
  if abs_time == NULL {
    ret true;
  }
  num now_sec = time(NULL);
  if now_sec < 0 {
    ret true;
  }
  ret now_sec >= abs_time.tv_sec;
}

impl Channel<T> {
  // Return a zeroed value for T.
  pub zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Initialize internal synchronization primitives.
  // 
  // Returns:
  // - 0 on success, nonzero error code on failure
  pub init() num {
    if self.has_buffer == false {
      ret -2;
    }

    num rc = self.mu.init();
    if rc != 0 {
      ret rc;
    }
    rc = self.can_send.init();
    if rc != 0 {
      ret rc;
    }
    rc = self.can_recv.init();
    if rc != 0 {
      ret rc;
    }
    ret 0;
  }

  // Send one value, blocking while the slot is full.
  // 
  // Returns:
  // - 0 on success
  // - -1 when channel is closed
  // - nonzero pthread error codes on synchronization failures
  pub send(T value) num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    for self.count == self.cap && self.closed == false {
      rc = self.can_send.wait(&self.mu);
      if rc != 0 {
        ret rc;
      }
    }

    if self.closed == true {
      ret -1;
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = self.can_recv.signal();
    ret 0;
  }

  // Send one value, blocking up to timeout_ms while full.
  // 
  // Params:
  // - value: value to send
  // - timeout_ms: max wait in ms (rounded up to whole seconds)
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 2 on timeout while still full
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub send_timeout(T value, num timeout_ms) num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }
    if timeout_ms < 0 {
      timeout_ms = 0;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.closed == true {
      ret 1;
    }

    ChannelAbsTime abs_time;
    rc = channel_make_abs_time(timeout_ms, &abs_time);
    if rc != 0 {
      ret rc;
    }

    for self.count == self.cap && self.closed == false {
      rc = self.can_send.timed_wait(&self.mu, &abs_time);
      if rc != 0 {
        if self.count < self.cap || self.closed == true {
          break;
        }
        if channel_deadline_reached(&abs_time) == true {
          ret 2;
        }
        ret rc;
      }
    }

    if self.closed == true {
      ret 1;
    }
    if self.count == self.cap {
      ret 2;
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = self.can_recv.signal();
    ret 0;
  }

  // Try sending one value without blocking.
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 2 when channel is full
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub try_send(T value) num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.closed == true {
      ret 1;
    }
    if self.count == self.cap {
      ret 2;
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = self.can_recv.signal();
    ret 0;
  }

  // Receive one value into out, blocking while empty.
  // 
  // Params:
  // - out: destination pointer
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and no value is available
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_into(T* out) num {
    if out == NULL {
      ret -1;
    }

    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    for self.count == 0 && self.closed == false {
      rc = self.can_recv.wait(&self.mu);
      if rc != 0 {
        ret rc;
      }
    }

    if self.count == 0 {
      ret 1;
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = self.can_send.signal();
    ret 0;
  }

  // Receive one value into out, blocking up to timeout_ms while empty.
  // 
  // Params:
  // - out: destination pointer
  // - timeout_ms: max wait in ms (rounded up to whole seconds)
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and empty
  // - 2 on timeout while still empty
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_timeout_into(T* out, num timeout_ms) num {
    if out == NULL {
      ret -1;
    }

    num rc = self.init();
    if rc != 0 {
      ret rc;
    }
    if timeout_ms < 0 {
      timeout_ms = 0;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.count == 0 && self.closed == false {
      ChannelAbsTime abs_time;
      rc = channel_make_abs_time(timeout_ms, &abs_time);
      if rc != 0 {
        ret rc;
      }

      for self.count == 0 && self.closed == false {
        rc = self.can_recv.timed_wait(&self.mu, &abs_time);
        if rc != 0 {
          if self.count > 0 || self.closed == true {
            break;
          }
          if channel_deadline_reached(&abs_time) == true {
            ret 2;
          }
          ret rc;
        }
      }
    }

    if self.count == 0 {
      if self.closed == true {
        ret 1;
      }
      ret 2;
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = self.can_send.signal();
    ret 0;
  }

  // Receive one value, blocking while empty.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when channel is closed and empty or on sync failure
  pub recv() T {
    T out = self.zero_value();
    num rc = self.recv_into(&out);
    if rc != 0 {
      ret self.zero_value();
    }
    ret out;
  }

  // Receive one value, blocking up to timeout_ms while empty.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when timeout/closed empty/sync error occurs
  pub recv_timeout(num timeout_ms) T {
    T out = self.zero_value();
    num rc = self.recv_timeout_into(&out, timeout_ms);
    if rc != 0 {
      ret self.zero_value();
    }
    ret out;
  }

  // Try receiving one value without blocking.
  // 
  // Params:
  // - out: destination pointer
  // 
  // Returns:
  // - 0 on success
  // - 1 when closed and empty
  // - 2 when open but empty
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub try_recv(T* out) num {
    if out == NULL {
      ret -1;
    }

    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.count == 0 {
      if self.closed == true {
        ret 1;
      }
      ret 2;
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = self.can_send.signal();
    ret 0;
  }

  // Try receiving from self or another channel without blocking.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 when both channels are open/empty in this polling step
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_try_recv_with(Channel<T>* other, T* out, num* out_index) num {
    if other == NULL || out == NULL || out_index == NULL {
      ret -1;
    }

    out_index[0] = -1;

    num rc_self = self.try_recv(out);
    if rc_self == 0 {
      out_index[0] = 0;
      ret 0;
    }
    if rc_self != 1 && rc_self != 2 {
      ret rc_self;
    }

    num rc_other = other.try_recv(out);
    if rc_other == 0 {
      out_index[0] = 1;
      ret 0;
    }
    if rc_other != 1 && rc_other != 2 {
      ret rc_other;
    }

    if rc_self == 1 && rc_other == 1 {
      ret 1;
    }
    ret 2;
  }

  // Receive from self or another channel, polling until timeout.
  // 
  // Notes:
  // - This uses polling with `try_recv`; timeout resolution is rounded to whole seconds.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // - timeout_ms: max wait in ms (negative means wait forever)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 on timeout
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout_with(Channel<T>* other, T* out, num* out_index, num timeout_ms) num {
    if other == NULL || out == NULL || out_index == NULL {
      ret -1;
    }

    bin wait_forever = timeout_ms < 0;
    ChannelAbsTime abs_time;
    if wait_forever == false {
      num time_rc = channel_make_abs_time(timeout_ms, &abs_time);
      if time_rc != 0 {
        ret time_rc;
      }
    }

    for true {
      out_index[0] = -1;

      num rc_self = self.try_recv(out);
      if rc_self == 0 {
        out_index[0] = 0;
        ret 0;
      }
      if rc_self != 1 && rc_self != 2 {
        ret rc_self;
      }

      num rc_other = other.try_recv(out);
      if rc_other == 0 {
        out_index[0] = 1;
        ret 0;
      }
      if rc_other != 1 && rc_other != 2 {
        ret rc_other;
      }

      if rc_self == 1 && rc_other == 1 {
        ret 1;
      }
      if wait_forever == false && channel_deadline_reached(&abs_time) == true {
        ret 2;
      }
    }

    ret 2;
  }

  // Receive from self or another channel, polling until one is ready.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_with(Channel<T>* other, T* out, num* out_index) num {
    if other == NULL || out == NULL || out_index == NULL {
      ret -1;
    }

    for true {
      out_index[0] = -1;

      num rc_self = self.try_recv(out);
      if rc_self == 0 {
        out_index[0] = 0;
        ret 0;
      }
      if rc_self != 1 && rc_self != 2 {
        ret rc_self;
      }

      num rc_other = other.try_recv(out);
      if rc_other == 0 {
        out_index[0] = 1;
        ret 0;
      }
      if rc_other != 1 && rc_other != 2 {
        ret rc_other;
      }

      if rc_self == 1 && rc_other == 1 {
        ret 1;
      }
    }

    ret 1;
  }

  // Close channel and wake blocked senders/receivers.
  // 
  // Returns:
  // - 0 on success, nonzero pthread error codes on sync failures
  pub close() num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    self.closed = true;
    _ = self.can_recv.broadcast();
    _ = self.can_send.broadcast();
    ret 0;
  }

  // Read closed state.
  pub is_closed() bin {
    ret self.closed;
  }

  // Number of queued values.
  pub len() num {
    ret self.count;
  }

  // Channel capacity.
  pub capacity() num {
    ret self.cap;
  }

  // Destroy channel synchronization primitives.
  // 
  // Returns:
  // - 0 on success, nonzero pthread error code on failure
  pub destroy() num {
    if self.has_buffer == true {
      free(self.data);
      self.has_buffer = false;
    }

    num rc = self.can_recv.destroy();
    if rc != 0 {
      ret rc;
    }
    rc = self.can_send.destroy();
    if rc != 0 {
      ret rc;
    }
    ret self.mu.destroy();
  }
}
