// Blocking bounded channels built on std.sync.
// 
// This module provides a minimal channel primitive suitable as a runtime
// building block for higher-level concurrency features.

imp std.sync;
imp std.c.mem;
imp std.c.string;
imp std.c.time;
imp std.c.def;

// Bounded blocking channel implemented as a ring buffer.
pub compound Channel<T> {
  // Channel mutex.
  Mutex mu;
  // Signaled when buffer transitions from full to not-full.
  CondVar can_send;
  // Signaled when buffer transitions from empty to not-empty.
  CondVar can_recv;

  // Ring buffer storage.
  T[] data;
  // True when ring storage is allocated.
  bin has_buffer;
  // Buffer capacity.
  num cap;
  // Read cursor.
  num head;
  // Write cursor.
  num tail;
  // Number of queued values.
  num count;

  // True once close() is called.
  bin closed;

  // Per-channel select wait slice in milliseconds.
  num select_wait_slice_ms;
  // Per-channel adaptive select backoff steps (0 disables backoff).
  num select_wait_backoff_steps;
}

// Create a single-slot channel.
// 
// Params:
// - default_value: initial value used to initialize storage
// 
// Returns:
// - initialized channel
pub fun channel_new<T>(T default_value) Channel<T> {
  Channel<T> ch;
  ch.mu = mutex_new();
  ch.can_send = condvar_new();
  ch.can_recv = condvar_new();

  ch.cap = 1;
  ch.has_buffer = false;
  ch.head = 0;
  ch.tail = 0;
  ch.count = 0;
  ch.closed = false;
  ch.select_wait_slice_ms = 5;
  ch.select_wait_backoff_steps = 3;

  raw* data_ptr = malloc(sizeof(T));
  ch.data = data_ptr;
  if data_ptr != NULL {
    ch.has_buffer = true;
    ch.data[0] = default_value;
  }

  ret ch;
}

// Create a bounded channel with explicit capacity.
// 
// Params:
// - default_value: initial value used to initialize storage
// - capacity: requested channel capacity (values <= 0 become 1)
// 
// Returns:
// - initialized channel
pub fun channel_new_cap<T>(T default_value, num capacity) Channel<T> {
  if capacity <= 0 {
    capacity = 1;
  }

  Channel<T> ch;
  ch.mu = mutex_new();
  ch.can_send = condvar_new();
  ch.can_recv = condvar_new();

  ch.cap = capacity;
  ch.has_buffer = false;
  ch.head = 0;
  ch.tail = 0;
  ch.count = 0;
  ch.closed = false;
  ch.select_wait_slice_ms = 5;
  ch.select_wait_backoff_steps = 3;

  raw* data_ptr = malloc(sizeof(T) * capacity);
  ch.data = data_ptr;
  if data_ptr != NULL {
    ch.has_buffer = true;
    num i = 0;
    for i < capacity {
      ch.data[i] = default_value;
      i = i + 1;
    }
  }

  ret ch;
}

// Absolute timeout payload used with pthread timed waits.
compound ChannelAbsTime {
  num tv_sec;
  num tv_nsec;
}

// Build an absolute timeout from a millisecond duration.
// 
// Note:
// - Uses `clock_gettime` and keeps millisecond-scale precision.
fun channel_make_abs_time(num timeout_ms, ChannelAbsTime* out) num {
  if out == NULL {
    ret -1;
  }
  if timeout_ms < 0 {
    timeout_ms = 0;
  }

  raw* out_raw = out;
  num rc = clock_gettime(0, out_raw);
  if rc != 0 {
    ret -3;
  }

  num add_sec = timeout_ms / 1000;
  num add_nsec = (timeout_ms % 1000) * 1000000;

  out.tv_sec = out.tv_sec + add_sec;
  out.tv_nsec = out.tv_nsec + add_nsec;

  if out.tv_nsec >= 1000000000 {
    out.tv_sec = out.tv_sec + (out.tv_nsec / 1000000000);
    out.tv_nsec = out.tv_nsec % 1000000000;
  }

  ret 0;
}

// Returns true when the absolute timeout is reached.
fun channel_deadline_reached(ChannelAbsTime* abs_time) bin {
  if abs_time == NULL {
    ret true;
  }

  ChannelAbsTime now;
  raw* now_raw = &now;
  num rc = clock_gettime(0, now_raw);
  if rc != 0 {
    ret true;
  }

  if now.tv_sec > abs_time.tv_sec {
    ret true;
  }
  if now.tv_sec == abs_time.tv_sec && now.tv_nsec >= abs_time.tv_nsec {
    ret true;
  }
  ret false;
}

// Clamp configurable select wait slice to a sane positive value.
fun channel_sanitize_wait_slice_ms(num wait_slice_ms) num {
  if wait_slice_ms <= 0 {
    ret 1;
  }
  ret wait_slice_ms;
}

// Clamp adaptive select backoff steps to a sane nonnegative range.
fun channel_sanitize_backoff_steps(num backoff_steps) num {
  if backoff_steps < 0 {
    ret 0;
  }
  if backoff_steps > 8 {
    ret 8;
  }
  ret backoff_steps;
}

// Remaining time (ms) until absolute deadline.
// 
// Returns:
// - remaining milliseconds rounded up
// - 0 when already expired or on clock failure
fun channel_deadline_remaining_ms(ChannelAbsTime* abs_time) num {
  if abs_time == NULL {
    ret 0;
  }

  ChannelAbsTime now;
  raw* now_raw = &now;
  num rc = clock_gettime(0, now_raw);
  if rc != 0 {
    ret 0;
  }

  num sec_diff = abs_time.tv_sec - now.tv_sec;
  num nsec_diff = abs_time.tv_nsec - now.tv_nsec;
  if nsec_diff < 0 {
    sec_diff = sec_diff - 1;
    nsec_diff = nsec_diff + 1000000000;
  }

  if sec_diff < 0 {
    ret 0;
  }

  num out_ms = sec_diff * 1000 + (nsec_diff / 1000000);
  if nsec_diff % 1000000 != 0 {
    out_ms = out_ms + 1;
  }
  ret out_ms;
}

// Compute per-round select wait duration with bounded adaptive backoff.
// 
// Strategy:
// - Start from base_wait_slice_ms.
// - Back off exponentially with idle rounds.
// - Clamp to rem_ms when rem_ms >= 0.
fun channel_compute_wait_slice_ms(num base_wait_slice_ms, num rem_ms, num idle_rounds, num max_backoff_steps) num {
  num wait_ms = channel_sanitize_wait_slice_ms(base_wait_slice_ms);
  max_backoff_steps = channel_sanitize_backoff_steps(max_backoff_steps);

  if idle_rounds < 0 {
    idle_rounds = 0;
  }

  num backoff_steps = idle_rounds;
  if backoff_steps > max_backoff_steps {
    backoff_steps = max_backoff_steps;
  }

  num i = 0;
  for i < backoff_steps {
    wait_ms = wait_ms * 2;
    i = i + 1;
  }

  if rem_ms >= 0 && wait_ms > rem_ms {
    wait_ms = rem_ms;
  }
  if wait_ms <= 0 {
    ret 1;
  }
  ret wait_ms;
}

impl Channel<T> {
  // Return a zeroed value for T.
  pub zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Initialize internal synchronization primitives.
  // 
  // Returns:
  // - 0 on success, nonzero error code on failure
  pub init() num {
    if self.has_buffer == false {
      ret -2;
    }

    num rc = self.mu.init();
    if rc != 0 {
      ret rc;
    }
    rc = self.can_send.init();
    if rc != 0 {
      ret rc;
    }
    rc = self.can_recv.init();
    if rc != 0 {
      ret rc;
    }
    self.select_wait_slice_ms = channel_sanitize_wait_slice_ms(self.select_wait_slice_ms);
    self.select_wait_backoff_steps = channel_sanitize_backoff_steps(self.select_wait_backoff_steps);
    ret 0;
  }

  // Configure the per-channel select wait slice (in milliseconds).
  pub set_select_wait_slice_ms(num wait_slice_ms) {
    self.select_wait_slice_ms = channel_sanitize_wait_slice_ms(wait_slice_ms);
  }

  // Read the per-channel select wait slice (in milliseconds).
  pub get_select_wait_slice_ms() num {
    ret self.select_wait_slice_ms;
  }

  // Configure max adaptive select backoff steps (0 disables backoff).
  pub set_select_wait_backoff_steps(num backoff_steps) {
    self.select_wait_backoff_steps = channel_sanitize_backoff_steps(backoff_steps);
  }

  // Read max adaptive select backoff steps.
  pub get_select_wait_backoff_steps() num {
    ret self.select_wait_backoff_steps;
  }

  // Send one value, blocking while the slot is full.
  // 
  // Returns:
  // - 0 on success
  // - -1 when channel is closed
  // - nonzero pthread error codes on synchronization failures
  pub send(T value) num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    for self.count == self.cap && self.closed == false {
      rc = self.can_send.wait(&self.mu);
      if rc != 0 {
        ret rc;
      }
    }

    if self.closed == true {
      ret -1;
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = self.can_recv.signal();
    ret 0;
  }

  // Send one value, blocking up to timeout_ms while full.
  // 
  // Params:
  // - value: value to send
  // - timeout_ms: max wait in milliseconds
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 2 on timeout while still full
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub send_timeout(T value, num timeout_ms) num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }
    if timeout_ms < 0 {
      timeout_ms = 0;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.closed == true {
      ret 1;
    }

    ChannelAbsTime abs_time;
    rc = channel_make_abs_time(timeout_ms, &abs_time);
    if rc != 0 {
      ret rc;
    }

    for self.count == self.cap && self.closed == false {
      rc = self.can_send.timed_wait(&self.mu, &abs_time);
      if rc != 0 {
        if self.count < self.cap || self.closed == true {
          break;
        }
        if channel_deadline_reached(&abs_time) == true {
          ret 2;
        }
        ret rc;
      }
    }

    if self.closed == true {
      ret 1;
    }
    if self.count == self.cap {
      ret 2;
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = self.can_recv.signal();
    ret 0;
  }

  // Try sending one value without blocking.
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed
  // - 2 when channel is full
  // - -2 when storage allocation failed
  // - nonzero pthread error codes on synchronization failures
  pub try_send(T value) num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.closed == true {
      ret 1;
    }
    if self.count == self.cap {
      ret 2;
    }

    self.data[self.tail] = value;
    self.tail = self.tail + 1;
    if self.tail >= self.cap {
      self.tail = 0;
    }
    self.count = self.count + 1;

    _ = self.can_recv.signal();
    ret 0;
  }

  // Receive one value into out, blocking while empty.
  // 
  // Params:
  // - out: destination pointer
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and no value is available
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_into(T* out) num {
    if out == NULL {
      ret -1;
    }

    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    for self.count == 0 && self.closed == false {
      rc = self.can_recv.wait(&self.mu);
      if rc != 0 {
        ret rc;
      }
    }

    if self.count == 0 {
      ret 1;
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = self.can_send.signal();
    ret 0;
  }

  // Receive one value into out, blocking up to timeout_ms while empty.
  // 
  // Params:
  // - out: destination pointer
  // - timeout_ms: max wait in milliseconds
  // 
  // Returns:
  // - 0 on success
  // - 1 when channel is closed and empty
  // - 2 on timeout while still empty
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub recv_timeout_into(T* out, num timeout_ms) num {
    if out == NULL {
      ret -1;
    }

    num rc = self.init();
    if rc != 0 {
      ret rc;
    }
    if timeout_ms < 0 {
      timeout_ms = 0;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.count == 0 && self.closed == false {
      ChannelAbsTime abs_time;
      rc = channel_make_abs_time(timeout_ms, &abs_time);
      if rc != 0 {
        ret rc;
      }

      for self.count == 0 && self.closed == false {
        rc = self.can_recv.timed_wait(&self.mu, &abs_time);
        if rc != 0 {
          if self.count > 0 || self.closed == true {
            break;
          }
          if channel_deadline_reached(&abs_time) == true {
            ret 2;
          }
          ret rc;
        }
      }
    }

    if self.count == 0 {
      if self.closed == true {
        ret 1;
      }
      ret 2;
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = self.can_send.signal();
    ret 0;
  }

  // Receive one value, blocking while empty.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when channel is closed and empty or on sync failure
  pub recv() T {
    T out = self.zero_value();
    num rc = self.recv_into(&out);
    if rc != 0 {
      ret self.zero_value();
    }
    ret out;
  }

  // Receive one value, blocking up to timeout_ms while empty.
  // 
  // Returns:
  // - received value on success
  // - zeroed value when timeout/closed empty/sync error occurs
  pub recv_timeout(num timeout_ms) T {
    T out = self.zero_value();
    num rc = self.recv_timeout_into(&out, timeout_ms);
    if rc != 0 {
      ret self.zero_value();
    }
    ret out;
  }

  // Try receiving one value without blocking.
  // 
  // Params:
  // - out: destination pointer
  // 
  // Returns:
  // - 0 on success
  // - 1 when closed and empty
  // - 2 when open but empty
  // - -1 when out is null
  // - nonzero pthread error codes on synchronization failures
  pub try_recv(T* out) num {
    if out == NULL {
      ret -1;
    }

    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    if self.count == 0 {
      if self.closed == true {
        ret 1;
      }
      ret 2;
    }

    out[0] = self.data[self.head];
    self.head = self.head + 1;
    if self.head >= self.cap {
      self.head = 0;
    }
    self.count = self.count - 1;

    _ = self.can_send.signal();
    ret 0;
  }

  // Wait for a receive signal on a hint channel for up to timeout_ms.
  // 
  // Returns:
  // - 0 when woken or wait skipped
  // - 2 on timeout
  // - -1 when hint is null
  // - other nonzero codes on synchronization failures
  pub wait_recv_hint_timeout(Channel<T>* hint, num timeout_ms) num {
    if hint == NULL {
      ret -1;
    }
    if timeout_ms < 0 {
      timeout_ms = 0;
    }

    num rc = hint.init();
    if rc != 0 {
      ret rc;
    }

    rc = hint.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer hint.mu.unlock();

    if hint.count > 0 || hint.closed == true {
      ret 0;
    }

    ChannelAbsTime abs_time;
    rc = channel_make_abs_time(timeout_ms, &abs_time);
    if rc != 0 {
      ret rc;
    }

    rc = hint.can_recv.timed_wait(&hint.mu, &abs_time);
    if rc != 0 {
      if channel_deadline_reached(&abs_time) == true {
        ret 2;
      }
      ret rc;
    }

    ret 0;
  }

  // Try receiving from self or another channel without blocking.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 when both channels are open/empty in this polling step
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_try_recv_with(Channel<T>* other, T* out, num* out_index) num {
    if other == NULL || out == NULL || out_index == NULL {
      ret -1;
    }

    out_index[0] = -1;

    num rc_self = self.try_recv(out);
    if rc_self == 0 {
      out_index[0] = 0;
      ret 0;
    }
    if rc_self != 1 && rc_self != 2 {
      ret rc_self;
    }

    num rc_other = other.try_recv(out);
    if rc_other == 0 {
      out_index[0] = 1;
      ret 0;
    }
    if rc_other != 1 && rc_other != 2 {
      ret rc_other;
    }

    if rc_self == 1 && rc_other == 1 {
      ret 1;
    }
    ret 2;
  }

  // Receive from self or another channel, polling until timeout.
  // 
  // Notes:
  // - This uses polling with `try_recv` plus short condvar-assisted waits.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // - timeout_ms: max wait in ms (negative means wait forever)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 on timeout
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout_with(Channel<T>* other, T* out, num* out_index, num timeout_ms) num {
    ret self.select_recv_timeout_with_slice(other, out, out_index, timeout_ms, self.select_wait_slice_ms);
  }

  // Receive from self or another channel, polling until timeout, with
  // an explicit wait-slice override.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // - timeout_ms: max wait in ms (negative means wait forever)
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 on timeout
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout_with_slice(Channel<T>* other, T* out, num* out_index, num timeout_ms, num wait_slice_ms) num {
    ret self.select_recv_timeout_with_tuning(other, out, out_index, timeout_ms, wait_slice_ms, self.select_wait_backoff_steps);
  }

  // Receive from self or another channel, polling until timeout, with
  // explicit wait-slice and backoff-step overrides.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // - timeout_ms: max wait in ms (negative means wait forever)
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // - backoff_steps: max adaptive backoff steps (clamped to 0..8)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - 2 on timeout
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout_with_tuning(Channel<T>* other, T* out, num* out_index, num timeout_ms, num wait_slice_ms, num backoff_steps) num {
    if other == NULL || out == NULL || out_index == NULL {
      ret -1;
    }

    num base_wait_slice_ms = channel_sanitize_wait_slice_ms(wait_slice_ms);
    num max_backoff_steps = channel_sanitize_backoff_steps(backoff_steps);

    bin wait_forever = timeout_ms < 0;
    ChannelAbsTime abs_time;
    if wait_forever == false {
      num time_rc = channel_make_abs_time(timeout_ms, &abs_time);
      if time_rc != 0 {
        ret time_rc;
      }
    }

    num wait_slot = 0;
    num idle_rounds = 0;

    for true {
      out_index[0] = -1;

      num rc_self = self.try_recv(out);
      if rc_self == 0 {
        out_index[0] = 0;
        ret 0;
      }
      if rc_self != 1 && rc_self != 2 {
        ret rc_self;
      }

      num rc_other = other.try_recv(out);
      if rc_other == 0 {
        out_index[0] = 1;
        ret 0;
      }
      if rc_other != 1 && rc_other != 2 {
        ret rc_other;
      }

      if rc_self == 1 && rc_other == 1 {
        ret 1;
      }
      if wait_forever == false && channel_deadline_reached(&abs_time) == true {
        ret 2;
      }

      Channel<T>* hint= self;
      if wait_slot == 1 {
        hint = other;
      }
      wait_slot = wait_slot + 1;
      if wait_slot >= 2 {
        wait_slot = 0;
      }

      num rem_ms = -1;
      if wait_forever == false {
        rem_ms = channel_deadline_remaining_ms(&abs_time);
        if rem_ms <= 0 {
          ret 2;
        }
      }

      num wait_now_ms = channel_compute_wait_slice_ms(base_wait_slice_ms, rem_ms, idle_rounds, max_backoff_steps);

      num wait_rc = self.wait_recv_hint_timeout(hint, wait_now_ms);
      if wait_rc != 0 && wait_rc != 2 {
        ret wait_rc;
      }
      if idle_rounds < max_backoff_steps {
        idle_rounds = idle_rounds + 1;
      }
      if wait_rc == 0 {
        idle_rounds = 0;
      }
    }

    ret 2;
  }

  // Receive from self or another channel, polling until one is ready.
  // with an explicit wait-slice override.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_with_slice(Channel<T>* other, T* out, num* out_index, num wait_slice_ms) num {
    ret self.select_recv_timeout_with_tuning(other, out, out_index, -1, wait_slice_ms, self.select_wait_backoff_steps);
  }

  // Receive from self or another channel, polling until one is ready,
  // with explicit wait-slice and backoff-step overrides.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // - backoff_steps: max adaptive backoff steps (clamped to 0..8)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_with_tuning(Channel<T>* other, T* out, num* out_index, num wait_slice_ms, num backoff_steps) num {
    ret self.select_recv_timeout_with_tuning(other, out, out_index, -1, wait_slice_ms, backoff_steps);
  }

  // Receive from self or another channel, polling until one is ready.
  // 
  // Params:
  // - other: second channel pointer
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index (0 for self, 1 for other)
  // 
  // Returns:
  // - 0 on success
  // - 1 when both channels are closed and empty
  // - -1 when other/out/out_index is null
  // - other nonzero codes on synchronization failures
  pub select_recv_with(Channel<T>* other, T* out, num* out_index) num {
    ret self.select_recv_with_tuning(other, out, out_index, self.select_wait_slice_ms, self.select_wait_backoff_steps);
  }

  // Try receiving from self + two other channels without blocking, using
  // a rotating start index for fairness.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - 2 when all three channels are open/empty in this polling step
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_try_recv3_rr_with(Channel<T>* other_a, Channel<T>* other_b, num* next_index, T* out, num* out_index) num {
    if other_a == NULL || other_b == NULL || next_index == NULL || out == NULL || out_index == NULL {
      ret -1;
    }

    out_index[0] = -1;

    num start = next_index[0] % 3;
    if start < 0 {
      start = start + 3;
    }

    num closed_count = 0;
    num i = 0;
    for i < 3 {
      num slot = start + i;
      if slot >= 3 {
        slot = slot - 3;
      }

      num rc = 2;
      if slot == 0 {
        rc = self.try_recv(out);
      } elif slot == 1 {
        rc = other_a.try_recv(out);
      } else {
        rc = other_b.try_recv(out);
      }

      if rc == 0 {
        out_index[0] = slot;
        num nxt = slot + 1;
        if nxt >= 3 {
          nxt = 0;
        }
        next_index[0] = nxt;
        ret 0;
      }

      if rc != 1 && rc != 2 {
        ret rc;
      }
      if rc == 1 {
        closed_count = closed_count + 1;
      }

      i = i + 1;
    }

    if closed_count == 3 {
      ret 1;
    }
    ret 2;
  }

  // Receive from self + two other channels, polling until timeout, with
  // fairness rotation driven by next_index.
  // 
  // Notes:
  // - This uses polling with `try_recv` plus short condvar-assisted waits.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // - timeout_ms: max wait in ms (negative means wait forever)
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - 2 on timeout
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout3_rr_with(Channel<T>* other_a, Channel<T>* other_b, num* next_index, T* out, num* out_index, num timeout_ms) num {
    ret self.select_recv_timeout3_rr_with_slice(other_a, other_b, next_index, out, out_index, timeout_ms, self.select_wait_slice_ms);
  }

  // Receive from self + two other channels, polling until timeout, with
  // fairness rotation and an explicit wait-slice override.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // - timeout_ms: max wait in ms (negative means wait forever)
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - 2 on timeout
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout3_rr_with_slice(Channel<T>* other_a, Channel<T>* other_b, num* next_index, T* out, num* out_index, num timeout_ms, num wait_slice_ms) num {
    ret self.select_recv_timeout3_rr_with_tuning(other_a, other_b, next_index, out, out_index, timeout_ms, wait_slice_ms, self.select_wait_backoff_steps);
  }

  // Receive from self + two other channels, polling until timeout, with
  // fairness rotation and explicit wait-slice/backoff-step overrides.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // - timeout_ms: max wait in ms (negative means wait forever)
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // - backoff_steps: max adaptive backoff steps (clamped to 0..8)
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - 2 on timeout
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv_timeout3_rr_with_tuning(Channel<T>* other_a, Channel<T>* other_b, num* next_index, T* out, num* out_index, num timeout_ms, num wait_slice_ms, num backoff_steps) num {
    if other_a == NULL || other_b == NULL || next_index == NULL || out == NULL || out_index == NULL {
      ret -1;
    }

    num base_wait_slice_ms = channel_sanitize_wait_slice_ms(wait_slice_ms);
    num max_backoff_steps = channel_sanitize_backoff_steps(backoff_steps);

    bin wait_forever = timeout_ms < 0;
    ChannelAbsTime abs_time;
    if wait_forever == false {
      num time_rc = channel_make_abs_time(timeout_ms, &abs_time);
      if time_rc != 0 {
        ret time_rc;
      }
    }

    num wait_slot = next_index[0] % 3;
    if wait_slot < 0 {
      wait_slot = wait_slot + 3;
    }
    num idle_rounds = 0;

    for true {
      num rc = self.select_try_recv3_rr_with(other_a, other_b, next_index, out, out_index);
      if rc == 0 {
        ret 0;
      }
      if rc == 1 {
        ret 1;
      }
      if rc != 2 {
        ret rc;
      }

      if wait_forever == false && channel_deadline_reached(&abs_time) == true {
        ret 2;
      }

      Channel<T>* hint= self;
      if wait_slot == 1 {
        hint = other_a;
      } elif wait_slot == 2 {
        hint = other_b;
      }
      wait_slot = wait_slot + 1;
      if wait_slot >= 3 {
        wait_slot = 0;
      }

      num rem_ms = -1;
      if wait_forever == false {
        rem_ms = channel_deadline_remaining_ms(&abs_time);
        if rem_ms <= 0 {
          ret 2;
        }
      }

      num wait_now_ms = channel_compute_wait_slice_ms(base_wait_slice_ms, rem_ms, idle_rounds, max_backoff_steps);

      num wait_rc = self.wait_recv_hint_timeout(hint, wait_now_ms);
      if wait_rc != 0 && wait_rc != 2 {
        ret wait_rc;
      }
      if idle_rounds < max_backoff_steps {
        idle_rounds = idle_rounds + 1;
      }
      if wait_rc == 0 {
        idle_rounds = 0;
      }
    }

    ret 2;
  }

  // Receive from self + two other channels, polling until one is ready,
  // with fairness rotation and an explicit wait-slice override.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv3_rr_with_slice(Channel<T>* other_a, Channel<T>* other_b, num* next_index, T* out, num* out_index, num wait_slice_ms) num {
    ret self.select_recv_timeout3_rr_with_tuning(other_a, other_b, next_index, out, out_index, -1, wait_slice_ms, self.select_wait_backoff_steps);
  }

  // Receive from self + two other channels, polling until one is ready,
  // with fairness rotation and explicit wait-slice/backoff-step overrides.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // - wait_slice_ms: wait duration per polling round (clamped to >= 1)
  // - backoff_steps: max adaptive backoff steps (clamped to 0..8)
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv3_rr_with_tuning(Channel<T>* other_a, Channel<T>* other_b, num* next_index, T* out, num* out_index, num wait_slice_ms, num backoff_steps) num {
    ret self.select_recv_timeout3_rr_with_tuning(other_a, other_b, next_index, out, out_index, -1, wait_slice_ms, backoff_steps);
  }

  // Receive from self + two other channels, polling until one is ready,
  // with fairness rotation driven by next_index.
  // 
  // Params:
  // - other_a: second channel pointer
  // - other_b: third channel pointer
  // - next_index: in/out probe start index (0=self, 1=other_a, 2=other_b)
  // - out: destination pointer
  // - out_index: destination pointer for selected channel index
  // 
  // Returns:
  // - 0 on success
  // - 1 when all three channels are closed and empty
  // - -1 when any pointer argument is null
  // - other nonzero codes on synchronization failures
  pub select_recv3_rr_with(Channel<T>* other_a, Channel<T>* other_b, num* next_index, T* out, num* out_index) num {
    ret self.select_recv3_rr_with_tuning(other_a, other_b, next_index, out, out_index, self.select_wait_slice_ms, self.select_wait_backoff_steps);
  }

  // Close channel and wake blocked senders/receivers.
  // 
  // Returns:
  // - 0 on success, nonzero pthread error codes on sync failures
  pub close() num {
    num rc = self.init();
    if rc != 0 {
      ret rc;
    }

    rc = self.mu.lock();
    if rc != 0 {
      ret rc;
    }
    defer self.mu.unlock();

    self.closed = true;
    _ = self.can_recv.broadcast();
    _ = self.can_send.broadcast();
    ret 0;
  }

  // Read closed state.
  pub is_closed() bin {
    ret self.closed;
  }

  // Number of queued values.
  pub len() num {
    ret self.count;
  }

  // Channel capacity.
  pub capacity() num {
    ret self.cap;
  }

  // Destroy channel synchronization primitives.
  // 
  // Returns:
  // - 0 on success, nonzero pthread error code on failure
  pub destroy() num {
    if self.has_buffer == true {
      free(self.data);
      self.has_buffer = false;
    }

    num rc = self.can_recv.destroy();
    if rc != 0 {
      ret rc;
    }
    rc = self.can_send.destroy();
    if rc != 0 {
      ret rc;
    }
    ret self.mu.destroy();
  }
}
