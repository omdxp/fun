// Basic URL parsing and HTTP request building.
// 
// Usage:
// ```
// Url u = url_parse("http://example.com/");
// str req = u.build_http_get();
// ```

imp std.string;
imp std.vec;
imp std.c.io;
imp std.c.mem;
imp std.c.net;
imp std.result;
imp std.error;

// Parsed URL components.
pub compound Url {
  // scheme: protocol (http/https)
  str scheme;
  // host: hostname
  str host;
  // port: port number
  num port;
  // path: request path
  str path;
}

impl Url {
  // Build a simple HTTP/1.1 GET request string.
  pub build_http_get() str {
    Vec<str> parts;
    parts.init(4);
    parts.push("GET ");
    parts.push(self.path);
    parts.push(" HTTP/1.1\r\nHost: ");
    parts.push(self.host);
    parts.push("\r\nConnection: close\r\n\r\n");
    str out = parts.join("");
    parts.free();
    ret out;
  }
}

// Parse a URL into components (scheme/host/port/path).
// 
// Params:
// - s: URL string
// 
// Returns:
// - parsed Url
pub fun parse_url(str s) Url {
  Url u;
  u.scheme = "http";
  u.host = "";
  u.port = 80;
  u.path = "/";

  num scheme_idx = index_of_str(s, "://");
  if scheme_idx != -1 {
    u.scheme = substr(s, 0, scheme_idx);
    num rest_start = scheme_idx + 3;
    s = substr(s, rest_start, len(s) - rest_start);
  }

  num slash_idx = index_of_char(s, '/');
  if slash_idx == -1 {
    u.host = s;
    u.path = "/";
  } else {
    u.host = substr(s, 0, slash_idx);
    u.path = substr(s, slash_idx, len(s) - slash_idx);
  }

  num colon_idx = index_of_char(u.host, ':');
  if colon_idx != -1 {
    str host_only = substr(u.host, 0, colon_idx);
    str port_str = substr(u.host, colon_idx + 1, len(u.host) - (colon_idx + 1));
    u.host = host_only;
    u.port = parse_int(port_str);
  } else {
    if equals(u.scheme, "https") != false {
      u.port = 443;
    }
  }

  ret u;
}

// Build a simple HTTP GET request from a Url.
// 
// Params:
// - url: URL instance to build a request for
// 
// Returns:
// - request string
pub fun build_http_get(Url* url) str {
  ret url.build_http_get();
}

// POSIX socket constants (best-effort defaults).
// 
// Returns:
// - AF_INET constant
pub fun af_inet() num {
  ret 2;
}

// Return SOCK_STREAM constant value (best-effort default).
// 
// Returns:
// - SOCK_STREAM constant
pub fun sock_stream() num {
  ret 1;
}

// Packed 16-byte sockaddr_in representation using two 64-bit words.
// word0 packs: family (bytes 0-1), port (2-3), addr (4-7)
// word1 packs: zero (8-15)
pub compound SockAddrInPacked {
  // word0: family/port/address packed
  num word0;
  // word1: trailing zero bytes
  num word1;
}

fun _pack_sockaddr_in_linux(num port) SockAddrInPacked {
  SockAddrInPacked a;
  num fam = af_inet();
  num prt = htons(port);
  num addr = htonl(0);
  a.word0 = fam + (prt * 65536) + (addr * 4294967296);
  a.word1 = 0;
  ret a;
}

fun _pack_sockaddr_in_bsd(num port) SockAddrInPacked {
  SockAddrInPacked a;
  num len = 16;
  num fam = af_inet();
  num prt = htons(port);
  num addr = htonl(0);
  a.word0 = len + (fam * 256) + (prt * 65536) + (addr * 4294967296);
  a.word1 = 0;
  ret a;
}

// Create a TCP listening socket on the given port.
// 
// Returns:
// - server fd on success, or -1
pub fun tcp_listen(num port) num {
  num fd = socket(af_inet(), sock_stream(), 0);
  if fd < 0 {
    ret -1;
  }

  SockAddrInPacked addr = _pack_sockaddr_in_linux(port);
  raw* addr_ptr = &addr;
  if bind(fd, addr_ptr, 16) != 0 {
    addr = _pack_sockaddr_in_bsd(port);
    addr_ptr = &addr;
    if bind(fd, addr_ptr, 16) != 0 {
      close(fd);
      ret -1;
    }
  }

  if listen(fd, 16) != 0 {
    close(fd);
    ret -1;
  }

  ret fd;
}

// Create a TCP listening socket with Result.
pub fun try_tcp_listen(num port) Result<num> {
  Result<num> r;
  num fd = tcp_listen(port);
  if fd < 0 {
    r.set_err(1, "tcp_listen failed", -1);
    ret r;
  }
  r.set_ok(fd);
  ret r;
}

// Accept a client connection.
// 
// Returns:
// - client fd, or -1
pub fun tcp_accept(num server_fd) num {
  ret accept(server_fd, NULL, NULL);
}

// Accept a client connection with Result.
pub fun try_tcp_accept(num server_fd) Result<num> {
  Result<num> r;
  num fd = tcp_accept(server_fd);
  if fd < 0 {
    r.set_err(1, "tcp_accept failed", -1);
    ret r;
  }
  r.set_ok(fd);
  ret r;
}

// Read from a socket.
// 
// Params:
// - fd: socket fd
// - buf: destination buffer
// - len: bytes to read
// 
// Returns:
// - bytes read or negative on error
pub fun tcp_read(num fd, str buf, num len) num {
  ret recv(fd, buf, len, 0);
}

// Read from a socket with Result.
pub fun try_tcp_read(num fd, str buf, num len) Result<num> {
  Result<num> r;
  num n = tcp_read(fd, buf, len);
  if n < 0 {
    r.set_err(1, "tcp_read failed", -1);
    ret r;
  }
  r.set_ok(n);
  ret r;
}

// Write to a socket.
// 
// Params:
// - fd: socket fd
// - buf: source buffer
// - len: bytes to write
// 
// Returns:
// - bytes written or negative on error
pub fun tcp_write(num fd, str buf, num len) num {
  ret send(fd, buf, len, 0);
}

// Write to a socket with Result.
pub fun try_tcp_write(num fd, str buf, num len) Result<num> {
  Result<num> r;
  num n = tcp_write(fd, buf, len);
  if n < 0 {
    r.set_err(1, "tcp_write failed", -1);
    ret r;
  }
  r.set_ok(n);
  ret r;
}

// Close a socket.
// 
// Params:
// - fd: socket fd
pub fun tcp_close(num fd) {
  close(fd);
}

// Serve a single HTTP request with a fixed response.
pub fun http_serve_once(num port, str body) num {
  num server = tcp_listen(port);
  if server < 0 {
    ret -1;
  }
  defer tcp_close(server);

  num client = tcp_accept(server);
  if client < 0 {
    ret -1;
  }

  str buf = malloc(1024);
  if buf != NULL {
    tcp_read(client, buf, 1023);
    free(buf);
  }

  str hdr = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n";
  tcp_write(client, hdr, len(hdr));
  tcp_write(client, body, len(body));
  tcp_close(client);
  ret 0;
}

// Serve a single HTTP request with Result.
pub fun try_http_serve_once(num port, str body) Result<num> {
  Result<num> r;
  num rc = http_serve_once(port, body);
  if rc != 0 {
    r.set_err(1, "http_serve_once failed", rc);
    ret r;
  }
  r.set_ok(rc);
  ret r;
}

// Serve HTTP requests forever (blocking loop).
pub fun http_serve_forever(num port, str body) num {
  num server = tcp_listen(port);
  if server < 0 {
    ret -1;
  }
  defer tcp_close(server);

  for true {
    num client = tcp_accept(server);
    if client < 0 {
      ret -1;
    }

    str buf = malloc(1024);
    if buf != NULL {
      tcp_read(client, buf, 1023);
      free(buf);
    }

    str hdr = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n";
    tcp_write(client, hdr, len(hdr));
    tcp_write(client, body, len(body));
    tcp_close(client);
  }
  ret 0;
}

// Serve HTTP requests forever with Result.
pub fun try_http_serve_forever(num port, str body) Result<num> {
  Result<num> r;
  num rc = http_serve_forever(port, body);
  if rc != 0 {
    r.set_err(1, "http_serve_forever failed", rc);
    ret r;
  }
  r.set_ok(rc);
  ret r;
}
