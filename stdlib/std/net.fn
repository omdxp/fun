// Basic URL parsing and HTTP request building.

imp std.string;
imp std.vec;
imp std.c.mem;
imp std.c.net;
imp std.channel;
imp std.thread_runtime;
imp std.result;
imp std.error;

// Parsed URL components.
pub compound Url {
  // Protocol (`http` or `https`).
  str scheme;
  // Host name.
  str host;
  // Port number.
  num port;
  // Request path.
  str path;
}

impl Url {
  // Builds a simple HTTP/1.1 GET request string.
  pub build_http_get() str {
    Vec<str> parts;
    parts.init(4);
    parts.push("GET ");
    parts.push(self.path);
    parts.push(" HTTP/1.1\r\nHost: ");
    parts.push(self.host);
    parts.push("\r\nConnection: close\r\n\r\n");
    let out = parts.join("");
    parts.free();
    ret out;
  }
}

// Parses a URL into scheme/host/port/path components.
pub fun parse_url(str s) Url {
  Url u;
  u.scheme = "http";
  u.host = "";
  u.port = 80;
  u.path = "/";

  let scheme_idx = index_of_str(s, "://");
  if scheme_idx != -1 {
    u.scheme = substr(s, 0, scheme_idx);
    let rest_start = scheme_idx + 3;
    s = substr(s, rest_start, len(s) - rest_start);
  }

  let slash_idx = index_of_char(s, '/');
  if slash_idx == -1 {
    u.host = s;
    u.path = "/";
  } else {
    u.host = substr(s, 0, slash_idx);
    u.path = substr(s, slash_idx, len(s) - slash_idx);
  }

  let colon_idx = index_of_char(u.host, ':');
  if colon_idx != -1 {
    let host_only = substr(u.host, 0, colon_idx);
    let port_str = substr(u.host, colon_idx + 1, len(u.host) - (colon_idx + 1));
    u.host = host_only;
    u.port = parse_int(port_str);
  } else {
    if equals(u.scheme, "https") != false {
      u.port = 443;
    }
  }

  ret u;
}

// Parse a URL with validation. `Ok(url)` when a non-empty host is present,
// otherwise `Err` — unlike `parse_url`, which returns a Url with an empty host
// on malformed input.
pub fun try_parse_url(str s) Result<Url, Error> {
  let u = parse_url(s);
  if is_empty(u.host) {
    ret err_kind(.Parse, "parse_url: missing host", u);
  }
  ret .Ok(u);
}

// Builds a simple HTTP GET request string from a parsed Url.
pub fun build_http_get(Url* url) str {
  ret url.build_http_get();
}

// Returns the POSIX AF_INET constant (best-effort default).
pub fun af_inet() num {
  ret 2;
}

// Returns the POSIX SOCK_STREAM constant (best-effort default).
pub fun sock_stream() num {
  ret 1;
}

// Packed 16-byte sockaddr_in representation using two 64-bit words.
// word0 packs: family (bytes 0-1), port (2-3), addr (4-7)
// word1 packs: zero (8-15)
pub compound SockAddrInPacked {
  // family/port/address packed
  num word0;
  // trailing zero bytes
  num word1;
}

fun _pack_sockaddr_in_linux(num port) SockAddrInPacked {
  SockAddrInPacked a;
  let fam = af_inet();
  let prt = htons(port);
  let addr = htonl(0);
  a.word0 = fam + (prt * 65536) + (addr * 4294967296);
  a.word1 = 0;
  ret a;
}

fun _pack_sockaddr_in_bsd(num port) SockAddrInPacked {
  SockAddrInPacked a;
  num len = 16;
  let fam = af_inet();
  let prt = htons(port);
  let addr = htonl(0);
  a.word0 = len + (fam * 256) + (prt * 65536) + (addr * 4294967296);
  a.word1 = 0;
  ret a;
}

// Creates a TCP listening socket on `port`; returns the server fd, or -1 on failure.
pub fun tcp_listen(num port) num {
  let fd = socket(af_inet(), sock_stream(), 0);
  if fd < 0 {
    ret -1;
  }

  let addr = _pack_sockaddr_in_linux(port);
  raw* addr_ptr = &addr;
  if bind(fd, addr_ptr, 16) != 0 {
    addr = _pack_sockaddr_in_bsd(port);
    addr_ptr = &addr;
    if bind(fd, addr_ptr, 16) != 0 {
      close(fd);
      ret -1;
    }
  }

  if listen(fd, 16) != 0 {
    close(fd);
    ret -1;
  }

  ret fd;
}

// Creates a TCP listening socket on `port`, with Result.
pub fun try_tcp_listen(num port) Result<num, Error> {
  let fd = tcp_listen(port);
  if fd < 0 {
    ret err_kind(.Io, "tcp_listen failed", -1);
  }
  ret .Ok(fd);
}

// Accepts a client connection; returns the client fd, or -1 on failure.
pub fun tcp_accept(num server_fd) num {
  ret accept(server_fd, nil, nil);
}

// Accepts a client connection, with Result.
pub fun try_tcp_accept(num server_fd) Result<num, Error> {
  let fd = tcp_accept(server_fd);
  if fd < 0 {
    ret err_kind(.Io, "tcp_accept failed", -1);
  }
  ret .Ok(fd);
}

// Reads up to `len` bytes from a socket into `buf`; returns bytes read, or negative on error.
pub fun tcp_read(num fd, str buf, num len) num {
  ret recv(fd, buf, len, 0);
}

// Reads from a socket, with Result.
pub fun try_tcp_read(num fd, str buf, num len) Result<num, Error> {
  let n = tcp_read(fd, buf, len);
  if n < 0 {
    ret err_kind(.Io, "tcp_read failed", -1);
  }
  ret .Ok(n);
}

// Writes `len` bytes from `buf` to a socket; returns bytes written, or negative on error.
pub fun tcp_write(num fd, str buf, num len) num {
  ret send(fd, buf, len, 0);
}

// Writes to a socket, with Result.
pub fun try_tcp_write(num fd, str buf, num len) Result<num, Error> {
  let n = tcp_write(fd, buf, len);
  if n < 0 {
    ret err_kind(.Io, "tcp_write failed", -1);
  }
  ret .Ok(n);
}

// Closes a socket.
pub fun tcp_close(num fd) {
  close(fd);
}

compound TcpRoundtripOffloadJob {
  num fd;
  str send_buf;
  str recv_buf;
  num recv_len;
  ChannelCancelToken* cancel_token;
  num result_rc;
}

fun _tcp_roundtrip_core(
  num fd,
  str send_buf,
  str recv_buf,
  num recv_len,
  ChannelCancelToken* cancel_token
) num {
  if recv_buf == nil || recv_len <= 0 {
    ret -1;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  if send_buf != nil {
    let send_len = len(send_buf);
    if send_len > 0 {
      let wrote = tcp_write(fd, send_buf, send_len);
      if wrote < 0 {
        ret -1;
      }
    }
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  let n = tcp_read(fd, recv_buf, recv_len);
  if n < 0 {
    ret -1;
  }
  ret n;
}

fun _tcp_roundtrip_offload_worker(raw* arg) raw* {
  if arg == nil {
    ret nil;
  }

  TcpRoundtripOffloadJob* job = arg;
  job.result_rc = _tcp_roundtrip_core(
    job.fd,
    job.send_buf,
    job.recv_buf,
    job.recv_len,
    job.cancel_token
  );

  ret nil;
}

// Sends `send_buf` (if any) then reads a response into `recv_buf` on an
// already-connected socket. Returns bytes read on success, -1 on invalid
// args or a write/read failure, and -3 if cancelled.
pub async fun tcp_roundtrip_async(
  num fd,
  str send_buf,
  str recv_buf,
  num recv_len,
  ChannelCancelToken* cancel_token
) num {
  ret _tcp_roundtrip_core(fd, send_buf, recv_buf, recv_len, cancel_token);
}

// Same as `tcp_roundtrip_async`, but offloads the socket call to a runtime
// thread so it doesn't block the caller. Returns the same codes, or a thread
// start/join error code when spawn/join fails.
pub async fun tcp_roundtrip_offload_async(
  num fd,
  str send_buf,
  str recv_buf,
  num recv_len,
  ChannelCancelToken* cancel_token
) num {
  if recv_buf == nil || recv_len <= 0 {
    ret -1;
  }
  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  TcpRoundtripOffloadJob job;
  job.fd = fd;
  job.send_buf = send_buf;
  job.recv_buf = recv_buf;
  job.recv_len = recv_len;
  job.cancel_token = cancel_token;
  job.result_rc = -1;

  let task = runtime_async_spawn(_tcp_roundtrip_offload_worker, &job);
  if task.last_start_rc() != 0 {
    ret task.last_start_rc();
  }

  let join_rc = await task.join_async(nil);
  if join_rc != 0 {
    ret join_rc;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }
  ret job.result_rc;
}

// Parses `raw_url`, builds an HTTP GET request, and sends it (heap-allocated;
// the receiver must free it) to `out_requests`. Returns 0 on success, 1 if
// the channel is closed, -1 on invalid args or a malformed URL, -2 if
// request allocation fails, and -3 if cancelled.
pub async fun build_http_get_to_channel_async(
  str raw_url,
  Channel<str>* out_requests,
  ChannelCancelToken* cancel_token
) num {
  if raw_url == nil || out_requests == nil {
    ret -1;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  let u = parse_url(raw_url);
  if u.host == nil || len(u.host) == 0 {
    ret -1;
  }

  let req = u.build_http_get();
  if req == nil {
    ret -2;
  }

  fit await out_requests.send_result_with_token_async(req, cancel_token) {
    .Ok -> { ret 0; }
    .Cancelled -> {
      free(req);
      ret -3;
    }
    .Closed -> {
      free(req);
      ret 1;
    }
    _ -> {
      free(req);
      ret -1;
    }
  }
  ret -1;
}

// Serves a single HTTP request on `port` with a fixed `body` response;
// returns 0 on success, -1 on socket setup or request-handling failure.
pub fun http_serve_once(num port, str body) num {
  let server = tcp_listen(port);
  if server < 0 {
    ret -1;
  }
  defer tcp_close(server);

  let client = tcp_accept(server);
  if client < 0 {
    ret -1;
  }

  str buf = malloc(1024);
  if buf != nil {
    tcp_read(client, buf, 1023);
    free(buf);
  }

  str hdr = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n";
  tcp_write(client, hdr, len(hdr));
  tcp_write(client, body, len(body));
  tcp_close(client);
  ret 0;
}

// Serves a single HTTP request, with Result.
pub fun try_http_serve_once(num port, str body) Result<num, Error> {
  let rc = http_serve_once(port, body);
  if rc != 0 {
    ret err_kind(.Io, "http_serve_once failed", rc);
  }
  ret .Ok(rc);
}

// Serves HTTP requests forever in a blocking loop, always responding with
// `body`. Returns 0 if the loop exits normally, -1 on socket setup or
// request-handling failure.
pub fun http_serve_forever(num port, str body) num {
  let server = tcp_listen(port);
  if server < 0 {
    ret -1;
  }
  defer tcp_close(server);

  for true {
    let client = tcp_accept(server);
    if client < 0 {
      ret -1;
    }

    str buf = malloc(1024);
    if buf != nil {
      tcp_read(client, buf, 1023);
      free(buf);
    }

    str hdr = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n";
    tcp_write(client, hdr, len(hdr));
    tcp_write(client, body, len(body));
    tcp_close(client);
  }
  ret 0;
}

// Serves HTTP requests forever, with Result.
pub fun try_http_serve_forever(num port, str body) Result<num, Error> {
  let rc = http_serve_forever(port, body);
  if rc != 0 {
    ret err_kind(.Io, "http_serve_forever failed", rc);
  }
  ret .Ok(rc);
}
