// Basic URL parsing and HTTP request building.
// 
// Usage:
// ```
// Url u = url_parse("http://example.com/");
// str req = u.build_http_get();
// ```

imp std.string;
imp std.vec;
imp std.c.mem;
imp std.c.net;
imp std.channel;
imp std.thread_runtime;
imp std.result;

// Parsed URL components.
pub compound Url {
  // protocol (http/https)
  str scheme;
  // hostname
  str host;
  // port number
  num port;
  // request path
  str path;
}

impl Url {
  // Build a simple HTTP/1.1 GET request string.
  pub build_http_get() str {
    Vec<str> parts;
    parts.init(4);
    parts.push("GET ");
    parts.push(self.path);
    parts.push(" HTTP/1.1\r\nHost: ");
    parts.push(self.host);
    parts.push("\r\nConnection: close\r\n\r\n");
    str out = parts.join("");
    parts.free();
    ret out;
  }
}

// Parse a URL into components (scheme/host/port/path).
// 
// Params:
// - s: URL string
// 
// Returns:
// - parsed Url
pub fun parse_url(str s) Url {
  Url u;
  u.scheme = "http";
  u.host = "";
  u.port = 80;
  u.path = "/";

  num scheme_idx = index_of_str(s, "://");
  if scheme_idx != -1 {
    u.scheme = substr(s, 0, scheme_idx);
    num rest_start = scheme_idx + 3;
    s = substr(s, rest_start, len(s) - rest_start);
  }

  num slash_idx = index_of_char(s, '/');
  if slash_idx == -1 {
    u.host = s;
    u.path = "/";
  } else {
    u.host = substr(s, 0, slash_idx);
    u.path = substr(s, slash_idx, len(s) - slash_idx);
  }

  num colon_idx = index_of_char(u.host, ':');
  if colon_idx != -1 {
    str host_only = substr(u.host, 0, colon_idx);
    str port_str = substr(u.host, colon_idx + 1, len(u.host) - (colon_idx + 1));
    u.host = host_only;
    u.port = parse_int(port_str);
  } else {
    if equals(u.scheme, "https") != false {
      u.port = 443;
    }
  }

  ret u;
}

// Parse a URL with validation. `Ok(url)` when a non-empty host is present,
// otherwise `Err` — unlike `parse_url`, which returns a Url with an empty host
// on malformed input (a silent footgun).
pub fun try_parse_url(str s) Result<Url> {
  Url u = parse_url(s);
  if is_empty(u.host) {
    ret err(1, "parse_url: missing host", u);
  }
  ret ok(u);
}

// Build a simple HTTP GET request from a Url.
// 
// Params:
// - url: URL instance to build a request for
// 
// Returns:
// - request string
pub fun build_http_get(Url* url) str {
  ret url.build_http_get();
}

// POSIX socket constants (best-effort defaults).
// 
// Returns:
// - AF_INET constant
pub fun af_inet() num {
  ret 2;
}

// Return SOCK_STREAM constant value (best-effort default).
// 
// Returns:
// - SOCK_STREAM constant
pub fun sock_stream() num {
  ret 1;
}

// Packed 16-byte sockaddr_in representation using two 64-bit words.
// word0 packs: family (bytes 0-1), port (2-3), addr (4-7)
// word1 packs: zero (8-15)
pub compound SockAddrInPacked {
  // family/port/address packed
  num word0;
  // trailing zero bytes
  num word1;
}

fun _pack_sockaddr_in_linux(num port) SockAddrInPacked {
  SockAddrInPacked a;
  num fam = af_inet();
  num prt = htons(port);
  num addr = htonl(0);
  a.word0 = fam + (prt * 65536) + (addr * 4294967296);
  a.word1 = 0;
  ret a;
}

fun _pack_sockaddr_in_bsd(num port) SockAddrInPacked {
  SockAddrInPacked a;
  num len = 16;
  num fam = af_inet();
  num prt = htons(port);
  num addr = htonl(0);
  a.word0 = len + (fam * 256) + (prt * 65536) + (addr * 4294967296);
  a.word1 = 0;
  ret a;
}

// Create a TCP listening socket on the given port.
// 
// Returns:
// - server fd on success, or -1
pub fun tcp_listen(num port) num {
  num fd = socket(af_inet(), sock_stream(), 0);
  if fd < 0 {
    ret -1;
  }

  SockAddrInPacked addr = _pack_sockaddr_in_linux(port);
  raw* addr_ptr = &addr;
  if bind(fd, addr_ptr, 16) != 0 {
    addr = _pack_sockaddr_in_bsd(port);
    addr_ptr = &addr;
    if bind(fd, addr_ptr, 16) != 0 {
      close(fd);
      ret -1;
    }
  }

  if listen(fd, 16) != 0 {
    close(fd);
    ret -1;
  }

  ret fd;
}

// Create a TCP listening socket with Result.
pub fun try_tcp_listen(num port) Result<num> {
  num fd = tcp_listen(port);
  if fd < 0 {
    ret err(1, "tcp_listen failed", -1);
  }
  ret ok(fd);
}

// Accept a client connection.
// 
// Returns:
// - client fd, or -1
pub fun tcp_accept(num server_fd) num {
  ret accept(server_fd, nil, nil);
}

// Accept a client connection with Result.
pub fun try_tcp_accept(num server_fd) Result<num> {
  num fd = tcp_accept(server_fd);
  if fd < 0 {
    ret err(1, "tcp_accept failed", -1);
  }
  ret ok(fd);
}

// Read from a socket.
// 
// Params:
// - fd: socket fd
// - buf: destination buffer
// - len: bytes to read
// 
// Returns:
// - bytes read or negative on error
pub fun tcp_read(num fd, str buf, num len) num {
  ret recv(fd, buf, len, 0);
}

// Read from a socket with Result.
pub fun try_tcp_read(num fd, str buf, num len) Result<num> {
  num n = tcp_read(fd, buf, len);
  if n < 0 {
    ret err(1, "tcp_read failed", -1);
  }
  ret ok(n);
}

// Write to a socket.
// 
// Params:
// - fd: socket fd
// - buf: source buffer
// - len: bytes to write
// 
// Returns:
// - bytes written or negative on error
pub fun tcp_write(num fd, str buf, num len) num {
  ret send(fd, buf, len, 0);
}

// Write to a socket with Result.
pub fun try_tcp_write(num fd, str buf, num len) Result<num> {
  num n = tcp_write(fd, buf, len);
  if n < 0 {
    ret err(1, "tcp_write failed", -1);
  }
  ret ok(n);
}

// Close a socket.
// 
// Params:
// - fd: socket fd
pub fun tcp_close(num fd) {
  close(fd);
}

compound TcpRoundtripOffloadJob {
  num fd;
  str send_buf;
  str recv_buf;
  num recv_len;
  ChannelCancelToken* cancel_token;
  num result_rc;
}

fun _tcp_roundtrip_core(
  num fd,
  str send_buf,
  str recv_buf,
  num recv_len,
  ChannelCancelToken* cancel_token
) num {
  if recv_buf == nil || recv_len <= 0 {
    ret -1;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  if send_buf != nil {
    num send_len = len(send_buf);
    if send_len > 0 {
      num wrote = tcp_write(fd, send_buf, send_len);
      if wrote < 0 {
        ret -1;
      }
    }
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  num n = tcp_read(fd, recv_buf, recv_len);
  if n < 0 {
    ret -1;
  }
  ret n;
}

fun _tcp_roundtrip_offload_worker(raw* arg) raw* {
  if arg == nil {
    ret nil;
  }

  TcpRoundtripOffloadJob* job = arg;
  job.result_rc = _tcp_roundtrip_core(
    job.fd,
    job.send_buf,
    job.recv_buf,
    job.recv_len,
    job.cancel_token
  );

  ret nil;
}

// Perform a best-effort request/response exchange on an existing socket.
// 
// Params:
// - fd: connected socket descriptor
// - send_buf: optional payload to send first (null/empty skips write)
// - recv_buf: destination buffer for response bytes
// - recv_len: max bytes to read into recv_buf
// - cancel_token: optional cancellation token
// 
// Returns:
// - >= 0 bytes read
// - -1 on invalid args or socket write/read failure
// - -3 when cancelled
pub async fun tcp_roundtrip_async(
  num fd,
  str send_buf,
  str recv_buf,
  num recv_len,
  ChannelCancelToken* cancel_token
) num {
  ret _tcp_roundtrip_core(fd, send_buf, recv_buf, recv_len, cancel_token);
}

// Offload a roundtrip operation to a runtime thread and await its result.
// 
// Notes:
// - Uses runtime_async_spawn so the socket call runs off the caller thread.
// - Cancellation is checked before/after join. Join still waits for worker completion.
// 
// Returns:
// - same codes as tcp_roundtrip_async
// - backend thread start/join error code when spawn/join fails
pub async fun tcp_roundtrip_offload_async(
  num fd,
  str send_buf,
  str recv_buf,
  num recv_len,
  ChannelCancelToken* cancel_token
) num {
  if recv_buf == nil || recv_len <= 0 {
    ret -1;
  }
  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  TcpRoundtripOffloadJob job;
  job.fd = fd;
  job.send_buf = send_buf;
  job.recv_buf = recv_buf;
  job.recv_len = recv_len;
  job.cancel_token = cancel_token;
  job.result_rc = -1;

  RuntimeAsyncTask task = runtime_async_spawn(_tcp_roundtrip_offload_worker, &job);
  if task.last_start_rc() != 0 {
    ret task.last_start_rc();
  }

  num join_rc = await task.join_async(nil);
  if join_rc != 0 {
    ret join_rc;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }
  ret job.result_rc;
}

// Parse a URL, build an HTTP GET request, and publish it to a channel.
// 
// Ownership:
// - The emitted request string is heap-allocated; the receiver should free it.
// 
// Returns:
// - 0 on success
// - 1 when output channel is closed
// - -1 on invalid args or malformed url
// - -2 when request allocation fails
// - -3 when cancelled
pub async fun build_http_get_to_channel_async(
  str raw_url,
  Channel<str>* out_requests,
  ChannelCancelToken* cancel_token
) num {
  if raw_url == nil || out_requests == nil {
    ret -1;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  Url u = parse_url(raw_url);
  if u.host == nil || len(u.host) == 0 {
    ret -1;
  }

  str req = u.build_http_get();
  if req == nil {
    ret -2;
  }

  num rc = await out_requests.send_with_token_async(req, cancel_token);
  if rc == channel_rc_ok() {
    ret 0;
  }

  free(req);
  if rc == channel_rc_cancelled() {
    ret -3;
  }
  if rc == channel_rc_closed() {
    ret 1;
  }
  ret -1;
}

// Serve a single HTTP request with a fixed response.
pub fun http_serve_once(num port, str body) num {
  num server = tcp_listen(port);
  if server < 0 {
    ret -1;
  }
  defer tcp_close(server);

  num client = tcp_accept(server);
  if client < 0 {
    ret -1;
  }

  str buf = malloc(1024);
  if buf != nil {
    tcp_read(client, buf, 1023);
    free(buf);
  }

  str hdr = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n";
  tcp_write(client, hdr, len(hdr));
  tcp_write(client, body, len(body));
  tcp_close(client);
  ret 0;
}

// Serve a single HTTP request with Result.
pub fun try_http_serve_once(num port, str body) Result<num> {
  num rc = http_serve_once(port, body);
  if rc != 0 {
    ret err(1, "http_serve_once failed", rc);
  }
  ret ok(rc);
}

// Serve HTTP requests forever (blocking loop).
pub fun http_serve_forever(num port, str body) num {
  num server = tcp_listen(port);
  if server < 0 {
    ret -1;
  }
  defer tcp_close(server);

  for true {
    num client = tcp_accept(server);
    if client < 0 {
      ret -1;
    }

    str buf = malloc(1024);
    if buf != nil {
      tcp_read(client, buf, 1023);
      free(buf);
    }

    str hdr = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n";
    tcp_write(client, hdr, len(hdr));
    tcp_write(client, body, len(body));
    tcp_close(client);
  }
  ret 0;
}

// Serve HTTP requests forever with Result.
pub fun try_http_serve_forever(num port, str body) Result<num> {
  num rc = http_serve_forever(port, body);
  if rc != 0 {
    ret err(1, "http_serve_forever failed", rc);
  }
  ret ok(rc);
}
