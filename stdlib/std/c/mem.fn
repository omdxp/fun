// C standard library utilities (stdlib.h)
// 
// These are C bindings; ownership/lifetime rules are C rules.
// Pointers are represented as raw*.

// Memory management
// Allocates `size` bytes, returning null on failure (C semantics).
pub fun malloc(num size) raw*;

// Allocates an array of `count` elements of `size` bytes each,
// zero-initialized. Returns null on failure (C semantics).
pub fun calloc(num count, num size) raw*;

// Resizes an existing allocation (`ptr` may be null). Returns null on
// failure (C semantics).
pub fun realloc(raw* ptr, num size) raw*;

// Frees an allocation created by malloc/calloc/realloc (`ptr` may be null).
pub fun free(raw* ptr);

// Process control
// Exits the process with the given exit code.
pub fun exit(num code);

// Abnormal process termination.
pub fun abort();

// Registers a function pointer (as raw*) to be called at normal process
// termination. Returns 0 on success, nonzero on failure (C semantics).
pub fun atexit(raw* func) num;

// Invokes a command processor to execute `command`, returning an
// implementation-defined status code (C semantics).
pub fun system(str command) num;

// Environment
// Looks up an environment variable, returning null if missing (C semantics).
pub fun getenv(str name) str;

// Sets an environment variable for this process, and so for every process
// it starts afterward. A zero `overwrite` leaves a value already there
// alone. Returns 0 on success. Windows has no function of this name, so
// codegen writes one in terms of what it does have.
pub fun setenv(str name, str value, num overwrite) num;

// Removes an environment variable. Returns 0 on success.
pub fun unsetenv(str name) num;

// Conversions
// Parses an integer in base-10 (C semantics).
pub fun atoi(str s) num;

// Parses a long integer in base-10 (C semantics).
pub fun atol(str s) num;

// Parses a floating point number (C semantics).
pub fun atof(str s) dec;

// Parses an integer from `nptr` in the given base (0, 2..36), writing the
// first unparsed char to `endptr` (C semantics).
pub fun strtol(str nptr, str endptr, num base) num;

// Parses an unsigned integer from `nptr` in the given base (0, 2..36),
// writing the first unparsed char to `endptr` (C semantics).
pub fun strtoul(str nptr, str endptr, num base) num;

// Parses a floating point number from `nptr`, writing the first unparsed
// char to `endptr` (C semantics).
pub fun strtod(str nptr, str endptr) dec;

// Random
// Returns a pseudo-random integer in the range 0..RAND_MAX (C semantics).
pub fun rand() num;

// Seeds the pseudo-random number generator.
pub fun srand(num seed);

// Search/sort (comparator function pointers are passed as raw*)
// Binary searches a sorted array (`base`, `nmemb` elements of `size` bytes,
// compared with `compar`) for `key`. Returns a pointer to the matching
// element or null (C semantics).
pub fun bsearch(raw* key, raw* base, num nmemb, num size, raw* compar) raw*;

// Sorts an array in-place (`base`, `nmemb` elements of `size` bytes,
// compared with `compar`).
pub fun qsort(raw* base, num nmemb, num size, raw* compar);
