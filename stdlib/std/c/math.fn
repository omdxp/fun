// C math library bindings (math.h). Trigonometric functions use radians;
// domain/range errors follow the platform C library behavior (C semantics).

// Sine of `x` (radians).
pub fun sin(dec x) dec;

// Cosine of `x` (radians).
pub fun cos(dec x) dec;

// Tangent of `x` (radians).
pub fun tan(dec x) dec;

// Arcsine of `x`.
pub fun asin(dec x) dec;

// Arccosine of `x`.
pub fun acos(dec x) dec;

// Arctangent of `x`.
pub fun atan(dec x) dec;

// Arctangent of `y / x`, using the sign of both to pick the right quadrant.
pub fun atan2(dec y, dec x) dec;

// Square root of `x`.
pub fun sqrt(dec x) dec;

// Cube root of `x`.
pub fun cbrt(dec x) dec;

// `x` raised to the power `y`.
pub fun pow(dec x, dec y) dec;

// `e` raised to `x`.
pub fun exp(dec x) dec;

// Natural logarithm of `x`.
pub fun log(dec x) dec;

// Base-10 logarithm of `x`.
pub fun log10(dec x) dec;

// Base-2 logarithm of `x`.
pub fun log2(dec x) dec;

// Largest integer value not greater than `x`.
pub fun floor(dec x) dec;

// Smallest integer value not less than `x`.
pub fun ceil(dec x) dec;

// `x` rounded to the nearest integer value.
pub fun round(dec x) dec;

// `x` rounded to the nearest integer, returned as a whole number rather
// than a decimal. This is how a decimal becomes a whole number: the
// conversion happens in C, where the result type already is one.
pub fun llround(dec x) num;

// `x` truncated toward zero.
pub fun trunc(dec x) dec;

// Absolute value of `x`.
pub fun fabs(dec x) dec;

// Floating-point remainder of `x / y`.
pub fun fmod(dec x, dec y) dec;

// Hypotenuse length `sqrt(x*x + y*y)`.
pub fun hypot(dec x, dec y) dec;

// `x` with the sign of `y`.
pub fun copysign(dec x, dec y) dec;

// Single-precision (`f32`) versions of the functions above, computed in
// `float` rather than widened to `double`.

// Sine of `x` (radians), in single precision.
pub fun sinf(f32 x) f32;

// Cosine of `x` (radians), in single precision.
pub fun cosf(f32 x) f32;

// Tangent of `x` (radians), in single precision.
pub fun tanf(f32 x) f32;

// Arcsine of `x`, in radians, in single precision.
pub fun asinf(f32 x) f32;

// Arccosine of `x`, in radians, in single precision.
pub fun acosf(f32 x) f32;

// Arctangent of `x`, in radians, in single precision.
pub fun atanf(f32 x) f32;

// Square root of `x`, in single precision.
pub fun sqrtf(f32 x) f32;

// `e` raised to `x`, in single precision.
pub fun expf(f32 x) f32;

// Natural logarithm of `x`, in single precision.
pub fun logf(f32 x) f32;

// Largest whole number not greater than `x`, in single precision.
pub fun floorf(f32 x) f32;

// Smallest whole number not less than `x`, in single precision.
pub fun ceilf(f32 x) f32;

// `x` rounded to the nearest whole number, halfway cases away from zero, in single precision.
pub fun roundf(f32 x) f32;

// `x` truncated toward zero, in single precision.
pub fun truncf(f32 x) f32;

// Absolute value of `x`, in single precision.
pub fun fabsf(f32 x) f32;

// Arctangent of `y / x`, using both signs to pick the quadrant, in single precision.
pub fun atan2f(f32 y, f32 x) f32;

// `x` raised to the power `y`, in single precision.
pub fun powf(f32 x, f32 y) f32;

// Floating-point remainder of `x / y`, in single precision.
pub fun fmodf(f32 x, f32 y) f32;

// Hypotenuse length `sqrt(x*x + y*y)`, in single precision.
pub fun hypotf(f32 x, f32 y) f32;

// Smaller of `x` and `y`, in single precision.
pub fun fminf(f32 x, f32 y) f32;

// Larger of `x` and `y`, in single precision.
pub fun fmaxf(f32 x, f32 y) f32;
