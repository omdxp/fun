// C math library bindings (math.h). Trigonometric functions use radians;
// domain/range errors follow the platform C library behavior (C semantics).

// Sine of `x` (radians).
pub fun sin(dec x) dec;

// Cosine of `x` (radians).
pub fun cos(dec x) dec;

// Tangent of `x` (radians).
pub fun tan(dec x) dec;

// Arcsine of `x`.
pub fun asin(dec x) dec;

// Arccosine of `x`.
pub fun acos(dec x) dec;

// Arctangent of `x`.
pub fun atan(dec x) dec;

// Arctangent of `y / x`, using the sign of both to pick the right quadrant.
pub fun atan2(dec y, dec x) dec;

// Square root of `x`.
pub fun sqrt(dec x) dec;

// Cube root of `x`.
pub fun cbrt(dec x) dec;

// `x` raised to the power `y`.
pub fun pow(dec x, dec y) dec;

// `e` raised to `x`.
pub fun exp(dec x) dec;

// Natural logarithm of `x`.
pub fun log(dec x) dec;

// Base-10 logarithm of `x`.
pub fun log10(dec x) dec;

// Base-2 logarithm of `x`.
pub fun log2(dec x) dec;

// Largest integer value not greater than `x`.
pub fun floor(dec x) dec;

// Smallest integer value not less than `x`.
pub fun ceil(dec x) dec;

// `x` rounded to the nearest integer value.
pub fun round(dec x) dec;

// `x` truncated toward zero.
pub fun trunc(dec x) dec;

// Absolute value of `x`.
pub fun fabs(dec x) dec;

// Floating-point remainder of `x / y`.
pub fun fmod(dec x, dec y) dec;

// Hypotenuse length `sqrt(x*x + y*y)`.
pub fun hypot(dec x, dec y) dec;

// `x` with the sign of `y`.
pub fun copysign(dec x, dec y) dec;
