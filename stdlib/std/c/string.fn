// C strings and memory utilities (string.h)
// 
// `str` models a C `char*` in these bindings.
// Most operations assume NUL-terminated strings and valid pointers.

// Returns the length of a NUL-terminated string (bytes before the
// terminating NUL, C semantics).
pub fun strlen(str s) num;

// Lexicographically compares two NUL-terminated strings, returning <0, 0, >0
// (C semantics).
pub fun strcmp(str a, str b) num;

// Compares up to n characters of two strings, returning <0, 0, >0 (C semantics).
pub fun strncmp(str a, str b, num n) num;

// Finds the first occurrence of character c in s, returning a pointer into
// s or null (C semantics).
pub fun strchr(str s, chr c) str;

// Finds the last occurrence of character c in s, returning a pointer into s
// or null (C semantics).
pub fun strrchr(str s, chr c) str;

// Returns the length in bytes of the initial segment of s that contains
// none of the characters in reject (C semantics).
pub fun strcspn(str s, str reject) num;

// Returns the length in bytes of the initial segment of s that contains
// only characters from accept (C semantics).
pub fun strspn(str s, str accept) num;

// Finds the first character in s that matches any character in accept,
// returning a pointer into s or null (C semantics).
pub fun strpbrk(str s, str accept) str;

// Tokenizes s using the delimiter character set delim; pass null for s to
// continue tokenizing. Returns the next token or null (C semantics).
pub fun strtok(str s, str delim) str;

// Returns a human-readable message for error number errnum (C semantics).
pub fun strerror(num errnum) str;

// Copies NUL-terminated string src into dst, returning dst (C semantics).
pub fun strcpy(str dst, str src) str;

// Copies up to n characters of src into dst, returning dst (C semantics).
pub fun strncpy(str dst, str src, num n) str;

// Appends src to dst (dst must have room), returning dst (C semantics).
pub fun strcat(str dst, str src) str;

// Appends up to n characters from src to dst (dst must have room),
// returning dst (C semantics).
pub fun strncat(str dst, str src, num n) str;

// Finds the first occurrence of needle in haystack, returning a pointer
// into haystack or null (C semantics).
pub fun strstr(str haystack, str needle) str;

// Copies n bytes from src to dst (no overlap allowed), returning dst (C semantics).
pub fun memcpy(raw* dst, raw* src, num n) raw*;

// Copies n bytes from src to dst (overlap allowed), returning dst (C semantics).
pub fun memmove(raw* dst, raw* src, num n) raw*;

// Sets n bytes of dst to byte value val, returning dst (C semantics).
pub fun memset(raw* dst, num val, num n) raw*;

// Compares n bytes of two memory areas, returning <0, 0, >0 (C semantics).
pub fun memcmp(raw* a, raw* b, num n) num;

// Searches for byte value c in the first n bytes of s, returning a pointer
// to the matching byte or null (C semantics).
fun memchr(raw* s, num c, num n) raw*;
