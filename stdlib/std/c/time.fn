// Time and date bindings (time.h)
// 
// Values follow C `time.h` semantics and platform libc behavior. Some
// functions return pointers to static storage (C semantics).

// Broken-down local or UTC time components.
pub compound tm {
  // Seconds after the minute (0..60).
  num tm_sec;
  // Minutes after the hour (0..59).
  num tm_min;
  // Hours since midnight (0..23).
  num tm_hour;
  // Day of the month (1..31).
  num tm_mday;
  // Months since January (0..11).
  num tm_mon;
  // Years since 1900.
  num tm_year;
  // Days since Sunday (0..6).
  num tm_wday;
  // Days since January 1 (0..365).
  num tm_yday;
  // Daylight Saving Time flag (>0 in effect, 0 not in effect, <0 unknown).
  num tm_isdst;
}

// Timespec payload used by POSIX timed APIs.
pub compound timespec {
  // Whole seconds.
  num tv_sec;
  // Nanoseconds component (0..999999999).
  num tv_nsec;
}

// Returns the current calendar time, optionally also writing it to `tloc`
// (may be null).
pub fun time(num* tloc) num;

// Returns processor time consumed by the program, or -1 if not available (C semantics).
pub fun clock() num;

// Reads the current time for POSIX clock `clk_id` (`CLOCK_REALTIME` is
// typically 0) into `tp`. Returns 0 on success, nonzero on failure (C semantics).
pub fun clock_gettime(num clk_id, raw* tp) num;

// Returns the difference time1 - time0 in seconds as dec (C semantics).
pub fun difftime(num time1, num time0) dec;

// Converts broken-down local time to calendar time, or -1 on failure (C semantics).
pub fun mktime(raw* t) num;

// Converts broken-down time to a textual representation (pointer to static
// string, C semantics).
pub fun asctime(raw* t) str;

// Converts calendar time to a textual representation (pointer to static
// string, C semantics).
pub fun ctime(num* timep) str;

// Converts calendar time to UTC broken-down time (pointer to static tm, C semantics).
pub fun gmtime(num* timep) raw*;

// Converts calendar time to local broken-down time (pointer to static tm, C semantics).
pub fun localtime(num* timep) raw*;

// Formats broken-down time `t` into `s` (capacity `max`) according to
// `format`, returning the number of bytes written (C semantics).
pub fun strftime(str s, num max, str format, raw* t) num;
