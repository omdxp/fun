// POSIX sockets (sys/socket.h, netinet/in.h, arpa/inet.h, unistd.h)
// 
// These are declarations only; implementations come from system libc.
// This module targets POSIX-style sockets.

// Socket API
// Creates a socket descriptor, returning the fd or -1 (C semantics).
pub fun socket(num domain, num type, num protocol) num;
// Binds a socket to a local address. Returns 0 on success, -1 on error (C semantics).
pub fun bind(num sockfd, raw* addr, num addrlen) num;
// Marks a socket as listening with the given backlog. Returns 0 on success,
// -1 on error (C semantics).
pub fun listen(num sockfd, num backlog) num;
// Accepts a connection from a listening socket (`addr`/`addrlen` may be
// null). Returns the client fd or -1 (C semantics).
pub fun accept(num sockfd, raw* addr, raw* addrlen) num;
// Receives up to `len` bytes from a socket into `buf`. Returns bytes read or
// -1 (C semantics).
pub fun recv(num sockfd, raw* buf, num len, num flags) num;
// Sends up to `len` bytes from `buf` to a socket. Returns bytes sent or -1
// (C semantics).
pub fun send(num sockfd, raw* buf, num len, num flags) num;
// Closes a file/socket descriptor. Returns 0 on success, -1 on error (C semantics).
pub fun close(num fd) num;

// Byte order helpers
// Converts a short from host to network byte order.
pub fun htons(num hostshort) num;
// Converts a long from host to network byte order.
pub fun htonl(num hostlong) num;
// Converts a short from network to host byte order.
pub fun ntohs(num netshort) num;
// Converts a long from network to host byte order.
pub fun ntohl(num netlong) num;

// Address parsing
// Parses an IPv4 address string, returning it in network byte order (C semantics).
pub fun inet_addr(str cp) num;
