// BSD-style sockets: POSIX (sys/socket.h, netinet/in.h, arpa/inet.h,
// unistd.h) on Linux/macOS, Winsock2 on Windows.
//
// These are declarations only; implementations come from the system libc
// on POSIX. On Windows the compiler's prelude redirects `socket` to a
// wrapper that runs `WSAStartup` once before delegating to the real
// Winsock `socket()`, and `close` to one that tries `_close` then
// `closesocket`; every other name here (`bind`, `listen`, `accept`,
// `recv`, `send`, `htons`, ...) matches Winsock2's own naming directly.

// Socket API
// Creates a socket descriptor, returning the fd or -1 (C semantics).
pub fun socket(num domain, num type, num protocol) num;
// Binds a socket to a local address. Returns 0 on success, -1 on error (C semantics).
pub fun bind(num sockfd, raw* addr, num addrlen) num;
// Marks a socket as listening with the given backlog. Returns 0 on success,
// -1 on error (C semantics).
pub fun listen(num sockfd, num backlog) num;
// Accepts a connection from a listening socket (`addr`/`addrlen` may be
// null). Returns the client fd or -1 (C semantics).
pub fun accept(num sockfd, raw* addr, raw* addrlen) num;
// Connects a socket to a remote address. Returns 0 on success, -1 on error
// (C semantics).
pub fun connect(num sockfd, raw* addr, num addrlen) num;
// Receives up to `len` bytes from a socket into `buf`. Returns bytes read or
// -1 (C semantics).
pub fun recv(num sockfd, raw* buf, num len, num flags) num;
// Sends up to `len` bytes from `buf` to a socket. Returns bytes sent or -1
// (C semantics).
pub fun send(num sockfd, raw* buf, num len, num flags) num;
// Closes a file/socket descriptor. Returns 0 on success, -1 on error (C semantics).
pub fun close(num fd) num;

// Byte order helpers
// Converts a short from host to network byte order.
pub fun htons(num hostshort) num;
// Converts a long from host to network byte order.
pub fun htonl(num hostlong) num;
// Converts a short from network to host byte order.
pub fun ntohs(num netshort) num;
// Converts a long from network to host byte order.
pub fun ntohl(num netlong) num;

// Address parsing
// Parses an IPv4 address string, returning it in network byte order (C semantics).
pub fun inet_addr(str cp) num;

// Sets both the receive and send timeout on `fd` to `ms` milliseconds (0
// disables the timeout, the socket's own default). A compiler-emitted
// shim, not a direct libc binding: the real socket option's value shape
// differs by platform (a `struct timeval` on POSIX, a plain millisecond
// count on Windows) even though the option itself is conceptually the
// same on both, the same reason `std.c.atomic`'s operations are shims
// rather than plain bindings. Returns 0 on success, -1 on failure.
pub fun __fun_socket_set_timeout(num fd, num ms) num;

// Marks a listening socket's address reusable, so a fresh bind to the
// same port doesn't wait out the previous socket's own TIME_WAIT state.
// POSIX only: on Windows SO_REUSEADDR has different, more permissive
// semantics (it can let a bind succeed against a port another socket is
// still actively using), so this shim is a deliberate no-op there -
// Windows doesn't block an immediate rebind the way POSIX does anyway.
// Returns 0 on success, -1 on failure (always 0 on Windows).
pub fun __fun_socket_set_reuseaddr(num fd) num;

// Resolves `host` (a hostname or an already-numeric IPv4 address) to its
// numeric dotted-quad form via a real DNS lookup, or a null pointer on
// failure. A shim over `getaddrinfo`/`inet_ntop` rather than a direct
// binding: the former's own C signature (an output `struct addrinfo**`,
// a hints struct) isn't something a caller should have to build by hand
// for the single common case of "give me one IPv4 address back".
pub fun __fun_resolve_host(str host) str;
