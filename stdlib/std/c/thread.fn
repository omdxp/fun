// POSIX thread bindings (pthread.h)
// 
// These are declarations only; implementations come from your system libc.
// This module targets POSIX pthread APIs. Function-pointer parameters are
// modeled as raw*. Unless noted otherwise, these return 0 on success and a
// nonzero error code on failure (C semantics).

// Thread lifecycle
// Creates a new thread running start_routine(arg), writing its handle to `thread`.
pub fun pthread_create(pthread_t* thread, pthread_attr_t* attr, raw* start_routine, raw* arg) num;

// Waits for a thread to terminate, optionally writing its return value to `retval`.
pub fun pthread_join(pthread_t thread, raw* retval) num;

// Detaches a thread so its resources are released automatically on exit.
pub fun pthread_detach(pthread_t thread) num;

// Returns the calling thread's handle.
pub fun pthread_self() pthread_t;

// Thread attributes
// Initializes a thread-attributes object with default values.
pub fun pthread_attr_init(pthread_attr_t* attr) num;

// Sets the stack size (bytes) a thread created with `attr` will use.
pub fun pthread_attr_setstacksize(pthread_attr_t* attr, num stacksize) num;

// Destroys a thread-attributes object. The thread itself is unaffected
// once created; only the attributes object's own resources are freed.
pub fun pthread_attr_destroy(pthread_attr_t* attr) num;

// Compares two thread handles, returning nonzero when equal, 0 otherwise (C semantics).
pub fun pthread_equal(pthread_t t1, pthread_t t2) num;

// Mutex
// Initializes a mutex (`attr` null for defaults).
pub fun pthread_mutex_init(pthread_mutex_t* mutex, pthread_mutexattr_t* attr) num;

// Destroys a mutex.
pub fun pthread_mutex_destroy(pthread_mutex_t* mutex) num;

// Locks a mutex, blocking until available.
pub fun pthread_mutex_lock(pthread_mutex_t* mutex) num;

// Tries to lock a mutex without blocking; returns an error code if unavailable.
pub fun pthread_mutex_trylock(pthread_mutex_t* mutex) num;

// Unlocks a mutex.
pub fun pthread_mutex_unlock(pthread_mutex_t* mutex) num;

// Condition variables
// Initializes a condition variable (`attr` null for defaults).
pub fun pthread_cond_init(pthread_cond_t* cond, pthread_condattr_t* attr) num;

// Destroys a condition variable.
pub fun pthread_cond_destroy(pthread_cond_t* cond) num;

// Waits on a condition variable, atomically releasing `mutex` while waiting
// and reacquiring it before returning.
pub fun pthread_cond_wait(pthread_cond_t* cond, pthread_mutex_t* mutex) num;

// Waits on a condition variable until the absolute deadline `abstime`
// (`struct timespec*`, C semantics) is reached.
pub fun pthread_cond_timedwait(pthread_cond_t* cond, pthread_mutex_t* mutex, raw* abstime) num;

// Wakes one thread waiting on a condition variable.
pub fun pthread_cond_signal(pthread_cond_t* cond) num;

// Wakes all threads waiting on a condition variable.
pub fun pthread_cond_broadcast(pthread_cond_t* cond) num;
