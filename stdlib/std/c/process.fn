// POSIX process bindings (unistd.h / sys/wait.h / spawn.h).
// 
// Notes:
// - These are declarations only; implementations come from your system libc.
// - Spawning goes through `posix_spawn` (declarative dup2/close file actions)
// rather than raw `fork`+`exec` -- not because of a naming conflict with
// Fun's own `fork` keyword (that's resolved: `fork` is contextual, reserved
// only in statement position `fork some_call();`, so a bare libc `fork()`
// binding is legal too), but because `posix_spawn` is the modern, recommended
// POSIX spawn API: no copy-on-write full-address-space duplication, and safe
// to call from a multithreaded process, unlike raw `fork`.
// - `waitpid`'s status is decoded manually in Fun (via bit ops on the raw
// `num`) rather than through the `WIFEXITED`/`WEXITSTATUS` C macros, since
// function-like macros can't be bound as Fun signatures (see std.c.def).
// The encoding used (`(status & 0x7f) == 0` for normal exit, exit code in
// bits 8-15) matches glibc and the BSD/Darwin libc's wait(2) layout.

// Duplicate a file descriptor onto a specific fd number, closing the target
// first if it was already open.
// 
// Params:
// - oldfd: existing open file descriptor
// - newfd: target file descriptor number
// 
// Returns:
// - newfd on success, -1 on failure (C semantics)
pub fun dup2(num oldfd, num newfd) num;

// Close a file descriptor.
// 
// Params:
// - fd: file descriptor to close
// 
// Returns:
// - 0 on success, -1 on failure (C semantics)
pub fun close(num fd) num;

// Read up to `count` bytes from a file descriptor into `buf`.
// 
// Params:
// - fd: file descriptor to read from
// - buf: destination buffer
// - count: maximum bytes to read
// 
// Returns:
// - number of bytes read (0 at end-of-file), or -1 on failure (C semantics)
pub fun read(num fd, raw* buf, num count) num;

// Write up to `count` bytes from `buf` to a file descriptor.
// 
// Params:
// - fd: file descriptor to write to
// - buf: source buffer
// - count: bytes to write
// 
// Returns:
// - number of bytes written, or -1 on failure (C semantics)
pub fun write(num fd, raw* buf, num count) num;

// Create a unidirectional data channel (a pipe).
// 
// Params:
// - fds: pointer to a 2-element i32 buffer (real C `int[2]`, NOT `num`/64-bit
// -- a width-mismatched output pointer here would only get its low 4 bytes
// written by libc, leaving the rest of a `num` slot as garbage); fds[0]
// becomes the read end, fds[1] the write end
// 
// Returns:
// - 0 on success, -1 on failure (C semantics)
pub fun pipe(i32* fds) num;

// Fork the calling process. Prefer `posix_spawnp` for actually spawning a
// program (below) -- it's the modern, recommended POSIX API (no
// copy-on-write full-address-space duplication, safe from a multithreaded
// process) -- but a bare `fork` is exposed here too for callers that need
// the classic fork/exec split directly. Legal to call under its real libc
// name: Fun's own `fork` keyword is contextual (reserved only in statement
// position, `fork some_call();`), so `fork()` used as an ordinary call
// resolves to this binding instead.
// 
// Returns:
// - 0 in the child process
// - the child's process id in the parent process
// - -1 on failure (C semantics)
pub fun fork() num;

// Replace the current process image, searching PATH for `file`, passing
// `argv` as the new program's argument vector. For use after a manual
// `fork()` in the child, as an alternative to `posix_spawnp`.
// 
// Params:
// - file: program name (searched via PATH if it contains no '/')
// - argv: NULL-terminated argument vector (argv[0] conventionally repeats
// the program name); must remain valid until exec succeeds or fails
// 
// Returns:
// - does not return on success; -1 on failure (C semantics)
pub fun execvp(str file, str[] argv) num;

// Terminate the calling process immediately, without running atexit
// handlers or flushing stdio buffers. Use in a forked child after `execvp`
// fails, so a failed exec can't fall through into the parent's own code path.
// 
// Params:
// - code: exit status
pub fun _exit(num code);

// Return the current process's environment (`char** environ`), for passing
// straight through to `posix_spawn` so the child inherits it.
pub fun environ_ptr() str[];

// Opaque set of child-side file actions (dup2/close operations) applied,
// in order, right after `posix_spawn` forks and before it execs.
pub fun posix_spawn_file_actions_init(posix_spawn_file_actions_t* actions) num;
pub fun posix_spawn_file_actions_destroy(posix_spawn_file_actions_t* actions) num;
pub fun posix_spawn_file_actions_adddup2(
  posix_spawn_file_actions_t* actions,
  num fildes,
  num newfildes
) num;
pub fun posix_spawn_file_actions_addclose(posix_spawn_file_actions_t* actions, num fildes) num;

// Spawn a new process running `path`, searching PATH (posix_spawnp
// variant), applying `file_actions` in the child before exec.
// 
// Params:
// - pid: output pointer for the new child's process id (real C `pid_t*`,
// NOT `num*`/64-bit -- same width-mismatch hazard as the `pipe`/`waitpid`
// notes above; `pid_t` is a plain 32-bit `int` on Darwin/glibc)
// - file: program name (searched via PATH, like execvp)
// - file_actions: dup2/close actions to apply in the child (may be null)
// - argv: NULL-terminated argument vector (argv[0] conventionally repeats
// the program name)
// - envp: NULL-terminated environment vector (pass `environ_ptr()` to
// inherit the parent's environment)
// 
// Returns:
// - 0 on success (the child was spawned; `pid` is set)
// - nonzero errno-style error code on failure (C semantics; `pid` untouched)
pub fun posix_spawnp(
  pid_t* pid,
  str file,
  posix_spawn_file_actions_t* file_actions,
  posix_spawnattr_t* attrp,
  str[] argv,
  str[] envp
) num;

// Wait for a specific child process to change state (here: to exit).
// 
// Params:
// - pid: child process id to wait for
// - status: output pointer for the raw wait status (real C `int*`, see the
// `pipe` note above on why this is `i32*` and not `num*`) -- decode with
// the bit ops described in this module's header comment
// - options: wait flags (0 for a normal blocking wait)
// 
// Returns:
// - the pid of the child whose state changed, or -1 on failure (C semantics)
pub fun waitpid(num pid, i32* status, num options) num;
