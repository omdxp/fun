// C standard I/O bindings (stdio.h)
// 
// This module declares common stdio types and functions so Fun programs can
// call into the platform C library. These are declarations only —
// implementations come from your system libc — and error reporting follows
// C conventions (return values + errno).

// Opaque stdio types
pub compound FILE {
  // Opaque payload (represents the underlying FILE structure).
  num _opaque;
}

// Prints formatted output to stdout. Returns the number of characters
// written, or negative on error (C semantics).
pub fun printf(str fmt, ...) num;

// Prints formatted output to a stream (e.g. stderr). Returns the number of
// characters written, or negative on error (C semantics).
pub fun fprintf(FILE* stream, str fmt, ...) num;

// Standard-stream accessors. `stdout`/`stderr`/`stdin` are libc macros/globals,
// not callable symbols and not portable as `extern FILE*` (MSVCRT resolves them
// via a function call). The compiler emits tiny `static FILE* fun_*_stream()`
// wrappers in the prelude that these bind to, so writing to stderr/stdin is
// portable across glibc/musl/macOS/Windows.

// The FILE* for the process's standard output stream.
pub fun stdout_stream() FILE*;

// The FILE* for the process's standard error stream.
pub fun stderr_stream() FILE*;

// The FILE* for the process's standard input stream.
pub fun stdin_stream() FILE*;

// Switch stdin and stdout to binary mode on Windows, suppressing the
// CRLF translation that breaks binary-framed protocols over stdio pipes.
// Emits a no-op stub on non-Windows; safe to call unconditionally.
pub fun set_binary_stdio();

// Formats output into buffer `dst`. Returns the number of characters
// written (excluding the trailing NUL), or negative on error (C semantics).
pub fun sprintf(str dst, str fmt, ...) num;

// Formats output into buffer `dst`, writing at most `n` bytes. Returns the
// number of characters that would have been written (excluding NUL), or
// negative on error (C semantics).
pub fun snprintf(str dst, num n, str fmt, ...) num;

// Scans formatted input from stdin into the given output pointers (C
// semantics). Returns the number of items read, or EOF on failure.
pub fun scanf(str fmt, ...) num;

// Scans formatted input from string `src` into the given output pointers
// (C semantics). Returns the number of items read, or EOF on failure.
pub fun sscanf(str src, str fmt, ...) num;

// Writes a string and a trailing newline to stdout. Returns nonnegative on
// success, or EOF on error (C semantics).
pub fun puts(str s) num;

// Writes a single character to stdout. Returns the character written, or
// EOF on error (C semantics).
pub fun putchar(chr c) num;

// Reads a single character from stdin. Returns the byte read, or EOF (C
// semantics).
pub fun getchar() num;

// File IO

// Opens the file at `path` with the given fopen mode string (e.g. "r",
// "wb"). Returns a FILE* handle, or null on failure.
pub fun fopen(str path, str mode) FILE*;

// Reopens `stream` with a new file and fopen mode. Returns a FILE* handle,
// or null on failure.
pub fun freopen(str path, str mode, FILE* stream) FILE*;

// Closes a stream. Returns 0 on success, EOF on failure (C semantics).
pub fun fclose(FILE* stream) num;

// Flushes buffered output to the underlying stream. Returns 0 on success,
// EOF on failure (C semantics).
pub fun fflush(FILE* stream) num;

// Reads a single byte from a stream. Returns the byte read, or EOF (C
// semantics).
pub fun fgetc(FILE* stream) num;

// Writes a single byte to a stream. Returns the byte written, or EOF on
// error (C semantics).
pub fun fputc(num c, FILE* stream) num;

// Reads a line (or up to n-1 bytes) from `stream` into buffer `s`. Returns
// `s` on success, or null (C semantics).
pub fun fgets(str s, num n, FILE* stream) str;

// Writes a string to a stream. Returns nonnegative on success, or EOF on
// error (C semantics).
pub fun fputs(str s, FILE* stream) num;

// Reads `nmemb` elements of `size` bytes each from a stream into `ptr`.
// Returns the number of elements read (C semantics).
pub fun fread(raw* ptr, num size, num nmemb, FILE* stream) num;

// Writes `nmemb` elements of `size` bytes each from `ptr` into a stream.
// Returns the number of elements written (C semantics).
pub fun fwrite(raw* ptr, num size, num nmemb, FILE* stream) num;

// Sets the file position indicator of `stream` to `offset` bytes relative
// to `whence` (e.g. SEEK_SET). Returns 0 on success, nonzero on failure (C
// semantics).
pub fun fseek(FILE* stream, num offset, num whence) num;

// Current file position indicator of `stream`, or negative on failure (C
// semantics).
pub fun ftell(FILE* stream) num;

// Resets the file position indicator of `stream` to the beginning.
pub fun rewind(FILE* stream);

// True (nonzero) if the end-of-file indicator of `stream` is set (C
// semantics).
pub fun feof(FILE* stream) num;

// True (nonzero) if the error indicator of `stream` is set (C semantics).
pub fun ferror(FILE* stream) num;

// Prints a human-readable error message for the current errno, prefixed
// with the optional string `s`.
pub fun perror(str s);

// Removes a file. Returns 0 on success, nonzero on failure (C semantics).
pub fun remove(str path) num;

// Renames (moves) a file from `oldpath` to `newpath`. Returns 0 on success,
// nonzero on failure (C semantics).
pub fun rename(str oldpath, str newpath) num;

// Creates a temporary binary file. Returns a FILE* handle, or null on
// failure.
pub fun tmpfile() FILE*;

// Generates a temporary filename into the optional buffer `s`, or an
// internal static buffer if null (C semantics).
pub fun tmpnam(str s) str;
