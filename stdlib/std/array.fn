// Helper utilities for fixed arrays.

imp std.option;
imp std.quirks;

// View over a generic array.
pub compound Array<T> {
  // Backing storage.
  T[] data;
  // Number of visible elements.
  num len;
}

impl Array<T> {
  // Return the element at index without bounds checking.
  // 
  // Params:
  // - i: element index
  // 
  // Notes:
  // - The caller must ensure `0 <= i < len`.
  // - Use `at()` for bounds-checked access.
  // 
  // Returns:
  // - element at index `i`
  pub get(num i) T {
    ret self.data[i];
  }

  // Return the element at index when it is in range.
  // 
  // Params:
  // - i: element index
  // 
  // Returns:
  // - `Some(value)` when `i` is in range
  // - `None` otherwise
  pub at(num i) Option<T> {
    if i < 0 || i >= self.len {
      ret Option.None;
    }
    ret Option.Some(self.data[i]);
  }

  // Set the element at index without bounds checking.
  // 
  // Params:
  // - i: element index
  // - value: value to write
  // 
  // Notes:
  // - The caller must ensure `0 <= i < len`.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Fill every element with the same value.
  // 
  // Params:
  // - value: value assigned to each element
  pub fill(T value) {
    num i = 0;
    for i < self.len {
      self.data[i] = value;
      i = i + 1;
    }
  }

  // Copy values from a source slice into the array.
  // 
  // Params:
  // - src: source slice
  // - len: number of elements to copy
  // 
  // Notes:
  // - The caller must ensure `len <= self.len`.
  pub copy_from(T[] src, num len) {
    num i = 0;
    for i < len {
      self.data[i] = src[i];
      i = i + 1;
    }
  }

  // Swap two elements in place.
  // 
  // Params:
  // - i: first element index
  // - j: second element index
  pub swap(num i, num j) {
    let tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverse the elements in place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // Return a forward iterator over the elements.
  // 
  // Returns:
  // - iterator yielding each value once, in order
  pub iter() ArrayIter<T> {
    ArrayIter<T> it;
    it.src = self;
    it.idx = 0;
    ret it;
  }
}

impl Array<T> as Sized {
  // Return the number of elements.
  // 
  // Returns:
  // - element count
  pub len() num {
    ret self.len;
  }

  // Return true when the array holds no elements.
  // 
  // Returns:
  // - true when the array is empty
  pub is_empty() bin {
    ret self.len == 0;
  }
}

impl Array<T> as Clearable {
  // Mark the view as empty without freeing the backing storage.
  // 
  // Notes:
  // - The backing storage remains owned by the caller.
  pub clear() {
    self.len = 0;
  }
}

// Forward iterator over an Array produced by `Array.iter()`.
pub compound ArrayIter<T> {
  // Array being iterated (borrowed, not owned).
  Array<T>* src;
  // Index of the next element to yield.
  num idx;
}

impl ArrayIter<T> as Iterator<T> {
  // Return the next element from the iterator.
  // 
  // Returns:
  // - `Some(value)` while elements remain
  // - `None` once the iterator reaches the end
  pub next() Option<T> {
    if self.idx >= self.src.len {
      ret Option.None;
    }
    T value = self.src.data[self.idx];
    self.idx = self.idx + 1;
    ret Option.Some(value);
  }
}

// Sum a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - total sum
pub fun sum_num(num[] arr, num len) num {
  num total = 0;
  num i = 0;
  for i < len {
    total = total + arr[i];
    i = i + 1;
  }
  ret total;
}

// Minimum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - minimum value (0 if empty)
pub fun min_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  let min = arr[0];
  num i = 1;
  for i < len {
    if arr[i] < min {
      min = arr[i];
    }
    i = i + 1;
  }
  ret min;
}

// Maximum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - maximum value (0 if empty)
pub fun max_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  let max = arr[0];
  num i = 1;
  for i < len {
    if arr[i] > max {
      max = arr[i];
    }
    i = i + 1;
  }
  ret max;
}

// Fill a numeric array slice with a value.
// 
// Params:
// - arr: array pointer
// - len: element count
// - value: fill value
pub fun fill_num(num[] arr, num len, num value) {
  num i = 0;
  for i < len {
    arr[i] = value;
    i = i + 1;
  }
}

// Copy between numeric array slices.
// 
// Params:
// - dst: destination array
// - src: source array
// - len: element count
pub fun copy_num(num[] dst, num[] src, num len) {
  num i = 0;
  for i < len {
    dst[i] = src[i];
    i = i + 1;
  }
}
