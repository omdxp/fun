// Helper utilities for fixed arrays.
// 
// Usage:
// ```
// Array<num> a;
// a.data = [1, 2, 3];
// a.len = 3;
// num v = a.get(1);
// ```

imp std.option;
imp std.quirks;

// View over a generic array.
pub compound Array<T> {
  // backing storage
  T[] data;
  // number of elements
  num len;
}

impl Array<T> {
  // Element at index, unchecked. The caller must guarantee `0 <= i < len`;
  // an out-of-range index reads past the backing storage. For safe,
  // bounds-checked access, use `at()`.
  pub get(num i) T {
    ret self.data[i];
  }

  // Bounds-checked element access: `Some(value)` when in range, `None` otherwise.
  pub at(num i) Option<T> {
    if i < 0 || i >= self.len {
      ret Option.None;
    }
    ret Option.Some(self.data[i]);
  }

  // Set element at index, unchecked. The caller must guarantee `0 <= i < len`.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Fill array with a value.
  pub fill(T value) {
    num i = 0;
    for i < self.len {
      self.data[i] = value;
      i = i + 1;
    }
  }

  // Copy values from another array.
  pub copy_from(T[] src, num len) {
    num i = 0;
    for i < len {
      self.data[i] = src[i];
      i = i + 1;
    }
  }

  // Swap two elements.
  pub swap(num i, num j) {
    let tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverse the array in-place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // A forward iterator over the elements (yields each value once, in order).
  pub iter() ArrayIter<T> {
    ArrayIter<T> it;
    it.src = self;
    it.idx = 0;
    ret it;
  }
}

impl Array<T> as Sized {
  // Number of elements.
  pub len() num {
    ret self.len;
  }

  // True when the array holds no elements.
  pub is_empty() bin {
    ret self.len == 0;
  }
}

impl Array<T> as Clearable {
  // Reset the element count to zero (the backing storage is the caller's; this only
  // marks the view as empty, it does not free `data`).
  pub clear() {
    self.len = 0;
  }
}

// Forward iterator over an Array produced by `Array.iter()`.
pub compound ArrayIter<T> {
  // the array being iterated (borrowed, not owned)
  Array<T>* src;
  // index of the next element to yield
  num idx;
}

impl ArrayIter<T> as Iterator<T> {
  // Yield the next element, or None once the end is reached.
  pub next() Option<T> {
    if self.idx >= self.src.len {
      ret Option.None;
    }
    T value = self.src.data[self.idx];
    self.idx = self.idx + 1;
    ret Option.Some(value);
  }
}

// Sum a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - total sum
pub fun sum_num(num[] arr, num len) num {
  num total = 0;
  num i = 0;
  for i < len {
    total = total + arr[i];
    i = i + 1;
  }
  ret total;
}

// Minimum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - minimum value (0 if empty)
pub fun min_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  let min = arr[0];
  num i = 1;
  for i < len {
    if arr[i] < min {
      min = arr[i];
    }
    i = i + 1;
  }
  ret min;
}

// Maximum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - maximum value (0 if empty)
pub fun max_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  let max = arr[0];
  num i = 1;
  for i < len {
    if arr[i] > max {
      max = arr[i];
    }
    i = i + 1;
  }
  ret max;
}

// Fill a numeric array slice with a value.
// 
// Params:
// - arr: array pointer
// - len: element count
// - value: fill value
pub fun fill_num(num[] arr, num len, num value) {
  num i = 0;
  for i < len {
    arr[i] = value;
    i = i + 1;
  }
}

// Copy between numeric array slices.
// 
// Params:
// - dst: destination array
// - src: source array
// - len: element count
pub fun copy_num(num[] dst, num[] src, num len) {
  num i = 0;
  for i < len {
    dst[i] = src[i];
    i = i + 1;
  }
}
