// Helper utilities for fixed arrays.

use std.option;
use std.quirks;
use std.c.mem;

// View over a generic array.
pub compound Array<T> {
  // Backing storage.
  T[] data;
  // Number of visible elements.
  num len;
}

impl Array<T> {
  // Element at index `i`, without bounds checking. The caller must ensure
  // `0 <= i < len`; use `at()` for bounds-checked access.
  pub get(num i) T {
    ret self.data[i];
  }

  // Element at index `i`, or `None` when out of range.
  pub at(num i) Option<T> {
    if i < 0 || i >= self.len {
      ret Option.None;
    }
    ret Option.Some(self.data[i]);
  }

  // Sets the element at index `i`, without bounds checking. The caller
  // must ensure `0 <= i < len`.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Fills every element with `value`.
  pub fill(T value) {
    num i = 0;
    for i < self.len {
      self.data[i] = value;
      i = i + 1;
    }
  }

  // Copies `len` values from `src` into the array. The caller must ensure
  // `len <= self.len`.
  pub copy_from(T[] src, num len) {
    num i = 0;
    for i < len {
      self.data[i] = src[i];
      i = i + 1;
    }
  }

  // Swaps two elements in place.
  pub swap(num i, num j) {
    let tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverses the elements in place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // Forward iterator over the elements, in order.
  pub iter() ArrayIter<T> {
    ArrayIter<T> it;
    it.src = self;
    it.idx = 0;
    ret it;
  }
}

impl Array<T> as Sized {
  // Number of elements in the array.
  pub len() num {
    ret self.len;
  }

  // True when the array holds no elements.
  pub is_empty() flag {
    ret self.len == 0;
  }
}

impl Array<T> as Clearable {
  // Marks the view as empty without freeing the backing storage, which
  // remains owned by the caller.
  pub clear() {
    self.len = 0;
  }
}

// Forward iterator over an Array produced by `Array.iter()`.
pub compound ArrayIter<T> {
  // Array being iterated (borrowed, not owned).
  Array<T>* src;
  // Index of the next element to yield.
  num idx;
}

impl ArrayIter<T> as Iterator<T> {
  // Next element, or `None` once the iterator reaches the end.
  pub next() Option<T> {
    if self.idx >= self.src.len {
      ret Option.None;
    }
    T value = self.src.data[self.idx];
    self.idx = self.idx + 1;
    ret Option.Some(value);
  }
}

// Sum of a numeric array slice.
pub fun sum_num(num[] arr, num len) num {
  num total = 0;
  num i = 0;
  for i < len {
    total = total + arr[i];
    i = i + 1;
  }
  ret total;
}

// Minimum value in a numeric array slice (0 if empty).
pub fun min_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  let min = arr[0];
  num i = 1;
  for i < len {
    if arr[i] < min {
      min = arr[i];
    }
    i = i + 1;
  }
  ret min;
}

// Maximum value in a numeric array slice (0 if empty).
pub fun max_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  let max = arr[0];
  num i = 1;
  for i < len {
    if arr[i] > max {
      max = arr[i];
    }
    i = i + 1;
  }
  ret max;
}

// Fills a numeric array slice with `value`.
pub fun fill_num(num[] arr, num len, num value) {
  num i = 0;
  for i < len {
    arr[i] = value;
    i = i + 1;
  }
}

// Copies `len` elements from `src` into `dst`.
pub fun copy_num(num[] dst, num[] src, num len) {
  num i = 0;
  for i < len {
    dst[i] = src[i];
    i = i + 1;
  }
}

fun _sample() Array<num> {
  Array<num> a;
  a.data = malloc(sizeof(num) * 5);
  a.len = 5;
  num i = 0;
  for i < 5 {
    a.set(i, i + 1);
    i = i + 1;
  }
  ret a;
}

test "an array reads, writes and reports its length" {
  Array<num> a = _sample();
  assert a.get(0) == 1 && a.get(4) == 5, "expected the values set";
  assert a.len() == 5 && !a.is_empty(), "expected five elements";
  assert a.at(2).unwrap() == 3, "expected a checked read";
  assert a.at(5).is_none() && a.at(-1).is_none(), "expected out-of-range reads to be None";
  a.clear();
  assert a.is_empty() && a.len() == 0, "expected clear to empty it";
}

test "swap, reverse, fill and copy_from" {
  Array<num> a = _sample();
  a.swap(0, 4);
  assert a.get(0) == 5 && a.get(4) == 1, "expected the ends swapped";
  a.reverse();
  assert a.get(0) == 1 && a.get(1) == 4 && a.get(2) == 3 && a.get(4) == 5, "expected the order reversed";
  a.fill(9);
  assert a.get(0) == 9 && a.get(3) == 9, "expected every element filled";
  num[] src = malloc(sizeof(num) * 3);
  src[0] = 7;
  src[1] = 8;
  src[2] = 6;
  a.copy_from(src, 3);
  assert a.get(0) == 7 && a.get(2) == 6 && a.get(3) == 9, "expected the first three copied";
  Array<num> one;
  one.data = malloc(sizeof(num));
  one.len = 1;
  one.set(0, 4);
  one.reverse();
  assert one.get(0) == 4, "expected reversing one element to change nothing";
}

test "an array iterates in order" {
  Array<num> a = _sample();
  num total = 0;
  num count = 0;
  for v : a.iter() {
    total = total + v;
    count = count + 1;
  }
  assert total == 15 && count == 5, "expected every element visited once";
}

test "the plain number-array helpers" {
  num[] xs = malloc(sizeof(num) * 4);
  xs[0] = 4;
  xs[1] = -2;
  xs[2] = 9;
  xs[3] = 1;
  assert sum_num(xs, 4) == 12, "expected the sum";
  assert min_num(xs, 4) == -2 && max_num(xs, 4) == 9, "expected the extremes";
  assert min_num(xs, 0) == 0 && max_num(xs, 0) == 0, "expected an empty range to give 0";
  num[] ys = malloc(sizeof(num) * 4);
  copy_num(ys, xs, 4);
  assert ys[2] == 9, "expected the copy";
  fill_num(ys, 4, 3);
  assert sum_num(ys, 4) == 12 && ys[0] == 3, "expected every element to be 3";
}
