// Helper utilities for fixed arrays.

// View over a numeric array.
// 
// Fields:
// - data: backing storage
// - len: number of elements
pub compound NumArray {
  // data: backing storage
  num[] data;
  // len: number of elements
  num len;
}

// Wrap a raw array pointer and length as NumArray.
// 
// Params:
// - data: array pointer
// - len: element count
// 
// Returns:
// - NumArray view
pub fun num_array_wrap(num[] data, num len) NumArray {
  NumArray a;
  a.data = data;
  a.len = len;
  ret a;
}

impl NumArray {
  // Sum all elements.
  pub sum() num {
    num total = 0;
    num i = 0;
    for i < self.len {
      total = total + self.data[i];
      i = i + 1;
    }
    ret total;
  }

  // Minimum value in the array (0 if empty).
  pub min() num {
    if self.len == 0 {
      ret 0;
    }
    num min = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] < min {
        min = self.data[i];
      }
      i = i + 1;
    }
    ret min;
  }

  // Maximum value in the array (0 if empty).
  pub max() num {
    if self.len == 0 {
      ret 0;
    }
    num max = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] > max {
        max = self.data[i];
      }
      i = i + 1;
    }
    ret max;
  }

  // Fill array with a value.
  pub fill(num value) {
    num i = 0;
    for i < self.len {
      self.data[i] = value;
      i = i + 1;
    }
  }

  // Copy values from another array.
  pub copy_from(num[] src, num len) {
    num i = 0;
    for i < len {
      self.data[i] = src[i];
      i = i + 1;
    }
  }
}

// Sum a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - total sum
pub fun sum_num(num[] arr, num len) num {
  NumArray a = num_array_wrap(arr, len);
  ret a.sum();
}

// Minimum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - minimum value (0 if empty)
pub fun min_num(num[] arr, num len) num {
  NumArray a = num_array_wrap(arr, len);
  ret a.min();
}

// Maximum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - maximum value (0 if empty)
pub fun max_num(num[] arr, num len) num {
  NumArray a = num_array_wrap(arr, len);
  ret a.max();
}

// Fill a numeric array slice with a value.
// 
// Params:
// - arr: array pointer
// - len: element count
// - value: fill value
pub fun fill_num(num[] arr, num len, num value) {
  NumArray a = num_array_wrap(arr, len);
  a.fill(value);
}

// Copy between numeric array slices.
// 
// Params:
// - dst: destination array
// - src: source array
// - len: element count
pub fun copy_num(num[] dst, num[] src, num len) {
  NumArray a = num_array_wrap(dst, len);
  a.copy_from(src, len);
}
