// Helper utilities for fixed arrays.

// View over a generic array.
// 
// Fields:
// - data: backing storage
// - len: number of elements
pub compound Array<T> {
  // data: backing storage
  T[] data;
  // len: number of elements
  num len;
}

impl Array<T> {
  // Get element at index.
  pub get(num i) T {
    ret self.data[i];
  }

  // Set element at index.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Fill array with a value.
  pub fill(T value) {
    num i = 0;
    for i < self.len {
      self.data[i] = value;
      i = i + 1;
    }
  }

  // Copy values from another array.
  pub copy_from(T[] src, num len) {
    num i = 0;
    for i < len {
      self.data[i] = src[i];
      i = i + 1;
    }
  }

  // Swap two elements.
  pub swap(num i, num j) {
    T tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverse the array in-place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }
}

// Sum a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - total sum
pub fun sum_num(num[] arr, num len) num {
  num total = 0;
  num i = 0;
  for i < len {
    total = total + arr[i];
    i = i + 1;
  }
  ret total;
}

// Minimum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - minimum value (0 if empty)
pub fun min_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  num min = arr[0];
  num i = 1;
  for i < len {
    if arr[i] < min {
      min = arr[i];
    }
    i = i + 1;
  }
  ret min;
}

// Maximum value in a numeric array slice.
// 
// Params:
// - arr: array pointer
// - len: element count
// 
// Returns:
// - maximum value (0 if empty)
pub fun max_num(num[] arr, num len) num {
  if len == 0 {
    ret 0;
  }
  num max = arr[0];
  num i = 1;
  for i < len {
    if arr[i] > max {
      max = arr[i];
    }
    i = i + 1;
  }
  ret max;
}

// Fill a numeric array slice with a value.
// 
// Params:
// - arr: array pointer
// - len: element count
// - value: fill value
pub fun fill_num(num[] arr, num len, num value) {
  num i = 0;
  for i < len {
    arr[i] = value;
    i = i + 1;
  }
}

// Copy between numeric array slices.
// 
// Params:
// - dst: destination array
// - src: source array
// - len: element count
pub fun copy_num(num[] dst, num[] src, num len) {
  num i = 0;
  for i < len {
    dst[i] = src[i];
    i = i + 1;
  }
}
