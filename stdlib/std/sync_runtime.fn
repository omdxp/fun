// Sync runtime shim contract: the backend-facing contract for
// synchronization operations. Backend selection comes from
// std.runtime_backend; return codes come from the selected backend.

imp std.runtime_backend;
imp std.sync;
imp std.sync_backend_posix;
imp std.sync_backend_windows;

// Active sync runtime backend id (1: POSIX, 2: Windows).
pub fun sync_runtime_backend_id() num {
  ret runtime_backend_id();
}

// Return the active sync runtime backend name.
pub fun sync_runtime_backend_name() str {
  ret runtime_backend_name();
}

// True when the active sync runtime backend is POSIX.
pub fun sync_runtime_backend_is_posix() bin {
  ret runtime_backend_is_posix();
}

// True when the active sync runtime backend is Windows.
pub fun sync_runtime_backend_is_windows() bin {
  ret runtime_backend_is_windows();
}

fun runtime_mutex_new_posix() Mutex {
  ret sync_backend_posix_mutex_new();
}

fun runtime_condvar_new_posix() CondVar {
  ret sync_backend_posix_condvar_new();
}

fun runtime_mutex_init_posix(Mutex* mutex) num {
  ret sync_backend_posix_mutex_init(mutex);
}

fun runtime_mutex_lock_posix(Mutex* mutex) num {
  ret sync_backend_posix_mutex_lock(mutex);
}

fun runtime_mutex_try_lock_posix(Mutex* mutex) num {
  ret sync_backend_posix_mutex_try_lock(mutex);
}

fun runtime_mutex_unlock_posix(Mutex* mutex) num {
  ret sync_backend_posix_mutex_unlock(mutex);
}

fun runtime_mutex_destroy_posix(Mutex* mutex) num {
  ret sync_backend_posix_mutex_destroy(mutex);
}

fun runtime_condvar_init_posix(CondVar* cond) num {
  ret sync_backend_posix_condvar_init(cond);
}

fun runtime_condvar_wait_posix(CondVar* cond, Mutex* mutex) num {
  ret sync_backend_posix_condvar_wait(cond, mutex);
}

fun runtime_condvar_timed_wait_posix(CondVar* cond, Mutex* mutex, raw* abs_time) num {
  ret sync_backend_posix_condvar_timed_wait(cond, mutex, abs_time);
}

fun runtime_condvar_signal_posix(CondVar* cond) num {
  ret sync_backend_posix_condvar_signal(cond);
}

fun runtime_condvar_broadcast_posix(CondVar* cond) num {
  ret sync_backend_posix_condvar_broadcast(cond);
}

fun runtime_condvar_destroy_posix(CondVar* cond) num {
  ret sync_backend_posix_condvar_destroy(cond);
}

// Windows backend constructors.
fun runtime_mutex_new_windows() Mutex {
  ret sync_backend_windows_mutex_new();
}

fun runtime_condvar_new_windows() CondVar {
  ret sync_backend_windows_condvar_new();
}

fun runtime_mutex_init_windows(Mutex* mutex) num {
  ret sync_backend_windows_mutex_init(mutex);
}

fun runtime_mutex_lock_windows(Mutex* mutex) num {
  ret sync_backend_windows_mutex_lock(mutex);
}

fun runtime_mutex_try_lock_windows(Mutex* mutex) num {
  ret sync_backend_windows_mutex_try_lock(mutex);
}

fun runtime_mutex_unlock_windows(Mutex* mutex) num {
  ret sync_backend_windows_mutex_unlock(mutex);
}

fun runtime_mutex_destroy_windows(Mutex* mutex) num {
  ret sync_backend_windows_mutex_destroy(mutex);
}

fun runtime_condvar_init_windows(CondVar* cond) num {
  ret sync_backend_windows_condvar_init(cond);
}

fun runtime_condvar_wait_windows(CondVar* cond, Mutex* mutex) num {
  ret sync_backend_windows_condvar_wait(cond, mutex);
}

fun runtime_condvar_timed_wait_windows(CondVar* cond, Mutex* mutex, raw* abs_time) num {
  ret sync_backend_windows_condvar_timed_wait(cond, mutex, abs_time);
}

fun runtime_condvar_signal_windows(CondVar* cond) num {
  ret sync_backend_windows_condvar_signal(cond);
}

fun runtime_condvar_broadcast_windows(CondVar* cond) num {
  ret sync_backend_windows_condvar_broadcast(cond);
}

fun runtime_condvar_destroy_windows(CondVar* cond) num {
  ret sync_backend_windows_condvar_destroy(cond);
}

// Create a new runtime mutex.
pub fun runtime_mutex_new() Mutex {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_mutex_new_windows();
  }
  ret runtime_mutex_new_posix();
}

// Create a new runtime condition variable.
pub fun runtime_condvar_new() CondVar {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_condvar_new_windows();
  }
  ret runtime_condvar_new_posix();
}

// Initialize a runtime mutex.
pub fun runtime_mutex_init(Mutex* mutex) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_mutex_init_windows(mutex);
  }
  ret runtime_mutex_init_posix(mutex);
}

// Lock a runtime mutex.
pub fun runtime_mutex_lock(Mutex* mutex) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_mutex_lock_windows(mutex);
  }
  ret runtime_mutex_lock_posix(mutex);
}

// Try locking a runtime mutex.
pub fun runtime_mutex_try_lock(Mutex* mutex) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_mutex_try_lock_windows(mutex);
  }
  ret runtime_mutex_try_lock_posix(mutex);
}

// Unlock a runtime mutex.
pub fun runtime_mutex_unlock(Mutex* mutex) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_mutex_unlock_windows(mutex);
  }
  ret runtime_mutex_unlock_posix(mutex);
}

// Destroy a runtime mutex.
pub fun runtime_mutex_destroy(Mutex* mutex) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_mutex_destroy_windows(mutex);
  }
  ret runtime_mutex_destroy_posix(mutex);
}

// Initialize a runtime condition variable.
pub fun runtime_condvar_init(CondVar* cond) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_condvar_init_windows(cond);
  }
  ret runtime_condvar_init_posix(cond);
}

// Wait on a runtime condition variable.
pub fun runtime_condvar_wait(CondVar* cond, Mutex* mutex) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_condvar_wait_windows(cond, mutex);
  }
  ret runtime_condvar_wait_posix(cond, mutex);
}

// Timed wait on a runtime condition variable.
pub fun runtime_condvar_timed_wait(CondVar* cond, Mutex* mutex, raw* abs_time) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_condvar_timed_wait_windows(cond, mutex, abs_time);
  }
  ret runtime_condvar_timed_wait_posix(cond, mutex, abs_time);
}

// Signal one runtime condition variable waiter.
pub fun runtime_condvar_signal(CondVar* cond) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_condvar_signal_windows(cond);
  }
  ret runtime_condvar_signal_posix(cond);
}

// Broadcast to all runtime condition variable waiters.
pub fun runtime_condvar_broadcast(CondVar* cond) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_condvar_broadcast_windows(cond);
  }
  ret runtime_condvar_broadcast_posix(cond);
}

// Destroy a runtime condition variable.
pub fun runtime_condvar_destroy(CondVar* cond) num {
  if sync_runtime_backend_is_windows() == true {
    ret runtime_condvar_destroy_windows(cond);
  }
  ret runtime_condvar_destroy_posix(cond);
}
