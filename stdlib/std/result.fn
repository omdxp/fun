// Result compounds for stdlib operations.

// Generic result container for stdlib operations.
// 
// Fields:
// - ok: success flag
// - value: return value
// - err_code: error code
// - err_message: error message
pub compound Result<T> {
  // ok: success flag
  bin ok;
  // value: return value
  T value;
  // err_code: error code
  num err_code;
  // err_message: error message
  str err_message;
}

impl Result<T> {
  pub is_ok() bin {
    ret self.ok;
  }

  pub is_err() bin {
    ret self.ok == false;
  }

  pub unwrap_or(T default_value) T {
    if self.ok {
      ret self.value;
    }
    ret default_value;
  }

  pub set_ok(T value) {
    self.ok = true;
    self.value = value;
    self.err_code = 0;
    self.err_message = "";
  }

  pub set_err(num code, str message, T default_value) {
    self.ok = false;
    self.value = default_value;
    self.err_code = code;
    self.err_message = message;
  }
}

// Construct a successful generic result.
pub fun ok<T> (T value) Result<T> {
  Result<T> r;
  r.set_ok(value);
  ret r;
}

// Construct an error generic result.
pub fun err<T> (num code, str message, T default_value) Result<T> {
  Result<T> r;
  r.set_err(code, message, default_value);
  ret r;
}
