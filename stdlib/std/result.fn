// Result<T, E>: the outcome of a fallible operation — `Ok(value)` or `Err(error)`.
// 
// Result is a data-carrying enum (a sum type), matched with `fit`:
// 
// ```
// Result<str, Error> r = read_file("config.toml");
// fit r {
//   Result.Ok(text) -> { use(text); }
//   Result.Err(e) -> { log_error(e); }
// }
// ```
// 
// Or use the combinators for the common cases:
// 
// ```
// str text = read_file(path).unwrap_or(""); // value, or a fallback on Err
// ```
// 
// `E` is the error type — most stdlib functions use the shared `Error`
// compound (kind + code + message + context) and can be built with `ok(v)`,
// `err(code, message, default)`, `err_kind(kind, message, default)`, or
// `err_error(e, default)`. A caller that wants its OWN specific error type
// (an enum of just the failure modes it actually has, e.g. `Result<Node,
// ParseErrorKind>`) constructs it directly via the bare shorthand
// (`ret .Err(ParseErrorKind.UnexpectedToken);`), which resolves against the
// enclosing function's declared return type or a variable's declared type
// like any other enum-variant shorthand — no stdlib helper needed for that
// case, since a helper generic over an unconstrained `E` would need a
// witness value with nothing natural to infer it from (`Err` never carries
// a `T`-shaped value the way `Ok` does).

imp std.error;
imp std.c.string;

// A fallible result: `Ok(value)` on success, `Err(error)` on failure.
pub enum Result<T, E> {
  Ok(T),
  Err(E),
}

impl Result<T, E> {
  // Return true when the result is Ok.
  pub is_ok() bin {
    fit *self {
      .Ok(v) -> { ret true; }
      .Err(e) -> { ret false; }
    }
    ret false;
  }

  // Return true when the result is Err.
  pub is_err() bin {
    fit *self {
      .Ok(v) -> { ret false; }
      .Err(e) -> { ret true; }
    }
    ret true;
  }

  // Return the Ok value, or `fallback` when Err.
  pub unwrap_or(T fallback) T {
    fit *self {
      .Ok(v) -> { ret v; }
      .Err(e) -> { ret fallback; }
    }
    ret fallback;
  }

  // Return the Ok value.
  // 
  // Notes:
  // - Prefer `unwrap_or()` when you need a fallback.
  // - On Err this returns a zero value; there is no panic mechanism.
  // - Use it only after checking `is_ok()` or matching the variant.
  pub unwrap() T {
    fit *self {
      .Ok(v) -> { ret v; }
      .Err(e) -> { ret self.zero(); }
    }
    ret self.zero();
  }

  // Return the Err value, or a zero-initialized `E` when the result is Ok.
  pub unwrap_err() E {
    fit *self {
      .Ok(v) -> { ret self.zero_e(); }
      .Err(e) -> { ret e; }
    }
    ret self.zero_e();
  }

  // A zero-initialized T, used as the empty fallback for `unwrap`.
  zero() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // A zero-initialized E, used as the empty fallback for `unwrap_err`.
  zero_e() E {
    E out;
    memset(&out, 0, sizeof(E));
    ret out;
  }

  // Return `other` when this result is Ok; otherwise keep this Err.
  pub and(Result<T, E> other) Result<T, E> {
    fit *self {
      .Ok(v) -> { ret other; }
      .Err(e) -> { ret .Err(e); }
    }
    ret other;
  }

  // Return this result when it is Ok; otherwise return `other`.
  pub or(Result<T, E> other) Result<T, E> {
    fit *self {
      .Ok(v) -> { ret .Ok(v); }
      .Err(e) -> { ret other; }
    }
    ret other;
  }
}

// Construct a successful `Ok(value)`.
pub fun ok<T>(T value) Result<T, Error> {
  ret .Ok(value);
}

// Construct an `Err` from a code + message, tagged `ErrorKind.System`. The trailing
// value is not stored (an Err carries only the Error); it exists purely as a
// generic-type WITNESS so `T` is inferred from the call site — `err(1, "msg",
// fallback)` resolves `Result<T, Error>`. The leading underscore marks it
// intentionally unused.
// 
// Prefer `err_kind()` when the failure has an unambiguous category (`Io`, `Parse`,
// `NotFound`, `Invalid`, `OutOfMemory`, `Unexpected`) — callers inspecting
// `result.unwrap_err().kind` see that category instead of the generic `System`.
pub fun err<T>(num code, str message, T _default_value) Result<T, Error> {
  ret .Err(error_new(code, message));
}

// Construct an `Err` tagged with a specific error category, code `0`. Use this in
// place of `err()` whenever the failure obviously belongs to one of the
// `ErrorKind` categories, so callers can branch on `kind` instead of parsing
// `message`.
// 
// Params:
// - kind: broad error category
// - message: human-readable error message
// - _default_value: generic-type witness only, not stored (see `err()`)
pub fun err_kind<T>(ErrorKind kind, str message, T _default_value) Result<T, Error> {
  ret .Err(error_new_simple(kind, message));
}

// Construct a category-tagged `Err` that also carries a real numeric code (e.g. an
// OS/pthread return code). Use `err_kind()` instead when there is no meaningful
// code to report.
// 
// Params:
// - kind: broad error category
// - code: numeric error code
// - message: human-readable error message
// - _default_value: generic-type witness only, not stored (see `err()`)
pub fun err_kind_code<T>(ErrorKind kind, num code, str message, T _default_value) Result<T, Error> {
  ret .Err(error_new_kind(kind, code, message));
}

// Construct an `Err` from a pre-built Error. The trailing value is the same
// generic-type witness as in `err` (the enum stores only the Error).
pub fun err_error<T>(Error e, T _default_value) Result<T, Error> {
  ret .Err(e);
}
