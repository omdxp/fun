// Result<T>: the outcome of a fallible operation — `Ok(value)` or `Err(error)`.
// 
// Result is a data-carrying enum (a sum type), matched with `fit`:
// 
// ```
// Result<str> r = read_file("config.toml");
// fit r {
//   Result.Ok(text) -> { use(text); }
//   Result.Err(e) -> { log_error(e); }
// }
// ```
// 
// Or use the combinators for the common cases:
// 
// ```
// str text = read_file(path).unwrap_or(""); // value, or a fallback on Err
// ```
// 
// Construct with `ok(v)`, `err(code, message, default)`, or `err_error(e, default)`.
// The error arm carries a full `Error` (kind + code + message + context).

imp std.error;

// A fallible result: `Ok(value)` on success, `Err(error)` on failure.
pub enum Result<T> {
  Ok(T),
  Err(Error),
}

impl Result<T> {
  // True when the result is Ok.
  pub is_ok() bin {
    fit *self {
      Result.Ok(v) -> { ret true; }
      Result.Err(e) -> { ret false; }
    }
    ret false;
  }

  // True when the result is an Err.
  pub is_err() bin {
    fit *self {
      Result.Ok(v) -> { ret false; }
      Result.Err(e) -> { ret true; }
    }
    ret true;
  }

  // The Ok value, or `fallback` when Err.
  pub unwrap_or(T fallback) T {
    fit *self {
      Result.Ok(v) -> { ret v; }
      Result.Err(e) -> { ret fallback; }
    }
    ret fallback;
  }

  // The Ok value. Prefer `unwrap_or`: on Err this returns a zero value (there is no
  // panic), so use it only after checking `is_ok()` or matching the variant.
  pub unwrap() T {
    fit *self {
      Result.Ok(v) -> { ret v; }
      Result.Err(e) -> { ret self.zero(); }
    }
    ret self.zero();
  }

  // The Err value, or a no-error `Error` when Ok.
  pub unwrap_err() Error {
    fit *self {
      Result.Ok(v) -> { ret error_none(); }
      Result.Err(e) -> { ret e; }
    }
    ret error_none();
  }

  // A zero-initialized T, used as the empty fallback for `unwrap`.
  zero() T {
    T out;
    ret out;
  }

  // `other` if this is Ok, otherwise keep this Err.
  pub and(Result<T> other) Result<T> {
    fit *self {
      Result.Ok(v) -> { ret other; }
      Result.Err(e) -> { ret Result.Err(e); }
    }
    ret other;
  }

  // This result if it is Ok, otherwise `other`.
  pub or(Result<T> other) Result<T> {
    fit *self {
      Result.Ok(v) -> { ret Result.Ok(v); }
      Result.Err(e) -> { ret other; }
    }
    ret other;
  }
}

// Construct a successful `Ok(value)`.
pub fun ok<T>(T value) Result<T> {
  ret Result.Ok(value);
}

// Construct an `Err` from a code + message. `default_value` is unused by the enum
// representation (Err carries only the Error) but is kept in the signature so
// existing call sites — `err(1, "msg", fallback)` — continue to compile.
pub fun err<T>(num code, str message, T default_value) Result<T> {
  ret Result.Err(error_new(code, message));
}

// Construct an `Err` from a pre-built Error. `default_value` is accepted for
// call-site compatibility (the enum stores only the Error).
pub fun err_error<T>(Error e, T default_value) Result<T> {
  ret Result.Err(e);
}
