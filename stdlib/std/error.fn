// Error values for stdlib operations.

// Broad error categories.
pub enum ErrorKind {
  // No error
  None,
  // Input/output failures
  Io,
  // Parsing/format errors
  Parse,
  // Missing resource
  NotFound,
  // Invalid input or state
  Invalid,
  // Allocation failure
  OutOfMemory,
  // OS/system error
  System,
  // Unexpected failure
  Unexpected
}

// Error representation used across stdlib.
pub compound Error {
  // Error category.
  ErrorKind kind;
  // Numeric error code.
  num code;
  // Human-readable message.
  str message;
  // Optional context string.
  str context;
  // Optional cause detail.
  str cause;
}

impl Error {
  // Attaches context, replacing any previous context string.
  pub with_context(str context) {
    self.context = context;
  }

  // Attaches cause detail, replacing any previous cause string.
  pub with_cause(str cause) {
    self.cause = cause;
  }

  // Returns true when no error is present (`kind` is `None`).
  pub is_ok() bin {
    ret self.kind == .None;
  }

  // Returns true when an error is present (`kind` is not `None`).
  pub is_err() bin {
    ret self.kind != .None;
  }
}

// Creates an error value with an explicit kind, code, and message.
pub fun error_new_kind(ErrorKind kind, num code, str message) Error {
  Error e;
  e.kind = kind;
  e.code = code;
  e.message = message;
  e.context = "";
  e.cause = "";
  ret e;
}

// Creates an error value with an explicit kind and message, and code `0`.
pub fun error_new_simple(ErrorKind kind, str message) Error {
  ret error_new_kind(kind, 0, message);
}

// Creates a `System`-kind error from a numeric code and message.
pub fun error_new(num code, str message) Error {
  ret error_new_kind(.System, code, message);
}

// Create a no-error value (kind = None). Use this where a function must return an
// `Error` to signal "nothing went wrong" (e.g. `Result.unwrap_err` on an Ok value).
pub fun error_none() Error {
  Error e;
  e.kind = .None;
  e.code = 0;
  e.message = "";
  e.context = "";
  e.cause = "";
  ret e;
}

// Attaches context to an error value.
pub fun error_with_context(Error* e, str context) {
  e.with_context(context);
}

// Attaches cause detail to an error value.
pub fun error_with_cause(Error* e, str cause) {
  e.with_cause(cause);
}

// Returns true when `e` has no error present (`kind` is `None`).
pub fun error_is_ok(Error* e) bin {
  ret e.kind == .None;
}

// Returns true when `e` has an error present (`kind` is not `None`).
pub fun error_is_err(Error* e) bin {
  ret e.kind != .None;
}
