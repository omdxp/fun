// Error values for stdlib operations.

// Broad error categories.
pub enum ErrorKind {
  // No error
  None,
  // Input/output failures
  Io,
  // Parsing/format errors
  Parse,
  // Missing resource
  NotFound,
  // Invalid input or state
  Invalid,
  // Allocation failure
  OutOfMemory,
  // OS/system error
  System,
  // Unexpected failure
  Unexpected
}

// Error representation used across stdlib.
pub compound Error {
  // Error category.
  ErrorKind kind;
  // Numeric error code.
  num code;
  // Human-readable message.
  str message;
  // Optional context string.
  str context;
  // Optional cause detail.
  str cause;
}

impl Error {
  // Attach context, replacing any previous context string.
  // 
  // Params:
  // - context: context message to store
  pub with_context(str context) {
    self.context = context;
  }

  // Attach cause detail, replacing any previous cause string.
  // 
  // Params:
  // - cause: cause detail to store
  pub with_cause(str cause) {
    self.cause = cause;
  }

  // Return true when no error is present.
  // 
  // Returns:
  // - true when `kind` is `None`
  pub is_ok() bin {
    ret self.kind == .None;
  }

  // Return true when an error is present.
  // 
  // Returns:
  // - true when `kind` is not `None`
  pub is_err() bin {
    ret self.kind != .None;
  }
}

// Create a new error value with an explicit kind and code.
// 
// Params:
// - kind: broad error category
// - code: numeric error code
// - message: human-readable error message
// 
// Returns:
// - initialized error value
pub fun error_new_kind(ErrorKind kind, num code, str message) Error {
  Error e;
  e.kind = kind;
  e.code = code;
  e.message = message;
  e.context = "";
  e.cause = "";
  ret e;
}

// Create a new error value with an explicit kind.
// 
// Params:
// - kind: broad error category
// - message: human-readable error message
// 
// Returns:
// - initialized error value with code `0`
pub fun error_new_simple(ErrorKind kind, str message) Error {
  ret error_new_kind(kind, 0, message);
}

// Create a system error using the legacy constructor shape.
// 
// Params:
// - code: numeric error code
// - message: human-readable error message
// 
// Returns:
// - initialized error value with kind `System`
pub fun error_new(num code, str message) Error {
  ret error_new_kind(.System, code, message);
}

// Create a no-error value (kind = None). Use this where a function must return an
// `Error` to signal "nothing went wrong" (e.g. `Result.unwrap_err` on an Ok value).
pub fun error_none() Error {
  Error e;
  e.kind = .None;
  e.code = 0;
  e.message = "";
  e.context = "";
  e.cause = "";
  ret e;
}

// Attach context to an error value.
// 
// Params:
// - e: error to update
// - context: context string to store
pub fun error_with_context(Error* e, str context) {
  e.with_context(context);
}

// Attach cause detail to an error value.
// 
// Params:
// - e: error to update
// - cause: cause string to store
pub fun error_with_cause(Error* e, str cause) {
  e.with_cause(cause);
}

// Return true when no error is present.
// 
// Params:
// - e: error to inspect
// 
// Returns:
// - true when `e.kind` is `None`
pub fun error_is_ok(Error* e) bin {
  ret e.kind == .None;
}

// Return true when an error is present.
// 
// Params:
// - e: error to inspect
// 
// Returns:
// - true when `e.kind` is not `None`
pub fun error_is_err(Error* e) bin {
  ret e.kind != .None;
}
