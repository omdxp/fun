// A closure-based `spawn` for `std.thread`.

use std.thread_runtime;
use std.atomic;
use std.c.mem;

// What a spawned thread is handed: the closure to run, boxed so it
// outlives the caller's frame.
compound SpawnBox {
  closure() void task;
}

// A spawned thread's entry: runs the boxed closure once, then frees it
// and what it captured.
fun run_spawned(raw* arg) raw* {
  SpawnBox* box = arg;
  closure() void task = box.task;
  free(box);
  task();
  task.free();
  ret nil;
}

// Runs `task` on a new OS thread, fire-and-forget. The thread owns
// `task` from here on and frees what it captured once it has run, so
// the caller must not call or free it again.
pub fun spawn(closure() void task) RuntimeAsyncTask {
  SpawnBox* box = malloc(sizeof(SpawnBox));
  box.task = task;
  ret runtime_async_spawn(run_spawned, box);
}

test "spawn runs a closure on a real thread, capturing a heap counter it mutates" {
  // Heap-allocated, never a stack local's own address: `hits` must
  // stay valid on the spawned thread regardless of whether this test
  // function's own frame has already returned by the time the closure
  // actually runs.
  Atomic<num>* hp = malloc(sizeof(Atomic<num>));
  *hp = atomic_new(0);
  RuntimeAsyncTask task = spawn(fun() {
    hp.fetch_add(1);
  });
  assert task.join(nil) == 0, "expected the spawned thread to join cleanly";
  assert hp.load() == 1, "expected the closure to have run exactly once on the spawned thread";
  free(hp);
}
