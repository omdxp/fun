// Everyday test helpers. `test "name" { ... }` blocks themselves need no
// import - the compiler recognizes them directly and generates their own
// runner (see `emit_test_runner` in the compiler's own codegen). That
// generated runner, in one compiled test binary:
//
// - runs every `sequential test "name" { ... }` first, one at a time on
// the calling thread, in declaration order;
// - then runs every plain `test "name" { ... }` across a pool of worker
// threads sized to the CPU count, pulled from a shared queue rather
// than a fixed split, so a slow test doesn't leave a worker idle while
// others queue up.
//
// A test is a plain `test` by default; write `sequential` in front of the
// ones that can't tolerate a sibling test running at the same time -
// mutating a shared global (an env var via `set_env`/`clear_env`, the
// process's working directory), writing a fixed file path another test
// also uses, or anything else that isn't safe under concurrent access.
// Ordinary `test` blocks are expected to be thread-safe: independent state
// only, no shared mutable globals.
//
// This module itself only holds small, common assertion helpers - nothing
// here participates in discovery or scheduling.

use std.string;
use std.io;

// Asserts `actual == expected`, formatting both into the failure message
// so a mismatch is legible without hand-writing the values into `label`.
pub fun assert_eq_num(num actual, num expected, str label) {
  assert actual == expected, format("{str}: expected {num}, got {num}", label, expected, actual);
}

// `assert_eq_num`, for `str` (compared with `equals`, not `==`).
pub fun assert_eq_str(str actual, str expected, str label) {
  assert equals(actual, expected), format("{str}: expected \"{str}\", got \"{str}\"", label, expected, actual);
}

// `assert_eq_num`, for `flag`.
pub fun assert_eq_flag(flag actual, flag expected, str label) {
  assert actual == expected, format("{str}: expected {flag}, got {flag}", label, expected, actual);
}

test "assert_eq_num passes on a match and reports both values on a mismatch" {
  assert_eq_num(2 + 2, 4, "addition");
}

test "assert_eq_str passes on a match" {
  assert_eq_str(format("{str}", "ok"), "ok", "format passthrough");
}

test "assert_eq_flag passes on a match" {
  assert_eq_flag(1 == 1, true, "equality");
}

sequential test "sequential test blocks compile and run like any other" {
  assert_eq_num(1 + 1, 2, "sanity");
}
