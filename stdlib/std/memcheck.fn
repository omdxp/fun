// Memory checker: catches leaks, double-frees, and use-after-free.
//
// `-memcheck` redirects malloc/calloc/realloc/free (see codegen's own
// `self.memcheck` note in `write_prelude`) to this module's own
// allocator: every allocation gets its own guarded page(s), so freeing
// one revokes access to it forever instead of returning it to the
// system - a later read or write through it faults immediately,
// instead of silently landing on whatever now occupies that address.
// The same redirecting macro captures `__FILE__`/`__LINE__` at every
// call site, which the `#line` directives `-memcheck` also turns on
// resolve back to the original `.fn` source rather than the generated
// C - so every report below names a real file and line, not just a
// sequence number.
//
// This module's own bookkeeping bypasses the redirect entirely
// (through `__fun_real_*`), so it never allocates through the very
// allocator it is tracking.
//
// The tracking table is guarded by one mutex (`__mc_mu`), held around
// every read and write of it, including from the fault handler - safe
// specifically because the thread that faults is always executing
// ordinary user code dereferencing a bad pointer at that moment, never
// code already holding `__mc_mu` itself (this module's own allocator
// never dereferences a user-facing guarded pointer), so the faulting
// thread can never already hold the lock it's about to wait on.

// Deliberately nothing from std.io/std.string here, even though a
// Fun-side format()-based message would read better: compiling one of
// THIS module's own transitive dependencies directly under -memcheck
// (every stdlib file does, in this project's own test suite) makes the
// "use std.memcheck" injected above its text pull this module back in
// as a dependency of itself, and anything this module then called back
// into - std.io's own format/writeln_to among them - would be a real
// forward reference into a declaration the entry file is the one
// supplying, landing before it in the generated C. Building reports
// with std.c.io's own snprintf/fprintf instead avoids the whole class
// of problem outright: everything this module touches is a bodiless
// C extern with no body of its own to be out of order with.
use std.c.mem;
use std.c.string;
use std.c.io;
use std.sync;

num __mc_count = 0;
num __mc_capacity = 0;
num __mc_next_seq = 0;
flag __mc_started = false;
// Set by codegen's own `emit_main_thread_wrapper`/`emit_test_runner`,
// as the very first statement of a program's real entry point, unless
// `-memcheck-leaks` asked to keep leak reporting - see
// `Codegen.memcheck_leaks`'s own note on why it's off by default.
flag __mc_suppress_leak_sweep = false;

// How much room a report line gets (plenty for every field this module
// ever prints, file paths included). Fixed rather than measured, so
// building one never allocates more than once.
const num __mc_msg_cap = 4096;

// Opts a running program out of the leak sweep below: real for every
// `-memcheck` build unless `-memcheck-leaks` turns it back on, never
// meant to be called directly from `.fn` source.
pub fun __fun_memcheck_disable_leak_sweep() {
  __mc_suppress_leak_sweep = true;
}

// Runtime hooks codegen's own preamble provides when `-memcheck` is on
// (see `write_prelude`'s own `self.memcheck` block) - real
// implementations live there, not here.
fun __fun_real_malloc(num size) raw*;
fun __fun_real_realloc(raw* ptr, num size) raw*;
fun __fun_mc_guard_alloc(num data_size, num* out_total_size, raw** out_mmap_base) raw*;
fun __fun_mc_guard_protect_all(raw* base, num total_size) num;
fun __fun_mc_register_handler(raw* handler) num;
fun __fun_mc_ptr_in_range(raw* addr, raw* base, num size) num;
// Per-thread, unlike `__mc_ensure_started` below: `sigaction`'s own
// handler registration is process-wide, but the alternate stack a
// signal handler needs in order to still run once a thread's own
// stack is exhausted (a real stack overflow, not a guarded-page
// violation) is per-thread. Safe, and nearly free, to call on every
// allocation - see its own C-side note in codegen.fn's write_prelude
// for why a thread needs its own call at all.
fun __fun_mc_ensure_altstack();

// One tracked allocation. `size` is what the caller asked for (what a
// report shows); `total_size` is the real, page-rounded-plus-guard
// span `__fun_mc_guard_protect_all` needs to revoke on free. `file`/
// `line` name where it was allocated; `freed_file`/`freed_line` name
// where it was first freed, filled in only once `is_freed` is set -
// what tells a double-free report the earlier, real free apart from
// the one that just tried it again.
compound AllocInfo {
  raw* base;
  // The real mmap/VirtualAlloc base `__fun_mc_guard_protect_all` revokes
  // on free - `base` above is the user-facing pointer, offset forward so
  // the user's own data ends exactly at the guard page (see
  // `__fun_mc_guard_alloc`'s own note), no longer the same address.
  raw* mmap_base;
  num size;
  num total_size;
  flag is_freed;
  num seq;
  str file;
  num line;
  str freed_file;
  num freed_line;
}
AllocInfo* __mc_table = nil;
Mutex __mc_mu;

// Doubles the table's own capacity (64 to start) via the real,
// unredirected allocator - growing this table must never go through
// `__fun_memcheck_realloc`, which would just track itself. Caller
// must already hold `__mc_mu` - every helper below assumes the same.
fun __mc_grow_if_needed() {
  if __mc_count < __mc_capacity {
    ret;
  }
  num new_cap = __mc_capacity * 2;
  if new_cap < 64 {
    new_cap = 64;
  }
  raw* grown = __fun_real_realloc(__mc_table, new_cap * sizeof(AllocInfo));
  __mc_table = grown;
  __mc_capacity = new_cap;
}

// The live index of the allocation whose own base is exactly `ptr`, or
// -1. Linear scan - fine at the allocation counts a debug/CI run sees,
// not a hot path worth a hash table for.
fun __mc_find(raw* ptr) num {
  num i = 0;
  for i < __mc_count {
    if __mc_table[i].base == ptr {
      ret i;
    }
    i = i + 1;
  }
  ret -1;
}

// The index of the allocation whose own guarded span contains `addr`,
// live or freed - what the fault handler needs to tell a use-after-free
// (inside a freed span) from a buffer overflow (inside a live one's
// trailing guard page) from a genuinely unrelated fault (inside
// neither).
fun __mc_find_by_range(raw* addr) num {
  num i = 0;
  for i < __mc_count {
    if __fun_mc_ptr_in_range(addr, __mc_table[i].mmap_base, __mc_table[i].total_size) != 0 {
      ret i;
    }
    i = i + 1;
  }
  ret -1;
}

// Registered with `__fun_mc_register_handler`, called from the
// SIGSEGV/access-violation trampoline codegen's own preamble installs.
fun __mc_fault_handler(num sig, raw* fault_addr, raw* ctx) {
  let _lk = __mc_mu.lock();
  num idx = __mc_find_by_range(fault_addr);
  flag is_freed = false;
  num info_seq = 0;
  num info_size = 0;
  str info_file = "";
  num info_line = 0;
  str info_freed_file = "";
  num info_freed_line = 0;
  raw* info_base = nil;
  if idx >= 0 {
    is_freed = __mc_table[idx].is_freed;
    info_seq = __mc_table[idx].seq;
    info_size = __mc_table[idx].size;
    info_file = __mc_table[idx].file;
    info_line = __mc_table[idx].line;
    info_freed_file = __mc_table[idx].freed_file;
    info_freed_line = __mc_table[idx].freed_line;
    info_base = __mc_table[idx].base;
  }
  let _ulk = __mc_mu.unlock();
  str msg = malloc(__mc_msg_cap);
  if idx >= 0 {
    if is_freed {
      let _n = snprintf(
        msg,
        __mc_msg_cap,
        "[memcheck] use-after-free: allocation #%lld (%lld bytes), allocated at %s:%lld, freed at %s:%lld",
        info_seq,
        info_size,
        info_file,
        info_line,
        info_freed_file,
        info_freed_line
      );
    } else {
      // Live, so the fault is a genuine out-of-bounds access against one
      // of the two guard pages - which one tells an overrun from an
      // underrun apart. The two aren't symmetric in precision (see
      // `__fun_mc_guard_alloc`'s own note): a write even one byte past
      // the end always faults, but an underflow only faults once it
      // crosses the page-rounding slack before the start.
      flag before_start = fault_addr < info_base;
      if before_start {
        let _n = snprintf(
          msg,
          __mc_msg_cap,
          "[memcheck] buffer underflow: before the start of allocation #%lld (%lld bytes), allocated at %s:%lld",
          info_seq,
          info_size,
          info_file,
          info_line
        );
      } else {
        let _n = snprintf(
          msg,
          __mc_msg_cap,
          "[memcheck] buffer overflow: past the end of allocation #%lld (%lld bytes), allocated at %s:%lld",
          info_seq,
          info_size,
          info_file,
          info_line
        );
      }
    }
  } else {
    str lit = "[memcheck] memory access violation (not within any tracked allocation)";
    let _n = snprintf(msg, __mc_msg_cap, "%s", lit);
  }
  let _fp = fprintf(stderr_stream(), "%s\n", msg);
  free(msg);
  let _ff = fflush(stderr_stream());
  abort();
}

// Registered with `atexit` - the only point a leak can be told apart
// from an allocation whose own program just hasn't gotten around to
// freeing it yet. Forces a nonzero exit on any leak found, even though
// `main` itself already returned cleanly - what makes this usable in CI.
fun __mc_leak_sweep() {
  if __mc_suppress_leak_sweep {
    ret;
  }
  num i = 0;
  num leaks = 0;
  for i < __mc_count {
    // Locked just for this one read, not across the `format`/`free`
    // below - those are further allocator calls (`free` redirects
    // back into this same module), which would try to re-lock `__mc_mu`
    // while this same thread still held it.
    let _lk = __mc_mu.lock();
    flag is_freed = __mc_table[i].is_freed;
    num seq = __mc_table[i].seq;
    num size = __mc_table[i].size;
    str file = __mc_table[i].file;
    num line = __mc_table[i].line;
    let _ulk = __mc_mu.unlock();
    if !is_freed {
      str msg = malloc(__mc_msg_cap);
      let _n = snprintf(
        msg,
        __mc_msg_cap,
        "[memcheck] leak: allocation #%lld, %lld bytes, allocated at %s:%lld, never freed",
        seq,
        size,
        file,
        line
      );
      let _fp = fprintf(stderr_stream(), "%s\n", msg);
      free(msg);
      leaks = leaks + 1;
    }
    i = i + 1;
  }
  let _ff = fflush(stderr_stream());
  if leaks > 0 {
    exit(1);
  }
}

// Registers the fault handler and the leak sweep exactly once, on the
// first allocation or free this process ever makes under `-memcheck`.
// Not itself lock-protected, the same non-atomic once-check this
// codebase's own M:N scheduler already accepts for its one-time setup
// (`__fun_sched_init_once`) - two threads racing their very first
// allocation at the exact same instant is the one window this leaves
// open, not the steady-state table access the mutex below covers.
fun __mc_ensure_started() {
  if __mc_started {
    ret;
  }
  __mc_started = true;
  let _mu_rc = __mc_mu.init();
  let _rc = __fun_mc_register_handler(__mc_fault_handler);
  let _rc2 = atexit(__mc_leak_sweep);
}

pub fun __fun_memcheck_malloc(num size, str file, num line) raw* {
  __mc_ensure_started();
  __fun_mc_ensure_altstack();
  num real_size = size;
  if real_size <= 0 {
    real_size = 1;
  }
  num total_size = 0;
  raw* mmap_base = nil;
  raw* base = __fun_mc_guard_alloc(real_size, &total_size, &mmap_base);
  if base == nil {
    ret nil;
  }
  let _lk = __mc_mu.lock();
  __mc_grow_if_needed();
  AllocInfo info;
  info.base = base;
  info.mmap_base = mmap_base;
  info.size = size;
  info.total_size = total_size;
  info.is_freed = false;
  info.seq = __mc_next_seq;
  info.file = file;
  info.line = line;
  info.freed_file = "";
  info.freed_line = 0;
  __mc_next_seq = __mc_next_seq + 1;
  __mc_table[__mc_count] = info;
  __mc_count = __mc_count + 1;
  let _ulk = __mc_mu.unlock();
  ret base;
}

// `mmap(MAP_ANONYMOUS)`/`VirtualAlloc` both hand back zeroed pages, so
// a fresh guarded region is already what `calloc` promises - no
// separate zeroing pass needed.
pub fun __fun_memcheck_calloc(num count, num size, str file, num line) raw* {
  ret __fun_memcheck_malloc(count * size, file, line);
}

pub fun __fun_memcheck_realloc(raw* ptr, num size, str file, num line) raw* {
  if ptr == nil {
    ret __fun_memcheck_malloc(size, file, line);
  }
  __mc_ensure_started();
  let _lk = __mc_mu.lock();
  num idx = __mc_find(ptr);
  flag have_old = idx >= 0;
  num old_size = 0;
  if have_old {
    old_size = __mc_table[idx].size;
  }
  let _ulk = __mc_mu.unlock();
  raw* new_ptr = __fun_memcheck_malloc(size, file, line);
  if have_old {
    num copy_size = old_size;
    if size < copy_size {
      copy_size = size;
    }
    if new_ptr != nil && copy_size > 0 {
      let _cp = memcpy(new_ptr, ptr, copy_size);
    }
    __fun_memcheck_free(ptr, file, line);
  }
  ret new_ptr;
}

pub fun __fun_memcheck_free(raw* ptr, str file, num line) {
  if ptr == nil {
    ret;
  }
  __mc_ensure_started();
  __fun_mc_ensure_altstack();
  let _lk = __mc_mu.lock();
  num idx = __mc_find(ptr);
  if idx < 0 {
    let _ulk0 = __mc_mu.unlock();
    ret;
  }
  AllocInfo* entry = &__mc_table[idx];
  if entry.is_freed {
    num dbl_seq = entry.seq;
    num dbl_size = entry.size;
    str dbl_alloc_file = entry.file;
    num dbl_alloc_line = entry.line;
    str dbl_freed_file = entry.freed_file;
    num dbl_freed_line = entry.freed_line;
    let _ulk1 = __mc_mu.unlock();
    str msg = malloc(__mc_msg_cap);
    let _n = snprintf(
      msg,
      __mc_msg_cap,
      "[memcheck] double-free: allocation #%lld, %lld bytes, allocated at %s:%lld, already freed at %s:%lld, double-freed at %s:%lld",
      dbl_seq,
      dbl_size,
      dbl_alloc_file,
      dbl_alloc_line,
      dbl_freed_file,
      dbl_freed_line,
      file,
      line
    );
    let _fp = fprintf(stderr_stream(), "%s\n", msg);
    free(msg);
    let _ff = fflush(stderr_stream());
    abort();
  }
  let _rc = __fun_mc_guard_protect_all(entry.mmap_base, entry.total_size);
  entry.is_freed = true;
  entry.freed_file = file;
  entry.freed_line = line;
  let _ulk2 = __mc_mu.unlock();
}
