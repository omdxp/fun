// Memory checker: catches leaks, double-frees, and use-after-free.
//
// `-memcheck` redirects malloc/calloc/realloc/free (see codegen's own
// `self.memcheck` note in `write_prelude`) to this module's own
// allocator: every allocation gets its own guarded page(s), so freeing
// one revokes access to it forever instead of returning it to the
// system - a later read or write through it faults immediately,
// instead of silently landing on whatever now occupies that address.
// The same redirecting macro captures `__FILE__`/`__LINE__` at every
// call site, which the `#line` directives `-memcheck` also turns on
// resolve back to the original `.fn` source rather than the generated
// C - so every report below names a real file and line, not just a
// sequence number.
//
// This module's own bookkeeping bypasses the redirect entirely
// (through `__fun_real_*`), so it never allocates through the very
// allocator it is tracking.
//
// The tracking table is guarded by one mutex (`__mc_mu`), held around
// every read and write of it, including from the fault handler - safe
// specifically because the thread that faults is always executing
// ordinary user code dereferencing a bad pointer at that moment, never
// code already holding `__mc_mu` itself (this module's own allocator
// never dereferences a user-facing guarded pointer), so the faulting
// thread can never already hold the lock it's about to wait on.

// Deliberately nothing from std.io/std.string here, even though a
// Fun-side format()-based message would read better: compiling one of
// THIS module's own transitive dependencies directly under -memcheck
// (every stdlib file does, in this project's own test suite) makes the
// "use std.memcheck" injected above its text pull this module back in
// as a dependency of itself, and anything this module then called back
// into - std.io's own format/writeln_to among them - would be a real
// forward reference into a declaration the entry file is the one
// supplying, landing before it in the generated C. Building reports
// with std.c.io's own snprintf/fprintf instead avoids the whole class
// of problem outright: everything this module touches is a bodiless
// C extern with no body of its own to be out of order with.
use std.c.mem;
use std.c.string;
use std.c.io;
use std.sync;

num __mc_count = 0;
num __mc_capacity = 0;
num __mc_next_seq = 0;
flag __mc_started = false;
// Set by codegen's own `emit_main_thread_wrapper`/`emit_test_runner`,
// as the very first statement of a program's real entry point, unless
// `-memcheck-leaks` asked to keep leak reporting - see
// `Codegen.memcheck_leaks`'s own note on why it's off by default.
flag __mc_suppress_leak_sweep = false;

// Open-addressing hash set mapping a tracked allocation's own pointer
// (as a number) to its index into `__mc_table`, so `__mc_find` is O(1)
// average instead of an O(n) scan - a file that makes a large number of
// allocations (an AST-heavy codegen test, say) was paying O(n^2) total
// under the scan, dominating every other cost `-memcheck` adds. Insert-
// only, like `__mc_table` itself: a freed allocation's pointer stays
// mapped to its index forever (this module never reuses or removes a
// tracked allocation, see `__fun_memcheck_free`'s own note), so a lookup
// probe can stop at the first empty slot with no tombstones needed -
// nothing was ever deleted that could leave a gap behind a later key.
// Allocated through the real, unredirected allocator, same as
// `__mc_table`. Caller must already hold `__mc_mu`, same as every helper
// touching `__mc_table` itself.
num __mc_hash_capacity = 0;
num __mc_hash_used_count = 0;
num* __mc_hash_keys = nil;
flag* __mc_hash_used = nil;
num* __mc_hash_vals = nil;
num __mc_quarantine_bytes = 0;
num __mc_quarantine_capacity = 0;
num __mc_quarantine_head = 0;
num __mc_quarantine_count = 0;
num* __mc_quarantine_queue = nil;

// A region recycled out of the quarantine, waiting for a new allocation
// whose own total guarded size matches exactly - same reasoning as
// `__mc_table`'s "exact total_size" note on `__mc_freelist_take` below.
num __mc_freelist_capacity = 0;
num __mc_freelist_count = 0;
raw** __mc_freelist_base = nil;
num* __mc_freelist_size = nil;

// How much room a report line gets (plenty for every field this module
// ever prints, file paths included). Fixed rather than measured, so
// building one never allocates more than once.
const num __mc_msg_cap = 4096;

// `std.string`'s own `format_num`, duplicated rather than imported:
// this module can't depend on `std.string` at all (see this file's own
// top note on why), and a plain decimal digit-by-digit build is the
// one way to put a number into one of this file's own report messages
// without `snprintf`'s `%lld` - which, on a platform where `int64_t` is
// `long` rather than `long long` (Linux's LP64 among them), is a real
// type mismatch the C compiler warns on, harmless only because both
// happen to be 8 bytes on every platform this project targets.
// Allocated through the real, unredirected allocator and freed by
// every caller right after the one `snprintf` it feeds, same as this
// module's own `msg` buffers.
fun __mc_format_num(num n) str {
  str buf = __fun_real_malloc(21);
  if n == 0 {
    buf[0] = '0';
    buf[1] = '\0';
    ret buf;
  }
  flag neg = n < 0;
  if neg {
    n = 0 - n;
  }
  str digits = "0123456789";
  num pos = 0;
  for n > 0 {
    buf[pos] = digits[n % 10];
    n = n / 10;
    pos = pos + 1;
  }
  if neg {
    buf[pos] = '-';
    pos = pos + 1;
  }
  buf[pos] = '\0';
  num start = 0;
  num end = pos - 1;
  for start < end {
    chr tmp = buf[start];
    buf[start] = buf[end];
    buf[end] = tmp;
    start = start + 1;
    end = end - 1;
  }
  ret buf;
}

// Opts a running program out of the leak sweep below: real for every
// `-memcheck` build unless `-memcheck-leaks` turns it back on, never
// meant to be called directly from `.fn` source.
pub fun __fun_memcheck_disable_leak_sweep() {
  __mc_suppress_leak_sweep = true;
}

// Runtime hooks codegen's own preamble provides when `-memcheck` is on
// (see `write_prelude`'s own `self.memcheck` block) - real
// implementations live there, not here.
fun __fun_real_malloc(num size) raw*;
fun __fun_real_realloc(raw* ptr, num size) raw*;
fun __fun_mc_guard_alloc(num data_size, num* out_total_size, raw** out_mmap_base) raw*;
fun __fun_mc_guard_protect_all(raw* base, num total_size) num;
// What `__fun_mc_guard_alloc` would set `out_total_size` to for a given
// `data_size`, without actually reserving anything - lets the quarantine
// below look for a reusable region of the right size before deciding to
// reserve a fresh one.
fun __fun_mc_guard_total_size(num data_size) num;
// Reopens an already-guarded, already-freed region's data pages for a
// new allocation (see `__mc_freelist_take`'s own note) instead of
// reserving a fresh one - same `(char*)guard - data_size` layout
// `__fun_mc_guard_alloc` returns, just skipping the real reservation.
fun __fun_mc_guard_reuse(raw* mmap_base, num total_size, num data_size) raw*;
fun __fun_mc_register_handler(raw* handler) num;
fun __fun_mc_ptr_in_range(raw* addr, raw* base, num size) num;
// A pointer's own bit pattern as a number - the one piece of raw-C glue
// `__mc_hash_insert`/`__mc_hash_lookup` below need to turn a `raw*` into
// something `%` can hash on.
fun __fun_mc_ptr_to_num(raw* ptr) num;
fun __fun_real_free(raw* ptr);
// Per-thread, unlike `__mc_ensure_started` below: `sigaction`'s own
// handler registration is process-wide, but the alternate stack a
// signal handler needs in order to still run once a thread's own
// stack is exhausted (a real stack overflow, not a guarded-page
// violation) is per-thread. Safe, and nearly free, to call on every
// allocation - see its own C-side note in codegen.fn's write_prelude
// for why a thread needs its own call at all.
fun __fun_mc_ensure_altstack();

// One tracked allocation. `size` is what the caller asked for (what a
// report shows); `total_size` is the real, page-rounded-plus-guard
// span `__fun_mc_guard_protect_all` needs to revoke on free. `file`/
// `line` name where it was allocated; `freed_file`/`freed_line` name
// where it was first freed, filled in only once `is_freed` is set -
// what tells a double-free report the earlier, real free apart from
// the one that just tried it again.
compound AllocInfo {
  raw* base;
  // The real mmap/VirtualAlloc base `__fun_mc_guard_protect_all` revokes
  // on free - `base` above is the user-facing pointer, offset forward so
  // the user's own data ends exactly at the guard page (see
  // `__fun_mc_guard_alloc`'s own note), no longer the same address.
  raw* mmap_base;
  num size;
  num total_size;
  flag is_freed;
  num seq;
  str file;
  num line;
  str freed_file;
  num freed_line;
}
AllocInfo* __mc_table = nil;
Mutex __mc_mu;

fun __mc_hash_alloc(num capacity) {
  __mc_hash_keys = __fun_real_malloc(capacity * sizeof(num));
  __mc_hash_used = __fun_real_malloc(capacity * sizeof(flag));
  __mc_hash_vals = __fun_real_malloc(capacity * sizeof(num));
  memset(__mc_hash_used, 0, capacity * sizeof(flag));
  __mc_hash_capacity = capacity;
  __mc_hash_used_count = 0;
}

// Rehashes every live entry into a freshly doubled table - the only time
// the old one's slot positions (each a function of its own key modulo
// the *old* capacity) are recomputed.
fun __mc_hash_grow() {
  num old_capacity = __mc_hash_capacity;
  num* old_keys = __mc_hash_keys;
  flag* old_used = __mc_hash_used;
  num* old_vals = __mc_hash_vals;
  num new_capacity = old_capacity * 2;
  if new_capacity < 128 {
    new_capacity = 128;
  }
  __mc_hash_alloc(new_capacity);
  num i = 0;
  for i < old_capacity {
    if old_used[i] {
      num slot = old_keys[i] % __mc_hash_capacity;
      for __mc_hash_used[slot] {
        slot = (slot + 1) % __mc_hash_capacity;
      }
      __mc_hash_keys[slot] = old_keys[i];
      __mc_hash_used[slot] = true;
      __mc_hash_vals[slot] = old_vals[i];
      __mc_hash_used_count = __mc_hash_used_count + 1;
    }
    i = i + 1;
  }
  if old_capacity > 0 {
    __fun_real_free(old_keys);
    __fun_real_free(old_used);
    __fun_real_free(old_vals);
  }
}

// Inserts `ptr -> idx`. Usually `ptr` is brand new (a fresh allocation
// appending a brand-new entry to `__mc_table`), but once the quarantine
// below recycles a retired region, the SAME pointer value comes back
// around for a different, later allocation - so this scans the probe
// sequence for an existing key first and overwrites its value in place
// rather than assuming every insert is new. That overwrite-in-place is
// exactly why no tombstone is needed anywhere in this table: a slot is
// never cleared back to empty, only ever written to (first time or
// again), so a lookup can still stop at the first empty slot it meets.
fun __mc_hash_insert(raw* ptr, num idx) {
  if __mc_hash_capacity == 0 || (__mc_hash_used_count + 1) * 2 > __mc_hash_capacity {
    __mc_hash_grow();
  }
  num key = __fun_mc_ptr_to_num(ptr);
  num slot = key % __mc_hash_capacity;
  for __mc_hash_used[slot] {
    if __mc_hash_keys[slot] == key {
      __mc_hash_vals[slot] = idx;
      ret;
    }
    slot = (slot + 1) % __mc_hash_capacity;
  }
  __mc_hash_keys[slot] = key;
  __mc_hash_used[slot] = true;
  __mc_hash_vals[slot] = idx;
  __mc_hash_used_count = __mc_hash_used_count + 1;
}

// The live index of the allocation whose own base is exactly `ptr`, or
// -1 - same contract `__mc_find` exposes below, just O(1) average.
fun __mc_hash_lookup(raw* ptr) num {
  if __mc_hash_capacity == 0 {
    ret -1;
  }
  num key = __fun_mc_ptr_to_num(ptr);
  num slot = key % __mc_hash_capacity;
  num steps = 0;
  for steps < __mc_hash_capacity {
    if !__mc_hash_used[slot] {
      ret -1;
    }
    if __mc_hash_keys[slot] == key {
      ret __mc_hash_vals[slot];
    }
    slot = (slot + 1) % __mc_hash_capacity;
    steps = steps + 1;
  }
  ret -1;
}

// A freed allocation's guard pages stay in place forever by design (see
// this file's own top note) so a use-after-free can never land on a
// reused, now-valid address - but "forever" against a real test suite's
// own allocation volume means unbounded growth: a single allocation-
// heavy file was enough to exhaust a CI runner's memory outright before
// this budget existed (every `mmap`/`VirtualAlloc` call costs real
// pages that nothing ever gives back). Capped the same way a real tool
// like AddressSanitizer caps its own quarantine: once more than this
// many bytes are sitting freed-but-still-guarded, the OLDEST ones give
// up their guarantee and go back into circulation for a new allocation
// - a sufficiently delayed use-after-free past that point reads or
// writes the new owner's memory instead of faulting, same accepted
// trade a bounded quarantine always makes. 256 MiB is far more than any
// single real bug needs to surface (a UAF that only reproduces after a
// quarter-gigabyte of other allocations churn through first would be
// exceptionally rare), while staying well inside what any CI runner or
// dev machine has room for.
const num __mc_quarantine_budget = 268435456;

fun __mc_quarantine_grow_if_needed() {
  if __mc_quarantine_count < __mc_quarantine_capacity {
    ret;
  }
  num new_cap = __mc_quarantine_capacity * 2;
  if new_cap < 64 {
    new_cap = 64;
  }
  num* grown = __fun_real_malloc(new_cap * sizeof(num));
  num i = 0;
  for i < __mc_quarantine_count {
    grown[i] = __mc_quarantine_queue[(__mc_quarantine_head + i) % __mc_quarantine_capacity];
    i = i + 1;
  }
  if __mc_quarantine_capacity > 0 {
    __fun_real_free(__mc_quarantine_queue);
  }
  __mc_quarantine_queue = grown;
  __mc_quarantine_capacity = new_cap;
  __mc_quarantine_head = 0;
}

// Queues `idx` (an allocation `__fun_memcheck_free` just marked freed)
// for eventual recycling. Caller must already hold `__mc_mu`.
fun __mc_quarantine_push(num idx) {
  __mc_quarantine_grow_if_needed();
  num tail = (__mc_quarantine_head + __mc_quarantine_count) % __mc_quarantine_capacity;
  __mc_quarantine_queue[tail] = idx;
  __mc_quarantine_count = __mc_quarantine_count + 1;
}

fun __mc_quarantine_pop() num {
  num idx = __mc_quarantine_queue[__mc_quarantine_head];
  __mc_quarantine_head = (__mc_quarantine_head + 1) % __mc_quarantine_capacity;
  __mc_quarantine_count = __mc_quarantine_count - 1;
  ret idx;
}

fun __mc_freelist_grow_if_needed() {
  if __mc_freelist_count < __mc_freelist_capacity {
    ret;
  }
  num new_cap = __mc_freelist_capacity * 2;
  if new_cap < 64 {
    new_cap = 64;
  }
  raw** grown_base = __fun_real_malloc(new_cap * sizeof(raw*));
  num* grown_size = __fun_real_malloc(new_cap * sizeof(num));
  num i = 0;
  for i < __mc_freelist_count {
    grown_base[i] = __mc_freelist_base[i];
    grown_size[i] = __mc_freelist_size[i];
    i = i + 1;
  }
  if __mc_freelist_capacity > 0 {
    __fun_real_free(__mc_freelist_base);
    __fun_real_free(__mc_freelist_size);
  }
  __mc_freelist_base = grown_base;
  __mc_freelist_size = grown_size;
  __mc_freelist_capacity = new_cap;
}

fun __mc_freelist_push(raw* mmap_base, num total_size) {
  __mc_freelist_grow_if_needed();
  __mc_freelist_base[__mc_freelist_count] = mmap_base;
  __mc_freelist_size[__mc_freelist_count] = total_size;
  __mc_freelist_count = __mc_freelist_count + 1;
}

// A recycled region whose own total guarded size is exactly `total_size`,
// or nil - exact-size matching only, so a hit can be handed straight to
// `__fun_mc_guard_reuse` with the same page geometry `__fun_mc_guard_alloc`
// would have produced fresh, keeping the "end is exact against the guard
// page" guarantee intact for the new allocation too. A linear scan: the
// freelist only ever holds entries bounded by `__mc_quarantine_budget`
// worth of allocations, not the whole run's history.
fun __mc_freelist_take(num total_size) raw* {
  num i = 0;
  for i < __mc_freelist_count {
    if __mc_freelist_size[i] == total_size {
      raw* base = __mc_freelist_base[i];
      __mc_freelist_count = __mc_freelist_count - 1;
      __mc_freelist_base[i] = __mc_freelist_base[__mc_freelist_count];
      __mc_freelist_size[i] = __mc_freelist_size[__mc_freelist_count];
      ret base;
    }
    i = i + 1;
  }
  ret nil;
}

// Pops the oldest quarantined allocations back into the freelist until
// the budget is met again. Caller must already hold `__mc_mu`.
fun __mc_quarantine_drain_if_over_budget() {
  for __mc_quarantine_bytes > __mc_quarantine_budget && __mc_quarantine_count > 0 {
    num idx = __mc_quarantine_pop();
    AllocInfo* entry = &__mc_table[idx];
    __mc_quarantine_bytes = __mc_quarantine_bytes - entry.total_size;
    __mc_freelist_push(entry.mmap_base, entry.total_size);
  }
}

// Doubles the table's own capacity (64 to start) via the real,
// unredirected allocator - growing this table must never go through
// `__fun_memcheck_realloc`, which would just track itself. Caller
// must already hold `__mc_mu` - every helper below assumes the same.
fun __mc_grow_if_needed() {
  if __mc_count < __mc_capacity {
    ret;
  }
  num new_cap = __mc_capacity * 2;
  if new_cap < 64 {
    new_cap = 64;
  }
  raw* grown = __fun_real_realloc(__mc_table, new_cap * sizeof(AllocInfo));
  __mc_table = grown;
  __mc_capacity = new_cap;
}

// The live index of the allocation whose own base is exactly `ptr`, or
// -1 - the hot path on every `free`/`realloc`, so it goes through the
// hash table above rather than scanning `__mc_table` directly.
fun __mc_find(raw* ptr) num {
  ret __mc_hash_lookup(ptr);
}

// The index of the allocation whose own guarded span contains `addr`,
// live or freed - what the fault handler needs to tell a use-after-free
// (inside a freed span) from a buffer overflow (inside a live one's
// trailing guard page) from a genuinely unrelated fault (inside
// neither). Still a linear scan: only the fault handler calls this, on
// the crash path, not the hot path `__mc_find` above needed fixing.
// Keeps scanning past the first match rather than returning early: once
// the quarantine recycles a region (see its own note above), the same
// mmap_base/total_size span can belong to more than one historical
// entry here - the retired one still sitting at its old index, and
// whatever allocation reused that exact address sitting at a higher
// one. The higher index is always the one that's actually live (or
// most recently freed) at the address right now, so it's the only one
// whose metadata a report should ever name; stopping at the first
// match would misattribute a fault against the new allocation to the
// stale old one instead.
fun __mc_find_by_range(raw* addr) num {
  num i = 0;
  num found = -1;
  for i < __mc_count {
    if __fun_mc_ptr_in_range(addr, __mc_table[i].mmap_base, __mc_table[i].total_size) != 0 {
      found = i;
    }
    i = i + 1;
  }
  ret found;
}

// Registered with `__fun_mc_register_handler`, called from the
// SIGSEGV/access-violation trampoline codegen's own preamble installs.
fun __mc_fault_handler(num sig, raw* fault_addr, raw* ctx) {
  let _lk = __mc_mu.lock();
  num idx = __mc_find_by_range(fault_addr);
  flag is_freed = false;
  num info_seq = 0;
  num info_size = 0;
  str info_file = "";
  num info_line = 0;
  str info_freed_file = "";
  num info_freed_line = 0;
  raw* info_base = nil;
  if idx >= 0 {
    is_freed = __mc_table[idx].is_freed;
    info_seq = __mc_table[idx].seq;
    info_size = __mc_table[idx].size;
    info_file = __mc_table[idx].file;
    info_line = __mc_table[idx].line;
    info_freed_file = __mc_table[idx].freed_file;
    info_freed_line = __mc_table[idx].freed_line;
    info_base = __mc_table[idx].base;
  }
  let _ulk = __mc_mu.unlock();
  str msg = __fun_real_malloc(__mc_msg_cap);
  if idx >= 0 {
    str seq_s = __mc_format_num(info_seq);
    str size_s = __mc_format_num(info_size);
    str line_s = __mc_format_num(info_line);
    if is_freed {
      str freed_line_s = __mc_format_num(info_freed_line);
      let _n = snprintf(
        msg,
        __mc_msg_cap,
        "[memcheck] use-after-free: allocation #%s (%s bytes), allocated at %s:%s, freed at %s:%s",
        seq_s,
        size_s,
        info_file,
        line_s,
        info_freed_file,
        freed_line_s
      );
      __fun_real_free(freed_line_s);
    } else {
      // Live, so the fault is a genuine out-of-bounds access against one
      // of the two guard pages - which one tells an overrun from an
      // underrun apart. The two aren't symmetric in precision (see
      // `__fun_mc_guard_alloc`'s own note): a write even one byte past
      // the end always faults, but an underflow only faults once it
      // crosses the page-rounding slack before the start.
      flag before_start = fault_addr < info_base;
      if before_start {
        let _n = snprintf(
          msg,
          __mc_msg_cap,
          "[memcheck] buffer underflow: before the start of allocation #%s (%s bytes), allocated at %s:%s",
          seq_s,
          size_s,
          info_file,
          line_s
        );
      } else {
        let _n = snprintf(
          msg,
          __mc_msg_cap,
          "[memcheck] buffer overflow: past the end of allocation #%s (%s bytes), allocated at %s:%s",
          seq_s,
          size_s,
          info_file,
          line_s
        );
      }
    }
    __fun_real_free(seq_s);
    __fun_real_free(size_s);
    __fun_real_free(line_s);
  } else {
    str lit = "[memcheck] memory access violation (not within any tracked allocation)";
    let _n = snprintf(msg, __mc_msg_cap, "%s", lit);
  }
  let _fp = fprintf(stderr_stream(), "%s\n", msg);
  __fun_real_free(msg);
  let _ff = fflush(stderr_stream());
  abort();
}

// Registered with `atexit` - the only point a leak can be told apart
// from an allocation whose own program just hasn't gotten around to
// freeing it yet. Forces a nonzero exit on any leak found, even though
// `main` itself already returned cleanly - what makes this usable in CI.
fun __mc_leak_sweep() {
  if __mc_suppress_leak_sweep {
    ret;
  }
  num i = 0;
  num leaks = 0;
  for i < __mc_count {
    // Locked just for this one read, not across the `format`/`free`
    // below - those are further allocator calls (`free` redirects
    // back into this same module), which would try to re-lock `__mc_mu`
    // while this same thread still held it.
    let _lk = __mc_mu.lock();
    flag is_freed = __mc_table[i].is_freed;
    num seq = __mc_table[i].seq;
    num size = __mc_table[i].size;
    str file = __mc_table[i].file;
    num line = __mc_table[i].line;
    let _ulk = __mc_mu.unlock();
    if !is_freed {
      str msg = __fun_real_malloc(__mc_msg_cap);
      str seq_s = __mc_format_num(seq);
      str size_s = __mc_format_num(size);
      str line_s = __mc_format_num(line);
      let _n = snprintf(
        msg,
        __mc_msg_cap,
        "[memcheck] leak: allocation #%s, %s bytes, allocated at %s:%s, never freed",
        seq_s,
        size_s,
        file,
        line_s
      );
      let _fp = fprintf(stderr_stream(), "%s\n", msg);
      __fun_real_free(msg);
      __fun_real_free(seq_s);
      __fun_real_free(size_s);
      __fun_real_free(line_s);
      leaks = leaks + 1;
    }
    i = i + 1;
  }
  let _ff = fflush(stderr_stream());
  if leaks > 0 {
    exit(1);
  }
}

// Registers the fault handler and the leak sweep exactly once, on the
// first allocation or free this process ever makes under `-memcheck`.
// Not itself lock-protected, the same non-atomic once-check this
// codebase's own M:N scheduler already accepts for its one-time setup
// (`__fun_sched_init_once`) - two threads racing their very first
// allocation at the exact same instant is the one window this leaves
// open, not the steady-state table access the mutex below covers.
fun __mc_ensure_started() {
  if __mc_started {
    ret;
  }
  __mc_started = true;
  let _mu_rc = __mc_mu.init();
  let _rc = __fun_mc_register_handler(__mc_fault_handler);
  let _rc2 = atexit(__mc_leak_sweep);
}

pub fun __fun_memcheck_malloc(num size, str file, num line) raw* {
  __mc_ensure_started();
  __fun_mc_ensure_altstack();
  num real_size = size;
  if real_size <= 0 {
    real_size = 1;
  }
  num total_size = __fun_mc_guard_total_size(real_size);
  let _lkf = __mc_mu.lock();
  raw* recycled = __mc_freelist_take(total_size);
  let _ulkf = __mc_mu.unlock();
  raw* mmap_base = nil;
  raw* base = nil;
  if recycled != nil {
    mmap_base = recycled;
    base = __fun_mc_guard_reuse(recycled, total_size, real_size);
  } else {
    num fresh_total = 0;
    base = __fun_mc_guard_alloc(real_size, &fresh_total, &mmap_base);
    total_size = fresh_total;
  }
  if base == nil {
    // The quarantine above exists specifically so this almost never
    // happens under real workloads (see its own note); if it still
    // does, the system is genuinely out of memory. Reporting that
    // clearly and stopping beats returning nil here: ordinary `.fn`
    // code almost never checks an allocation for nil (same as most
    // real-world C), so letting this propagate silently just turns an
    // honest out-of-memory condition into a confusing, unattributed
    // null-pointer crash somewhere else entirely.
    str msg = __fun_real_malloc(__mc_msg_cap);
    str size_s = __mc_format_num(real_size);
    str line_s = __mc_format_num(line);
    let _n = snprintf(
      msg,
      __mc_msg_cap,
      "[memcheck] out of memory: allocation of %s bytes failed at %s:%s",
      size_s,
      file,
      line_s
    );
    let _fp = fprintf(stderr_stream(), "%s\n", msg);
    __fun_real_free(msg);
    __fun_real_free(size_s);
    __fun_real_free(line_s);
    let _ff = fflush(stderr_stream());
    abort();
  }
  let _lk = __mc_mu.lock();
  __mc_grow_if_needed();
  AllocInfo info;
  info.base = base;
  info.mmap_base = mmap_base;
  info.size = size;
  info.total_size = total_size;
  info.is_freed = false;
  info.seq = __mc_next_seq;
  info.file = file;
  info.line = line;
  info.freed_file = "";
  info.freed_line = 0;
  __mc_next_seq = __mc_next_seq + 1;
  __mc_table[__mc_count] = info;
  __mc_hash_insert(base, __mc_count);
  __mc_count = __mc_count + 1;
  let _ulk = __mc_mu.unlock();
  ret base;
}

// `mmap(MAP_ANONYMOUS)`/`VirtualAlloc` both hand back zeroed pages, so
// a fresh guarded region is already what `calloc` promises - no
// separate zeroing pass needed.
pub fun __fun_memcheck_calloc(num count, num size, str file, num line) raw* {
  ret __fun_memcheck_malloc(count * size, file, line);
}

pub fun __fun_memcheck_realloc(raw* ptr, num size, str file, num line) raw* {
  if ptr == nil {
    ret __fun_memcheck_malloc(size, file, line);
  }
  __mc_ensure_started();
  let _lk = __mc_mu.lock();
  num idx = __mc_find(ptr);
  flag have_old = idx >= 0;
  num old_size = 0;
  if have_old {
    old_size = __mc_table[idx].size;
  }
  let _ulk = __mc_mu.unlock();
  raw* new_ptr = __fun_memcheck_malloc(size, file, line);
  // A failed allocation leaves the original block valid and untouched,
  // same contract real `realloc` makes - freeing `ptr` anyway here
  // would leave the caller holding a dangling pointer it still thinks
  // is good, with no way to tell its "realloc" actually failed.
  if have_old && new_ptr != nil {
    num copy_size = old_size;
    if size < copy_size {
      copy_size = size;
    }
    if copy_size > 0 {
      let _cp = memcpy(new_ptr, ptr, copy_size);
    }
    __fun_memcheck_free(ptr, file, line);
  }
  ret new_ptr;
}

pub fun __fun_memcheck_free(raw* ptr, str file, num line) {
  if ptr == nil {
    ret;
  }
  __mc_ensure_started();
  __fun_mc_ensure_altstack();
  let _lk = __mc_mu.lock();
  num idx = __mc_find(ptr);
  if idx < 0 {
    let _ulk0 = __mc_mu.unlock();
    ret;
  }
  AllocInfo* entry = &__mc_table[idx];
  if entry.is_freed {
    num dbl_seq = entry.seq;
    num dbl_size = entry.size;
    str dbl_alloc_file = entry.file;
    num dbl_alloc_line = entry.line;
    str dbl_freed_file = entry.freed_file;
    num dbl_freed_line = entry.freed_line;
    let _ulk1 = __mc_mu.unlock();
    str msg = __fun_real_malloc(__mc_msg_cap);
    str dbl_seq_s = __mc_format_num(dbl_seq);
    str dbl_size_s = __mc_format_num(dbl_size);
    str dbl_alloc_line_s = __mc_format_num(dbl_alloc_line);
    str dbl_freed_line_s = __mc_format_num(dbl_freed_line);
    str line_s = __mc_format_num(line);
    let _n = snprintf(
      msg,
      __mc_msg_cap,
      "[memcheck] double-free: allocation #%s, %s bytes, allocated at %s:%s, already freed at %s:%s, double-freed at %s:%s",
      dbl_seq_s,
      dbl_size_s,
      dbl_alloc_file,
      dbl_alloc_line_s,
      dbl_freed_file,
      dbl_freed_line_s,
      file,
      line_s
    );
    let _fp = fprintf(stderr_stream(), "%s\n", msg);
    __fun_real_free(msg);
    __fun_real_free(dbl_seq_s);
    __fun_real_free(dbl_size_s);
    __fun_real_free(dbl_alloc_line_s);
    __fun_real_free(dbl_freed_line_s);
    __fun_real_free(line_s);
    let _ff = fflush(stderr_stream());
    abort();
  }
  let _rc = __fun_mc_guard_protect_all(entry.mmap_base, entry.total_size);
  entry.is_freed = true;
  entry.freed_file = file;
  entry.freed_line = line;
  __mc_quarantine_push(idx);
  __mc_quarantine_bytes = __mc_quarantine_bytes + entry.total_size;
  __mc_quarantine_drain_if_over_budget();
  let _ulk2 = __mc_mu.unlock();
}
