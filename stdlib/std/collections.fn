// Collection quirks and helpers.

imp std.quirks;

// A minimal collection quirk aligned with std.quirks.Sized.
// Kept here for discoverability when browsing stdlib.
// Collection quirk for len/is_empty.
// 
// Example:
// fun takes(Collection c) { if c.is_empty() { ... } }
pub quirk Collection {
  len() num;
  is_empty() bin;
}

// Bridge to std.quirks.Sized (same methods).
// Users can accept either quirk as needed.
// 
// Helper functions for common quirks.
pub fun len_of(Sized s) num {
  ret s.len();
}

pub fun is_empty_of(Sized s) bin {
  ret s.is_empty();
}

// Clear a collection-like value via the Clearable quirk.
pub fun clear_of(Clearable c) {
  c.clear();
}
