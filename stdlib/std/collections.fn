// Collection quirks and helpers.

imp std.quirks;

// Collection quirk for basic size introspection.
pub quirk Collection {
  // Returns the number of elements.
  len() num;
  // Returns true when the collection is empty.
  is_empty() bin;
}

// Returns the element count of a Sized value.
pub fun len_of(Sized s) num {
  ret s.len();
}

// Checks whether a Sized value is empty.
pub fun is_empty_of(Sized s) bin {
  ret s.is_empty();
}

// Clears a collection-like value via the Clearable quirk.
pub fun clear_of(Clearable c) {
  c.clear();
}
