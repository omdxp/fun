// Collection quirks and helpers.
// 
// Usage:
// ```
// fun takes(Collection c) { if c.is_empty() { ... } }
// ```

imp std.quirks;

// Collection quirk for basic size introspection.
pub quirk Collection {
  // Return the number of elements.
  // 
  // Returns:
  // - element count
  len() num;
  // Return true when the collection is empty.
  // 
  // Returns:
  // - true when the collection holds no elements
  is_empty() bin;
}

// Helper functions for common quirks.
// 
// Params:
// - s: sized value
// 
// Returns:
// - number of elements
pub fun len_of(Sized s) num {
  ret s.len();
}

// Check whether a Sized value is empty.
// 
// Params:
// - s: sized value
// 
// Returns:
// - true if size is zero
pub fun is_empty_of(Sized s) bin {
  ret s.is_empty();
}

// Clear a collection-like value via the Clearable quirk.
// 
// Params:
// - c: clearable value
pub fun clear_of(Clearable c) {
  c.clear();
}
