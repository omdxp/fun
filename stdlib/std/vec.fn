// Dynamic vectors for common types.

imp std.c.mem;
imp std.c.string;
imp std.c.io;
imp std.quirks;
imp std.option;

// Dynamic vector.
pub compound Vec<T> {
  // Backing storage.
  T[] data;
  // Number of initialized elements.
  num len;
  // Allocated storage capacity.
  num cap;
}

fun _str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

impl Vec<T> as Sized {
  // Returns the number of elements.
  pub len() num {
    ret self.len;
  }

  // Return true when the vector is empty.
  // 
  // Returns:
  // - true when the vector holds no elements
  pub is_empty() bin {
    ret self.len == 0;
  }

  // Return the current storage capacity.
  // 
  // Returns:
  // - allocated element capacity
  pub capacity() num {
    ret self.cap;
  }
}

impl Vec<T> {
  // Initialize the vector with an optional starting capacity.
  // 
  // Params:
  // - cap: requested initial capacity
  pub init(num cap = 8) {
    self.len = 0;
    self.cap = 0;
    if cap > 0 {
      self.grow(cap);
    }
  }

  // Create a zero value for T.
  zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Ensure capacity is at least the requested size.
  // 
  // Params:
  // - min_cap: minimum desired capacity
  pub reserve(num min_cap) {
    if min_cap > self.cap {
      self.grow(min_cap);
    }
  }

  // Grow backing storage to at least min_cap.
  grow(num min_cap) {
    let new_cap = self.cap;
    if new_cap < 4 {
      new_cap = 4;
    }
    for new_cap < min_cap {
      new_cap = new_cap * 2;
    }

    let new_size = new_cap * sizeof(T);
    if self.cap == 0 {
      self.data = malloc(new_size);
    } else {
      self.data = realloc(self.data, new_size);
    }
    self.cap = new_cap;
  }

  // Free the backing storage and reset the vector.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Return the element at index without bounds checking.
  // 
  // Params:
  // - i: element index
  // 
  // Notes:
  // - The caller must ensure `0 <= i < len`.
  // 
  // Returns:
  // - element at index `i`
  pub get(num i) T {
    ret self.data[i];
  }

  // Set the element at index without bounds checking.
  // 
  // Params:
  // - i: element index
  // - value: value to write
  // 
  // Notes:
  // - The caller must ensure `0 <= i < len`.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Append one value to the end of the vector.
  // 
  // Params:
  // - value: value to append
  pub push(T value) {
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Append multiple values from a source slice.
  // 
  // Params:
  // - src: source slice
  // - len: number of elements to append
  pub push_many(T[] src, num len) {
    if len <= 0 {
      ret;
    }
    self.reserve(self.len + len);
    num i = 0;
    for i < len {
      self.data[self.len + i] = src[i];
      i = i + 1;
    }
    self.len = self.len + len;
  }

  // Append values from another vector.
  // 
  // Params:
  // - other: source vector
  pub extend(Vec<T>* other) {
    num i = 0;
    for i < other.len {
      self.push(other.data[i]);
      i = i + 1;
    }
  }

  // Remove and return the last element.
  // 
  // Notes:
  // - Returns the zero value of `T` when the vector is empty.
  // - Pair with `is_empty()` or `last()` when the empty case matters.
  // 
  // Returns:
  // - removed last element
  // - zero value of `T` when the vector is empty
  pub pop() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    self.len = self.len - 1;
    ret self.data[self.len];
  }

  // Return the element at index when it is in range.
  // 
  // Params:
  // - i: element index
  // 
  // Returns:
  // - `Some(value)` when `i` is in range
  // - `None` otherwise
  pub at(num i) Option<T> {
    if i < 0 {
      ret .None;
    }
    if i >= self.len {
      ret .None;
    }
    ret .Some(self.data[i]);
  }

  // Return the first element when present.
  // 
  // Returns:
  // - `Some(value)` for the first element
  // - `None` when the vector is empty
  pub first() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.data[0]);
  }

  // Return the last element when present.
  // 
  // Returns:
  // - `Some(value)` for the last element
  // - `None` when the vector is empty
  pub last() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.data[self.len - 1]);
  }

  // Insert a value at an index.
  // 
  // Params:
  // - idx: insertion index
  // - value: value to insert
  // 
  // Notes:
  // - `idx` is clamped into the range `[0, len]`.
  pub insert(num idx, T value) {
    if idx < 0 {
      idx = 0;
    }
    if idx > self.len {
      idx = self.len;
    }
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    num i = self.len;
    for i > idx {
      self.data[i] = self.data[i - 1];
      i = i - 1;
    }
    self.data[idx] = value;
    self.len = self.len + 1;
  }

  // Remove an element at index while preserving order.
  // 
  // Params:
  // - idx: element index
  // 
  // Returns:
  // - removed value when `idx` is in range
  // - zero value of `T` otherwise
  pub remove_at(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    num i = idx;
    for i + 1 < self.len {
      self.data[i] = self.data[i + 1];
      i = i + 1;
    }
    self.len = self.len - 1;
    ret out;
  }

  // Remove an element at index by swapping it with the last element.
  // 
  // Params:
  // - idx: element index
  // 
  // Returns:
  // - removed value when `idx` is in range
  // - zero value of `T` otherwise
  pub swap_remove(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    self.len = self.len - 1;
    if idx != self.len {
      self.data[idx] = self.data[self.len];
    }
    ret out;
  }

  // Remove all elements without freeing capacity.
  pub clear() {
    self.len = 0;
  }

  // Swap two elements in place.
  // 
  // Params:
  // - i: first element index
  // - j: second element index
  pub swap(num i, num j) {
    T tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverse the element order in place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // Resize the vector to a new length.
  // 
  // Params:
  // - new_len: target length
  // - value: fill value for newly created elements
  pub resize(num new_len, T value) {
    if new_len < 0 {
      ret;
    }
    if new_len <= self.len {
      self.len = new_len;
      ret;
    }
    self.reserve(new_len);
    for self.len < new_len {
      self.data[self.len] = value;
      self.len = self.len + 1;
    }
  }

  // Shrink the backing storage to the current length.
  pub shrink_to_fit() {
    if self.cap == self.len {
      ret;
    }
    if self.len == 0 {
      if self.cap != 0 {
        free(self.data);
      }
      self.cap = 0;
      ret;
    }
    self.data = realloc(self.data, self.len * sizeof(T));
    self.cap = self.len;
  }

  // Return a shallow copy with independent backing storage.
  // 
  // Returns:
  // - cloned vector containing the same elements
  pub clone() Vec<T> {
    Vec<T> out;
    out.init(self.len);
    num i = 0;
    for i < self.len {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }

  // Return a new vector containing the elements in `[start, end)`.
  // 
  // Params:
  // - start: inclusive start index
  // - end: exclusive end index
  // 
  // Notes:
  // - Indices are clamped to the valid range.
  // 
  // Returns:
  // - new vector containing the requested slice
  pub slice(num start, num end) Vec<T> {
    if start < 0 {
      start = 0;
    }
    if end > self.len {
      end = self.len;
    }
    Vec<T> out;
    out.init(0);
    num i = start;
    for i < end {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }

  // Return a forward iterator over the elements.
  // 
  // Returns:
  // - iterator yielding each value once, in order
  pub iter() VecIter<T> {
    VecIter<T> it;
    it.src = self;
    it.idx = 0;
    ret it;
  }

  // Sort elements in place using a custom comparator (stable insertion sort).
  // Works for any element type, unlike the numeric `sort()`/`sort_desc()`
  // which are only available on `Vec<num>`/`Vec<dec>`.
  // 
  // Params:
  // - cmp: comparator returning negative if `a` sorts before `b`, positive if
  // `a` sorts after `b`, or 0 if they're equal (`strcmp`/`qsort` convention)
  pub sort_by(fun(T, T) num cmp) {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if cmp(self.data[j], key) <= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }
}

// Forward iterator over a Vec produced by `Vec.iter()`.
pub compound VecIter<T> {
  // Vector being iterated (borrowed, not owned).
  Vec<T>* src;
  // Index of the next element to yield.
  num idx;
}

impl VecIter<T> as Iterator<T> {
  // Return the next element from the iterator.
  // 
  // Returns:
  // - `Some(value)` while elements remain
  // - `None` once the iterator reaches the end
  pub next() Option<T> {
    if self.idx >= self.src.len {
      ret .None;
    }
    T value = self.src.data[self.idx];
    self.idx = self.idx + 1;
    ret .Some(value);
  }
}

impl Vec<T> as Clearable {
  // Remove all elements without freeing capacity.
  pub clear() {
    self.len = 0;
  }
}

impl Vec<str> {
  // Join string elements with a separator.
  // 
  // Params:
  // - sep: separator inserted between elements
  // 
  // Returns:
  // - joined string
  pub join(str sep) str {
    let sep_len = _str_len(sep);
    let count = self.len;
    if count == 0 {
      str out_empty = malloc(1);
      if out_empty == nil {
        ret nil;
      }
      out_empty[0] = '\0';
      ret out_empty;
    }

    num total = 0;
    num i = 0;
    for i < count {
      total = total + _str_len(self.data[i]);
      i = i + 1;
    }
    total = total + sep_len * (count - 1);

    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }

    num pos = 0;
    i = 0;
    for i < count {
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      if i + 1 < count {
        j = 0;
        for j < sep_len {
          out[pos + j] = sep[j];
          j = j + 1;
        }
        pos = pos + sep_len;
      }
      i = i + 1;
    }
    out[pos] = '\0';
    ret out;
  }
}

// Numeric methods shared across Vec<num> and Vec<dec> via constrained generics.
impl Vec<T: num | dec> {
  // Sort elements in ascending order in place.
  pub sort() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] <= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sort elements in descending order in place.
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] >= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Return true when a value is present.
  // 
  // Params:
  // - value: value to search for
  // 
  // Returns:
  // - true when the value exists in the vector
  pub contains(T value) bin {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Return the index of the first matching value.
  // 
  // Params:
  // - value: value to search for
  // 
  // Returns:
  // - first matching index
  // - `-1` when the value is not present
  pub index_of(T value) num {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }

  // Return the index of the first matching value as an Option.
  // 
  // Params:
  // - value: value to search for
  // 
  // Returns:
  // - `Some(index)` when the value is present
  // - `None` otherwise
  pub index_of_opt(T value) Option<num> {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret .Some(i);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Return the minimum value.
  // 
  // Returns:
  // - minimum value in the vector
  // - zero value of `T` when the vector is empty
  pub min() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] < m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Return the minimum value as an Option.
  // 
  // Returns:
  // - `Some(minimum)` when the vector is non-empty
  // - `None` when the vector is empty
  pub min_opt() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.min());
  }

  // Return the maximum value.
  // 
  // Returns:
  // - maximum value in the vector
  // - zero value of `T` when the vector is empty
  pub max() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] > m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Return the maximum value as an Option.
  // 
  // Returns:
  // - `Some(maximum)` when the vector is non-empty
  // - `None` when the vector is empty
  pub max_opt() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.max());
  }

  // Return the sum of all elements.
  // 
  // Returns:
  // - sum of the vector elements
  pub sum() T {
    T s = self.zero_value();
    num i = 0;
    for i < self.len {
      s = s + self.data[i];
      i = i + 1;
    }
    ret s;
  }
}

impl Vec<num> as Display {
  // Render as a bracketed list, e.g. "[1, 2, 3]".
  pub to_string() str {
    // Each 64-bit integer needs at most 20 digits plus a sign; allow 24 per
    // element, two bytes per separator, and the surrounding brackets.
    let budget = self.len * 24 + self.len * 2 + 3;
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    chr[24] cell;
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    num i = 0;
    for i < self.len {
      let written = snprintf(cell, 24, "%lld", self.data[i]);
      num k = 0;
      for k < written {
        out[pos + k] = cell[k];
        k = k + 1;
      }
      pos = pos + written;
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}

fun _str_cmp(str a, str b) num {
  num i = 0;
  for a[i] != 0 {
    if b[i] == 0 {
      ret 1;
    }
    if a[i] < b[i] {
      ret -1;
    }
    if a[i] > b[i] {
      ret 1;
    }
    i = i + 1;
  }
  if b[i] != 0 {
    ret -1;
  }
  ret 0;
}

impl Vec<str> {
  // Sort elements in ascending lexicographic order in place.
  pub sort() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) <= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sort elements in descending lexicographic order in place.
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) >= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Return true when a string value is present.
  // 
  // Params:
  // - value: string to search for
  // 
  // Returns:
  // - true when the value exists in the vector
  pub contains(str value) bin {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Return the index of the first matching string.
  // 
  // Params:
  // - value: string to search for
  // 
  // Returns:
  // - first matching index
  // - `-1` when the value is not present
  pub index_of(str value) num {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }

  // Return the index of the first matching string as an Option.
  // 
  // Params:
  // - value: string to search for
  // 
  // Returns:
  // - `Some(index)` when the value is present
  // - `None` otherwise
  pub index_of_opt(str value) Option<num> {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret .Some(i);
      }
      i = i + 1;
    }
    ret .None;
  }
}

impl Vec<str> as Display {
  // Render as a bracketed list of quoted strings, e.g. `["a", "b"]`.
  pub to_string() str {
    num total = 2;
    num i = 0;
    for i < self.len {
      total = total + _str_len(self.data[i]) + 2;
      if i + 1 < self.len {
        total = total + 2;
      }
      i = i + 1;
    }
    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    i = 0;
    for i < self.len {
      out[pos] = '"';
      pos = pos + 1;
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      out[pos] = '"';
      pos = pos + 1;
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}
