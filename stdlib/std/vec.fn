// Dynamic vectors for common types.

imp std.c.mem;
imp std.c.string;
imp std.c.io;
imp std.quirks;
imp std.option;

// Dynamic vector.
pub compound Vec<T> {
  // Backing storage.
  T[] data;
  // Number of initialized elements.
  num len;
  // Allocated storage capacity.
  num cap;
}

fun _str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

impl Vec<T> as Sized {
  // Returns the number of elements.
  pub len() num {
    ret self.len;
  }

  // Returns true when the vector holds no elements.
  pub is_empty() bin {
    ret self.len == 0;
  }

  // Returns the allocated element capacity.
  pub capacity() num {
    ret self.cap;
  }
}

impl Vec<T> {
  // Initializes the vector with an optional starting capacity.
  pub init(num cap = 8) {
    self.len = 0;
    self.cap = 0;
    if cap > 0 {
      self.grow(cap);
    }
  }

  // Returns a zero value for T.
  zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Ensures capacity is at least `min_cap` elements.
  pub reserve(num min_cap) {
    if min_cap > self.cap {
      self.grow(min_cap);
    }
  }

  // Grows backing storage to hold at least `min_cap` elements.
  grow(num min_cap) {
    let new_cap = self.cap;
    if new_cap < 4 {
      new_cap = 4;
    }
    for new_cap < min_cap {
      new_cap = new_cap * 2;
    }

    let new_size = new_cap * sizeof(T);
    if self.cap == 0 {
      self.data = malloc(new_size);
    } else {
      self.data = realloc(self.data, new_size);
    }
    self.cap = new_cap;
  }

  // Frees the backing storage and resets the vector.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Returns the element at index `i`. The caller must ensure `0 <= i < len`.
  pub get(num i) T {
    ret self.data[i];
  }

  // Writes `value` at index `i`. The caller must ensure `0 <= i < len`.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Appends one value to the end of the vector.
  pub push(T value) {
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Appends the first `len` values from `src`.
  pub push_many(T[] src, num len) {
    if len <= 0 {
      ret;
    }
    self.reserve(self.len + len);
    num i = 0;
    for i < len {
      self.data[self.len + i] = src[i];
      i = i + 1;
    }
    self.len = self.len + len;
  }

  // Appends every value from another vector.
  pub extend(Vec<T>* other) {
    num i = 0;
    for i < other.len {
      self.push(other.data[i]);
      i = i + 1;
    }
  }

  // Removes and returns the last element, or the zero value of `T` when the
  // vector is empty. Pair with `is_empty()` or `last()` when that matters.
  pub pop() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    self.len = self.len - 1;
    ret self.data[self.len];
  }

  // Returns `Some(value)` at index `i`, or `None` when `i` is out of range.
  pub at(num i) Option<T> {
    if i < 0 {
      ret .None;
    }
    if i >= self.len {
      ret .None;
    }
    ret .Some(self.data[i]);
  }

  // Returns the first element, or `None` when the vector is empty.
  pub first() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.data[0]);
  }

  // Returns the last element, or `None` when the vector is empty.
  pub last() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.data[self.len - 1]);
  }

  // Inserts a value at `idx`, which is clamped into the range `[0, len]`.
  pub insert(num idx, T value) {
    if idx < 0 {
      idx = 0;
    }
    if idx > self.len {
      idx = self.len;
    }
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    num i = self.len;
    for i > idx {
      self.data[i] = self.data[i - 1];
      i = i - 1;
    }
    self.data[idx] = value;
    self.len = self.len + 1;
  }

  // Removes the element at `idx` while preserving order, returning it. Yields
  // the zero value of `T` when `idx` is out of range.
  pub remove_at(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    num i = idx;
    for i + 1 < self.len {
      self.data[i] = self.data[i + 1];
      i = i + 1;
    }
    self.len = self.len - 1;
    ret out;
  }

  // Removes the element at `idx` by swapping in the last element, returning it.
  // Yields the zero value of `T` when `idx` is out of range.
  pub swap_remove(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    self.len = self.len - 1;
    if idx != self.len {
      self.data[idx] = self.data[self.len];
    }
    ret out;
  }

  // Removes all elements without freeing capacity.
  pub clear() {
    self.len = 0;
  }

  // Swaps the elements at `i` and `j` in place.
  pub swap(num i, num j) {
    T tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverses the element order in place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // Resizes the vector to `new_len`, filling any new elements with `value`.
  pub resize(num new_len, T value) {
    if new_len < 0 {
      ret;
    }
    if new_len <= self.len {
      self.len = new_len;
      ret;
    }
    self.reserve(new_len);
    for self.len < new_len {
      self.data[self.len] = value;
      self.len = self.len + 1;
    }
  }

  // Shrinks the backing storage to the current length.
  pub shrink_to_fit() {
    if self.cap == self.len {
      ret;
    }
    if self.len == 0 {
      if self.cap != 0 {
        free(self.data);
      }
      self.cap = 0;
      ret;
    }
    self.data = realloc(self.data, self.len * sizeof(T));
    self.cap = self.len;
  }

  // Returns a shallow copy with independent backing storage.
  pub clone() Vec<T> {
    Vec<T> out;
    out.init(self.len);
    num i = 0;
    for i < self.len {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }

  // Returns a new vector holding the elements in `[start, end)`, with both
  // indices clamped to the valid range.
  pub slice(num start, num end) Vec<T> {
    if start < 0 {
      start = 0;
    }
    if end > self.len {
      end = self.len;
    }
    Vec<T> out;
    out.init(0);
    num i = start;
    for i < end {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }

  // Returns a forward iterator yielding each element once, in order.
  pub iter() VecIter<T> {
    VecIter<T> it;
    it.src = self;
    it.idx = 0;
    ret it;
  }

  // Sorts elements in place with a stable insertion sort, for any element type.
  // `cmp` follows the `strcmp` convention: negative when `a` sorts before `b`,
  // positive when after, 0 when equal.
  pub sort_by(fun(T, T) num cmp) {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if cmp(self.data[j], key) <= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }
}

// Forward iterator over a Vec produced by `Vec.iter()`.
pub compound VecIter<T> {
  // Vector being iterated (borrowed, not owned).
  Vec<T>* src;
  // Index of the next element to yield.
  num idx;
}

impl VecIter<T> as Iterator<T> {
  // Returns the next element, or `None` once the end is reached.
  pub next() Option<T> {
    if self.idx >= self.src.len {
      ret .None;
    }
    T value = self.src.data[self.idx];
    self.idx = self.idx + 1;
    ret .Some(value);
  }
}

impl Vec<T> as Clearable {
  // Removes all elements without freeing capacity.
  pub clear() {
    self.len = 0;
  }
}

impl Vec<str> {
  // Joins the elements into one string with `sep` between them.
  pub join(str sep) str {
    let sep_len = _str_len(sep);
    let count = self.len;
    if count == 0 {
      str out_empty = malloc(1);
      if out_empty == nil {
        ret nil;
      }
      out_empty[0] = '\0';
      ret out_empty;
    }

    num total = 0;
    num i = 0;
    for i < count {
      total = total + _str_len(self.data[i]);
      i = i + 1;
    }
    total = total + sep_len * (count - 1);

    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }

    num pos = 0;
    i = 0;
    for i < count {
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      if i + 1 < count {
        j = 0;
        for j < sep_len {
          out[pos + j] = sep[j];
          j = j + 1;
        }
        pos = pos + sep_len;
      }
      i = i + 1;
    }
    out[pos] = '\0';
    ret out;
  }
}

// Numeric methods shared across Vec<num> and Vec<dec> via constrained generics.
impl Vec<T: num | dec> {
  // Sorts elements in ascending order in place.
  pub sort() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] <= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sorts elements in descending order in place.
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] >= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Returns true when the value is present.
  pub contains(T value) bin {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Returns the index of the first matching value, or `-1` when absent.
  pub index_of(T value) num {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }

  // Returns the index of the first matching value, or `None` when absent.
  pub index_of_opt(T value) Option<num> {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret .Some(i);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Returns the smallest element, or the zero value of `T` when empty.
  pub min() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] < m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Returns the smallest element, or `None` when the vector is empty.
  pub min_opt() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.min());
  }

  // Returns the largest element, or the zero value of `T` when empty.
  pub max() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] > m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Returns the largest element, or `None` when the vector is empty.
  pub max_opt() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.max());
  }

  // Returns the sum of all elements.
  pub sum() T {
    T s = self.zero_value();
    num i = 0;
    for i < self.len {
      s = s + self.data[i];
      i = i + 1;
    }
    ret s;
  }
}

impl Vec<num> as Display {
  // Renders as a bracketed list, e.g. "[1, 2, 3]".
  pub to_string() str {
    // Each 64-bit integer needs at most 20 digits plus a sign; allow 24 per
    // element, two bytes per separator, and the surrounding brackets.
    let budget = self.len * 24 + self.len * 2 + 3;
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    chr[24] cell;
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    num i = 0;
    for i < self.len {
      let written = snprintf(cell, 24, "%lld", self.data[i]);
      num k = 0;
      for k < written {
        out[pos + k] = cell[k];
        k = k + 1;
      }
      pos = pos + written;
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}

fun _str_cmp(str a, str b) num {
  num i = 0;
  for a[i] != 0 {
    if b[i] == 0 {
      ret 1;
    }
    if a[i] < b[i] {
      ret -1;
    }
    if a[i] > b[i] {
      ret 1;
    }
    i = i + 1;
  }
  if b[i] != 0 {
    ret -1;
  }
  ret 0;
}

impl Vec<str> {
  // Sorts elements in ascending lexicographic order in place.
  pub sort() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) <= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sorts elements in descending lexicographic order in place.
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) >= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Returns true when the string is present.
  pub contains(str value) bin {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Returns the index of the first matching string, or `-1` when absent.
  pub index_of(str value) num {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }

  // Returns the index of the first matching string, or `None` when absent.
  pub index_of_opt(str value) Option<num> {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret .Some(i);
      }
      i = i + 1;
    }
    ret .None;
  }
}

impl Vec<str> as Display {
  // Renders as a bracketed list of quoted strings, e.g. `["a", "b"]`.
  pub to_string() str {
    num total = 2;
    num i = 0;
    for i < self.len {
      total = total + _str_len(self.data[i]) + 2;
      if i + 1 < self.len {
        total = total + 2;
      }
      i = i + 1;
    }
    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    i = 0;
    for i < self.len {
      out[pos] = '"';
      pos = pos + 1;
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      out[pos] = '"';
      pos = pos + 1;
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}
