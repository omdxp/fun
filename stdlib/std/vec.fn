// Dynamic vectors for common types.

use std.c.mem;
use std.c.string;
use std.quirks;
use std.option;

// A comparison function for two values of one type, following the `strcmp`
// convention: negative when `a` sorts before `b`, positive when after, 0
// when equal.
pub als Comparator<T> = fun(T, T) num;

// Dynamic vector.
pub compound Vec<T> {
  // Backing storage.
  T[] data;
  // Number of initialized elements.
  num len;
  // Allocated storage capacity.
  num cap;
  // A `for` loop always drives iteration through a fresh copy of the
  // value it started from (never the caller's own variable), so this
  // cursor never observably leaks across two independent loops over
  // "the same" Vec, or a loop nested inside another over the same Vec.
  // Compiler-internal, not meant to be read or written directly.
  num __iter_pos;
}

fun _str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

impl Vec<T> as Sized {
  // Returns the number of elements.
  pub len() num {
    ret self.len;
  }

  // Returns true when the vector holds no elements.
  pub is_empty() flag {
    ret self.len == 0;
  }

  // Returns the allocated element capacity.
  pub capacity() num {
    ret self.cap;
  }
}

impl Vec<T> {
  // Initializes the vector with an optional starting capacity.
  pub init(num cap = 8) {
    self.len = 0;
    self.cap = 0;
    self.__iter_pos = 0;
    if cap > 0 {
      self.grow(cap);
    }
  }

  // Returns a zero value for T.
  zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Ensures capacity is at least `min_cap` elements.
  pub reserve(num min_cap) {
    if min_cap > self.cap {
      self.grow(min_cap);
    }
  }

  // Grows backing storage to hold at least `min_cap` elements.
  grow(num min_cap) {
    let new_cap = self.cap;
    if new_cap < 4 {
      new_cap = 4;
    }
    for new_cap < min_cap {
      new_cap = new_cap * 2;
    }

    let new_size = new_cap * sizeof(T);
    if self.cap == 0 {
      self.data = malloc(new_size);
    } else {
      self.data = realloc(self.data, new_size);
    }
    self.cap = new_cap;
  }

  // Frees the backing storage and resets the vector.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Returns the element at index `i`. The caller must ensure `0 <= i < len`.
  pub get(num i) T {
    ret self.data[i];
  }

  // Writes `value` at index `i`. The caller must ensure `0 <= i < len`.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Appends one value to the end of the vector.
  pub push(T value) {
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Appends the first `len` values from `src`.
  pub push_many(T[] src, num len) {
    if len <= 0 {
      ret;
    }
    self.reserve(self.len + len);
    num i = 0;
    for i < len {
      self.data[self.len + i] = src[i];
      i = i + 1;
    }
    self.len = self.len + len;
  }

  // Appends every value from another vector.
  pub extend(Vec<T>* other) {
    num i = 0;
    for i < other.len {
      self.push(other.data[i]);
      i = i + 1;
    }
  }

  // Removes and returns the last element, or the zero value of `T` when the
  // vector is empty. Pair with `is_empty()` or `last()` when that matters.
  pub pop() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    self.len = self.len - 1;
    ret self.data[self.len];
  }

  // Returns `Some(value)` at index `i`, or `None` when `i` is out of range.
  pub at(num i) Option<T> {
    if i < 0 {
      ret .None;
    }
    if i >= self.len {
      ret .None;
    }
    ret .Some(self.data[i]);
  }

  // Returns the first element, or `None` when the vector is empty.
  pub first() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.data[0]);
  }

  // Returns the last element, or `None` when the vector is empty.
  pub last() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.data[self.len - 1]);
  }

  // Inserts a value at `idx`, which is clamped into the range `[0, len]`.
  pub insert(num idx, T value) {
    if idx < 0 {
      idx = 0;
    }
    if idx > self.len {
      idx = self.len;
    }
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    num i = self.len;
    for i > idx {
      self.data[i] = self.data[i - 1];
      i = i - 1;
    }
    self.data[idx] = value;
    self.len = self.len + 1;
  }

  // Removes the element at `idx` while preserving order, returning it. Yields
  // the zero value of `T` when `idx` is out of range.
  pub remove_at(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    num i = idx;
    for i + 1 < self.len {
      self.data[i] = self.data[i + 1];
      i = i + 1;
    }
    self.len = self.len - 1;
    ret out;
  }

  // Removes the element at `idx` by swapping in the last element, returning it.
  // Yields the zero value of `T` when `idx` is out of range.
  pub swap_remove(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    self.len = self.len - 1;
    if idx != self.len {
      self.data[idx] = self.data[self.len];
    }
    ret out;
  }

  // Removes all elements without freeing capacity.
  pub clear() {
    self.len = 0;
  }

  // Swaps the elements at `i` and `j` in place.
  pub swap(num i, num j) {
    T tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverses the element order in place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // Resizes the vector to `new_len`, filling any new elements with `value`.
  pub resize(num new_len, T value) {
    if new_len < 0 {
      ret;
    }
    if new_len <= self.len {
      self.len = new_len;
      ret;
    }
    self.reserve(new_len);
    for self.len < new_len {
      self.data[self.len] = value;
      self.len = self.len + 1;
    }
  }

  // Shrinks the backing storage to the current length.
  pub shrink_to_fit() {
    if self.cap == self.len {
      ret;
    }
    if self.len == 0 {
      if self.cap != 0 {
        free(self.data);
      }
      self.cap = 0;
      ret;
    }
    self.data = realloc(self.data, self.len * sizeof(T));
    self.cap = self.len;
  }

  // Returns a new vector holding the elements in `[start, end)`, with both
  // indices clamped to the valid range.
  pub slice(num start, num end) Vec<T> {
    if start < 0 {
      start = 0;
    }
    if end > self.len {
      end = self.len;
    }
    Vec<T> out;
    out.init(0);
    num i = start;
    for i < end {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }

  // Sorts elements in place with a stable insertion sort, for any element type.
  pub sort_by(Comparator<T> cmp) {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if cmp(self.data[j], key) <= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }
}

// Vec implements Iterator<T> directly: a `for` loop drives this through a
// fresh copy of the value it started from (see `__iter_pos`'s own doc
// comment), never the caller's own variable, so calling this by hand on a
// value still being read elsewhere is the only case that needs the same
// care.
impl Vec<T> as Iterator<T> {
  // Returns the next element, or `None` once the end is reached (and
  // resets the cursor, so a value manually driven to exhaustion reads
  // as fresh again - not load-bearing for a `for` loop, which always
  // starts from its own copy regardless).
  pub next() Option<T> {
    if self.__iter_pos >= self.len {
      self.__iter_pos = 0;
      ret .None;
    }
    T value = self.data[self.__iter_pos];
    self.__iter_pos = self.__iter_pos + 1;
    ret .Some(value);
  }
}

impl Vec<T> as Clearable {
  // Removes all elements without freeing capacity.
  pub clear() {
    self.len = 0;
  }
}

impl Vec<T> as Clonable<Vec<T>> {
  // Returns a shallow copy with independent backing storage.
  pub clone() Vec<T> {
    Vec<T> out;
    out.init(self.len);
    num i = 0;
    for i < self.len {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }
}

impl Vec<str> {
  // Joins the elements into one string with `sep` between them.
  pub join(str sep) str {
    let sep_len = _str_len(sep);
    let count = self.len;
    if count == 0 {
      str out_empty = malloc(1);
      if out_empty == nil {
        ret nil;
      }
      out_empty[0] = '\0';
      ret out_empty;
    }

    num total = 0;
    num i = 0;
    for i < count {
      total = total + _str_len(self.data[i]);
      i = i + 1;
    }
    total = total + sep_len * (count - 1);

    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }

    num pos = 0;
    i = 0;
    for i < count {
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      if i + 1 < count {
        j = 0;
        for j < sep_len {
          out[pos + j] = sep[j];
          j = j + 1;
        }
        pos = pos + sep_len;
      }
      i = i + 1;
    }
    out[pos] = '\0';
    ret out;
  }
}

// Numeric methods shared across Vec<num> and Vec<dec> via constrained generics.
impl Vec<T: num | dec> {
  // Sorts elements in ascending order in place.
  pub sort() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] <= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sorts elements in descending order in place.
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] >= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Returns true when the value is present.
  pub contains(T value) flag {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Returns the index of the first matching value, or `-1` when absent.
  pub index_of(T value) num {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }

  // Returns the index of the first matching value, or `None` when absent.
  pub index_of_opt(T value) Option<num> {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret .Some(i);
      }
      i = i + 1;
    }
    ret .None;
  }

  // Returns the smallest element, or the zero value of `T` when empty.
  pub min() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] < m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Returns the smallest element, or `None` when the vector is empty.
  pub min_opt() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.min());
  }

  // Returns the largest element, or the zero value of `T` when empty.
  pub max() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] > m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Returns the largest element, or `None` when the vector is empty.
  pub max_opt() Option<T> {
    if self.len == 0 {
      ret .None;
    }
    ret .Some(self.max());
  }

  // Returns the sum of all elements.
  pub sum() T {
    T s = self.zero_value();
    num i = 0;
    for i < self.len {
      s = s + self.data[i];
      i = i + 1;
    }
    ret s;
  }
}

// Writes `n`'s own decimal text directly into `out` at `pos` (no
// separate heap allocation), returning the number of bytes written.
// Kept local rather than reusing std.string's format_num: importing
// std.string here would also pull its free join(Vec<str>*, str) back
// in transitively, which collides with this file's own Vec<str>.join
// method once both are visible in the same merged program.
fun _write_num(str out, num pos, num n) num {
  if n == 0 {
    out[pos] = '0';
    ret 1;
  }
  let neg = n < 0;
  if neg {
    n = 0 - n;
  }
  str digits = "0123456789";
  num start = pos;
  for n > 0 {
    out[pos] = digits[n % 10];
    n = n / 10;
    pos = pos + 1;
  }
  if neg {
    out[pos] = '-';
    pos = pos + 1;
  }
  num written = pos - start;
  num lo = start;
  num hi = pos - 1;
  for lo < hi {
    let tmp = out[lo];
    out[lo] = out[hi];
    out[hi] = tmp;
    lo = lo + 1;
    hi = hi - 1;
  }
  ret written;
}

impl Vec<num> as Display {
  // Renders as a bracketed list, e.g. "[1, 2, 3]".
  pub to_string() str {
    // Each 64-bit integer needs at most 20 digits plus a sign; allow 24 per
    // element, two bytes per separator, and the surrounding brackets.
    let budget = self.len * 24 + self.len * 2 + 3;
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    num i = 0;
    for i < self.len {
      pos = pos + _write_num(out, pos, self.data[i]);
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}

fun _str_cmp(str a, str b) num {
  num i = 0;
  for a[i] != 0 {
    if b[i] == 0 {
      ret 1;
    }
    if a[i] < b[i] {
      ret -1;
    }
    if a[i] > b[i] {
      ret 1;
    }
    i = i + 1;
  }
  if b[i] != 0 {
    ret -1;
  }
  ret 0;
}

impl Vec<str> {
  // Sorts elements in ascending lexicographic order in place.
  pub sort() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) <= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sorts elements in descending lexicographic order in place.
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) >= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Returns true when the string is present.
  pub contains(str value) flag {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Returns the index of the first matching string, or `-1` when absent.
  pub index_of(str value) num {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }

  // Returns the index of the first matching string, or `None` when absent.
  pub index_of_opt(str value) Option<num> {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret .Some(i);
      }
      i = i + 1;
    }
    ret .None;
  }
}

impl Vec<str> as Display {
  // Renders as a bracketed list of quoted strings, e.g. `["a", "b"]`.
  pub to_string() str {
    num total = 2;
    num i = 0;
    for i < self.len {
      total = total + _str_len(self.data[i]) + 2;
      if i + 1 < self.len {
        total = total + 2;
      }
      i = i + 1;
    }
    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    i = 0;
    for i < self.len {
      out[pos] = '"';
      pos = pos + 1;
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      out[pos] = '"';
      pos = pos + 1;
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}

fun _same(str a, str b) flag {
  ret _str_cmp(a, b) == 0;
}

fun _by_descending(num a, num b) num {
  if a > b {
    ret -1;
  }
  if a < b {
    ret 1;
  }
  ret 0;
}

fun _nums(num a, num b, num c) Vec<num> {
  Vec<num> v;
  v.init(2);
  v.push(a);
  v.push(b);
  v.push(c);
  ret v;
}

test "a vector grows, reads, writes and reports its size" {
  Vec<num> v;
  v.init(2);
  assert v.is_empty() && v.len() == 0 && v.capacity() == 4, "expected an empty vector with the minimum capacity";
  v.push(10);
  v.push(20);
  v.push(30);
  assert v.len() == 3 && v.capacity() >= 3 && !v.is_empty(), "expected it to have grown to fit";
  assert v.get(1) == 20, "expected a read";
  v.set(1, 25);
  assert v.get(1) == 25, "expected a write";
  assert v.pop() == 30 && v.len() == 2, "expected pop to return and remove the last";
  v.clear();
  assert v.is_empty() && v.pop() == 0, "expected popping an empty vector to give the zero value";
  v.reserve(100);
  assert v.capacity() >= 100, "expected reserve to make room";
  v.free();
  assert v.capacity() == 0 && v.len() == 0, "expected free to reset it";
}

test "checked reads return an Option" {
  Vec<num> v = _nums(5, 6, 7);
  assert v.at(0).unwrap() == 5 && v.at(2).unwrap() == 7, "expected the ends";
  assert v.at(3).is_none() && v.at(-1).is_none(), "expected out-of-range reads to be None";
  assert v.first().unwrap() == 5 && v.last().unwrap() == 7, "expected first and last";
  v.clear();
  assert v.first().is_none() && v.last().is_none(), "expected an empty vector to have neither";
  v.free();
}

test "push_many and extend append in order" {
  Vec<num> v = _nums(1, 2, 3);
  num[] more = malloc(sizeof(num) * 2);
  more[0] = 4;
  more[1] = 5;
  v.push_many(more, 2);
  v.push_many(more, 0);
  assert v.len() == 5 && v.get(4) == 5, "expected two appended and a zero-length append to change nothing";
  Vec<num> other = _nums(6, 7, 8);
  v.extend(&other);
  assert v.len() == 8 && v.get(7) == 8, "expected the other vector appended";
  v.free();
  other.free();
}

test "insert clamps its index, and the removals return what they took" {
  Vec<num> v = _nums(1, 2, 3);
  v.insert(1, 9);
  assert v.get(0) == 1 && v.get(1) == 9 && v.get(2) == 2 && v.len() == 4, "expected an insert in the middle";
  v.insert(-5, 0);
  v.insert(100, 8);
  assert v.get(0) == 0 && v.get(v.len() - 1) == 8, "expected stray indexes to clamp to the ends";
  assert v.remove_at(1) == 1 && v.get(1) == 9, "expected remove_at to shift the rest down";
  assert v.remove_at(-1) == 0 && v.remove_at(99) == 0, "expected an out-of-range removal to return the zero value";
  Vec<num> w = _nums(10, 20, 30);
  assert w.swap_remove(0) == 10 && w.get(0) == 30 && w.len() == 2, "expected swap_remove to fill the gap with the last";
  assert w.swap_remove(1) == 20 && w.len() == 1, "expected removing the last to just shrink";
  assert w.swap_remove(-1) == 0 && w.swap_remove(5) == 0, "expected out-of-range to return the zero value";
  v.free();
  w.free();
}

test "swap, reverse, resize and shrink_to_fit" {
  Vec<num> v = _nums(1, 2, 3);
  v.swap(0, 2);
  assert v.get(0) == 3 && v.get(2) == 1, "expected the ends swapped";
  v.reverse();
  assert v.get(0) == 1 && v.get(2) == 3, "expected the order reversed";
  Vec<num> one = _nums(4, 4, 4);
  one.resize(1, 0);
  one.reverse();
  assert one.len() == 1, "expected resize to shrink and reversing one element to be a no-op";
  v.resize(5, 7);
  assert v.len() == 5 && v.get(4) == 7 && v.get(3) == 7, "expected growth to fill with the value";
  v.resize(-1, 0);
  assert v.len() == 5, "expected a negative length to change nothing";
  v.resize(2, 0);
  assert v.len() == 2, "expected shrinking";
  v.shrink_to_fit();
  assert v.capacity() == 2 && v.get(1) == 2, "expected the capacity trimmed to the length";
  v.shrink_to_fit();
  assert v.capacity() == 2, "expected shrinking an exact fit to change nothing";
  v.clear();
  v.shrink_to_fit();
  assert v.capacity() == 0, "expected an empty vector to release its storage";
  v.free();
  one.free();
}

test "slice clamps its bounds, and sort_by uses the comparator" {
  Vec<num> v = _nums(3, 1, 2);
  Vec<num> mid = v.slice(1, 3);
  assert mid.len() == 2 && mid.get(0) == 1 && mid.get(1) == 2, "expected the middle";
  Vec<num> all = v.slice(-4, 99);
  assert all.len() == 3, "expected stray bounds to clamp";
  v.sort_by(_by_descending);
  assert v.get(0) == 3 && v.get(1) == 2 && v.get(2) == 1, "expected descending order from the comparator";
  v.free();
  mid.free();
  all.free();
}

test "a vector iterates, clones independently and clears through its quirks" {
  Vec<num> v = _nums(1, 2, 3);
  num total = 0;
  for x : v {
    total = total + x;
  }
  assert total == 6, "expected every element visited";
  Vec<num> copy = v.clone();
  copy.push(4);
  assert v.len() == 3 && copy.len() == 4, "expected a clone to be independent";
  Clearable c = &copy;
  c.clear();
  assert copy.is_empty(), "expected clear through the quirk";
  v.free();
  copy.free();
}

test "numeric vectors sort, search and reduce" {
  Vec<num> v = _nums(3, 1, 2);
  v.sort();
  assert v.get(0) == 1 && v.get(2) == 3, "expected ascending order";
  v.sort_desc();
  assert v.get(0) == 3 && v.get(2) == 1, "expected descending order";
  assert v.contains(2) && !v.contains(9), "expected membership";
  assert v.index_of(1) == 2 && v.index_of(9) == -1, "expected the index or -1";
  assert v.index_of_opt(3).unwrap() == 0 && v.index_of_opt(9).is_none(), "expected the index as an Option";
  assert v.min() == 1 && v.max() == 3 && v.sum() == 6, "expected the extremes and the sum";
  assert v.min_opt().unwrap() == 1 && v.max_opt().unwrap() == 3, "expected the extremes as Options";
  v.clear();
  assert v.min() == 0 && v.max() == 0 && v.sum() == 0, "expected an empty vector to reduce to zero";
  assert v.min_opt().is_none() && v.max_opt().is_none(), "expected no extremes when empty";
  v.free();
}

test "decimal vectors reduce too" {
  Vec<dec> v;
  v.init(2);
  v.push(1.5);
  v.push(0.5);
  v.push(2.0);
  assert v.sum() == 4.0 && v.min() == 0.5 && v.max() == 2.0, "expected the decimal sum and extremes";
  v.sort();
  assert v.get(0) == 0.5 && v.get(2) == 2.0, "expected ascending decimals";
  v.free();
}

test "string vectors join, sort and search" {
  Vec<str> v;
  v.init(2);
  str empty = v.join(", ");
  assert _same(empty, ""), "expected joining nothing to give an empty string";
  v.push("pear");
  str single = v.join(", ");
  assert _same(single, "pear"), "expected one item with no separator";
  v.push("apple");
  v.push("fig");
  str joined = v.join(", ");
  assert _same(joined, "pear, apple, fig"), "expected the items separated";
  str tight = v.join("");
  assert _same(tight, "pearapplefig"), "expected an empty separator";
  v.sort();
  assert _same(v.get(0), "apple") && _same(v.get(2), "pear"), "expected alphabetical order";
  v.sort_desc();
  assert _same(v.get(0), "pear") && _same(v.get(2), "apple"), "expected reverse alphabetical order";
  assert v.contains("fig") && !v.contains("plum"), "expected membership";
  assert v.index_of("fig") == 1 && v.index_of("plum") == -1, "expected the index or -1";
  assert v.index_of_opt("apple").unwrap() == 2 && v.index_of_opt("plum").is_none(), "expected the index as an Option";
  assert !v.contains("fi") && !v.contains("figs"), "expected a prefix or an extension not to match";
  free(empty);
  free(single);
  free(joined);
  free(tight);
  v.free();
}

test "vectors render as text" {
  Vec<num> n = _nums(3, 0, -12);
  str a = n.to_string();
  assert _same(a, "[3, 0, -12]"), "expected numbers with a sign and a zero";
  free(a);
  n.clear();
  str b = n.to_string();
  assert _same(b, "[]"), "expected an empty vector";
  free(b);
  Vec<str> s;
  s.init(2);
  s.push("a");
  s.push("bc");
  str c = s.to_string();
  assert _same(c, "[\"a\", \"bc\"]"), "expected quoted strings";
  free(c);
  n.free();
  s.free();
}
