// Dynamic vectors for common types.

imp std.c.mem;
imp std.c.def;
imp std.quirks;

// Dynamic vector of numbers.
// 
// Fields:
// - data: backing storage
// - len: number of elements
// - cap: allocated capacity
pub compound NumVec {
  // data: backing storage
  num[] data;
  // len: number of elements
  num len;
  // cap: allocated capacity
  num cap;
}

// Dynamic vector of strings.
// 
// Fields:
// - data: backing storage
// - len: number of elements
// - cap: allocated capacity
pub compound StrVec {
  // data: backing storage
  str[] data;
  // len: number of elements
  num len;
  // cap: allocated capacity
  num cap;
}

fun _str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

fun _num_vec_grow(NumVec* v, num min_cap) {
  num new_cap = v.cap;
  if new_cap < 4 {
    new_cap = 4;
  }
  for new_cap < min_cap {
    new_cap = new_cap * 2;
  }

  num new_size = new_cap * sizeof(num);
  if v.cap == 0 {
    v.data = malloc(new_size);
  } else {
    v.data = realloc(v.data, new_size);
  }
  v.cap = new_cap;
}

fun _str_vec_grow(StrVec* v, num min_cap) {
  num new_cap = v.cap;
  if new_cap < 4 {
    new_cap = 4;
  }
  for new_cap < min_cap {
    new_cap = new_cap * 2;
  }

  num new_size = new_cap * sizeof(str);
  if v.cap == 0 {
    v.data = malloc(new_size);
  } else {
    v.data = realloc(v.data, new_size);
  }
  v.cap = new_cap;
}

// Create a numeric vector with optional capacity.
// 
// Params:
// - cap: initial capacity (0 for none)
// 
// Returns:
// - initialized NumVec
pub fun num_vec_init(num cap) NumVec {
  NumVec v;
  v.len = 0;
  v.cap = 0;
  if cap > 0 {
    _num_vec_grow(&v, cap);
  }
  ret v;
}

impl NumVec Sized {
  // Number of elements.
  pub len() num {
    ret self.len;
  }

  // True when empty.
  pub is_empty() bin {
    ret self.len == 0;
  }
}

impl NumVec {
  // Free backing storage.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Get element at index.
  pub get(num i) num {
    ret self.data[i];
  }

  // Set element at index.
  pub set(num i, num value) {
    self.data[i] = value;
  }

  // Append a value.
  pub push(num value) {
    if self.len + 1 > self.cap {
      _num_vec_grow(self, self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Clear without freeing capacity.
  pub clear() {
    self.len = 0;
  }
}

// Free a NumVec.
pub fun num_vec_free(NumVec* v) {
  v.free();
}

// Get NumVec length.
pub fun num_vec_len(NumVec* v) num {
  ret v.len();
}

// Get NumVec element at index.
pub fun num_vec_get(NumVec* v, num i) num {
  ret v.get(i);
}

// Set NumVec element at index.
pub fun num_vec_set(NumVec* v, num i, num value) {
  v.set(i, value);
}

// Append to NumVec.
pub fun num_vec_push(NumVec* v, num value) {
  v.push(value);
}

// Create a string vector with optional capacity.
// 
// Params:
// - cap: initial capacity (0 for none)
// 
// Returns:
// - initialized StrVec
pub fun str_vec_init(num cap) StrVec {
  StrVec v;
  v.len = 0;
  v.cap = 0;
  if cap > 0 {
    _str_vec_grow(&v, cap);
  }
  ret v;
}

impl StrVec Sized {
  // Number of elements.
  pub len() num {
    ret self.len;
  }

  // True when empty.
  pub is_empty() bin {
    ret self.len == 0;
  }
}

impl StrVec {
  // Free backing storage.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Get element at index.
  pub get(num i) str {
    ret self.data[i];
  }

  // Set element at index.
  pub set(num i, str value) {
    self.data[i] = value;
  }

  // Append a value.
  pub push(str value) {
    if self.len + 1 > self.cap {
      _str_vec_grow(self, self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Clear without freeing capacity.
  pub clear() {
    self.len = 0;
  }

  // Join elements with a separator.
  pub join(str sep) str {
    num sep_len = _str_len(sep);
    num count = self.len;
    if count == 0 {
      ret "";
    }

    num total = 0;
    num i = 0;
    for i < count {
      total = total + _str_len(self.data[i]);
      i = i + 1;
    }
    total = total + sep_len * (count - 1);

    str out = malloc(total + 1);
    if out == NULL {
      ret NULL;
    }

    num pos = 0;
    i = 0;
    for i < count {
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      if i + 1 < count {
        j = 0;
        for j < sep_len {
          out[pos + j] = sep[j];
          j = j + 1;
        }
        pos = pos + sep_len;
      }
      i = i + 1;
    }
    out[pos] = '\0';
    ret out;
  }
}

// Free a StrVec.
pub fun str_vec_free(StrVec* v) {
  v.free();
}

// Get StrVec length.
pub fun str_vec_len(StrVec* v) num {
  ret v.len();
}

// Get StrVec element at index.
pub fun str_vec_get(StrVec* v, num i) str {
  ret v.get(i);
}

// Set StrVec element at index.
pub fun str_vec_set(StrVec* v, num i, str value) {
  v.set(i, value);
}

// Append to StrVec.
pub fun str_vec_push(StrVec* v, str value) {
  v.push(value);
}
