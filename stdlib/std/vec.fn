// Dynamic vectors for common types.
// 
// Usage:
// ```
// Vec<num> v;
// v.init(0);
// v.push(1);
// v.push(2);
// ```

imp std.c.mem;
imp std.c.string;
imp std.c.io;
imp std.quirks;
imp std.option;

// Dynamic vector.
pub compound Vec<T> {
  // backing storage
  T[] data;
  // number of elements
  num len;
  // allocated capacity
  num cap;
}

fun _str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

impl Vec<T> as Sized {
  // Number of elements.
  pub len() num {
    ret self.len;
  }

  // True when empty.
  pub is_empty() bin {
    ret self.len == 0;
  }

  // Current capacity.
  pub capacity() num {
    ret self.cap;
  }
}

impl Vec<T> {
  // Initialize with an optional capacity.
  pub init(num cap) {
    self.len = 0;
    self.cap = 0;
    if cap > 0 {
      self.grow(cap);
    }
  }

  // Create a zero value for T.
  pub zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Ensure capacity is at least min_cap.
  pub reserve(num min_cap) {
    if min_cap > self.cap {
      self.grow(min_cap);
    }
  }

  // Grow backing storage to at least min_cap.
  grow(num min_cap) {
    num new_cap = self.cap;
    if new_cap < 4 {
      new_cap = 4;
    }
    for new_cap < min_cap {
      new_cap = new_cap * 2;
    }

    num new_size = new_cap * sizeof(T);
    if self.cap == 0 {
      self.data = malloc(new_size);
    } else {
      self.data = realloc(self.data, new_size);
    }
    self.cap = new_cap;
  }

  // Free backing storage.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Get element at index.
  pub get(num i) T {
    ret self.data[i];
  }

  // Set element at index.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Append a value.
  pub push(T value) {
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Append multiple values from a slice.
  pub push_many(T[] src, num len) {
    if len <= 0 {
      ret;
    }
    self.reserve(self.len + len);
    num i = 0;
    for i < len {
      self.data[self.len + i] = src[i];
      i = i + 1;
    }
    self.len = self.len + len;
  }

  // Append values from another Vec.
  pub extend(Vec<T>* other) {
    num i = 0;
    for i < other.len {
      self.push(other.data[i]);
      i = i + 1;
    }
  }

  // Pop the last element (zero value if empty). The mutating, ergonomic form; pair
  // with `is_empty()` when the empty case matters, or read `last()` first.
  pub pop() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    self.len = self.len - 1;
    ret self.data[self.len];
  }

  // Bounds-checked element access: Some(value) in range, None otherwise.
  pub at(num i) Option<T> {
    if i < 0 {
      ret Option.None;
    }
    if i >= self.len {
      ret Option.None;
    }
    ret Option.Some(self.data[i]);
  }

  // First element as Some, or None when empty.
  pub first() Option<T> {
    if self.len == 0 {
      ret Option.None;
    }
    ret Option.Some(self.data[0]);
  }

  // Last element as Some, or None when empty (the safe counterpart to `pop()`).
  pub last() Option<T> {
    if self.len == 0 {
      ret Option.None;
    }
    ret Option.Some(self.data[self.len - 1]);
  }

  // Insert a value at index (clamped to [0, len]).
  pub insert(num idx, T value) {
    if idx < 0 {
      idx = 0;
    }
    if idx > self.len {
      idx = self.len;
    }
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    num i = self.len;
    for i > idx {
      self.data[i] = self.data[i - 1];
      i = i - 1;
    }
    self.data[idx] = value;
    self.len = self.len + 1;
  }

  // Remove element at index (preserve order). Returns removed value or zero.
  pub remove_at(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    num i = idx;
    for i + 1 < self.len {
      self.data[i] = self.data[i + 1];
      i = i + 1;
    }
    self.len = self.len - 1;
    ret out;
  }

  // Remove element at index by swapping with last. Returns removed value or zero.
  pub swap_remove(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    self.len = self.len - 1;
    if idx != self.len {
      self.data[idx] = self.data[self.len];
    }
    ret out;
  }

  // Clear without freeing capacity.
  pub clear() {
    self.len = 0;
  }

  // Swap two elements.
  pub swap(num i, num j) {
    T tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverse elements in-place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // Resize vector to new_len, filling new slots with value.
  pub resize(num new_len, T value) {
    if new_len < 0 {
      ret;
    }
    if new_len <= self.len {
      self.len = new_len;
      ret;
    }
    self.reserve(new_len);
    for self.len < new_len {
      self.data[self.len] = value;
      self.len = self.len + 1;
    }
  }

  // Shrink capacity to current length.
  pub shrink_to_fit() {
    if self.cap == self.len {
      ret;
    }
    if self.len == 0 {
      if self.cap != 0 {
        free(self.data);
      }
      self.cap = 0;
      ret;
    }
    self.data = realloc(self.data, self.len * sizeof(T));
    self.cap = self.len;
  }

  // A shallow copy holding the same elements (independent backing storage).
  pub clone() Vec<T> {
    Vec<T> out;
    out.init(self.len);
    num i = 0;
    for i < self.len {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }

  // A new Vec with the elements in [start, end) (indices are clamped to range).
  pub slice(num start, num end) Vec<T> {
    if start < 0 {
      start = 0;
    }
    if end > self.len {
      end = self.len;
    }
    Vec<T> out;
    out.init(0);
    num i = start;
    for i < end {
      out.push(self.data[i]);
      i = i + 1;
    }
    ret out;
  }

  // A forward iterator over the elements (yields each value once, in order).
  pub iter() VecIter<T> {
    VecIter<T> it;
    it.src = self;
    it.idx = 0;
    ret it;
  }
}

// Forward iterator over a Vec produced by `Vec.iter()`.
pub compound VecIter<T> {
  // the vector being iterated (borrowed, not owned)
  Vec<T>* src;
  // index of the next element to yield
  num idx;
}

impl VecIter<T> as Iterator<T> {
  // Yield the next element, or None once the end is reached.
  pub next() Option<T> {
    if self.idx >= self.src.len {
      ret Option.None;
    }
    T value = self.src.data[self.idx];
    self.idx = self.idx + 1;
    ret Option.Some(value);
  }
}

impl Vec<T> as Clearable {
  // Clear without freeing capacity.
  pub clear() {
    self.len = 0;
  }
}

impl Vec<str> {
  // Join elements with a separator.
  pub join(str sep) str {
    num sep_len = _str_len(sep);
    num count = self.len;
    if count == 0 {
      str out_empty = malloc(1);
      if out_empty == nil {
        ret nil;
      }
      out_empty[0] = '\0';
      ret out_empty;
    }

    num total = 0;
    num i = 0;
    for i < count {
      total = total + _str_len(self.data[i]);
      i = i + 1;
    }
    total = total + sep_len * (count - 1);

    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }

    num pos = 0;
    i = 0;
    for i < count {
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      if i + 1 < count {
        j = 0;
        for j < sep_len {
          out[pos + j] = sep[j];
          j = j + 1;
        }
        pos = pos + sep_len;
      }
      i = i + 1;
    }
    out[pos] = '\0';
    ret out;
  }
}

// Numeric methods shared across Vec<num> and Vec<dec> via constrained generics.
impl Vec<T: num | dec> {
  // Sort elements in ascending order (in-place, insertion sort).
  pub sort() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] <= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sort elements in descending order (in-place, insertion sort).
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      T key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if self.data[j] >= key {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Return true if value is present.
  pub contains(T value) bin {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Return index of first occurrence, or -1 if not found.
  pub index_of(T value) num {
    num i = 0;
    for i < self.len {
      if self.data[i] == value {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }

  // Return the minimum value, or zero if empty.
  pub min() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] < m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Return the maximum value, or zero if empty.
  pub max() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    T m = self.data[0];
    num i = 1;
    for i < self.len {
      if self.data[i] > m {
        m = self.data[i];
      }
      i = i + 1;
    }
    ret m;
  }

  // Return the sum of all elements.
  pub sum() T {
    T s = self.zero_value();
    num i = 0;
    for i < self.len {
      s = s + self.data[i];
      i = i + 1;
    }
    ret s;
  }
}

impl Vec<num> as Display {
  // Render as a bracketed list, e.g. "[1, 2, 3]".
  pub to_string() str {
    // Each 64-bit integer needs at most 20 digits plus a sign; allow 24 per
    // element, two bytes per separator, and the surrounding brackets.
    num budget = self.len * 24 + self.len * 2 + 3;
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    chr[24] cell;
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    num i = 0;
    for i < self.len {
      num written = snprintf(cell, 24, "%lld", self.data[i]);
      num k = 0;
      for k < written {
        out[pos + k] = cell[k];
        k = k + 1;
      }
      pos = pos + written;
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}

fun _str_cmp(str a, str b) num {
  num i = 0;
  for a[i] != 0 {
    if b[i] == 0 {
      ret 1;
    }
    if a[i] < b[i] {
      ret -1;
    }
    if a[i] > b[i] {
      ret 1;
    }
    i = i + 1;
  }
  if b[i] != 0 {
    ret -1;
  }
  ret 0;
}

impl Vec<str> {
  // Sort elements in ascending lexicographic order (in-place, insertion sort).
  pub sort() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) <= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Sort elements in descending lexicographic order (in-place, insertion sort).
  pub sort_desc() {
    num i = 1;
    for i < self.len {
      str key = self.data[i];
      num j = i - 1;
      for j >= 0 {
        if _str_cmp(self.data[j], key) >= 0 {
          break;
        }
        self.data[j + 1] = self.data[j];
        j = j - 1;
      }
      self.data[j + 1] = key;
      i = i + 1;
    }
  }

  // Return true if value is present (exact string equality).
  pub contains(str value) bin {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret true;
      }
      i = i + 1;
    }
    ret false;
  }

  // Return index of first occurrence, or -1 if not found.
  pub index_of(str value) num {
    num i = 0;
    for i < self.len {
      if _str_cmp(self.data[i], value) == 0 {
        ret i;
      }
      i = i + 1;
    }
    ret -1;
  }
}

impl Vec<str> as Display {
  // Render as a bracketed list of quoted strings, e.g. `["a", "b"]`.
  pub to_string() str {
    num total = 2;
    num i = 0;
    for i < self.len {
      total = total + _str_len(self.data[i]) + 2;
      if i + 1 < self.len {
        total = total + 2;
      }
      i = i + 1;
    }
    str out = malloc(total + 1);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '[';
    pos = pos + 1;
    i = 0;
    for i < self.len {
      out[pos] = '"';
      pos = pos + 1;
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      out[pos] = '"';
      pos = pos + 1;
      if i + 1 < self.len {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      i = i + 1;
    }
    out[pos] = ']';
    out[pos + 1] = '\0';
    ret out;
  }
}
