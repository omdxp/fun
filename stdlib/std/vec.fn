// Dynamic vectors for common types.
// 
// Usage:
// ```
// Vec<num> v;
// v.init(0);
// v.push(1);
// v.push(2);
// ```

imp std.c.mem;
imp std.c.string;
imp std.c.def;
imp std.quirks;

// Dynamic vector.
// 
// Fields:
// - data: backing storage
// - len: number of elements
// - cap: allocated capacity
pub compound Vec<T> {
  // data: backing storage
  T[] data;
  // len: number of elements
  num len;
  // cap: allocated capacity
  num cap;
}

fun _str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

impl Vec<T> Sized {
  // Number of elements.
  pub len() num {
    ret self.len;
  }

  // True when empty.
  pub is_empty() bin {
    ret self.len == 0;
  }

  // Current capacity.
  pub capacity() num {
    ret self.cap;
  }
}

impl Vec<T> {
  // Initialize with an optional capacity.
  pub init(num cap) {
    self.len = 0;
    self.cap = 0;
    if cap > 0 {
      self.grow(cap);
    }
  }

  // Create a zero value for T.
  pub zero_value() T {
    T out;
    memset(&out, 0, sizeof(T));
    ret out;
  }

  // Ensure capacity is at least min_cap.
  pub reserve(num min_cap) {
    if min_cap > self.cap {
      self.grow(min_cap);
    }
  }

  // Grow backing storage to at least min_cap.
  grow(num min_cap) {
    num new_cap = self.cap;
    if new_cap < 4 {
      new_cap = 4;
    }
    for new_cap < min_cap {
      new_cap = new_cap * 2;
    }

    num new_size = new_cap * sizeof(T);
    if self.cap == 0 {
      self.data = malloc(new_size);
    } else {
      self.data = realloc(self.data, new_size);
    }
    self.cap = new_cap;
  }

  // Free backing storage.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Get element at index.
  pub get(num i) T {
    ret self.data[i];
  }

  // Set element at index.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Append a value.
  pub push(T value) {
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Append multiple values from a slice.
  pub push_many(T[] src, num len) {
    if len <= 0 {
      ret;
    }
    self.reserve(self.len + len);
    num i = 0;
    for i < len {
      self.data[self.len + i] = src[i];
      i = i + 1;
    }
    self.len = self.len + len;
  }

  // Append values from another Vec.
  pub extend(Vec<T>* other) {
    num i = 0;
    for i < other.len {
      self.push(other.data[i]);
      i = i + 1;
    }
  }

  // Return last element (zero if empty).
  pub last() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    ret self.data[self.len - 1];
  }

  // Pop last element (zero if empty).
  pub pop() T {
    if self.len == 0 {
      ret self.zero_value();
    }
    self.len = self.len - 1;
    ret self.data[self.len];
  }

  // Insert a value at index (clamped to [0, len]).
  pub insert(num idx, T value) {
    if idx < 0 {
      idx = 0;
    }
    if idx > self.len {
      idx = self.len;
    }
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    num i = self.len;
    for i > idx {
      self.data[i] = self.data[i - 1];
      i = i - 1;
    }
    self.data[idx] = value;
    self.len = self.len + 1;
  }

  // Remove element at index (preserve order). Returns removed value or zero.
  pub remove_at(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    num i = idx;
    for i + 1 < self.len {
      self.data[i] = self.data[i + 1];
      i = i + 1;
    }
    self.len = self.len - 1;
    ret out;
  }

  // Remove element at index by swapping with last. Returns removed value or zero.
  pub swap_remove(num idx) T {
    if idx < 0 {
      ret self.zero_value();
    }
    if idx >= self.len {
      ret self.zero_value();
    }
    T out = self.data[idx];
    self.len = self.len - 1;
    if idx != self.len {
      self.data[idx] = self.data[self.len];
    }
    ret out;
  }

  // Clear without freeing capacity.
  pub clear() {
    self.len = 0;
  }

  // Swap two elements.
  pub swap(num i, num j) {
    T tmp = self.data[i];
    self.data[i] = self.data[j];
    self.data[j] = tmp;
  }

  // Reverse elements in-place.
  pub reverse() {
    if self.len <= 1 {
      ret;
    }
    num i = 0;
    num j = self.len - 1;
    for i < j {
      self.swap(i, j);
      i = i + 1;
      j = j - 1;
    }
  }

  // Resize vector to new_len, filling new slots with value.
  pub resize(num new_len, T value) {
    if new_len < 0 {
      ret;
    }
    if new_len <= self.len {
      self.len = new_len;
      ret;
    }
    self.reserve(new_len);
    for self.len < new_len {
      self.data[self.len] = value;
      self.len = self.len + 1;
    }
  }

  // Shrink capacity to current length.
  pub shrink_to_fit() {
    if self.cap == self.len {
      ret;
    }
    if self.len == 0 {
      if self.cap != 0 {
        free(self.data);
      }
      self.cap = 0;
      ret;
    }
    self.data = realloc(self.data, self.len * sizeof(T));
    self.cap = self.len;
  }
}

impl Vec<str> {
  // Join elements with a separator.
  pub join(str sep) str {
    num sep_len = _str_len(sep);
    num count = self.len;
    if count == 0 {
      str out_empty = malloc(1);
      if out_empty == NULL {
        ret NULL;
      }
      out_empty[0] = '\0';
      ret out_empty;
    }

    num total = 0;
    num i = 0;
    for i < count {
      total = total + _str_len(self.data[i]);
      i = i + 1;
    }
    total = total + sep_len * (count - 1);

    str out = malloc(total + 1);
    if out == NULL {
      ret NULL;
    }

    num pos = 0;
    i = 0;
    for i < count {
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      if i + 1 < count {
        j = 0;
        for j < sep_len {
          out[pos + j] = sep[j];
          j = j + 1;
        }
        pos = pos + sep_len;
      }
      i = i + 1;
    }
    out[pos] = '\0';
    ret out;
  }
}

// Backwards-compatible helpers were removed in favor of generic Vec<T>.
