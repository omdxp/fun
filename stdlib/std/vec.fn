// Dynamic vectors for common types.

imp std.c.mem;
imp std.c.def;
imp std.quirks;

// Dynamic vector.
// 
// Fields:
// - data: backing storage
// - len: number of elements
// - cap: allocated capacity
pub compound Vec < T > {
  // data: backing storage
  T[] data;
  // len: number of elements
  num len;
  // cap: allocated capacity
  num cap;
}

fun _str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

impl Vec < T > Sized {
  // Number of elements.
  pub len() num {
    ret self.len;
  }

  // True when empty.
  pub is_empty() bin {
    ret self.len == 0;
  }
}

impl Vec < T > {
  // Initialize with an optional capacity.
  pub init(num cap) {
    self.len = 0;
    self.cap = 0;
    if cap > 0 {
      self.grow(cap);
    }
  }

  // Grow backing storage to at least min_cap.
  grow(num min_cap) {
    num new_cap = self.cap;
    if new_cap < 4 {
      new_cap = 4;
    }
    for new_cap < min_cap {
      new_cap = new_cap * 2;
    }

    num new_size = new_cap * sizeof(T);
    if self.cap == 0 {
      self.data = malloc(new_size);
    } else {
      self.data = realloc(self.data, new_size);
    }
    self.cap = new_cap;
  }

  // Free backing storage.
  pub free() {
    if self.cap != 0 {
      free(self.data);
    }
    self.len = 0;
    self.cap = 0;
  }

  // Get element at index.
  pub get(num i) T {
    ret self.data[i];
  }

  // Set element at index.
  pub set(num i, T value) {
    self.data[i] = value;
  }

  // Append a value.
  pub push(T value) {
    if self.len + 1 > self.cap {
      self.grow(self.len + 1);
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
  }

  // Clear without freeing capacity.
  pub clear() {
    self.len = 0;
  }
}

impl Vec < str > {
  // Join elements with a separator.
  pub join(str sep) str {
    num sep_len = _str_len(sep);
    num count = self.len;
    if count == 0 {
      ret "";
    }

    num total = 0;
    num i = 0;
    for i < count {
      total = total + _str_len(self.data[i]);
      i = i + 1;
    }
    total = total + sep_len * (count - 1);

    str out = malloc(total + 1);
    if out == NULL {
      ret NULL;
    }

    num pos = 0;
    i = 0;
    for i < count {
      str part = self.data[i];
      num plen = _str_len(part);
      num j = 0;
      for j < plen {
        out[pos + j] = part[j];
        j = j + 1;
      }
      pos = pos + plen;
      if i + 1 < count {
        j = 0;
        for j < sep_len {
          out[pos + j] = sep[j];
          j = j + 1;
        }
        pos = pos + sep_len;
      }
      i = i + 1;
    }
    out[pos] = '\0';
    ret out;
  }
}

// Backwards-compatible helpers were removed in favor of generic Vec<T>.
