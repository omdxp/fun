// File system helpers built on std.io.

imp std.io;
imp std.channel;
imp std.c.io;
imp std.c.mem;
imp std.c.dirent;
imp std.vec;
imp std.result;
imp std.error;
imp std.string;

// File system helper container.
pub compound Fs {
}

// Create an Fs helper instance.
// 
// Returns:
// - Fs helper
pub fun fs() Fs {
  Fs f;
  ret f;
}

// Copy a directory-entry name into a Fun-owned buffer. `__fun_dir_read_name`
// returns a pointer into an OS-owned buffer that gets reused on the next
// call, so a name that needs to outlive the current loop iteration must be
// duplicated first.
fun _dup_cstr(str s) str {
  let b = string_builder_init(len(s));
  b.append(s);
  let out = b.build();
  b.free();
  ret out;
}

// Recursively collect `.fn` file paths under `path` into `out`.
fun _walk_dir_collect(str path, Vec<str>* out) {
  raw* d = __fun_dir_open(path);
  if d == nil {
    ret;
  }
  for true {
    str name = __fun_dir_read_name(d);
    if name == nil {
      break;
    }
    if equals(name, ".") || equals(name, "..") {
      continue;
    }

    let b = string_builder_init(len(path) + len(name) + 1);
    b.append(path);
    b.append("/");
    b.append(name);
    let full = b.build();
    b.free();

    if __fun_path_is_dir(full) != 0 {
      _walk_dir_collect(full, out);
      free(full);
    } elif ends_with(full, ".fn") {
      out.push(full);
    } else {
      free(full);
    }
  }
  __fun_dir_close(d);
}

impl Fs {
  // Check whether a file exists.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - true if the file can be opened
  pub exists(str path) bin {
    FILE* f = fopen(path, "rb");
    if f == nil {
      ret false;
    }
    fclose(f);
    ret true;
  }

  // Read an entire file into a string.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - file contents or null
  pub read_to_string(str path) str {
    ret read_all(path);
  }

  // Read an entire file into a string with Result.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - Result<str, Error> with contents or error
  pub try_read_to_string(str path) Result<str, Error> {
    let out = read_all(path);
    if out == nil {
      ret err_kind(.Io, "read_to_string failed", "");
    }
    ret .Ok(out);
  }

  // Read up to max_len bytes into a string.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum bytes to read
  // 
  // Returns:
  // - bytes string or null
  pub read_bytes(str path, num max_len) str {
    if max_len <= 0 {
      ret nil;
    }
    FILE* h = fopen(path, "rb");
    if h == nil {
      ret nil;
    }
    defer fclose(h);
    str buf = malloc(max_len + 1);
    if buf == nil {
      ret nil;
    }
    let read = fread(buf, 1, max_len, h);
    buf[read] = '\0';
    ret buf;
  }

  // Read up to max_len bytes into a string with Result.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum bytes to read
  // 
  // Returns:
  // - Result<str, Error> with bytes or error
  pub try_read_bytes(str path, num max_len) Result<str, Error> {
    let out = self.read_bytes(path, max_len);
    if out == nil {
      ret err_kind(.Io, "read_bytes failed", "");
    }
    ret .Ok(out);
  }

  // Write a string to a file.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - true on success
  pub write_string(str path, str data) bin {
    ret write_all(path, data);
  }

  // Write a string to a file with Result.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - Result<bin, Error> with success flag or error
  pub try_write_string(str path, str data) Result<bin, Error> {
    let ok_write = write_all(path, data);
    if ok_write == false {
      ret err_kind(.Io, "write_string failed", false);
    }
    ret .Ok(true);
  }

  // Append a string to a file.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - true on success
  pub append_string(str path, str data) bin {
    FILE* h = fopen(path, "ab");
    if h == nil {
      ret false;
    }
    defer fclose(h);
    let n = len(data);
    let wrote = fwrite(data, 1, n, h);
    ret wrote == n;
  }

  // Append a string to a file with Result.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - Result<bin, Error> with success flag or error
  pub try_append_string(str path, str data) Result<bin, Error> {
    let ok_append = self.append_string(path, data);
    if ok_append == false {
      ret err_kind(.Io, "append_string failed", false);
    }
    ret .Ok(true);
  }

  // Copy a file by reading into memory and writing out.
  // 
  // Params:
  // - src: source path
  // - dst: destination path
  // 
  // Returns:
  // - true on success
  pub copy_file(str src, str dst) bin {
    let data = read_all(src);
    if data == nil {
      ret false;
    }
    ret write_all(dst, data);
  }

  // Copy a file by reading into memory and writing out with Result.
  // 
  // Params:
  // - src: source path
  // - dst: destination path
  // 
  // Returns:
  // - Result<bin, Error> with success flag or error
  pub try_copy_file(str src, str dst) Result<bin, Error> {
    let data = read_all(src);
    if data == nil {
      ret err_kind(.Io, "copy_file read failed", false);
    }
    if write_all(dst, data) == false {
      ret err_kind(.Io, "copy_file write failed", false);
    }
    ret .Ok(true);
  }

  // Get file size (bytes), or -1.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - size in bytes or -1
  pub size(str path) num {
    FILE* h = fopen(path, "rb");
    if h == nil {
      ret -1;
    }
    defer fclose(h);
    if fseek(h, 0, 2) != 0 {
      ret -1;
    }
    let end = ftell(h);
    if end < 0 {
      ret -1;
    }
    ret end;
  }

  // Get file size with Result.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - Result<num, Error> with size or error
  pub try_size(str path) Result<num, Error> {
    let out = self.size(path);
    if out < 0 {
      ret err_kind(.Io, "size failed", -1);
    }
    ret .Ok(out);
  }

  // Read all lines into a Vec<str>.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum line length
  // 
  // Returns:
  // - Vec<str> of lines (may be empty)
  pub read_lines(str path, num max_len) Vec<str> {
    Vec<str> out;
    out.init(8);
    FILE* h = fopen(path, "rb");
    if h == nil {
      ret out;
    }
    defer fclose(h);
    for true {
      if max_len <= 1 {
        break;
      }
      str buf = malloc(max_len);
      if buf == nil {
        break;
      }
      str res = fgets(buf, max_len, h);
      if res == nil {
        free(buf);
        break;
      }
      out.push(buf);
    }
    ret out;
  }

  // Read all lines into a Vec<str> with Result.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum line length
  // 
  // Returns:
  // - Result<Vec<str>, Error> with lines or error
  pub try_read_lines(str path, num max_len) Result<Vec<str>, Error> {
    let out = self.read_lines(path, max_len);
    if out.len == 0 {
      // Best-effort: treat empty as ok unless file can't be opened.
      if self.exists(path) == false {
        ret err_kind(.NotFound, "read_lines failed", out);
      }
    }
    ret .Ok(out);
  }

  // Check whether path names a directory.
  // 
  // Params:
  // - path: path to check
  // 
  // Returns:
  // - true if path is an existing directory
  pub is_dir(str path) bin {
    ret __fun_path_is_dir(path) != 0;
  }

  // Create a single directory. The parent must already exist -- this is not
  // recursive (see `walk_dir` for recursive traversal of existing
  // directories; a recursive `mkdir -p` is not provided here).
  // 
  // Params:
  // - path: directory path to create
  // 
  // Returns:
  // - Result<bin, Error> Ok(true) on success, Err on failure (including if the
  // directory already exists)
  pub make_dir(str path) Result<bin, Error> {
    if __fun_make_dir(path) != 0 {
      ret err_kind(.Io, "make_dir failed", false);
    }
    ret .Ok(true);
  }

  // List the immediate entries of a directory (excludes `.`/`..`; includes
  // both files and subdirectories, unfiltered by name).
  // 
  // Params:
  // - path: directory path
  // 
  // Returns:
  // - Result<Vec<str>, Error> Ok(names) on success, Err if the directory can't be opened
  pub list_dir(str path) Result<Vec<str>, Error> {
    raw* d = __fun_dir_open(path);
    if d == nil {
      Vec<str> empty;
      empty.init(0);
      ret err_kind(.Io, "list_dir: could not open directory", empty);
    }
    Vec<str> out;
    out.init(8);
    for true {
      str name = __fun_dir_read_name(d);
      if name == nil {
        break;
      }
      if equals(name, ".") || equals(name, "..") {
        continue;
      }
      out.push(_dup_cstr(name));
    }
    __fun_dir_close(d);
    ret .Ok(out);
  }

  // Recursively discover every `.fn` file under a directory. Used by the
  // build tooling to find a project's source files without an explicit
  // per-file manifest entry.
  // 
  // Params:
  // - path: root directory to search
  // 
  // Returns:
  // - Vec<str> of `.fn` file paths (empty if `path` isn't a readable directory)
  pub walk_dir(str path) Vec<str> {
    Vec<str> out;
    out.init(16);
    _walk_dir_collect(path, &out);
    ret out;
  }
}

// Check file existence.
// 
// Params:
// - path: file path
// 
// Returns:
// - true if file can be opened
pub fun exists(str path) bin {
  let f = fs();
  ret f.exists(path);
}

// Read an entire file into a string.
// 
// Params:
// - path: file path
// 
// Returns:
// - file contents or null
pub fun read_to_string(str path) str {
  let f = fs();
  ret f.read_to_string(path);
}

// Read up to max_len bytes into a string.
// 
// Params:
// - path: file path
// - max_len: maximum bytes to read
// 
// Returns:
// - bytes string or null
pub fun read_bytes(str path, num max_len) str {
  let f = fs();
  ret f.read_bytes(path, max_len);
}

// Write a string to a file.
// 
// Params:
// - path: file path
// - data: contents
// 
// Returns:
// - true on success
pub fun write_string(str path, str data) bin {
  let f = fs();
  ret f.write_string(path, data);
}

// Append a string to a file.
// 
// Params:
// - path: file path
// - data: contents
// 
// Returns:
// - true on success
pub fun append_string(str path, str data) bin {
  let f = fs();
  ret f.append_string(path, data);
}

// Copy a file by reading into memory and writing out.
// 
// Params:
// - src: source path
// - dst: destination path
// 
// Returns:
// - true on success
pub fun copy_file(str src, str dst) bin {
  let f = fs();
  ret f.copy_file(src, dst);
}

// Get file size in bytes (or -1 on failure).
// 
// Params:
// - path: file path
// 
// Returns:
// - size in bytes
pub fun size(str path) num {
  let f = fs();
  ret f.size(path);
}

// File size with Result. `Ok(bytes)` on success, `Err` when the file can't be
// sized — clearer than checking `size(path) < 0` for the -1 sentinel.
pub fun try_size(str path) Result<num, Error> {
  let n = size(path);
  if n < 0 {
    ret err_kind(.Io, "size failed", -1);
  }
  ret .Ok(n);
}

// Read all lines into a Vec<str>.
// 
// Params:
// - path: file path
// - max_len: maximum line length
// 
// Returns:
// - Vec<str> of lines (may be empty)
pub fun read_lines(str path, num max_len) Vec<str> {
  let f = fs();
  ret f.read_lines(path, max_len);
}

// Check whether path names a directory.
// 
// Params:
// - path: path to check
// 
// Returns:
// - true if path is an existing directory
pub fun is_dir(str path) bin {
  let f = fs();
  ret f.is_dir(path);
}

// Create a single directory (parent must already exist; not recursive).
// 
// Params:
// - path: directory path to create
// 
// Returns:
// - Result<bin, Error> Ok(true) on success, Err on failure
pub fun make_dir(str path) Result<bin, Error> {
  let f = fs();
  ret f.make_dir(path);
}

// List the immediate entries of a directory (excludes `.`/`..`).
// 
// Params:
// - path: directory path
// 
// Returns:
// - Result<Vec<str>, Error> Ok(names) on success, Err if the directory can't be opened
pub fun list_dir(str path) Result<Vec<str>, Error> {
  let f = fs();
  ret f.list_dir(path);
}

// Recursively discover every `.fn` file under a directory.
// 
// Params:
// - path: root directory to search
// 
// Returns:
// - Vec<str> of `.fn` file paths (empty if path isn't a readable directory)
pub fun walk_dir(str path) Vec<str> {
  let f = fs();
  ret f.walk_dir(path);
}

// Copy a file in chunks with optional cancellation and non-blocking progress updates.
// 
// Params:
// - src: source path
// - dst: destination path
// - chunk_size: bytes per copy chunk (<= 0 defaults to 4096)
// - progress_updates: optional channel receiving cumulative copied byte counts
// - cancel_token: optional cancellation token
// 
// Returns:
// - >= 0 total copied bytes on success
// - -1 on open/read/write/flush failure or null src/dst
// - -2 when buffer allocation fails
// - -3 when cancelled
pub async fun copy_file_progress_async(
  str src,
  str dst,
  num chunk_size,
  Channel<num>* progress_updates,
  ChannelCancelToken* cancel_token
) num {
  if src == nil || dst == nil {
    ret -1;
  }

  if chunk_size <= 0 {
    chunk_size = 4096;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  let in_file = open_read(src);
  if in_file.handle == nil {
    ret -1;
  }
  defer in_file.close();

  let out_file = open_write(dst);
  if out_file.handle == nil {
    ret -1;
  }
  defer out_file.close();

  raw* buf = malloc(chunk_size);
  if buf == nil {
    ret -2;
  }
  defer free(buf);

  num total = 0;
  for true {
    if channel_cancel_token_is_cancelled(cancel_token) == true {
      ret -3;
    }

    let n = in_file.read_into(buf, chunk_size);
    if n < 0 {
      ret -1;
    }
    if n == 0 {
      break;
    }

    if out_file.write_bytes(buf, n) == false {
      ret -1;
    }
    total = total + n;

    if progress_updates != nil {
      // Progress is best-effort: a Full channel (no reader keeping up) is fine to skip;
      // only a cancellation or a real failure aborts the copy.
      fit await progress_updates.send_result_timeout_with_token_async(total, 0, cancel_token) {
        .Cancelled -> { ret -3; }
        .Closed -> { ret -1; }
        .Error(e) -> { ret -1; }
        _ -> {}
      }
    }
  }

  if out_file.flush() == false {
    ret -1;
  }
  ret total;
}

// Stream lines from a file into a channel using async send operations.
// 
// Ownership:
// - each pushed line is heap-allocated; the receiver should free it.
// 
// Returns:
// - >= 0 number of lines sent on success
// - -1 on invalid args or file open/read failure
// - -3 when cancelled
pub async fun read_lines_into_channel_async(
  str path,
  num max_len,
  Channel<str>* out_lines,
  ChannelCancelToken* cancel_token
) num {
  if path == nil || out_lines == nil || max_len <= 1 {
    ret -1;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  File f = open_read(path);
  if f.handle == nil {
    ret -1;
  }
  defer f.close();

  num sent = 0;
  for true {
    if channel_cancel_token_is_cancelled(cancel_token) == true {
      ret -3;
    }

    let line = f.read_line_max(max_len);
    if line == nil {
      break;
    }

    fit await out_lines.send_result_with_token_async(line, cancel_token) {
      .Ok -> {}
      .Cancelled -> {
        free(line);
        ret -3;
      }
      .Closed -> {
        free(line);
        ret sent;
      }
      _ -> {
        free(line);
        ret -1;
      }
    }

    sent = sent + 1;
  }

  ret sent;
}
