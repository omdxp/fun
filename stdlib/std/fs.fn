// File system helpers built on std.io.

use std.io;
use std.channel;
use std.c.io;
use std.c.mem;
use std.c.dirent;
use std.vec;
use std.result;
use std.error;
use std.string;

// File system helper container.
pub compound Fs {
}

// Creates an Fs helper instance.
pub fun fs() Fs {
  Fs f;
  ret f;
}

// Copy a directory-entry name into a Fun-owned buffer. `__fun_dir_read_name`
// returns a pointer into an OS-owned buffer that gets reused on the next
// call, so a name that needs to outlive the current loop iteration must be
// duplicated first.
fun _dup_cstr(str s) str {
  let b = string_builder_init(len(s));
  b.append(s);
  let out = b.build();
  b.free();
  ret out;
}

// Recursively collect `.fn` file paths under `path` into `out`.
fun _walk_dir_collect(str path, Vec<str>* out) {
  raw* d = __fun_dir_open(path);
  if d == nil {
    ret;
  }
  for true {
    str name = __fun_dir_read_name(d);
    if name == nil {
      break;
    }
    if equals(name, ".") || equals(name, "..") {
      continue;
    }

    let b = string_builder_init(len(path) + len(name) + 1);
    b.append(path);
    b.append("/");
    b.append(name);
    let full = b.build();
    b.free();

    if __fun_path_is_dir(full) != 0 {
      _walk_dir_collect(full, out);
      free(full);
    } elif ends_with(full, ".fn") {
      out.push(full);
    } else {
      free(full);
    }
  }
  __fun_dir_close(d);
}

impl Fs {
  // Returns true if the file at `path` can be opened.
  pub exists(str path) flag {
    FILE* f = fopen(path, "rb");
    if f == nil {
      ret false;
    }
    fclose(f);
    ret true;
  }

  // Reads an entire file into a new string, or null on failure.
  pub read_to_string(str path) str {
    ret read_all(path);
  }

  // Reads an entire file into a string, with Result.
  pub try_read_to_string(str path) Result<str, Error> {
    let out = read_all(path);
    if out == nil {
      ret err_kind(.Io, "read_to_string failed", "");
    }
    ret .Ok(out);
  }

  // Reads up to max_len bytes into a new string, or null on failure.
  pub read_bytes(str path, num max_len) str {
    if max_len <= 0 {
      ret nil;
    }
    FILE* h = fopen(path, "rb");
    if h == nil {
      ret nil;
    }
    defer fclose(h);
    str buf = malloc(max_len + 1);
    if buf == nil {
      ret nil;
    }
    let read = fread(buf, 1, max_len, h);
    buf[read] = '\0';
    ret buf;
  }

  // Reads up to max_len bytes into a string, with Result.
  pub try_read_bytes(str path, num max_len) Result<str, Error> {
    let out = self.read_bytes(path, max_len);
    if out == nil {
      ret err_kind(.Io, "read_bytes failed", "");
    }
    ret .Ok(out);
  }

  // Writes `data` to a file, returning true on success.
  pub write_string(str path, str data) flag {
    ret write_all(path, data);
  }

  // Deletes the file at `path`, returning true on success.
  pub remove_file(str path) flag {
    ret remove(path) == 0;
  }

  // Writes `data` to a file, with Result.
  pub try_write_string(str path, str data) Result<flag, Error> {
    let ok_write = write_all(path, data);
    if ok_write == false {
      ret err_kind(.Io, "write_string failed", false);
    }
    ret .Ok(true);
  }

  // Appends `data` to a file, returning true on success.
  pub append_string(str path, str data) flag {
    FILE* h = fopen(path, "ab");
    if h == nil {
      ret false;
    }
    defer fclose(h);
    let n = len(data);
    let wrote = fwrite(data, 1, n, h);
    ret wrote == n;
  }

  // Appends `data` to a file, with Result.
  pub try_append_string(str path, str data) Result<flag, Error> {
    let ok_append = self.append_string(path, data);
    if ok_append == false {
      ret err_kind(.Io, "append_string failed", false);
    }
    ret .Ok(true);
  }

  // Copies a file by reading it fully into memory and writing it back out.
  pub copy_file(str src, str dst) flag {
    let data = read_all(src);
    if data == nil {
      ret false;
    }
    ret write_all(dst, data);
  }

  // Copies a file by reading it fully into memory and writing it back out, with Result.
  pub try_copy_file(str src, str dst) Result<flag, Error> {
    let data = read_all(src);
    if data == nil {
      ret err_kind(.Io, "copy_file read failed", false);
    }
    if write_all(dst, data) == false {
      ret err_kind(.Io, "copy_file write failed", false);
    }
    ret .Ok(true);
  }

  // Returns the file size in bytes, or -1 on failure.
  pub size(str path) num {
    FILE* h = fopen(path, "rb");
    if h == nil {
      ret -1;
    }
    defer fclose(h);
    if fseek(h, 0, 2) != 0 {
      ret -1;
    }
    let end = ftell(h);
    if end < 0 {
      ret -1;
    }
    ret end;
  }

  // Gets the file size, with Result.
  pub try_size(str path) Result<num, Error> {
    let out = self.size(path);
    if out < 0 {
      ret err_kind(.Io, "size failed", -1);
    }
    ret .Ok(out);
  }

  // Reads all lines of a file into a Vec<str> (empty if unreadable), capping each line at max_len.
  pub read_lines(str path, num max_len) Vec<str> {
    Vec<str> out;
    out.init(8);
    FILE* h = fopen(path, "rb");
    if h == nil {
      ret out;
    }
    defer fclose(h);
    for true {
      if max_len <= 1 {
        break;
      }
      str buf = malloc(max_len);
      if buf == nil {
        break;
      }
      str res = fgets(buf, max_len, h);
      if res == nil {
        free(buf);
        break;
      }
      out.push(buf);
    }
    ret out;
  }

  // Reads all lines of a file into a Vec<str>, with Result.
  pub try_read_lines(str path, num max_len) Result<Vec<str>, Error> {
    let out = self.read_lines(path, max_len);
    if out.len == 0 {
      // Best-effort: treat empty as ok unless file can't be opened.
      if self.exists(path) == false {
        ret err_kind(.NotFound, "read_lines failed", out);
      }
    }
    ret .Ok(out);
  }

  // Returns true if `path` is an existing directory.
  pub is_dir(str path) flag {
    ret __fun_path_is_dir(path) != 0;
  }

  // Creates a single directory. The parent must already exist; this is not
  // recursive (see `walk_dir` for recursive traversal of existing
  // directories; a recursive `mkdir -p` is not provided here). Errs on
  // failure, including if the directory already exists.
  pub make_dir(str path) Result<flag, Error> {
    if __fun_make_dir(path) != 0 {
      ret err_kind(.Io, "make_dir failed", false);
    }
    ret .Ok(true);
  }

  // Lists the immediate entries of a directory (excludes `.`/`..`; includes
  // both files and subdirectories, unfiltered by name). Errs if the
  // directory can't be opened.
  pub list_dir(str path) Result<Vec<str>, Error> {
    raw* d = __fun_dir_open(path);
    if d == nil {
      Vec<str> empty;
      empty.init(0);
      ret err_kind(.Io, "list_dir: could not open directory", empty);
    }
    Vec<str> out;
    out.init(8);
    for true {
      str name = __fun_dir_read_name(d);
      if name == nil {
        break;
      }
      if equals(name, ".") || equals(name, "..") {
        continue;
      }
      out.push(_dup_cstr(name));
    }
    __fun_dir_close(d);
    ret .Ok(out);
  }

  // Recursively discovers every `.fn` file under a directory (empty if
  // `path` isn't a readable directory). Used by the build tooling to find a
  // project's source files without an explicit per-file manifest entry.
  pub walk_dir(str path) Vec<str> {
    Vec<str> out;
    out.init(16);
    _walk_dir_collect(path, &out);
    ret out;
  }
}

// Returns true if the file at `path` can be opened.
pub fun exists(str path) flag {
  let f = fs();
  ret f.exists(path);
}

// Reads an entire file into a new string, or null on failure.
pub fun read_to_string(str path) str {
  let f = fs();
  ret f.read_to_string(path);
}

// Reads up to max_len bytes into a new string, or null on failure.
pub fun read_bytes(str path, num max_len) str {
  let f = fs();
  ret f.read_bytes(path, max_len);
}

// Writes `data` to a file, returning true on success.
pub fun write_string(str path, str data) flag {
  let f = fs();
  ret f.write_string(path, data);
}

// Deletes the file at `path`, returning true on success.
pub fun remove_file(str path) flag {
  let f = fs();
  ret f.remove_file(path);
}

// Appends `data` to a file, returning true on success.
pub fun append_string(str path, str data) flag {
  let f = fs();
  ret f.append_string(path, data);
}

// Copies a file by reading it fully into memory and writing it back out.
pub fun copy_file(str src, str dst) flag {
  let f = fs();
  ret f.copy_file(src, dst);
}

// Returns the file size in bytes (or -1 on failure).
pub fun size(str path) num {
  let f = fs();
  ret f.size(path);
}

// File size with Result. `Ok(bytes)` on success, `Err` when the file can't be
// sized — clearer than checking `size(path) < 0` for the -1 sentinel.
pub fun try_size(str path) Result<num, Error> {
  let n = size(path);
  if n < 0 {
    ret err_kind(.Io, "size failed", -1);
  }
  ret .Ok(n);
}

// Reads all lines of a file into a Vec<str> (empty if unreadable), capping each line at max_len.
pub fun read_lines(str path, num max_len) Vec<str> {
  let f = fs();
  ret f.read_lines(path, max_len);
}

// Returns true if `path` is an existing directory.
pub fun is_dir(str path) flag {
  let f = fs();
  ret f.is_dir(path);
}

// Creates a single directory (parent must already exist; not recursive).
pub fun make_dir(str path) Result<flag, Error> {
  let f = fs();
  ret f.make_dir(path);
}

// Creates `path` and any missing parent directories. Succeeds when the
// directory already exists. Accepts either separator, so a path written
// for one platform still works on another.
pub fun make_dir_all(str path) Result<flag, Error> {
  if equals(path, "") {
    ret .Ok(true);
  }
  if is_dir(path) {
    ret .Ok(true);
  }

  num i = 0;
  let n = len(path);
  for i < n {
    let c = path[i];
    if (c == '/' || c == '\\') && i > 0 {
      let parent = substr(path, 0, i);
      if !is_dir(parent) && !equals(parent, "") {
        let made = make_dir(parent);
        if made.is_err() && !is_dir(parent) {
          ret made;
        }
      }
    }
    i = i + 1;
  }

  let made = make_dir(path);
  if made.is_err() && !is_dir(path) {
    ret made;
  }
  ret .Ok(true);
}

// Lists the immediate entries of a directory (excludes `.`/`..`).
pub fun list_dir(str path) Result<Vec<str>, Error> {
  let f = fs();
  ret f.list_dir(path);
}

// Recursively discovers every `.fn` file under a directory (empty if `path` isn't a readable directory).
pub fun walk_dir(str path) Vec<str> {
  let f = fs();
  ret f.walk_dir(path);
}

// Copies a file in chunks, sending cumulative copied-byte counts to the
// optional `progress_updates` channel and checking `cancel_token` between
// chunks. `chunk_size <= 0` defaults to 4096. Returns the total bytes copied
// on success, -1 on an open/read/write/flush failure or null src/dst, -2 if
// the copy buffer can't be allocated, and -3 if cancelled.
pub async fun copy_file_progress_async(
  str src,
  str dst,
  num chunk_size,
  Channel<num>* progress_updates,
  ChannelCancelToken* cancel_token
) num {
  if src == nil || dst == nil {
    ret -1;
  }

  if chunk_size <= 0 {
    chunk_size = 4096;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  let in_file = open_read(src);
  if in_file.handle == nil {
    ret -1;
  }
  defer in_file.close();

  let out_file = open_write(dst);
  if out_file.handle == nil {
    ret -1;
  }
  defer out_file.close();

  raw* buf = malloc(chunk_size);
  if buf == nil {
    ret -2;
  }
  defer free(buf);

  num total = 0;
  for true {
    if channel_cancel_token_is_cancelled(cancel_token) == true {
      ret -3;
    }

    let n = in_file.read_into(buf, chunk_size);
    if n < 0 {
      ret -1;
    }
    if n == 0 {
      break;
    }

    if out_file.write_bytes(buf, n) == false {
      ret -1;
    }
    total = total + n;

    if progress_updates != nil {
      // Progress is best-effort: a Full channel (no reader keeping up) is fine to skip;
      // only a cancellation or a real failure aborts the copy.
      fit await progress_updates.send_result_timeout_with_token_async(total, 0, cancel_token) {
        .Cancelled -> { ret -3; }
        .Closed -> { ret -1; }
        .Error(e) -> { ret -1; }
        _ -> {}
      }
    }
  }

  if out_file.flush() == false {
    ret -1;
  }
  ret total;
}

// Streams lines from a file into `out_lines` (each pushed line is
// heap-allocated; the receiver must free it), checking `cancel_token`
// between lines. Returns the number of lines sent on success, -1 on invalid
// args or a file open/read failure, and -3 if cancelled.
pub async fun read_lines_into_channel_async(
  str path,
  num max_len,
  Channel<str>* out_lines,
  ChannelCancelToken* cancel_token
) num {
  if path == nil || out_lines == nil || max_len <= 1 {
    ret -1;
  }

  if channel_cancel_token_is_cancelled(cancel_token) == true {
    ret -3;
  }

  File f = open_read(path);
  if f.handle == nil {
    ret -1;
  }
  defer f.close();

  num sent = 0;
  for true {
    if channel_cancel_token_is_cancelled(cancel_token) == true {
      ret -3;
    }

    let line = f.read_line_max(max_len);
    if line == nil {
      break;
    }

    fit await out_lines.send_result_with_token_async(line, cancel_token) {
      .Ok -> {}
      .Cancelled -> {
        free(line);
        ret -3;
      }
      .Closed -> {
        free(line);
        ret sent;
      }
      _ -> {
        free(line);
        ret -1;
      }
    }

    sent = sent + 1;
  }

  ret sent;
}

// A scratch directory under fun-out for one test, created empty.
fun _scratch(str name) str {
  str dir = format("fun-out/fs_test_{str}", name);
  make_dir_all(dir);
  ret dir;
}

test "write, read, append, size and copy round-trip a file" {
  str dir = _scratch("basic");
  str path = format("{str}/a.txt", dir);
  assert write_string(path, "hello\nworld\n") && exists(path), "expected the file to be written and to exist";
  str back = read_to_string(path);
  assert equals(back, "hello\nworld\n"), "expected the text back";
  free(back);
  assert append_string(path, "more\n"), "expected the append to succeed";
  assert size(path) == 17 && try_size(path).unwrap() == 17, "expected the size to include the appended text";
  str head = read_bytes(path, 5);
  assert equals(head, "hello"), "expected the first five bytes";
  free(head);
  str copy = format("{str}/b.txt", dir);
  assert copy_file(path, copy), "expected the copy to succeed";
  str copied = read_to_string(copy);
  assert equals(copied, "hello\nworld\nmore\n"), "expected the copy to match";
  free(copied);
  assert remove_file(path) && remove_file(copy), "expected both files removed";
  assert !exists(path) && !remove_file(path), "expected a removed file to be gone, and removing it again to say so";
}

test "the fs value has the same operations as the free functions" {
  str dir = _scratch("methods");
  Fs files = fs();
  str path = format("{str}/m.txt", dir);
  assert files.write_string(path, "abc") && files.exists(path), "expected write and exists";
  assert files.try_write_string(path, "abcdef").is_ok(), "expected the try_ write";
  assert files.try_append_string(path, "!").is_ok() && files.append_string(path, "?"), "expected both appends";
  str all = files.read_to_string(path);
  assert equals(all, "abcdef!?"), "expected the accumulated text";
  free(all);
  assert files.try_read_to_string(path).is_ok() &&
    files.try_read_bytes(path, 3).is_ok(), "expected the try_ reads";
  assert files.size(path) == 8 && files.try_size(path).unwrap() == 8, "expected the size";
  str dst = format("{str}/m2.txt", dir);
  assert files.try_copy_file(path, dst).is_ok() && files.copy_file(path, dst), "expected both copies";
  assert files.remove_file(dst) && files.remove_file(path), "expected the removals";
}

test "missing files and bad arguments report failure" {
  str nowhere = "fun-out/fs_no_such_dir/file.txt";
  assert !exists(nowhere) && read_to_string(nowhere) == nil && read_bytes(nowhere, 4) == nil, "expected nothing to read";
  assert read_bytes("fun-out", 0) == nil, "expected a zero-length byte read to give nil";
  assert size(nowhere) == -1 && try_size(nowhere).is_err(), "expected no size";
  assert !write_string(nowhere, "x") && !append_string(nowhere, "x"), "expected writes into a missing directory to fail";
  assert !copy_file(nowhere, "fun-out/fs_never.txt"), "expected copying a missing file to fail";
  Fs files = fs();
  assert files.try_read_to_string(nowhere).is_err() &&
    files.try_read_bytes(nowhere, 4).is_err(), "expected the try_ reads to fail";
  assert files.try_write_string(nowhere, "x").is_err() &&
    files.try_append_string(nowhere, "x").is_err(), "expected the try_ writes to fail";
  assert files.try_copy_file(nowhere, "fun-out/fs_never.txt").is_err(), "expected the try_ copy to fail on the read";
  str dir = _scratch("copyfail");
  str src = format("{str}/s.txt", dir);
  write_string(src, "x");
  assert files.try_copy_file(src, nowhere).is_err(), "expected the try_ copy to fail on the write";
  remove_file(src);
}

test "lines are read whole, with a limit on their length" {
  str dir = _scratch("lines");
  str path = format("{str}/l.txt", dir);
  write_string(path, "one\ntwo\nthree\n");
  Vec<str> lines = read_lines(path, 64);
  assert lines.len == 3 && equals(lines.get(0), "one\n") &&
    equals(lines.get(2), "three\n"), "expected three lines";
  lines.free();
  Vec<str> none = read_lines(path, 1);
  assert none.len == 0, "expected a limit of one to read nothing";
  none.free();
  Fs files = fs();
  assert files.try_read_lines(path, 64).is_ok(), "expected the try_ read of an existing file";
  write_string(path, "");
  assert files.try_read_lines(path, 64).is_ok(), "expected an empty existing file to be fine";
  assert files.try_read_lines("fun-out/fs_no_such_file.txt", 64).is_err(), "expected a missing file to be reported";
  Vec<str> absent = read_lines("fun-out/fs_no_such_file.txt", 64);
  assert absent.len == 0, "expected a missing file to have no lines";
  absent.free();
  remove_file(path);
}

// Removes the entries `_tree_cleanup` knows the directory test creates, deepest
// first, so it can run again from nothing.
fun _tree_cleanup(str root) {
  remove(format("{str}/a/b/c/three.txt", root));
  remove(format("{str}/a/b/two.fn", root));
  remove(format("{str}/a/one.fn", root));
  remove(format("{str}/a/b/c", root));
  remove(format("{str}/a/b", root));
  remove(format("{str}/a", root));
  remove(format("{str}/d", root));
}

test "directories can be made, listed and walked" {
  str root = "fun-out/fs_test_tree";
  _tree_cleanup(root);
  _scratch("tree");
  assert is_dir(root) && !is_dir("fun-out/fs_test_missing_dir"), "expected the scratch directory to exist";
  assert make_dir_all(format("{str}/a/b/c", root)).is_ok(), "expected nested directories to be made";
  assert make_dir_all(format("{str}/a/b/c", root)).is_ok(), "expected making an existing directory to be fine";
  assert make_dir_all("").is_ok(), "expected the empty path to be fine";
  assert make_dir(format("{str}/d", root)).is_ok() &&
    make_dir(format("{str}/d", root)).is_err(), "expected a second make_dir of the same name to fail";
  write_string(format("{str}/a/one.fn", root), "x");
  write_string(format("{str}/a/b/two.fn", root), "x");
  write_string(format("{str}/a/b/c/three.txt", root), "x");
  Vec<str> listed = list_dir(format("{str}/a", root)).unwrap();
  assert listed.len == 2 && listed.contains("b") && listed.contains("one.fn"), "expected the entries of a directory, not . or ..";
  listed.free();
  assert list_dir("fun-out/fs_no_such_dir").is_err(), "expected listing a missing directory to fail";
  Vec<str> walked = walk_dir(root);
  assert walked.len == 2, "expected only the .fn files, found recursively";
  walked.sort();
  assert ends_with(walked.get(0), "a/b/two.fn") && ends_with(walked.get(1), "a/one.fn"), "expected the two source files";
  walked.free();
  Vec<str> nothing = walk_dir("fun-out/fs_no_such_dir");
  assert nothing.len == 0, "expected walking a missing directory to find nothing";
  nothing.free();
  assert make_dir_all(format("{str}/a/one.fn/x", root)).is_err(), "expected a path through a file to fail";
  _tree_cleanup(root);
}
