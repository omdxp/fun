// File system helpers built on std.io.
// 
// Usage:
// ```
// Fs f = fs();
// if f.exists("file.txt") { ... }
// ```

imp std.io;
imp std.c.io;
imp std.c.mem;
imp std.c.def;
imp std.vec;
imp std.result;
imp std.error;

// File system helper container.
pub compound Fs {
}

// Create an Fs helper instance.
// 
// Returns:
// - Fs helper
pub fun fs() Fs {
  Fs f;
  ret f;
}

fun _fs_err(str message, str context) Error {
  Error e = error_new_simple(.Io, message);
  if context != NULL {
    e.with_context(context);
  }
  ret e;
}

impl Fs {
  // Check whether a file exists.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - true if the file can be opened
  pub exists(str path) bin {
    FILE* f = fopen(path, "rb");
    if f == NULL {
      ret false;
    }
    fclose(f);
    ret true;
  }

  // Read an entire file into a string.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - file contents or null
  pub read_to_string(str path) str {
    ret read_all(path);
  }

  // Read an entire file into a string with Result.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - Result<str> with contents or error
  pub try_read_to_string(str path) Result<str> {
    Result<str> r;
    str out = read_all(path);
    if out == NULL {
      r.set_err(1, "read_to_string failed", "");
      ret r;
    }
    r.set_ok(out);
    ret r;
  }

  // Read up to max_len bytes into a string.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum bytes to read
  // 
  // Returns:
  // - bytes string or null
  pub read_bytes(str path, num max_len) str {
    if max_len <= 0 {
      ret NULL;
    }
    FILE* h = fopen(path, "rb");
    if h == NULL {
      ret NULL;
    }
    defer fclose(h);
    str buf = malloc(max_len + 1);
    if buf == NULL {
      ret NULL;
    }
    num read = fread(buf, 1, max_len, h);
    buf[read] = '\0';
    ret buf;
  }

  // Read up to max_len bytes into a string with Result.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum bytes to read
  // 
  // Returns:
  // - Result<str> with bytes or error
  pub try_read_bytes(str path, num max_len) Result<str> {
    Result<str> r;
    str out = self.read_bytes(path, max_len);
    if out == NULL {
      r.set_err(1, "read_bytes failed", "");
      ret r;
    }
    r.set_ok(out);
    ret r;
  }

  // Write a string to a file.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - true on success
  pub write_string(str path, str data) bin {
    ret write_all(path, data);
  }

  // Write a string to a file with Result.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - Result<bin> with success flag or error
  pub try_write_string(str path, str data) Result<bin> {
    Result<bin> r;
    bin ok_write = write_all(path, data);
    if ok_write == false {
      r.set_err(1, "write_string failed", false);
      ret r;
    }
    r.set_ok(true);
    ret r;
  }

  // Append a string to a file.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - true on success
  pub append_string(str path, str data) bin {
    FILE* h = fopen(path, "ab");
    if h == NULL {
      ret false;
    }
    defer fclose(h);
    num n = len(data);
    num wrote = fwrite(data, 1, n, h);
    ret wrote == n;
  }

  // Append a string to a file with Result.
  // 
  // Params:
  // - path: file path
  // - data: contents
  // 
  // Returns:
  // - Result<bin> with success flag or error
  pub try_append_string(str path, str data) Result<bin> {
    Result<bin> r;
    bin ok_append = self.append_string(path, data);
    if ok_append == false {
      r.set_err(1, "append_string failed", false);
      ret r;
    }
    r.set_ok(true);
    ret r;
  }

  // Copy a file by reading into memory and writing out.
  // 
  // Params:
  // - src: source path
  // - dst: destination path
  // 
  // Returns:
  // - true on success
  pub copy_file(str src, str dst) bin {
    str data = read_all(src);
    if data == NULL {
      ret false;
    }
    ret write_all(dst, data);
  }

  // Copy a file by reading into memory and writing out with Result.
  // 
  // Params:
  // - src: source path
  // - dst: destination path
  // 
  // Returns:
  // - Result<bin> with success flag or error
  pub try_copy_file(str src, str dst) Result<bin> {
    Result<bin> r;
    str data = read_all(src);
    if data == NULL {
      r.set_err(1, "copy_file read failed", false);
      ret r;
    }
    if write_all(dst, data) == false {
      r.set_err(1, "copy_file write failed", false);
      ret r;
    }
    r.set_ok(true);
    ret r;
  }

  // Get file size (bytes), or -1.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - size in bytes or -1
  pub size(str path) num {
    FILE* h = fopen(path, "rb");
    if h == NULL {
      ret -1;
    }
    defer fclose(h);
    if fseek(h, 0, 2) != 0 {
      ret -1;
    }
    num end = ftell(h);
    if end < 0 {
      ret -1;
    }
    ret end;
  }

  // Get file size with Result.
  // 
  // Params:
  // - path: file path
  // 
  // Returns:
  // - Result<num> with size or error
  pub try_size(str path) Result<num> {
    Result<num> r;
    num out = self.size(path);
    if out < 0 {
      r.set_err(1, "size failed", -1);
      ret r;
    }
    r.set_ok(out);
    ret r;
  }

  // Read all lines into a Vec<str>.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum line length
  // 
  // Returns:
  // - Vec<str> of lines (may be empty)
  pub read_lines(str path, num max_len) Vec<str> {
    Vec<str> out;
    out.init(8);
    FILE* h = fopen(path, "rb");
    if h == NULL {
      ret out;
    }
    defer fclose(h);
    for true {
      if max_len <= 1 {
        break;
      }
      str buf = malloc(max_len);
      if buf == NULL {
        break;
      }
      str res = fgets(buf, max_len, h);
      if res == NULL {
        free(buf);
        break;
      }
      out.push(buf);
    }
    ret out;
  }

  // Read all lines into a Vec<str> with Result.
  // 
  // Params:
  // - path: file path
  // - max_len: maximum line length
  // 
  // Returns:
  // - Result<Vec<str>> with lines or error
  pub try_read_lines(str path, num max_len) Result<Vec<str >> {
    Result<Vec<str >> r;
    Vec<str> out = self.read_lines(path, max_len);
    if out.len == 0 {
      // Best-effort: treat empty as ok unless file can't be opened.
      if self.exists(path) == false {
        r.set_err(1, "read_lines failed", out);
        ret r;
      }
    }
    r.set_ok(out);
    ret r;
  }
}

// Check file existence.
// 
// Params:
// - path: file path
// 
// Returns:
// - true if file can be opened
pub fun exists(str path) bin {
  Fs f = fs();
  ret f.exists(path);
}

// Read an entire file into a string.
// 
// Params:
// - path: file path
// 
// Returns:
// - file contents or null
pub fun read_to_string(str path) str {
  Fs f = fs();
  ret f.read_to_string(path);
}

// Read up to max_len bytes into a string.
// 
// Params:
// - path: file path
// - max_len: maximum bytes to read
// 
// Returns:
// - bytes string or null
pub fun read_bytes(str path, num max_len) str {
  Fs f = fs();
  ret f.read_bytes(path, max_len);
}

// Write a string to a file.
// 
// Params:
// - path: file path
// - data: contents
// 
// Returns:
// - true on success
pub fun write_string(str path, str data) bin {
  Fs f = fs();
  ret f.write_string(path, data);
}

// Append a string to a file.
// 
// Params:
// - path: file path
// - data: contents
// 
// Returns:
// - true on success
pub fun append_string(str path, str data) bin {
  Fs f = fs();
  ret f.append_string(path, data);
}

// Copy a file by reading into memory and writing out.
// 
// Params:
// - src: source path
// - dst: destination path
// 
// Returns:
// - true on success
pub fun copy_file(str src, str dst) bin {
  Fs f = fs();
  ret f.copy_file(src, dst);
}

// Get file size in bytes (or -1 on failure).
// 
// Params:
// - path: file path
// 
// Returns:
// - size in bytes
pub fun size(str path) num {
  Fs f = fs();
  ret f.size(path);
}

// Read all lines into a Vec<str>.
// 
// Params:
// - path: file path
// - max_len: maximum line length
// 
// Returns:
// - Vec<str> of lines (may be empty)
pub fun read_lines(str path, num max_len) Vec<str> {
  Fs f = fs();
  ret f.read_lines(path, max_len);
}
