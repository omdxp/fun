// Base64, the standard alphabet with `=` padding: bytes written as text,
// and text read back as bytes.

use std.vec;
use std.result;
use std.error;
use std.string;

const str ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

// The 6-bit value of base64 character `c`, or -1 when it isn't one.
fun _value_of(chr c) num {
  if c >= 'A' && c <= 'Z' {
    ret (c - 'A') as num;
  }
  if c >= 'a' && c <= 'z' {
    ret (c - 'a') as num + 26;
  }
  if c >= '0' && c <= '9' {
    ret (c - '0') as num + 52;
  }
  if c == '+' {
    ret 62;
  }
  if c == '/' {
    ret 63;
  }
  ret -1;
}

// The `len` bytes at `data` as base64 text.
pub fun encode(u8* data, num len) str {
  StringBuilder b = string_builder_init((len + 2) / 3 * 4 + 1);
  num i = 0;
  for i < len {
    num n = (data[i] as num) << 16;
    num left = len - i;
    if left > 1 {
      n = n | ((data[i + 1] as num) << 8);
    }
    if left > 2 {
      n = n | (data[i + 2] as num);
    }
    b.append_char(ALPHABET[(n >> 18) & 63]);
    b.append_char(ALPHABET[(n >> 12) & 63]);
    if left > 1 {
      b.append_char(ALPHABET[(n >> 6) & 63]);
    } else {
      b.append_char('=');
    }
    if left > 2 {
      b.append_char(ALPHABET[n & 63]);
    } else {
      b.append_char('=');
    }
    i += 3;
  }
  ret b.build();
}

// The bytes base64 text `text` stands for. Whitespace between characters
// is skipped; anything else outside the alphabet, or padding before the
// end, is an error.
pub fun decode(str text) Result<Vec<u8>, Error> {
  Vec<u8> out;
  out.init(len(text) / 4 * 3 + 3);
  num acc = 0;
  num bits = 0;
  num padding = 0;
  num i = 0;
  num n = len(text);
  for i < n {
    chr c = text[i];
    i += 1;
    if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
      continue;
    }
    if c == '=' {
      padding += 1;
      continue;
    }
    num v = _value_of(c);
    if v < 0 || padding > 0 {
      out.free();
      ret err_kind(.Parse, "not base64", out);
    }
    acc = ((acc << 6) | v) & 0xFFFFFF;
    bits += 6;
    if bits >= 8 {
      bits -= 8;
      out.push(((acc >> bits) & 255) as u8);
    }
  }
  if padding > 2 {
    out.free();
    ret err_kind(.Parse, "too much base64 padding", out);
  }
  ret .Ok(out);
}

test "encoding pads to whole groups of four" {
  str a = encode("f" as u8*, 1);
  str b = encode("fo" as u8*, 2);
  str c = encode("foo" as u8*, 3);
  str d = encode("foobar" as u8*, 6);
  assert equals(a, "Zg=="), "expected one byte padded twice";
  assert equals(b, "Zm8="), "expected two bytes padded once";
  assert equals(c, "Zm9v"), "expected three bytes unpadded";
  assert equals(d, "Zm9vYmFy"), "expected two whole groups";
  free(a);
  free(b);
  free(c);
  free(d);
}

test "decoding gives every byte back, zeros included" {
  u8[256] all;
  num i = 0;
  for i < 256 {
    all[i] = i as u8;
    i += 1;
  }
  str text = encode(&all[0], 256);
  defer free(text);
  let back = decode(text);
  assert back.is_ok(), "expected the text to decode";
  Vec<u8> bytes = back.unwrap();
  defer bytes.free();
  assert bytes.len() == 256, "expected all 256 bytes";
  i = 0;
  flag same = true;
  for i < 256 {
    if bytes.get(i) != all[i] {
      same = false;
    }
    i += 1;
  }
  assert same, "expected the same bytes back";
}

test "decoding skips whitespace and rejects what isn't base64" {
  let spaced = decode("Zm9v\nYmFy");
  assert spaced.is_ok() && spaced.unwrap().len() == 6, "expected whitespace skipped";
  assert decode("Zm9v!").is_err(), "expected a character outside the alphabet rejected";
  assert decode("Zg==Zg").is_err(), "expected data after padding rejected";
}
