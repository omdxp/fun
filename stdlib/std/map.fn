// Generic map with typed keys and values.

use std.c.mem;
use std.c.string;
use std.string;
use std.vec;
use std.quirks;
use std.option;

// Generic open-addressing hash map.
pub compound Map<K, V> {
  // Key storage array.
  K* key_slots;
  // Value storage array.
  V* value_slots;
  // Occupied-slot flags.
  flag* used;
  // Tombstone flags for deleted slots.
  flag* tomb;
  // Number of live entries.
  num len;
  // Allocated slot capacity.
  num cap;
  // Cursor for `impl Map<K, V> as Iterator<(K, V)>`'s own `next()`. A
  // `for` loop always drives iteration through a fresh copy of the value
  // it started from (never the caller's own variable), so this cursor
  // never observably leaks across two independent loops over "the same"
  // Map, or a loop nested inside another over the same Map.
  // Compiler-internal, not meant to be read or written directly.
  num __iter_pos;
}

impl Map<K, V> as Sized {
  // Returns the number of live entries.
  pub len() num {
    ret self.len;
  }

  // Returns true when the map holds no entries.
  pub is_empty() flag {
    ret self.len == 0;
  }

  // Returns the allocated slot capacity.
  pub capacity() num {
    ret self.cap;
  }
}

impl Map<K, V> {
  // Initializes the map with at least `cap` slots, rounded up to a minimum of 8.
  pub init(num cap = 8) {
    self.key_slots = nil;
    self.value_slots = nil;
    self.used = nil;
    self.tomb = nil;
    self.len = 0;
    self.cap = 0;
    self.__iter_pos = 0;

    if cap < 8 {
      cap = 8;
    }
    self.alloc(cap);
  }

  // Ensures capacity is at least `min_cap` slots, rounded up to a minimum of 8.
  pub reserve(num min_cap) {
    if min_cap < 8 {
      min_cap = 8;
    }
    if self.cap == 0 {
      self.alloc(min_cap);
      ret;
    }
    if min_cap > self.cap {
      self.rehash(min_cap);
    }
  }

  alloc(num cap) {
    self.key_slots = malloc(cap * sizeof(K));
    self.value_slots = malloc(cap * sizeof(V));
    self.used = malloc(cap * sizeof(flag));
    self.tomb = malloc(cap * sizeof(flag));

    if self.key_slots == nil {
      ret;
    }
    if self.value_slots == nil {
      ret;
    }
    if self.used == nil {
      ret;
    }
    if self.tomb == nil {
      ret;
    }

    memset(self.key_slots, 0, cap * sizeof(K));
    memset(self.value_slots, 0, cap * sizeof(V));
    memset(self.used, 0, cap * sizeof(flag));
    memset(self.tomb, 0, cap * sizeof(flag));
    self.cap = cap;
  }

  hash_key(K key) num {
    // Type-aware key hash: string keys hash by contents, value-typed keys by
    // their raw bytes. Monomorphization lowers __fun_key_hash per key type.
    ret __fun_key_hash(key);
  }

  keys_equal(K a, K b) flag {
    // String keys compare by value (strcmp); value-typed keys by raw bytes.
    ret __fun_key_eq(a, b);
  }

  find_live_index(K key) num {
    if self.cap == 0 {
      ret -1;
    }

    let idx = self.hash_key(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      if self.used[idx] == false {
        ret -1;
      }
      if self.tomb[idx] == false && self.keys_equal(self.key_slots[idx], key) != false {
        ret idx;
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret -1;
  }

  find_insert_index() num {
    if self.cap == 0 {
      ret -1;
    }

    num first_tomb = -1;
    num i = 0;
    for i < self.cap {
      if self.used[i] == false && first_tomb != -1 {
        ret first_tomb;
      }
      if self.used[i] == false {
        ret i;
      }
      if self.tomb[i] != false && first_tomb == -1 {
        first_tomb = i;
      }
      i = i + 1;
    }

    ret first_tomb;
  }

  find_insert_index_for(K key) num {
    if self.cap == 0 {
      ret -1;
    }

    let idx = self.hash_key(key) % self.cap;
    num steps = 0;
    num first_tomb = -1;

    for steps < self.cap {
      if self.used[idx] == false && first_tomb != -1 {
        ret first_tomb;
      }
      if self.used[idx] == false {
        ret idx;
      }

      if self.tomb[idx] != false && first_tomb == -1 {
        first_tomb = idx;
      }

      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }

    ret first_tomb;
  }

  // Returns a zero-initialized V.
  zero_value() V {
    V out;
    memset(&out, 0, sizeof(V));
    ret out;
  }

  // Reads the value at a live slot index.
  load_value_idx(num idx) V {
    ret self.value_slots[idx];
  }

  // Writes the value at a slot index.
  store_value_idx(num idx, V value) {
    self.value_slots[idx] = value;
  }

  rehash(num new_cap) {
    K* old_keys = self.key_slots;
    V* old_values = self.value_slots;
    flag* old_used = self.used;
    flag* old_tomb = self.tomb;
    let old_cap = self.cap;

    self.key_slots = nil;
    self.value_slots = nil;
    self.used = nil;
    self.tomb = nil;
    self.cap = 0;
    self.len = 0;

    self.alloc(new_cap);

    if old_keys == nil {
      ret;
    }

    num i = 0;
    for i < old_cap {
      if old_used[i] != false && old_tomb[i] == false {
        let idx = self.find_insert_index_for(old_keys[i]);
        if idx != -1 {
          self.key_slots[idx] = old_keys[i];
          self.value_slots[idx] = old_values[i];
          self.used[idx] = true;
          self.tomb[idx] = false;
          self.len = self.len + 1;
        }
      }
      i = i + 1;
    }

    free(old_keys);
    free(old_values);
    free(old_used);
    free(old_tomb);
  }

  // Frees internal storage and resets the map to an empty state.
  pub free() {
    self.clear();
    if self.key_slots != nil {
      free(self.key_slots);
    }
    if self.value_slots != nil {
      free(self.value_slots);
    }
    if self.used != nil {
      free(self.used);
    }
    if self.tomb != nil {
      free(self.tomb);
    }

    self.key_slots = nil;
    self.value_slots = nil;
    self.used = nil;
    self.tomb = nil;
    self.len = 0;
    self.cap = 0;
  }

  // Returns true when the key exists in the map.
  pub has(K key) flag {
    ret self.find_live_index(key) != -1;
  }

  // Returns the value for a key, or the zero value of `V` when it is missing.
  pub get(K key) V {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret self.zero_value();
    }
    ret self.load_value_idx(idx);
  }

  // Returns the value for a key, or `fallback` when it is missing.
  pub get_or(K key, V fallback) V {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret fallback;
    }
    ret self.load_value_idx(idx);
  }

  // Writes the value for a key into `out` and returns true, or returns false
  // and leaves `out` untouched when the key is missing.
  pub try_get(K key, V* out) flag {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret false;
    }
    *out = self.value_slots[idx];
    ret true;
  }

  // Returns the value for a key, or `None` when it is absent.
  pub at(K key) Option<V> {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret .None;
    }
    ret .Some(self.load_value_idx(idx));
  }

  // Inserts a value, replacing any existing value for the key.
  pub put(K key, V value) {
    if self.cap == 0 {
      self.alloc(8);
    }

    if self.len * 10 + 10 >= self.cap * 7 {
      self.rehash(self.cap * 2);
    }

    let existing = self.find_live_index(key);
    if existing != -1 {
      self.store_value_idx(existing, value);
      ret;
    }

    let idx = self.find_insert_index_for(key);
    if idx == -1 {
      self.rehash(self.cap * 2);
      idx = self.find_insert_index_for(key);
      if idx == -1 {
        ret;
      }
    }

    self.key_slots[idx] = key;
    self.store_value_idx(idx, value);
    self.used[idx] = true;
    self.tomb[idx] = false;
    self.len = self.len + 1;
  }

  // Inserts a value only when the key is absent, returning true when it did.
  // An existing value is left untouched.
  pub put_if_absent(K key, V value) flag {
    if self.find_live_index(key) != -1 {
      ret false;
    }
    self.put(key, value);
    ret true;
  }

  // Removes a key, returning true when an entry was removed.
  pub remove(K key) flag {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret false;
    }

    self.value_slots[idx] = self.zero_value();
    self.tomb[idx] = true;
    self.len = self.len - 1;
    ret true;
  }

  // Removes all entries while keeping the current capacity.
  pub clear() {
    if self.value_slots != nil {
      memset(self.key_slots, 0, self.cap * sizeof(K));
      memset(self.value_slots, 0, self.cap * sizeof(V));
      memset(self.used, 0, self.cap * sizeof(flag));
      memset(self.tomb, 0, self.cap * sizeof(flag));
    }
    self.len = 0;
  }

  // Returns every live key as a vector, in iteration order.
  pub keys() Vec<K> {
    Vec<K> out;
    out.init(self.len);
    if self.key_slots == nil {
      ret out;
    }

    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        out.push(self.key_slots[i]);
      }
      i = i + 1;
    }
    ret out;
  }

  // Returns every live value as a vector, in iteration order.
  pub values() Vec<V> {
    Vec<V> out;
    out.init(self.len);
    if self.value_slots == nil {
      ret out;
    }

    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        out.push(self.load_value_idx(i));
      }
      i = i + 1;
    }
    ret out;
  }

}

impl Map<K, V> as Iterator<(K, V)> {
  // Returns the next live (key, value) pair, or `None` once every slot
  // has been examined (and resets the cursor, so a value manually driven
  // to exhaustion reads as fresh again - not load-bearing for a `for`
  // loop, which always starts from its own copy regardless; see
  // `Vec<T>`'s own `next()` for the same reasoning).
  pub next() Option<(K, V)> {
    for self.__iter_pos < self.cap {
      let at = self.__iter_pos;
      self.__iter_pos = self.__iter_pos + 1;
      if self.used[at] != false && self.tomb[at] == false {
        ret .Some((self.key_slots[at], self.value_slots[at]));
      }
    }
    self.__iter_pos = 0;
    ret .None;
  }
}

impl Map<K, V> as Clearable {
  // Removes all entries while keeping the current capacity.
  pub clear() {
    if self.value_slots != nil {
      memset(self.key_slots, 0, self.cap * sizeof(K));
      memset(self.value_slots, 0, self.cap * sizeof(V));
      memset(self.used, 0, self.cap * sizeof(flag));
      memset(self.tomb, 0, self.cap * sizeof(flag));
    }
    self.len = 0;
  }
}

impl Map<K, V> as Clonable<Map<K, V>> {
  // Returns a shallow copy with independent backing storage.
  pub clone() Map<K, V> {
    Map<K, V> out;
    out.init(self.cap);
    Vec<K> ks = self.keys();
    defer ks.free();
    num i = 0;
    for i < ks.len {
      K k = ks.get(i);
      out.put(k, self.at(k).unwrap());
      i = i + 1;
    }
    ret out;
  }
}

fun _map_str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

fun _map_append(str dst, num pos, str part) num {
  let n = _map_str_len(part);
  num j = 0;
  for j < n {
    dst[pos + j] = part[j];
    j = j + 1;
  }
  ret pos + n;
}

impl Map<str, num> as Display {
  // Renders as `{"k": v, ...}` (entries are unordered).
  pub to_string() str {
    // Generously size: per entry "\"\": " + key + 20-digit value + ", ".
    num budget = 2;
    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        budget = budget + _map_str_len(self.key_slots[i]) + 30;
      }
      i = i + 1;
    }
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        if written > 0 {
          pos = _map_append(out, pos, ", ");
        }
        pos = _map_append(out, pos, "\"");
        pos = _map_append(out, pos, self.key_slots[i]);
        pos = _map_append(out, pos, "\": ");
        str cell = format_num(self.value_slots[i]);
        num c = len(cell);
        num k = 0;
        for k < c {
          out[pos + k] = cell[k];
          k = k + 1;
        }
        free(cell);
        pos = pos + c;
        written = written + 1;
      }
      i = i + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}

impl Map<str, str> as Display {
  // Renders as `{"k": "v", ...}` (entries are unordered).
  pub to_string() str {
    num budget = 2;
    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        budget = budget + _map_str_len(self.key_slots[i]) + _map_str_len(self.value_slots[i]) + 10;
      }
      i = i + 1;
    }
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        if written > 0 {
          pos = _map_append(out, pos, ", ");
        }
        pos = _map_append(out, pos, "\"");
        pos = _map_append(out, pos, self.key_slots[i]);
        pos = _map_append(out, pos, "\": \"");
        pos = _map_append(out, pos, self.value_slots[i]);
        pos = _map_append(out, pos, "\"");
        written = written + 1;
      }
      i = i + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}

fun _sample_map() Map<str, num> {
  Map<str, num> m;
  m.init(8);
  m.put("a", 1);
  m.put("b", 2);
  m.put("c", 3);
  ret m;
}

test "a map stores, replaces and looks up values" {
  Map<str, num> m = _sample_map();
  assert m.len() == 3 && !m.is_empty() && m.capacity() >= 8, "expected three entries";
  assert m.has("a") && !m.has("z"), "expected membership";
  assert m.get("b") == 2 && m.get("z") == 0, "expected a value, and the zero value for a missing key";
  assert m.get_or("c", 9) == 3 && m.get_or("z", 9) == 9, "expected the fallback only for a missing key";
  m.put("a", 10);
  assert m.get("a") == 10 && m.len() == 3, "expected a repeated key to replace, not add";
  assert m.at("b").unwrap() == 2 && m.at("z").is_none(), "expected the Option form";
  num out = 0;
  assert m.try_get("c", &out) && out == 3, "expected try_get to write the value";
  assert !m.try_get("z", &out) && out == 3, "expected a miss to leave the output alone";
  m.free();
}

test "put_if_absent and remove report what they did" {
  Map<str, num> m = _sample_map();
  assert !m.put_if_absent("a", 99) && m.get("a") == 1, "expected an existing key to be kept";
  assert m.put_if_absent("d", 4) && m.get("d") == 4, "expected a new key to be added";
  assert m.remove("a") && !m.remove("a"), "expected remove to report whether it removed anything";
  assert !m.has("a") && m.len() == 3, "expected the entry gone";
  m.put("a", 7);
  assert m.get("a") == 7 && m.len() == 4, "expected a removed slot to be reusable";
  m.free();
}

test "keys, values and iteration see every live entry" {
  Map<str, num> m = _sample_map();
  m.remove("b");
  Vec<str> ks = m.keys();
  assert ks.len == 2 && ks.contains("a") && ks.contains("c") && !ks.contains("b"), "expected the live keys";
  Vec<num> vs = m.values();
  vs.sort();
  assert vs.len == 2 && vs.get(0) == 1 && vs.get(1) == 3, "expected the live values";
  num total = 0;
  num count = 0;
  for pair : m {
    total = total + pair.1;
    count = count + 1;
  }
  assert total == 4 && count == 2, "expected each live pair visited once";
  ks.free();
  vs.free();
  m.free();
}

test "a map grows past its first capacity and keeps every entry" {
  Map<num, num> m;
  m.init(8);
  num i = 0;
  for i < 200 {
    m.put(i, i * 2);
    i = i + 1;
  }
  assert m.len() == 200 && m.capacity() > 200, "expected it to have grown";
  assert m.get(0) == 0 && m.get(137) == 274 && m.get(199) == 398, "expected every entry to survive the rehashes";
  i = 0;
  for i < 200 {
    m.remove(i);
    i = i + 2;
  }
  assert m.len() == 100 && !m.has(4) && m.has(5), "expected only the even keys removed";
  m.reserve(1000);
  assert m.capacity() >= 1000 && m.len() == 100 && m.get(5) == 10, "expected reserve to rehash without losing entries";
  m.free();
}

test "clear, clone and the quirks" {
  Map<str, num> m = _sample_map();
  Map<str, num> copy = m.clone();
  copy.put("d", 4);
  assert m.len() == 3 && copy.len() == 4 && copy.get("a") == 1, "expected an independent copy with the same entries";
  Clearable c = &copy;
  c.clear();
  assert copy.is_empty() && m.len() == 3, "expected clear through the quirk to empty only the copy";
  m.clear();
  assert m.is_empty() && !m.has("a"), "expected clear to empty the map";
  m.put("x", 1);
  assert m.get("x") == 1, "expected a cleared map to be reusable";
  m.free();
  copy.free();
}

test "reserve on a map with no storage allocates it, and a freed map can be reused" {
  Map<str, num> m;
  m.init(8);
  m.free();
  m.reserve(4);
  assert m.capacity() >= 8, "expected reserve to allocate at least the minimum";
  m.put("k", 1);
  assert m.get("k") == 1, "expected the map to work after reserve";
  m.free();
  Map<str, num> untouched;
  untouched.init(0);
  assert untouched.capacity() >= 8, "expected init to enforce the minimum capacity";
  untouched.free();
}

test "string maps render as text" {
  Map<str, num> n;
  n.init(8);
  str empty = n.to_string();
  assert _map_str_len(empty) == 2 && starts_with(empty, "{") && ends_with(empty, "}"), "expected empty braces";
  free(empty);
  n.put("a", 1);
  str one = n.to_string();
  assert equals(one, "{\"a\": 1}"), "expected one entry";
  free(one);
  n.put("b", -2);
  str two = n.to_string();
  assert contains(two, "\"a\": 1") && contains(two, "\"b\": -2") && contains(two, ", "), "expected both entries separated";
  free(two);
  Map<str, str> s;
  s.init(8);
  s.put("k", "v");
  str text = s.to_string();
  assert equals(text, "{\"k\": \"v\"}"), "expected a string value quoted";
  free(text);
  s.put("k2", "v2");
  str both = s.to_string();
  assert contains(both, "\"k2\": \"v2\"") && contains(both, ", "), "expected both string entries separated";
  free(both);
  n.free();
  s.free();
}
