// String-keyed hash map with generic values.

imp std.c.mem;
imp std.c.string;
imp std.c.def;
imp std.quirks;
imp std.string;
imp std.vec;

// Internal map entry (key/value pointer + flags).
// 
// Fields:
// - key: entry key
// - value: heap-allocated value bytes
// - used: slot has data
// - tomb: slot is a tombstone
pub compound MapEntry {
  // key: entry key
  str key;
  // value: heap-allocated value bytes
  raw* value;
  // used: slot has data
  bin used;
  // tomb: slot is a tombstone
  bin tomb;
}

// String-keyed hash map.
// 
// Fields:
// - entries: backing storage
// - len: number of live entries
// - cap: allocated capacity
// - value_size: size of stored values
pub compound Map<T> {
  // entries: backing storage
  MapEntry* entries;
  // len: number of live entries
  num len;
  // cap: allocated capacity
  num cap;
  // value_size: size of stored values
  num value_size;
}

fun _hash_str(str s) num {
  num h = 5381;
  num i = 0;
  for s[i] != 0 {
    if h > 100000000 {
      h = h % 100000000;
    }
    h = h + s[i];
    i = i + 1;
  }
  if h < 0 {
    h = -h;
  }
  ret h;
}

// (helpers are implemented as Map<T> methods)

impl Map<T> Sized {
  // Number of stored entries.
  pub len() num {
    ret self.len;
  }

  // True when no entries are stored.
  pub is_empty() bin {
    ret self.len == 0;
  }

  // Current capacity.
  pub capacity() num {
    ret self.cap;
  }
}

impl Map<T> {
  // Initialize with an initial capacity.
  pub init(num cap) {
    self.entries = NULL;
    self.len = 0;
    self.cap = 0;
    self.value_size = sizeof(T);

    if cap < 8 {
      cap = 8;
    }
    self.alloc(cap);
  }

  // Ensure capacity is at least min_cap.
  pub reserve(num min_cap) {
    if min_cap < 8 {
      min_cap = 8;
    }
    if self.cap == 0 {
      self.alloc(min_cap);
      ret;
    }
    if min_cap > self.cap {
      self.rehash(min_cap);
    }
  }

  // Allocate backing storage.
  alloc(num cap) {
    self.entries = malloc(cap * sizeof(MapEntry));
    if self.entries != NULL {
      memset(self.entries, 0, cap * sizeof(MapEntry));
    }
    self.cap = cap;
  }

  // Rehash into a new capacity.
  rehash(num new_cap) {
    MapEntry* old_entries = self.entries;
    num old_cap = self.cap;

    self.alloc(new_cap);
    self.len = 0;

    if old_entries == NULL {
      ret;
    }

    num i = 0;
    for i < old_cap {
      MapEntry entry = old_entries[i];
      if entry.used != false {
        if entry.tomb == false {
          str key = entry.key;
          raw* value_ptr = entry.value;
          // reinsert
          num idx = _hash_str(key) % self.cap;
          num steps = 0;
          for steps < self.cap {
            MapEntry dst = self.entries[idx];
            if dst.used == false {
              dst.key = key;
              dst.value = value_ptr;
              dst.used = true;
              dst.tomb = false;
              self.entries[idx] = dst;
              self.len = self.len + 1;
              break;
            }
            idx = (idx + 1) % self.cap;
            steps = steps + 1;
          }
        }
      }
      i = i + 1;
    }

    free(old_entries);
  }

  pub zero_value() T {
    T out;
    memset( &out, 0, sizeof(T));
    ret out;
  }

  pub load_value(MapEntry* entry) T {
    if entry.value == NULL {
      ret self.zero_value();
    }
    T out;
    memset( &out, 0, sizeof(T));
    memcpy( &out, entry.value, self.value_size);
    ret out;
  }

  pub store_value(MapEntry* entry, T value) {
    if entry.value == NULL {
      entry.value = malloc(self.value_size);
    }
    if entry.value != NULL {
      memcpy(entry.value, &value, self.value_size);
    }
  }

  // Free internal storage.
  pub free() {
    if self.entries != NULL {
      self.clear();
      free(self.entries);
    }
    self.entries = NULL;
    self.len = 0;
    self.cap = 0;
  }

  // Check if a key exists.
  pub has(str key) bin {
    if self.cap == 0 {
      ret false;
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        ret false;
      }
      if entry.tomb == false {
        if equals(entry.key, key) != false {
          ret true;
        }
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret false;
  }

  // Get a value by key (or zero).
  pub get(str key) T {
    if self.cap == 0 {
      ret self.zero_value();
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        ret self.zero_value();
      }
      if entry.tomb == false {
        if equals(entry.key, key) != false {
          ret self.load_value( &entry);
        }
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret self.zero_value();
  }

  // Get a value by key or a fallback value if missing.
  pub get_or(str key, T fallback) T {
    if self.has(key) != false {
      ret self.get(key);
    }
    ret fallback;
  }

  // Try to get a value by key; writes to out and returns true on success.
  pub try_get(str key, T* out) bin {
    if self.cap == 0 {
      ret false;
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        ret false;
      }
      if entry.tomb == false {
        if equals(entry.key, key) != false {
          if entry.value != NULL {
            memcpy(out, entry.value, self.value_size);
            ret true;
          }
          ret false;
        }
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret false;
  }

  // Insert or update a value by key.
  pub put(str key, T value) {
    if self.cap == 0 {
      self.alloc(8);
    }

    if self.len * 10 + 10 >= self.cap * 7 {
      self.rehash(self.cap * 2);
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    num first_tomb = -1;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        if first_tomb != -1 {
          idx = first_tomb;
          entry = self.entries[idx];
        }
        entry.key = key;
        self.store_value( &entry, value);
        entry.used = true;
        entry.tomb = false;
        self.entries[idx] = entry;
        self.len = self.len + 1;
        ret;
      }

      if entry.tomb == false {
        if equals(entry.key, key) != false {
          self.store_value( &entry, value);
          self.entries[idx] = entry;
          ret;
        }
      }

      if entry.tomb != false {
        if first_tomb == -1 {
          first_tomb = idx;
        }
      }

      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
  }

  // Insert only if missing; returns true if inserted.
  pub put_if_absent(str key, T value) bin {
    if self.has(key) != false {
      ret false;
    }
    self.put(key, value);
    ret true;
  }

  // Remove a key; returns true if removed.
  pub remove(str key) bin {
    if self.cap == 0 {
      ret false;
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        ret false;
      }
      if entry.tomb == false {
        if equals(entry.key, key) != false {
          if entry.value != NULL {
            free(entry.value);
            entry.value = NULL;
          }
          entry.tomb = true;
          self.entries[idx] = entry;
          self.len = self.len - 1;
          ret true;
        }
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret false;
  }

  // Clear all entries without freeing capacity.
  pub clear() {
    if self.entries != NULL {
      num i = 0;
      for i < self.cap {
        MapEntry entry = self.entries[i];
        if entry.used != false {
          if entry.tomb == false {
            if entry.value != NULL {
              free(entry.value);
            }
          }
        }
        i = i + 1;
      }
      memset(self.entries, 0, self.cap * sizeof(MapEntry));
    }
    self.len = 0;
  }

  // Return all keys as a Vec<str>.
  pub keys() Vec < str > {
    Vec<str> out;
    out.init(self.len);
    if self.entries == NULL {
      ret out;
    }

    num i = 0;
    for i < self.cap {
      MapEntry entry = self.entries[i];
      if entry.used != false {
        if entry.tomb == false {
          out.push(entry.key);
        }
      }
      i = i + 1;
    }
    ret out;
  }

}
