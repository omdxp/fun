// Generic map with typed keys and values.
// 
// Usage:
// ```
// Map<num, str> m;
// m.init(8);
// m.put(1, "a");
// ```

imp std.c.mem;
imp std.c.string;
imp std.c.def;
imp std.vec;
imp std.quirks;

// Generic open-addressing hash map.
pub compound Map<K, V> {
  K* key_slots;
  V* value_slots;
  bin* used;
  bin* tomb;
  num len;
  num cap;
}

impl Map<K, V> Sized {
  pub len() num {
    ret self.len;
  }

  pub is_empty() bin {
    ret self.len == 0;
  }

  pub capacity() num {
    ret self.cap;
  }
}

impl Map<K, V> {
  pub init(num cap) {
    self.key_slots = NULL;
    self.value_slots = NULL;
    self.used = NULL;
    self.tomb = NULL;
    self.len = 0;
    self.cap = 0;

    if cap < 8 {
      cap = 8;
    }
    self.alloc(cap);
  }

  pub reserve(num min_cap) {
    if min_cap < 8 {
      min_cap = 8;
    }
    if self.cap == 0 {
      self.alloc(min_cap);
      ret;
    }
    if min_cap > self.cap {
      self.rehash(min_cap);
    }
  }

  alloc(num cap) {
    self.key_slots = malloc(cap * sizeof(K));
    self.value_slots = malloc(cap * sizeof(V));
    self.used = malloc(cap * sizeof(bin));
    self.tomb = malloc(cap * sizeof(bin));

    if self.key_slots == NULL {
      ret;
    }
    if self.value_slots == NULL {
      ret;
    }
    if self.used == NULL {
      ret;
    }
    if self.tomb == NULL {
      ret;
    }

    memset(self.key_slots, 0, cap * sizeof(K));
    memset(self.value_slots, 0, cap * sizeof(V));
    memset(self.used, 0, cap * sizeof(bin));
    memset(self.tomb, 0, cap * sizeof(bin));
    self.cap = cap;
  }

  hash_key(K key) num {
    raw* key_ptr = &key;
    u8* bytes = key_ptr;
    let key_size = sizeof(K);
    num mod = 1000000007;
    num mul = 16777619;
    num h = 2166136261 % mod;
    num i = 0;
    for i < key_size {
      h = h ^ bytes[i];
      if h < 0 {
        h = -h;
      }
      h = h % mod;
      h = h * mul;
      h = h % mod;
      i = i + 1;
    }
    if h < 0 {
      h = -h;
    }
    ret h;
  }

  keys_equal(K a, K b) bin {
    ret memcmp(&a, &b, sizeof(K)) == 0;
  }

  find_live_index(K key) num {
    if self.cap == 0 {
      ret -1;
    }

    num idx = self.hash_key(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      if self.used[idx] == false {
        ret -1;
      }
      if self.tomb[idx] == false && self.keys_equal(self.key_slots[idx], key) != false {
        ret idx;
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret -1;
  }

  find_insert_index() num {
    if self.cap == 0 {
      ret -1;
    }

    num first_tomb = -1;
    num i = 0;
    for i < self.cap {
      if self.used[i] == false && first_tomb != -1 {
        ret first_tomb;
      }
      if self.used[i] == false {
        ret i;
      }
      if self.tomb[i] != false && first_tomb == -1 {
        first_tomb = i;
      }
      i = i + 1;
    }

    ret first_tomb;
  }

  find_insert_index_for(K key) num {
    if self.cap == 0 {
      ret -1;
    }

    num idx = self.hash_key(key) % self.cap;
    num steps = 0;
    num first_tomb = -1;

    for steps < self.cap {
      if self.used[idx] == false && first_tomb != -1 {
        ret first_tomb;
      }
      if self.used[idx] == false {
        ret idx;
      }

      if self.tomb[idx] != false && first_tomb == -1 {
        first_tomb = idx;
      }

      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }

    ret first_tomb;
  }

  pub zero_value() V {
    V out;
    memset(&out, 0, sizeof(V));
    ret out;
  }

  pub load_value_idx(num idx) V {
    ret self.value_slots[idx];
  }

  pub store_value_idx(num idx, V value) {
    self.value_slots[idx] = value;
  }

  rehash(num new_cap) {
    K* old_keys = self.key_slots;
    V* old_values = self.value_slots;
    bin* old_used = self.used;
    bin* old_tomb = self.tomb;
    num old_cap = self.cap;

    self.key_slots = NULL;
    self.value_slots = NULL;
    self.used = NULL;
    self.tomb = NULL;
    self.cap = 0;
    self.len = 0;

    self.alloc(new_cap);

    if old_keys == NULL {
      ret;
    }

    num i = 0;
    for i < old_cap {
      if old_used[i] != false && old_tomb[i] == false {
        let idx = self.find_insert_index_for(old_keys[i]);
        if idx != -1 {
          self.key_slots[idx] = old_keys[i];
          self.value_slots[idx] = old_values[i];
          self.used[idx] = true;
          self.tomb[idx] = false;
          self.len = self.len + 1;
        }
      }
      i = i + 1;
    }

    free(old_keys);
    free(old_values);
    free(old_used);
    free(old_tomb);
  }

  pub free() {
    self.clear();
    if self.key_slots != NULL {
      free(self.key_slots);
    }
    if self.value_slots != NULL {
      free(self.value_slots);
    }
    if self.used != NULL {
      free(self.used);
    }
    if self.tomb != NULL {
      free(self.tomb);
    }

    self.key_slots = NULL;
    self.value_slots = NULL;
    self.used = NULL;
    self.tomb = NULL;
    self.len = 0;
    self.cap = 0;
  }

  pub has(K key) bin {
    ret self.find_live_index(key) != -1;
  }

  pub get(K key) V {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret self.zero_value();
    }
    ret self.load_value_idx(idx);
  }

  pub get_or(K key, V fallback) V {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret fallback;
    }
    ret self.load_value_idx(idx);
  }

  pub try_get(K key, V* out) bin {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret false;
    }
    *out = self.value_slots[idx];
    ret true;
  }

  pub put(K key, V value) {
    if self.cap == 0 {
      self.alloc(8);
    }

    if self.len * 10 + 10 >= self.cap * 7 {
      self.rehash(self.cap * 2);
    }

    let existing = self.find_live_index(key);
    if existing != -1 {
      self.store_value_idx(existing, value);
      ret;
    }

    num idx = self.find_insert_index_for(key);
    if idx == -1 {
      self.rehash(self.cap * 2);
      idx = self.find_insert_index_for(key);
      if idx == -1 {
        ret;
      }
    }

    self.key_slots[idx] = key;
    self.store_value_idx(idx, value);
    self.used[idx] = true;
    self.tomb[idx] = false;
    self.len = self.len + 1;
  }

  pub put_if_absent(K key, V value) bin {
    let before_len = self.len;
    self.put(key, value);
    ret self.len > before_len;
  }

  pub remove(K key) bin {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret false;
    }

    self.value_slots[idx] = self.zero_value();
    self.tomb[idx] = true;
    self.len = self.len - 1;
    ret true;
  }

  pub clear() {
    if self.value_slots != NULL {
      memset(self.key_slots, 0, self.cap * sizeof(K));
      memset(self.value_slots, 0, self.cap * sizeof(V));
      memset(self.used, 0, self.cap * sizeof(bin));
      memset(self.tomb, 0, self.cap * sizeof(bin));
    }
    self.len = 0;
  }

  pub keys() Vec<K> {
    Vec<K> out;
    out.init(self.len);
    if self.key_slots == NULL {
      ret out;
    }

    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        out.push(self.key_slots[i]);
      }
      i = i + 1;
    }
    ret out;
  }

  pub values() Vec<V> {
    Vec<V> out;
    out.init(self.len);
    if self.value_slots == NULL {
      ret out;
    }

    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        out.push(self.load_value_idx(i));
      }
      i = i + 1;
    }
    ret out;
  }
}

impl Map<K, V> Clearable {
  pub clear() {
    if self.value_slots != NULL {
      memset(self.key_slots, 0, self.cap * sizeof(K));
      memset(self.value_slots, 0, self.cap * sizeof(V));
      memset(self.used, 0, self.cap * sizeof(bin));
      memset(self.tomb, 0, self.cap * sizeof(bin));
    }
    self.len = 0;
  }
}
