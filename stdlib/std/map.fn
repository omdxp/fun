// String-keyed hash map.

imp std.c.mem;
imp std.c.string;
imp std.c.def;
imp std.quirks;
imp std.string;

// Internal map entry (key/value + flags).
// 
// Fields:
// - key: entry key
// - value: entry value
// - used: slot has data
// - tomb: slot is a tombstone
pub compound MapEntry {
  // key: entry key
  str key;
  // value: entry value
  str value;
  // used: slot has data
  bin used;
  // tomb: slot is a tombstone
  bin tomb;
}

// String-keyed hash map.
// 
// Fields:
// - entries: backing storage
// - len: number of live entries
// - cap: allocated capacity
pub compound StrMap {
  // entries: backing storage
  MapEntry* entries;
  // len: number of live entries
  num len;
  // cap: allocated capacity
  num cap;
}

fun _hash_str(str s) num {
  num h = 5381;
  num i = 0;
  for s[i] != 0 {
    if h > 100000000 {
      h = h % 100000000;
    }
    h = h + s[i];
    i = i + 1;
  }
  if h < 0 {
    h = -h;
  }
  ret h;
}

fun _map_alloc(StrMap* m, num cap) {
  m.entries = malloc(cap * sizeof(MapEntry));
  if m.entries != NULL {
    memset(m.entries, 0, cap * sizeof(MapEntry));
  }
  m.cap = cap;
}

fun _map_rehash(StrMap* m, num new_cap) {
  MapEntry* old_entries = m.entries;
  num old_cap = m.cap;

  _map_alloc(m, new_cap);
  m.len = 0;

  if old_entries == NULL {
    ret;
  }

  num i = 0;
  for i < old_cap {
    MapEntry entry = old_entries[i];
    if entry.used != false {
      if entry.tomb == false {
        str key = entry.key;
        str value = entry.value;
        // reinsert
        num idx = _hash_str(key) % m.cap;
        num steps = 0;
        for steps < m.cap {
          MapEntry dst = m.entries[idx];
          if dst.used == false {
            dst.key = key;
            dst.value = value;
            dst.used = true;
            dst.tomb = false;
            m.entries[idx] = dst;
            m.len = m.len + 1;
            break;
          }
          idx = (idx + 1) % m.cap;
          steps = steps + 1;
        }
      }
    }
    i = i + 1;
  }

  free(old_entries);
}

// Create a map with an initial capacity.
// 
// Params:
// - cap: requested capacity (minimum 8)
// 
// Returns:
// - initialized StrMap
pub fun map_init(num cap) StrMap {
  StrMap m;
  m.entries = NULL;
  m.len = 0;
  m.cap = 0;

  if cap < 8 {
    cap = 8;
  }
  _map_alloc(&m, cap);
  ret m;
}

impl StrMap Sized {
  // Number of stored entries.
  pub len() num {
    ret self.len;
  }

  // True when no entries are stored.
  pub is_empty() bin {
    ret self.len == 0;
  }
}

impl StrMap {
  // Free internal storage.
  pub free() {
    if self.entries != NULL {
      free(self.entries);
    }
    self.entries = NULL;
    self.len = 0;
    self.cap = 0;
  }

  // Check if a key exists.
  pub has(str key) bin {
    if self.cap == 0 {
      ret false;
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        ret false;
      }
      if entry.tomb == false {
        if equals(entry.key, key) != false {
          ret true;
        }
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret false;
  }

  // Get a value by key (or null).
  pub get(str key) str {
    if self.cap == 0 {
      ret NULL;
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        ret NULL;
      }
      if entry.tomb == false {
        if equals(entry.key, key) != false {
          ret entry.value;
        }
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret NULL;
  }

  // Insert or update a value by key.
  pub put(str key, str value) {
    if self.cap == 0 {
      _map_alloc(self, 8);
    }

    if self.len * 10 + 10 >= self.cap * 7 {
      _map_rehash(self, self.cap * 2);
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    num first_tomb = -1;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        if first_tomb != -1 {
          idx = first_tomb;
          entry = self.entries[idx];
        }
        entry.key = key;
        entry.value = value;
        entry.used = true;
        entry.tomb = false;
        self.entries[idx] = entry;
        self.len = self.len + 1;
        ret;
      }

      if entry.tomb == false {
        if equals(entry.key, key) != false {
          entry.value = value;
          self.entries[idx] = entry;
          ret;
        }
      }

      if entry.tomb != false {
        if first_tomb == -1 {
          first_tomb = idx;
        }
      }

      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
  }

  // Remove a key; returns true if removed.
  pub remove(str key) bin {
    if self.cap == 0 {
      ret false;
    }

    num idx = _hash_str(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      MapEntry entry = self.entries[idx];
      if entry.used == false {
        ret false;
      }
      if entry.tomb == false {
        if equals(entry.key, key) != false {
          entry.tomb = true;
          self.entries[idx] = entry;
          self.len = self.len - 1;
          ret true;
        }
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret false;
  }

  // Clear all entries without freeing capacity.
  pub clear() {
    if self.entries != NULL {
      memset(self.entries, 0, self.cap * sizeof(MapEntry));
    }
    self.len = 0;
  }
}

// C-style wrapper for map free.
// 
// Params:
// - m: map instance
pub fun map_free(StrMap* m) {
  m.free();
}

// C-style wrapper for map length.
// 
// Params:
// - m: map instance
// 
// Returns:
// - number of entries
pub fun map_len(StrMap* m) num {
  ret m.len();
}

// C-style wrapper for map has.
// 
// Params:
// - m: map instance
// - key: lookup key
// 
// Returns:
// - true if present
pub fun map_has(StrMap* m, str key) bin {
  ret m.has(key);
}

// C-style wrapper for map get.
// 
// Params:
// - m: map instance
// - key: lookup key
// 
// Returns:
// - value or null
pub fun map_get(StrMap* m, str key) str {
  ret m.get(key);
}

// C-style wrapper for map put.
// 
// Params:
// - m: map instance
// - key: key
// - value: value
pub fun map_put(StrMap* m, str key, str value) {
  m.put(key, value);
}

// C-style wrapper for map remove.
// 
// Params:
// - m: map instance
// - key: key
// 
// Returns:
// - true if removed
pub fun map_remove(StrMap* m, str key) bin {
  ret m.remove(key);
}
