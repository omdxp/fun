// Generic map with typed keys and values.
// 
// Usage:
// ```
// Map<num, str> m;
// m.init(8);
// m.put(1, "a");
// ```

imp std.c.mem;
imp std.c.string;
imp std.c.io;
imp std.vec;
imp std.quirks;
imp std.option;

// Generic open-addressing hash map.
pub compound Map<K, V> {
  // Key storage array.
  K* key_slots;
  // Value storage array.
  V* value_slots;
  // Occupied-slot flags.
  bin* used;
  // Tombstone flags for deleted slots.
  bin* tomb;
  // Number of live entries.
  num len;
  // Allocated slot capacity.
  num cap;
}

impl Map<K, V> as Sized {
  // Return the number of live entries.
  // 
  // Returns:
  // - live entry count
  pub len() num {
    ret self.len;
  }

  // Return true when the map holds no entries.
  // 
  // Returns:
  // - true when the map is empty
  pub is_empty() bin {
    ret self.len == 0;
  }

  // Return the current slot capacity.
  // 
  // Returns:
  // - allocated slot count
  pub capacity() num {
    ret self.cap;
  }
}

impl Map<K, V> {
  // Initialize the map with at least the requested capacity.
  // 
  // Params:
  // - cap: requested initial slot capacity
  // 
  // Notes:
  // - Capacities smaller than 8 are rounded up to 8.
  pub init(num cap = 8) {
    self.key_slots = nil;
    self.value_slots = nil;
    self.used = nil;
    self.tomb = nil;
    self.len = 0;
    self.cap = 0;

    if cap < 8 {
      cap = 8;
    }
    self.alloc(cap);
  }

  // Ensure capacity is at least the requested size.
  // 
  // Params:
  // - min_cap: minimum desired slot capacity
  // 
  // Notes:
  // - Capacities smaller than 8 are rounded up to 8.
  pub reserve(num min_cap) {
    if min_cap < 8 {
      min_cap = 8;
    }
    if self.cap == 0 {
      self.alloc(min_cap);
      ret;
    }
    if min_cap > self.cap {
      self.rehash(min_cap);
    }
  }

  alloc(num cap) {
    self.key_slots = malloc(cap * sizeof(K));
    self.value_slots = malloc(cap * sizeof(V));
    self.used = malloc(cap * sizeof(bin));
    self.tomb = malloc(cap * sizeof(bin));

    if self.key_slots == nil {
      ret;
    }
    if self.value_slots == nil {
      ret;
    }
    if self.used == nil {
      ret;
    }
    if self.tomb == nil {
      ret;
    }

    memset(self.key_slots, 0, cap * sizeof(K));
    memset(self.value_slots, 0, cap * sizeof(V));
    memset(self.used, 0, cap * sizeof(bin));
    memset(self.tomb, 0, cap * sizeof(bin));
    self.cap = cap;
  }

  hash_key(K key) num {
    // Type-aware key hash: string keys hash by contents, value-typed keys by
    // their raw bytes. The compiler lowers __fun_key_hash per the concrete
    // key type, since this method is monomorphized.
    ret __fun_key_hash(key);
  }

  keys_equal(K a, K b) bin {
    // String keys compare by value (strcmp); value-typed keys by raw bytes.
    ret __fun_key_eq(a, b);
  }

  find_live_index(K key) num {
    if self.cap == 0 {
      ret -1;
    }

    let idx = self.hash_key(key) % self.cap;
    num steps = 0;
    for steps < self.cap {
      if self.used[idx] == false {
        ret -1;
      }
      if self.tomb[idx] == false && self.keys_equal(self.key_slots[idx], key) != false {
        ret idx;
      }
      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }
    ret -1;
  }

  find_insert_index() num {
    if self.cap == 0 {
      ret -1;
    }

    num first_tomb = -1;
    num i = 0;
    for i < self.cap {
      if self.used[i] == false && first_tomb != -1 {
        ret first_tomb;
      }
      if self.used[i] == false {
        ret i;
      }
      if self.tomb[i] != false && first_tomb == -1 {
        first_tomb = i;
      }
      i = i + 1;
    }

    ret first_tomb;
  }

  find_insert_index_for(K key) num {
    if self.cap == 0 {
      ret -1;
    }

    let idx = self.hash_key(key) % self.cap;
    num steps = 0;
    num first_tomb = -1;

    for steps < self.cap {
      if self.used[idx] == false && first_tomb != -1 {
        ret first_tomb;
      }
      if self.used[idx] == false {
        ret idx;
      }

      if self.tomb[idx] != false && first_tomb == -1 {
        first_tomb = idx;
      }

      idx = idx + 1;
      idx = idx % self.cap;
      steps = steps + 1;
    }

    ret first_tomb;
  }

  // Return a zero-initialized V.
  zero_value() V {
    V out;
    memset(&out, 0, sizeof(V));
    ret out;
  }

  // Read a value at a live slot index (internal).
  load_value_idx(num idx) V {
    ret self.value_slots[idx];
  }

  // Write a value at a slot index (internal).
  store_value_idx(num idx, V value) {
    self.value_slots[idx] = value;
  }

  rehash(num new_cap) {
    K* old_keys = self.key_slots;
    V* old_values = self.value_slots;
    bin* old_used = self.used;
    bin* old_tomb = self.tomb;
    let old_cap = self.cap;

    self.key_slots = nil;
    self.value_slots = nil;
    self.used = nil;
    self.tomb = nil;
    self.cap = 0;
    self.len = 0;

    self.alloc(new_cap);

    if old_keys == nil {
      ret;
    }

    num i = 0;
    for i < old_cap {
      if old_used[i] != false && old_tomb[i] == false {
        let idx = self.find_insert_index_for(old_keys[i]);
        if idx != -1 {
          self.key_slots[idx] = old_keys[i];
          self.value_slots[idx] = old_values[i];
          self.used[idx] = true;
          self.tomb[idx] = false;
          self.len = self.len + 1;
        }
      }
      i = i + 1;
    }

    free(old_keys);
    free(old_values);
    free(old_used);
    free(old_tomb);
  }

  // Free internal storage and reset the map to an empty state.
  pub free() {
    self.clear();
    if self.key_slots != nil {
      free(self.key_slots);
    }
    if self.value_slots != nil {
      free(self.value_slots);
    }
    if self.used != nil {
      free(self.used);
    }
    if self.tomb != nil {
      free(self.tomb);
    }

    self.key_slots = nil;
    self.value_slots = nil;
    self.used = nil;
    self.tomb = nil;
    self.len = 0;
    self.cap = 0;
  }

  // Return true when a key exists in the map.
  // 
  // Params:
  // - key: key to look up
  // 
  // Returns:
  // - true when the key is present
  pub has(K key) bin {
    ret self.find_live_index(key) != -1;
  }

  // Return the value for a key.
  // 
  // Params:
  // - key: key to look up
  // 
  // Returns:
  // - stored value when the key exists
  // - zero value of `V` when the key is missing
  pub get(K key) V {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret self.zero_value();
    }
    ret self.load_value_idx(idx);
  }

  // Return the value for a key or a fallback when it is missing.
  // 
  // Params:
  // - key: key to look up
  // - fallback: value returned when the key is absent
  // 
  // Returns:
  // - stored value when the key exists
  // - `fallback` when the key is missing
  pub get_or(K key, V fallback) V {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret fallback;
    }
    ret self.load_value_idx(idx);
  }

  // Try to read a value into an output pointer.
  // 
  // Params:
  // - key: key to look up
  // - out: destination for the value when present
  // 
  // Returns:
  // - true when the key exists and `out` is written
  // - false when the key is missing
  pub try_get(K key, V* out) bin {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret false;
    }
    *out = self.value_slots[idx];
    ret true;
  }

  // Look up a key as an Option.
  // 
  // Params:
  // - key: key to look up
  // 
  // Returns:
  // - `Some(value)` when the key exists
  // - `None` when the key is absent
  pub at(K key) Option<V> {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret .None;
    }
    ret .Some(self.load_value_idx(idx));
  }

  // Insert a value or replace the existing value for a key.
  // 
  // Params:
  // - key: key to insert or update
  // - value: value to store
  pub put(K key, V value) {
    if self.cap == 0 {
      self.alloc(8);
    }

    if self.len * 10 + 10 >= self.cap * 7 {
      self.rehash(self.cap * 2);
    }

    let existing = self.find_live_index(key);
    if existing != -1 {
      self.store_value_idx(existing, value);
      ret;
    }

    let idx = self.find_insert_index_for(key);
    if idx == -1 {
      self.rehash(self.cap * 2);
      idx = self.find_insert_index_for(key);
      if idx == -1 {
        ret;
      }
    }

    self.key_slots[idx] = key;
    self.store_value_idx(idx, value);
    self.used[idx] = true;
    self.tomb[idx] = false;
    self.len = self.len + 1;
  }

  // Insert a value only when the key is not already present.
  // 
  // Params:
  // - key: key to insert
  // - value: value to store
  // 
  // Returns:
  // - true when a new entry is inserted
  // - false when the key already exists
  pub put_if_absent(K key, V value) bin {
    // Inserts only when the key is absent; leaves an existing value untouched.
    if self.find_live_index(key) != -1 {
      ret false;
    }
    self.put(key, value);
    ret true;
  }

  // Remove a key from the map.
  // 
  // Params:
  // - key: key to remove
  // 
  // Returns:
  // - true when an entry is removed
  // - false when the key is missing
  pub remove(K key) bin {
    let idx = self.find_live_index(key);
    if idx == -1 {
      ret false;
    }

    self.value_slots[idx] = self.zero_value();
    self.tomb[idx] = true;
    self.len = self.len - 1;
    ret true;
  }

  // Remove all entries while keeping the current capacity.
  pub clear() {
    if self.value_slots != nil {
      memset(self.key_slots, 0, self.cap * sizeof(K));
      memset(self.value_slots, 0, self.cap * sizeof(V));
      memset(self.used, 0, self.cap * sizeof(bin));
      memset(self.tomb, 0, self.cap * sizeof(bin));
    }
    self.len = 0;
  }

  // Return the live keys as a vector.
  // 
  // Returns:
  // - vector containing every live key in iteration order
  pub keys() Vec<K> {
    Vec<K> out;
    out.init(self.len);
    if self.key_slots == nil {
      ret out;
    }

    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        out.push(self.key_slots[i]);
      }
      i = i + 1;
    }
    ret out;
  }

  // Return the live values as a vector.
  // 
  // Returns:
  // - vector containing every live value in iteration order
  pub values() Vec<V> {
    Vec<V> out;
    out.init(self.len);
    if self.value_slots == nil {
      ret out;
    }

    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        out.push(self.load_value_idx(i));
      }
      i = i + 1;
    }
    ret out;
  }

  // Return a forward iterator over the live keys.
  // 
  // Notes:
  // - Iteration order is unspecified.
  // - Pair the yielded keys with `get()` or `at()` to visit values.
  // 
  // Usage:
  // 
  // ```
  // let it = m.iter_keys();
  // for true {
  //   fit it.next() {
  //     Option.Some(k) -> { use(k, m.get(k)); }
  //     Option.None -> { break; }
  //   }
  // }
  // ```
  pub iter_keys() MapIter<K, V> {
    MapIter<K, V> it;
    it.src = self;
    it.idx = 0;
    ret it;
  }

  // Return the default key iterator.
  // 
  // Returns:
  // - same iterator as `iter_keys()`
  pub iter() MapIter<K, V> {
    ret self.iter_keys();
  }
}

// Forward iterator over a Map's live keys, produced by `Map.iter_keys()`.
pub compound MapIter<K, V> {
  // Map being iterated (borrowed, not owned).
  Map<K, V>* src;
  // Index of the next slot to examine.
  num idx;
}

impl MapIter<K, V> as Iterator<K> {
  // Return the next live key from the iterator.
  // 
  // Returns:
  // - `Some(key)` for the next live slot
  // - `None` after all slots have been examined
  pub next() Option<K> {
    for self.idx < self.src.cap {
      let at = self.idx;
      self.idx = self.idx + 1;
      if self.src.used[at] != false && self.src.tomb[at] == false {
        ret .Some(self.src.key_slots[at]);
      }
    }
    ret .None;
  }
}

impl Map<K, V> as Clearable {
  // Remove all entries while keeping the current capacity.
  pub clear() {
    if self.value_slots != nil {
      memset(self.key_slots, 0, self.cap * sizeof(K));
      memset(self.value_slots, 0, self.cap * sizeof(V));
      memset(self.used, 0, self.cap * sizeof(bin));
      memset(self.tomb, 0, self.cap * sizeof(bin));
    }
    self.len = 0;
  }
}

fun _map_str_len(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

fun _map_append(str dst, num pos, str part) num {
  let n = _map_str_len(part);
  num j = 0;
  for j < n {
    dst[pos + j] = part[j];
    j = j + 1;
  }
  ret pos + n;
}

impl Map<str, num> as Display {
  // Render as `{"k": v, ...}` (entries are unordered).
  pub to_string() str {
    // Generously size: per entry "\"\": " + key + 20-digit value + ", ".
    num budget = 2;
    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        budget = budget + _map_str_len(self.key_slots[i]) + 30;
      }
      i = i + 1;
    }
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        if written > 0 {
          pos = _map_append(out, pos, ", ");
        }
        pos = _map_append(out, pos, "\"");
        pos = _map_append(out, pos, self.key_slots[i]);
        pos = _map_append(out, pos, "\": ");
        chr[24] cell;
        let c = snprintf(cell, 24, "%lld", self.value_slots[i]);
        num k = 0;
        for k < c {
          out[pos + k] = cell[k];
          k = k + 1;
        }
        pos = pos + c;
        written = written + 1;
      }
      i = i + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}

impl Map<str, str> as Display {
  // Render as `{"k": "v", ...}` (entries are unordered).
  pub to_string() str {
    num budget = 2;
    num i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        budget = budget + _map_str_len(self.key_slots[i]) + _map_str_len(self.value_slots[i]) + 10;
      }
      i = i + 1;
    }
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    i = 0;
    for i < self.cap {
      if self.used[i] != false && self.tomb[i] == false {
        if written > 0 {
          pos = _map_append(out, pos, ", ");
        }
        pos = _map_append(out, pos, "\"");
        pos = _map_append(out, pos, self.key_slots[i]);
        pos = _map_append(out, pos, "\": \"");
        pos = _map_append(out, pos, self.value_slots[i]);
        pos = _map_append(out, pos, "\"");
        written = written + 1;
      }
      i = i + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}
