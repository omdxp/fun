// Generic set built on Map<T, flag>.

use std.map;
use std.vec;
use std.string;
use std.quirks;
use std.option;

// Generic set backed by Map<T, flag>.
pub compound Set<T> {
  // Backing map.
  Map<T, flag> map;
}

// Creates a set with initial capacity `cap`. `sample` is used only for type
// inference.
pub fun set_init<T>(T sample, num cap) Set<T> {
  Set<T> s;
  _ = sample;
  s.map.init(cap);
  ret s;
}

impl Set<T> as Sized {
  // Number of elements in the set.
  pub len() num {
    ret self.map.len;
  }

  // True when the set holds no elements.
  pub is_empty() flag {
    ret self.map.len == 0;
  }
}

impl Set<T> {
  // Free internal storage and reset the set.
  pub free() {
    self.map.free();
  }

  // True when `key` is present in the set.
  pub has(T key) flag {
    ret self.map.has(key);
  }

  // Adds a key to the set.
  pub add(T key) {
    self.map.put(key, true);
  }

  // Removes a key from the set. Returns true when it was present.
  pub remove(T key) flag {
    ret self.map.remove(key);
  }

  // Remove all elements from the set.
  pub clear() {
    self.map.clear();
  }

  // All members as a vector. Named `keys()` to match `Map` terminology,
  // since a set stores its members as the backing map's keys.
  pub keys() Vec<T> {
    ret self.map.keys();
  }

  // Union of this set and `other`.
  pub union(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + other.map.len + 1);
    for k : self.map.keys() {
      out.add(k);
    }
    for k : other.map.keys() {
      out.add(k);
    }
    ret out;
  }

  // Intersection of this set and `other`.
  pub intersection(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + 1);
    for k : self.map.keys() {
      if other.has(k) {
        out.add(k);
      }
    }
    ret out;
  }

  // Set difference `self - other`.
  pub difference(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + 1);
    for k : self.map.keys() {
      if other.has(k) == false {
        out.add(k);
      }
    }
    ret out;
  }

  // True when every element of this set is also in `other`.
  pub is_subset(Set<T>* other) flag {
    for k : self.map.keys() {
      if other.has(k) == false {
        ret false;
      }
    }
    ret true;
  }
}

impl Set<T> as Iterator<T> {
  // Next element, or `None` once exhausted. Delegates to the backing
  // map's own tombstone-skipping scan, discarding the value half of its
  // `(K, V)` pair.
  pub next() Option<T> {
    fit self.map.next() {
      .Some(pair) -> { ret .Some(pair.0); }
      .None -> { ret .None; }
    }
  }
}

impl Set<T> as Clearable {
  // Remove all elements while keeping capacity.
  pub clear() {
    self.map.clear();
  }
}

impl Set<T> as Clonable<Set<T>> {
  // Returns a shallow copy with independent backing storage.
  pub clone() Set<T> {
    Set<T> out;
    out.map = self.map.clone();
    ret out;
  }
}

impl Set<num> as Display {
  // Render as `{1, 2, 3}` (elements are unordered).
  pub to_string() str {
    let budget = self.map.len * 26 + 3;
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    for x : self.map.keys() {
      if written > 0 {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      str cell = format_num(x);
      num c = len(cell);
      num k = 0;
      for k < c {
        out[pos + k] = cell[k];
        k = k + 1;
      }
      free(cell);
      pos = pos + c;
      written = written + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}

impl Set<str> as Display {
  // Render as `{"a", "b"}` (elements are unordered).
  pub to_string() str {
    num budget = 3;
    for x : self.map.keys() {
      num m = 0;
      for x[m] != 0 {
        m = m + 1;
      }
      budget = budget + m + 4;
    }
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    for x : self.map.keys() {
      if written > 0 {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      out[pos] = '"';
      pos = pos + 1;
      num k = 0;
      for x[k] != 0 {
        out[pos + k] = x[k];
        k = k + 1;
      }
      pos = pos + k;
      out[pos] = '"';
      pos = pos + 1;
      written = written + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}
