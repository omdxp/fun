// Generic set built on Map<T, bin>.
// 
// Usage:
// ```
// Set<str> s = set_init("", 8);
// s.add("a");
// ```

imp std.map;
imp std.vec;
imp std.quirks;

// Generic set backed by Map<T, bin>.
pub compound Set<T> {
  // map: backing map
  Map<T, bin> map;
}

// Create a set with initial capacity.
// 
// Params:
// - cap: initial capacity
// 
// Returns:
// - initialized Set<T>
pub fun set_init<T>(T sample, num cap) Set<T> {
  Set<T> s;
  _ = sample;
  s.map.init(cap);
  ret s;
}

impl Set<T> as Sized {
  // Number of elements.
  pub len() num {
    ret self.map.len;
  }

  // True when empty.
  pub is_empty() bin {
    ret self.map.len == 0;
  }
}

impl Set<T> {
  // Free internal storage.
  pub free() {
    self.map.free();
  }

  // Check if a key exists.
  pub has(T key) bin {
    ret self.map.has(key);
  }

  // Add a key.
  pub add(T key) {
    self.map.put(key, true);
  }

  // Remove a key; returns true if removed.
  pub remove(T key) bin {
    ret self.map.remove(key);
  }

  // Clear all entries.
  pub clear() {
    self.map.clear();
  }

  // Return all values as a Vec<T>.
  pub values() Vec<T> {
    ret self.map.keys();
  }
}
