// String set built on Map<num>.
// 
// Usage:
// ```
// StrSet s = set_init(8);
// s.add("a");
// ```

imp std.map;
imp std.quirks;

// String set backed by Map<num>.
// 
// Fields:
// - map: backing map
pub compound StrSet {
  // map: backing map
  Map<num> map;
}

// Create a string set with initial capacity.
// 
// Params:
// - cap: initial capacity
// 
// Returns:
// - initialized StrSet
pub fun set_init(num cap) StrSet {
  StrSet s;
  s.map.init(cap);
  ret s;
}

impl StrSet Sized {
  // Number of elements.
  pub len() num {
    ret self.map.len();
  }

  // True when empty.
  pub is_empty() bin {
    ret self.map.len() == 0;
  }
}

impl StrSet {
  // Free internal storage.
  pub free() {
    self.map.free();
  }

  // Check if a key exists.
  pub has(str key) bin {
    ret self.map.has(key);
  }

  // Add a key.
  pub add(str key) {
    self.map.put(key, 1);
  }

  // Remove a key; returns true if removed.
  pub remove(str key) bin {
    ret self.map.remove(key);
  }

  // Clear all entries.
  pub clear() {
    self.map.clear();
  }
}

// C-style wrapper for free.
pub fun set_free(StrSet* s) {
  s.free();
}

// C-style wrapper for length.
pub fun set_len(StrSet* s) num {
  ret s.len();
}

// C-style wrapper for has.
pub fun set_has(StrSet* s, str key) bin {
  ret s.has(key);
}

// C-style wrapper for add.
pub fun set_add(StrSet* s, str key) {
  s.add(key);
}

// C-style wrapper for remove.
pub fun set_remove(StrSet* s, str key) bin {
  ret s.remove(key);
}
