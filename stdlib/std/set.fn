// Generic set built on Map<T, flag>.

use std.map;
use std.vec;
use std.string;
use std.quirks;
use std.option;

// Generic set backed by Map<T, flag>.
pub compound Set<T> {
  // Backing map.
  Map<T, flag> map;
}

// Creates a set with initial capacity `cap`. `sample` is used only for type
// inference.
pub fun set_init<T>(T sample, num cap) Set<T> {
  Set<T> s;
  _ = sample;
  s.map.init(cap);
  ret s;
}

impl Set<T> as Sized {
  // Number of elements in the set.
  pub len() num {
    ret self.map.len;
  }

  // True when the set holds no elements.
  pub is_empty() flag {
    ret self.map.len == 0;
  }
}

impl Set<T> {
  // Free internal storage and reset the set.
  pub free() {
    self.map.free();
  }

  // True when `key` is present in the set.
  pub has(T key) flag {
    ret self.map.has(key);
  }

  // Adds a key to the set.
  pub add(T key) {
    self.map.put(key, true);
  }

  // Removes a key from the set. Returns true when it was present.
  pub remove(T key) flag {
    ret self.map.remove(key);
  }

  // Remove all elements from the set.
  pub clear() {
    self.map.clear();
  }

  // All members as a vector. Named `keys()` to match `Map` terminology,
  // since a set stores its members as the backing map's keys.
  pub keys() Vec<T> {
    ret self.map.keys();
  }

  // Union of this set and `other`.
  pub union(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + other.map.len + 1);
    for k : self.map.keys() {
      out.add(k);
    }
    for k : other.map.keys() {
      out.add(k);
    }
    ret out;
  }

  // Intersection of this set and `other`.
  pub intersection(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + 1);
    for k : self.map.keys() {
      if other.has(k) {
        out.add(k);
      }
    }
    ret out;
  }

  // Set difference `self - other`.
  pub difference(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + 1);
    for k : self.map.keys() {
      if other.has(k) == false {
        out.add(k);
      }
    }
    ret out;
  }

  // True when every element of this set is also in `other`.
  pub is_subset(Set<T>* other) flag {
    for k : self.map.keys() {
      if other.has(k) == false {
        ret false;
      }
    }
    ret true;
  }
}

impl Set<T> as Iterator<T> {
  // Next element, or `None` once exhausted. Delegates to the backing
  // map's own tombstone-skipping scan, discarding the value half of its
  // `(K, V)` pair.
  pub next() Option<T> {
    fit self.map.next() {
      .Some(pair) -> { ret .Some(pair.0); }
      .None -> { ret .None; }
    }
  }
}

impl Set<T> as Clearable {
  // Remove all elements while keeping capacity.
  pub clear() {
    self.map.clear();
  }
}

impl Set<T> as Clonable<Set<T>> {
  // Returns a shallow copy with independent backing storage.
  pub clone() Set<T> {
    Set<T> out;
    out.map = self.map.clone();
    ret out;
  }
}

impl Set<num> as Display {
  // Render as `{1, 2, 3}` (elements are unordered).
  pub to_string() str {
    let budget = self.map.len * 26 + 3;
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    for x : self.map.keys() {
      if written > 0 {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      str cell = format_num(x);
      num c = len(cell);
      num k = 0;
      for k < c {
        out[pos + k] = cell[k];
        k = k + 1;
      }
      free(cell);
      pos = pos + c;
      written = written + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}

impl Set<str> as Display {
  // Render as `{"a", "b"}` (elements are unordered).
  pub to_string() str {
    num budget = 3;
    for x : self.map.keys() {
      num m = 0;
      for x[m] != 0 {
        m = m + 1;
      }
      budget = budget + m + 4;
    }
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    for x : self.map.keys() {
      if written > 0 {
        out[pos] = ',';
        out[pos + 1] = ' ';
        pos = pos + 2;
      }
      out[pos] = '"';
      pos = pos + 1;
      num k = 0;
      for x[k] != 0 {
        out[pos + k] = x[k];
        k = k + 1;
      }
      pos = pos + k;
      out[pos] = '"';
      pos = pos + 1;
      written = written + 1;
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}

fun _num_set(num a, num b, num c) Set<num> {
  Set<num> s = set_init(0, 8);
  s.add(a);
  s.add(b);
  s.add(c);
  ret s;
}

test "a set adds, removes and answers membership" {
  Set<num> s = set_init(0, 4);
  assert s.is_empty() && s.len() == 0, "expected a new set to be empty";
  s.add(3);
  s.add(3);
  s.add(7);
  assert s.len() == 2 && !s.is_empty(), "expected a repeated add to count once";
  assert s.has(3) && s.has(7) && !s.has(4), "expected membership";
  assert s.remove(3) && !s.remove(3), "expected remove to report whether it removed anything";
  assert !s.has(3) && s.len() == 1, "expected the element gone";
  s.clear();
  assert s.is_empty(), "expected clear to empty the set";
  s.free();
}

test "union, intersection, difference and subset" {
  Set<num> a = _num_set(1, 2, 3);
  Set<num> b = _num_set(3, 4, 5);
  Set<num> u = a.union(&b);
  assert u.len() == 5 && u.has(1) && u.has(5), "expected every element of both";
  Set<num> i = a.intersection(&b);
  assert i.len() == 1 && i.has(3), "expected only the shared element";
  Set<num> d = a.difference(&b);
  assert d.len() == 2 && d.has(1) && d.has(2) && !d.has(3), "expected what a has and b lacks";
  Set<num> small = _num_set(1, 2, 2);
  assert small.is_subset(&a) && !a.is_subset(&small), "expected subset to be directional";
  a.free();
  b.free();
  u.free();
  i.free();
  d.free();
  small.free();
}

test "a set lists its keys, iterates, clones and clears through its quirks" {
  Set<num> s = _num_set(4, 5, 6);
  Vec<num> keys = s.keys();
  assert keys.len == 3, "expected three keys";
  keys.sort();
  assert keys.get(0) == 4 && keys.get(2) == 6, "expected the keys";
  keys.free();
  num total = 0;
  for x : s {
    total = total + x;
  }
  assert total == 15, "expected iteration to visit every element once";
  Set<num> copy = s.clone();
  copy.add(9);
  assert s.len() == 3 && copy.len() == 4, "expected a clone to be independent";
  Clearable c = &copy;
  c.clear();
  assert copy.is_empty(), "expected clear through the quirk";
  s.free();
  copy.free();
}

test "a set of numbers and a set of strings render as text" {
  Set<num> n = set_init(0, 4);
  n.add(1);
  str one = n.to_string();
  assert equals(one, "{1}"), "expected a single number";
  free(one);
  n.add(2);
  str two = n.to_string();
  assert contains(two, "1") && contains(two, ", ") && starts_with(two, "{") &&
    ends_with(two, "}"), "expected both numbers separated by a comma";
  free(two);
  Set<str> s = set_init("", 4);
  s.add("a");
  str only = s.to_string();
  assert equals(only, "{\"a\"}"), "expected a quoted string";
  free(only);
  s.add("b");
  str both = s.to_string();
  assert contains(both, "\"a\"") && contains(both, "\"b\"") && contains(both, ", "), "expected both strings quoted and separated";
  free(both);
  n.free();
  s.free();
}
