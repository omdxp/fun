// Generic set built on Map<T, bin>.
// 
// Usage:
// ```
// Set<str> s = set_init("", 8);
// s.add("a");
// ```

imp std.map;
imp std.vec;
imp std.c.io;
imp std.quirks;
imp std.option;

// Generic set backed by Map<T, bin>.
pub compound Set<T> {
  // Backing map.
  Map<T, bin> map;
}

// Create a set with initial capacity.
// 
// Params:
// - sample: sample value used only for type inference
// - cap: initial capacity
// 
// Returns:
// - initialized set
pub fun set_init<T>(T sample, num cap) Set<T> {
  Set<T> s;
  _ = sample;
  s.map.init(cap);
  ret s;
}

impl Set<T> as Sized {
  // Return the number of elements.
  // 
  // Returns:
  // - element count
  pub len() num {
    ret self.map.len;
  }

  // Return true when the set holds no elements.
  // 
  // Returns:
  // - true when the set is empty
  pub is_empty() bin {
    ret self.map.len == 0;
  }
}

impl Set<T> {
  // Free internal storage and reset the set.
  pub free() {
    self.map.free();
  }

  // Return true when a key exists in the set.
  // 
  // Params:
  // - key: key to look up
  // 
  // Returns:
  // - true when the key is present
  pub has(T key) bin {
    ret self.map.has(key);
  }

  // Add a key to the set.
  // 
  // Params:
  // - key: key to insert
  pub add(T key) {
    self.map.put(key, true);
  }

  // Remove a key from the set.
  // 
  // Params:
  // - key: key to remove
  // 
  // Returns:
  // - true when a key is removed
  // - false when the key is not present
  pub remove(T key) bin {
    ret self.map.remove(key);
  }

  // Remove all elements from the set.
  pub clear() {
    self.map.clear();
  }

  // Return all members as a vector.
  // 
  // Notes:
  // - A set stores its members as the backing map's keys.
  // - The method is named `keys()` to match `Map` terminology.
  // 
  // Returns:
  // - vector containing the set members
  pub keys() Vec<T> {
    ret self.map.keys();
  }

  // Return a new set containing every element from this set and `other`.
  // 
  // Params:
  // - other: other set to merge with
  // 
  // Returns:
  // - union of the two sets
  pub union(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + other.map.len + 1);
    let ia = self.map.iter_keys();
    for true {
      fit ia.next() {
        Option.Some(k) -> { out.add(k); }
        Option.None -> { break; }
      }
    }
    let ib = other.map.iter_keys();
    for true {
      fit ib.next() {
        Option.Some(k) -> { out.add(k); }
        Option.None -> { break; }
      }
    }
    ret out;
  }

  // Return a new set containing only elements present in both sets.
  // 
  // Params:
  // - other: other set to compare against
  // 
  // Returns:
  // - intersection of the two sets
  pub intersection(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + 1);
    let it = self.map.iter_keys();
    for true {
      fit it.next() {
        Option.Some(k) -> {
          if other.has(k) {
            out.add(k);
          }
        }
        Option.None -> { break; }
      }
    }
    ret out;
  }

  // Return a new set containing elements from this set that are not in `other`.
  // 
  // Params:
  // - other: set whose elements should be excluded
  // 
  // Returns:
  // - set difference `self - other`
  pub difference(Set<T>* other) Set<T> {
    Set<T> out;
    out.map.init(self.map.len + 1);
    let it = self.map.iter_keys();
    for true {
      fit it.next() {
        Option.Some(k) -> {
          if other.has(k) == false {
            out.add(k);
          }
        }
        Option.None -> { break; }
      }
    }
    ret out;
  }

  // Return true when every element of this set is also in `other`.
  // 
  // Params:
  // - other: set to test against
  // 
  // Returns:
  // - true when this set is a subset of `other`
  pub is_subset(Set<T>* other) bin {
    let it = self.map.iter_keys();
    for true {
      fit it.next() {
        Option.Some(k) -> {
          if other.has(k) == false {
            ret false;
          }
        }
        Option.None -> { break; }
      }
    }
    ret true;
  }

  // Return a forward iterator over the set elements.
  // 
  // Notes:
  // - Iteration order is unspecified.
  // 
  // Usage:
  // 
  // ```
  // let it = s.iter();
  // for true {
  //   fit it.next() {
  //     Option.Some(x) -> { use(x); }
  //     Option.None -> { break; }
  //   }
  // }
  // ```
  // 
  // Returns:
  // - iterator yielding each element once
  pub iter() SetIter<T> {
    SetIter<T> it;
    it.inner = self.map.iter_keys();
    ret it;
  }
}

// Forward iterator over a Set's elements, produced by `Set.iter()`.
pub compound SetIter<T> {
  // Backing map key iterator.
  MapIter<T, bin> inner;
}

impl SetIter<T> as Iterator<T> {
  // Return the next element from the iterator.
  // 
  // Returns:
  // - `Some(value)` while elements remain
  // - `None` once the iterator is exhausted
  pub next() Option<T> {
    ret self.inner.next();
  }
}

impl Set<T> as Clearable {
  // Remove all elements while keeping capacity.
  pub clear() {
    self.map.clear();
  }
}

impl Set<num> as Display {
  // Render as `{1, 2, 3}` (elements are unordered).
  pub to_string() str {
    let budget = self.map.len * 26 + 3;
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    let it = self.iter();
    for true {
      fit it.next() {
        Option.Some(x) -> {
          if written > 0 {
            out[pos] = ',';
            out[pos + 1] = ' ';
            pos = pos + 2;
          }
          chr[24] cell;
          let c = snprintf(cell, 24, "%lld", x);
          num k = 0;
          for k < c {
            out[pos + k] = cell[k];
            k = k + 1;
          }
          pos = pos + c;
          written = written + 1;
        }
        Option.None -> { break; }
      }
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}

impl Set<str> as Display {
  // Render as `{"a", "b"}` (elements are unordered).
  pub to_string() str {
    num budget = 3;
    SetIter<str> measure = self.iter();
    for true {
      fit measure.next() {
        Option.Some(x) -> {
          num m = 0;
          for x[m] != 0 {
            m = m + 1;
          }
          budget = budget + m + 4;
        }
        Option.None -> { break; }
      }
    }
    str out = malloc(budget);
    if out == nil {
      ret nil;
    }
    num pos = 0;
    out[pos] = '{';
    pos = pos + 1;
    num written = 0;
    SetIter<str> it = self.iter();
    for true {
      fit it.next() {
        Option.Some(x) -> {
          if written > 0 {
            out[pos] = ',';
            out[pos + 1] = ' ';
            pos = pos + 2;
          }
          out[pos] = '"';
          pos = pos + 1;
          num k = 0;
          for x[k] != 0 {
            out[pos + k] = x[k];
            k = k + 1;
          }
          pos = pos + k;
          out[pos] = '"';
          pos = pos + 1;
          written = written + 1;
        }
        Option.None -> { break; }
      }
    }
    out[pos] = '}';
    out[pos + 1] = '\0';
    ret out;
  }
}
