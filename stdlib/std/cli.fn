// CLI argument parsing.
// 
// Usage:
// ```
// CliArgs c = cli_parse(args);
// if c.has("help") { ... }
// ```

imp std.map;
imp std.vec;
imp std.string;
imp std.quirks;

// Parsed command-line arguments.
pub compound CliArgs {
  // opts: parsed --key/--key=value flags
  Map<str, str> opts;
  // positionals: non-flag arguments
  Vec<str> positionals;
}

// Parse argv into options and positionals.
// 
// Params:
// - args: argv-style array (args[0] is program name)
// 
// Returns:
// - parsed CliArgs with options and positionals
pub fun cli_parse(str[] args) CliArgs {
  CliArgs out;
  out.opts.init(8);
  out.positionals.init(8);

  num i = 1;
  for args[i] != 0 {
    let arg = args[i];
    if arg[0] == '-' && arg[1] == '-' {
      // --key or --key=value
      let eq_idx = index_of_char(arg, '=');
      if eq_idx == -1 {
        let key = substr(arg, 2, len(arg) - 2);
        out.opts.put(key, "1");
      } else {
        let key_len = eq_idx - 2;
        let key = substr(arg, 2, key_len);
        let val = substr(arg, eq_idx + 1, len(arg) - (eq_idx + 1));
        out.opts.put(key, val);
      }
    } else {
      out.positionals.push(arg);
    }
    i = i + 1;
  }

  ret out;
}

// Parse argv with extended rules:
// - supports --key value
// - supports -k value
// - supports -abc (bundled short flags)
// - supports -- to end option parsing
pub fun cli_parse_ext(str[] args) CliArgs {
  CliArgs out;
  out.opts.init(8);
  out.positionals.init(8);

  num i = 1;
  bin end_opts = false;
  for args[i] != 0 {
    let arg = args[i];

    if end_opts {
      out.positionals.push(arg);
      i = i + 1;
      continue;
    }

    if arg == "--" {
      end_opts = true;
      i = i + 1;
      continue;
    }

    if arg[0] == '-' && arg[1] == '-' {
      // --key or --key=value or --key value
      let eq_idx = index_of_char(arg, '=');
      if eq_idx == -1 {
        let key = substr(arg, 2, len(arg) - 2);
        let next_arg = args[i + 1];
        if next_arg != 0 && next_arg[0] != '-' {
          out.opts.put(key, next_arg);
          i = i + 2;
          continue;
        }
        out.opts.put(key, "1");
      } else {
        let key_len = eq_idx - 2;
        let key = substr(arg, 2, key_len);
        let val = substr(arg, eq_idx + 1, len(arg) - (eq_idx + 1));
        out.opts.put(key, val);
      }
    } elif arg[0] == '-' {
      // -k or -k=value or -abc or -k value
      let eq_idx = index_of_char(arg, '=');
      if eq_idx != -1 {
        let key = substr(arg, 1, eq_idx - 1);
        let val = substr(arg, eq_idx + 1, len(arg) - (eq_idx + 1));
        out.opts.put(key, val);
      } elif len(arg) == 2 {
        let key = substr(arg, 1, 1);
        let next_arg = args[i + 1];
        if next_arg != 0 && next_arg[0] != '-' {
          out.opts.put(key, next_arg);
          i = i + 2;
          continue;
        }
        out.opts.put(key, "1");
      } else {
        num j = 1;
        for j < len(arg) {
          let key = substr(arg, j, 1);
          out.opts.put(key, "1");
          j = j + 1;
        }
      }
    } else {
      out.positionals.push(arg);
    }
    i = i + 1;
  }

  ret out;
}

impl CliArgs Sized {
  // Number of positional arguments.
  pub len() num {
    ret self.positionals.len;
  }

  // Returns true when no positionals are present.
  pub is_empty() bin {
    ret self.positionals.len == 0;
  }
}

impl CliArgs {
  // Check if an option exists.
  pub has(str key) bin {
    ret self.opts.has(key);
  }

  // Get an option value.
  pub get(str key) str {
    ret self.opts.get(key);
  }

  // Get an option value or default if missing.
  pub get_or(str key, str default_value) str {
    if self.opts.has(key) {
      ret self.opts.get(key);
    }
    ret default_value;
  }

  // Read a positional argument by index.
  pub positional(num i) str {
    ret self.positionals.get(i);
  }

  // Free internal storage.
  pub free() {
    self.opts.free();
    self.positionals.free();
  }
}

// C-style wrapper for option existence.
// 
// Params:
// - args: parsed args
// - key: option name
// 
// Returns:
// - true if present
pub fun cli_has(CliArgs* args, str key) bin {
  ret args.has(key);
}

// C-style wrapper for option value.
// 
// Params:
// - args: parsed args
// - key: option name
// 
// Returns:
// - value string or null
pub fun cli_get(CliArgs* args, str key) str {
  ret args.get(key);
}

// C-style wrapper for cleanup.
pub fun cli_free(CliArgs* args) {
  args.free();
}
