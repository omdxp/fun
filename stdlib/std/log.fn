// Structured logging.
//
// A `Logger` filters by severity, renders records as human-readable text or
// as one JSON object per line, and routes output to any `std.io.Sink`
// (stdout, stderr, a file, or a rotating file). Records may carry typed
// key/value fields, either via direct calls (`l.info(...)`) or a chainable
// builder (`l.info_r(...).str_field(...).emit()`).

use std.io;
use std.string;
use std.vec;
use std.time;
use std.fs;

use std.fs;

// Log severity levels with explicit ordered values, so filtering is a stable
// integer comparison and there's room to insert levels between the existing ones.
pub enum LogLevel {
  // Very verbose tracing.
  Trace = 0,
  // Verbose diagnostic logging.
  Debug = 10,
  // General informational messages.
  Info = 20,
  // Warning conditions.
  Warn = 30,
  // Error conditions.
  Error = 40,
  // Unrecoverable errors; the emitter flushes after a Fatal record.
  Fatal = 50
}

// Output rendering format.
pub enum LogFormat {
  // Human-readable single line: `[LEVEL] <ts> [name] msg key=value ...`.
  Text,
  // One JSON object per line: `{"level":..,"ts":..,"msg":..,<fields>}`.
  Json
}

// A typed structured-field value. A data-carrying enum is the reflection-free way
// to hold a mixed-type value; a value needing more structure can pass its JSON
// text via `.Str`.
pub enum FieldVal {
  Str(str),
  Num(num),
  Dec(dec),
  Flag(flag)
}

// An ordered key/value pair attached to a log record.
pub compound Field {
  str key;
  FieldVal val;
}

// Field constructors (ergonomic sugar over `FieldVal`).

// Builds a string-valued field.
pub fun fstr(str k, str v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Str(v);
  ret f;
}

// Builds a numeric-valued field.
pub fun fnum(str k, num v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Num(v);
  ret f;
}

// Builds a decimal-valued field.
pub fun fdec(str k, dec v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Dec(v);
  ret f;
}

// Builds a boolean-valued field.
pub fun fflag(str k, flag v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Flag(v);
  ret f;
}

// Logger configuration. Cheap to copy; the fluent setters return a new Logger.
pub compound Logger {
  // Minimum severity to emit.
  LogLevel level;
  // Output rendering format.
  LogFormat format;
  // Destination.
  Sink sink;
  // Prefix each record with a timestamp.
  flag with_timestamp;
  // Optional logger name (empty = none).
  str name;
  // When true, Warn/Error/Fatal go to stderr even if `sink` is stdout.
  flag route_err;
}

// Creates a Text logger writing to stdout with timestamps on, filtering below `level`.
pub fun logger_init(
  LogLevel level,
  LogFormat format = .Text,
  Sink sink = .Stdout,
  flag with_timestamp = true,
  str name = "",
  flag route_err = false
) Logger {
  Logger l;
  l.level = level;
  l.format = format;
  l.sink = sink;
  l.with_timestamp = with_timestamp;
  l.name = name;
  l.route_err = route_err;
  ret l;
}

// Creates a JSON logger writing to stdout, filtering below `level`.
pub fun logger_json(LogLevel level) Logger {
  let l = logger_init(level);
  l.format = LogFormat.Json;
  ret l;
}

// Converts a log level to its uppercase label (`"TRACE"`, `"DEBUG"`, ...).
pub fun level_name(LogLevel level) str {
  fit level {
    .Trace -> { ret "TRACE"; }
    .Debug -> { ret "DEBUG"; }
    .Info -> { ret "INFO"; }
    .Warn -> { ret "WARN"; }
    .Error -> { ret "ERROR"; }
    .Fatal -> { ret "FATAL"; }
  }
  ret "INFO";
}

// Append a JSON-escaped string (contents only, no surrounding quotes) to `b`.
fun json_escape_into(StringBuilder* b, str s) {
  num i = 0;
  for s[i] != 0 {
    let c = s[i];
    if c == '"' {
      b.append_char('\\');
      b.append_char('"');
    } elif c == '\\' {
      b.append_char('\\');
      b.append_char('\\');
    } elif c == '\n' {
      b.append_char('\\');
      b.append_char('n');
    } elif c == '\t' {
      b.append_char('\\');
      b.append_char('t');
    } elif c == '\r' {
      b.append_char('\\');
      b.append_char('r');
    } else {
      b.append_char(c);
    }
    i = i + 1;
  }
}

// Append a FieldVal to `b` in Text form (`value`), no key.
fun field_val_text_into(StringBuilder* b, FieldVal* v) {
  fit *v {
    .Str(s) -> { b.append(s); }
    .Num(n) -> { b.append_num(n); }
    .Dec(d) -> { b.append_dec(d, 6); }
    .Flag(x) -> { b.append(format_flag(x)); }
  }
}

// Append a FieldVal to `b` in JSON form (quoted when a string).
fun field_val_json_into(StringBuilder* b, FieldVal* v) {
  fit *v {
    .Str(s) -> {
      b.append_char('"');
      json_escape_into(b, s);
      b.append_char('"');
    }
    .Num(n) -> { b.append_num(n); }
    .Dec(d) -> { b.append_dec(d, 6); }
    .Flag(x) -> { b.append(format_flag(x)); }
  }
}

// A pending log record plus the builder for attaching structured fields.
// Returned by value from the `*_r`/`record` entrypoints and chained by value:
// `l.info_r("m").num_field("n", 1).emit()`. When `live` is false the record
// is below the logger threshold, so every builder method and `emit()` are no-ops.
pub compound LogRecord {
  // Severity this record was opened at.
  LogLevel level;
  // Record message.
  str msg;
  // Structured fields attached via the builder methods.
  Vec<Field> fields;
  // Copied logger config so `emit()` is self-contained.
  LogLevel min;
  LogFormat format;
  Sink sink;
  flag with_timestamp;
  str name;
  flag route_err;
  // False when this record is below the logger's threshold; every builder
  // method and `emit()` become no-ops so filtered-out logging stays cheap.
  flag live;
}

impl LogRecord {
  // Attaches a prebuilt field; chainable.
  pub with(Field f) LogRecord {
    if self.live {
      self.fields.push(f);
    }
    ret *self;
  }

  // Attaches a typed field; chainable.
  pub field(str key, FieldVal v) LogRecord {
    if self.live {
      Field f;
      f.key = key;
      f.val = v;
      self.fields.push(f);
    }
    ret *self;
  }

  // Attaches a string-valued field; chainable.
  pub str_field(str k, str v) LogRecord {
    ret self.field(k, FieldVal.Str(v));
  }

  // Attaches a numeric-valued field; chainable.
  pub num_field(str k, num v) LogRecord {
    ret self.field(k, FieldVal.Num(v));
  }

  // Attaches a decimal-valued field; chainable.
  pub dec_field(str k, dec v) LogRecord {
    ret self.field(k, FieldVal.Dec(v));
  }

  // Attaches a boolean-valued field; chainable.
  pub flag_field(str k, flag v) LogRecord {
    ret self.field(k, FieldVal.Flag(v));
  }

  // Render the record and write it to its destination.
  pub emit() {
    if self.live == false {
      ret;
    }

    // Choose the effective destination: route Warn+ to stderr when configured.
    Sink dest = self.sink;
    if self.route_err && self.level >= LogLevel.Warn {
      dest = Sink.Stderr;
    }

    let sb = string_builder_init(64);
    let n = self.fields.len();

    // Stack-allocated buffer for an RFC3339 UTC timestamp (e.g.
    // "2026-07-28T08:50:11Z"), avoiding a heap allocation on every log call.
    chr[32] ts_buf;
    if self.with_timestamp {
      now().format_utc(ts_buf, 32, "%Y-%m-%dT%H:%M:%SZ");
    }

    fit self.format {
      .Text -> {
        sb.append_char('[');
        sb.append(level_name(self.level));
        sb.append_char(']');
        if self.with_timestamp {
          sb.append_char(' ');
          sb.append(ts_buf);
        }
        if len(self.name) > 0 {
          sb.append(" [");
          sb.append(self.name);
          sb.append_char(']');
        }
        sb.append_char(' ');
        sb.append(self.msg);
        num i = 0;
        for i < n {
          let f = self.fields.get(i);
          sb.append_char(' ');
          sb.append(f.key);
          sb.append_char('=');
          field_val_text_into(&sb, &f.val);
          i = i + 1;
        }
      }
      .Json -> {
        // Rendered manually (not via std.json) so field order is deterministic
        // (insertion order) and Text-only users don't pull in the json module.
        sb.append("{\"level\":\"");
        sb.append(level_name(self.level));
        sb.append_char('"');
        if self.with_timestamp {
          sb.append(",\"ts\":\"");
          json_escape_into(&sb, ts_buf);
          sb.append_char('"');
        }
        if len(self.name) > 0 {
          sb.append(",\"logger\":\"");
          json_escape_into(&sb, self.name);
          sb.append_char('"');
        }
        sb.append(",\"msg\":\"");
        json_escape_into(&sb, self.msg);
        sb.append_char('"');
        num i = 0;
        for i < n {
          let f = self.fields.get(i);
          sb.append(",\"");
          json_escape_into(&sb, f.key);
          sb.append("\":");
          field_val_json_into(&sb, &f.val);
          i = i + 1;
        }
        sb.append_char('}');
      }
    }

    sb.append_char('\n');
    let line = sb.build();
    _ = dest.write(line);
    if self.level >= LogLevel.Fatal {
      _ = dest.flush();
    }
  }
}

impl Logger {
  // Sets the minimum severity level to emit.
  pub set_level(LogLevel level) {
    self.level = level;
  }

  // Returns true when `level` would be emitted by this logger.
  pub enabled(LogLevel level) flag {
    ret level >= self.level;
  }

  // Fluent configuration (each returns the Logger by value, so calls chain).

  // Sets the output rendering format; chainable.
  pub as_format(LogFormat f) Logger {
    self.format = f;
    ret *self;
  }

  // Sets the destination sink; chainable.
  pub to_sink(Sink s) Logger {
    self.sink = s;
    ret *self;
  }

  // Sets the logger name, included in rendered records when non-empty; chainable.
  pub named(str name) Logger {
    self.name = name;
    ret *self;
  }

  // Toggles routing Warn+ records to stderr regardless of `sink`; chainable.
  pub route_errors(flag on) Logger {
    self.route_err = on;
    ret *self;
  }

  // Toggles whether records are prefixed with a timestamp; chainable.
  pub with_timestamps(flag on) Logger {
    self.with_timestamp = on;
    ret *self;
  }

  // Opens a builder record for `level`/`msg`, ready for chained field
  // attachment and `emit()`. Prefer the `*_r` shortcuts.
  pub record(LogLevel level, str msg) LogRecord {
    LogRecord r;
    r.level = level;
    r.msg = msg;
    r.fields.init(4);
    r.min = self.level;
    r.format = self.format;
    r.sink = self.sink;
    r.with_timestamp = self.with_timestamp;
    r.name = self.name;
    r.route_err = self.route_err;
    r.live = level >= self.level;
    ret r;
  }

  // Open a Trace-level builder record for `msg`.
  pub trace_r(str msg) LogRecord {
    ret self.record(.Trace, msg);
  }
  // Open a Debug-level builder record for `msg`.
  pub debug_r(str msg) LogRecord {
    ret self.record(.Debug, msg);
  }
  // Open an Info-level builder record for `msg`.
  pub info_r(str msg) LogRecord {
    ret self.record(.Info, msg);
  }
  // Open a Warn-level builder record for `msg`.
  pub warn_r(str msg) LogRecord {
    ret self.record(.Warn, msg);
  }
  // Open an Error-level builder record for `msg`.
  pub error_r(str msg) LogRecord {
    ret self.record(.Error, msg);
  }
  // Open a Fatal-level builder record for `msg`.
  pub fatal_r(str msg) LogRecord {
    ret self.record(.Fatal, msg);
  }

  // Emits a bare message immediately, with no structured fields.
  pub log(LogLevel level, str msg) {
    let r = self.record(level, msg);
    r.emit();
  }

  // Logs a trace-level message.
  pub trace(str msg) {
    self.log(.Trace, msg);
  }
  // Logs a debug-level message.
  pub debug(str msg) {
    self.log(.Debug, msg);
  }
  // Logs an info-level message.
  pub info(str msg) {
    self.log(.Info, msg);
  }
  // Logs a warning-level message.
  pub warn(str msg) {
    self.log(.Warn, msg);
  }
  // Logs an error-level message.
  pub error(str msg) {
    self.log(.Error, msg);
  }
  // Logs a fatal-level message. The emitter flushes its sink afterward.
  pub fatal(str msg) {
    self.log(.Fatal, msg);
  }

  // Logs a message tagged with a `tag` field.
  pub log_tag(LogLevel level, str tag, str msg) {
    if level >= self.level {
      let r = self.record(level, msg);
      r.str_field("tag", tag).emit();
    }
  }

  // Logs a single numeric field under `label`, with no message.
  pub log_num(LogLevel level, str label, num value) {
    if level >= self.level {
      let r = self.record(level, "");
      r.num_field(label, value).emit();
    }
  }

  // Logs a single decimal field under `label`, with no message.
  pub log_dec(LogLevel level, str label, dec value) {
    if level >= self.level {
      let r = self.record(level, "");
      r.dec_field(label, value).emit();
    }
  }

  // Logs a single boolean field under `label`, with no message.
  pub log_flag(LogLevel level, str label, flag value) {
    if level >= self.level {
      let r = self.record(level, "");
      r.flag_field(label, value).emit();
    }
  }
}

// --- One-off free helpers -------------------------------------------------------------
// These log at their level through a default stdout Text logger with a Trace
// threshold (so every one-off message is emitted).

// Logs `msg` at `level` through a default stdout Text logger.
pub fun log(LogLevel level, str msg) {
  let l = logger_init(.Trace);
  l.log(level, msg);
}

// Logs a trace-level message through a default stdout Text logger.
pub fun log_trace(str msg) {
  let l = logger_init(.Trace);
  l.trace(msg);
}

// Logs a debug-level message through a default stdout Text logger.
pub fun log_debug(str msg) {
  let l = logger_init(.Trace);
  l.debug(msg);
}

// Logs an info-level message through a default stdout Text logger.
pub fun log_info(str msg) {
  let l = logger_init(.Trace);
  l.info(msg);
}

// Logs a warning-level message through a default stdout Text logger.
pub fun log_warn(str msg) {
  let l = logger_init(.Trace);
  l.warn(msg);
}

// Logs an error-level message through a default stdout Text logger.
pub fun log_error(str msg) {
  let l = logger_init(.Trace);
  l.error(msg);
}

// Logs a fatal-level message through a default stdout Text logger.
pub fun log_fatal(str msg) {
  let l = logger_init(.Trace);
  l.fatal(msg);
}

// A logger that writes to `path` with timestamps off, so its output is exact.
fun _test_logger(str path, LogLevel level, LogFormat format) Logger {
  File f = open_write(path);
  ret logger_init(level, format, Sink.File(f), false, "app", false);
}

// Closes the logger's file and returns what it wrote, removing the file.
fun _test_output(Logger l, str path) str {
  fit l.sink {
    .File(f) -> { f.close(); }
    _ -> {}
  }
  str out = read_all(path);
  remove_file(path);
  ret out;
}

test "a text logger writes level, name, message and fields on one line" {
  str path = "fun-out/log_text_test.txt";
  Logger l = _test_logger(path, .Info, .Text);
  l.info("started");
  l.info_r("request").str_field("path", "/x").num_field("n", 3).flag_field("ok", true).emit();
  str out = _test_output(l, path);
  assert contains(out, "[INFO] [app] started\n"), "expected the plain message line";
  assert contains(out, "[INFO] [app] request path=/x n=3 ok=true\n"), "expected the fields after the message";
}

test "records below the level are dropped and enabled says so" {
  str path = "fun-out/log_level_test.txt";
  Logger l = _test_logger(path, .Warn, .Text);
  l.trace("t");
  l.debug("d");
  l.info("i");
  l.warn("w");
  l.error("e");
  assert !l.enabled(.Info) && l.enabled(.Warn) && l.enabled(.Fatal), "expected the threshold to decide what is enabled";
  l.set_level(.Trace);
  assert l.enabled(.Trace), "expected set_level to lower the threshold";
  l.set_level(.Warn);
  str out = _test_output(l, path);
  assert !contains(out, "] t") && !contains(out, "] d") && !contains(out, "] i"), "expected records below warn dropped";
  assert contains(out, "[WARN] [app] w") && contains(out, "[ERROR] [app] e"), "expected warn and error kept";
}

test "a json logger writes one object per line with escaped text and ordered fields" {
  str path = "fun-out/log_json_test.txt";
  Logger l = _test_logger(path, .Debug, .Json);
  l.error_r("bad \"input\"\nline2").str_field("who", "me").num_field("code", 7).dec_field("ratio", 0.5).flag_field("retry", false).emit();
  str out = _test_output(l, path);
  assert contains(out, "{\"level\":\"ERROR\",\"logger\":\"app\",\"msg\":\"bad \\\"input\\\"\\nline2\",\"who\":\"me\",\"code\":7,"), "expected the JSON prefix with the escaped message";
  assert contains(out, "\"retry\":false}\n"), "expected the last field and a newline";
}

test "a logger with timestamps writes an ISO time after the level" {
  str path = "fun-out/log_ts_test.txt";
  File f = open_write(path);
  Logger l = logger_init(.Info, .Text, Sink.File(f), true, "", false);
  l.info("tick");
  str out = _test_output(l, path);
  assert starts_with(out, "[INFO] 20"), "expected a year after the level";
  assert contains(out, "Z tick\n"), "expected the UTC marker before the message";
  assert !contains(out, " [] "), "expected no empty name brackets";
}

test "every level has its uppercase name" {
  assert equals(level_name(.Trace), "TRACE") && equals(level_name(.Debug), "DEBUG"), "expected trace and debug";
  assert equals(level_name(.Info), "INFO") && equals(level_name(.Warn), "WARN"), "expected info and warn";
  assert equals(level_name(.Error), "ERROR") && equals(level_name(.Fatal), "FATAL"), "expected error and fatal";
}

test "field constructors and the builder attach typed fields" {
  str path = "fun-out/log_fields_test.txt";
  Logger l = _test_logger(path, .Trace, .Text);
  l.trace_r("t").with(fstr("a", "x")).with(fnum("b", 2)).with(fdec("c", 1.5)).with(fflag("d", true)).emit();
  l.debug_r("d").emit();
  l.warn_r("w").emit();
  l.fatal_r("f").emit();
  str out = _test_output(l, path);
  assert contains(out, "[TRACE] [app] t a=x b=2 c=1.5"), "expected the four field kinds in order";
  assert contains(out, "d=true"), "expected the flag field";
  assert contains(out, "[DEBUG] [app] d\n") && contains(out, "[WARN] [app] w\n") &&
    contains(out, "[FATAL] [app] f\n"), "expected each builder level";
  }

test "log_tag, log_num, log_dec and log_flag write a labelled field" {
  str path = "fun-out/log_labels_test.txt";
  Logger l = _test_logger(path, .Info, .Text);
  l.log_tag(.Info, "net", "connected");
  l.log_num(.Info, "count", 4);
  l.log_dec(.Info, "load", 0.25);
  l.log_flag(.Info, "up", true);
  l.log_num(.Debug, "hidden", 1);
  str out = _test_output(l, path);
  assert contains(out, "connected tag=net"), "expected the tag field";
  assert contains(out, "count=4") && contains(out, "load=0.25") && contains(out, "up=true"), "expected the labelled values";
  assert !contains(out, "hidden"), "expected a record below the level to be dropped";
}

test "the fluent setters change format, sink and name" {
  str path = "fun-out/log_fluent_test.txt";
  Logger base = logger_init(.Info);
  File f = open_write(path);
  Logger l = base.as_format(.Json).to_sink(Sink.File(f)).named("svc").with_timestamps(false).route_errors(false);
  l.info("hello");
  str out = _test_output(l, path);
  assert equals(out, "{\"level\":\"INFO\",\"logger\":\"svc\",\"msg\":\"hello\"}\n"), "expected the reconfigured logger's exact output";
}

test "the one-off helpers log through a default logger" {
  log_trace("one-off trace");
  log_debug("one-off debug");
  log_info("one-off info");
  log_warn("one-off warn");
  log_error("one-off error");
  log_fatal("one-off fatal");
  log(.Info, "one-off generic");
  assert true, "expected every helper to return";
}
