// Structured logging.
//
// A `Logger` filters by severity, renders records as human-readable text or
// as one JSON object per line, and routes output to any `std.io.Sink`
// (stdout, stderr, a file, or a rotating file). Records may carry typed
// key/value fields, either via direct calls (`l.info(...)`) or a chainable
// builder (`l.info_r(...).str_field(...).emit()`).

imp std.io;
imp std.string;
imp std.vec;
imp std.time;

// Log severity levels with explicit ordered values, so filtering is a stable
// integer comparison and there's room to insert levels between the existing ones.
pub enum LogLevel {
  // Very verbose tracing.
  Trace = 0,
  // Verbose diagnostic logging.
  Debug = 10,
  // General informational messages.
  Info = 20,
  // Warning conditions.
  Warn = 30,
  // Error conditions.
  Error = 40,
  // Unrecoverable errors; the emitter flushes after a Fatal record.
  Fatal = 50
}

// Output rendering format.
pub enum LogFormat {
  // Human-readable single line: `[LEVEL] <ts> [name] msg key=value ...`.
  Text,
  // One JSON object per line: `{"level":..,"ts":..,"msg":..,<fields>}`.
  Json
}

// A typed structured-field value. A data-carrying enum is the reflection-free way
// to hold a mixed-type value; a value needing more structure can pass its JSON
// text via `.Str`.
pub enum FieldVal {
  Str(str),
  Num(num),
  Dec(dec),
  Bin(bin)
}

// An ordered key/value pair attached to a log record.
pub compound Field {
  str key;
  FieldVal val;
}

// Field constructors (ergonomic sugar over `FieldVal`).

// Build a string-valued field.
// 
// Params:
// - k: field key
// - v: field value
// 
// Returns:
// - the constructed field
pub fun fstr(str k, str v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Str(v);
  ret f;
}

// Build a numeric-valued field.
// 
// Params:
// - k: field key
// - v: field value
// 
// Returns:
// - the constructed field
pub fun fnum(str k, num v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Num(v);
  ret f;
}

// Build a decimal-valued field.
// 
// Params:
// - k: field key
// - v: field value
// 
// Returns:
// - the constructed field
pub fun fdec(str k, dec v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Dec(v);
  ret f;
}

// Build a boolean-valued field.
// 
// Params:
// - k: field key
// - v: field value
// 
// Returns:
// - the constructed field
pub fun fbin(str k, bin v) Field {
  Field f;
  f.key = k;
  f.val = FieldVal.Bin(v);
  ret f;
}

// Logger configuration. Cheap to copy; the fluent setters return a new Logger.
pub compound Logger {
  // Minimum severity to emit.
  LogLevel level;
  // Output rendering format.
  LogFormat format;
  // Destination.
  Sink sink;
  // Prefix each record with a timestamp.
  bin with_timestamp;
  // Optional logger name (empty = none).
  str name;
  // When true, Warn/Error/Fatal go to stderr even if `sink` is stdout.
  bin route_err;
}

// Create a Text logger writing to stdout with timestamps on.
// 
// Params:
// - level: minimum severity to emit
// 
// Returns:
// - initialized logger
pub fun logger_init(
  LogLevel level,
  LogFormat format = .Text,
  Sink sink = .Stdout,
  bin with_timestamp = true,
  str name = "",
  bin route_err = false
) Logger {
  Logger l;
  l.level = level;
  l.format = format;
  l.sink = sink;
  l.with_timestamp = with_timestamp;
  l.name = name;
  l.route_err = route_err;
  ret l;
}

// Create a JSON logger writing to stdout.
// 
// Params:
// - level: minimum severity to emit
// 
// Returns:
// - initialized logger with `format` set to `LogFormat.Json`
pub fun logger_json(LogLevel level) Logger {
  let l = logger_init(level);
  l.format = LogFormat.Json;
  ret l;
}

// Convert a log level to its label string.
// 
// Params:
// - level: severity to convert
// 
// Returns:
// - the level's uppercase label (`"TRACE"`, `"DEBUG"`, ...)
pub fun level_name(LogLevel level) str {
  fit level {
    .Trace -> { ret "TRACE"; }
    .Debug -> { ret "DEBUG"; }
    .Info -> { ret "INFO"; }
    .Warn -> { ret "WARN"; }
    .Error -> { ret "ERROR"; }
    .Fatal -> { ret "FATAL"; }
  }
  ret "INFO";
}

// Append a JSON-escaped string (contents only, no surrounding quotes) to `b`.
fun json_escape_into(StringBuilder* b, str s) {
  num i = 0;
  for s[i] != 0 {
    let c = s[i];
    if c == '"' {
      b.append_char('\\');
      b.append_char('"');
    } elif c == '\\' {
      b.append_char('\\');
      b.append_char('\\');
    } elif c == '\n' {
      b.append_char('\\');
      b.append_char('n');
    } elif c == '\t' {
      b.append_char('\\');
      b.append_char('t');
    } elif c == '\r' {
      b.append_char('\\');
      b.append_char('r');
    } else {
      b.append_char(c);
    }
    i = i + 1;
  }
}

// Append a FieldVal to `b` in Text form (`value`), no key.
fun field_val_text_into(StringBuilder* b, FieldVal* v) {
  fit *v {
    .Str(s) -> { b.append(s); }
    .Num(n) -> { b.append_num(n); }
    .Dec(d) -> { b.append_dec(d, 6); }
    .Bin(x) -> { b.append(format_bin(x)); }
  }
}

// Append a FieldVal to `b` in JSON form (quoted when a string).
fun field_val_json_into(StringBuilder* b, FieldVal* v) {
  fit *v {
    .Str(s) -> {
      b.append_char('"');
      json_escape_into(b, s);
      b.append_char('"');
    }
    .Num(n) -> { b.append_num(n); }
    .Dec(d) -> { b.append_dec(d, 6); }
    .Bin(x) -> { b.append(format_bin(x)); }
  }
}

// A pending log record plus the builder for attaching structured fields.
// Returned by value from the `*_r`/`record` entrypoints and chained by value:
// `l.info_r("m").num_field("n", 1).emit()`. When `live` is false the record
// is below the logger threshold, so every builder method and `emit()` are no-ops.
pub compound LogRecord {
  // Severity this record was opened at.
  LogLevel level;
  // Record message.
  str msg;
  // Structured fields attached via the builder methods.
  Vec<Field> fields;
  // Copied logger config so `emit()` is self-contained.
  LogLevel min;
  LogFormat format;
  Sink sink;
  bin with_timestamp;
  str name;
  bin route_err;
  // False when this record is below the logger's threshold; every builder
  // method and `emit()` become no-ops so filtered-out logging stays cheap.
  bin live;
}

impl LogRecord {
  // Attach a prebuilt field.
  // 
  // Params:
  // - f: field to attach
  // 
  // Returns:
  // - the record by value (chainable)
  pub with(Field f) LogRecord {
    if self.live {
      self.fields.push(f);
    }
    ret *self;
  }

  // Attach a typed field.
  // 
  // Params:
  // - key: field key
  // - v: field value
  // 
  // Returns:
  // - the record by value (chainable)
  pub field(str key, FieldVal v) LogRecord {
    if self.live {
      Field f;
      f.key = key;
      f.val = v;
      self.fields.push(f);
    }
    ret *self;
  }

  // Attach a string-valued field.
  // 
  // Params:
  // - k: field key
  // - v: field value
  // 
  // Returns:
  // - the record by value (chainable)
  pub str_field(str k, str v) LogRecord {
    ret self.field(k, FieldVal.Str(v));
  }

  // Attach a numeric-valued field.
  // 
  // Params:
  // - k: field key
  // - v: field value
  // 
  // Returns:
  // - the record by value (chainable)
  pub num_field(str k, num v) LogRecord {
    ret self.field(k, FieldVal.Num(v));
  }

  // Attach a decimal-valued field.
  // 
  // Params:
  // - k: field key
  // - v: field value
  // 
  // Returns:
  // - the record by value (chainable)
  pub dec_field(str k, dec v) LogRecord {
    ret self.field(k, FieldVal.Dec(v));
  }

  // Attach a boolean-valued field.
  // 
  // Params:
  // - k: field key
  // - v: field value
  // 
  // Returns:
  // - the record by value (chainable)
  pub bin_field(str k, bin v) LogRecord {
    ret self.field(k, FieldVal.Bin(v));
  }

  // Render the record and write it to its destination.
  pub emit() {
    if self.live == false {
      ret;
    }

    // Choose the effective destination: route Warn+ to stderr when configured.
    Sink dest = self.sink;
    if self.route_err && self.level >= LogLevel.Warn {
      dest = Sink.Stderr;
    }

    let sb = string_builder_init(64);
    let n = self.fields.len();

    // Stack-allocated buffer for an RFC3339 UTC timestamp (e.g.
    // "2026-07-28T08:50:11Z"), avoiding a heap allocation on every log call.
    chr[32] ts_buf;
    if self.with_timestamp {
      now().format_utc(ts_buf, 32, "%Y-%m-%dT%H:%M:%SZ");
    }

    fit self.format {
      .Text -> {
        sb.append_char('[');
        sb.append(level_name(self.level));
        sb.append_char(']');
        if self.with_timestamp {
          sb.append_char(' ');
          sb.append(ts_buf);
        }
        if len(self.name) > 0 {
          sb.append(" [");
          sb.append(self.name);
          sb.append_char(']');
        }
        sb.append_char(' ');
        sb.append(self.msg);
        num i = 0;
        for i < n {
          let f = self.fields.get(i);
          sb.append_char(' ');
          sb.append(f.key);
          sb.append_char('=');
          field_val_text_into(&sb, &f.val);
          i = i + 1;
        }
      }
      .Json -> {
        // Rendered manually (not via std.json) so field order is deterministic
        // (insertion order) and Text-only users don't pull in the json module.
        sb.append("{\"level\":\"");
        sb.append(level_name(self.level));
        sb.append_char('"');
        if self.with_timestamp {
          sb.append(",\"ts\":\"");
          json_escape_into(&sb, ts_buf);
          sb.append_char('"');
        }
        if len(self.name) > 0 {
          sb.append(",\"logger\":\"");
          json_escape_into(&sb, self.name);
          sb.append_char('"');
        }
        sb.append(",\"msg\":\"");
        json_escape_into(&sb, self.msg);
        sb.append_char('"');
        num i = 0;
        for i < n {
          let f = self.fields.get(i);
          sb.append(",\"");
          json_escape_into(&sb, f.key);
          sb.append("\":");
          field_val_json_into(&sb, &f.val);
          i = i + 1;
        }
        sb.append_char('}');
      }
    }

    sb.append_char('\n');
    let line = sb.build();
    _ = dest.write(line);
    if self.level >= LogLevel.Fatal {
      _ = dest.flush();
    }
  }
}

impl Logger {
  // Set the minimum severity level.
  // 
  // Params:
  // - level: new minimum severity threshold
  pub set_level(LogLevel level) {
    self.level = level;
  }

  // Return true when a level would be emitted.
  // 
  // Params:
  // - level: severity to test
  // 
  // Returns:
  // - true when the logger would emit messages at this level
  pub enabled(LogLevel level) bin {
    ret level >= self.level;
  }

  // Fluent configuration (each returns the Logger by value, so calls chain).

  // Set the output rendering format.
  // 
  // Params:
  // - f: rendering format
  // 
  // Returns:
  // - the logger by value (chainable)
  pub as_format(LogFormat f) Logger {
    self.format = f;
    ret *self;
  }

  // Set the destination sink.
  // 
  // Params:
  // - s: destination sink
  // 
  // Returns:
  // - the logger by value (chainable)
  pub to_sink(Sink s) Logger {
    self.sink = s;
    ret *self;
  }

  // Set the logger name, included in rendered records when non-empty.
  // 
  // Params:
  // - name: logger name
  // 
  // Returns:
  // - the logger by value (chainable)
  pub named(str name) Logger {
    self.name = name;
    ret *self;
  }

  // Toggle routing Warn+ records to stderr regardless of `sink`.
  // 
  // Params:
  // - on: whether to route Warn+ to stderr
  // 
  // Returns:
  // - the logger by value (chainable)
  pub route_errors(bin on) Logger {
    self.route_err = on;
    ret *self;
  }

  // Toggle whether records are prefixed with a timestamp.
  // 
  // Params:
  // - on: whether to include a timestamp
  // 
  // Returns:
  // - the logger by value (chainable)
  pub with_timestamps(bin on) Logger {
    self.with_timestamp = on;
    ret *self;
  }

  // Open a builder record for `level`/`msg`. Prefer the `*_r` shortcuts.
  // 
  // Params:
  // - level: record severity
  // - msg: record message
  // 
  // Returns:
  // - a `LogRecord` ready for chained field attachment and `emit()`
  pub record(LogLevel level, str msg) LogRecord {
    LogRecord r;
    r.level = level;
    r.msg = msg;
    r.fields.init(4);
    r.min = self.level;
    r.format = self.format;
    r.sink = self.sink;
    r.with_timestamp = self.with_timestamp;
    r.name = self.name;
    r.route_err = self.route_err;
    r.live = level >= self.level;
    ret r;
  }

  // Open a Trace-level builder record for `msg`.
  pub trace_r(str msg) LogRecord {
    ret self.record(.Trace, msg);
  }
  // Open a Debug-level builder record for `msg`.
  pub debug_r(str msg) LogRecord {
    ret self.record(.Debug, msg);
  }
  // Open an Info-level builder record for `msg`.
  pub info_r(str msg) LogRecord {
    ret self.record(.Info, msg);
  }
  // Open a Warn-level builder record for `msg`.
  pub warn_r(str msg) LogRecord {
    ret self.record(.Warn, msg);
  }
  // Open an Error-level builder record for `msg`.
  pub error_r(str msg) LogRecord {
    ret self.record(.Error, msg);
  }
  // Open a Fatal-level builder record for `msg`.
  pub fatal_r(str msg) LogRecord {
    ret self.record(.Fatal, msg);
  }

  // Emit a bare message immediately (no structured fields). Back-compatible.
  // 
  // Params:
  // - level: message severity
  // - msg: message text
  pub log(LogLevel level, str msg) {
    let r = self.record(level, msg);
    r.emit();
  }

  // Log a trace-level message.
  // 
  // Params:
  // - msg: message text
  pub trace(str msg) {
    self.log(.Trace, msg);
  }
  // Log a debug-level message.
  // 
  // Params:
  // - msg: message text
  pub debug(str msg) {
    self.log(.Debug, msg);
  }
  // Log an info-level message.
  // 
  // Params:
  // - msg: message text
  pub info(str msg) {
    self.log(.Info, msg);
  }
  // Log a warning-level message.
  // 
  // Params:
  // - msg: message text
  pub warn(str msg) {
    self.log(.Warn, msg);
  }
  // Log an error-level message.
  // 
  // Params:
  // - msg: message text
  pub error(str msg) {
    self.log(.Error, msg);
  }
  // Log a fatal-level message. The emitter flushes its sink afterward.
  // 
  // Params:
  // - msg: message text
  pub fatal(str msg) {
    self.log(.Fatal, msg);
  }

  // Log a tagged message (back-compatible convenience).
  // 
  // Params:
  // - level: message severity
  // - tag: short tag prefix, attached as a `tag` field
  // - msg: message text
  pub log_tag(LogLevel level, str tag, str msg) {
    if level >= self.level {
      let r = self.record(level, msg);
      r.str_field("tag", tag).emit();
    }
  }

  // Log a single numeric field (back-compatible convenience).
  // 
  // Params:
  // - level: message severity
  // - label: field label
  // - value: numeric value to log
  pub log_num(LogLevel level, str label, num value) {
    if level >= self.level {
      let r = self.record(level, "");
      r.num_field(label, value).emit();
    }
  }

  // Log a single decimal field (back-compatible convenience).
  // 
  // Params:
  // - level: message severity
  // - label: field label
  // - value: decimal value to log
  pub log_dec(LogLevel level, str label, dec value) {
    if level >= self.level {
      let r = self.record(level, "");
      r.dec_field(label, value).emit();
    }
  }

  // Log a single boolean field (back-compatible convenience).
  // 
  // Params:
  // - level: message severity
  // - label: field label
  // - value: boolean value to log
  pub log_bin(LogLevel level, str label, bin value) {
    if level >= self.level {
      let r = self.record(level, "");
      r.bin_field(label, value).emit();
    }
  }
}

// --- One-off free helpers (back-compatible) -------------------------------------------
// These log at their level through a default stdout Text logger with a Trace
// threshold (so every one-off message is emitted).

// Log `msg` at `level` through a default stdout Text logger.
// 
// Params:
// - level: message severity
// - msg: message text
pub fun log(LogLevel level, str msg) {
  let l = logger_init(.Trace);
  l.log(level, msg);
}

// Log a trace-level message through a default stdout Text logger.
// 
// Params:
// - msg: message text
pub fun log_trace(str msg) {
  let l = logger_init(.Trace);
  l.trace(msg);
}

// Log a debug-level message through a default stdout Text logger.
// 
// Params:
// - msg: message text
pub fun log_debug(str msg) {
  let l = logger_init(.Trace);
  l.debug(msg);
}

// Log an info-level message through a default stdout Text logger.
// 
// Params:
// - msg: message text
pub fun log_info(str msg) {
  let l = logger_init(.Trace);
  l.info(msg);
}

// Log a warning-level message through a default stdout Text logger.
// 
// Params:
// - msg: message text
pub fun log_warn(str msg) {
  let l = logger_init(.Trace);
  l.warn(msg);
}

// Log an error-level message through a default stdout Text logger.
// 
// Params:
// - msg: message text
pub fun log_error(str msg) {
  let l = logger_init(.Trace);
  l.error(msg);
}

// Log a fatal-level message through a default stdout Text logger.
// 
// Params:
// - msg: message text
pub fun log_fatal(str msg) {
  let l = logger_init(.Trace);
  l.fatal(msg);
}
