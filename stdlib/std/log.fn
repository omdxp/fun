// Simple logging.
// 
// Usage:
// ```
// Logger l = logger_init(.Info);
// l.info("hello");
// ```

imp std.c.io;

// Log severity levels.
pub enum LogLevel {
  Debug,
  Info,
  Warn,
  Error
}

// Logger with a minimum severity threshold.
pub compound Logger {
  // level: minimum severity to emit
  LogLevel level;
}

// Create a logger with a threshold level.
// 
// Params:
// - level: minimum severity to emit
// 
// Returns:
// - Logger
pub fun logger_init(LogLevel level) Logger {
  Logger l;
  l.level = level;
  ret l;
}

// Convert log level to a label string.
// 
// Params:
// - level: severity
// 
// Returns:
// - label string
pub fun level_name(LogLevel level) str {
  fit level {
    .Debug -> {
      ret "DEBUG";
    }
    .Info -> {
      ret "INFO";
    }
    .Warn -> {
      ret "WARN";
    }
    .Error -> {
      ret "ERROR";
    }
  }
  ret "INFO";
}

fun level_value(LogLevel level) num {
  fit level {
    .Debug -> {
      ret 0;
    }
    .Info -> {
      ret 1;
    }
    .Warn -> {
      ret 2;
    }
    .Error -> {
      ret 3;
    }
  }
  ret 1;
}

impl Logger {
  // Set the minimum severity level.
  pub set_level(LogLevel level) {
    self.level = level;
  }

  // True if a level would be emitted.
  pub enabled(LogLevel level) bin {
    ret level_value(level) >= level_value(self.level);
  }

  // Log if level is >= logger threshold.
  pub log(LogLevel level, str msg) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] %s\n", level_name(level), msg);
    }
  }

  // Convenience: debug-level logging.
  pub debug(str msg) {
    self.log(.Debug, msg);
  }

  // Convenience: info-level logging.
  pub info(str msg) {
    self.log(.Info, msg);
  }

  // Convenience: warn-level logging.
  pub warn(str msg) {
    self.log(.Warn, msg);
  }

  // Convenience: error-level logging.
  pub error(str msg) {
    self.log(.Error, msg);
  }

  // Log a tagged message.
  pub log_tag(LogLevel level, str tag, str msg) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] [%s] %s\n", level_name(level), tag, msg);
    }
  }

  // Log a number value.
  pub log_num(LogLevel level, str label, num value) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] %s=%lld\n", level_name(level), label, value);
    }
  }

  // Log a decimal value.
  pub log_dec(LogLevel level, str label, dec value) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] %s=%f\n", level_name(level), label, value);
    }
  }

  // Log a boolean value.
  pub log_bin(LogLevel level, str label, bin value) {
    if level_value(level) >= level_value(self.level) {
      if value {
        printf("[%s] %s=true\n", level_name(level), label);
      } else {
        printf("[%s] %s=false\n", level_name(level), label);
      }
    }
  }
}

// One-off log with debug threshold.
// 
// Params:
// - level: severity
// - msg: message
pub fun log(LogLevel level, str msg) {
  Logger l = logger_init(.Debug);
  l.log(level, msg);
}

// One-off debug log.
// 
// Params:
// - msg: message
pub fun log_debug(str msg) {
  Logger l = logger_init(.Debug);
  l.debug(msg);
}

// One-off info log.
// 
// Params:
// - msg: message
pub fun log_info(str msg) {
  Logger l = logger_init(.Debug);
  l.info(msg);
}

// One-off warn log.
// 
// Params:
// - msg: message
pub fun log_warn(str msg) {
  Logger l = logger_init(.Debug);
  l.warn(msg);
}

// One-off error log.
// 
// Params:
// - msg: message
pub fun log_error(str msg) {
  Logger l = logger_init(.Debug);
  l.error(msg);
}
