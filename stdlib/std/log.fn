// Simple logging.
// 
// Usage:
// ```
// Logger l = logger_init(.Info);
// l.info("hello");
// ```

imp std.c.io;

// Log severity levels.
pub enum LogLevel {
  // Debug: verbose diagnostic logging
  Debug,
  // Info: general informational messages
  Info,
  // Warn: warning conditions
  Warn,
  // Error: error conditions
  Error
}

// Logger with a minimum severity threshold.
pub compound Logger {
  // Minimum severity to emit.
  LogLevel level;
}

// Create a logger with a threshold level.
// 
// Params:
// - level: minimum severity to emit
// 
// Returns:
// - initialized logger
pub fun logger_init(LogLevel level) Logger {
  Logger l;
  l.level = level;
  ret l;
}

// Convert log level to a label string.
// 
// Params:
// - level: severity
// 
// Returns:
// - label string
pub fun level_name(LogLevel level) str {
  fit level {
    .Debug -> { ret "DEBUG"; }
    .Info -> { ret "INFO"; }
    .Warn -> { ret "WARN"; }
    .Error -> { ret "ERROR"; }
  }
  ret "INFO";
}

fun level_value(LogLevel level) num {
  fit level {
    .Debug -> { ret 0; }
    .Info -> { ret 1; }
    .Warn -> { ret 2; }
    .Error -> { ret 3; }
  }
  ret 1;
}

impl Logger {
  // Set the minimum severity level.
  // 
  // Params:
  // - level: new minimum severity threshold
  pub set_level(LogLevel level) {
    self.level = level;
  }

  // Return true when a level would be emitted.
  // 
  // Params:
  // - level: severity to test
  // 
  // Returns:
  // - true when the logger would emit messages at this level
  pub enabled(LogLevel level) bin {
    ret level_value(level) >= level_value(self.level);
  }

  // Log a message when the level passes the current threshold.
  // 
  // Params:
  // - level: message severity
  // - msg: message text
  pub log(LogLevel level, str msg) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] %s\n", level_name(level), msg);
    }
  }

  // Log a debug-level message.
  // 
  // Params:
  // - msg: message text
  pub debug(str msg) {
    self.log(.Debug, msg);
  }

  // Log an info-level message.
  // 
  // Params:
  // - msg: message text
  pub info(str msg) {
    self.log(.Info, msg);
  }

  // Log a warning-level message.
  // 
  // Params:
  // - msg: message text
  pub warn(str msg) {
    self.log(.Warn, msg);
  }

  // Log an error-level message.
  // 
  // Params:
  // - msg: message text
  pub error(str msg) {
    self.log(.Error, msg);
  }

  // Log a tagged message when the level passes the current threshold.
  // 
  // Params:
  // - level: message severity
  // - tag: short tag prefix
  // - msg: message text
  pub log_tag(LogLevel level, str tag, str msg) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] [%s] %s\n", level_name(level), tag, msg);
    }
  }

  // Log a numeric value when the level passes the current threshold.
  // 
  // Params:
  // - level: message severity
  // - label: field label
  // - value: numeric value to print
  pub log_num(LogLevel level, str label, num value) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] %s=%lld\n", level_name(level), label, value);
    }
  }

  // Log a decimal value when the level passes the current threshold.
  // 
  // Params:
  // - level: message severity
  // - label: field label
  // - value: decimal value to print
  pub log_dec(LogLevel level, str label, dec value) {
    if level_value(level) >= level_value(self.level) {
      printf("[%s] %s=%f\n", level_name(level), label, value);
    }
  }

  // Log a boolean value when the level passes the current threshold.
  // 
  // Params:
  // - level: message severity
  // - label: field label
  // - value: boolean value to print
  pub log_bin(LogLevel level, str label, bin value) {
    let enabled = level_value(level) >= level_value(self.level);
    if enabled && value {
      printf("[%s] %s=true\n", level_name(level), label);
    } elif enabled {
      printf("[%s] %s=false\n", level_name(level), label);
    }
  }
}

// One-off log with debug threshold.
// 
// Params:
// - level: severity
// - msg: message
pub fun log(LogLevel level, str msg) {
  let l = logger_init(.Debug);
  l.log(level, msg);
}

// One-off debug log.
// 
// Params:
// - msg: message
pub fun log_debug(str msg) {
  let l = logger_init(.Debug);
  l.debug(msg);
}

// One-off info log.
// 
// Params:
// - msg: message
pub fun log_info(str msg) {
  let l = logger_init(.Debug);
  l.info(msg);
}

// One-off warn log.
// 
// Params:
// - msg: message
pub fun log_warn(str msg) {
  let l = logger_init(.Debug);
  l.warn(msg);
}

// One-off error log.
// 
// Params:
// - msg: message
pub fun log_error(str msg) {
  let l = logger_init(.Debug);
  l.error(msg);
}
