// Math helpers beyond C bindings.

imp std.c.math as cmath;
imp std.result;
imp std.error;

// The sign of a value, as a type-safe alternative to the -1/0/1 returned by
// `sign()`. Match it with `fit`:
// 
// ```
// fit sign_of(x) {
//   Sign.Negative -> { ... }
//   Sign.Zero -> { ... }
//   Sign.Positive -> { ... }
// }
// ```
pub enum Sign {
  Negative,
  Zero,
  Positive,
}

// 2D vector for simple math utilities.
pub compound Vec2 {
  // X component.
  dec x;
  // Y component.
  dec y;
}

impl Vec2 {
  // Euclidean distance to another vector.
  pub distance(Vec2 other) dec {
    let dx = self.x - other.x;
    let dy = self.y - other.y;
    ret cmath.sqrt(dx * dx + dy * dy);
  }

  // Euclidean length of the vector.
  pub length() dec {
    ret cmath.sqrt(self.x * self.x + self.y * self.y);
  }

  // Dot product with another vector.
  pub dot(Vec2 other) dec {
    ret self.x * other.x + self.y * other.y;
  }

  // Returns a unit-length copy of the vector, or the zero vector when the
  // length is zero.
  pub normalize() Vec2 {
    Vec2 out;
    let len = self.length();
    if len == 0 {
      out.x = 0;
      out.y = 0;
      ret out;
    }
    out.x = self.x / len;
    out.y = self.y / len;
    ret out;
  }
}

// Trigonometry and core math helpers (decimal).

// Sine of an angle in radians.
pub fun sin_dec(dec x) dec {
  ret cmath.sin(x);
}

// Cosine of an angle in radians.
pub fun cos_dec(dec x) dec {
  ret cmath.cos(x);
}

// Tangent of an angle in radians.
pub fun tan_dec(dec x) dec {
  ret cmath.tan(x);
}

// Arcsine of `x`.
pub fun asin_dec(dec x) dec {
  ret cmath.asin(x);
}

// Arccosine of `x`.
pub fun acos_dec(dec x) dec {
  ret cmath.acos(x);
}

// Arctangent of `x`.
pub fun atan_dec(dec x) dec {
  ret cmath.atan(x);
}

// Arctangent of `y / x`, using the sign of both to pick the right quadrant.
pub fun atan2_dec(dec y, dec x) dec {
  ret cmath.atan2(y, x);
}

// Square root of `x`.
pub fun sqrt_dec(dec x) dec {
  ret cmath.sqrt(x);
}

// Cube root of `x`.
pub fun cbrt_dec(dec x) dec {
  ret cmath.cbrt(x);
}

// Raise `x` to the power `y`.
pub fun pow_dec(dec x, dec y) dec {
  ret cmath.pow(x, y);
}

// `e` raised to `x`.
pub fun exp_dec(dec x) dec {
  ret cmath.exp(x);
}

// Natural logarithm of `x`.
pub fun log_dec(dec x) dec {
  ret cmath.log(x);
}

// Base-10 logarithm of `x`.
pub fun log10_dec(dec x) dec {
  ret cmath.log10(x);
}

// Base-2 logarithm of `x`.
pub fun log2_dec(dec x) dec {
  ret cmath.log2(x);
}

// Round `x` down to the nearest integer value.
pub fun floor_dec(dec x) dec {
  ret cmath.floor(x);
}

// Round `x` up to the nearest integer value.
pub fun ceil_dec(dec x) dec {
  ret cmath.ceil(x);
}

// Round `x` to the nearest integer value.
pub fun round_dec(dec x) dec {
  ret cmath.round(x);
}

// Truncate `x` toward zero.
pub fun trunc_dec(dec x) dec {
  ret cmath.trunc(x);
}

// The whole part of `value`, with anything after the point dropped. A
// decimal does not narrow into a whole number on its own, so this is
// how one is asked for.
pub fun dec_to_num(dec value) num {
  ret cmath.llround(cmath.trunc(value));
}

// `value` rounded to the nearest whole number, halves away from zero.
pub fun dec_round_to_num(dec value) num {
  ret cmath.llround(value);
}

// Floating-point remainder of `x / y`.
pub fun fmod_dec(dec x, dec y) dec {
  ret cmath.fmod(x, y);
}

// Hypotenuse length of a right triangle with legs `x` and `y`.
pub fun hypot_dec(dec x, dec y) dec {
  ret cmath.hypot(x, y);
}

// Value with the magnitude of `x` and the sign of `y`.
pub fun copysign_dec(dec x, dec y) dec {
  ret cmath.copysign(x, y);
}

// Absolute value of a number or decimal.
pub fun abs<T: num | dec>(T x) T {
  if x < 0 {
    ret -x;
  }
  ret x;
}

// Sign of a number or decimal as `-1`, `0`, or `1`.
pub fun sign<T: num | dec>(T x) T {
  if x < 0 {
    ret -1;
  }
  if x > 0 {
    ret 1;
  }
  ret 0;
}

// Sign of a number or decimal as a type-safe `Sign`. Prefer this over
// `sign()` when you want to `fit`-match the cases.
pub fun sign_of<T: num | dec>(T x) Sign {
  if x < 0 {
    ret Sign.Negative;
  }
  if x > 0 {
    ret Sign.Positive;
  }
  ret Sign.Zero;
}

// Smaller of two numbers. Kept as a separate `_num`/`_dec` overload rather
// than a generic `min<T>` because `Vec<T: num | dec>` already has an
// instance method named `min()`, and a same-named free function would
// collide with it when both `std.vec` and `std.math` are imported together.
pub fun min_num(num a, num b) num {
  if a < b {
    ret a;
  }
  ret b;
}

// Larger of two numbers.
pub fun max_num(num a, num b) num {
  if a > b {
    ret a;
  }
  ret b;
}

// Smaller of two decimals.
pub fun min_dec(dec a, dec b) dec {
  if a < b {
    ret a;
  }
  ret b;
}

// Larger of two decimals.
pub fun max_dec(dec a, dec b) dec {
  if a > b {
    ret a;
  }
  ret b;
}

// Clamp a number or decimal to `[lo, hi]`.
pub fun clamp<T: num | dec>(T x, T lo, T hi) T {
  if x < lo {
    ret lo;
  }
  if x > hi {
    ret hi;
  }
  ret x;
}

// Linearly interpolate between `a` and `b` by factor `t`.
pub fun lerp_dec(dec a, dec b, dec t) dec {
  ret a + (b - a) * t;
}

// Convert degrees to radians.
pub fun deg_to_rad(dec degrees) dec {
  ret degrees * (3.141592653589793 / 180);
}

// Convert radians to degrees.
pub fun rad_to_deg(dec radians) dec {
  ret radians * (180 / 3.141592653589793);
}

// Raise an integer base to a non-negative integer exponent. A negative
// exponent yields 1, since integer powers can't represent fractions; use
// `try_pow_int` to reject negative exponents.
pub fun pow_int(num base, num exp) num {
  num result = 1;
  num i = 0;
  for i < exp {
    result = result * base;
    i = i + 1;
  }
  ret result;
}

// Raise an integer base to an exponent, returning `Err` when `exp` is
// negative instead of the `pow_int` fallback of 1.
pub fun try_pow_int(num base, num exp) Result<num, Error> {
  if exp < 0 {
    ret err_kind(.Invalid, "pow_int: negative exponent", 1);
  }
  ret .Ok(pow_int(base, exp));
}

// Distance between two vectors.
pub fun distance(Vec2 a, Vec2 b) dec {
  ret a.distance(b);
}

// Length of a vector.
pub fun length(Vec2 v) dec {
  ret v.length();
}

// Dot product of two vectors.
pub fun dot(Vec2 a, Vec2 b) dec {
  ret a.dot(b);
}
