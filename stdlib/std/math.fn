// Math helpers beyond C bindings.

use std.c.math as cmath;
use std.result;
use std.error;

// The sign of a value, as a type-safe alternative to the -1/0/1 returned by
// `sign()`. Match it with `fit`:
//
// ```
// fit sign_of(x) {
//   Sign.Negative -> { ... }
//   Sign.Zero -> { ... }
//   Sign.Positive -> { ... }
// }
// ```
pub enum Sign {
  Negative,
  Zero,
  Positive,
}

// 2D vector for simple math utilities.
pub compound Vec2 {
  // X component.
  dec x;
  // Y component.
  dec y;
}

impl Vec2 {
  // Euclidean distance to another vector.
  pub distance(Vec2 other) dec {
    let dx = self.x - other.x;
    let dy = self.y - other.y;
    ret cmath.sqrt(dx * dx + dy * dy);
  }

  // Euclidean length of the vector.
  pub length() dec {
    ret cmath.sqrt(self.x * self.x + self.y * self.y);
  }

  // Dot product with another vector.
  pub dot(Vec2 other) dec {
    ret self.x * other.x + self.y * other.y;
  }

  // Returns a unit-length copy of the vector, or the zero vector when the
  // length is zero.
  pub normalize() Vec2 {
    Vec2 out;
    let len = self.length();
    if len == 0 {
      out.x = 0;
      out.y = 0;
      ret out;
    }
    out.x = self.x / len;
    out.y = self.y / len;
    ret out;
  }
}

// Trigonometry and core math helpers (decimal).

// Sine of an angle in radians.
pub fun sin_dec(dec x) dec {
  ret cmath.sin(x);
}

// Cosine of an angle in radians.
pub fun cos_dec(dec x) dec {
  ret cmath.cos(x);
}

// Tangent of an angle in radians.
pub fun tan_dec(dec x) dec {
  ret cmath.tan(x);
}

// Arcsine of `x`.
pub fun asin_dec(dec x) dec {
  ret cmath.asin(x);
}

// Arccosine of `x`.
pub fun acos_dec(dec x) dec {
  ret cmath.acos(x);
}

// Arctangent of `x`.
pub fun atan_dec(dec x) dec {
  ret cmath.atan(x);
}

// Arctangent of `y / x`, using the sign of both to pick the right quadrant.
pub fun atan2_dec(dec y, dec x) dec {
  ret cmath.atan2(y, x);
}

// Square root of `x`.
pub fun sqrt_dec(dec x) dec {
  ret cmath.sqrt(x);
}

// Cube root of `x`.
pub fun cbrt_dec(dec x) dec {
  ret cmath.cbrt(x);
}

// Raise `x` to the power `y`.
pub fun pow_dec(dec x, dec y) dec {
  ret cmath.pow(x, y);
}

// `e` raised to `x`.
pub fun exp_dec(dec x) dec {
  ret cmath.exp(x);
}

// Natural logarithm of `x`.
pub fun log_dec(dec x) dec {
  ret cmath.log(x);
}

// Base-10 logarithm of `x`.
pub fun log10_dec(dec x) dec {
  ret cmath.log10(x);
}

// Base-2 logarithm of `x`.
pub fun log2_dec(dec x) dec {
  ret cmath.log2(x);
}

// Round `x` down to the nearest integer value.
pub fun floor_dec(dec x) dec {
  ret cmath.floor(x);
}

// Round `x` up to the nearest integer value.
pub fun ceil_dec(dec x) dec {
  ret cmath.ceil(x);
}

// Round `x` to the nearest integer value.
pub fun round_dec(dec x) dec {
  ret cmath.round(x);
}

// Truncate `x` toward zero.
pub fun trunc_dec(dec x) dec {
  ret cmath.trunc(x);
}

// The whole part of `value`, with anything after the point dropped. A
// decimal does not narrow into a whole number on its own, so this is
// how one is asked for.
pub fun dec_to_num(dec value) num {
  ret cmath.llround(cmath.trunc(value));
}

// `value` rounded to the nearest whole number, halves away from zero.
pub fun dec_round_to_num(dec value) num {
  ret cmath.llround(value);
}

// Floating-point remainder of `x / y`.
pub fun fmod_dec(dec x, dec y) dec {
  ret cmath.fmod(x, y);
}

// Hypotenuse length of a right triangle with legs `x` and `y`.
pub fun hypot_dec(dec x, dec y) dec {
  ret cmath.hypot(x, y);
}

// Value with the magnitude of `x` and the sign of `y`.
pub fun copysign_dec(dec x, dec y) dec {
  ret cmath.copysign(x, y);
}

// Absolute value of a number or decimal.
pub fun abs<T: num | dec>(T x) T {
  if x < 0 {
    ret -x;
  }
  ret x;
}

// Sign of a number or decimal as `-1`, `0`, or `1`.
pub fun sign<T: num | dec>(T x) T {
  if x < 0 {
    ret -1;
  }
  if x > 0 {
    ret 1;
  }
  ret 0;
}

// Sign of a number or decimal as a type-safe `Sign`. Prefer this over
// `sign()` when you want to `fit`-match the cases.
pub fun sign_of<T: num | dec>(T x) Sign {
  if x < 0 {
    ret Sign.Negative;
  }
  if x > 0 {
    ret Sign.Positive;
  }
  ret Sign.Zero;
}

// Smaller of two numbers. Kept as a separate `_num`/`_dec` overload rather
// than a generic `min<T>` because `Vec<T: num | dec>` already has an
// instance method named `min()`, and a same-named free function would
// collide with it when both `std.vec` and `std.math` are imported together.
pub fun min_num(num a, num b) num {
  if a < b {
    ret a;
  }
  ret b;
}

// Larger of two numbers.
pub fun max_num(num a, num b) num {
  if a > b {
    ret a;
  }
  ret b;
}

// Smaller of two decimals.
pub fun min_dec(dec a, dec b) dec {
  if a < b {
    ret a;
  }
  ret b;
}

// Larger of two decimals.
pub fun max_dec(dec a, dec b) dec {
  if a > b {
    ret a;
  }
  ret b;
}

// Clamp a number or decimal to `[lo, hi]`.
pub fun clamp<T: num | dec>(T x, T lo, T hi) T {
  if x < lo {
    ret lo;
  }
  if x > hi {
    ret hi;
  }
  ret x;
}

// Linearly interpolate between `a` and `b` by factor `t`.
pub fun lerp_dec(dec a, dec b, dec t) dec {
  ret a + (b - a) * t;
}

// Convert degrees to radians.
pub fun deg_to_rad(dec degrees) dec {
  ret degrees * (3.141592653589793 / 180);
}

// Convert radians to degrees.
pub fun rad_to_deg(dec radians) dec {
  ret radians * (180 / 3.141592653589793);
}

// Raise an integer base to a non-negative integer exponent. A negative
// exponent yields 1, since integer powers can't represent fractions; use
// `try_pow_int` to reject negative exponents.
pub fun pow_int(num base, num exp) num {
  num result = 1;
  num i = 0;
  for i < exp {
    result = result * base;
    i = i + 1;
  }
  ret result;
}

// Raise an integer base to an exponent, returning `Err` when `exp` is
// negative instead of the `pow_int` fallback of 1.
pub fun try_pow_int(num base, num exp) Result<num, Error> {
  if exp < 0 {
    ret err_kind(.Invalid, "pow_int: negative exponent", 1);
  }
  ret .Ok(pow_int(base, exp));
}

// Distance between two vectors.
pub fun distance(Vec2 a, Vec2 b) dec {
  ret a.distance(b);
}

// Length of a vector.
pub fun length(Vec2 v) dec {
  ret v.length();
}

// Dot product of two vectors.
pub fun dot(Vec2 a, Vec2 b) dec {
  ret a.dot(b);
}

// True when `a` and `b` agree to 1e-9, for comparing computed decimals.
fun _near(dec a, dec b) flag {
  dec d = a - b;
  if d < 0.0 {
    d = -d;
  }
  ret d < 0.000000001;
}

test "trigonometry and its inverses" {
  assert _near(sin_dec(0.0), 0.0) && _near(cos_dec(0.0), 1.0) &&
    _near(tan_dec(0.0), 0.0), "expected the values at zero";
  assert _near(asin_dec(1.0), 1.5707963267948966), "expected asin(1) to be a right angle";
  assert _near(acos_dec(1.0), 0.0) && _near(atan_dec(0.0), 0.0), "expected acos(1) and atan(0) to be zero";
  assert _near(atan2_dec(1.0, 1.0), 0.7853981633974483), "expected atan2(1, 1) to be an eighth turn";
}

test "roots, powers and logarithms" {
  assert _near(sqrt_dec(9.0), 3.0) && _near(cbrt_dec(27.0), 3.0), "expected the square and cube roots";
  assert _near(pow_dec(2.0, 10.0), 1024.0), "expected 2^10";
  assert _near(exp_dec(0.0), 1.0) && _near(log_dec(1.0), 0.0), "expected exp(0) and log(1)";
  assert _near(log10_dec(1000.0), 3.0) && _near(log2_dec(8.0), 3.0), "expected the base-10 and base-2 logarithms";
  assert _near(hypot_dec(3.0, 4.0), 5.0), "expected the 3-4-5 triangle";
}

test "rounding and conversion between decimals and numbers" {
  assert floor_dec(2.7) == 2.0 && ceil_dec(2.1) == 3.0, "expected floor and ceil";
  assert round_dec(2.5) == 3.0 && trunc_dec(-2.7) == -2.0, "expected round half away from zero and truncation toward zero";
  assert dec_to_num(3.9) == 3 && dec_to_num(-3.9) == -3, "expected truncation to a whole number";
  assert dec_round_to_num(3.5) == 4 && dec_round_to_num(3.4) == 3, "expected rounding to a whole number";
  assert _near(fmod_dec(7.5, 2.0), 1.5), "expected the remainder";
  assert copysign_dec(3.0, -1.0) == -3.0 && copysign_dec(-3.0, 1.0) == 3.0, "expected the sign to be borrowed";
}

test "abs, sign, min, max and clamp" {
  assert abs(-4) == 4 && abs(4) == 4 && abs(-2.5) == 2.5, "expected the magnitude of a number and a decimal";
  assert sign(-9) == -1 && sign(0) == 0 && sign(9) == 1, "expected -1, 0 or 1";
  assert sign_of(-1) == Sign.Negative && sign_of(0) == Sign.Zero &&
    sign_of(1.5) == Sign.Positive, "expected the typed sign";
  assert min_num(2, 5) == 2 && min_num(5, 2) == 2 && max_num(2, 5) == 5 && max_num(5, 2) == 5, "expected the smaller and larger number";
  assert min_dec(0.5, 1.5) == 0.5 && min_dec(1.5, 0.5) == 0.5 &&
    max_dec(0.5, 1.5) == 1.5 && max_dec(1.5, 0.5) == 1.5, "expected the smaller and larger decimal";
  assert clamp(15, 0, 10) == 10 && clamp(-5, 0, 10) == 0 && clamp(5, 0, 10) == 5, "expected a value held inside its range";
}

test "interpolation and angle conversion" {
  assert _near(lerp_dec(10.0, 20.0, 0.25), 12.5), "expected a quarter of the way";
  assert _near(deg_to_rad(180.0), 3.141592653589793), "expected 180 degrees to be pi";
  assert _near(rad_to_deg(3.141592653589793), 180.0), "expected pi to be 180 degrees";
}

test "integer powers, and the checked form rejects a negative exponent" {
  assert pow_int(3, 4) == 81 && pow_int(5, 0) == 1 && pow_int(2, -1) == 1, "expected integer powers with the documented fallback";
  assert try_pow_int(2, 8).is_ok() && try_pow_int(2, 8).unwrap() == 256, "expected 2^8";
  assert try_pow_int(2, -1).is_err(), "expected a negative exponent to be an error";
}

test "vectors: length, distance, dot product and normalization" {
  Vec2 a;
  a.x = 3.0;
  a.y = 4.0;
  Vec2 b;
  b.x = 0.0;
  b.y = 0.0;
  assert _near(a.length(), 5.0) && _near(length(a), 5.0), "expected the length";
  assert _near(a.distance(b), 5.0) && _near(distance(a, b), 5.0), "expected the distance";
  assert _near(a.dot(a), 25.0) && _near(dot(a, b), 0.0), "expected the dot product";
  Vec2 unit = a.normalize();
  assert _near(unit.x, 0.6) && _near(unit.y, 0.8), "expected a unit vector";
  Vec2 zero = b.normalize();
  assert zero.x == 0.0 && zero.y == 0.0, "expected the zero vector to stay zero";
}
