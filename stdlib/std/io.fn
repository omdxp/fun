// File and buffer IO utilities.

use std.c.io;
use std.c.mem;
use std.string;
use std.vec;
use std.result;
use std.error;

// Print a string to stdout (no newline).
pub fun print(str s) {
  printf("%s", s);
}

// Print a string to stdout with newline.
pub fun println(str s) {
  puts(s);
}

// Print a number to stdout (no newline).
pub fun print_num(num n) {
  str s = format_num(n);
  printf("%s", s);
  free(s);
}

// Print a decimal to stdout (no newline).
pub fun print_dec(dec d) {
  printf("%f", d);
}

// Print a boolean to stdout (no newline).
pub fun print_flag(flag b) {
  if b {
    printf("true");
  } else {
    printf("false");
  }
}

// Duplicate a string into a new buffer.
fun _dup_str(str s) str {
  let n = len(s);
  str out = malloc(n + 1);
  if out == nil {
    ret nil;
  }
  num i = 0;
  for i < n {
    out[i] = s[i];
    i = i + 1;
  }
  out[n] = '\0';
  ret out;
}

// Format a number into a new string buffer.
pub fun fmt_num(num n) str {
  ret format_num(n);
}

// Format a decimal into a new string buffer.
pub fun fmt_dec(dec d) str {
  str buf = malloc(64);
  if buf == nil {
    ret nil;
  }
  snprintf(buf, 64, "%g", d);
  ret buf;
}

// Format a boolean into a new string buffer.
pub fun fmt_flag(flag b) str {
  if b {
    ret _dup_str("true");
  }
  ret _dup_str("false");
}

// Bootstrap-compatibility alias: a released `fun` binary built before
// the `bin` keyword's removal has its own vararg format dispatch
// hardcoded to call `fmt_bin` by name, baked into that binary's own
// compiled codegen. Building this repo's compiler from source with
// such a binary (the first stage of the 3-stage bootstrap every CI
// build and release does) needs this symbol to exist until the
// bootstrap baseline moves past that release; safe to remove once it
// does.
pub fun fmt_bin(flag b) str {
  ret fmt_flag(b);
}

// Format a character into a new string buffer.
pub fun fmt_chr(chr c) str {
  str buf = malloc(2);
  if buf == nil {
    ret nil;
  }
  buf[0] = c;
  buf[1] = '\0';
  ret buf;
}

// Format a string into a new string buffer.
pub fun fmt_str(str s) str {
  ret _dup_str(s);
}

// Format a raw pointer into a new string buffer.
pub fun fmt_raw(raw* p) str {
  str buf = malloc(32);
  if buf == nil {
    ret nil;
  }
  snprintf(buf, 32, "%p", p);
  ret buf;
}

// Formats `fmt` using a pre-built Vec<str> of arguments; used by format() and its variants.
pub fun format_impl(str fmt, Vec<str>* args) str {
  let b = string_builder_init(8);
  num i = 0;
  let n = len(fmt);
  num arg_i = 0;
  let argc = args.len;

  for i < n {
    let c = fmt[i];

    if c == '{' {
      if i + 1 < n && fmt[i + 1] == '{' {
        b.append_char('{');
        i = i + 2;
        continue;
      }
      if i + 1 < n && fmt[i + 1] == '}' {
        if arg_i < argc {
          b.append(args.get(arg_i));
          arg_i = arg_i + 1;
        } else {
          b.append("{}");
        }
        i = i + 2;
        continue;
      }
      // `{word}` is a typed placeholder only when `word` names a
      // recognized type (str/num/dec/flag/chr/ptr/raw); any other
      // `{word}` is literal text. The word's own length varies (`flag`
      // is 4 characters, every other one is 3), so the closing `}` is
      // found by scanning forward within a short bound rather than
      // assumed at a fixed offset.
      num close = -1;
      num max_word_len = 5;
      num limit = i + 1 + max_word_len;
      if limit > n {
        limit = n;
      }
      num j = i + 1;
      for j < limit {
        if fmt[j] == '}' {
          close = j;
          break;
        }
        j = j + 1;
      }
      if close > 0 {
        str word = substr(fmt, i + 1, close - i - 1);
        flag is_typed = equals(word, "str") || equals(word, "num") || equals(word, "dec") ||
          equals(word, "flag") || equals(word, "chr") || equals(word, "ptr") ||
          equals(word, "raw");
        free(word);
        if is_typed {
          if arg_i < argc {
            b.append(args.get(arg_i));
            arg_i = arg_i + 1;
          } else {
            b.append("{}");
          }
          i = close + 1;
          continue;
        }
      }
    }

    b.append_char(c);
    i = i + 1;
  }

  let out = b.build();
  b.free();
  ret out;
}
// Format a string using "{}" placeholders: {} or {str} for a string, {num},
// {dec}, {flag}, {chr}, {ptr} for other types. A `{` that starts none of
// those is written as it stands; write "{{" where one would otherwise be
// read as a placeholder. A `}` is always written as it stands, so text
// made of braces, such as JSON, survives being formatted.
pub fun format(str fmt, ...) str {
  ret format_impl(fmt, &vargs);
}

// Print a formatted string to stdout (no newline).
// See format() for placeholder types.
pub fun print_fmt(str fmt, ...) {
  let out = format_impl(fmt, &vargs);
  if out != nil {
    print(out);
    free(out);
  }
}

// Print a formatted string to stdout with newline.
// See format() for placeholder types.
pub fun println_fmt(str fmt, ...) {
  let out = format_impl(fmt, &vargs);
  if out != nil {
    println(out);
    free(out);
  }
}

// File handle wrapper.
pub compound File {
  // C FILE pointer (null if unopened)
  FILE* handle;
}

// Opens a file for reading (binary); returned File has a null handle on failure.
pub fun open_read(str path) File {
  File f;
  f.handle = fopen(path, "rb");
  ret f;
}

// Open file for reading (binary) with Result.
pub fun try_open_read(str path) Result<File, Error> {
  let f = open_read(path);
  if f.handle == nil {
    ret err_kind(.Io, "open_read failed", f);
  }
  ret .Ok(f);
}

// Opens a file for writing (binary); returned File has a null handle on failure.
pub fun open_write(str path) File {
  File f;
  f.handle = fopen(path, "wb");
  ret f;
}

// Open file for writing (binary) with Result.
pub fun try_open_write(str path) Result<File, Error> {
  let f = open_write(path);
  if f.handle == nil {
    ret err_kind(.Io, "open_write failed", f);
  }
  ret .Ok(f);
}

// Opens a file for appending (binary); returned File has a null handle on failure.
pub fun open_append(str path) File {
  File f;
  f.handle = fopen(path, "ab");
  ret f;
}

// Open file for appending (binary) with Result.
pub fun try_open_append(str path) Result<File, Error> {
  let f = open_append(path);
  if f.handle == nil {
    ret err_kind(.Io, "open_append failed", f);
  }
  ret .Ok(f);
}

impl File {
  // Close the file handle.
  pub close() {
    if self.handle != nil {
      fclose(self.handle);
      self.handle = nil;
    }
  }

  // Read entire file into a new string.
  pub read_all() str {
    if self.handle == nil {
      ret nil;
    }

    fseek(self.handle, 0, 2);
    let size = ftell(self.handle);
    fseek(self.handle, 0, 0);

    if size < 0 {
      ret nil;
    }

    str buf = malloc(size + 1);
    if buf == nil {
      ret nil;
    }

    let read = fread(buf, 1, size, self.handle);
    buf[read] = '\0';
    ret buf;
  }

  // Read entire file into a new string with Result.
  pub try_read_all() Result<str, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "read_all on closed file", "");
    }
    let out = self.read_all();
    if out == nil {
      ret err_kind(.Io, "read_all failed", "");
    }
    ret .Ok(out);
  }

  // Read up to max_len bytes (binary-safe). Returns allocated buffer (NUL-terminated).
  pub read_bytes(num max_len) str {
    if self.handle == nil || max_len <= 0 {
      ret nil;
    }
    str buf = malloc(max_len + 1);
    if buf == nil {
      ret nil;
    }
    let read = fread(buf, 1, max_len, self.handle);
    buf[read] = '\0';
    ret buf;
  }

  // Read up to max_len bytes with Result.
  pub try_read_bytes(num max_len) Result<str, Error> {
    if self.handle == nil || max_len <= 0 {
      ret err_kind(.Invalid, "read_bytes invalid", "");
    }
    let out = self.read_bytes(max_len);
    if out == nil {
      ret err_kind(.Io, "read_bytes failed", "");
    }
    ret .Ok(out);
  }

  // Read a line up to max_len (including newline if present).
  pub read_line_max(num max_len) str {
    if self.handle == nil || max_len <= 1 {
      ret nil;
    }
    str buf = malloc(max_len);
    if buf == nil {
      ret nil;
    }
    str res = fgets(buf, max_len, self.handle);
    if res == nil {
      free(buf);
      ret nil;
    }
    ret buf;
  }

  // Read a line up to max_len with Result.
  pub try_read_line_max(num max_len) Result<str, Error> {
    if self.handle == nil || max_len <= 1 {
      ret err_kind(.Invalid, "read_line_max invalid", "");
    }
    let out = self.read_line_max(max_len);
    if out == nil {
      ret err_kind(.Io, "read_line_max failed", "");
    }
    ret .Ok(out);
  }

  // Read all lines (up to max_len per line).
  pub read_lines(num max_len) Vec<str> {
    Vec<str> out;
    out.len = 0;
    out.cap = 0;
    if self.handle == nil {
      ret out;
    }
    for true {
      let line = self.read_line_max(max_len);
      if line == nil {
        break;
      }
      out.push(line);
    }
    ret out;
  }

  // Read all lines (up to max_len per line) with Result.
  pub try_read_lines(num max_len) Result<Vec<str>, Error> {
    if self.handle == nil {
      Vec<str> empty;
      empty.len = 0;
      empty.cap = 0;
      ret err_kind(.Invalid, "read_lines on closed file", empty);
    }
    let out = self.read_lines(max_len);
    ret .Ok(out);
  }

  // Write raw bytes to the file.
  pub write_bytes(raw* data, num len) flag {
    if self.handle == nil || data == nil {
      ret false;
    }
    let wrote = fwrite(data, 1, len, self.handle);
    ret wrote == len;
  }

  // Write raw bytes to the file with Result.
  pub try_write_bytes(raw* data, num len) Result<flag, Error> {
    if self.handle == nil || data == nil {
      ret err_kind(.Invalid, "write_bytes invalid", false);
    }
    let ok_write = self.write_bytes(data, len);
    if ok_write == false {
      ret err_kind(.Io, "write_bytes failed", false);
    }
    ret .Ok(true);
  }

  // Read raw bytes into a buffer; returns bytes read.
  pub read_into(raw* dst, num len) num {
    if self.handle == nil || dst == nil {
      ret 0;
    }
    ret fread(dst, 1, len, self.handle);
  }

  // Read raw bytes into a buffer with Result.
  pub try_read_into(raw* dst, num len) Result<num, Error> {
    if self.handle == nil || dst == nil {
      ret err_kind(.Invalid, "read_into invalid", 0);
    }
    let n = self.read_into(dst, len);
    ret .Ok(n);
  }

  // Seek within the file (whence: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END).
  pub seek(num offset, num whence) flag {
    if self.handle == nil {
      ret false;
    }
    ret fseek(self.handle, offset, whence) == 0;
  }

  // Seek within the file with Result.
  pub try_seek(num offset, num whence) Result<flag, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "seek on closed file", false);
    }
    let ok_seek = self.seek(offset, whence);
    if ok_seek == false {
      ret err_kind(.Io, "seek failed", false);
    }
    ret .Ok(true);
  }

  // Tell current file position.
  pub tell() num {
    if self.handle == nil {
      ret -1;
    }
    ret ftell(self.handle);
  }

  // Tell current file position with Result.
  pub try_tell() Result<num, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "tell on closed file", -1);
    }
    let pos = self.tell();
    if pos < 0 {
      ret err_kind(.Io, "tell failed", -1);
    }
    ret .Ok(pos);
  }

  // Rewind to start of file.
  pub rewind() {
    if self.handle == nil {
      ret;
    }
    rewind(self.handle);
  }

  // Flush buffered output.
  pub flush() flag {
    if self.handle == nil {
      ret false;
    }
    ret fflush(self.handle) == 0;
  }

  // Flush buffered output with Result.
  pub try_flush() Result<flag, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "flush on closed file", false);
    }
    let ok_flush = self.flush();
    if ok_flush == false {
      ret err_kind(.Io, "flush failed", false);
    }
    ret .Ok(true);
  }

  // Get file size (best-effort; returns -1 on failure).
  pub size() num {
    if self.handle == nil {
      ret -1;
    }
    let cur = ftell(self.handle);
    if cur < 0 {
      ret -1;
    }
    if fseek(self.handle, 0, 2) != 0 {
      ret -1;
    }
    let end = ftell(self.handle);
    fseek(self.handle, cur, 0);
    ret end;
  }

  // Write a string to the file.
  pub write(str data) flag {
    if self.handle == nil {
      ret false;
    }
    let n = len(data);
    let wrote = fwrite(data, 1, n, self.handle);
    ret wrote == n;
  }

  // Write a string to the file with Result.
  pub try_write(str data) Result<flag, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "write on closed file", false);
    }
    let ok_write = self.write(data);
    if ok_write == false {
      ret err_kind(.Io, "write failed", false);
    }
    ret .Ok(true);
  }
}

// --- Sinks: a unified write destination -----------------------------------------------

// A `Sink` names a write destination: a standard stream, an open `File`, or
// a rotating file sink. Dispatch is a `fit` match over the enum, so it stays
// zero-cost with no vtable.
pub enum Sink {
  Stdout,
  Stderr,
  Stdin,
  File(File),
  Rotating(RotatingSink*),
}

impl Sink {
  // Resolve the underlying C stream handle for this sink.
  handle() FILE* {
    fit *self {
      .Stdout -> { ret stdout_stream(); }
      .Stderr -> { ret stderr_stream(); }
      .Stdin -> { ret stdin_stream(); }
      .File(f) -> { ret f.handle; }
      .Rotating(r) -> { ret r.current.handle; }
    }
    ret nil;
  }

  // Write a string to the sink. Returns true on success.
  pub write(str s) flag {
    // Rotating sinks own their size-cap/rollover logic, so route through
    // RotatingSink.write() instead of the plain handle()+fputs path below.
    fit *self {
      .Rotating(r) -> { ret r.write(s); }
      _ -> {}
    }
    let h = self.handle();
    if h == nil {
      ret false;
    }
    let rc = fputs(s, h);
    ret rc >= 0;
  }

  // Write a string to the sink with a Result.
  pub try_write(str s) Result<flag, Error> {
    fit *self {
      .Rotating(r) -> {
        if r.write(s) {
          ret .Ok(true);
        }
        ret err_kind(.Io, "sink write failed", false);
      }
      _ -> {}
    }
    let h = self.handle();
    if h == nil {
      ret err_kind(.Invalid, "write to unavailable sink", false);
    }
    let rc = fputs(s, h);
    if rc < 0 {
      ret err_kind(.Io, "sink write failed", false);
    }
    ret .Ok(true);
  }

  // Reads one line, up to `max_len` bytes including the terminator, or
  // nil at the end of the stream. A sink names a stream, which is read
  // from as readily as it is written to.
  pub read_line_max(num max_len) str {
    let h = self.handle();
    if h == nil || max_len <= 0 {
      ret nil;
    }
    str buf = malloc(max_len + 1);
    if buf == nil {
      ret nil;
    }
    str res = fgets(buf, max_len, h);
    if res == nil {
      free(buf);
      ret nil;
    }
    ret buf;
  }

  // Reads exactly `length` bytes, or nil when the stream ends first.
  // Used where a protocol says how many bytes follow.
  pub read_bytes(num length) str {
    let h = self.handle();
    if h == nil || length < 0 {
      ret nil;
    }
    str buf = malloc(length + 1);
    if buf == nil {
      ret nil;
    }
    let read = fread(buf, 1, length, h);
    if read < length {
      free(buf);
      ret nil;
    }
    buf[read] = '\0';
    ret buf;
  }

  // Flush any buffered bytes to the underlying stream.
  pub flush() flag {
    fit *self {
      .Rotating(r) -> { ret r.flush(); }
      _ -> {}
    }
    let h = self.handle();
    if h == nil {
      ret false;
    }
    ret fflush(h) == 0;
  }

  // Flush any buffered bytes to the underlying stream, with a Result.
  pub try_flush() Result<flag, Error> {
    if self.flush() {
      ret .Ok(true);
    }
    ret err_kind(.Io, "sink flush failed", false);
  }
}

// Write `msg` to a sink (no trailing newline).
pub fun write_to(Sink s, str msg) {
  _ = s.write(msg);
}

// Write `msg` followed by a newline to a sink.
pub fun writeln_to(Sink s, str msg) {
  _ = s.write(msg);
  _ = s.write("\n");
}

// --- Rotating file sink ----------------------------------------------------------------

// A file destination that caps each file at `max_bytes` and keeps up to
// `max_files` rolled-over generations (`path`, `path.1`, ... `path.{max_files-1}`).
// When a write would exceed the cap, the current file is closed, existing
// generations are shifted up (dropping the oldest), and a fresh `path` is opened.
// Intended for a single writer; guard with a Mutex for concurrent use.
pub compound RotatingSink {
  str path;
  num max_bytes;
  num max_files;
  File current;
  num written;
}

// Open a rotating sink at `path` (truncates/creates the active file).
pub fun rotating_sink_new(str path, num max_bytes, num max_files) RotatingSink {
  RotatingSink r;
  r.path = path;
  r.max_bytes = max_bytes;
  r.max_files = max_files;
  r.current = open_write(path);
  r.written = 0;
  ret r;
}

impl RotatingSink {
  // Roll the current file over: close it, shift `path.N -> path.N+1` (dropping the
  // oldest beyond max_files), then reopen a fresh active `path`.
  rotate() {
    self.current.close();
    // Shift older generations up, oldest first, so nothing is overwritten.
    num i = self.max_files - 1;
    for i > 0 {
      let src = self.numbered_path(i - 1);
      let dst = self.numbered_path(i);
      _ = rename(src, dst);
      i = i - 1;
    }
    self.current = open_write(self.path);
    self.written = 0;
  }

  // Build the on-disk name for generation `n` (0 = the active `path`).
  numbered_path(num n) str {
    if n == 0 {
      ret self.path;
    }
    ret format("{}.{}", self.path, n);
  }

  // Write `s`, rotating first if it would exceed the size cap.
  pub write(str s) flag {
    let n = len(s);
    if self.written + n > self.max_bytes && self.written > 0 {
      self.rotate();
    }
    let ok_w = self.current.write(s);
    if ok_w {
      self.written = self.written + n;
    }
    ret ok_w;
  }

  pub flush() flag {
    ret self.current.flush();
  }

  pub close() {
    self.current.close();
  }
}

// Reads a file into a new string, or null on failure.
pub fun read_all(str path) str {
  let f = open_read(path);
  if f.handle == nil {
    ret nil;
  }
  defer f.close();
  let out = f.read_all();
  ret out;
}

// Writes `data` to a file, returning true on success.
pub fun write_all(str path, str data) flag {
  let f = open_write(path);
  if f.handle == nil {
    ret false;
  }
  defer f.close();
  let ok = f.write(data);
  ret ok;
}

test "format fills placeholders in order and keeps what it cannot fill" {
  str a = format("{} and {}", "x", "y");
  assert equals(a, "x and y"), "expected bare placeholders filled in order";
  free(a);
  str b = format("{num}/{str}/{flag}", 3, "s", true);
  assert equals(b, "3/s/true"), "expected typed placeholders";
  free(b);
  str c = format("{{literal}} {}", "v");
  assert equals(c, "{literal}} v"), "expected an escaped brace to print one brace";
  free(c);
  str d = format("{} {}", "only");
  assert equals(d, "only {}"), "expected a placeholder with no argument to stay";
  free(d);
  str e = format("{unknown} {}", "v");
  assert equals(e, "{unknown} v"), "expected an unrecognized word to stay as written";
  free(e);
  str g = format("{dec} {chr} {ptr}", 1.5, 'q', nil);
  assert starts_with(g, "1.5") && contains(g, "q"), "expected the decimal and character placeholders";
  free(g);
}

test "the fmt_ helpers render each type" {
  str n = fmt_num(-42);
  assert equals(n, "-42"), "expected a number";
  free(n);
  str d = fmt_dec(2.5);
  assert equals(d, "2.5"), "expected a decimal without trailing zeros";
  free(d);
  str t = fmt_flag(true);
  str f = fmt_bin(false);
  assert equals(t, "true") && equals(f, "false"), "expected both flag spellings";
  free(t);
  free(f);
  str c = fmt_chr('z');
  assert equals(c, "z"), "expected a character";
  free(c);
  str s = fmt_str("copy");
  assert equals(s, "copy"), "expected a copy of the string";
  free(s);
  raw* p = malloc(1);
  str r = fmt_raw(p);
  assert len(r) > 0, "expected a pointer rendering";
  free(r);
  free(p);
}

test "the print helpers write to standard output" {
  print("p ");
  println("line");
  print_num(7);
  print_dec(1.5);
  print_flag(true);
  print_flag(false);
  print_fmt("{} ", "fmt");
  println_fmt("{num}", 3);
  assert true, "expected every printer to return";
}

test "a file round-trips text and reports its size, position and lines" {
  str path = "fun-out/io_roundtrip_test.txt";
  File w = open_write(path);
  assert w.write("alpha\nbeta\ngamma\n"), "expected the write";
  assert w.try_write("delta\n").is_ok(), "expected the try_ write";
  assert w.flush() && w.try_flush().is_ok(), "expected both flushes";
  assert w.size() == 23, "expected the size of what was written";
  w.close();
  assert !w.write("late"), "expected a closed file to refuse writes";
  File r = open_read(path);
  str all = r.read_all();
  assert equals(all, "alpha\nbeta\ngamma\ndelta\n"), "expected the whole text back";
  free(all);
  r.rewind();
  str first = r.read_line_max(64);
  assert equals(first, "alpha\n"), "expected the first line";
  free(first);
  assert r.tell() == 6, "expected the position after one line";
  assert r.seek(0, 0) && r.tell() == 0, "expected seek to the start";
  Vec<str> lines = r.read_lines(64);
  assert lines.len == 4 && equals(lines.get(3), "delta\n"), "expected every line";
  lines.free();
  assert r.try_seek(0, 0).is_ok() && r.try_tell().unwrap() == 0, "expected the try_ seek and tell";
  str head = r.read_bytes(5);
  assert equals(head, "alpha"), "expected five bytes";
  free(head);
  assert r.try_read_bytes(3).is_ok() && r.try_read_line_max(8).is_ok() &&
    r.try_read_all().is_ok(), "expected the try_ readers to succeed";
  assert r.try_read_lines(64).is_ok(), "expected try_read_lines";
  r.close();
  remove(path);
}

test "a file reads and writes raw bytes" {
  str path = "fun-out/io_bytes_test.bin";
  File w = open_write(path);
  raw* data = malloc(4);
  str bytes = data;
  bytes[0] = 'a';
  bytes[1] = 'b';
  bytes[2] = 'c';
  bytes[3] = 'd';
  assert w.write_bytes(data, 4) && w.try_write_bytes(data, 2).is_ok(), "expected raw writes";
  w.close();
  File r = open_read(path);
  raw* back = malloc(8);
  assert r.read_into(back, 8) == 6, "expected six bytes back";
  r.rewind();
  assert r.try_read_into(back, 2).unwrap() == 2, "expected the try_ form";
  r.close();
  free(data);
  free(back);
  remove(path);
}

test "append adds to the end of a file" {
  str path = "fun-out/io_append_test.txt";
  write_all(path, "one\n");
  File a = open_append(path);
  a.write("two\n");
  a.close();
  str text = read_all(path);
  assert equals(text, "one\ntwo\n"), "expected the appended text after the original";
  free(text);
  assert try_open_append(path).is_ok(), "expected the try_ form";
  remove(path);
}

test "opening a missing file fails, and a closed file refuses everything" {
  assert try_open_read("fun-out/io_no_such_file.txt").is_err(), "expected a missing file to fail to open";
  assert try_open_write("fun-out/io_no_such_dir/x.txt").is_err(), "expected a missing directory to fail";
  assert try_open_append("fun-out/io_no_such_dir/x.txt").is_err(), "expected append to a missing directory to fail";
  assert read_all("fun-out/io_no_such_file.txt") == nil, "expected the helper to give nil for a missing file";
  assert !write_all("fun-out/io_no_such_dir/x.txt", "x"), "expected the helper to report a failed write";
  File closed = open_read("fun-out/io_no_such_file.txt");
  assert closed.read_all() == nil && closed.read_bytes(4) == nil &&
    closed.read_line_max(8) == nil, "expected reads from nothing to give nil";
  assert closed.try_read_all().is_err() && closed.try_read_bytes(4).is_err() &&
    closed.try_read_line_max(8).is_err(), "expected the try_ reads to fail";
  assert closed.try_read_lines(8).is_err() && closed.read_lines(8).len == 0, "expected no lines";
  assert !closed.write("x") && closed.try_write("x").is_err(), "expected writes to fail";
  assert !closed.write_bytes(nil, 0) && closed.try_write_bytes(nil, 0).is_err(), "expected raw writes to fail";
  assert closed.read_into(nil, 0) == 0 && closed.try_read_into(nil, 0).is_err(), "expected raw reads to fail";
  assert !closed.seek(0, 0) && closed.try_seek(0, 0).is_err(), "expected seek to fail";
  assert closed.tell() == -1 && closed.try_tell().is_err() && closed.size() == -1, "expected no position or size";
  assert !closed.flush() && closed.try_flush().is_err(), "expected flush to fail";
  closed.rewind();
  closed.close();
  assert true, "expected rewind and close on a closed file to be harmless";
}

test "a sink writes to a file, to standard streams, and reads back" {
  str path = "fun-out/io_sink_test.txt";
  File f = open_write(path);
  Sink s = Sink.File(f);
  assert s.write("hello\n") && s.try_write("world\n").is_ok(), "expected both writes";
  write_to(s, "raw");
  writeln_to(s, "!");
  assert s.flush() && s.try_flush().is_ok(), "expected the flushes";
  f.close();
  File r = open_read(path);
  Sink in = Sink.File(r);
  str line = in.read_line_max(64);
  assert equals(line, "hello\n"), "expected the first line back";
  free(line);
  str bytes = in.read_bytes(6);
  assert equals(bytes, "world\n"), "expected six bytes";
  free(bytes);
  assert in.read_bytes(1000) == nil, "expected a short read to give nil";
  assert in.read_line_max(0) == nil, "expected a zero-length line read to give nil";
  r.close();
  remove(path);
  Sink out = Sink.Stdout;
  Sink err = Sink.Stderr;
  assert out.write("") && err.write("") && out.try_write("").is_ok() &&
    err.try_write("").is_ok(), "expected the standard streams to accept text";
  assert out.flush() && err.try_flush().is_ok(), "expected the standard streams to flush";
  Sink unavailable = Sink.File(open_read("fun-out/io_no_such_file.txt"));
  assert !unavailable.write("x") && unavailable.try_write("x").is_err() &&
    !unavailable.flush(), "expected a sink with no file to refuse";
  assert unavailable.read_line_max(8) == nil && unavailable.read_bytes(2) == nil, "expected no reads from it";
}

test "a rotating sink starts a new file when the limit would be passed" {
  str path = "fun-out/io_rotate_test.log";
  remove(path);
  remove("fun-out/io_rotate_test.log.1");
  remove("fun-out/io_rotate_test.log.2");
  RotatingSink r = rotating_sink_new(path, 10, 3);
  Sink s = Sink.Rotating(&r);
  assert s.write("aaaaaa") && s.try_write("bbbbbb").is_ok(), "expected both writes across a rotation";
  assert s.write("cccccc"), "expected a third write across another rotation";
  assert s.flush() && s.try_flush().is_ok(), "expected the flushes";
  r.close();
  str current = read_all(path);
  str older = read_all("fun-out/io_rotate_test.log.1");
  str oldest = read_all("fun-out/io_rotate_test.log.2");
  assert equals(current, "cccccc"), "expected the newest text in the live file";
  assert equals(older, "bbbbbb"), "expected the previous text in .1";
  assert equals(oldest, "aaaaaa"), "expected the oldest text in .2";
  free(current);
  free(older);
  free(oldest);
  remove(path);
  remove("fun-out/io_rotate_test.log.1");
  remove("fun-out/io_rotate_test.log.2");
}
