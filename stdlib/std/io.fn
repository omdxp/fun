// File and buffer IO utilities.
// 
// Usage:
// ```
// print("hi");
// println("bye");
// ```

imp std.c.io;
imp std.c.mem;
imp std.c.def;
imp std.string;
imp std.vec;
imp std.quirks;
imp std.result;
imp std.error;

// Print a string to stdout (no newline).
// 
// Params:
// - s: string to print
pub fun print(str s) {
  printf("%s", s);
}

// Print a string to stdout with newline.
// 
// Params:
// - s: string to print
pub fun println(str s) {
  puts(s);
}

// Print a number to stdout (no newline).
// 
// Params:
// - n: number to print
pub fun print_num(num n) {
  printf("%lld", n);
}

// Print a decimal to stdout (no newline).
// 
// Params:
// - d: decimal to print
pub fun print_dec(dec d) {
  printf("%f", d);
}

// Print a boolean to stdout (no newline).
// 
// Params:
// - b: boolean to print
pub fun print_bin(bin b) {
  if b {
    printf("true");
  } else {
    printf("false");
  }
}

// Duplicate a string into a new buffer.
fun _dup_str(str s) str {
  num n = len(s);
  str out = malloc(n + 1);
  if out == NULL {
    ret NULL;
  }
  num i = 0;
  for i < n {
    out[i] = s[i];
    i = i + 1;
  }
  out[n] = '\0';
  ret out;
}

fun _io_err(str message, str context) Error {
  Error e = error_new_simple(.Io, message);
  if context != NULL {
    e.with_context(context);
  }
  ret e;
}

// Format a number into a new string buffer.
pub fun fmt_num(num n) str {
  str buf = malloc(32);
  if buf == NULL {
    ret NULL;
  }
  snprintf(buf, 32, "%lld", n);
  ret buf;
}

// Format a decimal into a new string buffer.
pub fun fmt_dec(dec d) str {
  str buf = malloc(64);
  if buf == NULL {
    ret NULL;
  }
  snprintf(buf, 64, "%g", d);
  ret buf;
}

// Format a boolean into a new string buffer.
pub fun fmt_bin(bin b) str {
  if b {
    ret _dup_str("true");
  }
  ret _dup_str("false");
}

// Format a character into a new string buffer.
pub fun fmt_chr(chr c) str {
  str buf = malloc(2);
  if buf == NULL {
    ret NULL;
  }
  buf[0] = c;
  buf[1] = '\0';
  ret buf;
}

// Format a string into a new string buffer.
pub fun fmt_str(str s) str {
  ret _dup_str(s);
}

// Format a raw pointer into a new string buffer.
pub fun fmt_raw(raw* p) str {
  str buf = malloc(32);
  if buf == NULL {
    ret NULL;
  }
  snprintf(buf, 32, "%p", p);
  ret buf;
}

// Format using a pre-built Vec<str>.
pub fun format_impl(str fmt, Vec<str>* args) str {
  StringBuilder b = string_builder_init(8);
  num i = 0;
  let n = len(fmt);
  num arg_i = 0;
  let argc = args.len;

  for i < n {
    let c = fmt[i];

    if c == '{' {
      if i + 1 < n && fmt[i + 1] == '{' {
        b.append_char('{');
        i = i + 2;
        continue;
      }
      if i + 1 < n && fmt[i + 1] == '}' {
        if arg_i < argc {
          b.append(args.get(arg_i));
          arg_i = arg_i + 1;
        } else {
          b.append("{}");
        }
        i = i + 2;
        continue;
      }
      if i + 4 < n && fmt[i + 4] == '}' {
        if arg_i < argc {
          b.append(args.get(arg_i));
          arg_i = arg_i + 1;
        } else {
          b.append("{}");
        }
        i = i + 5;
        continue;
      }
    }

    if c == '}' && i + 1 < n && fmt[i + 1] == '}' {
      b.append_char('}');
      i = i + 2;
      continue;
    }

    b.append_char(c);
    i = i + 1;
  }

  str out = b.build();
  b.free();
  ret out;
}
// Format a string using "{}" placeholders.
// 
// Placeholder forms:
// - {} or {str} : string
// - {num}       : number
// - {dec}       : decimal
// - {bin}       : boolean
// - {chr}       : character
// - {ptr}       : raw pointer
// 
// Use "{{" and "}}" to emit literal braces.
pub fun format(str fmt, ...) str {
  ret format_impl(fmt, &vargs);
}

// Print a formatted string to stdout (no newline).
// See format() for placeholder types.
pub fun print_fmt(str fmt, ...) {
  str out = format_impl(fmt, &vargs);
  if out != NULL {
    print(out);
    free(out);
  }
}

// Print a formatted string to stdout with newline.
// See format() for placeholder types.
pub fun println_fmt(str fmt, ...) {
  str out = format_impl(fmt, &vargs);
  if out != NULL {
    println(out);
    free(out);
  }
}

// File handle wrapper.
// 
// Fields:
// - handle: C FILE pointer (null if unopened)
pub compound File {
  // handle: C FILE pointer (null if unopened)
  FILE* handle;
}

// Open file for reading (binary).
// 
// Params:
// - path: file path
// 
// Returns:
// - File with handle set (null on failure)
pub fun open_read(str path) File {
  File f;
  f.handle = fopen(path, "rb");
  ret f;
}

// Open file for reading (binary) with Result.
pub fun try_open_read(str path) Result<File> {
  File f = open_read(path);
  Result<File> r;
  if f.handle == NULL {
    r.set_err(1, "open_read failed", f);
    ret r;
  }
  r.set_ok(f);
  ret r;
}

// Open file for writing (binary).
// 
// Params:
// - path: file path
// 
// Returns:
// - File with handle set (null on failure)
pub fun open_write(str path) File {
  File f;
  f.handle = fopen(path, "wb");
  ret f;
}

// Open file for writing (binary) with Result.
pub fun try_open_write(str path) Result<File> {
  File f = open_write(path);
  Result<File> r;
  if f.handle == NULL {
    r.set_err(1, "open_write failed", f);
    ret r;
  }
  r.set_ok(f);
  ret r;
}

// Open file for appending (binary).
// 
// Params:
// - path: file path
// 
// Returns:
// - File with handle set (null on failure)
pub fun open_append(str path) File {
  File f;
  f.handle = fopen(path, "ab");
  ret f;
}

// Open file for appending (binary) with Result.
pub fun try_open_append(str path) Result<File> {
  File f = open_append(path);
  Result<File> r;
  if f.handle == NULL {
    r.set_err(1, "open_append failed", f);
    ret r;
  }
  r.set_ok(f);
  ret r;
}

impl File {
  // Close the file handle.
  pub close() {
    if self.handle != NULL {
      fclose(self.handle);
      self.handle = NULL;
    }
  }

  // Read entire file into a new string.
  pub read_all() str {
    if self.handle == NULL {
      ret NULL;
    }

    fseek(self.handle, 0, 2);
    num size = ftell(self.handle);
    fseek(self.handle, 0, 0);

    if size < 0 {
      ret NULL;
    }

    str buf = malloc(size + 1);
    if buf == NULL {
      ret NULL;
    }

    num read = fread(buf, 1, size, self.handle);
    buf[read] = '\0';
    ret buf;
  }

  // Read entire file into a new string with Result.
  pub try_read_all() Result<str> {
    Result<str> r;
    if self.handle == NULL {
      r.set_err(1, "read_all on closed file", "");
      ret r;
    }
    str out = self.read_all();
    if out == NULL {
      r.set_err(1, "read_all failed", "");
      ret r;
    }
    r.set_ok(out);
    ret r;
  }

  // Read up to max_len bytes (binary-safe). Returns allocated buffer (NUL-terminated).
  pub read_bytes(num max_len) str {
    if self.handle == NULL || max_len <= 0 {
      ret NULL;
    }
    str buf = malloc(max_len + 1);
    if buf == NULL {
      ret NULL;
    }
    num read = fread(buf, 1, max_len, self.handle);
    buf[read] = '\0';
    ret buf;
  }

  // Read up to max_len bytes with Result.
  pub try_read_bytes(num max_len) Result<str> {
    Result<str> r;
    if self.handle == NULL || max_len <= 0 {
      r.set_err(1, "read_bytes invalid", "");
      ret r;
    }
    str out = self.read_bytes(max_len);
    if out == NULL {
      r.set_err(1, "read_bytes failed", "");
      ret r;
    }
    r.set_ok(out);
    ret r;
  }

  // Read a line up to max_len (including newline if present).
  pub read_line_max(num max_len) str {
    if self.handle == NULL || max_len <= 1 {
      ret NULL;
    }
    str buf = malloc(max_len);
    if buf == NULL {
      ret NULL;
    }
    str res = fgets(buf, max_len, self.handle);
    if res == NULL {
      free(buf);
      ret NULL;
    }
    ret buf;
  }

  // Read a line up to max_len with Result.
  pub try_read_line_max(num max_len) Result<str> {
    Result<str> r;
    if self.handle == NULL || max_len <= 1 {
      r.set_err(1, "read_line_max invalid", "");
      ret r;
    }
    str out = self.read_line_max(max_len);
    if out == NULL {
      r.set_err(1, "read_line_max failed", "");
      ret r;
    }
    r.set_ok(out);
    ret r;
  }

  // Read all lines (up to max_len per line).
  pub read_lines(num max_len) Vec<str> {
    Vec<str> out;
    out.len = 0;
    out.cap = 0;
    if self.handle == NULL {
      ret out;
    }
    for true {
      str line = self.read_line_max(max_len);
      if line == NULL {
        break;
      }
      out.push(line);
    }
    ret out;
  }

  // Read all lines (up to max_len per line) with Result.
  pub try_read_lines(num max_len) Result<Vec<str >> {
    Result<Vec<str >> r;
    if self.handle == NULL {
      Vec<str> empty;
      empty.len = 0;
      empty.cap = 0;
      r.set_err(1, "read_lines on closed file", empty);
      ret r;
    }
    Vec<str> out = self.read_lines(max_len);
    r.set_ok(out);
    ret r;
  }

  // Write raw bytes to the file.
  pub write_bytes(raw* data, num len) bin {
    if self.handle == NULL || data == NULL {
      ret false;
    }
    num wrote = fwrite(data, 1, len, self.handle);
    ret wrote == len;
  }

  // Write raw bytes to the file with Result.
  pub try_write_bytes(raw* data, num len) Result<bin> {
    Result<bin> r;
    if self.handle == NULL || data == NULL {
      r.set_err(1, "write_bytes invalid", false);
      ret r;
    }
    bin ok_write = self.write_bytes(data, len);
    if ok_write == false {
      r.set_err(1, "write_bytes failed", false);
      ret r;
    }
    r.set_ok(true);
    ret r;
  }

  // Read raw bytes into a buffer; returns bytes read.
  pub read_into(raw* dst, num len) num {
    if self.handle == NULL || dst == NULL {
      ret 0;
    }
    ret fread(dst, 1, len, self.handle);
  }

  // Read raw bytes into a buffer with Result.
  pub try_read_into(raw* dst, num len) Result<num> {
    Result<num> r;
    if self.handle == NULL || dst == NULL {
      r.set_err(1, "read_into invalid", 0);
      ret r;
    }
    num n = self.read_into(dst, len);
    r.set_ok(n);
    ret r;
  }

  // Seek within the file (whence: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END).
  pub seek(num offset, num whence) bin {
    if self.handle == NULL {
      ret false;
    }
    ret fseek(self.handle, offset, whence) == 0;
  }

  // Seek within the file with Result.
  pub try_seek(num offset, num whence) Result<bin> {
    Result<bin> r;
    if self.handle == NULL {
      r.set_err(1, "seek on closed file", false);
      ret r;
    }
    bin ok_seek = self.seek(offset, whence);
    if ok_seek == false {
      r.set_err(1, "seek failed", false);
      ret r;
    }
    r.set_ok(true);
    ret r;
  }

  // Tell current file position.
  pub tell() num {
    if self.handle == NULL {
      ret -1;
    }
    ret ftell(self.handle);
  }

  // Tell current file position with Result.
  pub try_tell() Result<num> {
    Result<num> r;
    if self.handle == NULL {
      r.set_err(1, "tell on closed file", -1);
      ret r;
    }
    num pos = self.tell();
    if pos<0 {
      r.set_err(1, "tell failed", -1);
      ret r;
    }
    r.set_ok(pos);
    ret r;
  }

  // Rewind to start of file.
  pub rewind() {
    if self.handle == NULL {
      ret;
    }
    rewind(self.handle);
  }

  // Flush buffered output.
  pub flush() bin {
    if self.handle == NULL {
      ret false;
    }
    ret fflush(self.handle) == 0;
  }

  // Flush buffered output with Result.
  pub try_flush() Result<bin> {
    Result<bin> r;
    if self.handle == NULL {
      r.set_err(1, "flush on closed file", false);
      ret r;
    }
    bin ok_flush = self.flush();
    if ok_flush == false {
      r.set_err(1, "flush failed", false);
      ret r;
    }
    r.set_ok(true);
    ret r;
  }

  // Get file size (best-effort; returns -1 on failure).
  pub size() num {
    if self.handle == NULL {
      ret -1;
    }
    let cur = ftell(self.handle);
    if cur<0 {
      ret -1;
    }
    if fseek(self.handle, 0, 2) != 0 {
      ret -1;
    }
    num end = ftell(self.handle);
    fseek(self.handle, cur, 0);
    ret end;
  }

  // Write a string to the file.
  pub write(str data) bin {
    if self.handle == NULL {
      ret false;
    }
    num n = len(data);
    num wrote = fwrite(data, 1, n, self.handle);
    ret wrote == n;
  }
}

// Read a file into a string.
// 
// Params:
// - path: file path
// 
// Returns:
// - file contents or null
pub fun read_all(str path) str {
  File f = open_read(path);
  if f.handle == NULL {
    ret NULL;
  }
  defer f.close();
  str out = f.read_all();
  ret out;
}

// Write a string to a file.
// 
// Params:
// - path: file path
// - data: contents
// 
// Returns:
// - true on success
pub fun write_all(str path, str data) bin {
  File f = open_write(path);
  if f.handle == NULL {
    ret false;
  }
  defer f.close();
  bin ok = f.write(data);
  ret ok;
}
