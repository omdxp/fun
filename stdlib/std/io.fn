// File and buffer IO utilities.
// 
// Usage:
// ```
// print("hi");
// println("bye");
// ```

imp std.c.io;
imp std.c.mem;
imp std.string;
imp std.vec;
imp std.result;
imp std.error;

// Print a string to stdout (no newline).
// 
// Params:
// - s: string to print
pub fun print(str s) {
  printf("%s", s);
}

// Print a string to stdout with newline.
// 
// Params:
// - s: string to print
pub fun println(str s) {
  puts(s);
}

// Print a number to stdout (no newline).
// 
// Params:
// - n: number to print
pub fun print_num(num n) {
  printf("%lld", n);
}

// Print a decimal to stdout (no newline).
// 
// Params:
// - d: decimal to print
pub fun print_dec(dec d) {
  printf("%f", d);
}

// Print a boolean to stdout (no newline).
// 
// Params:
// - b: boolean to print
pub fun print_bin(bin b) {
  if b {
    printf("true");
  } else {
    printf("false");
  }
}

// Duplicate a string into a new buffer.
fun _dup_str(str s) str {
  let n = len(s);
  str out = malloc(n + 1);
  if out == nil {
    ret nil;
  }
  num i = 0;
  for i < n {
    out[i] = s[i];
    i = i + 1;
  }
  out[n] = '\0';
  ret out;
}

// Format a number into a new string buffer.
pub fun fmt_num(num n) str {
  str buf = malloc(32);
  if buf == nil {
    ret nil;
  }
  snprintf(buf, 32, "%lld", n);
  ret buf;
}

// Format a decimal into a new string buffer.
pub fun fmt_dec(dec d) str {
  str buf = malloc(64);
  if buf == nil {
    ret nil;
  }
  snprintf(buf, 64, "%g", d);
  ret buf;
}

// Format a boolean into a new string buffer.
pub fun fmt_bin(bin b) str {
  if b {
    ret _dup_str("true");
  }
  ret _dup_str("false");
}

// Format a character into a new string buffer.
pub fun fmt_chr(chr c) str {
  str buf = malloc(2);
  if buf == nil {
    ret nil;
  }
  buf[0] = c;
  buf[1] = '\0';
  ret buf;
}

// Format a string into a new string buffer.
pub fun fmt_str(str s) str {
  ret _dup_str(s);
}

// Format a raw pointer into a new string buffer.
pub fun fmt_raw(raw* p) str {
  str buf = malloc(32);
  if buf == nil {
    ret nil;
  }
  snprintf(buf, 32, "%p", p);
  ret buf;
}

// Format using a pre-built Vec<str>.
// 
// Params:
// - fmt: format string
// - args: string arguments
// 
// Returns:
// - formatted string
pub fun format_impl(str fmt, Vec<str>* args) str {
  let b = string_builder_init(8);
  num i = 0;
  let n = len(fmt);
  num arg_i = 0;
  let argc = args.len;

  for i < n {
    let c = fmt[i];

    if c == '{' {
      if i + 1 < n && fmt[i + 1] == '{' {
        b.append_char('{');
        i = i + 2;
        continue;
      }
      if i + 1 < n && fmt[i + 1] == '}' {
        if arg_i < argc {
          b.append(args.get(arg_i));
          arg_i = arg_i + 1;
        } else {
          b.append("{}");
        }
        i = i + 2;
        continue;
      }
      if i + 4 < n && fmt[i + 4] == '}' {
        // A `{xyz}` is a typed placeholder ONLY when `xyz` is a recognized type
        // name (str/num/dec/bin/chr/ptr/raw) — matching the compile-time
        // `build_printf_format` rule. Any other `{xyz}` (e.g. `{foo}`) is literal
        // text, so the two format paths agree instead of one silently eating it.
        let a = fmt[i + 1];
        let b2 = fmt[i + 2];
        let d = fmt[i + 3];
        bin is_typed = (a == 's' && b2 == 't' && d == 'r') || (a == 'n' && b2 == 'u' && d == 'm') || (a == 'd' && b2 == 'e' && d == 'c') || (a == 'b' && b2 == 'i' && d == 'n') || (a == 'c' && b2 == 'h' && d == 'r') || (a == 'p' && b2 == 't' && d == 'r') || (a == 'r' && b2 == 'a' && d == 'w');
        if is_typed {
          if arg_i < argc {
            b.append(args.get(arg_i));
            arg_i = arg_i + 1;
          } else {
            b.append("{}");
          }
          i = i + 5;
          continue;
        }
      }
    }

    if c == '}' && i + 1 < n && fmt[i + 1] == '}' {
      b.append_char('}');
      i = i + 2;
      continue;
    }

    b.append_char(c);
    i = i + 1;
  }

  let out = b.build();
  b.free();
  ret out;
}
// Format a string using "{}" placeholders.
// 
// Placeholder forms:
// - {} or {str} : string
// - {num}       : number
// - {dec}       : decimal
// - {bin}       : boolean
// - {chr}       : character
// - {ptr}       : raw pointer
// 
// Use "{{" and "}}" to emit literal braces.
pub fun format(str fmt, ...) str {
  ret format_impl(fmt, &vargs);
}

// Print a formatted string to stdout (no newline).
// See format() for placeholder types.
pub fun print_fmt(str fmt, ...) {
  let out = format_impl(fmt, &vargs);
  if out != nil {
    print(out);
    free(out);
  }
}

// Print a formatted string to stdout with newline.
// See format() for placeholder types.
pub fun println_fmt(str fmt, ...) {
  let out = format_impl(fmt, &vargs);
  if out != nil {
    println(out);
    free(out);
  }
}

// File handle wrapper.
pub compound File {
  // C FILE pointer (null if unopened)
  FILE* handle;
}

// Open file for reading (binary).
// 
// Params:
// - path: file path
// 
// Returns:
// - File with handle set (null on failure)
pub fun open_read(str path) File {
  File f;
  f.handle = fopen(path, "rb");
  ret f;
}

// Open file for reading (binary) with Result.
pub fun try_open_read(str path) Result<File, Error> {
  let f = open_read(path);
  if f.handle == nil {
    ret err_kind(.Io, "open_read failed", f);
  }
  ret ok(f);
}

// Open file for writing (binary).
// 
// Params:
// - path: file path
// 
// Returns:
// - File with handle set (null on failure)
pub fun open_write(str path) File {
  File f;
  f.handle = fopen(path, "wb");
  ret f;
}

// Open file for writing (binary) with Result.
pub fun try_open_write(str path) Result<File, Error> {
  let f = open_write(path);
  if f.handle == nil {
    ret err_kind(.Io, "open_write failed", f);
  }
  ret ok(f);
}

// Open file for appending (binary).
// 
// Params:
// - path: file path
// 
// Returns:
// - File with handle set (null on failure)
pub fun open_append(str path) File {
  File f;
  f.handle = fopen(path, "ab");
  ret f;
}

// Open file for appending (binary) with Result.
pub fun try_open_append(str path) Result<File, Error> {
  let f = open_append(path);
  if f.handle == nil {
    ret err_kind(.Io, "open_append failed", f);
  }
  ret ok(f);
}

impl File {
  // Close the file handle.
  pub close() {
    if self.handle != nil {
      fclose(self.handle);
      self.handle = nil;
    }
  }

  // Read entire file into a new string.
  pub read_all() str {
    if self.handle == nil {
      ret nil;
    }

    fseek(self.handle, 0, 2);
    let size = ftell(self.handle);
    fseek(self.handle, 0, 0);

    if size < 0 {
      ret nil;
    }

    str buf = malloc(size + 1);
    if buf == nil {
      ret nil;
    }

    let read = fread(buf, 1, size, self.handle);
    buf[read] = '\0';
    ret buf;
  }

  // Read entire file into a new string with Result.
  pub try_read_all() Result<str, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "read_all on closed file", "");
    }
    let out = self.read_all();
    if out == nil {
      ret err_kind(.Io, "read_all failed", "");
    }
    ret ok(out);
  }

  // Read up to max_len bytes (binary-safe). Returns allocated buffer (NUL-terminated).
  pub read_bytes(num max_len) str {
    if self.handle == nil || max_len <= 0 {
      ret nil;
    }
    str buf = malloc(max_len + 1);
    if buf == nil {
      ret nil;
    }
    let read = fread(buf, 1, max_len, self.handle);
    buf[read] = '\0';
    ret buf;
  }

  // Read up to max_len bytes with Result.
  pub try_read_bytes(num max_len) Result<str, Error> {
    if self.handle == nil || max_len <= 0 {
      ret err_kind(.Invalid, "read_bytes invalid", "");
    }
    let out = self.read_bytes(max_len);
    if out == nil {
      ret err_kind(.Io, "read_bytes failed", "");
    }
    ret ok(out);
  }

  // Read a line up to max_len (including newline if present).
  pub read_line_max(num max_len) str {
    if self.handle == nil || max_len <= 1 {
      ret nil;
    }
    str buf = malloc(max_len);
    if buf == nil {
      ret nil;
    }
    str res = fgets(buf, max_len, self.handle);
    if res == nil {
      free(buf);
      ret nil;
    }
    ret buf;
  }

  // Read a line up to max_len with Result.
  pub try_read_line_max(num max_len) Result<str, Error> {
    if self.handle == nil || max_len <= 1 {
      ret err_kind(.Invalid, "read_line_max invalid", "");
    }
    let out = self.read_line_max(max_len);
    if out == nil {
      ret err_kind(.Io, "read_line_max failed", "");
    }
    ret ok(out);
  }

  // Read all lines (up to max_len per line).
  pub read_lines(num max_len) Vec<str> {
    Vec<str> out;
    out.len = 0;
    out.cap = 0;
    if self.handle == nil {
      ret out;
    }
    for true {
      let line = self.read_line_max(max_len);
      if line == nil {
        break;
      }
      out.push(line);
    }
    ret out;
  }

  // Read all lines (up to max_len per line) with Result.
  pub try_read_lines(num max_len) Result<Vec<str>, Error> {
    if self.handle == nil {
      Vec<str> empty;
      empty.len = 0;
      empty.cap = 0;
      ret err_kind(.Invalid, "read_lines on closed file", empty);
    }
    let out = self.read_lines(max_len);
    ret ok(out);
  }

  // Write raw bytes to the file.
  pub write_bytes(raw* data, num len) bin {
    if self.handle == nil || data == nil {
      ret false;
    }
    let wrote = fwrite(data, 1, len, self.handle);
    ret wrote == len;
  }

  // Write raw bytes to the file with Result.
  pub try_write_bytes(raw* data, num len) Result<bin, Error> {
    if self.handle == nil || data == nil {
      ret err_kind(.Invalid, "write_bytes invalid", false);
    }
    let ok_write = self.write_bytes(data, len);
    if ok_write == false {
      ret err_kind(.Io, "write_bytes failed", false);
    }
    ret ok(true);
  }

  // Read raw bytes into a buffer; returns bytes read.
  pub read_into(raw* dst, num len) num {
    if self.handle == nil || dst == nil {
      ret 0;
    }
    ret fread(dst, 1, len, self.handle);
  }

  // Read raw bytes into a buffer with Result.
  pub try_read_into(raw* dst, num len) Result<num, Error> {
    if self.handle == nil || dst == nil {
      ret err_kind(.Invalid, "read_into invalid", 0);
    }
    let n = self.read_into(dst, len);
    ret ok(n);
  }

  // Seek within the file (whence: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END).
  pub seek(num offset, num whence) bin {
    if self.handle == nil {
      ret false;
    }
    ret fseek(self.handle, offset, whence) == 0;
  }

  // Seek within the file with Result.
  pub try_seek(num offset, num whence) Result<bin, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "seek on closed file", false);
    }
    let ok_seek = self.seek(offset, whence);
    if ok_seek == false {
      ret err_kind(.Io, "seek failed", false);
    }
    ret ok(true);
  }

  // Tell current file position.
  pub tell() num {
    if self.handle == nil {
      ret -1;
    }
    ret ftell(self.handle);
  }

  // Tell current file position with Result.
  pub try_tell() Result<num, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "tell on closed file", -1);
    }
    let pos = self.tell();
    if pos < 0 {
      ret err_kind(.Io, "tell failed", -1);
    }
    ret ok(pos);
  }

  // Rewind to start of file.
  pub rewind() {
    if self.handle == nil {
      ret;
    }
    rewind(self.handle);
  }

  // Flush buffered output.
  pub flush() bin {
    if self.handle == nil {
      ret false;
    }
    ret fflush(self.handle) == 0;
  }

  // Flush buffered output with Result.
  pub try_flush() Result<bin, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "flush on closed file", false);
    }
    let ok_flush = self.flush();
    if ok_flush == false {
      ret err_kind(.Io, "flush failed", false);
    }
    ret ok(true);
  }

  // Get file size (best-effort; returns -1 on failure).
  pub size() num {
    if self.handle == nil {
      ret -1;
    }
    let cur = ftell(self.handle);
    if cur < 0 {
      ret -1;
    }
    if fseek(self.handle, 0, 2) != 0 {
      ret -1;
    }
    let end = ftell(self.handle);
    fseek(self.handle, cur, 0);
    ret end;
  }

  // Write a string to the file.
  pub write(str data) bin {
    if self.handle == nil {
      ret false;
    }
    let n = len(data);
    let wrote = fwrite(data, 1, n, self.handle);
    ret wrote == n;
  }

  // Write a string to the file with Result.
  pub try_write(str data) Result<bin, Error> {
    if self.handle == nil {
      ret err_kind(.Invalid, "write on closed file", false);
    }
    let ok_write = self.write(data);
    if ok_write == false {
      ret err_kind(.Io, "write failed", false);
    }
    ret ok(true);
  }
}

// --- Sinks: a unified write destination -----------------------------------------------

// A `Sink` names where bytes go: one of the three standard streams, or an open
// `File`. It gives std.io (and std.log) a single `write` path that works for
// stdout, stderr, and files alike. Dispatch is a `fit` over the enum (no vtable),
// so it stays zero-cost.
// 
// The set is intentionally limited to byte-stream destinations that map to a
// `FILE*` today. Pipe/Socket/Unix-socket/SharedMemory/Semaphore sinks are a
// roadmap item that depends on std.net / std.sync handles and per-OS syscalls;
// the enum can grow additively (one new variant + one `fit` arm) without
// changing any caller.
pub enum Sink {
  Stdout,
  Stderr,
  Stdin,
  File(File),
  Rotating(RotatingSink*),
}

impl Sink {
  // Resolve the underlying C stream handle for this sink.
  handle() FILE* {
    fit *self {
      .Stdout -> { ret stdout_stream(); }
      .Stderr -> { ret stderr_stream(); }
      .Stdin -> { ret stdin_stream(); }
      .File(f) -> { ret f.handle; }
      .Rotating(r) -> { ret r.current.handle; }
    }
    ret nil;
  }

  // Write a string to the sink. Returns true on success.
  pub write(str s) bin {
    // Rotating sinks own their size-cap/rollover logic, so route through
    // RotatingSink.write() instead of the plain handle()+fputs path below.
    fit *self {
      .Rotating(r) -> { ret r.write(s); }
      _ -> {}
    }
    let h = self.handle();
    if h == nil {
      ret false;
    }
    let rc = fputs(s, h);
    ret rc >= 0;
  }

  // Write a string to the sink with a Result.
  pub try_write(str s) Result<bin, Error> {
    fit *self {
      .Rotating(r) -> {
        if r.write(s) {
          ret ok(true);
        }
        ret err_kind(.Io, "sink write failed", false);
      }
      _ -> {}
    }
    let h = self.handle();
    if h == nil {
      ret err_kind(.Invalid, "write to unavailable sink", false);
    }
    let rc = fputs(s, h);
    if rc < 0 {
      ret err_kind(.Io, "sink write failed", false);
    }
    ret ok(true);
  }

  // Flush any buffered bytes to the underlying stream.
  pub flush() bin {
    fit *self {
      .Rotating(r) -> { ret r.flush(); }
      _ -> {}
    }
    let h = self.handle();
    if h == nil {
      ret false;
    }
    ret fflush(h) == 0;
  }

  // Flush any buffered bytes to the underlying stream, with a Result.
  pub try_flush() Result<bin, Error> {
    if self.flush() {
      ret ok(true);
    }
    ret err_kind(.Io, "sink flush failed", false);
  }
}

// Write `msg` to a sink (no trailing newline).
pub fun write_to(Sink s, str msg) {
  _ = s.write(msg);
}

// Write `msg` followed by a newline to a sink.
pub fun writeln_to(Sink s, str msg) {
  _ = s.write(msg);
  _ = s.write("\n");
}

// --- Rotating file sink ----------------------------------------------------------------

// A file destination that caps each file at `max_bytes` and keeps up to
// `max_files` rolled-over generations (`path`, `path.1`, ... `path.{max_files-1}`).
// When a write would exceed the cap, the current file is closed, existing
// generations are shifted up (dropping the oldest), and a fresh `path` is opened.
// Intended for a single writer; guard with a Mutex for concurrent use.
pub compound RotatingSink {
  str path;
  num max_bytes;
  num max_files;
  File current;
  num written;
}

// Open a rotating sink at `path` (truncates/creates the active file).
pub fun rotating_sink_new(str path, num max_bytes, num max_files) RotatingSink {
  RotatingSink r;
  r.path = path;
  r.max_bytes = max_bytes;
  r.max_files = max_files;
  r.current = open_write(path);
  r.written = 0;
  ret r;
}

impl RotatingSink {
  // Roll the current file over: close it, shift `path.N -> path.N+1` (dropping the
  // oldest beyond max_files), then reopen a fresh active `path`.
  rotate() {
    self.current.close();
    // Shift older generations up, oldest first, so nothing is overwritten.
    num i = self.max_files - 1;
    for i > 0 {
      let src = self.numbered_path(i - 1);
      let dst = self.numbered_path(i);
      _ = rename(src, dst);
      i = i - 1;
    }
    self.current = open_write(self.path);
    self.written = 0;
  }

  // Build the on-disk name for generation `n` (0 = the active `path`).
  numbered_path(num n) str {
    if n == 0 {
      ret self.path;
    }
    ret format("{}.{}", self.path, n);
  }

  // Write `s`, rotating first if it would exceed the size cap.
  pub write(str s) bin {
    let n = len(s);
    if self.written + n > self.max_bytes && self.written > 0 {
      self.rotate();
    }
    let ok_w = self.current.write(s);
    if ok_w {
      self.written = self.written + n;
    }
    ret ok_w;
  }

  pub flush() bin {
    ret self.current.flush();
  }

  pub close() {
    self.current.close();
  }
}

// Read a file into a string.
// 
// Params:
// - path: file path
// 
// Returns:
// - file contents or null
pub fun read_all(str path) str {
  let f = open_read(path);
  if f.handle == nil {
    ret nil;
  }
  defer f.close();
  let out = f.read_all();
  ret out;
}

// Write a string to a file.
// 
// Params:
// - path: file path
// - data: contents
// 
// Returns:
// - true on success
pub fun write_all(str path, str data) bin {
  let f = open_write(path);
  if f.handle == nil {
    ret false;
  }
  defer f.close();
  let ok = f.write(data);
  ret ok;
}
