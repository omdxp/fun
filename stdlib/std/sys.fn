// System utilities (process, environment, and randomness).
// 
// Usage:
// ```
// str home = env("HOME");
// if home == nil { sys_exit(1); }
// ```

imp std.c.mem;
imp std.result;

// Read an environment variable.
// 
// Params:
// - name: variable name
// 
// Returns:
// - value string or null
pub fun env(str name) str {
  ret getenv(name);
}

// Read an environment variable with Result.
pub fun try_env(str name) Result<str> {
  str out = env(name);
  if out == nil {
    ret err(1, "env missing", "");
  }
  ret ok(out);
}

// Exit the process with a status code.
// 
// Params:
// - code: exit status
pub fun sys_exit(num code) {
  exit(code);
}

// Abort the process immediately.
pub fun sys_abort() {
  abort();
}

// Execute a command using the host shell.
// 
// Params:
// - command: command string
// 
// Returns:
// - implementation-defined status code
pub fun sys_system(str command) num {
  ret system(command);
}

// Seed the pseudo-random generator.
// 
// Params:
// - seed: seed value
pub fun rand_seed(num seed) {
  srand(seed);
}

// Get the next pseudo-random number.
// 
// Returns:
// - integer in 0..RAND_MAX
pub fun rand_next() num {
  ret rand();
}
