// System utilities (process, environment, and randomness).

imp std.c.mem;
imp std.result;
imp std.error;

// Reads an environment variable, returning null if missing.
pub fun env(str name) str {
  ret getenv(name);
}

// Sets an environment variable for this process, and so for every
// process it starts afterward, since a child inherits what its parent
// holds. Replaces a value already there.
pub fun set_env(str name, str value) bin {
  ret setenv(name, value, 1) == 0;
}

// Removes an environment variable, so a later read finds nothing.
pub fun clear_env(str name) bin {
  ret unsetenv(name) == 0;
}

// Reads an environment variable with Result.
pub fun try_env(str name) Result<str, Error> {
  let out = env(name);
  if out == nil {
    ret err_kind(.NotFound, "env missing", "");
  }
  ret .Ok(out);
}

// Exits the process with the given status code.
pub fun sys_exit(num code) {
  exit(code);
}

// Aborts the process immediately.
pub fun sys_abort() {
  abort();
}

// Executes a command using the host shell, returning an
// implementation-defined status code.
pub fun sys_system(str command) num {
  ret system(command);
}

// Seeds the pseudo-random generator.
pub fun rand_seed(num seed) {
  srand(seed);
}

// Returns the next pseudo-random integer in 0..RAND_MAX.
pub fun rand_next() num {
  ret rand();
}
