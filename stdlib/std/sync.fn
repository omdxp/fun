// Synchronization helpers built on POSIX pthread APIs.
// 
// Provides mutex and condition variable wrappers with lazy init.

imp std.c.thread;
imp std.c.def;

// Managed mutex.
pub compound Mutex {
  // Underlying pthread mutex.
  pthread_mutex_t inner;
  // True once initialized and not yet destroyed.
  bin initialized;
}

// Managed condition variable.
pub compound CondVar {
  // Underlying pthread condvar.
  pthread_cond_t inner;
  // True once initialized and not yet destroyed.
  bin initialized;
}

// Create an uninitialized mutex wrapper.
// 
// Returns:
// - new Mutex value
pub fun mutex_new() Mutex {
  Mutex m;
  m.initialized = false;
  ret m;
}

// Create an uninitialized condition variable wrapper.
// 
// Returns:
// - new CondVar value
pub fun condvar_new() CondVar {
  CondVar c;
  c.initialized = false;
  ret c;
}

impl Mutex {
  // Initialize the mutex.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub init() num {
    if self.initialized == true {
      ret 0;
    }
    num rc = pthread_mutex_init(&self.inner, NULL);
    if rc == 0 {
      self.initialized = true;
    }
    ret rc;
  }

  // Lock the mutex.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub lock() num {
    if self.initialized == false {
      num init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    ret pthread_mutex_lock(&self.inner);
  }

  // Try locking the mutex without blocking.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub try_lock() num {
    if self.initialized == false {
      num init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    ret pthread_mutex_trylock(&self.inner);
  }

  // Unlock the mutex.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub unlock() num {
    if self.initialized == false {
      ret 0;
    }
    ret pthread_mutex_unlock(&self.inner);
  }

  // Destroy the mutex.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub destroy() num {
    if self.initialized == false {
      ret 0;
    }
    num rc = pthread_mutex_destroy(&self.inner);
    if rc == 0 {
      self.initialized = false;
    }
    ret rc;
  }
}

impl CondVar {
  // Initialize the condition variable.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub init() num {
    if self.initialized == true {
      ret 0;
    }
    num rc = pthread_cond_init(&self.inner, NULL);
    if rc == 0 {
      self.initialized = true;
    }
    ret rc;
  }

  // Wait on the condition variable.
  // 
  // Params:
  // - mutex: associated mutex wrapper
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub wait(Mutex* mutex) num {
    if self.initialized == false {
      num init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    if mutex == NULL {
      ret -1;
    }
    if mutex.initialized == false {
      num m_rc = mutex.init();
      if m_rc != 0 {
        ret m_rc;
      }
    }
    ret pthread_cond_wait(&self.inner, &mutex.inner);
  }

  // Wait on the condition variable until an absolute timeout.
  // 
  // Params:
  // - mutex: associated mutex wrapper
  // - abs_time: absolute timeout pointer (`struct timespec*`, C semantics)
  // 
  // Returns:
  // - pthread return code (0 on success, nonzero on timeout/failure)
  pub timed_wait(Mutex* mutex, raw* abs_time) num {
    if self.initialized == false {
      num init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    if mutex == NULL {
      ret -1;
    }
    if abs_time == NULL {
      ret -2;
    }
    if mutex.initialized == false {
      num m_rc = mutex.init();
      if m_rc != 0 {
        ret m_rc;
      }
    }
    ret pthread_cond_timedwait(&self.inner, &mutex.inner, abs_time);
  }

  // Wake one waiter.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub signal() num {
    if self.initialized == false {
      ret 0;
    }
    ret pthread_cond_signal(&self.inner);
  }

  // Wake all waiters.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub broadcast() num {
    if self.initialized == false {
      ret 0;
    }
    ret pthread_cond_broadcast(&self.inner);
  }

  // Destroy the condition variable.
  // 
  // Returns:
  // - pthread return code (0 on success)
  pub destroy() num {
    if self.initialized == false {
      ret 0;
    }
    num rc = pthread_cond_destroy(&self.inner);
    if rc == 0 {
      self.initialized = false;
    }
    ret rc;
  }
}

// Initialize a mutex via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when mutex is null
// - pthread return code on failure
pub fun mutex_init(Mutex* mutex) num {
  if mutex == NULL {
    ret -1;
  }

  if mutex.initialized == true {
    ret 0;
  }

  num rc = pthread_mutex_init(&mutex.inner, NULL);
  if rc == 0 {
    mutex.initialized = true;
  }
  ret rc;
}

// Lock a mutex via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when mutex is null
// - pthread return code on failure
pub fun mutex_lock(Mutex* mutex) num {
  if mutex == NULL {
    ret -1;
  }

  if mutex.initialized == false {
    num init_rc = mutex_init(mutex);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  num rc = pthread_mutex_lock(&mutex.inner);
  ret rc;
}

// Try lock a mutex via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when mutex is null
// - pthread return code on failure
pub fun mutex_try_lock(Mutex* mutex) num {
  if mutex == NULL {
    ret -1;
  }

  if mutex.initialized == false {
    num init_rc = mutex_init(mutex);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  num rc = pthread_mutex_trylock(&mutex.inner);
  ret rc;
}

// Unlock a mutex via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when mutex is null
// - pthread return code on failure
pub fun mutex_unlock(Mutex* mutex) num {
  if mutex == NULL {
    ret -1;
  }

  if mutex.initialized == false {
    ret 0;
  }

  num rc = pthread_mutex_unlock(&mutex.inner);
  ret rc;
}

// Destroy a mutex via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when mutex is null
// - pthread return code on failure
pub fun mutex_destroy(Mutex* mutex) num {
  if mutex == NULL {
    ret -1;
  }

  if mutex.initialized == false {
    ret 0;
  }

  num rc = pthread_mutex_destroy(&mutex.inner);
  if rc == 0 {
    mutex.initialized = false;
  }
  ret rc;
}

// Initialize a condition variable via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when cond is null
// - pthread return code on failure
pub fun condvar_init(CondVar* cond) num {
  if cond == NULL {
    ret -1;
  }

  if cond.initialized == true {
    ret 0;
  }

  num rc = pthread_cond_init(&cond.inner, NULL);
  if rc == 0 {
    cond.initialized = true;
  }
  ret rc;
}

// Wait on a condition variable via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when cond or mutex is null
// - pthread return code on failure
pub fun condvar_wait(CondVar* cond, Mutex* mutex) num {
  if cond == NULL || mutex == NULL {
    ret -1;
  }

  if cond.initialized == false {
    num init_rc = condvar_init(cond);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  if mutex.initialized == false {
    num m_rc = mutex_init(mutex);
    if m_rc != 0 {
      ret m_rc;
    }
  }

  num rc = pthread_cond_wait(&cond.inner, &mutex.inner);
  ret rc;
}

// Timed wait on a condition variable via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when cond or mutex is null
// - -2 when abs_time is null
// - pthread return code on timeout/failure
pub fun condvar_timed_wait(CondVar* cond, Mutex* mutex, raw* abs_time) num {
  if cond == NULL || mutex == NULL {
    ret -1;
  }

  if abs_time == NULL {
    ret -2;
  }

  if cond.initialized == false {
    num init_rc = condvar_init(cond);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  if mutex.initialized == false {
    num m_rc = mutex_init(mutex);
    if m_rc != 0 {
      ret m_rc;
    }
  }

  num rc = pthread_cond_timedwait(&cond.inner, &mutex.inner, abs_time);
  ret rc;
}

// Wake one waiter via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when cond is null
// - pthread return code on failure
pub fun condvar_signal(CondVar* cond) num {
  if cond == NULL {
    ret -1;
  }

  if cond.initialized == false {
    ret 0;
  }

  num rc = pthread_cond_signal(&cond.inner);
  ret rc;
}

// Wake all waiters via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when cond is null
// - pthread return code on failure
pub fun condvar_broadcast(CondVar* cond) num {
  if cond == NULL {
    ret -1;
  }

  if cond.initialized == false {
    ret 0;
  }

  num rc = pthread_cond_broadcast(&cond.inner);
  ret rc;
}

// Destroy a condition variable via pointer helper.
// 
// Returns:
// - 0 on success
// - -1 when cond is null
// - pthread return code on failure
pub fun condvar_destroy(CondVar* cond) num {
  if cond == NULL {
    ret -1;
  }

  if cond.initialized == false {
    ret 0;
  }

  num rc = pthread_cond_destroy(&cond.inner);
  if rc == 0 {
    cond.initialized = false;
  }
  ret rc;
}
