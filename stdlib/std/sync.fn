// Synchronization helpers built on POSIX pthread APIs.
// 
// Provides mutex and condition variable wrappers with lazy init. Lock/wait
// helpers auto-initialize wrappers on first use; unlock/signal/destroy on
// uninitialized wrappers are no-ops.

imp std.c.thread;

// Managed mutex.
pub compound Mutex {
  // Underlying pthread mutex.
  pthread_mutex_t inner;
  // True once initialized and not yet destroyed.
  bin initialized;
}

// Managed condition variable.
pub compound CondVar {
  // Underlying pthread condvar.
  pthread_cond_t inner;
  // True once initialized and not yet destroyed.
  bin initialized;
}

// Creates an uninitialized mutex wrapper.
pub fun mutex_new() Mutex {
  Mutex m;
  m.initialized = false;
  ret m;
}

// Creates an uninitialized condition variable wrapper.
pub fun condvar_new() CondVar {
  CondVar c;
  c.initialized = false;
  ret c;
}

impl Mutex {
  // Initializes the mutex. Returns the pthread return code (0 on success).
  pub init() num {
    if self.initialized == true {
      ret 0;
    }
    let rc = pthread_mutex_init(&self.inner, nil);
    if rc == 0 {
      self.initialized = true;
    }
    ret rc;
  }

  // True once initialized and not yet destroyed.
  pub is_initialized() bin {
    ret self.initialized;
  }

  // Locks the mutex, auto-initializing on first use.
  pub lock() num {
    if self.initialized == false {
      let init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    ret pthread_mutex_lock(&self.inner);
  }

  // Tries locking the mutex without blocking, auto-initializing on first use.
  pub try_lock() num {
    if self.initialized == false {
      let init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    ret pthread_mutex_trylock(&self.inner);
  }

  // Unlocks the mutex. No-op (returns 0) if called before initialization.
  pub unlock() num {
    if self.initialized == false {
      ret 0;
    }
    ret pthread_mutex_unlock(&self.inner);
  }

  // Destroys the mutex. No-op (returns 0) if called before initialization.
  pub destroy() num {
    if self.initialized == false {
      ret 0;
    }
    let rc = pthread_mutex_destroy(&self.inner);
    if rc == 0 {
      self.initialized = false;
    }
    ret rc;
  }
}

impl CondVar {
  // Initializes the condition variable. Returns the pthread return code (0
  // on success).
  pub init() num {
    if self.initialized == true {
      ret 0;
    }
    let rc = pthread_cond_init(&self.inner, nil);
    if rc == 0 {
      self.initialized = true;
    }
    ret rc;
  }

  // True once initialized and not yet destroyed.
  pub is_initialized() bin {
    ret self.initialized;
  }

  // Waits on the condition variable, auto-initializing both it and `mutex`
  // on first use. Returns -1 when `mutex` is null.
  pub wait(Mutex* mutex) num {
    if self.initialized == false {
      let init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    if mutex == nil {
      ret -1;
    }
    if mutex.initialized == false {
      let m_rc = mutex.init();
      if m_rc != 0 {
        ret m_rc;
      }
    }
    ret pthread_cond_wait(&self.inner, &mutex.inner);
  }

  // Waits on the condition variable until the absolute timeout `abs_time`
  // (a `struct timespec*`, C semantics). Returns -1 when `mutex` is null,
  // -2 when `abs_time` is null.
  pub timed_wait(Mutex* mutex, raw* abs_time) num {
    if self.initialized == false {
      let init_rc = self.init();
      if init_rc != 0 {
        ret init_rc;
      }
    }
    if mutex == nil {
      ret -1;
    }
    if abs_time == nil {
      ret -2;
    }
    if mutex.initialized == false {
      let m_rc = mutex.init();
      if m_rc != 0 {
        ret m_rc;
      }
    }
    ret pthread_cond_timedwait(&self.inner, &mutex.inner, abs_time);
  }

  // Wakes one waiter. No-op (returns 0) if called before initialization.
  pub signal() num {
    if self.initialized == false {
      ret 0;
    }
    ret pthread_cond_signal(&self.inner);
  }

  // Wakes all waiters. No-op (returns 0) if called before initialization.
  pub broadcast() num {
    if self.initialized == false {
      ret 0;
    }
    ret pthread_cond_broadcast(&self.inner);
  }

  // Destroys the condition variable. No-op (returns 0) if called before
  // initialization.
  pub destroy() num {
    if self.initialized == false {
      ret 0;
    }
    let rc = pthread_cond_destroy(&self.inner);
    if rc == 0 {
      self.initialized = false;
    }
    ret rc;
  }
}

// Initializes a mutex via pointer helper. Returns -1 when `mutex` is null,
// otherwise the pthread return code.
pub fun mutex_init(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  if mutex.initialized == true {
    ret 0;
  }

  let rc = pthread_mutex_init(&mutex.inner, nil);
  if rc == 0 {
    mutex.initialized = true;
  }
  ret rc;
}

// Locks a mutex via pointer helper. Returns -1 when `mutex` is null,
// otherwise the pthread return code.
pub fun mutex_lock(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  if mutex.initialized == false {
    let init_rc = mutex_init(mutex);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  let rc = pthread_mutex_lock(&mutex.inner);
  ret rc;
}

// Tries to lock a mutex via pointer helper. Returns -1 when `mutex` is
// null, otherwise the pthread return code.
pub fun mutex_try_lock(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  if mutex.initialized == false {
    let init_rc = mutex_init(mutex);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  let rc = pthread_mutex_trylock(&mutex.inner);
  ret rc;
}

// Unlocks a mutex via pointer helper. Returns -1 when `mutex` is null,
// otherwise the pthread return code.
pub fun mutex_unlock(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  if mutex.initialized == false {
    ret 0;
  }

  let rc = pthread_mutex_unlock(&mutex.inner);
  ret rc;
}

// Destroys a mutex via pointer helper. Returns -1 when `mutex` is null,
// otherwise the pthread return code.
pub fun mutex_destroy(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  if mutex.initialized == false {
    ret 0;
  }

  let rc = pthread_mutex_destroy(&mutex.inner);
  if rc == 0 {
    mutex.initialized = false;
  }
  ret rc;
}

// Initializes a condition variable via pointer helper. Returns -1 when
// `cond` is null, otherwise the pthread return code.
pub fun condvar_init(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  if cond.initialized == true {
    ret 0;
  }

  let rc = pthread_cond_init(&cond.inner, nil);
  if rc == 0 {
    cond.initialized = true;
  }
  ret rc;
}

// Waits on a condition variable via pointer helper. Returns -1 when `cond`
// or `mutex` is null, otherwise the pthread return code.
pub fun condvar_wait(CondVar* cond, Mutex* mutex) num {
  if cond == nil || mutex == nil {
    ret -1;
  }

  if cond.initialized == false {
    let init_rc = condvar_init(cond);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  if mutex.initialized == false {
    let m_rc = mutex_init(mutex);
    if m_rc != 0 {
      ret m_rc;
    }
  }

  let rc = pthread_cond_wait(&cond.inner, &mutex.inner);
  ret rc;
}

// Timed wait on a condition variable via pointer helper. Returns -1 when
// `cond` or `mutex` is null, -2 when `abs_time` is null, otherwise the
// pthread return code.
pub fun condvar_timed_wait(CondVar* cond, Mutex* mutex, raw* abs_time) num {
  if cond == nil || mutex == nil {
    ret -1;
  }

  if abs_time == nil {
    ret -2;
  }

  if cond.initialized == false {
    let init_rc = condvar_init(cond);
    if init_rc != 0 {
      ret init_rc;
    }
  }

  if mutex.initialized == false {
    let m_rc = mutex_init(mutex);
    if m_rc != 0 {
      ret m_rc;
    }
  }

  let rc = pthread_cond_timedwait(&cond.inner, &mutex.inner, abs_time);
  ret rc;
}

// Wakes one waiter via pointer helper. Returns -1 when `cond` is null,
// otherwise the pthread return code.
pub fun condvar_signal(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  if cond.initialized == false {
    ret 0;
  }

  let rc = pthread_cond_signal(&cond.inner);
  ret rc;
}

// Wakes all waiters via pointer helper. Returns -1 when `cond` is null,
// otherwise the pthread return code.
pub fun condvar_broadcast(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  if cond.initialized == false {
    ret 0;
  }

  let rc = pthread_cond_broadcast(&cond.inner);
  ret rc;
}

// Destroys a condition variable via pointer helper. Returns -1 when `cond`
// is null, otherwise the pthread return code.
pub fun condvar_destroy(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  if cond.initialized == false {
    ret 0;
  }

  let rc = pthread_cond_destroy(&cond.inner);
  if rc == 0 {
    cond.initialized = false;
  }
  ret rc;
}
