// Windows synchronization backend implementation.
// 
// Notes:
// - This module defines the Windows backend contract used by std.sync_runtime.
// - It talks directly to pthread-shaped primitives from std.c.thread_windows.
// - Return codes follow the Windows compatibility backend.

imp std.c.thread_windows;
imp std.sync;

// Legacy compatibility function kept for API stability.
pub fun sync_backend_windows_unavailable() num {
  ret 0;
}

// Create a new Windows backend mutex.
pub fun sync_backend_windows_mutex_new() Mutex {
  Mutex m;
  m.initialized = false;
  ret m;
}

// Create a new Windows backend condition variable.
pub fun sync_backend_windows_condvar_new() CondVar {
  CondVar c;
  c.initialized = false;
  ret c;
}

// Initialize a Windows backend mutex.
// 
// Returns:
// - 0 on success
// - 0 when already initialized (no-op)
// - -1 when mutex is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_mutex_init(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  Mutex m = mutex[0];
  if m.initialized == true {
    ret 0;
  }

  num rc = pthread_mutex_init(&m.inner, nil);
  if rc == 0 {
    m.initialized = true;
  }
  mutex[0] = m;
  ret rc;
}

// Lock a Windows backend mutex.
// 
// Returns:
// - 0 on success
// - -1 when mutex is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_mutex_lock(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  Mutex m = mutex[0];
  if m.initialized == false {
    num init_rc = pthread_mutex_init(&m.inner, nil);
    if init_rc != 0 {
      ret init_rc;
    }
    m.initialized = true;
  }

  num rc = pthread_mutex_lock(&m.inner);
  mutex[0] = m;
  ret rc;
}

// Try lock a Windows backend mutex.
// 
// Returns:
// - 0 on success
// - -1 when mutex is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_mutex_try_lock(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  Mutex m = mutex[0];
  if m.initialized == false {
    num init_rc = pthread_mutex_init(&m.inner, nil);
    if init_rc != 0 {
      ret init_rc;
    }
    m.initialized = true;
  }

  num rc = pthread_mutex_trylock(&m.inner);
  mutex[0] = m;
  ret rc;
}

// Unlock a Windows backend mutex.
// 
// Returns:
// - 0 on success
// - 0 when uninitialized (no-op)
// - -1 when mutex is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_mutex_unlock(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  Mutex m = mutex[0];
  if m.initialized == false {
    ret 0;
  }

  num rc = pthread_mutex_unlock(&m.inner);
  mutex[0] = m;
  ret rc;
}

// Destroy a Windows backend mutex.
// 
// Returns:
// - 0 on success
// - 0 when uninitialized (no-op)
// - -1 when mutex is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_mutex_destroy(Mutex* mutex) num {
  if mutex == nil {
    ret -1;
  }

  Mutex m = mutex[0];
  if m.initialized == false {
    ret 0;
  }

  num rc = pthread_mutex_destroy(&m.inner);
  if rc == 0 {
    m.initialized = false;
  }
  mutex[0] = m;
  ret rc;
}

// Initialize a Windows backend condition variable.
// 
// Returns:
// - 0 on success
// - 0 when already initialized (no-op)
// - -1 when cond is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_condvar_init(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  CondVar c = cond[0];
  if c.initialized == true {
    ret 0;
  }

  num rc = pthread_cond_init(&c.inner, nil);
  if rc == 0 {
    c.initialized = true;
  }
  cond[0] = c;
  ret rc;
}

// Wait on a Windows backend condition variable.
// 
// Returns:
// - 0 on success
// - -1 when cond or mutex is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_condvar_wait(CondVar* cond, Mutex* mutex) num {
  if cond == nil || mutex == nil {
    ret -1;
  }

  CondVar c = cond[0];
  Mutex m = mutex[0];

  if c.initialized == false {
    num c_init_rc = pthread_cond_init(&c.inner, nil);
    if c_init_rc != 0 {
      cond[0] = c;
      ret c_init_rc;
    }
    c.initialized = true;
  }

  if m.initialized == false {
    num m_init_rc = pthread_mutex_init(&m.inner, nil);
    if m_init_rc != 0 {
      cond[0] = c;
      mutex[0] = m;
      ret m_init_rc;
    }
    m.initialized = true;
  }

  num rc = pthread_cond_wait(&c.inner, &m.inner);
  cond[0] = c;
  mutex[0] = m;
  ret rc;
}

// Timed wait on a Windows backend condition variable.
// 
// Returns:
// - 0 on success
// - -1 when cond or mutex is null
// - -2 when abs_time is null
// - nonzero backend error code on timeout/failure
pub fun sync_backend_windows_condvar_timed_wait(CondVar* cond, Mutex* mutex, raw* abs_time) num {
  if cond == nil || mutex == nil {
    ret -1;
  }
  if abs_time == nil {
    ret -2;
  }

  CondVar c = cond[0];
  Mutex m = mutex[0];

  if c.initialized == false {
    num c_init_rc = pthread_cond_init(&c.inner, nil);
    if c_init_rc != 0 {
      cond[0] = c;
      ret c_init_rc;
    }
    c.initialized = true;
  }

  if m.initialized == false {
    num m_init_rc = pthread_mutex_init(&m.inner, nil);
    if m_init_rc != 0 {
      cond[0] = c;
      mutex[0] = m;
      ret m_init_rc;
    }
    m.initialized = true;
  }

  num rc = pthread_cond_timedwait(&c.inner, &m.inner, abs_time);
  cond[0] = c;
  mutex[0] = m;
  ret rc;
}

// Signal one Windows backend condition variable waiter.
// 
// Returns:
// - 0 on success
// - 0 when uninitialized (no-op)
// - -1 when cond is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_condvar_signal(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  CondVar c = cond[0];
  if c.initialized == false {
    ret 0;
  }

  num rc = pthread_cond_signal(&c.inner);
  cond[0] = c;
  ret rc;
}

// Broadcast to all Windows backend condition variable waiters.
// 
// Returns:
// - 0 on success
// - 0 when uninitialized (no-op)
// - -1 when cond is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_condvar_broadcast(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  CondVar c = cond[0];
  if c.initialized == false {
    ret 0;
  }

  num rc = pthread_cond_broadcast(&c.inner);
  cond[0] = c;
  ret rc;
}

// Destroy a Windows backend condition variable.
// 
// Returns:
// - 0 on success
// - 0 when uninitialized (no-op)
// - -1 when cond is null
// - nonzero backend error code on failure
pub fun sync_backend_windows_condvar_destroy(CondVar* cond) num {
  if cond == nil {
    ret -1;
  }

  CondVar c = cond[0];
  if c.initialized == false {
    ret 0;
  }

  num rc = pthread_cond_destroy(&c.inner);
  if rc == 0 {
    c.initialized = false;
  }
  cond[0] = c;
  ret rc;
}
