// Typed JSON values.
//
// `JsonValue` is a data-carrying enum (sum type) modelling any JSON value: a null,
// boolean, number, string, array, or object. Parse text into one with `parse`, inspect
// it with the `as_*` accessors (each returns an `Option`), and render it back with
// `stringify` / `to_string`.
//
// ```
// fit parse("{\"name\": \"fun\", \"version\": 1}") {
//   Result.Ok(doc) -> {
//     let name = doc.get("name").unwrap_or(JsonValue.Null).as_str().unwrap_or("?");
//     print(name);
//   }
//   Result.Err(e) -> { log_error(e); }
// }
// ```

use std.map;
use std.vec;
use std.option;
use std.result;
use std.error;
use std.string;
use std.math;
use std.quirks;
use std.c.mem;

// Any JSON value. Arrays and objects nest recursively.
pub enum JsonValue {
  Null,
  Bool(flag),
  // JSON numbers are decimals; integer-looking values still round-trip as integers.
  Num(dec),
  Str(str),
  Array(Vec<JsonValue>),
  Object(Map<str, JsonValue>),
}

impl JsonValue {
  // Return true when this value is JSON null.
  pub is_null() flag {
    fit *self {
      .Null -> { ret true; }
      _ -> { ret false; }
    }
    ret false;
  }

  // Return true when this value is a JSON boolean.
  pub is_bool() flag {
    fit *self {
      .Bool(b) -> { ret true; }
      _ -> { ret false; }
    }
    ret false;
  }

  // Return true when this value is a JSON number.
  pub is_num() flag {
    fit *self {
      .Num(n) -> { ret true; }
      _ -> { ret false; }
    }
    ret false;
  }

  // Return true when this value is a JSON string.
  pub is_str() flag {
    fit *self {
      .Str(s) -> { ret true; }
      _ -> { ret false; }
    }
    ret false;
  }

  // Return true when this value is a JSON array.
  pub is_array() flag {
    fit *self {
      .Array(a) -> { ret true; }
      _ -> { ret false; }
    }
    ret false;
  }

  // Return true when this value is a JSON object.
  pub is_object() flag {
    fit *self {
      .Object(o) -> { ret true; }
      _ -> { ret false; }
    }
    ret false;
  }

  // Return the boolean contents, or None when this is not a Bool.
  pub as_bool() Option<flag> {
    fit *self {
      .Bool(b) -> { ret .Some(b); }
      _ -> { ret .None; }
    }
    ret .None;
  }

  // Return the numeric contents, or None when this is not a Num.
  pub as_num() Option<dec> {
    fit *self {
      .Num(n) -> { ret .Some(n); }
      _ -> { ret .None; }
    }
    ret .None;
  }

  // Return the string contents, or None when this is not a Str.
  pub as_str() Option<str> {
    fit *self {
      .Str(s) -> { ret .Some(s); }
      _ -> { ret .None; }
    }
    ret .None;
  }

  // Return the array elements, or None when this is not an Array. The
  // returned Vec shares its elements with the original and should be
  // treated as read-only.
  pub as_array() Option<Vec<JsonValue>> {
    fit *self {
      .Array(a) -> { ret .Some(a); }
      _ -> { ret .None; }
    }
    ret .None;
  }

  // Return the object as a Map, or None when this is not an Object. The
  // returned Map shares its entries with the original and should be treated
  // as read-only; use `m.values().data` to iterate values or `m.keys()` for keys.
  pub as_object() Option<Map<str, JsonValue>> {
    fit *self {
      .Object(o) -> { ret .Some(o); }
      _ -> { ret .None; }
    }
    ret .None;
  }

  // Look up `key` on an object value; `None` if missing or not an object.
  pub get(str key) Option<JsonValue> {
    fit *self {
      .Object(o) -> { ret o.at(key); }
      _ -> { ret .None; }
    }
    ret .None;
  }

  // Return the element at array index `i`; `None` if out of range or not an array.
  pub index(num i) Option<JsonValue> {
    fit *self {
      .Array(a) -> { ret a.at(i); }
      _ -> { ret .None; }
    }
    ret .None;
  }

  // Return the logical length: entry count for Object, element count for
  // Array, or 0 for scalar values.
  pub len() num {
    fit *self {
      .Array(a) -> { ret a.len(); }
      .Object(o) -> { ret o.len(); }
      _ -> { ret 0; }
    }
    ret 0;
  }

  // Frees everything this value owns: a Str's own text, or (recursively)
  // every Array element or Object key and value. Safe unconditionally -
  // parse() never produces a Str whose text is a slice of the original
  // source or a literal, always a fresh StringBuilder.build() copy, and
  // the same is true of every Object key.
  pub free() {
    fit *self {
      .Str(s) -> { free(s); }
      .Array(a) -> {
        for v : a {
          v.free();
        }
        a.free();
      }
      .Object(o) -> {
        Vec<str> ks = o.keys();
        for k : ks {
          let v = o.at(k);
          if v.is_some() {
            JsonValue vv = v.unwrap();
            vv.free();
          }
        }
        // Keys are the map's own lookup keys: free them only after every
        // value has been looked up.
        for k : ks {
          free(k);
        }
        ks.free();
        o.free();
      }
      _ -> {}
    }
  }
}

// --- Convenience constructors --------------------------------------------------------

// Create a JSON number from a decimal.
pub fun json_num(dec n) JsonValue {
  ret JsonValue.Num(n);
}

// Create a JSON string.
pub fun json_str(str s) JsonValue {
  ret JsonValue.Str(s);
}

// Create a JSON boolean.
pub fun json_bool(flag b) JsonValue {
  ret JsonValue.Bool(b);
}

// Create an empty JSON object map, ready to wrap as `JsonValue.Object`.
pub fun json_object() Map<str, JsonValue> {
  Map<str, JsonValue> m;
  m.init(8);
  ret m;
}

// Create an empty JSON array vector, ready to wrap as `JsonValue.Array`.
pub fun json_array() Vec<JsonValue> {
  Vec<JsonValue> v;
  v.init(8);
  ret v;
}

// --- Serialization (stringify) -------------------------------------------------------

fun _append_escaped(StringBuilder* b, str s) {
  num i = 0;
  for s[i] != 0 {
    let c = s[i];
    if c == '"' {
      b.append_char('\\');
      b.append_char('"');
    } elif c == '\\' {
      b.append_char('\\');
      b.append_char('\\');
    } elif c == '\n' {
      b.append_char('\\');
      b.append_char('n');
    } elif c == '\t' {
      b.append_char('\\');
      b.append_char('t');
    } else {
      b.append_char(c);
    }
    i = i + 1;
  }
}

fun _append_value(StringBuilder* b, JsonValue* v) {
  fit *v {
    .Null -> { b.append("null"); }
    .Bool(x) -> {
      if x {
        b.append("true");
      } else {
        b.append("false");
      }
    }
    .Num(n) -> {
      // Render integer-valued decimals without a fractional part (42, not 42.000000).
      if trunc_dec(n) == n {
        b.append_dec(n, 0);
      } else {
        b.append_dec(n, 6);
      }
    }
    .Str(s) -> {
      b.append_char('"');
      _append_escaped(b, s);
      b.append_char('"');
    }
    .Array(a) -> {
      b.append_char('[');
      num i = 0;
      for i < a.len() {
        if i > 0 {
          b.append(", ");
        }
        let elem = a.get(i);
        _append_value(b, &elem);
        i = i + 1;
      }
      b.append_char(']');
    }
    .Object(o) -> {
      b.append_char('{');
      let keys = o.keys();
      defer keys.free();
      num i = 0;
      for i < keys.len() {
        if i > 0 {
          b.append(", ");
        }
        let key = keys.get(i);
        b.append_char('"');
        _append_escaped(b, key);
        b.append("\": ");
        let val = o.get(key);
        _append_value(b, &val);
        i = i + 1;
      }
      b.append_char('}');
    }
  }
}

impl JsonValue as Display {
  // Render this value as compact JSON text.
  pub to_string() str {
    let b = string_builder_init(32);
    _append_value(&b, self);
    let out = b.build();
    b.free();
    ret out;
  }
}

impl JsonValue {
  // Render this value as compact JSON text (same as `to_string`).
  pub stringify() str {
    ret self.to_string();
  }
}

// --- Parsing (recursive descent) -----------------------------------------------------

fun _json_is_digit(chr c) flag {
  ret c >= '0' && c <= '9';
}

// A character that can appear inside a JSON number literal.
fun _json_is_number_char(chr c) flag {
  if _json_is_digit(c) {
    ret true;
  }
  ret c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E';
}

// True when `text` is a number as JSON's grammar writes it: an optional minus,
// a whole part with no leading zero, an optional fraction, an optional
// exponent. `-`, `01`, `1.` and `.5` are not numbers.
fun _json_valid_number(str text) flag {
  num i = 0;
  if text[i] == '-' {
    i = i + 1;
  }
  if !_json_is_digit(text[i]) {
    ret false;
  }
  if text[i] == '0' {
    i = i + 1;
  } else {
    for _json_is_digit(text[i]) {
      i = i + 1;
    }
  }
  if text[i] == '.' {
    i = i + 1;
    if !_json_is_digit(text[i]) {
      ret false;
    }
    for _json_is_digit(text[i]) {
      i = i + 1;
    }
  }
  if text[i] == 'e' || text[i] == 'E' {
    i = i + 1;
    if text[i] == '+' || text[i] == '-' {
      i = i + 1;
    }
    if !_json_is_digit(text[i]) {
      ret false;
    }
    for _json_is_digit(text[i]) {
      i = i + 1;
    }
  }
  ret text[i] == 0;
}

// Cursor state threaded through the parser: the source plus the current offset.
pub compound JsonParser {
  str src;
  num pos;
}

impl JsonParser {
  skip_ws() {
    for true {
      let c = self.src[self.pos];
      if c == ' ' || c == '\n' || c == '\t' || c == '\r' {
        self.pos = self.pos + 1;
      } else {
        ret;
      }
    }
  }

  peek() chr {
    ret self.src[self.pos];
  }

  // Parse a JSON string literal (assumes the opening quote is current).
  parse_string() Result<str, Error> {
    if self.peek() != '"' {
      ret err_kind(.Parse, "expected '\"'", "");
    }
    self.pos = self.pos + 1;
    let b = string_builder_init(16);
    for true {
      let c = self.src[self.pos];
      if c == 0 {
        b.free();
        ret err_kind(.Parse, "unterminated string", "");
      }
      if c == '"' {
        self.pos = self.pos + 1;
        let out = b.build();
        b.free();
        ret .Ok(out);
      }
      if c == '\\' {
        self.pos = self.pos + 1;
        let e = self.src[self.pos];
        if e == 'n' {
          b.append_char('\n');
        } elif e == 't' {
          b.append_char('\t');
        } elif e == '"' {
          b.append_char('"');
        } elif e == '\\' {
          b.append_char('\\');
        } elif e == 'r' {
          b.append_char('\r');
        } else {
          b.append_char(e);
        }
        self.pos = self.pos + 1;
      } else {
        b.append_char(c);
        self.pos = self.pos + 1;
      }
    }
    b.free();
    ret err_kind(.Parse, "unterminated string", "");
  }

  // Collect the raw text of a number literal (caller converts with parse_dec).
  parse_number_text() str {
    let start = self.pos;
    for _json_is_number_char(self.src[self.pos]) {
      self.pos = self.pos + 1;
    }
    ret substr(self.src, start, self.pos - start);
  }

  // Does the source at the cursor start with `word`?
  starts_with(str word) flag {
    num i = 0;
    for word[i] != 0 {
      if self.src[self.pos + i] != word[i] {
        ret false;
      }
      i = i + 1;
    }
    ret true;
  }

  parse_value() Result<JsonValue, Error> {
    self.skip_ws();
    let c = self.peek();

    if c == '{' {
      ret self.parse_object();
    }
    if c == '[' {
      ret self.parse_array();
    }
    if c == '"' {
      fit self.parse_string() {
        .Ok(s) -> { ret .Ok(JsonValue.Str(s)); }
        .Err(e) -> { ret err_error(e, JsonValue.Null); }
      }
    }
    if self.starts_with("true") {
      self.pos = self.pos + 4;
      ret .Ok(JsonValue.Bool(true));
    }
    if self.starts_with("false") {
      self.pos = self.pos + 5;
      ret .Ok(JsonValue.Bool(false));
    }
    if self.starts_with("null") {
      self.pos = self.pos + 4;
      ret .Ok(JsonValue.Null);
    }
    if _json_is_digit(c) || c == '-' {
      let numtext = self.parse_number_text();
      if !_json_valid_number(numtext) {
        free(numtext);
        ret err_kind(.Parse, "invalid number in JSON", JsonValue.Null);
      }
      let n = parse_dec(numtext);
      free(numtext);
      ret .Ok(JsonValue.Num(n));
    }
    ret err_kind(.Parse, "unexpected character in JSON", JsonValue.Null);
  }

  parse_array() Result<JsonValue, Error> {
    self.pos = self.pos + 1;
    Vec<JsonValue> items;
    items.init(8);
    self.skip_ws();
    if self.peek() == ']' {
      self.pos = self.pos + 1;
      ret .Ok(JsonValue.Array(items));
    }
    for true {
      fit self.parse_value() {
        .Ok(v) -> { items.push(v); }
        .Err(e) -> {
          items.free();
          ret err_error(e, JsonValue.Null);
        }
      }
      self.skip_ws();
      let c = self.peek();
      if c == ',' {
        self.pos = self.pos + 1;
      } elif c == ']' {
        self.pos = self.pos + 1;
        ret .Ok(JsonValue.Array(items));
      } else {
        items.free();
        ret err_kind(.Parse, "expected ',' or ']' in array", JsonValue.Null);
      }
    }
    ret .Ok(JsonValue.Array(items));
  }

  parse_object() Result<JsonValue, Error> {
    self.pos = self.pos + 1;
    Map<str, JsonValue> entries;
    entries.init(8);
    self.skip_ws();
    if self.peek() == '}' {
      self.pos = self.pos + 1;
      ret .Ok(JsonValue.Object(entries));
    }
    for true {
      self.skip_ws();
      str key = "";
      fit self.parse_string() {
        .Ok(k) -> { key = k; }
        .Err(e) -> {
          entries.free();
          ret err_error(e, JsonValue.Null);
        }
      }
      self.skip_ws();
      if self.peek() != ':' {
        entries.free();
        ret err_kind(.Parse, "expected ':' in object", JsonValue.Null);
      }
      self.pos = self.pos + 1;
      fit self.parse_value() {
        .Ok(v) -> { entries.put(key, v); }
        .Err(e) -> {
          entries.free();
          ret err_error(e, JsonValue.Null);
        }
      }
      self.skip_ws();
      let c = self.peek();
      if c == ',' {
        self.pos = self.pos + 1;
      } elif c == '}' {
        self.pos = self.pos + 1;
        ret .Ok(JsonValue.Object(entries));
      } else {
        entries.free();
        ret err_kind(.Parse, "expected ',' or '}' in object", JsonValue.Null);
      }
    }
    ret .Ok(JsonValue.Object(entries));
  }
}

// Parse JSON text into a typed `JsonValue`. Returns `Err` on malformed input.
pub fun parse(str src) Result<JsonValue, Error> {
  let p = JsonParser{src = src, pos = 0};
  let value = p.parse_value();
  if value.is_err() {
    ret value;
  }
  p.skip_ws();
  if p.pos < len(src) {
    JsonValue parsed = value.unwrap();
    parsed.free();
    ret err_kind(.Parse, "unexpected text after the JSON value", JsonValue.Null);
  }
  ret value;
}

// A `JsonValue` serializes to its JSON text (the text-layer conversion, same
// `To<T>` mechanism std.serde's `to_string()` dispatches through).
impl JsonValue as To<str> {
  pub to() str {
    ret self.to_string();
  }
}

// --- Structured (de)serialization for your own compounds -----------------------------

// Convert your own compounds to/from a structured `JsonValue` with the generic
// `std.quirks.To<T>`/`From<T>` quirks. Fun has no reflection/derive, so
// implement these by hand — the explicit equivalent of a derived serializer:
//
// ```
// impl Point as To<JsonValue> {
//   pub to() JsonValue {
//     let o = json_object();
//     o.put("x", json_num(self.x));
//     o.put("y", json_num(self.y));
//     ret JsonValue.Object(o);
//   }
// }
//
// impl Point as From<JsonValue> {
//   pub from(JsonValue value) {
//     let x = value.get("x").unwrap_or(JsonValue.Null);
//     self.x = x.as_num().unwrap_or(0.0);
//     let y = value.get("y").unwrap_or(JsonValue.Null);
//     self.y = y.as_num().unwrap_or(0.0);
//   }
// }
// ```
//
// Dispatch directly (`p.to()`, `back.from(doc)`) or through the free-function
// wrappers below, which accept any `To<JsonValue>` implementer via a quirk-typed
// parameter.

// Convert any `To<JsonValue>` implementer into a `JsonValue`.
pub fun to_json_value(To<JsonValue> value) JsonValue {
  ret value.to();
}

// Serialize any `To<JsonValue>` implementer straight to JSON text.
pub fun to_json_string(To<JsonValue> value) str {
  let v = value.to();
  ret v.to_string();
}

test "parse reads scalars and their accessors" {
  let n = parse("null");
  assert n.is_ok() && n.unwrap().is_null(), "expected null";
  let t = parse("true");
  assert t.is_ok() && t.unwrap().is_bool() && t.unwrap().as_bool().unwrap(), "expected true";
  let f = parse(" false ");
  assert f.is_ok() && !f.unwrap().as_bool().unwrap(), "expected false with surrounding spaces";
  let i = parse("42");
  assert i.is_ok() && i.unwrap().is_num() &&
    i.unwrap().as_num().unwrap() == 42.0, "expected 42";
  let neg = parse("-7.5");
  assert neg.is_ok() && neg.unwrap().as_num().unwrap() == -7.5, "expected a negative decimal";
  let exp = parse("1e3");
  assert exp.is_ok() && exp.unwrap().as_num().unwrap() == 1000.0, "expected an exponent";
  let s = parse("\"hi\"");
  assert s.is_ok() && s.unwrap().is_str() &&
    equals(s.unwrap().as_str().unwrap(), "hi"), "expected a string";
  assert !s.unwrap().is_num() && s.unwrap().as_num().is_none(), "expected a string not to read as a number";
}

test "parse decodes string escapes" {
  let r = parse("\"a\\nb\\t\\\"q\\\" \\\\ \\/ \"");
  assert r.is_ok(), "expected the escapes to parse";
  str got = r.unwrap().as_str().unwrap();
  assert equals(got, "a\nb\t\"q\" \\ / "), "expected each escape decoded";
}

test "parse reads arrays and objects, and they can be indexed" {
  let a = parse("[1, \"two\", [3], {\"k\": true}]");
  assert a.is_ok() && a.unwrap().is_array(), "expected an array";
  JsonValue arr = a.unwrap();
  assert arr.len() == 4, "expected four elements";
  assert arr.index(0).unwrap().as_num().unwrap() == 1.0, "expected the first element";
  assert equals(arr.index(1).unwrap().as_str().unwrap(), "two"), "expected the second element";
  assert arr.index(2).unwrap().len() == 1, "expected a nested array";
  assert arr.index(3).unwrap().get("k").unwrap().as_bool().unwrap(), "expected a nested object member";
  assert arr.index(4).is_none() && arr.index(-1).is_none(), "expected out-of-range indexes to be None";

  let o = parse("{\"name\": \"fun\", \"n\": 3}");
  assert o.is_ok() && o.unwrap().is_object(), "expected an object";
  JsonValue obj = o.unwrap();
  assert obj.len() == 2, "expected two members";
  assert equals(obj.get("name").unwrap().as_str().unwrap(), "fun"), "expected a member by key";
  assert obj.get("absent").is_none(), "expected a missing key to be None";
  assert obj.as_object().is_some() && obj.as_array().is_none(), "expected the object view and no array view";
  assert arr.as_array().is_some() && arr.as_object().is_none(), "expected the array view and no object view";
}

test "empty arrays and objects parse and stringify" {
  let a = parse("[]");
  assert a.is_ok() && a.unwrap().len() == 0, "expected an empty array";
  assert equals(a.unwrap().stringify(), "[]"), "expected [] back";
  let o = parse("{}");
  assert o.is_ok() && o.unwrap().len() == 0, "expected an empty object";
  assert equals(o.unwrap().stringify(), "{}"), "expected {} back";
}

test "malformed input is an error, not a guess" {
  assert parse("").is_err(), "expected empty text to fail";
  assert parse("{").is_err(), "expected an unclosed object to fail";
  assert parse("[1,").is_err(), "expected an unfinished array to fail";
  assert parse("tru").is_err(), "expected a truncated literal to fail";
  assert parse("\"abc").is_err(), "expected an unterminated string to fail";
  assert parse("{\"a\" 1}").is_err(), "expected a missing colon to fail";
  assert parse("{a: 1}").is_err(), "expected an unquoted key to fail";
  assert parse("[1] x").is_err(), "expected trailing text to fail";
  assert parse("-").is_err(), "expected a bare minus to fail";
}

test "stringify output parses back to the same text" {
  let a = parse("[1,2.5,\"x\",true,null,[],{\"k\":[1]}]");
  assert a.is_ok(), "expected the array to parse";
  str text = a.unwrap().stringify();
  assert equals(text, "[1, 2.500000, \"x\", true, null, [], {\"k\": [1]}]"), "expected the array rendered with its separators";
  let again = parse(text);
  assert again.is_ok() && equals(again.unwrap().to_string(), text), "expected a stable round trip";
}

test "stringify escapes what JSON requires" {
  JsonValue v = json_str("a\"b\\c\nd\te");
  assert equals(v.to_string(), "\"a\\\"b\\\\c\\nd\\te\""), "expected quotes, backslashes and control characters escaped";
}

test "values can be built by hand and rendered" {
  let o = json_object();
  o.put("n", json_num(3.0));
  o.put("ok", json_bool(true));
  JsonValue obj = JsonValue.Object(o);
  assert equals(obj.get("n").unwrap().to_string(), "3"), "expected a whole number without a decimal point";
  assert equals(obj.get("ok").unwrap().to_string(), "true"), "expected true";
  let arr = json_array();
  arr.push(json_str("a"));
  arr.push(JsonValue.Null);
  JsonValue list = JsonValue.Array(arr);
  assert equals(list.to_string(), "[\"a\", null]"), "expected the array rendered in order";
}

test "a JsonValue converts to its text through To<str>" {
  JsonValue v = json_bool(false);
  assert equals(v.to(), "false"), "expected the text of the value";
}

test "a document with Windows line endings parses" {
  let r = parse("{\r\n  \"a\": [1,\r\n 2]\r\n}\r\n");
  assert r.is_ok(), "expected carriage returns to count as whitespace";
  assert r.unwrap().get("a").unwrap().len() == 2, "expected both elements";
}

test "numbers must follow JSON's grammar" {
  assert parse("-").is_err(), "expected a bare minus to fail";
  assert parse("01").is_err(), "expected a leading zero to fail";
  assert parse("1.").is_err(), "expected a dangling decimal point to fail";
  assert parse("1e").is_err(), "expected a dangling exponent to fail";
  assert parse("1e+").is_err(), "expected a signed but empty exponent to fail";
  assert parse("--1").is_err(), "expected a doubled minus to fail";
  assert parse("0").is_ok() && parse("-0.5").is_ok() && parse("2E-3").is_ok() &&
    parse("10").is_ok(), "expected valid numbers to parse";
  }
