// Typed JSON values.
// 
// `JsonValue` is a data-carrying enum (sum type) modelling any JSON value: a null,
// boolean, number, string, array, or object. Parse text into one with `parse`, inspect
// it with the `as_*` accessors (each returns an `Option`), and render it back with
// `stringify` / `to_string`.
// 
// ```
// fit parse("{\"name\": \"fun\", \"version\": 1}") {
//   Result.Ok(doc) -> {
//     let name = doc.get("name").unwrap_or(JsonValue.Null).as_str().unwrap_or("?");
//     print(name);
//   }
//   Result.Err(e) -> { log_error(e); }
// }
// ```

imp std.map;
imp std.vec;
imp std.option;
imp std.result;
imp std.string;
imp std.math;
imp std.quirks;
imp std.serde;

// Any JSON value. Arrays and objects nest recursively.
pub enum JsonValue {
  Null,
  Bool(bin),
  // JSON numbers are decimals; integer-looking values still round-trip as integers.
  Num(dec),
  Str(str),
  Array(Vec<JsonValue>),
  Object(Map<str, JsonValue>),
}

impl JsonValue {
  // True when this value is JSON null.
  pub is_null() bin {
    fit *self {
      .Null -> { ret true; }
      .Bool(b) -> { ret false; }
      .Num(n) -> { ret false; }
      .Str(s) -> { ret false; }
      .Array(a) -> { ret false; }
      .Object(o) -> { ret false; }
    }
    ret false;
  }

  // True when this value is a JSON boolean.
  pub is_bool() bin {
    fit *self {
      .Bool(b) -> { ret true; }
      .Null -> { ret false; }
      .Num(n) -> { ret false; }
      .Str(s) -> { ret false; }
      .Array(a) -> { ret false; }
      .Object(o) -> { ret false; }
    }
    ret false;
  }

  // True when this value is a JSON number.
  pub is_num() bin {
    fit *self {
      .Num(n) -> { ret true; }
      .Null -> { ret false; }
      .Bool(b) -> { ret false; }
      .Str(s) -> { ret false; }
      .Array(a) -> { ret false; }
      .Object(o) -> { ret false; }
    }
    ret false;
  }

  // True when this value is a JSON string.
  pub is_str() bin {
    fit *self {
      .Str(s) -> { ret true; }
      .Null -> { ret false; }
      .Bool(b) -> { ret false; }
      .Num(n) -> { ret false; }
      .Array(a) -> { ret false; }
      .Object(o) -> { ret false; }
    }
    ret false;
  }

  // True when this value is a JSON array.
  pub is_array() bin {
    fit *self {
      .Array(a) -> { ret true; }
      .Null -> { ret false; }
      .Bool(b) -> { ret false; }
      .Num(n) -> { ret false; }
      .Str(s) -> { ret false; }
      .Object(o) -> { ret false; }
    }
    ret false;
  }

  // True when this value is a JSON object.
  pub is_object() bin {
    fit *self {
      .Object(o) -> { ret true; }
      .Null -> { ret false; }
      .Bool(b) -> { ret false; }
      .Num(n) -> { ret false; }
      .Str(s) -> { ret false; }
      .Array(a) -> { ret false; }
    }
    ret false;
  }

  // The boolean, or None when this is not a Bool.
  pub as_bool() Option<bin> {
    fit *self {
      .Bool(b) -> { ret Option.Some(b); }
      .Null -> { ret Option.None; }
      .Num(n) -> { ret Option.None; }
      .Str(s) -> { ret Option.None; }
      .Array(a) -> { ret Option.None; }
      .Object(o) -> { ret Option.None; }
    }
    ret Option.None;
  }

  // The number (as a dec), or None when this is not a Num.
  pub as_num() Option<dec> {
    fit *self {
      .Num(n) -> { ret Option.Some(n); }
      .Null -> { ret Option.None; }
      .Bool(b) -> { ret Option.None; }
      .Str(s) -> { ret Option.None; }
      .Array(a) -> { ret Option.None; }
      .Object(o) -> { ret Option.None; }
    }
    ret Option.None;
  }

  // The string, or None when this is not a Str.
  pub as_str() Option<str> {
    fit *self {
      .Str(s) -> { ret Option.Some(s); }
      .Null -> { ret Option.None; }
      .Bool(b) -> { ret Option.None; }
      .Num(n) -> { ret Option.None; }
      .Array(a) -> { ret Option.None; }
      .Object(o) -> { ret Option.None; }
    }
    ret Option.None;
  }

  // The array elements, or None when this is not an Array. The Vec is a copy of the
  // header (its elements are shared); treat it as read-only.
  pub as_array() Option<Vec<JsonValue>> {
    fit *self {
      .Array(a) -> { ret Option.Some(a); }
      .Null -> { ret Option.None; }
      .Bool(b) -> { ret Option.None; }
      .Num(n) -> { ret Option.None; }
      .Str(s) -> { ret Option.None; }
      .Object(o) -> { ret Option.None; }
    }
    ret Option.None;
  }

  // Look up a key on an Object: Some(value) when present, None otherwise (also None
  // when this value is not an Object).
  pub get(str key) Option<JsonValue> {
    fit *self {
      .Object(o) -> { ret o.at(key); }
      .Null -> { ret Option.None; }
      .Bool(b) -> { ret Option.None; }
      .Num(n) -> { ret Option.None; }
      .Str(s) -> { ret Option.None; }
      .Array(a) -> { ret Option.None; }
    }
    ret Option.None;
  }

  // The element at array index `i`: Some(value) in range, None otherwise (also None
  // when this value is not an Array).
  pub index(num i) Option<JsonValue> {
    fit *self {
      .Array(a) -> { ret a.at(i); }
      .Null -> { ret Option.None; }
      .Bool(b) -> { ret Option.None; }
      .Num(n) -> { ret Option.None; }
      .Str(s) -> { ret Option.None; }
      .Object(o) -> { ret Option.None; }
    }
    ret Option.None;
  }

  // Number of entries (Object) or elements (Array); 0 for scalars.
  pub len() num {
    fit *self {
      .Array(a) -> { ret a.len(); }
      .Object(o) -> { ret o.len(); }
      .Null -> { ret 0; }
      .Bool(b) -> { ret 0; }
      .Num(n) -> { ret 0; }
      .Str(s) -> { ret 0; }
    }
    ret 0;
  }
}

// --- Convenience constructors --------------------------------------------------------

// A JSON number from a decimal.
pub fun json_num(dec n) JsonValue {
  ret JsonValue.Num(n);
}

// A JSON string.
pub fun json_str(str s) JsonValue {
  ret JsonValue.Str(s);
}

// A JSON boolean.
pub fun json_bool(bin b) JsonValue {
  ret JsonValue.Bool(b);
}

// An empty JSON object map you can fill with `put`, then wrap as `JsonValue.Object`.
pub fun json_object() Map<str, JsonValue> {
  Map<str, JsonValue> m;
  m.init(8);
  ret m;
}

// An empty JSON array vector you can fill with `push`, then wrap as `JsonValue.Array`.
pub fun json_array() Vec<JsonValue> {
  Vec<JsonValue> v;
  v.init(8);
  ret v;
}

// --- Serialization (stringify) -------------------------------------------------------

fun _append_escaped(StringBuilder* b, str s) {
  num i = 0;
  for s[i] != 0 {
    chr c = s[i];
    if c == '"' {
      b.append_char('\\');
      b.append_char('"');
    } elif c == '\\' {
      b.append_char('\\');
      b.append_char('\\');
    } elif c == '\n' {
      b.append_char('\\');
      b.append_char('n');
    } elif c == '\t' {
      b.append_char('\\');
      b.append_char('t');
    } else {
      b.append_char(c);
    }
    i = i + 1;
  }
}

fun _append_value(StringBuilder* b, JsonValue* v) {
  fit *v {
    .Null -> { b.append("null"); }
    .Bool(x) -> {
      if x {
        b.append("true");
      } else {
        b.append("false");
      }
    }
    .Num(n) -> {
      // Render integer-valued decimals without a fractional part (42, not 42.000000).
      if trunc_dec(n) == n {
        b.append_dec(n, 0);
      } else {
        b.append_dec(n, 6);
      }
    }
    .Str(s) -> {
      b.append_char('"');
      _append_escaped(b, s);
      b.append_char('"');
    }
    .Array(a) -> {
      b.append_char('[');
      num i = 0;
      for i < a.len() {
        if i > 0 {
          b.append(", ");
        }
        let elem = a.get(i);
        _append_value(b, &elem);
        i = i + 1;
      }
      b.append_char(']');
    }
    .Object(o) -> {
      b.append_char('{');
      let keys = o.keys();
      defer keys.free();
      num i = 0;
      for i < keys.len() {
        if i > 0 {
          b.append(", ");
        }
        let key = keys.get(i);
        b.append_char('"');
        _append_escaped(b, key);
        b.append("\": ");
        let val = o.get(key);
        _append_value(b, &val);
        i = i + 1;
      }
      b.append_char('}');
    }
  }
}

impl JsonValue as Display {
  // Render this value as compact JSON text.
  pub to_string() str {
    StringBuilder b = string_builder_init(32);
    _append_value(&b, self);
    str out = b.build();
    b.free();
    ret out;
  }
}

impl JsonValue {
  // Render this value as compact JSON text (same as `to_string`).
  pub stringify() str {
    ret self.to_string();
  }
}

// --- Parsing (recursive descent) -----------------------------------------------------

fun _json_is_digit(chr c) bin {
  ret c >= '0' && c <= '9';
}

// A character that can appear inside a JSON number literal.
fun _json_is_number_char(chr c) bin {
  if _json_is_digit(c) {
    ret true;
  }
  ret c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E';
}

// Cursor state threaded through the parser: the source plus the current offset.
pub compound JsonParser {
  str src;
  num pos;
}

impl JsonParser {
  skip_ws() {
    for true {
      chr c = self.src[self.pos];
      if c == ' ' || c == '\n' || c == '\t' {
        self.pos = self.pos + 1;
      } else {
        ret;
      }
    }
  }

  peek() chr {
    ret self.src[self.pos];
  }

  // Parse a JSON string literal (assumes the opening quote is current).
  parse_string() Result<str> {
    if self.peek() != '"' {
      ret err(1, "expected '\"'", "");
    }
    self.pos = self.pos + 1;
    StringBuilder b = string_builder_init(16);
    for true {
      chr c = self.src[self.pos];
      if c == 0 {
        b.free();
        ret err(1, "unterminated string", "");
      }
      if c == '"' {
        self.pos = self.pos + 1;
        str out = b.build();
        b.free();
        ret ok(out);
      }
      if c == '\\' {
        self.pos = self.pos + 1;
        chr e = self.src[self.pos];
        if e == 'n' {
          b.append_char('\n');
        } elif e == 't' {
          b.append_char('\t');
        } elif e == '"' {
          b.append_char('"');
        } elif e == '\\' {
          b.append_char('\\');
        } else {
          b.append_char(e);
        }
        self.pos = self.pos + 1;
      } else {
        b.append_char(c);
        self.pos = self.pos + 1;
      }
    }
    b.free();
    ret err(1, "unterminated string", "");
  }

  // Collect the raw text of a number literal (caller converts with parse_dec).
  parse_number_text() str {
    num start = self.pos;
    for _json_is_number_char(self.src[self.pos]) {
      self.pos = self.pos + 1;
    }
    ret substr(self.src, start, self.pos - start);
  }

  // Does the source at the cursor start with `word`?
  starts_with(str word) bin {
    num i = 0;
    for word[i] != 0 {
      if self.src[self.pos + i] != word[i] {
        ret false;
      }
      i = i + 1;
    }
    ret true;
  }

  parse_value() Result<JsonValue> {
    self.skip_ws();
    chr c = self.peek();

    if c == '{' {
      ret self.parse_object();
    }
    if c == '[' {
      ret self.parse_array();
    }
    if c == '"' {
      fit self.parse_string() {
        Result.Ok(s) -> { ret ok(JsonValue.Str(s)); }
        Result.Err(e) -> { ret err_error(e, JsonValue.Null); }
      }
    }
    if self.starts_with("true") {
      self.pos = self.pos + 4;
      ret ok(JsonValue.Bool(true));
    }
    if self.starts_with("false") {
      self.pos = self.pos + 5;
      ret ok(JsonValue.Bool(false));
    }
    if self.starts_with("null") {
      self.pos = self.pos + 4;
      ret ok(JsonValue.Null);
    }
    if _json_is_digit(c) || c == '-' {
      str numtext = self.parse_number_text();
      ret ok(JsonValue.Num(parse_dec(numtext)));
    }
    ret err(1, "unexpected character in JSON", JsonValue.Null);
  }

  parse_array() Result<JsonValue> {
    self.pos = self.pos + 1;
    Vec<JsonValue> items;
    items.init(8);
    self.skip_ws();
    if self.peek() == ']' {
      self.pos = self.pos + 1;
      ret ok(JsonValue.Array(items));
    }
    for true {
      fit self.parse_value() {
        Result.Ok(v) -> { items.push(v); }
        Result.Err(e) -> {
          items.free();
          ret err_error(e, JsonValue.Null);
        }
      }
      self.skip_ws();
      chr c = self.peek();
      if c == ',' {
        self.pos = self.pos + 1;
      } elif c == ']' {
        self.pos = self.pos + 1;
        ret ok(JsonValue.Array(items));
      } else {
        items.free();
        ret err(1, "expected ',' or ']' in array", JsonValue.Null);
      }
    }
    ret ok(JsonValue.Array(items));
  }

  parse_object() Result<JsonValue> {
    self.pos = self.pos + 1;
    Map<str, JsonValue> entries;
    entries.init(8);
    self.skip_ws();
    if self.peek() == '}' {
      self.pos = self.pos + 1;
      ret ok(JsonValue.Object(entries));
    }
    for true {
      self.skip_ws();
      str key = "";
      fit self.parse_string() {
        Result.Ok(k) -> { key = k; }
        Result.Err(e) -> {
          entries.free();
          ret err_error(e, JsonValue.Null);
        }
      }
      self.skip_ws();
      if self.peek() != ':' {
        entries.free();
        ret err(1, "expected ':' in object", JsonValue.Null);
      }
      self.pos = self.pos + 1;
      fit self.parse_value() {
        Result.Ok(v) -> { entries.put(key, v); }
        Result.Err(e) -> {
          entries.free();
          ret err_error(e, JsonValue.Null);
        }
      }
      self.skip_ws();
      chr c = self.peek();
      if c == ',' {
        self.pos = self.pos + 1;
      } elif c == '}' {
        self.pos = self.pos + 1;
        ret ok(JsonValue.Object(entries));
      } else {
        entries.free();
        ret err(1, "expected ',' or '}' in object", JsonValue.Null);
      }
    }
    ret ok(JsonValue.Object(entries));
  }
}

// Parse JSON text into a typed `JsonValue`. Returns `Err` on malformed input.
pub fun parse(str src) Result<JsonValue> {
  JsonParser p = JsonParser{src = src, pos = 0};
  ret p.parse_value();
}

// A `JsonValue` serializes to its JSON text (the text-layer serde quirk).
impl JsonValue as Serialize {
  pub serialize() str {
    ret self.to_string();
  }
}

// --- Structured (de)serialization for your own compounds -----------------------------

// A compound that can convert itself into a structured `JsonValue`. Fun has no
// reflection/derive, so implement this by hand — the explicit equivalent of a derived
// serializer:
// 
// ```
// impl Point as ToJson {
//   pub to_json() JsonValue {
//     let o = json_object();
//     o.put("x", json_num(self.x));
//     o.put("y", json_num(self.y));
//     ret JsonValue.Object(o);
//   }
// }
// ```
pub quirk ToJson {
  // Build a `JsonValue` representing this value.
  to_json() JsonValue;
}

// A compound that can rebuild itself from a structured `JsonValue`. Read fields with
// `value.get(key)` + the `as_*` accessors:
// 
// ```
// impl Point as FromJson {
//   pub from_json(JsonValue value) {
//     let x = value.get("x").unwrap_or(JsonValue.Null);
//     self.x = x.as_num().unwrap_or(0.0);
//     let y = value.get("y").unwrap_or(JsonValue.Null);
//     self.y = y.as_num().unwrap_or(0.0);
//   }
// }
// ```
pub quirk FromJson {
  // Apply state from a `JsonValue` (best-effort: missing fields take defaults).
  from_json(JsonValue value);
}

// Convert any `ToJson` implementer into a `JsonValue`.
pub fun to_json_value(ToJson value) JsonValue {
  ret value.to_json();
}

// Serialize any `ToJson` implementer straight to JSON text.
pub fun to_json_string(ToJson value) str {
  let v = value.to_json();
  ret v.to_string();
}
