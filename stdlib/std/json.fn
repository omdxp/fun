// Basic JSON object parsing/serialization (string values).
// 
// Usage:
// ```
// JsonObject o = json_object_init();
// o.set("a", "1");
// ```

imp std.map;
imp std.serde;
imp std.string;
imp std.vec;
imp std.result;
imp std.error;

// JSON object with string values.
pub compound JsonObject {
  // values: key/value map (string values)
  Map<str, str> values;
}

// JSON array of strings.
pub compound JsonArray {
  // values: vector of string values
  Vec<str> values;
}

// Create a new empty JSON object.
// 
// Returns:
// - JsonObject with empty map
pub fun json_object_init() JsonObject {
  JsonObject o;
  o.values.init(8);
  ret o;
}

// Create a new empty JSON array.
// 
// Returns:
// - JsonArray with empty vector
pub fun json_array_init() JsonArray {
  JsonArray a;
  a.values.init(8);
  ret a;
}

fun _append_escaped(StringBuilder* b, str s) {
  num i = 0;
  for s[i] != 0 {
    chr c = s[i];
    if c == '"' {
      b.append_char('\\');
      b.append_char('"');
    } elif c == '\\' {
      b.append_char('\\');
      b.append_char('\\');
    } elif c == '\n' {
      b.append_char('\\');
      b.append_char('n');
    } elif c == '\0' {
      b.append_char('\\');
      b.append_char('r');
    } elif c == '\t' {
      b.append_char('\\');
      b.append_char('t');
    } else {
      b.append_char(c);
    }
    i = i + 1;
  }
}

fun _json_find_str_key_index(Map<str, str>* m, str key) num {
  if m.key_slots == NULL {
    ret -1;
  }

  num i = 0;
  for i < m.cap {
    if m.used[i] != false && m.tomb[i] == false {
      if equals(m.key_slots[i], key) {
        ret i;
      }
    }
    i = i + 1;
  }
  ret -1;
}

impl JsonObject {
  // Get a value by key.
  pub get(str key) str {
    let idx = _json_find_str_key_index(&self.values, key);
    if idx == -1 {
      ret NULL;
    }
    ret self.values.value_slots[idx];
  }

  // Check if a key exists.
  pub has(str key) bin {
    ret _json_find_str_key_index(&self.values, key) != -1;
  }

  // Set a string value by key.
  pub set(str key, str value) {
    let idx = _json_find_str_key_index(&self.values, key);
    if idx != -1 {
      self.values.value_slots[idx] = value;
      ret;
    }
    self.values.put(key, value);
  }

  // Remove a key.
  pub remove(str key) bin {
    let idx = _json_find_str_key_index(&self.values, key);
    if idx == -1 {
      ret false;
    }
    self.values.value_slots[idx] = self.values.zero_value();
    self.values.tomb[idx] = true;
    self.values.len = self.values.len - 1;
    ret true;
  }

  // Return all keys.
  pub keys() Vec<str> {
    ret self.values.keys();
  }

  // Free internal storage.
  pub free() {
    self.values.free();
  }

  // Serialize object to JSON (string values).
  pub stringify() str {
    StringBuilder b = string_builder_init(self.values.len() * 2 + 4);
    b.append_char('{');

    num i = 0;
    num added = 0;
    for i < self.values.cap {
      if self.values.used[i] == false || self.values.tomb[i] != false {
        i = i + 1;
        continue;
      }

      if added > 0 {
        b.append(", ");
      }

      str key = self.values.key_slots[i];
      str value = self.values.value_slots[i];
      b.append_char('"');
      _append_escaped(&b, key);
      b.append_char('"');
      b.append(": ");
      b.append_char('"');
      _append_escaped(&b, value);
      b.append_char('"');
      added = added + 1;
      i = i + 1;
    }

    b.append_char('}');
    str out = b.build();
    b.free();
    ret out;
  }

  // Serialize object to JSON with Result.
  pub try_stringify() Result<str> {
    str out = self.stringify();
    if out == NULL {
      ret err(1, "json stringify failed", "");
    }
    ret ok(out);
  }
}

impl JsonObject as Serialize {
  // Encode this object as JSON text.
  pub serialize() str {
    ret self.stringify();
  }
}

impl JsonObject as Deserialize {
  // Parse JSON text into this object.
  pub deserialize(str input) {
    JsonObject parsed = parse_object(input);
    defer parsed.free();
    if self.values.cap == 0 {
      self.values.init(8);
    } else {
      self.values.clear();
    }

    num i = 0;
    for i < parsed.values.cap {
      if parsed.values.used[i] != false && parsed.values.tomb[i] == false {
        self.values.put(parsed.values.key_slots[i], parsed.values.value_slots[i]);
      }
      i = i + 1;
    }

  }
}

impl JsonArray {
  // Append a string value.
  pub push(str value) {
    self.values.push(value);
  }

  // Free internal storage.
  pub free() {
    self.values.free();
  }

  // Serialize array to JSON (string values).
  pub stringify() str {
    StringBuilder b = string_builder_init(self.values.len() * 2 + 4);
    b.append_char('[');
    num i = 0;
    for i < self.values.len {
      if i > 0 {
        b.append(", ");
      }
      b.append_char('"');
      _append_escaped(&b, self.values.get(i));
      b.append_char('"');
      i = i + 1;
    }
    b.append_char(']');
    str out = b.build();
    b.free();
    ret out;
  }

  // Serialize array to JSON with Result.
  pub try_stringify() Result<str> {
    str out = self.stringify();
    if out == NULL {
      ret err(1, "json stringify failed", "");
    }
    ret ok(out);
  }
}

impl JsonArray as Serialize {
  // Encode this array as JSON text.
  pub serialize() str {
    ret self.stringify();
  }
}

impl JsonArray as Deserialize {
  // Parse JSON text into this array.
  pub deserialize(str input) {
    JsonArray parsed = parse_array(input);
    defer parsed.free();
    if self.values.cap == 0 {
      self.values.init(8);
    } else {
      self.values.clear();
    }

    num i = 0;
    for i < parsed.values.len {
      self.values.push(parsed.values.get(i));
      i = i + 1;
    }

  }
}

fun _skip_ws(str s, num* i) {
  for s[*i] != 0 {
    let c = s[*i];
    if c == ' ' || c == '\n' || c == '\t' || c == '\0' {
      *i = *i + 1;
      continue;
    }
    break;
  }
}

fun _parse_string(str s, num* i) str {
  if s[*i] != '"' {
    ret "";
  }
  *i = *i + 1;
  num start = *i;
  for s[*i] != 0 {
    if s[*i] == '"' {
      break;
    }
    *i = *i + 1;
  }
  num len = *i - start;
  str out = substr(s, start, len);
  if s[*i] == '"' {
    *i = *i + 1;
  }
  ret out;
}

fun _parse_value(str s, num* i) str {
  _skip_ws(s, i);
  if s[*i] == '"' {
    ret _parse_string(s, i);
  }

  num start = *i;
  for s[*i] != 0 {
    if s[*i] == ',' {
      break;
    }
    if s[*i] == '}' {
      break;
    }
    *i = *i + 1;
  }
  num len = *i - start;
  str out = trim(substr(s, start, len));
  ret out;
}

// Parse a JSON object with string values.
// 
// Params:
// - s: JSON string
// 
// Returns:
// - parsed JsonObject
pub fun parse_object(str s) JsonObject {
  JsonObject out = json_object_init();
  num i = 0;
  _skip_ws(s, &i);
  if s[i] == '{' {
    i = i + 1;
  }

  for s[i] != 0 {
    _skip_ws(s, &i);
    if s[i] == '}' {
      break;
    }

    str key = _parse_string(s, &i);
    _skip_ws(s, &i);
    if s[i] == ':' {
      i = i + 1;
    }
    str value = _parse_value(s, &i);
    out.set(key, value);
    _skip_ws(s, &i);
    if s[i] == ',' {
      i = i + 1;
    }
  }

  ret out;
}

// Parse a JSON object with Result.
pub fun try_parse_object(str s) Result<JsonObject> {
  JsonObject out = parse_object(s);
  ret ok(out);
}

// Parse a JSON array of string values.
// 
// Params:
// - s: JSON array string
// 
// Returns:
// - parsed JsonArray
pub fun parse_array(str s) JsonArray {
  JsonArray out = json_array_init();
  num i = 0;
  _skip_ws(s, &i);
  if s[i] == '[' {
    i = i + 1;
  }

  for s[i] != 0 {
    _skip_ws(s, &i);
    if s[i] == ']' {
      break;
    }
    let value = _parse_value(s, &i);
    out.push(value);
    _skip_ws(s, &i);
    if s[i] == ',' {
      i = i + 1;
    }
  }

  ret out;
}

// Parse a JSON array with Result.
pub fun try_parse_array(str s) Result<JsonArray> {
  JsonArray out = parse_array(s);
  ret ok(out);
}

// Serialize a JSON object.
// 
// Params:
// - obj: JSON object
// 
// Returns:
// - JSON string
pub fun stringify_object(JsonObject* obj) str {
  ret obj.stringify();
}

// Serialize a JSON object with Result.
pub fun try_stringify_object(JsonObject* obj) Result<str> {
  str out = obj.stringify();
  if out == NULL {
    ret err(1, "json stringify failed", "");
  }
  ret ok(out);
}

// Serialize a JSON array.
// 
// Params:
// - arr: JSON array
// 
// Returns:
// - JSON string
pub fun stringify_array(JsonArray* arr) str {
  ret arr.stringify();
}

// Serialize a JSON array with Result.
pub fun try_stringify_array(JsonArray* arr) Result<str> {
  str out = arr.stringify();
  if out == NULL {
    ret err(1, "json stringify failed", "");
  }
  ret ok(out);
}
