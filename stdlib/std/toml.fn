// Typed TOML values (flat `key = value` documents).
// 
// `TomlValue` is a data-carrying enum modelling a TOML scalar: a string, integer,
// float, or boolean. `parse_document` reads `key = value` lines into a `TomlDoc`
// (a `Map<str, TomlValue>`), auto-detecting each value's type, and `get` returns the
// typed value.
// 
// ```
// let doc = parse_document("name = \"fun\"\nversion = 1\nstable = true\n");
// let v = doc.get("version").unwrap_or(TomlValue.Str(""));
// print_num(v.as_int().unwrap_or(0));   // 1
// ```

imp std.map;
imp std.option;
imp std.result;
imp std.error;
imp std.string;
imp std.quirks;

// A TOML value: a scalar, or one level of inline table (`{ key = value,
// ... }`, the value-position construct a manifest's own `[dependencies]`
// table uses to keep one dependency's several fields on one line).
// Deliberately shallow: a value inside a `Table` may be a scalar, never
// another nested inline table - this parser's own "narrow subset"
// philosophy (see the module doc) extends here too.
pub enum TomlValue {
  Str(str),
  Int(num),
  Float(dec),
  Bool(bin),
  Table(Map<str, TomlValue>),
}

impl TomlValue {
  // The string, or None when this is not a Str.
  pub as_str() Option<str> {
    fit *self {
      .Str(s) -> { ret Option.Some(s); }
      _ -> { ret Option.None; }
    }
    ret Option.None;
  }

  // The integer, or None when this is not an Int.
  pub as_int() Option<num> {
    fit *self {
      .Int(n) -> { ret Option.Some(n); }
      _ -> { ret Option.None; }
    }
    ret Option.None;
  }

  // The float, or None when this is not a Float.
  pub as_float() Option<dec> {
    fit *self {
      .Float(d) -> { ret Option.Some(d); }
      _ -> { ret Option.None; }
    }
    ret Option.None;
  }

  // The boolean, or None when this is not a Bool.
  pub as_bool() Option<bin> {
    fit *self {
      .Bool(b) -> { ret Option.Some(b); }
      _ -> { ret Option.None; }
    }
    ret Option.None;
  }

  // True when this is an inline table (`{ key = value, ... }`).
  pub is_table() bin {
    fit *self {
      .Table(_) -> { ret true; }
      _ -> { ret false; }
    }
    ret false;
  }

  // One field of this inline table, or "" when this isn't a Table, the
  // field is absent, or the field isn't itself a string. A plain scalar
  // return rather than handing back the inner `Map` or a `TomlTable`
  // wrapper, since a bare `{ key = value }` value has no section name of
  // its own for `TomlTable` to carry.
  pub table_field(str key) str {
    fit *self {
      .Table(m) -> {
        let v = m.at(key);
        if v.is_none() {
          ret "";
        }
        ret v.unwrap().as_str().unwrap_or("");
      }
      _ -> { ret ""; }
    }
    ret "";
  }
}

impl TomlValue as Display {
  // Render the value in TOML syntax (strings are quoted).
  pub to_string() str {
    fit *self {
      .Str(s) -> {
        let b = string_builder_init(_tv_strlen(s) + 2);
        b.append_char('"');
        b.append(s);
        b.append_char('"');
        let out = b.build();
        b.free();
        ret out;
      }
      .Int(n) -> {
        let b = string_builder_init(16);
        b.append_num(n);
        let out = b.build();
        b.free();
        ret out;
      }
      .Float(d) -> {
        let b = string_builder_init(24);
        b.append_dec(d, 6);
        let out = b.build();
        b.free();
        ret out;
      }
      .Bool(x) -> {
        if x {
          ret _tv_dup("true");
        }
        ret _tv_dup("false");
      }
      .Table(m) -> {
        let b = string_builder_init(64);
        b.append_char('{');
        let keys = m.keys();
        defer keys.free();
        num i = 0;
        for i < keys.len() {
          if i > 0 {
            b.append(", ");
          }
          let key = keys.get(i);
          b.append(key);
          b.append(" = ");
          b.append(m.get(key).to_string());
          i = i + 1;
        }
        b.append_char('}');
        let out = b.build();
        b.free();
        ret out;
      }
    }
    ret _tv_dup("");
  }
}

fun _tv_strlen(str s) num {
  num i = 0;
  for s[i] != 0 {
    i = i + 1;
  }
  ret i;
}

fun _tv_dup(str s) str {
  let b = string_builder_init(_tv_strlen(s) + 1);
  b.append(s);
  let out = b.build();
  b.free();
  ret out;
}

// A parsed TOML document: keys mapped to typed values.
// A `[name]` section's own `key = value` pairs.
pub compound TomlTable {
  str name;
  Map<str, TomlValue> values;
}

pub compound TomlDoc {
  // Keys written before any section header.
  Map<str, TomlValue> values;
  // `[name]` sections, in the order they appear.
  Vec<TomlTable> tables;
  // `[[name]]` entries, in the order they appear, one per occurrence.
  Vec<TomlTable> array_tables;
}

// Create an empty TOML document.
pub fun toml_doc_init() TomlDoc {
  TomlDoc d;
  d.values.init(8);
  d.tables.init(0);
  d.array_tables.init(0);
  ret d;
}

// An empty `[name]` section.
pub fun toml_table_init(str name) TomlTable {
  TomlTable t;
  t.name = name;
  t.values.init(8);
  ret t;
}

impl TomlTable {
  // Look up a key within this section.
  pub get(str key) Option<TomlValue> {
    ret self.values.at(key);
  }

  // The string value for `key`, or "" when absent or not a string.
  pub get_str(str key) str {
    let v = self.values.at(key);
    if v.is_none() {
      ret "";
    }
    ret v.unwrap().as_str().unwrap_or("");
  }

  pub free() {
    self.values.free();
  }
}

impl TomlDoc {
  // Look up a key: Some(value) when present, None otherwise.
  pub get(str key) Option<TomlValue> {
    ret self.values.at(key);
  }

  // Insert or replace a typed value.
  pub set(str key, TomlValue value) {
    self.values.put(key, value);
  }

  // Number of entries.
  pub len() num {
    ret self.values.len();
  }

  // The first `[name]` section, or None when there is none.
  pub table(str name) Option<TomlTable> {
    num i = 0;
    for i < self.tables.len {
      if equals(self.tables.get(i).name, name) {
        ret .Some(self.tables.get(i));
      }
      i = i + 1;
    }
    ret .None;
  }

  // Every `[[name]]` entry, in the order they appear.
  pub array(str name) Vec<TomlTable> {
    Vec<TomlTable> out;
    out.init(0);
    num i = 0;
    for i < self.array_tables.len {
      if equals(self.array_tables.get(i).name, name) {
        out.push(self.array_tables.get(i));
      }
      i = i + 1;
    }
    ret out;
  }

  // Free internal storage.
  pub free() {
    self.values.free();
    num i = 0;
    for i < self.tables.len {
      self.tables.data[i].free();
      i = i + 1;
    }
    self.tables.free();
    num j = 0;
    for j < self.array_tables.len {
      self.array_tables.data[j].free();
      j = j + 1;
    }
    self.array_tables.free();
  }

  // Render the document back to `key = value` lines.
  pub stringify() str {
    let b = string_builder_init(self.values.len() * 16 + 8);
    defer b.free();
    let keys = self.values.keys();
    defer keys.free();
    num i = 0;
    for i < keys.len() {
      let key = keys.get(i);
      let val = self.values.get(key);
      b.append(key);
      b.append(" = ");
      let vs = val.to_string();
      b.append(vs);
      b.append_char('\n');
      i = i + 1;
    }
    ret b.build();
  }

  // Render with Result (for the fallible serde surface).
  pub try_stringify() Result<str, Error> {
    let out = self.stringify();
    if out == nil {
      ret err_kind(.OutOfMemory, "toml stringify failed", "");
    }
    ret .Ok(out);
  }
}

// --- Value classification ------------------------------------------------------------

fun _toml_is_digit(chr c) bin {
  ret c >= '0' && c <= '9';
}

// Drops a trailing `# comment`, respecting a quoted value so a `#`
// inside quotes is kept.
fun _strip_trailing_comment(str text) str {
  num i = 0;
  bin in_quotes = false;
  let n = len(text);
  for i < n {
    if text[i] == '"' {
      in_quotes = !in_quotes;
    } elif text[i] == '#' && !in_quotes {
      ret trim(substr(text, 0, i));
    }
    i = i + 1;
  }
  ret text;
}

// One `key = value` piece inside an inline table's braces, put into
// `out` (a no-op for an empty or malformed piece, mirroring
// `_parse_line_into`'s own tolerance for a line with no `=`).
fun _inline_table_put(Map<str, TomlValue>* out, str piece) {
  if len(piece) == 0 {
    ret;
  }
  let eq_idx = index_of_char(piece, '=');
  if eq_idx == -1 {
    ret;
  }
  let key = trim(substr(piece, 0, eq_idx));
  let value_text = trim(substr(piece, eq_idx + 1, len(piece) - (eq_idx + 1)));
  if len(key) == 0 {
    ret;
  }
  out.put(key, _classify(value_text));
}

// `{ key = value, key2 = value2 }`: strips the outer braces, then splits
// on a top-level comma (one respecting quotes, so a comma inside a
// quoted value doesn't split it) and classifies each `key = value`
// piece the same way a top-level line would be.
fun _classify_inline_table(str text) TomlValue {
  Map<str, TomlValue> out;
  out.init(4);
  let inner = trim(substr(text, 1, len(text) - 2));
  let n = len(inner);
  if n == 0 {
    ret .Table(out);
  }
  num i = 0;
  num start = 0;
  bin in_quotes = false;
  for i < n {
    let c = inner[i];
    if c == '"' {
      in_quotes = !in_quotes;
    } elif c == ',' && !in_quotes {
      _inline_table_put(&out, trim(substr(inner, start, i - start)));
      start = i + 1;
    }
    i = i + 1;
  }
  if start < n {
    _inline_table_put(&out, trim(substr(inner, start, n - start)));
  }
  ret .Table(out);
}

// Classify a raw (trimmed) TOML value string into a typed TomlValue.
fun _classify(str raw_text) TomlValue {
  let text = _strip_trailing_comment(raw_text);
  let n = _tv_strlen(text);
  if n == 0 {
    ret .Str(text);
  }

  // Inline table: `{ key = value, ... }`, one level deep.
  if text[0] == '{' && text[n - 1] == '}' {
    ret _classify_inline_table(text);
  }

  // Quoted string: strip the surrounding quotes.
  if text[0] == '"' {
    if n >= 2 && text[n - 1] == '"' {
      ret .Str(substr(text, 1, n - 2));
    }
    ret .Str(text);
  }

  // Booleans.
  if equals(text, "true") {
    ret .Bool(true);
  }
  if equals(text, "false") {
    ret .Bool(false);
  }

  // Numbers: a leading digit or sign, with a '.' meaning float.
  let c0 = text[0];
  if _toml_is_digit(c0) || c0 == '-' || c0 == '+' {
    num has_dot = 0;
    num i = 0;
    for i < n {
      if text[i] == '.' {
        has_dot = 1;
      }
      i = i + 1;
    }
    if has_dot == 1 {
      ret .Float(parse_dec(text));
    }
    ret .Int(parse_int(text));
  }

  // Anything else is a bare string.
  ret TomlValue.Str(text);
}

fun _parse_line_into(TomlDoc* out, str line) {
  if len(line) <= 0 {
    ret;
  }
  let eq_idx = index_of_char(line, '=');
  if eq_idx == -1 {
    ret;
  }
  let key = trim(substr(line, 0, eq_idx));
  let value_text = trim(substr(line, eq_idx + 1, len(line) - (eq_idx + 1)));
  if len(key) <= 0 {
    ret;
  }
  out.set(key, _classify(value_text));
}

// True for a `[name]` header, including the `[[name]]` form.
fun _is_header(str line) bin {
  ret starts_with(line, "[") && ends_with(line, "]");
}

// Routes `line` into the document's top level, its current `[name]`
// section, or its current `[[name]]` entry.
fun _route_line(TomlDoc* out, str line, num section, num index) {
  if section == 0 {
    _parse_line_into(out, line);
    ret;
  }
  let eq_idx = index_of_char(line, '=');
  if eq_idx == -1 {
    ret;
  }
  let key = trim(substr(line, 0, eq_idx));
  let value_text = trim(substr(line, eq_idx + 1, len(line) - (eq_idx + 1)));
  if len(key) <= 0 {
    ret;
  }
  if section == 1 {
    out.tables.data[index].values.put(key, _classify(value_text));
  } else {
    out.array_tables.data[index].values.put(key, _classify(value_text));
  }
}

// Parse a TOML document: top-level `key = value` lines, `[name]`
// sections, and repeated `[[name]]` entries. Nested sub-tables are not
// split apart, so `[a.b]` is a section literally named "a.b".
pub fun parse_document(str s) TomlDoc {
  let out = toml_doc_init();
  // 0 = top level, 1 = a [name] section, 2 = a [[name]] entry.
  num section = 0;
  num index = 0;

  let lines = split(s, '\n');
  defer lines.free();
  for raw_line : lines {
    let line = trim(raw_line);
    if len(line) == 0 {
      continue;
    }
    if line[0] == '#' {
      continue;
    }
    if _is_header(line) {
      if starts_with(line, "[[") && ends_with(line, "]]") {
        let name = trim(substr(line, 2, len(line) - 4));
        out.array_tables.push(toml_table_init(name));
        section = 2;
        index = out.array_tables.len - 1;
      } else {
        let name = trim(substr(line, 1, len(line) - 2));
        out.tables.push(toml_table_init(name));
        section = 1;
        index = out.tables.len - 1;
      }
      continue;
    }
    _route_line(&out, line, section, index);
  }
  ret out;
}

// Parse a flat TOML document with Result.
pub fun try_parse_document(str s) Result<TomlDoc, Error> {
  let out = parse_document(s);
  ret .Ok(out);
}

impl TomlDoc as To<str> {
  // Encode this document as TOML text.
  pub to() str {
    ret self.stringify();
  }
}

impl TomlDoc as From<str> {
  // Parse TOML text into this document (replacing any current contents).
  pub from(str input) {
    if self.values.cap == 0 {
      self.values.init(8);
    } else {
      self.values.clear();
    }
    num i = 0;
    num start = 0;
    for input[i] != 0 {
      if input[i] == '\n' {
        let line = substr(input, start, i - start);
        _parse_line_into(self, line);
        i = i + 1;
        start = i;
      } else {
        i = i + 1;
      }
    }
    if i > start {
      let line = substr(input, start, i - start);
      _parse_line_into(self, line);
    }
  }
}

test "parses top-level scalars" {
  let doc = parse_document("name = \"fun\"\nversion = 1\nstable = true\n");
  defer doc.free();
  assert equals(doc.get("name").unwrap().as_str().unwrap_or(""), "fun"), "expected the string value";
  assert doc.get("version").unwrap().as_int().unwrap_or(0) == 1, "expected the integer value";
  assert doc.get("stable").unwrap().as_bool().unwrap_or(false), "expected the boolean value";
}

test "parses a named section" {
  let doc = parse_document("[package]\nname = \"demo\"\nversion = \"1.0\"\n");
  defer doc.free();
  let t = doc.table("package");
  assert t.is_some(), "expected the package section";
  assert equals(t.unwrap().get_str("name"), "demo"), "expected the section's name value";
  assert equals(t.unwrap().get_str("version"), "1.0"), "expected the section's version value";
}

test "a key after a section header does not land at the top level" {
  let doc = parse_document("[package]\nname = \"demo\"\n");
  defer doc.free();
  assert doc.get("name").is_none(), "expected the key to belong to the section";
}

test "parses repeated array-of-table entries in order" {
  let doc = parse_document("[[bin]]\nname = \"one\"\n\n[[bin]]\nname = \"two\"\n");
  defer doc.free();
  let bins = doc.array("bin");
  defer bins.free();
  assert bins.len == 2, "expected both entries";
  assert equals(bins.get(0).get_str("name"), "one"), "expected the first entry";
  assert equals(bins.get(1).get_str("name"), "two"), "expected the second entry";
}

test "sections and array-of-tables coexist" {
  let doc = parse_document("[package]\nname = \"demo\"\n\n[lib]\npath = \"src/lib.fn\"\n\n[[bin]]\nname = \"app\"\n");
  defer doc.free();
  assert equals(doc.table("package").unwrap().get_str("name"), "demo"), "expected the package section";
  assert equals(doc.table("lib").unwrap().get_str("path"), "src/lib.fn"), "expected the lib section";
  let bins = doc.array("bin");
  defer bins.free();
  assert bins.len == 1, "expected the single bin entry";
}

test "comments and blank lines are skipped" {
  let doc = parse_document("# a comment\n\n[package]\nname = \"demo\"\n");
  defer doc.free();
  assert equals(doc.table("package").unwrap().get_str("name"), "demo"), "expected the value past the comment";
}

test "an absent section reports None" {
  let doc = parse_document("[package]\nname = \"demo\"\n");
  defer doc.free();
  assert doc.table("nope").is_none(), "expected an absent section to report None";
}

test "a trailing comment is dropped from a value" {
  let doc = parse_document("name = \"demo\" # trailing\ncount = 3 # another\n");
  defer doc.free();
  assert equals(doc.get("name").unwrap().as_str().unwrap_or(""), "demo"), "expected the value without its comment";
  assert doc.get("count").unwrap().as_int().unwrap_or(0) == 3, "expected the integer without its comment";
}

test "a hash inside quotes is kept" {
  let doc = parse_document("tag = \"a#b\"\n");
  defer doc.free();
  assert equals(doc.get("tag").unwrap().as_str().unwrap_or(""), "a#b"), "expected the quoted hash to survive";
}

test "parses an inline table's fields" {
  let doc = parse_document("[deps]\nsomejson = { git = \"https://example.com/repo\", tag = \"v1.0.0\" }\n");
  defer doc.free();
  let deps = doc.table("deps").unwrap();
  let entry = deps.values.get("somejson");
  assert entry.is_table(), "expected the dependency entry to parse as an inline table";
  assert equals(entry.table_field("git"), "https://example.com/repo"), "expected the git field";
  assert equals(entry.table_field("tag"), "v1.0.0"), "expected the tag field";
  assert equals(entry.table_field("nosuchfield"), ""), "expected a missing field to report an empty string";
}

test "an inline table field value keeps its quotes stripped and a plain scalar reports not-a-table" {
  let doc = parse_document("plain = 3\n");
  defer doc.free();
  let entry = doc.get("plain").unwrap();
  assert !entry.is_table(), "expected a plain scalar to not be an inline table";
  assert equals(entry.table_field("anything"), ""), "expected table_field on a non-table to report an empty string";
}
