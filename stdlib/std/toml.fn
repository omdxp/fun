// Basic TOML parsing/serialization (flat key=value).
// 
// Usage:
// ```
// TomlDoc d = toml_doc_init();
// d.set("key", "value");
// ```

imp std.map;
imp std.serde;
imp std.string;
imp std.result;

fun _parse_line_into(TomlDoc* out, str line) {
  if len(line) <= 0 {
    ret;
  }

  let eq_idx = index_of_char(line, '=');
  if eq_idx == -1 {
    ret;
  }

  let key = trim(substr(line, 0, eq_idx));
  let val = trim(substr(line, eq_idx + 1, len(line) - (eq_idx + 1)));
  out.set(key, val);
}

fun _toml_find_str_key_index(Map<str, str>* m, str key) num {
  if m.key_slots == NULL {
    ret -1;
  }

  num i = 0;
  for i < m.cap {
    if m.used[i] != false && m.tomb[i] == false {
      if equals(m.key_slots[i], key) {
        ret i;
      }
    }
    i = i + 1;
  }
  ret -1;
}

// TOML document wrapper.
pub compound TomlDoc {
  // key/value map
  Map<str, str> values;
}

// Create a new TOML document.
// 
// Returns:
// - TomlDoc with empty map
pub fun toml_doc_init() TomlDoc {
  TomlDoc d;
  d.values.init(8);
  ret d;
}

impl TomlDoc {
  // Get a value by key.
  pub get(str key) str {
    let idx = _toml_find_str_key_index(&self.values, key);
    if idx == -1 {
      ret NULL;
    }
    ret self.values.value_slots[idx];
  }

  // Set a value by key.
  pub set(str key, str value) {
    let idx = _toml_find_str_key_index(&self.values, key);
    if idx != -1 {
      self.values.value_slots[idx] = value;
      ret;
    }
    self.values.put(key, value);
  }

  // Free internal storage.
  pub free() {
    self.values.free();
  }

  // Serialize the document to a string.
  pub stringify() str {
    StringBuilder b = string_builder_init(self.values.len() * 8 + 8);
    num i = 0;
    for i < self.values.cap {
      if self.values.used[i] == false || self.values.tomb[i] != false {
        i = i + 1;
        continue;
      }

      str key = self.values.key_slots[i];
      str value = self.values.value_slots[i];
      b.append(key);
      b.append(" = ");
      b.append(value);
      b.append("\n");
      i = i + 1;
    }

    str out = b.build();
    b.free();
    ret out;
  }

  // Serialize the document to a string with Result.
  pub try_stringify() Result<str> {
    str out = self.stringify();
    if out == NULL {
      ret err(1, "toml stringify failed", "");
    }
    ret ok(out);
  }
}

impl TomlDoc as Serialize {
  // Encode this document as TOML text.
  pub serialize() str {
    ret self.stringify();
  }
}

impl TomlDoc as Deserialize {
  // Parse TOML text into this document.
  pub deserialize(str input) {
    TomlDoc parsed = parse_document(input);
    defer parsed.free();
    if self.values.cap == 0 {
      self.values.init(8);
    } else {
      self.values.clear();
    }

    num i = 0;
    for i < parsed.values.cap {
      if parsed.values.used[i] != false && parsed.values.tomb[i] == false {
        self.values.put(parsed.values.key_slots[i], parsed.values.value_slots[i]);
      }
      i = i + 1;
    }

  }
}

// Parse a TOML document (flat key=value).
// 
// Params:
// - s: TOML string
// 
// Returns:
// - parsed TomlDoc
pub fun parse_document(str s) TomlDoc {
  TomlDoc out = toml_doc_init();
  num i = 0;
  num start = 0;

  for s[i] != 0 {
    if s[i] == '\n' {
      let line_len = i - start;
      let line = substr(s, start, line_len);
      _parse_line_into(&out, line);
      i = i + 1;
      start = i;
    } else {
      i = i + 1;
    }
  }

  if i > start {
    let line_len = i - start;
    let line = substr(s, start, line_len);
    _parse_line_into(&out, line);
  }

  ret out;
}

// Parse a TOML document with Result.
pub fun try_parse_document(str s) Result<TomlDoc> {
  TomlDoc out = parse_document(s);
  ret ok(out);
}

// Serialization is done through the value methods: `doc.stringify()` and
// `doc.try_stringify()` (the Result-returning form).
