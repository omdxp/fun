// Runtime backend selector helpers.
// 
// Notes:
// - Selector order:
// 1) FUN_RUNTIME_BACKEND override
// 2) FUN_RUNTIME_OS override
// 3) host environment hints (OS / OSTYPE)
// 4) fallback to POSIX

imp std.sys;
imp std.c.string;

// Runtime backend id for POSIX platforms.
pub fun runtime_backend_posix_id() num {
  ret 1;
}

// Runtime backend id for Windows platforms.
pub fun runtime_backend_windows_id() num {
  ret 2;
}

fun runtime_backend_id_from_name(str name) num {
  if name == NULL {
    ret 0;
  }

  if strcmp(name, "1") == 0 || strcmp(name, "posix") == 0 || strcmp(name, "POSIX") == 0 {
    ret runtime_backend_posix_id();
  }

  if strcmp(name, "2") == 0 || strcmp(name, "windows") == 0 || strcmp(name, "Windows") == 0 || strcmp(
    name,
    "WINDOWS"
  ) == 0 {
    ret runtime_backend_windows_id();
  }

  ret 0;
}

fun runtime_backend_id_from_os_name(str os_name) num {
  if os_name == NULL {
    ret 0;
  }

  if strcmp(os_name, "posix") == 0 || strcmp(os_name, "unix") == 0 || strcmp(os_name, "POSIX") == 0 || strcmp(
    os_name,
    "UNIX"
  ) == 0 {
    ret runtime_backend_posix_id();
  }

  if strcmp(os_name, "windows") == 0 || strcmp(os_name, "win") == 0 || strcmp(os_name, "Windows") == 0 {
    ret runtime_backend_windows_id();
  }

  ret 0;
}

fun runtime_backend_detect_windows_hint() bin {
  str os_env = env("OS");
  if os_env != NULL && strcmp(os_env, "Windows_NT") == 0 {
    ret true;
  }

  str os_type = env("OSTYPE");
  if os_type == NULL {
    ret false;
  }

  if strncmp(os_type, "msys", 4) == 0 {
    ret true;
  }
  if strncmp(os_type, "cygwin", 6) == 0 {
    ret true;
  }
  if strncmp(os_type, "win", 3) == 0 {
    ret true;
  }

  ret false;
}

// Return the selected runtime backend id.
// 
// Environment overrides:
// - FUN_RUNTIME_BACKEND: posix/windows (or 1/2)
// - FUN_RUNTIME_OS: posix/unix/windows
pub fun runtime_backend_id() num {
  num override_backend = runtime_backend_id_from_name(env("FUN_RUNTIME_BACKEND"));
  if override_backend != 0 {
    ret override_backend;
  }

  num override_os = runtime_backend_id_from_os_name(env("FUN_RUNTIME_OS"));
  if override_os != 0 {
    ret override_os;
  }

  if runtime_backend_detect_windows_hint() == true {
    ret runtime_backend_windows_id();
  }

  ret runtime_backend_posix_id();
}

// Return the selected runtime backend name.
pub fun runtime_backend_name() str {
  if runtime_backend_id() == runtime_backend_windows_id() {
    ret "windows";
  }
  ret "posix";
}

// True when the selected backend is POSIX.
pub fun runtime_backend_is_posix() bin {
  ret runtime_backend_id() == runtime_backend_posix_id();
}

// True when the selected backend is Windows.
pub fun runtime_backend_is_windows() bin {
  ret runtime_backend_id() == runtime_backend_windows_id();
}
