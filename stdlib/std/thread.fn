// Thread helpers using pthread-shaped APIs.
// 
// On POSIX, these map to native pthread APIs. On Windows, backend
// compatibility layers provide equivalent behavior. Unless noted otherwise,
// these return 0 on success (including as a no-op when already in the
// target state) and a nonzero backend error code on failure.

imp std.c.thread;
imp std.result;
imp std.error;

// Managed thread handle.
pub compound Thread {
  // Underlying pthread handle.
  pthread_t handle;
  // True once started and not yet joined/detached.
  bin started;
}

// Creates a thread handle in stopped state.
pub fun thread_new() Thread {
  Thread t;
  t.started = false;
  ret t;
}

impl Thread {
  // Starts this thread running `entry(arg)`.
  pub start(raw* entry, raw* arg) num {
    if self.started == true {
      ret 0;
    }
    let rc = pthread_create(&self.handle, nil, entry, arg);
    if rc == 0 {
      self.started = true;
    }
    ret rc;
  }

  // Joins this thread, optionally writing its entry function's return value to `out_ret`.
  pub join(raw* out_ret) num {
    if self.started == false {
      ret 0;
    }
    let rc = pthread_join(self.handle, out_ret);
    if rc == 0 {
      self.started = false;
    }
    ret rc;
  }

  // Detaches this thread.
  pub detach() num {
    if self.started == false {
      ret 0;
    }
    let rc = pthread_detach(self.handle);
    if rc == 0 {
      self.started = false;
    }
    ret rc;
  }
}

// Starts a thread via pointer receiver helper. Returns -1 when `thread` is null.
pub fun thread_start(Thread* thread, raw* entry, raw* arg) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  let rc = t.start(entry, arg);
  thread[0] = t;
  ret rc;
}

// Start a thread with Result. `Ok(true)` on success, `Err` with the backend code
// otherwise (where `thread_start` returns a raw nonzero/-1 code that's easy to ignore).
pub fun try_thread_start(Thread* thread, raw* entry, raw* arg) Result<bin, Error> {
  let rc = thread_start(thread, entry, arg);
  if rc != 0 {
    ret err_kind_code(.System, rc, "thread_start failed", false);
  }
  ret .Ok(true);
}

// Joins a thread via pointer receiver helper. Returns -1 when `thread` is null.
pub fun thread_join(Thread* thread, raw* out_ret) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  let rc = t.join(out_ret);
  thread[0] = t;
  ret rc;
}

// Join a thread with Result. `Ok(true)` on success, `Err` with the backend code otherwise.
pub fun try_thread_join(Thread* thread, raw* out_ret) Result<bin, Error> {
  let rc = thread_join(thread, out_ret);
  if rc != 0 {
    ret err_kind_code(.System, rc, "thread_join failed", false);
  }
  ret .Ok(true);
}

// Detaches a thread via pointer receiver helper. Returns -1 when `thread` is null.
pub fun thread_detach(Thread* thread) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  let rc = t.detach();
  thread[0] = t;
  ret rc;
}

// Detach a thread with Result. `Ok(true)` on success, `Err` with the backend code otherwise.
pub fun try_thread_detach(Thread* thread) Result<bin, Error> {
  let rc = thread_detach(thread);
  if rc != 0 {
    ret err_kind_code(.System, rc, "thread_detach failed", false);
  }
  ret .Ok(true);
}

// Returns the current thread's pthread handle.
pub fun current_thread() pthread_t {
  ret pthread_self();
}

// Returns true when two thread ids refer to the same thread.
pub fun thread_equal(pthread_t a, pthread_t b) bin {
  ret pthread_equal(a, b) != 0;
}
