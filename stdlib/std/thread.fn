// Thread helpers using pthread-shaped APIs.
// 
// Notes:
// - On POSIX, these map to native pthread APIs.
// - On Windows, backend compatibility layers provide equivalent behavior.
// 
// Usage:
// Thread t = thread_new();
// num rc = t.start(entry_ptr, arg_ptr);

imp std.c.thread;
imp std.result;

// Managed thread handle.
pub compound Thread {
  // Underlying pthread handle.
  pthread_t handle;
  // True once started and not yet joined/detached.
  bin started;
}

// Create a thread handle in stopped state.
// 
// Returns:
// - new Thread value
pub fun thread_new() Thread {
  Thread t;
  t.started = false;
  ret t;
}

impl Thread {
  // Start this thread.
  // 
  // Params:
  // - entry: pthread entry function pointer
  // - arg: user data passed to entry
  // 
  // Returns:
  // - 0 on success
  // - 0 when already started (no-op)
  // - nonzero backend error code on failure
  pub start(raw* entry, raw* arg) num {
    if self.started == true {
      ret 0;
    }
    let rc = pthread_create(&self.handle, nil, entry, arg);
    if rc == 0 {
      self.started = true;
    }
    ret rc;
  }

  // Join this thread.
  // 
  // Params:
  // - out_ret: optional output pointer for entry return value
  // 
  // Returns:
  // - 0 on success
  // - 0 when not started (no-op)
  // - nonzero backend error code on failure
  pub join(raw* out_ret) num {
    if self.started == false {
      ret 0;
    }
    let rc = pthread_join(self.handle, out_ret);
    if rc == 0 {
      self.started = false;
    }
    ret rc;
  }

  // Detach this thread.
  // 
  // Returns:
  // - 0 on success
  // - 0 when not started (no-op)
  // - nonzero backend error code on failure
  pub detach() num {
    if self.started == false {
      ret 0;
    }
    let rc = pthread_detach(self.handle);
    if rc == 0 {
      self.started = false;
    }
    ret rc;
  }
}

// Start a thread via pointer receiver helper.
// 
// Params:
// - thread: thread handle pointer
// - entry: pthread entry function pointer
// - arg: user data passed to entry
// 
// Returns:
// - 0 on success
// - 0 when already started (no-op)
// - -1 when thread is null
// - nonzero backend error code on failure
pub fun thread_start(Thread* thread, raw* entry, raw* arg) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  let rc = t.start(entry, arg);
  thread[0] = t;
  ret rc;
}

// Start a thread with Result. `Ok(true)` on success, `Err` with the backend code
// otherwise (where `thread_start` returns a raw nonzero/-1 code that's easy to ignore).
pub fun try_thread_start(Thread* thread, raw* entry, raw* arg) Result<bin> {
  let rc = thread_start(thread, entry, arg);
  if rc != 0 {
    ret err(rc, "thread_start failed", false);
  }
  ret ok(true);
}

// Join a thread via pointer receiver helper.
// 
// Params:
// - thread: thread handle pointer
// - out_ret: optional output pointer for entry return value
// 
// Returns:
// - 0 on success
// - 0 when not started (no-op)
// - -1 when thread is null
// - nonzero backend error code on failure
pub fun thread_join(Thread* thread, raw* out_ret) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  let rc = t.join(out_ret);
  thread[0] = t;
  ret rc;
}

// Join a thread with Result. `Ok(true)` on success, `Err` with the backend code otherwise.
pub fun try_thread_join(Thread* thread, raw* out_ret) Result<bin> {
  let rc = thread_join(thread, out_ret);
  if rc != 0 {
    ret err(rc, "thread_join failed", false);
  }
  ret ok(true);
}

// Detach a thread via pointer receiver helper.
// 
// Params:
// - thread: thread handle pointer
// 
// Returns:
// - 0 on success
// - 0 when not started (no-op)
// - -1 when thread is null
// - nonzero backend error code on failure
pub fun thread_detach(Thread* thread) num {
  if thread == nil {
    ret -1;
  }

  let t = thread[0];
  let rc = t.detach();
  thread[0] = t;
  ret rc;
}

// Detach a thread with Result. `Ok(true)` on success, `Err` with the backend code otherwise.
pub fun try_thread_detach(Thread* thread) Result<bin> {
  let rc = thread_detach(thread);
  if rc != 0 {
    ret err(rc, "thread_detach failed", false);
  }
  ret ok(true);
}

// Return the current thread id.
// 
// Returns:
// - current pthread handle
pub fun current_thread() pthread_t {
  ret pthread_self();
}

// Compare two thread ids.
// 
// Returns:
// - true when equal
pub fun thread_equal(pthread_t a, pthread_t b) bin {
  ret pthread_equal(a, b) != 0;
}
