// Common quirks (traits) implemented across stdlib types.
// 
// ```
// fun len_of(Sized s) num { ret s.len(); }
// ```

// Basic size/introspection for collections.
pub quirk Sized {
  // Returns the number of elements or items.
  len() num;
  // Returns true when there are no elements or items.
  is_empty() bin;
}

// Types that can render themselves as a string. Implemented by the collections,
// Error, and the serialization value types so any of them can be `to_string`-ed.
pub quirk Display {
  // Renders the value as text.
  to_string() str;
}

// Types that can clear internal state (Vec, Map, Set, StringBuilder).
pub quirk Clearable {
  // Reset the value to an empty/cleared state.
  clear() void;
}

// A uniform iteration protocol: `next()` yields `Some(item)` until exhausted,
// then `None` forever. Collections expose an iterator via `iter()`; consume it
// with a loop:
// 
// ```
// let it = v.iter();
// for true {
//   fit it.next() {
//     Option.Some(x) -> { use(x); }
//     Option.None -> { break; }
//   }
// }
// ```
pub quirk Iterator<T> {
  // Advances and returns `Some(item)` while elements remain, `None` once exhausted.
  next() Option<T>;
}

// Converts this value into a `T`. Fun has no reflection or derive macros, so
// each type hand-implements the conversion.
// 
// ```
// impl Point as To<JsonValue> {
//   pub to() JsonValue {
//     let o = json_object();
//     o.put("x", json_num(self.x));
//     o.put("y", json_num(self.y));
//     ret JsonValue.Object(o);
//   }
// }
// let doc = p.to();               // direct method call
// JsonValue doc2 = to_json_value(&p); // quirk-typed parameter (see std.json)
// ```
// 
// Dispatches both via a direct method call (`value.to()`) and through a
// concrete instantiation used as a quirk-typed parameter or variable
// (`fun f(To<JsonValue> v) { ret v.to(); }`, then `f(&point)` for any type
// implementing `To<JsonValue>`).
pub quirk To<T> {
  // Produce a `T` from this value.
  to() T;
}

// Rebuilds this value from a `T` (e.g. `impl Config as From<JsonValue>`),
// reading state from the source value:
// 
// ```
// impl Config as From<JsonValue> {
//   pub from(JsonValue v) {
//     let p = v.get("port").unwrap_or(JsonValue.Null);
//     self.port = p.as_num().unwrap_or(0.0);
//   }
// }
// cfg.from(doc);
// ```
pub quirk From<T> {
  // Apply state to this value from a `T` (best-effort; missing data takes defaults).
  from(T value);
}

// A shallow copy with independent backing storage: implementers own
// their own container (array, slots, ...) after cloning, but an
// element that itself holds a pointer (a `str` key, a nested `Vec`)
// still aliases whatever it originally pointed to, exactly as an
// ordinary value copy of that element would.
// 
// ```
// impl Vec<T> as Clonable<Vec<T>> {
//   pub clone() Vec<T> { ... }
// }
// let copy = original.clone();
// ```
pub quirk Clonable<T> {
  // Returns an independent copy of this value.
  clone() T;
}
