// Common quirks for stdlib compounds.
// 
// Usage:
// ```
// fun len_of(Sized s) num { ret s.len(); }
// ```

// Basic size/introspection for collections.
pub quirk Sized {
  len() num;
  is_empty() bin;
}

// Types that can render themselves as a string.
pub quirk Display {
  to_string() str;
}

// Types that can clear internal state.
pub quirk Clearable {
  clear() void;
}
