.fun-cache
node_modules/
# Generated C, wherever a build or a manual `-out` puts it.
*.c
# Hand-written C that is part of an example, not generated output.
!examples/kernel/boot/*.c
# A codegen test's own staged source (`name.p<pid>n<n>.fn`), left behind
# whenever the test fails before it can clean up.
src/tests/fixtures/*.p[0-9]*n[0-9]*.fn
website/reference/dist/
website/reference/dist-server/
website/reference/src/generated/
website/reference/public/versions/
website/reference/public/wasm/
website/reference/public/wasm-frontend/
website/reference/public/wasm-fls/
website/reference/public/stdlib-src/

# Example-run scratch output written to the repo root by std demo programs
_tmp_*.txt

# Build output from `fun build`.
fun-out/

# Executables built next to their source by `fun -in <file>` (the file
# keeps its name with no extension, or .exe on Windows).
*.exe
# MSVC debug databases emitted alongside .exe files.
*.pdb
# MSVC object files.
*.obj
